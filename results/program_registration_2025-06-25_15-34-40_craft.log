ctions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions and prioritize moving towards primitives\n          prioritized_actions = []\n          for action, _type in sorted(possible_actions, key=lambda x: ('move', 'use').index(x[1])):\n              if action != 4:\n                  reward, new_state = current_state.step(action)\n                  # Check if the move brings us closer to a primitive\n                  for primitive in goal_primitives.keys():\n                      if new_state.next_to(primitive):\n                          prioritized_actions.insert(0, (action, _type))\n                          break\n                  else:\n                      prioritized_actions.append((action, _type))\n              else:\n                  prioritized_actions.append((action, _type))\n\n          for action, _ in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T01:45:41.355139", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          if action == 4:  # USE action\n              can_make_goal = all(new_state.inventory[primitive] >= count \n                                  for primitive, count in goal_primitives.items())\n              \n              if not can_make_goal:\n                  continue  # Skip this action as it doesn't help make the goal item\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n      \n      # Check if any neighbor cells can contribute to the goal\n      x, y = current_state.pos\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < initial_state.grid.shape[0] and 0 <= ny < initial_state.grid.shape[1]:\n              for kind in range(initial_state.world.n_kinds):\n                  if initial_state.grid[nx, ny, kind] > 0:\n                      # Check if this item is needed for the goal\n                      if kind in goal_primitives and new_state.inventory[kind] < goal_primitives[kind]:\n                          # Move towards the item if it's not already in inventory\n                          move_action = None\n                          if dx == -1:\n                              move_action = 2  # LEFT\n                          elif dx == 1:\n                              move_action = 3  # RIGHT\n                          elif dy == -1:\n                              move_action = 0  # DOWN\n                          elif dy == 1:\n                              move_action = 1  # UP\n                          \n                          if move_action is not None and move_action != current_state.dir:\n                              reward, new_state = current_state.step(move_action)\n                              \n                              state_hash = (tuple(new_state.grid.flatten()), \n                                            tuple(new_state.inventory), \n                                            new_state.pos, \n                                            new_state.dir)\n                              \n                              if state_hash not in visited:\n                                  visited.add(state_hash)\n                                  queue.append((new_state, path + [move_action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T01:45:52.007989", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n\n                  # Check if the USE action can contribute to making the goal item\n                  for primitive, count in goal_primitives.items():\n                      required_count = count - initial_state.inventory[primitive]\n                      available_count = new_state.inventory[primitive] - initial_state.inventory[primitive]\n                      \n                      if available_count < 0:\n                          can_make_goal = False\n                          break\n\n                      if available_count > 0 and (required_count <= 0 or required_count <= available_count):\n                          continue\n                      else:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
