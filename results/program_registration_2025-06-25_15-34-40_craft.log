not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T05:08:01.078652", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_primitive_locations(initial_state, goal_item):\n      \"\"\"Helper function to find locations of primitives needed for the goal item.\"\"\"\n      primitive_counts = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      locations = {primitive: [] for primitive in primitive_counts}\n      \n      # Scan the grid to find all primitives\n      width, height, _ = initial_state.grid.shape\n      for y in range(height):\n          for x in range(width):\n              cell_contents = np.nonzero(initial_state.grid[y, x])[0]\n              for kind in cell_contents:\n                  if kind in primitive_counts:\n                      locations[kind].append((x, y))\n      \n      return locations\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Preprocess: Collect all possible primitives needed for the goal item and their locations\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  primitive_locations = get_primitive_locations(initial_state, goal_item)\n  \n  def move_to_and_pickup(state, x, y):\n      \"\"\"Helper function to generate actions to move to a location (x, y) and pickup.\"\"\"\n      path = []\n      \n      # Use A* search to find the shortest path\n      from heapq import heappop, heappush\n      \n      width, height, _ = state.grid.shape\n      start_pos = state.pos\n      target_pos = (x, y)\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      \n      def heuristic(a, b):\n          return abs(a[0] - b[0]) + abs(a[1] - b[1])\n      \n      queue = []\n      heappush(queue, (heuristic(start_pos, target_pos), start_pos, []))\n      visited = set()\n      \n      while queue:\n          _, current_pos, path = heappop(queue)\n          \n          if current_pos == target_pos:\n              return path + [4]  # Add the USE action to pick up\n      \n          visited.add(current_pos)\n          \n          for dx, dy in directions:\n              new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n              if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n                  heappush(queue, (heuristic((new_x, new_y), target_pos), (new_x, new_y), path + [directions.index((dx, dy))]))\n      \n      return []  # Return an empty list if no path is found\n\n  action_sequence = []\n  \n  while not satisfies_goal(initial_state, goal_item):\n      for primitive, count in goal_primitives.items():\n          if initial_state.inventory[primitive] < count:\n              # Find a location of the primitive\n              locations = primitive_locations[primitive]\n              if locations:\n                  x, y = locations.pop(0)\n                  path_to_primitive = move_to_and_pickup(initial_state, x, y)\n                  action_sequence.extend(path_to_primitive)\n                  \n                  # Simulate the actions to update the state\n                  for action in path_to_primitive:\n                      reward, initial_state = initial_state.step(action)\n  \n      # Try to use the collected primitives to make the goal item\n      if satisfies_goal(initial_state, goal_item):\n          break\n      \n      # If not, continue collecting missing primitives\n\n  return action_sequence", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T05:10:30.360972", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      use_actions = []\n      other_actions = []\n\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = all(new_state.inventory[primitive] >= count \n                              for primitive, count in goal_primitives.items())\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n\n          use_actions.append((action, reward, new_state))\n        else:\n          other_actions.append((action, reward, new_state))\n\n      # Prioritize USE actions that make progress\n      for action, _, new_state in sorted(use_actions, key=lambda x: -x[1]):  # Sort by negative reward to prioritize higher rewards\n        state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n      \n      # Then add other actions\n      for action, _, new_state in sorted(other_actions, key=lambda x: -x[1]):  # Sort by negative reward to prioritize higher rewards\n        state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_item_index(item_name, cookbook):\n    try:\n      return cookbook.index[item_name]\n    except KeyError:\n      raise ValueError(f\"Item '{item_name}' not found in the cookbook.\")\n\n  initial_state = env._current_state\n  goal_item_name = item\n  \n  # Convert item name to index if it's a string\n  if isinstance(item, str):\n    try:\n      goal_item = get_item_index(goal_item_name, initial_state.world.cookbook)\n    except ValueError as e:\n      print(e)\n      return []\n  else:\n    goal_item = item\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
