{"timestamp": "2025-06-26T20:18:20.905420", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_shortest_path(start_pos, goal_pos):\n      from collections import deque\n      \n      queue = deque([(start_pos, [])])\n      visited = set()\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if current_pos == goal_pos:\n              return path\n          \n          for neighbor in get_neighbors(current_pos):\n              if neighbor not in visited:\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [get_move_action(start_pos, neighbor)]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_move_action(start_pos, end_pos):\n      sx, sy = start_pos\n      ex, ey = end_pos\n      \n      if sx > ex:\n          return env.world.N_ACTIONS.DOWN\n      elif sx < ex:\n          return env.world.N_ACTIONS.UP\n      elif sy > ey:\n          return env.world.N_ACTIONS.LEFT\n      elif sy < ey:\n          return env.world.N_ACTIONS.RIGHT\n\n  def find_workshop_path(start_pos):\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if is_workshop((x, y)):\n                  path = get_shortest_path(start_pos, (x, y))\n                  if path:\n                      return path\n      return None\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the agent already has the goal item in inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Find a path to any workshop\n  workshop_path = find_workshop_path(initial_state.pos)\n  \n  if not workshop_path:\n      raise ValueError(\"No valid path to any workshop found.\")\n  \n  action_sequence = workshop_path\n  \n  # Execute the path and check again if the goal is satisfied\n  current_state = initial_state\n  for action in action_sequence:\n      _, current_state = current_state.step(action)\n      \n  if satisfies_goal(current_state, goal_item):\n      return action_sequence\n  \n  # If not, perform a BFS search to find actions to craft the item\n  full_action_sequence = bfs_search(current_state, goal_item)\n  \n  if not full_action_sequence:\n      raise ValueError(\"No valid sequence of actions found to craft the item.\")\n  \n  return action_sequence + full_action_sequence", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T20:20:26.435747", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Skip actions that lead to unchanged states\n          if (np.array_equal(new_state.grid, state.grid) and\n              np.array_equal(new_state.inventory, state.inventory) and\n              new_state.pos == state.pos and\n              new_state.dir == state.dir):\n              continue\n          \n          valid_actions.append((action, reward, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n      # Simple heuristic: number of steps needed to reach a workshop if not already there\n      pos = state.pos\n      dir_ = state.dir\n      \n      # Check if the agent is already in front of a workshop\n      x, y = pos\n      dx, dy = env.world.CRAFT_DIRECTIONS[dir_]\n      \n      # Calculate distance to nearest workshop\n      min_distance = float('inf')\n      for workshop_pos in env.world.workshop_indices:\n          wx, wy = workshop_pos\n          distance = abs(wx - (x + dx)) + abs(wy - (y + dy))\n          if distance < min_distance:\n              min_distance = distance\n      \n      # Calculate the number of steps needed to reach the nearest workshop\n      steps_to_workshop = min_distance // 2  # Assuming diagonal moves are possible\n\n      return steps_to_workshop\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, reward, new_state in get_valid_actions(current_state):\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action costs 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T20:20:27.437460", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Skip actions that lead to unchanged states\n          if (np.array_equal(new_state.grid, state.grid) and\n              np.array_equal(new_state.inventory, state.inventory) and\n              new_state.pos == state.pos and\n              new_state.dir == state.dir):\n              continue\n          \n          valid_actions.append((action, reward, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of steps to reach the goal item in the inventory\n      # If the item is not yet crafted, the heuristic should be high\n      if state.inventory[goal_item] > 0:\n          return 0\n      else:\n          # A simple estimate based on proximity to primitives or workshops\n          primitives = env.world.cookbook.primitives\n          pos = np.array(state.pos)\n          \n          # Check distances to nearest primitive or workshop\n          min_distance = float('inf')\n          for i, kind in enumerate(env.world.kinds):\n              if kind in primitives:\n                  for y in range(env.scenario.init_grid.shape[0]):\n                      for x in range(env.scenario.init_grid.shape[1]):\n                          if env.scenario.init_grid[y, x, kind] > 0:\n                              distance = np.linalg.norm(pos - np.array([y, x]))\n                              min_distance = min(min_distance, distance)\n          \n          # If no primitives found, estimate based on workshops\n          if min_distance == float('inf'):\n              for i, kind in enumerate(env.world.kinds):\n                  if kind in env.world.workshop_indices:\n                      for y in range(env.scenario.init_grid.shape[0]):\n                          for x in range(env.scenario.init_grid.shape[1]):\n                              if env.scenario.init_grid[y, x, kind] > 0:\n                                  distance = np.linalg.norm(pos - np.array([y, x]))\n                                  min_distance = min(min_distance, distance)\n          \n          return int(min_distance)\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_scores = {initial_state: 0}\n      f_scores = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          current_f_score, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, reward, new_state in get_valid_actions(current_state):\n\n              tentative_g_score = g_scores[current_state] + 1  # Assuming each step costs 1\n      \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_scores or tentative_g_score < g_scores[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_scores[new_state] = tentative_g_score\n                  f_scores[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_scores[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
