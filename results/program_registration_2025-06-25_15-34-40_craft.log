{"timestamp": "2025-06-26T08:40:15.492001", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of items in inventory needed to craft the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = {env.world.cookbook.index.get(name): count for name, count in enumerate(state.inventory)}\n      \n      missing_items = 0\n      for primitive_index, required_count in primitives.items():\n          missing_items += max(0, required_count - current_inventory.get(primitive_index, 0))\n      \n      return missing_items\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))  # f_score, state, path\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items or interacting with the environment\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Each step costs 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  \n                  # Convert the new state to a hashable form using a tuple of its attributes\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T08:40:16.520842", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: number of steps to collect all required primitives\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = current_state.inventory\n      \n      steps_required = 0\n      for primitive_idx, count in primitives_needed.items():\n          if current_inventory[primitive_idx] < count:\n              # Assuming each step can potentially gather one primitive\n              steps_required += (count - current_inventory[primitive_idx])\n      \n      return steps_required\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items or interacting with the environment\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state