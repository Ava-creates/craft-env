{"timestamp": "2025-06-26T08:41:15.979674", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n    import heapq\n    from collections import defaultdict\n\n    # Priority queue to store (cost + heuristic, cost, state, path)\n    queue = []\n    heapq.heappush(queue, (0, 0, initial_state, []))\n\n    # Dictionary to store the cost of reaching each state\n    g_costs = {}\n    g_costs[(tuple(initial_state.grid.flatten()), tuple(initial_state.inventory), initial_state.pos, initial_state.dir)] = 0\n\n    while queue:\n      _, current_cost, current_state, path = heapq.heappop(queue)\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n\n      for action in range(env.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        # Convert the new state to a hashable form using a tuple of its attributes\n        new_state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n        \n        tentative_cost = current_cost + 1  # Assuming each step costs 1\n\n        if new_state_hash not in g_costs or tentative_cost < g_costs[new_state_hash]:\n          g_costs[new_state_hash] = tentative_cost\n          heapq.heappush(queue, (tentative_cost + heuristic(new_state, goal_item), tentative_cost, new_state, path + [action]))\n\n    return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n    \"\"\"Heuristic function to estimate the cost from current state to goal.\"\"\"\n    # Simple heuristic: number of items needed minus items already in inventory\n    primitives_needed = env.world.cookbook.primitives_for(goal_item)\n    inventory_counts = {env.world.cookbook.index.get(kind_name): count for kind_name, count in enumerate(state.inventory) if count > 0}\n    \n    missing_items_cost = sum(primitives_needed.get(kind_idx, 0) - inventory_counts.get(kind_idx, 0) for kind_idx in primitives_needed)\n    return max(missing_items_cost, 0)\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
