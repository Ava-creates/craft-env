itial_state, goal_item):\n      # Try to craft the item using BFS\n      action_sequence = bfs_search(initial_state, goal_item)\n\n      if not action_sequence:\n          # If no direct path is found, gather primitives and then try again\n          primitive_actions = gather_primitives(initial_state)\n          \n          if primitive_actions:\n              new_initial_state, _ = initial_state.step(primitive_actions[-1])\n              \n              final_sequence = bfs_search(new_initial_state, goal_item)\n              action_sequence = primitive_actions + final_sequence\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = craft_item_from_primitives(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:21:14.257929", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Explore actions in a specific order to prioritize useful ones (e.g., USE action)\n          for action in [4, 0, 1, 2, 3]:  # Prioritize USE (action 4)\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic to estimate the cost from current state to the goal.\"\"\"\n      # Simple heuristic: Number of items needed - items in inventory\n      primitive_counts = env.world.cookbook.primitives_for(goal_item)\n      required_items = sum(primitive_counts.values())\n      available_items = sum(min(primitive_counts.get(i, 0), count) for i, count in enumerate(state.inventory))\n      return required_items - available_items\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      # Priority queue to hold the states along with their priority (cost + heuristic)\n      open_set = []\n      heappush(open_set, (0, 0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Explore actions in a specific order to prioritize useful ones (e.g., USE action)\n          for action in [4, 0, 1, 2, 3]:  # Prioritize USE (action 4)\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each step costs 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, next(itertools.count()), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
