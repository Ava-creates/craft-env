ction as it doesn't help make the goal item\n\n              possible_actions.append((action, new_state))\n          \n          for action, new_state in possible_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the goal item is already available in inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T11:29:49.227483", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_closest_resource(state, resource_index):\n      \"\"\"Find the closest resource of a given type using BFS.\"\"\"\n      from collections import deque\n      \n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if state.grid[current_pos[0], current_pos[1], resource_index] > 0:\n              return path\n          \n          for d in directions:\n              new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n              \n              if (0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1] and \n                  new_pos not in visited):\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [move_towards(state.pos, new_pos)]))\n      \n      return None\n\n  def move_towards(current_pos, target_pos) -> int:\n      \"\"\"Determine the action to move towards the target position.\"\"\"\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n      \n      if abs(dx) > abs(dy):\n          return 2 if dx < 0 else 3\n      else:\n          return 0 if dy < 0 else 1\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Prioritize gathering resources\n          resource_path_actions = []\n          for resource_index in goal_primitives.keys():\n              # Find the closest resource\n              resource_path = get_closest_resource(current_state, resource_index)\n              if resource_path:\n                  new_state = current_state\n                  for action in resource_path:\n                      reward, new_state = new_state.step(action)\n                  \n                  # Collect and use the resource to make progress towards the goal item\n                  if satisfies_goal(new_state, goal_item):\n                      return path + resource_path\n      \n                  resource_path_actions.extend(resource_path + [4])  # Add USE action after collecting the resource\n\n          # Expand the search space with all possible actions\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue\n      \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n          \n          # Add resource gathering actions to the queue\n          for action in resource_path_actions:\n              reward, new_state = current_state.step(action)\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:29:50.401489", "function_name": "craft", "function_body": "  def satisfies_goal(state: CraftState, goal_item: int) -> bool:\n      \"\"\"Check if the inventory contains the goal item.\"\"\"\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index: int, cookbook: Cookbook) -> dict[int, int]:\n      \"\"\"Recursively determine the required primitives to craft an item.\"\"\"\n      primitives = {}\n      \n      def dfs(current_index: int, count: int = 1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_closest_resource(state: CraftState, resource_index: int) -> list[int]:\n      \"\"\"Find the closest resource of a given type using BFS.\"\"\"\n      from collections import deque\n      \n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n      queue = deque([(state.pos, [])])\n      visited = set([state.pos])\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          # Check if the target resource is found\n          if state.grid[current_pos[0], current_pos[1], resource_index] > 0:\n              return path + [4]  # Add USE action to collect the resource\n          \n          # Explore neighboring positions\n          for direction in directions:\n              new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n              \n              if (0 <= new_pos[0] < state.grid.shape[0] and \n                  0 <= new_pos[1] < state.grid.shape[1] and \n                  new_pos not in visited):\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [direction_to_action(direction)]))\n      \n      return None\n\n  def direction_to_action(direction: tuple[int, int]) -> int:\n      \"\"\"Map a direction vector to an action index.\"\"\"\n      if direction == (0, -1):  # LEFT\n          return 2\n      elif direction == (0, 1):  # RIGHT\n          return 3\n      elif direction == (-1, 0):  # UP\n          return 0\n      elif direction == (1, 0):  # DOWN\n          return 1\n\n  def bfs_search(initial_state: CraftState, goal_item: int) -> list[int]:\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Find paths to collect required resources\n          for resource_index in goal_primitives.keys():\n              resource_path = get_closest_resource(current_state, resource_index)\n              if resource_path:\n                  new_state = current_state\n                  for action in resource_path:\n                      reward, new_state = new_state.step(action)\n                  \n                  # Check if the new state satisfies the goal after collecting resources\n                  if satisfies_goal(new_state, goal_item):\n                      return path + resource_path\n                  elif any(satisfies_goal(state, resource_index) for state, _ in queue):\n                      continue  # Skip if resource already queued for collection\n                  else:\n                      # Add new states to the queue with updated paths and inventory\n                      state_hash = (tuple(new_state.grid.flatten()), \n                                    tuple(new_state.inventory), \n                                    new_state.pos, \n                                    new_state.dir)\n                      visited.add(state_hash)\n                      queue.append((new_state, path + resource_path))\n          \n          # Explore other possible actions\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue\n      \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:31:57.364603", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Filter actions based on available inventory and required primitives\n        for action in range(initial_state.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def find_path(initial_state, goal_item):\n      \"\"\"Finds the shortest path to achieve the goal item using BFS.\"\"\"\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(current_state, goal_primitives):\n    \"\"\"Prioritize actions based on the current state and required primitives.\"\"\"\n    priority_actions = []\n    \n    for action in range(current_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n            # Check if the use action can contribute to making the goal item\n            can_make_goal = True\n            for primitive, count in goal_primitives.items():\n                if new_state.inventory[primitive] < count:\n                    can_make_goal = False\n                    break\n            \n            if not can_make_goal:\n                continue  # Skip this action as it doesn't help make the goal item\n        \n        priority_actions.append((action, reward, new_state))\n    \n    # Sort actions based on the amount of primitives collected or used\n    priority_actions.sort(key=lambda x: sum(x[2].inventory), reverse=True)\n    return [action for action, _, _ in priority_actions]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n  max_attempts = 10  # Increase attempts to handle more complex recipes\n  attempts = 0\n      \n  while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n      path = bfs_search(initial_state, goal_item)\n      if path is None:\n          break\n      \n      action_sequence.extend(path)\n      \n      # Apply the found actions to the environment\n      for action in path:\n          reward, done, observations = env.step(action)\n          \n          if done or satisfies_goal(env._current_state, goal_item):\n              return action_sequence\n      \n      initial_state = env._current_state\n      attempts += 1\n\n  return action_sequence if satisfies_goal(env._current_state, goal_item) else []", "island_id": 3, "scores": {"3": 2.0}}
