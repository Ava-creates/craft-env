{"timestamp": "2025-06-27T10:31:04.664775", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(current_state, goal_primitives):\n      # Calculate a simple heuristic based on the number of missing primitives\n      missing_count = 0\n      for primitive, required_count in goal_primitives.items():\n          if current_state.inventory[primitive] < required_count:\n              missing_count += required_count - current_state.inventory[primitive]\n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, get_primitive_counts(goal_item, initial_state.world.cookbook)), \n                                 initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, get_primitive_counts(goal_item, initial_state.world.cookbook))}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Sort actions based on potential to contribute to making the goal item\n          sorted_actions = []\n          use_actions = []\n\n          for action in range(current_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if can_make_goal:\n                      use_actions.append((action, reward, new_state))\n              else:\n                  sorted_actions.append((action, reward, new_state))\n\n          # Prioritize USE actions that contribute to the goal\n          sorted_actions.extend(use_actions)\n\n          for action, _, new_state in sorted_actions:\n              tentative_g_score = g_score[current_state] + 1  # Assume cost of each action is 1\n\n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_primitives)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.kinds:\n      raise ValueError(f\"Goal item with index {goal_item} is not recognized.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
