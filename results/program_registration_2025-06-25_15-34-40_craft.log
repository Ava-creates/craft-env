{"timestamp": "2025-06-27T06:45:34.505622", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal\n          sorted_valid_actions = sorted(\n              valid_actions,\n              key=lambda x: -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives)\n          )\n          \n          for new_state, action in sorted_valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_valid_actions(state):\n      actions = []\n      for action in range(state.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state has changed\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append(action)\n      \n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid\n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(f\"Goal item index {goal_item} is not a valid item.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T06:47:39.381810", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      \"\"\"Heuristic to estimate how close the state is to having all required primitives.\"\"\"\n      current_inventory = np.array([state.inventory[primitive] for primitive in goal_primitives.keys()])\n      required_counts = np.array(list(goal_primitives.values()))\n      progress = np.minimum(current_inventory, required_counts)\n      return -np.sum(progress)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store (heuristic_value, path_length, state, path)\n      open_set = []\n      heapq.heappush(open_set, (0, 0, initial_state, []))\n      \n      # Dictionary to store the cheapest path found so far for each state\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): 0}\n      \n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      while open_set:\n          _, path_length, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Ensure we don't revisit the same state unnecessarily\n          state_hash = tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos + (current_state.dir,)\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              new_state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + new_state.pos + (new_state.dir,)\n              tentative_g_score = path_length + 1\n\n              if new_state_hash not in g_score or tentative_g_score < g_score[new_state_hash]:\n                  g_score[new_state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_primitives)\n                  heapq.heappush(open_set, (f_score, tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(action_sequence):\n      optimized_sequence = []\n      i = 0\n      while i < len(action_sequence):\n          current_action = action_sequence[i]\n          \n          # Check for consecutive USE actions and merge them into a single step\n          if current_action == 4:  # USE action\n              use_count = 1\n              while (i + 1 < len(action_sequence) and \n                     action_sequence[i + 1] == 4):\n                  i += 1\n                  use_count += 1\n              \n              # Add a single USE action for each group of consecutive USE actions\n              optimized_sequence.extend([current_action] * use_count)\n          else:\n              optimized_sequence.append(current_action)\n          \n          i += 1\n      \n      return optimized_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T06:47:40.573803", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      \"\"\"Heuristic to estimate how close the state is to having all required primitives.\"\"\"\n      return -sum(min(state.inventory[primitive], goal_primitives.get(primitive, 0)) for primitive in goal_primitives)\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue with initial state and its heuristic value\n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_primitives), 0, initial_state, []))\n      \n      # Dictionary to store the g_score for each state (distance from start)\n      g_score = {state_hash(initial_state): 0}\n      \n      while open_set:\n          _, current_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              state_hash_new = state_hash(new_state)\n              \n              tentative_g_score = current_cost + 1  # Each action costs 1\n      \n              if state_hash_new not in g_score or tentative_g_score < g_score[state_hash_new]:\n                  g_score[state_hash_new] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_primitives)\n                  heapq.heappush(open_set, (f_score, tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      \"\"\"Generate a hashable representation of the state.\"\"\"\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n\n  def optimize_actions(action_sequence):\n      optimized_sequence = []\n      i = 0\n      while i < len(action_sequence):\n          current_action = action_sequence[i]\n          \n          # Check for consecutive USE actions and merge them into a single step\n          if current_action == 4:  # USE action\n              use_count = 1\n              while (i + 1 < len(action_sequence) and \n                     action_sequence[i + 1] == 4):\n                  i += 1\n                  use_count += 1\n              \n              # Add a single USE action for each group of consecutive USE actions\n              optimized_sequence.extend([current_action] * use_count)\n          else:\n              optimized_sequence.append(current_action)\n          \n          i += 1\n      \n      return optimized_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T06:49:26.094952", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n\n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal and move closer to required ingredients\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives),  # More primitives used first\n                  sum(initial_state.next_to(primitive) for primitive in goal_primitives),    # Closer to ingredients first\n                  len([ingredient for ingredient, count in goal_primitives.items() if new_state.inventory[ingredient] < count])  # Fewer missing primitives first\n              )\n          )\n\n          filtered_actions = []\n          for new_state, action in sorted_possible_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  filtered_actions.append((new_state, action))\n          \n          for new_state, action in filtered_actions:\n              queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid\n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(f\"Goal item index {goal_item} is not a valid item.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
