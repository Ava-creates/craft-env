l_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid and has a recipe or is primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item index {goal_item} is not recognized.\")\n  \n  action_sequence = craft_recursively(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:16:18.375844", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state):\n      cookbook = env.world.cookbook\n      goal_item = item\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      action_sequence = []\n      current_state = initial_state\n      \n      for primitive_index in primitives_needed:\n          # Collect the primitive\n          collect_action_sequence = bfs_search(current_state, primitive_index)\n          if collect_action_sequence:\n              action_sequence.extend(collect_action_sequence)\n              \n              # Update the state after collecting the primitive\n              for action in collect_action_sequence:\n                  _, current_state = current_state.step(action)\n      \n      return action_sequence, current_state\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      collect_action_sequence, updated_state = collect_primitives(env, initial_state)\n      \n      if collect_action_sequence:\n          action_sequence.extend(collect_action_sequence)\n          \n          # Try crafting again after collecting primitives\n          craft_action_sequence = bfs_search(updated_state, goal_item)\n          if craft_action_sequence:\n              action_sequence.extend(craft_action_sequence)\n              return action_sequence\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:16:34.017803", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state):\n      cookbook = env.world.cookbook\n      goal_item = item\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      action_sequence = []\n      current_state = initial_state\n      \n      for primitive_index in primitives_needed:\n          # Collect the primitive\n          collect_action_sequence = bfs_search(current_state, primitive_index)\n          if collect_action_sequence:\n              action_sequence.extend(collect_action_sequence)\n              \n              # Update the state after collecting the primitive\n              for action in collect_action_sequence:\n                  _, current_state = current_state.step(action)\n      \n      return action_sequence, current_state\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      collect_action_sequence, updated_state = collect_primitives(env, initial_state)\n      \n      if collect_action_sequence:\n          action_sequence.extend(collect_action_sequence)\n          \n          # Try crafting again after collecting primitives\n          craft_action_sequence = bfs_search(updated_state, goal_item)\n          if craft_action_sequence:\n              action_sequence.extend(craft_action_sequence)\n              return action_sequence\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:18:09.534570", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize actions that involve using items (USE action)\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state):\n    \"\"\"Heuristic function using Manhattan distance to the nearest required item.\"\"\"\n    distances = []\n    \n    for i_kind in range(len(env.world.cookbook.primitives)):\n        goal_idx = env.world.cookbook.index.get(i_kind)\n        \n        if goal_idx is not None and state.inventory[goal_idx] == 0:\n            min_dist = float('inf')\n            \n            # Find the nearest required item\n            for x in range(env.world.grid.shape[0]):\n                for y in range(env.world.grid.shape[1]):\n                    if state.grid[x, y, goal_idx] > 0:\n                        dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                        min_dist = min(min_dist, dist)\n            \n            distances.append(min_dist)\n        else:\n            distances.append(0)\n    \n    return sum(distances)\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items (USE action)\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt BFS search first for efficiency\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n      return action_sequence\n  \n  # If BFS fails, attempt to find a path using A* search with heuristic\n  action_sequence = a_star_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:18:10.558267", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function using Manhattan distance to the nearest required item.\"\"\"\n      distances = []\n      for i_kind in range(len(env.world.cookbook.primitives)):\n          goal_idx = env.world.cookbook.index.get(i_kind)\n          \n          if goal_idx is not None and state.inventory[goal_idx] == 0:\n              min_dist = float('inf')\n              \n              # Find the nearest required item\n              for x in range(env.world.grid.shape[0]):\n                  for y in range(env.world.grid.shape[1]):\n                      if state.grid[x, y, goal_idx] > 0:\n                          dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                          min_dist = min(min_dist, dist)\n              \n              distances.append(min_dist)\n          else:\n              distances.append(0)\n      \n      return sum(distances)\n\n  def a_star_search(initial_state, goal_item, max_steps=500):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize actions that involve using items (USE action)\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:19:20.574647", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # A simple heuristic that counts the number of items in the inventory\n      # towards the goal item. The fewer items needed, the better.\n      needed_count = env.world.cookbook.primitives_for(goal_item).get(goal_item, 0)\n      current_count = state.inventory[goal_item]\n      return needed_count - current_count\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store (cost + heuristic, cost, path, state)\n      queue = []\n      start_cost = 0\n      start_path = []\n      \n      # Use a dictionary for faster lookup of costs and paths\n      g_costs = {initial_state: start_cost}\n      f_costs = {initial_state: start_cost + heuristic(initial_state, goal_item)}\n      \n      heapq.heappush(queue, (f_costs[initial_state], start_cost, start_path, initial_state))\n      visited_states = set()\n      \n      while queue:\n          _, current_cost, path, current_state = heapq.heappop(queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate possible next states and actions\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited_states:\n                  visited_states.add(state_hash)\n\n                  # Calculate cost and heuristic for the new state\n                  tentative_g_cost = current_cost + 1\n                  if new_state not in g_costs or tentative_g_cost < g_costs[new_state]:\n                      g_costs[new_state] = tentative_g_cost\n                      f_costs[new_state] = tentative_g_cost + heuristic(new_state, goal_item)\n                      heapq.heappush(queue, (f_costs[new_state], tentative_g_cost, path + [action], new_state))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      print(\"Item already in inventory.\")\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(f\"No actions found to craft {item}.\")\n      return []\n\n  # Execute the action sequence\n  for action in action_sequence:\n      env.step(action)\n      \n  return action_sequence", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:19:25.307323", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def dfs_search(initial_state, goal_item, path=[], visited_states=None):\n      if visited_states is None:\n          visited_states = set()\n      \n      # Convert the current state to a hashable form\n      state_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n      \n      # Check for goal satisfaction\n      if satisfies_goal(initial_state, goal_item):\n          return path\n      \n      # Mark the current state as visited\n      visited_states.add(state_hash)\n      \n      # Explore possible actions in a specific order (e.g., prioritize use action first)\n      prioritized_actions = [4] + list(range(4))  # Use -> Down, Up, Left, Right\n      \n      for action in prioritized_actions:\n          reward, new_state = initial_state.step(action)\n          \n          # Convert the new state to a hashable form\n          new_state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n          \n          if new_state_hash not in visited_states:\n              result_path = dfs_search(new_state, goal_item, path + [action], visited_states)\n              if result_path is not None:\n                  return result_path\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      print(\"Item already in inventory.\")\n      return []\n  \n  action_sequence = dfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(f\"No actions found to craft {item}.\")\n      return []\n\n  # Execute the action sequence\n  for action in action_sequence:\n      env.step(action)\n      \n  return action_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:20:20.917208", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate all possible next states and actions\n          possible_actions = []\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited_states:\n                  possible_actions.append((new_state, action))\n                  visited_states.add(state_hash)\n          \n          # Prioritize actions that lead to a closer position to the goal\n          def heuristic(action):\n              new_state = action[0]\n              distance_to_goal = np.linalg.norm(np.array(new_state.pos) - np.array(current_state.pos), ord=1)\n              return distance_to_goal  # Lower is better\n          \n          possible_actions.sort(key=lambda x: heuristic(x))  # Sort by heuristic value\n          \n          for new_state, action in possible_actions:\n              queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:20:36.649681", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_action_priority(action):\n      # Prioritize 'USE' action over movement\n      if action == 4:  # USE\n          return -1\n      elif action < 4:  # DOWN, UP, LEFT, RIGHT\n          return 0\n      else:\n          return 1  # Other actions if any\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate actions and sort them based on priority\n          actions = list(range(env.world.n_actions))\n          actions.sort(key=get_action_priority)\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:21:36.804566", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n  \n  def get_next_states(current_state):\n      next_states = []\n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Only consider valid moves\n          if (0 <= new_state.pos[0] < env.scenario.init_grid.shape[0] and \n              0 <= new_state.pos[1] < env.scenario.init_grid.shape[1]):\n              \n              next_states.append((action, new_state))\n      \n      return next_states\n  \n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_next_states(current_state):\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n      # Execute the actions to reach the goal state\n      for action in action_sequence:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.5}}
