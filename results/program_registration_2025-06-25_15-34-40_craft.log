tion)\n      new_inventory_count = sum(new_state.inventory[primitive] for primitive in primitives_required)\n      return -new_inventory_count\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is None:\n      raise ValueError(\"No sequence of actions found to craft the item.\")\n\n  # Further optimization: If the action sequence leads to a dead end, try alternative paths\n  def dfs_with_backtracking(state, path, max_depth=50):\n      if satisfies_goal(state, goal_item):\n          return path\n      \n      if len(path) >= max_depth:\n          return None\n      \n      for action in sorted(range(env.world.n_actions), key=lambda x: heuristic(x, state)):\n          reward, new_state = state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              result = dfs_with_backtracking(new_state, path + [action], max_depth)\n              \n              if result is not None:\n                  return result\n      \n      return None\n\n  # Reset visited set for DFS\n  visited = set()\n  \n  optimized_action_sequence = dfs_with_backtracking(initial_state, [])\n  \n  if optimized_action_sequence is None:\n      raise ValueError(\"No valid sequence of actions found to craft the item.\")\n  \n  return optimized_action_sequence", "island_id": 4, "scores": {"3": 0.9}}
{"timestamp": "2025-06-26T19:09:22.961143", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  # Assuming actions are enumerated from 0 to n_actions-1\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def bfs_search(initial_state, goal_item, max_steps=500):  # Added a max_steps parameter to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: the number of items still needed to craft the goal\n      cookbook = env.world.cookbook\n      recipe = cookbook.recipes.get(goal_item, {})\n      \n      current_inventory = state.inventory.copy()\n      required_counts = {ingredient: count for ingredient, count in recipe.items() if isinstance(ingredient, int)}\n      \n      total_needed = sum(count - current_inventory[ingredient] if current_inventory[ingredient] < count else 0\n                         for ingredient, count in required_counts.items())\n      \n      return total_needed\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for new_state, action, state_hash in get_neighbor_states(current_state):\n              tentative_g_score = g_score[current_state] + 1  # Assuming each step has a cost of 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  \n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      while current_state in came_from:\n          current_state, action = came_from[current_state]\n          total_path.insert(0, action)\n      return total_path\n  \n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
