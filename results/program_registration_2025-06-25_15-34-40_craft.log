{"timestamp": "2025-06-27T15:07:56.241494", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(current_state, goal_item):\n      # Calculate the number of steps to collect all required primitives\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      steps_to_collect_primitives = sum(\n          (goal_primitives.get(primitive, 0) - current_state.inventory[primitive])\n          for primitive in goal_primitives\n      )\n      \n      # Use the number of primitives still needed as a heuristic\n      return steps_to_collect_primitives\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      \n      came_from = {}\n      g_score = {hash(tuple((tuple(initial_state.grid.flatten()), \n                              tuple(initial_state.inventory), \n                              initial_state.pos, \n                              initial_state.dir))): 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n  