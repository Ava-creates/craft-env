{"timestamp": "2025-06-27T05:48:06.945118", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal, satisfied_primitives_count = can_make_use_action(new_state, goal_primitives)\n                  if can_make_goal:\n                      possible_actions.append((action, 'use', satisfied_primitives_count))\n              else:\n                  possible_actions.append((action, 'move', 0))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action_type = action_tuple[1]\n              if action_type == 'use':\n                  return (-action_tuple[2],)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]  # Return immediately upon achieving the goal\n      \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def can_make_use_action(state, goal_primitives):\n      satisfied_primitives_count = sum(\n          state.inventory[primitive] >= count \n          for primitive, count in goal_primitives.items()\n      )\n      can_make_goal = satisfied_primitives_count == len(goal_primitives)\n      return can_make_goal, satisfied_primitives_count\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
