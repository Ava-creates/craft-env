{"timestamp": "2025-06-26T14:46:13.023308", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Avoid revisiting states that have been visited with the same inventory and position\n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if state_key not in visited_states:\n                  visited_states.add(state_key)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic based on the number of items needed to craft the goal.\"\"\"\n      recipe = env.world.cookbook.recipes.get(goal_item, {})\n      inventory = state.inventory\n      missing_items = sum(max(0, recipe[i] - inventory[i]) for i in recipe if i != \"_key\")\n      return missing_items\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited_states = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Avoid revisiting states that have been visited with the same inventory and position\n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if state_key not in visited_states:\n                  visited_states.add(state_key)\n                  cost = len(path) + 1\n                  priority = cost + heuristic(new_state, goal_item)\n                  heappush(open_set, (priority, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:46:14.037225", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of missing items needed to craft the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory.copy()\n      missing_count = 0\n      \n      for primitive_index, count in primitives.items():\n          if current_inventory[primitive_index] < count:\n              missing_count += (count - current_inventory[primitive_index])\n      \n      return missing_count\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      from collections import deque\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      visited_states = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Avoid revisiting states that have been visited with the same inventory and position\n              if state_key not in visited_states:\n                  visited_states.add(state_key)\n                  \n                  g_score = len(path) + 1\n                  f_score = g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:47:50.227740", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Prioritize USE actions to speed up crafting\n        use_actions = [4]  # Assuming USE action is indexed as 4\n        other_actions = list(set(range(env.world.n_actions)) - set(use_actions))\n        \n        for action in use_actions + other_actions:\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    \n    action_sequence = []\n    \n    for primitive in primitives_needed:\n        # Collect the primitive\n        collect_action_sequence = bfs_search(initial_state, primitive)\n        \n        if not collect_action_sequence:\n            return None  # If we can't collect a required primitive, fail\n        \n        action_sequence.extend(collect_action_sequence)\n        \n        # After collecting, try crafting again\n        new_state = initial_state\n        for action in collect_action_sequence:\n            _, new_state = new_state.step(action)\n    \n    return action_sequence\n\n  def craft_with_primitives(env, initial_state, goal_item):\n    cookbook = env.world.cookbook\n    \n    if goal_item not in cookbook.recipes:\n        return None  # If the item doesn't have a recipe, we can't craft it\n    \n    recipe = cookbook.recipes[goal_item]\n    \n    action_sequence = []\n    \n    for ingredient_index, count in recipe.items():\n        if ingredient_index == \"_key\":\n            continue\n        \n        while initial_state.inventory[ingredient_index] < count:\n            # Collect the required amount of the ingredient\n            collect_action_sequence = bfs_search(initial_state, ingredient_index)\n            \n            if not collect_action_sequence:\n                return None  # If we can't collect a required ingredient, fail\n            \n            action_sequence.extend(collect_action_sequence)\n            \n            # After collecting, try crafting again\n            new_state = initial_state\n            for action in collect_action_sequence:\n                _, new_state = new_state.step(action)\n    \n    # Now that we have all ingredients, craft the item\n    initial_state = env._current_state  # Reset to the actual state after collecting ingredients\n    craft_action_sequence = bfs_search(initial_state, goal_item)\n    \n    if not craft_action_sequence:\n        return None  # If crafting fails, return no actions\n    \n    action_sequence.extend(craft_action_sequence)\n    \n    return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      primitive_action_sequence = collect_primitives(env, initial_state, goal_item)\n      \n      if not primitive_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(primitive_action_sequence)\n      \n      # After collecting primitives, try crafting again\n      new_state = initial_state\n      for action in primitive_action_sequence:\n          _, new_state = new_state.step(action)\n      \n      craft_with_primitives_sequence = craft_with_primitives(env, new_state, goal_item)\n      if not craft_with_primitives_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(craft_with_primitives_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:48:05.797216", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, action_limit=None):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          use_actions = [4]  # Assuming USE action is indexed as 4\n          other_actions = list(set(range(env.world.n_actions)) - set(use_actions))\n          \n          for action in use_actions + other_actions:\n              if action_limit is not None and len(path) >= action_limit:\n                  continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      action_sequence = []\n      \n      for primitive in primitives_needed:\n          # Collect the primitive\n          collect_action_sequence = bfs_search(initial_state, primitive)\n          \n          if not collect_action_sequence:\n              return None  # If we can't collect a required primitive, fail\n          \n          action_sequence.extend(collect_action_sequence)\n          \n          # After collecting, try crafting again\n          new_state = initial_state\n          for action in collect_action_sequence:\n              _, new_state = new_state.step(action)\n      \n      return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      primitive_action_sequence = collect_primitives(env, initial_state, goal_item)\n      \n      if not primitive_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(primitive_action_sequence)\n      \n      # After collecting primitives, try crafting again\n      new_state = initial_state\n      for action in primitive_action_sequence:\n          _, new_state = new_state.step(action)\n      \n      craft_action_sequence = bfs_search(new_state, goal_item)\n      if not craft_action_sequence:\n          return []  # Return empty list if no actions found\n      \n      action_sequence.extend(craft_action_sequence)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:49:27.676208", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def prioritize_actions(current_state):\n      priority_actions = []\n      \n      # Prioritize the USE action\n      reward, use_state = current_state.step(4)\n      if not np.array_equal(use_state.grid, current_state.grid) or\\\n         not np.array_equal(use_state.inventory, current_state.inventory) or\\\n         use_state.pos != current_state.pos or\\\n         use_state.dir != current_state.dir:\n          priority_actions.append((4, use_state))\n      \n      # Prioritize moving actions\n      for action in range(4):\n          reward, move_state = current_state.step(action)\n          if not np.array_equal(move_state.grid, current_state.grid) or\\\n             not np.array_equal(move_state.inventory, current_state.inventory) or\\\n             move_state.pos != current_state.pos or\\\n             move_state.dir != current_state.dir:\n              priority_actions.append((action, move_state))\n      \n      return [action for action, _ in sorted(priority_actions, key=lambda x: -x[1].inventory[item])]\n\n  def iddfs(initial_state, goal_item, max_depth):\n      def dfs(current_state, path, depth):\n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if depth == 0:\n              return None\n          \n          priority_actions = prioritize_actions(current_state)\n          for action in priority_actions + [action for action in range(env.world.n_actions) if action not in priority_actions]:\n              reward, new_state = current_state.step(action)\n              \n              result = dfs(new_state, path + [action], depth - 1)\n              if result:\n                  return result\n          \n          return None\n      \n      for depth in range(max_depth):\n          result = dfs(initial_state, [], depth)\n          if result:\n              return result\n      \n      return None\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = iddfs(initial_state, goal_item, max_depth=50)  # Adjust max_depth as needed\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:49:44.917375", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def prioritize_actions(current_state):\n      priority_actions = []\n      \n      # Prioritize the USE action\n      reward, use_state = current_state.step(4)\n      if not np.array_equal(use_state.grid, current_state.grid) or\\\n         not np.array_equal(use_state.inventory, current_state.inventory) or\\\n         use_state.pos != current_state.pos or\\\n         use_state.dir != current_state.dir:\n          priority_actions.append((4, use_state))\n      \n      # Prioritize moving actions\n      for action in range(4):\n          reward, move_state = current_state.step(action)\n          if not np.array_equal(move_state.grid, current_state.grid) or\\\n             not np.array_equal(move_state.inventory, current_state.inventory) or\\\n             move_state.pos != current_state.pos or\\\n             move_state.dir != current_state.dir:\n              priority_actions.append((action, move_state))\n      \n      return [action for action, _ in sorted(priority_actions, key=lambda x: -x[1].inventory[item])]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get prioritized actions based on their potential to reach the goal faster\n          priority_actions = prioritize_actions(current_state)\n          for action in priority_actions + [action for action in range(env.world.n_actions) if action not in priority_actions]:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:50:53.402020", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbors.append((new_state, state_hash, action))\n      \n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, state_hash, action in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def dfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      stack = deque([(initial_state, [])])\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, state_hash, action in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try BFS first\n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  # If BFS fails, try DFS\n  if not action_sequence:\n      action_sequence = dfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:50:54.416064", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbors.append((new_state, state_hash, action))\n      \n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, state_hash, action in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      # A simple heuristic that can be improved\n      # For now, just return the number of steps taken so far\n      return len(path)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, state_hash, action in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  new_path = path + [action]\n                  f_score = len(new_path) + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, new_path))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  # If the action sequence is not found, attempt to reset the environment and try again\n  if not action_sequence:\n      env.reset()\n      initial_state = env._current_state\n      action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
