{"timestamp": "2025-06-26T22:50:52.222924", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_valid_actions(state):\n      actions = []\n      for action in range(state.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state has changed\n          if not np.array_equal(new_state.grid, state.grid) or \\\n             not np.array_equal(new_state.inventory, state.inventory) or \\\n             new_state.pos != state.pos or \\\n             new_state.dir != state.dir:\n              actions.append(action)\n      \n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid\n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(f\"Goal item index {goal_item} is not a valid item.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T22:51:03.647842", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T22:52:27.943341", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos, grid, target_kind):\n      \"\"\"Heuristic based on Manhattan distance to the nearest accessible cell with the target kind.\"\"\"\n      min_distance = float('inf')\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, target_kind] > 0:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state.pos, initial_state.grid, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state.pos, new_state.grid, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state):\n      total_path = []\n      while current_state in came_from:\n          _, action, path = came_from[current_state]\n          total_path.append(action)\n          current_state = came_from[current_state][0]\n      return total_path[::-1]\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:52:29.182871", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos, grid, target_kind):\n      \"\"\"Heuristic based on Manhattan distance to the nearest accessible cell with the target kind.\"\"\"\n      min_distance = float('inf')\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, target_kind] > 0:\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))  # (f_score, state, path)\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Each action has a cost of 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state.pos, new_state.grid, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      state_hash = (tuple(current_state.grid.flatten()), \n                    tuple(current_state.inventory), \n                    current_state.pos, \n                    current_state.dir)\n      while state_hash in came_from:\n          current_state, path = came_from[state_hash]\n          total_path = path + [total_path[-1]]\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n      return total_path[::-1]  # Reverse the path to get it from start to goal\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:54:14.105145", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = True\n          # Check if the use action can contribute to making the goal item\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n    for action in actions:\n      reward, done, observations = env.step(action)\n      if done:\n        break\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n    return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    execute_actions(env, action_sequence)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T22:54:24.106107", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    actions_taken = []  # Track actions taken to reach each state\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = True\n          # Check if the use action can contribute to making the goal item\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n      \n      # Update actions_taken for the current state\n      actions_taken.extend(path)\n    \n    return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n    for action in actions:\n      reward, done, observations = env.step(action)\n      if done:\n        break\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n    return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    execute_actions(env, action_sequence)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T22:56:05.501553", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Consider only valid actions (e.g., not walking into walls)\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              # If the state is unchanged, skip adding it to the queue\n              if np.array_equal(new_state.grid, current_state.grid) and\\\n                 np.array_equal(new_state.inventory, current_state.inventory) and\\\n                 new_state.pos == current_state.pos and\\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T22:56:06.778471", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Consider only valid actions (e.g., not walking into walls)\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              # Skip adding unchanged states to the queue\n              if np.array_equal(new_state.grid, current_state.grid) and\\\n                 np.array_equal(new_state.inventory, current_state.inventory) and\\\n                 new_state.pos == current_state.pos and\\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic: number of items needed to craft the goal.\"\"\"\n      cookbook = env.world.cookbook\n      primitives = cookbook.primitives_for(goal_item)\n      return sum(max(0, primitives.get(item_idx, 0) - state.inventory[item_idx]) for item_idx in primitives.keys())\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              # Skip adding unchanged states to the queue\n              if np.array_equal(new_state.grid, current_state.grid) and\\\n                 np.array_equal(new_state.inventory, current_state.inventory) and\\\n                 new_state.pos == current_state.pos and\\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              tentative_g_score = g_score[current_state] + 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n          (current, action) = came_from[current]\n          total_path.append(action)\n      return list(reversed(total_path))\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:57:44.942106", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Skip actions that lead to unchanged states\n          if (np.array_equal(new_state.grid, state.grid) and\n              np.array_equal(new_state.inventory, state.inventory) and\n              new_state.pos == state.pos and\n              new_state.dir == state.dir):\n              continue\n          \n          valid_actions.append((action, reward, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items needed to craft the goal minus available\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory.copy()\n      \n      total_cost = 0\n      for primitive, count in primitives_needed.items():\n          required = count - current_inventory[primitive]\n          if required > 0:\n              total_cost += required\n      \n      return total_cost\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, [], 0))  # (f, state, path, steps)\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path, steps = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, reward, new_state in get_valid_actions(current_state):\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action costs 1\n      \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path, steps)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action], steps + 1))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:57:46.200707", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Skip actions that lead to unchanged states\n          if (np.array_equal(new_state.grid, state.grid) and\n              np.array_equal(new_state.inventory, state.inventory) and\n              new_state.pos == state.pos and\n              new_state.dir == state.dir):\n              continue\n          \n          valid_actions.append((action, reward, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of primitives needed to craft the goal item\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      # Calculate the total number of primitives needed in the inventory\n      primitive_count = sum(primitives_needed.values())\n      \n      return primitive_count - np.sum([state.inventory[primitive] for primitive in primitives_needed.keys()])\n\n  def a_star_search(initial_state, goal_item, max_steps=100):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state, goal_item), initial_state, [], 0))  # (f_score, state, path, steps)\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path, steps = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if steps >= max_steps:\n              continue\n\n          for action, reward, new_state in get_valid_actions(current_state):\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assume each step has cost 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action], steps + 1))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:59:50.359781", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Heuristic: Prioritize actions that move closer to having required primitives\n              new_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n              heuristic_score = sum(min(new_primitives.get(primitive, 0) - current_primitives, 0)\n                                    for primitive, current_primitives in goal_primitives.items())\n              \n              valid_actions.append((new_state, action, heuristic_score))\n          \n          # Sort actions by heuristic score (descending order)\n          valid_actions.sort(key=lambda x: x[2], reverse=True)\n          \n          for new_state, action, _ in valid_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T23:00:02.826587", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      state_to_goal_primitives = {state_hash(initial_state): get_primitive_counts(goal_item, initial_state.world.cookbook)}\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item from the cache or compute them\n          goal_primitives = state_to_goal_primitives[state_hash(current_state)]\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Heuristic: Prioritize actions that move closer to having required primitives\n              new_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n              heuristic_score = sum(min(new_primitives.get(primitive, 0) - current_primitives, 0)\n                                    for primitive, current_primitives in goal_primitives.items())\n              \n              valid_actions.append((new_state, action, heuristic_score))\n          \n          # Sort actions by heuristic score (descending order)\n          valid_actions.sort(key=lambda x: x[2], reverse=True)\n          \n          for new_state, action, _ in valid_actions:\n              new_state_hash = state_hash(new_state)\n              if new_state_hash not in visited:\n                  visited.add(new_state_hash)\n                  queue.append((new_state, path + [action]))\n                  # Cache the primitives needed for the goal item at this new state\n                  state_to_goal_primitives[new_state_hash] = get_primitive_counts(goal_item, new_state.world.cookbook)\n      \n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      \"\"\"Returns a hashable representation of the state.\"\"\"\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T23:01:14.526275", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming 'USE' is the action with index 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4)\n          \n          all_actions = use_actions + other_actions\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  initial_state = env._current_state\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T23:01:15.846515", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_available_actions(state):\n      available_actions = []\n      for action in range(env.world.n_actions):\n          if action == 4:  # Assuming 'USE' is the action with index 4\n              if any(state.inventory[i] > 0 for i in env.world.cookbook.primitives):\n                  available_actions.append(action)\n          else:\n              available_actions.append(action)\n      return available_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          available_actions = get_available_actions(current_state)\n          \n          for action in available_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  initial_state = env._current_state\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T23:03:07.040226", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def heuristic(state, goal_item):\n      # Heuristic based on distance to nearest required primitive or workshop\n      primitives_required = env.world.cookbook.primitives_for(goal_item)\n      grid = state.grid\n      pos = state.pos\n      \n      distances = []\n      \n      for idx in primitives_required:\n          if any(grid[:, :, idx]):\n              # Find the closest instance of this primitive\n              positions = np.argwhere(grid[:, :, idx])\n              closest_pos = min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n              distances.append(abs(closest_pos[0] - pos[0]) + abs(closest_pos[1] - pos[1]))\n          else:\n              # If primitive is not in the grid, prioritize getting to a workshop\n              if any(grid[:, :, env.world.workshop_indices]):\n                  positions = np.argwhere(grid[:, :, env.world.workshop_indices])\n                  closest_pos = min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n                  distances.append(abs(closest_pos[0] - pos[0]) + abs(closest_pos[1] - pos[1]))\n              else:\n                  # If no workshop, prioritize getting to the nearest grabbable item\n                  if any(grid[:, :, env.world.grabbable_indices]):\n                      positions = np.argwhere(grid[:, :, env.world.grabbable_indices])\n                      closest_pos = min(positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n                      distances.append(abs(closest_pos[0] - pos[0]) + abs(closest_pos[1] - pos[1]))\n                  else:\n                      # If no items or workshops, prioritize moving\n                      return 0\n      \n      return sum(distances) if distances else 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine the agent's position and grid shape\n          pos = current_state.pos\n          grid_shape = current_state.grid.shape[:2]\n          \n          # Consider moving to adjacent cells or using an item\n          neighbors = get_neighbors(pos, grid_shape)\n          actions = [(i, action) for i, (nx, ny) in enumerate(neighbors) for action in range(env.world.n_actions - 1)]\n          actions.append((4, env.world.n_actions - 1))  # USE action\n\n          # Sort actions based on heuristic\n          actions.sort(key=lambda x: heuristic(current_state.step(x[1])[1], goal_item))\n          \n          for _, action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T23:03:24.226512", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the number of required primitives in inventory\n      primitives_required = env.world.cookbook.primitives_for(goal_item)\n      current_inventory_count = sum(state.inventory[primitive] for primitive in primitives_required)\n      return -current_inventory_count\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine the agent's position and grid shape\n          pos = current_state.pos\n          grid_shape = current_state.grid.shape[:2]\n          \n          # Consider moving to adjacent cells or using an item\n          for action in range(env.world.n_actions):\n              if action < 4:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n                  new_pos = get_neighbors(pos, grid_shape)[action % 4]  # Ensure valid index\n                  reward, new_state = current_state.step(action)\n              else:  # USE action\n                  reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T23:04:33.675477", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(action, current_state, goal_item):\n      # Higher priority for USE action if an ingredient is next to the agent\n      if action == 4:  # Assuming 'USE' is the action with index 4\n          for i_kind in env.world.cookbook.primitives:\n              if current_state.next_to(i_kind):\n                  return 1\n      return 0\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(None, initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          use_actions = [4]  # Assuming 'USE' is the action with index 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4)\n          \n          all_actions = sorted(use_actions + other_actions, key=lambda action: heuristic(action, current_state, goal_item), reverse=True)\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming all actions have the same cost of 1\n      \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(action, new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  initial_state = env._current_state\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T23:04:51.544264", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that involve using items (action == USE)\n          use_actions = [4]  # Assuming 'USE' is the action with index 4\n          other_actions = list(range(env.world.n_actions))\n          other_actions.remove(4)\n          \n          all_actions = use_actions + other_actions\n          \n          for action in all_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  goal_item = item\n  \n  # Reset the environment to ensure a clean starting point\n  env.reset()\n  \n  initial_state = env._current_state\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  # Execute the action sequence in the environment\n  for action in action_sequence:\n      env.step(action)\n      \n      # Check if the task is done\n      if satisfies_goal(env._current_state, goal_item):\n          break\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
