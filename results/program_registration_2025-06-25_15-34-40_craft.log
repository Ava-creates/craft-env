_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_goal_actions(initial_state, goal_item):\n      actions = []\n      current_state = initial_state\n      \n      while not satisfies_goal(current_state, goal_item):\n          action_sequence = bfs_search(current_state, goal_item)\n          if not action_sequence:\n              break\n          \n          for action in action_sequence:\n              _, current_state = current_state.step(action)\n              actions.append(action)\n      \n      return actions\n\n  # Start by collecting all primitives needed to craft the goal item.\n  initial_state = env._current_state\n  goal_primitives = get_primitive_counts(item, initial_state.world.cookbook)\n\n  primitive_actions = []\n  for primitive_index in goal_primitives:\n      if satisfies_goal(initial_state, primitive_index):\n          continue\n      \n      # Collect the primitive items required to craft the primitives\n      subgoal_primitives = get_primitive_counts(primitive_index, initial_state.world.cookbook)\n      \n      for subgoal_primitive_index in subgoal_primitives:\n          if satisfies_goal(initial_state, subgoal_primitive_index):\n              continue\n          \n          # Collect actions to gather each primitive\n          subgoal_actions = bfs_search(initial_state, subgoal_primitive_index)\n          if subgoal_actions:\n              primitive_actions.extend(subgoal_actions)\n              for action in subgoal_actions:\n                  _, initial_state = initial_state.step(action)\n\n  # Now, with all primitives collected, craft the goal item.\n  goal_actions = bfs_search(initial_state, item)\n  \n  if goal_actions is None:\n      return []  # Return empty list if no sequence is found\n  \n  return primitive_actions + goal_actions", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:53:24.813582", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_adjacent_positions(pos):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # LEFT, RIGHT, UP, DOWN\n      width, height = env.world.scenario.grid.shape[:2]\n      adjacent_positions = []\n      \n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < width and 0 <= ny < height:\n              adjacent_positions.append((nx, ny))\n      \n      return adjacent_positions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          adjacent_positions = get_adjacent_positions(current_state.pos)\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              elif action == 0:  # DOWN\n                  if current_state.pos in adjacent_positions and initial_state.dir != 1:\n                      continue  # Avoid moving out of adjacent positions\n              elif action == 1:  # UP\n                  if current_state.pos in adjacent_positions and initial_state.dir != 3:\n                      continue  # Avoid moving out of adjacent positions\n              elif action == 2:  # LEFT\n                  if current_state.pos in adjacent_positions and initial_state.dir != 0:\n                      continue  # Avoid moving out of adjacent positions\n              elif action == 3:  # RIGHT\n                  if current_state.pos in adjacent_positions and initial_state.dir != 2:\n                      continue  # Avoid moving out of adjacent positions\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T13:55:15.843213", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(actions):\n      # Simple heuristic: remove consecutive moves in opposite directions\n      optimized_actions = []\n      i = 0\n      \n      while i < len(actions):\n          current_action = actions[i]\n          \n          if current_action == 0:  # DOWN\n              if i + 1 < len(actions) and actions[i + 1] == 1:  # UP\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 1:  # UP\n              if i + 1 < len(actions) and actions[i + 1] == 0:  # DOWN\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 2:  # LEFT\n              if i + 1 < len(actions) and actions[i + 1] == 3:  # RIGHT\n                  i += 2  # Skip both actions\n                  continue\n          elif current_action == 3:  # RIGHT\n              if i + 1 < len(actions) and actions[i + 1] == 2:  # LEFT\n                  i += 2  # Skip both actions\n                  continue\n          \n          optimized_actions.append(current_action)\n          i += 1\n      \n      return optimized_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted\n  if goal_item not in initial_state.world.cookbook.recipes:\n      raise ValueError(f\"Goal item {goal_item} cannot be crafted.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      optimized_sequence = optimize_action_sequence(action_sequence)\n      return optimized_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
