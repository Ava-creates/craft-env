{"timestamp": "2025-06-27T07:49:54.196766", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def can_make_goal(current_state, goal_primitives):\n      # Check if the current state has enough of each primitive to make the goal item\n      for primitive, required_count in goal_primitives.items():\n          if current_state.inventory[primitive] < required_count:\n              return False\n      return True\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  if not can_make_goal(new_state, goal_primitives):\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              possible_actions.append(action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_primitives):\n      \"\"\"Estimate the cost to reach the goal based on current inventory.\"\"\"\n      missing_count = 0\n      for primitive, required_count in goal_primitives.items():\n          missing_count += max(0, required_count - current_state.inventory[primitive])\n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  if not can_make_goal(new_state, goal_primitives):\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              possible_actions.append(action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  g_score = len(path) + 1\n                  h_score = heuristic(new_state, goal_primitives)\n                  f_score = g_score + h_score\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T07:50:05.527978", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def can_make_goal(current_state, goal_primitives):\n      # Check if the current state has enough of each primitive to make the goal item\n      for primitive, required_count in goal_primitives.items():\n          if current_state.inventory[primitive] < required_count:\n              return False\n      return True\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  if not can_make_goal(new_state, goal_primitives):\n                      continue  # Skip this action as it doesn't help make the goal item\n                  \n                  # Ensure that using an item actually progresses towards the goal\n                  for ingredient_index in new_state.inventory.nonzero()[0]:\n                      if ingredient_index in goal_primitives:\n                          possible_actions.append(action)\n                          break\n              else:  # Movement actions\n                  possible_actions.append(action)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T07:52:31.395616", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              _, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  valid_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal and move closer to required ingredients\n          sorted_valid_actions = sorted(\n              valid_actions,\n              key=lambda x: (\n                  -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives),  # More primitives used first\n                  sum(initial_state.next_to(primitive) for primitive in goal_primitives)   # Closer to ingredients first\n              )\n          )\n          \n          queue.extend([(new_state, path + [action]) for new_state, action in sorted_valid_actions])\n      \n      return None  # Return None if no sequence is found\n\n  def get_valid_actions(state):\n      actions = []\n      for action in range(state.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state has changed\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append(action)\n      \n      return actions\n\n  def optimize_path(path, env):\n      \"\"\"Optimize the path by removing redundant movements.\"\"\"\n      optimized_path = []\n      last_action = None\n      \n      for action in path:\n          # Add the current action to the optimized path\n          optimized_path.append(action)\n          \n          # Check if the current and last actions are opposite movements (e.g., left then right, up then down)\n          if len(optimized_path) > 1 and last_action is not None:\n              if (action == 0 and last_action == 2) or \\\n                 (action == 2 and last_action == 0) or \\\n                 (action == 1 and last_action == 3) or \\\n                 (action == 3 and last_action == 1):\n                  # Remove the last action as it cancels out the current one\n                  optimized_path.pop()\n                  if len(optimized_path) > 0:\n                      last_action = optimized_path[-1]\n              else:\n                  last_action = action\n      \n      return optimized_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid\n  if goal_item not in range(len(initial_state.world.cookbook.index.reverse_contents)):\n      raise ValueError(f\"Goal item index {goal_item} is not a valid item.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  # Optimize the action sequence to remove redundant movements\n  if action_sequence:\n      optimized_action_sequence = optimize_path(action_sequence, env)\n      return optimized_action_sequence\n  else:\n      return []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T07:52:32.536853", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n\n      queue = deque([(initial_state, [])])\n      visited = set()\n\n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  valid_actions.append((new_state, action))\n\n          # Prioritize actions that use resources needed for the goal and move closer to required ingredients\n          sorted_valid_actions = sorted(\n              valid_actions,\n              key=lambda x: (\n                  -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives),  # More primitives used first\n                  sum(initial_state.next_to(primitive) for primitive in goal_primitives)   # Closer to ingredients first\n              )\n          )\n\n          queue.extend([(new_state, path + [action]) for new_state, action in sorted_valid_actions])\n\n      return None  # Return None if no sequence is found\n\n  def get_valid_actions(state):\n      actions = []\n      for action in range(state.world.n_actions):\n          _, new_state = state.step(action)\n\n          # Check if the new state has changed\n          if not np.array_equal(new_state.grid, state.grid) or \\\n             not np.array_equal(new_state.inventory, state.inventory) or \\\n             new_state.pos != state.pos or \\\n             new_state.dir != state.dir:\n              actions.append(action)\n\n      return actions\n\n  def heuristic(state, goal_item):\n      # Calculate the number of primitives needed for the goal item that are already in inventory\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      available_primitives = sum(min(state.inventory[primitive], count) for primitive, count in goal_primitives.items())\n      return len(goal_primitives) - available_primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n\n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      visited = set()\n\n      while open_set:\n          _, current_state, path = heappop(open_set)\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n\n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(current_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  valid_actions.append((new_state, action))\n\n          # Prioritize actions using the heuristic\n          for new_state, action in valid_actions:\n              cost = len(path) + 1  # Assuming each action has a uniform cost of 1\n              heappush(open_set, (cost + heuristic(new_state, goal_item), new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n\n  # Ensure the goal item is valid\n  if goal_item not in range(len(initial_state.world.cookbook.index.reverse_contents)):\n      raise ValueError(f\"Goal item index {goal_item} is not a valid item.\")\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-27T07:53:45.641630", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 2.0}}
