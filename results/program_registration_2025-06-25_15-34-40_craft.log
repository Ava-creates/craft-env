   f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n          heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n    state_hash = (tuple(current_state.grid.flatten()), tuple(current_state.inventory), current_state.pos, current_state.dir)\n    total_path = []\n    \n    while state_hash in came_from:\n      total_path.append(path[-1])\n      state_hash = came_from[state_hash]\n      if len(path) > 0:\n        path.pop()\n    \n    return total_path[::-1]\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
