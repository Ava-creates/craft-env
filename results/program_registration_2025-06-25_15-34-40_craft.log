{"timestamp": "2025-06-26T12:34:36.527811", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action over movement actions and avoid revisiting states\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Avoid revisiting states that have been visited with the same inventory and position\n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if state_key not in visited:\n                  visited.add(state_key)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:34:37.582076", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      \"\"\"\n      Heuristic function to estimate the cost from current state to the goal.\n      In this simple case, it returns the number of steps taken so far.\n      A more sophisticated heuristic could be based on distance to ingredients or workshop availability.\n      \"\"\"\n      # Placeholder heuristic: prioritize states with higher inventory count for the goal item\n      return -current_state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action over movement actions and avoid revisiting states\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if tentative_g_score < g_score.get(new_state, float('inf')):\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  a