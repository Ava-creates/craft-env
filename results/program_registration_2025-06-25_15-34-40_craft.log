{"timestamp": "2025-06-26T12:19:02.843109", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the presence of required items in the inventory\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      required_items_in_inventory = sum(min(state.inventory[p], primitives.get(p, 0)) for p in primitives.keys())\n      return len(primitives) - required_items_in_inventory\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()): 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten())] + 1  # Assume each action has cost 1\n      \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:19:18.903194", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_possible_actions(state):\n      possible_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          if any(new_state.grid.flatten()) or any(new_state.inventory) or new_state.pos != state.pos:\n              possible_actions.append(action)\n      return possible_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          possible_actions = get_possible_actions(current_state)\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:20:05.120918", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if is_valid_action(current_state, action) and state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def is_valid_action(state, action):\n      # Check if the agent can pick up a non-grabbable item\n      if action == env.world.N_ACTIONS['USE']:\n          x, y = state.pos\n          dx, dy = env.world.DIRECTIONS[state.dir]\n          target_pos = (x + dx, y + dy)\n          \n          if 0 <= target_pos[0] < state.grid.shape[0] and 0 <= target_pos[1] < state.grid.shape[1]:\n              item_index = np.argmax(state.grid[target_pos])\n              if item_index in state.world.non_grabbable_indices:\n                  return False\n      \n      # Check other constraints as needed\n      return True\n  \n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:20:18.922288", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_all_possible_actions(current_state):\n              _, new_state = action\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_all_possible_actions(state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          \n          # Check if the state has changed\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append((action, new_state))\n      return actions\n\n  def is_valid_action(state, action):\n      # Placeholder for any additional validation logic\n      return True\n  \n  initial_state = env._current_state\n  goal_item = item\n  \n  # Precompute all primitives required to craft the goal item\n  required_primitives = env.world.cookbook.primitives_for(goal_item)\n  \n  # Ensure all required primitives are available in the environment\n  if not all(primitive_index in env.world.grabbable_indices for primitive_index in required_primitives):\n      return []  # Return empty list if any required primitive is unavailable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:21:23.178192", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          # Prioritize USE action over movement actions and avoid revisiting states\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  def is_valid_recipe(recipe):\n    for ingredient, count in recipe.items():\n        if ingredient == \"_key\":\n            continue\n        if ingredient not in initial_state.world.cookbook.primitives:\n            return False\n    return True\n  \n  # Filter out invalid recipes\n  valid_recipes = {output: recipe for output, recipe in env.world.cookbook.recipes.items() \n                   if is_valid_recipe(recipe)}\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:21:24.164061", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: the more items in the inventory that are part of the recipe for the goal item, the better\n      from collections import defaultdict\n      \n      cookbook = env.world.cookbook\n      primitives = cookbook.primitives_for(goal_item)\n      \n      if not primitives:\n          return 0\n      \n      # Count the number of primitive ingredients already in the inventory\n      inventory_count = defaultdict(int)\n      for idx, count in enumerate(state.inventory):\n          inventory_count[idx] = count\n      \n      heuristic_value = sum(inventory_count[i] for i in primitives)\n      return heuristic_value\n\n  def a_star_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (-heuristic(initial_state, goal_item), 0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          # Prioritize USE action over movement actions and avoid revisiting states\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  new_cost = cost + 1  # Assuming each action has a uniform cost of 1\n                  heapq.heappush(open_set, (-heuristic(new_state, goal_item) - new_cost, new_cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:22:34.530584", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=100):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Check if the current depth exceeds the maximum allowed depth\n        if len(path) >= max_depth:\n            continue\n\n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item, max_retries=3):\n    for _ in range(max_retries):\n        env.reset()\n        initial_state = env._current_state\n        action_sequence = bfs_search(initial_state, goal_item)\n        if action_sequence:\n            return action_sequence\n    return None\n\n  def optimize_action_sequence(action_sequence):\n      # Implement optimization logic here (e.g., remove redundant movements)\n      optimized_actions = []\n      last_action = -1\n      \n      for action in action_sequence:\n          if action != last_action:  # Only add the action if it's different from the previous one\n              optimized_actions.append(action)\n          last_action = action\n      \n      return optimized_actions\n\n  goal_item = item\n  action_sequence = retry_bfs_search(env, goal_item)\n\n  if action_sequence:\n      optimized_actions = optimize_action_sequence(action_sequence)\n      return optimized_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 0.2}}
{"timestamp": "2025-06-26T12:22:50.676546", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Check if the current depth exceeds the maximum allowed depth\n        if len(path) >= max_depth:\n            continue\n\n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item, max_retries=5):\n    for _ in range(max_retries):\n        env.reset()\n        initial_state = env._current_state\n        action_sequence = bfs_search(initial_state, goal_item)\n        if action_sequence:\n            return action_sequence\n    return None\n\n  def optimize_action_sequence(action_sequence):\n    # Implement optimization logic here (e.g., remove redundant movements)\n    from collections import defaultdict\n    \n    # Remove consecutive opposite actions (e.g., LEFT RIGHT)\n    optimized_actions = []\n    i = 0\n    while i < len(action_sequence):\n        if action_sequence[i] == 0 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 1:\n            i += 2\n        elif action_sequence[i] == 1 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 0:\n            i += 2\n        elif action_sequence[i] == 2 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 3:\n            i += 2\n        elif action_sequence[i] == 3 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 2:\n            i += 2\n        else:\n            optimized_actions.append(action_sequence[i])\n            i += 1\n\n    # Further optimization can be done based on specific rules or heuristics\n    return optimized_actions\n\n  goal_item = item\n  action_sequence = retry_bfs_search(env, goal_item)\n\n  if action_sequence:\n      optimized_actions = optimize_action_sequence(action_sequence)\n      return optimized_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:24:02.601534", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(pos, goal_item):\n      # Simple Manhattan distance to nearest workshop that has the required item\n      min_distance = float('inf')\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if env.world.workshop_indices[x, y] and env.world.cookbook.primitives_for(goal_item):\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:24:03.583495", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def get_possible_actions(state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append((action, new_state))\n      return actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the number of items in inventory that are not the goal\n      return np.sum(state.inventory) - state.inventory[goal_item]\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_possible_actions(current_state):\n              tentative_g_score = g_score[current_state] + 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:24:56.206289", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue to store (cost, path, state)\n      queue = []\n      start_cost = 0\n      start_path = []\n      start_hash = (tuple(initial_state.grid.flatten()), \n                    tuple(initial_state.inventory), \n                    initial_state.pos, \n                    initial_state.dir)\n\n      heapq.heappush(queue, (start_cost, start_path, initial_state))\n      visited = set([start_hash])\n      \n      while queue:\n          current_cost, path, current_state = heapq.heappop(queue)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              if state_hash not in visited:\n                  visited.add(state_hash)\n\n                  # Heuristic: prioritize actions that increase inventory counts towards the goal\n                  heuristic_cost = sum(max(0, env.world.cookbook.primitives_for(goal_item).get(i, 0) - current_state.inventory[i]) for i in range(env.world.n_kinds))\n                  cost = current_cost + 1 + heuristic_cost  # Increase cost by 1 step and add heuristic\n\n                  new_path = path + [action]\n                  heapq.heappush(queue, (cost, new_path, new_state))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
