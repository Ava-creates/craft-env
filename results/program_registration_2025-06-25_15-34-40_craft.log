ssible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = all(new_state.inventory[primitive] >= count \n                                      for primitive, count in goal_primitives.items())\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal and move closer to required ingredients\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(x[0].inventory[primitive] > 0 for primitive in goal_primitives),  # More primitives used first\n                  sum(current_state.next_to(primitive) for primitive in goal_primitives),   # Closer to ingredients first\n                  len([ingredient for ingredient, count in goal_primitives.items() if x[0].inventory[ingredient] < count])  # Fewer missing primitives first\n              )\n          )\n          \n          for new_state, action in sorted_possible_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T02:39:13.248558", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Heuristic: Prioritize actions that move closer to having required primitives\n              new_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n              heuristic_score = sum(new_primitives.get(primitive, 0) - current_primitives\n                                    for primitive, current_primitives in goal_primitives.items())\n\n              valid_actions.append((new_state, action, heuristic_score))\n          \n          # Sort actions by heuristic score (descending order)\n          valid_actions.sort(key=lambda x: x[2], reverse=True)\n          \n          for new_state, action, _ in valid_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T02:39:24.472797", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      action_map = {}  # To keep track of the last action taken to reach each state\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Heuristic: Prioritize actions that move closer to having required primitives\n              new_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n              heuristic_score = sum(min(new_primitives.get(primitive, 0) - current_primitives, 0)\n                                    for primitive, current_primitives in goal_primitives.items())\n\n              valid_actions.append((new_state, action, heuristic_score))\n          \n          # Sort actions by heuristic score (descending order)\n          valid_actions.sort(key=lambda x: x[2], reverse=True)\n          \n          for new_state, action, _ in valid_actions:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  action_map[state_hash] = action\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T02:41:04.830110", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    actions_taken = []  # Track actions taken to reach each state\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      possible_actions = []\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = True\n          # Check if the use action can contribute to making the goal item\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        possible_actions.append((action, reward, new_state))\n      \n      for action, reward, new_state in sorted(possible_actions, key=lambda x: x[1], reverse=True):\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n      \n      # Update actions_taken for the current state\n      actions_taken.extend(path)\n    \n    return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n    for action in actions:\n      reward, done, observations = env.step(action)\n      if done:\n        break\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n    return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    execute_actions(env, action_sequence)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T02:41:06.122644", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      possible_actions = filter_possible_actions(current_state, goal_primitives)\n      \n      for action in possible_actions:\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = True\n          # Check if the use action can contribute to making the goal item\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n\n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def filter_possible_actions(current_state, goal_primitives):\n    actions = []\n    for action in range(initial_state.world.n_actions):\n      reward, new_state = current_state.step(action)\n      \n      if action == 4:  # USE action\n        can_make_goal = True\n        for primitive, count in goal_primitives.items():\n          if new_state.inventory[primitive] < count:\n            can_make_goal = False\n            break\n        if can_make_goal:\n          actions.append((action, reward, new_state))\n      else:\n        actions.append((action, reward, new_state))\n    return actions\n\n  def execute_actions(env, actions):\n    for action in actions:\n      reward, done, observations = env.step(action)\n      if done:\n        break\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook or is a primitive)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n    return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    execute_actions(env, action_sequence)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
