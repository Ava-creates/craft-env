{"timestamp": "2025-06-26T22:31:28.589451", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  # Validate that all required primitives are either already available or part of the environment\n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  # Optimize by prioritizing actions that lead to required primitives\n  def heuristic(action, state):\n      _, new_state = state.step(action)\n      new_inventory_count = sum(new_state.inventory[primitive] for primitive in primitives_required if new_state.inventory[primitive] > available_primitives.get(primitive, 0))\n      return -new_inventory_count\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is None:\n      raise ValueError(\"No sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T22:31:45.188208", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  \n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_primitives(primitives_required, available_primitives):\n      \"\"\"Prioritize actions that lead to required primitives.\"\"\"\n      priorities = {}\n      for action in range(env.world.n_actions):\n          reward, new_state = initial_state.step(action)\n          new_inventory_count = sum(new_state.inventory[primitive] for primitive in primitives_required if new_state.inventory[primitive] > available_primitives.get(primitive, 0))\n          priorities[action] = new_inventory_count\n      return sorted(priorities, key=priorities.get, reverse=True)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  # Prioritize actions that lead to required primitives\n  priority_actions = prioritize_primitives(primitives_required, available_primitives)\n  \n  def bfs_with_priorities(initial_state, goal_item, priority_actions, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [], priority_actions)])\n      visited = set()\n      \n      while queue:\n          current_state, path, actions_to_try = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          for action in actions_to_try:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action], prioritize_primitives(primitives_required, {idx: new_state.inventory[idx] for idx in env.world.grabbable_indices})))\n      \n      return None  # Return None if no sequence is found\n\n  action_sequence = bfs_with_priorities(initial_state, goal_item, priority_actions)\n\n  if action_sequence is None:\n      raise ValueError(\"No sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 4, "scores": {"3": 1.5}}
