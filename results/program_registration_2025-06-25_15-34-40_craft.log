{"timestamp": "2025-06-26T10:24:27.363106", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]\n              if 0 <= x + dx < env.world.WIDTH and 0 <= y + dy < env.world.HEIGHT]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize movement actions over USE action\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n              if 0 <= new_pos[0] < env.world.WIDTH and 0 <= new_pos[1] < env.world.HEIGHT:\n                  action = {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3}[(dx, dy)]\n                  reward, new_state = current_state.step(action)\n                  \n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      queue.append((new_state, path + [action]))\n          \n          # Try the USE action\n          reward, new_state = current_state.step(4)  # 4 is the USE action\n          \n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [4]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:24:43.476164", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              _, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:26:14.269655", "function_name": "craft", "function_body": "  def satisfies_goal(state: CraftState, goal_item: int) -> bool:\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state: CraftState, goal_item: int, max_depth=50):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if len(path) > max_depth:\n              continue\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              _, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def gather_primitives(initial_state: CraftState, goal_item: int):\n      \"\"\"Gather all primitives needed to craft the goal item.\"\"\"\n      primitive_actions = []\n      for prim_index in env.world.cookbook.primitives_for(goal_item).keys():\n          if satisfies_goal(initial_state, prim_index):\n              continue  # Skip gathering if already have the primitive\n          \n          prim_action_seq = bfs_search(initial_state, prim_index)\n          if not prim_action_seq:\n              return None  # Unable to gather a primitive\n          \n          primitive_actions.extend(prim_action_seq)\n          \n          # Update initial state after gathering primitives\n          current_state = initial_state\n          for action in prim_action_seq:\n              _, current_state = current_state.step(action)\n      \n      return primitive_actions\n\n  def craft_item(initial_state: CraftState, goal_item: int):\n      \"\"\"Craft the item using gathered primitives.\"\"\"\n      action_sequence = bfs_search(initial_state, goal_item)\n      if action_sequence:\n          return action_sequence\n      \n      # If direct crafting fails, try to gather prerequisites\n      primitive_actions = gather_primitives(initial_state, goal_item)\n      \n      if not primitive_actions:\n          return None  # No actions found to gather primitives\n      \n      # After gathering primitives, attempt to craft the goal item again\n      new_initial_state = initial_state\n      for action in primitive_actions:\n          _, new_initial_state = new_initial_state.step(action)\n      \n      final_sequence = bfs_search(new_initial_state, goal_item)\n      \n      if final_sequence:\n          return primitive_actions + final_sequence\n      \n      return None  # No sequence found to craft the item\n\n  def gather_and_craft(initial_state: CraftState, goal_item: int):\n      \"\"\"Gather all primitives and then craft the item.\"\"\"\n      primitive_actions = []\n      for prim_index in env.world.cookbook.primitives_for(goal_item).keys():\n          if satisfies_goal(initial_state, prim_index):\n              continue  # Skip gathering if already have the primitive\n          \n          prim_action_seq = bfs_search(initial_state, prim_index)\n          if not prim_action_seq:\n              return None  # Unable to gather a primitive\n          \n          primitive_actions.extend(prim_action_seq)\n          \n          # Update initial state after gathering primitives\n          current_state = initial_state\n          for action in prim_action_seq:\n              _, current_state = current_state.step(action)\n      \n      final_sequence = bfs_search(current_state, goal_item)\n      \n      if final_sequence:\n          return primitive_actions + final_sequence\n      \n      return None  # No sequence found to craft the item\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find a direct path first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence and env.world.cookbook.primitives_for(goal_item):\n      # Fallback: Try to gather primitives if the item requires them\n      action_sequence = gather_and_craft(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:26:29.929513", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if len(path) > max_depth:\n              continue\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None\n\n  def gather_primitives(initial_state, goal_item):\n      primitive_actions = []\n      primitives_needed = env.world.cookbook.primitives_for(goal_item).copy()\n      \n      while primitives_needed:\n          for prim_index in list(primitives_needed.keys()):\n              if satisfies_goal(initial_state, prim_index):\n                  del primitives_needed[prim_index]\n                  continue\n              \n              needed_count = primitives_needed[prim_index] - initial_state.inventory[prim_index]\n              if needed_count <= 0:\n                  del primitives_needed[prim_index]\n                  continue\n              \n              # Gather the required primitive\n              prim_action_seq = bfs_search(initial_state, prim_index)\n              if not prim_action_seq:\n                  return None  # Unable to gather a primitive\n              \n              primitive_actions.extend(prim_action_seq)\n              current_state = initial_state\n              for action in prim_action_seq:\n                  _, current_state = current_state.step(action)\n              \n              # Update the inventory count for the gathered primitive\n              initial_state = current_state\n      \n      return primitive_actions\n\n  def craft_item(initial_state, goal_item):\n      action_sequence = bfs_search(initial_state, goal_item)\n      if action_sequence:\n          return action_sequence\n      \n      # If direct crafting fails, try to gather prerequisites\n      primitive_actions = gather_primitives(initial_state, goal_item)\n      \n      if not primitive_actions:\n          return None  # No actions found to gather primitives\n      \n      new_initial_state = initial_state\n      for action in primitive_actions:\n          _, new_initial_state = new_initial_state.step(action)\n      \n      final_sequence = bfs_search(new_initial_state, goal_item)\n      \n      if final_sequence:\n          return primitive_actions + final_sequence\n      \n      return None\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find a direct path first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence and env.world.cookbook.primitives_for(goal_item):\n      # Fallback: Try to gather primitives if the item requires them\n      primitive_actions = gather_primitives(initial_state, goal_item)\n      \n      if primitive_actions:\n          new_initial_state = initial_state\n          for action in primitive_actions:\n              _, new_initial_state = new_initial_state.step(action)\n          \n          final_sequence = bfs_search(new_initial_state, goal_item)\n          \n          if final_sequence:\n              action_sequence = primitive_actions + final_sequence\n\n  return action_sequence if action_sequence else []", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:28:13.189838", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Limit the number of steps to prevent infinite loops\n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, primitives_needed):\n      action_sequence = []\n      current_state = initial_state\n      \n      for primitive, count in primitives_needed.items():\n          while current_state.inventory[primitive] < count:\n              collect_action_sequence = bfs_search(current_state, primitive)\n              if not collect_action_sequence:\n                  return None  # Primitive collection failed\n              \n              action_sequence.extend(collect_action_sequence)\n              new_state = initial_state\n              for action in collect_action_sequence:\n                  _, new_state = new_state.step(action)\n              \n              current_state = new_state\n      \n      return action_sequence\n\n  def craft_with_inventory(env, initial_state, goal_item):\n      cookbook = env.world.cookbook\n      recipes = cookbook.recipes\n      non_grabbable_indices = cookbook.non_grabbable_indices\n      \n      # Find a recipe that produces the goal item\n      for output_index, recipe in recipes.items():\n          if output_index == goal_item:\n              ingredients_needed = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"}\n              \n              # Check if we have enough inventory to craft directly\n              can_craft_directly = True\n              for ingredient, count in ingredients_needed.items():\n                  if current_state.inventory[ingredient] < count:\n                      can_craft_directly = False\n                      break\n              \n              if can_craft_directly:\n                  action_sequence = []\n                  \n                  # Collect the necessary items\n                  collect_action_sequences = []\n                  for ingredient, count in ingredients_needed.items():\n                      while current_state.inventory[ingredient] < count:\n                          collect_action_sequence = bfs_search(current_state, ingredient)\n                          if not collect_action_sequence:\n                              return None  # Collection failed\n                          \n                          collect_action_sequences.append(collect_action_sequence)\n                          new_state = initial_state\n                          for action in collect_action_sequence:\n                              _, new_state = new_state.step(action)\n                          \n                          current_state = new_state\n                  \n                  # Collect all sequences and apply them sequentially\n                  for seq in collect_action_sequences:\n                      action_sequence.extend(seq)\n                  \n                  # Perform the crafting action\n                  crafting_action = 4  # Assuming USE is represented by 4\n                  action_sequence.append(crafting_action)\n                  return action_sequence\n      \n      return None  # No direct crafting possible with current inventory\n\n  initial_state = env._current_state\n  goal_item = item\n  cookbook = env.world.cookbook\n  \n  # Try crafting the item directly first\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      # If direct crafting fails, try collecting primitives and then crafting\n      primitives_needed = cookbook.primitives_for(goal_item)\n      \n      collect_action_sequence = collect_primitives(env, initial_state, primitives_needed)\n      if collect_action_sequence:\n          action_sequence.extend(collect_action_sequence)\n          \n          # After collecting, try crafting again\n          new_state = initial_state\n          for action in collect_action_sequence:\n              _, new_state = new_state.step(action)\n          \n          craft_action_sequence = bfs_search(new_state, goal_item)\n          if craft_action_sequence:\n              action_sequence.extend(craft_action_sequence)\n              return action_sequence\n\n  # If all else fails, try crafting with the current inventory\n  craft_with_inventory_sequence = craft_with_inventory(env, initial_state, goal_item)\n  if craft_with_inventory_sequence:\n      action_sequence.extend(craft_with_inventory_sequence)\n      return action_sequence\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
