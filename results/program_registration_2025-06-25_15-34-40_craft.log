{"timestamp": "2025-06-27T12:19:47.465316", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Filter and prioritize actions based on available inventory and required primitives\n        priority_actions = prioritize_actions(current_state, goal_primitives)\n        \n        for action in priority_actions:\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def prioritize_actions(current_state, goal_primitives):\n    \"\"\"Prioritize actions based on the current state and required primitives.\"\"\"\n    priority_actions = []\n    \n    for action in range(current_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n            # Check if the use action can contribute to making the goal item\n            can_make_goal = True\n            for primitive, count in goal_primitives.items():\n                if new_state.inventory[primitive] < count:\n                    can_make_goal = False\n                    break\n            \n            if not can_make_goal:\n                continue  # Skip this action as it doesn't help make the goal item\n        \n        # Calculate the score based on the number of primitives collected or used\n        score = sum(new_state.inventory) - sum(current_state.inventory)\n        priority_actions.append((action, reward, new_state, score))\n    \n    # Sort actions based on the score (number of primitives collected or used)\n    priority_actions.sort(key=lambda x: x[3], reverse=True)\n    return [action for action, _, _, _ in priority_actions]\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = []\n  max_attempts = 10  # Increase attempts to handle more complex recipes\n  attempts = 0\n      \n  while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n      path = bfs_search(initial_state, goal_item)\n      if path is None:\n          break\n      \n      action_sequence.extend(path)\n      \n      # Apply the found actions to the environment\n      for action in path:\n          reward, done, observations = env.step(action)\n          \n          if done or satisfies_goal(env._current_state, goal_item):\n              return action_sequence\n      \n      initial_state = env._current_state\n      attempts += 1\n\n  return action_sequence if satisfies_goal(env._current_state, goal_item) else []", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T12:19:58.033567", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n    \"\"\"Finds the shortest path to achieve the goal item using BFS with action prioritization.\"\"\"\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Collect primitives needed for the goal item\n        goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        \n        # Prioritize actions based on available inventory and required primitives\n        priority_actions = prioritize_actions(current_state, goal_primitives)\n        \n        for action in priority_actions:\n            reward, new_state = current_state.step(action)\n            \n            if action == 4:  # USE action\n                # Check if the use action can contribute to making the goal item\n                can_make_goal = True\n                for primitive, count in goal_primitives.items():\n                    if new_state.inventory[primitive] < count:\n                        can_make_goal = False\n                        break\n                \n                if not can_make_goal:\n                    continue  # Skip this action as it doesn't help make the goal item\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def prioritize_actions(current_state, goal_primitives):\n    \"\"\"Prioritize actions based on the current state and required primitives.\"\"\"\n    priority_actions = []\n    \n    for action in range(current_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n            # Check if the use action can contribute to making the goal item\n            can_make_goal = True\n            for primitive, count in goal_primitives.items():\n                if new_state.inventory[primitive] < count:\n                    can_make_goal = False\n                    break\n            \n            if not can_make_goal:\n                continue  # Skip this action as it doesn't help make the goal item\n        \n        priority_actions.append((action, reward, new_state))\n    \n    # Sort actions based on the amount of primitives collected or used\n    priority_actions.sort(key=lambda x: sum(x[2].inventory), reverse=True)\n    return [action for action, _, _ in priority_actions]\n\n  def plan_actions(env, goal_item):\n      \"\"\"Plan and execute actions to craft the item.\"\"\"\n      initial_state = env._current_state\n      action_sequence = []\n      max_attempts = 10  # Increase attempts to handle more complex recipes\n      attempts = 0\n      \n      while not satisfies_goal(initial_state, goal_item) and attempts < max_attempts:\n          path = bfs_search(initial_state, goal_item)\n          if path is None:\n              break\n          \n          action_sequence.extend(path)\n          \n          # Apply the found actions to the environment\n          for action in path:\n              reward, done, observations = env.step(action)\n              \n              if done or satisfies_goal(env._current_state, goal_item):\n                  return action_sequence\n      \n          initial_state = env._current_state\n          attempts += 1\n\n      return action_sequence if satisfies_goal(env._current_state, goal_item) else []\n\n  # Plan and execute the actions to craft the item\n  return plan_actions(env, item)", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T12:21:08.902191", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def heuristic(state, goal_item):\n    # Simple heuristic: number of primitives missing to craft the goal item\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    current_primitives = {i: state.inventory[i] for i in goal_primitives}\n    return sum(max(0, goal_primitives[i] - current_primitives.get(i, 0)) for i in goal_primitives)\n\n  def a_star_search(initial_state, goal_item):\n    from heapq import heappop, heappush\n\n    open_set = [(heuristic(initial_state, goal_item), initial_state, [])]\n    visited = set()\n\n    while open_set:\n      _, current_state, path = heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n          if not can_make_goal:\n            continue\n        \n        valid_actions.append((action, new_state))\n      \n      for action, new_state in valid_actions:\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          heappush(open_set, (heuristic(new_state, goal_item) + len(path) + 1, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T12:21:10.169503", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n          if not can_make_goal:\n            continue\n        \n        valid_actions.append((action, new_state))\n      \n      for action, new_state in valid_actions:\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_initial_inventory_with_primitives(primitives):\n    inventory = np.zeros(env.world.cookbook.n_kinds, dtype=int)\n    for primitive, count in primitives.items():\n      inventory[primitive] += count\n    return inventory\n\n  initial_state = env._current_state.copy()\n  goal_item = item\n  primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n  # Set the initial state's inventory with necessary primitives\n  initial_state.inventory = get_initial_inventory_with_primitives(primitives)\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
