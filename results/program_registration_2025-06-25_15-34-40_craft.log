{"timestamp": "2025-06-25T19:14:50.751709", "function_name": "craft", "function_body": "  # Get the cookbook index for the desired item\n  goal_index = item\n\n  # Check if the goal is a primitive or in the environment (non-grabbable)\n  if goal_index in env.world.non_grabbable_indices:\n    raise ValueError(f\"Goal {goal_index} is not craftable.\")\n  \n  # Use the cookbook to get the primitives needed for the goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  actions = []\n\n  # Loop through each primitive and gather it if necessary\n  for primitive, count in primitives_needed.items():\n    if primitive in env.world.grabbable_indices:\n      # Generate actions to gather the required amount of the primitive\n      actions.extend(gather_primitive(env, primitive, count))\n\n  # Add actions to craft the goal item from gathered primitives\n  crafting_actions = create_goal(env, goal_index)\n  actions.extend(crafting_actions)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-25T19:16:15.165407", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def find_item(grid, item_index):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    return [tuple(pos) for pos in positions]\n\n  def move_to(target_pos):\n    current_pos = env._current_state.pos\n    direction_changes = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n    \n    # Calculate the relative position of the target\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    # Determine direction changes to move in x-axis\n    if dx > 0:\n        while env._current_state.dir != RIGHT:\n            env.step(RIGHT)\n            actions.append(RIGHT)\n        for _ in range(dx):\n            env.step(DOWN)\n            actions.append(DOWN)\n    elif dx < 0:\n        while env._current_state.dir != LEFT:\n            env.step(LEFT)\n            actions.append(LEFT)\n        for _ in range(-dx):\n            env.step(DOWN)\n            actions.append(DOWN)\n\n    # Determine direction changes to move in y-axis\n    if dy > 0:\n        while env._current_state.dir != DOWN:\n            env.step(DOWN)\n            actions.append(DOWN)\n        for _ in range(dy):\n            env.step(DOWN)\n            actions.append(DOWN)\n    elif dy < 0:\n        while env._current_state.dir != UP:\n            env.step(UP)\n            actions.append(UP)\n        for _ in range(-dy):\n            env.step(DOWN)\n            actions.append(DOWN)\n\n    return actions\n\n  def use_items(items):\n      actions = []\n      for item_pos in items:\n          actions.extend(move_to(item_pos))\n          actions.append(USE)\n          env.step(USE)\n      return actions\n\n  # Initialize the list of actions\n  actions = []\n\n  # Get the primitives required to craft the item\n  primitives_needed = env.world.cookbook.primitives_for(item)\n\n  for primitive, count in primitives_needed.items():\n    if count > 0:\n      # Find all positions of the primitive items\n      primitive_positions = find_item(env._current_state.grid, primitive)\n      \n      if not primitive_positions:\n        return actions  # No primitives found\n\n      # Use each item in the list\n      for _ in range(count):\n          actions.extend(use_items(primitive_positions))\n\n  # Now try to craft the final item\n  item_positions = find_item(env._current_state.grid, item)\n  \n  if not item_positions:\n    return actions  # No items found\n\n  # Use each item in the list\n  actions.extend(use_items(item_positions))\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-06-25T19:16:45.180396", "function_name": "craft", "function_body": "  UP = 0\n  DOWN = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def find_item(grid, item_index):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    return [tuple(pos) for pos in positions]\n\n  def move_to(target_pos):\n    current_pos = env._current_state.pos\n    direction_changes = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n    \n    # Calculate the relative position of the target\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    # Determine direction changes to move in x-axis\n    if dx > 0:\n        while env._current_state.dir != RIGHT:\n            env.step(RIGHT)\n            actions.append(RIGHT)\n        for _ in range(dx):\n            env.step(DOWN)\n            actions.append(DOWN)\n    elif dx < 0:\n        while env._current_state.dir != LEFT:\n            env.step(LEFT)\n            actions.append(LEFT)\n        for _ in range(-dx):\n            env.step(DOWN)\n            actions.append(DOWN)\n\n    # Determine direction changes to move in y-axis\n    if dy > 0:\n        while env._current_state.dir != DOWN:\n            env.step(DOWN)\n            actions.append(DOWN)\n        for _ in range(dy):\n            env.step(DOWN)\n            actions.append(DOWN)\n    elif dy < 0:\n        while env._current_state.dir != UP:\n            env.step(UP)\n            actions.append(UP)\n        for _ in range(-dy):\n            env.step(DOWN)\n            actions.append(DOWN)\n\n    return actions\n\n  def use_item(item_pos):\n      actions = []\n      actions.extend(move_to(item_pos))\n      actions.append(USE)\n      env.step(USE)\n      return actions\n\n  # Initialize the list of actions\n  actions = []\n\n  while not env._current_state.satisfies(None, item):\n    # Get the list of all positions of the required items for the goal\n    required_items = env.world.cookbook.primitives_for(item)\n    \n    if not required_items:\n      return actions  # No recipes found\n\n    for req_item_index in required_items.keys():\n      # Find the positions of the required item in the grid\n      item_positions = find_item(env._current_state.grid, req_item_index)\n\n      if not item_positions:\n        return actions  # Required items not found\n      \n      # Use the first available required item\n      actions.extend(use_item(item_positions[0]))\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-25T19:18:37.478959", "function_name": "craft", "function_body": "  def bfs_find_path(grid, start_pos, target_index):\n      from collections import deque\n      \n      width, height = grid.shape[0], grid.shape[1]\n      queue = deque([(start_pos, [])])\n      visited = set([start_pos])\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if the target is found in the 3x3 neighborhood\n          for dx in range(-1, 2):\n              for dy in range(-1, 2):\n                  nx, ny = x + dx, y + dy\n                  if 0 <= nx < width and 0 <= ny < height and np.any(grid[nx, ny] == target_index):\n                      return path + [4]  # Add USE action at the end\n      \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  queue.append(((nx, ny), path + [2 if dx == -1 else 3 if dx == 1 else 0 if dy == -1 else 1]))\n                  visited.add((nx, ny))\n      \n      return None  # Target not found\n\n  def plan_crafting(recipe, inventory):\n      \"\"\"Plan the sequence of actions needed to craft the item based on the recipe and current inventory.\"\"\"\n      actions = []\n      current_pos = env._current_state.pos\n      \n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue\n          \n          while inventory[ingredient] < count:\n              # If the ingredient is a primitive, find it on the map\n              if ingredient in env.world.cookbook.primitives:\n                  path = bfs_find_path(env._current_state.grid, current_pos, ingredient)\n                  if path is not None:\n                      actions.extend(path)\n                      # Update the current position based on the last move\n                      last_action = path[-1]\n                      dx, dy = (-1, 0) if last_action == 2 else (1, 0) if last_action == 3 else (0, -1) if last_action == 0 else (0, 1)\n                      current_pos = (current_pos[0] + dx, current_pos[1] + dy)\n                  else:\n                      return []  # Ingredient not found\n      \n              # Pick up the ingredient\n              actions.append(4)  # USE to pick up the ingredient\n              inventory[ingredient] += 1\n      \n      # After gathering all ingredients, use them to craft the item\n      actions.append(4)  # USE to craft the item\n      return actions\n\n  def get_primitives_recursively(item_index):\n      primitives = {}\n      if item_index in env.world.cookbook.primitives:\n          primitives[item_index] = 1\n      else:\n          recipe = env.world.cookbook.recipes.get(item_index, {})\n          for ingredient_index, count in recipe.items():\n              if ingredient_index != \"_key\":\n                  sub_primitives = get_primitives_recursively(ingredient_index)\n                  for prim_index, cnt in sub_primitives.items():\n                      primitives[prim_index] = primitives.get(prim_index, 0) + cnt\n      return primitives\n\n  # Get all required primitives recursively\n  primitives = get_primitives_recursively(item)\n\n  # Plan crafting actions based on the current inventory and grid state\n  recipe = env.world.cookbook.recipes[item]\n  action_sequence = plan_crafting(recipe, np.copy(env._current_state.inventory))\n\n  return action_sequence", "island_id": 9, "scores": {"3": 0.0}}
