{"timestamp": "2025-06-26T03:59:59.702788", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item, env):\n      # Simple heuristic: distance to the nearest required resource\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      min_distance = float('inf')\n      \n      for i_kind in primitives.keys():\n          if current_state.next_to(i_kind):\n              return 0  # If already next to a primitive, no additional cost\n          \n          grid = current_state.grid[:, :, i_kind]\n          positions = np.argwhere(grid > 0)\n          if len(positions) == 0:\n              continue\n          \n          agent_pos = np.array(current_state.pos)\n          distances = [np.linalg.norm(agent_pos - pos) for pos in positions]\n          min_distance = min(min_distance, min(distances))\n      \n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      g_scores = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos, initial_state.dir): 0}\n      \n      while open_set:\n          current_f, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + (new_state.pos, new_state.dir)\n              tentative_g_score = g_scores.get(state_hash, float('inf'))\n              current_g_score = g_scores[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos, current_state.dir)] + 1\n              \n              if current_g_score < tentative_g_score:\n                  g_scores[state_hash] = current_g_score\n                  f_score = current_g_score + heuristic(new_state, goal_item, env)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T04:00:15.401927", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):  # Limit search depth to avoid infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if len(path) > max_depth:\n              continue  # Skip paths that exceed the maximum depth\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(actions):\n      \"\"\"Optimizes the action sequence to remove redundant movements.\"\"\"\n      optimized = []\n      i = 0\n      while i < len(actions):\n          action = actions[i]\n          optimized.append(action)\n          \n          # Check for consecutive moves in opposite directions\n          if i + 2 < len(actions):\n              next_action = actions[i + 1]\n              following_action = actions[i + 2]\n              if (action == env.world.DOWN and next_action == env.world.UP) or \\\n                 (action == env.world.UP and next_action == env.world.DOWN) or \\\n                 (action == env.world.LEFT and next_action == env.world.RIGHT) or \\\n                 (action == env.world.RIGHT and next_action == env.world.LEFT):\n                  i += 3  # Skip these three actions as they are redundant\n              else:\n                  i += 1\n          else:\n              i += 1\n      \n      return optimized\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      optimized_actions = optimize_actions(action_sequence)\n      return optimized_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T04:01:24.321124", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check if USE action is valid and prioritize it\n      reward, new_state_use = state.step(4)\n      if new_state_use != state:\n          valid_actions.append(4)\n      \n      # Check movement actions (DOWN, UP, LEFT, RIGHT) in the order they are defined\n      for action in range(4):\n          reward, new_state_move = state.step(action)\n          if new_state_move != state:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of primitives needed to craft the goal item\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      total_primitives_in_inventory = sum(state.inventory[i] for i in primitives_needed.keys())\n      \n      # Estimate the remaining steps based on the number of primitives needed\n      return len(primitives_needed) - total_primitives_in_inventory\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              if new_state == current_state:  # Skip invalid moves (e.g., moving into walls or using an empty inventory)\n                  continue\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              state_hash = (\n                  tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir\n              )\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # If the item is already in the inventory, return an empty list of actions\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
