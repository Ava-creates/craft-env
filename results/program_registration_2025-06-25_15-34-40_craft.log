{"timestamp": "2025-06-26T15:20:51.520784", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize using items in inventory first and then movement actions\n          prioritized_actions = [4] + list(range(4))  # USE action first\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  # If an action sequence was found, filter out redundant movements and USE actions\n  if action_sequence:\n    filtered_actions = []\n    last_action = None\n    \n    for action in action_sequence:\n        # Avoid consecutive USE actions unless necessary\n        if action == 4 and last_action != 4:\n            filtered_actions.append(action)\n        elif action < 4:  # Movement actions\n            # Only add movement if it's different from the previous one or not redundant\n            if last_action is None or last_action >= 4 or action != (last_action + 2) % 4:\n                filtered_actions.append(action)\n        else:\n            filtered_actions.append(action)\n        \n        last_action = action\n    \n    return filtered_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-06-26T15:21:07.139315", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize using items in inventory first and then movement actions\n          prioritized_actions = [4] + list(range(4))  # USE action first\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T15:22:11.915583", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, target_item):\n      \"\"\"Simple heuristic to prioritize paths leading to resources or workstations.\"\"\"\n      current_pos = current_state.pos\n      inventory = current_state.inventory\n      \n      # Calculate distance to nearest resource needed for the target item\n      primitives_needed = env.world.cookbook.primitives_for(target_item)\n      distances = []\n      \n      for primitive, count in primitives_needed.items():\n          if inventory[primitive] >= count:\n              continue  # Skip if already have enough of this primitive\n      \n          # Find nearest cell with this primitive resource\n          min_dist = float('inf')\n          for y in range(env.world.scenario.init_grid.shape[0]):\n              for x in range(env.world.scenario.init_grid.shape[1]):\n                  if env.world.scenario.init_grid[y, x, primitive] > 0:\n                      dist = abs(y - current_pos[1]) + abs(x - current_pos[0])\n                      min_dist = min(min_dist, dist)\n          \n          distances.append(min_dist)\n      \n      # Return sum of minimum distances to all required primitives\n      return sum(distances) if distances else float('inf')\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      \n      g_scores = {initial_state: 0}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          # Prioritize USE action over movement actions\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_scores[current_state] + 1  # Assume uniform cost of 1 for each step\n              \n              if new_state not in g_scores or tentative_g_score < g_scores[new_state]:\n                  came_from[new_state] = (current_state, action, path)\n                  g_scores[new_state] = tentative_g_score\n                  \n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      while current_state in came_from:\n          state, action, prev_path = came_from[current_state]\n          path.append(action)\n          current_state = state\n      return list(reversed(path))\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:22:42.204930", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_primitive_actions(env):\n      primitives = []\n      for item_idx in env.world.cookbook.primitives:\n          action_sequence = bfs_search(env._current_state, item_idx)\n          if action_sequence:\n              primitives.append((item_idx, action_sequence))\n      return primitives\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Precompute primitive actions\n  primitive_actions = get_primitive_actions(env)\n\n  # Use primitive actions to satisfy recipe requirements\n  def satisfies_recipe(state, recipe):\n      for ingredient_idx in recipe.keys():\n          if ingredient_idx != \"_key\":\n              if state.inventory[ingredient_idx] < recipe[ingredient_idx]:\n                  return False\n      return True\n\n  def apply_primitives_to_inventory(env, state, primitives):\n      new_state = state\n      for item_idx, action_sequence in primitives:\n          while new_state.inventory[item_idx] < 1:  # Ensure we have at least one of each primitive\n              for action in action_sequence:\n                  _, new_state = new_state.step(action)\n      return new_state\n\n  # Apply primitive actions to ensure all required ingredients are available\n  initial_state = apply_primitives_to_inventory(env, initial_state, primitive_actions)\n\n  # Search for the goal item now that primitives are available\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T15:24:11.328354", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def collect_primitives(env, initial_state, goal_item):\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_for(goal_item)\n      action_sequence = []\n      current_state = initial_state\n      \n      for primitive_index in primitives_needed:\n          count = primitives_needed[primitive_index]\n          \n          while current_state.inventory[primitive_index] < count:\n              # Collect the primitive\n              collect_action_sequence = bfs_search(current_state, primitive_index)\n              \n              if not collect_action_sequence:\n                  print(f\"Could not find a path to collect {env.world.cookbook.index.get(primitive_index)}\")\n                  break\n              \n              action_sequence.extend(collect_action_sequence)\n              \n              # Update the state after collecting the primitive\n              for action in collect_action_sequence:\n                  _, current_state = current_state.step(action)\n      \n      return action_sequence, current_state\n\n  def craft_with_primitives(env, initial_state, goal_item):\n      action_sequence = []\n      current_state = initial_state\n      \n      # Collect all required primitives\n      collect_action_sequence, updated_state = collect_primitives(env, initial_state, goal_item)\n      if not collect_action_sequence:\n          print(\"Failed to collect all required primitives.\")\n          return None\n      \n      action_sequence.extend(collect_action_sequence)\n      current_state = updated_state\n      \n      # Try crafting again after collecting primitives\n      craft_action_sequence = bfs_search(current_state, goal_item)\n      if craft_action_sequence:\n          action_sequence.extend(craft_action_sequence)\n          return action_sequence\n      \n      return None\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try crafting the item directly first\n  direct_craft_action_sequence = bfs_search(initial_state, goal_item)\n\n  if direct_craft_action_sequence:\n      return direct_craft_action_sequence\n  else:\n      print(\"Direct crafting failed. Attempting to collect primitives and then craft.\")\n      \n      # If direct crafting fails, try collecting primitives and then crafting\n      final_action_sequence = craft_with_primitives(env, initial_state, goal_item)\n      \n      if final_action_sequence:\n          return final_action_sequence\n      \n  return []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
