ep(action)\n          if done:\n              break\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T11:06:35.961537", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      \n      # Action constants (assuming these are defined somewhere in your environment)\n      DOWN = 0\n      UP = 1\n      LEFT = 2\n      RIGHT = 3\n      USE = 4\n      \n      for action in [DOWN, UP, LEFT, RIGHT, USE]:\n          reward, new_state = state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbors.append((new_state, action, state_hash))\n      \n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, action, state_hash in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T11:06:52.399942", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(state):\n      neighbors = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          neighbors.append((new_state, action, state_hash))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for new_state, action, state_hash in get_neighbors(current_state):\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in range(env.world.cookbook.n_kinds):\n      raise ValueError(f\"Invalid goal item index: {goal_item}. Must be between 0 and {env.world.cookbook.n_kinds - 1}.\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T11:07:58.167406", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      # Priority queue for A* search\n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      \n      # Dictionary to store g_scores and came_from paths\n      g_scores = {initial_state: 0}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state)\n          \n          # Prioritize USE action first for crafting efficiency\n          use_action = 4\n          reward, new_use_state = current_state.step(use_action)\n          \n          state_hash_use = (tuple(new_use_state.grid.flatten()), \n                            tuple(new_use_state.inventory), \n                            new_use_state.pos, \n                            new_use_state.dir)\n          \n          if satisfies_goal(new_use_state, goal_item):\n              return path + [use_action]\n          \n          tentative_g_score = g_scores[current_state] + 1\n          \n          if state_hash_use not in g_scores or tentative_g_score < g_scores[state_hash_use]:\n              came_from[new_use_state] = (current_state, use_action)\n              g_scores[new_use_state] = tentative_g_score\n              f_score = tentative_g_score + heuristic(new_use_state, goal_item)\n              heapq.heappush(open_set, (f_score, new_use_state, path + [use_action]))\n              \n          # Then explore other movement actions\n          for action in range(env.world.n_actions - 1):  # Exclude USE action\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              tentative_g_score = g_scores[current_state] + 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_scores[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n          previous, action = came_from[current]\n          total_path.append(action)\n          current = previous\n      return total_path[::-1]\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on distance to nearest resource needed for the goal\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      # Get primitives required for the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      \n      min_distance = float('inf')\n      \n      for primitive, count in primitives_needed.items():\n          if state.inventory[primitive] >= count:\n              continue\n          \n          distances = []\n          for x in range(state.grid.shape[0]):\n              for y in range(state.grid.shape[1]):\n                  if state.grid[x, y, primitive] > 0:\n                      distance = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                      distances.append(distance)\n          \n          if distances:\n              min_distance = min(min_distance, min(distances))\n      \n      return min_distance\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
