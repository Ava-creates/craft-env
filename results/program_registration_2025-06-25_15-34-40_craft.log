{"timestamp": "2025-06-26T12:44:49.351370", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  def get_primitives_for_goal(goal_item):\n      return env.world.cookbook.primitives_for(goal_item)\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(pos, goal_item):\n      # Simple Manhattan distance to nearest workshop that has the required item\n      min_distance = float('inf')\n      for x in range(env.world.grid.shape[0]):\n          for y in range(env.world.grid.shape[1]):\n              if env.world.workshop_indices[x, y] and get_primitives_for_goal(goal_item):\n                  distance = abs(x - pos[0]) + abs(y - pos[1])\n                  min_distance = min(min_distance, distance)\n      return min_distance\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:45:05.805123", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:46:04.701747", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(new_state, goal_item):\n      # Heuristic: prioritize states where the inventory has increased towards the goal item\n      current_inventory = new_state.inventory.copy()\n      current_inventory[new_state.world.stone_index] = 0  # Ignore stone for heuristic purposes\n      return np.linalg.norm(current_inventory - initial_inventory)\n\n  def astar_search(initial_state, goal_item, depth_limit=50):  \n      from heapq import heappush, heappop\n      \n      open_set = [(0, initial_state, [], 0)]  # (f_score, state, path, current_depth)\n      visited = set()\n      \n      while open_set:\n          f_score, current_state, path, current_depth = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if current_depth >= depth_limit:  \n              continue\n          \n          for action in [1, 0, 2, 3, 4]:  # Try actions in a specific order: UP, DOWN, LEFT, RIGHT, USE\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  g_score = current_depth + 1\n                  h_score = heuristic(new_state, goal_item)\n                  f_score = g_score + h_score\n                  heappush(open_set, (f_score, new_state, path + [action], g_score))\n      \n      return None  \n\n  initial_inventory = env._current_state.inventory.copy()\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  ", "island_id": 2, "scores": {"3": -1}}
