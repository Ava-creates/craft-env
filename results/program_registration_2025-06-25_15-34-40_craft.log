 in sorted(use_actions, key=lambda x: -x[1]):  # Sort by negative reward to prioritize higher rewards\n        state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n      \n      # Then add other actions\n      for action, _, new_state in sorted(other_actions, key=lambda x: -x[1]):\n        state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_item_index(item_name, cookbook):\n    try:\n      return cookbook.index[item_name]\n    except KeyError:\n      raise ValueError(f\"Item '{item_name}' not found in the cookbook.\")\n\n  initial_state = env._current_state\n  goal_item_name = item\n  \n  # Convert item name to index if it's a string\n  if isinstance(item, str):\n    try:\n      goal_item = get_item_index(goal_item_name, initial_state.world.cookbook)\n    except ValueError as e:\n      print(e)\n      return []\n  else:\n    goal_item = item\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"No valid action sequence found to craft the item.\")\n  \n  return action_sequence", "island_id": 7, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T06:34:24.987076", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          action_priorities = []\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  action_priorities.append((action, path + [action], len(goal_primitives) - sum(1 for p in goal_primitives if new_state.inventory[p] >= goal_primitives[p])))\n          \n          # Sort actions by the number of primitives still needed (fewer first)\n          action_priorities.sort(key=lambda x: x[2])\n          \n          for action, path, _ in action_priorities:\n              queue.appendleft((current_state.step(action)[1], path))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T06:34:26.246463", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def is_ingredient_available(state, ingredient_index):\n      \"\"\"Check if the ingredient is available on the grid.\"\"\"\n      neighborhood = state.grid[max(0, state.pos[0] - 1):min(env.world.scenario.init_grid.shape[0], state.pos[0] + 2),\n                                 max(0, state.pos[1] - 1):min(env.world.scenario.init_grid.shape[1], state.pos[1] + 2), :]\n      return np.any(neighborhood[:, :, ingredient_index])\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      available_count = sum(\n                          np.sum(new_state.grid[:, :, primitive]),\n                          new_state.inventory[primitive]\n                      )\n                      if available_count < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Check if ingredient is available on the grid for pickup actions\n              if action in [0, 1, 2, 3]:  # DOWN, UP, LEFT, RIGHT\n                  current_ingredient = new_state.inventory.argmax()\n                  if not is_ingredient_available(new_state, current_ingredient):\n                      continue  # Skip this action as the ingredient isn't available\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T06:36:59.600178", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      state_to_goal_primitives = {state_hash(initial_state): get_primitive_counts(goal_item, initial_state.world.cookbook)}\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item from the cache or compute them\n          goal_primitives = state_to_goal_primitives[state_hash(current_state)]\n          \n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, path + [action]))\n\n          # Heuristic: Prioritize actions that move closer to having required primitives\n          possible_actions.sort(\n              key=lambda x: sum(min(get_primitive_counts(goal_item, x[0].world.cookbook).get(primitive, 0) - current_primitives, 0)\n                                  for primitive, current_primitives in goal_primitives.items()),\n              reverse=True\n          )\n\n          for new_state, path_with_action in possible_actions:\n              state_hash_val = state_hash(new_state)\n              \n              if state_hash_val not in visited:\n                  visited.add(state_hash_val)\n                  queue.append((new_state, path_with_action))\n                  # Cache the primitives needed for the goal item at this new state\n                  state_to_goal_primitives[state_hash_val] = get_primitive_counts(goal_item, new_state.world.cookbook)\n      \n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      \"\"\"Returns a hashable representation of the state.\"\"\"\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T06:37:15.097793", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n\n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      # Cache the primitive counts for the initial state\n      state_to_goal_primitives = {state_hash(initial_state): get_primitive_counts(goal_item, initial_state.world.cookbook)}\n\n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item from the cache\n          goal_primitives = state_to_goal_primitives[state_hash(current_state)]\n\n          # Filter and prioritize actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Heuristic: Prioritize actions that move closer to having required primitives\n              new_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n              heuristic_score = sum(new_primitives.get(primitive, 0) - current_primitives\n                                    for primitive, current_primitives in goal_primitives.items())\n\n              valid_actions.append((new_state, action, heuristic_score))\n\n          # Sort actions by heuristic score (descending order)\n          valid_actions.sort(key=lambda x: x[2], reverse=True)\n\n          for new_state, action, _ in valid_actions:\n              state_hash_val = state_hash(new_state)\n\n              if state_hash_val not in visited:\n                  visited.add(state_hash_val)\n                  queue.append((new_state, path + [action]))\n                  # Cache the primitives needed for the goal item at this new state\n                  state_to_goal_primitives[state_hash_val] = get_primitive_counts(goal_item, new_state.world.cookbook)\n\n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      \"\"\"Returns a hashable representation of the state.\"\"\"\n      grid_tuple = tuple(state.grid.flatten())\n      inventory_tuple = tuple(state.inventory)\n      pos_tuple = state.pos\n      dir_val = state.dir\n      return (grid_tuple, inventory_tuple, pos_tuple, dir_val)\n\n  initial_state = env._current_state\n  goal_item = item\n\n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}