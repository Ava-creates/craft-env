{"timestamp": "2025-06-26T10:22:40.958119", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def prioritize_actions(current_state):\n      priority_actions = []\n      \n      # Prioritize the USE action\n      reward, use_state = current_state.step(4)\n      if not np.array_equal(use_state.grid, current_state.grid) or\\\n         not np.array_equal(use_state.inventory, current_state.inventory) or\\\n         use_state.pos != current_state.pos or\\\n         use_state.dir != current_state.dir:\n          priority_actions.append((4, use_state))\n      \n      # Prioritize moving actions\n      for action in range(4):\n          reward, move_state = current_state.step(action)\n          if not np.array_equal(move_state.grid, current_state.grid) or\\\n             not np.array_equal(move_state.inventory, current_state.inventory) or\\\n             move_state.pos != current_state.pos or\\\n             move_state.dir != current_state.dir:\n              priority_actions.append((action, move_state))\n      \n      return [action for action, _ in sorted(priority_actions, key=lambda x: -x[1].inventory[item])]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get prioritized actions based on their potential to reach the goal faster\n          priority_actions = prioritize_actions(current_state)\n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:22:54.890185", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      \n      # Check USE action\n      reward, use_state = state.step(4)\n      if not np.array_equal(use_state.grid, state.grid) or\\\n         not np.array_equal(use_state.inventory, state.inventory) or\\\n         use_state.pos != state.pos or\\\n         use_state.dir != state.dir:\n          valid_actions.append(4)\n      \n      # Check movement actions\n      for action in range(4):\n          reward, move_state = state.step(action)\n          if not np.array_equal(move_state.grid, state.grid) or\\\n             not np.array_equal(move_state.inventory, state.inventory) or\\\n             move_state.pos != state.pos or\\\n             move_state.dir != state.dir:\n              valid_actions.append(action)\n      \n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          valid_actions = get_valid_actions(current_state)\n          for action in valid_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:23:42.836716", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE actions to speed up crafting\n          for action in [4] + list(range(4)):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Avoid revisiting states that have been visited with the same inventory and position\n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if state_key not in visited:\n                  visited.add(state_key)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  # If the initial BFS search fails, try a more exhaustive approach\n  if not action_sequence:\n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Explore all actions including movement and USE in a more exhaustive manner\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_key = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos)\n              if state_key not in visited:\n                  visited.add(state_key)\n                  queue.append((new_state, path + [action]))\n      \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
