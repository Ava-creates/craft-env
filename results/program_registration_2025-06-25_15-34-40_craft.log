_actions.append((action, new_state))\n              else:\n                  # Add movement actions without checking primitives\n                  valid_actions.append((action, new_state))\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the environment is reset before starting a new search\n  env.reset()\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:48:35.792689", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n    initial_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n\n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n\n          if action == 4:  # USE action\n              can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n              if not can_make_goal:\n                  continue\n\n          valid_actions.append((action, new_state))\n      \n      for action, new_state in valid_actions:\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(actions, initial_state):\n      \"\"\"Optimizes the action sequence by removing redundant movements and combining actions where possible.\"\"\"\n      optimized_actions = []\n      current_state = initial_state.copy()\n      \n      for action in actions:\n          reward, new_state = current_state.step(action)\n          \n          # Check if the USE action results in a change in inventory\n          if action == 4:  # USE action\n              if np.any(new_state.inventory != current_state.inventory):\n                  optimized_actions.append(action)\n          else:\n              optimized_actions.append(action)\n          \n          current_state = new_state\n      \n      return optimized_actions\n\n  initial_state = env._current_state.copy()\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    return []\n\n  # Optimize the action sequence\n  optimized_sequence = optimize_action_sequence(action_sequence, initial_state)\n  \n  return optimized_sequence", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T13:48:46.000445", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n    initial_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n    while queue:\n      current_state, path = queue.popleft()\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n\n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n          reward, new_state = current_state.step(action)\n\n          if action == 4:  # USE action\n              can_make_goal = all(new_state.inventory[primitive] >= count for primitive, count in goal_primitives.items())\n              if not can_make_goal:\n                  continue\n\n          valid_actions.append((action, new_state))\n      \n      # Prioritize actions that bring the agent closer to having required primitives\n      valid_actions.sort(key=lambda x: sum(x[1].inventory[p] >= c for p, c in goal_primitives.items()), reverse=True)\n      \n      for action, new_state in valid_actions:\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:50:18.688294", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]\n      return [n for n in neighbors if 0 <= n[0] < env.world.scenario.init_grid.shape[0] and 0 <= n[1] < env.world.scenario.init_grid.shape[1]]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Prioritize USE action if nearby resources can contribute to making the goal item\n          use_actions = []\n          move_actions = []\n\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      use_actions.append((new_state, path + [action]))\n              else:  # MOVE action\n                  move_actions.append((new_state, path + [action]))\n\n          # Convert states to hashable form and add to queue\n          for new_state, new_path in sorted(use_actions + move_actions, key=lambda x: -sum(x[0].inventory[i] for i in goal_primitives)):\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, new_path))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T13:50:20.086047", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]\n      return [n for n in neighbors if 0 <= n[0] < env.world.scenario.init_grid.shape[0] and 0 <= n[1] < env.world.scenario.init_grid.shape[1]]\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of missing primitives\n      required_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      inventory = {i: count for i, count in enumerate(state.inventory) if count > 0}\n      missing_count = sum(required_primitives.get(i, 0) - inventory.get(i, 0) for i in required_primitives)\n      return max(0, missing_count)\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state, goal_item), initial_state, [], 0))\n      visited = set()\n      \n      while not open_set.empty():\n          _, current_state, path, g_score = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  f_score = g_score + 1 + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action], g_score + 1))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
