{"timestamp": "2025-06-27T03:32:21.366470", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Determine which actions are relevant based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count \n                                      for primitive, count in goal_primitives.items())\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def find_shortest_path(goal_item):\n      initial_state = env._current_state\n      action_sequence = bfs_search(initial_state, goal_item)\n\n      return action_sequence if action_sequence else []  # Return empty list if no actions found\n\n  def collect_primitives(primitive_counts):\n      current_state = env._current_state\n      action_sequence = []\n\n      for primitive, count in primitive_counts.items():\n          while current_state.inventory[primitive] < count:\n              subgoal_path = find_shortest_path(primitive)\n              if not subgoal_path:\n                  return None  # Cannot satisfy the requirement\n              \n              action_sequence.extend(subgoal_path)\n              reward, current_state = current_state.step(4)  # USE to collect the primitive\n\n      return action_sequence\n\n  def construct_goal(goal_item):\n      initial_state = env._current_state\n      action_sequence = []\n\n      if satisfies_goal(initial_state, goal_item):\n          return action_sequence\n      \n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      collection_sequence = collect_primitives(goal_primitives)\n\n      if not collection_sequence:\n          return None  # Cannot collect all required primitives\n\n      action_sequence.extend(collection_sequence)\n      \n      while not satisfies_goal(env._current_state, goal_item):\n          subgoal_path = find_shortest_path(goal_item)\n          if not subgoal_path:\n              return None  # Cannot satisfy the requirement\n\n          action_sequence.extend(subgoal_path)\n          reward, new_state = env._current_state.step(4)  # USE to craft the goal item\n          env._current_state = new_state\n\n      return action_sequence\n\n  goal_item = item\n  return construct_goal(goal_item) if goal_item in env.world.cookbook.recipes else []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:32:22.591431", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Determine which actions are relevant based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count \n                                      for primitive, count in goal_primitives.items())\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current_state to reach the goal_item.\"\"\"\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      missing_primitives = {primitive: count - current_state.inventory[primitive] \n                            for primitive, count in goal_primitives.items() \n                            if count > current_state.inventory[primitive]}\n      \n      # Estimate the cost based on the number of missing primitives\n      return sum(missing_primitives.values())\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Determine which actions are relevant based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = all(new_state.inventory[primitive] >= count \n                                      for primitive, count in goal_primitives.items())\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      while current_state in came_from:\n          previous_state, action = came_from[current_state]\n          path.append(action)\n          current_state = previous_state\n      return path[::-1]  # Reverse the path to get it from start to goal\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:34:12.174688", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      state_to_goal_primitives = {state_hash(initial_state): get_primitive_counts(goal_item, initial_state.world.cookbook)}\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item from the cache or compute them\n          goal_primitives = state_to_goal_primitives[state_hash(current_state)]\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, path + [action]))\n\n          # Heuristic: Prioritize actions that move closer to having required primitives\n          possible_actions.sort(\n              key=lambda x: sum(min(get_primitive_counts(goal_item, x[0].world.cookbook).get(primitive, 0) - current_primitives, 0)\n                                  for primitive, current_primitives in goal_primitives.items()),\n              reverse=True\n          )\n\n          # Explore actions that move the agent towards primitives needed for crafting\n          for new_state, path_with_action in possible_actions:\n              state_hash_val = state_hash(new_state)\n              \n              if state_hash_val not in visited:\n                  visited.add(state_hash_val)\n                  queue.append((new_state, path_with_action))\n                  # Cache the primitives needed for the goal item at this new state\n                  state_to_goal_primitives[state_hash_val] = get_primitive_counts(goal_item, new_state.world.cookbook)\n\n          # Explore actions that move the agent towards primitives needed for crafting\n          # Prioritize moving to locations where primitives are available or closer to required items\n          if not possible_actions:\n              for action in range(initial_state.world.n_actions):\n                  reward, new_state = current_state.step(action)\n                  state_hash_val = state_hash(new_state)\n                  \n                  if state_hash_val not in visited:\n                      visited.add(state_hash_val)\n                      queue.append((new_state, path + [action]))\n\n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      \"\"\"Returns a hashable representation of the state.\"\"\"\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
