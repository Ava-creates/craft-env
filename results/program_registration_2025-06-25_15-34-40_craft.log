{"timestamp": "2025-06-26T13:59:00.044416", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: the number of items in inventory towards the goal\n      if not env.world.cookbook.primitives_for(goal_item):\n          return 0\n      required_primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = {index: count for index, count in enumerate(state.inventory) if count > 0}\n      \n      # Calculate the heuristic as the number of unique primitives already available\n      heuristic_value = sum(1 for primitive, _ in required_primitives.items() if primitive in current_inventory)\n      return -heuristic_value  # Negative because we want to maximize this value\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  f_score = len(path) + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
