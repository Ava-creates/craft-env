{"timestamp": "2025-06-27T02:35:50.878563", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Get all possible actions from the current state\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((action, new_state))\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_nearest_workshop(initial_state, workshops):\n      min_distance = float('inf')\n      nearest_workshop = None\n      pos_x, pos_y = initial_state.pos\n      \n      for workshop_pos in workshops:\n          dist = abs(workshop_pos[0] - pos_x) + abs(workshop_pos[1] - pos_y)\n          if dist < min_distance:\n              min_distance = dist\n              nearest_workshop = workshop_pos\n      \n      return nearest_workshop\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Get all workshops in the grid\n  workshops = [(x, y) for x in range(initial_state.grid.shape[0]) \n                         for y in range(initial_state.grid.shape[1]) \n                         if np.any(initial_state.grid[x, y] == initial_state.world.workshop_indices)]\n  \n  # If no workshops are found, return an empty list\n  if not workshops:\n      return []\n  \n  nearest_workshop = get_nearest_workshop(initial_state, workshops)\n  \n  def move_to_position(state, target_pos):\n      path = []\n      pos_x, pos_y = state.pos\n      dir_x, dir_y = [(0, 1), (0, -1), (-1, 0), (1, 0)][state.dir]\n      \n      while (pos_x, pos_y) != target_pos:\n          # Calculate the direction to move\n          dx = target_pos[0] - pos_x\n          dy = target_pos[1] - pos_y\n          \n          if dx > 0 and dir_x == 0:\n              path.append(3)  # RIGHT\n          elif dx < 0 and dir_x == 0:\n              path.append(2)  # LEFT\n          elif dy > 0 and dir_y == 0:\n              path.append(0)  # DOWN\n          elif dy < 0 and dir_y == 0:\n              path.append(1)  # UP\n          \n          # Update position and direction\n          reward, new_state = state.step(path[-1])\n          pos_x, pos_y = new_state.pos\n          dir_x, dir_y = [(0, 1), (0, -1), (-1, 0), (1, 0)][new_state.dir]\n          \n      return path\n\n  # Move to the nearest workshop\n  path_to_workshop = move_to_position(initial_state, nearest_workshop)\n  \n  if not path_to_workshop:\n      return []\n  \n  initial_state_after_move = env._current_state\n  \n  action_sequence = bfs_search(initial_state_after_move, goal_item)\n\n  if not action_sequence:\n      return []\n  \n  return path_to_workshop + action_sequence  # Return combined actions to reach workshop and craft item", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T02:37:34.193034", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      seen_primitives = set()  # Track the set of primitives already considered\n      initial_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Check if all required primitives are available or can be made\n          if all(primitive in seen_primitives or primitive in current_state.inventory \n                 for primitive in initial_primitives):\n              continue  # Skip this state as it doesn't have new information about primitives\n\n          seen_primitives.update(current_state.inventory)\n\n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              possible_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal and move closer to required ingredients\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives),  # More primitives used first\n                  sum(initial_state.next_to(primitive) for primitive in goal_primitives),   # Closer to ingredients first\n                  len([ingredient for ingredient, count in goal_primitives.items() if new_state.inventory[ingredient] < count])  # Fewer missing primitives first\n              )\n          )\n          \n          for new_state, action in sorted_possible_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
