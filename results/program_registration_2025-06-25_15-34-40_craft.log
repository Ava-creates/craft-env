{"timestamp": "2025-06-27T05:37:04.864337", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_pickup_actions_for_primitives(initial_state, primitives):\n      pickup_actions = []\n      for primitive, required_count in primitives.items():\n          while initial_state.inventory[primitive] < required_count:\n              # Find the position of the primitive on the grid\n              pos = np.argwhere(initial_state.grid[:, :, primitive] > 0)\n              if len(pos) == 0:\n                  break  # No more primitives found on the grid, break the loop\n              \n              for p in pos:\n                  x, y = p\n                  dx, dy = x - initial_state.pos[0], y - initial_state.pos[1]\n                  \n                  # Determine direction to move towards the primitive\n                  if abs(dx) >= abs(dy):\n                      dir_x = 1 if dx > 0 else -1\n                      dir_y = 0\n                  else:\n                      dir_x = 0\n                      dir_y = 1 if dy > 0 else -1\n                  \n                  # Move in the determined direction\n                  move_actions = []\n                  while initial_state.pos[0] + dir_x != x or initial_state.pos[1] + dir_y != y:\n                      dx, dy = x - initial_state.pos[0], y - initial_state.pos[1]\n                      \n                      if dx > 0 and initial_state.dir == 2:  # Move RIGHT\n                          move_actions.append(3)\n                      elif dx < 0 and initial_state.dir == 3:  # Move LEFT\n                          move_actions.append(2)\n                      elif dy > 0 and initial_state.dir == 1:  # Move DOWN\n                          move_actions.append(0)\n                      elif dy < 0 and initial_state.dir == 0:  # Move UP\n                          move_actions.append(1)\n                      \n                      else:\n                          if dx > 0:  # Turn to face RIGHT\n                              move_actions.extend([2, 3])\n                          elif dx < 0:  # Turn to face LEFT\n                              move_actions.extend([3, 2])\n                          elif dy > 0:  # Turn to face DOWN\n                              move_actions.extend([1, 0])\n                          elif dy < 0:  # Turn to face UP\n                              move_actions.extend([0, 1])\n                      \n                      initial_state, _ = initial_state.step(move_actions[-1])\n                  \n                  # Pickup the primitive\n                  pickup_actions.append(4)\n                  initial_state, _ = initial_state.step(4)\n      \n      return pickup_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Preprocess: Collect all possible primitives needed for the goal item\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  \n  # Get actions to pick up required primitives\n  pickup_actions = get_pickup_actions_for_primitives(initial_state, goal_primitives)\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      return pickup_actions + action_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T05:37:06.068700", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      # Heuristic based on the number of missing primitives needed to make the goal item\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      current_primitives = {i: state.inventory[i] for i in goal_primitives if state.inventory[i] > 0}\n      \n      missing_primitives = {k: v - current_primitives.get(k, 0) for k, v in goal_primitives.items()}\n      return sum(missing_primitives.values())\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (heuristic(new_state, goal_item) + len(path) + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-27T05:39:43.328674", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action, action_type = action_tuple\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # Only consider USE actions for prioritization\n                  primitives_satisfied = sum(\n                      new_state.inventory[primitive] >= count \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return (-primitives_satisfied,)  # Negative to sort descending\n              else:\n                  # Prioritize moving towards primitives that are needed and nearby\n                  nearby_primitives = sum(\n                      new_state.next_to(primitive) \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return (nearby_primitives,)\n          \n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=prioritize_action, reverse=True)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T05:39:51.865628", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      possible_actions.append((action, 'use'))\n              else:\n                  possible_actions.append((action, 'move'))\n          \n          # Prioritize USE actions over MOVE actions based on how many primitives are satisfied\n          def prioritize_action(action_tuple):\n              action, _ = action_tuple\n              reward, new_state = current_state.step(action)\n              if action == 4:  # Only consider USE actions for prioritization\n                  primitives_satisfied = sum(\n                      new_state.inventory[primitive] >= count \n                      for primitive, count in goal_primitives.items()\n                  )\n                  return (-primitives_satisfied,)  # Negative to sort descending\n              return (0,)  # Move actions have priority 0\n      \n          prioritized_actions = [action for action, _ in sorted(possible_actions, key=prioritize_action)]\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def find_path_to_primitive(initial_state, primitive_index):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if current_state.inventory[primitive_index] > 0:\n              return path\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = []\n  \n  # Collect primitives needed for the goal item\n  goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n  \n  for primitive_index, count in goal_primitives.items():\n      while initial_state.inventory[primitive_index] < count:\n          path_to_primitive = find_path_to_primitive(initial_state, primitive_index)\n          if path_to_primitive is not None:\n              action_sequence.extend(path_to_primitive)\n              # Simulate taking the actions to update the initial state\n              for action in path_to_primitive:\n                  _, initial_state = initial_state.step(action)\n          else:\n              raise ValueError(f\"Cannot find a way to obtain {primitive_index} required for {goal_item}\")\n  \n  # Now that all primitives are obtained, try to craft the goal item\n  remaining_actions = bfs_search(initial_state, goal_item)\n  if remaining_actions is not None:\n      action_sequence.extend(remaining_actions)\n  else:\n      raise ValueError(f\"Cannot find a way to craft the goal item {goal_item}\")\n  \n  return action_sequence", "island_id": 0, "scores": {"3": 1.1}}
