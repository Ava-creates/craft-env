t can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((action, new_state))\n          \n          # Prioritize USE actions for efficiency\n          use_actions = [action for action, _ in valid_actions if action == 4]\n          other_actions = [action for action, _ in valid_actions if action != 4]\n\n          # Add USE actions first to the queue to prioritize them\n          for action in use_actions + other_actions:\n              new_state = next((new_state for a, new_state in valid_actions if a == action), None)\n              if new_state:\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 2.0}}
