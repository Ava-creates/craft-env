{"timestamp": "2025-06-26T18:42:16.748292", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item, cookbook):\n      # A simple heuristic function that counts the number of missing ingredients\n      if current_state.inventory[goal_item] > 0:\n          return 0\n      \n      primitive_counts = cookbook.primitives_for(goal_item)\n      missing_count = sum(primitive_counts[kind] for kind in primitive_counts if current_state.inventory[kind] < primitive_counts[kind])\n      \n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item, env.world.cookbook), 0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              # Skip USE action if there's nothing to use in the 3x3 grid around the agent\n              if action == 4:\n                  if not any(current_state.grid[\n                      max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                      max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n                  ].flatten()):\n                      continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Each action has a cost of 1\n            \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item, env.world.cookbook)\n                  heappush(open_set, (f_score, tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:43:11.360205", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # A simple heuristic: number of items in the inventory that are not the goal item\n      return np.sum(state.inventory) - state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # Priority queue with f_score as priority\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each step has the same cost of 1\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:43:12.429463", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item, cookbook):\n      \"\"\"\n      Heuristic function to estimate the cost from current_state to reach the goal_item.\n      This simple heuristic is based on the number of steps needed to gather all required primitives.\n      \"\"\"\n      # Get the primitives required for the goal item\n      primitives = cookbook.primitives_for(goal_item)\n      \n      if not primitives:\n          return float('inf')  # If no recipe, return a high cost\n      \n      # Calculate the total number of primitive items missing from the inventory\n      missing_primitives = sum(\n          count - current_state.inventory[primitive] \n          for primitive, count in primitives.items() \n          if count > current_state.inventory[primitive]\n      )\n      \n      return missing_primitives\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Each action has cost 1\n      \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item, env.world.cookbook)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      while current_state in came_from:\n          current_state = came_from[current_state]\n          total_path = [total_path[-1]] + total_path  # Prepend the action to the path\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:44:16.704894", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          # Prioritize USE action and then prioritize movement in cardinal directions\n          priority_actions = [4] + [1, 3, 0, 2]  # UP, RIGHT, DOWN, LEFT\n\n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:44:46.752975", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_reachable_primitives(state):\n      reachable = set()\n      queue = [state]\n      \n      while queue:\n          current_state = queue.pop(0)\n          \n          # Collect all primitives in the current state's inventory\n          for idx, count in enumerate(current_state.inventory):\n              if count > 0 and idx in env.world.cookbook.primitives:\n                  reachable.add(idx)\n          \n          # Explore next states using available actions\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if new_state not in queue and new_state != current_state:  # Avoid revisiting same state\n                  queue.append(new_state)\n      \n      return reachable\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action over movement actions and avoid revisiting states\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  # Get reachable primitives from the current state\n  reachable_primitives = get_reachable_primitives(initial_state)\n  \n  # Check if all required primitives for the goal are reachable\n  primitives_needed = env.world.cookbook.primitives_for(goal_item)\n  \n  if not primitives_needed:\n      print(\"No recipe available to craft the item.\")\n      return []\n\n  missing_primitives = [idx for idx, count in primitives_needed.items() if idx not in reachable_primitives]\n  \n  if missing_primitives:\n      print(f\"Missing primitives: {missing_primitives}\")\n      return []  # Return empty list if some required primitives are not reachable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:46:03.877271", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n\n          # Skip adding unchanged states to the queue\n          if np.array_equal(new_state.grid, state.grid) and\\\n             np.array_equal(new_state.inventory, state.inventory) and\\\n             new_state.pos == state.pos and\\\n             new_state.dir == state.dir:\n              continue\n\n          valid_actions.append(action)\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Calculate Manhattan distance to the nearest occurrence of the goal item\n      if satisfies_goal(state, goal_item):\n          return 0\n      \n      distances = []\n      pos = np.array(state.pos)\n      \n      for x in range(env.world.scenario.init_grid.shape[0]):\n          for y in range(env.world.scenario.init_grid.shape[1]):\n              if state.grid[x, y, goal_item] > 0:\n                  dist = abs(x - pos[0]) + abs(y - pos[1])\n                  distances.append(dist)\n      \n      return min(distances) if distances else float('inf')\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:46:04.873509", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n\n          # Skip adding unchanged states to the queue\n          if np.array_equal(new_state.grid, state.grid) and \\\n             np.array_equal(new_state.inventory, state.inventory) and \\\n             new_state.pos == state.pos and \\\n             new_state.dir == state.dir:\n              continue\n\n          valid_actions.append((action, reward))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: the more of the goal item in inventory, the better\n      return -state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_cost, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, reward in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1 - reward  # Penalize negative rewards\n\n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  if goal_item in env.world.non_grabbable_indices:\n      raise ValueError(f\"Goal item {goal_item} is non-grabbable and cannot be crafted.\")\n\n  # If the goal item is already available, return an empty path\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:47:26.496501", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_action_sequence(action_sequence):\n    from collections import defaultdict\n    \n    # Remove consecutive opposite actions (e.g., LEFT RIGHT)\n    optimized_actions = []\n    i = 0\n    while i < len(action_sequence):\n        if action_sequence[i] == 0 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 1:\n            i += 2\n        elif action_sequence[i] == 1 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 0:\n            i += 2\n        elif action_sequence[i] == 2 and i + 1 < len(action_sequence) and action_sequence[i + 3] == 3:\n            i += 2\n        elif action_sequence[i] == 3 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 2:\n            i += 2\n        else:\n            optimized_actions.append(action_sequence[i])\n            i += 1\n\n    return optimized_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"First BFS search failed. Resetting environment and retrying...\")\n    \n    # Reset the environment to a new scenario with the same goal\n    env.world.sample_scenario_with_goal(goal_item)\n    initial_state = env._current_state\n    \n    action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      optimized_actions = optimize_action_sequence(action_sequence)\n      return optimized_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:47:42.080992", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item, max_retries=5):\n    for _ in range(max_retries):\n        env.reset()\n        initial_state = env._current_state\n        action_sequence = bfs_search(initial_state, goal_item)\n        if action_sequence:\n            return action_sequence\n    return None\n\n  def optimize_action_sequence(action_sequence):\n      # Implement optimization logic here (e.g., remove redundant movements)\n      from collections import defaultdict\n      \n      # Remove consecutive opposite actions (e.g., LEFT RIGHT)\n      optimized_actions = []\n      i = 0\n      while i < len(action_sequence):\n          if action_sequence[i] == 0 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 1:\n              i += 2\n          elif action_sequence[i] == 1 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 0:\n              i += 2\n          elif action_sequence[i] == 2 and i + 1 < len(action_sequence) and action_sequence[i + 3] == 3:\n              i += 2\n          elif action_sequence[i] == 3 and i + 1 < len(action_sequence) and action_sequence[i + 1] == 2:\n              i += 2\n          else:\n              optimized_actions.append(action_sequence[i])\n              i += 1\n\n      # Further optimization can be done based on specific rules or heuristics\n      return optimized_actions\n\n  goal_item = item\n  action_sequence = retry_bfs_search(env, goal_item)\n\n  if not action_sequence:\n    print(\"First BFS search failed. Resetting environment and retrying...\")\n    \n    # Reset the environment to a new scenario with the same goal\n    env.world.sample_scenario()\n    initial_state = env._current_state\n    \n    action_sequence = bfs_search(initial_state, goal_item)\n  \n  if action_sequence:\n      optimized_actions = optimize_action_sequence(action_sequence)\n      return optimized_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
