{"timestamp": "2025-06-27T10:27:52.535283", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def heuristic(state, goal_item):\n    # Simple heuristic: number of missing primitive items\n    needed_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    missing_count = 0\n    for primitive, needed_amount in needed_primitives.items():\n      missing_count += max(0, needed_amount - state.inventory[primitive])\n    return missing_count\n\n  def a_star_search(initial_state, goal_item):\n    import heapq\n\n    open_set = []\n    heapq.heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n    visited = set()\n\n    while open_set:\n      f, current_state, path = heapq.heappop(open_set)\n\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          g = len(path) + 1\n          h = heuristic(new_state, goal_item)\n          f = g + h\n          heapq.heappush(open_set, (f, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T10:28:03.268370", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n\n    queue = deque([(initial_state, [])])\n    visited = set()\n\n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n      # Filter actions based on available inventory and required primitives\n      valid_actions = []\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if can_make_goal:\n            valid_actions.append(action)\n        else:\n          valid_actions.append(action)\n\n      # Prioritize actions that could lead to making the goal item\n      for action in valid_actions:\n        reward, new_state = current_state.step(action)\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T10:29:34.780261", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_primitives):\n      # Estimate cost based on the number of needed primitives already available\n      needed = sum(state.inventory[primitive] < count for primitive, count in goal_primitives.items())\n      near_resources = sum(state.next_to(primitive) for primitive in goal_primitives)\n      return needed - near_resources\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      start_time = time.time()\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      visited = set()\n      \n      while open_set:\n          f_score, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              print(f\"Goal reached in {time.time() - start_time:.2f} seconds.\")\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          possible_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              possible_actions.append((new_state, action))\n          \n          # Prioritize actions that move towards or use resources needed for the goal\n          sorted_possible_actions = sorted(\n              possible_actions,\n              key=lambda x: (\n                  -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives),\n                  sum(new_state.next_to(primitive) for primitive in goal_primitives)\n              )\n          )\n          \n          for new_state, action in sorted_possible_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  # Calculate f_score\n                  g_score = len(path) + 1\n                  h_score = heuristic(new_state, goal_primitives)\n                  f_score = g_score + h_score\n                  \n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      print(f\"Goal not reachable in {time.time() - start_time:.2f} seconds.\")\n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal