ble_actions.sort(key=lambda x: -1 if x[0] == 4 else 0)\n\n      for action, _, new_state in possible_actions:\n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n    for action in actions:\n      reward, done, observations = env.step(action)\n      if done:\n        break\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n    return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    execute_actions(env, action_sequence)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T23:54:16.317254", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Get valid actions from the current state\n          valid_actions = get_valid_actions(current_state)\n          \n          for action in valid_actions:\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_valid_actions(state):\n      actions = []\n      for action in range(state.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state has changed\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append(action)\n      \n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid\n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(f\"Goal item index {goal_item} is not a valid item.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T23:54:26.153756", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((new_state, action))\n          \n          # Prioritize actions that use resources needed for the goal\n          sorted_valid_actions = sorted(\n              valid_actions,\n              key=lambda x: -sum(new_state.inventory[primitive] > 0 for primitive in goal_primitives)\n          )\n          \n          for new_state, action in sorted_valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_valid_actions(state):\n      actions = []\n      for action in range(state.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state has changed\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append(action)\n      \n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is valid\n  if goal_item not in initial_state.world.cookbook.index.reverse_contents:\n      raise ValueError(f\"Goal item index {goal_item} is not a valid item.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 2.0}}
{"timestamp": "2025-06-26T23:55:16.470724", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if not np.array_equal(new_state.grid, state.grid) or not np.array_equal(new_state.inventory, state.inventory) or new_state.pos != state.pos or new_state.dir != state.dir:\n              valid_actions.append(action)\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in get_valid_actions(current_state):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
