t can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((action, new_state))\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:35:05.695494", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  # Assuming actions are enumerated from 0 to n_actions-1\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def bfs_search(initial_state, goal_item, max_steps=500):  # Added a max_steps parameter to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic: number of missing primitives.\"\"\"\n      cookbook = env.world.cookbook\n      required_primitives = cookbook.primitives_for(goal_item)\n      available_primitives = {idx: state.inventory[idx] for idx in env.world.grabbable_indices}\n      \n      # Count the number of missing primitives\n      missing_count = 0\n      \n      for primitive, count in required_primitives.items():\n          if primitive not in available_primitives:\n              missing_count += count\n          elif available_primitives[primitive] < count:\n              missing_count += count - available_primitives[primitive]\n      \n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))  # (f_score, state, path)\n      \n      g_scores = {initial_state: 0}\n      f_scores = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              tentative_g_score = g_scores[current_state] + 1  # Each step costs 1\n            \n              if new_state not in g_scores or tentative_g_score < g_scores[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_scores[new_state] = tentative_g_score\n                  f_scores[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_scores[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Try A* search first\n  action_sequence = a_star_search(initial_state, goal_item)\n  if action_sequence:\n      return action_sequence\n  \n  # If A* fails, try BFS as a fallback\n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T00:35:06.801364", "function_name": "craft", "function_body": "  def satisfies_goal(state: CraftState, goal_item: int) -> bool:\n      return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state: CraftState):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  # Assuming actions are enumerated from 0 to n_actions-1\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def bfs_search(initial_state: CraftState, goal_item: int, max_steps=500) -> list[int]:\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state: CraftState, goal_item: int) -> int:\n      \"\"\"Heuristic function to estimate cost from current state to goal.\"\"\"\n      # Simple heuristic: number of steps taken so far\n      # More sophisticated heuristics could be implemented based on domain knowledge\n      return len(state.inventory)\n\n  def a_star_search(initial_state: CraftState, goal_item: int, max_steps=500) -> list[int]:\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heapq.heappush(open_set, (len(path) + heuristic(new_state, goal_item), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Try A* search first\n  action_sequence = a_star_search(initial_state, goal_item)\n  if action_sequence:\n      return action_sequence\n  \n  # If A* fails, fall back to BFS\n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T00:36:16.825012", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Only add actions that change the state\n          if not np.array_equal(new_state.grid, state.grid) or \\\n             not np.array_equal(new_state.inventory, state.inventory) or \\\n             new_state.pos != state.pos or \\\n             new_state.dir != state.dir:\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get valid actions and resulting states\n          for action, new_state in get_valid_actions(current_state):\n              \n              # Create a hashable form of the state using tuples\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited_states:\n                  visited_states.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T00:36:18.004456", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitives_for_goal(env, goal):\n    cookbook = env.world.cookbook\n    if goal in cookbook.primitives:\n        return {goal: 1}\n    \n    primitives_needed = {}\n    stack = [goal]\n    visited = set()\n    \n    while stack:\n        current_goal = stack.pop()\n        if current_goal in visited or current_goal not in cookbook.recipes:\n            continue\n        \n        visited.add(current_goal)\n        recipe = cookbook.recipes[current_goal]\n        \n        for ingredient, count in recipe.items():\n            if ingredient == \"_key\":\n                continue\n            \n            if ingredient in cookbook.primitives:\n                if ingredient in primitives_needed:\n                    primitives_needed[ingredient] += count\n                else:\n                    primitives_needed[ingredient] = count\n            else:\n                stack.append(ingredient)\n    \n    return primitives_needed\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  primitives_needed = get_primitives_for_goal(env, goal_item)\n  \n  action_sequence = []\n  \n  for primitive, count in primitives_needed.items():\n    while current_state.inventory[primitive] < count:\n      # Find a path to collect this primitive\n      primitive_path = bfs_search(initial_state, primitive)\n      \n      if not primitive_path:\n          raise ValueError(f\"Cannot find a way to obtain the required primitive: {primitive}\")\n      \n      action_sequence.extend(primitive_path)\n      initial_state = current_state  # Update the state after each collection\n  \n      # Collect the primitive (assuming USE action is the last in the path)\n      reward, new_state = current_state.step(env.world.n_actions - 1)  # Assuming USE is the last action\n      current_state = new_state\n      \n  final_path = bfs_search(initial_state, goal_item)\n  \n  if not final_path:\n      raise ValueError(f\"Cannot find a way to craft the final item: {goal_item}\")\n  \n  action_sequence.extend(final_path)\n  \n  return action_sequence", "island_id": 2, "scores": {"3": -1}}
