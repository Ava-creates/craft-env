ate]\n          total_path.insert(0, action)  # Insert actions at the beginning of the path\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  def heuristic(state):\n    # Implement a simple heuristic if necessary (e.g., Manhattan distance to nearest resource)\n    return 0  # Default to zero for now\n\n  action_sequence = a_star_search(initial_state, goal_item, heuristic)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:06:11.977141", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_next_states(current_state):\n    next_states = []\n    for action in range(env.world.n_actions):\n      reward, new_state = current_state.step(action)\n      if reward < 0:  # Skip actions that result in negative rewards (e.g., picking up non-grabbable items)\n        continue\n      next_states.append((action, new_state))\n    return next_states\n\n  def bfs_search(initial_state, goal_item, max_depth=None):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # If a maximum depth is specified and the current depth exceeds it, skip further expansion\n      if max_depth is not None and len(path) >= max_depth:\n        continue\n      \n      for action, new_state in get_next_states(current_state):\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  max_depth = 50  # Set a reasonable maximum depth to avoid excessive search space exploration\n  action_sequence = bfs_search(initial_state, goal_item, max_depth)\n\n  if action_sequence is not None:\n    return action_sequence\n  else:\n    print(\"Goal not reachable.\")\n    return []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:06:12.951642", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_next_states(current_state):\n    next_states = []\n    for action in range(env.world.n_actions):\n      reward, new_state = current_state.step(action)\n      next_states.append((action, new_state))\n    return next_states\n\n  def heuristic(state, goal_item):\n    # Simple heuristic: count how many primitives are missing\n    cookbook = env.world.cookbook\n    if goal_item in cookbook.primitives:\n      return 0\n    \n    recipe = cookbook.recipes.get(goal_item)\n    if not recipe:\n      return float('inf')\n    \n    missing_primitives = 0\n    inventory_counts = state.inventory.copy()\n    \n    def count_missing_for_goal(goal_item, inventory):\n      nonlocal missing_primitives\n      recipe = cookbook.recipes.get(goal_item)\n      \n      if not recipe:\n        # If there's no recipe, it must be a primitive that we're missing\n        if inventory[goal_item] == 0:\n          missing_primitives += 1\n        return\n      \n      for ingredient, count in recipe.items():\n        if ingredient == '_key':\n          continue\n        \n        current_count = inventory[ingredient]\n        \n        if current_count >= count:\n          inventory[ingredient] -= count\n        else:\n          # Calculate how many more of this ingredient we need and recursively check\n          additional_needed = count - current_count\n          inventory[ingredient] = 0\n          count_missing_for_goal(ingredient, inventory)\n          \n          missing_primitives += additional_needed\n    \n    count_missing_for_goal(goal_item, inventory_counts)\n    return missing_primitives\n\n  def a_star_search(initial_state, goal_item):\n    import heapq\n    \n    open_set = []\n    heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n    \n    g_costs = {(tuple(initial_state.grid.flatten()), tuple(initial_state.inventory), initial_state.pos, initial_state.dir): 0}\n    came_from = {}\n    \n    while open_set:\n      _, current_cost, current_state, path = heapq.heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      for action, new_state in get_next_states(current_state):\n          state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n          \n          tentative_g_cost = current_cost + 1\n          \n          if state_hash not in g_costs or tentative_g_cost < g_costs[state_hash]:\n            g_costs[state_hash] = tentative_g_cost\n            f_cost = tentative_g_cost + heuristic(new_state, goal_item)\n            heapq.heappush(open_set, (f_cost, tentative_g_cost, new_state, path + [action]))\n            \n            came_from[state_hash] = current_state\n      \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n    print(f\"Goal reached with {len(action_sequence)} actions.\")\n    return action_sequence\n  else:\n    print(\"Goal not reachable.\")\n    return []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:07:22.194069", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(pos1, pos2):\n      # Manhattan distance as the heuristic\n      x1, y1 = pos1\n      x2, y2 = pos2\n      return abs(x1 - x2) + abs(y1 - y2)\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state.pos, env.scenario.init_pos)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming cost per action is 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = current_state\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state.pos, env.scenario.init_pos)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:07:23.201677", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate all possible actions and their resulting states\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_pos, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current position to reach a workshop.\"\"\"\n      # Find all workshops\n      workshops = [(x, y) for x in range(env.world.grid.shape[0]) \n                   for y in range(env.world.grid.shape[1]) \n                   if is_workshop((x, y))]\n      \n      # If no workshops are found, return a high cost (e.g., infinity)\n      if not workshops:\n          return float('inf')\n      \n      # Find the closest workshop\n      min_distance = min(abs(current_pos[0] - w[0]) + abs(current_pos[1] - w[1]) for w in workshops)\n      \n      return min_distance\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state.pos, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has a cost of 1\n            \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state.pos, goal_item)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:08:11.045499", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Sort actions to prioritize certain movements or interactions (e.g., use before move)\n          action_order = [4] + list(range(4))  # Prioritize 'USE' action\n          \n          for action in action_order:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
