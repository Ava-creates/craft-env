{"timestamp": "2025-06-26T22:47:34.875757", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine the agent's position and grid shape\n          pos = current_state.pos\n          grid_shape = current_state.grid.shape[:2]\n          \n          # Check if the agent is next to any required ingredients\n          for ingredient in env.world.cookbook.recipes.get(goal_item, {}).keys():\n              if ingredient == \"_key\":\n                  continue  # Skip the key placeholder\n              if current_state.next_to(ingredient):\n                  action = 4  # USE action\n                  reward, new_state = current_state.step(action)\n                  \n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      queue.append((new_state, path + [action]))\n          \n          # Consider moving to adjacent cells\n          for action in range(4):  # Movement actions (DOWN, UP, LEFT, RIGHT)\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T22:47:50.750793", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      neighbors = []\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < grid_shape[0] and 0 <= ny < grid_shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Determine the agent's position and grid shape\n          pos = current_state.pos\n          grid_shape = current_state.grid.shape[:2]\n          \n          # Consider moving to adjacent cells or using an item\n          for action in range(env.world.n_actions):\n              if action < 4:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n                  new_pos_candidates = get_neighbors(pos, grid_shape)\n                  if action < len(new_pos_candidates):\n                      new_pos = new_pos_candidates[action]\n                      # Check if the movement is valid and within bounds\n                      if 0 <= new_pos[0] < grid_shape[0] and 0 <= new_pos[1] < grid_shape[1]:\n                          reward, new_state = current_state.step(action)\n                  else:\n                      continue  # Skip invalid actions due to lack of neighbors\n              else:  # USE action\n                  reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T22:49:00.264654", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if not (np.array_equal(new_state.grid, state.grid) and\n                  np.array_equal(new_state.inventory, state.inventory) and\n                  new_state.pos == state.pos and\n                  new_state.dir == state.dir):\n              valid_actions.append((action, new_state))\n      return valid_actions\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of items needed to craft the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory[primitives_needed.keys()]\n      required_counts = np.array(list(primitives_needed.values()))\n      missing_items = required_counts - current_inventory\n      return int(np.sum(missing_items > 0))\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))  # (priority, state, path)\n      \n      g_scores = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory): 0}\n      \n      while not open_set.empty():\n          current_f, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action, new_state in get_valid_actions(current_state):\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory))\n              \n              tentative_g_score = g_scores[state_hash] + 1  # Assuming uniform cost of 1 for each action\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
