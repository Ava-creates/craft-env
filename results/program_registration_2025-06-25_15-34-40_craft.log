_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-06-27T09:11:40.281407", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T09:13:58.407186", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    \"\"\"Check if the inventory contains the goal item.\"\"\"\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    \"\"\"\n    Recursively determine the primitive counts needed to craft a given item.\n    \n    Args:\n        goal_index (int): The index of the goal item.\n        cookbook (Cookbook): The Cookbook instance containing recipe information.\n        \n    Returns:\n        dict: A dictionary mapping primitive indices to required counts.\n    \"\"\"\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      \"\"\"Depth-first search to collect primitives.\"\"\"\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    \"\"\"\n    Breadth-first search to find a sequence of actions to achieve the goal item.\n    \n    Args:\n        initial_state (CraftState): The starting state of the environment.\n        goal_item (int): The index of the goal item.\n        \n    Returns:\n        list[int]: A list of actions to reach the goal, or an empty list if no path is found.\n    \"\"\"\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited_states = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      # Check if the goal has been satisfied\n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited_states:\n          visited_states.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n    \"\"\"\n    Estimate the cost from current_state to reach the goal_item using a heuristic.\n    \n    Args:\n        current_state (CraftState): The current state of the environment.\n        goal_item (int): The index of the goal item.\n        \n    Returns:\n        int: An estimated cost to reach the goal item.\n    \"\"\"\n    primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n    current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n    \n    steps_needed = 0\n    for primitive, required_count in primitives_needed.items():\n      available_count = current_primitives.get(primitive, 0)\n      # Calculate the number of times we need to gather this primitive\n      additional_gatherings = max(0, (required_count - available_count) // (primitives_needed[primitive] / (available_count + 1)))\n      steps_needed += additional_gatherings\n    \n    return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n    \"\"\"\n    A* search algorithm to find the optimal sequence of actions to achieve the goal item.\n    \n    Args:\n        initial_state (CraftState): The starting state of the environment.\n        goal_item (int): The index of the goal item.\n        \n    Returns:\n        list[int]: A list of actions to reach the goal, or an empty list if no path is found.\n    \"\"\"\n    from heapq import heappush, heappop\n    import itertools\n    \n    open_set = []\n    open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n    heappush(open_set, (0 + heuristic(initial_state, goal_item), next(open_heap_counter), initial_state, []))\n    \n    visited_states = set()\n    \n    while open_set:\n      _, _, current_state, path = heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n            if new_state.inventory[primitive] < count:\n              can_make_goal = False\n              break\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited_states:\n          visited_states.add(state_hash)\n          heappush(open_set, (\n              len(path) + heuristic(new_state, goal_item),\n              next(open_heap_counter),\n              new_state,\n              path + [action]\n          ))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Use A* search to find the optimal action sequence\n  action_sequence = a_star_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
