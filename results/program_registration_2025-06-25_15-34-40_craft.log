{"timestamp": "2025-06-26T12:48:29.079394", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Cache the features_dict to avoid recomputation in step()\n          cached_features_dict = current_state.features_dict()\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Use the cached features_dict for the new state\n              new_state._cached_features_dict = {key: value.copy() for key, value in cached_features_dict.items()}\n              new_state._cached_features_dict['features_ego'] = np.roll(new_state._cached_features_dict['features_ego'], \n                                                                      (action - 2) % 4, axis=0)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (\n                  tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir\n              )\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T12:48:30.042091", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item, cookbook):\n      \"\"\"\n      Estimate the cost to reach the goal. This is a simple estimate based on\n      the number of ingredients needed for the goal item and its dependencies.\n      \"\"\"\n      from collections import deque\n      \n      # Initialize a queue for BFS\n      queue = deque([goal_item])\n      visited = set()\n      total_ingredients = 0\n      \n      while queue:\n          current_item = queue.popleft()\n          \n          if current_item not in visited:\n              visited.add(current_item)\n              \n              # If the item is an ingredient, count it\n              if current_item in cookbook.primitives or current_item in cookbook.environment:\n                  total_ingredients += 1\n              else:\n                  # Add its ingredients to the queue\n                  recipe = cookbook.recipes.get(current_item, {})\n                  for ingredient in recipe:\n                      if ingredient != \"_key\":\n                          queue.append(ingredient)\n      \n      return total_ingredients\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item, env.world.cookbook)}\n      \n      while open_set:\n          current_f, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Cache the features_dict to avoid recomputation in step()\n          cached_features_dict = current_state.features_dict()\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Use the cached features_dict for the new state\n              new_state._cached_features_dict = {key: value.copy() for key, value in cached_features_dict.items()}\n              new_state._cached_features_dict['features_ego'] = np.roll(new_state._cached_features_dict['features_ego'], \n                                                                      (action - 2) % 4, axis=0)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has the same cost of 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item, env.world.cookbook)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-26T12:49:15.454296", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # A simple heuristic: number of items needed to reach the goal\n      recipe = env.world.cookbook.recipes.get(goal_item, {})\n      required_items = set(recipe.keys()) - {\"_key\"}\n      return sum(1 for item in required_items if state.inventory[item] == 0)\n\n  def a_star_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      \n      g_score = {initial_state: 0}\n      came_from = {}\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item) or len(path) >= max_steps:\n              return path\n          \n          # Prioritize actions that involve using items (USE action)\n          priority_actions = [4] + list(range(env.world.n_actions - 1))  # Use action first, then others\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited or tentative_g_score < g_score.get(state_hash, float('inf')):\n                  came_from[state_hash] = current_state\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n                  visited.add(state_hash)\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
