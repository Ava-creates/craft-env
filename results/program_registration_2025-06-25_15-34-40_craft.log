ore\n                  f_score = tentative_g_score + heuristic(neighbor, goal_pos)\n                  heappush(open_set, (f_score, neighbor, path + [neighbor]))\n      \n      return None  # Return None if no path is found\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def is_workshop(pos):\n      x, y = pos\n      return env.world.workshop_indices[x, y]\n\n  initial_state = env._current_state\n  goal_item = item\n\n  # Find all workshops\n  target_workshops = [(x, y) for x in range(env.world.grid.shape[0]) \n                      for y in range(env.world.grid.shape[1]) if is_workshop((x, y))]\n  \n  # Try to find a path to any workshop and then attempt crafting from there\n  action_sequence = []\n  for workshop in target_workshops:\n      min_cost_path = astar_search(initial_state.pos, workshop)\n      \n      if min_cost_path:\n          # Convert the move-to-workshop path to action sequence\n          current_pos = initial_state.pos\n          for next_pos in min_cost_path:\n              dx = next_pos[0] - current_pos[0]\n              dy = next_pos[1] - current_pos[1]\n              \n              if dx == -1 and dy == 0:  # LEFT\n                  action_sequence.append(2)\n              elif dx == 1 and dy == 0:  # RIGHT\n                  action_sequence.append(3)\n              elif dx == 0 and dy == -1:  # DOWN\n                  action_sequence.append(0)\n              elif dx == 0 and dy == 1:  # UP\n                  action_sequence.append(1)\n              \n              current_pos = next_pos\n      \n          # Once at the workshop, try crafting\n          new_state = initial_state\n          for action in action_sequence:\n              _, new_state = new_state.step(action)\n          \n          if satisfies_goal(new_state, goal_item):\n              return action_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
