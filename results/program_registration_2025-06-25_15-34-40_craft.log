{"timestamp": "2025-06-26T07:45:58.168853", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Filter actions that lead to a change in the state (useful for reducing search space)\n          possible_actions = filter_valid_actions(current_state)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def filter_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state is different from the current state\n          if (not np.array_equal(new_state.grid, state.grid) or \n              not np.array_equal(new_state.inventory, state.inventory) or \n              new_state.pos != state.pos or \n              new_state.dir != state.dir):\n              valid_actions.append(action)\n      return valid_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Ensure the goal item has a recipe or is a primitive\n  cookbook = env.world.cookbook\n  if goal_item not in cookbook.recipes and goal_item not in cookbook.primitives:\n      raise ValueError(f\"Goal item {goal_item} cannot be crafted or is unknown.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:46:12.178382", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Filter actions that lead to a change in the state (useful for reducing search space)\n          possible_actions = filter_valid_actions(current_state)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def filter_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          _, new_state = state.step(action)\n          \n          # Check if the new state is different from the current state\n          if (not np.array_equal(new_state.grid, state.grid) or \n              not np.array_equal(new_state.inventory, state.inventory) or \n              new_state.pos != state.pos or \n              new_state.dir != state.dir):\n              valid_actions.append(action)\n      return valid_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Ensure the goal item has a recipe or is a primitive\n  cookbook = env.world.cookbook\n  if goal_item not in cookbook.recipes and goal_item not in cookbook.primitives:\n      raise ValueError(f\"Goal item {goal_item} cannot be crafted or is unknown.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:47:03.047223", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"\n      Heuristic function to estimate the cost from the current state to the goal.\n      This can be based on various factors like distance to workstations or availability of ingredients.\n      For simplicity, we'll use a basic heuristic that returns 1 if the goal item is in the inventory, else 0.\n      \"\"\"\n      return 0 if satisfies_goal(state, goal_item) else 1\n\n  def astar_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))  # (f_score, state, path)\n      g_scores = {initial_state: 0}\n      came_from = {}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          # Prioritize USE action over movement actions\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_scores[current_state] + 1  # Each step costs 1\n      \n              if new_state not in g_scores or tentative_g_score < g_scores[new_state]:\n                  came_from[new_state] = (current_state, path)\n                  g_scores[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      while current_state in came_from:\n          current_state, prev_path = came_from[current_state]\n          path = prev_path + path\n      return path\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:47:04.101700", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of primitive ingredients needed for the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = {env.world.cookbook.index.get(primitive): state.inventory[index] for primitive, index in primitives.items()}\n      \n      missing_primitives = 0\n      for primitive, required_count in primitives.items():\n          if current_inventory[env.world.cookbook.index.get(primitive)] < required_count:\n              missing_primitives += (required_count - current_inventory[env.world.cookbook.index.get(primitive)])\n      \n      return missing_primitives\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, cost_so_far, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action over movement actions\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = cost_so_far + 1\n                  heappush(open_set, (cost + heuristic(new_state, goal_item), cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:48:11.503814", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n      # Execute the actions to reach the goal state\n      for action in action_sequence:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:48:12.528658", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: count the number of required items not yet in inventory\n      if satisfies_goal(current_state, goal_item):\n          return 0\n      \n      recipe = env.world.cookbook.recipes.get(goal_item)\n      if not recipe:\n          return float('inf')  # No recipe available\n      \n      required_items = set(recipe.keys()) - {'_key'}\n      current_inventory = set(np.where(current_state.inventory > 0)[0])\n      \n      missing_items = required_items - current_inventory\n      return len(missing_items)\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              reconstruct_path(came_from, current_state)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has cost 1\n      \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current):\n      total_path = []\n      while current in came_from:\n          prev, actions = came_from[current]\n          total_path = actions + total_path\n          current = prev\n      return total_path\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:49:03.943071", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # A simple heuristic: distance to nearest resource needed for the goal\n      # Here we assume that all resources are equally important and can be found on the map.\n      \n      # Get the list of required ingredients for the goal item\n      recipe = env.world.cookbook.recipes.get(goal_item, {})\n      \n      # Find the nearest ingredient in the grid\n      min_distance = float('inf')\n      \n      for i_kind, count in recipe.items():\n          if i_kind == \"_key\":\n              continue  # Skip the _key entry which is not an ingredient index\n          \n          # Find all positions of this ingredient on the grid\n          positions = np.argwhere(state.grid[:, :, i_kind] > 0)\n          \n          for pos in positions:\n              distance = abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1])\n              min_distance = min(min_distance, distance)\n      \n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # priority queue\n      came_from = {}\n      g_score = {hash(initial_state): 0}\n      f_score = {hash(initial_state): heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action over movement actions\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              state_hash = hash(new_state)\n              \n              tentative_g_score = g_score[hash(current_state)] + 1  # Assume all actions have cost of 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Override the default __hash__ method to make CraftState hashable\n  def state_hash(self):\n      return hash((tuple(self.grid.flatten()), \n                   tuple(self.inventory), \n                   self.pos, \n                   self.dir))\n  \n  env.world.CraftState.__hash__ = state_hash\n\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T07:49:19.556277", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  # Added depth limit to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          # Prioritize USE action over movement actions and avoid revisiting states\n          priority_actions = [4] + list(range(env.world.n_actions))[:-1]\n          \n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:50:20.418712", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"BFS search failed. Attempting to reset environment and retry...\")\n    \n    # Reset the environment to a new scenario with the same goal\n    env.world.sample_scenario_with_goal(goal_item)\n    initial_state = env._current_state\n    \n    action_sequence = bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:50:21.392389", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n    \"\"\"\n    Heuristic function to estimate the cost from the current state to the goal.\n    Here we use a simple heuristic based on the number of items needed.\n    \"\"\"\n    cookbook = env.world.cookbook\n    primitives_needed = cookbook.primitives_for(goal_item)\n    \n    # Calculate the missing count for each primitive item\n    missing_count = 0\n    for i_primitive, count in primitives_needed.items():\n        if state.inventory[i_primitive] < count:\n            missing_count += (count - state.inventory[i_primitive])\n    \n    return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + (initial_state.pos,) + (initial_state.dir,): 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + (current_state.pos,) + (current_state.dir,)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()), \n                                          tuple(current_state.inventory), \n                                          current_state.pos, \n                                          current_state.dir)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
