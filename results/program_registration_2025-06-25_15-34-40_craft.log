an_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Calculate a simple score based on inventory progress towards primitives\n              score = sum(min(new_state.inventory[p], goal_primitives[p]) for p in goal_primitives)\n              action_scores.append((score, action))\n          \n          # Sort actions by score and try the best ones first\n          action_scores.sort(reverse=True, key=lambda x: x[0])\n          sorted_actions = [action for _, action in action_scores]\n          \n          for action in sorted_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in range(env.world.cookbook.n_kinds):\n      raise ValueError(f\"Unknown or invalid item index: {goal_item}\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
