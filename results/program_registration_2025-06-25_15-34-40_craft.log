t can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            current_state.pos, \n                            current_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T15:31:07.304812", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: number of primitives still needed to make the goal item\n      goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n      current_inventory = current_state.inventory\n      \n      required_primitives = {}\n      for primitive, count in goal_primitives.items():\n          if current_inventory[primitive] < count:\n              required_primitives[primitive] = count - current_inventory[primitive]\n      \n      return len(required_primitives)\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): 0}\n      f_score = {tuple(initial_state.grid.flatten()) + tuple(initial_state.inventory) + initial_state.pos + (initial_state.dir,): heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = tuple(new_state.grid.flatten()) + tuple(new_state.inventory) + new_state.pos + (new_state.dir,)\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos + (current_state.dir,)] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (tuple(current_state.grid.flatten()) + tuple(current_state.inventory) + current_state.pos + (current_state.dir,), action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-27T15:32:38.755827", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n\n          possible_actions = []\n          use_actions = []  # Separate list for USE actions\n\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if can_make_goal:\n                      use_actions.append((action, reward))  # Include reward with the action\n              else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n                  possible_actions.append((action, reward))\n\n          # Sort USE actions by reward descending\n          sorted_use_actions = sorted(use_actions, key=lambda x: -x[1])\n          \n          # Combine all sorted actions\n          sorted_actions = sorted_use_actions + possible_actions\n\n          for action, _ in sorted_actions:\n              _, new_state = current_state.step(action)  # Execute the action to get the new state\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (\n                  tuple(new_state.grid.flatten()), \n                  tuple(new_state.inventory), \n                  new_state.pos, \n                  new_state.dir\n              )\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(actions):\n      \"\"\"Prioritize actions based on heuristic rules.\"\"\"\n      prioritized = []\n      for action, reward in actions:\n          if action == 4:  # USE action\n              prioritized.append((0, action))  # Prioritize USE actions highly\n          else:  # MOVEMENT actions (DOWN, UP, LEFT, RIGHT)\n              prioritized.append((1, action))  # Less priority for movement actions\n      \n      return [action for _, action in sorted(prioritized)]\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      # Prioritize the sequence of actions\n      prioritized_actions = prioritize_actions([(action, 0) for action in action_sequence])  # Assuming rewards are not used here\n      return prioritized_actions\n  \n  return []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 0.0}}
