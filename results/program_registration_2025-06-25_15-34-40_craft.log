 per your previous code\n      \n      preferred_actions = []\n      if use_action in valid_actions:\n          preferred_actions.append(use_action)\n      \n      # Prioritize move actions that lead closer to a workshop or water source\n      for action in range(env.world.n_actions - 1):  # Exclude 'USE' action from move actions\n          _, new_state = state.step(action)\n          if any(new_state.next_to(i) for i in env.world.workshop_indices):\n              preferred_actions.append(action)\n      \n      return preferred_actions + [action for action in valid_actions if action not in preferred_actions]\n\n  def heuristic(state, goal_item):\n      # Example heuristic: Distance to nearest workshop (can be improved)\n      distances = []\n      for pos in [(x, y) for x in range(env.world.scenario.init_grid.shape[0]) \n                    for y in range(env.world.scenario.init_grid.shape[1])]:\n          if state.grid[pos] in env.world.workshop_indices:\n              dist = np.linalg.norm(np.array(pos) - np.array(state.pos))\n              distances.append(dist)\n      if distances:\n          return min(distances)\n      else:\n          return float('inf')  # No workshops found, high penalty\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Filter actions that lead to a change in the state (useful for reducing search space)\n          possible_actions = filter_valid_actions(current_state)\n          \n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              temp_g_score = g_score[current_state] + 1  # Assuming each action has cost 1\n      \n              if new_state not in g_score or temp_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = temp_g_score\n                  f_score[new_state] = temp_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:54:19.429391", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  \n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          current_pos = current_state.pos\n          current_dir = current_state.dir\n\n          # Define possible actions with USE action first\n          possible_actions = [4] + list(range(5))\n\n          # Check neighboring cells based on direction and prioritize resource/workstation interactions\n          for d in range(4):\n              if (current_dir + d) % 4 == 0:  # UP\n                  next_pos = (current_pos[0], current_pos[1] - 1)\n                  possible_actions.append(4)  # Add USE action again for emphasis\n              elif (current_dir + d) % 4 == 1:  # DOWN\n                  next_pos = (current_pos[0], current_pos[1] + 1)\n                  possible_actions.append(4)\n              elif (current_dir + d) % 4 == 2:  # LEFT\n                  next_pos = (current_pos[0] - 1, current_pos[1])\n                  possible_actions.append(4)\n              elif (current_dir + d) % 4 == 3:  # RIGHT\n                  next_pos = (current_pos[0] + 1, current_pos[1])\n                  possible_actions.append(4)\n\n          # Avoid duplicate actions\n          possible_actions = list(set(possible_actions))\n\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:54:20.421931", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):  \n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          current_pos = current_state.pos\n          current_dir = current_state.dir\n\n          # Define possible actions with USE action first\n          possible_actions = [4] + list(range(5))\n\n          # Check neighboring cells based on direction and prioritize resource/workstation interactions\n          neighbors = [\n              (current_pos[0], current_pos[1] - 1),  # UP\n              (current_pos[0], current_pos[1] + 1),  # DOWN\n              (current_pos[0] - 1, current_pos[1]),  # LEFT\n              (current_pos[0] + 1, current_pos[1])   # RIGHT\n          ]\n\n          for d, next_pos in enumerate(neighbors):\n              if env.world.cookbook.index.get(next_pos) is not None:  # Check if the position contains an item\n                  possible_actions.append(4)  # Add USE action again for emphasis\n\n          # Avoid duplicate actions\n          possible_actions = list(set(possible_actions))\n\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:55:33.774005", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from the current state to the goal.\"\"\"\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      \n      if not primitives_needed:\n          return 0\n      \n      missing_count = 0\n      for primitive, required in primitives_needed.items():\n          if state.inventory[primitive] < required:\n              # Calculate Manhattan distance to the nearest cell containing the needed primitive\n              min_dist = float('inf')\n              for x in range(env.world.grid.shape[0]):\n                  for y in range(env.world.grid.shape[1]):\n                      if state.grid[x, y, primitive] > 0:\n                          dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                          min_dist = min(min_dist, dist)\n              missing_count += (required - state.inventory[primitive]) * (min_dist + 1)  # Add 1 to avoid zero distance\n      \n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      from collections import defaultdict\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      \n      g_score = {initial_state: 0}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:55:49.420903", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state):\n      \"\"\"Heuristic function using Manhattan distance to the nearest required item.\"\"\"\n      distances = []\n      for i_kind in range(len(env.world.cookbook.primitives)):\n          goal_idx = env.world.cookbook.index.get(i_kind)\n          \n          if goal_idx is not None and state.inventory[goal_idx] == 0:\n              min_dist = float('inf')\n              \n              # Find the nearest required item\n              for x in range(env.world.grid.shape[0]):\n                  for y in range(env.world.grid.shape[1]):\n                      if state.grid[x, y, goal_idx] > 0:\n                          dist = abs(x - state.pos[0]) + abs(y - state.pos[1])\n                          min_dist = min(min_dist, dist)\n              \n              distances.append(min_dist)\n          else:\n              distances.append(0)\n      \n      return sum(distances)\n\n  initial_state = env._current_state\n  goal_item = item\n\n  # Attempt BFS search first for efficiency\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n      return action_sequence\n  \n  # If BFS fails, attempt to find a path using A* search with heuristic\n  action_sequence = a_star_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T10:57:20.684038", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def retry_bfs_search(env, goal_item):\n    print(\"First BFS search failed. Resetting environment and retrying...\")\n    \n    # Reset the environment to a new scenario with the same goal\n    env.world.sample_scenario_with_goal(goal_item)\n    initial_state = env._current_state\n    \n    action_sequence = bfs_search(initial_state, goal_item)\n    \n    return action_sequence\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function based on distance to nearest required items and inventory.\"\"\"\n      required_items = set(env.world.cookbook.primitives_for(goal_item).keys())\n      required_items -= set(index for index in range(len(state.inventory)) if state.inventory[index] > 0)\n      \n      def manhattan_distance(p1, p2):\n          return abs(p1[0] - p2[0]) + abs(p1[1] - p2[1])\n      \n      min_distances = {item: float('inf') for item in required_items}\n      \n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              for kind in required_items:\n                  if state.grid[x, y, kind] > 0:\n                      dist = manhattan_distance((x, y), state.pos)\n                      min_distances[kind] = min(min_distances[kind], dist)\n      \n      return sum(min_distances.values())\n\n  def astar_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  \n                  g_score = len(path) + 1\n                  h_score = heuristic(new_state, goal_item)\n                  f_score = g_score + h_score\n                  \n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Try A* search first\n  action_sequence = astar_search(initial_state, goal_item)\n  \n  if not action_sequence:\n      action_sequence = retry_bfs_search(env, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:57:21.657812", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(current_state, goal_item):\n    # Simple heuristic: count the number of resources needed to craft the goal item\n    goal_recipe = env.world.cookbook.recipes.get(goal_item, {})\n    \n    resource_count = sum(count for resource_index, count in goal_recipe.items() if isinstance(resource_index, int))\n    \n    return resource_count\n\n  def a_star_search(initial_state, goal_item, max_depth=500):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # Priority queue based on f-score\n      g_score = {initial_state: 0}\n      came_from = {}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return reconstruct_path(came_from, current_state, path)\n          \n          # Check if the current depth exceeds the maximum allowed depth\n          if len(path) >= max_depth:\n              continue\n\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assume each step has cost 1\n\n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = current_state\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def reconstruct_path(came_from, current_state, path):\n      total_path = path\n      while current_state in came_from:\n          current_state = came_from[current_state]\n          total_path.insert(0, current_state)\n      return [action for _, action in zip(total_path[:-1], total_path[1:])]\n\n  def retry_search(env, goal_item):\n    print(\"First search failed. Resetting environment and retrying...\")\n    \n    # Reset the environment to a new scenario with the same goal\n    env.world.sample_scenario()\n    initial_state = env._current_state\n    \n    action_sequence = a_star_search(initial_state, goal_item)\n    \n    return action_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if not action_sequence:\n      action_sequence = retry_search(env, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T10:58:26.815892", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize actions that might lead to the goal item more directly\n          prioritized_actions = prioritize_actions(current_state, goal_item)\n          for action in prioritized_actions + [a for a in range(env.world.n_actions) if a not in prioritized_actions]:\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_actions(current_state, goal_item):\n      \"\"\"Prioritize actions that might lead to the goal item more directly.\"\"\"\n      prioritized_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Check if any of the neighboring cells contain ingredients needed for the goal item\n          primitives_needed = env.world.cookbook.primitives_for(goal_item)\n          for primitive_idx, count in primitives_needed.items():\n              if current_state.next_to(primitive_idx):\n                  prioritized_actions.append(action)\n      \n      return list(set(prioritized_actions))  # Remove duplicates\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate cost from state to goal.\"\"\"\n      ingredients = env.world.cookbook.primitives_for(goal_item)\n      nearby_count = sum(state.next_to(i) for i in ingredients.keys())\n      return -nearby_count  # More nearby ingredients means lower heuristic cost\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
