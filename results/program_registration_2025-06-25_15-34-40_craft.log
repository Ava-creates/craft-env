{"timestamp": "2025-06-27T03:35:40.763964", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos, grid_shape):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < grid_shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < grid_shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions - 1):  # Exclude USE action to explore movement first\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n          \n          # Now try using the USE action\n          reward, use_state = current_state.step(env.world.n_actions - 1)  # USE action\n          \n          use_state_hash = (tuple(use_state.grid.flatten()), \n                            tuple(use_state.inventory), \n                            use_state.pos, \n                            use_state.dir)\n          \n          if satisfies_goal(use_state, goal_item):\n              return path + [env.world.n_actions - 1]\n          \n          if use_state_hash not in visited:\n              visited.add(use_state_hash)\n              queue.append((use_state, path + [env.world.n_actions - 1]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T03:38:01.415553", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Get all possible actions from the current state\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              valid_actions.append((action, new_state))\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def find_item_on_grid(grid, item_index):\n      \"\"\"Finds the positions of all cells containing the specified item index.\"\"\"\n      positions = []\n      for y in range(grid.shape[0]):\n          for x in range(grid.shape[1]):\n              if grid[y, x, item_index] > 0:\n                  positions.append((x, y))\n      return positions\n\n  def get_movement_actions(current_pos, target_pos):\n      \"\"\"Returns a sequence of movement actions to move from current_pos to target_pos.\"\"\"\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      actions = []\n      if x_diff > 0:\n          actions.extend([2] * abs(x_diff))  # RIGHT\n      elif x_diff < 0:\n          actions.extend([3] * abs(x_diff))  # LEFT\n      \n      if y_diff > 0:\n          actions.extend([0] * abs(y_diff))  # DOWN\n      elif y_diff < 0:\n          actions.extend([1] * abs(y_diff))  # UP\n\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Attempt to find a path using BFS with pruning based on available primitives\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []  # Return empty list if no actions found\n\n  # Optimize the sequence by adding movement actions to reach items when needed\n  optimized_actions = []\n  current_state = initial_state\n\n  for action in action_sequence:\n      if action == 4:  # USE action\n          # Find primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          # Check if all primitives are available in inventory\n          can_make_goal = True\n          for primitive, count in goal_primitives.items():\n              if current_state.inventory[primitive] < count:\n                  can_make_goal = False\n                  break\n          \n          if not can_make_goal:\n              # Find positions of missing primitives on the grid\n              for primitive, count in goal_primitives.items():\n                  while current_state.inventory[primitive] < count:\n                      item_positions = find_item_on_grid(current_state.grid, primitive)\n                      \n                      if not item_positions:\n                          return []  # Return empty list if no items are found\n\n                      # Move to the nearest item position\n                      target_pos = min(item_positions, key=lambda pos: abs(pos[0] - current_state.pos[0]) + abs(pos[1] - current_state.pos[1]))\n                      movement_actions = get_movement_actions(current_state.pos, target_pos)\n                      \n                      optimized_actions.extend(movement_actions)\n                      \n                      # Pick up the item (assuming pick-up is action 4)\n                      optimized_actions.append(4)\n\n                      # Update the state\n                      for move_action in movement_actions:\n                          _, current_state = current_state.step(move_action)\n                          \n                      _, current_state = current_state.step(4)  # USE to pick up the item\n\n      # Add the original action to the sequence\n      optimized_actions.append(action)\n      \n      # Update the state with the action\n      _, current_state = current_state.step(action)\n\n  return optimized_actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:38:02.792134", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def heuristic(state, goal_item):\n      \"\"\"Heuristic function to estimate the cost to reach the goal.\"\"\"\n      # Calculate the number of primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n      \n      # Count the number of missing primitives in the current inventory\n      missing_count = 0\n      for primitive, count in goal_primitives.items():\n          if state.inventory[primitive] < count:\n              missing_count += (count - state.inventory[primitive])\n      \n      return missing_count\n\n  def astar_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Get all possible actions from the current state\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((action, new_state))\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  cost = len(path) + 1 + heuristic(new_state, goal_item)\n                  heappush(open_set, (cost, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = astar_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:39:14.833176", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item, primitives_required, available_primitives):\n      # Heuristic based on the number of required primitives not yet in inventory\n      missing_primitives = {primitive: count for primitive, count in primitives_required.items()\n                            if state.inventory[primitive] < count}\n      missing_count = sum(missing_primitives.values())\n      \n      return -missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import sys\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          visited.add(state_hash)\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  new_state_hash = (tuple(new_state.grid.flatten()), \n                                    tuple(new_state.inventory), \n                                    new_state.pos, \n                                    new_state.dir)\n                  \n                  if new_state_hash not in visited:\n                      heappush(open_set, (\n                          len(path) + heuristic(new_state, goal_item, primitives_required, available_primitives),\n                          new_state,\n                          path + [action]\n                      ))\n              else:  # Movement actions (DOWN, UP, LEFT, RIGHT)\n                  reward, new_state = current_state.step(action)\n                  \n                  new_state_hash = (tuple(new_state.grid.flatten()), \n                                    tuple(new_state.inventory), \n                                    new_state.pos, \n                                    new_state.dir)\n                  \n                  if new_state_hash not in visited:\n                      heappush(open_set, (\n                          len(path) + 1,\n                          new_state,\n                          path + [action]\n                      ))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:39:15.996050", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic based on the number of required primitives in inventory.\"\"\"\n      cookbook = env.world.cookbook\n      primitives_required = cookbook.primitives_for(goal_item)\n      current_inventory_count = sum(current_state.inventory[primitive] for primitive in primitives_required)\n      return -current_inventory_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each step has a cost of 1\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[state_hash] = (current_state, path + [action])\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  cookbook = env.world.cookbook\n  primitives_required = cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:40:13.627406", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def find_initial_items(env):\n      \"\"\"Find initial items that can be picked up from the grid.\"\"\"\n      initial_items = []\n      for i in range(env.world.WIDTH):\n          for j in range(env.world.HEIGHT):\n              kind_index = np.argmax(env._current_state.grid[i, j])\n              if kind_index not in env.world.non_grabbable_indices:\n                  initial_items.append(kind_index)\n      return initial_items\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Validate the goal item\n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n    return []\n  \n  # Find initial items that can be picked up from the grid and add them to the inventory\n  initial_items = find_initial_items(env)\n  for kind_index in initial_items:\n      action_sequence = [env.world.N_ACTIONS - 1] * len(env._current_state.grid.flatten())  # Assuming USE is the last action\n      new_state, _ = env.step(action_sequence)\n      \n      if satisfies_goal(new_state, goal_item):\n          return action_sequence\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"No valid sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-27T03:40:31.233844", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_all_possible_actions(state):\n      actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          if not np.array_equal(new_state.grid, state.grid) or\\\n             not np.array_equal(new_state.inventory, state.inventory) or\\\n             new_state.pos != state.pos or\\\n             new_state.dir != state.dir:\n              actions.append((action, new_state))\n      return actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Validate the goal item\n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n    return []\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n    print(\"No valid sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 8, "scores": {"3": 1.5}}
{"timestamp": "2025-06-27T03:42:01.971823", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n\n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      # Priority actions: prioritize USE action to speed up crafting\n      priority_actions = [4] + [i for i in range(initial_state.world.n_actions) if i != 4]\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      state_to_goal_primitives = {state_hash(initial_state): get_primitive_counts(goal_item, initial_state.world.cookbook)}\n\n      while queue:\n          current_state, path = queue.popleft()\n\n          # Check if the goal is satisfied\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Get primitives needed for the goal item\n          goal_primitives = state_to_goal_primitives[state_hash(current_state)]\n\n          for action in priority_actions:\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash_val = state_hash(new_state)\n\n              if state_hash_val not in visited:\n                  visited.add(state_hash_val)\n                  queue.append((new_state, path + [action]))\n\n                  # Cache the primitives needed for the goal item at this new state\n                  state_to_goal_primitives[state_hash_val] = get_primitive_counts(goal_item, new_state.world.cookbook)\n\n      return None  # Return None if no sequence is found\n\n  def state_hash(state):\n      \"\"\"Returns a hashable representation of the state.\"\"\"\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 2.0}}
