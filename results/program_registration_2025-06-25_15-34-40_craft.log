{"timestamp": "2025-06-26T07:43:59.061580", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T07:44:00.047244", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      # Simple heuristic: distance to the nearest required ingredient\n      if current_state.inventory[goal_item] > 0:\n          return 0\n      \n      needed_ingredients = set()\n      \n      def get_required_ingredients(item_index):\n          recipe = env.world.cookbook.recipes.get(item_index)\n          if recipe is None:\n              return\n          \n          for ingredient, count in recipe.items():\n              if ingredient == \"_key\":\n                  continue\n              \n              if ingredient in env.world.cookbook.primitives or ingredient not in env.world.cookbook.recipes:\n                  needed_ingredients.add(ingredient)\n              else:\n                  get_required_ingredients(ingredient)\n\n      get_required_ingredients(goal_item)\n\n      min_distance = float('inf')\n      grid = current_state.grid\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if any(grid[x, y, ingredient] > 0 for ingredient in needed_ingredients):\n                  agent_x, agent_y = current_state.pos\n                  distance = abs(x - agent_x) + abs(y - agent_y)\n                  min_distance = min(min_distance, distance)\n\n      return min_distance\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = [(heuristic(initial_state, goal_item), initial_state, [])]\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (heuristic(new_state, goal_item) + len(path) + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
