{"timestamp": "2025-06-26T14:36:43.508599", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      if x > 0:\n          neighbors.append((x - 1, y))\n      if x < env.world.grid.shape[0] - 1:\n          neighbors.append((x + 1, y))\n      if y > 0:\n          neighbors.append((x, y - 1))\n      if y < env.world.grid.shape[1] - 1:\n          neighbors.append((x, y + 1))\n      return neighbors\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count of goal item in inventory\n      return state.inventory[goal_item]\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (priority, state, path)\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  priority = heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (priority, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:37:25.542497", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: count the number of steps needed to gather primitives required for the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      \n      steps_to_gather = 0\n      for primitive, count in primitives_needed.items():\n          if state.inventory[primitive] < count:\n              # Calculate how many more we need and assume each primitive is one step away\n              steps_to_gather += count - state.inventory[primitive]\n      \n      return steps_to_gather\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0 + heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {tuple((tuple(initial_state.grid.flatten()), \n                         tuple(initial_state.inventory), \n                         initial_state.pos, \n                         initial_state.dir)): 0}\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[tuple((tuple(current_state.grid.flatten()), \n                                                 tuple(current_state.inventory), \n                                                 current_state.pos, \n                                                 current_state.dir))] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, action)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:37:41.106431", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"No valid crafting sequence found.\")\n  \n  return action_sequence or []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T14:38:30.324434", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: distance to the nearest required ingredient\n      if env.world.cookbook.primitives_for(goal_item):\n          closest_distance = float('inf')\n          for ingredient in env.world.cookbook.primitives_for(goal_item).keys():\n              for dx in range(-1, 2):\n                  for dy in range(-1, 2):\n                      nx, ny = state.pos[0] + dx, state.pos[1] + dy\n                      if 0 <= nx < env.scenario.init_grid.shape[0] and 0 <= ny < env.scenario.init_grid.shape[1]:\n                          if np.any(state.grid[nx, ny] == ingredient):\n                              closest_distance = min(closest_distance, abs(dx) + abs(dy))\n          return closest_distance\n      return 0\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # priority queue with (f_score, state, path)\n      g_scores = {initial_state: 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_scores[current_state] + 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:38:31.292916", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: the number of steps needed to reach the goal if no obstacles\n      # Here we assume that each step can potentially bring us closer to crafting the item.\n      return max(1, env.world.cookbook.n_kinds - np.sum(state.inventory))\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      g_scores = {initial_state: 0}\n      \n      while open_set:\n          f_score, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_scores[current_state] + 1\n              \n              if state_hash not in g_scores or tentative_g_score < g_scores[state_hash]:\n                  g_scores[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  if action_sequence is not None:\n      return action_sequence\n  \n  return []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-26T14:39:37.148956", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Heuristic: count how many more steps it takes to gather all necessary primitives\n      needed_primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = {idx: count for idx, count in enumerate(state.inventory)}\n      \n      total_steps_needed = 0\n      \n      for primitive_index, count in needed_primitives.items():\n          missing_count = max(0, count - current_inventory.get(primitive_index, 0))\n          \n          # BFS to find the shortest path to gather each primitive\n          if missing_count > 0:\n              sub_goal_item = primitive_index\n              steps_to_primitive = len(bfs_search(initial_state, sub_goal_item))\n              \n              total_steps_needed += steps_to_primitive * missing_count\n      \n      return total_steps_needed\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              _, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Use A* search to find the shortest path with heuristic guidance\n  from heapq import heappop, heappush\n  \n  open_set = []\n  heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n  came_from = {}\n  g_score = {initial_state: 0}\n  \n  while open_set:\n      _, current_cost, current_state, path = heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n          return path\n      \n      for action in range(env.world.n_actions):\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          tentative_g_score = current_cost + 1\n          \n          if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n              came_from[state_hash] = (current_state, path + [action])\n              g_score[new_state] = tentative_g_score\n              \n              # Convert the new state to a hashable form for priority queue\n              heappush(open_set, (tentative_g_score + heuristic(new_state, goal_item), \n                                  tentative_g_score, \n                                  new_state, \n                                  path + [action]))\n  \n  return None  # Return None if no sequence is found", "island_id": 7, "scores": {"3": -1}}
