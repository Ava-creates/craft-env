{"timestamp": "2025-06-26T15:08:45.265729", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = np.array([current_state.inventory[idx] for idx in primitives.keys()])\n      goal_counts = np.array(list(primitives.values()))\n      \n      # Calculate how many more steps are needed to gather the required ingredients\n      additional_steps_needed = np.ceil((goal_counts - current_inventory) / (current_inventory > 0)).sum()\n      \n      return int(additional_steps_needed)\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))  # (f_score, state, path)\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              new_g_score = g_score[current_state] + 1  # Assuming each action has cost 1\n            \n              if state_hash not in g_score or new_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, path + [action])\n                  g_score[new_state] = new_g_score\n                  f_score[new_state] = new_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
