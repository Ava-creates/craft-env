 2.0}}
{"timestamp": "2025-06-27T11:07:23.556604", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      action_sequence = []\n      while len(action_sequence) < 100:  # Limit to avoid infinite loops\n        action = env.world.random.randint(5)  # Randomly select an action\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = all(new_state.inventory[prim] >= count for prim, count in goal_primitives.items())\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          action_sequence.append(action)\n          current_state = new_state\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.kinds:\n      raise ValueError(f\"Goal item with index {goal_item} is not recognized.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-06-27T11:07:34.401868", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n    \n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        primitives[current_index] = primitives.get(current_index, 0) + count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n    \n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n        \n        if action == 4:  # USE action\n          # Check if the use action can contribute to making the goal item\n          can_make_goal = all(new_state.inventory[prim] >= count for prim, count in goal_primitives.items())\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n        \n        # Convert the new state to a hashable form using a tuple of its attributes\n        state_hash = (tuple(new_state.grid.flatten()), \n                      tuple(new_state.inventory), \n                      new_state.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def find_closest_resource(env, resource_index):\n    \"\"\"Find the closest position of a specific resource.\"\"\"\n    current_state = env._current_state\n    grid = current_state.grid\n    pos = np.array(current_state.pos)\n    \n    # Find all positions of the resource in the grid\n    resource_positions = np.argwhere(grid[:, :, resource_index] > 0)\n    \n    if len(resource_positions) == 0:\n        return None\n    \n    # Calculate distances from the current position to each resource position\n    distances = np.linalg.norm(resource_positions - pos, axis=1)\n    \n    # Find the closest resource position\n    closest_index = np.argmin(distances)\n    closest_pos = resource_positions[closest_index]\n    \n    return tuple(closest_pos)\n\n  def move_to_position(env, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      current_state = env._current_state\n      pos = np.array(current_state.pos)\n      dir_ = current_state.dir\n      \n      # Calculate the direction vector needed to reach the target position\n      delta = target_pos - pos\n      \n      actions = []\n      \n      # Rotate to face the correct direction\n      if delta[0] < 0:  # Move left\n          actions.append(2)  # LEFT\n      elif delta[0] > 0:  # Move right\n          actions.append(3)  # RIGHT\n      elif delta[1] < 0:  # Move down\n          actions.append(0)  # DOWN\n      elif delta[1] > 0:  # Move up\n          actions.append(1)  # UP\n      \n      # Adjust direction if necessary\n      new_dir = dir_\n      if actions:\n          action = actions[-1]\n          if action == 0:  # DOWN\n              new_dir = 0\n          elif action == 1:  # UP\n              new_dir = 2\n          elif action == 2:  # LEFT\n              new_dir = 3\n          elif action == 3:  # RIGHT\n              new_dir = 1\n      \n      if new_dir != dir_:\n          actions.append(new_dir)  # Change direction\n      \n      # Move to the target position\n      for _ in range(abs(delta[0])):\n          actions.append(3 - abs(dir_ - (2 if delta[0] < 0 else 1)))  # Move LEFT or RIGHT\n      for _ in range(abs(delta[1])):\n          actions.append(3 - abs(dir_ - (0 if delta[1] < 0 else 2)))  # Move DOWN or UP\n      \n      return actions\n\n  def perform_action_sequence(env, action_sequence):\n    \"\"\"Perform a sequence of actions on the environment.\"\"\"\n    for action in action_sequence:\n        env._current_state.step(action)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.kinds:\n      raise ValueError(f\"Goal item with index {goal_item} is not recognized.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  if not action_sequence:\n      return []  # Return empty list if no actions found\n  \n  final_actions = []\n  \n  for action in action_sequence:\n    if action == 4:  # USE action\n        # Find closest primitive needed for the current state to make progress towards the goal\n        primitives_needed = get_primitive_counts(goal_item, initial_state.world.cookbook)\n        for prim_index in primitives_needed:\n            if initial_state.inventory[prim_index] < primitives_needed[prim_index]:\n                target_pos = find_closest_resource(env, prim_index)\n                if target_pos:\n                    move_actions = move_to_position(env, target_pos)\n                    final_actions.extend(move_actions)\n                    # Perform the pick-up action (assuming 4 is USE and it picks up resources when needed)\n                    final_actions.append(4)  # USE\n    final_actions.append(action)\n  \n  return final_actions", "island_id": 6, "scores": {"3": 0.0}}
