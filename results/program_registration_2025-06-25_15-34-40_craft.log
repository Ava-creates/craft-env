{"timestamp": "2025-06-26T19:12:43.953727", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic based on number of items needed.\"\"\"\n      if not hasattr(state, '_primitives_needed'):\n          cookbook = env.world.cookbook\n          primitives_needed = cookbook.primitives_for(goal_item)\n          state._primitives_needed = {item: count for item, count in primitives_needed.items() \n                                      if item not in state.inventory or state.inventory[item] < count}\n      return sum(state._primitives_needed.values())\n\n  def a_star_search(initial_state, goal_item):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Generate all possible actions and their resulting states in parallel\n          action_sequences = [(action, current_state.step(action)) for action in range(env.world.n_actions)]\n          \n          for action, (reward, new_state) in action_sequences:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  g_score = len(path) + 1\n                  h_score = heuristic(new_state, goal_item)\n                  f_score = g_score + h_score\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T19:12:44.955481", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # UP, DOWN, LEFT, RIGHT\n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n              yield (nx, ny)\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check nearby positions for useful actions\n          for neighbor_pos in get_neighbors(current_state.pos):\n              x, y = neighbor_pos\n              cell_contents = np.nonzero(current_state.grid[x, y])[0]\n              \n              for content_index in cell_contents:\n                  if content_index in env.world.grabbable_indices or content_index in env.world.workshop_indices:\n                      # Try to pick up or use the item at this position\n                      for action in [3, 4]:  # USE action is often critical for crafting\n                          reward, new_state = current_state.step(action)\n                          \n                          if satisfies_goal(new_state, goal_item):\n                              return path + [action]\n                          \n                          # Convert the new state to a hashable form using a tuple of its attributes\n                          state_hash = (tuple(new_state.grid.flatten()), \n                                        tuple(new_state.inventory), \n                                        new_state.pos, \n                                        new_state.dir)\n                          \n                          if state_hash not in visited:\n                              visited.add(state_hash)\n                              queue.append((new_state, path + [action]))\n          \n          # Generate all possible actions and their resulting states in parallel\n          action_sequences = [(action, current_state.step(action)) for action in range(env.world.n_actions)]\n          \n          for action, (reward, new_state) in action_sequences:\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T19:13:45.365155", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Prioritize actions: use (index 4), then movement actions\n        priority_actions = [4] + list(range(4))\n        \n        for action in priority_actions:\n            reward, new_state = current_state.step(action)\n            \n            # Skip invalid actions that incur penalties\n            if reward < -0.1:  # Assuming any negative reward is a penalty\n                continue\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def apply_actions_to_env(env, action_sequence):\n    for action in action_sequence:\n        env.step(action, num_steps=1)\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"No valid action sequence found to craft the desired item.\")\n      return []\n\n  # Apply the actions to the environment\n  apply_actions_to_env(env, action_sequence)\n  \n  return action_sequence", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T19:14:01.189330", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        # Prioritize actions: use (index 4), then movement actions\n        priority_actions = [4] + list(range(4))\n        \n        for action in priority_actions:\n            reward, new_state = current_state.step(action)\n            \n            # Skip invalid actions that incur penalties\n            if reward < -0.1:  # Assuming any negative reward is a penalty\n                continue\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      print(\"No valid action sequence found to craft the desired item.\")\n      return []\n  \n  return action_sequence", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T19:15:11.534184", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      return [d for d in directions if 0 <= d[0] < env.scenario.world.grid.shape[0] and 0 <= d[1] < env.scenario.world.grid.shape[1]]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action when there's something to use nearby\n          neighborhood = current_state.grid[\n              max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n              max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n          ]\n          \n          actions = list(range(env.world.n_actions))\n          if np.any(neighborhood):\n              actions.insert(0, 4)  # Prioritize USE action\n          \n          for action in actions:\n              if action == 4 and not np.any(neighborhood):\n                  continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T19:15:27.761005", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      directions = [(x-1, y), (x+1, y), (x, y-1), (x, y+1)]\n      return [d for d in directions if 0 <= d[0] < env.scenario.world.grid.shape[0] and 0 <= d[1] < env.scenario.world.grid.shape[1]]\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):  # Actions: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n              # Skip USE action if there's nothing to use in the 3x3 grid around the agent\n              if action == 4:\n                  neighborhood = current_state.grid[\n                      max(0, current_state.pos[0]-1):min(env.scenario.init_grid.shape[0], current_state.pos[0]+2),\n                      max(0, current_state.pos[1]-1):min(env.scenario.init_grid.shape[1], current_state.pos[1]+2)\n                  ]\n                  if not np.any(neighborhood):\n                      continue\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T19:16:31.616140", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def is_reachable_via_primitives(goal_item, inventory, cookbook):\n      if goal_item in cookbook.primitives:\n          return True\n      for recipe_output, ingredients in cookbook.recipes.items():\n          if recipe_output == goal_item:\n              # Check if all ingredients are either primitives or already available in the inventory\n              can_craft = True\n              for ingredient_index, count in ingredients.items():\n                  if ingredient_index not in cookbook.primitives and (ingredient_index not in inventory or inventory[ingredient_index] < count):\n                      can_craft = False\n                      break\n              if can_craft:\n                  return True\n      return False\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n    return []\n\n  # Check if the goal item can be reached via primitives or existing inventory\n  if not is_reachable_via_primitives(goal_item, initial_state.inventory, env.world.cookbook):\n    print(f\"Item {goal_item} cannot be crafted with the current resources.\")\n    return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-06-26T19:16:32.796830", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action first to speed up crafting\n          for action in [4] + list(range(env.world.n_actions)):\n              if action == 4 and not current_state.next_to(goal_item):\n                  continue  # Skip USE if the item is not next to the agent\n              \n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in env.world.cookbook.primitives and goal_item not in env.world.cookbook.recipes:\n      print(f\"Item {goal_item} does not have a recipe or is not a primitive.\")\n      return []\n\n  # Check if the goal item is already in inventory\n  if satisfies_goal(initial_state, goal_item):\n    return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-06-26T19:17:41.809338", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def dfs_search(initial_state, goal_item, max_depth=30):\n      from collections import deque\n      \n      stack = [(initial_state, [])]\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Limit the depth of search to avoid infinite loops and excessive computation\n          if len(path) < max_depth:\n              for action in range(env.world.n_actions):\n                  reward, new_state = current_state.step(action)\n                  \n                  # Convert the new state to a hashable form using a tuple of its attributes\n                  state_hash = (tuple(new_state.grid.flatten()), \n                                tuple(new_state.inventory), \n                                new_state.pos, \n                                new_state.dir)\n                  \n                  if state_hash not in visited:\n                      visited.add(state_hash)\n                      stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = dfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 1.1}}
{"timestamp": "2025-06-26T19:17:42.842641", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n              neighbors.append((nx, ny))\n      return neighbors\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Get neighboring positions to explore movement actions first\n          neighbors = get_neighbors(current_state.pos)\n          for nx, ny in neighbors:\n              action = [DOWN, UP, LEFT, RIGHT].index(get_action_from_positions(current_state.pos, (nx, ny)))\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n          \n          # Explore use action last\n          reward, new_state = current_state.step(USE)\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          if state_hash not in visited:\n              visited.add(state_hash)\n              queue.append((new_state, path + [USE]))\n      \n      return None  # Return None if no sequence is found\n\n  def get_action_from_positions(current_pos, target_pos):\n      cx, cy = current_pos\n      tx, ty = target_pos\n      \n      if cx < tx:\n          return RIGHT\n      elif cx > tx:\n          return LEFT\n      elif cy < ty:\n          return DOWN\n      elif cy > ty:\n          return UP\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T19:19:04.618182", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):  # Added a max_steps parameter to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  # Optimize by prioritizing actions that lead to required primitives\n  def heuristic(action, state):\n      _, new_state = state.step(action)\n      new_inventory_count = sum(new_state.inventory[primitive] for primitive in env.world.cookbook.primitives_for(goal_item))\n      return -new_inventory_count\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is None:\n      raise ValueError(\"No sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T19:19:20.380345", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_steps=500):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Check if the goal item can be crafted based on available primitives and environment items\n  primitives_required = env.world.cookbook.primitives_for(goal_item)\n  available_primitives = {idx: initial_state.inventory[idx] for idx in env.world.grabbable_indices}\n  \n  if not all(primitive in available_primitives or primitive in env.world.environment for primitive in primitives_required):\n      raise ValueError(\"Goal item cannot be crafted with the available items and environment.\")\n  \n  # Optimize by prioritizing actions that lead to required primitives\n  def heuristic(action, state):\n      _, new_state = state.step(action)\n      new_inventory_count = sum(new_state.inventory[primitive] for primitive in primitives_required)\n      return -new_inventory_count\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence is None:\n      raise ValueError(\"No sequence of actions found to craft the item.\")\n\n  return action_sequence", "island_id": 4, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T19:22:13.496133", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  # Check if the use action can contribute to making the goal item\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n            