{"timestamp": "2025-06-27T15:47:43.619351", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def get_inventory_counts(state):\n      return dict(enumerate(state.inventory))\n  \n  def find_actions_to_gather_primitives(initial_state, goal_item, cookbook):\n      # Get the required primitives and their counts for the goal item\n      required_primitives = get_primitive_counts(goal_item, cookbook)\n      \n      # Filter out already available primitives in inventory\n      current_inventory = get_inventory_counts(initial_state)\n      needed_primitives = {k: v - current_inventory.get(k, 0) for k, v in required_primitives.items() if v > current_inventory.get(k, 0)}\n      \n      actions_to_gather = []\n      \n      # Breadth-first search to find actions that gather primitives\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in visited_states:\n              continue\n          \n          visited_states.add(state_hash)\n          \n          # Check if we have gathered all needed primitives\n          current_inventory = get_inventory_counts(current_state)\n          all_gathered = True\n          for primitive, count in needed_primitives.items():\n              if current_inventory.get(primitive, 0) < count:\n                  all_gathered = False\n                  break\n          \n          if all_gathered:\n              return path\n      \n          # Explore actions to gather primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  continue  # Skip the USE action as it doesn't directly gather primitives\n              \n              new_inventory_counts = get_inventory_counts(new_state)\n              for primitive, count in needed_primitives.items():\n                  if new_inventory_counts.get(primitive, 0) > current_inventory.get(primitive, 0):\n                      queue.append((new_state, path + [action]))\n                      break\n      \n      return None  # Return None if no sequence is found\n\n  def bfs_search(initial_state, goal_item, cookbook):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited_states = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          state_hash = (tuple(current_state.grid.flatten()), \n                        tuple(current_state.inventory), \n                        current_state.pos, \n                        current_state.dir)\n          \n          if state_hash in visited_states:\n              continue\n          \n          visited_states.add(state_hash)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n      \n          # Find actions to gather primitives needed for the goal item\n          actions_to_gather = find_actions_to_gather_primitives(current_state, goal_item, cookbook)\n          \n          if actions_to_gather:\n              new_state = current_state\n              for action in actions_to_gather:\n                  _, new_state = new_state.step(action)\n              queue.append((new_state, path + actions_to_gather))\n              continue\n          \n          # Explore other possible actions\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  if satisfies_goal(new_state, goal_item):\n                      return path + [action]\n                  else:\n                      continue  # Skip this action as it doesn't directly make the goal item\n              \n              queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  cookbook = initial_state.world.cookbook\n  action_sequence = bfs_search(initial_state, goal_item, cookbook)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T15:49:28.668409", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def heuristic(current_state, goal_item):\n      \"\"\"Heuristic function to estimate the cost from current_state to reach the goal_item.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, current_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(current_state.inventory) if count > 0 and i in primitives_needed}\n      \n      # Calculate the total number of steps needed based on available primitives\n      steps_needed = 0\n      for primitive, required_count in primitives_needed.items():\n          available_count = current_primitives.get(primitive, 0)\n          steps_needed += max(0, (required_count - available_count) // primitives_needed[primitive])\n      \n      return steps_needed\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      import itertools\n      \n      open_set = []\n      open_heap_counter = itertools.count()  # Unique sequence count for heap stability\n      heappush(open_set, (heuristic(initial_state, goal_item), next(open_heap_counter), initial_state, []))\n      \n      visited = set()\n      \n      while open_set:\n          _, _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, current_state.world.cookbook)\n          \n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              valid_actions.append((action, new_state))\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (\n                      len(path) + 1 + heuristic(new_state, goal_item),\n                      next(open_heap_counter),\n                      new_state,\n                      path + [action]\n                  ))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item can be crafted at all\n  if goal_item not in initial_state.world.cookbook.recipes:\n      print(f\"Item {goal_item} cannot be crafted.\")\n      return []\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
