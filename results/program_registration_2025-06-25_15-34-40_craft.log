{"timestamp": "2025-06-26T16:26:54.568448", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the cost to reach the goal.\"\"\"\n      # Simple heuristic: count how many primitives are missing\n      required_primitives = env.world.cookbook.primitives_for(goal_item)\n      inventory_dict = {env.world.cookbook.index.get(idx): count for idx, count in enumerate(state.inventory) if idx in required_primitives}\n      \n      missing_count = 0\n      for primitive, required_count in required_primitives.items():\n          name = env.world.cookbook.index.get(primitive)\n          if name not in inventory_dict or inventory_dict[name] < required_count:\n              missing_count += required_count - (inventory_dict.get(name, 0))\n      \n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappop, heappush\n      \n      open_set = []\n      heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      \n      while open_set:\n          current_f, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[new_state]:\n                  g_score[state_hash] = tentative_g_score\n                  f_score[state_hash] = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score[state_hash], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:27:45.157709", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Optimize by considering only valid actions (e.g., not walking into walls)\n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # If the state is unchanged, skip adding it to the queue\n              if np.array_equal(new_state.grid, current_state.grid) and \\\n                 np.array_equal(new_state.inventory, current_state.inventory) and \\\n                 new_state.pos == current_state.pos and \\\n                 new_state.dir == current_state.dir:\n                  continue\n\n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  