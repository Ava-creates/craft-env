{"timestamp": "2025-06-26T16:19:10.808057", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Check and prioritize USE action first if there's something to use\n          if any(current_state.grid[current_state.pos[0]-1:current_state.pos[0]+2,\n                                   current_state.pos[1]-1:current_state.pos[1]+2].flatten()):\n              reward, new_state = current_state.step(4)\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [4]\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [4]))\n          \n          # Try other actions\n          for action in range(env.world.n_actions):\n              if action == 4: \n                  continue  # Skip USE action as it's already handled above\n              \n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T16:19:57.159946", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(current_state, goal_item):\n    # A simple heuristic that considers the number of items needed in the inventory\n    primitives = env.world.cookbook.primitives_for(goal_item)\n    current_inventory = current_state.inventory\n    \n    # Calculate the sum of missing primitives\n    missing_count = sum(max(0, count - current_inventory[prim]) for prim, count in primitives.items())\n    \n    return missing_count\n\n  def a_star_search(initial_state, goal_item):\n    from heapq import heappush, heappop\n    \n    open_set = []\n    heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n    came_from = {}\n    g_score = {initial_state: 0}\n    \n    while open_set:\n        _, current_state, path = heappop(open_set)\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in range(env.world.n_actions):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            tentative_g_score = g_score[current_state] + 1\n            \n            if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                came_from[state_hash] = (current_state, path)\n                g_score[state_hash] = tentative_g_score\n                f_score = tentative_g_score + heuristic(new_state, goal_item)\n                heappush(open_set, (f_score, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  # If the first attempt fails, try resetting and searching again\n  if not action_sequence:\n      env.reset()\n      initial_state = env._current_state\n      action_sequence = a_star_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:19:58.195000", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic based on the number of steps already taken\n      return len(state.step_path)\n\n  def a_star_search(initial_state, goal_item, max_steps=500):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))  # (f_score, state, path)\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while open_set:\n          current_f, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              tentative_g_score = g_score[current_state] + 1\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if tentative_g_score < g_score.get(state_hash, float('inf')):\n                  came_from[state_hash] = current_state\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heapq.heappush(open_set, (f_score, new_state, path + [action]))\n                  \n                  if len(path) >= max_steps:\n                      break  # Break if the current depth exceeds the maximum allowed steps\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-06-26T16:20:30.969407", "function_name": "craft", "function_body": "  def satisfies_goal(state: CraftState, goal_item: int) -> bool:\n      return state.inventory[goal_item] > 0\n\n  def dfs_search(initial_state: CraftState, goal_item: int):\n      from collections import deque\n      \n      # Stack for DFS\n      stack = [(initial_state, [])]\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the environment is reset for a fresh start\n  env.reset()\n\n  action_sequence = dfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": -1}}
