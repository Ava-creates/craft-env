tate.pos, \n                      new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n    for action in actions:\n      reward, done, observations = env.step(action)\n      if done:\n        break\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item can be crafted (i.e., it's in the cookbook)\n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n    return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n    execute_actions(env, action_sequence)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:22:08.710739", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n            \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n            \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def execute_actions(env, actions):\n      for action in actions:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n      return done\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item not in initial_state.world.cookbook.recipes and goal_item not in initial_state.world.cookbook.primitives:\n      return []  # Return empty list if the goal item is uncraftable\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if action_sequence:\n      done = execute_actions(env, action_sequence)\n      return action_sequence if done else []\n\n  return []  # Return empty list if no actions found or crafting failed", "island_id": 6, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:24:21.050516", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = all(new_state.inventory[primitive] >= count \n                                      for primitive, count in goal_primitives.items())\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def find_shortest_path_to_primitives(initial_state, primitives):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      paths = {primitive: [] for primitive in primitives}\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          # Check if any of the required primitives are available\n          for primitive in primitives:\n              if current_state.inventory[primitive] >= primitives[primitive]:\n                  paths[primitive] = path\n                  del primitives[primitive]\n                  if not primitives:\n                      return paths\n      \n          # Explore actions to collect more resources\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return paths  # Return partial paths if some primitives are still missing\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  while True:\n      primitive_counts = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      if not primitive_counts:\n          break\n      \n      action_paths_to_primitives = find_shortest_path_to_primitives(initial_state, dict(primitive_counts))\n      \n      # Execute paths to collect primitives\n      action_sequence = []\n      for path in action_paths_to_primitives.values():\n          action_sequence.extend(path)\n          for action in path:\n              _, initial_state = initial_state.step(action)\n      \n      if satisfies_goal(initial_state, goal_item):\n          break\n\n  # Find final sequence to craft the goal item\n  final_action_sequence = bfs_search(initial_state, goal_item) or []\n  \n  return action_sequence + final_action_sequence", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-06-27T00:24:22.198809", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = all(new_state.inventory[primitive] >= count \n                                      for primitive, count in goal_primitives.items())\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the cost from the current state to the goal.\"\"\"\n      primitives_needed = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      current_primitives = {i: count for i, count in enumerate(state.inventory) if count > 0}\n      \n      # Calculate the difference between needed and available primitives\n      diff = sum(primitives_needed.get(i, 0) - current_primitives.get(i, 0) for i in primitives_needed)\n      \n      return diff\n\n  def a_star_search(initial_state, goal_item):\n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      came_from = {}\n      g_score = {tuple(initial_state.grid.flatten()): 0}\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = all(new_state.inventory[primitive] >= count \n                                      for primitive, count in goal_primitives.items())\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = tuple(new_state.grid.flatten())\n              \n              tentative_g_score = g_score[tuple(current_state.grid.flatten())] + 1\n              \n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[state_hash] = (current_state, path)\n                  g_score[state_hash] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  heappush(open_set, (f_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 0.0}}
