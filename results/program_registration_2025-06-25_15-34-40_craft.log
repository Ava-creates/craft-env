not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def optimize_actions(action_sequence):\n      optimized_sequence = []\n      i = 0\n      while i < len(action_sequence):\n          current_action = action_sequence[i]\n          \n          # Check for consecutive USE actions and merge them into a single step\n          if current_action == 4:  # USE action\n              use_count = 1\n              while (i + 1 < len(action_sequence) and \n                     action_sequence[i + 1] == 4):\n                  i += 1\n                  use_count += 1\n              optimized_sequence.append(current_action)\n          else:\n              optimized_sequence.append(current_action)\n          \n          i += 1\n      \n      return optimized_sequence\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  if not action_sequence:\n      return []\n\n  # Optimize the action sequence by merging consecutive USE actions\n  optimized_action_sequence = optimize_actions(action_sequence)\n  \n  return optimized_action_sequence", "island_id": 5, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:39:22.510650", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n      current_state, path = queue.popleft()\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = all(new_state.inventory[primitive] >= count \n                              for primitive, count in goal_primitives.items())\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n\n        state_hash = (tuple(new_state.grid.flatten()), tuple(new_state.inventory), new_state.pos, new_state.dir)\n        \n        if state_hash not in visited:\n          visited.add(state_hash)\n          queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  def get_item_index(item_name, cookbook):\n    try:\n      return cookbook.index[item_name]\n    except KeyError:\n      raise ValueError(f\"Item '{item_name}' not found in the cookbook.\")\n\n  initial_state = env._current_state\n  goal_item_name = item\n  \n  # Convert item name to index if it's a string\n  if isinstance(item, str):\n    try:\n      goal_item = get_item_index(goal_item_name, initial_state.world.cookbook)\n    except ValueError as e:\n      print(e)\n      return []\n  else:\n    goal_item = item\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:39:23.611034", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n    return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n    primitives = {}\n\n    def dfs(current_index, count=1):\n      if current_index in cookbook.primitives:\n        if current_index not in primitives:\n          primitives[current_index] = 0\n        primitives[current_index] += count\n      elif current_index in cookbook.recipes:\n        recipe = cookbook.recipes[current_index]\n        for ingredient, amount in recipe.items():\n          if ingredient == \"_key\":\n            continue\n          dfs(ingredient, count * amount)\n\n    dfs(goal_index)\n    return primitives\n\n  def heuristic(state, goal_item):\n    # Calculate the number of steps required to gather all primitives needed for the goal item.\n    goal_primitives = get_primitive_counts(goal_item, state.world.cookbook)\n    inventory = {i: state.inventory[i] for i in goal_primitives}\n    \n    steps_required = 0\n    for primitive, count in goal_primitives.items():\n      if inventory.get(primitive, 0) < count:\n        steps_required += (count - inventory.get(primitive, 0))\n    return steps_required\n\n  def a_star_search(initial_state, goal_item):\n    from heapq import heappop, heappush\n    \n    open_set = []\n    heappush(open_set, (0 + heuristic(initial_state, goal_item), 0, initial_state, []))  # (f_score, g_score, state, path)\n    came_from = {}\n    g_score = {tuple(initial_state.grid.flatten()): 0}\n    \n    while open_set:\n      _, current_g, current_state, path = heappop(open_set)\n      \n      if satisfies_goal(current_state, goal_item):\n        return path\n      \n      # Collect primitives needed for the goal item\n      goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n      \n      # Filter actions based on available inventory and required primitives\n      for action in range(initial_state.world.n_actions):\n        reward, new_state = current_state.step(action)\n\n        if action == 4:  # USE action\n          can_make_goal = all(new_state.inventory[primitive] >= count \n                              for primitive, count in goal_primitives.items())\n          \n          if not can_make_goal:\n            continue  # Skip this action as it doesn't help make the goal item\n\n        state_hash = tuple(new_state.grid.flatten())\n        \n        tentative_g_score = current_g + 1\n        if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n          came_from[new_state] = (current_state, action)\n          g_score[state_hash] = tentative_g_score\n          f_score = tentative_g_score + heuristic(new_state, goal_item)\n          heappush(open_set, (f_score, tentative_g_score, new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-06-27T00:40:51.905621", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          actions = range(initial_state.world.n_actions)\n          prioritized_actions = prioritize_use_actions(actions, current_state, goal_primitives)\n          \n          for action in prioritized_actions:\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def prioritize_use_actions(actions, state, goal_primitives):\n      use_actions = []\n      other_actions = []\n      \n      for action in actions:\n          reward, new_state = state.step(action)\n          \n          if action == 4:  # USE action\n              can_make_goal = True\n              for primitive, count in goal_primitives.items():\n                  if new_state.inventory[primitive] < count:\n                      can_make_goal = False\n                      break\n              \n              if can_make_goal:\n                  use_actions.append(action)\n          else:\n              other_actions.append(action)\n      \n      return use_actions + other_actions\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:41:02.174037", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index, cookbook):\n      primitives = {}\n      \n      def dfs(current_index, count=1):\n          if current_index in cookbook.primitives:\n              if current_index not in primitives:\n                  primitives[current_index] = 0\n              primitives[current_index] += count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n      \n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Collect primitives needed for the goal item\n          goal_primitives = get_primitive_counts(goal_item, initial_state.world.cookbook)\n          \n          # Filter actions based on available inventory and required primitives\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              valid_actions.append((action, new_state))\n          \n          # Prioritize USE actions\n          valid_actions.sort(key=lambda x: x[0] != 4)  # Sort by action type (USE first)\n          \n          for action, new_state in valid_actions:\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the goal item is already available\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 0, "scores": {"3": 2.0}}
{"timestamp": "2025-06-27T00:42:47.388787", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  # Assuming actions are enumerated from 0 to n_actions-1\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def bfs_search(initial_state, goal_item, max_steps=500):  # Added a max_steps parameter to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def a_star_search(initial_state, goal_item, max_steps=500):\n      import heapq\n      \n      open_set = []\n      heapq.heappush(open_set, (0, initial_state, []))\n      visited = set()\n      \n      while open_set:\n          current_cost, current_state, path = heapq.heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heapq.heappush(open_set, (current_cost + 1, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Try A* search first\n  action_sequence = a_star_search(initial_state, goal_item)\n  if action_sequence:\n      return action_sequence\n  \n  # If A* fails, try BFS as a fallback\n  action_sequence = bfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T00:42:48.614036", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_neighbor_states(current_state):\n      neighbor_states = []\n      \n      for action in range(env.world.n_actions):  # Assuming actions are enumerated from 0 to n_actions-1\n          reward, new_state = current_state.step(action)\n          \n          # Convert the new state to a hashable form using a tuple of its attributes\n          state_hash = (tuple(new_state.grid.flatten()), \n                        tuple(new_state.inventory), \n                        new_state.pos, \n                        new_state.dir)\n          \n          neighbor_states.append((new_state, action, state_hash))\n      \n      return neighbor_states\n\n  def bfs_search(initial_state, goal_item, max_steps=500):  # Added a max_steps parameter to prevent infinite loops\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def dfs_search(initial_state, goal_item, max_depth=500):  # Added a max_depth parameter to prevent infinite recursion\n      stack = [(initial_state, [])]\n      visited = set()\n      \n      while stack:\n          current_state, path = stack.pop()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum depth\n          if len(path) >= max_depth:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in reversed(neighbor_states):  # Reverse to maintain original order after popping from stack\n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  stack.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  def heuristic(state, goal_item):\n      \"\"\"Estimate the cost to reach the goal.\"\"\"\n      # A simple heuristic: distance from any primitive needed for the goal\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      if not primitives:\n          return float('inf')\n      \n      min_distance = float('inf')\n      \n      for i_primitive, count in primitives.items():\n          if state.inventory[i_primitive] >= count:\n              continue  # No need to search if we already have enough\n      \n          # Find the closest occurrence of this primitive on the grid\n          kind_grid = np.any(state.grid[:, :, i_primitive], axis=-1)\n          positions = np.argwhere(kind_grid)\n          \n          for pos in positions:\n              distance = abs(pos[0] - state.pos[0]) + abs(pos[1] - state.pos[1])\n              min_distance = min(min_distance, distance)\n      \n      return min_distance if min_distance < float('inf') else 0\n\n  def a_star_search(initial_state, goal_item, max_steps=500):  # Added a max_steps parameter to prevent infinite loops\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0, initial_state, []))\n      \n      came_from = {}\n      g_score = {initial_state: 0}\n      f_score = {initial_state: heuristic(initial_state, goal_item)}\n      visited = set()\n      \n      while not open_set.empty():\n          _, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Avoid exploring paths that exceed the maximum number of steps\n          if len(path) >= max_steps:\n              continue\n          \n          neighbor_states = get_neighbor_states(current_state)\n          \n          for new_state, action, state_hash in neighbor_states:\n              tentative_g_score = g_score[current_state] + 1  # Assuming each step costs 1\n      \n              if new_state not in g_score or tentative_g_score < g_score[new_state]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score[new_state] = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score[new_state], new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Check if the item is already in the inventory\n  if satisfies_goal(initial_state, goal_item):\n      return []\n  \n  # Try A* first\n  action_sequence = a_star_search(initial_state, goal_item)\n  if action_sequence:\n      return action_sequence\n  \n  # If A* fails, try BFS as a fallback\n  action_sequence = bfs_search(initial_state, goal_item)\n  if action_sequence:\n      return action_sequence\n  \n  # If both A* and BFS fail, try DFS as a last resort\n  action_sequence = dfs_search(initial_state, goal_item)\n  \n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-06-27T00:44:31.590658", "function_name": "craft", "function_body": "  def satisfies_goal(state: CraftState, goal_item: int) -> bool:\n      \"\"\"Check if the state satisfies the goal.\"\"\"\n      return state.inventory[goal_item] > 0\n\n  def get_primitive_counts(goal_index: int, cookbook: Cookbook) -> dict[int, int]:\n      \"\"\"Recursively determine the required primitive counts for a given goal index.\"\"\"\n      primitives = {}\n\n      def dfs(current_index: int, count: int = 1):\n          if current_index in cookbook.primitives:\n              primitives[current_index] = primitives.get(current_index, 0) + count\n          elif current_index in cookbook.recipes:\n              recipe = cookbook.recipes[current_index]\n              for ingredient, amount in recipe.items():\n                  if ingredient == \"_key\":\n                      continue\n                  dfs(ingredient, count * amount)\n\n      dfs(goal_index)\n      return primitives\n\n  def bfs_search(initial_state: CraftState, goal_item: int) -> list[int] | None:\n      \"\"\"Perform a breadth-first search to find the sequence of actions that satisfy the goal.\"\"\"\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      state_to_goal_primitives = {state_hash(initial_state): get_primitive_counts(goal_item, initial_state.world.cookbook)}\n      \n      while queue:\n          current_state, path = queue.popleft()\n\n          if satisfies_goal(current_state, goal_item):\n              return path\n\n          # Collect primitives needed for the goal item from the cache or compute them\n          goal_primitives = state_to_goal_primitives[state_hash(current_state)]\n\n          valid_actions = []\n          for action in range(initial_state.world.n_actions):\n              reward, new_state = current_state.step(action)\n\n              if action == 4:  # USE action\n                  # Check if the use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in goal_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n\n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              # Heuristic: Prioritize actions that move closer to having required primitives\n              new_primitives = get_primitive_counts(goal_item, new_state.world.cookbook)\n              heuristic_score = sum(min(new_primitives.get(primitive, 0) - current_primitives, 0)\n                                    for primitive, current_primitives in goal_primitives.items())\n\n              valid_actions.append((new_state, action, heuristic_score))\n\n          # Sort actions by heuristic score (descending order)\n          valid_actions.sort(key=lambda x: x[2], reverse=True)\n\n          for new_state, action, _ in valid_actions:\n              new_state_hash = state_hash(new_state)\n              if new_state_hash not in visited:\n                  visited.add(new_state_hash)\n                  queue.append((new_state, path + [action]))\n                  # Cache the primitives needed for the goal item at this new state\n                  state_to_goal_primitives[new_state_hash] = get_primitive_counts(goal_item, new_state.world.cookbook)\n\n      return None  # Return None if no sequence is found\n\n  def state_hash(state: CraftState) -> tuple:\n      \"\"\"Returns a hashable representation of the state.\"\"\"\n      return (tuple(state.grid.flatten()), \n              tuple(state.inventory), \n              state.pos, \n              state.dir)\n  \n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the goal item is a valid index in the cookbook\n  if not (0 <= goal_item < initial_state.world.cookbook.n_kinds):\n      raise ValueError(f\"Goal item index {goal_item} is out of bounds.\")\n  \n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 3, "scores": {"3": -1}}
