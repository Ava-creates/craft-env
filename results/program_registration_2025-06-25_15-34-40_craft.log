{"timestamp": "2025-06-26T18:56:46.833180", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, max_depth=50):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4)\n          actions = [4] + list(range(4))  # [USE, DOWN, UP, LEFT, RIGHT]\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0:\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited and len(path) < max_depth:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:57:02.475335", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          # Prioritize USE action (index 4)\n          actions = [4] + list(range(4))  # [USE, DOWN, UP, LEFT, RIGHT]\n          \n          for action in actions:\n              reward, new_state = current_state.step(action)\n              \n              # Skip invalid actions that incur penalties\n              if reward < 0 or len(path) > 100:  # Add a max path length to prevent infinite loops\n                  continue\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Start BFS search to find the action sequence\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 9, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:58:21.328648", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      # Simple heuristic: number of steps required to reach a primitive or workshop\n      grid_width, grid_height, _ = initial_state.grid.shape\n      current_pos = state.pos\n      \n      # Find nearby primitives and workshops\n      neighboring_entities = []\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = current_pos[0] + dx, current_pos[1] + dy\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  entity_index = np.argmax(initial_state.grid[nx, ny])\n                  if (entity_index in env.world.cookbook.primitives or \n                      entity_index in env.world.workshop_indices):\n                      neighboring_entities.append(entity_index)\n      \n      # Calculate heuristic value based on distance to nearest primitive/workshop\n      min_distance = float('inf')\n      for nx, ny in [(current_pos[0] + dx, current_pos[1] + dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]]:\n          if 0 <= nx < grid_width and 0 <= ny < grid_height:\n              entity_index = np.argmax(initial_state.grid[nx, ny])\n              if (entity_index in env.world.cookbook.primitives or \n                  entity_index in env.world.workshop_indices):\n                  distance = abs(nx - current_pos[0]) + abs(ny - current_pos[1])\n                  min_distance = min(min_distance, distance)\n      \n      return min_distance\n\n  def a_star_search(initial_state, goal_item, depth_limit=50):  \n      from heapq import heappush, heappop\n      \n      open_set = []\n      heappush(open_set, (heuristic(initial_state, goal_item), initial_state, []))\n      visited = set()\n      \n      while open_set:\n          _, current_state, path = heappop(open_set)\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          grid_width, grid_height, _ = initial_state.grid.shape\n          current_pos = current_state.pos\n\n          neighboring_entities = []\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  nx, ny = current_pos[0] + dx, current_pos[1] + dy\n                  if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                      entity_index = np.argmax(initial_state.grid[nx, ny])\n                      if (entity_index in env.world.cookbook.primitives or \n                          entity_index in env.world.workshop_indices):\n                          neighboring_entities.append(entity_index)\n\n          # Prioritize USE actions for nearby primitives and workshops\n          priority_actions = [4] + [4] * len(neighboring_entities)  # Use action first\n\n          # Add all other movement actions\n          other_actions = list(range(env.world.n_actions))[:-1]\n\n          # Combine actions: prioritize USE over movement\n          possible_actions = priority_actions + other_actions\n\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  heappush(open_set, (heuristic(new_state, goal_item) + len(path), new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:58:33.324588", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def bfs_search(initial_state, goal_item, depth_limit=50):\n      from collections import deque\n      \n      queue = deque([(initial_state, [])])\n      visited = set()\n      \n      while queue:\n          current_state, path = queue.popleft()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          if len(path) >= depth_limit:  # Skip paths exceeding the depth limit\n              continue\n          \n          grid_width, grid_height, _ = initial_state.grid.shape\n          current_pos = current_state.pos\n\n          neighboring_entities = []\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  nx, ny = current_pos[0] + dx, current_pos[1] + dy\n                  if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                      entity_index = np.argmax(initial_state.grid[nx, ny])\n                      if (entity_index in env.world.cookbook.primitives or \n                          entity_index in env.world.workshop_indices):\n                          neighboring_entities.append(entity_index)\n\n          # Prioritize USE actions for nearby primitives and workshops\n          priority_actions = [4] * len(neighboring_entities)  # Use action first\n\n          # Add all other movement actions except USE (action index 4)\n          other_actions = list(range(4))\n\n          # Combine actions: prioritize USE over movement\n          possible_actions = priority_actions + other_actions\n\n          for action in possible_actions:\n              reward, new_state = current_state.step(action)\n              \n              if satisfies_goal(new_state, goal_item):\n                  return path + [action]\n              \n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 2, "scores": {"3": 1.5}}
{"timestamp": "2025-06-26T18:59:26.386493", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def heuristic(state, goal_item):\n      \"\"\"Simple heuristic based on the number of missing ingredients.\"\"\"\n      primitives = env.world.cookbook.primitives_for(goal_item)\n      current_inventory = state.inventory\n      missing_count = sum(max(0, count - current_inventory[index]) for index, count in primitives.items())\n      return missing_count\n\n  def a_star_search(initial_state, goal_item):\n      from queue import PriorityQueue\n      \n      open_set = PriorityQueue()\n      open_set.put((0 + heuristic(initial_state, goal_item), 0, initial_state, []))\n      came_from = {}\n      g_score = {initial_state: 0}\n      \n      while not open_set.empty():\n          _, current_cost, current_state, path = open_set.get()\n          \n          if satisfies_goal(current_state, goal_item):\n              return path\n          \n          for action in range(env.world.n_actions):\n              reward, new_state = current_state.step(action)\n              \n              # Convert the new state to a hashable form using a tuple of its attributes\n              state_hash = (tuple(new_state.grid.flatten()), \n                            tuple(new_state.inventory), \n                            new_state.pos, \n                            new_state.dir)\n              \n              tentative_g_score = g_score[current_state] + 1  # Assuming each action has a cost of 1\n\n              if state_hash not in g_score or tentative_g_score < g_score[state_hash]:\n                  came_from[new_state] = (current_state, action)\n                  g_score[new_state] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(new_state, goal_item)\n                  open_set.put((f_score, tentative_g_score, new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  action_sequence = a_star_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-06-26T18:59:40.299946", "function_name": "craft", "function_body": "  def satisfies_goal(state, goal_item):\n      return state.inventory[goal_item] > 0\n\n  def get_valid_actions(state):\n      valid_actions = []\n      for action in range(env.world.n_actions):\n          reward, new_state = state.step(action)\n          # Check if the new state is different from the current state\n          if not (np.array_equal(new_state.grid, state.grid) and \n                  np.array_equal(new_state.inventory, state.inventory) and \n                  new_state.pos == state.pos and \n                  new_state.dir == state.dir):\n              valid_actions.append(action)\n      return valid_actions\n\n  def bfs_search(initial_state, goal_item):\n    from collections import deque\n    \n    queue = deque([(initial_state, [])])\n    visited = set()\n    \n    while queue:\n        current_state, path = queue.popleft()\n        \n        if satisfies_goal(current_state, goal_item):\n            return path\n        \n        for action in get_valid_actions(current_state):\n            reward, new_state = current_state.step(action)\n            \n            # Convert the new state to a hashable form using a tuple of its attributes\n            state_hash = (tuple(new_state.grid.flatten()), \n                          tuple(new_state.inventory), \n                          new_state.pos, \n                          new_state.dir)\n            \n            if state_hash not in visited:\n                visited.add(state_hash)\n                queue.append((new_state, path + [action]))\n    \n    return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  # Ensure the item index is valid and can be crafted or is a primitive\n  if goal_item not in env.world.cookbook.kinds:\n      raise ValueError(f\"Goal item {goal_item} is not a valid kind in the cookbook.\")\n  \n  if goal_item in env.world.non_grabbable_indices:\n      raise ValueError(f\"Goal item {goal_item} is non-grabbable and cannot be crafted.\")\n\n  # If the goal item is already available, return an empty path\n  if satisfies_goal(initial_state, goal_item):\n      return []\n\n  action_sequence = bfs_search(initial_state, goal_item)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 5, "scores": {"3": 1.5}}
