use action can contribute to making the goal item\n                  can_make_goal = True\n                  for primitive, count in target_primitives.items():\n                      if new_state.inventory[primitive] < count:\n                          can_make_goal = False\n                          break\n                  \n                  if not can_make_goal:\n                      continue  # Skip this action as it doesn't help make the goal item\n\n              state_hash = (\n                  tuple(new_state.grid.flatten()),\n                  tuple(new_state.inventory),\n                  new_state.pos,\n                  new_state.dir\n              )\n              \n              if state_hash not in visited:\n                  visited.add(state_hash)\n                  queue.append((new_state, path + [action]))\n      \n      return None  # Return None if no sequence is found\n\n  initial_state = env._current_state\n  goal_item = item\n  \n  if goal_item >= initial_state.world.cookbook.n_kinds or goal_item < 0:\n      raise ValueError(\"Invalid goal item index\")\n  \n  all_primitives = get_all_primitives(env)\n  action_sequence = bfs_search(initial_state, goal_item, all_primitives)\n\n  return action_sequence if action_sequence else []  # Return empty list if no actions found", "island_id": 4, "scores": {"3": 2.0}}
