 env.world.cookbook.index['WATER']: ['BRIDGE'],\n          env.world.cookbook.index['GEM']: ['PICKAXE']\n      }\n\n      # Update the tool requirements based on current inventory and environment\n      for item, required_tool in list(tools.items()):\n          if any(inventory[env.world.cookbook.index[tool]] > 0 for tool in required_tool):\n              continue\n\n          # Check if there's a nearby item that can be used to craft the required tool\n          tool_recipe = env.world.cookbook.recipes.get(required_tool[0])\n          if not tool_recipe:\n              continue\n\n          # Add crafting actions to the list if necessary tools are available\n          for ingredient, amount in tool_recipe.items():\n              if inventory[env.world.cookbook.index[ingredient]] < amount:\n                  return False\n\n      return True\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  targets = set(map(tuple, positions))\n  path = find_shortest_path(start_pos, targets)\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  tools_for_primitive = update_tools_for_primitive()\n\n  if not tools_for_primitive:\n    raise ValueError(\"Insufficient tools or ingredients to collect the primitive.\")\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect