tate.grid[pos[0], pos[1]]\n      if primitive_index == env.world.cookbook.index['WATER']:\n        if inventory[env.world.cookbook.index['BRIDGE']] == 0 and cell[env.world.cookbook.index['WATER']] > 0:\n          tools.append('BRIDGE')\n    return tools\n\n  def craft_tool(tool):\n      # Placeholder for crafting logic\n      actions = [craft.CRAFT_FUNC(env.world.cookbook.index[tool]), craft.USE]\n      return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  inventory = env._current_state.inventory\n\n  # Check if tools are needed for the path\n  tools_needed = find_tools_needed(path, primitive_index)\n  for tool in tools_needed:\n    actions.extend(craft_tool(tool))\n\n  # Add movement actions to reach the primitive\n  actions.extend(use_tool_if_needed(path, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T00:50:55.755364", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n    tools_used = set()\n    grid = env._current_state.grid\n    cookbook = env.world.cookbook\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if (dx == 0 and dy == 0):\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = grid[path[i + 1][0], path[i + 1][1]].argmax()\n\n      # Determine required tools for the next cell based on recipes\n      required_tools = determine_required_tools(next_cell_index, inventory)\n      actions.extend(collect_required_tools(required_tools, inventory))\n\n      # Use tools that are available and required\n      for tool in required_tools:\n        if inventory[tool] > 0 and tool not in tools_used:\n          actions.append(craft.CRAFT_FUNC(tool))\n          actions.append(craft.USE)\n          tools_used.add(tool)\n\n    return actions\n\n  def find_nearest_primitive(primitive_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n    if len(positions) == 0:\n        raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n    start_pos = env._current_state.pos\n\n    # Find the nearest instance of the primitive\n    min_distance = float('inf')\n    nearest_position = None\n\n    for pos in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(start_pos))\n        if distance < min_distance:\n            min_distance = distance\n            nearest_position = tuple(pos)\n\n    return nearest_position\n\n  def collect_required_tools(required_tools, inventory):\n      actions = []\n      for tool_index, count in required_tools.items():\n          # Find the nearest instance of each required tool\n          if inventory[tool_index] < count:\n              nearest_tool_position = find_nearest_primitive(tool_index)\n              start_pos = env._current_state.pos\n              path_to_tool = build_path(start_pos, nearest_tool_position)\n              if path_to_tool is not None:\n                  actions.extend(use_tool_if_needed(path_to_tool, tool_index))\n                  actions.append(craft.USE)\n      return actions\n\n  def determine_required_tools(cell_index, inventory):\n    required_tools = {}\n    if cell_index in env.world.cookbook.recipes:\n        recipe = env.world.cookbook.recipes[cell_index]\n        if '_tools' in recipe:  # Assuming tools are listed under a key like '_tools'\n            for tool_name, count in recipe['_tools'].items():\n                tool_index = env.world.cookbook.index[tool_name]\n                if inventory[tool_index] < count:\n                    required_tools[tool_index] = count\n    return required_tools\n\n  def build_path(start_pos, end_pos):\n    grid = env._current_state.grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {tuple(start_pos): None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == tuple(end_pos):\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[tuple(current_pos)]\n            path.reverse()\n            return path\n\n        visited.add(tuple(current_pos))\n\n        # Check neighbors (UP, DOWN, LEFT, RIGHT)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n            if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n                if neighbor_pos not in visited:\n                    queue.append(neighbor_pos)\n                    parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Determine required tools for the destination primitive\n  start_pos = env._current_state.pos\n  nearest_primitive_position = find_nearest_primitive(primitive_index)\n  destination_cell_index = env._current_state.grid[nearest_primitive_position].argmax()\n  required_tools = determine_required_tools(destination_cell_index, env._current_state.inventory)\n\n  # Collect any required tools if they are not in the inventory\n  actions.extend(collect_required_tools(required_tools, env._current_state.inventory))\n\n  # Re-evaluate the path after collecting tools\n  nearest_primitive_position = find_nearest_primitive(primitive_index)\n  start_pos = env._current_state.pos\n  path_to_primitive = build_path(start_pos, nearest_primitive_position)\n\n  if path_to_primitive is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  actions.extend(use_tool_if_needed(path_to_primitive, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T00:50:56.757223", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([(start, [])])\n    visited = set()\n\n    while queue:\n      current_pos, path = queue.popleft()\n      if tuple(current_pos) in targets:\n        return path\n\n      visited.add(tuple(current_pos))\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if (0 <= neighbor_pos[0] < grid.shape[0] and\n            0 <= neighbor_pos[1] < grid.shape[1] and\n            neighbor_pos not in visited):\n          new_path = path + [neighbor_pos]\n          queue.append((neighbor_pos, new_path))\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n    tools_used = set()\n    grid = env._current_state.grid\n    cookbook = env.world.cookbook\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = grid[path[i + 1][0], path[i + 1][1]].argmax()\n      required_tools = determine_required_tools(next_cell_index, inventory)\n      \n      # Collect any required tools if they are not in the inventory\n      actions.extend(collect_required_tools(required_tools, inventory))\n\n      # Use tools that are available and required\n      for tool in required_tools:\n        if inventory[tool] > 0 and tool not in tools_used:\n          actions.append(craft.CRAFT_FUNC(tool))\n          actions.append(craft.USE)\n          tools_used.add(tool)\n\n    return actions\n\n  def find_nearest_primitive(primitive_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n    if len(positions) == 0:\n        raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n    start_pos = env._current_state.pos\n\n    # Find the nearest instance of the primitive\n    min_distance = float('inf')\n    nearest_position = None\n\n    for pos in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(start_pos))\n        if distance < min_distance:\n            min_distance = distance\n            nearest_position = tuple(pos)\n\n    return nearest_position\n\n  def collect_required_tools(required_tools, inventory):\n      actions = []\n      cookbook = env.world.cookbook\n      \n      for tool, count in required_tools.items():\n          # Find the nearest instance of each required tool\n          tool_index = cookbook.index[tool]\n          if tool_index in env.world.grabbable_indices and inventory[tool] < count:\n              nearest_tool_position = find_nearest_primitive(tool_index)\n              start_pos = env._current_state.pos\n              path_to_tool = find_shortest_path(start_pos, set(map(tuple, [nearest_tool_position])))\n              if path_to_tool is not None:\n                  actions.extend(use_tool_if_needed(path_to_tool, tool_index))\n                  actions.append(craft.USE)\n      return actions\n\n  def determine_required_tools(cell_index, inventory):\n    required_tools = {}\n    cookbook = env.world.cookbook\n    if cell_index in cookbook.recipes:\n        recipe = cookbook.recipes[cell_index]\n        if '_tools' in recipe:  # Assuming tools are listed under a key like '_tools'\n            for tool, count in recipe['_tools'].items():\n                if inventory[tool] < count:\n                    required_tools[cookbook.index[tool]] = count\n    return required_tools\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Determine required tools for the destination primitive\n  start_pos = env._current_state.pos\n  nearest_primitive_position = find_nearest_primitive(primitive_index)\n  destination_cell_index = env._current_state.grid[nearest_primitive_position].argmax()\n  required_tools = determine_required_tools(destination_cell_index, env._current_state.inventory)\n\n  # Collect any required tools if they are not in the inventory\n  actions.extend(collect_required_tools(required_tools, env._current_state.inventory))\n\n  # Re-evaluate the path after collecting tools\n  nearest_primitive_position = find_nearest_primitive(primitive_index)\n  start_pos = env._current_state.pos\n  path_to_primitive = find_shortest_path(start_pos, set(map(tuple, [nearest_primitive_position])))\n\n  if path_to_primitive is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  actions.extend(use_tool_if_needed(path_to_primitive, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-08-10T00:52:41.224332", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if (dx, dy) == (0, 0):\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = env.world.cookbook.index[env._current_state.grid[path[i + 1][0], path[i + 1][1]]]\n      required_tool = get_required_tool(next_cell_index, primitive_index)\n      \n      if required_tool and inventory[required_tool] > 0:\n        tool_index = required_tool\n        if can_place_tool(tool_index, path[i + 1]):\n          actions.append(craft.CRAFT_FUNC(tool_index))\n          actions.append(craft.USE)\n\n    return actions\n\n  def get_required_tool(cell_index, primitive_index):\n      # Define the tools needed for each cell type to collect primitives\n      required_tools = {\n          env.world.cookbook.index['WATER']: env.world.cookbook.index['BRIDGE'],\n          env.world.cookbook.index['ROCK']: env.world.cookbook.index['PICKAXE']\n      }\n\n      # Check if the tool is needed for the cell type\n      return required_tools.get(cell_index, None)\n\n  def can_place_tool(tool_index, target_cell):\n    # Check if the tool can be placed on the target cell\n    return env._current_state.grid[target_cell[0], target_cell[1], tool_index] == 0\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-10T00:52:42.222411", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if (dx, dy) == (0, 0):\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n\n      # Example: Use BRIDGE to cross WATER\n      if primitive_index == env.world.cookbook.index['WATER'] and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        if can_place_tool(env.world.cookbook.index['BRIDGE'], path[i + 1]):\n          actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n          actions.append(craft.USE)\n\n    return actions\n\n  def can_place_tool(tool_index, target_cell):\n    # Check if the tool can be placed on the target cell\n    grid = env._current_state.grid\n    target_x, target_y = target_cell\n    for z in range(grid.shape[2]):\n      if grid[target_x, target_y, z] > 0:\n        return False\n    return True\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T00:54:23.260096", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = grid[path[i + 1][0], path[i + 1][1]].argmax()\n      if next_cell_index == env.world.cookbook.index['WATER']:\n          # Use BRIDGE to cross WATER\n          if inventory[env.world.cookbook.index['BRIDGE']] > 0:\n              actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n              actions.append(craft.USE)\n      elif next_cell_index == env.world.cookbook.index['ROCK']:\n          # Use PICKAXE to mine ROCK\n          if inventory[env.world.cookbook.index['PICKAXE']] > 0:\n              actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n              actions.append(craft.USE)\n      elif next_cell_index == env.world.cookbook.index['TREE']:\n          # Use AXE to cut TREE\n          if inventory[env.world.cookbook.index['AXE']] > 0:\n              actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['AXE']))\n              actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T00:54:24.267978", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = grid[path[i + 1][0], path[i + 1][1]].argmax()\n      required_tools = get_required_tool(next_cell_index)\n      \n      if required_tools and inventory[required_tools] > 0:\n          actions.append(craft.CRAFT_FUNC(env.world.cookbook.index[required_tools]))\n          actions.append(craft.USE)\n\n    return actions\n\n  def get_required_tool(cell_index):\n    # Mapping from cell index to required tool\n    required_tools = {\n        env.world.cookbook.index['WATER']: 'BRIDGE',\n        env.world.cookbook.index['ROCK']: 'PICKAXE',\n        env.world.cookbook.index['IRONORE']: 'PICKAXE'\n    }\n    return required_tools.get(cell_index)\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": 1.0}}
