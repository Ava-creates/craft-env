nteract with them\n    # For example, WATER might require a BRIDGE, ROCK might require a PICKAXE, etc.\n    if cell_index == env.world.cookbook.index['WATER']:\n      return env.world.cookbook.index['BRIDGE']\n    elif cell_index == env.world.cookbook.index['ROCK']:\n      return env.world.cookbook.index['PICKAXE']\n    # Add more mappings as needed\n    return None\n\n  def get_primitive_positions(primitive_index, grid):\n    return set(map(tuple, np.argwhere(grid[:, :, primitive_index] > 0)))\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = get_primitive_positions(primitive_index, grid)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, positions)\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 1.0}}
