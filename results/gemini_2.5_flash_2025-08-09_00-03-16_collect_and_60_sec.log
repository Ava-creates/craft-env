ol usage\n    cookbook = env.world.cookbook.index\n    if (primitive_index == cookbook['WATER'] and\n        inventory[tool_index] > 0 and\n        tool_index == cookbook['BRIDGE']):\n      return True\n    elif (primitive_index in [cookbook['GOLD'], cookbook['GEM']] and\n          inventory[tool_index] > 0 and\n          tool_index == cookbook['PICKAXE']):\n      return True\n    else:\n      return False\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  inventory = env._current_state.inventory\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T18:20:11.478152", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        return path[::-1]\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if (0 <= neighbor_pos[0] < grid.shape[0] and\n            0 <= neighbor_pos[1] < grid.shape[1]):\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tools_if_needed(path, primitive_index):\n      actions = []\n      inventory = env._current_state.inventory\n      grid = env._current_state.grid\n      required_tools = {\n          env.world.cookbook.index['WATER']: 'BRIDGE',\n          env.world.cookbook.index['GEM']: 'PICKAXE'\n      }\n\n      for i in range(len(path) - 1):\n          # Determine the direction of movement\n          dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n          if (dx, dy) in directions:\n              actions.append(directions[(dx, dy)])\n\n          next_cell_items = grid[path[i + 1][0], path[i + 1][1]].nonzero()[0]\n\n          for item_index in next_cell_items:\n              if item_index in required_tools and inventory[env.world.cookbook.index[required_tools[item_index]]] > 0:\n                  actions.append(craft.CRAFT_FUNC(env.world.cookbook.index[required_tools[item_index]]))\n                  actions.append(craft.USE)\n\n      return actions\n\n  # Define the mapping from direction to action\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = tuple(env._current_state.pos)\n  target_positions = set(map(tuple, positions))\n  path = find_shortest_path(start_pos, target_positions)\n\n  if not path:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  actions = use_tools_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T18:20:12.519645", "function_name": "collect", "function_body": "  def find_shortest_path(start_pos, target_positions):\n    grid = env._current_state.grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {tuple(start_pos): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in target_positions:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        return path[::-1]\n\n      visited.add(tuple(current_pos))\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if (0 <= neighbor_pos[0] < grid.shape[0] and\n            0 <= neighbor_pos[1] < grid.shape[1]):\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tools_if_needed(path, primitive_index):\n    actions = []\n    inventory = env._current_state.inventory\n    grid = env._current_state.grid\n\n    # Define the required tools for specific environments\n    required_tools = {\n        env.world.cookbook.index['WATER']: 'BRIDGE',\n        env.world.cookbook.index['GEM']: 'PICKAXE'\n    }\n\n    tool_indices = {env.world.cookbook.index[tool]: i for i, tool in enumerate(required_tools.values())}\n\n    # Create a set of positions that need tools\n    tool_required_positions = set()\n    for x, y in path:\n        next_cell_items = grid[x, y].nonzero()[0]\n        for item_index in next_cell_items:\n            if item_index in required_tools:\n                tool_required_positions.add((x, y))\n\n    # Calculate the shortest paths to places where tools are needed\n    tool_paths = {}\n    for tool_pos in tool_required_positions:\n        tool_path = find_shortest_path(start_pos, {tool_pos})\n        if tool_path:\n            tool_paths[tuple(tool_pos)] = tool_path\n\n    # Find the closest path to a place that needs a tool\n    closest_tool_path = None\n    min_distance = float('inf')\n    for tool_path in tool_paths.values():\n        distance = len(tool_path)\n        if distance < min_distance:\n            closest_tool_path = tool_path\n            min_distance = distance\n\n    # If there's a path to a place that needs a tool, go and get it first\n    if closest_tool_path:\n        actions.extend(use_tools_if_needed(closest_tool_path, primitive_index))\n        start_pos = closest_tool_path[-1]\n\n    # Continue to the target with the required tools in hand\n    for i in range(len(path) - 1):\n        dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n        if (dx, dy) in directions:\n            actions.append(directions[(dx, dy)])\n\n        next_cell_items = grid[path[i + 1][0], path[i + 1][1]].nonzero()[0]\n\n        for item_index in next_cell_items:\n            if item_index in required_tools and inventory[tool_indices[item_index]] > 0:\n                actions.append(craft.CRAFT_FUNC(tool_indices[item_index]))\n                actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = tuple(env._current_state.pos)\n  target_positions = set(map(tuple, positions))\n  path = find_shortest_path(start_pos, target_positions)\n\n  if not path:\n      raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tools_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T18:21:55.214631", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = grid[path[i + 1][0], path[i + 1][1]].argmax()\n\n      # Example: Use BRIDGE to cross WATER\n      if next_cell_index == env.world.cookbook.index['WATER'] and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n      elif next_cell_index == env.world.cookbook.index['STONE'] and inventory[env.world.cookbook.index['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
