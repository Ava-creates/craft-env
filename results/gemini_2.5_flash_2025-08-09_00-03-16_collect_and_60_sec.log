.append(craft.USE)\n\n  # Function to determine if a tool can be used at a specific position\n  def can_use_tool_here(tool_name, pos):\n    x, y = pos\n    return (tool_name == \"BRIDGE\" and current_state.grid[x, y, env.world.cookbook.index[\"WATER\"]] > 0) or\\\n           (tool_name == \"PICKAXE\" and current_state.grid[x, y, env.world.cookbook.index[\"GEM\"]] > 0)\n\n  # Function to check if the primitive is next to the current position\n  def is_primitive_next_to(pos, item_idx):\n    for neighbor in get_neighbors(pos):\n      nx, ny = neighbor\n      if is_valid_position((nx, ny)) and current_state.grid[nx, ny, item_idx] > 0:\n        return True\n    return False\n\n  # Function to update the current state based on actions taken\n  def update_current_state(action):\n    env.step(action, num_steps=1)\n    nonlocal current_state\n    current_state = env._current_state\n\n  # Function to find a path while considering tool usage\n  def bfs_find_primitive_with_tools(start_pos, item_idx):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      x, y = pos\n\n      # Check if the current position contains the desired primitive\n      if current_state.grid[x, y, item_idx] > 0:\n        return path + [craft.USE]\n\n      # Explore neighbors\n      for neighbor in get_neighbors(pos):\n        nx, ny = neighbor\n        if is_valid_position((nx, ny)) and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          # Determine direction based on neighbor position\n          dx, dy = nx - x, ny - y\n          action = RIGHT if dx == 1 else LEFT if dx == -1 else DOWN if dy == -1 else UP\n\n          # Check if a tool needs to be used before moving\n          use_tool_if_needed(pos)\n          queue.append(((nx, ny), path + [action]))\n\n    return None\n\n  # Find the shortest path to the primitive considering tool usage\n  start_pos = current_state.pos\n  path_to_primitive = bfs_find_primitive_with_tools(start_pos, item_idx)\n\n  if path_to_primitive is not None:\n    for action in path_to_primitive[:-1]:\n      actions.append(action)\n      \n      # Update the current state after each move\n      update_current_state(action)\n      \n      # Check if we have reached a position where the primitive is next to us\n      if is_primitive_next_to(current_state.pos, item_idx):\n        actions.append(path_to_primitive[-1])  # Move to collect the primitive\n        actions.append(craft.USE)  # Collect the primitive\n        break\n\n    else:\n      actions.append(path_to_primitive[-1])  # Move to collect the primitive\n      actions.append(craft.USE)  # Collect the primitive\n  else:\n    print(f\"No path found to collect {primitive}.\")\n\n  return actions", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T23:43:09.275349", "function_name": "collect", "function_body": "  def find_shortest_path(start_pos, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {tuple(start_pos): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    cookbook = env.world.cookbook.index\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if (dx == 0 and dy == 0):\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check the next cell for tools needed to cross or mine\n      next_cell_indices = env._current_state.grid[path[i + 1][0], path[i + 1][1]].nonzero()[0]\n\n      for index in next_cell_indices:\n          if can_use_tool(index, primitive_index):\n              actions.append(craft.CRAFT_FUNC(index))\n              actions.append(craft.USE)\n\n    return actions\n\n  def can_use_tool(tool_index, primitive_index):\n    cookbook = env.world.cookbook.index\n    inventory = env._current_state.inventory\n\n    # Check for BRIDGE to cross WATER\n    if (primitive_index == cookbook['WATER'] and\n        tool_index == cookbook['BRIDGE'] and\n        inventory[tool_index] > 0):\n        return True\n    \n    # Check for PICKAXE to mine GOLD or GEM\n    elif (primitive_index in [cookbook['GOLD'], cookbook['GEM']] and\n          tool_index == cookbook['PICKAXE'] and\n          inventory[tool_index] > 0):\n        return True\n    \n    # Check for HAMMER/AXE to mine STONE\n    elif (primitive_index == cookbook['STONE'] and\n          tool_index in [cookbook['HAMMER'], cookbook['AXE']] and\n          inventory[tool_index] > 0):\n        return True\n\n    return False\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T23:43:10.274336", "function_name": "collect", "function_body": "  def find_shortest_path(start_pos, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {tuple(start_pos): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n    cookbook = env.world.cookbook.index\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check the next cell for tools needed to cross or mine\n      next_cell_indices = env._current_state.grid[path[i + 1][0], path[i + 1][1]].nonzero()[0]\n\n      for index in next_cell_indices:\n        if can_use_tool(index, primitive_index):\n          actions.append(craft.CRAFT_FUNC(index))\n          actions.append(craft.USE)\n\n    return actions\n\n  def can_use_tool(tool_index, primitive_index):\n      cookbook = env.world.cookbook.index\n      inventory = env._current_state.inventory\n      if (primitive_index == cookbook['WATER'] and\n          inventory[tool_index] > 0 and\n          tool_index == cookbook['BRIDGE']):\n          return True\n      elif (primitive_index in [cookbook['GOLD'], cookbook['GEM']] and\n            inventory[tool_index] > 0 and\n            tool_index == cookbook['PICKAXE']):\n          return True\n      else:\n          return False\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T23:45:24.535196", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n    tools_used = set()\n    grid = env._current_state.grid\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = grid[path[i + 1][0], path[i + 1][1]].argmax()\n\n      # Determine required tools for the next cell based on recipes\n      required_tools = {}\n      if next_cell_index in env.world.cookbook.recipes:\n        recipe = env.world.cookbook.recipes[next_cell_index]\n        if 'tools' in recipe:\n          required_tools = recipe['tools']\n\n      # Use tools that are available and required\n      for tool, count in required_tools.items():\n        if inventory[tool] >= count and tool not in tools_used:\n          actions.append(craft.CRAFT_FUNC(tool))\n          actions.append(craft.USE)\n          tools_used.add(tool)\n\n    return actions\n\n  def find_nearest_primitive(primitive_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n    if len(positions) == 0:\n        raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n    start_pos = env._current_state.pos\n\n    # Find the nearest instance of the primitive\n    min_distance = float('inf')\n    nearest_position = None\n\n    for pos in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(start_pos))\n        if distance < min_distance:\n            min_distance = distance\n            nearest_position = tuple(pos)\n\n    return nearest_position\n\n  def build_path(start_pos, end_pos):\n    grid = env._current_state.grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {tuple(start_pos): None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == tuple(end_pos):\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[tuple(current_pos)]\n            path.reverse()\n            return path\n\n        visited.add(tuple(current_pos))\n\n        # Check neighbors (UP, DOWN, LEFT, RIGHT)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n            if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n                if neighbor_pos not in visited:\n                    queue.append(neighbor_pos)\n                    parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the nearest instance of the primitive\n  nearest_primitive_position = find_nearest_primitive(primitive_index)\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = build_path(start_pos, nearest_primitive_position)\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
