m]['tools']\n              for tool, count in required_tools.items():\n                  if inventory[tool] >= count and tool not in tools_used:\n                      actions.append(craft.CRAFT_FUNC(tool))\n                      actions.append(craft.USE)\n                      tools_used.add(tool)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T16:47:25.106365", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n\n      # Use BRIDGE to cross WATER\n      if primitive_index == env.world.cookbook.index['WATER'] and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  def get_primitive_positions(primitive_index):\n      grid = env._current_state.grid\n      positions = np.argwhere(grid[:, :, primitive_index] > 0)\n      if len(positions) == 0:\n          raise ValueError(f\"No instances of {primitive} found in the environment.\")\n      return set(map(tuple, positions))\n\n  # Initialize necessary variables and constants\n  primitive_index = env.world.cookbook.index[primitive]\n  start_pos = env._current_state.pos\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  # Handle cases where the primitive cannot be grabbed\n  if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Attempt to collect all instances of the primitive\n  while True:\n      try:\n          positions = get_primitive_positions(primitive_index)\n          path = find_shortest_path(start_pos, positions)\n\n          if path is None:\n              break\n\n          actions += use_tool_if_needed(path, primitive_index)\n\n          # Add the USE action to collect the primitive\n          actions.append(craft.USE)\n\n      except ValueError as e:\n          print(e)\n          break\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-09T16:47:26.067117", "function_name": "collect", "function_body": "  def find_shortest_path_with_tools(start, targets):\n    grid = env._current_state.grid\n    inventory = env._current_state.inventory\n\n    # Tools and their effects on the environment\n    tools = {\n        'BRIDGE': {'WATER'},\n        'AXE': {'TREE'}\n    }\n\n    queue = collections.deque([(start, [])])\n    visited = set()\n\n    while queue:\n      current_pos, path = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = np.array(current_pos) + np.array([dx, dy])\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          cell_content = env.world.cookbook.index.get(grid[neighbor_pos[0], neighbor_pos[1]].argmax(), None)\n          tool_required = None\n\n          # Check if the neighbor cell requires a tool\n          for tool, targets in tools.items():\n              if inventory[env.world.cookbook.index[tool]] > 0 and cell_content in targets:\n                  tool_required = tool\n                  break\n\n          if tool_required is None or (tool_required is not None and inventory[env.world.cookbook.index[tool_required]] > 0):\n            new_path = path + [(dx, dy)]\n            queue.append((tuple(neighbor_pos), new_path))\n\n    return None\n\n  def actions_from_path(path):\n    directions = {\n        (-1, 0): craft.LEFT,\n        (1, 0): craft.RIGHT,\n        (0, -1): craft.DOWN,\n        (0, 1): craft.UP\n    }\n\n    inventory = env._current_state.inventory\n    grid = env._current_state.grid\n\n    actions = []\n\n    for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      action = directions.get((dx, dy))\n\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = grid[path[i + 1][0], path[i + 1][1]]\n      cell_content = env.world.cookbook.index.get(next_cell.argmax(), None)\n      tools = {\n          'BRIDGE': {'WATER'},\n          'AXE': {'TREE'}\n      }\n\n      for tool, targets in tools.items():\n        if inventory[env.world.cookbook.index[tool]] > 0 and cell_content in targets:\n          actions.append(craft.CRAFT_FUNC(env.world.cookbook.index[tool]))\n          actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path_with_tools(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  actions = actions_from_path(path)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
