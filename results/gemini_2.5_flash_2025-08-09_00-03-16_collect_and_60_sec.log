{"timestamp": "2025-08-09T18:42:40.988145", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def get_tool_usage_actions(tool_name, target_index):\n      tool_index = env.world.cookbook.index[tool_name]\n      if env._current_state.inventory[tool_index] > 0:\n          return [craft.CRAFT_FUNC(tool_index), craft.USE]\n      else:\n          raise ValueError(f\"Tool {tool_name} not found in inventory.\")\n\n  def check_and_use_tools(path):\n    actions = []\n    for i in range(len(path) - 1):\n        current_pos, next_pos = path[i], path[i + 1]\n\n        # Determine the direction of movement\n        dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n        action = directions.get((dx, dy))\n        if action is not None:\n            actions.append(action)\n\n        # Check if the next cell requires a tool\n        next_cell_index = env._current_state.grid[next_pos].argmax()\n\n        if next_cell_index == env.world.cookbook.index['WATER'] and env._current_state.inventory[env.world.cookbook.index['BRIDGE']] > 0:\n            actions.extend(get_tool_usage_actions('BRIDGE', next_cell_index))\n        \n        elif next_cell_index == env.world.cookbook.index['GEM'] and env._current_state.inventory[env.world.cookbook.index['PICKAXE']] > 0:\n            actions.extend(get_tool_usage_actions('PICKAXE', next_cell_index))\n\n    return actions\n\n  primitive_index = env.world.craftLabook.index.get(primitive)\n\n  if primitive_index is None:\n      raise ValueError(f\"Primitive {primitive} not found in the cookbook.\")\n\n  if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # Find all positions of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if not path:\n      raise ValueError(\"No path found to any instances of the primitive.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  # Check each step in the path for obstacles and use tools if needed\n  actions = check_and_use_tools(path)\n\n  # Add final USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
