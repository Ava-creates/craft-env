dir))\n          current_dir = direction_map[(dx, dy)]\n\n          # Move or use item at current position\n          actions.append(env.world.USE)\n      \n      return actions\n\n  def rotate_to_direction(current_dir, target_dir):\n    actions = []\n    # Define the mapping from current direction to action indices for turning.\n    rotation_map = {\n        (0, 1): [env.world.RIGHT],       # Right from Up\n        (0, 3): [env.world.LEFT],         # Left from Up\n        (0, 2): [env.world.DOWN, env.world.DOWN],  # Down from Up\n        (1, 0): [env.world.LEFT],         # Left from Right\n        (1, 2): [env.world.RIGHT],       # Right from Right\n        (1, 3): [env.world.UP, env.world.UP],     # Up from Right\n        (2, 0): [env.world.DOWN, env.world.DOWN],  # Down from Down\n        (2, 1): [env.world.LEFT],         # Left from Down\n        (2, 3): [env.world.RIGHT],       # Right from Down\n        (3, 0): [env.world.UP, env.world.UP],     # Up from Left\n        (3, 1): [env.world.RIGHT],       # Right from Left\n        (3, 2): [env.world.LEFT],         # Left from Left\n    }\n\n    key = (current_dir, target_dir)\n    return rotation_map.get(key, [])\n\n  def is_primitive_reachable(primitive_name):\n    target_pos = find_nearest_primitive(primitive_name)\n    if not target_pos:\n        return False\n    \n    path = compute_shortest_path_to_target(env._current_state.pos, target_pos)\n    return len(path) > 0\n\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # If the agent already has the primitive, no need to collect it\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n  \n  # Check if the nearest primitive is reachable\n  if not is_primitive_reachable(primitive):\n      return []\n\n  # Find the nearest occurrence of the primitive\n  target_pos = find_nearest_primitive(primitive)\n  \n  # Compute the shortest path to the nearest primitive\n  path_to_target = compute_shortest_path_to_target(env._current_state.pos, target_pos)\n\n  # Convert the path into a sequence of actions for the agent\n  action_sequence = follow_path(path_to_target)\n  \n  return action_sequence", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-09T03:54:06.470578", "function_name": "collect", "function_body": "  def get_available_tools():\n    tools = []\n    for i_kind in env.world.cookbook.primitives:\n      if env._current_state.inventory[i_kind] > 0:\n        tools.append(i_kind)\n    return tools\n\n  def can_use_tool(primitive_index, tool):\n    # Check if the given tool can be used to collect the primitive\n    if tool == env.world.stone_index and primitive in [\"GEM\"]:\n      return True\n    elif tool == env.world.water_index and primitive in [\"WATER\"]:\n      return False  # Assuming WATER cannot be collected using BRIDGE\n    # Add more conditions as necessary for other tools and primitives\n    return False\n\n  def find_path_with_tools(primitive_index, tools):\n    from collections import deque\n\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    dir_ = env._current_state.dir\n    width, height, _ = grid.shape\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n\n    queue = deque([(pos[0], pos[1], dir_, [], [])])  # (x, y, direction, path, used_tools)\n    visited = set()\n    visited.add((pos[0], pos[1]))\n\n    while queue:\n      x, y, current_dir, path, used_tools = queue.popleft()\n\n      if env._current_state.next_to(primitive_index):\n        return path\n\n      for i, (dx, dy) in enumerate(directions):\n        nx, ny = x + dx, y + dy\n\n        if 0 <= nx < width and 0 <= ny < height:\n          new_dir = i\n          new_path = path.copy()\n          new_used_tools = used_tools.copy()\n\n          # Turn to the correct direction\n          if current_dir != new_dir:\n            turn_action = (new_dir - current_dir) % 4\n            if turn_action == 1:\n              new_path.append(3)  # RIGHT\n            elif turn_action == 2:\n              new_path.extend([3, 3])  # RIGHT twice (180 degrees)\n            elif turn_action == 3:\n              new_path.append(2)  # LEFT\n\n          # Check if we can use a tool to move over obstacles\n          for tool in tools:\n            if can_use_tool(primitive_index, tool):\n              place_tool_action = env.world.n_actions + used_tools.count(tool)  # Assuming actions after n_actions are tool placement actions\n              new_path.append(place_tool_action)\n              new_used_tools.append(tool)\n\n          # Move forward\n          move_action = 0  # DOWN (assuming DOWN is the move action)\n          new_path.append(move_action)\n\n          if (nx, ny) not in visited:\n            queue.append((nx, ny, new_dir, new_path, new_used_tools))\n            visited.add((nx, ny))\n\n    return []\n\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  tools = get_available_tools()\n  actions = find_path_with_tools(primitive_index, tools)\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-09T03:54:07.468664", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index):\n    # BFS to find the shortest path\n    from collections import deque\n\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    dir_ = env._current_state.dir\n    width, height, _ = grid.shape\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    actions = {0: 'DOWN', 1: 'RIGHT', 2: 'UP', 3: 'LEFT'}\n\n    queue = deque([(pos[0], pos[1], dir_, [])])\n    visited = set()\n    visited.add((pos[0], pos[1]))\n\n    while queue:\n      x, y, current_dir, path = queue.popleft()\n\n      # Check if we are next to the primitive\n      if env._current_state.next_to(primitive_index):\n        return path\n\n      for i, (dx, dy) in enumerate(directions):\n        nx, ny = x + dx, y + dy\n\n        if 0 <= nx < width and 0 <= ny < height:\n          new_dir = i\n          new_path = path.copy()\n\n          # Turn to the correct direction\n          turn_action = (new_dir - current_dir) % 4\n          if turn_action == 1:\n              new_path.append(3)  # RIGHT\n          elif turn_action == 2:\n              new_path.extend([3, 3])  # RIGHT twice (180 degrees)\n          elif turn_action == 3:\n              new_path.append(2)  # LEFT\n\n          # Move forward\n          new_path.append(0)  # DOWN (assuming DOWN is the move action)\n\n          if (nx, ny) not in visited:\n            queue.append((nx, ny, new_dir, new_path))\n            visited.add((nx, ny))\n\n    return []\n\n  def use_tool_if_needed(primitive_index):\n      # Check if there are any obstacles and if we have tools to handle them\n      from collections import deque\n\n      grid = env._current_state.grid\n      pos = env._current_state.pos\n      dir_ = env._current_state.dir\n      width, height, _ = grid.shape\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n\n      queue = deque([(pos[0], pos[1], dir_, [])])\n      visited = set()\n      visited.add((pos[0], pos[1]))\n\n      while queue:\n          x, y, current_dir, path = queue.popleft()\n\n          for i, (dx, dy) in enumerate(directions):\n              nx, ny = x + dx, y + dy\n\n              if 0 <= nx < width and 0 <= ny < height:\n                  obstacle_index = np.argmax(grid[nx, ny])\n                  if obstacle_index == env.world.cookbook.index.index('WATER') and 'BRIDGE' in env._current_state.inventory:\n                      # Use bridge to cross water\n                      new_path = path.copy()\n                      new_path.extend([4])  # USE action to place a bridge\n                      return new_path\n                  elif obstacle_index == env.world.cookbook.index.index('ROCK') and 'PICKAXE' in env._current_state.inventory:\n                      # Use pickaxe to mine rock\n                      new_path = path.copy()\n                      new_path.extend([4])  # USE action to use the pickaxe\n                      return new_path\n\n                  new_dir = i\n                  new_path = path.copy()\n\n                  # Turn to the correct direction\n                  turn_action = (new_dir - current_dir) % 4\n                  if turn_action == 1:\n                      new_path.append(3)  # RIGHT\n                  elif turn_action == 2:\n                      new_path.extend([3, 3])  # RIGHT twice (180 degrees)\n                  elif turn_action == 3:\n                      new_path.append(2)  # LEFT\n\n                  # Move forward\n                  new_path.append(0)  # DOWN (assuming DOWN is the move action)\n\n                  if (nx, ny) not in visited:\n                      queue.append((nx, ny, new_dir, new_path))\n                      visited.add((nx, ny))\n\n      return []\n\n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # First, try to use tools if needed\n  tool_actions = use_tool_if_needed(primitive_index)\n  if tool_actions:\n      return tool_actions\n\n  # If no tools are needed, find the path to the primitive\n  actions = find_path_to_primitive(primitive_index)\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-09T03:55:05.772032", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Define directions as actions\n  actions = {\n      \"UP\": 4,    # Assuming USE is action index 4 for picking up items\n      \"DOWN\": 0,\n      \"LEFT\": 2,\n      \"RIGHT\": 3\n  }\n\n  # Mapping from action to position change\n  action_to_pos_change = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1)\n  }\n\n  # Get the index of the primitive in the world's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Define a queue for BFS and set to track visited positions\n  queue = collections.deque([(pos[0], pos[1], [])])  # (x, y, path)\n  visited = set()\n  visited.add(pos)\n\n  def is_valid(x, y):\n      \"\"\"Check if the position (x, y) is valid on the grid.\"\"\"\n      return 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]\n\n  # Perform BFS to find the shortest path to the primitive\n  while queue:\n      x, y, path = queue.popleft()\n\n      # Check if we have found the primitive at this position\n      if grid[x, y, primitive_index] > 0:\n          return [actions[a] for a in path + [\"UP\"]]  # Add \"UP\" to pick up the item\n\n      # Explore neighbors\n      for direction, (dx, dy) in action_to_pos_change.items():\n          nx, ny = x + dx, y + dy\n\n          if is_valid(nx, ny):\n              new_path = path + [direction]\n              if (nx, ny) not in visited:\n                  queue.append((nx, ny, new_path))\n                  visited.add((nx, ny))\n\n  # If the primitive is unreachable or not found, return an empty list\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-09T03:55:06.752464", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid.copy()\n  pos = current_state.pos\n  inventory = current_state.inventory.copy()\n\n  # Define directions as actions\n  actions = {\n      \"UP\": 1,\n      \"DOWN\": 0,\n      \"LEFT\": 2,\n      \"RIGHT\": 3\n  }\n\n  # Mapping from action to position change\n  action_to_pos_change = {\n      \"UP\": (-1, 0),\n      \"DOWN\": (1, 0),\n      \"LEFT\": (0, -1),\n      \"RIGHT\": (0, 1)\n  }\n\n  # Get the index of the primitive in the world's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Define a queue for BFS and set to track visited positions\n  queue = collections.deque([(pos[0], pos[1], [])])  # (x, y, path)\n  visited = set()\n  visited.add(pos)\n\n  def is_valid(x, y):\n      \"\"\"Check if the position (x, y) is valid on the grid.\"\"\"\n      return 0 <= x < grid.shape[0] and 0 <= y < grid.shape[1]\n\n  # Perform BFS to find the shortest path to the primitive\n  while queue:\n      x, y, path = queue.popleft()\n\n      # Check if we have found the primitive at this position\n      if grid[x, y, primitive_index] > 0:\n          return [actions[a] for a in path]\n\n      # Explore neighbors\n      for direction, (dx, dy) in action_to_pos_change.items():\n          nx, ny = x + dx, y + dy\n\n          if is_valid(nx, ny):\n              new_path = path + [direction]\n              if (nx, ny) not in visited:\n                  queue.append((nx, ny, new_path))\n                  visited.add((nx, ny))\n\n  # If the primitive is unreachable or not found, return an empty list\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-09T03:55:58.033560", "function_name": "collect", "function_body": "  def in_bounds(pos):\n    x, y = pos\n    width, height = current_state.grid.shape[:2]\n    return 0 <= x < width and 0 <= y < height\n\n  def bfs(start, target):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if current_state.grid[x, y].argmax() == target:\n        return path\n      for direction, (dx, dy) in DIRECTIONS:\n          next_pos = (x + dx, y + dy)\n          if in_bounds(next_pos) and next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path + [direction]))\n\n    return None\n\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  DIRECTIONS = [(DOWN, (0, 1)), (UP, (0, -1)), (LEFT, (-1, 0)), (RIGHT, (1, 0))]\n\n  current_state = env._current_state\n  primitive_index = current_state.world.cookbook.index[primitive]\n  path_to_primitive = bfs(current_state.pos, primitive_index)\n\n  if not path_to_primitive:\n    return []\n\n  actions = []\n  for direction in path_to_primitive[:-1]:\n      actions.append(direction)\n      actions.append(USE)  # Assume we can use the item once we reach it\n\n  # Append the final move without using the item\n  actions.append(path_to_primitive[-1])\n\n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-09T03:55:59.080342", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Constants for directions\n  DIRECTIONS = [(DOWN, (0, 1)), (UP, (0, -1)), (LEFT, (-1, 0)), (RIGHT, (1, 0))]\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define a function to check if a position is within bounds\n  def in_bounds(pos):\n    x, y = pos\n    return 0 <= x < current_state.grid.shape[0] and 0 <= y < current_state.grid.shape[1]\n\n  # Define a function to find the shortest path using BFS\n  def bfs(start, target):\n    queue = collections.deque([(start, [])])\n    visited = set([start])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if current_state.grid[x, y].argmax() == target:\n        return path\n\n      for direction, (dx, dy) in DIRECTIONS:\n          next_pos = (x + dx, y + dy)\n          if in_bounds(next_pos) and next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, path + [direction]))\n\n    return None\n\n  # Find the index of the target primitive\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Perform BFS to find the shortest path to the target primitive\n  path_to_primitive = bfs(current_state.pos, primitive_index)\n\n  if not path_to_primitive:\n      return []\n\n  actions = []\n  for direction in path_to_primitive[:-1]:\n      actions.append(direction)\n      actions.append(USE)  # Assume we can use the item once we reach it\n\n  # Append the final move without using the item\n  actions.append(path_to_primitive[-1])\n\n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-08-09T03:57:11.895378", "function_name": "collect", "function_body": "  def is_walkable(grid, x, y, inventory):\n    current_index = grid[x, y].argmax()\n    \n    if current_index == i_primitive:\n      return True\n    \n    # Check for obstacles and tools needed\n    if env.world.water_index == current_index:\n      return 'BRIDGE' in inventory.values()\n    elif env.world.stone_index == current_index:\n      return 'PICKAXE' in inventory.values() or 'HAMMER' in inventory.values()\n    \n    # Default to walkable if no specific checks are defined\n    return True\n\n  actions = []\n  i_primitive = env.world.cookbook.index.index(primitive)\n\n  # Check if the agent is already next to the primitive\n  if env._current_state.next_to(i_primitive):\n    actions.append(4)  # USE action to collect the primitive\n    return actions\n\n  # Define a helper function for BFS to find the shortest path with tool usage consideration\n  def bfs_shortest_path_with_tools(grid, start_pos, target_index, inventory):\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    \n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_index:  # Check if the current cell contains the primitive\n        return path\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n          if is_walkable(grid, nx, ny, inventory):\n            visited.add((nx, ny))\n            queue.append(((nx, ny), path + [(dx, dy)]))\n    \n    return None\n\n  # Get the current state\n  start_pos = env._current_state.pos\n  grid = env._current_state.grid\n  inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  # Find the shortest path to reach a cell containing the primitive\n  path = bfs_shortest_path_with_tools(grid, start_pos, i_primitive, inventory)\n\n  if path is not None:\n    directions_to_actions = {(-1, 0): 2, (1, 0): 3, (0, -1): 1, (0, 1): 0}\n    \n    for dx, dy in path:\n      actions.append(directions_to_actions[(dx, dy)])\n      \n    actions.append(4)  # USE action to collect the primitive\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-09T03:57:12.856381", "function_name": "collect", "function_body": "  def is_walkable(grid, x, y, inventory):\n    current_index = grid[x, y].argmax()\n    \n    if current_index == i_primitive:\n      return True\n    \n    # Check for obstacles and tools needed\n    if env.world.water_index == current_index:\n      return 'BRIDGE' in inventory\n    elif env.world.stone_index == current_index:\n      return 'PICKAXE' in inventory or 'HAMMER' in inventory\n    \n    # Default to walkable if no specific checks are defined\n    return True\n\n  def bfs_shortest_path_with_tools(grid, start_pos, target_index, inventory):\n    queue = collections.deque([(start_pos, [])])\n    visited = set()\n    \n    while queue:\n      (x, y), path = queue.popleft()\n      \n      if grid[x, y].argmax() == target_index:  # Check if the current cell contains the primitive\n        return path\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n          if is_walkable(grid, nx, ny, inventory):\n            visited.add((nx, ny))\n            queue.append(((nx, ny), path + [(dx, dy)]))\n    \n    return None\n\n  actions = []\n  i_primitive = env.world.cookbook.index.index(primitive)\n\n  # Check if the agent is already next to the primitive\n  if env._current_state.next_to(i_primitive):\n    actions.append(4)  # USE action to collect the primitive\n    return actions\n\n  start_pos = env._current_state.pos\n  grid = env._current_state.grid\n  \n  inventory = {env.world.cookbook.index.get(i): count for i, count in enumerate(env._current_state.inventory) if count > 0}\n\n  path = bfs_shortest_path_with_tools(grid, start_pos, i_primitive, inventory)\n\n  if path is not None:\n    directions_to_actions = {(-1, 0): 2, (1, 0): 3, (0, -1): 1, (0, 1): 0}\n    \n    for dx, dy in path:\n      actions.append(directions_to_actions[(dx, dy)])\n      \n    actions.append(4)  # USE action to collect the primitive\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
