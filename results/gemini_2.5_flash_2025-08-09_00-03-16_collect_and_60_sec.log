{"timestamp": "2025-08-09T16:27:05.167009", "function_name": "collect", "function_body": "  item_idx = env.world.cookbook.index[primitive]\n  actions = []\n  current_state = env._current_state\n  UP, DOWN, LEFT, RIGHT = 1, 0, 2, 3\n\n  def get_neighbors(pos):\n    x, y = pos\n    return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def is_valid_position(pos):\n    x, y = pos\n    return 0 <= x < current_state.grid.shape[0] and 0 <= y < current_state.grid.shape[1]\n  \n  # Improved BFS with tool usage logic integrated\n  def bfs_find_primitive(start_pos, item_idx):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      x, y = pos\n\n      if current_state.grid[x, y, item_idx] > 0:\n        return path + [craft.USE]\n\n      for neighbor in get_neighbors(pos):\n        nx, ny = neighbor\n        if is_valid_position((nx, ny)) and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          action = RIGHT if nx == x + 1 else LEFT if nx == x - 1 else DOWN if ny == y - 1 else UP\n          path_with_action = path + [action]\n          \n          # Check and use tools before moving to the next cell\n          for tool_idx in current_state.inventory.nonzero()[0]:\n            tool_name = env.world.cookbook.index.get(tool_idx)\n            if can_use_tool_here(tool_name, (nx, ny)):\n              actions.append(craft.USE)  # Use the tool at the current position\n              path_with_action += [action]  # Repeat the action to move after using the tool\n\n          queue.append(((nx, ny), path_with_action))\n\n    return None\n\n  def can_use_tool_here(tool_name, pos):\n    x, y = pos\n    if tool_name == \"BRIDGE\" and current_state.grid[x, y, env.world.cookbook.index[\"WATER\"]] > 0:\n      return True\n    elif tool_name == \"PICKAXE\" and current_state.grid[x, y, env.world.cookbook.index[\"GEM\"]] > 0:\n      return True\n    # Add more conditions for other tools as needed\n    return False\n\n  start_pos = current_state.pos\n  path_to_primitive = bfs_find_primitive(start_pos, item_idx)\n\n  if path_to_primitive is not None:\n    actions.extend(path_to_primitive)\n  else:\n    print(f\"No path found to collect {primitive}.\")\n\n  return actions", "island_id": 5, "scores": {"3": 1.0}}
