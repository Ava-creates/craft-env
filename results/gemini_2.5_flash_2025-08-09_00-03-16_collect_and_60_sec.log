] > 0:\n                                  actions.append(env.action_specs()['USE'])  # Place BRIDGE\n                              else:\n                                  return None\n\n                          if grid[new_x, new_y, env.world.cookbook.index['ROCK']] > 0:\n                              if env._current_state.inventory[env.world.cookbook.index['PICKAXE']] > 0:\n                                  actions.append(env.action_specs()['USE'])  # Mine ROCK\n                              else:\n                                  return None\n\n                          current_pos = new_pos\n                      break\n      return actions\n\n  def construct_bridge():\n      grid = env._current_state.grid\n      width, height, _ = grid.shape\n      for x in range(width):\n          for y in range(height):\n              if grid[x, y, env.world.cookbook.index['WATER']] > 0:\n                  # Calculate path to water and place bridge\n                  path_to_water = find_path_to_primitive(env.world.cookbook.index['WATER'])\n                  if path_to_water:\n                      actions = []\n                      for direction in path_to_water:\n                          action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n                          actions.append(action_index)\n                      # Place bridge\n                      actions.append(env.action_specs()['USE'])\n                      return actions\n      return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n  path_to_primitive = find_path_to_primitive(primitive_index)\n\n  if not path_to_primitive:\n      return []\n\n  actions = []\n  for direction in path_to_primitive:\n      action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n      actions.append(action_index)\n\n  # Check if the agent can collect the primitive\n  if env._current_state.next_to(primitive_index):\n      actions.append(4)  # USE action\n\n  return actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-09T11:20:14.315679", "function_name": "collect", "function_body": "  def find_path(start_pos, target_index):\n    grid = env._current_state.grid\n    width, height, _ = grid.shape\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    # Define movement directions: RIGHT, DOWN, LEFT, UP\n    directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n    while queue:\n        current_pos, path = queue.popleft()\n        if grid[current_pos[0], current_pos[1], target_index] > 0:\n            return path\n        \n        for direction in directions:\n            new_x = current_pos[0] + direction[0]\n            new_y = current_pos[1] + direction[1]\n            new_pos = (new_x, new_y)\n            \n            if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                visited.add(new_pos)\n                queue.append((new_pos, path + [direction]))\n\n    return None\n\n  def handle_obstacles(path_to_primitive):\n    grid = env._current_state.grid\n    current_pos = env._current_state.pos\n    actions = []\n    width, height, _ = grid.shape\n\n    for direction in path_to_primitive:\n        new_x = current_pos[0] + direction[0]\n        new_y = current_pos[1] + direction[1]\n\n        if 0 <= new_x < width and 0 <= new_y < height:\n            # Check obstacles and use tools\n            if grid[new_x, new_y, env.world.cookbook.index['WATER']] > 0:\n                if env._current_state.inventory[env.world.cookbook.index['BRIDGE']] > 0:\n                    actions.append(env.action_specs()['USE'])  # Place BRIDGE\n                else:\n                    return None\n\n            if grid[new_x, new_y, env.world.cookbook.index['ROCK']] > 0:\n                if env._current_state.inventory[env.world.cookbook.index['PICKAXE']] > 0:\n                    actions.append(env.action_specs()['USE'])  # Mine ROCK\n                else:\n                    return None\n\n            current_pos = (new_x, new_y)\n            action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n            actions.append(action_index)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n  path_to_primitive = find_path(env._current_state.pos, primitive_index)\n  \n  if not path_to_primitive:\n      return []\n\n  actions = handle_obstacles(path_to_primitive)\n\n  # Check if the agent can collect the primitive\n  if env._current_state.next_to(primitive_index):\n      actions.append(4)  # USE action\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-09T11:21:41.279267", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index):\n      grid = env._current_state.grid\n      start_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      # Define movement directions: RIGHT, DOWN, LEFT, UP\n      directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n              return path\n          \n          for direction in directions:\n              new_x = current_pos[0] + direction[0]\n              new_y = current_pos[1] + direction[1]\n              new_pos = (new_x, new_y)\n              \n              if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [direction]))\n\n      return None\n\n  def use_tool_if_needed(primitive_index):\n      # Check if there are any obstacles in the way that require tool usage,\n      # and if so, determine the appropriate tool to use based on the agent's inventory.\n      current_inventory = env._current_state.inventory\n      tools_required = {\n          \"WATER\": (\"BRIDGE\",),\n          \"ROCK\": (\"PICKAXE\",)\n      }\n      \n      for obstacle, required_tools in tools_required.items():\n          obstacle_index = env.world.cookbook.index[obstacle]\n          if grid[start_pos[0], start_pos[1], obstacle_index] > 0:\n              for tool in required_tools:\n                  tool_index = env.world.cookbook.index[tool]\n                  if current_inventory[tool_index] > 0:\n                      return {\"action\": \"USE\", \"index\": tool_index}\n      return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n  path_to_primitive = find_path_to_primitive(primitive_index)\n\n  actions = []\n  if path_to_primitive is not None:\n      for direction in path_to_primitive:\n          # Convert direction tuple to action index (RIGHT=0, DOWN=1, LEFT=2, UP=3)\n          action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n          actions.append(action_index)\n\n      # Check if any tool usage is needed before collecting the primitive\n      tool_action = use_tool_if_needed(primitive_index)\n      if tool_action:\n          actions.append(tool_action[\"index\"])  # Use the appropriate tool\n\n      # Add action to collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-09T11:21:42.243105", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index):\n      grid = env._current_state.grid\n      start_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      # Define movement directions: RIGHT, DOWN, LEFT, UP\n      directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n              return path\n          \n          for direction in directions:\n              new_x = current_pos[0] + direction[0]\n              new_y = current_pos[1] + direction[1]\n              new_pos = (new_x, new_y)\n              \n              if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [direction]))\n\n      return None\n\n  def use_tool_if_needed(primitive_index):\n      # Identify obstacles that need tools\n      grid = env._current_state.grid\n      start_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      inventory = env._current_state.inventory\n      \n      # Check for water obstacles\n      if primitive_index == env.world.cookbook.index[\"GOLD\"]:\n          water_index = env.world.cookbook.index[\"WATER\"]\n          bridge_index = env.world.cookbook.index[\"BRIDGE\"]\n          \n          if grid[start_pos[0], start_pos[1], water_index] > 0 and inventory.get(bridge_index, 0) > 0:\n              return [craft.BRIDGE]\n      \n      # Check for rock obstacles\n      if primitive_index == env.world.cookbook.index[\"GEM\"]:\n          rock_index = env.world.cookbook.index[\"ROCK\"]\n          pickaxe_index = env.world.cookbook.index[\"PICKAXE\"]\n          \n          if grid[start_pos[0], start_pos[1], rock_index] > 0 and inventory.get(pickaxe_index, 0) > 0:\n              return [craft.PICKAXE]\n      \n      return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n  path_to_primitive = find_path_to_primitive(primitive_index)\n\n  actions = []\n  if path_to_primitive is not None:\n      for direction in path_to_primitive:\n          # Convert direction tuple to action index (RIGHT=0, DOWN=1, LEFT=2, UP=3)\n          action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n          actions.append(action_index)\n\n      # Check if there are any obstacles that need tools\n      tool_actions = use_tool_if_needed(primitive_index)\n      if tool_actions:\n          for tool_action in tool_actions:\n              # Convert tool action to appropriate index (e.g., BRIDGE=5, PICKAXE=6)\n              actions.append(tool_action)\n\n      # Add action to collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-09T11:23:21.092902", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n      for tool in tools_for_primitive.get(primitive_index, []):\n          if inventory[env.world.cookbook.index[tool]] > 0:\n              actions.append(craft.CRAFT_FUNC(env.world.cookbook.index[tool]))\n              actions.append(craft.USE)\n              break\n\n    return actions\n\n  # Get the index of the primitive to collect\n  primitive_index = env.world.cookbook.index.get(primitive, None)\n\n  if primitive_index is None:\n      raise ValueError(f\"Primitive {primitive} not found in cookbook.\")\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # Define tools required for certain primitives\n  tools_for_primitive = {\n      env.world.cookbook.index.get('WATER', -1): ['BRIDGE'],\n      env.world.cookbook.index.get('GEM', -1): ['PICKAXE']\n  }\n\n  actions = []\n\n  # Find all positions of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = tuple(env._current_state.pos)\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions.extend(use_tool_if_needed(path, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
