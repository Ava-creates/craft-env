th_to_primitive)\n  \n  # Check for any obstacles that might require tool usage.\n  def requires_tool(primitive_index):\n      return (world.water_index == primitive_index and current_state.inventory[world.cookbook.index['BRIDGE']] > 0) or\\\n             (primitive_index in world.stone_index and current_state.inventory[world.cookbook.index['PICKAXE']] > 0)\n\n  # Add actions to use the required tool if needed.\n  if requires_tool(primitive_index):\n      actions_to_take.append(craft.USE)\n  \n  # Collect the primitive.\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-09T03:50:18.622524", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n\n  # Retrieve the index for the specified primitive.\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the sequence of actions.\n  actions_to_take = []\n\n  # Check if the agent is already holding the primitive.\n  if current_state.inventory[primitive_index] > 0:\n    return actions_to_take\n\n  # Function to find the nearest instance of a given item in the environment grid.\n  def find_nearest_item(grid, item_index):\n      rows, cols = grid.shape[:2]\n      queue = collections.deque([(current_state.pos, [])])  # (position, path)\n      visited = set([current_state.pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          x, y = pos\n\n          if grid[x, y, item_index] > 0:  # Check if the item is found at this position\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < rows and 0 <= ny < cols and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [move_to(dx, dy)]))\n\n      return None  # If no path is found\n\n  # Function to determine the movement action required to move from one cell to an adjacent cell.\n  def move_to(dx, dy):\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.UP\n      elif dx == 0 and dy == 1:\n          return craft.DOWN\n\n  # Function to check if a path to the primitive exists considering tools in inventory.\n  def find_path_with_tools(grid, item_index):\n      rows, cols = grid.shape[:2]\n      queue = collections.deque([(current_state.pos, [])])  # (position, path)\n      visited = set([current_state.pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          x, y = pos\n\n          if grid[x, y, item_index] > 0:  # Check if the item is found at this position\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < rows and 0 <= ny < cols and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  \n                  # Check if there's an obstacle that can be removed with a tool.\n                  obstacle_index = None\n                  for oindex in world.cookbook.primitives:  # Assuming primitives contains all potential obstacles.\n                      if grid[nx, ny, oindex] > 0 and has_tool_to_remove_obstacle(world.cookbook.index[oindex]):\n                          obstacle_index = oindex\n                          break\n\n                  if obstacle_index is not None:\n                      path_with_tool = path + [move_to(dx, dy), craft.USE]\n                      new_path = find_path_with_tools(grid, item_index)  # Recursively find the next step.\n                      if new_path is not None:\n                          return path_with_tool + new_path\n                  else:\n                      queue.append(((nx, ny), path + [move_to(dx, dy)]))\n\n      return None  # If no path is found\n\n  # Function to check if the agent has a tool that can remove an obstacle.\n  def has_tool_to_remove_obstacle(obstacle_index):\n      required_tools = {\n          world.cookbook.index['STONE']: ['PICKAXE'],  # Assuming PICKAXE is needed for STONE\n          world.cookbook.index['GEM']: ['PICKAXE'],    # Assuming PICKAXE is needed for GEM\n          world.cookbook.index['WATER']: ['BRIDGE']     # Assuming BRIDGE is needed for WATER\n      }\n      \n      tool_indices = [world.cookbook.index[tool] for tool in required_tools.get(obstacle_index, [])]\n      return any(current_state.inventory[tool_index] > 0 for tool_index in tool_indices)\n\n  # Find the nearest instance of the specified primitive considering tools in inventory.\n  path_to_primitive = find_path_with_tools(current_state.grid, primitive_index)\n\n  if path_to_primitive is None:\n      raise ValueError(f\"No reachable {primitive} found in the environment.\")\n\n  actions_to_take.extend(path_to_primitive)\n  \n  # Collect the primitive.\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-09T03:50:19.582443", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n\n  # Retrieve the index for the specified primitive.\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the sequence of actions.\n  actions_to_take = []\n\n  # Check if the agent is already holding the primitive.\n  if current_state.inventory[primitive_index] > 0:\n    return actions_to_take\n\n  # Function to find the nearest instance of a given item in the environment grid.\n  def find_nearest_item(grid, item_index):\n      rows, cols = grid.shape[:2]\n      queue = collections.deque([(current_state.pos, [])])  # (position, path)\n      visited = set([current_state.pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          x, y = pos\n\n          if grid[x, y, item_index] > 0:  # Check if the item is found at this position\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < rows and 0 <= ny < cols and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [move_to(dx, dy)]))\n\n      return None  # If no path is found\n\n  # Function to determine the movement action required to move from one cell to an adjacent cell.\n  def move_to(dx, dy):\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.UP\n      elif dx == 0 and dy == 1:\n          return craft.DOWN\n\n  # Function to check if a path to the primitive exists considering tools in inventory.\n  def find_path_with_tools(grid, item_index):\n      rows, cols = grid.shape[:2]\n      queue = collections.deque([(current_state.pos, [])])  # (position, path)\n      visited = set([current_state.pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          x, y = pos\n\n          if grid[x, y, item_index] > 0:  # Check if the item is found at this position\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < rows and 0 <= ny < cols and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  \n                  # Check if there's an obstacle that can be removed with a tool.\n                  obstacle_index = None\n                  for oindex in world.cookbook.primitives:  # Assuming primitives contains all potential obstacles.\n                      if grid[nx, ny, oindex] > 0 and has_tool_to_remove_obstacle(oindex):\n                          obstacle_index = oindex\n                          break\n\n                  if obstacle_index is not None:\n                      path_with_tool = path + [move_to(dx, dy), craft.USE]\n                      new_path = find_path_with_tools(grid, item_index)  # Recursively find the next step.\n                      if new_path is not None:\n                          return path_with_tool + new_path\n                  else:\n                      queue.append(((nx, ny), path + [move_to(dx, dy)]))\n\n      return None  # If no path is found\n\n  # Function to check if the agent has a tool that can remove an obstacle.\n  def has_tool_to_remove_obstacle(obstacle_index):\n      # This function should be implemented based on game rules and tools' capabilities.\n      # For example, checking if there's a PICKAXE in inventory for GEM or WOOD.\n      tool_for_obstacle = {\n          world.cookbook.index['GEM']: 'PICKAXE',\n          world.cookbook.index['WOOD']: 'AXE'\n      }\n      \n      obstacle_name = world.cookbook.index[obstacle_index]\n      if obstacle_name in tool_for_obstacle:\n          tool_name = tool_for_obstacle[obstacle_name]\n          tool_index = world.cookbook.index[tool_name]\n          return current_state.inventory[tool_index] > 0\n      return False\n\n  # Find the nearest instance of the specified primitive considering tools in inventory.\n  path_to_primitive = find_path_with_tools(current_state.grid, primitive_index)\n\n  if path_to_primitive is None:\n      raise ValueError(f\"No reachable {primitive} found in the environment.\")\n\n  actions_to_take.extend(path_to_primitive)\n  \n  # Collect the primitive.\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-09T03:52:24.886006", "function_name": "collect", "function_body": "  def find_nearest_primitive(primitive_name):\n    grid = env._current_state.grid\n    width, height, _ = grid.shape\n\n    primitive_index = env.world.cookbook.index[primitive_name]\n\n    min_distance = float('inf')\n    target_pos = None\n    for x in range(width):\n      for y in range(height):\n        if np.any(grid[x, y] == primitive_index):\n          distance = abs(env._current_state.pos[0] - x) + abs(env._current_state.pos[1] - y)\n          if distance < min_distance:\n            min_distance = distance\n            target_pos = (x, y)\n\n    return target_pos\n\n  def compute_shortest_path_to_target(start_pos, target_pos):\n    from queue import Queue\n\n    grid = env._current_state.grid\n    width, height, _ = grid.shape\n\n    # Directions: right, down, left, up\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n\n    q = Queue()\n    q.put((start_pos, []))\n    visited = set([start_pos])\n\n    while not q.empty():\n      current_pos, path = q.get()\n\n      if current_pos == target_pos:\n        return path\n\n      for dx, dy in directions:\n        new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n        if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n          # Check if the cell is traversable.\n          if env._current_state.next_to_obstacle(new_x, new_y):\n            continue\n\n          visited.add((new_x, new_y))\n          q.put(((new_x, new_y), path + [(dx, dy)]))\n\n    return []\n\n  def follow_path(path):\n      actions = []\n      current_dir = env._current_state.dir\n      direction_map = {(0, 1): 'RIGHT', (1, 0): 'DOWN', (0, -1): 'LEFT', (-1, 0): 'UP'}\n      \n      for dx, dy in path:\n          target_dir = direction_map[(dx, dy)]\n          \n          # Convert the target direction to action indices based on current direction.\n          actions.extend(rotate_to_direction(current_dir, direction_map[(dx, dy)]))\n          current_dir = {'RIGHT': 0, 'DOWN': 1, 'LEFT': 2, 'UP': 3}[target_dir]\n          actions.append(env.world.USE)  # Action to move or use item at current position\n      \n      return actions\n\n  def rotate_to_direction(current_dir, target_dir):\n    actions = []\n    # Define the mapping from current direction to action indices for turning.\n    rotation_map = {\n        (0, 'RIGHT'): [env.world.RIGHT],       # Right from Up\n        (0, 'DOWN'): [env.world.DOWN],         # Down from Up\n        (0, 'LEFT'): [env.world.LEFT],         # Left from Up\n        (1, 'UP'): [env.world.UP],             # Up from Right\n        (1, 'RIGHT'): [env.world.RIGHT],       # Right from Right\n        (1, 'DOWN'): [env.world.DOWN],         # Down from Right\n        (2, 'UP'): [env.world.UP],             # Up from Down\n        (2, 'RIGHT'): [env.world.RIGHT],       # Right from Down\n        (2, 'LEFT'): [env.world.LEFT],         # Left from Down\n        (3, 'DOWN'): [env.world.DOWN],         # Down from Left\n        (3, 'RIGHT'): [env.world.RIGHT],       # Right from Left\n        (3, 'LEFT'): [env.world.LEFT],         # Left from Left\n    }\n\n    key = (current_dir, target_dir)\n    return rotation_map.get(key, [])\n\n  def is_primitive_reachable(primitive_name):\n    target_pos = find_nearest_primitive(primitive_name)\n    if not target_pos:\n        return False\n    \n    path = compute_shortest_path_to_target(env._current_state.pos, target_pos)\n    return len(path) > 0\n\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # If the agent already has the primitive, no need to collect it\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n  \n  # Check if the nearest primitive is reachable\n  if not is_primitive_reachable(primitive):\n      return []\n\n  # Find the nearest occurrence of the primitive\n  target_pos = find_nearest_primitive(primitive)\n  \n  # Compute the shortest path to the nearest primitive\n  path_to_target = compute_shortest_path_to_target(env._current_state.pos, target_pos)\n\n  # Convert the path into a sequence of actions for the agent\n  action_sequence = follow_path(path_to_target)\n  \n  return action_sequence", "island_id": 7, "scores": {"3": 0.0}}
