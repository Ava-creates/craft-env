    action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n          actions.append(action_index)\n\n      # Add action to collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # USE action\n\n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-08-09T11:17:20.516754", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index):\n      grid = env._current_state.grid\n      start_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      # Define movement directions: RIGHT, DOWN, LEFT, UP\n      directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n              return path\n          \n          for direction in directions:\n              new_x = current_pos[0] + direction[0]\n              new_y = current_pos[1] + direction[1]\n              new_pos = (new_x, new_y)\n              \n              if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [direction]))\n\n      return None\n\n  def use_tool_if_needed(primitive_index):\n      grid = env._current_state.grid\n      current_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      actions = []\n\n      for x in range(width):\n          for y in range(height):\n              if (x != current_pos[0] or y != current_pos[1]) and (\n                  grid[x, y, primitive_index] > 0\n              ):\n                  path_to_primitive = find_path_to_primitive(primitive_index)\n                  if path_to_primitive:\n                      for direction in path_to_primitive:\n                          new_x = current_pos[0] + direction[0]\n                          new_y = current_pos[1] + direction[1]\n                          new_pos = (new_x, new_y)\n\n                          # Check obstacles and use tools\n                          if grid[new_x, new_y, env.world.cookbook.index['WATER']] > 0:\n                              if env._current_state.inventory[env.world.cookbook.index['BRIDGE']] > 0:\n                                  actions.append(env.action_specs()['USE'])  # Place BRIDGE\n                              else:\n                                  return None\n\n                          if grid[new_x, new_y, env.world.cookbook.index['ROCK']] > 0:\n                              if env._current_state.inventory[env.world.cookbook.index['PICKAXE']] > 0:\n                                  actions.append(env.action_specs()['USE'])  # Mine ROCK\n                              else:\n                                  return None\n\n                          current_pos = new_pos\n                      break\n      return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n  path_to_primitive = find_path_to_primitive(primitive_index)\n\n  if not path_to_primitive:\n      return []\n\n  actions = []\n  for direction in path_to_primitive:\n      action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n      actions.append(action_index)\n\n  # Check if the agent can collect the primitive\n  if env._current_state.next_to(primitive_index):\n      actions.append(4)  # USE action\n\n  return actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-08-09T11:17:21.481145", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index):\n    grid = env._current_state.grid\n    start_pos = env._current_state.pos\n    width, height, _ = grid.shape\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    # Define movement directions: RIGHT, DOWN, LEFT, UP\n    directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n    while queue:\n        current_pos, path = queue.popleft()\n        if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n            return path\n        for direction in directions:\n            new_x = current_pos[0] + direction[0]\n            new_y = current_pos[1] + direction[1]\n            new_pos = (new_x, new_y)\n            \n            if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                visited.add(new_pos)\n                queue.append((new_pos, path + [direction]))\n\n    return None\n\n  def use_tool_if_needed(primitive_index):\n      grid = env._current_state.grid\n      current_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      \n      actions = []\n      \n      # Use BFS to find a path to the primitive considering obstacles\n      queue = collections.deque([(current_pos, [])])\n      visited = set([current_pos])\n      directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n              return actions + path\n      \n          for direction in directions:\n              new_x = current_pos[0] + direction[0]\n              new_y = current_pos[1] + direction[1]\n              new_pos = (new_x, new_y)\n              \n              if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                  visited.add(new_pos)\n                  obstacle_actions = []\n                  \n                  # Check for obstacles and use tools\n                  if grid[new_x, new_y, env.world.cookbook.index['WATER']] > 0:\n                      if env._current_state.inventory[env.world.cookbook.index['BRIDGE']] > 0:\n                          obstacle_actions.append(env.action_specs()['USE'])  # Place BRIDGE\n                      else:\n                          return None\n                  elif grid[new_x, new_y, env.world.cookbook.index['ROCK']] > 0:\n                      if env._current_state.inventory[env.world.cookbook.index['PICKAXE']] > 0:\n                          obstacle_actions.append(env.action_specs()['USE'])  # Mine ROCK\n                      else:\n                          return None\n      \n                  queue.append((new_pos, path + [direction] + obstacle_actions))\n      \n      return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n  path_to_primitive = find_path_to_primitive(primitive_index)\n\n  if path_to_primitive is not None:\n    # Convert direction tuples to action indices (RIGHT=0, DOWN=1, LEFT=2, UP=3)\n    action_indices = {\n      \"(1, 0)\": env.action_specs()['MOVE_RIGHT'],\n      \"(0, 1)\": env.action_specs()['MOVE_DOWN'],\n      \"(-1, 0)\": env.action_specs()['MOVE_LEFT'],\n      \"(0, -1)\": env.action_specs()['MOVE_UP']\n    }\n    \n    actions = [action_indices[str(direction)] for direction in path_to_primitive]\n    \n    # Check if the agent can collect the primitive\n    if env._current_state.next_to(primitive_index):\n        actions.append(env.action_specs()['USE'])  # USE action\n\n    return actions\n\n  return None", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-09T11:18:36.755152", "function_name": "collect", "function_body": "  item_idx = env.world.cookbook.index[primitive]\n  \n  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define movement directions and corresponding actions\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 2, 3, 4\n  \n  def get_neighbors(pos):\n    x, y = pos\n    return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def is_valid_position(pos):\n    x, y = pos\n    return 0 <= x < current_state.grid.shape[0] and 0 <= y < current_state.grid.shape[1]\n  \n  # Function to perform a breadth-first search to find the shortest path to the target primitive\n  def bfs_find_primitive(start_pos, item_idx):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      x, y = pos\n\n      # Check if the current position contains the desired primitive\n      if current_state.grid[x, y, item_idx] > 0:\n        return path + [USE]  # Assume USE is the action to collect the item\n\n      # Explore neighbors\n      for neighbor in get_neighbors(pos):\n        nx, ny = neighbor\n        if is_valid_position((nx, ny)) and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          # Determine direction based on neighbor position\n          dx, dy = nx - x, ny - y\n          action = RIGHT if dx == 1 else LEFT if dx == -1 else DOWN if dy == -1 else UP\n          queue.append(((nx, ny), path + [action]))\n\n    return None\n\n  # Find the shortest path to the primitive\n  start_pos = current_state.pos\n  path_to_primitive = bfs_find_primitive(start_pos, item_idx)\n\n  if path_to_primitive is not None:\n    actions.extend(path_to_primitive)\n  else:\n    print(f\"No path found to collect {primitive}.\")\n\n  return actions", "island_id": 8, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T11:18:37.729196", "function_name": "collect", "function_body": "  item_idx = env.world.cookbook.index[primitive]\n  \n  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define movement directions and corresponding actions\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 2, 3, 4\n  \n  def get_neighbors(pos):\n    x, y = pos\n    return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  def is_valid_position(pos):\n    x, y = pos\n    return 0 <= x < current_state.grid.shape[0] and 0 <= y < current_state.grid.shape[1]\n  \n  # Function to perform a breadth-first search to find the shortest path to the target primitive\n  def bfs_find_primitive(start_pos, item_idx):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      x, y = pos\n\n      # Check if the current position contains the desired primitive\n      if current_state.grid[x, y, item_idx] > 0:\n        return path + [USE]  # Assume USE is the action to collect the item\n\n      # Explore neighbors\n      for neighbor in get_neighbors(pos):\n        nx, ny = neighbor\n        if is_valid_position((nx, ny)) and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          # Determine direction based on neighbor position\n          dx, dy = nx - x, ny - y\n          action = RIGHT if dx == 1 else LEFT if dx == -1 else DOWN if dy == -1 else UP\n          queue.append(((nx, ny), path + [action]))\n\n    return None\n\n  # Function to check if a tool is available in the inventory\n  def has_tool(tool_idx):\n    return current_state.grid[current_state.pos[0], current_state.pos[1], tool_idx] > 0\n\n  # Check for tools that might be needed and add actions to use them if necessary\n  bridge_needed = primitive == \"GOLD\" and env.world.cookbook.index[\"WATER\"] in current_state.pos\n  if bridge_needed:\n    # Assume BRIDGE index is known or can be retrieved\n    BRIDGE_INDEX = env.world.cookbook.index[\"BRIDGE\"]\n    if has_tool(BRIDGE_INDEX):\n      actions.append(USE)  # Use the BRIDGE to cross WATER\n\n  # Find the shortest path to the primitive\n  start_pos = current_state.pos\n  path_to_primitive = bfs_find_primitive(start_pos, item_idx)\n\n  if path_to_primitive is not None:\n    actions.extend(path_to_primitive)\n  else:\n    print(f\"No path found to collect {primitive}.\")\n\n  return actions", "island_id": 8, "scores": {"3": 1.0}}
