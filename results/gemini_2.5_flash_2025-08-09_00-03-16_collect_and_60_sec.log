        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n\n      # Use AXE to cut WOOD\n      if next_cell[env.world.cookbook.index['WOOD']] > 0 and inventory[env.world.cookbook.index['AXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['AXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  def can_use_tool(tool_index, target_cell):\n      \"\"\"Check if the tool can be used on the target cell.\"\"\"\n      # This is a placeholder. In practice, you would need to check compatibility.\n      return True\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = tuple(env._current_state.pos)\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-09T08:41:12.194686", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n\n      # Determine which tool to use based on the primitive and inventory\n      required_tool = determine_required_tool(next_cell_index, primitive_index)\n      if required_tool is not None and inventory[required_tool] > 0:\n        actions.append(craft.CRAFT_FUNC(required_tool))\n        actions.append(craft.USE)\n\n    return actions\n\n  def can_use_tool(tool_index, target_cell):\n      \"\"\"Check if the tool can be used on the target cell.\"\"\"\n      # This is a placeholder. In practice, you would need to check compatibility.\n      return True\n\n  def determine_required_tool(next_cell_index, primitive_index):\n      \"\"\"Determine which tool is required to interact with the next cell to collect the primitive.\"\"\"\n      # Placeholder logic:\n      if next_cell_index == env.world.cookbook.index['WATER']:\n          return env.world.cookbook.index.get('BRIDGE', None)\n      elif next_cell_index == env.world.cookbook.index['STONE']:\n          return env.world.cookbook.index.get('PICKAXE', None)\n      # Add more conditions as needed for other tools and cells\n      return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = tuple(env._current_state.pos)\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-09T08:43:00.256195", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index, tool_indices=None):\n      grid = env._current_state.grid\n      start_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      # Define movement directions: RIGHT, DOWN, LEFT, UP\n      directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n              return path\n          \n          for direction in directions:\n              new_x = current_pos[0] + direction[0]\n              new_y = current_pos[1] + direction[1]\n              new_pos = (new_x, new_y)\n              \n              if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                  # Check for obstacles that can be removed with tools\n                  obstacle_cleared = False\n                  if tool_indices is not None:\n                      for tool_index in tool_indices:\n                          if grid[new_pos[0], new_pos[1], tool_index] > 0:\n                              # Use the tool to clear the obstacle\n                              return path + [direction, 4]\n                          elif env._current_state.next_to(tool_index):\n                              # Move towards the tool and use it\n                              tool_path = find_path_to_tool(tool_index)\n                              if tool_path is not None:\n                                  return path + tool_path + [4] + [direction, 4]\n                      \n                      if not obstacle_cleared:\n                          visited.add(new_pos)\n                          queue.append((new_pos, path + [direction]))\n                  else:\n                      visited.add(new_pos)\n                      queue.append((new_pos, path + [direction]))\n\n      return None\n\n  def find_path_to_tool(tool_index):\n      grid = env._current_state.grid\n      start_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      # Define movement directions: RIGHT, DOWN, LEFT, UP\n      directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if grid[current_pos[0], current_pos[1], tool_index] > 0:\n              return path\n          \n          for direction in directions:\n              new_x = current_pos[0] + direction[0]\n              new_y = current_pos[1] + direction[1]\n              new_pos = (new_x, new_y)\n              \n              if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [direction]))\n\n      return None\n\n  def get_tool_indices():\n      inventory = env._current_state.inventory\n      tool_indices = []\n      for item_name in [\"BRIDGE\", \"PICKAXE\"]:\n          if item_name in env.world.cookbook.index:\n              tool_index = env.world.cookbook.index[item_name]\n              if inventory[tool_index] > 0:\n                  tool_indices.append(tool_index)\n      return tool_indices\n\n  primitive_index = env.world.cookbook.index[primitive]\n  tool_indices = get_tool_indices()\n  path_to_primitive = find_path_to_primitive(primitive_index, tool_indices)\n\n  actions = []\n  if path_to_primitive is not None:\n      for direction in path_to_primitive:\n          # Convert direction tuple to action index (RIGHT=0, DOWN=1, LEFT=2, UP=3)\n          action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n          actions.append(action_index)\n\n      # Add action to collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # USE action\n\n  return actions", "island_id": 7, "scores": {"3": 0.5}}
