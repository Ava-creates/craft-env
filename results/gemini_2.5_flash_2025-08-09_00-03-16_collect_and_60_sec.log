example, WATER might require a BRIDGE, ROCK might require a PICKAXE, etc.\n    if env.world.cookbook.index['WATER'] in cell:\n      return env.world.cookbook.index['BRIDGE']\n    elif env.world.cookbook.index['ROCK'] in cell:\n      return env.world.cookbook.index['PICKAXE']\n    # Add more mappings as needed\n    return None\n\n  def get_primitive_positions(primitive_index, grid):\n    return set(map(tuple, np.argwhere(grid[:, :, primitive_index] > 0)))\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = get_primitive_positions(primitive_index, grid)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, positions)\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T17:11:00.239449", "function_name": "collect", "function_body": "  item_idx = env.world.cookbook.index[primitive]\n  \n  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define movement directions and corresponding actions\n  UP, DOWN, LEFT, RIGHT = 1, 0, 2, 3\n  \n  # Function to get neighbors in the grid\n  def get_neighbors(pos):\n    x, y = pos\n    return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Function to check if a position is within the grid bounds and not blocked by obstacles\n  def is_valid_position(pos):\n    x, y = pos\n    return 0 <= x < current_state.grid.shape[0] and 0 <= y < current_state.grid.shape[1]\n  \n  # Function to perform a breadth-first search to find the shortest path to the target primitive\n  def bfs_find_primitive(start_pos, item_idx):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      x, y = pos\n\n      # Check if the current position contains the desired primitive\n      if current_state.grid[x, y, item_idx] > 0:\n        return path + [craft.USE]  # Assume USE is the action to collect the item\n\n      # Explore neighbors\n      for neighbor in get_neighbors(pos):\n        nx, ny = neighbor\n        if is_valid_position((nx, ny)) and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          # Determine direction based on neighbor position\n          dx, dy = nx - x, ny - y\n          action = RIGHT if dx == 1 else LEFT if dx == -1 else DOWN if dy == -1 else UP\n          queue.append(((nx, ny), path + [action]))\n\n    return None\n\n  # Function to check and use tools from inventory if needed\n  def use_tool_if_needed(pos):\n    x, y = pos\n    for tool_idx in current_state.inventory.nonzero()[0]:\n      tool_name = env.world.cookbook.index.get(tool_idx)\n      if can_use_tool_here(tool_name, pos):\n        actions.append(craft.USE)  # Assume USE is the action to use a tool\n\n  # Function to determine if a tool can be used at a specific position\n  def can_use_tool_here(tool_name, pos):\n    x, y = pos\n    # Define conditions for using tools (e.g., BRIDGE on WATER, PICKAXE on GEM)\n    return (tool_name == \"BRIDGE\" and current_state.grid[x, y, env.world.cookbook.index[\"WATER\"]] > 0) or\\\n           (tool_name == \"PICKAXE\" and current_state.grid[x, y, env.world.cookbook.index[\"GEM\"]] > 0)\n\n  # Function to check if the primitive is next to the current position\n  def is_primitive_next_to(pos, item_idx):\n    for neighbor in get_neighbors(pos):\n      nx, ny = neighbor\n      if is_valid_position((nx, ny)) and current_state.grid[nx, ny, item_idx] > 0:\n        return True\n    return False\n\n  # Function to place a bridge or pickaxe if needed before moving\n  def place_tool_if_needed(pos, next_pos):\n    x, y = pos\n    nx, ny = next_pos\n    tool_to_place = None\n    if current_state.grid[nx, ny, env.world.cookbook.index[\"WATER\"]] > 0 and current_state.inventory[env.world.cookbook.index[\"BRIDGE\"]] > 0:\n        tool_to_place = \"BRIDGE\"\n    elif current_state.grid[nx, ny, env.world.cookbook.index[\"GEM\"]] > 0 and current_state.inventory[env.world.cookbook.index[\"PICKAXE\"]] > 0:\n        tool_to_place = \"PICKAXE\"\n\n    if tool_to_place is not None:\n      actions.append(craft.CRAFT_FUNC(env.world.cookbook.index[tool_to_place]))\n      actions.append(craft.USE)\n      # Update the grid to reflect the placed tool\n      current_state.grid[nx, ny, env.world.cookbook.index[tool_to_place]] = 1\n\n  # Find the shortest path to the primitive\n  start_pos = current_state.pos\n  path_to_primitive = bfs_find_primitive(start_pos, item_idx)\n\n  if path_to_primitive is not None:\n    for i in range(len(path_to_primitive) - 1):\n      pos = current_state.pos\n      next_pos = (path_to_primitive[i + 1] // current_state.grid.shape[1], path_to_primitive[i + 1] % current_state.grid.shape[1])\n\n      # Place a bridge or pickaxe if needed before moving\n      place_tool_if_needed(pos, next_pos)\n\n      # Determine direction based on neighbor position\n      dx, dy = next_pos[0] - pos[0], next_pos[1] - pos[1]\n      action = RIGHT if dx == 1 else LEFT if dx == -1 else DOWN if dy == -1 else UP\n\n      actions.append(action)\n\n      # Check and use tools from inventory if needed\n      use_tool_if_needed(next_pos)\n      \n      # Update the current state after each move (assuming step function updates it)\n      env.step(action, num_steps=1)\n      \n      # Check if we have reached a position where the primitive is next to us\n      if is_primitive_next_to(current_state.pos, item_idx):\n        actions.append(path_to_primitive[-1])  # Move to collect the primitive\n        actions.append(craft.USE)  # Collect the primitive\n        break\n\n    else:\n      actions.append(path_to_primitive[-1])  # Move to collect the primitive\n      actions.append(craft.USE)  # Collect the primitive\n  else:\n    print(f\"No path found to collect {primitive}.\")\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-09T17:11:01.208801", "function_name": "collect", "function_body": "  def bfs_find_primitive(start_pos, item_idx):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      x, y = pos\n\n      # Check if the current position contains the desired primitive\n      if env._current_state.grid[x, y, item_idx] > 0:\n        return path\n\n      # Explore neighbors\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1]:\n          if (nx, ny) not in visited:\n            visited.add((nx, ny))\n            action = _get_action(dx, dy)\n            queue.append(((nx, ny), path + [action]))\n\n    return None\n\n  def _get_action(dx, dy):\n      \"\"\"Get the corresponding action index based on movement direction.\"\"\"\n      if dx == -1: return craft.LEFT\n      elif dx == 1: return craft.RIGHT\n      elif dy == -1: return craft.DOWN\n      elif dy == 1: return craft.UP\n\n  def use_tool_if_needed(pos, item_idx):\n    \"\"\"Use a tool from inventory if needed to cross or interact with the environment.\"\"\"\n    actions = []\n    \n    # Define conditions for using tools based on the current cell and primitive index\n    current_cell = env._current_state.grid[pos[0], pos[1]]\n    if current_cell[env.world.cookbook.index['WATER']] > 0 and env._current_state.inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n    elif current_cell[env.world.cookbook.index['GEM']] > 0 and env._current_state.inventory[env.world.cookbook.index['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n    \n    return actions\n\n  item_idx = env.world.cookbook.index[primitive]\n\n  if item_idx not in env.world.grabbable_indices:\n      raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the current state of the environment\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path_to_primitive = bfs_find_primitive(start_pos, item_idx)\n\n  if path_to_primitive is None:\n      raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  for action in path_to_primitive:\n      actions.extend(use_tool_if_needed(env._current_state.pos, item_idx))\n      actions.append(action)\n      # Update the current state after each move (assuming step function updates it)\n      env.step(action, num_steps=1)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-09T17:12:50.651654", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = env._current_state.grid[path[i + 1][0], path[i + 1][1]].nonzero()[0]\n\n      # Use BRIDGE to cross WATER\n      if primitive_index == env.world.cookbook.index['WATER'] and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  def check_and_use_tools(path, primitive_index):\n    grid = env._current_state.grid\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = env._current_state.grid[path[i + 1][0], path[i + 1][1]].nonzero()[0]\n\n      # Use BRIDGE to cross WATER\n      if grid[path[i + 1][0], path[i + 1][1], env.world.cookbook.index['WATER']] > 0 and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n\n      # Use PICKAXE to mine GEM\n      if grid[path[i + 1][0], path[i + 1][1], env.world.cookbook.index['GEM']] > 0 and inventory[env.world.cookbook.index['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n\n      # Use AXE to chop WOOD\n      if grid[path[i + 1][0], path[i + 1][1], env.world.cookbook.index['WOOD']] > 0 and inventory[env.world.cookbook.index['AXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['AXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = check_and_use_tools(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
