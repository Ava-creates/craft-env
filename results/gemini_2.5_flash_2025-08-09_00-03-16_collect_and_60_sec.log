ol_requirements = {\n      'BRIDGE': 'WATER',\n      'PICKAXE': 'ROCK',\n      'SCYTHE': 'GRASS'\n      # Add more tools and their respective requirements here\n  }\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 8, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T01:20:35.526740", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): start}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos != start:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        return path[::-1]\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = np.array(current_pos) + np.array([dx, dy])\n        if (0 <= neighbor_pos[0] < grid.shape[0] and\n            0 <= neighbor_pos[1] < grid.shape[1] and\n            tuple(neighbor_pos) not in visited):\n          queue.append(tuple(neighbor_pos))\n          parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if (dx, dy) not in directions:\n          continue\n\n      action = directions[(dx, dy)]\n      actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n      for i_kind in range(len(next_cell)):\n        if inventory[i_kind] > 0 and can_use_tool(primitive_index, i_kind):\n          actions.append(craft.CRAFT_FUNC(i_kind))\n          actions.append(craft.USE)\n\n    return actions\n\n  def can_use_tool(target_primitive, tool_primitive):\n    # This function should be defined to check compatibility between the target primitive and the tool\n    # For example, BRIDGE can be used on WATER, PICKAXE on GEM, etc.\n    # Placeholder logic:\n    if target_primitive == env.world.cookbook.index['WATER'] and tool_primitive == env.world.cookbook.index['BRIDGE']:\n      return True\n    if target_primitive == env.world.cookbook.index['GEM'] and tool_primitive == env.world.cookbook.index['PICKAXE']:\n      return True\n    # Add more conditions as needed\n    return False\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions.extend(use_tool_if_needed(path, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": 0.5}}
