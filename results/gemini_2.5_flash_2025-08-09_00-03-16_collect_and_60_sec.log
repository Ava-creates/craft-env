def get_tool_indices():\n      inventory = env._current_state.inventory\n      tool_indices = []\n      for item_name in [\"BRIDGE\", \"PICKAXE\"]:\n          if item_name in env.world.cookbook.index:\n              tool_index = env.world.cookbook.index[item_name]\n              if inventory[tool_index] > 0:\n                  tool_indices.append(tool_index)\n      return tool_indices\n\n  primitive_index = env.world.cookbook.index[primitive]\n  tool_indices = get_tool_indices()\n  path_to_primitive = find_path(env._current_state.pos, primitive_index, tool_indices)\n\n  actions = []\n  if path_to_primitive is not None:\n      for direction in path_to_primitive:\n          # Convert direction tuple to action index (RIGHT=0, DOWN=1, LEFT=2, UP=3)\n          action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n          actions.append(action_index)\n\n      # Add action to collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # USE action\n\n  return actions", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-08-09T09:14:17.083180", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index):\n      grid = env._current_state.grid\n      start_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      # Define movement directions: RIGHT, DOWN, LEFT, UP\n      directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n              return path\n          \n          for direction in directions:\n              new_x = current_pos[0] + direction[0]\n              new_y = current_pos[1] + direction[1]\n              new_pos = (new_x, new_y)\n              \n              if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                  # Check for obstacles like water or rock that require tool usage\n                  if grid[new_x, new_y, env.world.water_index] > 0 and \"BRIDGE\" in env._current_state.inventory:\n                      actions_to_use_tool = use_tool(new_pos, env.world.water_index, env.world.cookbook.index[\"BRIDGE\"])\n                      path.extend(actions_to_use_tool)\n                      visited.add(new_pos)\n                      queue.append((new_pos, path))\n                  elif grid[new_x, new_y, env.world.stone_index] > 0 and \"PICKAXE\" in env._current_state.inventory:\n                      actions_to_use_tool = use_tool(new_pos, env.world.stone_index, env.world.cookbook.index[\"PICKAXE\"])\n                      path.extend(actions_to_use_tool)\n                      visited.add(new_pos)\n                      queue.append((new_pos, path))\n                  else:\n                      visited.add(new_pos)\n                      queue.append((new_x, new_y), path + [direction])\n\n      return None\n\n  def use_tool(target_pos, obstacle_index, tool_index):\n      current_pos = env._current_state.pos\n      path_to_obstacle = find_path_to_primitive(obstacle_index)\n\n      if path_to_obstacle is not None:\n          actions = []\n          for direction in path_to_obstacle:\n              action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n              actions.append(action_index)\n          # Place the tool to clear the obstacle\n          if env._current_state.next_to(obstacle_index):\n              actions.append(tool_index)  # Use action index for placing bridge or pickaxe\n\n      return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n  path_to_primitive = find_path_to_primitive(primitive_index)\n\n  actions = []\n  if path_to_primitive is not None:\n      for direction in path_to_primitive:\n          # Convert direction tuple to action index (RIGHT=0, DOWN=1, LEFT=2, UP=3)\n          action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n          actions.append(action_index)\n\n      # Add action to collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # USE action\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-09T09:14:18.056048", "function_name": "collect", "function_body": "  def find_path_to_primitive(primitive_index):\n      grid = env._current_state.grid\n      start_pos = env._current_state.pos\n      width, height, _ = grid.shape\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      # Define movement directions: RIGHT, DOWN, LEFT, UP\n      directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n              return path\n          \n          for direction in directions:\n              new_x = current_pos[0] + direction[0]\n              new_y = current_pos[1] + direction[1]\n              new_pos = (new_x, new_y)\n              \n              if 0 <= new_x < width and 0 <= new_y < height and new_pos not in visited:\n                  # Check for obstacles like water or rock that require tool usage\n                  if grid[new_x, new_y, env.world.water_index] > 0 and \"BRIDGE\" not in env._current_state.inventory:\n                      continue\n                  if grid[new_x, new_y, env.world.stone_index] > 0 and \"PICKAXE\" not in env._current_state.inventory:\n                      continue\n\n                  visited.add(new_pos)\n                  queue.append((new_pos, path + [direction]))\n\n      return None\n\n  def use_tool(tool_name):\n      tool_index = env.world.cookbook.index[tool_name]\n      if tool_index in env._current_state.inventory:\n          # Find a valid position to place the tool (e.g., bridge) near water\n          for x in range(grid.shape[0]):\n              for y in range(grid.shape[1]):\n                  if grid[x, y, env.world.water_index] > 0 and \"BRIDGE\" == tool_name:\n                      return [(x, y)]  # Return the position to place the bridge\n      return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n  path_to_primitive = find_path_to_primitive(primitive_index)\n\n  actions = []\n  if path_to_primitive is not None:\n      for direction in path_to_primitive:\n          # Convert direction tuple to action index (RIGHT=0, DOWN=1, LEFT=2, UP=3)\n          action_index = {\"(1, 0)\": 0, \"(0, 1)\": 1, \"(-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n          actions.append(action_index)\n\n      # Add action to collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # USE action\n\n  return actions", "island_id": 7, "scores": {"3": 0.5}}
