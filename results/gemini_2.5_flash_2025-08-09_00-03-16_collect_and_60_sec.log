ons.append(craft.USE)\n\n  # Check for required tools and if they are in the inventory\n  required_tools = {\n      'GOLD': None,\n      'GEM': 'PICKAXE',\n      'WOOD': None,\n      'STONE': 'PICKAXE',\n      # Add more mappings as needed\n  }\n\n  required_tool_name = required_tools.get(primitive)\n  if required_tool_name:\n      required_tool_idx = env.world.cookbook.index[required_tool_name]\n      if current_state.inventory.get(required_tool_idx, 0) > 0:\n          use_tool(required_tool_idx)\n\n  # Find the shortest path to the primitive\n  start_pos = current_state.pos\n  path_to_primitive = bfs_find_primitive(start_pos, item_idx)\n\n  if path_to_primitive is not None:\n    for action in path_to_primitive:\n      actions.append(action)\n  else:\n    print(f\"No path found to collect {primitive}.\")\n\n  return actions", "island_id": 2, "scores": {"3": 1.0}}
