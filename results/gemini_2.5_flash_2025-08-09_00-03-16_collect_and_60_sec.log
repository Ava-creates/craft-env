= 0:\n                  actions.append(env.world.RIGHT)\n              elif current_dir == 1:\n                  actions.append(env.world.DOWN)\n                  actions.append(env.world.RIGHT)\n              elif current_dir == 2:\n                  actions.append(env.world.UP)\n                  actions.append(env.world.RIGHT)\n              elif current_dir == 3:\n                  actions.append(env.world.LEFT)\n                  actions.append(env.world.RIGHT)\n          elif target_dir == 'DOWN':\n              if current_dir == 0:\n                  actions.append(env.world.DOWN)\n                  actions.append(env.world.LEFT)\n                  actions.append(env.world.DOWN)\n              elif current_dir == 1:\n                  actions.append(env.world.DOWN)\n              elif current_dir == 2:\n                  actions.append(env.world.RIGHT)\n                  actions.append(env.world.DOWN)\n              elif current_dir == 3:\n                  actions.append(env.world.UP)\n                  actions.append(env.world.DOWN)\n          elif target_dir == 'LEFT':\n              if current_dir == 0:\n                  actions.append(env.world.LEFT)\n              elif current_dir == 1:\n                  actions.append(env.world.RIGHT)\n                  actions.append(env.world.LEFT)\n              elif current_dir == 2:\n                  actions.append(env.world.LEFT)\n              elif current_dir == 3:\n                  actions.append(env.world.UP)\n                  actions.append(env.world.LEFT)\n          elif target_dir == 'UP':\n              if current_dir == 0:\n                  actions.append(env.world.UP)\n                  actions.append(env.world.RIGHT)\n                  actions.append(env.world.UP)\n              elif current_dir == 1:\n                  actions.append(env.world.DOWN)\n                  actions.append(env.world.UP)\n              elif current_dir == 2:\n                  actions.append(env.world.LEFT)\n                  actions.append(env.world.UP)\n              elif current_dir == 3:\n                  actions.append(env.world.UP)\n          \n          # Update the current direction\n          if target_dir == 'RIGHT':\n              current_dir = 0\n          elif target_dir == 'DOWN':\n              current_dir = 1\n          elif target_dir == 'LEFT':\n              current_dir = 2\n          elif target_dir == 'UP':\n              current_dir = 3\n\n      # Add the action to collect the primitive at the final position\n      actions.append(env.world.USE)\n      \n      return actions\n\n  def is_primitive_reachable(primitive_name):\n    target_pos = find_nearest_primitive(primitive_name)\n    if not target_pos:\n        return False\n    \n    path = compute_shortest_path_to_target(env._current_state.pos, target_pos)\n    return len(path) > 0\n\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # If the agent already has the primitive, no need to collect it\n  if env._current_state.inventory[primitive_index] > 0:\n      return []\n  \n  # Check if the nearest primitive is reachable\n  if not is_primitive_reachable(primitive):\n      return []\n\n  # Find the nearest occurrence of the primitive\n  target_pos = find_nearest_primitive(primitive)\n  \n  # Compute the shortest path to the nearest primitive\n  path_to_target = compute_shortest_path_to_target(env._current_state.pos, target_pos)\n\n  # Convert the path into a sequence of actions for the agent\n  action_sequence = follow_path(path_to_target)\n  \n  return action_sequence", "island_id": 7, "scores": {"3": 0.0}}
