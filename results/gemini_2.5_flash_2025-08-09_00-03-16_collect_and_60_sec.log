ndex['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n      # Use AXE to cut down WOOD\n      elif next_cell_index == env.world.cookbook.index['WOOD'] and inventory[env.world.cookbook.index['AXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['AXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 2, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T01:48:18.289594", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n        continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n\n      # Example: Use BRIDGE to cross WATER\n      if primitive_index == env.world.cookbook.index['WATER'] and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  def find_tools_needed(path, primitive_index):\n    tools = []\n    for pos in path:\n      cell = env._current_state.grid[pos[0], pos[1]]\n      if primitive_index == env.world.cookbook.index['WATER']:\n        if inventory[env.world.cookbook.index['BRIDGE']] == 0 and cell[env.world.cookbook.index['WATER']] > 0:\n          tools.append('BRIDGE')\n    return tools\n\n  def craft_tool(tool):\n    # Placeholder for crafting logic\n    actions = [craft.CRAFT_FUNC(env.world.cookbook.index[tool]), craft.USE]\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  inventory = env._current_state.inventory\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  # Check if tools are needed for the path\n  tools_needed = find_tools_needed(path, primitive_index)\n  for tool in tools_needed:\n    actions.extend(craft_tool(tool))\n\n  actions.extend(use_tool_if_needed(path, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T01:48:19.356267", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          # Check for obstacles\n          if any(grid[neighbor_pos[0], neighbor_pos[1]][index] > 0 for index in env.world.non_grabbable_indices):\n            continue\n\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = tuple(current_pos)\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n    current_direction = None\n\n    for i in range(len(path) - 1):\n        # Determine the direction of movement\n        dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n        if (dx == 0 and dy == 0):\n            continue\n\n        new_direction = directions.get((dx, dy))\n        if new_direction != current_direction:\n            actions.append(new_direction)\n            current_direction = new_direction\n\n        # Check if the next cell requires a tool\n        next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n\n        # Example: Use BRIDGE to cross WATER\n        if primitive_index == env.world.cookbook.index['WATER'] and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n            actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n            actions.append(craft.USE)\n\n    return actions\n\n  def find_tools_needed(path, primitive_index):\n    tools = []\n    for pos in path:\n        cell = env._current_state.grid[pos[0], pos[1]]\n        if primitive_index == env.world.cookbook.index['WATER']:\n            if inventory[env.world.cookbook.index['BRIDGE']] == 0 and cell[env.world.cookbook.index['WATER']] > 0:\n                tools.append('BRIDGE')\n    return tools\n\n  def craft_tool(tool):\n      # Placeholder for crafting logic\n      actions = [craft.CRAFT_FUNC(env.world.cookbook.index[tool]), craft.USE]\n      return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  inventory = env._current_state.inventory\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n      raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  # Check if tools are needed for the path\n  tools_needed = find_tools_needed(path, primitive_index)\n  for tool in tools_needed:\n      actions.extend(craft_tool(tool))\n\n  actions.extend(use_tool_if_needed(path, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-10T01:50:09.599123", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check the next cell for any tools needed\n      next_cell_index = env._current_state.grid[path[i + 1][0], path[i + 1][1]].argmax()\n\n      # Use BRIDGE to cross WATER if needed and available\n      if (primitive_index == env.world.cookbook.index['WATER'] or \n          next_cell_index == env.world.cookbook.index['WATER']) and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n\n      # Use PICKAXE to mine GEM if needed and available\n      elif (primitive_index == env.world.cookbook.index['GEM'] or \n            next_cell_index == env.world.cookbook.index['GEM']) and inventory[env.world.cookbook.index['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  actions = []\n  start_pos = env._current_state.pos\n\n  # Sort targets based on proximity to start position\n  sorted_positions = sorted(map(tuple, positions), key=lambda pos: np.linalg.norm(np.array(pos) - np.array(start_pos)))\n\n  for target in sorted_positions:\n      path = find_shortest_path(start_pos, set([target]))\n\n      if path is None:\n          continue\n\n      directions = {\n          (-1, 0): craft.LEFT,\n          (1, 0): craft.RIGHT,\n          (0, -1): craft.DOWN,\n          (0, 1): craft.UP\n      }\n\n      actions.extend(use_tool_if_needed(path, primitive_index))\n\n      # Add the USE action to collect the primitive\n      actions.append(craft.USE)\n\n      # Update start position for next target\n      start_pos = path[-1]\n\n  if not actions:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  return actions", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T01:50:10.601806", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check the next cell for any tools needed\n      next_cell_index = env._current_state.grid[path[i + 1][0], path[i + 1][1]].argmax()\n\n      # Use BRIDGE to cross WATER if needed and available\n      if (next_cell_index == env.world.cookbook.index['WATER'] or \n          primitive_index == env.world.cookbook.index['WATER']) and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n\n      # Use PICKAXE to mine GEM if needed and available\n      elif (next_cell_index == env.world.cookbook.index['GEM'] or \n            primitive_index == env.world.cookbook.index['GEM']) and inventory[env.world.cookbook.index['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  actions = []\n  start_pos = env._current_state.pos\n\n  # Sort targets based on proximity to start position\n  sorted_positions = sorted(map(tuple, positions), key=lambda pos: np.linalg.norm(np.array(pos) - np.array(start_pos)))\n\n  for target in sorted_positions:\n      path = find_shortest_path(start_pos, set([target]))\n\n      if path is None:\n          continue\n\n      directions = {\n          (-1, 0): craft.LEFT,\n          (1, 0): craft.RIGHT,\n          (0, -1): craft.DOWN,\n          (0, 1): craft.UP\n      }\n\n      actions.extend(use_tool_if_needed(path, primitive_index))\n\n      # Add the USE action to collect the primitive\n      actions.append(craft.USE)\n\n      # Update start position for next target\n      start_pos = path[-1]\n\n  if not actions:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  return actions", "island_id": 5, "scores": {"3": 1.0}}
{"timestamp": "2025-08-10T01:51:57.706242", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, inventory):\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if (dx == 0 and dy == 0) or (abs(dx) > 1 or abs(dy) > 1):\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n      next_cell_index = np.argmax(next_cell)\n      next_cell_item = list(env.world.cookbook.index)[next_cell_index]\n\n      if next_cell_item == 'WATER' and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n      elif next_cell_item == 'ROCK' and inventory[env.world.cookbook.index['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  def get_primitive_positions(primitive_index, grid):\n      positions = np.argwhere(grid[:, :, primitive_index] > 0)\n      return set(map(tuple, positions))\n\n  def validate_target_positions(targets, grabbable_indices, grid):\n      valid_targets = []\n      for target in targets:\n          cell_index = np.argmax(grid[target])\n          if cell_index in grabbable_indices:\n              valid_targets.append(target)\n      return set(valid_targets)\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = get_primitive_positions(primitive_index, grid)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = tuple(env._current_state.pos)\n  targets = validate_target_positions(positions, env.world.grabbable_indices, grid)\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, targets)\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  inventory = env._current_state.inventory.copy()\n\n  actions = use_tool_if_needed(path, inventory)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
