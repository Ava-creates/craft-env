 {primitive}.\")\n\n  return actions", "island_id": 2, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T03:48:03.521617", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = current_state.world\n\n  # Retrieve the index for the specified primitive.\n  primitive_index = world.cookbook.index[primitive]\n\n  # Initialize an empty list to store the sequence of actions.\n  actions_to_take = []\n\n  # Check if the agent is already holding the primitive.\n  if current_state.inventory[primitive_index] > 0:\n    return actions_to_take\n\n  # Function to find the nearest instance of a given item in the environment grid.\n  def find_nearest_item(grid, item_index):\n      rows, cols = grid.shape[:2]\n      queue = collections.deque([(current_state.pos, [])])  # (position, path)\n      visited = set([current_state.pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          x, y = pos\n\n          if grid[x, y, item_index] > 0:  # Check if the item is found at this position\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:  # Explore neighbors\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < rows and 0 <= ny < cols and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  queue.append(((nx, ny), path + [move_to(dx, dy)]))\n\n      return None  # If no path is found\n\n  # Function to determine the movement action required to move from one cell to an adjacent cell.\n  def move_to(dx, dy):\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.UP\n      elif dx == 0 and dy == 1:\n          return craft.DOWN\n\n  # Function to check if a cell requires a tool for the agent to pass through.\n  def requires_tool(cell_index):\n      if world.water_index == cell_index and 'BRIDGE' in current_state.inventory:\n          return True\n      elif world.stone_index == cell_index and 'PICKAXE' in current_state.inventory:\n          return True\n      return False\n\n  # Find the nearest instance of the specified primitive.\n  path_to_primitive = find_nearest_item(current_state.grid, primitive_index)\n\n  if path_to_primitive is None:\n      raise ValueError(f\"No reachable {primitive} found in the environment.\")\n\n  actions_to_take.extend(path_to_primitive)\n  \n  # Check for any obstacles that might require tool usage.\n  def requires_tool(primitive_index):\n      return (world.water_index == primitive_index and 'BRIDGE' in current_state.inventory) or\\\n             (world.stone_index == primitive_index and 'PICKAXE' in current_state.inventory)\n\n  # Adjust the path to account for tools needed to pass through obstacles.\n  adjusted_path = []\n  for i, action in enumerate(path_to_primitive):\n      next_pos = move(current_state.pos, action)\n      if requires_tool(current_state.grid[next_pos[0], next_pos[1]].argmax()):\n          adjusted_path.append(craft.USE)  # Add tool usage action\n      adjusted_path.append(action)\n\n  actions_to_take = adjusted_path\n\n  # Collect the primitive.\n  actions_to_take.append(craft.USE)\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
