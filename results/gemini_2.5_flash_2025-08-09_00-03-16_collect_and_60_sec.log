{"timestamp": "2025-08-09T21:33:06.072240", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        return path[::-1]\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = np.array(current_pos) + np.array([dx, dy])\n        if (0 <= neighbor_pos[0] < grid.shape[0] and \n            0 <= neighbor_pos[1] < grid.shape[1] and\n            tuple(neighbor_pos) not in visited):\n          queue.append(tuple(neighbor_pos))\n          parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n        # Determine the direction of movement\n        dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n        \n        if dx == 0 and dy == 0:\n            continue\n\n        action = directions.get((dx, dy))\n        if action is not None:\n            actions.append(action)\n\n        # Check if the next cell requires a tool\n        next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n        \n        # Example: Use BRIDGE to cross WATER\n        if inventory[env.world.cookbook.index['BRIDGE']] > 0 and next_cell[env.world.cookbook.index['WATER']] > 0:\n            actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n            actions.append(craft.USE)\n        \n        # Example: Use PICKAXE to mine GEM\n        if inventory[env.world.cookbook.index['PICKAXE']] > 0 and next_cell[env.world.cookbook.index['GEM']] > 0:\n            actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n            actions.append(craft.USE)\n\n    return actions\n\n  def find_tools_needed(path, primitive_index):\n    tools = []\n    inventory = env._current_state.inventory\n    grid = env._current_state.grid\n\n    for pos in path:\n        cell = grid[pos[0], pos[1]]\n        \n        # Check if bridge is needed to cross water\n        if (inventory[env.world.cookbook.index['BRIDGE']] == 0 and \n            cell[env.world.cookbook.index['WATER']] > 0):\n            tools.append('BRIDGE')\n        \n        # Check if pickaxe is needed to mine gem\n        if (inventory[env.world.cookbook.index['PICKAXE']] == 0 and \n            cell[env.world.cookbook.index['GEM']] > 0):\n            tools.append('PICKAXE')\n\n    return list(set(tools))  # Remove duplicates\n\n  def craft_tool(tool):\n      \"\"\"Return actions needed to craft a tool.\"\"\"\n      if tool not in env.world.cookbook.primitives:\n          raise ValueError(f\"Tool {tool} cannot be crafted.\")\n      \n      recipe = env.world.cookbook.recipes.get(tool)\n      if not recipe:\n          raise ValueError(f\"No recipe found for crafting {tool}.\")\n      \n      actions = []\n      for component, count in recipe.items():\n          if inventory[env.world.cookbook.index[component]] < count:\n              # Placeholder: Assume we can collect the components needed\n              actions.extend(collect_v2(env, component))\n          \n          # Craft the tool\n          actions.append(craft.CRAFT_FUNC(env.world.cookbook.index[tool]))\n          actions.append(craft.USE)\n      \n      return actions\n\n  primitive_index = env.world.cookbook.index.get(primitive)\n  if primitive_index is None:\n      raise ValueError(f\"Primitive {primitive} not found in the cookbook.\")\n\n  if primitive_index not in env.world.grabbable_indices:\n      raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  inventory = env._current_state.inventory\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n      raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  # Check if tools are needed for the path\n  tools_needed = find_tools_needed(path, primitive_index)\n  for tool in tools_needed:\n      actions.extend(craft_tool(tool))\n\n  actions.extend(use_tool_if_needed(path, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
