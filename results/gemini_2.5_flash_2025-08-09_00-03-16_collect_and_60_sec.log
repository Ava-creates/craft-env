unt in required_tools.items():\n        if inventory[tool] >= count and tool not in tools_used:\n          actions.append(craft.CRAFT_FUNC(tool))\n          actions.append(craft.USE)\n          tools_used.add(tool)\n\n    return actions\n\n  def find_nearest_primitive(primitive_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, primitive_index] > 0)\n    \n    if len(positions) == 0:\n        raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n    start_pos = env._current_state.pos\n\n    # Find the nearest instance of the primitive\n    min_distance = float('inf')\n    nearest_position = None\n\n    for pos in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(start_pos))\n        if distance < min_distance:\n            min_distance = distance\n            nearest_position = tuple(pos)\n\n    return nearest_position\n\n  def build_path(start_pos, end_pos):\n    grid = env._current_state.grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {tuple(start_pos): None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == tuple(end_pos):\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[tuple(current_pos)]\n            path.reverse()\n            return path\n\n        visited.add(tuple(current_pos))\n\n        # Check neighbors (UP, DOWN, LEFT, RIGHT)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n            if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n                if grid[neighbor_pos[0], neighbor_pos[1]].argmax() not in env.world.non_walkable_indices:\n                    if neighbor_pos not in visited:\n                        queue.append(neighbor_pos)\n                        parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the nearest instance of the primitive\n  nearest_primitive_position = find_nearest_primitive(primitive_index)\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = build_path(start_pos, nearest_primitive_position)\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-09T21:55:02.619017", "function_name": "collect", "function_body": "  def find_shortest_path(start_pos, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {tuple(start_pos): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n    cookbook = env.world.cookbook.index\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check the next cell for tools needed to cross or mine\n      next_cell_index = env._current_state.grid[path[i + 1][0], path[i + 1][1]].nonzero()[0]\n\n      # Use BRIDGE to cross WATER\n      if primitive_index == cookbook['WATER'] and inventory[cookbook['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(cookbook['BRIDGE']))\n        actions.append(craft.USE)\n\n      # Use PICKAXE to mine GOLD or GEM\n      elif primitive_index in [cookbook['GOLD'], cookbook['GEM']] and inventory[cookbook['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(cookbook['PICKAXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T21:55:03.605353", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if (dx, dy) == (0, 0):\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_indices = np.where(env._current_state.grid[path[i + 1][0], path[i + 1][1]] > 0)[0]\n\n      for index in next_cell_indices:\n        if can_use_tool(index, primitive_index):\n          actions.append(craft.CRAFT_FUNC(index))\n          actions.append(craft.USE)\n\n    return actions\n\n  def can_use_tool(tool_index, primitive_index):\n    # Define a simple heuristic for tool usage\n    if (primitive_index == env.world.cookbook.index['WATER'] and\n        inventory[tool_index] > 0 and\n        tool_index == env.world.cookbook.index['BRIDGE']):\n      return True\n    elif (primitive_index in [env.world.cookbook.index['GOLD'], env.world.cookbook.index['GEM']] and\n          inventory[tool_index] > 0 and\n          tool_index == env.world.cookbook.index['PICKAXE']):\n      return True\n    else:\n      return False\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  inventory = env._current_state.inventory\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T21:56:53.573591", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n      next_cell_index = np.argmax(next_cell)\n      next_cell_item = list(env.world.cookbook.index)[next_cell_index]\n\n      if next_cell_item == 'WATER' and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n      elif next_cell_item == 'ROCK' and inventory[env.world.cookbook.index['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  def is_primitive_reachable(primitive_index):\n    grid = env._current_state.grid\n    start_pos = tuple(env._current_state.pos)\n    queue = collections.deque([start_pos])\n    visited = set()\n\n    while queue:\n      current_pos = queue.popleft()\n      if grid[current_pos[0], current_pos[1], primitive_index] > 0:\n        return True\n\n      visited.add(current_pos)\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            visited.add(neighbor_pos)\n\n    return False\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Check if the primitive is reachable\n  if not is_primitive_reachable(primitive_index):\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  start_pos = tuple(env._current_state.pos)\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  actions = use_tool_if_needed(path)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T21:56:54.574973", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, inventory):\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n      next_cell_index = np.argmax(next_cell)\n      next_cell_item = list(env.world.cookbook.index)[next_cell_index]\n\n      if next_cell_item == 'WATER' and inventory[env.world.cookbook.index['BRIDGE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['BRIDGE']))\n        actions.append(craft.USE)\n      elif next_cell_item == 'ROCK' and inventory[env.world.cookbook.index['PICKAXE']] > 0:\n        actions.append(craft.CRAFT_FUNC(env.world.cookbook.index['PICKAXE']))\n        actions.append(craft.USE)\n\n    return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = tuple(env._current_state.pos)\n  targets = set(map(tuple, positions))\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, targets)\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  inventory = env._current_state.inventory.copy()\n\n  actions = use_tool_if_needed(path, inventory)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": 1.0}}
