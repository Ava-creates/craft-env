hat are available and required\n      for tool, count in required_tools.items():\n        if inventory[tool] >= count and tool not in tools_used:\n          actions.append(craft.CRAFT_FUNC(tool))\n          actions.append(craft.USE)\n          tools_used.add(tool)\n\n    return actions\n\n  def find_nearest_primitive(primitive_index):\n    grid = env._current_state.grid\n    positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n    if len(positions) == 0:\n        raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n    start_pos = env._current_state.pos\n\n    # Find the nearest instance of the primitive\n    min_distance = float('inf')\n    nearest_position = None\n\n    for pos in positions:\n        distance = np.linalg.norm(np.array(pos) - np.array(start_pos))\n        if distance < min_distance:\n            min_distance = distance\n            nearest_position = tuple(pos)\n\n    return nearest_position\n\n  def determine_required_tools(cell_index, inventory):\n    required_tools = {}\n    if cell_index in env.world.cookbook.recipes:\n        recipe = env.world.cookbook.recipes[cell_index]\n        if '_tools' in recipe:  # Assuming tools are listed under a key like '_tools'\n            for tool, count in recipe['_tools'].items():\n                if inventory[tool] < count:\n                    required_tools[tool] = count\n    return required_tools\n\n  def collect_required_tools(required_tools):\n      actions = []\n      for tool, count in required_tools.items():\n          # Find the nearest instance of each required tool\n          tool_index = env.world.cookbook.index[tool]\n          if tool_index in env.world.grabbable_indices:\n              nearest_tool_position = find_nearest_primitive(tool_index)\n              start_pos = env._current_state.pos\n              path_to_tool = build_path(start_pos, nearest_tool_position)\n              if path_to_tool is not None:\n                  actions.extend(use_tool_if_needed(path_to_tool, tool_index))\n                  actions.append(craft.USE)\n      return actions\n\n  def build_path(start_pos, end_pos):\n    grid = env._current_state.grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {tuple(start_pos): None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if tuple(current_pos) == tuple(end_pos):\n            path = []\n            while current_pos is not None:\n                path.append(current_pos)\n                current_pos = parent[tuple(current_pos)]\n            path.reverse()\n            return path\n\n        visited.add(tuple(current_pos))\n\n        # Check neighbors (UP, DOWN, LEFT, RIGHT)\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n            if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n                if neighbor_pos not in visited:\n                    queue.append(neighbor_pos)\n                    parent[neighbor_pos] = current_pos\n\n    return None\n\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Determine required tools for the destination primitive\n  start_pos = env._current_state.pos\n  nearest_primitive_position = find_nearest_primitive(primitive_index)\n  destination_cell_index = env._current_state.grid[nearest_primitive_position].argmax()\n  required_tools = determine_required_tools(destination_cell_index, env._current_state.inventory)\n\n  # Collect any required tools if they are not in the inventory\n  actions.extend(collect_required_tools(required_tools))\n\n  # Re-evaluate the path after collecting tools\n  nearest_primitive_position = find_nearest_primitive(primitive_index)\n  start_pos = env._current_state.pos\n  path_to_primitive = build_path(start_pos, nearest_primitive_position)\n\n  if path_to_primitive is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  actions.extend(use_tool_if_needed(path_to_primitive, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T22:38:16.579452", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n      next_cell_indices = np.where(next_cell > 0)[0]  # Get all non-zero indices\n\n      for index in next_cell_indices:\n        if can_use_tool(index, primitive_index):\n          actions.append(craft.CRAFT_FUNC(index))\n          actions.append(craft.USE)\n\n    return actions\n\n  def can_use_tool(tool_index, primitive_index):\n    \"\"\"Determine if the tool can be used to collect the primitive.\"\"\"\n    inventory = env._current_state.inventory\n    cookbook = env.world.cookbook\n\n    # Tools and their uses\n    tools_and_uses = {\n        'BRIDGE': [cookbook.index['WATER']],\n        'PICKAXE': [cookbook.index['GOLD'], cookbook.index['GEM']],\n        'HAMMER': [cookbook.index['STONE'], cookbook.index['WOOD']],\n        'BOAT': [cookbook.index['WATER']]\n    }\n\n    tool_name = None\n    for name, indices in cookbook.index.items():\n        if indices == tool_index:\n            tool_name = name\n            break\n\n    if not tool_name or inventory[tool_index] <= 0:\n        return False\n\n    # Check if the tool can be used on the primitive\n    return primitive_index in tools_and_uses.get(tool_name, [])\n\n  def find_tool_for_primitive(primitive_index):\n    \"\"\"Find a suitable tool from the inventory to collect the primitive.\"\"\"\n    cookbook = env.world.cookbook\n    inventory = env._current_state.inventory\n\n    # Tools and their uses\n    tools_and_uses = {\n        'BRIDGE': [cookbook.index['WATER']],\n        'PICKAXE': [cookbook.index['GOLD'], cookbook.index['GEM']],\n        'HAMMER': [cookbook.index['STONE'], cookbook.index['WOOD']],\n        'BOAT': [cookbook.index['WATER']]\n    }\n\n    for tool_name, usable_primitives in tools_and_uses.items():\n        if primitive_index in usable_primitives:\n            tool_index = cookbook.index[tool_name]\n            if inventory[tool_index] > 0:\n                return tool_index\n\n    return None\n\n  def move_to_position(start_pos, target_pos):\n      \"\"\"Compute the sequence of actions to move from start_pos to target_pos.\"\"\"\n      path = find_shortest_path(start_pos, {target_pos})\n      if not path:\n          raise ValueError(f\"No path found from {start_pos} to {target_pos}\")\n\n      actions = []\n      for i in range(len(path) - 1):\n          dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n          action = directions.get((dx, dy))\n          if action is not None:\n              actions.append(action)\n\n      return actions\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  nearest_position = min(positions, key=lambda p: abs(p[0] - start_pos[0]) + abs(p[1] - start_pos[1]))\n\n  tool_index = find_tool_for_primitive(primitive_index)\n\n  if tool_index is not None:\n      # Move to a cell that allows the use of the tool\n      tool_positions = np.argwhere(grid[:, :, tool_index] > 0)\n      if len(tool_positions) == 0:\n          raise ValueError(f\"No instances of the required tool found in the environment.\")\n\n      nearest_tool_position = min(tool_positions, key=lambda p: abs(p[0] - start_pos[0]) + abs(p[1] - start_pos[1]))\n\n      # Move to the nearest tool position\n      actions.extend(move_to_position(start_pos, tuple(nearest_tool_position)))\n\n      # Use the tool if needed (e.g., place a bridge)\n      actions.append(craft.CRAFT_FUNC(tool_index))\n      actions.append(craft.USE)\n\n      # Update start position after using the tool\n      start_pos = nearest_tool_position\n\n  # Move to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, {tuple(nearest_position)})\n\n  if not path:\n    raise ValueError(f\"No path found from {start_pos} to {nearest_position}\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  inventory = env._current_state.inventory\n\n  actions.extend(use_tool_if_needed(path, primitive_index))\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-09T22:38:17.579856", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if dx == 0 and dy == 0:\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell = env._current_state.grid[path[i + 1][0], path[i + 1][1]]\n      next_cell_indices = np.where(next_cell > 0)[0]  # Get all non-zero indices\n\n      for index in next_cell_indices:\n        if can_use_tool(index, primitive_index):\n          actions.append(craft.CRAFT_FUNC(index))\n          actions.append(craft.USE)\n\n    return actions\n\n  def can_use_tool(tool_index, primitive_index):\n    # Define a sophisticated heuristic for tool usage\n    inventory = env._current_state.inventory\n    cookbook = env.world.cookbook\n\n    if (primitive_index == cookbook.index['WATER'] and\n        inventory[tool_index] > 0 and\n        tool_index in [cookbook.index['BRIDGE'], cookbook.index['BOAT']]):\n      return True\n    elif (primitive_index in [cookbook.index['GOLD'], cookbook.index['GEM']] and\n          inventory[tool_index] > 0 and\n          tool_index in [cookbook.index['PICKAXE'], cookbook.index['HAMMER']]):\n      return True\n\n    # Add more sophisticated checks for other tools and situations\n    if (primitive_index == cookbook.index['TREE'] and\n        inventory[tool_index] > 0 and\n        tool_index == cookbook.index['AXE']):\n      return True\n    elif (primitive_index in [cookbook.index['ROCK'], cookbook.index['STONE']] and\n          inventory[tool_index] > 0 and\n          tool_index == cookbook.index['PICKAXE']):\n      return True\n\n    return False\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  inventory = env._current_state.inventory\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T22:40:10.195627", "function_name": "collect", "function_body": "  item_idx = env.world.cookbook.index[primitive]\n  \n  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define movement directions\n  UP, DOWN, LEFT, RIGHT = 1, 0, 2, 3\n  \n  # Function to get neighbors in the grid\n  def get_neighbors(pos):\n    x, y = pos\n    return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Function to check if a position is within the grid bounds and not blocked by obstacles\n  def is_valid_position(pos):\n    x, y = pos\n    return 0 <= x < current_state.grid.shape[0] and 0 <= y < current_state.grid.shape[1]\n  \n  # Function to perform a breadth-first search to find the shortest path to the target primitive\n  def bfs_find_primitive(start_pos, item_idx):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      x, y = pos\n\n      # Check if the current position contains the desired primitive\n      if current_state.grid[x, y, item_idx] > 0:\n        return path + [craft.USE]  # Assume USE is the action to collect the item\n\n      # Explore neighbors\n      for neighbor in get_neighbors(pos):\n        nx, ny = neighbor\n        if is_valid_position((nx, ny)) and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          # Determine direction based on neighbor position\n          dx, dy = nx - x, ny - y\n          action = RIGHT if dx == 1 else LEFT if dx == -1 else DOWN if dy == -1 else UP\n          queue.append(((nx, ny), path + [action]))\n\n    return None\n\n  # Function to check for obstacles and use tools in the inventory\n  def handle_obstacles(pos):\n    x, y = pos\n    obstacles = set(env.world.non_grabbable_indices)\n    available_tools = current_state.inventory > 0\n\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n      if is_valid_position((nx, ny)) and current_state.grid[nx, ny] in obstacles:\n        # Check if there's a tool available to handle the obstacle\n        for tool_idx in range(len(current_state.inventory)):\n          if available_tools[tool_idx] > 0 and can_use_tool(tool_idx, (nx, ny)):\n            return [craft.MOVE_FUNC(nx - x, ny - y), craft.CRAFT_FUNC(tool_idx)]\n    return []\n\n  # Function to determine if a tool can be used at a specific position\n  def can_use_tool(tool_idx, pos):\n    tool_name = env.world.cookbook.index[tool_idx]\n    obstacle = current_state.grid[pos]\n\n    if tool_name == \"BRIDGE\" and obstacle in {\"WATER\"}:\n      return True\n    elif tool_name == \"PICKAXE\" and obstacle in {\"GEM\", \"ROCK\"}:\n      return True\n    # Add more conditions for other tools and obstacles as needed\n\n    return False\n\n  # Find the shortest path to the primitive\n  start_pos = current_state.pos\n  path_to_primitive = bfs_find_primitive(start_pos, item_idx)\n\n  if path_to_primitive is not None:\n    actions.extend(path_to_primitive)\n  else:\n    print(f\"No path found to collect {primitive}.\")\n\n  return actions", "island_id": 7, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T22:40:11.230159", "function_name": "collect", "function_body": "  item_idx = env.world.cookbook.index[primitive]\n  \n  # Initialize an empty list to store actions\n  actions = []\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  # Define movement directions\n  UP, DOWN, LEFT, RIGHT = 1, 0, 2, 3\n  \n  # Function to get neighbors in the grid\n  def get_neighbors(pos):\n    x, y = pos\n    return [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]\n\n  # Function to check if a position is within the grid bounds and not blocked by obstacles\n  def is_valid_position(pos):\n    x, y = pos\n    return 0 <= x < current_state.grid.shape[0] and 0 <= y < current_state.grid.shape[1]\n  \n  # Function to perform a breadth-first search to find the shortest path to the target primitive\n  def bfs_find_primitive(start_pos, item_idx):\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      pos, path = queue.popleft()\n      x, y = pos\n\n      # Check if the current position contains the desired primitive\n      if current_state.grid[x, y, item_idx] > 0:\n        return path + [craft.USE]  # Assume USE is the action to collect the item\n\n      # Explore neighbors\n      for neighbor in get_neighbors(pos):\n        nx, ny = neighbor\n        if is_valid_position((nx, ny)) and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          # Determine direction based on neighbor position\n          dx, dy = nx - x, ny - y\n          action = RIGHT if dx == 1 else LEFT if dx == -1 else DOWN if dy == -1 else UP\n          queue.append(((nx, ny), path + [action]))\n\n    return None\n\n  # Function to handle obstacles using tools in the inventory\n  def handle_obstacles(pos):\n    x, y = pos\n    obstacles = set(env.world.non_grabbable_indices)\n    available_tools = current_state.inventory > 0\n\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n      nx, ny = x + dx, y + dy\n      if is_valid_position((nx, ny)) and current_state.grid[nx, ny] in obstacles:\n        # Check if there's a tool available to handle the obstacle\n        for tool_idx in range(len(current_state.inventory)):\n          if available_tools[tool_idx] > 0 and can_use_tool(tool_idx, (nx, ny)):\n            return [craft.MOVE_FUNC(nx - x, ny - y), craft.CRAFT_FUNC(tool_idx)]\n    return []\n\n  # Function to determine if a tool can be used at a specific position\n  def can_use_tool(tool_idx, pos):\n    tool_name = env.world.cookbook.index.get_index(tool_idx)\n    obstacle = current_state.grid[pos]\n    \n    # Define tool usage logic based on the type of obstacle and tool\n    if tool_name == \"BRIDGE\" and any(index in obstacle for index in [env.world.cookbook.index[\"WATER\"]]):\n      return True\n    elif tool_name == \"PICKAXE\" and any(index in obstacle for index in [env.world.cookbook.index[\"ROCK\"], env.world.cookbook.index[\"GEM\"]]):\n      return True\n    \n    return False\n\n  # Find the shortest path to the primitive\n  start_pos = current_state.pos\n  path_to_primitive = bfs_find_primitive(start_pos, item_idx)\n\n  if path_to_primitive is not None:\n    actions.extend(path_to_primitive)\n  else:\n    print(f\"No path found to collect {primitive}.\")\n\n  return actions", "island_id": 7, "scores": {"3": 1.0}}
{"timestamp": "2025-08-09T22:41:56.967671", "function_name": "collect", "function_body": "  def find_shortest_path(start, targets):\n    grid = env._current_state.grid\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if tuple(current_pos) in targets:\n        path = []\n        while current_pos is not None:\n          path.append(tuple(current_pos))\n          current_pos = parent[tuple(current_pos)]\n        path.reverse()\n        return path\n\n      visited.add(tuple(current_pos))\n\n      # Check neighbors (UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = tuple(np.array(current_pos) + np.array([dx, dy]))\n        if 0 <= neighbor_pos[0] < grid.shape[0] and 0 <= neighbor_pos[1] < grid.shape[1]:\n          if neighbor_pos not in visited:\n            queue.append(neighbor_pos)\n            parent[tuple(neighbor_pos)] = current_pos\n\n    return None\n\n  def use_tool_if_needed(path, primitive_index):\n    inventory = env._current_state.inventory\n    actions = []\n\n    for i in range(len(path) - 1):\n      # Determine the direction of movement\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      if (dx, dy) == (0, 0):\n          continue\n\n      action = directions.get((dx, dy))\n      if action is not None:\n        actions.append(action)\n\n      # Check if the next cell requires a tool\n      next_cell_index = tuple(path[i + 1])\n      next_cell = grid[next_cell_index]\n\n      for tool_name in tools_to_use:\n          tool_index = env.world.cookbook.index[tool_name]\n          if inventory[tool_index] > 0 and can_place_tool(tool_index, next_cell_index):\n              actions.append(craft.CRAFT_FUNC(tool_index))\n              actions.append(craft.USE)\n              break\n\n    return actions\n\n  def can_place_tool(tool_index, target_cell):\n    # Check if the tool can be placed on the target cell\n    return grid[target_cell[0], target_cell[1], tool_index] == 0\n\n  primitive_index = env.world.cookbook.index[primitive]\n\n  if primitive_index not in env.world.grabbable_indices:\n    raise ValueError(f\"Primitive {primitive} cannot be grabbed.\")\n\n  actions = []\n\n  # Find the position of the primitive in the grid\n  grid = env._current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(positions) == 0:\n    raise ValueError(f\"No instances of {primitive} found in the environment.\")\n\n  start_pos = env._current_state.pos\n\n  # Find the shortest path to the nearest instance of the primitive\n  path = find_shortest_path(start_pos, set(map(tuple, positions)))\n\n  if path is None:\n    raise ValueError(f\"No path found to any instances of {primitive}.\")\n\n  directions = {\n      (-1, 0): craft.LEFT,\n      (1, 0): craft.RIGHT,\n      (0, -1): craft.DOWN,\n      (0, 1): craft.UP\n  }\n\n  tools_to_use = ['BRIDGE', 'PICKAXE']  # Add other tools as needed\n\n  actions = use_tool_if_needed(path, primitive_index)\n\n  # Add the USE action to collect the primitive\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
