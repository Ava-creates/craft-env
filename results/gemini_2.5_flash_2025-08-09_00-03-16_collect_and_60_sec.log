{"timestamp": "2025-08-09T00:18:43.724293", "function_name": "collect", "function_body": "  def bfs(start_pos, target_kind):\n    \"\"\"Breadth-first search for shortest path to a cell with the given kind.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n      if env._current_state.grid[x, y, target_kind] > 0:\n        return path\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if (nx, ny) not in visited and env._current_state.valid_move(nx, ny):\n          visited.add((nx, ny))\n          queue.append(((nx, ny), path + [move_direction(dx, dy)]))\n\n    return None\n\n  def move_direction(dx, dy):\n      \"\"\"Convert grid deltas to action indices.\"\"\"\n      if dx == -1:\n          return env.ACTIONS['LEFT']\n      elif dx == 1:\n          return env.ACTIONS['RIGHT']\n      elif dy == -1:\n          return env.ACTIONS['UP']\n      elif dy == 1:\n          return env.ACTIONS['DOWN']\n\n  def can_use_tool(target_kind, tool_kinds):\n      \"\"\"Check if there is a usable tool in the inventory for a given target kind.\"\"\"\n      return any(env._current_state.inventory[tool_kind] > 0 for tool_kind in tool_kinds)\n\n  # Get the index of the primitive to collect\n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  if not can_use_tool(primitive_index, [env.world.stone_index]):\n      return []\n\n  # Find a path to the primitive\n  path_to_primitive = bfs(env._current_state.pos, primitive_index)\n\n  if not path_to_primitive:\n      return []\n\n  return path_to_primitive", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-09T00:18:44.690746", "function_name": "collect", "function_body": "  actions = []\n  \n  # Check if the required primitive is already in inventory\n  if primitive in env._current_state.inventory:\n      return actions\n  \n  # Get the index for the required primitive\n  i_primitive = env.world.cookbook.index[primitive]\n  \n  # Find positions of all occurrences of the primitive in the grid\n  primitive_positions = np.argwhere(env._current_state.grid[:, :, i_primitive] == 1)\n  \n  if len(primitive_positions) == 0:\n      raise ValueError(f\"No {primitive} found in the environment.\")\n  \n  # Find the closest primitive to the agent's current position using Manhattan distance\n  min_distance = float('inf')\n  closest_position = None\n  \n  for pos in primitive_positions:\n      distance = abs(pos[0] - env._current_state.pos[0]) + abs(pos[1] - env._current_state.pos[1])\n      if distance < min_distance:\n          min_distance = distance\n          closest_position = tuple(pos)\n  \n  # Compute a shortest path to the closest primitive position\n  path_to_primitive = compute_shortest_path(env, env._current_state.pos, closest_position)\n  \n  # Append actions to move along the computed path\n  for pos in path_to_primitive:\n      direction = calculate_direction(env._current_state.pos, pos)\n      actions.append(direction)\n      env._current_state.pos = tuple(pos)  # Update agent's position\n  \n  # Action to collect the primitive (assuming USE action is 4)\n  actions.append(4)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
