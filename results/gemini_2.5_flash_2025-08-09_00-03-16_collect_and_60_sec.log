-1, 0)\": 2, \"(0, -1)\": 3}[str(direction)]\n          actions.append(action_index)\n\n      # Check if any tool is needed to use before collecting the primitive\n      required_tool = use_tool_if_needed(primitive_index)\n      if required_tool:\n          tool_index = env.world.cookbook.index[required_tool]\n          if env._current_state.next_to(tool_index):\n              actions.append(4)  # USE action for the tool\n      \n      # Add action to collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(4)  # USE action\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
