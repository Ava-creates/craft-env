{"timestamp": "2025-07-29T20:59:33.894868", "function_name": "collect", "function_body": "  primitive_name = primitive.upper()\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index[primitive_name]\n\n  # 1. Basic validation: ensure the primitive exists and is grabbable.\n  # If the primitive name is not recognized or has no index, return an empty list.\n  if primitive_idx is None:\n    return []\n  # If the primitive is a non-grabbable item (e.g., BOUNDARY, WORKSHOPs, WATER, STONE),\n  # it cannot be 'collected' by the agent through the 'USE' action in this context.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define possible movement actions and their corresponding grid coordinate deltas.\n  action_specs = env.action_specs()\n  MOVE_ACTIONS = {\n      action_specs['UP']: (0, -1),\n      action_specs['DOWN']: (0, 1),\n      action_specs['LEFT']: (-1, 0),\n      action_specs['RIGHT']: (1, 0)\n  }\n  USE_ACTION = action_specs['USE']\n\n  # 2. Pre-compute all locations on the grid where the target primitive exists.\n  # This list serves as the set of physical locations of the primitive.\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive is present at this grid cell.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere in the current grid, it cannot be collected.\n  if not primitive_locations:\n    return []\n\n  # --- Improvement for collect_v2: Pre-compute all valid \"target cells\" for the BFS. ---\n  # A target cell is any grid cell from which the agent can perform the 'USE' action\n  # to collect the primitive. This means the cell must be within a 3x3 neighborhood\n  # of any primitive location (including the primitive location itself).\n  target_bfs_cells = set()\n  for px, py in primitive_locations:\n    # Iterate through the 3x3 neighborhood around each primitive instance.\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        adj_x, adj_y = px + dx_adj, py + dy_adj\n        # Ensure the adjacent cell is within grid boundaries.\n        if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n          target_bfs_cells.add((adj_x, adj_y))\n  # This pre-computation makes the target check within the BFS loop an O(1) operation,\n  # improving efficiency especially when there are many primitive instances.\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  # to any cell within the pre-computed 'target_bfs_cells' set.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # The set of visited positions prevents cycles and redundant exploration.\n  visited = {start_pos}\n\n  # Variables to store the found path and signal when the target is reached.\n  found_path_actions = []\n  target_reached = False\n\n  while queue and not target_reached:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # --- Improved Target Check for collect_v2 ---\n    # Check if the current position is one of the pre-computed target BFS cells.\n    if (curr_x, curr_y) in target_bfs_cells:\n      found_path_actions = path_so_far\n      target_reached = True\n      break # Path found to an adjacent position, exit BFS.\n    # --- End of Improved Target Check ---\n\n    # Explore valid neighboring cells.\n    for action, (dx, dy) in MOVE_ACTIONS.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # a. Check if the next position is within grid boundaries.\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # b. Check if the next position has already been visited.\n      if next_pos in visited:\n        continue\n\n      # c. Check if the next position is blocked by a non-traversable entity.\n      # A cell is considered blocked if it contains any item kind that is in the\n      # `non_grabbable_indices` set (e.g., BOUNDARY, WORKSHOPS, WATER, STONE).\n      is_blocked = False\n      for k_idx in env.world.non_grabbable_indices:\n        if grid[next_x, next_y, k_idx] > 0: # If this non-grabbable item is present at the cell.\n          is_blocked = True\n          break # Found an obstacle, this path is blocked.\n      \n      if is_blocked:\n        continue # Do not add this position to the queue.\n\n      # If the next position is valid and not blocked, add it to the queue.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action]))\n\n  # If BFS completed and no path was found to any cell in target_bfs_cells, return empty.\n  if not target_reached:\n    return []\n  \n  # 4. If a path was found, append the 'USE' action to the sequence.\n  # This assumes 'USE' successfully collects the item once the agent is in a valid position.\n  return found_path_actions + [USE_ACTION]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:00:59.940660", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0:North, 1:East, 2:South, 3:West)\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define action mappings for movements and USE\n  ACTION_MAP = {\n      'UP': env.action_specs()['UP'],\n      'DOWN': env.action_specs()['DOWN'],\n      'LEFT': env.action_specs()['LEFT'],\n      'RIGHT': env.action_specs()['RIGHT'],\n      'USE': env.action_specs()['USE']\n  }\n\n  # Map (delta_row, delta_col) for a move action to (action_id, new_agent_direction_int)\n  # When an agent moves, its direction is updated to face the direction of movement.\n  MOVE_ACTIONS_INFO = {\n      (0, -1): (ACTION_MAP['UP'], 0),    # Move North (decreasing row), new dir = 0 (North)\n      (1, 0): (ACTION_MAP['RIGHT'], 1),  # Move East (increasing col), new dir = 1 (East)\n      (0, 1): (ACTION_MAP['DOWN'], 2),   # Move South (increasing row), new dir = 2 (South)\n      (-1, 0): (ACTION_MAP['LEFT'], 3),  # Move West (decreasing col), new dir = 3 (West)\n  }\n  \n  # Map direction integer to (dr, dc) for checking adjacent cells in ADJACENT_AND_FACE\n  # This helps determine which relative cell the agent is facing based on its direction.\n  RELATIVE_DIR_TO_COORDS = {\n      0: (0, -1), # North: (0, -1) from current (r, c)\n      1: (1, 0),  # East: (1, 0) from current (r, c)\n      2: (0, 1),  # South: (0, 1) from current (r, c)\n      3: (-1, 0)  # West: ( -1, 0) from current (r, c)\n  }\n\n  # Determine interaction type for the primitive\n  target_is_grabbable = primitive_idx in env.world.grabbable_indices\n  target_is_workshop = primitive_idx in env.world.workshop_indices\n\n  if target_is_grabbable:\n      interaction_type = \"ADJACENT_AND_FACE\" # Agent needs to be next to it and face it (e.g., WOOD, IRON)\n  elif target_is_workshop:\n      interaction_type = \"ON_SQUARE\"       # Agent needs to be on the same square (e.g., WORKSHOP)\n  else:\n      # For other non-grabbable entities listed as primitives (e.g., WATER, BOUNDARY, STONE as a fixed feature),\n      # assume \"ON_SQUARE\" interaction, meaning the goal is to reach that specific tile.\n      interaction_type = \"ON_SQUARE\"\n\n  # Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: (current_position (r,c), current_direction, path_of_actions_to_reach_this_state)\n  q = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  # Visited set stores (position_r, position_c, direction) tuples to avoid redundant exploration of states\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n      (r, c), current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the goal condition\n      if interaction_type == \"ON_SQUARE\":\n          # If the current cell contains the primitive\n          if grid[r, c, primitive_idx] > 0:\n              return path + [ACTION_MAP['USE']] # Path found, add USE action and return\n      else: # interaction_type == \"ADJACENT_AND_FACE\"\n          # Check the cell directly in front of the agent\n          dr_adj, dc_adj = RELATIVE_DIR_TO_COORDS[current_dir]\n          target_nr, target_nc = r + dr_adj, c + dc_adj\n          \n          # Ensure the target cell is within bounds\n          if 0 <= target_nr < grid_width and 0 <= target_nc < grid_height:\n              # If the cell in front contains the primitive\n              if grid[target_nr, target_nc, primitive_idx] > 0:\n                  return path + [ACTION_MAP['USE']] # Path found, add USE action and return\n\n      # Explore neighbor states\n      for (dr, dc), (action_val, new_dir) in MOVE_ACTIONS_INFO.items():\n          nr, nc = r + dr, c + dc # Calculate new neighbor position\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nr < grid_width and 0 <= nc < grid_height):\n              continue\n\n          # --- Start of improved traversability check for collect_v2 ---\n          is_traversable = True\n\n          # A cell is non-traversable if it contains:\n          # 1. Any non-grabbable entity that is NOT our target primitive (if target is ON_SQUARE, e.g., workshop).\n          #    OR if it IS our target primitive but our target is NOT ON_SQUARE (i.e. we cannot walk on it).\n          for k_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, k_idx] > 0: # If cell contains a non-grabbable item\n                  if k_idx != primitive_idx or not target_is_workshop:\n                      is_traversable = False\n                      break\n          if not is_traversable: # If already determined to be non-traversable, skip this neighbor\n              continue\n\n          # 2. Any grabbable item (agent generally cannot walk through grabbable items, must walk around)\n          for k_idx in env.world.grabbable_indices:\n              if grid[nr, nc, k_idx] > 0: # If cell contains ANY grabbable item\n                  is_traversable = False\n                  break\n          if not is_traversable: # If already determined to be non-traversable, skip this neighbor\n              continue\n          # --- End of improved traversability check for collect_v2 ---\n          \n          # Check if this (position, direction) state has already been visited\n          if (nr, nc, new_dir) in visited:\n              continue\n\n          # Add new state to queue and visited set\n          visited.add((nr, nc, new_dir))\n          q.append(((nr, nc), new_dir, path + [action_val]))\n  \n  # If the BFS completes and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:01:00.928793", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0:North, 1:East, 2:South, 3:West)\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define action mappings for movements and USE\n  ACTION_MAP = {\n      'UP': env.action_specs()['UP'],\n      'DOWN': env.action_specs()['DOWN'],\n      'LEFT': env.action_specs()['LEFT'],\n      'RIGHT': env.action_specs()['RIGHT'],\n      'USE': env.action_specs()['USE']\n  }\n\n  # Map (delta_row, delta_col) for a move action to (action_id, new_agent_direction_int)\n  # When an agent moves, its direction is updated to face the direction of movement.\n  MOVE_ACTIONS_INFO = {\n      (0, -1): (ACTION_MAP['UP'], 0),    # Move North (r, c-1), new dir = 0 (North)\n      (1, 0): (ACTION_MAP['RIGHT'], 1),  # Move East (r+1, c), new dir = 1 (East)\n      (0, 1): (ACTION_MAP['DOWN'], 2),   # Move South (r, c+1), new dir = 2 (South)\n      (-1, 0): (ACTION_MAP['LEFT'], 3),  # Move West (r-1, c), new dir = 3 (West)\n  }\n  \n  # Map direction integer to (dr, dc) for checking adjacent cells in ADJACENT_AND_FACE\n  # This helps determine which relative cell the agent is facing based on its direction.\n  RELATIVE_DIR_TO_COORDS = {\n      0: (0, -1), # North: (0, -1) from current (r, c)\n      1: (1, 0),  # East: (1, 0) from current (r, c)\n      2: (0, 1),  # South: (0, 1) from current (r, c)\n      3: (-1, 0)  # West: (r-1, c) from current (r, c)\n  }\n\n  # Determine interaction type for the primitive\n  # If it's a grabbable item (e.g., WOOD, IRON), typically you stand adjacent and USE.\n  # If it's a workshop, typically you stand on the square and USE.\n  target_is_grabbable = primitive_idx in env.world.grabbable_indices\n  target_is_workshop = primitive_idx in env.world.workshop_indices\n\n  if target_is_grabbable:\n      interaction_type = \"ADJACENT_AND_FACE\" # Agent needs to be next to it and face it\n  elif target_is_workshop:\n      interaction_type = \"ON_SQUARE\"       # Agent needs to be on the same square\n  else:\n      # For other non-grabbable entities listed as primitives (e.g., WATER, BOUNDARY, STONE as a fixed feature),\n      # assume \"ON_SQUARE\" interaction, meaning the goal is to reach that specific tile.\n      interaction_type = \"ON_SQUARE\"\n\n  # Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: (current_position (r,c), current_direction, path_of_actions_to_reach_this_state)\n  q = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  # Visited set stores (position_r, position_c, direction) tuples to avoid redundant exploration of states\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n      (r, c), current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the goal condition\n      if interaction_type == \"ON_SQUARE\":\n          # If the current cell contains the primitive\n          if grid[r, c, primitive_idx] > 0:\n              return path + [ACTION_MAP['USE']] # Path found, add USE action and return\n      else: # interaction_type == \"ADJACENT_AND_FACE\"\n          # Check the cell directly in front of the agent\n          dr_adj, dc_adj = RELATIVE_DIR_TO_COORDS[current_dir]\n          target_nr, target_nc = r + dr_adj, c + dc_adj\n          \n          # Ensure the target cell is within bounds\n          if 0 <= target_nr < grid_width and 0 <= target_nc < grid_height:\n              # If the cell in front contains the primitive\n              if grid[target_nr, target_nc, primitive_idx] > 0:\n                  return path + [ACTION_MAP['USE']] # Path found, add USE action and return\n\n      # Explore neighbor states\n      for (dr, dc), (action_val, new_dir) in MOVE_ACTIONS_INFO.items():\n          nr, nc = r + dr, c + dc # Calculate new neighbor position\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nr < grid_width and 0 <= nc < grid_height):\n              continue\n\n          # Check for traversability:\n          # A cell is considered traversable if it does not contain any \"non-grabbable\"\n          # entity that is also an obstacle. It *can* contain the primitive if the primitive\n          # is a non-grabbable target (like a workshop).\n          is_traversable = True\n          # Use env.world.non_grabbable_indices for obstacle checking as it's directly from CraftWorld\n          for k_idx in env.world.non_grabbable_indices: \n              if grid[nr, nc, k_idx] > 0 and k_idx != primitive_idx:\n                  # If the cell contains a non-grabbable item that is NOT our target primitive,\n                  # then it's an obstacle and not traversable.\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has already been visited\n          if (nr, nc, new_dir) in visited:\n              continue\n\n          # Add new state to queue and visited set\n          visited.add((nr, nc, new_dir))\n          q.append(((nr, nc), new_dir, path + [action_val]))\n  \n  # If the BFS completes and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:01:54.511462", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get the integer ID for the primitive string from the cookbook's index.\n  # The `index` method will create the index if it doesn't exist, but for \"primitives\"\n  # in this context, they are expected to be known entities.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get current state information from the environment's internal state.\n  current_state = env._current_state\n  start_pos = current_state.pos # Agent's current (row, col) position\n  start_dir = current_state.dir # Agent's current direction (0:North, 1:East, 2:South, 3:West)\n  grid = current_state.grid     # The current grid layout for pathfinding\n  grid_height, grid_width, _ = grid.shape # Grid dimensions: (rows, columns, kinds)\n\n  # Define action mappings for movements and USE based on the environment's action specifications.\n  ACTION_MAP = {\n      'UP': env.action_specs()['UP'],\n      'DOWN': env.action_specs()['DOWN'],\n      'LEFT': env.action_specs()['LEFT'],\n      'RIGHT': env.action_specs()['RIGHT'],\n      'USE': env.action_specs()['USE']\n  }\n\n  # Map (delta_row, delta_col) for a move action to (action_id, new_agent_direction_int).\n  # When an agent moves, its direction is updated to face the direction of movement.\n  # (dr, dc) represents the change in (row, column) coordinates.\n  # Dictionary format: (delta_row, delta_col): (action_to_take_id, resulting_direction_int)\n  MOVE_ACTIONS_INFO = {\n      (0, -1): (ACTION_MAP['UP'], 0),    # Move North: row stays, col decreases. New dir: North (0)\n      (0, 1): (ACTION_MAP['DOWN'], 2),   # Move South: row stays, col increases. New dir: South (2)\n      (-1, 0): (ACTION_MAP['LEFT'], 3),  # Move West: row decreases, col stays. New dir: West (3)\n      (1, 0): (ACTION_MAP['RIGHT'], 1),  # Move East: row increases, col stays. New dir: East (1)\n  }\n\n  # Map agent direction integer to (delta_row, delta_col) for the cell directly in front of the agent.\n  # This is crucial for 'ADJACENT_AND_FACE' interaction type, to check if the primitive is in sight.\n  # Dictionary format: direction_int: (dr_relative_to_agent_pos, dc_relative_to_agent_pos)\n  RELATIVE_DIR_TO_FACING_CELL_DELTA = {\n      0: (0, -1), # North: If agent at (r,c) facing North, cell in front is (r, c-1).\n      1: (1, 0),  # East: If agent at (r,c) facing East, cell in front is (r+1, c).\n      2: (0, 1),  # South: If agent at (r,c) facing South, cell in front is (r, c+1).\n      3: (-1, 0)  # West: If agent at (r,c) facing West, cell in front is (r-1, c).\n  }\n\n  # Determine the interaction type required for the primitive.\n  # This dictates how the agent needs to be positioned relative to the primitive to \"collect\" it.\n  target_is_grabbable = primitive_idx in env.world.grabbable_indices\n  target_is_workshop = primitive_idx in env.world.workshop_indices\n\n  interaction_type = None\n  if target_is_grabbable:\n      # Examples: WOOD, IRON. Agent typically needs to be adjacent and facing it to USE.\n      interaction_type = \"ADJACENT_AND_FACE\"\n  elif target_is_workshop:\n      # Examples: WORKSHOP0, WORKSHOP1. Agent needs to be on the same square to USE.\n      interaction_type = \"ON_SQUARE\"\n  else:\n      # This covers other \"primitives\" like BOUNDARY, WATER, STONE (if not grabbable).\n      # Assumes 'collect' implies reaching the square and performing a 'USE' action there.\n      interaction_type = \"ON_SQUARE\"\n\n  # Breadth-First Search (BFS) Initialization\n  # The queue stores tuples: (current_position (r,c), current_direction, path_of_actions_to_reach_this_state).\n  q = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  # The visited set stores (position_r, position_c, direction) tuples to avoid redundant exploration.\n  # Visiting the same grid position from a different agent direction can be a distinct and valid state.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n      (r, c), current_dir, path = q.popleft()\n\n      # --- Check if the current agent state (position, direction) satisfies the goal condition ---\n      # This check is performed immediately upon popping a state, as it might be the target.\n      \n      # Condition for ON_SQUARE interaction: agent is on the target square.\n      if interaction_type == \"ON_SQUARE\":\n          if grid[r, c, primitive_idx] > 0:\n              # If the current cell contains the primitive, a 'USE' action completes the collection.\n              return path + [ACTION_MAP['USE']]\n      # Condition for ADJACENT_AND_FACE interaction: agent is adjacent to and facing the target.\n      elif interaction_type == \"ADJACENT_AND_FACE\":\n          dr_facing, dc_facing = RELATIVE_DIR_TO_FACING_CELL_DELTA[current_dir]\n          target_nr, target_nc = r + dr_facing, c + dc_facing\n          \n          # Ensure the cell the agent is facing is within grid boundaries.\n          if 0 <= target_nr < grid_height and 0 <= target_nc < grid_width:\n              if grid[target_nr, target_nc, primitive_idx] > 0:\n                  # If the cell in front contains the primitive, a 'USE' action completes the collection.\n                  return path + [ACTION_MAP['USE']]\n      \n      # --- Explore neighbor states by simulating potential move actions ---\n      for (dr_move, dc_move), (action_val, new_dir) in MOVE_ACTIONS_INFO.items():\n          nr, nc = r + dr_move, c + dc_move # Calculate new potential position after taking a move action\n\n          # Check if the new position is within the grid boundaries.\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n\n          # Check for traversability of the new cell:\n          # A cell is considered traversable if it does not contain any \"non-grabbable\"\n          # entity (which are typically obstacles), *unless* that specific non-grabbable\n          # entity IS our target primitive (e.g., a workshop, which you can move onto).\n          is_traversable = True\n          for k_idx in env.world.non_grabbable_indices:\n              # If the neighbor cell (nr, nc) contains an obstacle (a non-grabbable entity)\n              # AND that obstacle is NOT the primitive we are currently trying to collect.\n              if grid[nr, nc, k_idx] > 0 and k_idx != primitive_idx:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this new state (position, new_direction) has already been visited\n          # to prevent cycles and redundant path exploration.\n          if (nr, nc, new_dir) in visited:\n              continue\n\n          # If the state is valid and has not been visited, add it to the queue\n          # and mark it as visited for future reference.\n          visited.add((nr, nc, new_dir))\n          q.append(((nr, nc), new_dir, path + [action_val]))\n\n  # If the BFS completes and the primitive was not found on the grid or a path to it\n  # could not be determined, return an empty list of actions.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:01:55.477961", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  start_pos = current_state.pos # (row, col)\n  start_dir = current_state.dir # Agent's initial direction (0:North, 1:East, 2:South, 3:West)\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape # Note: numpy array shape is (height, width, depth)\n\n  # Define action mappings for movements and USE based on env.action_specs()\n  ACTION_MAP = env.action_specs()\n  ACTION_UP = ACTION_MAP['UP']\n  ACTION_DOWN = ACTION_MAP['DOWN']\n  ACTION_LEFT = ACTION_MAP['LEFT']\n  ACTION_RIGHT = ACTION_MAP['RIGHT']\n  ACTION_USE = ACTION_MAP['USE']\n\n  # Map (delta_row, delta_col) for a move action to (action_id, new_agent_direction_int)\n  # When an agent moves, its direction is updated to face the direction of movement.\n  # (dr, dc): (action_to_take, resulting_direction)\n  # Directions: 0:North (UP), 1:East (RIGHT), 2:South (DOWN), 3:West (LEFT)\n  MOVE_ACTIONS_INFO = {\n      (0, -1): (ACTION_UP, 0),    # Move North (decreasing col, effectively 'UP' on screen), new dir = 0 (North)\n      (0, 1): (ACTION_DOWN, 2),   # Move South (increasing col, effectively 'DOWN' on screen), new dir = 2 (South)\n      (-1, 0): (ACTION_LEFT, 3),  # Move West (decreasing row, effectively 'LEFT' on screen), new dir = 3 (West)\n      (1, 0): (ACTION_RIGHT, 1),  # Move East (increasing row, effectively 'RIGHT' on screen), new dir = 1 (East)\n  }\n  \n  # Map direction integer to (dr, dc) relative to current position to find the cell in front.\n  # This is used for 'ADJACENT_AND_FACE' interaction type.\n  # dir_int: (dr_relative, dc_relative)\n  RELATIVE_DIR_TO_FACING_CELL = {\n      0: (0, -1), # North: (r, c-1) from current (r, c)\n      1: (1, 0),  # East: (r+1, c) from current (r, c)\n      2: (0, 1),  # South: (r, c+1) from current (r, c)\n      3: (-1, 0)  # West: (r-1, c) from current (r, c)\n  }\n\n  # Determine interaction type for the primitive based on its properties\n  # Grabbable items (like WOOD, IRON) require being adjacent and facing them.\n  # Workshops require being on the same square.\n  target_is_grabbable = primitive_idx in env.world.grabbable_indices\n  target_is_workshop = primitive_idx in env.world.workshop_indices\n\n  interaction_type = None\n  if target_is_grabbable:\n      interaction_type = \"ADJACENT_AND_FACE\"\n  elif target_is_workshop:\n      interaction_type = \"ON_SQUARE\"\n  else:\n      # For other non-grabbable environment entities (e.g., BOUNDARY, WATER, STONE)\n      # if they are passed as a primitive to 'collect', it implies reaching that square.\n      interaction_type = \"ON_SQUARE\"\n\n  # Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: (current_position (r,c), current_direction, path_of_actions_to_reach_this_state)\n  q = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  # Visited set stores (position_r, position_c, direction) tuples to avoid redundant exploration of states\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n      (r, c), current_dir, path = q.popleft()\n\n      # --- Check if the current state satisfies the goal condition ---\n      # This check is performed *before* exploring neighbors, as the current state\n      # might be the goal state itself, or one step away.\n      if interaction_type == \"ON_SQUARE\":\n          # If the current cell (r, c) contains the primitive\n          if grid[r, c, primitive_idx] > 0:\n              return path + [ACTION_USE] # Path found, add USE action and return\n      elif interaction_type == \"ADJACENT_AND_FACE\":\n          # Calculate the coordinates of the cell directly in front of the agent\n          dr_adj, dc_adj = RELATIVE_DIR_TO_FACING_CELL[current_dir]\n          target_nr, target_nc = r + dr_adj, c + dc_adj\n          \n          # Ensure the target cell is within bounds\n          if 0 <= target_nr < grid_height and 0 <= target_nc < grid_width:\n              # If the cell in front contains the primitive\n              if grid[target_nr, target_nc, primitive_idx] > 0:\n                  return path + [ACTION_USE] # Path found, add USE action and return\n      \n      # --- Explore neighbor states ---\n      for (dr_move, dc_move), (action_val, new_dir) in MOVE_ACTIONS_INFO.items():\n          nr, nc = r + dr_move, c + dc_move # Calculate new neighbor position\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n\n          # Check for traversability:\n          # A cell (nr, nc) is traversable if it does not contain any \"non-grabbable\"\n          # entity that is *not* our target primitive. This allows moving onto\n          # a workshop if the workshop is the primitive, but blocks other obstacles.\n          is_traversable = True\n          for k_idx in env.world.non_grabbable_indices: \n              # If the cell contains a non-grabbable item (k_idx) AND that item is NOT our target primitive\n              if grid[nr, nc, k_idx] > 0 and k_idx != primitive_idx:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has already been visited\n          if (nr, nc, new_dir) in visited:\n              continue\n\n          # Add new state to queue and visited set\n          visited.add((nr, nc, new_dir))\n          q.append(((nr, nc), new_dir, path + [action_val]))\n  \n  # If the BFS completes and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:02:50.569960", "function_name": "collect", "function_body": "    # 1. Get necessary indices and constants\n    action_map = env.action_specs()\n    \n    # Get the integer ID for the primitive we want to collect\n    try:\n        primitive_idx = env.world.cookbook.index[primitive]\n    except KeyError:\n        # Primitive name not found in the game's index, cannot collect it.\n        return []\n\n    # Get current state information from the environment\n    current_state = env._current_state\n    grid = current_state.grid\n    start_pos = current_state.pos\n    \n    WIDTH, HEIGHT, _ = grid.shape\n\n    # Identify impassable terrain. In CraftWorld, water is typically an obstacle.\n    water_idx = env.world.water_index\n    impassable_kinds = {water_idx}\n    \n    # Define movement directions and their corresponding actions\n    # (dr, dc) tuple mapping to action name string\n    move_deltas_to_names = {\n        (0, 1): 'RIGHT',\n        (0, -1): 'LEFT',\n        (1, 0): 'DOWN',\n        (-1, 0): 'UP',\n    }\n    \n    # Map deltas to the integer action values (e.g., (0,1) -> 3 for RIGHT)\n    delta_to_action_val = {delta: action_map[name] for delta, name in move_deltas_to_names.items()}\n    \n    # BFS Initialization\n    # Queue stores tuples: ((current_row, current_col), list_of_actions_to_reach_here)\n    q = collections.deque([(start_pos, [])]) \n    \n    # Set to keep track of visited cells to prevent cycles and redundant exploration\n    visited = {start_pos} \n\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # Explore all 4 cardinal neighbors\n        for (dr, dc), action_val in delta_to_action_val.items():\n            next_r, next_c = r + dr, c + dc\n\n            # Boundary check: Ensure the next cell is within the grid\n            if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n                continue\n\n            # Obstacle check: Check if the next cell contains any impassable kind (e.g., water)\n            is_impassable = False\n            for kind_idx in impassable_kinds:\n                if grid[next_r, next_c, kind_idx] == 1: # If the impassable kind is present\n                    is_impassable = True\n                    break\n            if is_impassable:\n                continue\n\n            # Visited check: Avoid re-visiting cells already explored in a shorter path\n            if (next_r, next_c) in visited:\n                continue\n            \n            # Construct the path to the next cell\n            new_path_actions = path_actions + [action_val]\n            \n            # Check if the current 'next_r, next_c' cell is adjacent to the primitive\n            # The agent needs to be *next to* the item to 'USE' it.\n            # So, we check the 4 cardinal neighbors of (next_r, next_c)\n            found_primitive_adjacent = False\n            for (ndr, ndc) in move_deltas_to_names.keys(): # Use the same deltas for checking adjacency\n                primitive_r, primitive_c = next_r + ndr, next_c + ndc\n                \n                # Boundary check for the primitive's actual location\n                if not (0 <= primitive_r < WIDTH and 0 <= primitive_c < HEIGHT):\n                    continue\n                \n                # Check if the primitive is at this neighboring location\n                if grid[primitive_r, primitive_c, primitive_idx] == 1:\n                    found_primitive_adjacent = True\n                    break # Found the primitive next to the target cell (next_r, next_c)\n\n            if found_primitive_adjacent:\n                # Path found! Add the 'USE' action and return the complete sequence.\n                return new_path_actions + [action_map['USE']]\n            else:\n                # Not yet adjacent to the primitive, so continue exploring from this cell\n                visited.add((next_r, next_c))\n                q.append(((next_r, next_c), new_path_actions))\n    \n    # If the BFS completes and no path to the primitive is found\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:02:51.580182", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:04:17.251373", "function_name": "collect", "function_body": "  import collections\n\n  # Get the integer index for the target primitive.\n  # The `index` method from `Cookbook.index` handles both existing and new item names, returning its ID.\n  i_primitive = env.world.cookbook.index.index(primitive)\n\n  # A 'collect' action in this DSL implies acquiring an item into the agent's inventory.\n  # Based on the environment's definition, only items listed in `env.world.grabbable_indices` can be collected.\n  # If the target primitive is not grabbable, it cannot be collected by the agent, so return an empty action list.\n  if i_primitive not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve numerical action mappings from the environment's action specifications.\n  # These constants are used to construct the sequence of actions for the agent.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define movement deltas (change in row, change in column) for each cardinal action.\n  # These are crucial for calculating new positions during the Breadth-First Search (BFS) exploration.\n  movement_deltas = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n\n  # Access the current state details directly from the environment.\n  # This provides the necessary information about the grid, agent's position, etc., for planning.\n  current_state = env._current_state \n  grid = current_state.grid # The current grid layout (occupancy of kinds in cells)\n  current_pos = current_state.pos # Agent's current (row, col) position\n  \n  # Extract grid dimensions for boundary checks.\n  HEIGHT, WIDTH, _ = grid.shape \n\n  # Optimization: Check if the agent is already in a position to 'USE' (collect) the primitive.\n  # The `CraftState.next_to()` method checks if the specified `i_primitive` is within the agent's 3x3 neighborhood.\n  # If so, a single `ACTION_USE` is sufficient, avoiding a full pathfinding search.\n  if current_state.next_to(i_primitive):\n      return [ACTION_USE]\n\n  # --- Breadth-First Search (BFS) Implementation ---\n  # BFS is used to find the shortest sequence of actions (path) to reach a position\n  # from which the target primitive can be collected.\n  \n  # The queue stores tuples: (current_position (row, col), list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(current_pos, [])]) \n  # `visited_positions` set keeps track of (row, col) positions already explored to prevent cycles\n  # and redundant computation, ensuring the shortest path is found.\n  visited_positions = {current_pos} \n\n  while queue:\n      (r, c), path = queue.popleft() # Dequeue the current position and the path leading to it.\n\n      # Determine if a primitive of the target kind (`i_primitive`) is within the 3x3 neighborhood\n      # of the current BFS exploration position (`(r, c)`).\n      # If it is, the agent can 'USE' it from this location.\n      can_use_from_current_pos = False\n      for dr_check in [-1, 0, 1]: # Iterate over rows in the 3x3 neighborhood\n          for dc_check in [-1, 0, 1]: # Iterate over columns in the 3x3 neighborhood\n              neighbor_r, neighbor_c = r + dr_check, c + dc_check\n              \n              # Ensure the neighbor cell being checked is within the grid boundaries.\n              if 0 <= neighbor_r < HEIGHT and 0 <= neighbor_c < WIDTH:\n                  # Check if the target primitive is present in this specific neighbor cell.\n                  if grid[neighbor_r, neighbor_c, i_primitive] == 1:\n                      can_use_from_current_pos = True\n                      break # Primitive found nearby, no need to check further neighbors for this (r,c) position.\n          if can_use_from_current_pos:\n              break # Break from the outer loop as well.\n      \n      # If the primitive is found nearby, we have successfully identified the shortest path\n      # to a valid 'use' location. Append the `ACTION_USE` to this path and return the complete sequence.\n      if can_use_from_current_pos:\n          return path + [ACTION_USE]\n      \n      # If the primitive is not found nearby from the current (r,c),\n      # explore unvisited, traversable neighbor cells to continue the BFS.\n      for action, (dr, dc) in movement_deltas.items():\n          next_r, next_c = r + dr, c + dc # Calculate the coordinates of the next potential cell.\n          \n          # Skip if the next cell is outside the grid boundaries.\n          if not (0 <= next_r < HEIGHT and 0 <= next_c < WIDTH):\n              continue \n          \n          # Determine if the next cell is blocked by an environment obstacle.\n          # `env.world.cookbook.environment` typically lists indices of entities that are static\n          # and non-traversable (e.g., walls, water, sometimes workshops depending on environment setup).\n          is_blocked = False\n          for kind_idx in env.world.cookbook.environment:\n              if grid[next_r, next_c, kind_idx] == 1: # If the cell contains any environment obstacle.\n                  is_blocked = True\n                  break\n          \n          if is_blocked:\n              continue # Cannot move into a blocked cell.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue for future exploration.\n          next_pos = (next_r, next_c)\n          if next_pos not in visited_positions:\n              visited_positions.add(next_pos)\n              queue.append((next_pos, path + [action]))\n\n  # If the BFS completes and the queue becomes empty without finding a path to the primitive,\n  # it indicates that the primitive is either unreachable from the agent's current position\n  # or does not exist on the map. In such cases, return an empty list of actions.\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:04:18.221096", "function_name": "collect", "function_body": "  import collections\n\n  actions_list = []\n  \n  i_primitive = env.world.cookbook.index.index(primitive)\n\n  # If the primitive is not a grabbable item, it cannot be 'collected' into inventory.\n  # The DSL's `collect` implies acquiring the item.\n  # Return an empty list as it's not possible to fulfill the \"collect\" objective.\n  if i_primitive not in env.world.grabbable_indices:\n      return []\n\n  # Access the current state attributes directly for efficiency in planning\n  current_state = env._current_state \n  grid = current_state.grid\n  current_pos = current_state.pos # (row, col)\n  \n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Optimization: If the primitive doesn't exist anywhere on the grid,\n  # there's no path to find it. Early exit to avoid unnecessary BFS.\n  # This relies on numpy's sum over the specific kind's layer of the grid.\n  if np.sum(grid[:, :, i_primitive]) == 0:\n      return []\n\n  # Get action integer mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define movement deltas (dy, dx) for each cardinal action\n  movement_deltas = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n  \n  # Immediate check: if already next to the grabbable primitive, just use it\n  if current_state.next_to(i_primitive):\n      return [ACTION_USE]\n\n  # --- BFS to find the shortest path to a position from which the primitive can be collected ---\n  # Queue stores tuples of ((row, col), [list_of_actions_to_reach_here])\n  queue = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set of visited (row, col) positions\n\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # Check if the current cell (r, c) is a valid \"use position\".\n      # A cell is a valid \"use position\" if the target primitive is within its 3x3 neighborhood.\n      primitive_is_nearby = False\n      for dr_check in [-1, 0, 1]:\n          for dc_check in [-1, 0, 1]:\n              nr_check, nc_check = r + dr_check, c + dc_check\n              \n              # Check grid boundaries for the neighboring cell\n              if 0 <= nr_check < HEIGHT and 0 <= nc_check < WIDTH:\n                  # If the neighboring cell contains the primitive\n                  if grid[nr_check, nc_check, i_primitive] == 1:\n                      primitive_is_nearby = True\n                      break # Found the primitive nearby, no need to check further neighbors for this position\n          if primitive_is_nearby:\n              break # Found the primitive nearby, no need to check further deltas for this position\n      \n      if primitive_is_nearby:\n          # Found a path to a cell from which we can successfully USE the primitive.\n          # Append the path, then the USE action, and return.\n          actions_list.extend(path)\n          actions_list.append(ACTION_USE)\n          return actions_list\n      \n      # Explore unvisited, traversable neighbors\n      for action, (dy, dx) in movement_deltas.items():\n          nr, nc = r + dy, c + dx # Calculate the coordinates of the next cell\n          \n          # Check if the next cell is within grid boundaries\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n          \n          # Check if the next cell (nr, nc) is blocked by an environment obstacle.\n          # `env.world.cookbook.environment` typically contains indices of non-traversable entities\n          # like boundaries, water, or workshops that act as obstacles.\n          is_blocked = False\n          for kind_idx in env.world.cookbook.environment:\n              if grid[nr, nc, kind_idx] == 1: # If the cell contains an environment obstacle\n                  is_blocked = True\n                  break\n          \n          if is_blocked:\n              continue # Cannot move into a blocked cell\n\n          # If the cell is traversable and not yet visited, add it to the queue\n          if (nr, nc) not in visited:\n              visited.add((nr, nc))\n              queue.append(((nr, nc), path + [action]))\n\n  # If the BFS completes and no path to a collectible primitive is found (e.g., unreachable or none exist)\n  return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:05:10.794461", "function_name": "collect", "function_body": "  current_state = env._current_state\n  current_pos = current_state.pos  # Agent's current (x, y) position\n  current_dir = current_state.dir # Agent's current facing direction (int 0-3)\n  grid = current_state.grid\n  action_map = env.action_specs()\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Convert primitive string to its integer ID using the cookbook\n  primitive_id = env.world.cookbook.index[primitive]\n  is_primitive_grabbable = (primitive_id in env.world.grabbable_indices)\n\n  # If the primitive is already in the agent's inventory, no actions are needed.\n  if current_state.inventory[primitive_id] > 0 and is_primitive_grabbable:\n      return [] # Primitive already collected.\n\n  # Identify obstacle IDs. Assume 'water' and 'stone' are impassable.\n  obstacle_ids = set()\n  if 'water' in env.world.cookbook.index:\n      obstacle_ids.add(env.world.cookbook.index['water'])\n  if 'stone' in env.world.cookbook.index:\n      obstacle_ids.add(env.world.cookbook.index['stone'])\n  \n  # Movement deltas corresponding to actions (and resulting direction)\n  # (dx, dy) is the change in coordinates for a given action\n  # Assumes that taking a movement action also sets the agent's direction to that action's direction.\n  # e.g., if you take action 'UP', your direction becomes 'UP'.\n  action_to_delta_and_dir_id = {\n      action_map['UP']: ((0, -1), 0),    # UP (dir_id 0)\n      action_map['DOWN']: ((0, 1), 1),   # DOWN (dir_id 1)\n      action_map['LEFT']: ((-1, 0), 2),  # LEFT (dir_id 2)\n      action_map['RIGHT']: ((1, 0), 3),  # RIGHT (dir_id 3)\n  }\n  \n  # Mapping from direction ID to its (dx, dy) vector\n  dir_id_to_delta = {v[1]: v[0] for v in action_to_delta_and_dir_id.values()}\n  # Mapping from (dx, dy) vector to direction ID\n  vec_to_dir = {v: k for k, v in dir_id_to_delta.items()}\n\n  # Helper function to check if a position is within bounds and walkable\n  def is_walkable(x, y):\n      # Check grid boundaries\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False \n      \n      # Check if the cell contains any known obstacle\n      for obs_id in obstacle_ids:\n          if grid[x, y, obs_id] > 0: \n              return False\n      return True\n\n  # 1. Find all locations where the primitive exists\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_id] > 0:\n              primitive_locations.append((x, y))\n  \n  if not primitive_locations:\n      return [] # Primitive not found in the environment\n\n  # 2. Define target collection states: (ax, ay, required_dir)\n  # These are the (agent_position, agent_direction) states from which the agent can \"collect\" the primitive.\n  target_collection_states = set()\n  \n  # Cardinal neighbors for adjacency calculation\n  cardinal_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] # LEFT, RIGHT, UP, DOWN\n\n  for px, py in primitive_locations:\n      for dx_adj, dy_adj in cardinal_deltas:\n          # Calculate the potential agent position (ax, ay) adjacent to the primitive\n          ax, ay = px + dx_adj, py + dy_adj\n          \n          # Check if this agent position is within bounds and walkable\n          if is_walkable(ax, ay):\n              if is_primitive_grabbable:\n                  # For grabbable items, agent must be at (ax,ay) and facing (px,py)\n                  # The vector from agent to primitive is (px-ax, py-ay) = (-dx_adj, -dy_adj)\n                  required_facing_dir_id = vec_to_dir[(-dx_adj, -dy_adj)]\n                  target_collection_states.add((ax, ay, required_facing_dir_id))\n              else:\n                  # For non-grabbable items, agent just needs to be adjacent. Any facing direction is fine.\n                  for d in range(4): # 0, 1, 2, 3 represent UP, DOWN, LEFT, RIGHT\n                      target_collection_states.add((ax, ay, d))\n\n  # If no valid collection points can be reached (e.g., primitive is surrounded by obstacles)\n  if not target_collection_states:\n      return []\n\n  # 3. BFS search for the shortest path to any target collection state\n  # Queue stores tuples of ((x, y, dir), list_of_actions_to_reach_this_state)\n  queue = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  # Set of visited states to prevent cycles and redundant exploration\n  # A state is defined by (x, y, dir).\n  visited = {(current_pos[0], current_pos[1], current_dir)} \n\n  while queue:\n      (cx, cy, cdir), path_actions = queue.popleft()\n\n      # Check if the current state (position, direction) is a target collection state\n      if (cx, cy, cdir) in target_collection_states:\n          final_actions = list(path_actions) # Create a copy of the path\n\n          # If the primitive is an item that can be picked up, add a USE action.\n          # For non-grabbable primitives (like 'water' or 'workshop'), we just need to reach adjacency.\n          if is_primitive_grabbable:\n              final_actions.append(action_map['USE'])\n          \n          return final_actions # Return the complete sequence of actions\n\n      # Explore all possible movement actions from the current state\n      for action_id, ((dx, dy), new_dir) in action_to_delta_and_dir_id.items():\n          nx, ny = cx + dx, cy + dy\n          new_state_tuple = (nx, ny, new_dir)\n\n          # Only proceed if the new position is walkable and the new state has not been visited yet\n          if is_walkable(nx, ny) and new_state_tuple not in visited:\n              visited.add(new_state_tuple)\n              queue.append((new_state_tuple, path_actions + [action_id]))\n\n  # If the queue becomes empty and no path to a target collection state was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:05:11.770377", "function_name": "collect", "function_body": "  current_state = env._current_state\n  current_pos = current_state.pos  # Agent's current (x, y) position\n  current_dir = current_state.dir # Agent's current facing direction (int 0-3)\n  grid = current_state.grid\n  action_map = env.action_specs()\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Convert primitive string to its integer ID using the cookbook\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Determine if the primitive is grabbable (requires 'USE' action)\n  is_primitive_grabbable = (primitive_id in env.world.grabbable_indices)\n\n  # Optimization: If the primitive is grabbable and already in inventory, no actions are needed.\n  if is_primitive_grabbable and current_state.inventory[primitive_id] > 0:\n      return [] # Primitive already collected.\n\n  # Identify obstacle IDs. Assume 'water' and 'stone' are impassable.\n  obstacle_ids = set()\n  if 'water' in env.world.cookbook.index:\n      obstacle_ids.add(env.world.cookbook.index['water'])\n  if 'stone' in env.world.cookbook.index:\n      obstacle_ids.add(env.world.cookbook.index['stone'])\n  \n  # Movement deltas corresponding to actions and the resulting agent direction\n  # Stores: action_id: ((dx, dy), new_dir_id)\n  move_action_details = {\n      action_map['UP']: ((0, -1), 0),    # UP: (dx, dy) for movement, resulting_dir_id (0:UP)\n      action_map['DOWN']: ((0, 1), 1),   # DOWN: (dx, dy), resulting_dir_id (1:DOWN)\n      action_map['LEFT']: ((-1, 0), 2),  # LEFT: (dx, dy), resulting_dir_id (2:LEFT)\n      action_map['RIGHT']: ((1, 0), 3),  # RIGHT: (dx, dy), resulting_dir_id (3:RIGHT)\n  }\n  \n  # Mapping from direction ID to its (dx, dy) vector (what agent faces)\n  dir_id_to_delta = {0: (0, -1), 1: (0, 1), 2: (-1, 0), 3: (1, 0)}\n\n  # Helper function to check if a position is within bounds and walkable (not an obstacle)\n  def is_walkable(x, y):\n      # Check grid boundaries\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False \n      \n      # Check if the cell contains any known obstacle\n      for obs_id in obstacle_ids:\n          if grid[x, y, obs_id] > 0: \n              return False\n      return True\n\n  # 1. Find all grid locations where the primitive exists\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_id] > 0:\n              primitive_locations.append((x, y))\n  \n  if not primitive_locations:\n      return [] # Primitive not found in the environment\n\n  # 2. Define target collection states: (ax, ay, adir)\n  # These are the (agent_position, agent_direction) states from which the agent can collect the primitive.\n  target_collection_states = set()\n  \n  # Cardinal neighbor deltas (used for defining adjacency)\n  cardinal_neighbors_deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations:\n      if is_primitive_grabbable:\n          # For grabbable items, the agent must be adjacent to the item AND facing it.\n          # Iterate over all possible agent facing directions\n          for adir_id, (ddx, ddy) in dir_id_to_delta.items():\n              # If agent at (ax, ay) faces (ddx, ddy), the item is at (ax+ddx, ay+ddy)\n              # Given item is at (px, py), the agent position must be (ax, ay) = (px-ddx, py-ddy)\n              ax, ay = px - ddx, py - ddy\n              if is_walkable(ax, ay):\n                  target_collection_states.add((ax, ay, adir_id))\n      else:\n          # For non-grabbable primitives (e.g., WORKSHOP, WATER, BOUNDARY),\n          # the agent just needs to be adjacent to it. Facing direction does not matter.\n          for ndx, ndy in cardinal_neighbors_deltas:\n              ax, ay = px + ndx, py + ndy # (ax,ay) is a neighbor of (px,py)\n              if is_walkable(ax, ay):\n                  # If agent is at (ax, ay), it can be facing any of the 4 directions.\n                  # All these (pos, dir) states are valid for 'collecting' (i.e., reaching) a non-grabbable.\n                  for adir_id in range(4): # 0, 1, 2, 3 for UP, DOWN, LEFT, RIGHT\n                      target_collection_states.add((ax, ay, adir_id))\n\n  # If no valid collection points can be reached (e.g., primitive is completely surrounded by obstacles)\n  if not target_collection_states:\n      return []\n\n  # 3. BFS search for the shortest path to any target collection state\n  # Queue stores tuples of ((x, y, dir), list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  # Set of visited states to prevent cycles and redundant exploration (state = (x, y, dir))\n  visited = {(current_pos[0], current_pos[1], current_dir)} \n\n  while queue:\n      (cx, cy, cdir), path_actions = queue.popleft()\n\n      # Check if the current state (position, direction) is one of our target collection states\n      if (cx, cy, cdir) in target_collection_states:\n          final_actions = list(path_actions) # Make a copy of the path\n\n          # If the primitive is grabbable, a 'USE' action is required to collect it.\n          if is_primitive_grabbable:\n              final_actions.append(action_map['USE'])\n          \n          return final_actions # Return the complete sequence of actions\n\n      # Explore all possible moves from the current position and direction\n      for action_id, ((dx, dy), new_dir) in move_action_details.items():\n          nx, ny = cx + dx, cy + dy\n          new_state_tuple = (nx, ny, new_dir)\n\n          # Only proceed if the new position is walkable and this specific (pos, dir) state has not been visited yet\n          if is_walkable(nx, ny) and new_state_tuple not in visited:\n              visited.add(new_state_tuple)\n              queue.append((new_state_tuple, path_actions + [action_id]))\n\n  # If the queue becomes empty and no path to a target collection state was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:06:27.875317", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1` (or `collect_v0` if v1 is a pass-through).\n  This version provides a robust strategy to find and 'collect' (either pick up or interact with)\n  a specified primitive in the environment. It uses Breadth-First Search (BFS) for shortest\n  pathfinding, differentiating between grabbable and non-grabbable items and\n  handling environmental obstacles.\n  \"\"\"\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get the integer ID for the target primitive from the cookbook's index.\n  # Using .index() ensures that if the primitive name exists, its ID is returned;\n  # otherwise, it's added to the index (though for DSL tasks, names should pre-exist).\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Access the current state details of the environment.\n  current_state_obj = env._current_state\n  inventory = current_state_obj.inventory\n  current_pos = current_state_obj.pos # (x, y) agent's current grid coordinates\n  grid = current_state_obj.grid # The grid represents cell contents: grid[y, x, kind] == 1 if 'kind' is at (x,y)\n  \n  HEIGHT, WIDTH, _ = grid.shape # Dimensions of the grid\n\n  # Determine if the primitive is a 'grabbable' item (can be picked up by moving onto its cell)\n  # or a 'non-grabbable' item (interacted with from an adjacent cell, or serves as an impassable obstacle).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # --- Early Exit Conditions to avoid unnecessary pathfinding ---\n  # 1. If the primitive is grabbable and the agent already possesses it, no actions are needed.\n  if is_grabbable and inventory[primitive_idx] > 0:\n    return []\n\n  # 2. If the primitive is non-grabbable and the agent is already in a cell adjacent to it,\n  #    a single ACTION_USE is sufficient to interact with it.\n  if not is_grabbable and current_state_obj.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  # --- BFS for Pathfinding to the Primitive ---\n  # The queue stores tuples: (current_position (x,y), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # The 'visited' set keeps track of explored grid positions to prevent cycles and redundant paths.\n  visited = {current_pos}\n  \n  # This variable will store the sequence of actions that leads to the target cell.\n  path_to_target_cell_actions = None \n  \n  # Define what entities/objects make a grid cell impassable for agent movement.\n  # In CraftWorld, all non-grabbable items are generally considered obstacles (e.g., water, workshops, boundaries).\n  impassable_object_indices = env.world.non_grabbable_indices \n\n  while queue:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # --- Check if the current position satisfies the goal condition ---\n    if is_grabbable:\n        # For grabbable items, the goal is to reach the cell *containing* the primitive itself.\n        # The agent must move onto this cell to collect it.\n        if grid[curr_y, curr_x, primitive_idx] == 1:\n            path_to_target_cell_actions = path_so_far\n            break # Path to the grabbable item found\n    else: # This is a non-grabbable primitive (e.g., WORKSHOP, WATER, STONE)\n        # For non-grabbable items, the goal is to reach a cell *adjacent* to the primitive.\n        # Interaction (via ACTION_USE) typically happens from an adjacent cell.\n        # We check the 4-directional neighbors (N, S, W, E) of the current cell.\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Delta coordinates for neighbors\n            nx, ny = curr_x + dx, curr_y + dy\n            # Check if neighbor is within grid bounds AND contains the primitive\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[ny, nx, primitive_idx] == 1:\n                path_to_target_cell_actions = path_so_far\n                break # Path found to a cell adjacent to the non-grabbable primitive\n        if path_to_target_cell_actions is not None:\n            break # Break the outer BFS loop if a path to an adjacent cell was found\n\n    # --- Explore Valid Neighbors ---\n    # Define possible cardinal moves and their corresponding actions.\n    possible_moves = [\n        ((curr_x, curr_y - 1), ACTION_UP),    # Move North\n        ((curr_x, curr_y + 1), ACTION_DOWN),   # Move South\n        ((curr_x - 1, curr_y), ACTION_LEFT),   # Move West\n        ((curr_x + 1, curr_y), ACTION_RIGHT)   # Move East\n    ]\n\n    for (next_x, next_y), action in possible_moves:\n        # 1. Boundary Check: Ensure the prospective next position is within the grid.\n        if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n            continue\n\n        # 2. Visited Check: Avoid revisiting already explored positions to prevent cycles and find shortest path.\n        if (next_x, next_y) in visited:\n            continue\n\n        # 3. Obstacle Check: Determine if the prospective next cell contains any impassable objects.\n        #    The agent cannot move into a cell that has an item identified as an obstacle.\n        is_obstacle_at_next_pos = False\n        for obj_kind_idx in impassable_object_indices:\n            if grid[next_y, next_x, obj_kind_idx] == 1: # If this cell contains any impassable item\n                is_obstacle_at_next_pos = True\n                break # No need to check other impassable kinds\n        \n        if is_obstacle_at_next_pos:\n            continue # This cell is blocked, cannot move here\n\n        # If the cell is traversable and unvisited, add it to the queue for future exploration.\n        visited.add((next_x, next_y))\n        new_path = list(path_so_far) # Create a new list for the path to avoid modifying shared references\n        new_path.append(action)\n        queue.append(((next_x, next_y), new_path))\n\n  # --- Construct the Final List of Actions ---\n  final_actions = []\n  if path_to_target_cell_actions is not None:\n    final_actions.extend(path_to_target_cell_actions)\n    # After reaching the identified target cell (either on it for grabbable, or adjacent for non-grabbable),\n    # a final ACTION_USE is performed to interact with or collect the primitive.\n    final_actions.append(ACTION_USE)\n  \n  return final_actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:06:28.861675", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  current_state_obj = env._current_state\n  inventory = current_state_obj.inventory\n  current_pos = current_state_obj.pos # (x, y)\n  grid = current_state_obj.grid\n  \n  HEIGHT, WIDTH, _ = grid.shape # grid is indexed as grid[y, x, kind]\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Early exit 1: If the primitive is grabbable and already in inventory, no actions needed.\n  if is_grabbable and inventory[primitive_idx] > 0:\n    return []\n\n  # Early exit 2: If the primitive is non-grabbable and we are already next to it, just use.\n  # This covers cases like workshops or water where interaction is adjacent.\n  # We check this early to avoid pathfinding if already in position.\n  if not is_grabbable and current_state_obj.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  # BFS Setup for pathfinding\n  # Queue stores tuples: (current_position (x,y), list_of_actions_to_reach_current_position)\n  queue = collections.deque([(current_pos, [])])\n  # Visited set stores positions (x,y) to prevent cycles and redundant exploration\n  visited = {current_pos}\n  \n  path_to_target_cell_actions = None\n  \n  # Impassable indices are entities the agent cannot move onto (e.g., BOUNDARY, WATER, WORKSHOPS).\n  impassable_indices = env.world.non_grabbable_indices\n\n  while queue:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Target check based on primitive type\n    if is_grabbable:\n        # For grabbable items, the target is the cell *containing* the primitive.\n        # The agent needs to move onto this cell to collect it.\n        if grid[curr_y, curr_x, primitive_idx] == 1:\n            path_to_target_cell_actions = path_so_far\n            break # Path to the primitive's location found\n    else: # Non-grabbable primitive (e.g., WATER, WORKSHOP, STONE)\n        # For non-grabbable items, the target is a cell *adjacent* to the primitive.\n        # Interaction (USE) happens from an adjacent cell.\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Check N, S, W, E neighbors\n            nx, ny = curr_x + dx, curr_y + dy\n            # Check if neighbor is within bounds and contains the primitive\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[ny, nx, primitive_idx] == 1:\n                path_to_target_cell_actions = path_so_far\n                break # Path to a cell adjacent to the primitive found\n        if path_to_target_cell_actions is not None:\n            break # Break outer while loop if path found to an adjacent cell\n\n    # Explore neighbors (cardinal directions only)\n    neighbors_data = [\n        ((curr_x, curr_y - 1), ACTION_UP),    # North\n        ((curr_x, curr_y + 1), ACTION_DOWN),   # South\n        ((curr_x - 1, curr_y), ACTION_LEFT),   # West\n        ((curr_x + 1, curr_y), ACTION_RIGHT)   # East\n    ]\n\n    for (nx, ny), action in neighbors_data:\n        # Check if neighbor is within grid bounds\n        if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n            continue\n        # Check if neighbor has already been visited in this BFS search\n        if (nx, ny) in visited:\n            continue\n\n        # Obstacle check: Agent cannot move onto cells containing impassable items.\n        is_impassable_neighbor = False\n        for kind_idx in impassable_indices:\n            if grid[ny, nx, kind_idx] == 1:\n                is_impassable_neighbor = True\n                break\n        \n        if is_impassable_neighbor:\n            continue # Cannot move into this cell as it's an obstacle\n\n        # If the neighbor is traversable and not visited, add it to the queue\n        visited.add((nx, ny))\n        new_path = list(path_so_far) # Create a copy of the path\n        new_path.append(action)\n        queue.append(((nx, ny), new_path))\n\n  actions = []\n  if path_to_target_cell_actions is not None:\n    actions.extend(path_to_target_cell_actions)\n    # The DSL's `collect` semantic implies using the item after reaching it.\n    actions.append(ACTION_USE) \n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:07:13.046062", "function_name": "collect", "function_body": "  primitive_name = primitive.upper()\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index[primitive_name]\n\n  # 1. Basic validation: ensure the primitive exists and is grabbable.\n  if primitive_idx is None:\n    return []\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define possible movement actions and their corresponding grid coordinate deltas.\n  action_specs = env.action_specs()\n  MOVE_ACTIONS = {\n      action_specs['UP']: (0, -1),\n      action_specs['DOWN']: (0, 1),\n      action_specs['LEFT']: (-1, 0),\n      action_specs['RIGHT']: (1, 0)\n  }\n  USE_ACTION = action_specs['USE']\n\n  # Improvement for collect_v2: Create a boolean grid for primitive locations.\n  # This allows O(1) lookup to check if a specific cell contains the primitive.\n  is_primitive_grid = np.zeros((WIDTH, HEIGHT), dtype=bool)\n  has_any_primitive = False # Flag to quickly check if any primitive exists at all\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # If the primitive is present at this grid cell, mark it in the boolean grid.\n      if grid[x, y, primitive_idx] > 0:\n        is_primitive_grid[x, y] = True\n        has_any_primitive = True\n\n  # If the primitive is not found anywhere in the current grid, it cannot be collected.\n  if not has_any_primitive:\n    return []\n\n  # Improvement inherited from collect_v1: Pre-compute obstacle grid for faster lookups during BFS.\n  # A cell is an obstacle if it contains any item kind that is in the `non_grabbable_indices` set.\n  is_obstacle_grid = np.zeros((WIDTH, HEIGHT), dtype=bool)\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      for obstacle_k_idx in env.world.non_grabbable_indices:\n        if grid[x, y, obstacle_k_idx] > 0:\n          is_obstacle_grid[x, y] = True\n          break # Found an obstacle at this cell, no need to check other kinds\n\n  # Perform Breadth-First Search (BFS) to find the shortest path\n  # to a cell adjacent to any of the primitive locations.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # The set of visited positions prevents cycles and redundant exploration.\n  visited = {start_pos}\n\n  # Variables to store the found path and signal when the target is reached.\n  found_path_actions = []\n  target_reached = False\n\n  while queue and not target_reached:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Check if the current position is within the 3x3 neighborhood of any primitive location.\n    # The agent needs to be adjacent (or on top of) to an item to 'USE' it.\n    # Improvement for collect_v2: Use the pre-computed `is_primitive_grid` for constant-time checks.\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n        \n        # Ensure the adjacent cell is within grid boundaries before checking.\n        if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n          # If this adjacent cell contains the primitive, a path has been found.\n          if is_primitive_grid[adj_x, adj_y]:\n            found_path_actions = path_so_far\n            target_reached = True\n            break # Found an adjacent primitive, break inner loop (dy_adj).\n      if target_reached:\n        break # Found an adjacent primitive, break outer loop (dx_adj).\n    \n    if target_reached:\n      break # Exit BFS loop immediately as the shortest path is found.\n\n    # Explore valid neighboring cells.\n    for action, (dx, dy) in MOVE_ACTIONS.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # a. Check if the next position is within grid boundaries.\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # b. Check if the next position has already been visited.\n      if next_pos in visited:\n        continue\n\n      # c. Check if the next position is blocked by a non-traversable entity.\n      # Use pre-computed obstacle grid for faster obstacle check.\n      if is_obstacle_grid[next_x, next_y]:\n        continue # Do not add this position to the queue, it's blocked.\n\n      # If the next position is valid and not blocked, add it to the queue.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action]))\n\n  # If BFS completed and no path was found to any cell adjacent to the primitive, return empty.\n  if not target_reached:\n    return []\n  \n  # If a path was found, append the 'USE' action to the sequence.\n  return found_path_actions + [USE_ACTION]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:07:14.082949", "function_name": "collect", "function_body": "  primitive_name = primitive.upper()\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index[primitive_name]\n\n  # If the primitive name is not recognized or has no index, return an empty list.\n  if primitive_idx is None:\n    return []\n\n  # If the primitive is a non-grabbable item (e.g., BOUNDARY, WORKSHOPs, or\n  # WATER/STONE if they are designated as non-grabbable), it cannot be 'collected'\n  # by the agent through the 'USE' action in this context.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  # Grid shape is (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define possible movement actions and their corresponding grid coordinate deltas.\n  action_specs = env.action_specs()\n  # Map move actions (UP, DOWN, LEFT, RIGHT) to (dx, dy) changes.\n  # Assuming (0,0) is top-left, x increases rightwards, y increases downwards.\n  MOVE_ACTIONS = {\n      action_specs['UP']: (0, -1),\n      action_specs['DOWN']: (0, 1),\n      action_specs['LEFT']: (-1, 0),\n      action_specs['RIGHT']: (1, 0)\n  }\n  USE_ACTION = action_specs['USE']\n\n  # Pre-compute all locations on the grid where the target primitive exists.\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive is present at this grid cell.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere in the current grid, it cannot be collected.\n  if not primitive_locations:\n    return []\n\n  # Pre-compute obstacle grid for faster lookups during BFS.\n  # This avoids repeated iteration over `n_kinds` and membership checks in `non_grabbable_indices`\n  # within the inner BFS loop for every visited cell.\n  is_obstacle_grid = np.zeros((WIDTH, HEIGHT), dtype=bool)\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if any of the non-grabbable items are present at this cell.\n      for obstacle_k_idx in env.world.non_grabbable_indices:\n        if grid[x, y, obstacle_k_idx] > 0:\n          is_obstacle_grid[x, y] = True\n          break # Found an obstacle at this cell, no need to check other kinds\n\n  # Perform Breadth-First Search (BFS) to find the shortest path to an adjacent cell.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # The set of visited positions prevents cycles and redundant exploration.\n  visited = {start_pos}\n\n  # Variables to store the found path and signal when the target is reached.\n  found_path_actions = []\n  target_reached = False\n\n  while queue and not target_reached:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Check if the current position is within the 3x3 neighborhood of any primitive location.\n    # The agent needs to be adjacent (in a 3x3 sense) to an item to 'USE' it.\n    for px, py in primitive_locations:\n      if abs(curr_x - px) <= 1 and abs(curr_y - py) <= 1:\n        found_path_actions = path_so_far\n        target_reached = True\n        break # Found a path to an adjacent position, stop checking other primitive locations.\n    \n    if target_reached:\n      break # Exit BFS loop immediately as the shortest path is found.\n\n    # Explore valid neighboring cells.\n    for action, (dx, dy) in MOVE_ACTIONS.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries.\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position has already been visited.\n      if next_pos in visited:\n        continue\n\n      # Use pre-computed obstacle grid for faster obstacle check.\n      if is_obstacle_grid[next_x, next_y]:\n        continue # Do not add this position to the queue, it's blocked.\n\n      # If the next position is valid and not blocked, add it to the queue.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action]))\n\n  # If no path was found to any cell adjacent to the primitive after BFS, return empty.\n  if not target_reached:\n    return []\n  \n  # If a path was found, append the 'USE' action to the sequence.\n  # This assumes 'USE' successfully collects the item once adjacent.\n  return found_path_actions + [USE_ACTION]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:08:19.191562", "function_name": "collect", "function_body": "  p_idx = env.world.cookbook.index[primitive]\n\n  # Get the numerical action IDs from the environment's action_specs.\n  actions = env.action_specs()\n  MOVE_ACTIONS = [actions['DOWN'], actions['UP'], actions['LEFT'], actions['RIGHT']]\n  USE_ACTION = actions['USE']\n\n  # Get the current actual state of the environment.\n  current_state = env._current_state\n\n  # Improvement 1: Check if the primitive is actually grabbable.\n  # If it's a non-grabbable entity (like WATER, STONE, WORKSHOP), it cannot be \"collected\" into inventory.\n  # In this case, return an empty list of actions.\n  if p_idx not in env.world.grabbable_indices:\n      return []\n\n  # Early exit 1: If the primitive is already in inventory, no collection actions are needed.\n  if current_state.inventory[p_idx] > 0:\n      return []\n\n  # Early exit 2: If the agent is already next to the primitive, only a USE action is needed.\n  if current_state.next_to(p_idx):\n      return [USE_ACTION]\n\n  # Initialize a queue for Breadth-First Search (BFS) and a set for visited states.\n  # Queue items will be (position_tuple, direction_int).\n  # Visited states are represented by (position_tuple, direction_int).\n  q = collections.deque()\n  visited = set()\n\n  # Improvement 2: Use a parent map to reconstruct the path more efficiently,\n  # avoiding repeated list concatenations.\n  # path_parent_map: maps (child_pos, child_dir) -> (parent_pos, parent_dir, action_from_parent)\n  path_parent_map = {}\n\n  # Add the initial state to the queue and mark it as visited.\n  start_pos_dir_tuple = (current_state.pos, current_state.dir)\n  q.append(start_pos_dir_tuple)\n  visited.add(start_pos_dir_tuple)\n\n  target_node = None # Will store the (pos, dir) of the state where next_to(p_idx) is true\n\n  # Perform BFS to find a path.\n  while q:\n    curr_pos, curr_dir = q.popleft()\n\n    # Simulate the current state to check conditions and step from it.\n    # CraftState's grid and inventory attributes are numpy arrays. For movement actions,\n    # CraftState.step does not deep copy these arrays, making this memory-efficient.\n    sim_state = CraftState(current_state.scenario, current_state.grid, curr_pos, curr_dir, current_state.inventory)\n\n    # If the current simulated state is \"next to\" the primitive, we've found a path.\n    if sim_state.next_to(p_idx):\n      target_node = (curr_pos, curr_dir)\n      break # Path found, exit BFS\n\n    # Explore possible move actions from the current state.\n    for action in MOVE_ACTIONS:\n      # Simulate taking the action to get the next state.\n      _, next_sim_state = sim_state.step(action)\n      next_pos_dir_tuple = (next_sim_state.pos, next_sim_state.dir)\n\n      # If this state (position and direction) has not been visited before, add it to the queue.\n      if next_pos_dir_tuple not in visited:\n        visited.add(next_pos_dir_tuple)\n        q.append(next_pos_dir_tuple)\n        # Store parent information for path reconstruction\n        path_parent_map[next_pos_dir_tuple] = (curr_pos, curr_dir, action)\n\n  # Reconstruct the path if a target node was found.\n  if target_node is None:\n      # If the BFS queue became empty and no path to the primitive was found, it's unreachable.\n      return []\n  else:\n      # Start with the USE action, as we are now adjacent to the primitive.\n      actions_to_take = [USE_ACTION]\n      node = target_node\n\n      # Backtrack from the target node to the starting node using the parent map.\n      # The loop continues until we reach the starting position and direction.\n      while node != start_pos_dir_tuple:\n          parent_pos, parent_dir, action_to_reach_node = path_parent_map[node]\n          actions_to_take.append(action_to_reach_node)\n          node = (parent_pos, parent_dir)\n\n      # The path is built in reverse, so reverse it to get actions from start to target.\n      return actions_to_take[::-1]", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:08:20.214254", "function_name": "collect", "function_body": "  p_idx = env.world.cookbook.index[primitive]\n\n  # Get the numerical action IDs from the environment's action_specs.\n  actions = env.action_specs()\n  MOVE_ACTIONS = [actions['DOWN'], actions['UP'], actions['LEFT'], actions['RIGHT']]\n  USE_ACTION = actions['USE']\n\n  # Determine if the primitive is grabbable. This influences the collection logic.\n  is_grabbable = p_idx in env.world.grabbable_indices\n\n  # Get the current actual state of the environment.\n  current_state = env._current_state\n\n  # Early exit 1: If the primitive is grabbable and already in inventory, no actions are needed.\n  if is_grabbable and current_state.inventory[p_idx] > 0:\n      return []\n\n  # Early exit 2: If the agent is already next to the primitive.\n  # `next_to` checks the 3x3 neighborhood, including the agent's current cell.\n  if current_state.next_to(p_idx):\n      if is_grabbable:\n          # If grabbable, a single USE action completes the collection.\n          return [USE_ACTION]\n      else:\n          # If non-grabbable, being next to it (or on it) is the goal for \"collection\"\n          # (as they cannot be put into inventory), so no further actions are needed.\n          return []\n\n  # Initialize a queue for Breadth-First Search (BFS) and a set for visited states.\n  # Each item in the queue will be a tuple: (current_CraftState, list_of_actions_taken_to_reach_this_state)\n  q = collections.deque()\n  # Visited states are represented by a hashable tuple: (position_tuple, direction_int).\n  # This is sufficient as inventory only changes via a 'USE' action, which is the final step\n  # or not applicable for non-grabbables.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  start_pos_dir_tuple = (current_state.pos, current_state.dir)\n  q.append((current_state, []))  # (CraftState object, empty list of actions)\n  visited.add(start_pos_dir_tuple)\n\n  # Perform BFS to find a path.\n  while q:\n    current_sim_state, path_actions = q.popleft()\n\n    # If the current simulated state is \"next to\" the primitive, we've found a path\n    # to the target location.\n    if current_sim_state.next_to(p_idx):\n      if is_grabbable:\n          # If grabbable, append the USE action to the path and return the complete list.\n          return path_actions + [USE_ACTION]\n      else:\n          # If non-grabbable, the path to being next to it (or on it) is the goal,\n          # no USE action is appended as it cannot be \"collected\" into inventory.\n          return path_actions\n\n    # Explore possible move actions from the current state.\n    for action in MOVE_ACTIONS:\n      # Simulate taking the action using the CraftState's step method.\n      # This creates a new CraftState object without modifying the actual environment's state.\n      # The reward from the step is ignored as we are only concerned with reaching the goal.\n      _, next_sim_state = current_sim_state.step(action)\n\n      # Get the hashable representation of the next simulated state (position and direction).\n      next_pos_dir_tuple = (next_sim_state.pos, next_sim_state.dir)\n\n      # If this state (position and direction) has not been visited before, add it to the queue.\n      if next_pos_dir_tuple not in visited:\n        visited.add(next_pos_dir_tuple)\n        q.append((next_sim_state, path_actions + [action]))\n\n  # If the BFS queue becomes empty and no path to the primitive was found, it's unreachable.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
