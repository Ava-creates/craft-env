{"timestamp": "2025-07-29T21:09:13.710778", "function_name": "collect", "function_body": "  primitive_name = primitive.upper()\n  cookbook = env.world.cookbook\n  primitive_idx = cookbook.index[primitive_name]\n\n  # If the primitive name is not recognized or has no index, return an empty list.\n  if primitive_idx is None:\n    return []\n\n  # If the primitive is a non-grabbable item (e.g., BOUNDARY, WORKSHOPs, or\n  # WATER/STONE if they are designated as non-grabbable), it cannot be 'collected'\n  # by the agent through the 'USE' action in this context.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n\n  # Get current state information from the environment.\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  # Grid shape is (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define possible movement actions and their corresponding grid coordinate deltas.\n  action_specs = env.action_specs()\n  # Map move actions (UP, DOWN, LEFT, RIGHT) to (dx, dy) changes.\n  # Assuming (0,0) is top-left, x increases rightwards, y increases downwards.\n  MOVE_ACTIONS = {\n      action_specs['UP']: (0, -1),\n      action_specs['DOWN']: (0, 1),\n      action_specs['LEFT']: (-1, 0),\n      action_specs['RIGHT']: (1, 0)\n  }\n  USE_ACTION = action_specs['USE']\n\n  # Pre-compute all locations on the grid where the target primitive exists.\n  primitive_locations = []\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the primitive is present at this grid cell.\n      if grid[x, y, primitive_idx] > 0:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found anywhere in the current grid, it cannot be collected.\n  if not primitive_locations:\n    return []\n\n  # Convert the set of non-grabbable indices to a NumPy array for efficient checks\n  # with np.isin during the BFS traversal for obstacle detection.\n  non_grabbable_kinds_array = np.array(list(env.world.non_grabbable_indices))\n\n  # Perform Breadth-First Search (BFS) to find the shortest path to an adjacent cell.\n  # The queue stores tuples: (current_position (x, y), list_of_actions_to_reach_here).\n  queue = collections.deque([(start_pos, [])])\n  # The set of visited positions prevents cycles and redundant exploration.\n  visited = {start_pos}\n\n  # Variables to store the found path and signal when the target is reached.\n  found_path_actions = []\n  target_reached = False\n\n  while queue and not target_reached:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Check if the current position is within the 3x3 neighborhood of any primitive location.\n    # The agent needs to be adjacent (in a 3x3 sense) to an item to 'USE' it.\n    for px, py in primitive_locations:\n      if abs(curr_x - px) <= 1 and abs(curr_y - py) <= 1:\n        found_path_actions = path_so_far\n        target_reached = True\n        break # Found a path to an adjacent position, stop checking other primitive locations.\n    \n    if target_reached:\n      break # Exit BFS loop immediately as the shortest path is found.\n\n    # Explore valid neighboring cells.\n    for action, (dx, dy) in MOVE_ACTIONS.items():\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      # Check if the next position is within grid boundaries.\n      if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n        continue\n\n      # Check if the next position has already been visited.\n      if next_pos in visited:\n        continue\n\n      # Check if the next position is blocked by a non-traversable entity.\n      # A cell is considered blocked if it contains any item kind that is in the\n      # `non_grabbable_indices` set (e.g., BOUNDARY).\n      \n      # Get all item kinds present at the next position (indices where grid value > 0).\n      # np.where returns a tuple, so we take the first element which is the array of indices.\n      kinds_at_next_pos = np.where(grid[next_x, next_y, :] > 0)[0]\n      \n      # Check if any of the `kinds_at_next_pos` are present in `non_grabbable_kinds_array`.\n      # If so, the path is blocked.\n      if np.any(np.isin(kinds_at_next_pos, non_grabbable_kinds_array)):\n        continue # Do not add this position to the queue.\n\n      # If the next position is valid and not blocked, add it to the queue.\n      visited.add(next_pos)\n      queue.append((next_pos, path_so_far + [action]))\n\n  # If no path was found to any cell adjacent to the primitive after BFS, return empty.\n  if not target_reached:\n    return []\n  \n  # If a path was found, append the 'USE' action to the sequence.\n  # This assumes 'USE' successfully collects the item once adjacent.\n  return found_path_actions + [USE_ACTION]", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:10:35.344628", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook_index = env.world.cookbook.index\n  action_specs = env.action_specs()\n  world = env.world # Reference to CraftWorld instance\n\n  primitive_id = cookbook_index.index(primitive)\n  water_id = world.water_index # ID for \"water\" kind\n\n  # Determine if this primitive is inherently non-collectable via 'USE' action.\n  # A primitive can be 'collected' if it's grabbable (increases inventory upon 'USE')\n  # OR if it's stone (which is a special case: non-grabbable but can be 'mined' or 'used' to get it).\n  is_grabbable_item = primitive_id in world.grabbable_indices\n  is_stone_item = (primitive_id == world.stone_index)\n\n  if not is_grabbable_item and not is_stone_item:\n    # If it's not a typically grabbable item and not stone, it's considered un-collectable by this function.\n    # This handles environmental features like water, workshops, or boundaries which cannot be added to inventory.\n    return []\n\n  # 1. Check if primitive is already in the agent's inventory.\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already collected, no actions needed\n\n  # 2. Check if the primitive is immediately reachable (within the 3x3 neighborhood, including current cell).\n  # If it is, a single 'USE' action should be sufficient.\n  if current_state.next_to(primitive_id):\n    return [action_specs['USE']]\n\n  # 3. Use Breadth-First Search (BFS) to find the shortest path to a cell containing the primitive.\n  start_pos = current_state.pos\n  grid = current_state.grid # Current grid occupancy\n  WIDTH, HEIGHT, _ = grid.shape\n\n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_actions_to_current_position)\n  visited = {start_pos} # Set to keep track of visited grid cells to avoid cycles\n\n  # Define possible movements and their corresponding actions\n  # (dx, dy): action_value\n  moves_delta = [\n    ((0, 1), action_specs['DOWN']),\n    ((0, -1), action_specs['UP']),\n    ((1, 0), action_specs['RIGHT']),\n    ((-1, 0), action_specs['LEFT'])\n  ]\n\n  found_path_actions = None # To store the actions once a path is found\n\n  while q:\n    (cx, cy), path_actions = q.popleft()\n\n    # Check if the current position (cx, cy) contains the primitive we are looking for.\n    # If the agent can stand ON the primitive to collect it (e.g., wood, stone), this is a valid target cell.\n    if grid[cx, cy, primitive_id] == 1:\n      found_path_actions = path_actions\n      break # Path found to a cell containing the primitive\n\n    # Explore neighbors\n    for (dx, dy), action in moves_delta:\n      nx, ny = cx + dx, cy + dy\n\n      # Check grid bounds\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n\n      # Determine if the neighboring cell (nx, ny) is traversable\n      is_traversable = True\n      \n      # Water is typically an impassable obstacle\n      if grid[nx, ny, water_id] == 1:\n        is_traversable = False\n      else:\n        # Check for other non-grabbable obstacles at (nx, ny)\n        # Iterate through all kinds that might be present at (nx, ny)\n        for k_idx in range(grid.shape[2]): \n          if grid[nx, ny, k_idx] == 1 and k_idx in world.non_grabbable_indices:\n            # If the cell contains a non-grabbable item, it's an obstacle UNLESS:\n            # 1. It is the target primitive itself (e.g., stone, which you move onto to collect).\n            # 2. It is a workshop (workshops are typically traversable points of interaction).\n            if k_idx == primitive_id:\n              continue # Can move onto the target primitive even if it's non-grabbable\n            \n            if k_idx in world.workshop_indices: # workshop_indices is a list of int IDs\n              continue # Workshops are non-grabbable but assumed to be traversable for movement\n            \n            # If it's a non-grabbable, and not the target, and not a workshop, then it's an obstacle.\n            is_traversable = False\n            break # No need to check other kinds in this cell if an obstacle is found\n      \n      # If the cell is traversable and hasn't been visited yet, add it to the queue\n      if is_traversable and (nx, ny) not in visited:\n        visited.add((nx, ny))\n        new_path_actions = path_actions + [action]\n        q.append(((nx, ny), new_path_actions))\n\n  if found_path_actions is not None:\n    # Once the agent reaches the cell containing the primitive, a 'USE' action is needed to collect it.\n    return found_path_actions + [action_specs['USE']]\n  else:\n    # Primitive not found or unreachable on the current grid\n    return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:10:36.323811", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook_index = env.world.cookbook.index\n  \n  # Get the integer ID for the primitive from the cookbook's index\n  primitive_id = cookbook_index.index(primitive)\n\n  # 1. Check if the primitive is already in the inventory\n  if current_state.inventory[primitive_id] > 0:\n    return [] # Already collected, no actions needed\n\n  # 2. Check if the primitive is in the agent's immediate 3x3 neighborhood.\n  # If it is, a single 'USE' action should be sufficient to collect it.\n  if current_state.next_to(primitive_id):\n    return [env.action_specs()['USE']]\n\n  # If not in inventory and not next to, we need to find its location and path to it using BFS.\n  \n  # Get environment details for pathfinding\n  start_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  action_map = env.action_specs()\n  \n  # Define possible movements and their corresponding actions\n  moves = {\n      'UP': (0, -1),\n      'DOWN': (0, 1),\n      'LEFT': (-1, 0),\n      'RIGHT': (1, 0)\n  }\n\n  # Identify impassable terrain indices from the cookbook's environment set.\n  # These are typically non-grabbable entities like water, stone, boundary, which are also not walkable.\n  impassable_ids = env.world.cookbook.environment\n\n  def is_walkable(pos):\n    \"\"\"\n    Checks if a given grid position is within bounds and does not contain any impassable items.\n    \"\"\"\n    x, y = pos\n    # Check bounds\n    if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n      return False \n    \n    # Check if the cell contains any impassable item\n    for k_id in impassable_ids:\n      if grid[x, y, k_id] == 1:\n        return False # This cell contains an impassable object\n    return True\n\n  # BFS initialization\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples of visited positions to avoid cycles\n\n  # Start BFS from the agent's current position with an empty path\n  q.append((start_pos, [])) # (current_position, actions_taken_to_reach_here)\n  visited.add(start_pos)\n\n  while q:\n    curr_pos, path_actions = q.popleft()\n    curr_x, curr_y = curr_pos\n\n    # Goal Check: Can the primitive be collected from the current position using 'USE'?\n    # This means the primitive must be present in the 3x3 neighborhood of curr_pos.\n    # We manually simulate the logic of CraftState.next_to for our simulated position.\n    found_primitive_adjacent = False\n    for dx_adj in [-1, 0, 1]:\n      for dy_adj in [-1, 0, 1]:\n        adj_x, adj_y = curr_x + dx_adj, curr_y + dy_adj\n        # Check if the adjacent cell is within grid bounds\n        if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n          # Check if the primitive is present in this adjacent cell\n          if grid[adj_x, adj_y, primitive_id] == 1:\n            found_primitive_adjacent = True\n            break # Primitive found in vicinity, this is a valid spot to USE\n      if found_primitive_adjacent:\n        break\n            \n    if found_primitive_adjacent:\n      # If a path to a suitable position is found, append 'USE' and return the path\n      return path_actions + [action_map['USE']]\n\n    # Explore neighbors: Add walkable, unvisited neighbors to the queue\n    for action_name, (dx, dy) in moves.items():\n      next_pos = (curr_x + dx, curr_y + dy)\n      \n      if is_walkable(next_pos) and next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action_map[action_name]]))\n\n  # If BFS completes and no path to collect the primitive is found\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:12:06.939499", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  current_state_obj = env._current_state\n  inventory = current_state_obj.inventory\n  initial_pos = current_state_obj.pos # (x, y)\n  initial_dir = current_state_obj.dir # (0=UP, 1=DOWN, 2=LEFT, 3=RIGHT)\n  grid = current_state_obj.grid\n  \n  HEIGHT, WIDTH, _ = grid.shape # grid is indexed as grid[y, x, kind]\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Early exit: If the primitive is grabbable and already in inventory, no actions needed.\n  if is_grabbable and inventory[primitive_idx] > 0:\n    return []\n\n  # Define constants for clarity matching CraftState.dir mapping\n  DIR_UP = 0\n  DIR_DOWN = 1\n  DIR_LEFT = 2\n  DIR_RIGHT = 3\n  \n  # Map movement actions to the resulting agent direction\n  action_to_new_dir_map = {\n      ACTION_UP: DIR_UP,\n      ACTION_DOWN: DIR_DOWN,\n      ACTION_LEFT: DIR_LEFT,\n      ACTION_RIGHT: DIR_RIGHT\n  }\n  \n  # Map direction integers to (dx, dy) vectors\n  dir_vectors = {\n      DIR_UP: (0, -1),\n      DIR_DOWN: (0, 1),\n      DIR_LEFT: (-1, 0),\n      DIR_RIGHT: (1, 0)\n  }\n  \n  # Reverse map from (dx, dy) vectors to direction integers\n  vector_to_dir = {(0, -1): DIR_UP, (0, 1): DIR_DOWN, (-1, 0): DIR_LEFT, (1, 0): DIR_RIGHT}\n\n  # Helper function to get turn actions\n  def get_turn_actions(current_dir, target_dir):\n      if current_dir == target_dir:\n          return []\n\n      # Mapping current_dir to the direction after a single RIGHT turn\n      turn_right_map = {DIR_UP: DIR_RIGHT, DIR_DOWN: DIR_LEFT, DIR_LEFT: DIR_UP, DIR_RIGHT: DIR_DOWN} \n      # Mapping current_dir to the direction after a single LEFT turn\n      turn_left_map = {DIR_UP: DIR_LEFT, DIR_DOWN: DIR_RIGHT, DIR_LEFT: DIR_DOWN, DIR_RIGHT: DIR_UP}\n\n      if turn_right_map[current_dir] == target_dir:\n          return [ACTION_RIGHT]\n      elif turn_left_map[current_dir] == target_dir:\n          return [ACTION_LEFT]\n      else: # Must be a 180-degree turn\n          return [ACTION_LEFT, ACTION_LEFT] # Or [ACTION_RIGHT, ACTION_RIGHT]\n\n  # BFS Setup for pathfinding\n  # Queue stores tuples: (current_position (x,y), list_of_actions_to_reach_current_position)\n  queue = collections.deque([(initial_pos, [])])\n  # Visited set stores positions (x,y) to prevent cycles and redundant exploration\n  visited = {initial_pos}\n  \n  path_to_target_cell_actions = None\n  target_primitive_location = None # (x,y) of the primitive itself (only for non-grabbable)\n  final_agent_pos_after_path = None # The cell the agent lands on after moves\n\n  # Impassable indices are entities the agent cannot move onto (e.g., BOUNDARY, WATER, WORKSHOPS).\n  impassable_indices = env.world.non_grabbable_indices\n\n  while queue:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Target check based on primitive type\n    if is_grabbable:\n        # For grabbable items, the target is the cell *containing* the primitive.\n        # The agent needs to move onto this cell to collect it.\n        if grid[curr_y, curr_x, primitive_idx] == 1:\n            path_to_target_cell_actions = path_so_far\n            final_agent_pos_after_path = (curr_x, curr_y)\n            break # Path to the primitive's location found\n    else: # Non-grabbable primitive (e.g., WORKSHOP, WATER, STONE)\n        # For non-grabbable items, the target is a cell *adjacent* to the primitive.\n        # Interaction (USE) happens from an adjacent cell.\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Check N, S, W, E neighbors\n            nx, ny = curr_x + dx, curr_y + dy\n            # Check if neighbor is within bounds and contains the primitive\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[ny, nx, primitive_idx] == 1:\n                path_to_target_cell_actions = path_so_far\n                final_agent_pos_after_path = (curr_x, curr_y) # Agent is at (curr_x, curr_y)\n                target_primitive_location = (nx, ny) # Primitive is at (nx, ny)\n                break # Path to a cell adjacent to the primitive found\n        if path_to_target_cell_actions is not None:\n            break # Break outer while loop if path found to an adjacent cell\n\n    # Explore neighbors (cardinal directions only)\n    neighbors_data = [\n        ((curr_x, curr_y - 1), ACTION_UP),    # North\n        ((curr_x, curr_y + 1), ACTION_DOWN),   # South\n        ((curr_x - 1, curr_y), ACTION_LEFT),   # West\n        ((curr_x + 1, curr_y), ACTION_RIGHT)   # East\n    ]\n\n    for (nx, ny), action in neighbors_data:\n        # Check if neighbor is within grid bounds\n        if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n            continue\n        # Check if neighbor has already been visited in this BFS search\n        if (nx, ny) in visited:\n            continue\n\n        # Obstacle check: Agent cannot move onto cells containing impassable items.\n        is_impassable_neighbor = False\n        for kind_idx in impassable_indices:\n            if grid[ny, nx, kind_idx] == 1:\n                is_impassable_neighbor = True\n                break\n        \n        if is_impassable_neighbor:\n            continue # Cannot move into this cell as it's an obstacle\n\n        # If the neighbor is traversable and not visited, add it to the queue\n        visited.add((nx, ny))\n        new_path = list(path_so_far) # Create a copy of the path\n        new_path.append(action)\n        queue.append(((nx, ny), new_path))\n\n  actions = []\n  if path_to_target_cell_actions is not None:\n    actions.extend(path_to_target_cell_actions)\n\n    if not is_grabbable:\n      # Simulate the agent's direction after all movement actions in the path\n      sim_current_dir = initial_dir\n      for action_taken in path_to_target_cell_actions:\n          if action_taken in action_to_new_dir_map:\n              sim_current_dir = action_to_new_dir_map[action_taken]\n      \n      # Determine the required direction for the agent to face the primitive\n      # This is the vector from the agent's final position to the primitive's position\n      dx = target_primitive_location[0] - final_agent_pos_after_path[0]\n      dy = target_primitive_location[1] - final_agent_pos_after_path[1]\n      \n      required_face_dir = vector_to_dir.get((dx, dy))\n\n      # If a cardinal direction is required (i.e., not diagonal or same cell)\n      if required_face_dir is not None:\n          # Get the actions needed to turn to face the primitive\n          turn_actions = get_turn_actions(sim_current_dir, required_face_dir)\n          actions.extend(turn_actions)\n    \n    # After reaching the target cell (or adjacent for non-grabbables) and facing correctly, USE the item\n    actions.append(ACTION_USE) \n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:12:07.950017", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  current_state_obj = env._current_state\n  inventory = current_state_obj.inventory\n  current_pos = current_state_obj.pos # (x, y)\n  grid = current_state_obj.grid\n  \n  HEIGHT, WIDTH, _ = grid.shape # grid is indexed as grid[y, x, kind]\n\n  # Determine if the primitive is grabbable (can be picked up) or non-grabbable (interacted with adjacently)\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Early exit 1: If the primitive is grabbable and already in inventory, no actions needed.\n  if is_grabbable and inventory[primitive_idx] > 0:\n    return []\n\n  # Early exit 2: If the primitive is non-grabbable and we are already next to it, just use.\n  # This covers cases like workshops or water where interaction is adjacent and immediate.\n  if not is_grabbable and current_state_obj.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  # BFS Setup for pathfinding\n  # Queue stores tuples: (current_position (x,y), list_of_actions_to_reach_current_position)\n  queue = collections.deque([(current_pos, [])])\n  # Visited set stores positions (x,y) to prevent cycles and redundant exploration\n  visited = {current_pos}\n  \n  path_to_target_cell_actions = None\n  \n  # Impassable indices are entities the agent cannot move onto (e.g., BOUNDARY, WATER, WORKSHOPS).\n  # These are derived from the world's non-grabbable entities, which act as obstacles for movement.\n  impassable_indices = env.world.non_grabbable_indices\n\n  while queue:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Check if the current cell (for grabbable) or a neighbor (for non-grabbable) contains the primitive.\n    found_target_in_bfs = False\n    if is_grabbable:\n        # For grabbable items, the target is the cell *containing* the primitive.\n        # The agent needs to move onto this cell to collect it.\n        if grid[curr_y, curr_x, primitive_idx] == 1:\n            path_to_target_cell_actions = path_so_far\n            found_target_in_bfs = True\n    else: # Non-grabbable primitive (e.g., WATER, WORKSHOP, STONE)\n        # For non-grabbable items, the target is a cell *adjacent* to the primitive.\n        # Interaction (USE) happens from an adjacent cell.\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Check N, S, W, E (cardinal) neighbors\n            nx_adj, ny_adj = curr_x + dx, curr_y + dy\n            # Check if neighbor is within bounds and contains the primitive\n            if 0 <= nx_adj < WIDTH and 0 <= ny_adj < HEIGHT and grid[ny_adj, nx_adj, primitive_idx] == 1:\n                path_to_target_cell_actions = path_so_far\n                found_target_in_bfs = True\n                break # Found an adjacent primitive for this path_so_far, no need to check other neighbors\n    \n    if found_target_in_bfs:\n        break # Path to the desired interaction location (on or next to primitive) found\n\n    # Explore neighbors (cardinal directions only: North, South, West, East)\n    neighbors_data = [\n        ((curr_x, curr_y - 1), ACTION_UP),    \n        ((curr_x, curr_y + 1), ACTION_DOWN),   \n        ((curr_x - 1, curr_y), ACTION_LEFT),   \n        ((curr_x + 1, curr_y), ACTION_RIGHT)   \n    ]\n\n    for (nx, ny), action in neighbors_data:\n        # Check if neighbor is within grid bounds\n        if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n            continue\n        # Check if neighbor has already been visited in this BFS search\n        if (nx, ny) in visited:\n            continue\n\n        # Obstacle check: Agent cannot move onto cells containing impassable items.\n        is_impassable_neighbor = False\n        for kind_idx in impassable_indices:\n            if grid[ny, nx, kind_idx] == 1:\n                is_impassable_neighbor = True\n                break\n        \n        if is_impassable_neighbor:\n            continue # Cannot move into this cell as it's an obstacle\n\n        # If the neighbor is traversable and not visited, add it to the queue\n        visited.add((nx, ny))\n        new_path = list(path_so_far) # Create a copy of the path for this branch\n        new_path.append(action)\n        queue.append(((nx, ny), new_path))\n\n  actions = []\n  if path_to_target_cell_actions is not None:\n    actions.extend(path_to_target_cell_actions)\n    # The DSL's `collect` semantic implies using the item after reaching its location (on or next to).\n    actions.append(ACTION_USE) \n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:13:18.233767", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  grid = current_state.grid\n  start_pos = current_state.pos  # Agent's current (x_col, y_row) position\n\n  # Get grid dimensions: grid.shape is (WIDTH, HEIGHT, n_kinds)\n  # WIDTH corresponds to x-axis (columns), HEIGHT corresponds to y-axis (rows)\n  grid_width, grid_height, _ = grid.shape\n\n  # Map action names to integer IDs for clarity and consistency\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible movements as (dx, dy) changes to (x_col, y_row) and their corresponding actions\n  MOVE_ACTIONS = [\n      ((-1, 0), LEFT),   # Move Left: decrease column (x)\n      ((1, 0), RIGHT),  # Move Right: increase column (x)\n      ((0, -1), UP),    # Move Up: decrease row (y)\n      ((0, 1), DOWN)    # Move Down: increase row (y)\n  ]\n\n  # Get the integer ID for the primitive.\n  # The DSL guarantees primitive names (e.g., 'WOOD', 'STONE') are consistent with cookbook entries.\n  primitive_kind_id = cookbook.index[primitive.upper()]\n\n  # Crucial safety check: A primitive must be \"grabbable\" (e.g., wood, stone) to be collected.\n  # Non-grabbable entities (e.g., water, workshops, boundaries) cannot be collected.\n  if primitive_kind_id not in world.grabbable_indices:\n      return [] # Return empty list if the primitive cannot be collected\n\n  # Helper function to check if a given grid position (x_col, y_row) is within the grid boundaries.\n  def _is_in_bounds(x_col, y_row):\n      return 0 <= x_col < grid_width and 0 <= y_row < grid_height\n\n  # Helper function to check if a specific grid position (x_col, y_row) or its 3x3 neighborhood\n  # contains the target_kind_id. This is essential because `USE` action is effective\n  # if the agent is adjacent to the item (as per CraftState.next_to).\n  def _is_adjacent_to_kind(x_col, y_row, target_kind_idx):\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = x_col + dx, y_row + dy\n              # Check bounds and if the kind is present at the neighboring cell\n              if _is_in_bounds(nx, ny) and grid[nx, ny, target_kind_idx] > 0:\n                  return True\n      return False\n\n  # Optimization: If the agent is already at a position from which the primitive can be collected,\n  # no movement is necessary; just perform the 'USE' action.\n  if _is_adjacent_to_kind(start_pos[0], start_pos[1], primitive_kind_id):\n      return [USE]\n\n  # Precompute non-traversable cells for efficient pathfinding.\n  # Cells containing any item from `world.non_grabbable_indices` are obstacles.\n  non_traversable_cells = np.zeros((grid_width, grid_height), dtype=bool)\n  for i_kind in world.non_grabbable_indices:\n      # Ensure the kind index is valid for the grid's dimension (n_kinds)\n      if i_kind < grid.shape[2]:\n          non_traversable_cells |= (grid[:, :, i_kind] > 0)\n\n  # Breadth-First Search (BFS) to find the shortest path from the agent's current position\n  # to any cell from which the primitive can be collected (i.e., adjacent to the primitive).\n  # The queue stores tuples: ((current_x_col, current_y_row), list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])])\n  # 'visited' set keeps track of explored positions to prevent cycles and redundant paths.\n  visited = {start_pos}\n\n  while q:\n      (curr_x, curr_y), path = q.popleft()\n\n      # Goal condition: If the current position (curr_x, curr_y) is adjacent to the primitive,\n      # we have found the shortest path to a valid collection spot.\n      if _is_adjacent_to_kind(curr_x, curr_y, primitive_kind_id):\n          # Return the sequence of movement actions to reach this spot, followed by the 'USE' action.\n          return path + [USE]\n\n      # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n      for (dx, dy), action in MOVE_ACTIONS:\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is:\n          # 1. Within grid boundaries\n          # 2. Not a non-traversable obstacle\n          # 3. Has not been visited yet (to find the shortest path)\n          if _is_in_bounds(next_x, next_y) and \\\n             not non_traversable_cells[next_x, next_y] and \\\n             next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path to the primitive (or an adjacent cell) is found,\n  # it indicates that the primitive is unreachable from the current state.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:13:19.216263", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n  Finds the shortest path to a location from which the agent can 'USE' to collect the specified primitive.\n  Considers non-grabbable entities as obstacles that cannot be traversed.\n  \"\"\"\n  # Retrieve essential environment and state information\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n  grid = current_state.grid\n  start_pos = current_state.pos  # Agent's current (x, y) coordinates, where x=column, y=row\n\n  # Map the DSL primitive name (e.g., 'WOOD', 'STONE') to its integer ID\n  # The DSL uses uppercase names, so ensure consistency.\n  primitive_kind_id = cookbook.index[primitive.upper()]\n\n  # Critical safety check: Ensure the primitive is actually something that can be picked up.\n  # Non-grabbable entities (like WATER, WORKSHOPs, BOUNDARY) cannot be 'collected'.\n  if primitive_kind_id not in world.grabbable_indices:\n      return [] # Return empty list if the item cannot be collected\n\n  # Define action mappings for clarity and robustness, retrieving them from the environment.\n  ACTION_UP = env.action_specs()['UP']\n  ACTION_DOWN = env.action_specs()['DOWN']\n  ACTION_LEFT = env.action_specs()['LEFT']\n  ACTION_RIGHT = env.action_specs()['RIGHT']\n  ACTION_USE = env.action_specs()['USE']\n\n  # Define possible movement deltas (change in x, change in y) and their corresponding actions.\n  # `grid` is (WIDTH, HEIGHT, n_kinds), and `pos` is (x, y) = (col, row).\n  # Therefore, dx is change in column, dy is change in row.\n  MOVEMENT_ACTIONS = {\n      (0, -1): ACTION_UP,    # Move up: decreases row (y)\n      (0, 1): ACTION_DOWN,   # Move down: increases row (y)\n      (-1, 0): ACTION_LEFT,  # Move left: decreases column (x)\n      (1, 0): ACTION_RIGHT,  # Move right: increases column (x)\n  }\n\n  # Helper function: Checks if the agent at (agent_x, agent_y) is adjacent to the target kind.\n  # This simulates the `CraftState.next_to` behavior for an arbitrary position.\n  def _is_adjacent_to_kind(agent_x, agent_y, target_kind_idx, current_grid, grid_width, grid_height):\n      # Iterate over a 3x3 neighborhood centered at (agent_x, agent_y)\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              nx, ny = agent_x + dx_adj, agent_y + dy_adj # Neighboring cell coordinates\n              # Check if the neighbor is within grid boundaries and contains the target kind\n              if 0 <= nx < grid_width and 0 <= ny < grid_height and current_grid[nx, ny, target_kind_idx] > 0:\n                  return True\n      return False\n\n  # Optimization: If the agent is already at a position where it can `USE` to collect the primitive,\n  # (i.e., the primitive is in its 3x3 neighborhood, including its own cell),\n  # then only the 'USE' action is required.\n  if current_state.next_to(primitive_kind_id):\n      return [ACTION_USE]\n\n  # Get grid dimensions (width corresponds to columns, height to rows)\n  grid_width, grid_height, _ = grid.shape\n\n  # Precompute obstacles: Create a boolean map of non-traversable cells.\n  # Cells containing any `non_grabbable_indices` items are considered obstacles.\n  is_obstacle = np.zeros((grid_width, grid_height), dtype=bool)\n  for obstacle_kind_id in world.non_grabbable_indices:\n      # Ensure the kind ID is valid for the current grid's 'n_kinds' dimension.\n      if obstacle_kind_id < grid.shape[2]:\n          is_obstacle |= (grid[:, :, obstacle_kind_id] > 0)\n\n  # Breadth-First Search (BFS) for finding the shortest path.\n  # The queue stores tuples: ((current_x, current_y), list_of_actions_to_reach_here).\n  q = collections.deque([(start_pos, [])])\n  # Set to keep track of visited positions to prevent cycles and redundant paths.\n  visited = {start_pos}\n\n  while q:\n      (curr_x, curr_y), path = q.popleft()\n\n      # Goal check: If the current position allows the agent to collect the primitive (is adjacent to it).\n      if _is_adjacent_to_kind(curr_x, curr_y, primitive_kind_id, grid, grid_width, grid_height):\n          # We found the shortest path to a suitable collection spot.\n          # Return the sequence of movement actions to reach this spot, followed by the 'USE' action.\n          return path + [ACTION_USE]\n\n      # Explore neighbors: Iterate through all four cardinal directions.\n      for (dx, dy), action in MOVEMENT_ACTIONS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within the grid boundaries.\n          if 0 <= next_x < grid_width and 0 <= next_y < grid_height:\n              # Check if the next position is traversable (not an obstacle) and has not been visited.\n              if not is_obstacle[next_x, next_y] and next_pos not in visited:\n                  visited.add(next_pos) # Mark as visited\n                  q.append((next_pos, path + [action])) # Add to queue for further exploration\n\n  # If the BFS completes and no path to the primitive (or an adjacent cell) is found,\n  # the primitive is deemed unreachable in the current grid configuration.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:14:28.520449", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get the integer ID for the primitive string\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Agent's initial direction (0=N, 1=E, 2=S, 3=W by convention)\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define action mappings\n  ACTION_MAP = {\n      'UP': env.action_specs()['UP'],\n      'DOWN': env.action_specs()['DOWN'],\n      'LEFT': env.action_specs()['LEFT'],\n      'RIGHT': env.action_specs()['RIGHT'],\n      'USE': env.action_specs()['USE']\n  }\n\n  # Define possible movements (delta_row, delta_column) and their corresponding action IDs.\n  # These deltas are for the agent's position change.\n  MOVE_DELTAS_AND_ACTIONS = [\n      ((-1, 0), ACTION_MAP['UP']),    # Move North (decreasing row)\n      ((1, 0), ACTION_MAP['DOWN']),   # Move South (increasing row)\n      ((0, -1), ACTION_MAP['LEFT']),  # Move West (decreasing col)\n      ((0, 1), ACTION_MAP['RIGHT']),  # Move East (increasing col)\n  ]\n\n  # Map a movement action ID to the direction the agent will face after that action.\n  # Assumed direction encoding: 0=North, 1=East, 2=South, 3=West.\n  ACTION_TO_FACING_DIR = {\n      ACTION_MAP['UP']: 0,      # Moving UP makes agent face North\n      ACTION_MAP['RIGHT']: 1,   # Moving RIGHT makes agent face East\n      ACTION_MAP['DOWN']: 2,    # Moving DOWN makes agent face South\n      ACTION_MAP['LEFT']: 3,    # Moving LEFT makes agent face West\n  }\n\n  # Map a facing direction to the (delta_row, delta_column) of the cell directly in front.\n  FACING_DIR_TO_DELTA = {\n      0: (-1, 0), # North (row - 1, col)\n      1: (0, 1),  # East (row, col + 1)\n      2: (1, 0),  # South (row + 1, col)\n      3: (0, -1)  # West (row, col - 1)\n  }\n\n  # Determine the required interaction type for the primitive.\n  # This dictates whether the agent needs to be ON the target square\n  # or ADJACENT and FACING the target square.\n  \n  target_is_grabbable = primitive_idx in env.world.grabbable_indices\n  target_is_workshop = primitive_idx in env.world.workshop_indices\n  \n  if target_is_grabbable:\n      # Grabbable items (e.g., WOOD, IRON, GRASS, ROCK, GOLD, GEM) are typically \"used\"\n      # by standing adjacent to them and facing them.\n      interaction_type = \"ADJACENT_AND_FACE\" \n  elif target_is_workshop:\n      # Workshops (WORKSHOP0, WORKSHOP1, WORKSHOP2) require the agent to be on the same square.\n      interaction_type = \"ON_SQUARE\"       \n  else:\n      # This covers other non-grabbable environment entities like WATER or STONE.\n      # For these, the goal is typically to reach their square.\n      # BOUNDARY should ideally not be a target for 'collect'.\n      interaction_type = \"ON_SQUARE\"\n\n  # Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: ((current_r, current_c), current_direction, path_of_actions_to_reach_current_state)\n  q = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant exploration.\n  visited = {((start_pos[0], start_pos[1]), start_dir)} \n\n  target_actions = []\n\n  while q:\n      (r, c), current_dir, path_to_current_state = q.popleft()\n\n      # --- Goal Check ---\n      # Check if the current state allows for interacting with the primitive.\n      found_goal_state = False\n      if interaction_type == \"ON_SQUARE\":\n          # If the agent is on the target primitive's square.\n          if grid[r, c, primitive_idx] > 0:\n              target_actions.extend(path_to_current_state)\n              target_actions.append(ACTION_MAP['USE']) \n              found_goal_state = True\n      elif interaction_type == \"ADJACENT_AND_FACE\":\n          # Calculate the coordinates of the cell directly in front of the agent.\n          dr_front, dc_front = FACING_DIR_TO_DELTA[current_dir]\n          nr_front, nc_front = r + dr_front, c + dc_front\n\n          # Check if this cell in front is within bounds and contains the primitive.\n          if (0 <= nr_front < grid_width and 0 <= nc_front < grid_height and\n              grid[nr_front, nc_front, primitive_idx] > 0):\n              target_actions.extend(path_to_current_state)\n              target_actions.append(ACTION_MAP['USE']) \n              found_goal_state = True\n      \n      if found_goal_state:\n          break # Found the nearest goal state (BFS guarantees shortest path in terms of steps)\n\n      # --- Explore Neighbors ---\n      # For each possible movement action\n      for (dr_move, dc_move), action_val in MOVE_DELTAS_AND_ACTIONS:\n          nr, nc = r + dr_move, c + dc_move # Calculate the new position after this move\n          new_dir = ACTION_TO_FACING_DIR[action_val] # Determine the agent's new facing direction\n\n          # Check if the new position is within grid boundaries\n          if not (0 <= nr < grid_width and 0 <= nc < grid_height):\n              continue\n\n          # Check if this (position, direction) state has already been visited\n          if ((nr, nc), new_dir) in visited:\n              continue\n\n          # Traversability check:\n          # A cell is traversable unless it contains a non-grabbable obstacle\n          # which is NOT our target primitive that we intend to move ONTO.\n          is_traversable = True\n          for k_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, k_idx] > 0: # If this cell contains a non-grabbable item\n                  if k_idx == primitive_idx and interaction_type == \"ON_SQUARE\":\n                      # It's the target primitive and we want to land on it, so it's traversable.\n                      pass \n                  else:\n                      # It's an obstacle (either not the target, or target but requires adjacency).\n                      is_traversable = False\n                      break\n          \n          if not is_traversable:\n              continue\n\n          # If the new state is traversable and not visited, add it to the queue\n          visited.add(((nr, nc), new_dir))\n          q.append(((nr, nc), new_dir, path_to_current_state + [action_val]))\n\n  return target_actions", "island_id": 8, "scores": {"3": 0.0}}
