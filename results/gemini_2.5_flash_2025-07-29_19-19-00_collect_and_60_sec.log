{"timestamp": "2025-07-29T19:56:19.206264", "function_name": "collect", "function_body": "  obs = env.observations()\n  current_state = obs['_current_state']\n  grid = current_state.grid\n  current_pos = current_state.pos\n  world = env.world\n  \n  primitive_id = world.cookbook.index[primitive]\n  empty_id = world.cookbook.index[\"empty\"]\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape # grid shape is (WIDTH, HEIGHT, n_kinds)\n\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define movement deltas for (dr, dc) for each action\n  # Mapping actual action integer to delta (row_change, col_change)\n  move_deltas = {\n      ACTION_UP: (-1, 0),    # Row decreases (move North)\n      ACTION_DOWN: (1, 0),   # Row increases (move South)\n      ACTION_LEFT: (0, -1),  # Col decreases (move West)\n      ACTION_RIGHT: (0, 1)   # Col increases (move East)\n  }\n  \n  # Determine if the primitive is a grabbable item that needs a 'USE' action\n  grabbable = primitive_id in world.grabbable_indices\n  \n  # Step 1: Identify all potential target positions for the agent.\n  # These are empty cells (where the agent can stand) that are adjacent to the primitive.\n  target_agent_positions = set()\n  \n  for r_obj in range(WIDTH): # Iterate through rows of the grid\n      for c_obj in range(HEIGHT): # Iterate through columns of the grid\n          # Check if the current cell (r_obj, c_obj) contains the primitive\n          if grid[r_obj, c_obj, primitive_id] > 0:\n              # This cell contains the primitive. Now, find adjacent empty cells where the agent can stand.\n              for dr, dc in move_deltas.values(): # Check 4-directional neighbors (UP, DOWN, LEFT, RIGHT)\n                  r_agent, c_agent = r_obj + dr, c_obj + dc\n                  \n                  # Check bounds for the potential agent position\n                  if not (0 <= r_agent < WIDTH and 0 <= c_agent < HEIGHT):\n                      continue\n                  \n                  # Check if this potential agent position is empty (agent can stand here)\n                  # The agent can only move onto empty cells. Interaction (USE) happens with adjacent cells.\n                  if grid[r_agent, c_agent, empty_id] > 0:\n                      target_agent_positions.add((r_agent, c_agent))\n  \n  # If no primitive found in the world or no reachable empty spots next to it, return an empty path.\n  if not target_agent_positions:\n      return []\n\n  # Step 2: Perform Breadth-First Search (BFS) to find the shortest path\n  # from the current agent position to any of the target_agent_positions.\n  \n  queue = collections.deque([(current_pos, [])]) # (current_position (tuple), path_actions (list))\n  visited = {current_pos} # Keep track of visited (row, col) positions to avoid loops and redundant paths\n\n  while queue:\n      (r, c), path = queue.popleft()\n      \n      # If the current position is one of our target positions, we found a path.\n      if (r, c) in target_agent_positions:\n          # If the primitive is grabbable, we need to add a 'USE' action at the end to collect it.\n          if grabbable:\n              return path + [ACTION_USE]\n          else:\n              # If non-grabbable (e.g., WORKSHOP), just reaching an adjacent empty cell is enough.\n              return path\n      \n      # Explore neighbors by trying all possible movement actions\n      for action_val, (dr, dc) in move_deltas.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n          \n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < WIDTH and 0 <= next_c < HEIGHT):\n              continue\n          \n          # Check if this position has already been visited in a shorter or equal path\n          if next_pos in visited:\n              continue\n          \n          # Check if the next cell is walkable (must be empty for the agent to move into it)\n          if grid[next_r, next_c, empty_id] > 0:\n              visited.add(next_pos)\n              queue.append((next_pos, path + [action_val]))\n                \n  # If the BFS queue becomes empty and no path was found to any target, return an empty list.\n  return []", "island_id": 4, "scores": {"3": -1}}
