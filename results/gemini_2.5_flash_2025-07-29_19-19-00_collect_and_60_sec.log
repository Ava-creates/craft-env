{"timestamp": "2025-07-29T21:15:21.648991", "function_name": "collect", "function_body": "  current_state = env._current_state\n  current_pos = current_state.pos  # Agent's current (x, y) position\n  current_dir = current_state.dir # Agent's current facing direction (int 0-3)\n  grid = current_state.grid\n  action_map = env.action_specs() # Maps action names (str) to their integer IDs\n\n  grid_width, grid_height, _ = grid.shape\n\n  # Convert primitive string name to its integer ID using the cookbook\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Determine if the primitive is grabbable (can be picked up into inventory)\n  is_primitive_grabbable = (primitive_id in env.world.grabbable_indices)\n\n  # --- Early Exit Optimization ---\n  # If the primitive is grabbable and already in the agent's inventory,\n  # no further actions are needed.\n  if is_primitive_grabbable and current_state.inventory[primitive_id] > 0:\n      return [] # Primitive already collected.\n\n  # Identify impassable obstacle IDs. These are entities on the grid that\n  # the agent cannot walk onto. 'water' and 'stone' are typically obstacles.\n  obstacle_ids = set()\n  if 'water' in env.world.cookbook.index:\n      obstacle_ids.add(env.world.cookbook.index['water'])\n  if 'stone' in env.world.cookbook.index:\n      obstacle_ids.add(env.world.cookbook.index['stone'])\n  \n  # Define movement actions: maps action ID to ((dx, dy), new_direction_id).\n  # Moving in a direction also sets the agent's facing direction to that direction.\n  action_to_delta_and_dir_id = {\n      action_map['UP']: ((0, -1), action_map['UP']),    # UP: (dx, dy), resulting_dir_id\n      action_map['DOWN']: ((0, 1), action_map['DOWN']),   # DOWN: (dx, dy), resulting_dir_id\n      action_map['LEFT']: ((-1, 0), action_map['LEFT']),  # LEFT: (dx, dy), resulting_dir_id\n      action_map['RIGHT']: ((1, 0), action_map['RIGHT']),  # RIGHT: (dx, dy), resulting_dir_id\n  }\n  \n  # Helper mapping: direction ID to its (dx, dy) vector.\n  # This is used to calculate the agent's position when facing a target.\n  dir_id_to_delta = {v[1]: v[0] for v in action_to_delta_and_dir_id.values()}\n\n  # Helper function to check if a grid position (x, y) is within bounds and walkable\n  def is_walkable(x, y):\n      # Check grid boundaries\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False \n      \n      # Check if the cell contains any known obstacle\n      for obs_id in obstacle_ids:\n          if grid[x, y, obs_id] > 0: # If the obstacle kind is present at this cell\n              return False\n      return True\n\n  # 1. Locate all occurrences of the primitive on the grid.\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_id] > 0:\n              primitive_locations.append((x, y))\n  \n  # If the primitive is not found anywhere on the map, it's unreachable.\n  if not primitive_locations:\n      return [] \n\n  # 2. Determine target collection states (agent_x, agent_y, required_facing_direction).\n  # A \"target collection state\" is a (position, direction) from which the agent can\n  # successfully interact with (e.g., USE or be adjacent to) the primitive.\n  # The 'USE' action in CraftWorld applies to the cell directly in front of the agent.\n  # So, if the primitive is at (px, py) and the agent is at (ax, ay) facing (px, py),\n  # then (px, py) = (ax + dx_face, ay + dy_face), implying (ax, ay) = (px - dx_face, py - dy_face).\n  target_collection_states = set()\n  for px, py in primitive_locations:\n      # Iterate through all possible facing directions (UP, DOWN, LEFT, RIGHT)\n      for facing_dir_id, (dx_face, dy_face) in dir_id_to_delta.items():\n          # Calculate the agent's position (ax, ay) such that it would face (px, py)\n          ax, ay = px - dx_face, py - dy_face\n          \n          # Only consider this as a valid target agent position if it's walkable\n          if is_walkable(ax, ay):\n              target_collection_states.add((ax, ay, facing_dir_id))\n\n  # If no valid collection points can be reached (e.g., primitive is surrounded by obstacles),\n  # or if no walkable path to them exists.\n  if not target_collection_states:\n      return []\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path to any\n  #    of the target collection states.\n  # Queue stores tuples: ((current_x, current_y, current_dir), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([((current_pos[0], current_pos[1], current_dir), [])]) \n  \n  # Set of visited states (x, y, dir) to prevent redundant exploration and cycles.\n  visited = {(current_pos[0], current_pos[1], current_dir)} \n\n  while queue:\n      (cx, cy, cdir), path_actions = queue.popleft()\n\n      # If the current state is one of our target collection states, we've found the shortest path.\n      if (cx, cy, cdir) in target_collection_states:\n          final_actions = list(path_actions) # Create a copy of the path found\n\n          # If the primitive is a grabbable item, an additional 'USE' action is required\n          # to pick it up. For non-grabbable entities like workshops, merely reaching\n          # the position and facing them is sufficient for \"collection\" (interaction).\n          if is_primitive_grabbable:\n              final_actions.append(action_map['USE'])\n          \n          return final_actions # Return the complete sequence of actions\n\n      # Explore all possible movement actions from the current state\n      for action_id, ((dx, dy), new_dir) in action_to_delta_and_dir_id.items():\n          nx, ny = cx + dx, cy + dy\n          new_state_tuple = (nx, ny, new_dir) # The state after taking this action\n\n          # Only proceed if the new position is walkable and this new state has not been visited yet\n          if is_walkable(nx, ny) and new_state_tuple not in visited:\n              visited.add(new_state_tuple)\n              queue.append((new_state_tuple, path_actions + [action_id]))\n\n  # If the queue becomes empty and no path to a target collection state was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:15:43.967855", "function_name": "collect", "function_body": "  p_idx = env.world.cookbook.index[primitive]\n\n  # Get the numerical action IDs from the environment's action_specs.\n  actions_map = env.action_specs()\n  MOVE_ACTIONS = [actions_map['DOWN'], actions_map['UP'], actions_map['LEFT'], actions_map['RIGHT']]\n  USE_ACTION = actions_map['USE']\n\n  # Get the current actual state of the environment.\n  initial_state = env._current_state\n\n  # Improvement 1 (from collect_v0): Ensure the primitive is actually grabbable.\n  # Non-grabbable entities like water, stone, or workshops cannot be 'collected' into inventory.\n  # If the item cannot be picked up, there's no path to \"collect\" it.\n  if p_idx not in env.world.grabbable_indices:\n      return []\n\n  # Optimization 1: If the primitive is already in inventory, no collection actions are needed.\n  if initial_state.inventory[p_idx] > 0:\n      return []\n\n  # Optimization 2: If the agent is already next to the primitive, only a USE action is needed.\n  # This covers cases where the agent spawns next to the item or has just moved to be next to it.\n  if initial_state.next_to(p_idx):\n      return [USE_ACTION]\n\n  # Initialize a queue for Breadth-First Search (BFS) and a set for visited states.\n  # Each item in the queue will be a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n  q = collections.deque()\n  # Visited states are represented by a hashable tuple: (position_tuple, direction_integer)\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  q.append((initial_state, []))\n  visited.add((initial_state.pos, initial_state.dir))\n\n  # Perform BFS to find the shortest path to a state where the primitive can be collected.\n  while q:\n    current_sim_state, path_actions = q.popleft()\n\n    # Explore all possible move actions from the current simulated state.\n    for action in MOVE_ACTIONS:\n      # Simulate taking the action. The `step` method of `CraftState` returns\n      # a reward (ignored here) and a new `CraftState` object reflecting the\n      # state after the action, handling movements, collisions, etc.\n      _, next_sim_state = current_sim_state.step(action)\n\n      # Create a hashable representation of the next simulated state for the 'visited' set.\n      next_pos_dir_tuple = (next_sim_state.pos, next_sim_state.dir)\n\n      # If this state (position and direction) has not been visited before, process it.\n      if next_pos_dir_tuple not in visited:\n        visited.add(next_pos_dir_tuple)\n        \n        # Check if, after this move, the agent is now adjacent to the primitive.\n        if next_sim_state.next_to(p_idx):\n            # If so, we've found the shortest path.\n            # Append the move action and then the USE action, and return the complete path.\n            return path_actions + [action, USE_ACTION]\n        \n        # If not yet adjacent, add this state to the queue to explore further.\n        q.append((next_sim_state, path_actions + [action]))\n\n  # If the BFS queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable in the current scenario.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:15:45.017726", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:16:49.895333", "function_name": "collect", "function_body": "  \"\"\"\n  Returns a list of actions to find and collect the primitive passed in the function\n  within the given environment. It uses Breadth-First Search (BFS) to find the shortest\n  sequence of actions.\n\n  Args:\n    env: The CraftLab environment instance.\n    primitive: A string name of the primitive item to collect (e.g., \"WOOD\", \"WORKSHOP0\").\n\n  Returns:\n    A list of integer actions (e.g., [UP, UP, USE]) to reach and collect the primitive.\n    Returns an empty list if the primitive is unreachable or not present.\n  \"\"\"\n  # Retrieve the integer ID for the target primitive from the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get the integer mapping for actions from the environment's action_specs.\n  action_to_int_map = env.action_specs()\n  ACTION_USE = action_to_int_map['USE']\n\n  # Define movement actions: (action_int: {'dr': row_delta, 'dc': col_delta, 'new_dir': resulting_direction})\n  # The 'new_dir' indicates the agent's facing direction after performing the move.\n  # Assuming direction integers map as: 0=UP, 1=DOWN, 2=LEFT, 3=RIGHT.\n  move_action_info = {\n      action_to_int_map['UP']:    {'dr': -1, 'dc': 0, 'new_dir': 0},\n      action_to_int_map['DOWN']:  {'dr': 1,  'dc': 0, 'new_dir': 1},\n      action_to_int_map['LEFT']:  {'dr': 0,  'dc': -1, 'new_dir': 2},\n      action_to_int_map['RIGHT']: {'dr': 0,  'dc': 1,  'new_dir': 3},\n  }\n\n  # Helper dictionary to get row/column deltas for a given direction.\n  dir_to_delta = {\n      0: (-1, 0), # UP\n      1: (1, 0),  # DOWN\n      2: (0, -1), # LEFT\n      3: (0, 1)   # RIGHT\n  }\n\n  # Get current state information from the environment.\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos # (row, col) tuple\n  start_dir = current_state.dir # Integer representing current facing direction\n  HEIGHT, WIDTH, N_KINDS = grid.shape # Dimensions of the grid and number of distinct item kinds.\n\n  # Determine if the target primitive is grabbable (can be picked up with USE).\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # Define a helper function to check if a cell (r, c) is traversable.\n  # A cell is traversable if it's within bounds and does not contain any\n  # non-grabbable obstacles (unless the obstacle *is* the target primitive itself,\n  # in which case we might need to move onto it, e.g., a WORKSHOP).\n  def is_traversable(r, c):\n      # Check grid boundaries.\n      if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n          return False # Out of bounds.\n      \n      # Iterate through all possible item kinds at (r,c) to check for obstacles.\n      for k in range(N_KINDS):\n          if grid[r, c, k] == 1: # If this kind 'k' is present at (r,c)\n              # If 'k' is a non-grabbable item and it's NOT the primitive we are trying to collect,\n              # then this cell is an obstacle and cannot be traversed.\n              if k in env.world.non_grabbable_indices and k != primitive_id:\n                  return False # Obstacle found.\n      return True # Cell is traversable.\n\n  # Initialize BFS queue and visited set.\n  # Queue stores (row, col, direction, path_actions_to_reach_this_state).\n  # Visited set stores (row, col, direction) tuples to avoid cycles and redundant exploration.\n  q = collections.deque()\n  visited = set()\n\n  # Add the initial agent state to the queue if it's traversable.\n  if is_traversable(start_pos[0], start_pos[1]):\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      visited.add((start_pos[0], start_pos[1], start_dir))\n  else:\n      # If the starting position itself is an obstacle, no path is possible.\n      return []\n\n  # Start BFS traversal.\n  while q:\n      curr_r, curr_c, curr_d, path_actions = q.popleft()\n\n      # Check if the current state satisfies the goal condition.\n      if is_grabbable:\n          # For grabbable items, the agent needs to be on the item's cell or\n          # directly facing it to use the ACTION_USE.\n\n          # 1. Check if the primitive is on the agent's current cell.\n          if grid[curr_r, curr_c, primitive_id] == 1:\n              return path_actions + [ACTION_USE]\n\n          # 2. Check the cell directly in front of the agent (based on current direction).\n          front_r, front_c = curr_r + dir_to_delta[curr_d][0], curr_c + dir_to_delta[curr_d][1]\n\n          # Ensure the cell in front is within grid bounds and contains the primitive.\n          if (0 <= front_r < HEIGHT and 0 <= front_c < WIDTH) and \\\n             grid[front_r, front_c, primitive_id] == 1:\n              return path_actions + [ACTION_USE]\n      else:\n          # For non-grabbable items (e.g., workshops, water), simply being adjacent\n          # (within a 3x3 neighborhood, including the current cell) is sufficient.\n          # No ACTION_USE is required for these.\n          for dr_adj in [-1, 0, 1]:\n              for dc_adj in [-1, 0, 1]:\n                  check_r, check_c = curr_r + dr_adj, curr_c + dc_adj\n\n                  # Ensure the checked cell is within grid bounds.\n                  if not (0 <= check_r < HEIGHT and 0 <= check_c < WIDTH):\n                      continue\n                  \n                  # If the primitive is located at (check_r, check_c).\n                  if grid[check_r, check_c, primitive_id] == 1:\n                      # If found, the path leading to (curr_r, curr_c) is sufficient,\n                      # as it implies adjacency (or being on) the non-grabbable primitive.\n                      return list(path_actions) # Return a copy of actions.\n\n      # Explore next possible states by trying all movement actions.\n      for action_int, info in move_action_info.items():\n          next_r, next_c = curr_r + info['dr'], curr_c + info['dc']\n          next_d = info['new_dir'] # Agent's direction updates to the direction of movement.\n\n          next_state_tuple = (next_r, next_c, next_d)\n\n          # Check if the next cell is traversable and if this specific state\n          # (position + direction) has not been visited yet.\n          if is_traversable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_r, next_c, next_d, path_actions + [action_int]))\n\n  # If the BFS completes and no path to collect the primitive is found,\n  # return an empty list, indicating the primitive is unreachable or not present on the map.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:16:50.897571", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n\n  action_to_int_map = env.action_specs()\n  ACTION_USE = action_to_int_map['USE']\n\n  # Define movement deltas and the new direction for each movement action.\n  # Assuming direction integers map as: 0=UP, 1=DOWN, 2=LEFT, 3=RIGHT.\n  move_action_info = {\n      action_to_int_map['UP']:    {'dr': -1, 'dc': 0, 'new_dir': 0},\n      action_to_int_map['DOWN']:  {'dr': 1,  'dc': 0, 'new_dir': 1},\n      action_to_int_map['LEFT']:  {'dr': 0,  'dc': -1, 'new_dir': 2},\n      action_to_int_map['RIGHT']: {'dr': 0,  'dc': 1,  'new_dir': 3},\n  }\n\n  # Helper for getting (dr, dc) from a direction integer\n  dir_to_delta = {\n      0: (-1, 0), # UP\n      1: (1, 0),  # DOWN\n      2: (0, -1), # LEFT\n      3: (0, 1)   # RIGHT\n  }\n\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos # (row, col)\n  start_dir = current_state.dir # Initial facing direction\n  HEIGHT, WIDTH, N_KINDS = grid.shape\n\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # A cell is traversable if it's within bounds and does not contain any generally impassable items.\n  # We assume items in `env.world.non_grabbable_indices` are impassable,\n  # UNLESS they are specifically `workshop_indices` (which are often traversable).\n  # This implies water, boundary, and certain stone types (if non-grabbable blocks) are impassable.\n  def is_traversable(r, c):\n      # Check grid boundaries first\n      if not (0 <= r < HEIGHT and 0 <= c < WIDTH):\n          return False # Out of bounds\n      \n      # Check if the cell contains any generally impassable obstacles.\n      # Iterate through all possible kinds that might be at (r,c)\n      for k in range(N_KINDS):\n          if grid[r, c, k] == 1: # If this kind 'k' is present at (r,c)\n              # If 'k' is a non-grabbable item AND it's NOT a workshop (which we treat as traversable)\n              # then it's an impassable obstacle.\n              if k in env.world.non_grabbable_indices and k not in env.world.workshop_indices:\n                  return False # Obstacle found (e.g., water, boundary, some stone types)\n      return True # Cell is traversable (or contains a traversable non-grabbable like a workshop)\n\n  q = collections.deque()\n  visited = set() # Stores (row, col, direction) tuples to prevent cycles and redundant exploration\n\n  # Start BFS from the agent's initial position and direction\n  # Only add the initial state if it's traversable.\n  if is_traversable(start_pos[0], start_pos[1]):\n      q.append((start_pos[0], start_pos[1], start_dir, []))\n      visited.add((start_pos[0], start_pos[1], start_dir))\n  else:\n      # If the starting position itself is an obstacle, no path is possible.\n      return []\n\n  while q:\n      curr_r, curr_c, curr_d, path_actions = q.popleft()\n\n      # Check if the current state (position and direction) satisfies the goal\n      if is_grabbable:\n          # For grabbable items, the agent must be on the item's cell or facing it to USE it.\n          \n          # 1. Check if the primitive is on the agent's current cell\n          if grid[curr_r, curr_c, primitive_id] == 1:\n              return path_actions + [ACTION_USE]\n\n          # 2. Check the cell directly in front of the agent (relative to current direction)\n          front_r, front_c = curr_r + dir_to_delta[curr_d][0], curr_c + dir_to_delta[curr_d][1]\n\n          # Ensure the cell in front is within grid bounds and contains the primitive\n          if (0 <= front_r < HEIGHT and 0 <= front_c < WIDTH) and\\\n             grid[front_r, front_c, primitive_id] == 1:\n              return path_actions + [ACTION_USE]\n      else:\n          # For non-grabbable items (e.g., workshops, water), simply being adjacent\n          # (within a 3x3 neighborhood, including the current cell) is sufficient.\n          # No ACTION_USE is typically required for these.\n          for dr_adj in [-1, 0, 1]:\n              for dc_adj in [-1, 0, 1]:\n                  check_r, check_c = curr_r + dr_adj, curr_c + dc_adj\n\n                  # Ensure the checked cell is within grid bounds\n                  if not (0 <= check_r < HEIGHT and 0 <= check_c < WIDTH):\n                      continue\n                  \n                  # If the primitive is located at (check_r, check_c)\n                  if grid[check_r, check_c, primitive_id] == 1:\n                      # If we found it, the path to curr_r, curr_c is sufficient.\n                      return list(path_actions) # Return a copy of actions\n\n      # Explore next possible states by trying movement actions\n      for action_int, info in move_action_info.items():\n          next_r, next_c = curr_r + info['dr'], curr_c + info['dc']\n          next_d = info['new_dir'] # Agent's direction updates to the direction of movement\n\n          next_state_tuple = (next_r, next_c, next_d)\n\n          # Check if the next cell is traversable and if this state (position + direction) has been visited\n          if is_traversable(next_r, next_c) and next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_r, next_c, next_d, path_actions + [action_int]))\n\n  # If the BFS completes and no path to collect the primitive is found,\n  # return an empty list, indicating the primitive is unreachable or not present.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:17:50.813652", "function_name": "collect", "function_body": "  actions_list = []\n\n  # Get current state and world information\n  initial_state = env._current_state\n  grid = initial_state.grid\n  start_pos = initial_state.pos\n  \n  # Get dimensions of the grid\n  width, height, _ = grid.shape\n\n  # Get action integer mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define movement actions and their corresponding (dx, dy)\n  move_deltas = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  # Get non-walkable entity indices from the world's cookbook.\n  # These are typically things like water, stone, workshops that block movement.\n  non_walkable_indices = env.world.cookbook.environment\n\n  # Helper function to check if a position is valid and walkable\n  def is_walkable(pos_x, pos_y):\n      # Check bounds\n      if not (0 <= pos_x < width and 0 <= pos_y < height):\n          return False\n      \n      # Check if any non-walkable entity is at this position.\n      # Assumes grid[x, y, kind_idx] > 0 means the entity is present\n      # and that entity's presence makes the cell non-walkable if it's in non_walkable_indices.\n      for kind_idx in non_walkable_indices:\n          if grid[pos_x, pos_y, kind_idx] > 0:\n              return False # Blocked by a non-walkable item\n      return True\n\n  # BFS initialization\n  q = collections.deque()\n  visited = set() # Stores (x, y) tuples of visited positions\n\n  # Queue stores (current_position, path_taken_to_reach_here)\n  q.append((start_pos, []))\n  visited.add(start_pos)\n\n  # BFS loop\n  while q:\n      current_pos, current_path = q.popleft()\n      cx, cy = current_pos\n\n      # Check if the primitive is within the 3x3 neighborhood of the current position.\n      # This mimics the CraftState.next_to() logic to determine if USE action can be applied.\n      found_adjacent_primitive = False\n      for dx_adj in [-1, 0, 1]:\n          for dy_adj in [-1, 0, 1]:\n              adj_x, adj_y = cx + dx_adj, cy + dy_adj\n              # Check bounds and if the primitive exists at this adjacent cell.\n              if 0 <= adj_x < width and 0 <= adj_y < height and grid[adj_x, adj_y, primitive] > 0:\n                  found_adjacent_primitive = True\n                  break\n          if found_adjacent_primitive:\n              break\n\n      if found_adjacent_primitive:\n          # Found a path to a position next to the primitive, add USE action and return the plan.\n          return current_path + [USE]\n\n      # Explore neighbors (move actions)\n      for action_val, (dx, dy) in move_deltas.items():\n          next_x, next_y = cx + dx, cy + dy\n          next_pos = (next_x, next_y)\n\n          if is_walkable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos)\n              q.append((next_pos, current_path + [action_val]))\n\n  # If BFS completes and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:17:51.780025", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index(primitive)\n  current_state = env._current_state\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  actions_map = env.action_specs()\n  UP = actions_map['UP']\n  DOWN = actions_map['DOWN']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  boundary_idx = env.world.cookbook.index(\"BOUNDARY\")\n\n  # BFS: (position_tuple, actions_path_list)\n  queue = collections.deque([((agent_r, agent_c), [])])\n  visited = {(agent_r, agent_c)}\n\n  # Delta R, Delta C for cardinal directions\n  dr = [-1, 1, 0, 0] # Corresponding to UP, DOWN, LEFT, RIGHT\n  dc = [0, 0, -1, 1]\n\n  # Map (dr, dc) to action\n  deltas_to_actions = {\n      (-1, 0): UP,\n      (1, 0): DOWN,\n      (0, -1): LEFT,\n      (0, 1): RIGHT\n  }\n\n  while queue:\n      (r, c), path_so_far = queue.popleft()\n\n      # Check if current position is a goal state for grabbable items\n      # If we are currently ON the grabbable item\n      if is_grabbable and grid[r, c, primitive_idx] > 0:\n          return path_so_far + [USE]\n\n      # Explore neighbors\n      for i in range(4):\n          nr, nc = r + dr[i], c + dc[i]\n          move_action = deltas_to_actions[(dr[i], dc[i])]\n\n          # Check bounds\n          if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n              continue\n\n          # Check if already visited\n          if (nr, nc) in visited:\n              continue\n\n          # Avoid moving onto a boundary cell unless the primitive itself is a boundary\n          if primitive_idx != boundary_idx and grid[nr, nc, boundary_idx] > 0:\n              continue\n\n          # Check if this neighbor cell contains the primitive\n          if grid[nr, nc, primitive_idx] > 0:\n              if is_grabbable:\n                  # If grabbable, the goal is to move TO this cell (nr, nc) and then USE.\n                  # The path_so_far gets us to (r, c). Add move_action to get to (nr, nc), then USE.\n                  return path_so_far + [move_action, USE]\n              else:\n                  # If not grabbable (e.g., workshop, water), the goal is to be ADJACENT to it.\n                  # Our current position (r, c) is adjacent to (nr, nc) which contains the primitive.\n                  # So, the path_so_far (to reach (r, c)) is sufficient. No USE action needed for non-grabbables.\n                  return path_so_far \n\n          # If neighbor is not the primitive itself, add to queue for further exploration\n          visited.add((nr, nc))\n          queue.append(((nr, nc), path_so_far + [move_action]))\n\n  # If no path found after exploring all reachable cells\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:18:33.690209", "function_name": "collect", "function_body": "  cookbook = env.world.cookbook\n  \n  # Get the integer ID for the specific primitive we are trying to collect.\n  primitive_id = cookbook.index.index(primitive)\n\n  # Access the current state of the environment.\n  current_state = env._current_state\n\n  # --- Pre-computation and Early Exits ---\n\n  # 1. Early Exit: If the primitive is already in the agent's inventory,\n  # there's no need to perform any collection actions.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # 2. Validation: Ensure the requested 'primitive' is actually a collectable resource.\n  # The 'collect' action is designed for gatherable items (e.g., WOOD, GRASS),\n  # not for fixed environment features like boundaries, water, or workshops.\n  if primitive_id not in cookbook.primitives:\n    # If it's not a recognized collectable primitive, return an empty action list.\n    return []\n\n  # --- Setup for Breadth-First Search (BFS) Pathfinding ---\n\n  agent_start_pos = current_state.pos  # Agent's current (row, column) position.\n  game_grid = current_state.grid       # The current state of the game grid.\n  # Grid dimensions: numpy arrays are typically (height, width, channels).\n  grid_height, grid_width, _ = game_grid.shape \n\n  # Get action mappings (integer IDs for actions) from the environment.\n  action_specs = env.action_specs()\n  \n  # Map (delta_row, delta_column) movement to their corresponding action ID.\n  # This defines the cardinal directions an agent can move.\n  cardinal_move_actions = {\n      (-1, 0): action_specs['UP'],    # Move North (row decreases)\n      (1, 0): action_specs['DOWN'],   # Move South (row increases)\n      (0, -1): action_specs['LEFT'],  # Move West (column decreases)\n      (0, 1): action_specs['RIGHT']   # Move East (column increases)\n  }\n  use_action_id = action_specs['USE'] # The action ID for using/collecting an item.\n\n  # Identify indices of entities that block agent movement.\n  # These are \"non-grabbable\" items that the agent cannot traverse through.\n  impassable_kind_ids = env.world.non_grabbable_indices\n\n  # BFS Queue: Stores tuples of (current_position (r, c), list_of_actions_to_reach_this_position).\n  bfs_queue = collections.deque([(agent_start_pos, [])])\n  \n  # Visited set: Keeps track of grid positions already explored to prevent cycles\n  # and ensure we find the shortest path.\n  visited_positions = {agent_start_pos} \n  \n  # Variables to store the result of the BFS.\n  path_to_collection_spot = None # Will store the shortest path if found.\n\n  # --- Perform BFS to Find Shortest Path to a Collection Spot ---\n  # A \"collection spot\" is any grid cell from which the target `primitive_id`\n  # is within the agent's 3x3 neighborhood (including the cell itself).\n  # This mirrors the logic of `CraftState.next_to(primitive_id)`.\n\n  while bfs_queue:\n    (current_r, current_c), path_so_far = bfs_queue.popleft()\n\n    # 1. Check if the current position is a \"collection spot\".\n    # Iterate through the 3x3 neighborhood centered at (current_r, current_c).\n    for dr_neighbor in [-1, 0, 1]:\n      for dc_neighbor in [-1, 0, 1]:\n        neighbor_r, neighbor_c = current_r + dr_neighbor, current_c + dc_neighbor\n\n        # Ensure the neighbor coordinates are within the grid boundaries.\n        if not (0 <= neighbor_r < grid_height and 0 <= neighbor_c < grid_width):\n          continue\n\n        # Check if the target primitive is present at this neighbor location.\n        if game_grid[neighbor_r, neighbor_c, primitive_id] == 1:\n          # If found, we've identified the closest collection spot.\n          path_to_collection_spot = path_so_far\n          bfs_queue.clear() # Clear the queue to stop BFS immediately.\n          break # Exit inner loop\n      if path_to_collection_spot is not None:\n        break # Exit middle loop\n    if path_to_collection_spot is not None:\n      break # Exit main BFS loop\n\n    # 2. If not a collection spot, explore traversable cardinal neighbors for movement.\n    for (dr_move, dc_move), action_id in cardinal_move_actions.items():\n      next_r, next_c = current_r + dr_move, current_c + dc_move\n\n      # Boundary Check: Is the next position within the grid?\n      if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n        continue\n\n      # Obstacle Check: Is the next position blocked by an impassable item?\n      is_next_cell_obstacle = False\n      for obstacle_kind_id in impassable_kind_ids:\n        if game_grid[next_r, next_c, obstacle_kind_id] == 1:\n          is_next_cell_obstacle = True\n          break\n      if is_next_cell_obstacle:\n        continue # Skip this cell; it's blocked.\n\n      # Visited Check: Has this position already been visited in a shorter path?\n      if (next_r, next_c) not in visited_positions:\n        visited_positions.add((next_r, next_c))\n        # Add the new position and its accumulated path to the queue.\n        bfs_queue.append(((next_r, next_c), path_so_far + [action_id]))\n\n  # --- Construct the Final Action Sequence ---\n\n  if path_to_collection_spot is None:\n    # If BFS completes and no path to a collection spot was found,\n    # the primitive is unreachable from the agent's current position.\n    return [] \n\n  # The actions needed are:\n  # 1. The sequence of movements to reach the collection spot.\n  # 2. Followed by a single 'USE' action to collect the primitive.\n  actions_to_execute = path_to_collection_spot + [use_action_id]\n  \n  return actions_to_execute", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:18:34.658000", "function_name": "collect", "function_body": "  cookbook = env.world.cookbook\n  \n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_id = cookbook.index.index(primitive)\n\n  # Access the current game state from the environment wrapper.\n  current_state = env._current_state\n\n  # --- Early Exits and Input Validation ---\n  \n  # 1. Early exit: If the primitive is already in the agent's inventory,\n  # no collection actions are necessary.\n  if current_state.inventory[primitive_id] > 0:\n    return []\n\n  # 2. Validate: Ensure the requested item is indeed a 'primitive' (collectable resource)\n  # recognized by the cookbook. The 'collect' function is designed for gatherable resources\n  # (e.g., WOOD, IRON, GRASS), not fixed environmental features like BOUNDARY or WORKSHOP,\n  # which usually cannot be picked up.\n  if primitive_id not in cookbook.primitives:\n    # If it's not a recognized collectable primitive, return an empty list of actions.\n    # The agent cannot \"collect\" this type of item via the 'USE' action in this context.\n    return []\n\n  # --- Setup for Pathfinding using Breadth-First Search (BFS) ---\n  \n  agent_current_pos = current_state.pos  # Agent's current (row, column) position (tuple).\n  game_grid = current_state.grid       # The current grid layout: numpy.ndarray (height, width, n_kinds).\n  grid_height, grid_width, _ = game_grid.shape # Extract grid dimensions.\n\n  # Retrieve action mappings (integer IDs) for movement and 'USE' from the environment.\n  action_specs = env.action_specs()\n  cardinal_move_actions = {\n      (-1, 0): action_specs['UP'],    # Movement North: decreases row index\n      (1, 0): action_specs['DOWN'],   # Movement South: increases row index\n      (0, -1): action_specs['LEFT'],  # Movement West: decreases column index\n      (0, 1): action_specs['RIGHT']   # Movement East: increases column index\n  }\n  use_action_id = action_specs['USE']\n\n  # Identify entity indices that represent impassable terrain or obstacles for agent movement.\n  # These are entities explicitly marked as \"non-grabbable\" in the CraftWorld configuration,\n  # implying they cannot be walked through.\n  impassable_kind_ids = env.world.non_grabbable_indices\n\n  # BFS Queue: Stores tuples of (current_position (r, c), path_taken_so_far_as_action_list).\n  # We start the search from the agent's current position with an empty path.\n  bfs_queue = collections.deque([(agent_current_pos, [])])\n  \n  # Visited set: Keeps track of grid positions already explored to prevent redundant work\n  # and cycles, ensuring the shortest path is found.\n  visited_positions = {agent_current_pos} \n  \n  # Variables to store the shortest path once a collection spot is found.\n  shortest_path_to_collection_spot = []\n  collection_spot_found = False\n\n  # --- Perform Breadth-First Search (BFS) ---\n  # The objective is to find the shortest path (sequence of moves) to a 'collection spot'.\n  # A 'collection spot' is any grid cell (r, c) from which the target primitive can be\n  # 'USE'd. This means the primitive must be located within the 3x3 neighborhood of (r, c)\n  # (including (r, c) itself), which corresponds to the `CraftState.next_to(primitive_id)` condition.\n  \n  while bfs_queue:\n    (current_r, current_c), path_to_current_cell = bfs_queue.popleft()\n\n    # Step 1: Check the 3x3 neighborhood around the current cell for the primitive.\n    # If found, the current cell is a valid 'collection spot'.\n    for dr_neighbor in [-1, 0, 1]:\n      for dc_neighbor in [-1, 0, 1]:\n        neighbor_r, neighbor_c = current_r + dr_neighbor, current_c + dc_neighbor\n\n        # Ensure the potential primitive location is within grid boundaries.\n        if not (0 <= neighbor_r < grid_height and 0 <= neighbor_c < grid_width):\n          continue\n\n        # Check if the target primitive is present at this neighbor location in the grid.\n        # `game_grid[r, c, kind_id] == 1` indicates the presence of that kind.\n        if game_grid[neighbor_r, neighbor_c, primitive_id] == 1:\n          # If found, we've identified the closest collection spot!\n          # The path taken to reach (current_r, current_c) is the shortest path to this spot.\n          shortest_path_to_collection_spot = path_to_current_cell\n          collection_spot_found = True\n          break # Exit inner loop, primitive found in neighborhood.\n      if collection_spot_found:\n        break # Exit middle loop.\n    if collection_spot_found:\n      break # Exit main BFS loop; the shortest path to a collection spot is found.\n\n    # Step 2: If no primitive was found in the current cell's 3x3 neighborhood,\n    # continue exploring adjacent traversable cells to expand the search.\n    # We only consider cardinal movements (UP, DOWN, LEFT, RIGHT).\n    for (dr_move, dc_move), action_id in cardinal_move_actions.items():\n      next_r, next_c = current_r + dr_move, current_c + dc_move\n\n      # a. Boundary check: Ensure the next potential position is within the grid.\n      if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n        continue\n\n      # b. Obstacle check: Determine if the next position is traversable.\n      # A cell is considered an obstacle if it contains any of the entities listed in `impassable_kind_ids`.\n      is_next_cell_blocked = False\n      for obstacle_kind_id in impassable_kind_ids:\n        if game_grid[next_r, next_c, obstacle_kind_id] == 1:\n          is_next_cell_blocked = True\n          break\n      if is_next_cell_blocked:\n        continue # Skip this cell as it's blocked by an obstacle.\n\n      # c. Visited check: Avoid revisiting already explored positions to ensure we find\n      # the shortest path and prevent infinite loops.\n      if (next_r, next_c) not in visited_positions:\n        visited_positions.add((next_r, next_c))\n        # Add the next valid, unvisited position to the queue, along with the\n        # accumulated path to reach it (including the action just taken).\n        bfs_queue.append(((next_r, next_c), path_to_current_cell + [action_id]))\n\n  # --- Construct the Final Sequence of Actions ---\n\n  if not collection_spot_found:\n    # If the BFS completes and no collection spot was found, it implies that the primitive\n    # is either not present on the map, or it is unreachable from the agent's current position\n    # due to obstacles.\n    return [] \n\n  # The complete sequence of actions required to collect the primitive is:\n  # 1. The movement path (shortest_path_to_collection_spot) to reach the identified collection spot.\n  # 2. A single 'USE' action performed once the agent arrives at that spot to gather the primitive.\n  actions_to_execute = shortest_path_to_collection_spot + [use_action_id]\n  \n  return actions_to_execute", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:19:42.054528", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get the integer ID for the primitive string (e.g., \"WOOD\", \"WORKSHOP0\")\n  # The `primitive` argument here will be a string (e.g., \"WOOD\", \"WORKSHOP0\")\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  start_pos = current_state.pos # (col, row)\n  start_dir = current_state.dir # Agent's initial direction (0:North, 1:East, 2:South, 3:West)\n  grid = current_state.grid\n  # grid shape is (WIDTH, HEIGHT, n_kinds). In numpy, this means (columns, rows, n_kinds).\n  # We'll use (row, col) internally for BFS for easier conceptualization.\n  # So, grid[row, col, kind_idx].\n  grid_width_cols, grid_height_rows, _ = grid.shape\n\n  # Define action mappings for movements and USE\n  ACTION_MAP = {\n      'UP': env.action_specs()['UP'],\n      'DOWN': env.action_specs()['DOWN'],\n      'LEFT': env.action_specs()['LEFT'],\n      'RIGHT': env.action_specs()['RIGHT'],\n      'USE': env.action_specs()['USE']\n  }\n\n  # Map (delta_row, delta_col) for a move action to (action_id, new_agent_direction_int)\n  # When an agent moves, its direction is updated to face the direction of movement.\n  # Assuming (dr, dc) refers to (delta_row, delta_col) relative to (current_row, current_col)\n  # 0:North, 1:East, 2:South, 3:West\n  MOVE_ACTIONS_INFO = {\n      (-1, 0): (ACTION_MAP['UP'], 0),    # Move North (row-1, col), new dir = 0 (North)\n      (1, 0): (ACTION_MAP['DOWN'], 2),   # Move South (row+1, col), new dir = 2 (South)\n      (0, -1): (ACTION_MAP['LEFT'], 3),  # Move West (row, col-1), new dir = 3 (West)\n      (0, 1): (ACTION_MAP['RIGHT'], 1),  # Move East (row, col+1), new dir = 1 (East)\n  }\n  \n  # Map agent's current direction integer to (dr, dc) offset of the cell it is facing.\n  # This is for checking the cell to interact with using 'USE' action.\n  RELATIVE_DIR_TO_COORDS = {\n      0: (-1, 0), # North: (-1, 0) from current (row, col)\n      1: (0, 1),  # East: (0, 1) from current (row, col)\n      2: (1, 0),  # South: (1, 0) from current (row, col)\n      3: (0, -1)  # West: (0, -1) from current (row, col)\n  }\n\n  # Determine interaction type for the primitive\n  # Grabbable items (e.g., WOOD, IRON) typically require agent to be adjacent and face it.\n  # Workshops (e.g., BENCH) typically require agent to be on the same square.\n  target_is_grabbable = primitive_idx in env.world.grabbable_indices\n  target_is_workshop = primitive_idx in env.world.workshop_indices\n\n  if target_is_grabbable:\n      interaction_type = \"ADJACENT_AND_FACE\" # Agent needs to be next to it and face it\n  elif target_is_workshop:\n      interaction_type = \"ON_SQUARE\"       # Agent needs to be on the same square\n  else:\n      # For other non-grabbable entities listed as primitives (e.g., WATER, STONE as a fixed feature),\n      # assume \"ON_SQUARE\" interaction, meaning the goal is to reach that specific tile and 'USE'.\n      interaction_type = \"ON_SQUARE\"\n\n  # Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: (current_position (row, col), current_direction, path_of_actions_to_reach_this_state)\n  # Convert start_pos (col, row) to (row, col) for internal BFS use.\n  start_row, start_col = start_pos[1], start_pos[0]\n  q = collections.deque([((start_row, start_col), start_dir, [])])\n  # Visited set stores (position_row, position_col, direction) tuples to avoid redundant exploration of states\n  visited = {(start_row, start_col, start_dir)}\n\n  while q:\n      (r, c), current_dir, path = q.popleft()\n\n      # Check if the current state satisfies the goal condition\n      if interaction_type == \"ON_SQUARE\":\n          # If the current cell contains the primitive\n          # Note: grid is indexed as [col, row, kind_idx] by the problem description (WIDTH, HEIGHT).\n          # So we use grid[c, r, primitive_idx] for grid[col, row, kind_idx]\n          if grid[c, r, primitive_idx] > 0:\n              return path + [ACTION_MAP['USE']] # Path found, add USE action and return\n      else: # interaction_type == \"ADJACENT_AND_FACE\"\n          # Calculate the cell directly in front of the agent\n          dr_facing, dc_facing = RELATIVE_DIR_TO_COORDS[current_dir]\n          target_r, target_c = r + dr_facing, c + dc_facing\n          \n          # Ensure the target cell is within bounds (col, row)\n          if 0 <= target_c < grid_width_cols and 0 <= target_r < grid_height_rows:\n              # If the cell in front contains the primitive\n              # Note: grid is indexed as [col, row, kind_idx]\n              if grid[target_c, target_r, primitive_idx] > 0:\n                  return path + [ACTION_MAP['USE']] # Path found, add USE action and return\n\n      # Explore neighbor states (movement actions)\n      for (dr, dc), (action_val, new_dir) in MOVE_ACTIONS_INFO.items():\n          nr, nc = r + dr, c + dc # Calculate new neighbor position (row, col)\n\n          # Check if the neighbor is within grid boundaries (col, row)\n          if not (0 <= nc < grid_width_cols and 0 <= nr < grid_height_rows):\n              continue\n\n          # Check for traversability:\n          # A cell is considered traversable if it does not contain any 'environment' object\n          # (like walls, water, etc.) EXCEPT if that 'environment' object is our target primitive itself.\n          # This allows the agent to pathfind *to* a workshop, for example, which is in `environment`.\n          is_traversable = True\n          for k_idx in env.world.cookbook.environment:\n              # If the cell (nr, nc) contains an environment object that is NOT our target primitive\n              # Note: grid is indexed as [col, row, kind_idx]\n              if grid[nc, nr, k_idx] > 0 and k_idx != primitive_idx:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position_row, position_col, direction) state has already been visited\n          if (nr, nc, new_dir) in visited:\n              continue\n\n          # Add new state to queue and visited set\n          visited.add((nr, nc, new_dir))\n          q.append(((nr, nc), new_dir, path + [action_val]))\n  \n  # If the BFS completes and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:19:43.154385", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Get the integer ID for the primitive string\n  # The `primitive` argument here will be a string (e.g., \"WOOD\", \"WORKSHOP0\")\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n\n  # Define action mappings for movements and USE\n  ACTION_MAP = {\n      'UP': env.action_specs()['UP'],\n      'DOWN': env.action_specs()['DOWN'],\n      'LEFT': env.action_specs()['LEFT'],\n      'RIGHT': env.action_specs()['RIGHT'],\n      'USE': env.action_specs()['USE']\n  }\n\n  # Define possible movements (dr, dc) relative to current position and corresponding actions\n  MOVE_DIRS = {\n      (0, -1): ACTION_MAP['UP'],    # Move North (decreasing row)\n      (0, 1): ACTION_MAP['DOWN'],   # Move South (increasing row)\n      (-1, 0): ACTION_MAP['LEFT'],  # Move West (decreasing col)\n      (1, 0): ACTION_MAP['RIGHT'],  # Move East (increasing col)\n  }\n\n  # Determine if primitive_idx is a grabbable or workshop for specific interaction logic\n  primitive_is_grabbable = primitive_idx in env.world.grabbable_indices\n  primitive_is_workshop = primitive_idx in env.world.workshop_indices\n  \n  # For other primitives (like WATER, STONE) that might be goals just to reach a tile.\n  # This covers cases where primitive is neither explicitly grabbable nor a workshop,\n  # but interaction means being on its square and using.\n  primitive_is_location_based = not primitive_is_grabbable and not primitive_is_workshop\n\n  # Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: (current_position (r,c), path_of_actions_to_reach_current_position)\n  q = collections.deque([(start_pos, [])])\n  visited = {start_pos} # Set to store visited positions to avoid cycles and redundant checks\n\n  while q:\n      (r, c), path_to_current_pos = q.popleft()\n\n      # --- Goal Check for current position (r, c) ---\n      # Check if the current position (r,c) allows interaction with the primitive.\n      goal_achieved = False\n\n      if primitive_is_grabbable:\n          # For grabbable items, the agent must be ON the item's square to pick it up.\n          if grid[r, c, primitive_idx] > 0:\n              goal_achieved = True\n      elif primitive_is_workshop:\n          # For workshops, the agent needs to be on a square from which it can activate the workshop.\n          # This means the workshop must be in the agent's 3x3 neighborhood (including the current cell).\n          # This logic aligns with CraftState.next_to used for workshop interaction.\n          for dr_check in [-1, 0, 1]:\n              for dc_check in [-1, 0, 1]:\n                  nr_check, nc_check = r + dr_check, c + dc_check\n                  # Ensure checked cell is within grid bounds\n                  if 0 <= nr_check < grid_width and 0 <= nc_check < grid_height:\n                      if grid[nr_check, nc_check, primitive_idx] > 0:\n                          goal_achieved = True\n                          break # Found a workshop in the 3x3 neighborhood\n              if goal_achieved:\n                  break # Break outer loop if goal achieved\n      elif primitive_is_location_based:\n          # For other primitives, assume goal is to reach the square containing the primitive.\n          if grid[r, c, primitive_idx] > 0:\n              goal_achieved = True\n      \n      if goal_achieved:\n          # Path found, add USE action and return the complete action list\n          return path_to_current_pos + [ACTION_MAP['USE']]\n\n      # --- Explore neighbors ---\n      for (dr, dc), action_val in MOVE_DIRS.items():\n          nr, nc = r + dr, c + dc # Calculate new neighbor position\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nr < grid_width and 0 <= nc < grid_height):\n              continue\n\n          # Check if the neighbor has already been visited\n          if (nr, nc) in visited:\n              continue\n\n          # Check for traversability:\n          # A cell is considered non-traversable if it contains any 'environment' object\n          # (like walls, water, etc.) EXCEPT if that 'environment' object is our target primitive.\n          # This allows the agent to pathfind *onto* a workshop, for example, which might be in `environment`.\n          is_traversable = True\n          for k_idx in env.world.cookbook.environment:\n              # If the cell (nr, nc) contains an environment object that is NOT our target primitive\n              # then it is an obstacle.\n              if grid[nr, nc, k_idx] > 0 and k_idx != primitive_idx:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n\n          # If traversable and not visited, add to queue\n          visited.add((nr, nc))\n          q.append(((nr, nc), path_to_current_pos + [action_val]))\n  \n  # If the BFS completes and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:21:20.250426", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # 1. Get the integer ID for the primitive string\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # 2. Get current state information from the environment's internal state\n  current_state = env._current_state\n  start_pos = current_state.pos # (x, y) where x is the width-wise index, y is the height-wise index\n  start_dir = current_state.dir # Agent's initial direction (0:North, 1:East, 2:South, 3:West)\n  grid = current_state.grid\n  # Grid shape is (WIDTH, HEIGHT, n_kinds). `pos` is (x, y).\n  grid_width, grid_height, _ = grid.shape\n\n  # 3. Define action mappings for movements and USE based on env.action_specs()\n  ACTION_MAP = {\n      'UP': env.action_specs()['UP'],\n      'DOWN': env.action_specs()['DOWN'],\n      'LEFT': env.action_specs()['LEFT'],\n      'RIGHT': env.action_specs()['RIGHT'],\n      'USE': env.action_specs()['USE']\n  }\n\n  # Map (dx, dy) relative to current position to (action_id, new_agent_direction_int)\n  # When an agent moves, its direction is updated to face the direction of movement.\n  # dx: change in x-coordinate (width), dy: change in y-coordinate (height)\n  # Directions: 0:North (UP, dy=-1), 1:East (RIGHT, dx=+1), 2:South (DOWN, dy=+1), 3:West (LEFT, dx=-1)\n  MOVE_ACTIONS_INFO = {\n      (0, -1): (ACTION_MAP['UP'], 0),    # Move North (decreasing y-coordinate), new dir = 0 (North)\n      (0, 1): (ACTION_MAP['DOWN'], 2),   # Move South (increasing y-coordinate), new dir = 2 (South)\n      (-1, 0): (ACTION_MAP['LEFT'], 3),  # Move West (decreasing x-coordinate), new dir = 3 (West)\n      (1, 0): (ACTION_MAP['RIGHT'], 1),  # Move East (increasing x-coordinate), new dir = 1 (East)\n  }\n  \n  # Map direction integer to (dx_relative, dy_relative) for the cell directly in front of the agent.\n  # This is crucial for 'ADJACENT_AND_FACE' interaction type.\n  # dir_int: (dx_relative, dy_relative) from current (x, y)\n  RELATIVE_DIR_TO_FACING_CELL = {\n      0: (0, -1), # North: (x, y-1) from current (x, y)\n      1: (1, 0),  # East: (x+1, y) from current (x, y)\n      2: (0, 1),  # South: (x, y+1) from current (x, y)\n      3: (-1, 0)  # West: (x-1, y) from current (x, y)\n  }\n\n  # 4. Determine interaction type for the primitive based on its properties\n  # Grabbable items (like WOOD, IRON) require being adjacent and facing them.\n  # Workshops (like BENCH) require being on the same square.\n  # Other environment objects (like WATER, STONE) are treated as requiring being on the same square for 'collect'.\n  target_is_grabbable = primitive_idx in env.world.grabbable_indices\n  target_is_workshop = primitive_idx in env.world.workshop_indices\n  # This covers primitives like BOUNDARY, WATER, STONE, which are non-grabbable environment objects.\n  # If one of these is the `primitive` to `collect`, it implies reaching that square and using it.\n  target_is_other_environment_object = primitive_idx in env.world.non_grabbable_indices and not target_is_workshop\n\n  interaction_type = None\n  if target_is_grabbable:\n      interaction_type = \"ADJACENT_AND_FACE\"\n  elif target_is_workshop or target_is_other_environment_object:\n      interaction_type = \"ON_SQUARE\"\n  else:\n      # Fallback for any other type of primitive not explicitly categorized, assumes ON_SQUARE.\n      interaction_type = \"ON_SQUARE\" \n\n  # 5. Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: (current_position (x,y), current_direction, path_of_actions_to_reach_this_state)\n  q = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  # Visited set stores (position_x, position_y, direction) tuples to avoid redundant exploration of states\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n      (cx, cy), current_dir, path = q.popleft() # Current x, current y\n\n      # --- 6. Check if the current state satisfies the goal condition ---\n      # This check is performed *before* exploring neighbors, as the current state\n      # might be the goal state itself, or one step away from interaction.\n      if interaction_type == \"ON_SQUARE\":\n          # If the current cell (cx, cy) contains the primitive\n          if grid[cx, cy, primitive_idx] > 0:\n              return path + [ACTION_MAP['USE']] # Path found, add USE action and return\n      elif interaction_type == \"ADJACENT_AND_FACE\":\n          # Calculate the coordinates of the cell directly in front of the agent\n          dx_adj, dy_adj = RELATIVE_DIR_TO_FACING_CELL[current_dir]\n          target_nx, target_ny = cx + dx_adj, cy + dy_adj\n          \n          # Ensure the target cell is within grid boundaries\n          if 0 <= target_nx < grid_width and 0 <= target_ny < grid_height:\n              # If the cell in front contains the primitive\n              if grid[target_nx, target_ny, primitive_idx] > 0:\n                  return path + [ACTION_MAP['USE']] # Path found, add USE action and return\n      \n      # --- 7. Explore neighbor states (movement) ---\n      for (dx_move, dy_move), (action_val, new_dir) in MOVE_ACTIONS_INFO.items():\n          nx, ny = cx + dx_move, cy + dy_move # Calculate new neighbor position\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n              continue\n\n          # Check for traversability:\n          # A cell (nx, ny) is traversable if it does not contain any \"non-grabbable\"\n          # entity that is *not* our target primitive. This allows moving onto\n          # a workshop (a non-grabbable) if the workshop is the primitive, but blocks other obstacles.\n          is_traversable = True\n          # Iterate through indices of all non-grabbable items that act as obstacles to movement.\n          for k_idx in env.world.non_grabbable_indices: \n              # If the cell (nx, ny) contains a non-grabbable item (k_idx)\n              # AND that item is NOT the primitive we are trying to reach/collect\n              if grid[nx, ny, k_idx] > 0 and k_idx != primitive_idx:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has already been visited\n          if (nx, ny, new_dir) in visited:\n              continue\n\n          # Add new state to queue and visited set\n          visited.add((nx, ny, new_dir))\n          q.append(((nx, ny), new_dir, path + [action_val]))\n  \n  # 8. If the BFS completes and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T21:21:21.239910", "function_name": "collect", "function_body": "  import collections\n  # numpy is imported at the top level of the file as per the problem description.\n\n  # Get the integer ID for the primitive string\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  start_pos = current_state.pos # (row, col)\n  start_dir = current_state.dir # Agent's initial direction (0:North, 1:East, 2:South, 3:West)\n  grid = current_state.grid\n  # Grid shape is typically (rows, columns, kinds).\n  # The documentation states (WIDTH, HEIGHT, n_kinds), which might be confusing.\n  # Assuming standard numpy array indexing (row, col) where row is vertical, col is horizontal.\n  grid_height, grid_width, _ = grid.shape \n\n  # Define action mappings for movements and USE\n  ACTION_UP = env.action_specs()['UP']\n  ACTION_DOWN = env.action_specs()['DOWN']\n  ACTION_LEFT = env.action_specs()['LEFT']\n  ACTION_RIGHT = env.action_specs()['RIGHT']\n  ACTION_USE = env.action_specs()['USE']\n\n  # Define delta_row (dr) and delta_col (dc) for each cardinal direction\n  DR_NORTH, DC_NORTH = -1, 0\n  DR_SOUTH, DC_SOUTH = 1, 0\n  DR_WEST, DC_WEST = 0, -1\n  DR_EAST, DC_EAST = 0, 1\n\n  # Map (delta_row, delta_col) for a move action to (action_id, new_agent_direction_int)\n  # When an agent moves, its direction is updated to face the direction of movement.\n  # (dr, dc): (action_to_take, resulting_direction)\n  # Directions: 0:North (UP), 1:East (RIGHT), 2:South (DOWN), 3:West (LEFT)\n  MOVE_ACTIONS_INFO = {\n      (DR_NORTH, DC_NORTH): (ACTION_UP, 0),    # Move North (decrease row), new dir = 0 (North)\n      (DR_SOUTH, DC_SOUTH): (ACTION_DOWN, 2),   # Move South (increase row), new dir = 2 (South)\n      (DR_WEST, DC_WEST): (ACTION_LEFT, 3),  # Move West (decrease col), new dir = 3 (West)\n      (DR_EAST, DC_EAST): (ACTION_RIGHT, 1),  # Move East (increase col), new dir = 1 (East)\n  }\n  \n  # Map direction integer to (dr, dc) relative to current position to find the cell in front\n  # This is used for 'ADJACENT_AND_FACE' interaction type.\n  # dir_int: (dr_relative, dc_relative)\n  RELATIVE_DIR_TO_FACING_CELL = {\n      0: (DR_NORTH, DC_NORTH), # North: (r-1, c) from current (r, c)\n      1: (DR_EAST, DC_EAST),   # East: (r, c+1) from current (r, c)\n      2: (DR_SOUTH, DC_SOUTH), # South: (r+1, c) from current (r, c)\n      3: (DR_WEST, DC_WEST)    # West: (r, c-1) from current (r, c)\n  }\n\n  # Determine interaction type for the primitive\n  # Grabbable items (e.g., WOOD, IRON) require being adjacent and facing them.\n  # Workshops require being on the same square.\n  # Other primitives are assumed to be collected by being on their square.\n  target_is_grabbable = primitive_idx in env.world.grabbable_indices\n  target_is_workshop = primitive_idx in env.world.workshop_indices\n\n  interaction_type = \"ON_SQUARE\" # Default for collection/interaction (e.g., workshops)\n  if target_is_grabbable:\n      interaction_type = \"ADJACENT_AND_FACE\" # Agent needs to be next to it and face it\n\n  # Breadth-First Search (BFS) Initialization\n  # Queue stores tuples: (current_position (r,c), current_direction, path_of_actions_to_reach_this_state)\n  q = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n  # Visited set stores (position_r, position_c, direction) tuples to avoid redundant exploration of states\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n      (r, c), current_dir, path = q.popleft()\n\n      # --- Check if the current state satisfies the goal condition ---\n      # This check is performed *before* exploring neighbors, as the current state\n      # might be the goal state itself, or one step away.\n      if interaction_type == \"ON_SQUARE\":\n          # If the current cell (r, c) contains the primitive\n          if grid[r, c, primitive_idx] > 0:\n              return path + [ACTION_USE] # Path found, add USE action and return\n      elif interaction_type == \"ADJACENT_AND_FACE\":\n          # Calculate the coordinates of the cell directly in front of the agent\n          dr_adj, dc_adj = RELATIVE_DIR_TO_FACING_CELL[current_dir]\n          target_nr, target_nc = r + dr_adj, c + dc_adj\n          \n          # Ensure the target cell is within bounds\n          if 0 <= target_nr < grid_height and 0 <= target_nc < grid_width:\n              # If the cell in front contains the primitive\n              if grid[target_nr, target_nc, primitive_idx] > 0:\n                  return path + [ACTION_USE] # Path found, add USE action and return\n      \n      # --- Explore neighbor states ---\n      for (dr_move, dc_move), (action_val, new_dir) in MOVE_ACTIONS_INFO.items():\n          nr, nc = r + dr_move, c + dc_move # Calculate new neighbor position\n\n          # Check if the neighbor is within grid boundaries\n          if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n              continue\n\n          # Check for traversability:\n          # A cell (nr, nc) is traversable if it does not contain any \"non-grabbable\"\n          # entity (obstacles like walls, water, etc.) that is *not* our target primitive.\n          # This allows moving onto a workshop if the workshop is the primitive itself,\n          # but blocks other general obstacles.\n          is_traversable = True\n          # `env.world.non_grabbable_indices` contains all indices of entities that cannot be picked up (e.g., BOUNDARY, WATER, STONE, WORKSHOPS).\n          for k_idx in env.world.non_grabbable_indices: \n              # If the cell contains a non-grabbable item (k_idx) AND that item is NOT our target primitive\n              if grid[nr, nc, k_idx] > 0 and k_idx != primitive_idx:\n                  is_traversable = False\n                  break\n          if not is_traversable:\n              continue\n          \n          # Check if this (position, direction) state has already been visited\n          if (nr, nc, new_dir) in visited:\n              continue\n\n          # Add new state to queue and visited set\n          visited.add((nr, nc, new_dir))\n          q.append(((nr, nc), new_dir, path + [action_val]))\n  \n  # If the BFS completes and no path to the primitive was found\n  return []", "island_id": 8, "scores": {"3": 0.0}}
