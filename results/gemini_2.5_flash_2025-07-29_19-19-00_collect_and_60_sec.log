{"timestamp": "2025-07-29T20:16:32.841397", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  current_state_obj = env._current_state\n  inventory = current_state_obj.inventory\n  current_pos = current_state_obj.pos # (x, y)\n  grid = current_state_obj.grid # Grid is of shape (WIDTH, HEIGHT, n_kinds)\n  \n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # If the primitive is grabbable and already in inventory, no actions needed.\n  if is_grabbable and inventory[primitive_idx] > 0:\n    return []\n\n  # If the primitive is non-grabbable and we are already next to it, just use.\n  # This covers cases like workshops or water where interaction is adjacent.\n  if not is_grabbable and current_state_obj.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  # BFS Setup for pathfinding\n  queue = collections.deque([(current_pos, [])]) # (pos=(x,y), path_actions_list)\n  visited = {current_pos}\n  path_to_target_cell_actions = None\n  \n  # Impassable indices: Cells with these kinds are generally not traversable.\n  impassable_indices = env.world.non_grabbable_indices \n\n  while queue:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Target check based on primitive type\n    if is_grabbable:\n        # For grabbable items, the target is the cell *containing* the primitive.\n        # We need to move onto this cell to collect it.\n        # Check grid[x, y, primitive_idx]\n        if grid[curr_x, curr_y, primitive_idx] == 1:\n            path_to_target_cell_actions = path_so_far\n            break # Found path to the primitive itself\n    else: # Non-grabbable primitive (e.g., WATER, WORKSHOP)\n        # For non-grabbable items, the target is a cell *adjacent* to the primitive.\n        # Interaction (USE) happens from an adjacent cell.\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # N, S, W, E relative positions\n            nx, ny = curr_x + dx, curr_y + dy\n            # Check if neighbor is within bounds\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                # Check if neighbor contains the primitive using correct grid indexing\n                if grid[nx, ny, primitive_idx] == 1:\n                    path_to_target_cell_actions = path_so_far\n                    break # Found path to a cell adjacent to the primitive\n        if path_to_target_cell_actions is not None:\n            break # Break outer while loop if path found\n\n    # Explore neighbors\n    neighbors_data = [\n        ((curr_x, curr_y - 1), ACTION_UP),\n        ((curr_x, curr_y + 1), ACTION_DOWN),\n        ((curr_x - 1, curr_y), ACTION_LEFT),\n        ((curr_x + 1, curr_y), ACTION_RIGHT)\n    ]\n\n    for (nx, ny), action in neighbors_data:\n        # Check if neighbor is within grid bounds\n        if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n            continue\n        # Check if neighbor has already been visited\n        if (nx, ny) in visited:\n            continue\n\n        # Obstacle check: Agent cannot move onto cells containing non-grabbable items.\n        is_impassable_neighbor = False\n        for kind_idx in impassable_indices:\n            # Check if any impassable kind is at the neighbor cell using correct grid indexing\n            if grid[nx, ny, kind_idx] == 1:\n                is_impassable_neighbor = True\n                break\n        \n        if is_impassable_neighbor:\n            continue # Cannot move into this cell\n\n        # If the neighbor is traversable and not visited, add it to the queue\n        visited.add((nx, ny))\n        new_path = list(path_so_far)\n        new_path.append(action)\n        queue.append(((nx, ny), new_path))\n\n  actions = []\n  if path_to_target_cell_actions is not None:\n    actions.extend(path_to_target_cell_actions)\n    # Perform USE action after reaching the target cell/adjacent cell\n    actions.append(ACTION_USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T20:16:33.822378", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  current_state_obj = env._current_state\n  inventory = current_state_obj.inventory\n  current_pos_x, current_pos_y = current_state_obj.pos # (x, y)\n  initial_dir = current_state_obj.dir # Agent's current facing direction (e.g., 0 for North, 1 for East, etc.)\n  grid = current_state_obj.grid\n  \n  WIDTH, HEIGHT, _ = grid.shape # Grid is (WIDTH, HEIGHT, n_kinds) -> grid[x, y, kind]\n\n  # Constants for directions. Assuming a common convention for CraftState.dir:\n  # 0: North (Up, decreasing Y)\n  # 1: East (Right, increasing X)\n  # 2: South (Down, increasing Y)\n  # 3: West (Left, decreasing X)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # Mapping movement actions to (dx, dy) movement and the resulting facing direction.\n  # It is assumed that taking a movement action also makes the agent face that direction.\n  ACTION_TO_MOVE_DATA = { # (move_dx, move_dy, new_facing_dir)\n      ACTION_UP: (0, -1, DIR_NORTH),\n      ACTION_DOWN: (0, 1, DIR_SOUTH),\n      ACTION_LEFT: (-1, 0, DIR_WEST),\n      ACTION_RIGHT: (1, 0, DIR_EAST)\n  }\n\n  # Mapping facing direction (agent's `dir` attribute) to (dx, dy) of the cell *in front*.\n  FACING_DIR_TO_DELTA = {\n      DIR_NORTH: (0, -1),\n      DIR_EAST: (1, 0),\n      DIR_SOUTH: (0, 1),\n      DIR_WEST: (-1, 0)\n  }\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # 1. Initial Checks: If already collected (for grabbable items)\n  if is_grabbable and inventory[primitive_idx] > 0:\n    return [] # Already collected, no actions needed\n\n  # BFS Setup for pathfinding\n  # Queue stores: ((current_x, current_y), current_direction, list_of_actions_to_reach_here)\n  queue = collections.deque([((current_pos_x, current_pos_y), initial_dir, [])])\n  # Visited set stores ((x, y), dir) tuples to avoid cycles in the state space (position + direction).\n  visited = {((current_pos_x, current_pos_y), initial_dir)}\n\n  # Impassable indices: Cells containing these kinds are generally not traversable by the agent.\n  impassable_indices = env.world.non_grabbable_indices \n\n  while queue:\n    (cx, cy), c_dir, path_so_far = queue.popleft()\n\n    # 2. Goal Check for Current State:\n    # Check if the agent's current (position, direction) state satisfies the goal.\n\n    # If the primitive is grabbable:\n    # The agent needs to be ON the cell containing the primitive.\n    # The direction typically does not matter for picking up an item from the current cell.\n    if is_grabbable:\n      if grid[cx, cy, primitive_idx] == 1:\n        # Agent is on the primitive's cell, collect it.\n        return path_so_far + [ACTION_USE]\n    else:\n      # If the primitive is non-grabbable (e.g., WORKSHOP, WATER):\n      # The agent needs to be ADJACENT to it AND FACING it.\n      # Calculate the coordinates of the cell directly in front of the agent.\n      fx, fy = cx + FACING_DIR_TO_DELTA[c_dir][0], cy + FACING_DIR_TO_DELTA[c_dir][1]\n      \n      # Check if the cell in front is within bounds and contains the primitive.\n      if (0 <= fx < WIDTH and 0 <= fy < HEIGHT and grid[fx, fy, primitive_idx] == 1):\n        # Agent is adjacent to and correctly facing the non-grabbable primitive. Interact with it.\n        return path_so_far + [ACTION_USE]\n\n    # 3. Explore Neighbors (movement actions)\n    # For each possible movement action (UP, DOWN, LEFT, RIGHT):\n    for action, (move_dx, move_dy, new_facing_dir) in ACTION_TO_MOVE_DATA.items():\n      nx, ny = cx + move_dx, cy + move_dy # Calculate new position\n      \n      # Check if the new position is within grid boundaries.\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n        continue\n      \n      # Check if the new position contains any impassable items.\n      # Agent cannot move onto cells containing non-grabbable items.\n      is_impassable_cell = False\n      for kind_idx in impassable_indices:\n        if grid[nx, ny, kind_idx] == 1:\n          is_impassable_cell = True\n          break\n      \n      if is_impassable_cell:\n        continue # Cannot move into this cell\n\n      # Check if this new state (new position, new facing direction) has already been visited.\n      if ((nx, ny), new_facing_dir) in visited:\n        continue\n\n      # If valid and unvisited, add to the queue.\n      visited.add(((nx, ny), new_facing_dir))\n      new_path = list(path_so_far) # Create a new path list to avoid modifying shared references\n      new_path.append(action)\n      queue.append(((nx, ny), new_facing_dir, new_path))\n            \n  # If the BFS completes and no path to the primitive was found.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
