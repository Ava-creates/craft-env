{"timestamp": "2025-07-29T20:17:58.864382", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  current_state_obj = env._current_state\n  inventory = current_state_obj.inventory\n  current_pos = current_state_obj.pos # (x, y)\n  grid = current_state_obj.grid # Grid is of shape (WIDTH, HEIGHT, n_kinds)\n  \n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Determine if the primitive is grabbable or non-grabbable\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Get indices for specific tools that make certain \"impassable\" terrains passable\n  # These are used to dynamically determine if a grid cell is traversable based on inventory.\n  bridge_idx = env.world.cookbook.index.index('BRIDGE')\n  axe_idx = env.world.cookbook.index.index('AXE')\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n\n  # Early exit 1: If the primitive is grabbable and already in inventory, no actions needed.\n  if is_grabbable and inventory[primitive_idx] > 0:\n    return []\n\n  # Early exit 2: If the primitive is non-grabbable and we are already next to it, just use.\n  # This covers cases like workshops or water where interaction happens from an adjacent cell.\n  if not is_grabbable and current_state_obj.next_to(primitive_idx):\n    return [ACTION_USE]\n\n  # BFS Setup for pathfinding\n  # Queue stores tuples of (current_position, path_actions_list_so_far)\n  queue = collections.deque([(current_pos, [])])\n  # Visited set stores positions to avoid cycles and redundant exploration\n  visited = {current_pos}\n  path_to_target_cell_actions = None\n  \n  while queue:\n    (curr_x, curr_y), path_so_far = queue.popleft()\n\n    # Target check based on primitive type\n    if is_grabbable:\n        # For grabbable items, the target is the cell *containing* the primitive.\n        # We need to move onto this cell to \"collect\" it (which implies a final ACTION_USE).\n        if grid[curr_x, curr_y, primitive_idx] == 1:\n            path_to_target_cell_actions = path_so_far\n            break # Path to the primitive's location found\n    else: # Non-grabbable primitive (e.g., WORKSHOP, WATER)\n        # For non-grabbable items, the target is a cell *adjacent* to the primitive.\n        # Interaction (USE) happens from an adjacent cell.\n        # Check 4-directional neighbors of the current cell to see if any contain the primitive.\n        for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # N, S, W, E relative positions\n            nx, ny = curr_x + dx, curr_y + dy\n            # Check if neighbor is within bounds\n            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                # Check if this neighbor cell contains the target primitive\n                if grid[nx, ny, primitive_idx] == 1:\n                    path_to_target_cell_actions = path_so_far\n                    break # Path to a cell adjacent to the primitive found\n        if path_to_target_cell_actions is not None:\n            break # Break outer while loop if path found\n\n    # Explore neighbors of the current cell\n    neighbors_data = [\n        ((curr_x, curr_y - 1), ACTION_UP),\n        ((curr_x, curr_y + 1), ACTION_DOWN),\n        ((curr_x - 1, curr_y), ACTION_LEFT),\n        ((curr_x + 1, curr_y), ACTION_RIGHT)\n    ]\n\n    for (nx, ny), action in neighbors_data:\n        # Check if neighbor is within grid bounds\n        if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n            continue\n        # Check if neighbor has already been visited in the BFS\n        if (nx, ny) in visited:\n            continue\n\n        # Obstacle check: Determine if the neighbor cell is traversable.\n        # A cell is generally impassable if it contains certain non-grabbable items.\n        # However, some (WATER, STONE) can be traversed if the agent has the right tool in inventory.\n        is_impassable_neighbor = False\n        for kind_idx in env.world.non_grabbable_indices:\n            # Check if this neighbor cell (nx, ny) contains an obstacle of 'kind_idx'\n            if grid[nx, ny, kind_idx] == 1:\n                if kind_idx == water_idx:\n                    # Water is traversable if the agent has a BRIDGE\n                    if inventory[bridge_idx] == 0: \n                        is_impassable_neighbor = True\n                        break\n                elif kind_idx == stone_idx:\n                    # Stone is traversable if the agent has an AXE\n                    if inventory[axe_idx] == 0: \n                        is_impassable_neighbor = True\n                        break\n                else: \n                    # Other non-grabbables like WORKSHOP or BOUNDARY are always impassable.\n                    # Note: If the primitive itself is non-grabbable (e.g., WORKSHOP),\n                    # the agent cannot move *onto* it, only to an adjacent cell.\n                    is_impassable_neighbor = True\n                    break\n        \n        if is_impassable_neighbor:\n            continue # Cannot move into this cell, skip to next neighbor\n\n        # If the neighbor is traversable and not visited, add it to the queue\n        visited.add((nx, ny))\n        new_path = list(path_so_far)\n        new_path.append(action)\n        queue.append(((nx, ny), new_path))\n\n  actions = []\n  if path_to_target_cell_actions is not None:\n    actions.extend(path_to_target_cell_actions)\n    # After moving to the target cell (or adjacent to it for non-grabbables),\n    # perform the USE action to collect/interact with the primitive.\n    actions.append(ACTION_USE)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
