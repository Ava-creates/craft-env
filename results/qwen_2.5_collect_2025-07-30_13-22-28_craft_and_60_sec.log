{"timestamp": "2025-07-30T14:07:40.972177", "function_name": "craft", "function_body": "    initial_state = env._current_state\n\n    # Constants for actions (from CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Using collections.deque for BFS, assuming 'collections' is available in scope.\n    # If not, it would need to be imported at the module level (as per prompt rules,\n    # imports are not to be included in the function's body).\n\n    def _bfs_pathfinding(start_pos, target_predicate_func, grid, non_grabbable_indices, max_steps=200):\n        \"\"\"\n        Performs BFS to find a path from start_pos to a cell satisfying target_predicate_func.\n        Returns (path_actions, target_pos) or ([], None) if no path found.\n        path_actions are (UP, DOWN, LEFT, RIGHT).\n        \"\"\"\n        WIDTH, HEIGHT, _ = grid.shape\n        q = collections.deque([(start_pos, [])])  # (current_pos, path_actions)\n        visited = {start_pos}\n\n        while q:\n            (r, c), path_actions = q.popleft()\n\n            if len(path_actions) > max_steps:\n                continue\n\n            # Check if current position itself is the target\n            if target_predicate_func(r, c, grid):\n                return path_actions, (r, c)\n\n            # Explore neighbors (N, S, W, E moves for UP, DOWN, LEFT, RIGHT)\n            # Mapping (dr, dc) to action: (-1,0)=UP, (1,0)=DOWN, (0,-1)=LEFT, (0,1)=RIGHT\n            possible_moves = {\n                (-1, 0): UP,    # North\n                (1, 0): DOWN,   # South\n                (0, -1): LEFT,  # West\n                (0, 1): RIGHT,  # East\n            }\n\n            for (dr, dc), action_val in possible_moves.items():\n                next_r, next_c = r + dr, c + dc\n\n                if 0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and (next_r, next_c) not in visited:\n                    is_blocked = False\n                    for k in non_grabbable_indices:\n                        if grid[next_r, next_c, k] > 0:\n                            is_blocked = True\n                            break\n                    if is_blocked:\n                        continue\n\n                    visited.add((next_r, next_c))\n                    q.append(((next_r, next_c), path_actions + [action_val]))\n\n        return [], None  # No path found\n\n    def _plan_to_get_primitive(primitive_idx, current_state):\n        \"\"\"\n        Plans actions to move to and pick up a primitive.\n        Assumes primitive is on the grid and can be picked up by 'USE'.\n        Returns (list_of_actions, final_state_after_actions)\n        \"\"\"\n        total_actions = []\n        world = current_state.world\n        non_grabbable_indices = world.non_grabbable_indices\n\n        primitive_locations = []\n        WIDTH, HEIGHT, _ = current_state.grid.shape\n        for r in range(WIDTH):\n            for c in range(HEIGHT):\n                if current_state.grid[r, c, primitive_idx] > 0:\n                    primitive_locations.append((r, c))\n\n        if not primitive_locations:\n            return [], current_state  # Primitive not on grid\n\n        best_path_len = float('inf')\n        best_approach_actions = []\n        best_target_primitive_pos = None\n\n        # Find the primitive that can be reached with the shortest path to an adjacent cell\n        for target_primitive_pos in primitive_locations:\n            candidate_approach_cells = []\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                adj_r, adj_c = target_primitive_pos[0] + dr, target_primitive_pos[1] + dc\n                if 0 <= adj_r < WIDTH and 0 <= adj_c < HEIGHT:\n                    is_blocked = False\n                    for k_idx in non_grabbable_indices:\n                        if current_state.grid[adj_r, adj_c, k_idx] > 0:\n                            is_blocked = True\n                            break\n                    if not is_blocked:\n                        candidate_approach_cells.append((adj_r, adj_c))\n\n            for approach_cell_pos in candidate_approach_cells:\n                path_to_approach, _ = _bfs_pathfinding(current_state.pos,\n                                                       lambda r, c, g: (r, c) == approach_cell_pos,\n                                                       current_state.grid,\n                                                       non_grabbable_indices)\n                if path_to_approach is not None and (not best_approach_actions or len(path_to_approach) < best_path_len):\n                    best_path_len = len(path_to_approach)\n                    best_approach_actions = path_to_approach\n                    best_target_primitive_pos = target_primitive_pos\n\n        if not best_approach_actions:\n            return [], current_state  # Could not find a path to approach any primitive\n\n        # Simulate movement actions\n        temp_state = current_state\n        for action in best_approach_actions:\n            _, new_s = temp_state.step(action)\n            temp_state = new_s\n            total_actions.append(action)\n\n        # Agent is now adjacent to the primitive. Need to turn to face it, then USE.\n        agent_r, agent_c = temp_state.pos\n        target_r, target_c = best_target_primitive_pos\n\n        dx = target_c - agent_c\n        dy = target_r - agent_r\n\n        target_facing_dir = -1  # 0:East, 1:North, 2:West, 3:South\n        if dx == 1 and dy == 0: target_facing_dir = 0\n        elif dx == -1 and dy == 0: target_facing_dir = 2\n        elif dx == 0 and dy == -1: target_facing_dir = 1\n        elif dx == 0 and dy == 1: target_facing_dir = 3\n        else:\n            return [], current_state # Should not happen if adjacent\n\n        current_dir = temp_state.dir\n        actions_to_turn = []\n        turn_diff = (target_facing_dir - current_dir + 4) % 4  # Shortest turn\n        if turn_diff == 1: actions_to_turn.append(RIGHT)\n        elif turn_diff == 2: actions_to_turn.extend([RIGHT, RIGHT]) # 180 degrees\n        elif turn_diff == 3: actions_to_turn.append(LEFT)\n\n        for action in actions_to_turn:\n            _, new_s = temp_state.step(action)\n            temp_state = new_s\n            total_actions.append(action)\n\n        # Agent is now facing the primitive. Use it.\n        _, final_state = temp_state.step(USE)\n        total_actions.append(USE)\n        return total_actions, final_state\n\n    def _plan_to_craft(crafted_item_idx, current_state):\n        \"\"\"\n        Plans actions to move to a workshop and craft an item.\n        Assumes all ingredients are already in inventory.\n        Returns (list_of_actions, final_state_after_actions)\n        \"\"\"\n        total_actions = []\n        world = current_state.world\n        workshop_indices = world.workshop_indices\n        non_grabbable_indices = world.non_grabbable_indices\n\n        if not workshop_indices:\n            return [], current_state\n\n        workshop_locations = []\n        WIDTH, HEIGHT, _ = current_state.grid.shape\n        for r in range(WIDTH):\n            for c in range(HEIGHT):\n                for w_idx in workshop_indices:\n                    if current_state.grid[r, c, w_idx] > 0:\n                        workshop_locations.append((r, c))\n\n        if not workshop_locations:\n            return [], current_state\n\n        best_path_len = float('inf')\n        best_approach_actions = []\n        best_target_workshop_pos = None\n\n        # Find the nearest workshop that can be approached\n        for target_workshop_pos in workshop_locations:\n            candidate_approach_cells = []\n            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                adj_r, adj_c = target_workshop_pos[0] + dr, target_workshop_pos[1] + dc\n                if 0 <= adj_r < WIDTH and 0 <= adj_c < HEIGHT:\n                    is_blocked = False\n                    for k_idx in non_grabbable_indices:\n                        if current_state.grid[adj_r, adj_c, k_idx] > 0:\n                            is_blocked = True\n                            break\n                    if not is_blocked:\n                        candidate_approach_cells.append((adj_r, adj_c))\n\n            for approach_cell_pos in candidate_approach_cells:\n                path_to_approach, _ = _bfs_pathfinding(current_state.pos,\n                                                       lambda r, c, g: (r, c) == approach_cell_pos,\n                                                       current_state.grid,\n                                                       non_grabbable_indices)\n                if path_to_approach is not None and (not best_approach_actions or len(path_to_approach) < best_path_len):\n                    best_path_len = len(path_to_approach)\n                    best_approach_actions = path_to_approach\n                    best_target_workshop_pos = target_workshop_pos\n\n        if not best_approach_actions:\n            return [], current_state\n\n        # Simulate movement actions\n        temp_state = current_state\n        for action in best_approach_actions:\n            _, new_s = temp_state.step(action)\n            temp_state = new_s\n            total_actions.append(action)\n\n        # Agent is now adjacent to the workshop. Need to turn to face it, then USE.\n        agent_r, agent_c = temp_state.pos\n        target_r, target_c = best_target_workshop_pos\n\n        dx = target_c - agent_c\n        dy = target_r - agent_r\n\n        target_facing_dir = -1\n        if dx == 1 and dy == 0: target_facing_dir = 0\n        elif dx == -1 and dy == 0: target_facing_dir = 2\n        elif dx == 0 and dy == -1: target_facing_dir = 1\n        elif dx == 0 and dy == 1: target_facing_dir = 3\n        else:\n            return [], current_state\n\n        current_dir = temp_state.dir\n        actions_to_turn = []\n        turn_diff = (target_facing_dir - current_dir + 4) % 4\n        if turn_diff == 1: actions_to_turn.append(RIGHT)\n        elif turn_diff == 2: actions_to_turn.extend([RIGHT, RIGHT])\n        elif turn_diff == 3: actions_to_turn.append(LEFT)\n\n        for action in actions_to_turn:\n            _, new_s = temp_state.step(action)\n            temp_state = new_s\n            total_actions.append(action)\n\n        # Agent is now facing the workshop. Use it.\n        _, final_state = temp_state.step(USE)\n        total_actions.append(USE)\n        return total_actions, final_state\n\n    def _plan_for_item_recursive(target_item_idx, current_state):\n        \"\"\"\n        Recursively plans actions to acquire a target item.\n        Returns (list_of_actions, final_state_after_actions)\n        \"\"\"\n        # Base case: if item is already in inventory\n        if current_state.inventory[target_item_idx] > 0:\n            return [], current_state\n\n        cookbook = current_state.world.cookbook\n\n        # If it's a primitive, plan to collect it.\n        if target_item_idx in cookbook.primitives:\n            actions, new_state = _plan_to_get_primitive(target_item_idx, current_state)\n            # Check if primitive was successfully acquired\n            if new_state.inventory[target_item_idx] == current_state.inventory[target_item_idx]:\n                return [], current_state # Failed to get primitive\n            return actions, new_state\n        else:\n            # It's a craftable item.\n            recipe = cookbook.recipes.get(target_item_idx)\n            if not recipe:\n                return [], current_state  # Cannot craft this item (no recipe found)\n\n            total_actions = []\n\n            # Create a deep copy of the state for internal planning for this craft goal.\n            # This is important as sub-plans modify `planning_state`.\n            planning_state = initial_state.scenario.init() # Use scenario.init() to get a fresh state from scenario\n                                                           # then update its components from current_state to ensure fresh caches.\n            planning_state.grid = np.copy(current_state.grid)\n            planning_state.pos = current_state.pos\n            planning_state.dir = current_state.dir\n            planning_state.inventory = np.copy(current_state.inventory)\n\n\n            ingredients_to_get = {k: v for k, v in recipe.items() if k != \"_key\"}\n\n            for ingredient_idx, count_needed in ingredients_to_get.items():\n                current_has = planning_state.inventory[ingredient_idx]\n                while current_has < count_needed:\n                    # Recursively plan to get one more unit of the ingredient\n                    sub_actions, updated_planning_state = _plan_for_item_recursive(ingredient_idx, planning_state)\n\n                    # Check if the sub-plan failed or made no progress\n                    if not sub_actions and updated_planning_state.inventory[ingredient_idx] == planning_state.inventory[ingredient_idx]:\n                        return [], current_state  # Propagate failure up\n\n                    total_actions.extend(sub_actions)\n                    planning_state = updated_planning_state\n                    current_has = planning_state.inventory[ingredient_idx]\n\n            # After acquiring all ingredients, craft the item\n            craft_actions, final_state_after_craft = _plan_to_craft(target_item_idx, planning_state)\n\n            # Check if crafting failed or did not produce the item\n            if not craft_actions and final_state_after_craft.inventory[target_item_idx] == planning_state.inventory[target_item_idx]:\n                return [], current_state  # Propagate failure\n\n            total_actions.extend(craft_actions)\n            return total_actions, final_state_after_craft\n\n    # Start the planning process from the initial state provided by the environment\n    final_plan_actions, final_state = _plan_for_item_recursive(item, initial_state)\n\n    # Verify if the goal item was actually crafted\n    # The check is if the count of the item has increased from the initial state.\n    if final_state.inventory[item] > initial_state.inventory[item]:\n        return final_plan_actions\n    else:\n        return []  # Goal not achieved or plan failed", "island_id": 9, "scores": {"3": -1}}
