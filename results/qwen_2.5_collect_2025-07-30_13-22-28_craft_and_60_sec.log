{"timestamp": "2025-07-30T13:29:57.473349", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (based on CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  def get_state_hash(state):\n    \"\"\"Returns a hashable representation of a CraftState for BFS visited set.\"\"\"\n    # Convert numpy arrays to bytes for hashing, pos to tuple\n    return (\n        state.grid.tobytes(),\n        tuple(state.pos),\n        state.dir,\n        state.inventory.tobytes()\n    )\n\n  initial_state = env._current_state # Start from the current state of the environment\n\n  # Initialize BFS queue: (current_state, path_to_this_state)\n  # Path is a list of actions taken to reach current_state from initial_state\n  queue = collections.deque([(initial_state, [])])\n\n  # Initialize visited set: stores hashable representations of states already explored\n  visited = {get_state_hash(initial_state)}\n\n  # Maximum search depth to prevent excessively long searches for unachievable goals\n  # or very complex scenarios. This value may need tuning.\n  MAX_SEARCH_DEPTH = 100 \n\n  while queue:\n    current_state, path = queue.popleft()\n\n    # Pruning: If the current path exceeds the maximum depth, stop exploring this branch\n    if len(path) > MAX_SEARCH_DEPTH:\n      continue\n\n    # Check if the goal item has been crafted in the current state's inventory\n    # The 'goal_name' argument to satisfies is ignored by CraftState.satisfies\n    if current_state.satisfies(None, item):\n      return path # Goal achieved, return the sequence of actions\n\n    # Explore all possible actions from the current state\n    for action in ALL_ACTIONS:\n      # Simulate taking the action to get the next state\n      # CraftState.step returns (reward, new_state)\n      _, new_state = current_state.step(action)\n\n      new_state_hash = get_state_hash(new_state)\n\n      # If this new state has not been visited, add it to the queue and visited set\n      if new_state_hash not in visited:\n        visited.add(new_state_hash)\n        queue.append((new_state, path + [action]))\n\n  # If the queue becomes empty and the goal was not satisfied,\n  # it means no path was found within the search limits.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:32:55.276522", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Constants for actions as defined by CraftLab's action_specs\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n  _ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT, _USE]\n\n  def _hash_craft_state(state):\n      \"\"\"\n      Creates a hashable representation of a CraftState for use in a set or as a dictionary key.\n      Numpy arrays (grid, inventory) are not hashable, so they are converted to bytes.\n      The position (pos) and direction (dir) are already hashable.\n      \"\"\"\n      return (\n          state.grid.tobytes(),\n          state.inventory.tobytes(),\n          state.pos,\n          state.dir\n      )\n\n  # Reset the environment to a known initial state.\n  # Using seed=0 ensures a deterministic starting point for the search.\n  env.reset(seed=0)\n  initial_state = env._current_state # Get the initial CraftState object\n\n  # If the item is already in the inventory at the start, no actions are needed.\n  if initial_state.satisfies(None, item):\n      return []\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple:\n  # (current_CraftState, list_of_actions_taken_to_reach_this_state)\n  queue = deque()\n  queue.append((initial_state, []))\n\n  # Initialize a set to store visited states to prevent infinite loops and\n  # redundant computations. States are hashed using the _hash_craft_state helper.\n  visited = set()\n  visited.add(_hash_craft_state(initial_state))\n\n  # Define a maximum path length to prevent excessively long searches,\n  # especially in cases where the item might be unreachable or require a very complex sequence.\n  # This is a heuristic to bound computation time.\n  MAX_PATH_LENGTH = 150 \n\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # If the current path has exceeded the maximum allowed length,\n      # skip this branch to manage the search depth.\n      if len(current_path) >= MAX_PATH_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for action in _ACTIONS:\n          # Simulate the action to get the next state.\n          # CraftState.step returns (reward, new_state). The reward is 0.0 for this problem.\n          _, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_state_hash = _hash_craft_state(next_state)\n\n          # If this state has already been visited, skip it to avoid cycles and redundant work.\n          if next_state_hash in visited:\n              continue\n\n          # Check if the goal item is satisfied (i.e., in inventory) in the next state.\n          if next_state.satisfies(None, item):\n              # Goal reached! Return the complete sequence of actions.\n              return current_path + [action]\n\n          # Mark the next state as visited and add it to the queue for further exploration.\n          visited.add(next_state_hash)\n          queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no path was found\n  # within the explored state space and path length limit.\n  return []", "island_id": 3, "scores": {"3": -1}}
