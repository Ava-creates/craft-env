{"timestamp": "2025-07-30T13:59:43.113081", "function_name": "craft", "function_body": "  initial_craft_state = env._current_state\n\n  # State representation for visited set: (grid_tuple, inventory_tuple, pos, dir)\n  # Convert numpy arrays to tuples for hashing.\n  initial_grid_hashable = tuple(initial_craft_state.grid.flatten())\n  initial_inventory_hashable = tuple(initial_craft_state.inventory)\n  initial_state_tuple = (initial_grid_hashable, initial_inventory_hashable,\n                         initial_craft_state.pos, initial_craft_state.dir)\n\n  # BFS queue: stores (current_CraftState_object, path_taken_to_reach_this_state)\n  q = collections.deque()\n  q.append((initial_craft_state, []))\n\n  # Set of visited states to prevent cycles and redundant computation\n  visited_states = {initial_state_tuple}\n\n  # Goal item index\n  goal_item_index = item\n\n  # Maximum number of actions to prevent infinite loops or excessively long searches\n  # This limit might need adjustment based on typical task complexity.\n  MAX_SEARCH_DEPTH = 100 \n\n  # Get the number of possible actions from the world configuration\n  num_possible_actions = env.world.n_actions\n\n  while q:\n    current_state_obj, current_path = q.popleft()\n\n    # Check if the goal is satisfied in the current state\n    # CraftState.satisfies expects goal_name and goal_arg. Here goal_name is not relevant.\n    if current_state_obj.satisfies(None, goal_item_index):\n      return current_path\n\n    # Prune paths that exceed the maximum allowed length\n    if len(current_path) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state\n    for action in range(num_possible_actions):\n      # Apply the action to get the next state\n      # CraftState.step returns (reward, new_state). Reward is always 0.0 here.\n      _, next_state_obj = current_state_obj.step(action)\n\n      # Create hashable representation of the next state\n      next_grid_hashable = tuple(next_state_obj.grid.flatten())\n      next_inventory_hashable = tuple(next_state_obj.inventory)\n      next_state_tuple = (next_grid_hashable, next_inventory_hashable,\n                          next_state_obj.pos, next_state_obj.dir)\n\n      # If this state has not been visited before, add it to the queue\n      if next_state_tuple not in visited_states:\n        visited_states.add(next_state_tuple)\n        new_path = current_path + [action]\n        q.append((next_state_obj, new_path))\n\n  # If the queue is empty and the goal was not reached, no path was found\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:59:43.131568", "function_name": "craft", "function_body": "    # Action constants (from action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Direction constants (CraftState.dir)\n    # 0: down, 1: up, 2: left, 3: right (standard for CraftWorld)\n    DIR_DOWN = 0\n    DIR_UP = 1\n    DIR_LEFT = 2\n    DIR_RIGHT = 3\n\n    # Mapping directions to delta_x, delta_y (x, y)\n    DIR_TO_DELT = {\n        DIR_DOWN: (0, 1),\n        DIR_UP: (0, -1),\n        DIR_LEFT: (-1, 0),\n        DIR_RIGHT: (1, 0),\n    }\n\n    # Mapping delta_x, delta_y to directions (for inverse lookup)\n    DELT_TO_DIR = {v: k for k, v in DIR_TO_DELT.items()}\n\n    # Mapping directions to actions to face them\n    # In Craft, performing a move action in a direction also changes facing to that direction.\n    # If you are already at the adjacent cell but not facing the target, performing the\n    # \"move\" action corresponding to the target direction will turn you.\n    DIR_TO_FACE_ACTION = {\n        DIR_DOWN: DOWN,\n        DIR_UP: UP,\n        DIR_LEFT: LEFT,\n        DIR_RIGHT: RIGHT,\n    }\n\n    # Helper functions nested within craft_v2.\n\n    def _get_entity_positions(grid, kind_idx):\n        \"\"\"Returns a list of (x, y) tuples where kind_idx is present on the grid.\n        Grid is assumed to be (HEIGHT, WIDTH, n_kinds).\"\"\"\n        positions = []\n        # np.where returns (row_indices, col_indices, kind_indices)\n        # We want (x,y) for kind_idx, so x corresponds to column, y to row\n        y_coords, x_coords = np.where(grid[:, :, kind_idx] > 0)\n        for i in range(len(x_coords)):\n            positions.append((x_coords[i], y_coords[i]))\n        return positions\n\n    def _is_walkable(x, y, grid, non_grabbable_indices):\n        \"\"\"Checks if a cell (x, y) is within bounds and not occupied by a non-grabbable item.\n        Grid is assumed to be (HEIGHT, WIDTH, n_kinds).\"\"\"\n        HEIGHT, WIDTH, _ = grid.shape\n        if not (0 <= x < WIDTH and 0 <= y < HEIGHT): # Check bounds (x against WIDTH, y against HEIGHT)\n            return False\n        # Check if the cell contains any non-grabbable item\n        for i_kind in non_grabbable_indices:\n            # grid[y, x, i_kind] checks the occupancy at (x,y) for kind i_kind\n            if grid[y, x, i_kind] > 0:\n                return False\n        return True\n\n    def _get_path_bfs(start_pos, target_pos, grid, non_grabbable_indices):\n        \"\"\"\n        Performs a BFS to find the shortest path from start_pos to target_pos.\n        Returns a list of (x, y) positions in the path, or None if no path.\n        \"\"\"\n        q = collections.deque([(start_pos, [start_pos])])\n        visited = {start_pos}\n\n        while q:\n            (curr_x, curr_y), path = q.popleft()\n\n            if (curr_x, curr_y) == target_pos:\n                return path\n\n            # Explore neighbors: (dx, dy) -> (new_x, new_y)\n            # Order: Down, Up, Right, Left (standard for some environments, ensures deterministic path)\n            for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                if _is_walkable(next_x, next_y, grid, non_grabbable_indices) and next_pos not in visited:\n                    visited.add(next_pos)\n                    q.append((next_pos, path + [next_pos]))\n        return None\n\n    def _actions_to_move_along_path(start_pos, start_dir, path_nodes):\n        \"\"\"\n        Given a path (list of positions) and initial position/direction, returns actions\n        to follow the path.\n        Returns: (list of actions, final_pos, final_dir)\n        \"\"\"\n        actions = []\n        current_pos = start_pos\n        current_dir = start_dir\n\n        if not path_nodes or path_nodes[0] != current_pos:\n            return [], current_pos, current_dir # Path must start at current_pos\n\n        for i in range(len(path_nodes) - 1):\n            prev_x, prev_y = path_nodes[i]\n            next_x, next_y = path_nodes[i+1]\n\n            dx, dy = next_x - prev_x, next_y - prev_y\n\n            # Determine the move action and target direction\n            move_action = None\n            target_dir = None\n            for d_dir, d_delt in DIR_TO_DELT.items():\n                if d_delt == (dx, dy):\n                    move_action = d_dir # Action to move in that direction (coincidentally matches dir value)\n                    target_dir = d_dir\n                    break\n            \n            if move_action is None:\n                # Should not happen for a valid path\n                return [], current_pos, current_dir\n\n            actions.append(move_action)\n            current_pos = (next_x, next_y)\n            current_dir = target_dir # Agent's direction changes to movement direction\n\n        return actions, current_pos, current_dir\n\n    def _get_actions_to_use_target(current_sim_state, target_pos):\n        \"\"\"\n        Gets actions to move adjacent to target_pos and use it.\n        Returns: (list of actions, new_sim_state after actions) or ([], None) if impossible.\n        \"\"\"\n        actions = []\n        agent_pos = current_sim_state.pos\n        agent_dir = current_sim_state.dir\n        grid = current_sim_state.grid\n        world = current_sim_state.world\n        non_grabbable_indices = world.non_grabbable_indices\n\n        tx, ty = target_pos\n        \n        best_path = None\n        target_adj_pos = None\n        final_face_dir = None\n\n        # Check all 4 adjacent cells to the target for a suitable position to stand.\n        # (adj_x_offset, adj_y_offset) is the offset from the target to the agent's desired standing position.\n        # This implies the agent's desired facing direction will be the opposite of this offset.\n        # The values here are (dx from target to adjacent, dy from target to adjacent, corresponding face dir)\n        # e.g., if target is (1,1), and we want to stand at (0,1), offset is (-1,0).\n        # From (0,1), we need to face (1,1), which is RIGHT.\n        # So: ((-1,0), DIR_RIGHT) means: if agent is at (tx-1, ty), it must face DIR_RIGHT to hit target.\n        potential_adj_info = [\n            ((-1, 0), DIR_RIGHT), # Agent stands left of target, faces right\n            ((1, 0), DIR_LEFT),   # Agent stands right of target, faces left\n            ((0, -1), DIR_DOWN),  # Agent stands above target, faces down\n            ((0, 1), DIR_UP),     # Agent stands below target, faces up\n        ]\n        \n        for adj_offset, face_dir_candidate in potential_adj_info:\n            adj_x_offset, adj_y_offset = adj_offset\n            adj_x_cand, adj_y_cand = tx + adj_x_offset, ty + adj_y_offset # Candidate adjacent cell position\n            \n            if _is_walkable(adj_x_cand, adj_y_cand, grid, non_grabbable_indices):\n                path = _get_path_bfs(agent_pos, (adj_x_cand, adj_y_cand), grid, non_grabbable_indices)\n                if path:\n                    if best_path is None or len(path) < len(best_path):\n                        best_path = path\n                        target_adj_pos = (adj_x_cand, adj_y_cand)\n                        final_face_dir = face_dir_candidate\n        \n        if not best_path:\n            return [], None # No path to any valid adjacent cell\n\n        # Add actions to move to the adjacent cell\n        move_actions, final_agent_pos, final_agent_dir_after_move = \\\n            _actions_to_move_along_path(agent_pos, agent_dir, best_path)\n        actions.extend(move_actions)\n        \n        # Simulate state after movement\n        sim_state_after_move = current_sim_state\n        for act in move_actions:\n            # CraftState.step returns a new state object\n            _, sim_state_after_move = sim_state_after_move.step(act)\n\n        # Now, at final_agent_pos (which is sim_state_after_move.pos), facing final_agent_dir_after_move.\n        # Need to turn if not facing target_pos.\n        \n        if final_agent_dir_after_move != final_face_dir:\n            # Add a turning action. In Craft, these are the movement actions themselves.\n            # Executing a movement action without being able to move (e.g. into an obstacle)\n            # still changes the agent's facing direction.\n            turn_action = DIR_TO_FACE_ACTION[final_face_dir]\n            actions.append(turn_action)\n            # Simulate state after turning\n            _, sim_state_after_move = sim_state_after_move.step(turn_action)\n            \n\n        # Finally, add the USE action\n        actions.append(USE)\n        # Simulate state after USE\n        _, sim_state_after_use = sim_state_after_move.step(USE)\n        \n        return actions, sim_state_after_use\n\n\n    # --- Main logic of craft_v2 ---\n    all_actions = []\n    \n    # Start with a copy of the initial state from the env\n    # Using env._current_state as the base for simulation\n    current_sim_state = env._current_state \n\n    # Check if the item is already in inventory\n    if current_sim_state.inventory[item] > 0:\n        return [] # Already have it, no actions needed (or potentially, it was already collected)\n\n    # Get the primitive ingredients needed for the target item\n    primitives_needed = env.world.cookbook.primitives_for(item)\n\n    # If the item itself is a primitive (no recipe for it), or cannot be crafted via recipes,\n    # then primitives_for returns an empty dict. In this case, we just try to pick it up directly.\n    is_primitive_item = not primitives_needed\n\n    if is_primitive_item:\n        # Try to collect the item directly from the grid\n        # Loop until item is in inventory (or determined impossible)\n        while current_sim_state.inventory[item] == 0:\n            item_locs = _get_entity_positions(current_sim_state.grid, item)\n            \n            if not item_locs:\n                # Item no longer on grid or never was\n                return [] \n\n            closest_item_pos = None\n            min_path_len = float('inf')\n            for loc in item_locs:\n                path_to_loc = _get_path_bfs(current_sim_state.pos, loc, \n                                            current_sim_state.grid, env.world.non_grabbable_indices)\n                if path_to_loc:\n                    if len(path_to_loc) < min_path_len:\n                        min_path_len = len(path_to_loc)\n                        closest_item_pos = loc\n            \n            if closest_item_pos is None:\n                # No path to any instance of the item\n                return []\n\n            actions_to_collect, new_sim_state = _get_actions_to_use_target(\n                current_sim_state, closest_item_pos)\n            \n            if not actions_to_collect:\n                # Failed to generate actions to collect\n                return []\n            \n            all_actions.extend(actions_to_collect)\n            current_sim_state = new_sim_state\n\n            # If after USE action, item still not in inventory, it means it's not grabbable\n            # or some other condition failed. Assume failure for now.\n            if current_sim_state.inventory[item] == 0:\n                return [] \n        \n        # If we reach here, the item has been collected.\n        return all_actions\n    \n    # If not a primitive, proceed with crafting by collecting ingredients first\n    for p_idx, count_needed in primitives_needed.items():\n        while current_sim_state.inventory[p_idx] < count_needed:\n            # Find all locations of this primitive on the grid\n            primitive_locs = _get_entity_positions(current_sim_state.grid, p_idx)\n            \n            if not primitive_locs:\n                # Cannot find more of this primitive, impossible to craft\n                return [] \n\n            # Find the closest primitive\n            closest_primitive_pos = None\n            min_path_len = float('inf')\n\n            for loc in primitive_locs:\n                path_to_loc = _get_path_bfs(current_sim_state.pos, loc, \n                                            current_sim_state.grid, env.world.non_grabbable_indices)\n                if path_to_loc:\n                    if len(path_to_loc) < min_path_len:\n                        min_path_len = len(path_to_loc)\n                        closest_primitive_pos = loc\n            \n            if closest_primitive_pos is None:\n                # No path found to any primitive of this type\n                return []\n\n            # Get actions to move to and use the closest primitive\n            actions_to_collect, new_sim_state = _get_actions_to_use_target(\n                current_sim_state, closest_primitive_pos)\n            \n            if not actions_to_collect:\n                # Failed to generate actions to collect\n                return []\n            \n            all_actions.extend(actions_to_collect)\n            current_sim_state = new_sim_state # Update our simulated state\n\n    # After collecting all primitives, craft the target item at a workshop\n    # Ensure it's not already in inventory from a previous primitive collection step (e.g. if target itself was a primitive)\n    if current_sim_state.inventory[item] > 0:\n        return all_actions \n        \n    # Get the workshop index. Assuming there's at least one workshop type defined.\n    # CraftWorld.workshop_indices is a list of int indices.\n    if not env.world.workshop_indices:\n        return [] # No workshops defined\n\n    workshop_kind_idx = env.world.workshop_indices[0] # Use the first workshop type\n\n    workshop_locs = _get_entity_positions(current_sim_state.grid, workshop_kind_idx)\n    \n    if not workshop_locs:\n        # No workshop found on the current grid, cannot craft\n        return []\n\n    # Find the closest workshop\n    closest_workshop_pos = None\n    min_path_len = float('inf')\n\n    for loc in workshop_locs:\n        path_to_loc = _get_path_bfs(current_sim_state.pos, loc, \n                                    current_sim_state.grid, env.world.non_grabbable_indices)\n        if path_to_loc:\n            if len(path_to_loc) < min_path_len:\n                min_path_len = len(path_to_loc)\n                closest_workshop_pos = loc\n    \n    if closest_workshop_pos is None:\n        # No path found to any workshop\n        return []\n\n    # Get actions to move to and use the closest workshop\n    actions_to_craft, new_sim_state = _get_actions_to_use_target(\n        current_sim_state, closest_workshop_pos)\n\n    if not actions_to_craft:\n        # Failed to generate actions to craft\n        return []\n\n    all_actions.extend(actions_to_craft)\n    current_sim_state = new_sim_state # Update our simulated state\n\n    # Final check: did we actually craft the item?\n    if current_sim_state.inventory[item] == 0:\n        # This can happen if the recipe was not met or USE didn't work for some reason.\n        # For a robust planner, this would indicate a failure or need for more complex reasoning.\n        # For now, return empty if crafting failed.\n        return []\n\n    return all_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:02:04.711610", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Define actions as constants within the function for clarity and compliance\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    def _get_fwd_coords(pos, _dir):\n        \"\"\"Calculates coordinates of the cell directly in front of the agent.\"\"\"\n        x, y = pos\n        if _dir == 0: return (x, y - 1)  # North (Y decreases)\n        if _dir == 1: return (x, y + 1)  # South (Y increases)\n        if _dir == 2: return (x - 1, y)  # West (X decreases)\n        if _dir == 3: return (x + 1, y)  # East (X increases)\n        return pos # Should not happen, but for safety\n\n    def _find_path_and_orient(start_state: \"CraftState\", env_world, target_kind_index: int = None):\n        \"\"\"\n        Finds a path from start_state to a cell adjacent to an instance of target_kind_index,\n        and orient the agent to face it. This uses a Breadth-First Search (BFS).\n        \n        Returns (list_of_actions, final_state_after_path_and_orientation) or (None, None) if no path found.\n        \"\"\"\n        if target_kind_index is None:\n            return [], start_state # No specific target for pathfinding\n        \n        # BFS Queue: stores (current_CraftState_object, list_of_actions_to_reach_this_state)\n        queue = collections.deque([(start_state, [])])\n        \n        # Visited set: stores (pos_x, pos_y, dir) tuples to avoid cycles and redundant exploration\n        visited = set([(start_state.pos[0], start_state.pos[1], start_state.dir)])\n\n        WIDTH, HEIGHT, _ = start_state.grid.shape # Get grid dimensions\n\n        # Find all grid coordinates where the target_kind_index exists\n        possible_target_locations = []\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if start_state.grid[x, y, target_kind_index] > 0:\n                    possible_target_locations.append((x, y))\n        \n        if not possible_target_locations:\n            return None, None # Target kind not found on the grid at all\n\n        while queue:\n            current_sim_state, actions_so_far = queue.popleft()\n\n            # Check if current_sim_state is adjacent to any target_location and correctly oriented\n            cx, cy = current_sim_state.pos\n            current_dir = current_sim_state.dir\n\n            for tx, ty in possible_target_locations:\n                # Check if current agent position is one of the 4 direct neighbors of (tx, ty)\n                is_adjacent = abs(cx - tx) + abs(cy - ty) == 1\n                if is_adjacent:\n                    # Check if the target cell (tx,ty) is directly in front of the agent\n                    if _get_fwd_coords((cx, cy), current_dir) == (tx, ty):\n                        return actions_so_far, current_sim_state # Path found and oriented!\n            \n            # Explore possible next states by trying all movement actions\n            for action in [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT]:\n                # Simulate the step to get the next state\n                # CraftState.step returns a new CraftState object, which is ideal for simulation\n                _, next_sim_state = current_sim_state.step(action)\n                next_pos_tuple = (next_sim_state.pos[0], next_sim_state.pos[1], next_sim_state.dir)\n                \n                if next_pos_tuple not in visited:\n                    visited.add(next_pos_tuple)\n                    queue.append((next_sim_state, actions_so_far + [action]))\n        \n        return None, None # No path found to any instance of the target kind\n\n    def _simulate_actions(start_state: \"CraftState\", actions: list[int]):\n        \"\"\"\n        Simulates a list of actions on a starting CraftState, returning the final state\n        after applying all actions.\n        \"\"\"\n        current_sim_state = start_state \n        for action in actions:\n            # CraftState.step returns a new state object, so current_sim_state gets updated\n            _, current_sim_state = current_sim_state.step(action)\n        return current_sim_state\n\n    # Recursive helper function to plan how to acquire a single item\n    # It returns (list_of_actions_to_get_item, new_state_after_acquiring, new_inventory_after_acquiring)\n    # or (None, None, None) if the item cannot be acquired.\n    def _plan_get_item(target_item_idx: int, current_sim_state: \"CraftState\", current_sim_inventory: np.ndarray):\n        \n        # Base case 1: If item is already available in the current virtual inventory\n        if current_sim_inventory[target_item_idx] > 0:\n            return [], current_sim_state, current_sim_inventory\n\n        # Case 1: Item is a primitive (can be picked up directly from the grid)\n        if target_item_idx in env.world.cookbook.primitives:\n            # Find a path to the primitive and orient towards it\n            path_actions, final_state_after_path = _find_path_and_orient(\n                start_state=current_sim_state,\n                env_world=env.world, # Pass env.world for necessary constants/indices\n                target_kind_index=target_item_idx\n            )\n            \n            if path_actions is None:\n                return None, None, None # Cannot reach the primitive\n\n            # After reaching, perform the USE action to pick it up\n            full_actions = path_actions + [_ACTION_USE]\n            \n            # Simulate these actions to get the updated state and inventory\n            new_sim_state = _simulate_actions(current_sim_state, full_actions)\n            # Update the virtual inventory based on the result of the simulation\n            new_sim_inventory = new_sim_state.inventory.copy() \n            \n            return full_actions, new_sim_state, new_sim_inventory\n\n        # Case 2: Item is crafted (requires ingredients and a possible workshop)\n        elif target_item_idx in env.world.cookbook.recipes:\n            recipe = env.world.cookbook.recipes[target_item_idx]\n            \n            actions_for_this_craft = []\n            # Temporarily track state and inventory within this recipe's planning\n            temp_state_for_recipe = current_sim_state\n            temp_inventory_for_recipe = current_sim_inventory.copy() \n\n            # Step 1: Gather all required ingredients\n            for ingredient_idx_or_key, needed_count_val in recipe.items():\n                if ingredient_idx_or_key == \"_key\":\n                    continue # This is the workshop, handled separately\n                \n                # Ensure needed_count is an integer (recipe values can be floats in YAML)\n                needed_count = int(needed_count_val) \n\n                while temp_inventory_for_recipe[ingredient_idx_or_key] < needed_count:\n                    # Recursively call _plan_get_item to acquire missing ingredients\n                    sub_actions, updated_state, updated_inventory = \\\n                        _plan_get_item(ingredient_idx_or_key, temp_state_for_recipe, temp_inventory_for_recipe)\n                    \n                    if sub_actions is None:\n                        # If any ingredient cannot be acquired, the target item cannot be crafted\n                        return None, None, None \n                    \n                    actions_for_this_craft.extend(sub_actions)\n                    temp_state_for_recipe = updated_state # Update current state for next planning steps\n                    temp_inventory_for_recipe = updated_inventory # Update current virtual inventory\n\n            # Step 2: Move to the required workshop (if any) and perform crafting\n            workshop_idx_name = recipe.get(\"_key\")\n            \n            if workshop_idx_name is not None:\n                # Convert workshop name (string) to its integer index\n                workshop_id = env.world.cookbook.index[workshop_idx_name] \n\n                path_to_workshop_actions, final_state_at_workshop = _find_path_and_orient(\n                    start_state=temp_state_for_recipe,\n                    env_world=env.world,\n                    target_kind_index=workshop_id\n                )\n                if path_to_workshop_actions is None:\n                    return None, None, None # Cannot reach the workshop\n\n                actions_for_this_craft.extend(path_to_workshop_actions)\n                temp_state_for_recipe = final_state_at_workshop # Update state after moving to workshop\n            \n            # Perform the USE action to craft the item (interact with workshop or directly craft)\n            actions_for_this_craft.append(_ACTION_USE)\n            \n            # Simulate the entire sequence of crafting actions to reflect inventory changes\n            # This handles consumption of ingredients and production of the target item.\n            new_sim_state = _simulate_actions(current_sim_state, actions_for_this_craft)\n            new_sim_inventory = new_sim_state.inventory.copy() \n\n            return actions_for_this_craft, new_sim_state, new_sim_inventory\n        else:\n            # Item is neither a primitive nor a crafted item (e.g., an invalid ID or a non-acquirable item)\n            return None, None, None\n\n    # Start the overall planning process for the desired item\n    # We use a copy of the current environment state and inventory for the initial call.\n    initial_planning_state = env._current_state \n    initial_planning_inventory = initial_planning_state.inventory.copy()\n\n    final_actions_plan, _, _ = _plan_get_item(item, initial_planning_state, initial_planning_inventory)\n    \n    # Return the collected actions, or an empty list if the item cannot be crafted\n    return final_actions_plan if final_actions_plan is not None else []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:02:04.729259", "function_name": "craft", "function_body": "    from collections import deque\n\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    # Mapping relative movement (dx, dy) to action constants\n    _MOVE_DELTAS_TO_ACTION = {\n        (0, 1): _ACTION_DOWN,\n        (0, -1): _ACTION_UP,\n        (-1, 0): _ACTION_LEFT,\n        (1, 0): _ACTION_RIGHT\n    }\n    \n    # Agent's possible moves (dx, dy)\n    _ADJACENT_DELTAS = [(0, 1), (0, -1), (-1, 0), (1, 0)] # (dx, dy) for Down, Up, Left, Right moves\n\n    WIDTH, HEIGHT, N_KINDS = env.scenario.init_grid.shape[0], env.scenario.init_grid.shape[1], env.world.n_kinds\n    NON_GRABBABLE_INDICES = env.world.non_grabbable_indices\n    WORKSHOP_INDICES = env.world.workshop_indices\n\n    def _is_valid_pos(pos):\n        x, y = pos\n        return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n    def _is_blocked(grid, pos, current_non_grabbable_indices):\n        x, y = pos\n        if not _is_valid_pos(pos):\n            return True\n        \n        # Check if cell contains any non-grabbable items that block movement\n        for kind_idx in current_non_grabbable_indices:\n            if grid[x, y, kind_idx] > 0:\n                return True\n        return False\n\n    def _find_path_to_kind(start_state, target_kind_idx, allow_adjacent=False):\n        # BFS to find path from start_state.pos to a cell containing target_kind_idx.\n        # Returns list of actions to reach target/adjacent cell.\n        \n        q = deque([(start_state.pos, [])]) # (current_pos, actions_taken_so_far)\n        visited = {start_state.pos}\n        \n        target_positions = []\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if start_state.grid[x, y, target_kind_idx] > 0:\n                    target_positions.append((x, y))\n\n        if not target_positions:\n            return None # Target not found on grid\n\n        # If agent is already on a target cell (and not looking for adjacent)\n        if not allow_adjacent and start_state.pos in target_positions:\n            return [] # Already at target\n\n        while q:\n            (cx, cy), path = q.popleft()\n\n            for dx, dy in _ADJACENT_DELTAS:\n                nx, ny = cx + dx, cy + dy\n                next_pos = (nx, ny)\n\n                if _is_valid_pos(next_pos) and not _is_blocked(start_state.grid, next_pos, NON_GRABBABLE_INDICES) and next_pos not in visited:\n                    move_action = _MOVE_DELTAS_TO_ACTION.get((dx, dy))\n                    if move_action is None: \n                        continue # Should not happen with valid deltas\n\n                    new_path = path + [move_action]\n                    \n                    if not allow_adjacent and next_pos in target_positions:\n                        return new_path # Found path to be on the target cell.\n                    \n                    if allow_adjacent:\n                        # Check if this new position is *adjacent* to any target_position\n                        for tx, ty in target_positions:\n                            if abs(nx - tx) + abs(ny - ty) == 1: # Manhattan distance 1\n                                return new_path # Found path to be adjacent to target.\n\n                    visited.add(next_pos)\n                    q.append((next_pos, new_path))\n        \n        return None # No path found\n\n    def _move_and_use_object(current_sim_state, object_kind_idx):\n        # Finds path to object, moves, and uses it.\n        # Returns (list_of_actions, new_sim_state)\n        \n        actions = []\n        \n        # Determine if we need to be on the object (e.g., primitive) or adjacent (e.g., workshop)\n        is_workshop = object_kind_idx in WORKSHOP_INDICES\n\n        if is_workshop:\n            path_actions = _find_path_to_kind(current_sim_state, object_kind_idx, allow_adjacent=True)\n        else:\n            # For primitives/grabbable items on the ground, agent usually needs to be on the same cell to pick up / use\n            path_actions = _find_path_to_kind(current_sim_state, object_kind_idx, allow_adjacent=False)\n        \n        if path_actions is None:\n            return [], current_sim_state # Cannot collect/use, no path found\n        \n        actions.extend(path_actions)\n        \n        # Simulate moving to the position\n        temp_state = current_sim_state\n        for action in path_actions:\n            _, temp_state = temp_state.step(action)\n        \n        # Now agent is at the target cell or adjacent to it. Apply USE action.\n        # Assume `USE` action is smart enough to apply to the relevant object in vicinity/on cell.\n        actions.append(_ACTION_USE)\n        _, final_sim_state = temp_state.step(_ACTION_USE)\n        \n        return actions, final_sim_state\n\n    # --- Main planning loop using recursive helper ---\n    all_final_actions = [] # This list will accumulate all actions\n\n    def _plan_to_obtain(sim_state, target_item_idx):\n        nonlocal all_final_actions \n        \n        # 1. Base case: Item already in inventory\n        if sim_state.inventory[target_item_idx] > 0:\n            return True, sim_state # Success, no actions needed from this branch\n\n        recipe = env.world.cookbook.recipes.get(target_item_idx)\n        current_sim_state_for_planning = sim_state # Use a mutable reference for current state in planning\n\n        # 2. Case: Item is a primitive (no recipe)\n        if recipe is None:\n            if target_item_idx in env.world.cookbook.primitives:\n                collect_actions, next_sim_state = _move_and_use_object(current_sim_state_for_planning, target_item_idx)\n                if not collect_actions: # Failed to collect primitive (e.g., no path to it)\n                    return False, current_sim_state_for_planning # Indicate failure\n                \n                all_final_actions.extend(collect_actions)\n                return True, next_sim_state\n            else:\n                # Item is neither craftable nor a known primitive. Cannot obtain.\n                return False, current_sim_state_for_planning # Indicate failure\n        \n        # 3. Case: Item is craftable (has a recipe)\n        recipe_copy = recipe.copy()\n        workshop_required = False\n        workshop_index = None\n\n        if \"_key\" in recipe_copy:\n            workshop_name = recipe_copy[\"_key\"]\n            del recipe_copy[\"_key\"]\n            workshop_required = True\n            workshop_index = env.world.cookbook.index[workshop_name]\n        \n        # Recursively plan for each ingredient\n        for ing_idx, count_needed in recipe_copy.items():\n            already_have = current_sim_state_for_planning.inventory[ing_idx]\n            num_to_get = max(0, count_needed - already_have)\n\n            for _ in range(num_to_get):\n                success, current_sim_state_for_planning = _plan_to_obtain(current_sim_state_for_planning, ing_idx)\n                if not success:\n                    # If any ingredient cannot be obtained, the entire crafting chain fails\n                    return False, sim_state # Return original state to indicate no progress\n\n        # After trying to obtain all ingredients, verify they are present in sufficient quantities\n        for ing_idx, count_needed in recipe_copy.items():\n            if current_sim_state_for_planning.inventory[ing_idx] < count_needed:\n                return False, sim_state # Not enough ingredients after attempting to obtain them\n\n        # 4. Craft the item using workshop or general USE\n        if workshop_required:\n            craft_actions, next_sim_state = _move_and_use_object(current_sim_state_for_planning, workshop_index)\n            if not craft_actions: # Failed to reach/use workshop\n                return False, sim_state\n            all_final_actions.extend(craft_actions)\n            current_sim_state_for_planning = next_sim_state\n        else:\n            # No specific workshop required, simply use general crafting action\n            craft_actions = [_ACTION_USE]\n            all_final_actions.extend(craft_actions)\n            _, current_sim_state_for_planning = current_sim_state_for_planning.step(_ACTION_USE)\n        \n        # Final check: Confirm the target item was actually crafted in the simulated state\n        if current_sim_state_for_planning.inventory[target_item_idx] > sim_state.inventory[target_item_idx]:\n            return True, current_sim_state_for_planning\n        else:\n            # Crafting failed despite having ingredients and performing actions.\n            # This might indicate an issue with the CraftState.step logic or incomplete recipe handling.\n            return False, sim_state\n\n    # Start the planning process from the environment's current state\n    initial_state_for_planning = env._current_state\n    \n    # Call the recursive planner. `all_final_actions` will be populated by side effect.\n    planning_success, _ = _plan_to_obtain(initial_state_for_planning, item)\n\n    if not planning_success:\n        # If planning failed at any point, clear the accumulated actions\n        # and return an empty list, indicating the item cannot be crafted.\n        all_final_actions = [] \n\n    return all_final_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:03:39.104548", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming they are globally defined or implicitly known)\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  _ACTIONS = [0, 1, 2, 3, 4]\n  _MOVE_ACTIONS = [0, 1, 2, 3]\n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  # This is crucial for BFS and recursive planning to avoid redundant computations and cycles.\n  def _hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # A general Breadth-First Search (BFS) helper function for pathfinding.\n  # It finds a sequence of actions from a start state to a state satisfying a goal predicate.\n  def _bfs_path_find(start_s, goal_fn, cookbook, relevant_use_kind=None, max_depth=100):\n      \"\"\"\n      Performs a BFS to find a path from start_s to a state satisfying goal_fn.\n\n      Args:\n          start_s (CraftState): The starting state for the BFS.\n          goal_fn (callable): A function `goal_fn(state)` that returns True if the state\n                              satisfies the goal, False otherwise.\n          cookbook (Cookbook): Reference to the world's cookbook for primitive checks.\n          relevant_use_kind (int, optional): If an item's index is provided, `USE` actions\n                                             will only be considered if the agent is next to this kind.\n                                             Useful for gathering primitives. Defaults to None.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths\n                           or infinite loops in complex environments.\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found, else (None, None).\n      \"\"\"\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)}\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal\n          if goal_fn(curr_s):\n              return curr_p, curr_s\n\n          # Prune if path exceeds max_depth\n          if len(curr_p) >= max_depth:\n              continue\n\n          # Explore possible actions\n          for action in _ACTIONS:\n              # Optimization: Prune `USE` actions if they are unlikely to be productive for the current goal.\n              # For gathering primitives, `USE` is only effective if next to the primitive.\n              if action == 4:  # USE action\n                  if relevant_use_kind is not None and relevant_use_kind in cookbook.primitives:\n                      if not curr_s.next_to(relevant_use_kind):\n                          # If trying to get a primitive, don't try USE unless next to it.\n                          continue\n\n              _, next_s = curr_s.step(action)\n              next_hash = _hash_craft_state(next_s)\n\n              # Add to queue only if the new state is unique and not previously visited\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      return None, None  # No path found\n\n  # Memoization dictionary to store results of _plan_craft_recursive for (state_hash, target_item_idx)\n  memo = {}\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops).\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n\n      Returns:\n          tuple: (list of actions, final_state) required to craft the item, or (None, None) if impossible.\n      \"\"\"\n      # Use the hashed state and target item index as the memoization key\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n      \n      if memo_key in memo:\n          return memo[memo_key] # Return cached result\n\n      # Base Case 1: Item is already in inventory\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          memo[memo_key] = ([], current_state_for_goal)\n          return [], current_state_for_goal\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          current_count = current_state_for_goal.inventory[target_item_idx]\n          # Goal for BFS: inventory of target_item_idx increases (meaning we picked it up)\n          goal_fn = lambda s: s.inventory[target_item_idx] > current_count\n          \n          # Use BFS to find a path to the primitive and pick it up\n          path_to_get_primitive, new_state = _bfs_path_find(\n              current_state_for_goal, goal_fn, cookbook, relevant_use_kind=target_item_idx)\n          \n          if path_to_get_primitive is None:\n              memo[memo_key] = (None, None)  # Cache failure\n              return None, None\n          \n          memo[memo_key] = (path_to_get_primitive, new_state)  # Cache success\n          return path_to_get_primitive, new_state\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          memo[memo_key] = (None, None)\n          return None, None \n      \n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      current_state_after_ingredients = current_state_for_goal\n      actions_for_this_goal = [] # Accumulate actions for this specific crafting goal\n\n      # Step A: Gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_ingredients.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_ingredients, ingredient_idx)\n              \n              if actions_for_one_ing is None:\n                  memo[memo_key] = (None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_state_after_ingredients = next_state_after_ingredient\n\n      # Step B: Move to workshop if required, and then craft\n      state_for_crafting = current_state_after_ingredients\n\n      if workshop_needed is not None:\n          # Goal for BFS: agent is next to the required workshop\n          goal_fn_workshop = lambda s: s.next_to(workshop_needed)\n          \n          # Find path to reach the workshop location (no specific `USE` relevant during pathfinding for workshop)\n          path_to_workshop, state_at_workshop = _bfs_path_find(\n              state_for_crafting, goal_fn_workshop, cookbook, relevant_use_kind=None\n          )\n          \n          if path_to_workshop is None:\n              memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          state_for_crafting = state_at_workshop\n\n      # Step C: Perform the USE action to craft the item\n      current_inv_of_target = state_for_crafting.inventory[target_item_idx]\n      _, final_state_after_craft = state_for_crafting.step(4) # Action: USE\n\n      # Check if crafting was successful (inventory of target item increased)\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target:\n          actions_for_this_goal.append(4) # Add the USE action to the plan\n          memo[memo_key] = (actions_for_this_goal, final_state_after_craft)\n          return actions_for_this_goal, final_state_after_craft\n      else:\n          # Crafting failed (e.g., wrong workshop, or unexpected condition)\n          memo[memo_key] = (None, None)\n          return None, None\n\n  # Start the planning process for the top-level goal item\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item)\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path not found", "island_id": 3, "scores": {"3": 0.0}}
