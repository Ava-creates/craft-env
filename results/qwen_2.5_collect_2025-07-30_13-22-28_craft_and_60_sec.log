{"timestamp": "2025-07-30T14:31:00.283164", "function_name": "craft", "function_body": "    # Define action constants (assuming they are not implicitly available or passed)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n    _ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT, _USE]\n\n    # Get the initial state from the CraftLab environment\n    # CraftLab internally stores the current state in _current_state\n    initial_state = env._current_state\n\n    # Use a list as a queue for BFS.\n    # Queue stores (current_craft_state, list_of_actions_to_reach_this_state)\n    # We use a 'head' pointer to simulate popleft efficiently without importing collections.deque.\n    q = [(initial_state, [])]\n\n    # Visited set to prevent revisiting states and cycles.\n    # A state is defined by (grid, inventory, position, direction).\n    # grid.tobytes() and tuple(inventory) are used to make them hashable.\n    def _get_state_key(state):\n        return (state.grid.tobytes(), tuple(state.inventory), state.pos, state.dir)\n\n    visited = {_get_state_key(initial_state)}\n\n    # Maximum number of actions to search for a path to prevent infinite loops\n    # or excessively long computations for complex or impossible goals.\n    MAX_PATH_LENGTH = 500 \n\n    head = 0  # Pointer for the front of the queue\n    while head < len(q):\n        current_state, current_actions = q[head]\n        head += 1\n\n        # Check if the goal item is in the inventory using the state's satisfies method.\n        if current_state.satisfies(None, item):\n            return current_actions\n\n        # Pruning: If the current path is too long, stop exploring this branch.\n        if len(current_actions) >= MAX_PATH_LENGTH:\n            continue\n\n        # Explore possible next actions\n        for action in _ACTIONS:\n            # Simulate the step to get the new state.\n            # CraftState.step returns (reward, new_craft_state). We only need the new state.\n            _, new_state = current_state.step(action)\n\n            new_actions = current_actions + [action]\n            new_state_key = _get_state_key(new_state)\n\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                q.append((new_state, new_actions))\n\n    # If the queue becomes empty and the goal was not reached, the item is unreachable\n    # within the MAX_PATH_LENGTH or from the initial state.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:31:00.305781", "function_name": "craft", "function_body": "    initial_craft_state = env._current_state  # Get the current CraftState from the Lab env\n\n    # Check if the item is already crafted in the initial state\n    if initial_craft_state.satisfies(None, item):\n        return []\n\n    # BFS queue: stores tuples of (CraftState_object, list_of_actions_taken_to_reach_this_state)\n    queue = collections.deque([(initial_craft_state, [])])\n\n    # Visited set: stores hashable representations of states to avoid redundant exploration\n    # A state is defined by (grid_bytes, position_tuple, direction_int, inventory_bytes)\n    # Using .tobytes() for numpy arrays for hashing\n    visited = set()\n    visited.add((\n        initial_craft_state.grid.tobytes(),\n        initial_craft_state.pos,\n        initial_craft_state.dir,\n        initial_craft_state.inventory.tobytes()\n    ))\n\n    # Define action constants (as per CraftLab.action_specs)\n    # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n    all_actions = [0, 1, 2, 3, 4]\n\n    # Max search depth to prevent excessively long searches for complex or unreachable goals\n    # This value might need tuning based on typical task complexity.\n    max_search_depth = 100\n\n    while queue:\n        current_state, current_actions = queue.popleft()\n\n        # Prune search branches that exceed the maximum allowed depth\n        if len(current_actions) >= max_search_depth:\n            continue\n\n        # Try all possible actions from the current state\n        for action in all_actions:\n            # CraftState.step returns (reward, new_CraftState_instance)\n            _reward, next_state = current_state.step(action)\n\n            # Create a hashable key for the next state\n            next_state_key = (\n                next_state.grid.tobytes(),\n                next_state.pos,\n                next_state.dir,\n                next_state.inventory.tobytes()\n            )\n\n            # If this state has not been visited before\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                new_actions = current_actions + [action]\n\n                # Check if the goal item is crafted in the new state\n                if next_state.satisfies(None, item):\n                    return new_actions  # Goal reached, return the sequence of actions\n                \n                # Add the new state to the queue for further exploration\n                queue.append((next_state, new_actions))\n    \n    # If the queue becomes empty and the goal was not reached, it means the item is unreachable\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:32:16.037235", "function_name": "craft", "function_body": "  initial_state = env._current_state # Get the initial CraftState from the CraftLab environment\n  \n  # Initialize the BFS queue with the starting state and an empty list of actions.\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(initial_state, [])])\n  \n  # Initialize a set to keep track of visited states to prevent redundant exploration and cycles.\n  # States are identified by a hashable key representing their unique configuration.\n  visited = {_get_state_key(initial_state)}\n  \n  # Define the set of all possible actions the agent can take.\n  # These are standard action indices for CraftWorld.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n  \n  # Set a maximum search depth to prevent the BFS from running indefinitely\n  # on complex or unsolvable problems. This value is a heuristic limit.\n  MAX_SEARCH_DEPTH = 200 # A reasonable limit for typical CraftWorld scenarios\n  \n  while queue:\n    current_state, actions_so_far = queue.popleft()\n\n    # Check if the goal (item in inventory) is satisfied in the current state.\n    # The `satisfies` method on CraftState is used to check if `inventory[item] > 0`.\n    if current_state.satisfies(None, item):\n      return actions_so_far # Goal achieved, return the sequence of actions\n\n    # Pruning: If the current path exceeds the maximum search depth,\n    # do not explore further from this state to avoid combinatorial explosion.\n    if len(actions_so_far) >= MAX_SEARCH_DEPTH:\n      continue # Move to the next state in the queue\n\n    # Explore all possible actions from the current state.\n    for action in ACTIONS:\n      # Simulate taking the action to get the next state.\n      # CraftState.step returns (reward, new_state). We only care about new_state for BFS.\n      _reward, next_state = current_state.step(action)\n      \n      # Generate a unique key for the next state to check if it has been visited.\n      next_state_key = _get_state_key(next_state)\n      \n      # If this state has not been visited before, add it to the queue and visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Append the current action to the path leading to the next state.\n        new_actions_path = actions_so_far + [action]\n        queue.append((next_state, new_actions_path))\n        \n  # If the queue becomes empty and the goal was not reached, it means no solution\n  # was found within the defined search limits.\n  return [] # Return an empty list indicating no path found.", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:32:16.055062", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Actions as defined in action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    # Maximum number of distinct states to explore in BFS to prevent excessive computation.\n    # Adjust this value based on expected complexity of crafting tasks and performance needs.\n    MAX_BFS_STATES_EXPLORED = 10000 \n    # Maximum length of an action sequence. Prevents very long, potentially non-optimal paths\n    # or paths for complex recipes that might exceed practical limits.\n    MAX_PATH_LENGTH = 150 \n\n    # Helper function to create a hashable representation of a CraftState\n    def _hash_state_components(grid, inventory, pos, direction):\n        # Convert numpy arrays to bytes for hashing. Ensure order and dtype consistency.\n        # This is efficient for large arrays.\n        grid_bytes = grid.tobytes()\n        inventory_bytes = inventory.tobytes()\n        return (grid_bytes, inventory_bytes, pos, direction)\n\n    start_state = env._current_state\n    \n    # Check if the item is already crafted in the initial state\n    if start_state.satisfies(None, item):\n        return []\n\n    # BFS queue: stores tuples of (current_state, path_so_far_as_list_of_actions)\n    queue = collections.deque([(start_state, [])])\n\n    # Visited set: stores hashable representations of states to avoid cycles and redundant exploration\n    visited = {_hash_state_components(start_state.grid, start_state.inventory, start_state.pos, start_state.dir)}\n\n    states_explored_count = 0\n\n    while queue:\n        current_state, path_so_far = queue.popleft()\n        states_explored_count += 1\n\n        # Check exploration limits\n        if states_explored_count > MAX_BFS_STATES_EXPLORED:\n            # print(f\"BFS reached max states explored ({MAX_BFS_STATES_EXPLORED}). Aborting search.\")\n            return []  # No path found within the defined limits\n\n        if len(path_so_far) >= MAX_PATH_LENGTH:\n            # print(f\"BFS path reached max length ({MAX_PATH_LENGTH}). Skipping further exploration from this path.\")\n            continue  # Don't explore paths that are too long\n\n        # Try all possible actions from the current state\n        for action in ACTIONS:\n            # Simulate the action: CraftState.step returns (reward, new_state)\n            # The reward is always 0.0 in this specific CraftState implementation.\n            _, next_state = current_state.step(action)\n\n            # Generate a hashable representation of the next state\n            next_state_hash = _hash_state_components(next_state.grid, next_state.inventory, next_state.pos, next_state.dir)\n\n            if next_state_hash not in visited:\n                visited.add(next_state_hash)\n                new_path = path_so_far + [action]\n\n                # Check if the goal (item in inventory) is satisfied in the new state\n                if next_state.satisfies(None, item):\n                    return new_path\n                \n                # Add the new state and its path to the queue for further exploration\n                queue.append((next_state, new_path))\n    \n    # If the queue becomes empty and the goal was not reached, it means no path exists\n    # within the defined search limits.\n    # print(f\"BFS queue exhausted. Goal item {item} not found within search limits.\")\n    return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:34:14.582246", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  def _get_kind_positions(kind_index, grid):\n      \"\"\"\n      Returns a list of (row, col) positions where kind_index exists in the grid.\n      grid shape: (H, W, N_KINDS)\n      \"\"\"\n      # np.argwhere returns (row, col) for non-zero elements.\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      return [tuple(pos) for pos in positions]\n\n  def _get_adjacent_positions(pos, grid_shape):\n      \"\"\"\n      Returns a list of positions adjacent to `pos` within grid boundaries.\n      \"\"\"\n      r, c = pos\n      H, W, _ = grid_shape\n      adj_pos = []\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Up, Down, Left, Right\n          nr, nc = r + dr, c + dc\n          if 0 <= nr < H and 0 <= nc < W:\n              adj_pos.append((nr, nc))\n      return adj_pos\n\n  def _bfs_path(start_pos, start_dir, target_kind_idx, grid, world_obj):\n      \"\"\"\n      Finds a path (list of actions) from `start_pos` to reach the `target_kind_idx`.\n      The goal is to either be at the target's cell (for primitives) or adjacent to it\n      (for workshops/non-grabbables).\n\n      Returns: (actions_list, final_pos, final_dir) or (None, None, None) if no path.\n      \"\"\"\n      queue = collections.deque([(start_pos, start_dir, [])])\n      visited = {(start_pos, start_dir)} # Tracks (position, direction) to avoid cycles and redundant paths\n\n      grid_h, grid_w, _ = grid.shape\n\n      target_positions = _get_kind_positions(target_kind_idx, grid)\n      if not target_positions:\n          return None, None, None # Target does not exist on the current grid\n\n      is_target_primitive = target_kind_idx in world_obj.cookbook.primitives\n\n      # Mapping from movement action to (row_delta, col_delta, new_facing_direction_index)\n      # Assumes CraftWorld uses DMLab-style direction indices: 0=DOWN, 1=UP, 2=RIGHT, 3=LEFT\n      move_deltas = {\n          UP:    (-1, 0, 1),  # Move Up: r-1, c, face Up (dir 1)\n          DOWN:  (1, 0, 0),   # Move Down: r+1, c, face Down (dir 0)\n          LEFT:  (0, -1, 3),  # Move Left: r, c-1, face Left (dir 3)\n          RIGHT: (0, 1, 2)    # Move Right: r, c+1, face Right (dir 2)\n      }\n\n      def is_walkable(p, current_grid, world_ref):\n          \"\"\"Checks if a position `p` is walkable.\"\"\"\n          r, c = p\n          if not (0 <= r < grid_h and 0 <= c < grid_w):\n              return False # Out of bounds\n\n          # Cells containing water are assumed to be impassable\n          if current_grid[r, c, world_ref.water_index] > 0:\n              return False\n          \n          # Cells containing other non-grabbable items (like other workshops or walls)\n          # are assumed impassable for movement, unless the current cell IS the target item.\n          for idx in world_ref.non_grabbable_indices:\n              if current_grid[r, c, idx] > 0 and idx != target_kind_idx:\n                  return False\n          \n          return True\n\n      while queue:\n          current_pos, current_dir, current_path = queue.popleft()\n\n          # Check if the current position satisfies the goal condition\n          goal_reached = False\n          if is_target_primitive:\n              # For primitives, the agent needs to be directly on the item's cell to pick it up.\n              if current_pos in target_positions:\n                  goal_reached = True\n          else:\n              # For workshops/non-grabbables, the agent needs to be adjacent to the target.\n              for target_p in target_positions:\n                  if current_pos in _get_adjacent_positions(target_p, grid.shape):\n                      goal_reached = True\n                      break\n\n          if goal_reached:\n              # If the goal is reached, return the path.\n              # Assume 'USE' action works when adjacent/on target, irrespective of precise agent facing,\n              # or that the agent implicitly reorients.\n              return current_path, current_pos, current_dir\n\n          # Explore possible next movements\n          for action in MOVEMENT_ACTIONS:\n              r_delta, c_delta, new_facing_dir = move_deltas[action]\n              next_pos = (current_pos[0] + r_delta, current_pos[1] + c_delta)\n\n              if is_walkable(next_pos, grid, world_obj) and (next_pos, new_facing_dir) not in visited:\n                  next_path = current_path + [action]\n                  visited.add((next_pos, new_facing_dir))\n                  queue.append((next_pos, new_facing_dir, next_path))\n\n      return None, None, None # No path found to the target\n\n  def _craft_item_recursive(current_state, item_idx, world_obj, visited_recipes_in_stack):\n      \"\"\"\n      Recursively plans actions to craft or acquire a specific item.\n\n      Args:\n          current_state: The current CraftState of the agent and world.\n          item_idx: The integer index of the item to craft/acquire.\n          world_obj: The CraftWorld instance, containing cookbook, grid info, etc.\n          visited_recipes_in_stack: A set tracking items currently in the recursion call stack\n                                    to prevent infinite loops due to circular dependencies.\n\n      Returns:\n          A tuple: (actions_list, final_state)\n          - actions_list: A list of actions (int) to take to get the item.\n          - final_state: The CraftState instance after simulating these actions.\n          Returns ([], current_state) if the item cannot be crafted/acquired.\n      \"\"\"\n      actions = []\n\n      # Base case 1: If the item is already in the inventory, no actions are needed.\n      if current_state.inventory[item_idx] > 0:\n          return actions, current_state\n\n      # Base case 2: Prevent infinite recursion for items involved in a dependency cycle\n      # within the current planning path.\n      if item_idx in visited_recipes_in_stack:\n          return [], current_state \n\n      # Mark this item as currently being processed in the recursion stack.\n      visited_recipes_in_stack.add(item_idx)\n\n      cookbook = world_obj.cookbook\n\n      # Strategy 1: Check if the item is a primitive (can be picked up directly from the grid).\n      if item_idx in cookbook.primitives:\n          # Find a path to the primitive on the grid.\n          path_actions, _final_pos, _final_dir = _bfs_path(\n              current_state.pos, current_state.dir, item_idx, current_state.grid, world_obj\n          )\n          if path_actions is None:\n              # Primitive not reachable/found on the grid.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state\n\n          actions.extend(path_actions)\n          # Simulate the state after movement to the primitive.\n          temp_state_after_movement = current_state\n          for act in path_actions:\n              _reward, temp_state_after_movement = temp_state_after_movement.step(act)\n\n          # Agent is now at the primitive's location. Use the 'USE' action to pick it up.\n          _reward, next_state = temp_state_after_movement.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully acquired after 'USE'.\n          if next_state.inventory[item_idx] > temp_state_after_movement.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx) # Remove from stack once successfully handled.\n              return actions, next_state\n          else:\n              # 'USE' action failed to pick up the item (e.g., wrong item used).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n      # Strategy 2: Check if the item has a recipe (requires crafting at a workshop).\n      if item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[item_idx]\n          required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n          workshop_idx = recipe.get(\"_key\")\n\n          # Assumption: All crafting recipes in CraftWorld that produce an item require a workshop.\n          if workshop_idx is None:\n              # If a recipe has no workshop key, it cannot be crafted using the 'USE' action\n              # as implemented for workshops.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state\n\n          # Recursively gather all required ingredients.\n          current_state_for_ingredients = current_state\n          for ingredient_idx, count_needed in required_ingredients.items():\n              while current_state_for_ingredients.inventory[ingredient_idx] < count_needed:\n                  # IMPORTANT: Pass a COPY of `visited_recipes_in_stack` to recursive calls for ingredients.\n                  # This allows an ingredient to be crafted even if it was previously processed in a different\n                  # branch of the recipe tree, while still preventing infinite loops within the *current*\n                  # ingredient's own dependency chain.\n                  ingredient_actions, state_after_ingredient = _craft_item_recursive(\n                      current_state_for_ingredients, ingredient_idx, world_obj, visited_recipes_in_stack.copy()\n                  )\n                  if not ingredient_actions and state_after_ingredient.inventory[ingredient_idx] < count_needed:\n                      # Failed to obtain a required ingredient, so cannot craft the main item.\n                      visited_recipes_in_stack.remove(item_idx)\n                      return [], current_state # Indicate failure\n                  actions.extend(ingredient_actions)\n                  current_state_for_ingredients = state_after_ingredient\n\n          # All ingredients gathered. Now, navigate to the workshop and use it to craft the item.\n          path_actions, _final_pos, _final_dir = _bfs_path(\n              current_state_for_ingredients.pos,\n              current_state_for_ingredients.dir,\n              workshop_idx,\n              current_state_for_ingredients.grid,\n              world_obj\n          )\n          if path_actions is None:\n              # Cannot reach the required workshop.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n          actions.extend(path_actions)\n          # Simulate state after movement to the workshop.\n          for act in path_actions:\n              _reward, current_state_for_ingredients = current_state_for_ingredients.step(act)\n\n          # Agent is now adjacent to the workshop. Use it to craft.\n          _reward, next_state = current_state_for_ingredients.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully crafted after 'USE'.\n          if next_state.inventory[item_idx] > current_state_for_ingredients.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx)\n              return actions, next_state\n          else:\n              # 'USE' action failed to craft the item (e.g., consumed ingredients without success).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n      # If the item is neither a primitive nor has a known recipe, it cannot be crafted.\n      visited_recipes_in_stack.remove(item_idx)\n      return [], current_state\n\n  # Retrieve the current state from the CraftLab environment.\n  # We assume env._current_state holds the initial state for planning this sequence of actions.\n  current_state = env._current_state\n  world = env.world # Reference to the CraftWorld instance, needed for cookbook and grid info.\n\n  # Initiate the recursive planning process.\n  # The `set()` tracks items in the current recursion stack to prevent re-processing\n  # an item that's a direct or indirect dependency of itself (circular recipes).\n  actions, final_state = _craft_item_recursive(current_state, item, world, set())\n\n  # Final verification: Check if the target item's count in the inventory has increased\n  # in the simulated final state compared to the initial state.\n  if final_state.inventory[item] > current_state.inventory[item]:\n      return actions\n  else:\n      return [] # Return an empty list if the item could not be crafted or acquired.", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:34:14.614670", "function_name": "craft", "function_body": "    import collections # Assumed to be imported at a higher level, but included here to be self-contained within the function's logical scope.\n    # Action constants (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4) are derived from CraftLab.action_specs\n    # and are used directly as integer literals for robustness.\n    _ACTIONS = [0, 1, 2, 3, 4] # Represents [DOWN, UP, LEFT, RIGHT, USE]\n\n    # 1. Reset the CraftLab environment to its initial configuration.\n    # This also populates `env._current_state` with the initial `CraftState` object.\n    env.reset()\n    initial_state = env._current_state\n\n    # 2. Initialize the Breadth-First Search (BFS) queue and the set for visited states.\n    # The queue stores tuples: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n    queue = collections.deque([(initial_state, [])])\n\n    # The `visited` set stores a compact, hashable representation of states to prevent\n    # redundant exploration and infinite loops. A state is uniquely identified by:\n    # (agent_position, agent_direction, inventory_contents_tuple, grid_contents_bytes).\n    visited = set()\n    initial_state_key = (\n        initial_state.pos,                     # Agent's (x, y) tuple position\n        initial_state.dir,                     # Agent's integer direction\n        tuple(initial_state.inventory.tolist()), # Convert inventory numpy array to tuple for hashing\n        initial_state.grid.tobytes()           # Convert grid numpy array to bytes for hashing\n    )\n    visited.add(initial_state_key)\n\n    # 3. BFS loop: Explore states level by level.\n    while queue:\n        current_state, path = queue.popleft()\n\n        # Check if the goal item has been successfully crafted (i.e., is in inventory).\n        if current_state.inventory[item] > 0:\n            return path # Goal reached, return the sequence of actions that led to this state.\n\n        # Explore all possible actions from the current state.\n        for action in _ACTIONS:\n            # Simulate the action. `CraftState.step` returns (reward, new_state).\n            # The reward is not relevant for finding the shortest path in this context.\n            _reward, next_state = current_state.step(action)\n\n            # Create a unique key for the `next_state` to check against visited states.\n            next_state_key = (\n                next_state.pos,\n                next_state.dir,\n                tuple(next_state.inventory.tolist()),\n                next_state.grid.tobytes()\n            )\n\n            # If this `next_state` has not been visited before, add it to the `visited` set\n            # and enqueue it for further exploration, along with the updated path.\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_state, path + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it implies that no valid\n    # sequence of actions can craft the item from the initial state within the search limits.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:35:52.518750", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming they are globally defined or implicitly known)\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  _ACTIONS = [0, 1, 2, 3, 4]\n  _MOVE_ACTIONS = [0, 1, 2, 3]\n\n  # Maximum allowed steps for any single BFS pathfinding attempt.\n  # This prevents excessively long sub-plans and helps manage computational complexity.\n  _MAX_BFS_DEPTH = 100 \n\n  # Maximum total steps for the entire crafting plan.\n  # If a plan exceeds this, it's considered impossible within practical limits.\n  _MAX_TOTAL_PLAN_STEPS = 500 \n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  def _hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # A general Breadth-First Search (BFS) helper function for pathfinding.\n  # It finds a sequence of actions from a start state to a state satisfying a goal predicate.\n  def _bfs_path_find(start_s, goal_fn, cookbook, relevant_use_kind=None, max_depth=_MAX_BFS_DEPTH):\n      \"\"\"\n      Performs a BFS to find a path from start_s to a state satisfying goal_fn.\n\n      Args:\n          start_s (CraftState): The starting state for the BFS.\n          goal_fn (callable): A function `goal_fn(state)` that returns True if the state\n                              satisfies the goal, False otherwise.\n          cookbook (Cookbook): Reference to the world's cookbook for primitive checks.\n          relevant_use_kind (int, optional): If an item's index is provided, `USE` actions\n                                             will only be considered if the agent is next to this kind.\n                                             Useful for gathering primitives. Defaults to None.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths\n                           or infinite loops in complex environments.\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found, else (None, None).\n      \"\"\"\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)}\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal\n          if goal_fn(curr_s):\n              return curr_p, curr_s\n\n          # Prune if path exceeds max_depth\n          if len(curr_p) >= max_depth:\n              continue\n\n          # Explore possible actions\n          for action in _ACTIONS:\n              # Optimization: Prune `USE` actions if they are unlikely to be productive for the current goal.\n              # For gathering primitives, `USE` is only effective if next to the primitive.\n              # For reaching a workshop, `USE` is not part of the path to the workshop, only after.\n              if action == 4:  # USE action\n                  if relevant_use_kind is not None and relevant_use_kind in cookbook.primitives:\n                      # If we are looking for a specific primitive via USE, check if next to it.\n                      if not curr_s.next_to(relevant_use_kind):\n                          continue\n                  else:\n                      # If relevant_use_kind is None, it means we are pathfinding to a location\n                      # (e.g., a workshop). In this context, a generic USE action is not relevant\n                      # to reaching the location goal, so it's pruned.\n                      continue\n\n              _, next_s = curr_s.step(action)\n              next_hash = _hash_craft_state(next_s)\n\n              # Add to queue only if the new state is unique and not previously visited\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      return None, None  # No path found\n\n  # Memoization dictionary to store results of _plan_craft_recursive for (state_hash, target_item_idx)\n  memo = {}\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops).\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx, current_plan_length=0):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n          current_plan_length (int): The length of the action sequence accumulated so far\n                                     for the entire top-level plan. Used for global step limit.\n\n      Returns:\n          tuple: (list of actions, final_state) required to craft the item, or (None, None) if impossible.\n      \"\"\"\n      # Use the hashed state and target item index as the memoization key\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n      \n      if memo_key in memo:\n          return memo[memo_key] # Return cached result\n\n      # Base Case 1: Item is already in inventory\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          memo[memo_key] = ([], current_state_for_goal)\n          return [], current_state_for_goal\n\n      # Prune if total plan length exceeds max limit (this applies to recursive calls too)\n      if current_plan_length >= _MAX_TOTAL_PLAN_STEPS:\n          memo[memo_key] = (None, None)\n          return None, None\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          current_count = current_state_for_goal.inventory[target_item_idx]\n          # Goal for BFS: inventory of target_item_idx increases (meaning we picked it up)\n          goal_fn = lambda s: s.inventory[target_item_idx] > current_count\n          \n          # Use BFS to find a path to the primitive and pick it up\n          path_to_get_primitive, new_state = _bfs_path_find(\n              current_state_for_goal, goal_fn, cookbook, relevant_use_kind=target_item_idx, max_depth=_MAX_BFS_DEPTH)\n          \n          if path_to_get_primitive is None:\n              memo[memo_key] = (None, None)  # Cache failure\n              return None, None\n          \n          # Check global plan length after adding this segment\n          if current_plan_length + len(path_to_get_primitive) >= _MAX_TOTAL_PLAN_STEPS:\n              memo[memo_key] = (None, None)\n              return None, None\n\n          memo[memo_key] = (path_to_get_primitive, new_state)  # Cache success\n          return path_to_get_primitive, new_state\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          memo[memo_key] = (None, None) \n          return None, None \n      \n      # Deep copy the recipe to avoid modifying the original dictionary if popping _key\n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      current_state_after_ingredients = current_state_for_goal\n      actions_for_this_goal = [] # Accumulate actions for this specific crafting goal\n      current_recursive_plan_length = current_plan_length # Track length for this specific branch\n\n      # Step A: Gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_ingredients.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_ingredients, ingredient_idx, current_recursive_plan_length)\n              \n              if actions_for_one_ing is None:\n                  memo[memo_key] = (None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_recursive_plan_length += len(actions_for_one_ing)\n              current_state_after_ingredients = next_state_after_ingredient\n\n              # Check global plan length after adding ingredient steps\n              if current_recursive_plan_length >= _MAX_TOTAL_PLAN_STEPS:\n                  memo[memo_key] = (None, None)\n                  return None, None\n\n      # Step B: Move to workshop if required, and then craft\n      state_for_crafting = current_state_after_ingredients\n\n      if workshop_needed is not None:\n          # Goal for BFS: agent is next to the required workshop\n          goal_fn_workshop = lambda s: s.next_to(workshop_needed)\n          \n          # Find path to reach the workshop location (no specific `USE` relevant during pathfinding for workshop)\n          path_to_workshop, state_at_workshop = _bfs_path_find(\n              state_for_crafting, goal_fn_workshop, cookbook, relevant_use_kind=None, max_depth=_MAX_BFS_DEPTH\n          )\n          \n          if path_to_workshop is None:\n              memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          current_recursive_plan_length += len(path_to_workshop)\n          state_for_crafting = state_at_workshop\n\n          # Check global plan length after adding workshop path\n          if current_recursive_plan_length >= _MAX_TOTAL_PLAN_STEPS:\n              memo[memo_key] = (None, None)\n              return None, None\n\n      # Step C: Perform the USE action to craft the item\n      current_inv_of_target = state_for_crafting.inventory[target_item_idx]\n      _, final_state_after_craft = state_for_crafting.step(4) # Action: USE\n\n      # Check if crafting was successful (inventory of target item increased)\n      # and that the action does not exceed total steps.\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target and \\\n         current_recursive_plan_length + 1 <= _MAX_TOTAL_PLAN_STEPS:\n          actions_for_this_goal.append(4) # Add the USE action to the plan\n          memo[memo_key] = (actions_for_this_goal, final_state_after_craft)\n          return actions_for_this_goal, final_state_after_craft\n      else:\n          # Crafting failed (e.g., wrong workshop, or unexpected condition, or max steps reached)\n          memo[memo_key] = (None, None)\n          return None, None\n\n  # Start the planning process for the top-level goal item\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item, 0) # Start with 0 length\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path not found", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:35:53.931031", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming they are globally defined or implicitly known,\n  # but defined here for self-containment consistent with craft_v1)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  _MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  def _hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # A Breadth-First Search (BFS) helper function specifically for movement.\n  # It finds a sequence of movement actions from a start state to a state\n  # where the agent is next to a specified kind of entity.\n  def _bfs_move_to_kind(start_s, target_kind_idx, max_depth=100):\n      \"\"\"\n      Performs a BFS using only movement actions to find a path to a state\n      where the agent is next to the target_kind_idx.\n\n      Args:\n          start_s (CraftState): The starting state.\n          target_kind_idx (int): The index of the entity kind to move next to.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths.\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found, else (None, None).\n      \"\"\"\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)}\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal: being next to the target kind\n          if curr_s.next_to(target_kind_idx):\n              return curr_p, curr_s\n\n          # Prune if path exceeds max_depth\n          if len(curr_p) >= max_depth:\n              continue\n\n          # Explore only movement actions\n          for action in _MOVE_ACTIONS:\n              _, next_s = curr_s.step(action) # Rewards are ignored as per problem spec\n              next_hash = _hash_craft_state(next_s)\n\n              # Add to queue only if the new state is unique and not previously visited\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      return None, None  # No path found\n\n  # Memoization dictionary to store results of _plan_craft_recursive\n  # This stores (state_hash, target_item_idx) -> (list of actions, final_state)\n  memo = {}\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops).\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n\n      Returns:\n          tuple: (list of actions, final_state) required to craft the item, or (None, None) if impossible.\n      \"\"\"\n      # Use the hashed state and target item index as the memoization key\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n      \n      if memo_key in memo:\n          return memo[memo_key] # Return cached result\n\n      # Base Case 1: Item is already in inventory\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          memo[memo_key] = ([], current_state_for_goal)\n          return [], current_state_for_goal\n\n      current_state_after_actions = current_state_for_goal # State to be updated through the planning process\n      actions_for_this_goal = [] # Accumulate actions for this specific crafting goal\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          # Step A: Move next to the primitive\n          path_to_primitive, state_at_primitive = _bfs_move_to_kind(\n              current_state_after_actions, target_item_idx\n          )\n          \n          if path_to_primitive is None:\n              memo[memo_key] = (None, None)  # Cache failure\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_primitive)\n          current_state_after_actions = state_at_primitive\n\n          # Step B: Perform the USE action to gather the primitive\n          current_count_before_use = current_state_after_actions.inventory[target_item_idx]\n          _, state_after_use = current_state_after_actions.step(USE)\n\n          # Verify that the USE action successfully obtained the primitive\n          if state_after_use.inventory[target_item_idx] > current_count_before_use:\n              actions_for_this_goal.append(USE) # Add the USE action to the plan\n              memo[memo_key] = (actions_for_this_goal, state_after_use) # Cache success\n              return actions_for_this_goal, state_after_use\n          else:\n              # USE action did not result in obtaining the primitive (e.g., failed pickup)\n              memo[memo_key] = (None, None) # Cache failure\n              return None, None\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          memo[memo_key] = (None, None)\n          return None, None \n      \n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      # Step A: Gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_actions.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_actions, ingredient_idx)\n              \n              if actions_for_one_ing is None:\n                  memo[memo_key] = (None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_state_after_actions = next_state_after_ingredient\n\n      # Step B: Move to workshop if required\n      if workshop_needed is not None:\n          path_to_workshop, state_at_workshop = _bfs_move_to_kind(\n              current_state_after_actions, workshop_needed\n          )\n          \n          if path_to_workshop is None:\n              memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          current_state_after_actions = state_at_workshop\n\n      # Step C: Perform the USE action to craft the item\n      current_inv_of_target = current_state_after_actions.inventory[target_item_idx]\n      _, final_state_after_craft = current_state_after_actions.step(USE)\n\n      # Check if crafting was successful (inventory of target item increased)\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target:\n          actions_for_this_goal.append(USE) # Add the USE action to the plan\n          memo[memo_key] = (actions_for_this_goal, final_state_after_craft)\n          return actions_for_this_goal, final_state_after_craft\n      else:\n          # Crafting failed (e.g., insufficient ingredients despite prior steps, wrong workshop, or unexpected condition)\n          memo[memo_key] = (None, None)\n          return None, None\n\n  # Start the planning process for the top-level goal item\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item)\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path not found", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:38:15.803121", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants (from DMLab-style interface)\n  # DOWN = 0\n  # UP = 1\n  # LEFT = 2\n  # RIGHT = 3\n  # USE = 4\n  ACTIONS = [0, 1, 2, 3, 4]\n\n  # Get the initial state of the agent from the environment.\n  # This is the starting point for our search.\n  initial_craft_state = env._current_state\n\n  # Check if the item is already in the inventory at the start.\n  # If so, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Queue for Breadth-First Search (BFS).\n  # It stores CraftState objects that need to be explored.\n  q = collections.deque([initial_craft_state])\n\n  # Set to keep track of visited states to prevent cycles and redundant exploration.\n  # A state is defined by its grid, position, direction, and inventory.\n  # numpy arrays (grid, inventory) are converted to bytes for hashing.\n  visited = set()\n  \n  # Dictionary to reconstruct the path from the initial state to the goal state.\n  # It maps a `state_key` (hashable state representation) to a tuple:\n  # (parent_state_key, action_taken_to_reach_current_state).\n  parent = {}\n\n  # Create the hashable key for the initial state.\n  initial_state_key = (\n      initial_craft_state.grid.tobytes(),\n      initial_craft_state.pos,\n      initial_craft_state.dir,\n      initial_craft_state.inventory.tobytes()\n  )\n  visited.add(initial_state_key)\n  parent[initial_state_key] = (None, None) # The initial state has no parent.\n\n  # BFS loop\n  while q:\n      current_state = q.popleft()\n      current_state_key = (\n          current_state.grid.tobytes(),\n          current_state.pos,\n          current_state.dir,\n          current_state.inventory.tobytes()\n      )\n\n      # If the current state satisfies the goal, we have found the shortest path.\n      if current_state.satisfies(None, item):\n          # Reconstruct the path by backtracking from the goal state using the `parent` map.\n          path = []\n          trace_key = current_state_key\n          while parent[trace_key][0] is not None: # Traverse back until we reach the initial state\n              _prev_key, action_to_reach = parent[trace_key]\n              path.append(action_to_reach)\n              trace_key = _prev_key\n          return path[::-1] # Reverse the path to get actions in chronological order.\n\n      # Explore all possible actions from the current state.\n      for action in ACTIONS:\n          # Simulate the action. CraftState.step returns a *new* CraftState object,\n          # which is essential for BFS to explore different paths without modifying\n          # the current state in the search. The reward is always 0.0 for this method.\n          _reward, next_state = current_state.step(action)\n\n          next_state_key = (\n              next_state.grid.tobytes(),\n              next_state.pos,\n              next_state.dir,\n              next_state.inventory.tobytes()\n          )\n\n          # If this new state has not been visited before, add it to the queue and visited set.\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              parent[next_state_key] = (current_state_key, action)\n              q.append(next_state)\n              \n  # If the queue becomes empty and the goal was not found, it means the item\n  # is unreachable from the current state within the explored state space.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:38:17.736799", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants (from CraftLab.action_specs, implied by the problem description)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Max recursion depth to prevent infinite loops for complex or impossible recipes\n  MAX_PLANNING_DEPTH = 20\n  # Maximum actions for a single pathfinding attempt to prevent excessively long paths\n  MAX_PATH_LENGTH = 100 \n\n  # Get initial state from the environment wrapper\n  # Assuming direct access to _current_state is permitted for this 'terminal function'.\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n  world = env.world # CraftWorld instance\n\n  # Helper for pathfinding using BFS to find a path to a specific kind on the grid.\n  # This helper will return a list of actions (moves) to get from a start_state\n  # to a target location where a specific kind is present.\n  def _find_actions_to_reach_kind(current_planning_state, target_kind_idx, require_next_to=False):\n    \"\"\"\n    Finds a sequence of actions (moves) to reach a cell containing target_kind_idx.\n    If require_next_to is True (for workshops), it finds a path to a cell adjacent to target_kind_idx.\n    Returns (actions, final_state_after_moves) or (None, None) if no path.\n    \"\"\"\n    q = collections.deque([(current_planning_state, [])]) # Queue stores (state, actions_taken_to_reach_state)\n    \n    # Visited states: (position_tuple, direction_int) to prevent cycles and redundant exploration.\n    visited = {(current_planning_state.pos, current_planning_state.dir)} \n\n    while q:\n      sim_state, path_actions = q.popleft()\n\n      # Check if current state satisfies the \"reach\" condition\n      found_target = False\n      if require_next_to:\n        # For workshops, we need to be next to it. Use CraftState.next_to.\n        if sim_state.next_to(target_kind_idx):\n          found_target = True\n      else:\n        # For primitives, we need to be on the cell.\n        r, c = sim_state.pos\n        if sim_state.grid[r, c, target_kind_idx] > 0:\n          found_target = True\n      \n      if found_target:\n        return path_actions, sim_state\n\n      # Avoid excessively long paths for planning\n      if len(path_actions) >= MAX_PATH_LENGTH:\n        continue\n\n      # Explore possible moves (UP, DOWN, LEFT, RIGHT)\n      for action_move in [DOWN, UP, LEFT, RIGHT]:\n        # CraftState.step returns (reward, new_state). We only need new_state for planning.\n        _, next_sim_state = sim_state.step(action_move) \n        \n        # Check if agent actually moved or just bumped into an obstacle\n        # Only add to queue if it's a valid move to a new state/direction combination.\n        if (next_sim_state.pos, next_sim_state.dir) not in visited:\n            visited.add((next_sim_state.pos, next_sim_state.dir))\n            q.append((next_sim_state, path_actions + [action_move]))\n    \n    return None, None # No path found\n\n  # Recursive planning function\n  # Returns (list of actions, final_state_after_executing_actions) or (None, None) if impossible\n  def _plan_recursive(current_planning_state, goal_item_idx, current_depth):\n    if current_depth > MAX_PLANNING_DEPTH:\n      return None, None # Exceeded maximum recursion depth, likely an uncraftable item or too complex\n\n    # 1. Base case: Goal already in inventory\n    if current_planning_state.satisfies(\"goal\", goal_item_idx):\n      return [], current_planning_state\n\n    # 2. Check if goal is a primitive (collectable directly from the grid)\n    # This checks if it's in the cookbook's primitives set AND does not have a recipe.\n    # If it has a recipe, crafting will be prioritized.\n    if goal_item_idx in cookbook.primitives and goal_item_idx not in cookbook.recipes:\n      # Find path to the primitive on the grid\n      actions_to_collect, next_state_after_collection = _find_actions_to_reach_kind(\n          current_planning_state, goal_item_idx, require_next_to=False\n      )\n      if actions_to_collect is None:\n        return None, None # Cannot reach primitive\n      \n      # The primitive is collected implicitly by moving onto its square.\n      # CraftState.step handles this for grabbable items, updating inventory.\n      return actions_to_collect, next_state_after_collection\n\n    # 3. Goal is craftable: Get recipe\n    recipe = cookbook.recipes.get(goal_item_idx)\n    if not recipe:\n      # Not a primitive, not craftable, and not in inventory. Impossible to acquire.\n      return None, None\n\n    # 4. Craftable item: Gather ingredients and then use workshop (if any)\n    sim_state = current_planning_state # Start planning from the current simulated state\n    total_actions = []\n\n    ingredients_to_gather = recipe.copy()\n    workshop_idx = None\n    if \"_key\" in ingredients_to_gather:\n      workshop_idx = ingredients_to_gather.pop(\"_key\") # Extract the workshop index\n\n    # Iterate through ingredients required by the recipe\n    for ingredient_idx, count in ingredients_to_gather.items():\n      # Determine how many more of this ingredient are needed\n      num_to_get = max(0, count - sim_state.inventory[ingredient_idx])\n      \n      # Recursively plan to get each needed instance of the ingredient\n      for _ in range(num_to_get):\n        actions_for_ingredient, state_after_ingredient = _plan_recursive(\n            sim_state, ingredient_idx, current_depth + 1\n        )\n        if actions_for_ingredient is None:\n          return None, None # Cannot get this ingredient, so goal is impossible\n        \n        total_actions.extend(actions_for_ingredient) # Add actions for this ingredient\n        sim_state = state_after_ingredient # Update simulated state for subsequent planning\n\n    # 5. After all ingredients are gathered, if a workshop is required, move to and use it.\n    if workshop_idx is not None:\n      # Find path to be next to the workshop\n      actions_to_workshop, state_at_workshop = _find_actions_to_reach_kind(\n          sim_state, workshop_idx, require_next_to=True\n      )\n      if actions_to_workshop is None:\n        return None, None # Cannot reach workshop\n\n      total_actions.extend(actions_to_workshop) # Add actions to reach workshop\n      sim_state = state_at_workshop\n\n      # Perform the USE action at the workshop\n      _, final_sim_state = sim_state.step(USE) # CraftState.step processes the crafting\n      total_actions.append(USE) # Add the USE action\n      sim_state = final_sim_state # Update simulated state to reflect crafted item\n    \n    # At this point, the goal item should be in `sim_state.inventory` if crafting was successful.\n    return total_actions, sim_state\n\n  # Start the planning process from the initial environment state\n  final_actions, _ = _plan_recursive(initial_state, item, 0)\n\n  if final_actions is None:\n    # If planning fails (e.g., cannot find path, depth limit reached, uncraftable ingredient),\n    # return an empty list indicating no solution found.\n    return []\n  else:\n    return final_actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:40:11.922724", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  _MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  def _hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Memoization dictionary for the main planning function\n  plan_memo = {}\n  # Memoization dictionary for the BFS movement function\n  bfs_memo = {}\n\n  cookbook = env.world.cookbook # Get cookbook once for efficiency\n\n  # A Breadth-First Search (BFS) helper function specifically for movement.\n  # It finds a sequence of movement actions from a start state to a state\n  # where the agent is next to a specified kind of entity.\n  def _bfs_move_to_kind(start_s, target_kind_idx, max_depth=100):\n      \"\"\"\n      Performs a BFS using only movement actions to find a path to a state\n      where the agent is next to the target_kind_idx. Memoized.\n\n      Args:\n          start_s (CraftState): The starting state.\n          target_kind_idx (int): The index of the entity kind to move next to.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths.\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found, else (None, None).\n      \"\"\"\n      memo_key = (_hash_craft_state(start_s), target_kind_idx)\n      if memo_key in bfs_memo:\n          return bfs_memo[memo_key]\n\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)} # Visited states to avoid cycles and redundant paths\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal: being next to the target kind\n          if curr_s.next_to(target_kind_idx):\n              bfs_memo[memo_key] = (curr_p, curr_s) # Cache success\n              return curr_p, curr_s\n\n          # Prune if path exceeds max_depth\n          if len(curr_p) >= max_depth:\n              continue\n\n          # Explore only movement actions\n          for action in _MOVE_ACTIONS:\n              _, next_s = curr_s.step(action) # Rewards are ignored as per problem spec\n              next_hash = _hash_craft_state(next_s)\n\n              # Add to queue only if the new state is unique and not previously visited\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      bfs_memo[memo_key] = (None, None) # Cache failure\n      return None, None  # No path found\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops).\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n      Memoized.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n\n      Returns:\n          tuple: (list of actions, final_state) required to craft the item, or (None, None) if impossible.\n      \"\"\"\n      # Use the hashed state and target item index as the memoization key\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n      \n      if memo_key in plan_memo:\n          return plan_memo[memo_key] # Return cached result\n\n      # Base Case 1: Item is already in inventory\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          plan_memo[memo_key] = ([], current_state_for_goal)\n          return [], current_state_for_goal\n\n      current_state_after_actions = current_state_for_goal # State to be updated through the planning process\n      actions_for_this_goal = [] # Accumulate actions for this specific crafting goal\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          # Step A: Move next to the primitive\n          path_to_primitive, state_at_primitive = _bfs_move_to_kind(\n              current_state_after_actions, target_item_idx\n          )\n          \n          if path_to_primitive is None:\n              plan_memo[memo_key] = (None, None)  # Cache failure\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_primitive)\n          current_state_after_actions = state_at_primitive\n\n          # Step B: Perform the USE action to gather the primitive\n          current_count_before_use = current_state_after_actions.inventory[target_item_idx]\n          _, state_after_use = current_state_after_actions.step(USE)\n\n          # Verify that the USE action successfully obtained the primitive\n          if state_after_use.inventory[target_item_idx] > current_count_before_use:\n              actions_for_this_goal.append(USE) # Add the USE action to the plan\n              plan_memo[memo_key] = (actions_for_this_goal, state_after_use) # Cache success\n              return actions_for_this_goal, state_after_use\n          else:\n              # USE action did not result in obtaining the primitive (e.g., failed pickup)\n              plan_memo[memo_key] = (None, None) # Cache failure\n              return None, None\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          plan_memo[memo_key] = (None, None)\n          return None, None \n      \n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      # Step A: Gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_actions.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_actions, ingredient_idx)\n              \n              if actions_for_one_ing is None:\n                  plan_memo[memo_key] = (None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_state_after_actions = next_state_after_ingredient\n\n      # Step B: Move to workshop if required\n      if workshop_needed is not None:\n          path_to_workshop, state_at_workshop = _bfs_move_to_kind(\n              current_state_after_actions, workshop_needed\n          )\n          \n          if path_to_workshop is None:\n              plan_memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          current_state_after_actions = state_at_workshop\n\n      # Step C: Perform the USE action to craft the item\n      current_inv_of_target = current_state_after_actions.inventory[target_item_idx]\n      _, final_state_after_craft = current_state_after_actions.step(USE)\n\n      # Check if crafting was successful (inventory of target item increased)\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target:\n          actions_for_this_goal.append(USE) # Add the USE action to the plan\n          plan_memo[memo_key] = (actions_for_this_goal, final_state_after_craft)\n          return actions_for_this_goal, final_state_after_craft\n      else:\n          # Crafting failed (e.g., insufficient ingredients despite prior steps, wrong workshop, or unexpected condition)\n          plan_memo[memo_key] = (None, None)\n          return None, None\n\n  # Start the planning process for the top-level goal item\n  initial_state = env._current_state\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item)\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path not found", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:40:13.399785", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  _MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  def _hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # A Breadth-First Search (BFS) helper function specifically for movement.\n  def _bfs_move_to_kind(start_s, target_kind_idx, max_depth=100):\n      \"\"\"\n      Performs a BFS using only movement actions to find a path to a state\n      where the agent is next to the target_kind_idx.\n\n      Args:\n          start_s (CraftState): The starting state.\n          target_kind_idx (int): The index of the entity kind to move next to.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths.\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found, else (None, None).\n      \"\"\"\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)}\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal: being next to the target kind\n          if curr_s.next_to(target_kind_idx):\n              return curr_p, curr_s\n\n          # Prune if path exceeds max_depth\n          if len(curr_p) >= max_depth:\n              continue\n\n          # Explore only movement actions\n          for action in _MOVE_ACTIONS:\n              # Rewards are always 0.0 for step, so we ignore them.\n              _, next_s = curr_s.step(action)\n              next_hash = _hash_craft_state(next_s)\n\n              # Add to queue only if the new state is unique and not previously visited\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      return None, None  # No path found\n\n  # Memoization dictionary, localized to this specific call of craft_v2.\n  # This ensures a clean memo for each top-level planning request.\n  memo = {}\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Helper function for performing the USE action and checking its outcome.\n  # This consolidates logic used for both primitive gathering and crafting.\n  def _perform_use_and_verify(current_state_before_use, item_idx_to_verify, actions_list_to_extend):\n      \"\"\"\n      Attempts to perform the USE action and verifies if the target item count increased.\n      \n      Args:\n          current_state_before_use (CraftState): The state before performing USE.\n          item_idx_to_verify (int): The index of the item whose inventory count is expected to increase.\n          actions_list_to_extend (list): The list of actions to which USE will be appended on success.\n      \n      Returns:\n          tuple: (updated_actions_list, new_state) if USE was successful, else (None, None).\n      \"\"\"\n      initial_item_count = current_state_before_use.inventory[item_idx_to_verify]\n      _, state_after_use_action = current_state_before_use.step(USE)\n      \n      if state_after_use_action.inventory[item_idx_to_verify] > initial_item_count:\n          actions_list_to_extend.append(USE)\n          return actions_list_to_extend, state_after_use_action\n      else:\n          # USE action did not result in obtaining the item (e.g., failed pickup, wrong workshop, or item exhausted)\n          return None, None\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops).\n  # This function implicitly uses `memo` and `cookbook` from the enclosing `craft_v2` scope.\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n\n      Returns:\n          tuple: (list of actions, final_state) required to craft the item, or (None, None) if impossible.\n      \"\"\"\n      # Use the hashed state and target item index as the memoization key\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n      \n      if memo_key in memo:\n          return memo[memo_key] # Return cached result\n\n      # Base Case 1: Item is already in inventory\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          memo[memo_key] = ([], current_state_for_goal)\n          return [], current_state_for_goal\n\n      current_state_after_actions = current_state_for_goal # State to be updated through the planning process\n      actions_for_this_goal = [] # Accumulate actions for this specific crafting goal\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          # Step A: Move next to the primitive\n          path_to_primitive, state_at_primitive = _bfs_move_to_kind(\n              current_state_after_actions, target_item_idx\n          )\n          \n          if path_to_primitive is None:\n              memo[memo_key] = (None, None)  # Cache failure\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_primitive)\n          current_state_after_actions = state_at_primitive\n\n          # Step B: Perform the USE action to gather the primitive\n          updated_actions, final_state = _perform_use_and_verify(\n              current_state_after_actions, target_item_idx, actions_for_this_goal\n          )\n          \n          if updated_actions is None:\n              memo[memo_key] = (None, None) # USE action did not result in obtaining the primitive\n              return None, None\n          \n          memo[memo_key] = (updated_actions, final_state) # Cache success\n          return updated_actions, final_state\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          memo[memo_key] = (None, None)\n          return None, None \n      \n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      # Step A: Gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_actions.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_actions, ingredient_idx)\n              \n              if actions_for_one_ing is None:\n                  memo[memo_key] = (None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_state_after_actions = next_state_after_ingredient\n\n      # Step B: Move to workshop if required\n      if workshop_needed is not None:\n          path_to_workshop, state_at_workshop = _bfs_move_to_kind(\n              current_state_after_actions, workshop_needed\n          )\n          \n          if path_to_workshop is None:\n              memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          current_state_after_actions = state_at_workshop\n\n      # Step C: Perform the USE action to craft the item\n      updated_actions, final_state = _perform_use_and_verify(\n          current_state_after_actions, target_item_idx, actions_for_this_goal\n      )\n      \n      if updated_actions is None:\n          # Crafting failed (e.g., insufficient ingredients despite prior steps, wrong workshop, or unexpected condition)\n          memo[memo_key] = (None, None)\n          return None, None\n      \n      memo[memo_key] = (updated_actions, final_state)\n      return updated_actions, final_state\n\n  # Start the planning process for the top-level goal item\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item)\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path not found", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:42:15.372670", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n  \n  # Mapping from direction index to (row_delta, col_delta) of the cell in front\n  # Assumes DMLab-style direction indices: 0=DOWN, 1=UP, 2=RIGHT, 3=LEFT\n  DIRECTION_TO_FRONT_CELL_DELTA = {\n      0: (1, 0),   # Facing DOWN, cell in front is (r+1, c)\n      1: (-1, 0),  # Facing UP, cell in front is (r-1, c)\n      2: (0, 1),   # Facing RIGHT, cell in front is (r, c+1)\n      3: (0, -1)   # Facing LEFT, cell in front is (r, c-1)\n  }\n\n  # Mapping from movement action to (row_delta, col_delta, new_facing_direction_index)\n  # The new facing direction is the direction of movement.\n  MOVE_ACTION_TO_DELTA_AND_DIR = {\n      UP:    (-1, 0, 1),  # Move Up: r-1, c, face Up (dir 1)\n      DOWN:  (1, 0, 0),   # Move Down: r+1, c, face Down (dir 0)\n      LEFT:  (0, -1, 3),  # Move Left: r, c-1, face Left (dir 3)\n      RIGHT: (0, 1, 2)    # Move Right: r, c+1, face Right (dir 2)\n  }\n\n  def _is_valid_pos(pos, grid_shape):\n      r, c = pos\n      H, W, _ = grid_shape\n      return 0 <= r < H and 0 <= c < W\n\n  def _is_walkable(pos, current_grid, world_ref, target_kind_idx_for_pathfinding=None):\n      \"\"\"\n      Checks if a position `pos` is walkable.\n      `target_kind_idx_for_pathfinding`: The specific kind index the BFS is trying to reach.\n                                          Allows walking onto target primitive or ignoring target workshop as obstacle.\n      \"\"\"\n      r, c = pos\n      H, W, _ = current_grid.shape\n      if not (0 <= r < H and 0 <= c < W):\n          return False # Out of bounds\n\n      # Water is always impassable\n      if current_grid[r, c, world_ref.water_index] > 0:\n          return False\n      \n      # Non-grabbable items are generally obstacles.\n      # If a cell contains any non-grabbable item that is NOT our specific target, it's an obstacle.\n      # This allows us to walk onto a cell if it contains a primitive (which might be in non_grabbable_indices\n      # in some configurations, though typically primitives are grabbable), or to navigate around other workshops.\n      for idx in world_ref.non_grabbable_indices:\n          if current_grid[r, c, idx] > 0:\n              if idx != target_kind_idx_for_pathfinding:\n                  return False\n      \n      return True\n\n  def _get_kind_positions(kind_index, grid):\n      \"\"\"\n      Returns a list of (row, col) positions where kind_index exists in the grid.\n      grid shape: (H, W, N_KINDS)\n      \"\"\"\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      return [tuple(pos) for pos in positions]\n\n  def _bfs_path_with_facing(start_pos, start_dir, target_kind_idx, grid, world_obj):\n      \"\"\"\n      Finds a path (list of actions) from `start_pos` to reach a state where the `target_kind_idx`\n      can be interacted with using the 'USE' action.\n      This means either being on the target's cell (for primitives) or adjacent to it and facing it\n      (for workshops).\n\n      Returns: (actions_list, final_pos, final_dir) or (None, None, None) if no path.\n      \"\"\"\n      queue = collections.deque([(start_pos, start_dir, [])])\n      # Visited set tracks (position, direction) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      target_positions = _get_kind_positions(target_kind_idx, grid)\n      if not target_positions:\n          return None, None, None # Target does not exist on the current grid\n\n      is_target_primitive = target_kind_idx in world_obj.cookbook.primitives\n      \n      # Pre-calculate all valid (agent_pos, agent_dir) pairs that enable 'USE' on a target.\n      goal_states_for_use = set()\n      for tr, tc in target_positions:\n          if is_target_primitive:\n              # For primitives, agent needs to be on the item's cell. Direction might not matter for pickup.\n              # Assuming direction doesn't block pickup if on the cell for primitives.\n              for d in range(4): # All 4 directions are valid at the target cell for pickup\n                  if _is_walkable((tr, tc), grid, world_obj, target_kind_idx):\n                      goal_states_for_use.add(((tr, tc), d))\n          else:\n              # For workshops/non-grabbables, agent needs to be adjacent and face the target.\n              for d_idx, (dr, dc) in DIRECTION_TO_FRONT_CELL_DELTA.items():\n                  # Calculate agent position (ar, ac) if facing (dr, dc) towards (tr,tc)\n                  ar, ac = tr - dr, tc - dc \n                  if _is_valid_pos((ar, ac), grid.shape) and \\\n                     _is_walkable((ar, ac), grid, world_obj, target_kind_idx):\n                      goal_states_for_use.add(((ar, ac), d_idx))\n\n      while queue:\n          current_pos, current_dir, current_path = queue.popleft()\n\n          # Check if the current (pos, dir) is a goal state for 'USE' action\n          if ((current_pos, current_dir)) in goal_states_for_use:\n              return current_path, current_pos, current_dir\n\n          # Explore possible next movements\n          for action in MOVEMENT_ACTIONS:\n              r_delta, c_delta, new_facing_dir = MOVE_ACTION_TO_DELTA_AND_DIR[action]\n              next_pos = (current_pos[0] + r_delta, current_pos[1] + c_delta)\n\n              if _is_walkable(next_pos, grid, world_obj, target_kind_idx) and \\\n                 (next_pos, new_facing_dir) not in visited:\n                  next_path = current_path + [action]\n                  visited.add((next_pos, new_facing_dir))\n                  queue.append((next_pos, new_facing_dir, next_path))\n\n      return None, None, None # No path found to the target\n\n  def _craft_item_recursive(current_state, item_idx, world_obj, visited_recipes_in_stack):\n      \"\"\"\n      Recursively plans actions to craft or acquire a specific item.\n\n      Args:\n          current_state: The current CraftState of the agent and world.\n          item_idx: The integer index of the item to craft/acquire.\n          world_obj: The CraftWorld instance, containing cookbook, grid info, etc.\n          visited_recipes_in_stack: A set tracking items currently in the recursion call stack\n                                    to prevent infinite loops due to circular dependencies.\n\n      Returns:\n          A tuple: (actions_list, final_state)\n          - actions_list: A list of actions (int) to take to get the item.\n          - final_state: The CraftState instance after simulating these actions.\n          Returns ([], current_state) if the item cannot be crafted/acquired.\n      \"\"\"\n      actions = []\n\n      # Base case 1: If the item is already in the inventory, no actions are needed.\n      if current_state.inventory[item_idx] > 0:\n          return actions, current_state\n\n      # Base case 2: Prevent infinite recursion for items involved in a dependency cycle\n      # within the current planning path.\n      if item_idx in visited_recipes_in_stack:\n          return [], current_state \n\n      # Mark this item as currently being processed in the recursion stack.\n      visited_recipes_in_stack.add(item_idx)\n\n      cookbook = world_obj.cookbook\n\n      # Strategy 1: Check if the item is a primitive (can be picked up directly from the grid).\n      if item_idx in cookbook.primitives:\n          path_actions, _final_pos, _final_dir = _bfs_path_with_facing(\n              current_state.pos, current_state.dir, item_idx, current_state.grid, world_obj\n          )\n          if path_actions is None:\n              # Primitive not reachable/found on the grid.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state\n\n          actions.extend(path_actions)\n          # Simulate the state after movement to the primitive.\n          temp_state_after_movement = current_state\n          for act in path_actions:\n              _reward, temp_state_after_movement = temp_state_after_movement.step(act)\n\n          # Agent is now in position and facing correctly. Use the 'USE' action to pick it up.\n          _reward, next_state = temp_state_after_movement.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully acquired after 'USE'.\n          if next_state.inventory[item_idx] > temp_state_after_movement.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx) # Remove from stack once successfully handled.\n              return actions, next_state\n          else:\n              # 'USE' action failed to pick up the item (e.g., wrong item used).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n      # Strategy 2: Check if the item has a recipe (requires crafting at a workshop).\n      if item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[item_idx]\n          required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n          workshop_idx = recipe.get(\"_key\")\n\n          # All crafting recipes in CraftWorld that produce an item are assumed to require a workshop.\n          if workshop_idx is None:\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state\n\n          # Recursively gather all required ingredients.\n          current_state_for_ingredients = current_state\n          for ingredient_idx, count_needed in required_ingredients.items():\n              while current_state_for_ingredients.inventory[ingredient_idx] < count_needed:\n                  # Pass a COPY of `visited_recipes_in_stack` to recursive calls for ingredients.\n                  # This allows an ingredient to be crafted even if it was previously processed in a different\n                  # branch of the recipe tree, while still preventing infinite loops within the *current*\n                  # ingredient's own dependency chain.\n                  ingredient_actions, state_after_ingredient = _craft_item_recursive(\n                      current_state_for_ingredients, ingredient_idx, world_obj, visited_recipes_in_stack.copy()\n                  )\n                  if not ingredient_actions and state_after_ingredient.inventory[ingredient_idx] < count_needed:\n                      # Failed to obtain a required ingredient, so cannot craft the main item.\n                      visited_recipes_in_stack.remove(item_idx)\n                      return [], current_state # Indicate failure\n                  actions.extend(ingredient_actions)\n                  current_state_for_ingredients = state_after_ingredient\n\n          # All ingredients gathered. Now, navigate to the workshop and use it to craft the item.\n          path_actions, _final_pos, _final_dir = _bfs_path_with_facing(\n              current_state_for_ingredients.pos,\n              current_state_for_ingredients.dir,\n              workshop_idx,\n              current_state_for_ingredients.grid,\n              world_obj\n          )\n          if path_actions is None:\n              # Cannot reach the required workshop.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n          actions.extend(path_actions)\n          # Simulate state after movement to the workshop.\n          for act in path_actions:\n              _reward, current_state_for_ingredients = current_state_for_ingredients.step(act)\n\n          # Agent is now in position and facing correctly. Use the 'USE' action to craft.\n          _reward, next_state = current_state_for_ingredients.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully crafted after 'USE'.\n          if next_state.inventory[item_idx] > current_state_for_ingredients.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx)\n              return actions, next_state\n          else:\n              # 'USE' action failed to craft the item (e.g., consumed ingredients without success).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n      # If the item is neither a primitive nor has a known recipe, it cannot be crafted.\n      visited_recipes_in_stack.remove(item_idx)\n      return [], current_state\n\n  # Retrieve the current state from the CraftLab environment.\n  # We assume env._current_state holds the initial state for planning this sequence of actions.\n  current_state = env._current_state\n  world = env.world # Reference to the CraftWorld instance, needed for cookbook and grid info.\n\n  # Initiate the recursive planning process.\n  actions, final_state = _craft_item_recursive(current_state, item, world, set())\n\n  # Final verification: Check if the target item's count in the inventory has increased\n  # in the simulated final state compared to the initial state.\n  if final_state.inventory[item] > current_state.inventory[item]:\n      return actions\n  else:\n      return [] # Return an empty list if the item could not be crafted or acquired.", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:42:16.765574", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  def _get_kind_positions(kind_index, grid):\n      \"\"\"\n      Returns a list of (row, col) positions where kind_index exists in the grid.\n      grid shape: (H, W, N_KINDS)\n      \"\"\"\n      # np.argwhere returns (row, col) for non-zero elements.\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      return [tuple(pos) for pos in positions]\n\n  def _get_adjacent_positions(pos, grid_shape):\n      \"\"\"\n      Returns a list of positions adjacent to `pos` within grid boundaries.\n      \"\"\"\n      r, c = pos\n      H, W, _ = grid_shape\n      adj_pos = []\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Up, Down, Left, Right\n          nr, nc = r + dr, c + dc\n          if 0 <= nr < H and 0 <= nc < W:\n              adj_pos.append((nr, nc))\n      return adj_pos\n\n  def _bfs_path(start_pos, start_dir, target_kind_idx, grid, world_obj):\n      \"\"\"\n      Finds a path (list of actions) from `start_pos` to reach the `target_kind_idx`.\n      The goal is to either be at the target's cell (for primitives) or adjacent to it\n      (for workshops/non-grabbables).\n\n      Returns: (actions_list, final_pos, final_dir) or (None, None, None) if no path.\n      \"\"\"\n      queue = collections.deque([(start_pos, start_dir, [])])\n      visited = {(start_pos, start_dir)} # Tracks (position, direction) to avoid cycles and redundant paths\n\n      grid_h, grid_w, _ = grid.shape\n\n      target_positions = _get_kind_positions(target_kind_idx, grid)\n      if not target_positions:\n          return None, None, None # Target does not exist on the current grid\n\n      is_target_primitive = target_kind_idx in world_obj.cookbook.primitives\n\n      # Mapping from movement action to (row_delta, col_delta, new_facing_direction_index)\n      # Assumes CraftWorld uses DMLab-style direction indices: 0=DOWN, 1=UP, 2=RIGHT, 3=LEFT\n      move_deltas = {\n          UP:    (-1, 0, 1),  # Move Up: r-1, c, face Up (dir 1)\n          DOWN:  (1, 0, 0),   # Move Down: r+1, c, face Down (dir 0)\n          LEFT:  (0, -1, 3),  # Move Left: r, c-1, face Left (dir 3)\n          RIGHT: (0, 1, 2)    # Move Right: r, c+1, face Right (dir 2)\n      }\n\n      def is_walkable(p, current_grid, world_ref):\n          \"\"\"Checks if a position `p` is walkable.\"\"\"\n          r, c = p\n          if not (0 <= r < grid_h and 0 <= c < grid_w):\n              return False # Out of bounds\n\n          # Cells containing water are assumed to be impassable\n          if current_grid[r, c, world_ref.water_index] > 0:\n              return False\n          \n          # Cells containing other non-grabbable items (like other workshops or walls)\n          # are assumed impassable for movement, unless the current cell IS the target item itself.\n          # This ensures the agent can move *into* a primitive's cell but not *through* a workshop.\n          for idx in world_ref.non_grabbable_indices:\n              if current_grid[r, c, idx] > 0 and idx != target_kind_idx:\n                  return False\n          \n          return True\n\n      while queue:\n          current_pos, current_dir, current_path = queue.popleft()\n\n          # Check if the current position satisfies the goal condition\n          goal_reached = False\n          if is_target_primitive:\n              # For primitives, the agent needs to be directly on the item's cell to pick it up.\n              if current_pos in target_positions:\n                  goal_reached = True\n          else:\n              # For workshops/non-grabbables, the agent needs to be adjacent to the target.\n              for target_p in target_positions:\n                  if current_pos in _get_adjacent_positions(target_p, grid.shape):\n                      goal_reached = True\n                      break\n\n          if goal_reached:\n              # If the goal is reached, return the path.\n              # The 'USE' action is assumed to work when adjacent/on target, irrespective of precise\n              # agent facing if the item is within the 3x3 'next_to' proximity.\n              return current_path, current_pos, current_dir\n\n          # Explore possible next movements\n          for action in MOVEMENT_ACTIONS:\n              r_delta, c_delta, new_facing_dir = move_deltas[action]\n              next_pos = (current_pos[0] + r_delta, current_pos[1] + c_delta)\n\n              if is_walkable(next_pos, grid, world_obj) and (next_pos, new_facing_dir) not in visited:\n                  next_path = current_path + [action]\n                  visited.add((next_pos, new_facing_dir))\n                  queue.append((next_pos, new_facing_dir, next_path))\n\n      return None, None, None # No path found to the target\n\n  def _craft_item_recursive(current_state, item_idx, world_obj, visited_recipes_in_stack):\n      \"\"\"\n      Recursively plans actions to craft or acquire a specific item.\n\n      Args:\n          current_state: The current CraftState of the agent and world. This state is\n                         simulated and updated throughout the planning process.\n          item_idx: The integer index of the item to craft/acquire.\n          world_obj: The CraftWorld instance, containing cookbook, grid info, etc.\n          visited_recipes_in_stack: A set tracking items currently in the recursion call stack\n                                    to prevent infinite loops due to circular dependencies\n                                    (e.g., A needs B, B needs A).\n\n      Returns:\n          A tuple: (actions_list, final_state)\n          - actions_list: A list of actions (int) to take to get the item.\n          - final_state: The CraftState instance after simulating these actions.\n          Returns ([], current_state) if the item cannot be crafted/acquired or if\n          necessary resources/workshops are unreachable.\n      \"\"\"\n      actions = []\n\n      # Base case 1: If the item is already in the inventory, no actions are needed.\n      if current_state.inventory[item_idx] > 0:\n          return actions, current_state\n\n      # Base case 2: Prevent infinite recursion. If this item is already being processed\n      # higher up in the current call stack, it means we have a circular dependency\n      # that cannot be resolved.\n      if item_idx in visited_recipes_in_stack:\n          return [], current_state \n\n      # Mark this item as currently being processed to detect circular dependencies.\n      visited_recipes_in_stack.add(item_idx)\n\n      cookbook = world_obj.cookbook\n\n      # Strategy 1: Check if the item is a primitive (can be picked up directly from the grid).\n      # This is prioritized as it's typically a simpler acquisition method.\n      if item_idx in cookbook.primitives:\n          # Find a path to the primitive on the grid using the current state's grid layout.\n          path_actions, _final_pos, _final_dir = _bfs_path(\n              current_state.pos, current_state.dir, item_idx, current_state.grid, world_obj\n          )\n          if path_actions is None:\n              # Primitive not reachable/found on the grid in the current state.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n          actions.extend(path_actions)\n          # Simulate the state after movement to the primitive's location.\n          temp_state_after_movement = current_state\n          for act in path_actions:\n              _reward, temp_state_after_movement = temp_state_after_movement.step(act)\n\n          # Agent is now at the primitive's location. Use the 'USE' action to pick it up.\n          _reward, next_state = temp_state_after_movement.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully acquired after the 'USE' action.\n          if next_state.inventory[item_idx] > temp_state_after_movement.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx) # Remove from stack once successfully handled.\n              return actions, next_state\n          else:\n              # 'USE' action failed to pick up the item (e.g., wrong item used, or item depleted).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n      # Strategy 2: Check if the item has a recipe (requires crafting at a workshop).\n      # This is attempted only if the item is not a primitive or primitive acquisition failed.\n      if item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[item_idx]\n          required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n          workshop_idx = recipe.get(\"_key\")\n\n          # All crafting recipes in CraftWorld that produce an item are assumed to require a workshop.\n          if workshop_idx is None:\n              # If a recipe has no workshop key, it cannot be crafted using the 'USE' action\n              # as implemented for workshops in this environment.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state\n\n          # Recursively gather all required ingredients.\n          current_state_for_ingredients = current_state # Start with the current state for ingredient gathering\n          for ingredient_idx, count_needed in required_ingredients.items():\n              while current_state_for_ingredients.inventory[ingredient_idx] < count_needed:\n                  # Recursively call to get each required unit of the ingredient.\n                  # A COPY of `visited_recipes_in_stack` is passed to allow an ingredient\n                  # to be crafted even if it was previously processed in a different branch\n                  # of the recipe tree, while still preventing infinite loops within the\n                  # *current* ingredient's own dependency chain.\n                  ingredient_actions, state_after_ingredient = _craft_item_recursive(\n                      current_state_for_ingredients, ingredient_idx, world_obj, visited_recipes_in_stack.copy()\n                  )\n                  if not ingredient_actions and state_after_ingredient.inventory[ingredient_idx] < count_needed:\n                      # Failed to obtain a required ingredient, so cannot craft the main item.\n                      visited_recipes_in_stack.remove(item_idx)\n                      return [], current_state # Indicate overall failure\n                  \n                  actions.extend(ingredient_actions)\n                  current_state_for_ingredients = state_after_ingredient # Update state for next ingredient/unit\n\n          # All ingredients gathered. Now, navigate to the workshop and use it to craft the item.\n          path_actions, _final_pos, _final_dir = _bfs_path(\n              current_state_for_ingredients.pos,\n              current_state_for_ingredients.dir,\n              workshop_idx,\n              current_state_for_ingredients.grid,\n              world_obj\n          )\n          if path_actions is None:\n              # Cannot reach the required workshop in the current state.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n          actions.extend(path_actions)\n          # Simulate state after movement to the workshop.\n          for act in path_actions:\n              _reward, current_state_for_ingredients = current_state_for_ingredients.step(act)\n\n          # Agent is now adjacent to the workshop. Use it to craft.\n          _reward, next_state = current_state_for_ingredients.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully crafted after the 'USE' action.\n          if next_state.inventory[item_idx] > current_state_for_ingredients.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx)\n              return actions, next_state\n          else:\n              # 'USE' action failed to craft the item (e.g., consumed ingredients without success).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n      # If the item is neither a primitive nor has a known recipe, it cannot be crafted.\n      visited_recipes_in_stack.remove(item_idx)\n      return [], current_state\n\n  # Retrieve the current state from the CraftLab environment.\n  # env._current_state holds the initial state for planning this sequence of actions.\n  current_state = env._current_state\n  world = env.world # Reference to the CraftWorld instance, needed for cookbook and grid info.\n\n  # Initiate the recursive planning process to acquire the target item.\n  # The `set()` tracks items in the current recursion stack to prevent re-processing\n  # an item that's a direct or indirect dependency of itself (circular recipes).\n  initial_item_count = current_state.inventory[item]\n  actions, final_simulated_state = _craft_item_recursive(current_state, item, world, set())\n\n  # Final verification: Check if the target item's count in the inventory has increased\n  # in the simulated final state compared to the initial state.\n  if final_simulated_state.inventory[item] > initial_item_count:\n      return actions\n  else:\n      return [] # Return an empty list if the item could not be crafted or acquired.", "island_id": 4, "scores": {"3": 0.0}}
