{"timestamp": "2025-07-30T14:50:02.834446", "function_name": "craft", "function_body": "  # Action constants based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  initial_craft_state = env._current_state # Get the current CraftState from CraftLab\n  \n  # Queue stores tuples of (CraftState, list_of_actions_to_reach_this_state)\n  # collections.deque is assumed to be available from an outer import\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Visited set stores a hashable representation of the CraftState to avoid cycles and re-exploring.\n  # A CraftState is defined by (grid, pos, dir, inventory).\n  # Use grid.tobytes() and inventory.tobytes() for hashable numpy arrays.\n  visited = set()\n  \n  # Add initial state to visited\n  initial_state_hash = (\n      initial_craft_state.grid.tobytes(),\n      initial_craft_state.pos,\n      initial_craft_state.dir,\n      initial_craft_state.inventory.tobytes()\n  )\n  visited.add(initial_state_hash)\n\n  # Maximum number of states to explore to prevent excessive computation time\n  # and limit the search depth in complex scenarios.\n  MAX_EXPLORED_STATES = 10000 \n  states_explored = 0\n\n  while queue and states_explored < MAX_EXPLORED_STATES:\n      current_state, actions_path = queue.popleft()\n      states_explored += 1\n\n      # Check if the goal is satisfied in the current state.\n      # The `satisfies` method checks if the goal_arg (item index) is in inventory.\n      if current_state.satisfies(None, item):\n          return actions_path\n\n      # Generate next states by trying all possible actions.\n      for action in ACTIONS:\n          # CraftState.step(action) returns (reward, new_state). We only need the new_state.\n          _, next_craft_state = current_state.step(action)\n\n          # Create a hashable representation of the next state for the visited set.\n          next_state_hash = (\n              next_craft_state.grid.tobytes(),\n              next_craft_state.pos,\n              next_craft_state.dir,\n              next_craft_state.inventory.tobytes()\n          )\n\n          # If this state has not been visited, add it to the queue and visited set.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              queue.append((next_craft_state, actions_path + [action]))\n  \n  # If the queue is exhausted (no more states to explore) or MAX_EXPLORED_STATES is reached\n  # without finding the item, return an empty list indicating no path was found within limits.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:50:02.850672", "function_name": "craft", "function_body": "    # A reasonable limit for the length of the action sequence to prevent excessively long plans\n    # and manage computation time for potentially complex crafting tasks.\n    MAX_PLANNING_STEPS = 200\n\n    # Start from the current state of the CraftLab environment\n    initial_craft_state = env._current_state\n\n    # Immediate goal check: If the item is already in inventory, no actions are needed.\n    if initial_craft_state.satisfies(None, item):\n        return []\n\n    # Initialize a queue for Breadth-First Search (BFS).\n    # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state)\n    queue = collections.deque()\n\n    # Initialize a set to store visited state keys to prevent cycles and redundant computation.\n    # A state key is a hashable representation of the CraftState (grid, position, direction, inventory).\n    visited = set()\n\n    # Create the hashable key for the initial state.\n    # numpy.ndarray.tobytes() converts the array data to an immutable byte string, which is hashable.\n    initial_state_key = (\n        initial_craft_state.grid.tobytes(),\n        initial_craft_state.pos,\n        initial_craft_state.dir,\n        initial_craft_state.inventory.tobytes()\n    )\n\n    # Add the initial state to the queue and mark it as visited.\n    queue.append((initial_craft_state, [])) # (current_CraftState, path_actions)\n    visited.add(initial_state_key)\n\n    # Define the set of possible actions.\n    # These constants are assumed to be accessible from the env_factory module.\n    actions = [\n        env_factory.DOWN,\n        env_factory.UP,\n        env_factory.LEFT,\n        env_factory.RIGHT,\n        env_factory.USE\n    ]\n\n    # BFS loop\n    while queue:\n        current_state, path_actions = queue.popleft()\n\n        # Pruning: If the current path exceeds the maximum allowed length, stop exploring this branch.\n        # This helps manage computation time and memory for very long or unreachable goals.\n        if len(path_actions) >= MAX_PLANNING_STEPS:\n            continue # Skip this path, it's too long\n\n        # Explore all possible next states by applying each action.\n        for action in actions:\n            # Simulate the action: CraftState.step returns a new CraftState object,\n            # which is crucial for BFS to avoid modifying states in place.\n            _, next_state = current_state.step(action)\n\n            # Create the hashable key for the next state.\n            next_state_key = (\n                next_state.grid.tobytes(),\n                next_state.pos,\n                next_state.dir,\n                next_state.inventory.tobytes()\n            )\n\n            # If this state has not been visited before, add it to the queue.\n            if next_state_key not in visited:\n                visited.add(next_state_key) # Mark as visited\n                new_path_actions = path_actions + [action] # Extend the path\n\n                # Check if the goal is satisfied in this new state.\n                if next_state.satisfies(None, item):\n                    return new_path_actions # Goal reached, return the sequence of actions\n\n                # Add the new state and its path to the queue for further exploration.\n                queue.append((next_state, new_path_actions))\n\n    # If the queue becomes empty and the goal was not reached, it means no path was found\n    # within the defined limits (e.g., MAX_PLANNING_STEPS).\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:51:37.900189", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants as defined in CraftLab's action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Maximum path length for BFS to prevent excessively long or infinite searches in movement\n    _MAX_BFS_PATH_LEN = 50\n    # Maximum recursion depth for crafting chain to prevent infinite loops (e.g., circular recipes)\n    _MAX_CRAFT_DEPTH = 15\n\n    def _get_path_actions(start_craft_state, target_kind_idx, world):\n        \"\"\"\n        Finds a sequence of actions to move the agent from start_craft_state.pos\n        to be adjacent to an item of `target_kind_idx`.\n        Returns (list of actions, final_craft_state) or (None, None) if no path.\n        The BFS state is (current_craft_state, list_of_actions_to_reach_this_state).\n        Visited states are tracked by (pos_y, pos_x, dir) to prevent cycles and find shortest path.\n        \"\"\"\n        queue = collections.deque([(start_craft_state, [])])\n        # Visited set for BFS: (pos_y, pos_x, dir) to avoid revisiting the same physical and directional state\n        visited = set([(start_craft_state.pos[0], start_craft_state.pos[1], start_craft_state.dir)])\n\n        while queue:\n            current_s, current_actions = queue.popleft()\n\n            # Check if agent is already next to the target item\n            if current_s.next_to(target_kind_idx):\n                return current_actions, current_s\n\n            # Limit path length to prevent excessively long or infinite searches\n            if len(current_actions) >= _MAX_BFS_PATH_LEN:\n                continue\n\n            # Explore possible movement actions\n            for action_type in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n                # Simulate a step. CraftState.step returns (reward, new_state).\n                # The new_state is a copy, allowing for simulation without altering the original.\n                _, next_s = current_s.step(action_type)\n\n                # Check if the step was valid and resulted in a different state/position.\n                # If `step` returns the identical object, it typically means no change occurred (e.g., hit a wall).\n                if next_s is not current_s:\n                    new_state_key = (next_s.pos[0], next_s.pos[1], next_s.dir)\n                    if new_state_key not in visited:\n                        visited.add(new_state_key)\n                        queue.append((next_s, current_actions + [action_type]))\n\n        return None, None # No path found to the target item\n\n    def _recursive_craft(current_sim_state, target_item_idx, world, depth=0):\n        \"\"\"\n        Helper function to recursively plan actions to craft a target_item_idx.\n        It simulates state changes to determine the required actions and their impact.\n        Returns (list of actions, resulting_simulated_state) or (None, None) on failure.\n        `depth` is used to limit recursion to prevent infinite loops (e.g., circular recipes).\n        \"\"\"\n        if depth > _MAX_CRAFT_DEPTH:\n            return None, None # Exceeded maximum recursion depth, likely a complex or circular dependency\n\n        # 1. Check if the target item is already in the inventory (sufficient quantity).\n        # This function aims to acquire at least one unit of the target item.\n        if current_sim_state.inventory[target_item_idx] > 0:\n            return [], current_sim_state # Already have the item, no actions needed\n\n        all_actions = []\n        sim_state = current_sim_state # The current simulated state for this planning branch\n\n        # 2. If the target item is a primitive resource\n        if target_item_idx in world.cookbook.primitives:\n            # Plan actions to move adjacent to the primitive resource\n            path_actions, state_at_primitive = _get_path_actions(sim_state, target_item_idx, world)\n            if path_actions is None:\n                return None, None # Cannot find a path to the primitive\n            all_actions.extend(path_actions)\n            sim_state = state_at_primitive\n\n            # Perform the USE action to acquire/interact with the primitive\n            # CraftState.step handles updating inventory and potentially the grid for collected items.\n            _, sim_state_after_use = sim_state.step(ACTION_USE)\n            all_actions.append(ACTION_USE)\n            sim_state = sim_state_after_use\n\n            # Verify that the USE action successfully acquired the item\n            if sim_state.inventory[target_item_idx] > current_sim_state.inventory[target_item_idx]:\n                 return all_actions, sim_state\n            else:\n                 return None, None # USE action did not result in acquiring the item\n\n        # 3. If the target item is a craftable item (has a recipe)\n        elif target_item_idx in world.cookbook.recipes:\n            recipe = world.cookbook.recipes[target_item_idx]\n            \n            ingredients_needed = {}\n            workshop_kind_idx = None # The integer ID of the required workshop, if any\n\n            # Parse the recipe: separate ingredients from the \"_key\" (workshop)\n            for key, count in recipe.items():\n                if key == \"_key\":\n                    # The value for \"_key\" is the string name of the workshop (e.g., \"workbench\")\n                    workshop_kind_idx = world.cookbook.index.index(count)\n                else:\n                    ingredients_needed[key] = count\n            \n            # Recursively plan to gather each required ingredient\n            for ing_idx, required_count in ingredients_needed.items():\n                # Continue planning for this ingredient until the required quantity is met\n                # This loop is important because `_recursive_craft` typically yields one item per call.\n                while sim_state.inventory[ing_idx] < required_count:\n                    ing_actions, state_after_ing = _recursive_craft(sim_state, ing_idx, world, depth + 1)\n                    if ing_actions is None:\n                        return None, None # Failed to acquire an ingredient, so cannot craft target item\n                    all_actions.extend(ing_actions)\n                    sim_state = state_after_ing # Update simulated state after gathering ingredient\n\n            # All ingredients are (simulated to be) in inventory. Now, move to workshop if needed.\n            if workshop_kind_idx is not None:\n                path_actions, state_at_workshop = _get_path_actions(sim_state, workshop_kind_idx, world)\n                if path_actions is None:\n                    return None, None # Cannot reach the required workshop\n                all_actions.extend(path_actions)\n                sim_state = state_at_workshop\n            \n            # Perform the USE action to craft the target item\n            _, sim_state_after_craft = sim_state.step(ACTION_USE)\n            all_actions.append(ACTION_USE)\n            sim_state = sim_state_after_craft\n            \n            # Verify that crafting was successful (target item quantity increased)\n            if sim_state.inventory[target_item_idx] > current_sim_state.inventory[target_item_idx]:\n                return all_actions, sim_state\n            else:\n                return None, None # Crafting failed or did not yield the desired item\n\n        # 4. Item is neither a primitive nor a craftable item via a known recipe\n        else:\n            return None, None # Cannot acquire or craft this item\n\n    world = env.world\n    initial_state = env._current_state # Get the current state of the environment for planning\n\n    # Initiate the recursive planning process. The '_' indicates we don't need the final simulated state,\n    # only the list of actions.\n    actions, _ = _recursive_craft(initial_state, item, world)\n\n    if actions is None:\n        return [] # Return an empty list if no valid plan was found\n    else:\n        return actions # Return the sequence of actions to craft the item", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:51:37.923570", "function_name": "craft", "function_body": "    initial_state = env._current_state\n\n    # Queue for BFS: stores (current_state, actions_list_to_reach_this_state)\n    # Using a list and pop(0) for simplicity, aware that it's O(N) for each pop.\n    queue = [(initial_state, [])]\n\n    # Visited set: stores hashable representation of states to avoid re-visiting.\n    # A state is uniquely defined by its grid, inventory, position, and direction.\n    visited = set()\n    initial_state_key = (initial_state.grid.tobytes(), initial_state.inventory.tobytes(), initial_state.pos, initial_state.dir)\n    visited.add(initial_state_key)\n\n    # Maximum number of steps to explore to prevent infinite loops or excessively long searches.\n    # This value might need tuning depending on the complexity of the crafting recipes.\n    MAX_BFS_DEPTH = 1000\n\n    while queue:\n        # Dequeue the next state and its action path\n        current_state, actions_taken = queue.pop(0)\n\n        # Check if the current state satisfies the goal\n        # The goal_name parameter is ignored by CraftState.satisfies, so we pass None.\n        if current_state.satisfies(None, item):\n            return actions_taken\n\n        # Prune search if the path length exceeds the maximum allowed depth.\n        if len(actions_taken) >= MAX_BFS_DEPTH:\n            continue\n\n        # Explore all possible actions from the current state (0 to 4: DOWN, UP, LEFT, RIGHT, USE)\n        for action in range(5):\n            # Apply the action to get the next state.\n            # CraftState.step returns a tuple: (reward, new_state). We only need new_state.\n            _reward, new_state = current_state.step(action)\n\n            # Create a hashable key for the new state to check if it has been visited.\n            # numpy arrays are converted to bytes for hashing.\n            new_state_key = (new_state.grid.tobytes(), new_state.inventory.tobytes(), new_state.pos, new_state.dir)\n\n            # If this new state has not been visited before, add it to the queue for exploration\n            # and mark it as visited.\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                queue.append((new_state, actions_taken + [action]))\n\n    # If the BFS completes without finding the goal, it means the item cannot be crafted\n    # from the initial state within the defined search limits.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:53:15.793291", "function_name": "craft", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:54:36.638079", "function_name": "craft", "function_body": "  import collections\n\n  # Define actions based on env.action_specs()\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Helper function to get a hashable representation of a CraftState.\n  # This allows storing visited states in a set to avoid redundant computation and cycles.\n  def get_hashable_state(craft_state):\n      return (craft_state.grid.tobytes(), # Convert numpy array to bytes for hashing\n              craft_state.pos,\n              craft_state.dir,\n              craft_state.inventory.tobytes()) # Convert numpy array to bytes for hashing\n\n  # Initialize the BFS queue with the current state of the environment and an empty list of actions.\n  # The `env` object is a CraftLab instance, and its current state is stored in `_current_state`.\n  initial_craft_state = env._current_state\n  q = collections.deque([(initial_craft_state, [])]) # Queue stores (CraftState, list_of_actions_taken)\n  \n  # Set to keep track of visited states to prevent cycles and redundant exploration.\n  visited = {get_hashable_state(initial_craft_state)} \n\n  # Maximum number of actions to explore in a single path. This acts as a safeguard\n  # against infinitely long searches in complex or unreachable scenarios.\n  MAX_SEARCH_DEPTH = 100 \n\n  while q:\n      current_state, actions_taken = q.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # The `satisfies` method takes `goal_name` (ignored here) and `goal_arg` (the item index).\n      if current_state.satisfies(None, item):\n          return actions_taken\n\n      # If the current path length exceeds the maximum allowed depth, prune this branch.\n      if len(actions_taken) >= MAX_SEARCH_DEPTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns a new state object and a reward (which is always 0.0 in this env).\n          _, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state.\n          new_hashable_state = get_hashable_state(new_state)\n\n          # If this new state has not been visited before, add it to the queue for exploration.\n          if new_hashable_state not in visited:\n              visited.add(new_hashable_state)\n              q.append((new_state, actions_taken + [action]))\n\n  # If the queue becomes empty and the goal was not satisfied,\n  # it means the item cannot be crafted or reached within the defined search limits.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:56:25.539939", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n  \n  # Mapping from direction index to (row_delta, col_delta) of the cell in front\n  # Assumes DMLab-style direction indices: 0=DOWN, 1=UP, 2=RIGHT, 3=LEFT\n  DIRECTION_TO_FRONT_CELL_DELTA = {\n      0: (1, 0),   # Facing DOWN, cell in front is (r+1, c)\n      1: (-1, 0),  # Facing UP, cell in front is (r-1, c)\n      2: (0, 1),   # Facing RIGHT, cell in front is (r, c+1)\n      3: (0, -1)   # Facing LEFT, cell in front is (r, c-1)\n  }\n\n  # Mapping from movement action to (row_delta, col_delta, new_facing_direction_index)\n  # The new facing direction is the direction of movement.\n  MOVE_ACTION_TO_DELTA_AND_DIR = {\n      UP:    (-1, 0, 1),  # Move Up: r-1, c, face Up (dir 1)\n      DOWN:  (1, 0, 0),   # Move Down: r+1, c, face Down (dir 0)\n      LEFT:  (0, -1, 3),  # Move Left: r, c-1, face Left (dir 3)\n      RIGHT: (0, 1, 2)    # Move Right: r, c+1, face Right (dir 2)\n  }\n\n  def _is_valid_pos(pos, grid_shape):\n      r, c = pos\n      H, W, _ = grid_shape\n      return 0 <= r < H and 0 <= c < W\n\n  def _is_walkable(pos, current_grid, world_ref, target_kind_idx_for_pathfinding=None):\n      \"\"\"\n      Checks if a position `pos` is walkable for the agent.\n      `target_kind_idx_for_pathfinding`: The specific kind index the BFS is trying to reach/interact with.\n                                          Allows walking onto target primitive. Blocks walking onto target workshop.\n      \"\"\"\n      r, c = pos\n      H, W, _ = current_grid.shape\n      if not (0 <= r < H and 0 <= c < W):\n          return False # Out of bounds\n\n      # Water is always impassable\n      if current_grid[r, c, world_ref.water_index] > 0:\n          return False\n      \n      # Iterate through all kinds present at 'pos'\n      # Check if any non-grabbable item, particularly a workshop, makes the cell impassable.\n      for k_idx in world_ref.cookbook.kinds: # Iterate through all known kinds\n          if current_grid[r, c, k_idx] > 0: # If this kind is present at the cell\n              # If it's a non-grabbable item (e.g., workshops, stone)\n              if k_idx in world_ref.non_grabbable_indices:\n                  # If this non-grabbable item is NOT the specific target we are trying to pathfind to,\n                  # it's an obstacle (e.g., trying to path to wood, but there's a stone in the way).\n                  if k_idx != target_kind_idx_for_pathfinding:\n                      return False \n                  # If this non-grabbable item IS the target_kind_idx_for_pathfinding,\n                  # we still need to check if it's a workshop. Workshops are typically not walkable terrain.\n                  elif k_idx in world_ref.workshop_indices:\n                      return False # Workshops are generally not walkable terrain.\n\n      return True\n\n  def _get_kind_positions(kind_index, grid):\n      \"\"\"\n      Returns a list of (row, col) positions where kind_index exists in the grid.\n      grid shape: (H, W, N_KINDS)\n      \"\"\"\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      return [tuple(pos) for pos in positions]\n\n  def _bfs_path_with_facing(start_pos, start_dir, target_kind_idx, grid, world_obj):\n      \"\"\"\n      Finds a path (list of actions) from `start_pos` to reach a state where the `target_kind_idx`\n      can be interacted with using the 'USE' action.\n      This means either being on the target's cell (for primitives) or adjacent to it and facing it\n      (for workshops).\n\n      Returns: (actions_list, final_pos, final_dir) or (None, None, None) if no path.\n      \"\"\"\n      queue = collections.deque([(start_pos, start_dir, [])])\n      # Visited set tracks (position, direction) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      target_positions = _get_kind_positions(target_kind_idx, grid)\n      if not target_positions:\n          return None, None, None # Target does not exist on the current grid\n\n      is_target_primitive = target_kind_idx in world_obj.cookbook.primitives\n      \n      # Pre-calculate all valid (agent_pos, agent_dir) pairs that enable 'USE' on a target.\n      goal_states_for_use = set()\n      for tr, tc in target_positions:\n          if is_target_primitive:\n              # For primitives, agent needs to be on the item's cell. Direction might not matter for pickup.\n              for d in range(4): # All 4 directions are valid at the target cell for pickup\n                  goal_states_for_use.add(((tr, tc), d))\n          else:\n              # For workshops/non-primitives, agent needs to be adjacent and face the target.\n              for d_idx, (dr, dc) in DIRECTION_TO_FRONT_CELL_DELTA.items():\n                  # Calculate agent position (ar, ac) if facing (dr, dc) towards (tr,tc)\n                  ar, ac = tr - dr, tc - dc \n                  if _is_valid_pos((ar, ac), grid.shape): # Check validity before adding to goal states\n                      goal_states_for_use.add(((ar, ac), d_idx))\n\n      while queue:\n          current_pos, current_dir, current_path = queue.popleft()\n\n          # Check if the current (pos, dir) is a goal state for 'USE' action\n          if (current_pos, current_dir) in goal_states_for_use:\n              # Additional check: Is the target still present at the expected interaction location?\n              # This is important for primitives, as they are consumed. Workshops remain.\n              target_is_present = False\n              if is_target_primitive:\n                  # If pathfinding to a primitive, it must be at the agent's current position.\n                  if grid[current_pos[0], current_pos[1], target_kind_idx] > 0:\n                      target_is_present = True\n              else: # Workshop or other adjacent-interactable item\n                  # If pathfinding to a workshop, it must be in the cell in front of the agent.\n                  fr, fc = current_pos[0] + DIRECTION_TO_FRONT_CELL_DELTA[current_dir][0], \\\n                           current_pos[1] + DIRECTION_TO_FRONT_CELL_DELTA[current_dir][1]\n                  if _is_valid_pos((fr, fc), grid.shape) and grid[fr, fc, target_kind_idx] > 0:\n                      target_is_present = True\n              \n              if target_is_present:\n                  return current_path, current_pos, current_dir\n\n          # Explore possible next movements\n          for action in MOVEMENT_ACTIONS:\n              r_delta, c_delta, new_facing_dir = MOVE_ACTION_TO_DELTA_AND_DIR[action]\n              next_pos = (current_pos[0] + r_delta, current_pos[1] + c_delta)\n\n              # Pass the target_kind_idx to _is_walkable to allow specific logic for target cells\n              if _is_valid_pos(next_pos, grid.shape) and \\\n                 _is_walkable(next_pos, grid, world_obj, target_kind_idx) and \\\n                 (next_pos, new_facing_dir) not in visited:\n                  next_path = current_path + [action]\n                  visited.add((next_pos, new_facing_dir))\n                  queue.append((next_pos, new_facing_dir, next_path))\n\n      return None, None, None # No path found to the target\n\n  def _craft_item_recursive(current_state, item_idx, world_obj, visited_recipes_in_stack):\n      \"\"\"\n      Recursively plans actions to craft or acquire a specific item.\n\n      Args:\n          current_state: The current CraftState of the agent and world.\n          item_idx: The integer index of the item to craft/acquire.\n          world_obj: The CraftWorld instance, containing cookbook, grid info, etc.\n          visited_recipes_in_stack: A set tracking items currently in the recursion call stack\n                                    to prevent infinite loops due to circular dependencies.\n\n      Returns:\n          A tuple: (actions_list, final_state)\n          - actions_list: A list of actions (int) to take to get the item.\n          - final_state: The CraftState instance after simulating these actions.\n          Returns ([], current_state) if the item cannot be crafted/acquired.\n      \"\"\"\n      actions = []\n\n      # Base case 1: If the item is already in the inventory, no actions are needed.\n      if current_state.inventory[item_idx] > 0:\n          return actions, current_state\n\n      # Base case 2: Prevent infinite recursion for items involved in a dependency cycle\n      # within the current planning path.\n      if item_idx in visited_recipes_in_stack:\n          return [], current_state \n\n      # Mark this item as currently being processed in the recursion stack.\n      visited_recipes_in_stack.add(item_idx)\n\n      cookbook = world_obj.cookbook\n\n      # Strategy 1: Check if the item is a primitive (can be picked up directly from the grid).\n      if item_idx in cookbook.primitives:\n          path_actions, _final_pos, _final_dir = _bfs_path_with_facing(\n              current_state.pos, current_state.dir, item_idx, current_state.grid, world_obj\n          )\n          if path_actions is None:\n              # Primitive not reachable/found on the grid.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state\n\n          actions.extend(path_actions)\n          # Simulate the state after movement to the primitive.\n          temp_state_after_movement = current_state\n          for act in path_actions:\n              _reward, temp_state_after_movement = temp_state_after_movement.step(act)\n\n          # Agent is now in position and facing correctly. Use the 'USE' action to pick it up.\n          _reward, next_state = temp_state_after_movement.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully acquired after 'USE'.\n          if next_state.inventory[item_idx] > temp_state_after_movement.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx) # Remove from stack once successfully handled.\n              return actions, next_state\n          else:\n              # 'USE' action failed to pick up the item (e.g., wrong item used).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n      # Strategy 2: Check if the item has a recipe (requires crafting at a workshop).\n      if item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[item_idx]\n          required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n          workshop_idx = recipe.get(\"_key\")\n\n          # All crafting recipes in CraftWorld that produce an item are assumed to require a workshop.\n          if workshop_idx is None:\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state\n\n          # Recursively gather all required ingredients.\n          current_state_for_ingredients = current_state\n          for ingredient_idx, count_needed in required_ingredients.items():\n              while current_state_for_ingredients.inventory[ingredient_idx] < count_needed:\n                  # Pass a COPY of `visited_recipes_in_stack` to recursive calls for ingredients.\n                  # This allows an ingredient to be crafted even if it was previously processed in a different\n                  # branch of the recipe tree, while still preventing infinite loops within the *current*\n                  # ingredient's own dependency chain.\n                  ingredient_actions, state_after_ingredient = _craft_item_recursive(\n                      current_state_for_ingredients, ingredient_idx, world_obj, visited_recipes_in_stack.copy()\n                  )\n                  if not ingredient_actions and state_after_ingredient.inventory[ingredient_idx] < count_needed:\n                      # Failed to obtain a required ingredient, so cannot craft the main item.\n                      visited_recipes_in_stack.remove(item_idx)\n                      return [], current_state # Indicate failure\n                  actions.extend(ingredient_actions)\n                  current_state_for_ingredients = state_after_ingredient\n\n          # All ingredients gathered. Now, navigate to the workshop and use it to craft the item.\n          path_actions, _final_pos, _final_dir = _bfs_path_with_facing(\n              current_state_for_ingredients.pos,\n              current_state_for_ingredients.dir,\n              workshop_idx,\n              current_state_for_ingredients.grid,\n              world_obj\n          )\n          if path_actions is None:\n              # Cannot reach the required workshop.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n          actions.extend(path_actions)\n          # Simulate state after movement to the workshop.\n          for act in path_actions:\n              _reward, current_state_for_ingredients = current_state_for_ingredients.step(act)\n\n          # Agent is now in position and facing correctly. Use the 'USE' action to craft.\n          _reward, next_state = current_state_for_ingredients.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully crafted after 'USE'.\n          if next_state.inventory[item_idx] > current_state_for_ingredients.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx)\n              return actions, next_state\n          else:\n              # 'USE' action failed to craft the item (e.g., consumed ingredients without success).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state # Indicate failure\n\n      # If the item is neither a primitive nor has a known recipe, it cannot be crafted.\n      visited_recipes_in_stack.remove(item_idx)\n      return [], current_state\n\n  # Retrieve the current state from the CraftLab environment.\n  # We assume env._current_state holds the initial state for planning this sequence of actions.\n  current_state = env._current_state\n  world = env.world # Reference to the CraftWorld instance, needed for cookbook and grid info.\n\n  # Initiate the recursive planning process.\n  actions, final_state = _craft_item_recursive(current_state, item, world, set())\n\n  # Final verification: Check if the target item's count in the inventory has increased\n  # in the simulated final state compared to the initial state.\n  if final_state.inventory[item] > current_state.inventory[item]:\n      return actions\n  else:\n      return [] # Return an empty list if the item could not be crafted or acquired.", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:56:26.937307", "function_name": "craft", "function_body": "  \"\"\"Improved version of `craft_v1`. This version includes an early exit if the target item is already in the inventory.\"\"\"\n  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n  \n  # Mapping from direction index to (row_delta, col_delta) of the cell in front\n  # Assumes DMLab-style direction indices: 0=DOWN, 1=UP, 2=RIGHT, 3=LEFT\n  DIRECTION_TO_FRONT_CELL_DELTA = {\n      0: (1, 0),   # Facing DOWN, cell in front is (r+1, c)\n      1: (-1, 0),  # Facing UP, cell in front is (r-1, c)\n      2: (0, 1),   # Facing RIGHT, cell in front is (r, c+1)\n      3: (0, -1)   # Facing LEFT, cell in front is (r, c-1)\n  }\n\n  # Mapping from movement action to (row_delta, col_delta, new_facing_direction_index)\n  # The new facing direction is the direction of movement.\n  MOVE_ACTION_TO_DELTA_AND_DIR = {\n      UP:    (-1, 0, 1),  # Move Up: r-1, c, face Up (dir 1)\n      DOWN:  (1, 0, 0),   # Move Down: r+1, c, face Down (dir 0)\n      LEFT:  (0, -1, 3),  # Move Left: r, c-1, face Left (dir 3)\n      RIGHT: (0, 1, 2)    # Move Right: r, c+1, face Right (dir 2)\n  }\n\n  def _is_valid_pos(pos, grid_shape):\n      r, c = pos\n      H, W, _ = grid_shape\n      return 0 <= r < H and 0 <= c < W\n\n  def _is_walkable(pos, current_grid, world_ref, target_kind_idx_for_pathfinding=None):\n      \"\"\"\n      Checks if a position `pos` is walkable.\n      `target_kind_idx_for_pathfinding`: The specific kind index the BFS is trying to reach.\n                                          Allows walking onto target primitive or ignoring target workshop as obstacle.\n      \"\"\"\n      r, c = pos\n      H, W, _ = current_grid.shape\n      if not (0 <= r < H and 0 <= c < W):\n          return False # Out of bounds\n\n      # Water is always impassable\n      if current_grid[r, c, world_ref.water_index] > 0:\n          return False\n      \n      # Non-grabbable items are generally obstacles.\n      # If a cell contains any non-grabbable item that is NOT our specific target, it's an obstacle.\n      # This allows us to walk onto a cell if it contains a primitive (which might be in non_grabbable_indices\n      # in some configurations, though typically primitives are grabbable), or to navigate around other workshops.\n      for idx in world_ref.non_grabbable_indices:\n          if current_grid[r, c, idx] > 0:\n              if idx != target_kind_idx_for_pathfinding:\n                  return False\n      \n      return True\n\n  def _get_kind_positions(kind_index, grid):\n      \"\"\"\n      Returns a list of (row, col) positions where kind_index exists in the grid.\n      grid shape: (H, W, N_KINDS)\n      \"\"\"\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      return [tuple(pos) for pos in positions]\n\n  def _bfs_path_with_facing(start_pos, start_dir, target_kind_idx, grid, world_obj):\n      \"\"\"\n      Finds a path (list of actions) from `start_pos` to reach a state where the `target_kind_idx`\n      can be interacted with using the 'USE' action.\n      This means either being on the target's cell (for primitives) or adjacent to it and facing it\n      (for workshops).\n\n      Returns: (actions_list, final_pos, final_dir) or (None, None, None) if no path.\n      \"\"\"\n      queue = collections.deque([(start_pos, start_dir, [])])\n      # Visited set tracks (position, direction) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      target_positions = _get_kind_positions(target_kind_idx, grid)\n      if not target_positions:\n          return None, None, None # Target does not exist on the current grid\n\n      is_target_primitive = target_kind_idx in world_obj.cookbook.primitives\n      \n      # Pre-calculate all valid (agent_pos, agent_dir) pairs that enable 'USE' on a target.\n      goal_states_for_use = set()\n      for tr, tc in target_positions:\n          if is_target_primitive:\n              # For primitives, agent needs to be on the item's cell. Direction might not matter for pickup.\n              # Assuming direction doesn't block pickup if on the cell for primitives.\n              for d in range(4): # All 4 directions are valid at the target cell for pickup\n                  if _is_walkable((tr, tc), grid, world_obj, target_kind_idx):\n                      goal_states_for_use.add(((tr, tc), d))\n          else:\n              # For workshops/non-grabbables, agent needs to be adjacent and face the target.\n              for d_idx, (dr, dc) in DIRECTION_TO_FRONT_CELL_DELTA.items():\n                  # Calculate agent position (ar, ac) if facing (dr, dc) towards (tr,tc)\n                  ar, ac = tr - dr, tc - dc \n                  if _is_valid_pos((ar, ac), grid.shape) and\\\n                     _is_walkable((ar, ac), grid, world_obj, target_kind_idx):\n                      goal_states_for_use.add(((ar, ac), d_idx))\n\n      while queue:\n          current_pos, current_dir, current_path = queue.popleft()\n\n          # Check if the current (pos, dir) is a goal state for 'USE' action\n          if ((current_pos, current_dir)) in goal_states_for_use:\n              return current_path, current_pos, current_dir\n\n          # Explore possible next movements\n          for action in MOVEMENT_ACTIONS:\n              r_delta, c_delta, new_facing_dir = MOVE_ACTION_TO_DELTA_AND_DIR[action]\n              next_pos = (current_pos[0] + r_delta, current_pos[1] + c_delta)\n\n              if _is_walkable(next_pos, grid, world_obj, target_kind_idx) and\\\n                 (next_pos, new_facing_dir) not in visited:\n                  next_path = current_path + [action]\n                  visited.add((next_pos, new_facing_dir))\n                  queue.append((next_pos, new_facing_dir, next_path))\n\n      return None, None, None # No path found to the target\n\n  def _craft_item_recursive(current_state_in_recursion, item_idx, world_obj, visited_recipes_in_stack):\n      \"\"\"\n      Recursively plans actions to craft or acquire a specific item.\n\n      Args:\n          current_state_in_recursion: The current CraftState of the agent and world.\n          item_idx: The integer index of the item to craft/acquire.\n          world_obj: The CraftWorld instance, containing cookbook, grid info, etc.\n          visited_recipes_in_stack: A set tracking items currently in the recursion call stack\n                                    to prevent infinite loops due to circular dependencies.\n\n      Returns:\n          A tuple: (actions_list, final_state)\n          - actions_list: A list of actions (int) to take to get the item.\n          - final_state: The CraftState instance after simulating these actions.\n          Returns ([], current_state_in_recursion) if the item cannot be crafted/acquired.\n      \"\"\"\n      actions = []\n\n      # Base case 1: If the item is already in the inventory, no actions are needed.\n      if current_state_in_recursion.inventory[item_idx] > 0:\n          return actions, current_state_in_recursion\n\n      # Base case 2: Prevent infinite recursion for items involved in a dependency cycle\n      # within the current planning path.\n      if item_idx in visited_recipes_in_stack:\n          return [], current_state_in_recursion \n\n      # Mark this item as currently being processed in the recursion stack.\n      visited_recipes_in_stack.add(item_idx)\n\n      cookbook = world_obj.cookbook\n\n      # Strategy 1: Check if the item is a primitive (can be picked up directly from the grid).\n      if item_idx in cookbook.primitives:\n          path_actions, _final_pos, _final_dir = _bfs_path_with_facing(\n              current_state_in_recursion.pos, current_state_in_recursion.dir, item_idx, current_state_in_recursion.grid, world_obj\n          )\n          if path_actions is None:\n              # Primitive not reachable/found on the grid.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state_in_recursion\n\n          actions.extend(path_actions)\n          # Simulate the state after movement to the primitive.\n          simulated_state = current_state_in_recursion\n          for act in path_actions:\n              _reward, simulated_state = simulated_state.step(act)\n\n          # Agent is now in position and facing correctly. Use the 'USE' action to pick it up.\n          _reward, next_state = simulated_state.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully acquired after 'USE'.\n          if next_state.inventory[item_idx] > simulated_state.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx) # Remove from stack once successfully handled.\n              return actions, next_state\n          else:\n              # 'USE' action failed to pick up the item (e.g., wrong item used).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state_in_recursion # Indicate failure\n\n      # Strategy 2: Check if the item has a recipe (requires crafting at a workshop).\n      if item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[item_idx]\n          required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n          workshop_idx = recipe.get(\"_key\")\n\n          # All crafting recipes in CraftWorld that produce an item are assumed to require a workshop.\n          if workshop_idx is None:\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state_in_recursion\n\n          # Recursively gather all required ingredients.\n          simulated_state_for_ingredients = current_state_in_recursion\n          for ingredient_idx, count_needed in required_ingredients.items():\n              while simulated_state_for_ingredients.inventory[ingredient_idx] < count_needed:\n                  # Pass a COPY of `visited_recipes_in_stack` to recursive calls for ingredients.\n                  # This allows an ingredient to be crafted even if it was previously processed in a different\n                  # branch of the recipe tree, while still preventing infinite loops within the *current*\n                  # ingredient's own dependency chain.\n                  ingredient_actions, state_after_ingredient = _craft_item_recursive(\n                      simulated_state_for_ingredients, ingredient_idx, world_obj, visited_recipes_in_stack.copy()\n                  )\n                  if not ingredient_actions and state_after_ingredient.inventory[ingredient_idx] < count_needed:\n                      # Failed to obtain a required ingredient, so cannot craft the main item.\n                      visited_recipes_in_stack.remove(item_idx)\n                      return [], current_state_in_recursion # Indicate failure\n                  actions.extend(ingredient_actions)\n                  simulated_state_for_ingredients = state_after_ingredient\n\n          # All ingredients gathered. Now, navigate to the workshop and use it to craft the item.\n          path_actions, _final_pos, _final_dir = _bfs_path_with_facing(\n              simulated_state_for_ingredients.pos,\n              simulated_state_for_ingredients.dir,\n              workshop_idx,\n              simulated_state_for_ingredients.grid,\n              world_obj\n          )\n          if path_actions is None:\n              # Cannot reach the required workshop.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state_in_recursion # Indicate failure\n\n          actions.extend(path_actions)\n          # Simulate state after movement to the workshop.\n          for act in path_actions:\n              _reward, simulated_state_for_ingredients = simulated_state_for_ingredients.step(act)\n\n          # Agent is now in position and facing correctly. Use the 'USE' action to craft.\n          _reward, next_state = simulated_state_for_ingredients.step(USE)\n          actions.append(USE)\n\n          # Verify if the item was successfully crafted after 'USE'.\n          if next_state.inventory[item_idx] > simulated_state_for_ingredients.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx)\n              return actions, next_state\n          else:\n              # 'USE' action failed to craft the item (e.g., consumed ingredients without success).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_state_in_recursion # Indicate failure\n\n      # If the item is neither a primitive nor has a known recipe, it cannot be crafted.\n      visited_recipes_in_stack.remove(item_idx)\n      return [], current_state_in_recursion\n\n  # Retrieve the current state from the CraftLab environment.\n  # We assume env._current_state holds the initial state for planning this sequence of actions.\n  initial_state = env._current_state\n  world = env.world # Reference to the CraftWorld instance, needed for cookbook and grid info.\n\n  # Early exit: If the item is already present in the initial inventory, no actions are needed.\n  if initial_state.inventory[item] > 0:\n      return []\n\n  # Initiate the recursive planning process.\n  actions, final_simulated_state = _craft_item_recursive(initial_state, item, world, set())\n\n  # Final verification: Check if the target item's count in the inventory has increased\n  # in the simulated final state compared to the initial state.\n  if final_simulated_state.inventory[item] > initial_state.inventory[item]:\n      return actions\n  else:\n      return [] # Return an empty list if the item could not be crafted or acquired.", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:58:13.475004", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants (as per DMLab's definition in action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Memoization table for _solve_for_item function\n  # Stores (state_key, target_item_idx) -> list of actions or None\n  # state_key: (agent_pos, agent_dir, inventory_tuple, grid_bytes)\n  _solve_memo = {}\n\n  def _solve_for_item(current_state, target_item_idx):\n      \"\"\"\n      Recursively finds a path of actions to acquire `target_item_idx`.\n      Memoizes results to avoid recomputing paths for identical states/goals.\n\n      Args:\n          current_state: A CraftState instance representing the current environment state.\n          target_item_idx: The integer index of the item to acquire.\n\n      Returns:\n          A list of integer actions to acquire the item, or None if impossible.\n      \"\"\"\n      # Create a unique key for the current state for memoization\n      # Convert inventory and grid to hashable forms (tuple for inventory, bytes for grid)\n      state_key = (current_state.pos, current_state.dir,\n                   tuple(current_state.inventory), current_state.grid.tobytes())\n\n      memo_key = (state_key, target_item_idx)\n      if memo_key in _solve_memo:\n          return _solve_memo[memo_key]\n\n      # Base case: The target item is already in the inventory\n      if current_state.satisfies(None, target_item_idx):\n          _solve_memo[memo_key] = []\n          return []\n\n      cookbook = current_state.world.cookbook\n      total_actions_path = []\n      # Use a simulated_state to track changes as actions are \"found\"\n      simulated_state = current_state\n\n      # --- Strategy 1: Acquire as a primitive (if it is one) ---\n      # Check if target_item_idx is in the set of known primitive resources\n      if target_item_idx in cookbook.primitives:\n          # Find path to the primitive resource and include a USE action\n          actions_to_primitive_source = _pathfind_and_use(simulated_state, target_item_idx)\n\n          if actions_to_primitive_source is not None:\n              # Apply these actions to a temporary simulated state to verify acquisition\n              temp_sim_state = simulated_state\n              for action in actions_to_primitive_source:\n                  _, temp_sim_state = temp_sim_state.step(action)\n\n              # Verify if the primitive was actually acquired (inventory count increased)\n              if temp_sim_state.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n                  _solve_memo[memo_key] = actions_to_primitive_source\n                  return actions_to_primitive_source\n              # If path found but item not acquired (e.g., depleted), fall through to try recipes.\n\n      # --- Strategy 2: Acquire via a recipe (if it's a craftable item) ---\n      # Check if target_item_idx is an output of any known recipe\n      if target_item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[target_item_idx]\n          # Filter out the \"_key\" field to get only ingredient requirements\n          required_ingredients = {k: v for k, v in recipe.items() if k != '_key'}\n\n          # Identify all missing ingredient instances needed (accounting for current inventory)\n          missing_ingredient_instances = []\n          for ing_idx, req_count in required_ingredients.items():\n              current_count = simulated_state.inventory[ing_idx]\n              # Add `ing_idx` to the list `req_count - current_count` times\n              for _ in range(req_count - current_count):\n                  missing_ingredient_instances.append(ing_idx)\n\n          # Iteratively try to acquire each missing ingredient instance\n          for ing_idx_to_get in missing_ingredient_instances:\n              # Recursively call _solve_for_item to get path for this ingredient\n              sub_path = _solve_for_item(simulated_state, ing_idx_to_get)\n              if sub_path is None:\n                  # If any ingredient cannot be acquired, this recipe cannot be fulfilled.\n                  _solve_memo[memo_key] = None\n                  return None\n\n              total_actions_path.extend(sub_path)\n              # Update the simulated state by applying the sub_path actions\n              for action in sub_path:\n                  _, simulated_state = simulated_state.step(action)\n\n          # After acquiring all necessary ingredients, craft at a workshop\n          if cookbook.workshop_indices: # Ensure there's at least one workshop type\n              workshop_idx = cookbook.workshop_indices[0] # Assume any workshop type will work\n\n              # Pathfind to the workshop and include a USE action\n              actions_to_workshop = _pathfind_and_use(simulated_state, workshop_idx)\n\n              if actions_to_workshop is not None:\n                  # Apply these actions to a temporary simulated state\n                  temp_state_after_craft = simulated_state\n                  for action in actions_to_workshop:\n                      _, temp_state_after_craft = temp_state_after_craft.step(action)\n\n                  # Verify if the target item was crafted (inventory count increased)\n                  # Compare against the initial inventory of this _solve_for_item call\n                  if temp_state_after_craft.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n                      total_actions_path.extend(actions_to_workshop)\n                      _solve_memo[memo_key] = total_actions_path\n                      return total_actions_path\n                  # If path found but item not crafted, fall through.\n\n      # If neither primitive collection nor recipe crafting led to the item from this state,\n      # mark this path as impossible and return None.\n      _solve_memo[memo_key] = None\n      return None\n\n\n  def _pathfind_and_use(initial_state, target_kind_idx) -> list[int] or None:\n      \"\"\"\n      Performs a BFS to find a path of movement actions to be adjacent to `target_kind_idx`.\n      Once adjacent, it appends the ACTION_USE to the path and returns it.\n      This function focuses purely on spatial navigation and a final interaction.\n\n      Args:\n          initial_state: The CraftState instance to start pathfinding from.\n          target_kind_idx: The integer index of the entity kind to find and use.\n\n      Returns:\n          A list of integer actions (movement + USE) or None if no path found.\n      \"\"\"\n      q = collections.deque([(initial_state, [])])\n      # Visited set for BFS during pathfinding. Only (pos, dir) needed as inventory/grid\n      # typically don't change during pure movement actions.\n      visited_positions = set([(initial_state.pos, initial_state.dir)])\n\n      while q:\n          current_sim_state, actions_taken = q.popleft()\n\n          # Check if we are now next to the target kind\n          if current_sim_state.next_to(target_kind_idx):\n              # If next to it, append the USE action and return the complete path\n              return actions_taken + [ACTION_USE]\n\n          # Explore possible movement actions (DOWN, UP, LEFT, RIGHT)\n          for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n              # Simulate the step without permanently changing current_sim_state for the queue\n              # rewards are ignored for pathfinding\n              _, new_sim_state = current_sim_state.step(action)\n              new_pos_dir = (new_sim_state.pos, new_sim_state.dir)\n\n              # Add to queue if this (pos, dir) hasn't been visited in this pathfinding context\n              if new_pos_dir not in visited_positions:\n                  visited_positions.add(new_pos_dir)\n                  q.append((new_sim_state, actions_taken + [action]))\n\n      return None # No path found to be next to and use the target_kind_idx\n\n  # Clear memoization table before the first call to craft_v2 to ensure fresh planning\n  # This makes craft_v2 behave as if it's stateless across calls within a larger system.\n  _solve_memo.clear()\n\n  # Get initial CraftState from the CraftLab environment\n  # CraftLab holds the current CraftState in _current_state\n  initial_craft_state = env._current_state\n\n  # Call the recursive solver\n  path = _solve_for_item(initial_craft_state, item)\n  return path if path is not None else []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:58:13.493956", "function_name": "craft", "function_body": "    # Action constants for the CraftWorld environment\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Helper function to generate a hashable representation of a CraftState.\n    # This is crucial for using a set to keep track of visited states in BFS,\n    # preventing redundant computations and infinite loops.\n    def _get_hashable_state(craft_state):\n        # Agent's position (x, y) as an immutable tuple\n        pos = tuple(craft_state.pos)\n        # Agent's facing direction as an integer\n        direction = craft_state.dir\n        \n        # Inventory: Convert the numpy array to a tuple of integers.\n        # .astype(np.int32) ensures consistent integer representation,\n        # and .tolist() converts to a Python list which is then made a tuple.\n        inventory = tuple(craft_state.inventory.astype(np.int32).tolist())\n        \n        # Grid: Convert the numpy grid array to bytes for hashing.\n        # .astype(np.float32) ensures consistent float representation before converting to bytes.\n        # Hashing the bytes provides a unique identifier for the grid's configuration.\n        grid_data_for_hash = craft_state.grid.astype(np.float32).tobytes()\n        grid_hash = hash(grid_data_for_hash)\n        \n        # Combine all relevant parts into a single hashable tuple\n        return (pos, direction, inventory, grid_hash)\n\n    # Get the initial state from the CraftLab environment\n    initial_craft_state = env._current_state\n    goal_item_idx = item  # The target item's index\n\n    # Initialize the BFS queue.\n    # Each element is a tuple: (current_craft_state_instance, list_of_actions_to_reach_this_state).\n    # Using a list and managing a 'head' pointer to simulate deque's efficiency without importing collections.deque.\n    q = [] \n    q.append((initial_craft_state, []))\n\n    # Set to store visited states to avoid cycles and re-exploring the same state.\n    # States are stored using their hashable representation.\n    visited = set()\n    visited.add(_get_hashable_state(initial_craft_state))\n\n    # A maximum depth/step limit for the BFS to prevent excessively long searches\n    # or to handle cases where no solution exists within reasonable bounds.\n    MAX_BFS_STEPS = 200 \n\n    # Manually manage the queue head pointer for efficient pops (amortized O(1)).\n    head = 0\n    while head < len(q):\n        current_state, path = q[head]\n        head += 1  # Move head to the next element\n\n        # Check if the current state satisfies the goal.\n        # CraftState.satisfies(goal_name, goal_arg) expects goal_name (ignored here) and goal_arg (item index).\n        if current_state.satisfies(None, goal_item_idx):\n            return path  # Goal reached, return the sequence of actions\n\n        # If the current path length exceeds the maximum allowed BFS steps, prune this path.\n        if len(path) >= MAX_BFS_STEPS:\n            continue\n\n        # Explore all possible actions from the current state\n        for action in [DOWN, UP, LEFT, RIGHT, USE]:\n            # Simulate the action to get the next state.\n            # CraftState.step(action) returns (reward, new_craft_state).\n            # The reward is 0.0 in this implementation, so we only need the new state.\n            _, next_state = current_state.step(action)\n\n            # Get the hashable representation of the next state\n            next_hashable_state = _get_hashable_state(next_state)\n\n            # If this next state has not been visited yet:\n            if next_hashable_state not in visited:\n                # Add it to the visited set\n                visited.add(next_hashable_state)\n                # Add it to the queue with the updated path\n                q.append((next_state, path + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means no path\n    # was found within the defined search limits.\n    return []", "island_id": 0, "scores": {"3": -1}}
