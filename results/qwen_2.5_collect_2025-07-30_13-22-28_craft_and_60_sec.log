{"timestamp": "2025-07-30T14:48:58.601441", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define helper for creating a hashable state key\n  def _get_state_key(state):\n    \"\"\"Generates a hashable key for a CraftState object.\"\"\"\n    return (\n        state.grid.tobytes(),        # Grid content\n        state.inventory.tobytes(),   # Inventory content\n        state.pos,                   # Agent position (tuple)\n        state.dir                    # Agent direction (int)\n    )\n\n  # Reset the environment to its initial state before starting the search.\n  # This ensures the planning starts from the scenario's defined initial configuration.\n  env.reset() \n  initial_craft_state = env._current_state\n\n  # If the item is already crafted in the initial state, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n    return []\n\n  # Initialize a deque for BFS, storing tuples of (state, actions_path)\n  queue = collections.deque()\n  # Initialize a set to keep track of visited state keys to avoid redundant exploration and cycles.\n  visited = set()\n\n  # Add the initial state to the queue with an empty action path.\n  queue.append((initial_craft_state, []))\n  visited.add(_get_state_key(initial_craft_state))\n\n  # Get the number of possible actions from the world configuration.\n  # This typically includes DOWN, UP, LEFT, RIGHT, USE.\n  ACTIONS = range(env.world.n_actions)\n\n  # Perform Breadth-First Search\n  while queue:\n    current_state, current_actions = queue.popleft()\n\n    # Explore all possible actions from the current state\n    for action in ACTIONS:\n      # Simulate the action to get the next state.\n      # CraftState.step returns a new CraftState object, preserving the current_state.\n      _reward, next_state = current_state.step(action) \n\n      next_state_key = _get_state_key(next_state)\n\n      # If this next_state has not been visited before:\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        new_actions_path = current_actions + [action]\n\n        # Check if the goal item is crafted in this new state\n        if next_state.satisfies(None, item):\n          return new_actions_path  # Goal reached, return the path\n\n        # Add the new state to the queue for further exploration\n        queue.append((next_state, new_actions_path))\n  \n  # If the queue becomes empty and the goal was never reached, it means the item\n  # cannot be crafted from the initial state within the search limits (or at all).\n  return []", "island_id": 5, "scores": {"3": -1}}
