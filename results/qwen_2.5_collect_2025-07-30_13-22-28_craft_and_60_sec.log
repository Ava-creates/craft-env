{"timestamp": "2025-07-30T13:26:54.971828", "function_name": "craft", "function_body": "  import collections\n  import numpy as np # numpy is used for array operations like .tobytes()\n\n  # Define possible actions using constants from env_factory.\n  # These constants are assumed to be accessible via the env_factory module,\n  # which is imported at a higher scope in the surrounding code.\n  ALL_ACTIONS = [\n      env_factory.ACTION_DOWN,\n      env_factory.ACTION_UP,\n      env_factory.ACTION_LEFT,\n      env_factory.ACTION_RIGHT,\n      env_factory.ACTION_USE\n  ]\n\n  # Get the initial CraftState from the CraftLab environment.\n  # We work with copies of CraftState objects during the search to avoid\n  # modifying the actual environment's state until the plan is executed.\n  initial_craft_state = env._current_state\n\n  # Queue for Breadth-First Search (BFS): stores tuples of\n  # (CraftState object, list of actions taken to reach this state).\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Set for visited states: stores a hashable representation of each CraftState\n  # to prevent revisiting the same state and avoid infinite loops.\n  # A state is uniquely defined by its grid contents, inventory, agent position, and direction.\n  # numpy.ndarray.tobytes() provides a hashable byte string representation of the array's data.\n  visited = set()\n  visited.add((initial_craft_state.grid.tobytes(),\n               initial_craft_state.inventory.tobytes(),\n               initial_craft_state.pos,\n               initial_craft_state.dir))\n\n  # Limit search depth to prevent excessive computation for very complex goals\n  # or in cases where no path exists, to avoid combinatorial explosion.\n  # This value can be tuned based on the typical complexity of crafting tasks.\n  MAX_SEARCH_DEPTH = 100 # A reasonable default for many grid-world planning problems\n\n  while queue:\n    current_state, current_path = queue.popleft()\n\n    # Check if the current state satisfies the goal condition.\n    # CraftState.satisfies(goal_name, goal_arg) expects the item index as goal_arg.\n    # The 'goal_name' parameter is ignored by the satisfies method in CraftState,\n    # so we can pass None or an empty string.\n    if current_state.satisfies(None, item):\n      return current_path\n\n    # If the current path length exceeds the maximum allowed search depth,\n    # stop exploring further from this state to manage computational resources.\n    if len(current_path) >= MAX_SEARCH_DEPTH:\n      continue # Move to the next state in the queue\n\n    # Explore all possible actions from the current state.\n    for action in ALL_ACTIONS:\n      # Apply the action to get the next state.\n      # CraftState.step returns a tuple (reward, new_state). We only need new_state for planning.\n      _, next_state = current_state.step(action)\n\n      # Create a hashable tuple representing the next state for the 'visited' set.\n      next_state_tuple = (next_state.grid.tobytes(),\n                          next_state.inventory.tobytes(),\n                          next_state.pos,\n                          next_state.dir)\n\n      # If this state has not been visited before, add it to the queue and the visited set.\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no path\n  # to craft the item was found within the defined search depth.\n  return []", "island_id": 6, "scores": {"3": -1}}
