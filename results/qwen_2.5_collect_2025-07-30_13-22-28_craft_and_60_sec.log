{"timestamp": "2025-07-30T13:45:17.368467", "function_name": "craft", "function_body": "  # Get the initial state of the environment\n  initial_state = env._current_state\n\n  # Queue for BFS: stores (current_state, path_to_current_state, steps_taken_in_bfs)\n  # current_state is a CraftState object\n  # path_to_current_state is a list of integer actions (0-4)\n  # steps_taken_in_bfs is the number of actions in path_to_current_state\n  q = deque([(initial_state, [], 0)])\n\n  # Set to keep track of visited states to prevent cycles and redundant work.\n  # A state is hashed as a tuple: (grid_bytes, pos_tuple, dir_int, inventory_bytes)\n  # numpy arrays (grid, inventory) are converted to bytes for hashing.\n  visited = set()\n  \n  # Add the initial state to the visited set\n  initial_state_hash = (initial_state.grid.tobytes(),\n                        initial_state.pos,\n                        initial_state.dir,\n                        initial_state.inventory.tobytes())\n  visited.add(initial_state_hash)\n\n  # Define actions to iterate over. These are standard DMLab-like actions.\n  # As per CraftLab.action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  actions_to_try = [0, 1, 2, 3, 4] \n\n  # Set a maximum depth for the BFS to prevent excessively long searches,\n  # especially if the environment is large or if no solution exists.\n  # This limit is for the internal BFS search, distinct from env.max_steps.\n  MAX_SEARCH_DEPTH = 500 \n\n  while q:\n    current_state, current_path, steps_taken = q.popleft()\n\n    # Check if the current state satisfies the goal (item is in inventory)\n    # The satisfies method takes goal_name (ignored here) and goal_arg (item index).\n    if current_state.satisfies(None, item):\n      return current_path\n\n    # If the search depth limit is reached, stop exploring this path\n    if steps_taken >= MAX_SEARCH_DEPTH:\n      continue # Do not expand further from this state\n\n    # Explore all possible next actions\n    for action in actions_to_try:\n      # Apply the action to get the next state.\n      # CraftState.step returns (reward, new_state_object).\n      # The reward is always 0.0 in this implementation, so we only care about new_state.\n      _, next_state = current_state.step(action)\n      \n      # Construct the new path by appending the current action\n      new_path = current_path + [action]\n\n      # Create a hashable representation of the next state\n      next_state_hash = (next_state.grid.tobytes(),\n                         next_state.pos,\n                         next_state.dir,\n                         next_state.inventory.tobytes())\n\n      # If this state has not been visited, add it to the queue and visited set\n      if next_state_hash not in visited:\n        visited.add(next_state_hash)\n        q.append((next_state, new_path, steps_taken + 1))\n  \n  # If the queue becomes empty and the goal was never reached, no path was found\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:45:19.389069", "function_name": "craft", "function_body": "  # Get initial state from the CraftLab environment\n  initial_state = env._current_state\n  \n  # Check if the item is already present at the very beginning\n  if initial_state.satisfies(None, item):\n      return []\n\n  # Queue for BFS: stores (current_state, actions_taken_so_far)\n  # collections.deque is assumed to be available in scope.\n  q = collections.deque([(initial_state, [])])\n\n  # Set to store visited states to avoid cycles and redundant computation.\n  # A state is represented by (grid.tobytes(), pos, dir, inventory.tobytes())\n  visited = set()\n  visited.add((initial_state.grid.tobytes(), initial_state.pos,\n               initial_state.dir, initial_state.inventory.tobytes()))\n\n  # A reasonable maximum number of steps to prevent excessively long searches.\n  MAX_SEARCH_STEPS = 500 \n\n  while q:\n    current_state, actions_so_far = q.popleft()\n\n    # Prune paths that exceed the maximum allowed length.\n    if len(actions_so_far) >= MAX_SEARCH_STEPS:\n      continue\n\n    # Iterate through all possible actions (e.g., DOWN, UP, LEFT, RIGHT, USE)\n    for action in range(env.n_actions):\n      # Perform the action and get the resulting next state.\n      _reward, next_state = current_state.step(action)\n\n      # Create a hashable key for the next state for visited set lookup.\n      next_state_key = (next_state.grid.tobytes(), next_state.pos,\n                        next_state.dir, next_state.inventory.tobytes())\n\n      # If this next_state has not been explored yet\n      if next_state_key not in visited:\n        visited.add(next_state_key) \n\n        # Construct the path to this new state\n        new_actions_so_far = actions_so_far + [action]\n        \n        # Check if the goal item is obtained in this new state\n        if next_state.satisfies(None, item):\n          return new_actions_so_far \n\n        # If goal not achieved yet, add the new state and its path to the queue\n        q.append((next_state, new_actions_so_far))\n\n  # If the BFS queue is exhausted and the goal was never reached,\n  # it means there's no path to craft the item within the search limits.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:47:35.178386", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Helper function to make CraftState hashable for the visited set in BFS.\n    def _hash_craft_state(state):\n        # Convert numpy arrays to bytes for hashing.\n        # Position (tuple) and direction (int) are already hashable.\n        return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n    # Helper for finding a sequence of movement actions to get adjacent to a specific item kind.\n    # It performs a BFS on (position, direction) to find the shortest path.\n    def _find_path_to_kind(start_state, target_kind_id, max_path_len=50):\n        \"\"\"\n        Finds a sequence of movement actions to get adjacent to a specific entity kind.\n        Returns (actions_to_reach_adjacency, end_state) if a path is found,\n        otherwise (None, None).\n        The end_state will be the CraftState where the agent is next to the target_kind_id.\n        \"\"\"\n        # Queue for pathfinding BFS: stores (current_CraftState, list_of_movement_actions_so_far)\n        queue = collections.deque([(start_state, [])])\n        \n        # Visited set for pathfinding: tracks (position, direction) to avoid cycles.\n        # We assume the grid and inventory are static during pure movement planning.\n        visited_pos_dir = {(start_state.pos, start_state.dir)}\n        \n        # Only consider movement actions for pathfinding\n        movement_actions = [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT]\n        \n        while queue:\n            current_s, actions_so_far = queue.popleft()\n\n            # Prune paths that exceed the maximum allowed length for a sub-plan\n            if len(actions_so_far) > max_path_len:\n                continue\n\n            # If the current state is next to the target kind, we found a path\n            if current_s.next_to(target_kind_id):\n                return actions_so_far, current_s\n            \n            # Explore all possible movement actions from the current state\n            for action in movement_actions:\n                # Simulate the step (reward is ignored)\n                _, next_s = current_s.step(action)\n                next_pos_dir = (next_s.pos, next_s.dir)\n\n                # If this (position, direction) has not been visited, add to queue\n                if next_pos_dir not in visited_pos_dir:\n                    visited_pos_dir.add(next_pos_dir)\n                    queue.append((next_s, actions_so_far + [action]))\n                    \n        return None, None # Path not found\n\n    # Get the initial state and cookbook reference from the environment\n    initial_state = env._current_state\n    cookbook = env.world.cookbook\n\n    # If the item is already in the inventory, no actions are needed\n    if initial_state.satisfies(None, item):\n        return []\n\n    # Main planning BFS queue: stores (current_CraftState, list_of_total_actions_taken)\n    plan_queue = collections.deque([(initial_state, [])])\n    \n    # Visited set for the main planner: tracks full state hashes to avoid redundant work\n    plan_visited = {_hash_craft_state(initial_state)}\n\n    # Maximum total actions allowed for the complete crafting plan.\n    # This acts as a safeguard against excessively long searches.\n    MAX_TOTAL_ACTIONS = 200 \n    \n    # Maximum length for a single pathfinding sub-plan (movement to an item/workshop).\n    MAX_SUBPLAN_ACTIONS = 50 \n\n    while plan_queue:\n        current_state, current_actions = plan_queue.popleft()\n\n        # Prune plans that exceed the maximum allowed total actions\n        if len(current_actions) >= MAX_TOTAL_ACTIONS:\n            continue\n\n        # Check if the goal (item in inventory) is satisfied in the current state\n        if current_state.satisfies(None, item):\n            return current_actions\n\n        # List to store all valid next states and their corresponding action sequences\n        # derived from \"macro-actions\" (acquiring primitives, crafting items)\n        possible_next_states_and_actions = []\n\n        # --- Option A: Acquire missing primitive ingredients ---\n        # Determine all primitive items ultimately needed for the target 'item'\n        needed_primitives_counts = cookbook.primitives_for(item)\n        \n        # Identify which of these primitives are still missing from the current inventory\n        missing_primitives = {\n            p_id: count for p_id, count in needed_primitives_counts.items()\n            if current_state.inventory[p_id] < count\n        }\n\n        # Try to find and pick up any one of the missing primitives that is present on the grid\n        # Iterating over sorted keys ensures deterministic behavior if multiple primitives are missing\n        for p_id in sorted(missing_primitives.keys()):\n            # Check if this primitive actually exists on the grid in the current state\n            # This is crucial because items are removed from the grid after being picked up.\n            item_on_grid = False\n            for r in range(current_state.grid.shape[0]):\n                for c in range(current_state.grid.shape[1]):\n                    # Check if the cell contains the primitive and it's grabbable\n                    if current_state.grid[r, c, p_id] > 0 and p_id in env.world.grabbable_indices:\n                        item_on_grid = True\n                        break\n                if item_on_grid:\n                    break\n            \n            if not item_on_grid:\n                continue # This primitive is not available on the grid in the current state\n\n            # Find a path to this primitive on the grid\n            path_to_primitive_actions, state_at_primitive = _find_path_to_kind(\n                current_state, p_id, MAX_SUBPLAN_ACTIONS\n            )\n            \n            if path_to_primitive_actions is not None:\n                # If a path is found, simulate the 'USE' action to pick up the item\n                _, next_state_after_pickup = state_at_primitive.step(env_factory.USE)\n                total_actions_for_pickup = current_actions + path_to_primitive_actions + [env_factory.USE]\n                \n                # Check if the new path length exceeds the maximum allowed\n                if len(total_actions_for_pickup) < MAX_TOTAL_ACTIONS:\n                    hash_next_state = _hash_craft_state(next_state_after_pickup)\n                    # Add to potential options if this state has not been visited before\n                    if hash_next_state not in plan_visited:\n                        possible_next_states_and_actions.append((next_state_after_pickup, total_actions_for_pickup))\n\n        # --- Option B: Craft an item (explore using workshops/recipes) ---\n        # Iterate through all available recipes in a deterministic order\n        for output_id in sorted(cookbook.recipes.keys()):\n            recipe = cookbook.recipes[output_id]\n            \n            ingredients_available = True\n            required_workshop_kind_id = None\n            \n            # Check if all ingredients for this recipe are in the current inventory\n            # and identify if a specific workshop is required.\n            for ing_key, count in recipe.items():\n                if ing_key.startswith(\"_\"): # This indicates a required workshop (e.g., \"_workbench\")\n                    workshop_name = ing_key[1:]\n                    try:\n                        # Convert workshop name (string) to its integer ID\n                        required_workshop_kind_id = cookbook.index.index(workshop_name)\n                    except KeyError:\n                        # If the workshop name is not recognized, this recipe cannot be crafted\n                        ingredients_available = False\n                        break\n                else: # This is a regular ingredient\n                    if current_state.inventory[ing_key] < count:\n                        ingredients_available = False\n                        break\n            \n            if ingredients_available:\n                # If all ingredients are available, attempt to craft\n                path_to_workshop_actions = []\n                state_at_workshop = current_state\n                \n                if required_workshop_kind_id is not None:\n                    # If a specific workshop is required, find a path to it\n                    path_to_workshop_actions, state_at_workshop = _find_path_to_kind(\n                        current_state, required_workshop_kind_id, MAX_SUBPLAN_ACTIONS\n                    )\n                    if path_to_workshop_actions is None:\n                        # Cannot reach the required workshop, so this recipe cannot be crafted now\n                        continue # Try the next recipe\n                \n                # Simulate the 'USE' action to perform crafting (either at a workshop or \"anywhere\")\n                _, next_state_after_crafting = state_at_workshop.step(env_factory.USE)\n                total_actions_for_crafting = current_actions + path_to_workshop_actions + [env_factory.USE]\n\n                # Check if the new path length exceeds the maximum allowed\n                if len(total_actions_for_crafting) < MAX_TOTAL_ACTIONS:\n                    hash_next_state = _hash_craft_state(next_state_after_crafting)\n                    # Add to potential options if this state has not been visited before\n                    if hash_next_state not in plan_visited:\n                        possible_next_states_and_actions.append((next_state_after_crafting, total_actions_for_crafting))\n        \n        # Add all newly found reachable states from macro-actions to the main planning queue.\n        # Sort them for deterministic exploration (by path length, then by state hash for tie-breaking).\n        for next_s, next_acts in sorted(possible_next_states_and_actions, \n                                        key=lambda x: (len(x[1]), _hash_craft_state(x[0]))):\n            plan_visited.add(_hash_craft_state(next_s))\n            plan_queue.append((next_s, next_acts))\n            \n    # If the queue becomes empty and the goal was not reached within the defined limits,\n    # it means no plan was found.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:47:35.205875", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Define constants for actions and directions\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Directions: NORTH (0), EAST (1), SOUTH (2), WEST (3)\n    # Mapping to (dx, dy) for movement on the grid\n    _DIR_VECS = {\n        0: (0, -1), # NORTH (Y-axis decreases)\n        1: (1, 0),  # EAST (X-axis increases)\n        2: (0, 1),  # SOUTH (Y-axis increases)\n        3: (-1, 0)  # WEST (X-axis decreases)\n    }\n    \n    # Get grid dimensions once from the current state\n    # CraftState.grid has shape (WIDTH, HEIGHT, n_kinds)\n    WIDTH, HEIGHT, N_KINDS = env._current_state.grid.shape\n\n    # --- Helper Functions (nested to be within the function scope) ---\n\n    def _find_entity_coords(state, kind_idx):\n        \"\"\"Finds all (x, y) coordinates where a given entity kind is present.\"\"\"\n        coords = []\n        grid = state.grid\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if grid[x, y, kind_idx] > 0:\n                    coords.append((x, y))\n        return coords\n\n    def _get_actions_to_face(current_sim_state, target_dir):\n        \"\"\"\n        Calculates actions (LEFT/RIGHT) to rotate the agent to face target_dir.\n        Returns the list of actions and the new simulated state after rotations.\n        \"\"\"\n        actions = []\n        sim_state = current_sim_state # Start with the given state for simulation\n        \n        # Calculate shortest turns\n        current_dir = sim_state.dir\n        diff = (target_dir - current_dir + 4) % 4 # Clockwise difference\n        \n        if diff == 1: # 90 deg clockwise (RIGHT)\n            actions.append(ACTION_RIGHT)\n            sim_state = sim_state.step(ACTION_RIGHT)[1]\n        elif diff == 2: # 180 deg (two RIGHTs or two LEFTs), prefer two RIGHTs\n            actions.extend([ACTION_RIGHT, ACTION_RIGHT])\n            sim_state = sim_state.step(ACTION_RIGHT)[1]\n            sim_state = sim_state.step(ACTION_RIGHT)[1]\n        elif diff == 3: # 90 deg counter-clockwise (LEFT)\n            actions.append(ACTION_LEFT)\n            sim_state = sim_state.step(ACTION_LEFT)[1]\n        \n        return actions, sim_state\n\n    def _bfs_plan_to_target_adj(initial_sim_state, target_kind_idx, specific_target_coords=None):\n        \"\"\"\n        Plans actions to move the agent to a position adjacent to and facing\n        an entity of `target_kind_idx`. Uses BFS for shortest path.\n        \n        Args:\n            initial_sim_state (CraftState): The starting simulated state.\n            target_kind_idx (int): The index of the entity kind to target.\n            specific_target_coords (list[tuple], optional): A list of (x,y)\n                coordinates to search for the target. If None, it uses\n                _find_entity_coords.\n\n        Returns:\n            tuple[list[int], CraftState]: A tuple containing:\n                - List of actions (movement and rotation) to reach and face the target.\n                - The simulated CraftState after applying these actions.\n                Returns ([], initial_sim_state) if no path is found or targets exist.\n        \"\"\"\n        \n        # Helper for visited_states hashing: (pos_tuple, dir_int, inventory_flattened_tuple)\n        def _hash_state(state):\n            # Convert numpy array to tuple for hashing in set\n            return (state.pos, state.dir, tuple(state.inventory.flatten()))\n\n        sim_q = collections.deque([(initial_sim_state, [])]) # (current_state, actions_path)\n        visited_hashes = set([_hash_state(initial_sim_state)]) # Keep track of visited state hashes\n\n        # Determine the actual target locations to aim for\n        if specific_target_coords is None:\n            target_locations = _find_entity_coords(initial_sim_state, target_kind_idx)\n        else:\n            target_locations = specific_target_coords\n        \n        if not target_locations:\n            return [], initial_sim_state # No targets on the map to path to\n\n        while sim_q:\n            current_sim_state, current_actions = sim_q.popleft()\n\n            # Check if current_sim_state is adjacent to any target and facing it\n            for tx, ty in target_locations:\n                cx, cy = current_sim_state.pos\n                dx_to_target = tx - cx\n                dy_to_target = ty - cy\n\n                # Check if agent's current position is adjacent to (tx, ty)\n                if (abs(dx_to_target) + abs(dy_to_target)) == 1: # Manhattan distance of 1\n                    # Determine required facing direction\n                    required_dir = -1\n                    for d_idx, (vx, vy) in _DIR_VECS.items():\n                        if vx == dx_to_target and vy == dy_to_target:\n                            required_dir = d_idx\n                            break\n                    \n                    if required_dir != -1:\n                        # Agent is adjacent. Now ensure it's facing the target.\n                        if required_dir == current_sim_state.dir:\n                            # Agent is already adjacent and facing correctly\n                            return current_actions, current_sim_state\n                        else:\n                            # Agent is adjacent but needs to turn\n                            rotation_actions, final_state_after_rot = _get_actions_to_face(current_sim_state, required_dir)\n                            return current_actions + rotation_actions, final_state_after_rot\n\n            # Explore possible moves (DOWN, UP, LEFT, RIGHT)\n            for action_val in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n                # Simulate the action to get the next state\n                # CraftState.step returns (reward, new_state)\n                next_sim_state = current_sim_state.step(action_val)[1]\n                next_hash = _hash_state(next_sim_state)\n\n                # Add to queue if not visited\n                if next_hash not in visited_hashes:\n                    visited_hashes.add(next_hash)\n                    sim_q.append((next_sim_state, current_actions + [action_val]))\n        \n        return [], initial_sim_state # No path found to any adjacent cell\n\n    # --- Main planning function (recursive) ---\n\n    def _plan_item_recursively(sim_state_at_start, target_item_idx):\n        \"\"\"\n        Plans actions to acquire/craft a single `target_item_idx`.\n        Operates on a simulated state (`current_sim_state`) to determine\n        actions without modifying the real environment until the full plan is returned.\n\n        Args:\n            sim_state_at_start (CraftState): The current simulated state before\n                                              planning for this particular item.\n            target_item_idx (int): The index of the item to acquire/craft.\n\n        Returns:\n            tuple[list[int], CraftState]: A tuple containing:\n                - List of actions required to achieve the goal (or empty list if impossible).\n                - The simulated CraftState after applying these actions.\n        \"\"\"\n        \n        actions = []\n        current_sim_state = sim_state_at_start # This state will be updated as actions are planned\n\n        world = env.world\n        cookbook = world.cookbook\n\n        # 0. Base Case: If the item is already in inventory, no actions needed.\n        if current_sim_state.inventory[target_item_idx] > 0:\n            return [], current_sim_state\n\n        # 1. Primitive Item Case: Acquire by finding and using\n        if target_item_idx in cookbook.primitives:\n            # Find coordinates of the primitive on the grid\n            item_coords = _find_entity_coords(current_sim_state, target_item_idx)\n            if not item_coords:\n                # Primitive not found on map, cannot acquire\n                return [], sim_state_at_start\n\n            # Plan path to be adjacent to and face the primitive\n            path_actions, current_sim_state = _bfs_plan_to_target_adj(current_sim_state, target_item_idx, item_coords)\n            \n            # If path_actions is empty and inventory still doesn't have it, it means no path found\n            if not path_actions and current_sim_state.inventory[target_item_idx] == 0:\n                return [], sim_state_at_start\n            \n            actions.extend(path_actions)\n            \n            # Perform the USE action to pick up/collect the primitive\n            actions.append(ACTION_USE)\n            current_sim_state = current_sim_state.step(ACTION_USE)[1]\n            \n            # Verify if the item was actually acquired (inventory updated)\n            if current_sim_state.inventory[target_item_idx] > 0:\n                return actions, current_sim_state\n            else:\n                # USE action did not result in acquiring the item. Treat as failure.\n                return [], sim_state_at_start\n\n        # 2. Crafted Item Case: Acquire by gathering ingredients and using a workbench\n        elif target_item_idx in cookbook.recipes:\n            recipe = cookbook.recipes[target_item_idx]\n\n            # Recursively collect all ingredients required for this recipe\n            for ingredient_idx, count in recipe.items():\n                if ingredient_idx == \"_key\":\n                    continue # Skip special keys (like \"tool\" requirements) in recipes, they are not items to collect\n\n                while current_sim_state.inventory[ingredient_idx] < count:\n                    # Recursively plan for the sub-ingredient\n                    sub_actions, current_sim_state = _plan_item_recursively(current_sim_state, ingredient_idx)\n                    \n                    if not sub_actions and current_sim_state.inventory[ingredient_idx] < count:\n                        # If no actions were returned for the ingredient AND we still don't have enough,\n                        # it means this ingredient cannot be acquired/crafted, so this main item cannot be crafted.\n                        return [], sim_state_at_start\n                    \n                    actions.extend(sub_actions) # Add ingredient-gathering actions to the main plan\n\n            # All ingredients are now (simulated to be) in inventory.\n            # Next, find the workbench and use it.\n            workbench_idx = cookbook.index.index('workbench') # Assumes 'workbench' item exists and is named this way\n            workbench_coords = _find_entity_coords(current_sim_state, workbench_idx)\n            if not workbench_coords:\n                # Workbench not found on map, cannot craft the item\n                return [], sim_state_at_start\n\n            # Plan path to be adjacent to and face the workbench\n            path_actions, current_sim_state = _bfs_plan_to_target_adj(current_sim_state, workbench_idx, workbench_coords)\n            \n            # If path_actions is empty and inventory still doesn't have it, it means no path found\n            if not path_actions and current_sim_state.inventory[target_item_idx] == 0:\n                return [], sim_state_at_start\n            \n            actions.extend(path_actions)\n\n            # Perform the USE action at the workbench to craft the item\n            actions.append(ACTION_USE)\n            current_sim_state = current_sim_state.step(ACTION_USE)[1]\n            \n            # Verify if the item was actually crafted (inventory updated)\n            if current_sim_state.inventory[target_item_idx] > 0:\n                return actions, current_sim_state\n            else:\n                # Crafting failed, potentially due to complex recipe rules or environment state not handled.\n                return [], sim_state_at_start # Treat as failure\n\n        # 3. Unknown Item Case: Item is neither primitive nor has a recipe\n        else:\n            return [], sim_state_at_start # Cannot craft this item\n\n    # --- Start the top-level planning ---\n    # Get the initial state of the environment. This will be the starting point for our simulation.\n    initial_craft_state_for_planning = env._current_state\n    \n    # Call the recursive planner. We only need the list of actions from the result.\n    final_actions, _ = _plan_item_recursively(initial_craft_state_for_planning, item)\n    \n    return final_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:48:47.168155", "function_name": "craft", "function_body": "    import collections\n\n    # Constants for actions, mapping to integers as described in action_specs\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    # Maximum search steps and path length to prevent infinite loops and limit computation.\n    # These values might need tuning based on the complexity of the crafting world.\n    MAX_SEARCH_STEPS = 50000  # Maximum number of states to explore\n    MAX_PATH_LENGTH = 150     # Maximum number of actions in a sequence\n\n    # The initial state is the current state of the CraftLab environment.\n    initial_state = env._current_state\n    \n    # If the item is already in the inventory, no actions are needed.\n    if initial_state.inventory[item] > 0:\n        return []\n\n    # Queue for Breadth-First Search (BFS): stores (current_state, actions_taken_so_far)\n    queue = collections.deque([(initial_state, [])])\n\n    # Visited set: stores hashable representations of states to avoid cycles and redundant work.\n    # A state is represented by a tuple of (grid_hash, position, direction, inventory_tuple).\n    # grid.tobytes() provides a compact and hashable representation of the numpy grid array.\n    def get_state_hash(state):\n        return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n    visited = set()\n    visited.add(get_state_hash(initial_state))\n\n    steps_explored = 0\n\n    while queue:\n        current_state, current_actions = queue.popleft()\n        steps_explored += 1\n\n        # Check for search limits to prevent excessive computation.\n        if steps_explored > MAX_SEARCH_STEPS:\n            # print(f\"Max search steps ({MAX_SEARCH_STEPS}) reached. Could not find path.\")\n            return []  # Goal unreachable within the given search limits.\n        \n        # Check if the current state satisfies the goal (item is in inventory).\n        if current_state.inventory[item] > 0:\n            return current_actions  # Path found!\n\n        # Prune branches that exceed the maximum allowed path length.\n        if len(current_actions) >= MAX_PATH_LENGTH:\n            continue\n\n        # Explore all possible actions from the current state.\n        for action in ALL_ACTIONS:\n            # Simulate the step using the CraftState's step method, which handles all game logic.\n            # The step method returns (reward, new_state).\n            reward, next_state = current_state.step(action)\n            \n            # Get the hashable representation of the next state.\n            next_state_hash = get_state_hash(next_state)\n\n            # If the next state has not been visited, add it to the queue and visited set.\n            if next_state_hash not in visited:\n                visited.add(next_state_hash)\n                queue.append((next_state, current_actions + [action]))\n    \n    # If the queue becomes empty and the item has not been found, it means the item\n    # is unreachable from the initial state within the given search constraints.\n    # print(f\"BFS queue exhausted. Could not find path to item {env.world.cookbook.index.get(item)}.\")\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:48:55.661591", "function_name": "craft", "function_body": "  from collections import deque\n\n  initial_state = env._current_state\n  world_config = env.world \n\n  # A practical limit for the number of states to explore in BFS.\n  # This prevents the search from running indefinitely in complex scenarios\n  # or where no path exists within a reasonable depth.\n  # Adjust this value based on typical problem complexity/time limits.\n  MAX_BFS_NODES_TO_EXPAND = 20000 # Increased for better chances of finding solutions.\n\n  # Number of possible actions (UP, DOWN, LEFT, RIGHT, USE)\n  N_ACTIONS = world_config.n_actions \n\n  def _state_to_hashable(state):\n      \"\"\"\n      Converts a CraftState object into a hashable tuple for use in a set.\n      This is crucial for the visited set in BFS to detect cycles and avoid\n      re-processing identical states.\n      \"\"\"\n      # Convert the grid (numpy array) to bytes for hashing.\n      # grid.tobytes() is an efficient way to get a hashable representation\n      # for NumPy arrays, assuming the array's contents are the primary\n      # part of the grid state.\n      return (\n          state.grid.tobytes(), \n          state.pos,            # Agent's position (tuple)\n          state.dir,            # Agent's direction (int)\n          tuple(state.inventory) # Agent's inventory (numpy array to tuple)\n      )\n\n  # Initialize the BFS queue with the initial state and an empty action list\n  q = deque([(initial_state, [])]) \n  # Initialize the set of visited states using the hashable representation\n  visited = {_state_to_hashable(initial_state)}\n\n  nodes_expanded = 0\n  while q and nodes_expanded < MAX_BFS_NODES_TO_EXPAND:\n      current_state, current_actions = q.popleft()\n\n      # Check if the goal item is now in the inventory\n      if current_state.inventory[item] > 0:\n          return current_actions # Goal reached, return the sequence of actions\n\n      # Explore all possible actions from the current state\n      for action in range(N_ACTIONS):\n          # Simulate the action: CraftState.step returns (reward, new_state)\n          # We only care about the new_state for planning\n          _, next_state = current_state.step(action)\n          \n          # Get the hashable representation of the next state\n          next_hashable = _state_to_hashable(next_state)\n\n          # If this state has not been visited before, add it to the queue and visited set\n          if next_hashable not in visited:\n              visited.add(next_hashable)\n              q.append((next_state, current_actions + [action]))\n      \n      nodes_expanded += 1 # Increment the count of states explored\n\n  # If the queue is exhausted or MAX_BFS_NODES_TO_EXPAND is reached,\n  # it means no path to craft the item was found within the search limits.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
