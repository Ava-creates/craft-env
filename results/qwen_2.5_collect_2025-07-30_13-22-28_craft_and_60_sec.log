{"timestamp": "2025-07-30T14:12:06.464679", "function_name": "craft", "function_body": "  import collections\n  # numpy is assumed to be available from the environment's context (e.g., CraftState.grid, CraftState.inventory)\n\n  # Action constants (based on CraftLab.action_specs)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n  _ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT, _USE]\n\n  # Start from the current state of the environment\n  start_craft_state = env._current_state\n  \n  # Queue for BFS: stores (current_craft_state, path_of_actions)\n  # A path is a list of action integers.\n  queue = collections.deque([(start_craft_state, [])])\n  \n  # Visited set: stores a hashable representation of states to avoid cycles and redundant computation.\n  # A state is uniquely defined by its grid, inventory, position, and direction.\n  # We use grid.tobytes() to make the numpy array grid hashable.\n  visited = set()\n  \n  def _get_state_key(craft_state):\n      \"\"\"Returns a hashable tuple representing the given CraftState.\"\"\"\n      return (craft_state.grid.tobytes(), tuple(craft_state.inventory), craft_state.pos, craft_state.dir)\n\n  # Add the initial state to the visited set\n  visited.add(_get_state_key(start_craft_state))\n\n  # Maximum number of steps to explore in the BFS to prevent excessively long searches\n  # or infinite loops in complex environments. This is a heuristic limit.\n  MAX_SEARCH_STEPS = 500 \n\n  while queue:\n      current_state, path_actions = queue.popleft()\n\n      # If the current path length exceeds the maximum allowed steps, prune this path.\n      if len(path_actions) >= MAX_SEARCH_STEPS:\n          continue\n\n      # Check if the goal item has been crafted and is in the inventory\n      # CraftState.satisfies takes (goal_name, goal_arg). goal_name is ignored here.\n      if current_state.satisfies(None, item):\n          return path_actions\n\n      # Explore all possible actions from the current state\n      for action in _ACTIONS:\n          # Apply the action to get the new state.\n          # CraftState.step(action) returns (reward, new_craft_state).\n          # We are interested in the new_craft_state. Reward is always 0.0 in this implementation.\n          _, new_state = current_state.step(action)\n          \n          new_state_key = _get_state_key(new_state)\n\n          # If this new state has not been visited before, add it to the queue and visited set\n          if new_state_key not in visited:\n              visited.add(new_state_key)\n              queue.append((new_state, path_actions + [action]))\n\n  # If the queue becomes empty and the goal is not reached, it means no path was found\n  # within the search limits.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:12:06.560938", "function_name": "craft", "function_body": "    world = env.world # CraftWorld instance\n    \n    total_actions = []\n    MAX_PLANNING_STEPS = 1000 # Safety limit for planning actions\n    steps_taken = 0\n\n    while not env._current_state.satisfies(None, item) and steps_taken < MAX_PLANNING_STEPS:\n        current_state = env._current_state # Get the most current state from the env\n        action_found_this_iteration = False\n\n        # Strategy 1: Prioritize collecting any missing *primitive* resources\n        # `primitives_for` gives all base ingredients needed for the final item\n        required_primitives_overall = world.cookbook.primitives_for(item)\n        \n        # Check if we need to collect any primitive\n        for p_idx, p_count_needed in required_primitives_overall.items():\n            if current_state.inventory[p_idx] < p_count_needed:\n                # Need more of this primitive. Find it on the grid.\n                target_pos_found = None\n                for r in range(current_state.grid.shape[0]):\n                    for c in range(current_state.grid.shape[1]):\n                        if current_state.grid[r, c, p_idx] > 0:\n                            target_pos_found = (r, c)\n                            break\n                    if target_pos_found:\n                        break\n                \n                if target_pos_found:\n                    # Path to the primitive's location\n                    path_to_primitive = _find_path(current_state.pos, target_pos_found, current_state.grid, \n                                                   world.non_grabbable_indices)\n                    if path_to_primitive:\n                        # Append movement actions\n                        for action in path_to_primitive:\n                            _, _, _ = env.step(action)\n                            total_actions.append(action)\n                            steps_taken += 1\n                            if steps_taken >= MAX_PLANNING_STEPS: return []\n                        \n                        # After moving to (or adjacent to) the primitive, attempt USE action.\n                        # `CraftState.next_to` checks 3x3 neighborhood, assuming USE works in this area.\n                        old_inventory_count = env._current_state.inventory[p_idx]\n                        \n                        _, _, _ = env.step(ACTION_USE)\n                        total_actions.append(ACTION_USE)\n                        steps_taken += 1\n                        if steps_taken >= MAX_PLANNING_STEPS: return []\n\n                        if env._current_state.inventory[p_idx] > old_inventory_count:\n                            # Successfully collected a primitive\n                            action_found_this_iteration = True\n                            break # Break from p_idx loop, re-evaluate needs\n\n        if action_found_this_iteration:\n            continue # Restart planning loop with updated state\n\n        # Strategy 2: If no primitives to collect, try to craft an item whose ingredients are met.\n        # Prioritize crafting the final `item` first, then its direct craftable ingredients.\n        \n        items_to_consider_crafting = set()\n        items_to_consider_crafting.add(item) # Always consider crafting the final item\n\n        # Add intermediate craftable ingredients that lead to the final item\n        q_recipe_deps = collections.deque([item])\n        processed_recipe_deps = {item} # Use a set to prevent re-processing and infinite loops\n\n        while q_recipe_deps:\n            current_craft_target = q_recipe_deps.popleft()\n            if current_craft_target in world.cookbook.recipes:\n                recipe = world.cookbook.recipes[current_craft_target]\n                for ing_idx, _ in recipe.items():\n                    if ing_idx == world.cookbook.index._reverse_contents[\"_key\"]:\n                        continue # Skip workshop key\n                    # If this ingredient is also a craftable item and not yet processed\n                    if ing_idx in world.cookbook.recipes and ing_idx not in processed_recipe_deps:\n                        items_to_consider_crafting.add(ing_idx)\n                        processed_recipe_deps.add(ing_idx)\n                        q_recipe_deps.append(ing_idx)\n        \n        # Sort candidates for deterministic behavior (e.g., by index)\n        sorted_craft_candidates = sorted(list(items_to_consider_crafting))\n\n        for craft_output_idx in sorted_craft_candidates:\n            # Only attempt to craft if we still need the item (inventory count is 0)\n            # and if it's a valid recipe and we have the ingredients.\n            if env._current_state.inventory[craft_output_idx] == 0 and \\\n               craft_output_idx in world.cookbook.recipes:\n                \n                recipe = world.cookbook.recipes[craft_output_idx]\n                if _can_craft(env._current_state.inventory, recipe, world.cookbook):\n                    crafting_actions = []\n                    workshop_idx = None\n                    if world.cookbook.index._reverse_contents[\"_key\"] in recipe:\n                        workshop_idx = recipe[world.cookbook.index._reverse_contents[\"_key\"]]\n\n                    if workshop_idx is not None:\n                        # Find workshop location\n                        target_workshop_pos = None\n                        for r in range(env._current_state.grid.shape[0]):\n                            for c in range(env._current_state.grid.shape[1]):\n                                if env._current_state.grid[r, c, workshop_idx] > 0:\n                                    target_workshop_pos = (r, c)\n                                    break\n                            if target_workshop_pos:\n                                break\n                        \n                        if not target_workshop_pos:\n                            continue # Cannot find workshop, try next craftable item\n\n                        path_to_workshop = _find_path(env._current_state.pos, target_workshop_pos, env._current_state.grid,\n                                                      world.non_grabbable_indices)\n                        if not path_to_workshop:\n                            continue # Cannot reach workshop, try next craftable item\n                        \n                        crafting_actions.extend(path_to_workshop)\n                    \n                    crafting_actions.append(ACTION_USE) # The actual craft action\n\n                    # Simulate these crafting actions\n                    old_inventory_count = env._current_state.inventory[craft_output_idx]\n                    \n                    for action in crafting_actions:\n                        _, _, _ = env.step(action)\n                        total_actions.append(action)\n                        steps_taken += 1\n                        if steps_taken >= MAX_PLANNING_STEPS: return []\n\n                    if env._current_state.inventory[craft_output_idx] > old_inventory_count:\n                        # Successfully crafted an item\n                        action_found_this_iteration = True\n                        break # Break from crafting loop, re-evaluate from top of while loop\n\n        if action_found_this_iteration:\n            continue # Restart planning loop with updated state\n\n        # If neither collecting nor crafting actions were found, the planner is stuck.\n        # This could mean the goal is impossible, or the planner's strategy is too simple.\n        return []\n\n    # Goal satisfied or MAX_PLANNING_STEPS reached\n    if env._current_state.satisfies(None, item):\n        return total_actions\n    else:\n        return [] # Failed to find a plan within limits", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:13:41.108221", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftWorld / CraftLab, typically defined as 0-4)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Global set to avoid redundant exploration in the recursive planner.\n  # This set tracks (hashable_state_tuple, target_item_idx) to prevent\n  # re-attempting to get the same item from the same agent state within a planning branch.\n  # It must be cleared at the beginning of each top-level `craft_v2` call.\n  _visited_planning_states = set()\n\n\n  def _get_hashable_state(craft_state):\n      \"\"\"\n      Creates a hashable tuple from a CraftState object.\n      This is used for the `_visited_planning_states` set to identify unique\n      agent states (position, direction, inventory) for memoization/cycle detection.\n      The full grid is typically too large and changes too frequently to be hashed directly.\n      \"\"\"\n      return (craft_state.pos, craft_state.dir, tuple(craft_state.inventory))\n\n\n  def _bfs_find_path(initial_state, target_predicate_func, max_steps=100):\n      \"\"\"\n      Finds a path of movement actions (UP, DOWN, LEFT, RIGHT) from an `initial_state`\n      to a state that satisfies `target_predicate_func`.\n      \n      Args:\n          initial_state (CraftState): The starting state for pathfinding.\n          target_predicate_func (callable): A function that takes a CraftState and returns True\n                                            if that state is a desired target (e.g., next to item).\n          max_steps (int): Maximum number of movement steps to search for a path.\n      \n      Returns:\n          tuple[list[int], CraftState] or tuple[None, None]: \n              A tuple containing:\n                  - A list of movement actions (integers) to reach the target,\n                  - The final simulated CraftState after applying those actions.\n              Returns (None, None) if no path is found within `max_steps`.\n      \"\"\"\n      queue = collections.deque([(initial_state, [])])  # (state, actions_taken_to_reach_state)\n      \n      # Visited set for BFS to avoid cycles. Tracks (pos, dir, inventory_tuple).\n      # Inventory is included because picking up items (which might happen before pathfinding\n      # to a new target) changes the state and might open up new valid paths.\n      visited = set([_get_hashable_state(initial_state)])\n\n      while queue:\n          current_state, actions_so_far = queue.popleft()\n\n          if target_predicate_func(current_state):\n              return actions_so_far, current_state\n\n          if len(actions_so_far) >= max_steps:  # Prevent excessively long paths\n              continue\n\n          for action in [DOWN, UP, LEFT, RIGHT]:  # Only movement actions for pathfinding\n              # Simulate the action to get the next state. Reward is typically 0 for movement.\n              _, next_state = current_state.step(action)\n              next_state_key = _get_hashable_state(next_state)\n\n              if next_state_key not in visited:\n                  visited.add(next_state_key)\n                  queue.append((next_state, actions_so_far + [action]))\n      \n      return None, None  # No path found\n\n\n  def _is_item_pickup_target(state, item_kind_idx, world):\n      \"\"\"\n      Predicate for `_bfs_find_path`: checks if the agent is next to a grabbable item\n      of `item_kind_idx`.\n      \"\"\"\n      # Ensure the item is actually designated as 'grabbable' in the world.\n      if item_kind_idx not in world.grabbable_indices:\n          return False\n      \n      # Use CraftState's built-in `next_to` method, which checks the 3x3 neighborhood.\n      return state.next_to(item_kind_idx)\n\n\n  def _is_workshop_target(state, workshop_indices):\n      \"\"\"\n      Predicate for `_bfs_find_path`: checks if the agent is next to any workshop.\n      \"\"\"\n      for workshop_idx in workshop_indices:\n          if state.next_to(workshop_idx):\n              return True\n      return False\n\n\n  def _plan_to_get_item_recursive(current_simulated_state, target_item_idx, env_world):\n      \"\"\"\n      Recursive function to plan a sequence of actions to acquire a specific `target_item_idx`.\n      It uses a depth-first search like approach, attempting primitive acquisition first,\n      then crafting by recursively acquiring ingredients.\n      \n      Args:\n          current_simulated_state (CraftState): The current state of the environment\n                                                (grid, inventory, pos, dir) within the planner's simulation.\n          target_item_idx (int): The index of the item to be acquired.\n          env_world (CraftWorld): Reference to the CraftWorld instance, providing cookbook\n                                  and other environmental details.\n      \n      Returns:\n          tuple[list[int], CraftState] or tuple[None, None]:\n              A tuple containing:\n                  - A list of actions (integers) to acquire the item.\n                  - The final simulated CraftState after performing these actions.\n              Returns (None, None) if the item cannot be acquired.\n      \"\"\"\n      # Base case 1: Already have the item in the current simulated inventory.\n      if current_simulated_state.inventory[target_item_idx] > 0:\n          return [], current_simulated_state\n\n      # Memoization / Cycle detection: Avoid re-planning for the same item from the same state.\n      state_key = (_get_hashable_state(current_simulated_state), target_item_idx)\n      if state_key in _visited_planning_states:\n          return None, None  # Already trying to get this item from this state; implies a cycle or dead end.\n      _visited_planning_states.add(state_key)\n\n      total_actions = []\n      current_state_in_planning = current_simulated_state\n\n      # --- Strategy 1: Try to get the item as a primitive (by picking it up) ---\n      if target_item_idx in env_world.cookbook.primitives:\n          # Find a path to the primitive item on the grid.\n          path_actions, final_move_state = _bfs_find_path(\n              current_state_in_planning,\n              lambda s: _is_item_pickup_target(s, target_item_idx, env_world)\n          )\n          \n          if path_actions is not None:\n              # Simulate movement actions.\n              temp_state = final_move_state\n              total_actions.extend(path_actions)\n              \n              # Apply the USE action to pick up the item.\n              _, next_state_after_use = temp_state.step(USE)\n              \n              # Verify if the item was successfully acquired (inventory count increased).\n              if next_state_after_use.inventory[target_item_idx] > current_simulated_state.inventory[target_item_idx]:\n                  _visited_planning_states.remove(state_key)  # Backtrack from visited set upon success.\n                  return total_actions + [USE], next_state_after_use\n      \n      # --- Strategy 2: Try to craft the item (if primitive acquisition failed or not applicable) ---\n      if target_item_idx in env_world.cookbook.recipes:\n          recipe = env_world.cookbook.recipes[target_item_idx]\n          all_ingredients_acquired = True\n          \n          # This state will be updated as ingredients are acquired recursively.\n          current_state_after_ingredients = current_state_in_planning \n\n          # Filter out the special \"_key\" entry from recipe ingredients.\n          ingredient_keys = [k for k in recipe if k != '_key']\n\n          # Prioritize acquiring ingredients that we are most deficient in first.\n          sorted_ingredients = sorted(\n              ingredient_keys,\n              key=lambda ing_idx: max(0, recipe[ing_idx] - current_state_after_ingredients.inventory[ing_idx]),\n              reverse=True # Sort in descending order of missing quantity\n          )\n\n          for ing_idx in sorted_ingredients:\n              required_count = recipe[ing_idx]\n              current_count = current_state_after_ingredients.inventory[ing_idx]\n\n              # Loop until the required quantity of the current ingredient is met.\n              while current_count < required_count:\n                  # Recursively plan to get the missing ingredient.\n                  ing_actions, next_ing_state = _plan_to_get_item_recursive(\n                      current_state_after_ingredients, ing_idx, env_world\n                  )\n                  \n                  if ing_actions is None:  # Cannot acquire this ingredient, so cannot craft target item.\n                      all_ingredients_acquired = False\n                      break \n                  \n                  # Extend total actions and update the simulated state for subsequent planning.\n                  total_actions.extend(ing_actions)\n                  current_state_after_ingredients = next_ing_state\n                  current_count = current_state_after_ingredients.inventory[ing_idx] \n\n              if not all_ingredients_acquired:\n                  break # If any ingredient couldn't be acquired, stop trying to craft.\n\n          if all_ingredients_acquired:\n              # All ingredients are now available in `current_state_after_ingredients`.\n              # Next step: go to a workshop and perform the USE action to craft.\n              path_to_workshop_actions, final_move_state = _bfs_find_path(\n                  current_state_after_ingredients, \n                  lambda s: _is_workshop_target(s, env_world.workshop_indices)\n              )\n              \n              if path_to_workshop_actions is not None:\n                  total_actions.extend(path_to_workshop_actions)\n                  \n                  # Simulate the crafting at the workshop.\n                  temp_state_at_workshop = final_move_state \n                  _, next_state_after_craft = temp_state_at_workshop.step(USE)\n\n                  # Verify if the item was successfully crafted.\n                  if next_state_after_craft.inventory[target_item_idx] > current_simulated_state.inventory[target_item_idx]:\n                      _visited_planning_states.remove(state_key)  # Backtrack from visited set upon success.\n                      return total_actions + [USE], next_state_after_craft\n      \n      # If neither primitive acquisition nor crafting succeeded for this item from this state:\n      _visited_planning_states.remove(state_key)  # Backtrack: this path failed, allow other branches to explore.\n      return None, None  # Item cannot be acquired.\n\n\n  # Main function `craft_v2`\n  # This function orchestrates the planning process.\n  global _visited_planning_states\n  _visited_planning_states = set()  # Clear global visited set for a fresh planning session.\n\n  # Get the initial CraftState from the `CraftLab` environment.\n  initial_craft_state = env._current_state\n  \n  # Get the `CraftWorld` instance, which holds cookbook, recipes, indices, etc.\n  world = env.world\n\n  # Initiate the recursive planning process.\n  actions, _ = _plan_to_get_item_recursive(initial_craft_state, item, world)\n  \n  # Return the list of actions if a plan was found, otherwise an empty list.\n  return actions if actions is not None else []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:13:42.828347", "function_name": "craft", "function_body": "  # Action constants as defined in CraftLab.action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Arbitrary limits to prevent infinite loops or excessively long computations.\n  # These might need tuning depending on the complexity of the CraftWorld scenarios.\n  MAX_SEARCH_STEPS = 500000 \n  MAX_ACTION_SEQUENCE_LENGTH = 200 \n\n  initial_state = env._current_state\n\n  # If the item is already in the inventory, no actions are needed.\n  if initial_state.inventory[item] > 0:\n    return []\n\n  # Queue for Breadth-First Search (BFS)\n  # Each element is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n  # collections.deque is assumed to be available (e.g., imported at the top of the file)\n  q = collections.deque([(initial_state, [])])\n  \n  # Visited set to prevent cycles and redundant exploration.\n  # A state is represented by a hashable tuple:\n  # (grid_bytes, position_tuple, direction_int, inventory_bytes)\n  # numpy arrays (grid, inventory) are converted to bytes for hashing.\n  # numpy is assumed to be available (e.g., imported as np at the top of the file)\n  visited = set()\n  \n  # Add the initial state to the visited set\n  initial_state_tuple = (\n      initial_state.grid.tobytes(),\n      initial_state.pos,\n      initial_state.dir,\n      initial_state.inventory.tobytes()\n  )\n  visited.add(initial_state_tuple)\n\n  search_steps_counter = 0\n\n  while q:\n    search_steps_counter += 1\n    # Check for search step limit to prevent runaway computations\n    if search_steps_counter > MAX_SEARCH_STEPS:\n      # print(f\"Warning: Max search steps ({MAX_SEARCH_STEPS}) reached. Could not find a plan for item {item}.\")\n      return [] # Return empty list if no plan found within limits\n\n    current_state, actions_so_far = q.popleft()\n\n    # Check if the goal (item in inventory) is satisfied in the current state\n    if current_state.inventory[item] > 0:\n      return actions_so_far # Goal reached, return the sequence of actions\n\n    # Prune search branches that are too long to prevent excessive memory/time usage\n    if len(actions_so_far) >= MAX_ACTION_SEQUENCE_LENGTH:\n      continue # Skip exploring further from this state\n\n    # Try all possible actions (movements and USE)\n    for action in ALL_ACTIONS:\n      # Simulate the action: get the next state\n      # The CraftState.step method handles all game logic (movement, pickups, crafting)\n      # Reward is always 0.0 in this implementation, so we ignore it.\n      _, next_state = current_state.step(action)\n\n      # Create a hashable representation of the next state\n      next_state_tuple = (\n          next_state.grid.tobytes(),\n          next_state.pos,\n          next_state.dir,\n          next_state.inventory.tobytes()\n      )\n      \n      # If this next state has not been visited, add it to the queue and mark as visited\n      if next_state_tuple not in visited:\n        visited.add(next_state_tuple)\n        new_actions_so_far = actions_so_far + [action] # Append the current action\n        q.append((next_state, new_actions_so_far))\n\n  # If the queue becomes empty and the goal was not reached, no path exists.\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:14:56.455832", "function_name": "craft", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:16:10.438252", "function_name": "craft", "function_body": "  import collections # This import is typically at the top of the file.\n                     # Placed here to adhere strictly to \"Return only the code that will be inside the function. Do not imports\"\n                     # which implies no top-level imports in the *output*.\n\n  def _get_hashable_state(craft_state):\n      \"\"\"\n      Returns a hashable representation of a CraftState for use in a set or dict key.\n      Includes position, direction, inventory contents, and grid bytes.\n      The grid.tobytes() can be very large and consume significant memory for large grids,\n      but is necessary to correctly capture all state changes relevant to crafting.\n      \"\"\"\n      # pos is a tuple (int, int), already hashable.\n      # dir is an int, already hashable.\n      # inventory is a numpy array; convert to a tuple of its list representation to make it hashable.\n      inventory_tuple = tuple(craft_state.inventory.tolist())\n      # grid is a numpy array; convert to bytes for hashing. This captures the exact state of the environment.\n      grid_bytes = craft_state.grid.tobytes()\n      return (craft_state.pos, craft_state.dir, inventory_tuple, grid_bytes)\n\n\n  # Get the initial state from the environment.\n  # The CraftLab instance `env` holds the current CraftState object in its `_current_state` attribute.\n  initial_craft_state = env._current_state\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_craft_state_object, list_of_actions_taken_to_reach_this_state).\n  q = collections.deque()\n\n  # Initialize a set to keep track of visited states.\n  # Storing hashable representations of states prevents cycles and redundant exploration.\n  visited = set()\n\n  # Get all possible action IDs from the environment's action_specs.\n  # e.g., env.action_specs() might return {'DOWN': 0, 'UP': 1, ...}, so we get [0, 1, ...].\n  action_ids = list(env.action_specs().values())\n\n  # Add the initial state to the queue and the visited set.\n  initial_path = []\n  q.append((initial_craft_state, initial_path))\n  visited.add(_get_hashable_state(initial_craft_state))\n\n  # Perform BFS\n  while q:\n      current_state, path_so_far = q.popleft()\n\n      # Check if the current state satisfies the goal.\n      # The `satisfies` method takes `goal_name` (ignored here) and `goal_arg` (the item index).\n      if current_state.satisfies(None, item):\n          return path_so_far # Goal reached, return the sequence of actions.\n\n      # Explore all possible next states from the current state.\n      for action_id in action_ids:\n          # Use the CraftState.step method to get the next state.\n          # This method returns a *new* CraftState object, ensuring the original state\n          # (and the environment's internal state) is not modified during search exploration.\n          # It returns (reward, new_CraftState). We only need the new_CraftState for BFS.\n          _, next_craft_state = current_state.step(action_id)\n\n          hashable_next_state = _get_hashable_state(next_craft_state)\n\n          # If this next state has not been visited before, add it to the queue and visited set.\n          if hashable_next_state not in visited:\n              visited.add(hashable_next_state)\n              # Append the new state object and the updated path to the queue.\n              q.append((next_craft_state, path_so_far + [action_id]))\n\n  # If the queue becomes empty and the goal was not found, it means the goal is unreachable\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:17:47.274721", "function_name": "craft", "function_body": "    # Constants for actions (assuming these are globally defined or available)\n    # If not, they would typically be imported or defined at a higher scope.\n    # For self-containment within the function, we define them here.\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Helper function for BFS pathfinding, defined locally to be self-contained\n    def _hashable_state_for_pathfinding(state):\n        \"\"\"Returns a hashable representation for pathfinding (only pos and dir).\"\"\"\n        return (state.pos, state.dir)\n\n    def _bfs_pathfinding(start_state, target_kinds_list=None, target_pos=None):\n        \"\"\"\n        Finds a path (actions) from start_state to a cell adjacent to any of target_kinds_list\n        or at target_pos. Movement actions only.\n        Returns (list of actions, final_state) or ([], None) if no path.\n        \"\"\"\n        q = collections.deque([(start_state, [])])\n        visited = {_hashable_state_for_pathfinding(start_state)}\n\n        while q:\n            current_s, path = q.popleft()\n\n            # Check if goal is reached:\n            # 1. If target_pos is specified, check if current_s.pos is that target_pos.\n            # 2. If target_kinds_list is specified, check if current_s is next to any of these kinds.\n            goal_reached = False\n            \n            if target_pos is not None:\n                if current_s.pos == target_pos:\n                    goal_reached = True\n            elif target_kinds_list is not None:\n                for kind_idx in target_kinds_list:\n                    if current_s.next_to(kind_idx):\n                        goal_reached = True\n                        break\n            \n            if goal_reached:\n                return path, current_s\n\n            # Explore movement actions (DOWN, UP, LEFT, RIGHT)\n            for action in [DOWN, UP, LEFT, RIGHT]:\n                # Simulate step without actually changing the original state or rewarding.\n                # CraftState.step for movement actions typically returns 0.0 reward.\n                _, next_s = current_s.step(action)\n                next_hashable_s = _hashable_state_for_pathfinding(next_s)\n\n                if next_hashable_s not in visited:\n                    visited.add(next_hashable_s)\n                    q.append((next_s, path + [action]))\n\n        return [], None # No path found\n\n    total_actions = []\n    current_state = env._current_state\n    cookbook = env.world.cookbook\n    \n    # Get the required primitive ingredients for the final 'item'.\n    # This recursively breaks down complex items into their primitive components.\n    # The dictionary maps primitive_idx to the count required.\n    required_primitives_counts = cookbook.primitives_for(item)\n\n    # Convert to a list of (primitive_idx, count) for deterministic iteration order.\n    primitives_to_get = sorted(required_primitives_counts.items(), key=lambda x: x[0])\n\n    # 1. Gather all required primitives\n    for primitive_idx, required_count in primitives_to_get:\n        while current_state.inventory[primitive_idx] < required_count:\n            # Find a path to an instance of the primitive on the grid.\n            # We search for any cell containing `primitive_idx`.\n            path_to_item, state_at_item = _bfs_pathfinding(current_state, target_kinds_list=[primitive_idx])\n            \n            if not path_to_item and not state_at_item: # No path found to this specific primitive instance\n                return [] # Cannot complete task: primitive not found or unreachable.\n\n            # Add movement actions to reach the item.\n            total_actions.extend(path_to_item)\n            current_state = state_at_item\n\n            # Agent is now adjacent to the primitive. Use 'USE' action to pick it up.\n            # We assume pickup is always successful if a path was found.\n            _, next_state_after_pickup = current_state.step(USE)\n            total_actions.append(USE)\n            current_state = next_state_after_pickup\n            \n            # The loop continues until the required count for this primitive is met,\n            # allowing for gathering multiple instances of the same primitive.\n\n    # 2. If the target 'item' itself is not a primitive, craft it at a workshop.\n    # This step assumes all necessary ingredients are now in the inventory.\n    if item not in cookbook.primitives: \n        workshop_indices = env.world.workshop_indices\n        \n        if not workshop_indices: # No workshops defined in the world\n            return [] # Cannot craft without a workshop.\n\n        # Find a path to any of the available workshops.\n        path_to_workshop, state_at_workshop = _bfs_pathfinding(current_state, target_kinds_list=workshop_indices)\n\n        if not path_to_workshop and not state_at_workshop:\n            return [] # Cannot find any workshop.\n\n        # Add movement actions to reach the workshop.\n        total_actions.extend(path_to_workshop)\n        current_state = state_at_workshop\n\n        # Agent is now adjacent to a workshop. Use 'USE' action to craft.\n        # We assume crafting is always successful if ingredients are present and a workshop is used.\n        _, next_state_after_craft = current_state.step(USE)\n        total_actions.append(USE)\n        current_state = next_state_after_craft\n        \n    # 3. Final verification: Check if the goal item is now in the inventory.\n    if not current_state.satisfies(None, item):\n        # This indicates a failure in the crafting process (e.g., ingredients insufficient,\n        # item became uncraftable, or logic error).\n        return []\n\n    return total_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:17:47.298066", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants for internal use\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n    ACTIONS = [DOWN, UP, LEFT, RIGHT]\n    ACTION_DELTAS = {\n        UP: (-1, 0),\n        DOWN: (1, 0),\n        LEFT: (0, -1),\n        RIGHT: (0, 1)\n    }\n\n    def _find_path(start_pos, current_grid, target_kind_idx, grid_dims):\n        \"\"\"\n        Finds a path (list of actions) from start_pos to a position where agent\n        can 'USE' the target_kind_idx. The target position is defined as any\n        cell from which the agent can be 'next_to' the target_kind_idx.\n        Returns (list_of_actions, final_pos) or (None, None) if no path.\n        \"\"\"\n        R, C, _ = grid_dims\n        q = collections.deque([(start_pos, [])]) # (current_pos, actions_so_far)\n        visited = {start_pos}\n\n        # Helper to check if a position (r, c) enables 'next_to' target_kind_idx on the grid\n        def can_next_to(r, c, grid, kind_idx):\n            # Check 3x3 neighborhood around (r, c)\n            for dr_item in [-1, 0, 1]:\n                for dc_item in [-1, 0, 1]:\n                    item_r, item_c = r + dr_item, c + dc_item\n                    if 0 <= item_r < R and 0 <= item_c < C:\n                        # If this cell contains the kind (and it's not the agent's current cell,\n                        # though next_to implicitly handles this by checking grid content)\n                        if grid[item_r, item_c, kind_idx] > 0:\n                            return True\n            return False\n\n        while q:\n            (r, c), path_actions = q.popleft()\n\n            # Check if the current position is a goal state (can use target_kind_idx here)\n            if can_next_to(r, c, current_grid, target_kind_idx):\n                return path_actions, (r, c)\n\n            # Explore neighbors\n            for action_val in ACTIONS:\n                dr, dc = ACTION_DELTAS[action_val]\n                nr, nc = r + dr, c + dc\n\n                if 0 <= nr < R and 0 <= nc < C and (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    new_path_actions = path_actions + [action_val]\n                    q.append(((nr, nc), new_path_actions))\n\n        return None, None # No path found\n\n    all_actions = []\n    # Get initial state from the scenario\n    current_state = env.scenario.init()\n    cookbook = env.world.cookbook\n    grid_dims = current_state.grid.shape # (WIDTH, HEIGHT, n_kinds)\n\n    # Determine what is needed\n    needed_primitives = cookbook.primitives_for(item)\n    is_final_craft_step = True # Assume crafting is needed\n\n    # Special case: if target item is a primitive itself and has no recipe, we just need to pick it up.\n    if not needed_primitives and item in env.world.grabbable_indices:\n        needed_primitives = {item: 1} # Need to \"collect\" one of itself\n        is_final_craft_step = False\n\n    if not needed_primitives:\n        # Cannot craft or collect this item (either no recipe or not grabbable primitive)\n        return []\n\n    # Simulate the state to plan actions\n    simulated_inventory = current_state.inventory.copy()\n    simulated_grid = current_state.grid.copy()\n    simulated_pos = current_state.pos\n\n    # Phase 1: Collect all required primitive ingredients\n    # Loop until all required primitives are met in simulated_inventory\n    while any(simulated_inventory[k] < c for k, c in needed_primitives.items()):\n        # Find the first missing primitive (could be optimized to find closest)\n        target_primitive_kind = -1\n        for k, c in needed_primitives.items():\n            if simulated_inventory[k] < c:\n                target_primitive_kind = k\n                break\n\n        if target_primitive_kind == -1: # Should not happen if loop condition is correct\n            break\n\n        # Find path to reach a position adjacent to target_primitive_kind\n        path_to_item, final_pos_after_move = _find_path(\n            simulated_pos, simulated_grid, target_primitive_kind, grid_dims\n        )\n\n        if path_to_item is None:\n            # Cannot reach required primitive, impossible to craft\n            return []\n\n        # Add path actions\n        all_actions.extend(path_to_item)\n        simulated_pos = final_pos_after_move # Update simulated position\n\n        # Add USE action\n        all_actions.append(USE)\n        \n        # Simulate the effect of USE action: remove one instance of the item from grid, add to inventory\n        # Find the specific item location that was \"used\" (within 3x3 neighborhood of simulated_pos)\n        found_item_loc = None\n        for dr_item in [-1, 0, 1]:\n            for dc_item in [-1, 0, 1]:\n                item_r, item_c = simulated_pos[0] + dr_item, simulated_pos[1] + dc_item\n                if 0 <= item_r < grid_dims[0] and 0 <= item_c < grid_dims[1]:\n                    if simulated_grid[item_r, item_c, target_primitive_kind] > 0:\n                        found_item_loc = (item_r, item_c)\n                        break\n            if found_item_loc:\n                break\n        \n        if found_item_loc:\n            simulated_grid[found_item_loc[0], found_item_loc[1], target_primitive_kind] -= 1\n            simulated_inventory[target_primitive_kind] += 1\n        else:\n            # This indicates an inconsistency: path found, but item not there to pick up.\n            # Could happen if item is dynamic or consumed by something else.\n            # For this static planning, it implies an error or an uncollectable item.\n            return [] # Fail if USE finds no item\n\n    # Phase 2: Craft the final item if necessary\n    if is_final_craft_step:\n        # Find a workshop kind to target\n        workshop_kind_indices = env.world.workshop_indices\n        if not workshop_kind_indices:\n            # No workshop available, cannot craft\n            return []\n\n        # Pick one workshop kind to target (e.g., the first one)\n        target_workshop_kind = workshop_kind_indices[0]\n\n        # Find path to reach a position adjacent to the workshop\n        path_to_workshop, final_pos_after_move = _find_path(\n            simulated_pos, simulated_grid, target_workshop_kind, grid_dims\n        )\n\n        if path_to_workshop is None:\n            # Cannot reach a workshop, impossible to craft\n            return []\n\n        all_actions.extend(path_to_workshop)\n        simulated_pos = final_pos_after_move # Update simulated position\n        all_actions.append(USE) # Use workshop to craft\n\n    return all_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:20:08.613817", "function_name": "craft", "function_body": "    import collections\n\n    # Action constants (assuming these map to integers 0-4)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Maximum number of planning iterations to prevent infinite loops in complex or unreachable scenarios\n    MAX_PLANNING_ITERATIONS = 500 \n\n    def _get_path_to_next_to_object(start_state, target_kind_idx):\n        \"\"\"\n        Finds a path of movement actions to get the agent to a position\n        where it is 'next_to' the target_kind_idx. This uses BFS on the grid.\n\n        Args:\n            start_state (CraftState): The current state of the agent and world.\n            target_kind_idx (int): The index of the entity kind to get next to.\n\n        Returns:\n            list: A list of movement actions (e.g., ACTION_UP, ACTION_DOWN)\n                  or None if no path is found within the reachable grid.\n        \"\"\"\n        q = collections.deque([(start_state.pos, [])]) # (current_pos, path_actions)\n        \n        # Visited set for grid positions to avoid cycles in pathfinding\n        # (x, y) tuple\n        visited_pos = {start_state.pos}\n\n        WIDTH, HEIGHT, _ = start_state.grid.shape\n        \n        # Define movement options: (delta_x, delta_y), action_code\n        move_options = [\n            ((0, -1), ACTION_UP),    # Move North\n            ((0, 1), ACTION_DOWN),   # Move South\n            ((-1, 0), ACTION_LEFT),  # Move West\n            ((1, 0), ACTION_RIGHT),  # Move East\n        ]\n\n        while q:\n            current_pos, path_actions = q.popleft()\n            \n            # Check if current_pos is next to the target_kind_idx\n            # Simulates CraftState.next_to logic without creating a new CraftState object\n            found_target_adjacent = False\n            for dx_adj in [-1, 0, 1]:\n                for dy_adj in [-1, 0, 1]:\n                    if dx_adj == 0 and dy_adj == 0: continue # Don't check agent's own cell\n                    adj_x, adj_y = current_pos[0] + dx_adj, current_pos[1] + dy_adj\n                    \n                    # Check if the adjacent cell is within grid bounds\n                    if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n                        # Check if the target kind is present in the adjacent cell\n                        if start_state.grid[adj_x, adj_y, target_kind_idx] > 0:\n                            found_target_adjacent = True\n                            break # Found target, no need to check other adjacent cells\n                if found_target_adjacent: break\n            \n            if found_target_adjacent:\n                return path_actions # Path to a position next to the target is found\n\n            # If not next to the target, explore neighboring cells\n            for (dx, dy), action in move_options:\n                next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n\n                # Check if next position is within bounds and not already visited\n                if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and (next_x, next_y) not in visited_pos:\n                    visited_pos.add((next_x, next_y))\n                    q.append(((next_x, next_y), path_actions + [action]))\n        \n        return None # No path found to get next to the target object\n\n    def _can_craft(target_idx, state, cookbook):\n        \"\"\"\n        Checks if the agent can craft a specific item given its current state.\n        This includes checking for ingredients and being next to the required workshop.\n\n        Args:\n            target_idx (int): The index of the item to check for crafting.\n            state (CraftState): The current state of the agent.\n            cookbook (Cookbook): The cookbook instance containing recipes.\n\n        Returns:\n            bool: True if the item can be crafted, False otherwise.\n        \"\"\"\n        recipe = cookbook.recipes.get(target_idx)\n        if not recipe:\n            return False # No recipe exists for this item\n        \n        # Check if all required ingredients are present in the inventory\n        for ingredient_idx, count in recipe.items():\n            if isinstance(ingredient_idx, int): # Ignore the '_key' which specifies workshop\n                if state.inventory[ingredient_idx] < count:\n                    return False # Not enough of this ingredient\n        \n        # Check if a workshop is required and if the agent is next to it\n        workshop_key = recipe.get(\"_key\")\n        if workshop_key is not None:\n            workshop_idx = cookbook.index[workshop_key] # Get the integer index for the workshop\n            if not state.next_to(workshop_idx):\n                return False # Not next to the required workshop\n        \n        return True # All conditions met for crafting\n\n    # --- Main `craft_v2` logic starts here ---\n    \n    cookbook = env.world.cookbook\n    current_state = env._current_state\n    \n    final_actions = [] # This list will store the sequence of actions to return\n\n    # The goal_stack holds (item_idx, count_needed) tuples.\n    # It acts as a LIFO stack: the last item pushed (most immediate dependency)\n    # is the first one processed (by peeking with [-1] and popping).\n    goal_stack = collections.deque([(item, 1)]) # Start with the primary goal: needing 1 of the 'item'\n\n    planning_iterations = 0 # Counter to prevent infinite loops\n\n    # The main planning loop: continues as long as there are goals and within iteration limits\n    while goal_stack and planning_iterations < MAX_PLANNING_ITERATIONS:\n        planning_iterations += 1\n\n        current_goal_idx, _ = goal_stack[-1] # Peek at the top goal to work on\n\n        # 1. Check if the current goal is already satisfied in the inventory\n        if current_state.inventory[current_goal_idx] > 0:\n            goal_stack.pop() # Goal satisfied, remove it from the stack\n            continue # Move to the next goal\n\n        # 2. Determine how to acquire the current goal item (primitive or craftable)\n        if current_goal_idx in cookbook.primitives:\n            # The goal is a primitive item (can be picked up from the environment)\n            \n            # Check if agent is already next to the primitive\n            if current_state.next_to(current_goal_idx):\n                # If next to it, perform the 'USE' action to pick it up\n                _, new_state = current_state.step(ACTION_USE)\n                final_actions.append(ACTION_USE)\n                current_state = new_state # Update current state\n                # The next iteration will find the item in inventory and pop this goal\n            else:\n                # Not next to it, need to move there.\n                path_to_primitive_actions = _get_path_to_next_to_object(current_state, current_goal_idx)\n                if path_to_primitive_actions:\n                    # If a path is found, execute each movement action\n                    for action in path_to_primitive_actions:\n                        _, new_state = current_state.step(action)\n                        final_actions.append(action)\n                        current_state = new_state # Update current state after each step\n                    # After moving, the next iteration will find the agent next to the primitive and USE it\n                else:\n                    # If no path is found to the primitive, this goal is unreachable. Abort.\n                    return [] \n        else:\n            # The goal is a craftable item (requires a recipe and possibly a workshop)\n            recipe = cookbook.recipes.get(current_goal_idx)\n            if not recipe:\n                # No recipe found and not a primitive. This item cannot be acquired. Abort.\n                return [] \n\n            # Check if all ingredients for this recipe are present in the inventory\n            all_ingredients_present = True\n            missing_ingredients = [] # To store missing (ingredient_idx, count_needed)\n            \n            for ingredient_idx, count_needed in recipe.items():\n                if isinstance(ingredient_idx, int): # Ensure it's an ingredient index, not '_key'\n                    if current_state.inventory[ingredient_idx] < count_needed:\n                        all_ingredients_present = False\n                        # Add missing count of this ingredient to the `missing_ingredients` list\n                        for _ in range(count_needed - current_state.inventory[ingredient_idx]):\n                            missing_ingredients.append((ingredient_idx, 1))\n\n            if not all_ingredients_present:\n                # If ingredients are missing, push them onto the goal stack.\n                # This makes the planner prioritize acquiring these dependencies first.\n                # Pushing them one by one to ensure each is addressed.\n                for ing_idx, ing_count in missing_ingredients:\n                    goal_stack.append((ing_idx, ing_count))\n                continue # Re-evaluate the new top goal (which is now a missing ingredient)\n\n            # All ingredients are present. Now, handle the workshop requirement.\n            workshop_key = recipe.get(\"_key\")\n            workshop_idx = None\n            if workshop_key:\n                workshop_idx = cookbook.index[workshop_key] # Get the integer index for the workshop\n            \n            if workshop_idx is not None:\n                # A workshop is required for this recipe\n                if not current_state.next_to(workshop_idx):\n                    # Not next to workshop, need to move there.\n                    path_to_workshop_actions = _get_path_to_next_to_object(current_state, workshop_idx)\n                    if path_to_workshop_actions:\n                        # If a path is found, execute movement actions\n                        for action in path_to_workshop_actions:\n                            _, new_state = current_state.step(action)\n                            final_actions.append(action)\n                            current_state = new_state # Update state after each step\n                        # After moving, the next iteration will find the agent next to the workshop and USE it\n                    else:\n                        # Cannot reach the workshop. Abort planning.\n                        return []\n                else:\n                    # Next to workshop and ingredients are ready, perform 'USE' action to craft.\n                    if _can_craft(current_goal_idx, current_state, cookbook):\n                        _, new_state = current_state.step(ACTION_USE)\n                        final_actions.append(ACTION_USE)\n                        current_state = new_state # Update state\n                        # The crafted item should now be in inventory, next iteration will pop this goal\n                    else:\n                        # Should ideally not happen if _can_craft logic is consistent with prior checks.\n                        # As a safeguard, abort if crafting fails here.\n                        return [] \n            else:\n                # No workshop needed (e.g., crafting directly from inventory)\n                # Ingredients are ready, perform 'USE' action to craft.\n                if _can_craft(current_goal_idx, current_state, cookbook):\n                    _, new_state = current_state.step(ACTION_USE)\n                    final_actions.append(ACTION_USE)\n                    current_state = new_state # Update state\n                    # The crafted item should now be in inventory, next iteration will pop this goal\n                else:\n                    # Safeguard: Abort if crafting fails unexpectedly.\n                    return []\n\n    # After the planning loop completes (either all goals satisfied or iterations limit reached)\n    # Check if the desired 'item' is now in the inventory.\n    if current_state.inventory[item] > 0:\n        return final_actions # Success: Return the sequence of actions\n    else:\n        # Failure: The item was not crafted within the planning limits or due to unreachable sub-goals.\n        return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:20:10.281207", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these are defined and consistent with CraftWorld/CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def _hash_state(craft_state):\n    \"\"\"\n    Generates a hashable representation of the CraftState for the visited set.\n    This version uses the agent's position, direction, and a tuple of its\n    inventory counts. It assumes that differences in the grid that are not\n    reflected in inventory (e.g., items being picked up and disappearing from\n    the grid) are implicitly handled by the inventory change, or are\n    acceptable for finding a valid path (not necessarily strictly optimal\n    if grid changes are critical for future choices beyond inventory).\n    \"\"\"\n    # Convert numpy array inventory to a tuple for hashing\n    inventory_tuple = tuple(craft_state.inventory)\n    return (craft_state.pos, craft_state.dir, inventory_tuple)\n\n\n  # Initial state from the CraftLab environment\n  initial_state = env._current_state\n\n  # Check if the item is already in inventory at the start.\n  # If so, no actions are needed to \"craft\" it.\n  if initial_state.inventory[item] > 0:\n    return []\n\n  # BFS Queue: stores tuples of (current_CraftState, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(initial_state, [])])\n\n  # Visited Set: stores hashable representations of states to avoid redundant work and cycles.\n  visited = {_hash_state(initial_state)}\n\n  # Define all possible actions the agent can take\n  actions = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Heuristic limit to prevent excessively long searches in complex or unsolvable scenarios.\n  # This value can be tuned based on the expected complexity of the crafting tasks.\n  MAX_PATH_LENGTH = 500 \n\n  # BFS loop\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # Prune paths that exceed the maximum allowed length to prevent infinite loops\n    # or extremely long computations in very large state spaces.\n    if len(path_so_far) >= MAX_PATH_LENGTH:\n      continue\n\n    # Explore all possible next states by applying each action\n    for action in actions:\n      # Apply the action to get the next state.\n      # The .step() method of CraftState returns a new CraftState object.\n      # The reward is ignored as we are searching for any path, not an optimal one by reward.\n      next_state, _ = current_state.step(action)\n\n      # Check if the goal item is now in the inventory of the new state.\n      # This is the primary success condition for crafting the item.\n      if next_state.inventory[item] > 0:\n        return path_so_far + [action] # Goal reached! Return the complete sequence of actions.\n\n      # Generate a hash for the new state to check if it has been visited before.\n      next_state_hash = _hash_state(next_state)\n\n      # If this state (defined by its hash) has not been visited, add it to the queue and visited set.\n      if next_state_hash not in visited:\n        visited.add(next_state_hash)\n        queue.append((next_state, path_so_far + [action]))\n\n  # If the queue becomes empty and the goal was never reached, no path was found\n  # within the search limits.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:22:24.447324", "function_name": "craft", "function_body": "  # Action constants (assuming they are globally defined or implicitly known)\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # Re-defining them for clarity within this context, assuming they map to the environment's actions.\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n  _MOVE_ACTIONS = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT]\n  _ALL_ACTIONS = _MOVE_ACTIONS + [_ACTION_USE]\n\n  # A reasonable default for maximum search depth in BFS to prevent excessively long paths.\n  _MAX_BFS_DEPTH = 100 \n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  # This is crucial for BFS and recursive planning to avoid redundant computations and cycles.\n  def _hash_craft_state(state):\n      \"\"\"Generates a hashable representation of a CraftState by converting mutable parts to bytes.\"\"\"\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # A general Breadth-First Search (BFS) helper function for pathfinding.\n  # It finds a sequence of actions from a start state to a state satisfying a goal predicate.\n  def _bfs_path_find(start_s, goal_fn, cookbook, relevant_use_kind=None, max_depth=_MAX_BFS_DEPTH):\n      \"\"\"\n      Performs a BFS to find the shortest path (in terms of actions) from `start_s` to a state \n      satisfying `goal_fn`.\n\n      Args:\n          start_s (CraftState): The starting state for the BFS.\n          goal_fn (callable): A function `goal_fn(state)` that returns True if the state \n                              satisfies the goal, False otherwise.\n          cookbook (Cookbook): Reference to the world's cookbook, used for primitive checks.\n          relevant_use_kind (int, optional): If an item's index is provided (e.g., a primitive \n                                             to gather), `USE` actions will only be considered \n                                             if the agent is next to this kind. This prunes \n                                             ineffective `USE` actions during pathfinding.\n                                             Defaults to None.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths \n                           or infinite loops in complex environments.\n\n      Returns:\n          tuple: `(list of actions, final_state)` if a path is found, else `(None, None)`.\n      \"\"\"\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)} # Set to store hashes of visited states\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal\n          if goal_fn(curr_s):\n              return curr_p, curr_s\n\n          # Prune if path length exceeds maximum allowed depth\n          if len(curr_p) >= max_depth:\n              continue\n\n          # Explore all possible actions from the current state\n          for action in _ALL_ACTIONS:\n              # Optimization for 'USE' action:\n              # If we're specifically trying to get a primitive (relevant_use_kind is set),\n              # only attempt 'USE' if the agent is directly next to that primitive.\n              # This avoids wasting search effort on useless 'USE' actions.\n              if action == _ACTION_USE:\n                  if relevant_use_kind is not None and relevant_use_kind in cookbook.primitives:\n                      if not curr_s.next_to(relevant_use_kind):\n                          continue # Skip this 'USE' action as it's not productive for the current goal.\n\n              # Apply the action to get the next state\n              _, next_s = curr_s.step(action)\n              next_hash = _hash_craft_state(next_s)\n\n              # Add the new state to the queue only if it hasn't been visited before\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      return None, None  # No path found within the given constraints\n\n  # Memoization dictionary to store results of _plan_craft_recursive for (state_hash, target_item_idx)\n  # This significantly improves performance by avoiding redundant computation of sub-goals.\n  _memo = {} # Initialized for each call to craft_v2 to ensure a clean slate.\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops).\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx, cookbook, memo):\n      \"\"\"\n      Recursively plans the actions required to craft a target item starting from a given state.\n\n      Args:\n          current_state_for_goal (CraftState): The current environment state for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n          cookbook (Cookbook): Reference to the world's cookbook for recipes and primitive definitions.\n          memo (dict): The memoization dictionary used to cache and retrieve results of sub-problems.\n\n      Returns:\n          tuple: `(list of actions, final_state)` required to craft the item, or `(None, None)` if impossible.\n      \"\"\"\n      # Create a hashable key for memoization based on current state and target item\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n      \n      # Check memoization cache before computing\n      if memo_key in memo:\n          return memo[memo_key]\n\n      # Base Case 1: Target item is already in inventory (we have at least one unit)\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          memo[memo_key] = ([], current_state_for_goal) # No actions needed, state is already desired\n          return [], current_state_for_goal\n\n      # Case 1: Target item is a primitive resource (needs to be gathered from the environment)\n      if target_item_idx in cookbook.primitives:\n          # Record current count to define goal: we need to get at least one more.\n          current_count = current_state_for_goal.inventory[target_item_idx]\n          # Define the goal for BFS: any state where the primitive count has increased.\n          goal_fn = lambda s: s.inventory[target_item_idx] > current_count\n          \n          # Use BFS to find actions to reach and gather the primitive.\n          # `relevant_use_kind` guides the BFS to only consider 'USE' near the primitive.\n          path_to_get_primitive, new_state = _bfs_path_find(\n              current_state_for_goal, goal_fn, cookbook, relevant_use_kind=target_item_idx)\n          \n          if path_to_get_primitive is None:\n              memo[memo_key] = (None, None) # Cache and return failure if primitive cannot be acquired\n              return None, None\n          \n          memo[memo_key] = (path_to_get_primitive, new_state) # Cache success\n          return path_to_get_primitive, new_state\n\n      # Case 2: Target item is a crafted product (requires a recipe)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via any recipe. Impossible to obtain.\n          memo[memo_key] = (None, None) \n          return None, None \n      \n      # Copy recipe to extract ingredients and workshop requirement\n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop index\n\n      current_state_after_ingredients = current_state_for_goal\n      actions_for_this_goal = [] # List to accumulate all actions for this crafting goal\n\n      # Step A: Recursively gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_ingredients.inventory[ingredient_idx] < count_needed:\n              # Recursively plan to get one more unit of the current missing ingredient.\n              # The `current_state_after_ingredients` is updated with each successful acquisition,\n              # ensuring subsequent recursive calls start from the new inventory state.\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_ingredients, ingredient_idx, cookbook, memo)\n              \n              if actions_for_one_ing is None:\n                  memo[memo_key] = (None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_state_after_ingredients = next_state_after_ingredient\n\n      # Step B: Move to the required workshop if necessary\n      state_for_crafting = current_state_after_ingredients\n\n      if workshop_needed is not None:\n          # Define goal for BFS: agent must be next to the required workshop.\n          goal_fn_workshop = lambda s: s.next_to(workshop_needed)\n          \n          # Find actions to move to the workshop. `relevant_use_kind=None` as we're just moving.\n          path_to_workshop, state_at_workshop = _bfs_path_find(\n              state_for_crafting, goal_fn_workshop, cookbook, relevant_use_kind=None\n          )\n          \n          if path_to_workshop is None:\n              memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          state_for_crafting = state_at_workshop\n\n      # Step C: Perform the 'USE' action to craft the item\n      current_inv_of_target = state_for_crafting.inventory[target_item_idx]\n      \n      # Simulate the 'USE' action to get the resulting state.\n      # The reward is not used here, only the state transition.\n      _, final_state_after_craft = state_for_crafting.step(_ACTION_USE) \n\n      # Verify if crafting was successful (i.e., target item count increased)\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target:\n          actions_for_this_goal.append(_ACTION_USE) # Add the 'USE' action to the plan\n          memo[memo_key] = (actions_for_this_goal, final_state_after_craft)\n          return actions_for_this_goal, final_state_after_craft\n      else:\n          # Crafting failed (e.g., not at correct workshop, or other conditions not met)\n          memo[memo_key] = (None, None)\n          return None, None\n\n  # Get the initial state of the environment and the cookbook for planning\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Start the recursive planning process for the top-level goal item.\n  # The `_memo` dictionary is passed to allow caching across recursive calls.\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item, cookbook, _memo)\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return an empty list if crafting the item is impossible or no plan can be found.", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:22:25.802554", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n  import heapq # For A* search algorithm\n\n  # Action constants (assuming they are globally defined or implicitly known)\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  _ACTIONS = [0, 1, 2, 3, 4]\n  _ACTION_COSTS = {0: 1, 1: 1, 2: 1, 3: 1, 4: 1} # All actions cost 1\n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  # This is crucial for A* search and recursive planning to avoid redundant computations and cycles.\n  def _hash_craft_state(state):\n      # Use tobytes() for NumPy arrays for efficient hashing\n      # Include grid, inventory, position, and direction in the state hash\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # A* search helper function for pathfinding.\n  # It finds a sequence of actions from a start state to a state satisfying a goal predicate,\n  # prioritizing paths with lower estimated total cost.\n  def _astar_path_find(start_s, goal_fn, cookbook, relevant_use_kind=None, max_depth=100, heuristic_fn=None):\n      \"\"\"\n      Performs A* search to find a path from start_s to a state satisfying goal_fn.\n\n      Args:\n          start_s (CraftState): The starting state for the search.\n          goal_fn (callable): A function `goal_fn(state)` that returns True if the state\n                              satisfies the goal, False otherwise.\n          cookbook (Cookbook): Reference to the world's cookbook for primitive checks.\n          relevant_use_kind (int, optional): If an item's index is provided, `USE` actions\n                                             will only be considered if the agent is next to this kind.\n                                             Useful for gathering primitives. Defaults to None.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths\n                           or infinite loops in complex environments.\n          heuristic_fn (callable, optional): A function `heuristic_fn(state)` that estimates\n                                            the cost from `state` to the goal. Defaults to None (0-heuristic, i.e., Dijkstra).\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found, else (None, None).\n      \"\"\"\n      # Priority queue stores (f_cost, g_cost, current_state, actions_list)\n      # f_cost = g_cost + h_cost\n      pq = [(0, 0, start_s, [])] # (estimated_total_cost, cost_from_start, current_state, actions_to_reach_current_state)\n      \n      # visited_g_costs stores the minimum g_cost (cost from start) found so far to reach a state hash\n      # This is crucial for A* to re-evaluate paths when a shorter one is found to an already visited state.\n      visited_g_costs = {_hash_craft_state(start_s): 0}\n\n      while pq:\n          f_cost, g_cost, curr_s, curr_p = heapq.heappop(pq)\n\n          # If we found a better path to this state already, or this path has exceeded max_depth, skip\n          if g_cost > visited_g_costs.get(_hash_craft_state(curr_s), float('inf')) or len(curr_p) > max_depth:\n              continue\n\n          # Check if the current state satisfies the goal\n          if goal_fn(curr_s):\n              return curr_p, curr_s\n          \n          # Explore possible actions\n          for action in _ACTIONS:\n              action_cost = _ACTION_COSTS.get(action, 1)\n\n              # Action pruning for 'USE':\n              # If `relevant_use_kind` is specified (typically for primitive gathering),\n              # only allow `USE` action if the agent is currently next to that specific kind.\n              if action == 4:  # USE action\n                  if relevant_use_kind is not None and relevant_use_kind in cookbook.primitives:\n                      if not curr_s.next_to(relevant_use_kind):\n                          continue\n                  # For crafting at a workshop, `relevant_use_kind` will be None.\n                  # The recursive planner ensures the agent is next to the workshop before calling `step(4)`.\n\n              # Simulate the step to get the next state\n              _, next_s = curr_s.step(action)\n              next_hash = _hash_craft_state(next_s)\n              \n              new_g_cost = g_cost + action_cost\n              \n              # If this path to `next_s` is better than any previously found path, or it's a new state\n              if new_g_cost < visited_g_costs.get(next_hash, float('inf')):\n                  visited_g_costs[next_hash] = new_g_cost\n                  h_cost = heuristic_fn(next_s) if heuristic_fn else 0\n                  f_cost = new_g_cost + h_cost\n                  heapq.heappush(pq, (f_cost, new_g_cost, next_s, curr_p + [action]))\n      \n      return None, None # No path found within the search limits\n\n  # Heuristic function for A* pathfinding\n  def _get_heuristic_fn(target_item_idx, current_state, cookbook):\n      \"\"\"\n      Returns a heuristic function based on the target item and current state.\n      For primitive items, it provides Manhattan distance to the nearest item on the grid.\n      For crafting recipes or other goals, it returns a 0-heuristic (equivalent to Dijkstra/BFS).\n      \"\"\"\n      if target_item_idx in cookbook.primitives:\n          def primitive_heuristic(state):\n              # Find all locations of the `target_item_idx` on the current grid\n              primitive_locations = np.argwhere(state.grid[:, :, target_item_idx] > 0)\n              \n              if not primitive_locations.size:\n                  return float('inf') # If no primitive of this kind on the map, it's effectively unreachable\n\n              min_dist = float('inf')\n              px, py = state.pos\n              for lx, ly in primitive_locations:\n                  # Manhattan distance from current position to a primitive location\n                  dist = abs(px - lx) + abs(py - ly)\n                  min_dist = min(min_dist, dist)\n              \n              return min_dist\n          return primitive_heuristic\n      else:\n          # For recipes or general movement goals, a 0-heuristic is admissible and sufficient.\n          # It essentially makes A* behave like Dijkstra's algorithm (or BFS if costs are uniform).\n          return lambda state: 0\n\n  # Memoization dictionary to store results of _plan_craft_recursive.\n  # It's initialized for each `craft_v2` call to ensure a fresh planning session.\n  memo = {}\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops),\n  # using A* for pathfinding sub-problems.\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n\n      Returns:\n          tuple: (list of actions, final_state) required to craft the item, or (None, None) if impossible.\n      \"\"\"\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n      \n      if memo_key in memo:\n          return memo[memo_key] # Return cached result if available\n\n      # Base Case 1: Item is already in inventory\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          memo[memo_key] = ([], current_state_for_goal)\n          return [], current_state_for_goal\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          current_count = current_state_for_goal.inventory[target_item_idx]\n          \n          # Goal for A* search: inventory of target_item_idx increases (meaning we picked it up)\n          goal_fn = lambda s: s.inventory[target_item_idx] > current_count\n          \n          # Get the specific heuristic for primitive gathering\n          heuristic = _get_heuristic_fn(target_item_idx, current_state_for_goal, cookbook)\n\n          # Use A* to find a path that includes picking up the primitive\n          path_to_get_primitive, new_state = _astar_path_find(\n              current_state_for_goal, goal_fn, cookbook,\n              relevant_use_kind=target_item_idx, # This flag helps prune 'USE' actions in A*\n              heuristic_fn=heuristic # Pass the primitive-specific heuristic\n          )\n          \n          if path_to_get_primitive is None:\n              memo[memo_key] = (None, None)  # Cache failure\n              return None, None\n          \n          memo[memo_key] = (path_to_get_primitive, new_state)  # Cache success\n          return path_to_get_primitive, new_state\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          memo[memo_key] = (None, None)\n          return None, None \n      \n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      current_state_after_ingredients = current_state_for_goal\n      actions_for_this_goal = [] # Accumulate actions for this specific crafting goal\n\n      # Step A: Gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_ingredients.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient.\n              # The sub-call will determine its own pathfinding strategy (primitive or recipe).\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_ingredients, ingredient_idx)\n              \n              if actions_for_one_ing is None:\n                  memo[memo_key] = (None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_state_after_ingredients = next_state_after_ingredient\n\n      # Step B: Move to workshop if required, and then craft\n      state_for_crafting = current_state_after_ingredients\n\n      if workshop_needed is not None:\n          # Goal for A*: agent is next to the required workshop\n          goal_fn_workshop = lambda s: s.next_to(workshop_needed)\n          \n          # For movement to workshops, a 0-heuristic (equivalent to Dijkstra/BFS) is appropriate.\n          # No `relevant_use_kind` here, as the A* is just for movement, not for performing the `USE` itself.\n          path_to_workshop, state_at_workshop = _astar_path_find(\n              state_for_crafting, goal_fn_workshop, cookbook, relevant_use_kind=None, heuristic_fn=lambda s: 0\n          )\n          \n          if path_to_workshop is None:\n              memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          state_for_crafting = state_at_workshop\n\n      # Step C: Perform the USE action to craft the item\n      current_inv_of_target = state_for_crafting.inventory[target_item_idx]\n      \n      # Perform the USE action (action 4)\n      _, final_state_after_craft = state_for_crafting.step(4)\n\n      # Check if crafting was successful (inventory of target item increased)\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target:\n          actions_for_this_goal.append(4) # Add the USE action to the plan\n          memo[memo_key] = (actions_for_this_goal, final_state_after_craft)\n          return actions_for_this_goal, final_state_after_craft\n      else:\n          # Crafting failed (e.g., wrong workshop, not enough ingredients, or unexpected condition)\n          memo[memo_key] = (None, None)\n          return None, None\n\n  # Start the planning process for the top-level goal item\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item)\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path not found", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:24:25.178692", "function_name": "craft", "function_body": "    # Action constants (typically from env.action_specs(), but hardcoded for self-contained function)\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Direction vectors for movement actions\n    _DELTA_POS = {\n        _UP: (-1, 0),\n        _DOWN: (1, 0),\n        _LEFT: (0, -1),\n        _RIGHT: (0, 1),\n    }\n\n    # Access world and cookbook for information\n    cookbook = env.world.cookbook\n    world = env.world\n\n    # Get the initial state of the environment for simulation purposes.\n    # We create a mutable dictionary to represent the state during planning,\n    # as we cannot easily deep-copy `CraftState` objects or directly\n    # call their `step` method for planning without altering the live environment.\n    initial_env_state = env._current_state\n    sim_state = {\n        'grid': np.copy(initial_env_state.grid),\n        'inventory': np.copy(initial_env_state.inventory),\n        'pos': initial_env_state.pos,\n        'dir': initial_env_state.dir, # Direction is mostly ignored for `_USE` based on `next_to`'s 3x3 check.\n    }\n\n    GRID_ROWS, GRID_COLS, _ = sim_state['grid'].shape\n\n    def _sim_move_action(current_sim_state, action):\n        \"\"\"\n        Simulates a single movement action on the given mutable `current_sim_state`.\n        Updates the agent's position if the move is valid (within bounds and not blocked).\n        \"\"\"\n        if action not in _DELTA_POS:\n            return # Not a movement action\n\n        dr, dc = _DELTA_POS[action]\n        r, c = current_sim_state['pos']\n        nr, nc = r + dr, c + dc\n\n        # Check if the new position is within grid boundaries\n        if 0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS:\n            # Check for obstacles (non-grabbable items occupy cells and block movement)\n            is_blocked = False\n            for k_idx in world.non_grabbable_indices:\n                if current_sim_state['grid'][nr, nc, k_idx] > 0:\n                    is_blocked = True\n                    break\n            if not is_blocked:\n                current_sim_state['pos'] = (nr, nc)\n        # If blocked or out of bounds, the agent stays at its current position.\n\n    def _find_path_actions_to_interaction_pos(start_pos, target_kind_idx, current_grid, is_workshop_target):\n        \"\"\"\n        Finds a shortest sequence of movement actions from `start_pos` to a position\n        from which the agent can interact (USE) with `target_kind_idx`.\n        Returns a list of actions or None if no such path is found.\n        \"\"\"\n        q = collections.deque([(start_pos, [])]) # (current_position_tuple, list_of_actions_taken_to_reach_here)\n        visited = {start_pos}\n\n        # Define cells that block movement (non-grabbable items)\n        non_walkable_indices = world.non_grabbable_indices\n\n        while q:\n            (r, c), actions_so_far = q.popleft()\n\n            # Check if the current position (r, c) is a valid \"interaction\" position\n            target_found_at_interaction_pos = False\n            if is_workshop_target:\n                # For a workshop, the agent needs to be ON the cell containing it\n                if current_grid[r, c, target_kind_idx] > 0:\n                    target_found_at_interaction_pos = True\n            else: # Grabbable item (primitive resource)\n                # For a grabbable item, the agent needs to be ADJACENT to it (within 3x3 neighborhood).\n                # This simulates CraftState's `next_to` check.\n                for dr_n in [-1, 0, 1]:\n                    for dc_n in [-1, 0, 1]:\n                        nr_item, nc_item = r + dr_n, c + dc_n\n                        if 0 <= nr_item < GRID_ROWS and 0 <= nc_item < GRID_COLS:\n                            if current_grid[nr_item, nc_item, target_kind_idx] > 0:\n                                target_found_at_interaction_pos = True\n                                break # Found the item in the neighborhood\n                        if target_found_at_interaction_pos:\n                            break\n                \n            if target_found_at_interaction_pos:\n                return actions_so_far # Path found to a position suitable for interaction\n\n            # Explore neighboring cells (possible movement actions)\n            for action in [_UP, _DOWN, _LEFT, _RIGHT]:\n                dr, dc = _DELTA_POS[action]\n                nr, nc = r + dr, c + dc\n                new_pos = (nr, nc)\n\n                if 0 <= nr < GRID_ROWS and 0 <= nc < GRID_COLS and new_pos not in visited:\n                    # Check if the new cell is walkable (not blocked by obstacles)\n                    is_walkable = True\n                    for k_idx in non_walkable_indices:\n                        if current_grid[nr, nc, k_idx] > 0:\n                            is_walkable = False\n                            break\n                    if not is_walkable:\n                        continue # Skip this blocked cell\n                    \n                    visited.add(new_pos)\n                    q.append((new_pos, actions_so_far + [action]))\n        \n        return None # No path found to an interaction position\n\n    def _craft_recursive(target_item_idx, current_sim_state, current_plan_actions):\n        \"\"\"\n        Recursively finds actions to obtain `target_item_idx`.\n        Updates `current_sim_state` and `current_plan_actions` in place to reflect\n        the simulated process of gathering ingredients and crafting.\n        Returns True on successful acquisition, False on failure.\n        \"\"\"\n        # Base case: If the item is already in inventory, it's obtained.\n        if current_sim_state['inventory'][target_item_idx] > 0:\n            return True\n\n        # Check if the item is a primitive (resource that must be gathered, not crafted)\n        if target_item_idx in world.primitives:\n            # Find a path to the primitive on the grid\n            path_to_primitive = _find_path_actions_to_interaction_pos(\n                current_sim_state['pos'],\n                target_item_idx,\n                current_sim_state['grid'],\n                is_workshop_target=False # It's a grabbable resource, not a workshop\n            )\n            \n            if path_to_primitive:\n                current_plan_actions.extend(path_to_primitive)\n                # Simulate the agent moving to the primitive's vicinity\n                for action in path_to_primitive:\n                    _sim_move_action(current_sim_state, action)\n                \n                # Now that the agent is in position, perform the _USE action.\n                # Manually update sim_state for primitive pickup (since _sim_move_action doesn't handle this).\n                r_agent, c_agent = current_sim_state['pos']\n                picked_up = False\n                # Check 3x3 neighborhood around agent for the item to pick up\n                for dr_n in [-1, 0, 1]:\n                    for dc_n in [-1, 0, 1]:\n                        nr_item, nc_item = r_agent + dr_n, c_agent + dc_n\n                        if 0 <= nr_item < GRID_ROWS and 0 <= nc_item < GRID_COLS:\n                            if current_sim_state['grid'][nr_item, nc_item, target_item_idx] > 0:\n                                current_sim_state['grid'][nr_item, nc_item, target_item_idx] -= 1 # Remove from grid\n                                current_sim_state['inventory'][target_item_idx] += 1 # Add to inventory\n                                picked_up = True\n                                break # Assume only one instance picked up per USE\n                        if picked_up: break\n                    if picked_up: break\n                \n                if picked_up:\n                    current_plan_actions.append(_USE) # Add the USE action to the plan\n                    return True # Successfully gathered\n            \n            return False # Failed to find or reach the primitive\n\n        # If not a primitive, it must be craftable. Get its recipe.\n        recipe = cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            return False # Cannot craft (no recipe and not a primitive)\n\n        # Recursively gather all required ingredients\n        ingredients_ready = True\n        for ing_idx_str, count in recipe.items():\n            if ing_idx_str == '_key': # This entry denotes a required workshop, not an ingredient\n                continue\n            \n            ing_idx = int(ing_idx_str) # Convert string key to integer index\n            needed = count - current_sim_state['inventory'][ing_idx]\n\n            if needed > 0:\n                for _ in range(needed): # Recursively try to obtain the required quantity\n                    success_ing = _craft_recursive(ing_idx, current_sim_state, current_plan_actions)\n                    if not success_ing:\n                        ingredients_ready = False\n                        break # Failed to get an ingredient, so cannot craft\n                if not ingredients_ready:\n                    break # Propagate failure up\n\n        if not ingredients_ready:\n            return False # Cannot proceed without all ingredients\n\n        # All ingredients are now gathered. Proceed with crafting.\n        # Check for workshop requirement\n        workshop_key = recipe.get('_key')\n        if workshop_key:\n            workshop_idx = cookbook.index.index(workshop_key) # Get integer index of the required workshop\n            \n            # Find a path to the workshop\n            path_to_workshop = _find_path_actions_to_interaction_pos(\n                current_sim_state['pos'],\n                workshop_idx,\n                current_sim_state['grid'],\n                is_workshop_target=True # It's a workshop, agent needs to be ON it\n            )\n            \n            if path_to_workshop:\n                current_plan_actions.extend(path_to_workshop)\n                # Simulate movement to the workshop location\n                for action in path_to_workshop:\n                    _sim_move_action(current_sim_state, action)\n            else:\n                return False # Cannot reach the required workshop\n\n        # Perform the crafting action: consume ingredients and produce the item.\n        for ing_idx_str, count in recipe.items():\n            if ing_idx_str == '_key':\n                continue\n            ing_idx = int(ing_idx_str)\n            current_sim_state['inventory'][ing_idx] -= count # Consume ingredients from inventory\n        \n        current_sim_state['inventory'][target_item_idx] += 1 # Produce the target item\n        current_plan_actions.append(_USE) # Add the USE action to represent crafting\n\n        return True # Successfully crafted the item\n\n    # --- Main execution logic for craft_v2 ---\n\n    # If the desired item is already present in the initial inventory, no actions are needed.\n    if sim_state['inventory'][item] > 0:\n        return []\n\n    # Initialize an empty list to store the sequence of actions.\n    plan_actions = []\n    \n    # Attempt to craft the item recursively, updating `sim_state` and `plan_actions` in place.\n    success = _craft_recursive(item, sim_state, plan_actions)\n    \n    if success:\n        return plan_actions\n    else:\n        return [] # Return empty list if crafting goal cannot be achieved", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:24:36.502015", "function_name": "craft", "function_body": "  import collections # Placed here to adhere strictly to \"only return code that will fit in that function. Do not imports... on the top.\"\n\n  # Constants for actions based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Ensure the environment is reset to a known state before starting search.\n  # This populates env._current_state.\n  # The seed for reset() here primarily affects observations like image, not the core CraftState for search,\n  # but it's good practice for reproducibility of the overall DMLab interface.\n  _ = env.reset(seed=0)\n\n  # Get the initial CraftState instance directly from the CraftLab environment.\n  # We will use CraftState's own .step() method for search without involving CraftLab's step loop.\n  initial_craft_state = env._current_state\n\n  # BFS Queue: stores tuples of (current_craft_state_object, list_of_actions_taken_to_reach_this_state)\n  q = collections.deque([(initial_craft_state, [])])\n\n  # Visited set: stores hashable representations of states to avoid revisiting.\n  # A hashable state is a tuple: (grid_byte_string, position_tuple, direction_int, inventory_tuple).\n  visited = set()\n  \n  # Add the initial state to the visited set.\n  initial_hashable_state = (\n      initial_craft_state.grid.tobytes(), # Convert numpy array to bytes for hashing\n      initial_craft_state.pos,\n      initial_craft_state.dir,\n      tuple(initial_craft_state.inventory) # Convert numpy array to tuple for hashing\n  )\n  visited.add(initial_hashable_state)\n\n  # Limit the search space to prevent excessively long runtimes for complex or unreachable goals.\n  MAX_SEARCH_NODES = 50000 \n  nodes_visited_count = 0\n\n  while q:\n      current_state, current_actions = q.popleft()\n      nodes_visited_count += 1\n\n      # Check if we've exceeded the search limit.\n      if nodes_visited_count > MAX_SEARCH_NODES:\n          # If limit reached, assume goal is unreachable within reasonable bounds and return an empty path.\n          return []\n\n      # Check if the current state satisfies the goal condition.\n      # CraftState.satisfies expects a goal_name (ignored) and goal_arg (the item index).\n      if current_state.satisfies(None, item):\n          return current_actions # Goal achieved, return the sequence of actions.\n\n      # Explore all possible actions from the current state.\n      for action in ACTIONS:\n          # Apply the action to get the next CraftState.\n          # CraftState.step returns (reward, new_state). Reward is ignored for pathfinding.\n          _, next_state = current_state.step(action)\n\n          # Create a hashable representation of the next state.\n          next_hashable_state = (\n              next_state.grid.tobytes(),\n              next_state.pos,\n              next_state.dir,\n              tuple(next_state.inventory)\n          )\n\n          # If this state has not been visited before, add it to the queue and visited set.\n          if next_hashable_state not in visited:\n              visited.add(next_hashable_state)\n              q.append((next_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted from the initial state.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T14:25:22.270912", "function_name": "craft", "function_body": "    ACTIONS = [0, 1, 2, 3, 4]  # DOWN, UP, LEFT, RIGHT, USE\n\n    def _hashable_state(state):\n        \"\"\"Converts a CraftState object into a hashable tuple for visited set.\"\"\"\n        # Convert numpy arrays to tuples for hashing\n        # Grid: (WIDTH, HEIGHT, n_kinds) -> tuple of tuples of tuples\n        grid_tuple = tuple(tuple(tuple(kind_value for kind_value in cell_kind_array)\n                                 for cell_kind_array in row_array)\n                           for row_array in state.grid)\n        # Inventory: (n_kinds,) -> tuple\n        inventory_tuple = tuple(state.inventory)\n        \n        return (grid_tuple, state.pos, state.dir, inventory_tuple)\n\n    start_state = env._current_state\n    \n    # Use collections.deque for efficient BFS queue operations\n    # Queue stores (current_CraftState_object, list_of_actions_to_reach_this_state)\n    q = collections.deque()\n    \n    # Visited set stores hashable representations of states to avoid cycles and redundant work\n    visited = set()\n\n    # Initialize the queue with the starting state and an empty action list\n    q.append((start_state, []))\n    visited.add(_hashable_state(start_state))\n\n    while q:\n        current_state, current_actions = q.popleft()\n\n        # Check if the current state satisfies the goal\n        # goal_name is ignored by CraftState.satisfies, goal_arg is the item index\n        if current_state.satisfies(None, item):\n            return current_actions  # Goal reached, return the sequence of actions\n\n        # Explore all possible next states from the current state\n        for action in ACTIONS:\n            # Simulate the action to get the next state\n            # The reward is always 0.0 in this environment, so we discard it\n            _, next_state = current_state.step(action)\n\n            next_hashable_state = _hashable_state(next_state)\n\n            # If this state has not been visited before, add it to the queue\n            if next_hashable_state not in visited:\n                visited.add(next_hashable_state)\n                q.append((next_state, current_actions + [action]))\n\n    # If the queue is exhausted and the goal was not found, return an empty list\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:25:24.106794", "function_name": "craft", "function_body": "  # Map action names to their integer codes for easy use\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is crucial for the `visited` set to avoid revisiting identical states.\n  def _hash_craft_state(state):\n      return (\n          state.grid.tobytes(),        # Convert numpy array to bytes for hashing\n          state.pos,                   # Position tuple is already hashable\n          state.dir,                   # Direction integer is already hashable\n          state.inventory.tobytes()    # Convert numpy array to bytes for hashing\n      )\n\n  # Reset the environment to get the initial CraftState.\n  # CraftLab.reset() returns an observation dict, but also updates `_current_state`.\n  # Using a fixed seed for deterministic behavior, if desired.\n  _ = env.reset(seed=0) \n  initial_craft_state = env._current_state\n\n  # If the goal item is already in the inventory at the start, no actions needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the BFS queue. Each element is a tuple: (current_state, path_to_current_state).\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Initialize the set of visited states to avoid cycles and redundant computations.\n  # Stores hashable representations of CraftState objects.\n  visited = {_hash_craft_state(initial_craft_state)}\n\n  # Start the BFS loop\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # Explore all possible actions from the current state\n      for action in ALL_ACTIONS:\n          # Simulate the action to get the next state.\n          # CraftState.step returns (reward, new_state).\n          # The reward is always 0.0 in this implementation, so we ignore it.\n          _, next_state = current_state.step(action)\n\n          # Check if the goal is satisfied in the new state.\n          if next_state.satisfies(None, item):\n              return current_path + [action] # Goal reached, return the sequence of actions.\n\n          # Get the hashable representation of the new state.\n          next_state_hashable = _hash_craft_state(next_state)\n\n          # If this state has not been visited before, add it to the queue and visited set.\n          if next_state_hashable not in visited:\n              visited.add(next_state_hashable)\n              queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item cannot be crafted\n  # or acquired from the initial state within the reachable state space.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:27:19.239007", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Define actions (from CraftLab action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper for movement\n    MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n    MOVE_DELTAS = {\n        DOWN: (0, 1),\n        UP: (0, -1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n\n    class _CraftStateProxy:\n        \"\"\"A lightweight proxy for CraftState to simulate actions during planning.\"\"\"\n        def __init__(self, grid, pos, inventory):\n            self.grid = grid\n            self.pos = pos\n            self.inventory = inventory\n        \n        def copy(self):\n            return _CraftStateProxy(self.grid.copy(), self.pos, self.inventory.copy())\n\n    def _bfs_pathfinding(start_pos, target_predicate, grid, world, current_kind_idx_if_target_is_on_cell=None):\n        \"\"\"\n        Finds a path from start_pos to a cell satisfying target_predicate.\n        \n        Args:\n            start_pos: (x, y) tuple, agent's current position.\n            target_predicate: A function (x, y, grid) -> bool, returns True if (x, y) is a target cell.\n            grid: The current grid.\n            world: The CraftWorld instance (to access workshop_indices).\n            current_kind_idx_if_target_is_on_cell: If pathfinding to a cell to stand *on* (e.g., workshop),\n                                                    this is the index of that kind. It allows agent to stand on it.\n                                                    Otherwise, agent avoids cells with items.\n        Returns:\n            A list of actions (integers) to reach the target cell. Empty list if already there or no path.\n        \"\"\"\n        q = collections.deque([(start_pos, [])])\n        visited = {start_pos}\n        grid_width, grid_height, n_kinds = grid.shape\n\n        # Check if starting position already satisfies the predicate\n        if target_predicate(start_pos[0], start_pos[1], grid):\n            return []\n\n        while q:\n            (cx, cy), path = q.popleft()\n\n            for action in MOVE_ACTIONS:\n                dx, dy = MOVE_DELTAS[action]\n                nx, ny = cx + dx, cy + dy\n\n                if not (0 <= nx < grid_width and 0 <= ny < grid_height):\n                    continue # Out of bounds\n\n                if (nx, ny) in visited:\n                    continue # Already visited\n\n                # Check if cell (nx, ny) is passable\n                is_passable = True\n                cell_occupancies = grid[nx, ny, :]\n                \n                # A cell is blocked if it contains any non-workshop item (that's not the specific target to stand on).\n                # Agent can move onto empty cells or cells containing only workshop items.\n                for k_idx in range(n_kinds):\n                    if cell_occupancies[k_idx] > 0:\n                        if k_idx not in world.workshop_indices: # If it's not a workshop\n                            if k_idx != current_kind_idx_if_target_is_on_cell: # And not the target item we are pathing directly ONTO\n                                is_passable = False\n                                break\n                \n                if not is_passable:\n                    continue # Cell is blocked\n\n                visited.add((nx, ny))\n                new_path = path + [action]\n                if target_predicate(nx, ny, grid):\n                    return new_path\n                q.append(((nx, ny), new_path))\n        \n        return [] # No path found\n\n    cookbook = env.world.cookbook\n    initial_state_proxy = _CraftStateProxy(env._current_state.grid.copy(), env._current_state.pos, env._current_state.inventory.copy())\n    \n    def _get_actions_to_satisfy_recursive(target_item_idx, current_state_proxy):\n        \"\"\"\n        Recursively plans actions to obtain a target item, updating the simulated state.\n        Returns (list_of_actions, final_state_proxy).\n        \"\"\"\n\n        # Base Case: Item already in inventory\n        if current_state_proxy.inventory[target_item_idx] > 0:\n            return [], current_state_proxy.copy()\n\n        # Try to find if it's a primitive and can be picked up\n        if target_item_idx in cookbook.primitives:\n            actions = []\n            final_state = current_state_proxy.copy()\n\n            # Predicate for finding a cell *adjacent* to the target primitive\n            def target_adjacent_predicate(x, y, grid_local):\n                # Check if current (x,y) is adjacent to the item (4-directional)\n                for dx, dy in MOVE_DELTAS.values():\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < grid_local.shape[0] and 0 <= ny < grid_local.shape[1]:\n                        if grid_local[nx, ny, target_item_idx] > 0:\n                            return True\n                return False\n\n            path_to_adj = _bfs_pathfinding(final_state.pos, target_adjacent_predicate, final_state.grid, env.world)\n            if path_to_adj:\n                actions.extend(path_to_adj)\n                # Update position for simulation after moves\n                for move_action in path_to_adj:\n                    dx, dy = MOVE_DELTAS[move_action]\n                    final_state.pos = (final_state.pos[0] + dx, final_state.pos[1] + dy)\n                \n                # Now at a position adjacent to the item, USE to pick it up.\n                actions.append(USE)\n                \n                # Simulate pickup: find the item, remove one from grid, add to inventory\n                pickup_successful = False\n                cx, cy = final_state.pos\n                grid_width, grid_height, _ = final_state.grid.shape\n                for dx, dy in MOVE_DELTAS.values(): # Check all 4 adjacent cells for item\n                    adj_x, adj_y = cx + dx, cy + dy\n                    if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n                        if final_state.grid[adj_x, adj_y, target_item_idx] > 0:\n                            final_state.grid[adj_x, adj_y, target_item_idx] -= 1\n                            final_state.inventory[target_item_idx] += 1\n                            pickup_successful = True\n                            break\n                    if pickup_successful: break # Break outer loop too\n                \n                if pickup_successful:\n                    return actions, final_state\n                # If path was found but pickup failed (e.g. item disappeared), return failure\n                return [], current_state_proxy.copy() \n            \n            # If primitive but no path found to pick it up\n            return [], current_state_proxy.copy()\n\n        # Try to craft it\n        if target_item_idx in cookbook.recipes:\n            recipe = cookbook.recipes[target_item_idx]\n            required_ingredients = {idx: count for idx, count in recipe.items() if idx != \"_key\"}\n            workshop_name = recipe.get(\"_key\")\n            workshop_idx = cookbook.index.index(workshop_name) if workshop_name else None\n\n            crafting_actions = []\n            state_after_ingredients = current_state_proxy.copy()\n\n            # Gather ingredients\n            for ing_idx, needed_count in required_ingredients.items():\n                current_has = state_after_ingredients.inventory[ing_idx]\n                for _ in range(needed_count - current_has):\n                    ingredient_actions, state_after_obtain_ingredient = _get_actions_to_satisfy_recursive(ing_idx, state_after_ingredients)\n                    \n                    if not ingredient_actions and state_after_obtain_ingredient.inventory[ing_idx] <= current_has:\n                        # Failed to obtain an ingredient, so this craft path is not viable\n                        return [], current_state_proxy.copy()\n\n                    crafting_actions.extend(ingredient_actions)\n                    state_after_ingredients = state_after_obtain_ingredient # Propagate state changes\n\n            # Move to workshop if required\n            if workshop_idx is not None:\n                # Predicate for finding a cell *containing* the workshop\n                def workshop_cell_predicate(x, y, grid_local):\n                    return grid_local[x, y, workshop_idx] > 0\n\n                path_to_workshop = _bfs_pathfinding(state_after_ingredients.pos, workshop_cell_predicate, state_after_ingredients.grid, env.world, workshop_idx)\n                if path_to_workshop:\n                    crafting_actions.extend(path_to_workshop)\n                    # Update position for simulation after moves\n                    for move_action in path_to_workshop:\n                        dx, dy = MOVE_DELTAS[move_action]\n                        state_after_ingredients.pos = (state_after_ingredients.pos[0] + dx, state_after_ingredients.pos[1] + dy)\n                else:\n                    return [], current_state_proxy.copy() # Cannot reach workshop\n\n            # Perform crafting (USE action)\n            crafting_actions.append(USE)\n            # Simulate consumption of ingredients and production of item\n            for ing_idx, needed_count in required_ingredients.items():\n                state_after_ingredients.inventory[ing_idx] -= needed_count\n            state_after_ingredients.inventory[target_item_idx] += 1\n            \n            return crafting_actions, state_after_ingredients\n\n        # Item cannot be obtained (e.g., environment, non-craftable, not grabbable)\n        return [], current_state_proxy.copy()\n\n    total_actions, final_state_after_plan = _get_actions_to_satisfy_recursive(item, initial_state_proxy)\n    \n    # Verify if goal was achieved in the planned state\n    if final_state_after_plan.inventory[item] > initial_state_proxy.inventory[item]:\n        return total_actions\n    else:\n        return [] # Goal not achievable with this plan", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:27:20.814241", "function_name": "craft", "function_body": "  # Retrieve action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  initial_state = env._current_state\n  max_steps = env.max_steps # Use env's max_steps to limit search depth\n\n  # Queue for BFS: stores (current_state, actions_taken_so_far)\n  # `collections.deque` is assumed to be imported at the file level.\n  q = collections.deque([(initial_state, [])])\n\n  # Set to store visited states for cycle detection\n  # A state is defined by (position, direction, inventory, grid content)\n  # For grid content, we convert the numpy array to bytes for hashing.\n  # `numpy` is assumed to be imported at the file level as `np`.\n  visited_states_hash = set()\n\n  def get_state_key(state):\n      \"\"\"Returns a hashable tuple representing the current CraftState.\"\"\"\n      # pos is already a tuple (int, int)\n      # dir is an int\n      # inventory is np.ndarray, convert to tuple\n      inventory_tuple = tuple(state.inventory.tolist())\n      # grid is np.ndarray, convert to bytes for hashing\n      grid_bytes = state.grid.tobytes()\n      return (state.pos, state.dir, inventory_tuple, grid_bytes)\n\n  # Add initial state to visited set and queue\n  initial_key = get_state_key(initial_state)\n  visited_states_hash.add(initial_key)\n\n  while q:\n      current_state, actions_so_far = q.popleft()\n\n      # Check if the goal is satisfied in the current state\n      # `satisfies` method checks if inventory[item] > 0\n      if current_state.satisfies(None, item):\n          return actions_so_far\n\n      # Prune paths that exceed the maximum allowed steps\n      if len(actions_so_far) >= max_steps:\n          continue\n\n      # Explore all possible actions\n      for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]:\n          # Simulate the action to get the next state\n          # CraftState.step returns (reward, new_state)\n          try:\n              _reward, next_state = current_state.step(action)\n          except Exception: # Catch potential errors from invalid actions (e.g., trying to move out of bounds)\n              continue # Skip this action if it leads to an error\n\n          next_key = get_state_key(next_state)\n\n          # If this new state has not been visited before, add it to the queue\n          if next_key not in visited_states_hash:\n              visited_states_hash.add(next_key)\n              q.append((next_state, actions_so_far + [action]))\n\n  # If the queue becomes empty and the goal was not reached, no solution found\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T14:28:58.401597", "function_name": "craft", "function_body": "  # A state is defined by (grid, position, direction, inventory)\n  # We need to hash numpy arrays, so convert them to bytes.\n  def get_state_hash(state):\n      # Ensure consistent order and type for hashing.\n      # pos is already a tuple, dir is an int.\n      # grid and inventory are numpy arrays, convert to bytes.\n      return (state.grid.tobytes(), state.pos, state.dir, state.inventory.tobytes())\n\n  # Get the initial state from the environment\n  initial_state = env._current_state\n\n  # Check if the item is already crafted in the initial state\n  if initial_state.satisfies(None, item):\n      return [] # Already have it, no actions needed\n\n  # Queue for BFS: stores (state_object, path_to_state_as_action_list)\n  # Using collections.deque for efficient append and popleft operations.\n  # Assumes 'deque' is available in the execution environment (e.g., globally imported).\n  queue = deque([(initial_state, [])])\n\n  # Set to store visited states to avoid cycles and redundant exploration.\n  # Stores hashable representations of states.\n  visited = {get_state_hash(initial_state)}\n\n  # Actions available in CraftWorld (constants from problem description or implied by CraftLab)\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  # These are numerical values expected by CraftState.step(action)\n  ACTIONS = [0, 1, 2, 3, 4] # Corresponds to [DOWN, UP, LEFT, RIGHT, USE]\n\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # Iterate over all possible actions\n      for action in ACTIONS:\n          # Apply the action to get the next state\n          # CraftState.step returns (reward, new_state)\n          _, new_state = current_state.step(action)\n          new_path = current_path + [action]\n\n          # Check if the goal is satisfied in the new state\n          if new_state.satisfies(None, item):\n              return new_path\n\n          # Get hashable representation of the new state\n          new_state_hash = get_state_hash(new_state)\n\n          # If this state has not been visited, add it to the queue and visited set\n          if new_state_hash not in visited:\n              visited.add(new_state_hash)\n              queue.append((new_state, new_path))\n\n  # If the queue becomes empty and the goal is not reached,\n  # it means the item cannot be crafted from the initial state.\n  return []", "island_id": 5, "scores": {"3": -1}}
