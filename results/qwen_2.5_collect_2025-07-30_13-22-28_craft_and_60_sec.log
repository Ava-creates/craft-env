hat each unique state is processed only once, guaranteeing the shortest path\n  # in terms of action count for BFS.\n  visited = {initial_hashable_state}\n\n  # Path reconstruction dictionary: maps a state's hashable_representation -> (parent_hashable_representation, action_taken_to_reach_this_state)\n  # This allows us to reconstruct the sequence of actions from the initial state to the goal state\n  # once the goal is found, without storing the full action list in the queue. This is a memory optimization\n  # compared to craft_v1, which stored the entire path in the queue elements.\n  path_info = {initial_hashable_state: (None, None)} # Initial state has no parent or action leading to it.\n\n  # Limit the search space to prevent excessively long runtimes for complex or unreachable goals.\n  MAX_SEARCH_NODES = 50000 \n  nodes_visited_count = 0\n\n  while q:\n      current_state, current_hashable_state = q.popleft()\n      nodes_visited_count += 1\n\n      # Check if we've exceeded the search limit.\n      if nodes_visited_count > MAX_SEARCH_NODES:\n          # If limit reached, assume goal is unreachable within reasonable bounds and return an empty path.\n          return []\n\n      # Check if the current state satisfies the goal condition.\n      # CraftState.satisfies expects a goal_name (ignored here) and goal_arg (the item index).\n      if current_state.satisfies(None, item):\n          # Goal achieved, reconstruct the sequence of actions by backtracking through path_info.\n          path = []\n          node_hash = current_hashable_state\n          while path_info[node_hash][0] is not None: # Backtrack until we reach the initial state (whose parent is None)\n              parent_hash, action = path_info[node_hash]\n              path.append(action)\n              node_hash = parent_hash\n          return path[::-1] # Reverse the path as it was built backwards from goal to start.\n\n      # Explore all possible actions from the current state.\n      for action in ACTIONS:\n          # Apply the action to get the next CraftState.\n          # CraftState.step returns (reward, new_state). Reward is ignored for pathfinding.\n          _, next_state = current_state.step(action)\n\n          # Create a hashable representation of the next state.\n          next_hashable_state = _get_hashable_state_local(next_state)\n\n          # If this state has not been visited before, add it to the queue and visited set.\n          if next_hashable_state not in visited:\n              visited.add(next_hashable_state)\n              # Record how we reached this new state for path reconstruction.\n              path_info[next_hashable_state] = (current_hashable_state, action)\n              q.append((next_state, next_hashable_state))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted from the initial state within the search limits.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:44:49.509304", "function_name": "craft", "function_body": "    initial_state = env._current_state\n    \n    # If the item is already in the inventory, no actions are needed\n    if initial_state.inventory[item] > 0:\n        return []\n\n    # Queue for Breadth-First Search (BFS): stores tuples of\n    # (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n    queue = collections.deque([(initial_state, [])])\n\n    # Set to keep track of visited states to prevent cycles and redundant exploration.\n    # A state is defined by its grid configuration, agent position, direction, and inventory.\n    # Numpy arrays (grid, inventory) are converted to bytes for hashability.\n    visited = set()\n    \n    def get_state_key(state):\n        # Creates a hashable tuple representation of the current state.\n        return (state.grid.tobytes(), state.pos, state.dir, state.inventory.tobytes())\n\n    # Add the initial state to the visited set\n    initial_state_key = get_state_key(initial_state)\n    visited.add(initial_state_key)\n\n    # Maximum number of steps to explore in the search.\n    # This limits the depth of the BFS to prevent excessively long searches or out-of-memory errors.\n    # 150 steps is a heuristic limit; adjust based on typical CraftWorld task complexity.\n    max_planner_steps = 150\n\n    # Define all possible actions as integers (standard for CraftWorld)\n    # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n    ACTIONS = [0, 1, 2, 3, 4] \n\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # If the current path length exceeds the maximum allowed planning steps,\n        # prune this branch as it's too long or unlikely to be an efficient solution.\n        if len(current_path) >= max_planner_steps:\n            continue\n\n        # Iterate over all possible actions from the current state\n        for action in ACTIONS:\n            # Apply the action to the current state to get the new state.\n            # CraftState.step returns (reward, new_CraftState_instance).\n            # We are primarily interested in the new_CraftState_instance.\n            _reward, new_state = current_state.step(action)\n            \n            # Check if the goal is satisfied in the new state (i.e., the target item is in inventory)\n            if new_state.inventory[item] > 0:\n                # If the goal is met, return the sequence of actions that led to this state.\n                return current_path + [action]\n\n            # Generate the hashable key for the new state to check if it has been visited.\n            new_state_key = get_state_key(new_state)\n\n            # If this new state has not been visited before, add it to the queue for future exploration\n            # and to the visited set to mark it as explored.\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                queue.append((new_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal was never reached, it means no path\n    # was found within the defined search limits.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:44:49.531821", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on CraftLab's action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n    # Use a deque for efficient breadth-first search (BFS)\n    q = collections.deque()\n\n    # Visited set to store unique representations of states\n    # A state is defined by its grid, position, direction, and inventory.\n    # Using .tobytes() for numpy arrays makes them hashable for set membership.\n    visited = set()\n\n    # Get the initial state from the CraftLab environment.\n    # The `_current_state` attribute holds the current CraftState object.\n    initial_state = env._current_state\n\n    # If the item is already crafted in the initial state, no actions are needed.\n    if initial_state.satisfies(None, item):  # goal_name is ignored for CraftState.satisfies\n        return []\n\n    # Prepare the initial state for the BFS queue.\n    # Each element in the queue is (CraftState object, list of actions to reach this state).\n    initial_state_repr = (initial_state.grid.tobytes(), initial_state.pos,\n                          initial_state.dir, initial_state.inventory.tobytes())\n    \n    q.append((initial_state, []))\n    visited.add(initial_state_repr)\n\n    # Set a maximum search depth to prevent excessively long searches\n    # and to handle cases where no path exists within reasonable steps.\n    # Use env.max_steps if available, otherwise a default practical limit.\n    max_search_depth = env.max_steps if hasattr(env, 'max_steps') and env.max_steps is not None else 100\n\n    while q:\n        current_state, current_path = q.popleft()\n\n        # If the current path length exceeds the maximum search depth, prune this branch.\n        if len(current_path) >= max_search_depth:\n            continue\n\n        # Explore all possible actions from the current state\n        for action in ACTIONS:\n            # Apply the action to get the next state.\n            # CraftState.step() returns a new CraftState object, not modifying the current_state.\n            _, new_state = current_state.step(action)\n\n            # Generate the unique representation for the new state.\n            new_state_repr = (new_state.grid.tobytes(), new_state.pos,\n                              new_state.dir, new_state.inventory.tobytes())\n\n            # If this state has not been visited before, process it.\n            if new_state_repr not in visited:\n                new_path = current_path + [action]\n\n                # Check if the new state satisfies the goal (item is crafted).\n                if new_state.satisfies(None, item):\n                    return new_path  # Goal reached, return the sequence of actions\n\n                # Mark the new state as visited and add it to the queue for further exploration.\n                visited.add(new_state_repr)\n                q.append((new_state, new_path))\n\n    # If the queue becomes empty and the goal was not reached, it means no path\n    # exists within the search limits.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:46:40.003944", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming they are globally defined or implicitly known,\n  # but defined here for self-containment consistent with craft_v1)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  _MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  # This hash includes the grid and inventory as they can change and define the state.\n  def _hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # A Breadth-First Search (BFS) helper function specifically for movement.\n  # It finds a sequence of movement actions from a start state to a state\n  # where the agent is next to a specified kind of entity, respecting a global step limit.\n  def _bfs_move_to_kind(start_s, target_kind_idx, current_plan_len, max_total_steps):\n      \"\"\"\n      Performs a BFS using only movement actions to find a path to a state\n      where the agent is next to the target_kind_idx.\n      The search considers the total plan length against `max_total_steps`.\n\n      Args:\n          start_s (CraftState): The starting state for this BFS.\n          target_kind_idx (int): The index of the entity kind to move next to.\n          current_plan_len (int): The length of the plan that led to `start_s`.\n          max_total_steps (int): The maximum allowed total steps for the entire crafting plan.\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found within limits,\n                 else (None, None).\n      \"\"\"\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)}\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal: being next to the target kind\n          if curr_s.next_to(target_kind_idx):\n              return curr_p, curr_s\n\n          # Prune if the current path length plus existing plan length and a future USE action\n          # would exceed the maximum total steps.\n          if current_plan_len + len(curr_p) + 1 >= max_total_steps:\n              continue\n\n          # Explore only movement actions\n          for action in _MOVE_ACTIONS:\n              # Rewards are ignored as per problem spec, step returns (reward, new_state)\n              _, next_s = curr_s.step(action)\n              next_hash = _hash_craft_state(next_s)\n\n              # Add to queue only if the new state is unique and not previously visited\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      return None, None  # No path found within the allowed budget\n\n  # Memoization dictionary to store results of _plan_craft_recursive.\n  # The key includes the state hash, target item, and current plan length,\n  # to correctly handle step budget constraints.\n  memo = {}\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n  max_total_steps = env.max_steps # Use the environment's max_steps as a hard limit\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down crafting into sub-goals (gathering ingredients, moving to workshops).\n  # It tracks and respects the overall step budget.\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx, current_plan_len):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n          current_plan_len (int): The length of the plan accumulated *before* this recursive call.\n\n      Returns:\n          tuple: (list of actions, final_state, new_plan_length) required to craft the item,\n                 or (None, None, None) if impossible or exceeds step budget.\n      \"\"\"\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx, current_plan_len) # current_plan_len included for budget-aware memoization\n      \n      if memo_key in memo:\n          return memo[memo_key]\n\n      # Base Case 1: Item is already in inventory\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          memo[memo_key] = ([], current_state_for_goal, current_plan_len)\n          return [], current_state_for_goal, current_plan_len\n\n      # Prune early if the current accumulated plan length already exceeds the total budget.\n      if current_plan_len >= max_total_steps:\n          memo[memo_key] = (None, None, None)\n          return None, None, None\n\n      current_state_after_actions = current_state_for_goal # State to be updated through planning\n      actions_for_this_goal = [] # Actions accumulated for this specific crafting goal\n      new_plan_length = current_plan_len # Start tracking new length from current_plan_len\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          # Step A: Move next to the primitive\n          path_to_primitive, state_at_primitive = _bfs_move_to_kind(\n              current_state_after_actions, target_item_idx, new_plan_length, max_total_steps\n          )\n          \n          if path_to_primitive is None:\n              memo[memo_key] = (None, None, None)  # Cache failure\n              return None, None, None\n          \n          actions_for_this_goal.extend(path_to_primitive)\n          new_plan_length += len(path_to_primitive)\n          current_state_after_actions = state_at_primitive\n\n          # Check budget again after movement actions, before adding USE.\n          if new_plan_length + 1 >= max_total_steps: # +1 for the USE action\n              memo[memo_key] = (None, None, None)\n              return None, None, None\n\n          # Step B: Perform the USE action to gather the primitive\n          current_count_before_use = current_state_after_actions.inventory[target_item_idx]\n          _, state_after_use = current_state_after_actions.step(USE)\n\n          # Verify that the USE action successfully obtained the primitive\n          if state_after_use.inventory[target_item_idx] > current_count_before_use:\n              actions_for_this_goal.append(USE) # Add the USE action to the plan\n              new_plan_length += 1\n              memo[memo_key] = (actions_for_this_goal, state_after_use, new_plan_length) # Cache success\n              return actions_for_this_goal, state_after_use, new_plan_length\n          else:\n              # USE action did not result in obtaining the primitive (e.g., failed pickup)\n              memo[memo_key] = (None, None, None) # Cache failure\n              return None, None, None\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          memo[memo_key] = (None, None, None)\n          return None, None, None\n      \n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      # Step A: Gather all required ingredients\n      # The order of processing ingredients here is based on dictionary iteration order.\n      # For optimization, one might reorder ingredients based on proximity or cost.\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_actions.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient\n              actions_for_one_ing, next_state_after_ingredient, updated_len = _plan_craft_recursive(\n                  current_state_after_actions, ingredient_idx, new_plan_length)\n              \n              if actions_for_one_ing is None:\n                  memo[memo_key] = (None, None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              new_plan_length = updated_len # The new total length after this ingredient is obtained\n              current_state_after_actions = next_state_after_ingredient\n\n              # Check total plan length after each ingredient is gathered.\n              if new_plan_length >= max_total_steps:\n                  memo[memo_key] = (None, None, None)\n                  return None, None, None\n\n      # Step B: Move to workshop if required\n      if workshop_needed is not None:\n          path_to_workshop, state_at_workshop = _bfs_move_to_kind(\n              current_state_after_actions, workshop_needed, new_plan_length, max_total_steps\n          )\n          \n          if path_to_workshop is None:\n              memo[memo_key] = (None, None, None) # Cannot reach workshop, so this craft fails\n              return None, None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          new_plan_length += len(path_to_workshop)\n          current_state_after_actions = state_at_workshop\n\n          # Check budget again after movement actions, before adding USE.\n          if new_plan_length + 1 >= max_total_steps: # +1 for the USE action\n              memo[memo_key] = (None, None, None)\n              return None, None, None\n\n      # Step C: Perform the USE action to craft the item\n      current_inv_of_target = current_state_after_actions.inventory[target_item_idx]\n      _, final_state_after_craft = current_state_after_actions.step(USE)\n\n      # Check if crafting was successful (inventory of target item increased)\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target:\n          actions_for_this_goal.append(USE) # Add the USE action to the plan\n          new_plan_length += 1\n          memo[memo_key] = (actions_for_this_goal, final_state_after_craft, new_plan_length)\n          return actions_for_this_goal, final_state_after_craft, new_plan_length\n      else:\n          # Crafting failed (e.g., insufficient ingredients despite prior steps, wrong workshop, or unexpected condition)\n          memo[memo_key] = (None, None, None)\n          return None, None, None\n\n  # Start the planning process for the top-level goal item from the initial state\n  # with a starting plan length of 0.\n  final_plan_actions, _, _ = _plan_craft_recursive(initial_state, item, 0)\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path exceeds max_total_steps", "island_id": 3, "scores": {"3": 0.0}}
