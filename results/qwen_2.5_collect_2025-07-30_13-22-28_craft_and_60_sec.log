{"timestamp": "2025-07-30T15:00:13.467344", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n  import env_factory # Assuming env_factory is available based on the context.\n\n  # Action constants from env_factory for clarity.\n  ACTION_DOWN = env_factory.ACTION_DOWN\n  ACTION_UP = env_factory.ACTION_UP\n  ACTION_LEFT = env_factory.ACTION_LEFT\n  ACTION_RIGHT = env_factory.ACTION_RIGHT\n  ACTION_USE = env_factory.ACTION_USE\n\n  start_state = env._current_state # Get the initial CraftState object from the CraftLab environment.\n\n  # Helper function to convert a CraftState object into a hashable tuple.\n  # This tuple uniquely identifies a state and is used for the 'visited' set and 'parent_map'.\n  # NumPy arrays (grid, inventory) are converted to bytes to make them hashable.\n  def state_to_tuple(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  q = collections.deque()\n  start_state_tuple = state_to_tuple(start_state)\n  \n  # The queue stores CraftState objects to explore. We add the initial state.\n  q.append(start_state) \n  \n  # The 'visited' set keeps track of unique state_tuples that have already been\n  # added to the queue or explored. This prevents redundant processing and infinite loops.\n  visited = {start_state_tuple}\n\n  # The 'parent_map' stores the path information. It maps a 'current_state_tuple'\n  # to a tuple: (action_taken_to_reach_current_state, previous_state_tuple).\n  # This allows for efficient reconstruction of the shortest path by backtracking.\n  parent_map = {start_state_tuple: (None, None)} # The start state has no preceding action or state.\n\n  # List of all possible actions the agent can take.\n  actions_list = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # This variable will store the hashable tuple of the state where the goal is finally satisfied.\n  goal_reached_state_tuple = None\n\n  # Maximum number of states to visit during the BFS. \n  # This is a critical parameter to prevent the search from running indefinitely\n  # in very complex or potentially unsolvable scenarios, thus preventing memory exhaustion\n  # and excessively long computation times. This value may need tuning based on problem scale.\n  MAX_VISITED_STATES = 200000 \n\n  while q:\n      current_state = q.popleft() # Get the current CraftState object from the front of the queue.\n      current_state_tuple = state_to_tuple(current_state)\n\n      # Check if the current state satisfies the crafting goal.\n      if current_state.satisfies(None, item):\n          goal_reached_state_tuple = current_state_tuple\n          break # Goal achieved, exit the BFS loop as the shortest path is found.\n\n      # Heuristic/Optimization: If too many unique states have been visited, terminate the search.\n      # This acts as a safeguard against state space explosion.\n      if len(visited) > MAX_VISITED_STATES:\n          # print(f\"Warning: Max visited states ({MAX_VISITED_STATES}) reached. Goal might not be found.\")\n          return [] # Return an empty list, indicating no path found within the defined limits.\n\n      # Explore all possible actions from the current state.\n      for action in actions_list:\n          # Simulate taking the action to get the next state.\n          # CraftState.step returns a new CraftState object, which is crucial for BFS\n          # as it preserves the immutability of previously visited states.\n          # The reward (first return value) is ignored as this is a uniform-cost pathfinding problem.\n          _, next_state = current_state.step(action)\n          next_state_tuple = state_to_tuple(next_state)\n\n          # If this next state has not been visited before:\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple) # Mark the new state tuple as visited.\n              \n              # Record how we reached this new state: store the action taken and the previous state tuple.\n              parent_map[next_state_tuple] = (action, current_state_tuple)\n              \n              # Add the new CraftState object to the queue for further exploration.\n              q.append(next_state)\n\n  # --- Path Reconstruction ---\n  # If the goal state was not found after exhausting the queue or hitting the limit:\n  if goal_reached_state_tuple is None:\n      return [] # No path found that leads to the desired item.\n\n  # Backtrack from the goal state using the parent_map to reconstruct the sequence of actions.\n  path = []\n  current = goal_reached_state_tuple\n  \n  # Traverse backward from the goal state until the start state is reached\n  # (the start state's parent_map entry has `None` for the action).\n  while parent_map[current][0] is not None: \n      action, prev_state = parent_map[current]\n      path.append(action) # Add the action that led to the 'current' state.\n      current = prev_state # Move to the previous state in the path.\n  \n  # The path is built in reverse order (from goal to start). Reverse it to get the correct order (start to goal).\n  return path[::-1]", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:01:21.407695", "function_name": "craft", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:01:21.424999", "function_name": "craft", "function_body": "    # Helper function to generate a hashable state representation for the visited set.\n    # This is crucial for avoiding cycles and redundant computations in BFS.\n    def _hash_state(state):\n        \"\"\"Generates a hashable tuple from a CraftState.\n        \n        The grid (numpy.ndarray) is converted to bytes for hashing.\n        The inventory (numpy.ndarray) is converted to a tuple.\n        Position (tuple) and direction (int) are already hashable.\n        \"\"\"\n        # grid.tobytes() provides a compact and efficient hashable representation of the grid.\n        grid_hash = state.grid.tobytes()\n        # Inventory values are converted to a tuple to make it hashable.\n        inventory_hash = tuple(state.inventory)\n        return (grid_hash, state.pos, state.dir, inventory_hash)\n\n    # Get the initial state of the environment. The `env` object is a CraftLab instance.\n    initial_craft_state = env._current_state\n    # The `item` argument is the integer index of the desired item to craft.\n    goal_item_idx = item\n\n    # Optimization: If the goal item is already in the inventory at the start, no actions are needed.\n    if initial_craft_state.inventory[goal_item_idx] > 0:\n        return []\n\n    # Initialize a deque (double-ended queue) for Breadth-First Search (BFS).\n    # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state).\n    queue = collections.deque([(initial_craft_state, [])])\n\n    # Initialize a set to keep track of visited states.\n    # Storing hashable representations of states prevents revisiting the same state,\n    # which is essential for efficiency and correctness in BFS.\n    visited = set()\n    visited.add(_hash_state(initial_craft_state))\n\n    # Define the possible actions. These integers correspond to the action IDs\n    # as defined in CraftLab's `action_specs`: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4.\n    ACTIONS = [0, 1, 2, 3, 4]\n\n    # Set a maximum search depth. This acts as a safeguard to prevent excessively long searches\n    # and to manage computational resources, especially if a path doesn't exist or is very long.\n    # A value of 100 is a heuristic limit; a more sophisticated solution might use `env.max_steps`.\n    MAX_SEARCH_DEPTH = 100\n\n    # Start the BFS exploration.\n    while queue:\n        current_state, path = queue.popleft()\n\n        # If the current path length has exceeded the maximum allowed depth,\n        # prune this branch to avoid exploring very long or potentially infinite paths.\n        if len(path) >= MAX_SEARCH_DEPTH:\n            continue\n\n        # Explore all possible actions from the current state.\n        for action in ACTIONS:\n            # Simulate taking the action using the CraftState's `step` method.\n            # `step` returns (reward, new_state). In this Craft implementation, reward is always 0.0.\n            _, next_state = current_state.step(action)\n\n            # Generate the hashable representation of the new state.\n            next_state_hash = _hash_state(next_state)\n\n            # If this `next_state` has not been visited before, proceed.\n            if next_state_hash not in visited:\n                # Check if the goal (desired item in inventory) is satisfied in this new state.\n                # If it is, we've found the shortest path because BFS explores layer by layer.\n                if next_state.inventory[goal_item_idx] > 0:\n                    # Return the path that includes the current action to reach the goal state.\n                    return path + [action]\n\n                # Mark the `next_state` as visited and add it to the queue for further exploration.\n                visited.add(next_state_hash)\n                queue.append((next_state, path + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means no path\n    # was found within the specified `MAX_SEARCH_DEPTH`.\n    return []  # Return an empty list to indicate that no solution was found.", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:03:53.997887", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants\n  # These are the integer values for actions as specified by CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  initial_craft_state = env._current_state\n  goal_item_idx = item\n\n  # 1. Check if the goal item is already in the inventory\n  if initial_craft_state.satisfies(None, goal_item_idx):\n    return []\n\n  # Queue for BFS: stores tuples of (CraftState_instance, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Visited set: stores hashable representations of states to avoid cycles and redundant exploration.\n  # A state is defined by (agent_position, agent_direction, inventory_contents_bytes, grid_contents_bytes).\n  # Using .tobytes() for numpy arrays makes them hashable.\n  visited = set()\n\n  # Limit search depth to prevent excessively long plans and manage computational cost.\n  # We use env.max_steps as a reasonable upper bound for path length.\n  # This prevents infinite loops in cyclic environments and bounds computation.\n  max_search_depth = env.max_steps\n\n  while queue:\n    current_state, current_path = queue.popleft()\n\n    # Pruning: If the current path length equals or exceeds the maximum allowed depth,\n    # we stop exploring from this state to stay within reasonable bounds.\n    if len(current_path) >= max_search_depth:\n      continue\n\n    # Create a hashable key for the current state to check against the visited set.\n    # The `tobytes()` method provides a compact, hashable representation of numpy arrays.\n    state_key = (current_state.pos,\n                 current_state.dir,\n                 current_state.inventory.tobytes(),\n                 current_state.grid.tobytes())\n\n    # If this exact state has already been visited (and thus processed) with an\n    # equal or shorter path (guaranteed by BFS), skip it to avoid redundant work.\n    if state_key in visited:\n      continue\n\n    # Mark the current state as visited.\n    visited.add(state_key)\n\n    # Explore all possible actions from the current state\n    for action in ACTIONS:\n      # Apply the action to get the next state.\n      # CraftState.step returns (reward, new_state). Reward is typically 0.0 in this model,\n      # but the new_state is crucial for planning.\n      _reward, next_state = current_state.step(action)\n      new_path = current_path + [action]\n\n      # Check if the goal item is obtained in the new state.\n      if next_state.satisfies(None, goal_item_idx):\n        return new_path  # Goal reached, return the sequence of actions\n\n      # Add the new state and its path to the queue for further exploration.\n      queue.append((next_state, new_path))\n\n  # If the queue becomes empty and the goal was not reached, no path was found\n  # within the specified max_search_depth.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:05:17.268698", "function_name": "craft", "function_body": "  import collections\n\n  initial_state = env._current_state\n\n  # Check if the item is already crafted in the initial state\n  if initial_state.satisfies(None, item):\n      return []\n\n  # Queue for BFS: stores (current_state, path_to_current_state)\n  queue = collections.deque()\n  queue.append((initial_state, []))\n\n  # Visited set: stores hashable representation of states to avoid cycles and redundant work\n  # State key: (agent_position, agent_direction, tuple(inventory_array), grid_bytes)\n  # Using grid.tobytes() to hash the grid array, as grid changes affect state.\n  visited = set()\n  initial_state_key = (initial_state.pos, initial_state.dir, tuple(initial_state.inventory), initial_state.grid.tobytes())\n  visited.add(initial_state_key)\n\n  # Maximum number of actions to attempt for a path.\n  # This prevents infinite loops in very large or cyclic state spaces and limits search time.\n  # The value is a heuristic and might need tuning based on typical problem complexity.\n  MAX_DEPTH = 100\n\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # If the current state satisfies the goal, we found a path\n      if current_state.satisfies(None, item):\n          return current_path\n\n      # Prune if the path length exceeds the maximum allowed depth\n      if len(current_path) >= MAX_DEPTH:\n          continue\n\n      # Explore all possible actions from the current state\n      # env.world.n_actions gives the total number of actions (e.g., 5 for move + use)\n      for action in range(env.world.n_actions):\n          # Simulate the action: CraftState.step returns (reward, new_state)\n          # The new_state is a new CraftState instance with updated grid, pos, dir, inventory\n          _, next_state = current_state.step(action)\n\n          # Create a hashable key for the next state\n          next_state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory), next_state.grid.tobytes())\n\n          # If this state has not been visited before, add it to the queue and visited set\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, no path was found\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:07:07.452118", "function_name": "craft", "function_body": "    # Access necessary components from the environment\n    initial_state = env._current_state\n    cookbook = env.world.cookbook\n    recipes = cookbook.recipes\n    world = env.world # Contains grabbable_indices, workshop_indices etc.\n\n    # Initialize hypothetical planning state\n    # This numpy array will track item counts during planning.\n    # It will be modified by recursive calls to simulate inventory changes.\n    simulated_inventory = initial_state.inventory.copy()\n    # Agent's current position during planning.\n    simulated_pos = initial_state.pos\n\n    # List to accumulate all planned actions.\n    all_planned_actions = []\n\n    # Map action constants to (dx, dy) for pathfinding.\n    # Assuming these constants are available from env_factory.\n    action_deltas = {\n        env_factory.RIGHT: (1, 0),\n        env_factory.LEFT: (-1, 0),\n        env_factory.UP: (0, -1),\n        env_factory.DOWN: (0, 1),\n    }\n\n    # Recursive planning function.\n    # It attempts to gather/craft 'target_item_idx'.\n    # Returns True on success, False on failure.\n    # Modifies 'simulated_inventory', 'simulated_pos', and 'all_planned_actions' as side effects.\n    def _plan_item_acquisition_recursive(target_item_idx):\n        nonlocal simulated_inventory, simulated_pos, all_planned_actions\n\n        # Base case: Item already in (simulated) inventory.\n        if simulated_inventory[target_item_idx] > 0:\n            return True\n\n        # Check if it's a primitive (no recipe in the cookbook).\n        if target_item_idx in cookbook.primitives:\n            # Find the primitive on the initial grid (it's static).\n            target_coords = None\n            for x in range(env_factory.WIDTH):\n                for y in range(env_factory.HEIGHT):\n                    if initial_state.grid[x, y, target_item_idx] > 0:\n                        target_coords = (x, y)\n                        break\n                if target_coords: break\n\n            if not target_coords:\n                # Primitive not found on the map.\n                return False\n\n            # --- Pathfinding (BFS) from current simulated_pos to target_coords ---\n            q = [(simulated_pos, [])] # (current_pos, path_actions)\n            visited = {simulated_pos}\n            path_to_target = None\n            \n            # For grabbable items (primitives), the agent needs to reach the same cell.\n            target_reachable_cells = {target_coords}\n\n            while q:\n                (curr_x, curr_y), path = q.pop(0)\n\n                if (curr_x, curr_y) in target_reachable_cells:\n                    path_to_target = path\n                    break\n\n                # Heuristic to prevent excessively long searches for unreachables.\n                # A path cannot be longer than the total number of cells.\n                if len(path) > env_factory.WIDTH * env_factory.HEIGHT:\n                    continue\n\n                for action_dir, (dx, dy) in action_deltas.items():\n                    nx, ny = curr_x + dx, curr_y + dy\n                    if 0 <= nx < env_factory.WIDTH and 0 <= ny < env_factory.HEIGHT and (nx, ny) not in visited:\n                        # Assuming all grid cells are traversable for simplicity.\n                        visited.add((nx, ny))\n                        q.append(((nx, ny), path + [action_dir]))\n            # --- End Pathfinding ---\n\n            if path_to_target is None:\n                return False # Cannot reach the primitive.\n\n            all_planned_actions.extend(path_to_target)\n            all_planned_actions.append(env_factory.USE) # Use to pick up.\n\n            # Update simulated state.\n            simulated_inventory[target_item_idx] += 1\n            simulated_pos = target_coords # After path, agent is at target_coords.\n\n            return True\n\n        # If not a primitive, try to craft it.\n        else:\n            recipe = recipes.get(target_item_idx)\n            if not recipe:\n                return False # Not a primitive and no recipe (uncraftable).\n\n            # Gather ingredients recursively.\n            ingredients_to_get = []\n            for ing_idx, ing_count in recipe.items():\n                if ing_idx == \"_key\": continue # \"_key\" is a special identifier in recipes.\n                \n                # Calculate how many more of this ingredient are needed.\n                needed_count = ing_count - simulated_inventory[ing_idx]\n                for _ in range(needed_count):\n                    ingredients_to_get.append(ing_idx)\n\n            for ing_idx in ingredients_to_get:\n                if not _plan_item_acquisition_recursive(ing_idx):\n                    return False # Failed to get an ingredient.\n\n            # After all ingredients are (hypothetically) gathered, craft the item.\n            # Find a workshop on the initial grid.\n            workshop_coords = None\n            if not world.workshop_indices:\n                return False # No workshop available in the world.\n            \n            # Find the first workshop location (assuming any workshop can be used).\n            for ws_idx in world.workshop_indices:\n                for x in range(env_factory.WIDTH):\n                    for y in range(env_factory.HEIGHT):\n                        if initial_state.grid[x, y, ws_idx] > 0:\n                            workshop_coords = (x, y)\n                            break\n                    if workshop_coords: break\n                if workshop_coords: break # Found a workshop.\n\n            if not workshop_coords:\n                return False # Workshop not found on grid.\n\n            # --- Pathfinding (BFS) from current simulated_pos to an adjacent cell of the workshop ---\n            q = [(simulated_pos, [])]\n            visited = {simulated_pos}\n            path_to_workshop_adj = None\n            \n            # Need to reach any of the four cells adjacent to the workshop.\n            workshop_adjacent_cells = set()\n            wx, wy = workshop_coords\n            for dx, dy in action_deltas.values(): # Check all 4 adjacent cells.\n                nx, ny = wx + dx, wy + dy\n                if 0 <= nx < env_factory.WIDTH and 0 <= ny < env_factory.HEIGHT:\n                    workshop_adjacent_cells.add((nx, ny))\n            \n            while q:\n                (curr_x, curr_y), path = q.pop(0)\n\n                if (curr_x, curr_y) in workshop_adjacent_cells:\n                    path_to_workshop_adj = path\n                    break\n                \n                if len(path) > env_factory.WIDTH * env_factory.HEIGHT:\n                    continue\n\n                for action_dir, (dx, dy) in action_deltas.items():\n                    nx, ny = curr_x + dx, curr_y + dy\n                    if 0 <= nx < env_factory.WIDTH and 0 <= ny < env_factory.HEIGHT and (nx, ny) not in visited:\n                        visited.add((nx, ny))\n                        q.append(((nx, ny), path + [action_dir]))\n            # --- End Pathfinding ---\n\n            if path_to_workshop_adj is None:\n                return False # Cannot reach workshop.\n\n            all_planned_actions.extend(path_to_workshop_adj)\n            all_planned_actions.append(env_factory.USE) # Use action to craft.\n\n            # Update simulated state.\n            simulated_inventory[target_item_idx] += 1 # Gain the crafted item.\n            for ing_idx, ing_count in recipe.items():\n                if ing_idx == \"_key\": continue\n                simulated_inventory[ing_idx] -= ing_count # Consume ingredients.\n\n            # Agent's position after moving to workshop.\n            # It's the last position in the path taken to reach an adjacent cell.\n            simulated_pos = path_to_workshop_adj[-1] if path_to_workshop_adj else simulated_pos\n\n            return True\n\n    # Start the planning process for the desired item.\n    plan_success = _plan_item_acquisition_recursive(item)\n\n    # Return the accumulated actions if planning was successful and the item is now in inventory.\n    if plan_success and simulated_inventory[item] > 0:\n        return all_planned_actions\n    else:\n        return [] # Return an empty list if crafting is not possible or failed.", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:08:36.363395", "function_name": "craft", "function_body": "  import collections\n\n  # Define actions based on CraftLab.action_specs\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTIONS = [0, 1, 2, 3, 4] \n\n  # Get the initial CraftState from the CraftLab environment\n  # The `_current_state` attribute of CraftLab holds the current CraftState.\n  initial_craft_state = env._current_state\n  \n  # Early exit: If the item is already in the inventory in the initial state,\n  # no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Helper function to create a hashable key for a CraftState.\n  # This is crucial for efficiently checking visited states in the BFS,\n  # preventing redundant computations and infinite loops.\n  def get_state_key(state):\n      # A unique state is defined by the agent's position, direction,\n      # current inventory, and the complete grid content.\n      \n      # Convert the numpy array `inventory` to a hashable tuple.\n      inventory_tuple = tuple(state.inventory.tolist())\n      \n      # Convert the 3D numpy array `grid` to a hashable tuple.\n      # This is done by flattening the array and then converting it to a tuple.\n      # This is the most computationally expensive part for large grids,\n      # but necessary for correctness as the grid can change (e.g., when picking up items).\n      grid_tuple = tuple(state.grid.flatten().tolist())\n      \n      # Combine all components into a single hashable tuple.\n      return (state.pos, state.dir, inventory_tuple, grid_tuple)\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Initialize the set of visited states.\n  # This set stores the hashable keys generated by `get_state_key` to track explored states.\n  visited = {get_state_key(initial_craft_state)}\n\n  # Set a maximum search depth/number of steps to prevent the search from running indefinitely\n  # or consuming excessive resources for very complex or unreachable goals.\n  # This value may need tuning based on the typical complexity of tasks in the CraftWorld.\n  MAX_SEARCH_STEPS = 200 # A common heuristic limit for grid-based planning tasks.\n\n  # Start the BFS loop\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Check if the goal (the target `item` is in the inventory) is satisfied in the current state.\n      if current_state.satisfies(None, item):\n          return actions_taken # Goal reached, return the sequence of actions.\n\n      # Pruning: If the current path is too long (exceeds MAX_SEARCH_STEPS),\n      # stop exploring this branch to save computation.\n      if len(actions_taken) >= MAX_SEARCH_STEPS:\n          continue\n\n      # Explore all possible actions from the current state\n      for action in ACTIONS:\n          # Simulate the action. The `CraftState.step()` method is expected to return\n          # a *new* CraftState instance representing the state after the action,\n          # without modifying the `current_state` object.\n          # The reward is ignored in this planning context as we only care about reachability.\n          _, next_state = current_state.step(action)\n          \n          # Get the hashable key for the new state.\n          next_state_key = get_state_key(next_state)\n\n          # If this new state has not been visited before, add it to the queue\n          # and mark it as visited to avoid cycles and redundant exploration.\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              # Append the new state object and the updated list of actions to the queue.\n              queue.append((next_state, actions_taken + [action]))\n              \n  # If the queue becomes empty and the goal was not reached,\n  # it means no path was found within the defined search limits.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:09:35.459192", "function_name": "craft", "function_body": "  # The top of the file already has 'import numpy as np', so np is available.\n  # 'collections' is a standard library module and should also be available globally if this is part of a larger script.\n  # No explicit imports inside the function as per instructions.\n\n  # The 'item' argument is the integer index of the desired item.\n  goal_idx = item\n\n  initial_state = env._current_state\n\n  # If the goal is already satisfied in the initial state, no actions are needed.\n  if initial_state.satisfies(goal_name=None, goal_arg=goal_idx):\n    return []\n\n  # Queue for Breadth-First Search (BFS).\n  # Each element is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n  # Assuming 'collections' module is available in the global scope.\n  queue = collections.deque([(initial_state, [])])\n\n  # Set to keep track of visited states to prevent cycles and redundant computation.\n  # A state is uniquely identified by its grid, inventory, agent position, and agent direction.\n  # numpy arrays (grid, inventory) are not hashable, so convert them to bytes.\n  visited = set()\n  initial_state_hash = (\n      initial_state.grid.tobytes(),\n      initial_state.inventory.tobytes(),\n      initial_state.pos,\n      initial_state.dir\n  )\n  visited.add(initial_state_hash)\n\n  # Maximum number of actions to allow in a plan. This helps to prevent excessively long searches\n  # and ensures the planner terminates even if the item is uncraftable or requires too many steps.\n  MAX_PLANNER_DEPTH = 100 # This value might need tuning based on typical recipe complexity.\n\n  # The number of possible actions (DOWN, UP, LEFT, RIGHT, USE)\n  num_actions = env.n_actions # Expected to be 5 (0-4)\n\n  while queue:\n    current_state, current_path = queue.popleft()\n\n    # If the current path length exceeds the maximum allowed depth, skip this path.\n    # This prevents exploring paths that are too long or potentially infinite loops in a very complex or cyclic environment.\n    if len(current_path) >= MAX_PLANNER_DEPTH:\n      continue\n\n    # Iterate over all possible actions (0 to num_actions-1).\n    for action in range(num_actions):\n      # Simulate the action to get the next state.\n      # CraftState.step returns a new CraftState object, crucial for BFS as it doesn't modify current_state.\n      # The reward is not needed for this pathfinding algorithm.\n      _, next_state = current_state.step(action)\n\n      # Create a hashable representation of the next state for the 'visited' set.\n      next_state_hash = (\n          next_state.grid.tobytes(),\n          next_state.inventory.tobytes(),\n          next_state.pos,\n          next_state.dir\n      )\n\n      # If this state has not been visited before, add it to our search.\n      if next_state_hash not in visited:\n        visited.add(next_state_hash) # Mark as visited.\n        new_path = current_path + [action] # Extend the path.\n\n        # Check if the goal (desired item in inventory) is satisfied in this new state.\n        if next_state.satisfies(goal_name=None, goal_arg=goal_idx):\n          return new_path # Goal reached, return the sequence of actions.\n\n        # Add the new state and its corresponding path to the queue for further exploration.\n        queue.append((next_state, new_path))\n\n  # If the loop finishes and the queue is empty, it means no path was found\n  # to craft the item within the given depth limit.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:09:35.476093", "function_name": "craft", "function_body": "    start_state = env._current_state\n    \n    # Queue for BFS: stores tuples of (current_state_object, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(start_state, [])])\n    \n    # Set to store visited states to avoid redundant computations and infinite loops.\n    # A state is uniquely identified by its grid, inventory, position, and direction.\n    visited_states = set()\n    \n    # Helper function to create a hashable key for a CraftState object.\n    # numpy arrays are converted to bytes for efficient hashing in the set.\n    def _get_state_key(state):\n        return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n    # Add the initial state to the set of visited states.\n    visited_states.add(_get_state_key(start_state))\n\n    # Define all possible actions as per CraftLab.action_specs()\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    all_actions = [0, 1, 2, 3, 4]\n\n    # Maximum path length (number of actions) to explore. This limit helps prevent\n    # excessive memory usage and computation time for very complex or unachievable goals.\n    max_search_depth = 150 \n\n    while queue:\n        current_state, path = queue.popleft()\n\n        # Check if the goal item is present in the current state's inventory.\n        # CraftState.satisfies expects goal_name (which is ignored here) and the item index.\n        if current_state.satisfies(None, item):\n            return path # Goal reached, return the sequence of actions.\n        \n        # If the current path length exceeds the maximum allowed depth,\n        # stop exploring this branch to keep the search manageable.\n        if len(path) >= max_search_depth:\n            continue\n\n        # Explore all possible actions from the current state.\n        for action in all_actions:\n            # Simulate the action using the CraftState's step method.\n            # step returns (reward, new_state); we only need the new_state.\n            _, next_state = current_state.step(action)\n            \n            # Get the hashable key for the next state.\n            next_state_key = _get_state_key(next_state)\n\n            # If this next state has not been visited before, add it to the queue\n            # and mark it as visited.\n            if next_state_key not in visited_states:\n                visited_states.add(next_state_key)\n                new_path = path + [action]\n                queue.append((next_state, new_path))\n    \n    # If the queue becomes empty and the goal was not reached,\n    # it means no path was found within the defined search limits.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:11:32.768931", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Initial observation and state setup\n  initial_obs = env.observations()\n  # Create copies of the current state for simulation\n  current_sim_grid = initial_obs['features_dict']['features_global'].copy()\n  current_sim_pos = initial_obs['features_dict']['pos']\n  current_sim_dir = np.argmax(initial_obs['features_dict']['direction']) # Direction is one-hot\n  current_sim_inventory = initial_obs['features_dict']['inventory'].copy()\n\n  all_actions = []\n\n  # Check if goal is already satisfied at the start\n  if current_sim_inventory[item] > 0:\n      return []\n\n  # Get cookbook and relevant indices from the world instance\n  cookbook = env.world.cookbook\n  world = env.world \n\n  # Get grid dimensions for boundary checks in pathfinding\n  WIDTH, HEIGHT, N_KINDS = current_sim_grid.shape\n\n  # Helper function for pathfinding using BFS on grid positions\n  # It finds a path to a cell adjacent to a target_kind\n  # Returns: (list of actions, final_pos, final_dir, coords_of_adjacent_target_cell)\n  # Returns None if no path found.\n  def _find_path_actions_with_target_cell(sim_grid, sim_pos, sim_dir, target_kind_idx, world_instance):\n      q = collections.deque()\n      visited = set()\n      \n      # State in BFS: (current_position_tuple, current_direction_int)\n      initial_state_tuple = (tuple(sim_pos), sim_dir)\n      q.append((initial_state_tuple, [])) # (state_tuple, path_so_far)\n      visited.add(initial_state_tuple)\n\n      # Mapping of CraftLab movement actions to (dx, dy) for grid movement\n      # and the resulting agent's internal direction after the move.\n      # CraftState internal directions: 0:North(-Y), 1:East(+X), 2:South(+Y), 3:West(-X)\n      MOVE_ACTION_DATA = {\n          0: ((0, 1), 2),  # DOWN action results in (+Y) move, agent faces South (dir 2)\n          1: ((0, -1), 0), # UP action results in (-Y) move, agent faces North (dir 0)\n          2: ((-1, 0), 3), # LEFT action results in (-X) move, agent faces West (dir 3)\n          3: ((1, 0), 1),  # RIGHT action results in (+X) move, agent faces East (dir 1)\n      }\n\n      # Helper to check if a position is adjacent to a cell containing target_kind_idx\n      # Returns the (x,y) coordinates of the first found adjacent target cell, or None.\n      def get_adjacent_target_cell_coords(current_pos, grid, target_kind):\n          px, py = current_pos\n          # Check 3x3 neighborhood (8 neighbors excluding the center)\n          for dx_n in [-1, 0, 1]:\n              for dy_n in [-1, 0, 1]:\n                  if dx_n == 0 and dy_n == 0: continue # Don't check current cell\n                  nx, ny = px + dx_n, py + dy_n\n                  if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                      # Check if this cell contains the target_kind_idx\n                      if grid[nx, ny, target_kind] > 0:\n                          return (nx, ny)\n          return None\n          \n      # Check if we are already adjacent to the target from the starting position\n      adj_target_cell_at_start = get_adjacent_target_cell_coords(sim_pos, sim_grid, target_kind_idx)\n      if adj_target_cell_at_start:\n          # Already adjacent, no movement actions needed\n          return [], sim_pos, sim_dir, adj_target_cell_at_start \n\n      # BFS loop\n      while q:\n          (pos, current_dir), path = q.popleft()\n          px, py = pos\n\n          # Explore possible movement actions\n          for action_val, ((dx, dy), new_dir_after_action) in MOVE_ACTION_DATA.items():\n              new_px, new_py = px + dx, py + dy\n              new_pos = (new_px, new_py)\n\n              # Check grid boundaries\n              if not (0 <= new_px < WIDTH and 0 <= new_py < HEIGHT):\n                  continue\n              \n              # Check if this new position is adjacent to the target kind\n              adj_target_cell = get_adjacent_target_cell_coords(new_pos, sim_grid, target_kind_idx)\n              if adj_target_cell:\n                  # Found a path: return the sequence of actions, the final agent position,\n                  # its final direction, and the coordinates of the target cell it's adjacent to.\n                  return path + [action_val], new_pos, new_dir_after_action, adj_target_cell\n\n              # If not yet at target, add to queue for further exploration\n              new_state_tuple = (new_pos, new_dir_after_action)\n              if new_state_tuple not in visited:\n                  visited.add(new_state_tuple)\n                  q.append((new_state_tuple, path + [action_val]))\n      \n      return None # No path found to any cell adjacent to target_kind_idx\n  # End of nested _find_path_actions_with_target_cell helper\n\n\n  # Determine if the goal item is a recipe output (craftable) or a primitive (collectable directly)\n  is_recipe_output = item in cookbook.recipes\n\n  if is_recipe_output:\n      # The item needs to be crafted at a workshop after gathering its base ingredients.\n      # `primitives_for` returns the total basic primitives needed, even for multi-step recipes.\n      primitives_needed = cookbook.primitives_for(item)\n\n      # 1. Collect all necessary primitives\n      for p_kind_idx, required_count in primitives_needed.items():\n          while current_sim_inventory[p_kind_idx] < required_count:\n              path_info = _find_path_actions_with_target_cell(\n                  current_sim_grid, current_sim_pos, current_sim_dir, p_kind_idx, world\n              )\n              \n              if path_info is None:\n                  # Cannot reach the primitive or no more of it on the grid.\n                  # This means the goal is impossible with this planning strategy.\n                  return [] \n              \n              path_moves, current_sim_pos, current_sim_dir, target_cell_coords = path_info\n              all_actions.extend(path_moves)\n\n              # Add USE action to pick up the item\n              all_actions.append(4) # USE action is 4\n\n              # Simulate the effect of USE (picking up the item)\n              current_sim_inventory[p_kind_idx] += 1\n              \n              # Remove the picked-up item from the simulated grid\n              tx, ty = target_cell_coords\n              if current_sim_grid[tx, ty, p_kind_idx] > 0: # Ensure it's still there before removal\n                  current_sim_grid[tx, ty, p_kind_idx] = 0 # Assume one item instance is removed per use\n\n      # 2. Craft the item at a workshop\n      workshop_kind_idx = None\n      if world.workshop_indices:\n          workshop_kind_idx = world.workshop_indices[0] # Assume there's at least one workshop and use the first one\n      \n      if workshop_kind_idx is not None:\n          path_info = _find_path_actions_with_target_cell(\n              current_sim_grid, current_sim_pos, current_sim_dir, workshop_kind_idx, world\n          )\n          \n          if path_info is None:\n              # Cannot reach a workshop.\n              return []\n\n          path_moves, current_sim_pos, current_sim_dir, _ = path_info # Workshop itself is not removed from grid\n          all_actions.extend(path_moves)\n\n          all_actions.append(4) # USE action at the workshop\n\n          # Simulate crafting: update inventory by consuming ingredients and producing the goal item.\n          recipe_ingredients = cookbook.recipes.get(item, {}) # Get the exact ingredients for this recipe\n          for ing_kind_idx, count_needed in recipe_ingredients.items():\n              if ing_kind_idx == '_key': \n                  continue # Skip special keys like required tools, they are not consumed\n              current_sim_inventory[ing_kind_idx] -= count_needed # Subtract consumed ingredients\n          \n          current_sim_inventory[item] += 1 # Add the crafted item to inventory\n      else:\n          # No workshop available to craft this recipe item.\n          return []\n  else:\n      # The item is not a recipe output. It must be a primitive that can be collected directly.\n      # We already checked at the beginning if we possess it. If not, attempt to pick it up.\n      if item in world.grabbable_indices: # Check if the item is something that can be picked up\n          path_info = _find_path_actions_with_target_cell(\n              current_sim_grid, current_sim_pos, current_sim_dir, item, world\n          )\n          \n          if path_info is None:\n              # Cannot reach the item, or it's not present on the grid.\n              return [] \n          \n          path_moves, current_sim_pos, current_sim_dir, target_cell_coords = path_info\n          all_actions.extend(path_moves)\n\n          all_actions.append(4) # USE action to pick it up\n          \n          current_sim_inventory[item] += 1 # Simulate pickup\n          \n          # Remove the picked item from the simulated grid\n          tx, ty = target_cell_coords\n          if current_sim_grid[tx, ty, item] > 0:\n              current_sim_grid[tx, ty, item] = 0\n      else:\n          # Item is neither a recipe output nor a grabbable primitive. Impossible to acquire.\n          return []\n\n  # Final check: if the simulated inventory now contains the goal item, return the plan.\n  if current_sim_inventory[item] > 0:\n      return all_actions\n  else:\n      # Planning failed to acquire the item for some unhandled reason.\n      return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:12:51.912650", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Helper to get a hashable representation of a CraftState.\n  # This tuple uniquely identifies a state for the purpose of the search.\n  # grid.tobytes() is used for the numpy array to make it hashable and memory efficient.\n  # inventory.tolist() followed by tuple() is used for the inventory array.\n  def get_state_key(state):\n    return (state.pos, state.dir, tuple(state.inventory.tolist()), state.grid.tobytes())\n\n  # Start BFS from the current state of the environment.\n  # CraftState.step() returns a *new* state, which is ideal for BFS\n  # as it avoids modifying the original state object during exploration.\n  initial_state = env._current_state\n\n  # Initialize the BFS queue with the initial state and an empty path.\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state)\n  q = collections.deque([(initial_state, [])])\n\n  # Keep track of visited states to avoid cycles and redundant computations.\n  # Stores hashable keys (produced by get_state_key) of CraftState objects.\n  visited = {get_state_key(initial_state)}\n\n  # Define the set of possible actions.\n  # From CraftLab's action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTIONS = [0, 1, 2, 3, 4]\n\n  # Set a maximum search depth to prevent the BFS from running indefinitely\n  # on very complex or unreachable goals, or in extremely large state spaces.\n  # This value is a heuristic and may need tuning depending on typical problem complexity\n  # within the CraftWorld environment.\n  MAX_SEARCH_DEPTH = 200 \n\n  # Perform Breadth-First Search\n  while q:\n    current_state, path = q.popleft()\n\n    # Check if the goal is satisfied in the current state.\n    # The 'goal_name' is ignored for CraftState.satisfies, only 'goal_arg' (item index) is used.\n    if current_state.satisfies(None, item):\n      return path # Goal reached, return the sequence of actions that led to this state.\n\n    # Prune the search if the current path length exceeds the maximum allowed depth.\n    # This helps manage computational complexity and prevent excessive memory usage.\n    if len(path) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible next states by trying each available action.\n    for action in ACTIONS:\n      # Apply the action to get the next state.\n      # The first return value (reward) from CraftState.step() is 0.0 in this environment,\n      # so we only care about the 'next_state' object.\n      _, next_state = current_state.step(action)\n\n      # Get the hashable key for the newly generated next state.\n      next_state_key = get_state_key(next_state)\n\n      # If this state has not been visited before, add it to the queue and the visited set.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Add the new state along with the updated path (current path + the action taken) to the queue.\n        q.append((next_state, path + [action]))\n\n  # If the queue becomes empty and the goal has not been reached,\n  # it means the goal is unreachable within the specified MAX_SEARCH_DEPTH from the initial state.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:15:10.806311", "function_name": "craft", "function_body": "  import collections # Required for deque for BFS\n\n  # Define action constants for clarity\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  def _find_path_actions(start_pos, current_grid, target_kind_idx, world_info):\n    \"\"\"\n    Finds a path of movement actions (0-3) from start_pos to a cell adjacent to target_kind_idx.\n    Returns a list of actions or None if no path is found.\n    The path leads to a position where `current_state.next_to(target_kind_idx)` would be True.\n    \"\"\"\n    height, width, _ = current_grid.shape\n    non_grabbable_indices = world_info.non_grabbable_indices\n    \n    # Identify all grid locations where the target_kind_idx is present.\n    # We need to find a path to a cell *adjacent* to one of these locations.\n    actual_target_cells = []\n    for r in range(height):\n        for c in range(width):\n            if current_grid[r, c, target_kind_idx] == 1:\n                actual_target_cells.append((r, c))\n    \n    if not actual_target_cells:\n        return None # Target item not found on the grid at all\n\n    q = collections.deque([(start_pos, [])]) # (current_position, path_actions_so_far)\n    visited = {start_pos}\n\n    # Define movement deltas (dy, dx) and their corresponding actions\n    moves = {\n        (1, 0): ACTION_DOWN,\n        (-1, 0): ACTION_UP,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT\n    }\n\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # Check if the current position (r, c) is adjacent to any of the target cells.\n        # This is the goal condition for the BFS: being in a position suitable for `USE`.\n        is_adjacent_to_target = False\n        for tr, tc in actual_target_cells:\n            # Check 3x3 neighborhood, excluding the target cell itself as a valid agent position\n            # for \"next_to\" meaning.\n            if abs(r - tr) <= 1 and abs(c - tc) <= 1 and (r,c) != (tr,tc):\n                is_adjacent_to_target = True\n                break\n        \n        if is_adjacent_to_target:\n            return path_actions # Found a path to a cell adjacent to the target\n\n        # Explore valid neighbors\n        for (dr, dc), action in moves.items():\n            nr, nc = r + dr, c + dc # New potential position\n\n            # Check bounds\n            if not (0 <= nr < height and 0 <= nc < width):\n                continue\n\n            # Check if already visited in this BFS path\n            if (nr, nc) in visited:\n                continue\n            \n            # Check if the next cell (nr, nc) is walkable.\n            # A cell is considered an obstacle if it contains any non-grabbable item (e.g., water, stone, workshops).\n            # The agent cannot move onto these types of cells.\n            is_obstacle = False\n            for idx in non_grabbable_indices:\n                if current_grid[nr, nc, idx] == 1: \n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            visited.add((nr, nc))\n            q.append(((nr, nc), path_actions + [action]))\n\n    return None # No path found to any cell adjacent to the target\n\n  # --- Main craft_v2 function logic starts here ---\n  all_actions = []\n\n  # Get the initial state of the environment. `env` is a CraftLab instance.\n  current_state = env._current_state \n\n  # 1. Check if the goal item is already in inventory\n  if current_state.satisfies(None, item): # `goal_name` is ignored in `satisfies`\n      return all_actions # Already crafted, no actions needed\n\n  cookbook = env.world.cookbook\n  # Get the list of all primitive ingredients and their counts required for the final item.\n  needed_primitives = cookbook.primitives_for(item) # Returns {primitive_idx: count}\n\n  # 2. Gather all required primitives iteratively\n  # We loop until all necessary primitives are collected.\n  # A simple safeguard to prevent infinite loops in complex scenarios or unreachability.\n  max_gathering_attempts = 500 \n  attempts_count = 0\n\n  while True:\n      attempts_count += 1\n      if attempts_count > max_gathering_attempts:\n          # print(\"Warning: Max gathering attempts reached. Could not collect all primitives.\")\n          return [] # Indicate failure or unreachability\n\n      current_state = env._current_state # Always use the most recent state\n\n      all_primitives_satisfied = True\n      missing_primitive_to_collect = None # Store the index of the first encountered missing primitive\n\n      # Check if any primitive is still missing\n      for p_idx, p_count in needed_primitives.items():\n          if current_state.inventory[p_idx] < p_count:\n              all_primitives_satisfied = False\n              missing_primitive_to_collect = p_idx\n              break # Found a missing primitive, focus on collecting this one\n\n      if all_primitives_satisfied:\n          break # All primitives are collected, exit the gathering loop\n\n      # If a primitive is missing, find a path to it and collect it\n      path_to_primitive = _find_path_actions(\n          current_state.pos, current_state.grid, missing_primitive_to_collect, env.world\n      )\n\n      if path_to_primitive is None:\n          # Cannot find a path to the necessary primitive.\n          # print(f\"Error: Cannot find path to primitive {cookbook.index.get(missing_primitive_to_collect)}\")\n          return [] # Indicate failure (item likely uncraftable)\n\n      # Execute the path to the primitive\n      for action in path_to_primitive:\n          _, _, _ = env.step(action) # Apply action, update environment state\n          all_actions.append(action)\n          current_state = env._current_state # Update current_state for the next iteration/step\n\n      # After moving, use the primitive if adjacent\n      if current_state.next_to(missing_primitive_to_collect):\n          _, _, _ = env.step(ACTION_USE)\n          all_actions.append(ACTION_USE)\n          # The inventory is updated internally by env.step; next loop iteration will reflect it.\n      else:\n          # This case indicates an issue with pathfinding or environmental changes\n          # print(f\"Error: Agent not next to primitive {cookbook.index.get(missing_primitive_to_collect)} after pathing.\")\n          return [] # Indicate failure\n\n  # 3. Craft the final item if a workshop is required\n  workshop_needed_idx = None\n  recipe_dict = cookbook.recipes.get(item) # Get the specific recipe for the final item\n\n  if recipe_dict:\n      # A workshop is needed if one of the recipe keys is in the workshop_indices\n      for key in recipe_dict:\n          if key in env.world.workshop_indices:\n              workshop_needed_idx = key\n              break\n  \n  if workshop_needed_idx is not None:\n      # Pathfind to the required workshop\n      path_to_workshop = _find_path_actions(\n          current_state.pos, current_state.grid, workshop_needed_idx, env.world\n      )\n\n      if path_to_workshop is None:\n          # print(f\"Error: Cannot find path to workshop {cookbook.index.get(workshop_needed_idx)}\")\n          return [] # Indicate failure\n\n      # Execute the path to the workshop\n      for action in path_to_workshop:\n          _, _, _ = env.step(action)\n          all_actions.append(action)\n          current_state = env._current_state # Update current_state\n\n      # Use the workshop to craft the item\n      if current_state.next_to(workshop_needed_idx):\n          _, _, _ = env.step(ACTION_USE)\n          all_actions.append(ACTION_USE)\n      else:\n          # print(f\"Error: Agent not next to workshop {cookbook.index.get(workshop_needed_idx)} after pathing.\")\n          return [] # Indicate failure\n\n  # 4. Final verification: Check if the goal item is now in inventory\n  current_state = env._current_state # Get the final state after all actions\n  if current_state.satisfies(None, item):\n      return all_actions # Successfully crafted\n  else:\n      # print(f\"Goal item {cookbook.index.get(item)} not in inventory after all actions. Crafting failed.\")\n      return [] # Goal not satisfied, something went wrong or item cannot be crafted (e.g., complex recipe logic not covered)", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:15:10.826491", "function_name": "craft", "function_body": "    import numpy as np\n    import collections\n\n    # Constants for actions\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function for pathfinding using Breadth-First Search (BFS).\n    # It finds a path of movement actions (UP/DOWN/LEFT/RIGHT) from the agent's\n    # current position to a cell adjacent to any instance of the `target_kind`\n    # on the grid.\n    # Returns a list of actions or None if no path is found.\n    def _find_path_to_adjacent(start_state, target_kind, world):\n        grid_shape = start_state.grid.shape\n        width, height, n_kinds = grid_shape\n        start_pos = start_state.pos\n\n        q = collections.deque([(start_pos, [])]) # Queue: (position, path_actions)\n        visited = {start_pos} # Set of visited positions to prevent cycles\n\n        # Mappings from actions to (dx, dy) for absolute grid movement\n        action_deltas = {\n            UP: (0, -1),\n            DOWN: (0, 1),\n            LEFT: (-1, 0),\n            RIGHT: (1, 0),\n        }\n\n        # Identify all grid cells that contain the `target_kind`\n        cells_with_target = []\n        for x in range(width):\n            for y in range(height):\n                if start_state.grid[x, y, target_kind] > 0:\n                    cells_with_target.append((x, y))\n        \n        if not cells_with_target:\n            return None # Target item not found anywhere on the grid\n\n        # Determine all valid adjacent positions around the target cells.\n        # These are the actual goals for the BFS.\n        target_adj_positions = set()\n        for tx, ty in cells_with_target:\n            # Check 4-directional neighbors\n            for dx, dy in [(-1,0), (1,0), (0,-1), (0,1)]:\n                nx, ny = tx + dx, ty + dy\n                # Ensure neighbor is within grid bounds\n                if 0 <= nx < width and 0 <= ny < height:\n                    # Check if the neighbor cell is blocked by a non-target environment object.\n                    # Environment objects that are NOT the target kind (e.g., water, stone)\n                    # are considered impassable for movement.\n                    is_blocked_by_env_object = False\n                    for k_idx in world.cookbook.environment:\n                        if k_idx != target_kind and start_state.grid[nx, ny, k_idx] > 0:\n                            is_blocked_by_env_object = True\n                            break\n                    \n                    if not is_blocked_by_env_object:\n                        target_adj_positions.add((nx, ny))\n        \n        # If the agent is already at a valid adjacent position, no movement needed.\n        if start_pos in target_adj_positions:\n            return []\n\n        if not target_adj_positions: # No valid adjacent cells to reach (e.g., target is surrounded)\n            return None\n\n        # Perform BFS\n        while q:\n            (curr_x, curr_y), path = q.popleft()\n\n            for action, (dx, dy) in action_deltas.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                # Check if next position is within bounds and not already visited\n                if 0 <= next_x < width and 0 <= next_y < height and (next_x, next_y) not in visited:\n                    # Check if the next cell is traversable (same logic as for target_adj_positions)\n                    is_blocked_by_env_object = False\n                    for k_idx in world.cookbook.environment:\n                        if k_idx != target_kind and start_state.grid[next_x, next_y, k_idx] > 0:\n                            is_blocked_by_env_object = True\n                            break\n                    \n                    if not is_blocked_by_env_object:\n                        new_path = path + [action]\n                        # If we reached one of the target adjacent positions, return the path\n                        if (next_x, next_y) in target_adj_positions:\n                            return new_path\n                        \n                        visited.add((next_x, next_y))\n                        q.append(((next_x, next_y), new_path))\n        \n        return None # No path found to any adjacent target cell\n\n    # Recursive planner function to generate a sequence of actions to craft a target item.\n    # It simulates the environment state as it goes, managing inventory and position.\n    # Returns (list of actions, final_simulated_state) if successful, None otherwise.\n    # `memo` is used for caching successful sub-plans to avoid redundant computations.\n    # `path_stack` is used to detect and prevent infinite recursion due to cyclic recipes.\n    def _plan_crafting_sequence(target_item_idx, current_sim_state, world, memo, path_stack):\n        # 1. Base case: Item already in inventory (enough quantity to satisfy one unit requirement)\n        if current_sim_state.inventory[target_item_idx] > 0:\n            return [], current_sim_state\n\n        # 2. Cycle detection: If this item is already in the current recursion path, it's a cycle.\n        if target_item_idx in path_stack:\n            return None \n        \n        # 3. Memoization: Check if we've already successfully planned for this specific item goal\n        # from a previous state in this overall planning session.\n        # Note: This simple memoization might not be optimal for all scenarios if state matters deeply,\n        # but it prevents re-calculating the same sub-goal in a greedy DFS-like manner.\n        if target_item_idx in memo:\n            # The cached result might not be from the *exact* current_sim_state,\n            # but for v2 it's assumed to be good enough if it provides actions and gets the item.\n            # We must re-simulate the cached actions on current_sim_state to get the correct end-state.\n            cached_actions, _ = memo[target_item_idx] # Discard cached state, re-simulate\n            temp_state = current_sim_state\n            for action in cached_actions:\n                _, temp_state = temp_state.step(action)\n            \n            if temp_state.inventory[target_item_idx] > 0:\n                return cached_actions, temp_state\n            else:\n                # Cached plan failed from current state, need to re-plan.\n                # Remove from memo to allow re-computation.\n                del memo[target_item_idx]\n\n\n        cookbook = world.cookbook\n        sim_actions = [] # List to accumulate actions for this planning branch\n        \n        recipe = cookbook.recipes.get(target_item_idx)\n\n        # Add current item to path stack for cycle detection (removed in finally block)\n        path_stack.add(target_item_idx)\n\n        try:\n            if recipe is None: # It's a primitive item (no recipe)\n                # Check if this primitive is grabbable (e.g., not water or stone without tools)\n                if target_item_idx not in world.grabbable_indices:\n                    return None # Cannot acquire this non-grabbable primitive directly\n\n                # Find path to a cell adjacent to the primitive\n                path_to_primitive_adj = _find_path_to_adjacent(current_sim_state, target_item_idx, world)\n                if path_to_primitive_adj is None:\n                    return None # Cannot reach the primitive on the map\n                \n                # Simulate moving to the primitive's vicinity\n                for action in path_to_primitive_adj:\n                    _, current_sim_state = current_sim_state.step(action)\n                    sim_actions.append(action)\n                \n                # Verify agent is next to the primitive before attempting USE\n                if not current_sim_state.next_to(target_item_idx):\n                    return None \n\n                # Perform the USE action to pick up the primitive\n                _, current_sim_state = current_sim_state.step(USE)\n                sim_actions.append(USE)\n                \n                # Check if the primitive was successfully acquired\n                if current_sim_state.inventory[target_item_idx] == 0:\n                    return None # USE action failed (e.g., no item there, or agent not positioned correctly)\n\n            else: # It's a crafted item with a recipe\n                ingredients_needed = collections.defaultdict(int)\n                for ingredient_idx, count in recipe.items():\n                    if ingredient_idx == \"_key\": continue # Special key, not an ingredient\n                    ingredients_needed[ingredient_idx] += count\n                \n                # Recursively acquire all necessary ingredients\n                for ingredient_idx, needed_count in ingredients_needed.items():\n                    # Keep trying to acquire this ingredient until enough units are gathered\n                    while current_sim_state.inventory[ingredient_idx] < needed_count:\n                        # Recursively plan for acquiring this ingredient\n                        result = _plan_crafting_sequence(ingredient_idx, current_sim_state, world, memo, path_stack)\n                        if result is None:\n                            return None # Cannot acquire ingredient, so cannot craft target item\n                        \n                        ingredient_path_actions, current_sim_state = result\n                        sim_actions.extend(ingredient_path_actions)\n\n                # After all ingredients are simulated to be in inventory, go to a workshop and craft.\n                if not world.workshop_indices:\n                    return None # No workshops available in this world configuration\n\n                # Find path to a cell adjacent to any workshop\n                workshop_idx_to_use = None\n                path_to_workshop_adj = None\n                # Iterate through all known workshop kinds to find one we can reach\n                for w_idx in world.workshop_indices:\n                    temp_path = _find_path_to_adjacent(current_sim_state, w_idx, world)\n                    if temp_path is not None:\n                        path_to_workshop_adj = temp_path\n                        workshop_idx_to_use = w_idx\n                        break\n                \n                if path_to_workshop_adj is None:\n                    return None # Cannot reach any workshop on the map\n\n                # Simulate moving to the workshop's vicinity\n                for action in path_to_workshop_adj:\n                    _, current_sim_state = current_sim_state.step(action)\n                    sim_actions.append(action)\n                \n                # Verify agent is next to the workshop before attempting USE\n                if not current_sim_state.next_to(workshop_idx_to_use):\n                    return None \n\n                # Perform the USE action to craft the item\n                _, current_sim_state = current_sim_state.step(USE)\n                sim_actions.append(USE)\n                \n                # Check if crafting succeeded\n                if current_sim_state.inventory[target_item_idx] == 0:\n                    return None # Crafting failed (e.g., not enough ingredients or not at correct workshop)\n        finally:\n            # Remove current item from the path stack as its planning branch is complete\n            path_stack.remove(target_item_idx)\n\n        # Memoize the successful plan and return it\n        memo[target_item_idx] = (sim_actions, current_sim_state)\n        return sim_actions, current_sim_state\n\n    # --- Main logic of craft_v2 ---\n    initial_state = env._current_state\n    \n    # Initialize memoization cache and recursion path stack for this specific call\n    memo = {} \n    path_stack = set() \n\n    # Start the recursive planning process for the target item\n    result = _plan_crafting_sequence(item, initial_state, env.world, memo, path_stack)\n    \n    if result is None:\n        return [] # Return empty list if no valid plan found\n    \n    actions, _ = result # Discard the final simulated state, return only the actions\n    return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:16:04.011318", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Actions as per CraftLab.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Get the initial state from the environment\n  start_state = env._current_state\n  goal_item_idx = item\n\n  # Immediate check: if the item is already crafted, no actions needed.\n  if start_state.satisfies(None, goal_item_idx):\n    return []\n\n  # BFS data structures\n  queue = deque()\n  visited = set()  # Stores hashable state representations\n  # Stores the sequence of actions to reach a state. Key: state_key, Value: list of actions.\n  paths = {}\n\n  def get_state_key(state):\n    \"\"\"Creates a hashable representation of a CraftState.\"\"\"\n    # Convert numpy arrays (grid, inventory) to bytes for hashing\n    return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  initial_state_key = get_state_key(start_state)\n  queue.append(start_state)\n  visited.add(initial_state_key)\n  paths[initial_state_key] = []  # No actions needed to reach the start state\n\n  # Safety limit to prevent excessively long searches for complex or impossible goals.\n  # This value may need tuning based on environment complexity.\n  MAX_SEARCH_STEPS = 50000 \n  current_search_steps = 0\n\n  while queue and current_search_steps < MAX_SEARCH_STEPS:\n    current_state = queue.popleft()\n    current_state_key = get_state_key(current_state)\n    current_actions = paths[current_state_key]  # Actions to reach the current state\n\n    # Check if the current state satisfies the goal\n    if current_state.satisfies(None, goal_item_idx):\n      return current_actions\n\n    # Explore all possible actions from the current state\n    for action in ACTIONS:\n      # Simulate the step to get the next state.\n      # CraftState.step returns (reward, new_state); reward is always 0.0 here.\n      _reward, next_state = current_state.step(action)\n      next_state_key = get_state_key(next_state)\n\n      # If this new state has not been visited, add it to the queue\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        paths[next_state_key] = current_actions + [action]\n        queue.append(next_state)\n    \n    current_search_steps += 1\n\n  # If the loop finishes (queue is empty or max_search_steps reached)\n  # without finding the goal, it means the goal is not reachable within the limits.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:16:05.687896", "function_name": "craft", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:17:15.415649", "function_name": "craft", "function_body": "  # Reset the environment to a known initial state\n  # The _current_state of CraftLab holds the CraftState instance\n  _ = env.reset(seed=0)  # Use a fixed seed for deterministic behavior of the search\n  initial_state = env._current_state\n\n  # Data structures for Breadth-First Search (BFS)\n  # collections.deque is assumed to be available (e.g., imported globally as `from collections import deque`)\n  queue = collections.deque() \n  # visited set stores a hashable representation of states to avoid redundant computations and cycles.\n  # A state is defined by (agent_position, agent_direction, inventory_contents, grid_layout).\n  # Numpy arrays (grid, inventory) are converted to bytes for hashability.\n  visited = set()\n\n  # Start BFS from the initial state\n  # Queue elements are (CraftState object, list_of_actions_taken_to_reach_this_state)\n  queue.append((initial_state, []))\n\n  # Action constants. Assuming they are fixed and known (0-4).\n  # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE\n  NUM_ACTIONS = 5 \n\n  while queue:\n    current_state, actions_history = queue.popleft()\n\n    # Check if the goal item is present in the current inventory\n    if current_state.inventory[item] > 0:\n      return actions_history  # Goal achieved, return the sequence of actions\n\n    # Create a unique, hashable key for the current state to check against 'visited'\n    # Use .tobytes() for numpy arrays (inventory, grid) to make them hashable\n    # np (from numpy) is assumed to be imported globally\n    state_key = (\n        current_state.pos,            # Tuple (int, int)\n        current_state.dir,            # Int (0, 1, 2, or 3)\n        current_state.inventory.tobytes(), # Bytes representation of inventory array\n        current_state.grid.tobytes()  # Bytes representation of grid array\n    )\n\n    # If this state has already been visited, skip it to avoid cycles and redundant work\n    if state_key in visited:\n      continue\n    visited.add(state_key) # Mark the current state as visited\n\n    # Explore all possible next states by trying each action\n    for action in range(NUM_ACTIONS):\n      # Simulate the action: CraftState.step returns (reward, new_CraftState)\n      # We only care about the new_CraftState for our search\n      _, next_state = current_state.step(action)\n\n      # Create a key for the next state to check if it's already visited or in queue\n      next_state_key = (\n          next_state.pos,\n          next_state.dir,\n          next_state.inventory.tobytes(),\n          next_state.grid.tobytes()\n      )\n\n      # If the next state has not been visited, add it to the queue for exploration\n      if next_state_key not in visited:\n        # Append the new action to the history and add to queue\n        queue.append((next_state, actions_history + [action]))\n\n  # If the queue becomes empty and the goal was never reached, the item cannot be crafted\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:17:17.238113", "function_name": "craft", "function_body": "  # Action constants (based on CraftLab.action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Assume collections and numpy are imported at the top-level by the environment.\n  # For example:\n  # import collections\n  # import numpy as np\n\n  initial_state = env._current_state\n  \n  # Check if the goal item is already in the inventory at the start\n  if initial_state.satisfies(None, item):\n      return []\n\n  # Queue for Breadth-First Search (BFS): stores tuples of (current_state, path_to_current_state)\n  # collections.deque is used for efficient popleft operations.\n  q = collections.deque([(initial_state, [])])\n  \n  # Visited set to store unique state representations to avoid cycles and redundant computations.\n  # A state is represented by a tuple: (grid_bytes, position_tuple, direction_int, inventory_bytes).\n  # numpy.ndarray.tobytes() is used for hashable representation of grid and inventory arrays.\n  visited = set()\n  \n  # Add the initial state to the visited set\n  visited.add((initial_state.grid.tobytes(), initial_state.pos, initial_state.dir, initial_state.inventory.tobytes()))\n\n  # Define a maximum path length to prevent the search from exploring endlessly\n  # for very complex or impossible goals. This acts as a practical limit on search depth.\n  MAX_PATH_LENGTH = 150 \n\n  while q:\n      current_state, current_path = q.popleft()\n\n      # If the current path length exceeds the maximum allowed, stop exploring this branch.\n      # This prevents infinite loops or excessive memory usage for very long or impossible paths.\n      if len(current_path) >= MAX_PATH_LENGTH:\n          continue\n\n      # Iterate over all possible actions (movements and 'USE')\n      for action in ACTIONS:\n          # Simulate the action to get the next state.\n          # CraftState.step returns (reward, new_state). The reward is always 0.0 in this implementation.\n          _, next_state = current_state.step(action)\n          new_path = current_path + [action]\n\n          # Check if the goal item is satisfied in the new state's inventory\n          if next_state.satisfies(None, item):\n              return new_path\n\n          # Create a hashable representation of the next state for efficient lookup in the visited set\n          next_state_repr = (next_state.grid.tobytes(), next_state.pos, next_state.dir, next_state.inventory.tobytes())\n\n          # If this state has not been visited before, add it to the queue and the visited set\n          if next_state_repr not in visited:\n              visited.add(next_state_repr)\n              q.append((next_state, new_path))\n              \n  # If the queue becomes empty and the goal was not reached, it means the item cannot be crafted\n  # from the initial state within the defined search limits (or is truly impossible).\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:18:29.994680", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Actions as per CraftLab.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Get the initial state from the environment\n  start_state = env._current_state\n  goal_item_idx = item\n\n  # Immediate check: if the item is already crafted, no actions needed.\n  if start_state.satisfies(None, goal_item_idx):\n    return []\n\n  # BFS data structures\n  # Queue stores tuples of (CraftState instance, list of actions taken to reach this state)\n  queue = deque()\n  \n  # Visited set stores hashable representations of states to avoid revisiting\n  # and infinite loops.\n  visited = set()  \n\n  def get_state_key(state):\n    \"\"\"Creates a hashable representation of a CraftState.\"\"\"\n    # Convert numpy arrays (grid, inventory) to bytes for efficient hashing.\n    # pos and dir are already hashable (tuple and int).\n    return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  initial_state_key = get_state_key(start_state)\n  queue.append((start_state, [])) # Start with the initial state and an empty action list\n  visited.add(initial_state_key)\n\n  # Safety limits to prevent excessively long searches for complex or impossible goals.\n  # MAX_SEARCH_STATES: limits the total number of distinct states explored.\n  # Increased from v1 to allow for more extensive searches.\n  MAX_SEARCH_STATES = 100000 \n  \n  # MAX_PATH_LENGTH: limits the maximum length of the action sequence that will be returned.\n  # This prevents finding extremely long, potentially impractical plans,\n  # even if the goal is theoretically reachable. Adjust based on expected task complexity.\n  MAX_PATH_LENGTH = 100 \n\n  current_search_states = 0\n\n  while queue and current_search_states < MAX_SEARCH_STATES:\n    current_state, current_actions = queue.popleft()\n    current_state_key = get_state_key(current_state)\n\n    # Check if the current state satisfies the goal\n    if current_state.satisfies(None, goal_item_idx):\n      return current_actions\n\n    # Prune paths that are already too long. If the current path already exceeds\n    # the maximum allowed length, do not explore further from this state.\n    if len(current_actions) >= MAX_PATH_LENGTH:\n      continue \n\n    # Explore all possible actions from the current state\n    for action in ACTIONS:\n      # Simulate the step to get the next state.\n      # CraftState.step returns (reward, new_state); reward is always 0.0 in this implementation.\n      _reward, next_state = current_state.step(action)\n      next_state_key = get_state_key(next_state)\n\n      # If this new state has not been visited, add it to the queue\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        new_actions = current_actions + [action]\n        queue.append((next_state, new_actions))\n    \n    current_search_states += 1\n\n  # If the loop finishes (queue is empty or max_search_states reached)\n  # without finding the goal, it means the goal is not reachable within the defined limits.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:18:51.871269", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Actions as per CraftLab.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Safety limit to prevent excessively long searches for complex or impossible goals.\n  # This value may need tuning based on environment complexity.\n  _MAX_SEARCH_STEPS = 100000 \n\n  def get_state_key(state):\n    \"\"\"Creates a hashable representation of a CraftState.\n    Uses tobytes() for grid and inventory, which is robust for content hashing.\n    \"\"\"\n    return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  def reconstruct_path(parent_pointers, end_state_key, start_state_key):\n    \"\"\"Reconstructs the action path from the start_state_key to the end_state_key\n    using the parent pointers stored in parent_pointers map.\n    \"\"\"\n    path = []\n    current_key = end_state_key\n    # Traverse backwards from the end state until the start state is reached.\n    while current_key != start_state_key:\n      # Each entry in parent_pointers stores (previous_state_key, action_taken_to_reach_current_key)\n      prev_key, action = parent_pointers[current_key]\n      path.append(action)\n      current_key = prev_key\n    # The path is built in reverse order, so reverse it to get actions from start to end.\n    return path[::-1]\n\n  # Get the initial state from the environment\n  start_state = env._current_state\n  goal_item_idx = item\n\n  # Immediate check: if the item is already crafted, no actions needed.\n  if start_state.satisfies(None, goal_item_idx):\n    return []\n\n  # BFS data structures\n  queue = deque()\n  visited = set()  # Stores hashable state representations of visited states\n  # Stores parent pointers for path reconstruction.\n  # Key: current_state_key, Value: (previous_state_key, action_taken_to_reach_current_state)\n  parent_pointers = {}\n\n  initial_state_key = get_state_key(start_state)\n  queue.append(start_state)\n  visited.add(initial_state_key)\n\n  current_search_steps = 0\n\n  while queue and current_search_steps < _MAX_SEARCH_STEPS:\n    current_state = queue.popleft()\n    current_state_key = get_state_key(current_state)\n\n    # Check if the current state satisfies the goal\n    if current_state.satisfies(None, goal_item_idx):\n      # Goal reached! Reconstruct the path using parent pointers.\n      return reconstruct_path(parent_pointers, current_state_key, initial_state_key)\n\n    # Explore all possible actions from the current state\n    for action in ACTIONS:\n      # Simulate the step to get the next state.\n      # CraftState.step returns (reward, new_state); reward is always 0.0 here.\n      _reward, next_state = current_state.step(action)\n      next_state_key = get_state_key(next_state)\n\n      # If this new state has not been visited, add it to the queue\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Store the parent state and the action taken to reach this next_state.\n        parent_pointers[next_state_key] = (current_state_key, action)\n        queue.append(next_state)\n    \n    current_search_steps += 1\n\n  # If the loop finishes (queue is empty or max_search_steps reached)\n  # without finding the goal, it means the goal is not reachable within the limits.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:20:33.343682", "function_name": "craft", "function_body": "    # Action constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Max steps for internal pathfinding BFS (e.g., moving to an item)\n    MAX_NAV_STEPS = 10000\n\n    # Max recursion depth for crafting complex items\n    MAX_CRAFT_DEPTH = 5\n\n    from collections import deque\n    import numpy as np\n\n    def _pathfind(start_state, target_kind_idx=None, target_pos=None, world=None):\n        \"\"\"\n        Finds a path (list of actions) from start_state to a state where:\n        - agent is next to target_kind_idx, OR\n        - agent is at target_pos.\n        Returns (path_actions, final_state) or (None, None) if no path found.\n        \"\"\"\n        q = deque()\n        q.append((start_state, [])) # (current_state, path_so_far)\n\n        visited = set()\n        # State key for navigation: (position, direction)\n        visited.add((start_state.pos, start_state.dir)) \n\n        step_count = 0\n        while q and step_count < MAX_NAV_STEPS:\n            current_state, current_path = q.popleft()\n            step_count += 1\n\n            # Check if goal is met for navigation\n            if target_kind_idx is not None:\n                if current_state.next_to(target_kind_idx):\n                    return current_path, current_state\n            elif target_pos is not None:\n                if current_state.pos == target_pos:\n                    return current_path, current_state\n            \n            # Explore movement actions\n            for action in [DOWN, UP, LEFT, RIGHT]:\n                _reward, next_state = current_state.step(action)\n                next_key = (next_state.pos, next_state.dir)\n                if next_key not in visited:\n                    visited.add(next_key)\n                    q.append((next_state, current_path + [action]))\n        \n        return None, None # No path found\n\n    def _get_item_coords(grid, item_idx):\n        \"\"\"Helper to find coordinates of an item on the grid.\"\"\"\n        coords = []\n        # Grid is (WIDTH, HEIGHT, n_kinds)\n        rows, cols = np.where(grid[:, :, item_idx] > 0)\n        for r, c in zip(rows, cols):\n            coords.append((r, c))\n        return coords\n\n    def _plan_craft_recursive(current_state, target_item_idx, cookbook, world, depth):\n        \"\"\"\n        Recursive helper function to plan crafting of a single item.\n        Returns (list_of_actions, final_state) or (None, None) if no plan found.\n        \"\"\"\n        if depth >= MAX_CRAFT_DEPTH:\n            return None, None # Exceeded recursion depth\n\n        # If already have the item, no actions needed\n        if current_state.inventory[target_item_idx] > 0: \n            return [], current_state\n        \n        # Get the recipe for the target item\n        recipe = cookbook.recipes.get(target_item_idx)\n\n        current_plan_segment = [] # Actions generated at this level of recursion\n        current_planning_state = current_state # Use this to track state changes during planning\n        \n        if recipe is None: # No recipe, must be a primitive or uncraftable\n            # If it's a primitive, we need to pick it up\n            if target_item_idx in cookbook.primitives:\n                # Pathfind to a position next to the item.\n                # _pathfind will find the shortest path to *any* instance of target_item_idx.\n                path_to_loc, state_at_loc = _pathfind(\n                    current_planning_state, target_kind_idx=target_item_idx, world=world\n                )\n                \n                if path_to_loc is not None:\n                    # Simulate the USE action\n                    _reward, state_after_use = state_at_loc.step(USE)\n                    \n                    # Check if the item was successfully picked up (inventory increased)\n                    if target_item_idx in world.grabbable_indices and state_after_use.inventory[target_item_idx] > current_planning_state.inventory[target_item_idx]:\n                        current_plan_segment.extend(path_to_loc)\n                        current_plan_segment.append(USE)\n                        return current_plan_segment, state_after_use\n                \n                return None, None # Cannot pick up primitive, maybe no path or no instance found\n            else: # Not a primitive and no recipe, uncraftable/unobtainable\n                return None, None\n        \n        else: # Recipe exists, need to craft\n            \n            # Step 1: Collect ingredients\n            ingredients_needed_map = {}\n            for ing_key, count in recipe.items():\n                if ing_key == \"_key\":\n                    continue\n                ing_idx = cookbook.index.index(ing_key) # Convert string key to int index\n                ingredients_needed_map[ing_idx] = count\n\n            # Iterate through ingredients and ensure we have enough\n            for ing_idx, required_count in ingredients_needed_map.items():\n                while current_planning_state.inventory[ing_idx] < required_count:\n                    # Recursively plan to get ONE unit of the ingredient\n                    ing_actions, state_after_ing = _plan_craft_recursive(\n                        current_planning_state, ing_idx, cookbook, world, depth + 1\n                    )\n                    if ing_actions is None:\n                        return None, None # Failed to get an ingredient\n                    \n                    current_plan_segment.extend(ing_actions)\n                    current_planning_state = state_after_ing # Update state for next ingredient collection\n            \n            # Step 2: Navigate to workshop (if _key exists)\n            if \"_key\" in recipe:\n                workshop_name = recipe[\"_key\"]\n                workshop_idx = cookbook.index.index(workshop_name) # Get index for workshop\n                \n                path_to_workshop, state_at_workshop = _pathfind(\n                    current_planning_state, target_kind_idx=workshop_idx, world=world\n                )\n                \n                if path_to_workshop is None:\n                    return None, None # Cannot reach workshop\n                \n                current_plan_segment.extend(path_to_workshop)\n                current_planning_state = state_at_workshop\n                \n                # Verify we are next to the workshop before USE (safety check)\n                if not current_planning_state.next_to(workshop_idx):\n                    return None, None \n\n            # Step 3: Perform USE action to craft\n            _reward, state_after_craft = current_planning_state.step(USE)\n            \n            # Check if crafting was successful (item count increased)\n            if state_after_craft.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n                current_plan_segment.append(USE)\n                return current_plan_segment, state_after_craft\n            else:\n                return None, None # Crafting failed (e.g., not at right workshop, or not enough ingredients/conditions)\n\n    # Ensure item is an integer ID\n    if isinstance(item, str):\n        item_idx = env.world.cookbook.index.index(item)\n    else:\n        item_idx = item\n\n    # Check if goal is already satisfied in the initial state\n    if env._current_state.satisfies(None, item_idx):\n        return []\n\n    cookbook = env.world.cookbook\n    world = env.world\n    \n    # Start the recursive planning process\n    final_action_sequence, _final_state = _plan_craft_recursive(\n        env._current_state, item_idx, cookbook, world, 0\n    )\n    \n    if final_action_sequence is not None:\n        return final_action_sequence\n    else:\n        return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:20:33.363947", "function_name": "craft", "function_body": "    import collections\n\n    # Define actions as integers (0-4) as per CraftLab.action_specs\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ACTIONS = [0, 1, 2, 3, 4]\n\n    # Get the initial CraftState from the current environment state\n    start_state = env._current_state \n    world = env.world \n    cookbook = world.cookbook \n\n    # Get the item name for the goal check. CraftState.satisfies ignores goal_name,\n    # but it's good practice to provide it or None.\n    item_name = cookbook.index.get(item)\n\n    # Initialize a deque for BFS queue: stores (CraftState, list_of_actions_to_reach_state)\n    queue = collections.deque([(start_state, [])]) \n    # Initialize a set to store visited state keys to prevent cycles and redundant work\n    # A state key is a hashable representation of the CraftState's crucial attributes\n    visited = set() \n\n    # Optional: Limits to prevent excessive search in very complex or unsolvable scenarios\n    # These values can be tuned based on expected problem complexity\n    MAX_SEARCH_DEPTH = 200\n    MAX_VISITED_STATES = 100000\n\n    while queue and len(visited) < MAX_VISITED_STATES:\n        current_state, current_path = queue.popleft()\n\n        # Prune search if maximum depth is exceeded\n        if len(current_path) > MAX_SEARCH_DEPTH:\n            continue \n\n        # Create a hashable key for the current state:\n        # - current_state.grid (numpy.ndarray) is converted to bytes for hashability.\n        # - current_state.inventory (numpy.ndarray) is converted to a tuple for hashability.\n        # - current_state.pos (tuple) and current_state.dir (int) are already hashable.\n        state_key = (current_state.grid.tobytes(), tuple(current_state.inventory),\n                     current_state.pos, current_state.dir)\n\n        # If this state has already been visited (via a shorter or equal path), skip it\n        if state_key in visited:\n            continue\n\n        # Mark the current state as visited\n        visited.add(state_key)\n\n        # Check if the goal item is satisfied in the current state's inventory\n        if current_state.satisfies(item_name, item):\n            return current_path\n\n        # Explore all possible actions from the current state\n        for action in ACTIONS:\n            # current_state.step(action) returns (reward, new_state)\n            # The reward is always 0.0 in this implementation according to CraftState.step docstring,\n            # so we only need the new_state.\n            _, new_state = current_state.step(action)\n            \n            # Construct the path to the new state\n            new_path = current_path + [action]\n\n            # Create the hashable key for the new state\n            new_state_key = (new_state.grid.tobytes(), tuple(new_state.inventory),\n                             new_state.pos, new_state.dir)\n\n            # Add the new state to the queue only if it hasn't been visited yet\n            # This ensures BFS finds the shortest path by processing states level by level\n            if new_state_key not in visited:\n                queue.append((new_state, new_path))\n\n    # If the queue becomes empty and the goal was not reached, it means no path was found\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:21:57.925091", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (typically defined globally or via env.action_specs(), but inlined for self-containment)\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n\n  # Max search depths to prevent infinite loops and limit computation\n  MAX_PATH_SEARCH_DEPTH = 100  # Max steps for agent movement to reach an item/workshop\n  MAX_CRAFT_RECURSION_DEPTH = 20 # Max depth for recursive crafting of sub-items\n\n  def _find_path_to_target(start_state, target_kind_idx):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find a path (sequence of movement actions)\n      from `start_state` to a state where the agent is adjacent to `target_kind_idx`.\n      This is required before a _ACTION_USE can successfully interact with the target.\n\n      Args:\n          start_state: The initial CraftState from which to start the search.\n          target_kind_idx: The integer index of the item or workshop to reach.\n\n      Returns:\n          A tuple (list_of_actions, final_craft_state) if a path is found,\n          where list_of_actions are movement actions and final_craft_state is the state\n          where the agent is next to the target. Returns (None, None) if no path.\n      \"\"\"\n      q = collections.deque([(start_state, [])])\n      # Visited states are defined by (agent_position, agent_direction)\n      # This assumes the grid layout relevant for movement is static during pathfinding.\n      visited = set([(start_state.pos, start_state.dir)])\n\n      while q:\n          current_state, current_path = q.popleft()\n\n          if len(current_path) > MAX_PATH_SEARCH_DEPTH:\n              continue  # Prune excessively long paths\n\n          # Check if the current state is adjacent to the target\n          if current_state.next_to(target_kind_idx):\n              return current_path, current_state\n\n          # Explore possible movement actions\n          for action in [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT]:\n              # CraftState.step returns a new state object, which is good for BFS\n              _, next_state = current_state.step(action)\n\n              state_key = (next_state.pos, next_state.dir)\n              if state_key not in visited:\n                  visited.add(state_key)\n                  q.append((next_state, current_path + [action]))\n\n      return None, None  # No path found\n\n  def _craft_item(target_item_idx, current_state, recursion_depth=0):\n      \"\"\"\n      Recursively finds actions to craft `target_item_idx` starting from `current_state`.\n      This function collects ingredients (by crafting or picking them up),\n      moves to necessary workshops, and performs the USE action.\n\n      Args:\n          target_item_idx: The integer index of the item to craft.\n          current_state: The current CraftState of the environment.\n          recursion_depth: Current depth of recursion, to prevent infinite loops.\n\n      Returns:\n          A tuple (final_state, list_of_actions) if successful,\n          where final_state is the state after crafting and list_of_actions\n          is the sequence of actions taken. Returns (None, []) if impossible.\n      \"\"\"\n      if recursion_depth > MAX_CRAFT_RECURSION_DEPTH:\n          # Prevent stack overflow or infinite recursion in complex dependency graphs\n          return None, []\n\n      # Base Case 1: Item is already in inventory\n      if current_state.inventory[target_item_idx] > 0:\n          return current_state, []\n\n      total_actions_for_this_item = []\n\n      # Get the recipe for the target item. If no recipe, it's a primitive or uncraftable.\n      recipe = env.world.cookbook.recipes.get(target_item_idx)\n\n      if recipe is None:\n          # This item has no recipe, so it must be a primitive that needs to be picked up.\n          if target_item_idx not in env.world.grabbable_indices:\n              # Item cannot be picked up (e.g., environment item like water, or not defined as grabbable)\n              return None, [] # Impossible to get\n\n          # Find path to the primitive item\n          path_actions, path_end_state = _find_path_to_target(current_state, target_item_idx)\n          if path_actions is None:\n              return None, [] # Cannot reach the primitive\n\n          total_actions_for_this_item.extend(path_actions)\n          current_state = path_end_state # Update state after movement\n\n          # Perform the USE action to pick up the primitive\n          _, new_state_after_use = current_state.step(_ACTION_USE)\n          total_actions_for_this_item.append(_ACTION_USE)\n          current_state = new_state_after_use\n\n          # Verify item was picked up\n          if current_state.inventory[target_item_idx] > 0:\n              return current_state, total_actions_for_this_item\n          else:\n              # USE action somehow failed to pick up the item.\n              return None, []\n      else:\n          # This item needs to be crafted according to its recipe\n          required_ingredients = {}\n          for ing_idx_str, count in recipe.items():\n              if ing_idx_str == \"_key\":\n                  continue\n              ing_idx = int(ing_idx_str)\n              required_ingredients[ing_idx] = count\n\n          # First, gather all required ingredients\n          for ingredient_idx, needed_count in required_ingredients.items():\n              have_count = current_state.inventory[ingredient_idx]\n              to_get_count = needed_count - have_count\n\n              for _ in range(max(0, int(to_get_count))): # Ensure positive integer count\n                  # Recursively craft or pick up each needed ingredient\n                  next_state, actions_for_ingredient = _craft_item(\n                      ingredient_idx, current_state, recursion_depth + 1\n                  )\n                  if next_state is None:\n                      return None, [] # Failed to get an ingredient, propagate failure\n\n                  total_actions_for_this_item.extend(actions_for_ingredient)\n                  current_state = next_state # Update current_state for subsequent steps\n\n          # All ingredients collected. Now, perform the crafting action.\n          workshop_idx = recipe.get(\"_key\")\n          if workshop_idx is not None:\n              workshop_idx = int(workshop_idx)\n\n              # Check if the specified workshop is valid\n              if workshop_idx not in env.world.workshop_indices:\n                  # This recipe requires an unknown or invalid workshop\n                  return None, []\n\n              # Find path to the required workshop\n              path_actions, path_end_state = _find_path_to_target(current_state, workshop_idx)\n              if path_actions is None:\n                  return None, [] # Cannot reach the workshop\n\n              total_actions_for_this_item.extend(path_actions)\n              current_state = path_end_state # Update state after movement\n\n          # Perform the USE action to craft the item.\n          # If workshop_idx is None, this is a \"handicraft\" and USE acts without specific nearby object.\n          _, new_state_after_use = current_state.step(_ACTION_USE)\n          total_actions_for_this_item.append(_ACTION_USE)\n          current_state = new_state_after_use\n\n          # Verify item was crafted and is now in inventory\n          if current_state.inventory[target_item_idx] > 0:\n              return current_state, total_actions_for_this_item\n          else:\n              # Crafting failed for some reason (e.g., incorrect conditions for USE,\n              # or logic error if inventory didn't update).\n              return None, []\n\n  # Get the initial state from the environment.\n  # Assuming env._current_state is properly initialized by CraftLab.reset() or similar.\n  initial_state = env._current_state\n\n  if initial_state is None:\n      # This indicates the CraftLab environment has not been reset or initialized.\n      # For a DMLab-style env, a reset() call is usually expected before agent interaction.\n      # Returning empty list as no actions can be planned from an uninitialized state.\n      return []\n\n  final_state, actions = _craft_item(item, initial_state)\n\n  # Check if the goal was successfully achieved\n  if final_state is None or final_state.inventory[item] == 0:\n      return [] # Goal not achieved or impossible\n  else:\n      return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:21:59.289730", "function_name": "craft", "function_body": "  # Define actions as constants, consistent with CraftLab's action_specs.\n  # These are numerical values mapped to actions: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Initialize a deque for BFS, which stores tuples of (CraftState, list_of_actions_taken).\n  q = collections.deque()\n  initial_state = env._current_state  # Get the current state of the CraftLab environment.\n  q.append((initial_state, [])) # Start with the initial state and an empty list of actions.\n\n  # Initialize a set to keep track of visited states to prevent cycles and redundant computation.\n  # A state is defined by the agent's grid, inventory, position, and direction.\n  # numpy arrays (grid, inventory) are not hashable, so convert them to bytes for set membership.\n  visited = set()\n  visited.add((initial_state.grid.tobytes(), initial_state.inventory.tobytes(),\n               initial_state.pos, initial_state.dir))\n\n  # Set the maximum depth for the BFS. This limit prevents infinite loops in large state spaces\n  # and ensures that the found path (if any) is within the episode's step limit.\n  # `env.max_steps` provides a natural upper bound for a successful episode.\n  max_bfs_depth = env.max_steps \n\n  while q:\n      current_state, actions_so_far = q.popleft() # Dequeue the next state and its action path.\n\n      # Check if the current state satisfies the goal (i.e., the desired item is in the inventory).\n      if current_state.satisfies(None, item):\n          return actions_so_far # Goal reached, return the sequence of actions that led to it.\n\n      # Pruning: If the current path length exceeds the maximum allowed BFS depth,\n      # stop exploring this path to avoid excessively long or impossible solutions.\n      if len(actions_so_far) >= max_bfs_depth:\n          continue\n\n      # Explore all possible actions from the current state.\n      for action in ACTIONS:\n          # Apply the action to get the next state.\n          # The `CraftState.step` method handles all game mechanics:\n          # movement, picking up items, and crafting (based on recipes, inventory, and workshops).\n          _, next_state = current_state.step(action) # The reward is not needed for pathfinding here.\n\n          # Create a hashable representation of the next state for the `visited` set.\n          next_state_tuple = (next_state.grid.tobytes(), next_state.inventory.tobytes(),\n                              next_state.pos, next_state.dir)\n\n          # If this next state has not been visited before, add it to the queue and `visited` set.\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple) # Mark the state as visited.\n              # Enqueue the new state along with the extended list of actions.\n              q.append((next_state, actions_so_far + [action]))\n\n  # If the queue becomes empty and the goal was never reached, it means no path was found\n  # within the specified `max_bfs_depth`.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:24:37.664596", "function_name": "craft", "function_body": "  # Action constants (standard for CraftWorld, defined locally for self-containment)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def _get_hashable_state(state):\n    \"\"\"Returns a hashable tuple representation of a CraftState.\"\"\"\n    return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n\n  def find_path_to_location_or_item(initial_state, target_kind_idx, world, target_is_grabbable=False):\n    \"\"\"\n    Finds a path of actions to reach a cell containing target_kind_idx.\n    If target_is_grabbable is True, it also includes the USE action to pick it up.\n\n    Args:\n        initial_state: CraftState object to start from.\n        target_kind_idx: The index of the entity kind (item or workshop) to reach/interact with.\n        world: CraftWorld instance to access its properties.\n        target_is_grabbable: If True, the goal is to pick up the item. If False,\n                             the goal is to be adjacent to the item (e.g., a workshop).\n\n    Returns:\n        A tuple (list_of_actions, final_state) or (None, None) if no path found.\n    \"\"\"\n    queue = deque([(initial_state, [])]) # (state, path_to_state)\n    visited = set()\n    visited.add(_get_hashable_state(initial_state))\n\n    movement_actions = [UP, DOWN, LEFT, RIGHT]\n\n    # BFS search\n    while queue:\n      current_state, current_path = queue.popleft()\n\n      # Check if the goal is met for this current_state\n      if target_is_grabbable:\n        # Goal: be next to target_kind_idx AND pick it up\n        if current_state.next_to(target_kind_idx):\n          # Try the USE action\n          reward, state_after_use = current_state.step(USE)\n          \n          # Check if the item was successfully acquired and it's a grabbable item\n          if target_kind_idx in world.grabbable_indices and \\\n             state_after_use.inventory[target_kind_idx] > current_state.inventory[target_kind_idx]:\n            return current_path + [USE], state_after_use\n      else: # Goal: simply be next to target_kind_idx (e.g., a workshop)\n        if current_state.next_to(target_kind_idx):\n          return current_path, current_state\n\n      # Explore neighbors by movement actions\n      for action in movement_actions:\n        # CraftState.step handles invalid moves (e.g., into walls), returning the same state.\n        # This is implicitly handled by `_get_hashable_state` which would then\n        # detect a visited state.\n        reward, next_state = current_state.step(action)\n        next_hash = _get_hashable_state(next_state)\n\n        if next_hash not in visited:\n          visited.add(next_hash)\n          queue.append((next_state, current_path + [action]))\n    \n    return None, None # No path found (or item cannot be acquired/reached)\n\n\n  def get_and_craft_item_recursive(goal_item_idx, current_st, cookbook, env_world):\n    \"\"\"\n    Recursively plans actions to acquire/craft a single goal_item_idx.\n    \n    Args:\n        goal_item_idx: The index of the item to acquire.\n        current_st: The CraftState object from which to start planning.\n        cookbook: Reference to env.world.cookbook.\n        env_world: Reference to env.world.\n\n    Returns:\n        A tuple (list_of_actions, resulting_state) or (None, None) if impossible.\n    \"\"\"\n    # Base case: if item is already in inventory\n    if current_st.inventory[goal_item_idx] > 0:\n      return [], current_st\n\n    # If it's a primitive, find it and pick it up\n    if goal_item_idx in cookbook.primitives:\n      path, final_st = find_path_to_location_or_item(current_st, goal_item_idx, env_world, target_is_grabbable=True)\n      if path is None:\n        return None, None # Cannot find primitive\n      return path, final_st\n\n    # If it's craftable (not a primitive, so it must have a recipe)\n    if goal_item_idx in cookbook.recipes:\n      recipe = cookbook.recipes[goal_item_idx]\n      workshop_idx = None\n      ingredients_needed = {}\n\n      # Determine workshop and ingredients from the recipe\n      for ing_idx_or_key, count in recipe.items():\n        if isinstance(ing_idx_or_key, str) and ing_idx_or_key.startswith('_key:'):\n          workshop_name = ing_idx_or_key.split(':')[1]\n          workshop_idx = cookbook.index[workshop_name]\n        else: # It's an ingredient index\n          ingredients_needed[ing_idx_or_key] = count\n\n      # Accumulate actions and the current state as we gather ingredients\n      temp_current_st = current_st\n      temp_path_acc = []\n      \n      # Iteratively gather all missing ingredients required for this recipe\n      while True:\n        missing_ingredient_found_in_this_loop = False\n        for ing_idx, needed_count in ingredients_needed.items():\n          if temp_current_st.inventory[ing_idx] < needed_count:\n            # Need to acquire this ingredient recursively\n            ing_path, ing_final_st = get_and_craft_item_recursive(ing_idx, temp_current_st, cookbook, env_world)\n            if ing_path is None:\n              return None, None # Cannot get this ingredient\n            \n            temp_path_acc.extend(ing_path)\n            temp_current_st = ing_final_st\n            missing_ingredient_found_in_this_loop = True\n            break # Break and re-check all ingredients after acquiring one\n        \n        if not missing_ingredient_found_in_this_loop:\n          break # All ingredients are satisfied\n\n      # Now, if a workshop is required, go to it\n      if workshop_idx is not None:\n        path_to_workshop, workshop_final_st = find_path_to_location_or_item(temp_current_st, workshop_idx, env_world, target_is_grabbable=False)\n        if path_to_workshop is None:\n          return None, None # Cannot reach workshop\n        temp_path_acc.extend(path_to_workshop)\n        temp_current_st = workshop_final_st\n\n      # Attempt to craft the item using the USE action\n      # The `step(USE)` function handles the crafting logic (checks ingredients, consumes them, produces output)\n      reward, final_st_after_craft = temp_current_st.step(USE)\n      \n      # Verify crafting success by checking if the goal item's inventory count increased\n      if final_st_after_craft.inventory[goal_item_idx] > temp_current_st.inventory[goal_item_idx]:\n        temp_path_acc.append(USE)\n        return temp_path_acc, final_st_after_craft\n      else:\n        # Crafting failed (e.g., not at the correct workshop, or another implicit condition not met)\n        return None, None\n\n    # If the item is neither a primitive nor has a recipe (e.g., an ungrabbable environment object),\n    # then it cannot be acquired by this planner.\n    return None, None\n\n\n  # Get the current state from the environment\n  # Assume `env._current_state` is available and holds the `CraftState` object.\n  current_state = env._current_state\n\n  # Check if the goal item is already in inventory\n  if current_state.inventory[item] > 0:\n    return []\n\n  # Start the planning process to acquire/craft the target item\n  planned_actions, _ = get_and_craft_item_recursive(item, current_state, env.world.cookbook, env.world)\n\n  if planned_actions is None:\n    return [] # Cannot craft the item\n  else:\n    return planned_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:24:37.683160", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Define actions and their deltas\n    ACTIONS = {\"DOWN\": 0, \"UP\": 1, \"LEFT\": 2, \"RIGHT\": 3, \"USE\": 4}\n    DELTAS = {\n        ACTIONS[\"DOWN\"]: (0, 1),  # (dx, dy) - assuming (0,0) is top-left, y increases downwards\n        ACTIONS[\"UP\"]: (0, -1),\n        ACTIONS[\"LEFT\"]: (-1, 0),\n        ACTIONS[\"RIGHT\"]: (1, 0),\n    }\n\n    def _bfs_pathfinding(start_state, target_kind_idx, world_ref, is_use_target=False):\n        \"\"\"\n        Finds a path from start_state.pos to a cell containing target_kind_idx,\n        or adjacent to it if is_use_target is True.\n        Returns (list_of_actions, new_state_after_path) or (None, None) if no path.\n        \"\"\"\n        initial_pos = start_state.pos\n        grid_shape = start_state.grid.shape\n        WIDTH, HEIGHT = grid_shape[0], grid_shape[1]\n\n        # Queue stores (position, current_state_copy, actions_taken_to_reach_pos)\n        # We pass a copy of the state so that the simulation within BFS doesn't\n        # interfere with the state from which BFS was called.\n        q = collections.deque([(initial_pos, start_state, [])])\n        visited = {initial_pos} # Set of (x,y) tuples\n\n        # Precompute target cells (cells containing target_kind_idx)\n        target_cells_in_grid = np.argwhere(start_state.grid[:, :, target_kind_idx] > 0)\n        if len(target_cells_in_grid) == 0:\n            return None, None # Target not on grid\n\n        target_coords_set = {tuple(p) for p in target_cells_in_grid}\n\n        # Helper to check if a cell is traversable/valid for movement\n        def is_traversable(x, y, current_sim_state_grid):\n            if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n                return False # Out of bounds\n\n            # A cell is traversable if it does not contain any non-grabbable item.\n            # Agent can only move onto empty cells or cells with grabbable items.\n            for k_idx in world_ref.non_grabbable_indices:\n                if current_sim_state_grid[x, y, k_idx] > 0:\n                    return False # Cell contains a non-grabbable item, thus is an obstacle.\n            return True # Cell is either empty or contains only grabbable items (which are picked up).\n\n\n        while q:\n            (curr_x, curr_y), curr_sim_state, curr_actions = q.popleft()\n\n            # Check if current position satisfies target condition\n            target_reached = False\n            if is_use_target: # Target is for USE, so we need to be adjacent.\n                for tx, ty in target_coords_set:\n                    # Manhattan distance of 1 means adjacent (N, S, E, W)\n                    if abs(curr_x - tx) + abs(curr_y - ty) == 1:\n                        target_reached = True\n                        break\n            else: # Target is grabbable, so we need to be on the same cell.\n                if (curr_x, curr_y) in target_coords_set:\n                    target_reached = True\n            \n            if target_reached:\n                return curr_actions, curr_sim_state\n\n            # Explore neighbors\n            for action_move, (dx, dy) in DELTAS.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                # Check if next_pos is valid and not visited\n                if next_pos not in visited and is_traversable(next_x, next_y, curr_sim_state.grid):\n                    # Simulate step to get new state and check for pick-ups.\n                    # CraftState.step returns a *new* state instance.\n                    reward, next_sim_state = curr_sim_state.step(action_move)\n                    visited.add(next_pos)\n                    q.append((next_pos, next_sim_state, curr_actions + [action_move]))\n\n        return None, None # No path found\n\n    def _get_actions_to_have(current_state_in, item_idx, desired_count, world_ref):\n        \"\"\"\n        Recursively finds actions to get desired_count of item_idx.\n        Returns (list_of_actions, new_state) or (None, None) if impossible.\n        `current_state_in` is the state before attempting to get `item_idx`.\n        The returned `new_state` reflects the state after all actions are applied.\n        \"\"\"\n        current_state = current_state_in # The state will be updated as actions are performed\n        current_actions = []\n\n        if current_state.inventory[item_idx] >= desired_count:\n            return [], current_state\n\n        is_primitive = item_idx in world_ref.cookbook.primitives\n        is_environment_resource = item_idx in world_ref.cookbook.environment # like tree, water\n        is_grabbable = item_idx in world_ref.grabbable_indices # Items picked up by moving onto them\n\n        if is_primitive or is_environment_resource:\n            # Determine if it's a \"USE\" type gatherable (e.g., Tree, Water, Plant, Stone)\n            # These are typically in non_grabbable_indices and also in primitives/environment.\n            requires_use = item_idx in world_ref.non_grabbable_indices\n\n            while current_state.inventory[item_idx] < desired_count:\n                if requires_use:\n                    # For non-grabbable gatherable items, agent needs to move adjacent and USE.\n                    path_actions, new_state = _bfs_pathfinding(current_state, item_idx, world_ref, is_use_target=True)\n                    if path_actions is None:\n                        return None, None # Cannot reach item or no more found\n                    current_actions.extend(path_actions)\n                    current_state = new_state\n\n                    # Now agent is adjacent. Perform USE actions.\n                    # Each USE action typically yields 1 item (or more, but problem implies simple yields).\n                    # We loop until desired_count is met.\n                    reward, new_state = current_state.step(ACTIONS[\"USE\"])\n                    current_actions.append(ACTIONS[\"USE\"])\n                    current_state = new_state\n                else:\n                    # For grabbable items, agent moves onto the tile; pickup is automatic.\n                    path_actions, new_state = _bfs_pathfinding(current_state, item_idx, world_ref, is_use_target=False)\n                    if path_actions is None:\n                        return None, None # Cannot find more items\n                    current_actions.extend(path_actions)\n                    current_state = new_state\n            \n            return current_actions, current_state\n\n        else: # Item is craftable\n            recipe = world_ref.cookbook.recipes.get(item_idx)\n            if not recipe:\n                return None, None # Invalid item / no recipe\n\n            # Determine how many times we need to craft this `item_idx`\n            num_crafts_needed = max(0, desired_count - current_state.inventory[item_idx])\n\n            if num_crafts_needed == 0:\n                return [], current_state\n\n            # Gather all ingredients needed for `num_crafts_needed` crafts first.\n            # This is done by recursively calling _get_actions_to_have for each ingredient.\n            # The state `state_after_ingredients_collection` is updated iteratively.\n            state_after_ingredients_collection = current_state\n\n            for ingredient_idx, count_needed_per_craft in recipe.items():\n                if ingredient_idx == '_key':\n                    continue\n\n                # Recursively get the total required amount of this ingredient.\n                # The total needed is `count_needed_per_craft` multiplied by `num_crafts_needed`.\n                ing_actions, updated_state = _get_actions_to_have(\n                    state_after_ingredients_collection, ingredient_idx,\n                    count_needed_per_craft * num_crafts_needed, world_ref\n                )\n                if ing_actions is None:\n                    return None, None # Cannot get ingredient\n                current_actions.extend(ing_actions)\n                state_after_ingredients_collection = updated_state\n            \n            # Update the main `current_state` with the result of ingredient gathering\n            current_state = state_after_ingredients_collection\n\n            # Go to workshop (if any)\n            workshop_idx = None\n            if '_key' in recipe:\n                workshop_name = recipe['_key']\n                workshop_idx = world_ref.cookbook.index.get(workshop_name)\n                if workshop_idx is None:\n                    return None, None # Unknown workshop type\n\n                # Pathfind to a cell adjacent to the workshop\n                path_actions, new_state = _bfs_pathfinding(current_state, workshop_idx, world_ref, is_use_target=True)\n                if path_actions is None:\n                    return None, None # Cannot reach workshop\n                current_actions.extend(path_actions)\n                current_state = new_state\n\n            # Perform USE action to craft `num_crafts_needed` times\n            for _ in range(num_crafts_needed):\n                reward, new_state = current_state.step(ACTIONS[\"USE\"])\n                current_actions.append(ACTIONS[\"USE\"])\n                current_state = new_state\n\n            return current_actions, current_state\n\n    # Main logic for craft_v2 starts here\n    initial_state = env._current_state\n    world = env.world # Reference to the CraftWorld instance\n\n    # If the item is already in inventory, no actions are needed.\n    if initial_state.inventory[item] > 0:\n        return []\n\n    # Call the recursive planner to get 1 unit of the desired item.\n    # The `_get_actions_to_have` function will recursively resolve dependencies,\n    # collect ingredients, and perform crafting steps.\n    actions, final_state = _get_actions_to_have(initial_state, item, 1, world)\n\n    if actions is None:\n        # If actions is None, it means the item cannot be crafted/found based on current logic.\n        return [] # Return empty list indicating impossibility for this problem context.\n    return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:27:33.703687", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # The problem statement implies that `env_factory.Actions` and other constants\n    # (like WIDTH, HEIGHT if needed for internal calculations, though not directly used here)\n    # are accessible from the environment where this function is called.\n    # Therefore, we assume `env_factory.Actions.DOWN.value`, etc., are valid.\n\n    def _find_path_to_adjacent_or_target(\n        start_craft_state, target_kind_idx\n    ):\n        \"\"\"\n        Performs a Breadth-First Search (BFS) on the grid to find a path to a cell\n        adjacent to `target_kind_idx` (for primitives) or to a workshop.\n\n        Args:\n            start_craft_state: The CraftState to start the search from.\n            target_kind_idx: The index of the item/workshop to reach.\n\n        Returns:\n            A list of actions to reach the adjacent/target location, or None if no path is found.\n            This list *does not* include the final USE action.\n        \"\"\"\n        _queue = collections.deque([(start_craft_state, [])])\n        # Visited state includes (pos, dir) to prevent redundant movement paths and cycles.\n        _visited = set([(start_craft_state.pos, start_craft_state.dir)])\n\n        _MOVE_ACTIONS = [\n            env_factory.Actions.DOWN.value,\n            env_factory.Actions.UP.value,\n            env_factory.Actions.LEFT.value,\n            env_factory.Actions.RIGHT.value,\n        ]\n\n        while _queue:\n            _current_state, _current_actions = _queue.popleft()\n\n            # Check if we are adjacent to the target_kind_idx\n            if _current_state.next_to(target_kind_idx):\n                return _current_actions  # Path found, return actions to get there\n\n            # Explore possible next states (move actions)\n            for _action in _MOVE_ACTIONS:\n                # Simulate the step to get the next state\n                # CraftState.step returns a new CraftState object, not modifying in place.\n                _, _next_state = _current_state.step(_action)\n                _next_pos = _next_state.pos\n                _next_dir = _next_state.dir\n\n                if (_next_pos, _next_dir) not in _visited:\n                    _visited.add((_next_pos, _next_dir))\n                    _queue.append((_next_state, _current_actions + [_action]))\n\n        return None  # No path found\n\n    world = env.world\n    cookbook = world.cookbook\n    goal_item_idx = item\n\n    all_actions = []\n\n    # Reset the environment to a known initial state\n    # env.reset() returns an observation dict, but importantly\n    # it updates env._current_state, which we need to track.\n    _ = env.reset(seed=0)  # Reset with a fixed seed for reproducibility\n    current_craft_state = env._current_state\n\n    # Safety limit to prevent infinite loops in complex or potentially unsolvable scenarios\n    max_overall_actions = 500\n\n    action_count = 0\n    # Loop until the goal item is in the inventory or the action limit is reached\n    while current_craft_state.inventory[goal_item_idx] == 0 and action_count < max_overall_actions:\n        progress_made_in_iteration = False\n\n        # Phase 1: Collect Missing Primitives\n        # Determine what primitives are ultimately needed for the goal\n        needed_primitives = cookbook.primitives_for(goal_item_idx)\n        \n        # Identify which primitives are currently missing from the inventory\n        current_missing_primitives = []\n        for p_idx, required_count in needed_primitives.items():\n            if current_craft_state.inventory[p_idx] < required_count:\n                current_missing_primitives.append(p_idx)\n\n        if current_missing_primitives:\n            # For simplicity, try to collect the first missing primitive found.\n            # A more sophisticated planner might prioritize based on distance or complexity.\n            p_to_collect = current_missing_primitives[0]\n            \n            path_to_primitive_adj = _find_path_to_adjacent_or_target(\n                current_craft_state, p_to_collect\n            )\n            \n            if path_to_primitive_adj:\n                # Apply pathfinding actions to the environment\n                for action in path_to_primitive_adj:\n                    _, _, _ = env.step(action)\n                    all_actions.append(action)\n                    action_count += 1\n                    current_craft_state = env._current_state  # Update current state\n\n                # After moving adjacent, apply the USE action to collect the primitive\n                _, _, _ = env.step(env_factory.Actions.USE.value)\n                all_actions.append(env_factory.Actions.USE.value)\n                action_count += 1\n                current_craft_state = env._current_state\n                \n                progress_made_in_iteration = True\n                # A primitive was collected, re-evaluate needs in the next loop iteration\n                continue  \n\n        # Phase 2: Craft Items\n        # If no primitive was collected (or all needed for now are collected), try crafting.\n        \n        craftable_items = []\n        # Iterate through all recipes to find what can be crafted\n        for output_idx, recipe in cookbook.recipes.items():\n            # If it's the goal item and we already have it, no need to craft again\n            if output_idx == goal_item_idx and current_craft_state.inventory[output_idx] > 0:\n                continue\n\n            # Check if all ingredients for this recipe are available in the inventory\n            all_ingredients_available = True\n            for ing_idx, count in recipe.items():\n                if ing_idx == \"_key\": # Skip the workshop key\n                    continue\n                if current_craft_state.inventory[ing_idx] < count:\n                    all_ingredients_available = False\n                    break\n            \n            if all_ingredients_available:\n                # Prioritize the goal item if it can be crafted\n                if output_idx == goal_item_idx:\n                    craftable_items.insert(0, output_idx) # Insert at front for highest priority\n                else:\n                    craftable_items.append(output_idx) # Add other craftable items\n\n        if craftable_items:\n            # Craft the highest priority item (goal first, then others)\n            item_to_craft_idx = craftable_items[0]\n            recipe = cookbook.recipes[item_to_craft_idx]\n            workshop_key = recipe.get(\"_key\")\n            \n            actions_to_perform_craft = None\n            if workshop_key:\n                # If a workshop is required, find path to it\n                workshop_idx = cookbook.index[workshop_key]\n                path_to_workshop_adj = _find_path_to_adjacent_or_target(\n                    current_craft_state, workshop_idx\n                )\n                if path_to_workshop_adj:\n                    actions_to_perform_craft = path_to_workshop_adj + [env_factory.Actions.USE.value]\n            else: \n                # No specific workshop required, just apply USE from current location\n                actions_to_perform_craft = [env_factory.Actions.USE.value]\n            \n            if actions_to_perform_craft:\n                # Apply the actions (move to workshop + USE)\n                for action in actions_to_perform_craft:\n                    _, _, _ = env.step(action)\n                    all_actions.append(action)\n                    action_count += 1\n                    current_craft_state = env._current_state\n                \n                progress_made_in_iteration = True\n                continue  # Crafted something, re-evaluate in the next loop iteration\n\n        # If no progress was made in this entire iteration (neither collected a primitive nor crafted an item)\n        if not progress_made_in_iteration:\n            # This indicates that we are stuck or cannot achieve the goal with current resources/logic.\n            break # Exit the main loop\n\n    # After the loop, check if the goal was achieved\n    if current_craft_state.inventory[goal_item_idx] > 0:\n        return all_actions\n    else:\n        return [] # Goal not achieved, return empty list", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:27:35.313879", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants based on the prompt's action_specs\n  _DOWN = 0  # Move forward\n  _UP_TURN_LEFT = 1  # Turn left (counter-clockwise)\n  _LEFT_TURN_RIGHT = 2  # Turn right (clockwise)\n  _RIGHT_TURN_180 = 3  # Turn 180 degrees\n  _USE = 4  # Use/Interact\n\n  # Direction deltas (row, col) for moving forward based on current direction\n  # 0: EAST, 1: NORTH, 2: WEST, 3: SOUTH (standard DMLab)\n  _DIR_DELTAS = {\n      0: (0, 1),   # EAST (col + 1)\n      1: (-1, 0),  # NORTH (row - 1)\n      2: (0, -1),  # WEST (col - 1)\n      3: (1, 0)    # SOUTH (row + 1)\n  }\n\n  # Turn actions mapping (current_dir, target_dir) -> list of actions\n  _TURN_ACTIONS = {\n      (0, 0): [],                                   # E -> E\n      (0, 1): [_UP_TURN_LEFT],                       # E -> N (turn left)\n      (0, 2): [_UP_TURN_LEFT, _UP_TURN_LEFT],       # E -> W (turn left twice)\n      (0, 3): [_LEFT_TURN_RIGHT],                    # E -> S (turn right)\n\n      (1, 0): [_LEFT_TURN_RIGHT],                   # N -> E (turn right)\n      (1, 1): [],                                   # N -> N\n      (1, 2): [_UP_TURN_LEFT],                       # N -> W (turn left)\n      (1, 3): [_UP_TURN_LEFT, _UP_TURN_LEFT],       # N -> S (turn left twice)\n\n      (2, 0): [_UP_TURN_LEFT, _UP_TURN_LEFT],       # W -> E (turn left twice)\n      (2, 1): [_LEFT_TURN_RIGHT],                   # W -> N (turn right)\n      (2, 2): [],                                   # W -> W\n      (2, 3): [_UP_TURN_LEFT],                       # W -> S (turn left)\n\n      (3, 0): [_UP_TURN_LEFT],                       # S -> E (turn left)\n      (3, 1): [_UP_TURN_LEFT, _UP_TURN_LEFT],       # S -> N (turn left twice)\n      (3, 2): [_LEFT_TURN_RIGHT],                   # S -> W (turn right)\n      (3, 3): []                                    # S -> S\n  }\n\n\n  def _apply_action_to_state_simplified(current_state, action_constant, item_for_use_logic=None):\n      \"\"\"\n      Simulates applying a single action to a CraftState.\n      Returns a new CraftState instance. This is a simplified, internal simulation.\n      item_for_use_logic: If _USE is called at a workshop, this is the specific item we intend to craft.\n                          If None, it implies primitive collection or general interaction.\n      \"\"\"\n      grid = current_state.grid.copy()\n      pos = current_state.pos\n      direction = current_state.dir\n      inventory = current_state.inventory.copy()\n      world = current_state.world\n      cookbook = world.cookbook\n\n      H, W, K = grid.shape\n\n      if action_constant == _DOWN:  # Move forward\n          new_r, new_c = pos[0] + _DIR_DELTAS[direction][0], pos[1] + _DIR_DELTAS[direction][1]\n          if 0 <= new_r < H and 0 <= new_c < W:\n              is_blocking = False\n              # A cell is blocking if it contains any non-grabbable item that is not a workshop\n              # Also, water is blocking unless the water item itself is the target for USE.\n              for k_idx in world.non_grabbable_indices:\n                  if k_idx not in world.workshop_indices and grid[new_r, new_c, k_idx] > 0:\n                      is_blocking = True\n                      break\n              if grid[new_r, new_c, world.water_index] > 0 and world.water_index != item_for_use_logic:\n                  is_blocking = True\n\n              if not is_blocking:\n                  pos = (new_r, new_c)\n      elif action_constant == _UP_TURN_LEFT:\n          direction = (direction + 1) % 4\n      elif action_constant == _LEFT_TURN_RIGHT:\n          direction = (direction - 1 + 4) % 4\n      elif action_constant == _RIGHT_TURN_180:\n          direction = (direction + 2) % 4\n      elif action_constant == _USE:\n          facing_r, facing_c = pos[0] + _DIR_DELTAS[direction][0], pos[1] + _DIR_DELTAS[direction][1]\n\n          if 0 <= facing_r < H and 0 <= facing_c < W:\n              # Prioritize primitive collection if facing a primitive\n              collected_primitive = False\n              for k_idx in world.primitives:\n                  if grid[facing_r, facing_c, k_idx] > 0:\n                      inventory[k_idx] += 1\n                      grid[facing_r, facing_c, k_idx] -= 1  # Remove from grid\n                      collected_primitive = True\n                      break\n              if collected_primitive:\n                  pass  # Primitive collected, done with _USE action for this step\n\n              # If not a primitive, check for workshop interaction and crafting IF item_for_use_logic is provided\n              else:\n                  is_facing_workshop = False\n                  for w_idx in world.workshop_indices:\n                      if grid[facing_r, facing_c, w_idx] > 0:\n                          is_facing_workshop = True\n                          break\n\n                  if is_facing_workshop and item_for_use_logic is not None:\n                      target_recipe = cookbook.recipes.get(item_for_use_logic)\n                      if target_recipe:\n                          can_craft = True\n                          for ing_name_str, count in target_recipe.items():\n                              if ing_name_str == '_key':  # Ignore metadata\n                                  continue\n                              ing_idx = cookbook.index.index(ing_name_str)\n                              if inventory[ing_idx] < count:\n                                  can_craft = False\n                                  break\n\n                          if can_craft:\n                              # Consume ingredients\n                              for ing_name_str, count in target_recipe.items():\n                                  if ing_name_str == '_key':\n                                      continue\n                                  ing_idx = cookbook.index.index(ing_name_str)\n                                  inventory[ing_idx] -= count\n                              # Produce output\n                              inventory[item_for_use_logic] += 1\n                              # Item crafted, done with _USE action for this step\n\n      new_state = type(current_state)(\n          scenario=current_state.scenario,\n          grid=grid,\n          pos=pos,\n          dir=direction,\n          inventory=inventory\n      )\n      return new_state\n\n\n  def _get_path_and_sim_state(current_state, target_pos, world, cookbook, item_for_use_logic=None):\n      \"\"\"\n      Finds the shortest path of cells from current_state.pos to target_pos using BFS.\n      Returns the actions to take along that path, and the simulated final state after moves.\n      item_for_use_logic: Passed to _apply_action_to_state_simplified for correct blocking/USE logic.\n      \"\"\"\n      grid_h, grid_w, _ = current_state.grid.shape\n\n      path_cells_q = collections.deque([(current_state.pos, [current_state.pos])])\n      path_cells_visited = {current_state.pos}\n\n      target_path = None\n\n      while path_cells_q:\n          curr_cell, path = path_cells_q.popleft()\n\n          if curr_cell == target_pos:\n              target_path = path\n              break\n\n          # Explore 4 neighbors\n          for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              next_r, next_c = curr_cell[0] + dr, curr_cell[1] + dc\n              next_cell = (next_r, next_c)\n\n              if 0 <= next_r < grid_h and 0 <= next_c < grid_w and next_cell not in path_cells_visited:\n                  is_blocking = False\n                  for k_idx in world.non_grabbable_indices:\n                      if k_idx not in world.workshop_indices and current_state.grid[next_r, next_c, k_idx] > 0:\n                          is_blocking = True\n                          break\n                  if current_state.grid[next_r, next_c, world.water_index] > 0 and world.water_index != item_for_use_logic:\n                      is_blocking = True\n\n                  if not is_blocking:\n                      path_cells_visited.add(next_cell)\n                      path_cells_q.append((next_cell, path + [next_cell]))\n\n      if not target_path:\n          return [], current_state  # No path found\n\n      # Convert cell path to actions and simulate state\n      sim_state = current_state\n      path_actions = []\n\n      for i in range(1, len(target_path)):\n          next_cell = target_path[i]\n\n          dr, dc = next_cell[0] - sim_state.pos[0], next_cell[1] - sim_state.pos[1]\n\n          target_dir_for_move = -1\n          if dr == 0 and dc == 1:\n              target_dir_for_move = 0  # EAST\n          elif dr == -1 and dc == 0:\n              target_dir_for_move = 1  # NORTH\n          elif dr == 0 and dc == -1:\n              target_dir_for_move = 2  # WEST\n          elif dr == 1 and dc == 0:\n              target_dir_for_move = 3  # SOUTH\n\n          if target_dir_for_move != -1:\n              turn_sequence = _TURN_ACTIONS[(sim_state.dir, target_dir_for_move)]\n              for action in turn_sequence:\n                  path_actions.append(action)\n                  sim_state = _apply_action_to_state_simplified(sim_state, action, item_for_use_logic)\n\n              path_actions.append(_DOWN)\n              sim_state = _apply_action_to_state_simplified(sim_state, _DOWN, item_for_use_logic)\n          else:\n              return [], current_state  # Should not happen for a valid path\n\n      return path_actions, sim_state\n\n\n  def _face_and_use_actions(current_sim_state, target_entity_pos, item_for_use_logic=None):\n      \"\"\"\n      Generates actions to face target_entity_pos (if adjacent) and then USE.\n      Returns actions and new simulated state.\n      \"\"\"\n      actions = []\n      sim_state = current_sim_state\n\n      dr = target_entity_pos[0] - sim_state.pos[0]\n      dc = target_entity_pos[1] - sim_state.pos[1]\n\n      target_dir = -1\n      if dr == 0 and dc == 1:\n          target_dir = 0  # EAST\n      elif dr == -1 and dc == 0:\n          target_dir = 1  # NORTH\n      elif dr == 0 and dc == -1:\n          target_dir = 2  # WEST\n      elif dr == 1 and dc == 0:\n          target_dir = 3  # SOUTH\n\n      if target_dir != -1:  # Agent must be adjacent to the target\n          turn_sequence = _TURN_ACTIONS[(sim_state.dir, target_dir)]\n          for action in turn_sequence:\n              actions.append(action)\n              sim_state = _apply_action_to_state_simplified(sim_state, action, item_for_use_logic)\n\n          actions.append(_USE)\n          sim_state = _apply_action_to_state_simplified(sim_state, _USE, item_for_use_logic)\n\n      return actions, sim_state\n\n  # --- Main Crafting Logic ---\n  all_actions = []\n\n  # Get the initial CraftState from the environment wrapper\n  current_state = env._current_state\n\n  # Check if goal is already satisfied\n  if current_state.inventory[item] > 0:\n      return []\n\n  cookbook = env.world.cookbook\n  world = env.world\n\n\n  # Recursive function to gather ingredients and craft\n  def _plan_and_execute_recursive(current_sim_state, target_item_idx, total_actions_list):\n      \"\"\"\n      Recursively plans actions to obtain target_item_idx.\n      Modifies total_actions_list and returns the updated simulated state and success status.\n      \"\"\"\n      # Base case: if target_item_idx is already in inventory in the current simulation\n      if current_sim_state.inventory[target_item_idx] > 0:\n          return current_sim_state, True\n\n      # If it's a primitive, collect it\n      if target_item_idx in cookbook.primitives:\n          # Find the closest location on the grid that contains the primitive.\n          # We need to find a cell adjacent to the primitive location.\n          grid_h, grid_w, _ = current_sim_state.grid.shape\n          closest_adj_pos_to_primitive = None\n          actual_primitive_pos = None\n\n          q_bfs = collections.deque([(current_sim_state.pos, [])])  # (cell, path_from_agent_to_cell)\n          visited_bfs = {current_sim_state.pos}\n\n          while q_bfs:\n              (r, c), path_cells = q_bfs.popleft()\n\n              # Check if this cell (r,c) is adjacent to a primitive\n              for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  adj_r, adj_c = r + dr, c + dc\n                  if 0 <= adj_r < grid_h and 0 <= adj_c < grid_w and current_sim_state.grid[adj_r, adj_c, target_item_idx] > 0:\n                      closest_adj_pos_to_primitive = (r, c)\n                      actual_primitive_pos = (adj_r, adj_c)\n                      break\n              if closest_adj_pos_to_primitive:\n                  break\n\n              # Explore neighbors for pathfinding\n              for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  next_r, next_c = r + dr, c + dc\n                  next_cell = (next_r, next_c)\n                  if 0 <= next_r < grid_h and 0 <= next_c < grid_w and next_cell not in visited_bfs:\n                      # Check traversability. Water is blocking unless we are specifically targeting it for collection.\n                      is_blocking = False\n                      for k_idx in world.non_grabbable_indices:\n                          if k_idx not in world.workshop_indices and current_sim_state.grid[next_r, next_c, k_idx] > 0:\n                              is_blocking = True\n                              break\n                      if current_sim_state.grid[next_r, next_c, world.water_index] > 0 and world.water_index != target_item_idx:\n                          is_blocking = True\n\n                      if not is_blocking:\n                          visited_bfs.add(next_cell)\n                          q_bfs.append((next_cell, path_cells + [next_cell]))\n          \n          if not closest_adj_pos_to_primitive:\n              return current_sim_state, False  # Cannot find the primitive\n\n          # 1. Move to the position adjacent to the primitive\n          move_actions, current_sim_state = _get_path_and_sim_state(\n              current_sim_state, closest_adj_pos_to_primitive, world, cookbook, item_for_use_logic=target_item_idx\n          )\n          total_actions_list.extend(move_actions)\n\n          # 2. Face the primitive and _USE to collect it\n          # Pass target_item_idx to _face_and_use_actions as item_for_use_logic for collection logic.\n          face_use_actions, current_sim_state = _face_and_use_actions(\n              current_sim_state, actual_primitive_pos, item_for_use_logic=target_item_idx\n          )\n          total_actions_list.extend(face_use_actions)\n\n          return current_sim_state, True\n\n      # If it's a craftable item, first get ingredients then craft\n      if target_item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[target_item_idx]\n\n          # Recursively ensure all ingredients are in inventory\n          for ing_name_str, count_needed in recipe.items():\n              if ing_name_str == '_key':\n                  continue\n              ing_idx = cookbook.index.index(ing_name_str)\n\n              while current_sim_state.inventory[ing_idx] < count_needed:\n                  current_sim_state, success = _plan_and_execute_recursive(current_sim_state, ing_idx, total_actions_list)\n                  if not success:\n                      return current_sim_state, False  # Cannot get ingredient\n\n          # After getting all ingredients, find a workshop and craft\n          grid_h, grid_w, _ = current_sim_state.grid.shape\n          closest_adj_pos_to_workshop = None\n          actual_workshop_pos = None\n\n          q_bfs = collections.deque([(current_sim_state.pos, [])])\n          visited_bfs = {current_sim_state.pos}\n\n          while q_bfs:\n              (r, c), path_cells = q_bfs.popleft()\n\n              # Check if this cell is adjacent to a workshop\n              for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  adj_r, adj_c = r + dr, c + dc\n                  if 0 <= adj_r < grid_h and 0 <= adj_c < grid_w:\n                      for w_idx in world.workshop_indices:\n                          if current_sim_state.grid[adj_r, adj_c, w_idx] > 0:\n                              closest_adj_pos_to_workshop = (r, c)\n                              actual_workshop_pos = (adj_r, adj_c)\n                              break\n                      if closest_adj_pos_to_workshop:\n                          break\n              if closest_adj_pos_to_workshop:\n                  break\n\n              # Explore neighbors for pathfinding\n              for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                  next_r, next_c = r + dr, c + dc\n                  next_cell = (next_r, next_c)\n                  if 0 <= next_r < grid_h and 0 <= next_c < grid_w and next_cell not in visited_bfs:\n                      is_blocking = False\n                      for k_idx in world.non_grabbable_indices:\n                          if k_idx not in world.workshop_indices and current_sim_state.grid[next_r, next_c, k_idx] > 0:\n                              is_blocking = True\n                              break\n                      if current_sim_state.grid[next_r, next_c, world.water_index] > 0 and world.water_index != target_item_idx:\n                          is_blocking = True\n\n                      if not is_blocking:\n                          visited_bfs.add(next_cell)\n                          q_bfs.append((next_cell, path_cells + [next_cell]))\n\n          if not closest_adj_pos_to_workshop:\n              return current_sim_state, False  # Cannot find a workshop\n\n          # 1. Move to the position adjacent to the workshop\n          move_actions, current_sim_state = _get_path_and_sim_state(\n              current_sim_state, closest_adj_pos_to_workshop, world, cookbook, item_for_use_logic=target_item_idx\n          )\n          total_actions_list.extend(move_actions)\n\n          # 2. Face the workshop and _USE to craft\n          # Pass target_item_idx to _face_and_use_actions as item_for_use_logic for crafting logic.\n          face_use_actions, current_sim_state = _face_and_use_actions(\n              current_sim_state, actual_workshop_pos, item_for_use_logic=target_item_idx\n          )\n          total_actions_list.extend(face_use_actions)\n\n          return current_sim_state, True\n\n      # If not primitive and not craftable (e.g., environment item that can't be collected/crafted)\n      return current_sim_state, False\n\n\n  # Start the planning process for the target 'item'\n  final_sim_state, success = _plan_and_execute_recursive(current_state, item, all_actions)\n\n  # Check if the goal was successfully met in the simulation\n  if not success or final_sim_state.inventory[item] == 0:\n      # If the goal wasn't met, return an empty list or raise an error.\n      # For this problem, an empty list indicates failure to plan.\n      return []\n\n  return all_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:30:00.326015", "function_name": "craft", "function_body": "    current_state = env._current_state\n    world = env.world\n    cookbook = world.cookbook\n\n    # Action constants\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Direction vectors for agent facing (0:down, 1:up, 2:left, 3:right)\n    DIR_TO_VEC = {\n        0: (1, 0),   # Down: (row+1, col)\n        1: (-1, 0),  # Up: (row-1, col)\n        2: (0, -1),  # Left: (row, col-1)\n        3: (0, 1)    # Right: (row, col+1)\n    }\n\n    def _get_new_pos_dir(current_pos, current_dir, action):\n        \"\"\"Calculates new position and direction after a movement action.\"\"\"\n        r, c = current_pos\n        next_r, next_c = r, c\n        next_dir = current_dir\n\n        if action == ACTION_DOWN:\n            next_r += 1\n            next_dir = 0\n        elif action == ACTION_UP:\n            next_r -= 1\n            next_dir = 1\n        elif action == ACTION_LEFT:\n            next_c -= 1\n            next_dir = 2\n        elif action == ACTION_RIGHT:\n            next_c += 1\n            next_dir = 3\n        return (next_r, next_c), next_dir\n\n    def _is_valid_pos(pos, grid_shape):\n        \"\"\"Checks if a given position is within the grid boundaries.\"\"\"\n        r, c = pos\n        WIDTH, HEIGHT, _ = grid_shape\n        return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n    def _bfs_path_to_target_facing(initial_pos, initial_dir, initial_grid, target_kind_idx):\n        \"\"\"\n        Performs BFS to find a path to a position where the agent is facing\n        the target_kind_idx.\n        Returns a list of movement actions.\n        \"\"\"\n        WIDTH, HEIGHT, _ = initial_grid.shape\n\n        q = collections.deque([\n            ((initial_pos, initial_dir), []) # ((pos, dir), actions_taken)\n        ])\n        visited = set([\n            (initial_pos, initial_dir)\n        ])\n\n        while q:\n            (current_pos, current_dir), path_actions = q.popleft()\n\n            # Determine the cell the agent is currently facing\n            facing_dr, facing_dc = DIR_TO_VEC[current_dir]\n            facing_pos = (current_pos[0] + facing_dr, current_pos[1] + facing_dc)\n\n            # Check if the facing cell contains the target kind\n            if _is_valid_pos(facing_pos, initial_grid.shape) and \\\n               initial_grid[facing_pos[0], facing_pos[1], target_kind_idx] > 0:\n                return path_actions # Found path to face the target!\n\n            # Explore movement actions\n            for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n                next_pos, next_dir = _get_new_pos_dir(current_pos, current_dir, action)\n\n                if not _is_valid_pos(next_pos, initial_grid.shape):\n                    continue\n\n                next_state_key = (next_pos, next_dir)\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    new_path_actions = path_actions + [action]\n                    q.append((next_state_key, new_path_actions))\n\n        return None # Path not found\n\n    def _get_item_count(state, item_idx):\n        \"\"\"Returns the count of an item in the current state's inventory.\"\"\"\n        if item_idx < len(state.inventory): # Ensure index is valid\n            return state.inventory[item_idx]\n        return 0\n\n    def _recursive_craft_v2(current_state_sim, target_item_idx, max_depth=10, depth=0):\n        \"\"\"\n        Recursively determines actions to acquire an item.\n        Returns (success_bool, final_state, actions_taken_for_this_call).\n        `final_state` is the state *after* successfully acquiring the item.\n        `actions_taken_for_this_call` is the list of actions performed to get *this* item.\n        \"\"\"\n        # Base case: Max depth reached (to prevent infinite recursion)\n        if depth > max_depth:\n            return False, current_state_sim, []\n\n        actions_taken_for_this_call = []\n\n        # Check if target_item_idx is a primitive resource\n        if target_item_idx in world.primitives:\n            path_actions = _bfs_path_to_target_facing(\n                current_state_sim.pos, current_state_sim.dir, current_state_sim.grid,\n                target_item_idx\n            )\n            if path_actions is None:\n                return False, current_state_sim, []\n\n            actions_taken_for_this_call.extend(path_actions)\n            # Simulate actions to update current_state_sim\n            for action in path_actions:\n                _, current_state_sim = current_state_sim.step(action)\n\n            # Perform USE action\n            actions_taken_for_this_call.append(ACTION_USE)\n            original_count = _get_item_count(current_state_sim, target_item_idx)\n            _, current_state_sim = current_state_sim.step(ACTION_USE)\n            \n            # Check if USE was successful (inventory increased)\n            if _get_item_count(current_state_sim, target_item_idx) <= original_count:\n                return False, current_state_sim, []\n\n            return True, current_state_sim, actions_taken_for_this_call\n\n        # Otherwise, it's a crafted item\n        recipe = cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            return False, current_state_sim, []\n\n        ingredients_needed = {}\n        workshop_kind = None\n        for ingredient_idx, count in recipe.items():\n            if ingredient_idx == \"_key\":\n                workshop_kind = count # \"_key\" holds the index of the workshop\n            else:\n                ingredients_needed[ingredient_idx] = count\n\n        # Recursively acquire all ingredients\n        for ingredient_idx, needed_count in ingredients_needed.items():\n            current_have = _get_item_count(current_state_sim, ingredient_idx)\n            for _ in range(needed_count - current_have): # Collect only what's missing\n                success, new_state_sim, sub_actions = _recursive_craft_v2(\n                    current_state_sim, ingredient_idx, max_depth, depth + 1\n                )\n                if not success:\n                    return False, current_state_sim, [] # Return original state for this branch\n                current_state_sim = new_state_sim # Update state with collected ingredient\n                actions_taken_for_this_call.extend(sub_actions)\n\n        # After all ingredients are collected, craft the item\n        if workshop_kind is None:\n            # Crafting recipes always use a workshop in this environment.\n            return False, current_state_sim, []\n\n        path_to_workshop_actions = _bfs_path_to_target_facing(\n            current_state_sim.pos, current_state_sim.dir, current_state_sim.grid,\n            workshop_kind\n        )\n        if path_to_workshop_actions is None:\n            return False, current_state_sim, []\n\n        actions_taken_for_this_call.extend(path_to_workshop_actions)\n        # Simulate actions to update current_state_sim\n        for action in path_to_workshop_actions:\n            _, current_state_sim = current_state_sim.step(action)\n\n        # Perform USE at the workshop\n        actions_taken_for_this_call.append(ACTION_USE)\n        original_count = _get_item_count(current_state_sim, target_item_idx)\n        _, current_state_sim = current_state_sim.step(ACTION_USE)\n\n        # Check if crafting was successful (item count increased)\n        if _get_item_count(current_state_sim, target_item_idx) <= original_count:\n            return False, current_state_sim, []\n\n        return True, current_state_sim, actions_taken_for_this_call\n\n    # --- Main logic of craft_v2 ---\n    # Goal: Ensure inventory[item] > 0\n    if _get_item_count(current_state, item) > 0:\n        return [] # Already have the item\n\n    # Perform the recursive planning starting from the current state\n    # max_depth chosen heuristically to prevent extremely long plans for complex recipes\n    success, final_planning_state, plan_actions = _recursive_craft_v2(\n        current_state, item, max_depth=10\n    )\n\n    if success:\n        return plan_actions\n    else:\n        return [] # Could not find a plan to craft the item", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:30:02.008917", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (based on action_specs in CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map movement actions to (row_delta, col_delta)\n  ACTION_TO_DELTA_MAP = {\n      DOWN: (1, 0),   # Move South (+row)\n      UP: (-1, 0),    # Move North (-row)\n      LEFT: (0, -1),  # Move West (-col)\n      RIGHT: (0, 1)   # Move East (+col)\n  }\n\n  # Directions for `dir` attribute (0:North, 1:East, 2:South, 3:West)\n  # And their corresponding deltas used by CraftState.step for USE action.\n  # This assumes dir is fixed to 0 (North) as there are no turn actions.\n  # DR = [-1, 0, 1, 0] # Row deltas for dir 0, 1, 2, 3\n  # DC = [0, 1, 0, -1] # Col deltas for dir 0, 1, 2, 3\n\n\n  def _state_to_tuple(state):\n      \"\"\"Converts a CraftState object into a hashable tuple for memoization.\"\"\"\n      # Convert grid to a hashable tuple of tuples.\n      # state.grid has shape (WIDTH, HEIGHT, N_KINDS).\n      # Reshape to (WIDTH*HEIGHT, N_KINDS) and convert each row to a tuple, then the whole to a tuple.\n      grid_tuple = tuple(tuple(row) for row in state.grid.reshape(-1, state.grid.shape[-1]))\n      # Convert inventory to a hashable tuple.\n      inventory_tuple = tuple(state.inventory)\n      # Position and direction are already hashable.\n      return (grid_tuple, inventory_tuple, state.pos, state.dir)\n\n\n  def _find_path_and_pos_for_use(start_state, target_item_idx, is_workshop=False):\n      \"\"\"\n      Finds a path from start_state.pos to a position from which `USE` can target the `target_item_idx`.\n      \n      Args:\n          start_state: The CraftState from which to start pathfinding.\n          target_item_idx: The integer index of the item to target, or a dummy value like -1 if\n                           looking for any workshop (when `is_workshop` is True).\n          is_workshop: Boolean, if True, searches for any workshop item.\n      \n      Returns:\n          A tuple (path_actions, new_state_after_path_and_use) if a path is found,\n          where `path_actions` is a list of integer actions (movement + USE) and\n          `new_state_after_path_and_use` is the resulting CraftState.\n          Returns None if no path is found.\n      \"\"\"\n      rows, cols, _ = start_state.grid.shape\n      \n      # Determine all target cells on the grid for the desired item/workshop.\n      item_coords_on_grid = []\n      if is_workshop:\n          # If looking for a workshop, find any cell containing a workshop index.\n          workshop_indices = start_state.world.workshop_indices\n          for r in range(rows):\n              for c in range(cols):\n                  cell_kinds = start_state.grid[r, c, :].nonzero()[0]\n                  if any(k in workshop_indices for k in cell_kinds):\n                      item_coords_on_grid.append((r, c))\n      else:\n          # If looking for a specific item, find cells containing that item_idx.\n          for r in range(rows):\n              for c in range(cols):\n                  if start_state.grid[r, c, target_item_idx] > 0:\n                      item_coords_on_grid.append((r, c))\n\n      if not item_coords_on_grid:\n          return None # Target item/workshop not found on the grid\n\n      # Based on the CraftState.step logic and lack of turn actions,\n      # `dir` is fixed (default 0 for North).\n      # The `DR` and `DC` arrays are hardcoded in the original CraftState.py:\n      # DR = [-1, 0, 1, 0] # Row deltas for dir 0 (N), 1 (E), 2 (S), 3 (W)\n      # DC = [0, 1, 0, -1] # Col deltas for dir 0 (N), 1 (E), 2 (S), 3 (W)\n      # Since `dir` is fixed to 0 (North), `USE` always targets `(r + DR[0], c + DC[0])` which is `(r-1, c)`.\n      # This means `USE` always targets the cell directly North of the agent.\n      # To USE an item at `(item_r, item_c)`, the agent must be at `(item_r + 1, item_c)`.\n      # These are the required agent positions to be able to `USE` the item.\n      required_agent_use_positions = set()\n      for item_r, item_c in item_coords_on_grid:\n          # Agent must be South of the item to USE it (assuming fixed North direction)\n          agent_r, agent_c = item_r + 1, item_c\n          if 0 <= agent_r < rows and 0 <= agent_c < cols: # Ensure required agent position is within bounds\n              required_agent_use_positions.add((agent_r, agent_c))\n      \n      if not required_agent_use_positions:\n          return None # No valid positions from which to USE the item\n\n      # BFS to find the shortest path to any of the `required_agent_use_positions`.\n      q = collections.deque()\n      # Queue stores: (row, col, path_actions_list, current_simulated_state)\n      q.append((start_state.pos[0], start_state.pos[1], [], start_state))\n      \n      # Visited states: (r, c) - only track position to prevent infinite loops in movement\n      visited_pos = {(start_state.pos[0], start_state.pos[1])}\n      \n      while q:\n          r, c, path_actions, current_sim_state = q.popleft()\n\n          # If current position is one of the required agent positions for USE:\n          if (r, c) in required_agent_use_positions:\n              # We found a path to the correct pre-USE position.\n              # Now simulate the final USE action.\n              try:\n                  # The _ step always returns 0.0 reward in this implementation.\n                  _, new_state_after_use = current_sim_state.step(USE)\n              except Exception: # Handle potential errors if USE is invalid for some reason (e.g. no item)\n                  continue # This path lead to an invalid USE, try other paths\n              \n              final_actions = path_actions + [USE]\n              return final_actions, new_state_after_use\n\n          # Explore neighbors\n          for action_val, (dr, dc) in ACTION_TO_DELTA_MAP.items():\n              nr, nc = r + dr, c + dc\n              if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in visited_pos:\n                  visited_pos.add((nr, nc))\n                  # Simulate the move to get the state after this move\n                  _, next_sim_state_after_move = current_sim_state.step(action_val)\n                  q.append((nr, nc, path_actions + [action_val], next_sim_state_after_move))\n      \n      return None # No path found to any valid USE position\n\n\n  # Memoization cache for (state_tuple, target_item_idx) -> (actions_list, final_state)\n  # This cache needs to be accessible by _plan_recursively\n  memo = {} \n\n  def _plan_recursively(current_state, target_item, cookbook, memo):\n      \"\"\"\n      Recursively plans actions to obtain `target_item`.\n      \n      Args:\n          current_state: The current CraftState object.\n          target_item: The integer index of the item to obtain.\n          cookbook: The Cookbook instance from CraftWorld.\n          memo: The memoization cache dictionary.\n            \n      Returns:\n          A tuple (actions_list, final_state) where actions_list is a list of\n          integer actions, and final_state is the CraftState after applying\n          these actions. Returns (None, None) if the item cannot be obtained.\n      \"\"\"\n      state_tuple = _state_to_tuple(current_state)\n      if (state_tuple, target_item) in memo:\n          return memo[(state_tuple, target_item)]\n\n      # Base Case 1: Already have the item\n      if current_state.inventory[target_item] > 0:\n          memo[(state_tuple, target_item)] = ([], current_state)\n          return [], current_state\n\n      actions_to_achieve_goal = []\n      current_simulated_state = current_state\n\n      # Case 1: Target is a primitive (can be picked up from grid)\n      if target_item in cookbook.primitives:\n          path_result = _find_path_and_pos_for_use(current_simulated_state, target_item, is_workshop=False)\n          if path_result:\n              actions, new_sim_state = path_result\n              actions_to_achieve_goal.extend(actions)\n              current_simulated_state = new_sim_state\n              # Store in memo and return\n              memo[(state_tuple, target_item)] = (actions_to_achieve_goal, current_simulated_state)\n              return actions_to_achieve_goal, current_simulated_state\n          else:\n              # Cannot find or reach primitive on grid\n              memo[(state_tuple, target_item)] = (None, None) # Cache failure\n              return None, None \n\n      # Case 2: Target is craftable (has a recipe)\n      if target_item in cookbook.recipes:\n          recipe = cookbook.recipes[target_item]\n          \n          # First, check and obtain all required ingredients\n          ingredients_to_obtain = []\n          for ing_idx, count in recipe.items():\n              if ing_idx == \"_key\": # Special key for workshop requirements\n                  continue\n              missing_count = max(0, count - current_simulated_state.inventory[ing_idx])\n              if missing_count > 0:\n                  ingredients_to_obtain.append((ing_idx, missing_count))\n          \n          for ing_idx, needed_count in ingredients_to_obtain:\n              for _ in range(needed_count): # Try to obtain each missing unit of ingredient\n                  # Pass memo to recursive calls\n                  ing_actions, new_state_after_ing = _plan_recursively(current_simulated_state, ing_idx, cookbook, memo)\n                  if ing_actions is None:\n                      # Cannot obtain this ingredient, so cannot craft the target item\n                      memo[(state_tuple, target_item)] = (None, None)\n                      return None, None \n                  actions_to_achieve_goal.extend(ing_actions)\n                  current_simulated_state = new_state_after_ing\n\n          # After gathering all ingredients, craft the item.\n          # Check if a workshop is needed.\n          workshop_needed_or_type = recipe.get(\"_key\", False)\n          if workshop_needed_or_type:\n              # `_key` can be True (any workshop) or a specific workshop index.\n              # Currently, assuming CraftWorld uses True for any workshop.\n              path_result = _find_path_and_pos_for_use(current_simulated_state, -1, is_workshop=True) # -1 is dummy for \"any workshop\"\n              if path_result:\n                  actions, new_sim_state = path_result\n                  actions_to_achieve_goal.extend(actions)\n                  current_simulated_state = new_sim_state\n              else:\n                  # Cannot find or reach a workshop\n                  memo[(state_tuple, target_item)] = (None, None)\n                  return None, None\n\n          # If we reached this point, we have ingredients and are at a workshop (if needed).\n          # Now, simulate the final USE action to craft the item.\n          try:\n              _, new_state_after_craft = current_simulated_state.step(USE)\n          except Exception: # Handle cases where USE might still fail (e.g. not enough ingredients for multiple crafts, or other hidden env rules)\n              memo[(state_tuple, target_item)] = (None, None)\n              return None, None\n          \n          actions_to_achieve_goal.append(USE)\n          current_simulated_state = new_state_after_craft\n          \n          # Store in memo and return\n          memo[(state_tuple, target_item)] = (actions_to_achieve_goal, current_simulated_state)\n          return actions_to_achieve_goal, current_simulated_state\n\n      # Case 3: Target is neither primitive nor craftable (invalid item_idx or uncraftable)\n      memo[(state_tuple, target_item)] = (None, None) # Cache failure\n      return None, None\n\n  # Clear memoization cache for each call to craft_v2\n  memo.clear() \n\n  # Start the planning process from the environment's current state\n  initial_state = env._current_state\n  final_actions, _ = _plan_recursively(initial_state, item_idx, env.world.cookbook, memo)\n\n  # If `_plan_recursively` returns None, it means the item cannot be crafted/obtained.\n  # Return an empty list as per the problem description's expectation for such cases.\n  if final_actions is None:\n      return []\n  return final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:32:08.993630", "function_name": "craft", "function_body": "  import collections\n\n  # Define constants locally as per instructions to only return code within function\n  # These are inferred from the problem description\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map move actions to relative (dx, dy)\n  MOVE_ACTION_VECTORS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  def _get_path_to_cell(start_pos, grid_shape, target_pos):\n      \"\"\"\n      Internal helper to find a path of movement actions from start_pos to target_pos.\n      Returns list of actions or None if no path.\n      \"\"\"\n      WIDTH, HEIGHT = grid_shape[0], grid_shape[1]\n\n      q = collections.deque([(start_pos, [])])\n      visited = {start_pos}\n\n      while q:\n          current_pos, path_actions = q.popleft()\n\n          if current_pos == target_pos:\n              return path_actions\n\n          for action_val, (dx, dy) in MOVE_ACTION_VECTORS.items():\n              new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n              new_pos = (new_x, new_y)\n\n              if 0 <= new_x < WIDTH and 0 <= new_y < HEIGHT and new_pos not in visited:\n                  visited.add(new_pos)\n                  q.append((new_pos, path_actions + [action_val]))\n      return None # No path found\n\n  all_actions = []\n  current_state = env._current_state # Get the initial state from CraftLab\n\n  # Get cookbook for recipe information\n  cookbook = env.world.cookbook\n\n  # 1. Determine all primitive ingredients needed for the target item\n  needed_primitives = cookbook.primitives_for(item)\n  # needed_primitives is a dict like {primitive_idx: count}\n\n  # 2. Collect primitives\n  # This loop attempts to collect all necessary primitives. It will iterate,\n  # finding the closest needed primitive, pathing to it, and using it.\n  # It breaks when all primitives are collected or if no more reachable primitives are found.\n  max_collection_attempts = 100 # Safety limit to prevent infinite loops\n\n  for attempt in range(max_collection_attempts):\n      # Check if all needed primitives are already in inventory\n      all_primitives_collected = True\n      for p_idx, needed_count in needed_primitives.items():\n          if current_state.inventory[p_idx] < needed_count:\n              all_primitives_collected = False\n              break\n      \n      if all_primitives_collected:\n          break # Exit the collection loop, all primitives are collected\n      \n      if attempt == max_collection_attempts - 1: # If this is the last attempt and still not collected\n          return [] # Failed to collect all within attempts limit\n          \n      found_item_on_grid_this_attempt = False\n      \n      # Iterate through needed primitives to find one to collect\n      # The order here can influence performance (e.g., collecting cheaper/closer first)\n      # but simple iteration is sufficient for correctness.\n      for p_idx, needed_count in needed_primitives.items():\n          if current_state.inventory[p_idx] >= needed_count:\n              continue # Already have enough of this primitive\n\n          # Find the closest instance of this primitive on the grid that has not been picked up yet\n          target_pos = None\n          grid = current_state.grid\n          WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n          min_dist = float('inf') # Used to find the closest item\n          \n          # Linear scan for the closest instance of the primitive\n          for x in range(WIDTH):\n              for y in range(HEIGHT):\n                  if grid[x, y, p_idx] > 0: # Check if primitive exists at this grid cell\n                      dist = abs(current_state.pos[0] - x) + abs(current_state.pos[1] - y)\n                      if dist < min_dist:\n                          min_dist = dist\n                          target_pos = (x, y)\n          \n          if target_pos is not None:\n              # Pathfind to the target primitive\n              path_to_primitive = _get_path_to_cell(current_state.pos, grid.shape, target_pos)\n\n              if path_to_primitive is not None:\n                  # Execute path actions and update current_state\n                  for action_to_take in path_to_primitive:\n                      all_actions.append(action_to_take)\n                      _, current_state = current_state.step(action_to_take)\n                      \n                  # Now current_state.pos is at target_pos. Add USE action and simulate.\n                  # This implies USE acts on the cell the agent is on, or an adjacent one,\n                  # and picks up the item or interacts with it.\n                  all_actions.append(USE)\n                  _, current_state = current_state.step(USE)\n                  \n                  found_item_on_grid_this_attempt = True\n                  # Break from this inner p_idx loop to re-evaluate overall needs\n                  # because inventory might have changed (possibly collecting multiple items)\n                  # and a new nearest item might need to be found.\n                  break \n      \n      if not found_item_on_grid_this_attempt and not all_primitives_collected:\n          # If we went through all needed primitives and couldn't find any to collect on grid,\n          # but we still need more, then it's impossible to collect them.\n          # This handles cases where items are exhausted or unreachable.\n          return [] # Cannot fulfill\n  \n  # Final check to ensure all primitives were collected after the loop.\n  # This should be true if the loop broke normally.\n  all_primitives_collected = True\n  for p_idx, needed_count in needed_primitives.items():\n      if current_state.inventory[p_idx] < needed_count:\n          all_primitives_collected = False\n          break\n  if not all_primitives_collected:\n      return [] # Should not happen if logic is correct, but defensive programming\n\n  # 3. Perform final crafting steps if needed\n  recipe = cookbook.recipes.get(item)\n  # If 'item' is a primitive itself (no recipe), this block is skipped, which is correct\n  # as primitives are \"crafted\" by simply picking them up.\n  if recipe is not None:\n      # Check if a workshop is needed for this recipe (indicated by \"_key\")\n      workshop_idx = recipe.get(\"_key\")\n      \n      if workshop_idx is not None:\n          # Find the workshop on the grid\n          workshop_pos = None\n          grid = current_state.grid\n          WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n          min_dist = float('inf') # Find the closest workshop\n          \n          for x in range(WIDTH):\n              for y in range(HEIGHT):\n                  # Check if workshop_idx is present at this grid cell\n                  if grid[x, y, workshop_idx] > 0: \n                      dist = abs(current_state.pos[0] - x) + abs(current_state.pos[1] - y)\n                      if dist < min_dist:\n                          min_dist = dist\n                          workshop_pos = (x, y)\n          \n          if workshop_pos is not None:\n              # Pathfind to the workshop\n              path_to_workshop = _get_path_to_cell(current_state.pos, grid.shape, workshop_pos)\n              if path_to_workshop is not None:\n                  # Execute movement actions to the workshop and update state\n                  for action_to_take in path_to_workshop:\n                      all_actions.append(action_to_take)\n                      _, current_state = current_state.step(action_to_take)\n                      \n                  # Now at workshop_pos. USE it to craft the item.\n                  all_actions.append(USE)\n                  _, current_state = current_state.step(USE)\n              else:\n                  return [] # Cannot reach the workshop\n          else:\n              return [] # Workshop not found on grid\n\n  # Verify if the goal item is successfully crafted and in inventory\n  if current_state.inventory[item] > 0:\n      return all_actions\n  else:\n      return [] # Goal not achieved", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:32:09.012368", "function_name": "craft", "function_body": "    # Define a hashable wrapper for CraftState to be used in the visited set\n    class StateWrapper:\n        def __init__(self, craft_state):\n            # Using .tobytes() for NumPy arrays for efficient hashing and comparison.\n            # This relies on the internal data representation being consistent.\n            self.grid_bytes = craft_state.grid.tobytes()\n            self.inventory_bytes = craft_state.inventory.tobytes()\n            self.pos = craft_state.pos\n            self.direction = craft_state.dir\n\n        def __hash__(self):\n            # Combine hashes of all components that define the state uniquely\n            return hash((self.grid_bytes, self.inventory_bytes, self.pos, self.direction))\n\n        def __eq__(self, other):\n            if not isinstance(other, StateWrapper):\n                return NotImplemented\n            # Compare all components for equality\n            return (self.grid_bytes == other.grid_bytes and\n                    self.inventory_bytes == other.inventory_bytes and\n                    self.pos == other.pos and\n                    self.direction == other.direction)\n\n    initial_state = env._current_state\n    goal_index = item\n\n    # Initialize BFS queue: (current_CraftState_object, list_of_actions_to_reach_this_state)\n    q = collections.deque([(initial_state, [])])\n\n    # Initialize visited set using the hashable StateWrapper to avoid cycles and redundant work\n    visited = {StateWrapper(initial_state)}\n\n    # Define possible actions as integers (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE)\n    # These map to the actions provided by CraftLab.action_specs()\n    actions = [0, 1, 2, 3, 4]\n\n    while q:\n        current_state, actions_taken = q.popleft()\n\n        # Check if the goal (item in inventory) is satisfied in the current state\n        if current_state.satisfies(None, goal_index):\n            return actions_taken\n\n        # Explore all possible actions from the current state\n        for action in actions:\n            # Apply the action to get the next state.\n            # CraftState.step returns (reward, done, new_state). We only need new_state.\n            _, _, next_state = current_state.step(action)\n\n            # Wrap the next state for hashing and equality comparison in the visited set\n            next_state_wrapper = StateWrapper(next_state)\n\n            # If this state has not been visited before, add it to the queue and visited set\n            if next_state_wrapper not in visited:\n                visited.add(next_state_wrapper)\n                q.append((next_state, actions_taken + [action]))\n\n    # If the queue becomes empty and the goal has not been reached, the goal is unreachable\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:34:47.809206", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab action_specs)\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n  _ACTIONS = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT, _ACTION_USE]\n\n  # Get the initial CraftState from the CraftLab environment.\n  # CraftLab stores the current state in its private attribute `_current_state`.\n  initial_craft_state = env._current_state\n\n  # Validate the item index. Check if it's a known kind in the cookbook.\n  # If the item index is not recognized by the cookbook or is a special invalid index (like 0),\n  # it's considered uncraftable.\n  if item not in env.world.cookbook.kinds and item != 0:\n      return []\n\n  # Initialize BFS structures.\n  # The queue will store tuples of (current_CraftState_instance, list_of_actions_taken_to_reach_this_state).\n  q = collections.deque([(initial_craft_state, [])])\n\n  # The 'visited' set will store hashable representations of CraftState objects\n  # to prevent revisiting states and to detect cycles.\n  # A state is uniquely defined by its grid, inventory, position, and direction.\n  # For numpy arrays (grid, inventory), .tobytes() provides a hashable representation.\n  visited = set()\n  initial_state_hash = (\n      initial_craft_state.grid.tobytes(),\n      initial_craft_state.inventory.tobytes(),\n      initial_craft_state.pos,\n      initial_craft_state.dir\n  )\n  visited.add(initial_state_hash)\n\n  # Define a maximum search depth to prevent excessively long searches for complex\n  # or potentially unsolvable scenarios, ensuring the function completes in reasonable time.\n  MAX_SEARCH_DEPTH = 75 # This value can be tuned based on expected problem complexity.\n\n  # BFS Loop: Explore states layer by layer\n  while q:\n      current_state, current_actions = q.popleft()\n\n      # Goal Check: If the target 'item' is present in the current state's inventory,\n      # the goal is achieved. Return the sequence of actions that led to this state.\n      if current_state.inventory[item] > 0:\n          return current_actions\n\n      # Depth Pruning: If the current path exceeds the maximum allowed search depth,\n      # stop exploring this path to control computational complexity.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue\n\n      # Generate Successor States: Try all possible actions from the current state.\n      for action in _ACTIONS:\n          # `current_state.step(action)` simulates the action and returns a *new*\n          # CraftState object, which is ideal for BFS as it avoids modifying\n          # the current state in place and simplifies state management.\n          _reward, next_state = current_state.step(action)\n\n          # Create a hashable representation for the next state to check against 'visited'.\n          next_state_hash = (\n              next_state.grid.tobytes(),\n              next_state.inventory.tobytes(),\n              next_state.pos,\n              next_state.dir\n          )\n\n          # If this 'next_state' has not been visited before, add it to the 'visited' set\n          # and enqueue it for further exploration with its accumulated actions.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              q.append((next_state, current_actions + [action]))\n\n  # If the BFS queue becomes empty and the goal was never reached, it means no\n  # sequence of actions was found to craft the item within the search limits.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:34:47.907172", "function_name": "craft", "function_body": "    # Constants for actions based on CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    N_ACTIONS = 5 # Total number of possible actions\n\n    def get_hashable_state_key(state):\n        \"\"\"\n        Generates a hashable key for a CraftState to be used in a visited set.\n        This key uniquely identifies the state by combining its grid, position,\n        direction, and inventory.\n        \"\"\"\n        # Convert numpy arrays (grid and inventory) to bytes for hashing.\n        # This ensures the key is immutable and hashable.\n        grid_bytes = state.grid.tobytes()\n        inventory_bytes = state.inventory.tobytes()\n        return (grid_bytes, state.pos, state.dir, inventory_bytes)\n\n    initial_state = env._current_state\n    \n    # Check if the goal item is already in the inventory in the initial state.\n    # If so, no actions are needed.\n    if initial_state.satisfies(None, item):\n        return []\n\n    # Define a maximum search depth to limit computation time and prevent\n    # infinite loops in complex or unreachable scenarios. This value may\n    # need tuning based on the specific complexity of crafting tasks.\n    MAX_DEPTH = 100 \n\n    # Initialize the BFS queue. Each element is a tuple:\n    # (current_CraftState, list_of_actions_taken_to_reach_this_state, current_depth)\n    # Using a list and an index (`head`) to simulate a queue efficiently without `collections.deque`.\n    queue = [(initial_state, [], 0)]\n    head = 0 # Pointer to the front of the queue\n\n    # Initialize the set of visited states to avoid redundant exploration and cycles.\n    # States are represented by their hashable keys.\n    visited = {get_hashable_state_key(initial_state)}\n\n    # Perform Breadth-First Search\n    while head < len(queue):\n        current_state, path_so_far, current_depth = queue[head]\n        head += 1 # Move the queue pointer forward\n\n        # Pruning: If the current path exceeds the maximum allowed depth,\n        # do not expand this path further to control search complexity.\n        if current_depth >= MAX_DEPTH:\n            continue\n\n        # Explore all possible actions from the current state\n        for action in range(N_ACTIONS):\n            # Apply the action to get the next state.\n            # The reward returned by `step` is not used here as we are looking\n            # for the shortest path (uniform action cost).\n            _, next_state = current_state.step(action)\n            new_path = path_so_far + [action] # Record the action in the path\n\n            # Generate a hashable key for the new state\n            state_key = get_hashable_state_key(next_state)\n\n            # If this state has not been visited before (along a shorter or equal path)\n            if state_key not in visited:\n                # Check if the goal item is present in the inventory of the new state.\n                if next_state.satisfies(None, item):\n                    return new_path # Goal reached, return the sequence of actions\n\n                # Add the new state to the visited set and the queue for future exploration\n                visited.add(state_key)\n                queue.append((next_state, new_path, current_depth + 1))\n\n    # If the BFS completes and the queue is empty without finding the goal,\n    # it means the item cannot be crafted or acquired within the MAX_DEPTH.\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:36:20.776075", "function_name": "craft", "function_body": "    import collections # collections.deque for efficient queue operations\n\n    # Maximum number of steps to search.\n    # This acts as a safeguard against excessively long searches or unreachable goals.\n    # The value chosen (e.g., 300) should be tuned based on typical recipe complexity\n    # and expected map sizes in the CraftWorld.\n    MAX_SEARCH_DEPTH = 300 \n\n    # Retrieve action mapping and total number of actions from the environment.\n    # The 'action_specs' method of CraftLab provides the integer mapping for actions.\n    action_map = env.action_specs()\n    USE_ACTION = action_map['USE'] # Get the integer value for the 'USE' action\n    N_ACTIONS = len(action_map)    # Total number of distinct actions (e.g., 5)\n\n    # --- Setup for Breadth-First Search (BFS) ---\n    # q: A deque to store (current_CraftState, list_of_actions_taken_to_reach_this_state).\n    # BFS guarantees the shortest path in terms of number of actions.\n    q = collections.deque()\n    q.append((env._current_state, [])) # Start with the initial state and an empty action list\n\n    # visited: A dictionary to keep track of states already explored.\n    # This prevents cycles and re-exploring states with longer paths.\n    # The key for a state is a hashable tuple: (pos_tuple, direction_int, inventory_bytes, grid_bytes).\n    # The value is the list of actions taken to reach that state.\n    visited = {} \n    \n    initial_state = env._current_state\n    initial_state_key = (\n        initial_state.pos,\n        initial_state.dir,\n        initial_state.inventory.tobytes(), # Convert numpy array to bytes for hashing\n        initial_state.grid.tobytes()       # Convert numpy array to bytes for hashing\n    )\n    visited[initial_state_key] = [] # Store the empty path for the initial state\n\n    # --- Pre-compute relevant indices from the world for faster access ---\n    # These indices help in optimizing the 'USE' action by checking proximity to relevant objects.\n    workshop_indices = env.world.workshop_indices\n    # `environment_indices` represent non-grabbable entities, some of which might be harvestable\n    # via the 'USE' action (e.g., water, stone).\n    environment_indices = env.world.environment \n\n    # --- BFS Loop ---\n    while q:\n        current_state, actions_taken = q.popleft() # Get the next state to explore\n\n        # Check if the goal is satisfied in the current state.\n        # The 'satisfies' method in CraftState takes a goal_name (ignored here) and the goal_arg (item index).\n        if current_state.satisfies(None, item):\n            return actions_taken # Goal reached, return the sequence of actions\n\n        # Pruning: If the current path length exceeds the maximum search depth,\n        # stop exploring this branch to prevent overly long computations.\n        if len(actions_taken) >= MAX_SEARCH_DEPTH:\n            continue # Skip further expansion from this path\n\n        # --- Explore all possible actions from the current state ---\n        for action_val in range(N_ACTIONS): \n            # Optimization for the 'USE' action:\n            # 'USE' is only productive if the agent is next to a workshop or a harvestable environmental item.\n            # Skipping 'USE' actions when nothing relevant is nearby significantly prunes the search space.\n            if action_val == USE_ACTION:\n                is_next_to_useful_use_target = False\n                \n                # Check if the agent is adjacent to any known workshop type\n                for w_idx in workshop_indices:\n                    if current_state.next_to(w_idx):\n                        is_next_to_useful_use_target = True\n                        break # Found a workshop, no need to check others\n                \n                # If not next to a workshop, check for adjacent environmental items that might be harvestable\n                if not is_next_to_useful_use_target:\n                    for e_idx in environment_indices:\n                        if current_state.next_to(e_idx):\n                            is_next_to_useful_use_target = True\n                            break # Found an environmental item, no need to check others\n                \n                # If 'USE' action is unlikely to be productive, skip it for this state\n                if not is_next_to_useful_use_target:\n                    continue \n\n            # Simulate the action to get the next state.\n            # The reward is typically 0.0 for intermediate steps in this CraftState implementation.\n            _, next_state = current_state.step(action_val) \n\n            # Create a hashable key for the next state to use in the 'visited' dictionary.\n            next_state_key = (\n                next_state.pos,\n                next_state.dir,\n                next_state.inventory.tobytes(),\n                next_state.grid.tobytes()\n            )\n\n            # If this next_state has not been visited before, or if we found a shorter path to it,\n            # add it to the queue and update the 'visited' dictionary.\n            if next_state_key not in visited or len(actions_taken) + 1 < len(visited[next_state_key]):\n                visited[next_state_key] = actions_taken + [action_val] # Record the path\n                q.append((next_state, actions_taken + [action_val])) # Add to queue for further exploration\n\n    # If the queue becomes empty and the goal was not satisfied, it means the item\n    # is unreachable within the specified MAX_SEARCH_DEPTH or is impossible to craft.\n    return [] # Return an empty list indicating no path found", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:36:22.644088", "function_name": "craft", "function_body": "  # Actions mapping (constants as per problem description)\n  _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4\n  _ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT, _USE]\n\n  initial_state = env._current_state\n  \n  # Queue for BFS: stores (CraftState, list_of_actions_to_reach_this_state)\n  q = deque([(initial_state, [])])\n  \n  # Set to store visited states to avoid cycles and redundant computation.\n  # A state is defined by (grid_bytes, pos_tuple, direction, inventory_bytes).\n  # Using .tobytes() for numpy arrays makes them hashable and captures their full content.\n  visited = set()\n\n  # Helper function to create a hashable state representation\n  def get_state_key(state: 'CraftState'):\n      return (state.grid.tobytes(), state.pos, state.dir, state.inventory.tobytes())\n\n  # Add initial state to visited set\n  visited.add(get_state_key(initial_state))\n\n  # Goal check function\n  def check_goal(state: 'CraftState', target_item_idx: int) -> bool:\n      return state.inventory[target_item_idx] > 0\n\n  max_steps_allowed = env.max_steps # Get maximum allowed steps from the environment\n\n  while q:\n      current_state, current_path = q.popleft()\n\n      # Check if goal is satisfied\n      if check_goal(current_state, item):\n          return current_path\n\n      # Prune if path length reaches or exceeds maximum allowed steps\n      # (We don't want to take any more steps if we're already at the limit)\n      if len(current_path) >= max_steps_allowed:\n          continue\n\n      # Try all possible actions\n      for action in _ACTIONS:\n          # Simulate the step to get the new state.\n          # CraftState.step handles all game logic (movement, pickup, crafting with USE).\n          _, new_state = current_state.step(action)\n          \n          new_path = current_path + [action]\n          \n          # Prune the new path if it exceeds the maximum allowed steps\n          if len(new_path) > max_steps_allowed:\n              continue\n\n          new_state_key = get_state_key(new_state)\n\n          if new_state_key not in visited:\n              visited.add(new_state_key)\n              q.append((new_state, new_path))\n  \n  # If the queue becomes empty and the goal was not reached, return an empty list.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:37:30.058569", "function_name": "craft", "function_body": "  import heapq\n\n  # Actions as per CraftLab.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  cookbook = env.world.cookbook # Access the cookbook for heuristic\n\n  # Get the initial state from the environment\n  start_state = env._current_state\n  goal_item_idx = item\n\n  # Immediate check: if the item is already crafted, no actions needed.\n  if start_state.satisfies(None, goal_item_idx):\n    return []\n\n  def get_state_key(state):\n    \"\"\"Creates a hashable representation of a CraftState for visited set/g_score.\"\"\"\n    # Convert numpy arrays (grid, inventory) to bytes for efficient hashing.\n    # pos and dir are already hashable (tuple and int).\n    return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  def heuristic(state):\n    \"\"\"\n    Estimates the minimum number of actions needed to reach the goal state\n    from the current state. This heuristic is admissible (never overestimates).\n    It computes the sum of missing primitive items required for the goal.\n    Each missing primitive effectively costs at least one 'USE' action.\n    \"\"\"\n    required_primitives = cookbook.primitives_for(goal_item_idx)\n    \n    missing_primitive_count = 0\n    for p_idx, p_count_needed in required_primitives.items():\n        in_inventory = state.inventory[p_idx]\n        missing_primitive_count += max(0, p_count_needed - in_inventory)\n        \n    return missing_primitive_count\n\n  # A* search data structures\n  # Priority queue: stores (f_score, g_score, CraftState_instance, path_to_state)\n  # f_score = g_score + h_score\n  open_set = [] \n  \n  # g_score: maps state_key to the cost of the cheapest path found so far from start to that state\n  g_score = {}\n  \n  start_state_key = get_state_key(start_state)\n  \n  # Initial state setup\n  g_score[start_state_key] = 0\n  h_score_start = heuristic(start_state)\n  f_score_start = h_score_start # g_score is 0 for the start state\n  \n  # Push the initial state onto the priority queue\n  # Tuple: (f_score, g_score, state_instance, path_list)\n  heapq.heappush(open_set, (f_score_start, 0, start_state, []))\n\n  # Safety limits to prevent excessively long searches\n  MAX_SEARCH_NODES = 200000 # Max number of nodes to explore (popped from open_set)\n  MAX_PATH_LENGTH = 150     # Max length of an action sequence to consider\n  \n  nodes_explored = 0\n\n  while open_set and nodes_explored < MAX_SEARCH_NODES:\n    # Pop the state with the lowest f_score\n    current_f, current_g, current_state, current_path = heapq.heappop(open_set)\n    current_state_key = get_state_key(current_state)\n\n    # If we have already found a path to this state with a lower or equal cost,\n    # then this path is not optimal, so skip it.\n    if current_g > g_score.get(current_state_key, float('inf')):\n        continue\n\n    # Increment the counter for explored nodes\n    nodes_explored += 1\n\n    # Check if the current state satisfies the goal\n    if current_state.satisfies(None, goal_item_idx):\n      return current_path\n\n    # Prune paths that are already too long. If the current path already exceeds\n    # the maximum allowed length, do not explore further from this state.\n    if len(current_path) >= MAX_PATH_LENGTH:\n      continue \n\n    # Explore all possible actions from the current state\n    for action in ACTIONS:\n      # Simulate the step to get the next state.\n      # CraftState.step returns (reward, new_state); reward is always 0.0 in this implementation.\n      _reward, next_state = current_state.step(action)\n      next_state_key = get_state_key(next_state)\n\n      # Each action has a cost of 1\n      tentative_g_score = current_g + 1 \n\n      # If this new path to next_state is shorter than any previously found path to next_state\n      if tentative_g_score < g_score.get(next_state_key, float('inf')):\n        # Update the g_score for next_state\n        g_score[next_state_key] = tentative_g_score\n        \n        # Calculate the heuristic and f_score for next_state\n        h_score_next = heuristic(next_state)\n        f_score_next = tentative_g_score + h_score_next\n        \n        # Create the new path\n        new_path = current_path + [action]\n        \n        # Push the next state onto the priority queue\n        heapq.heappush(open_set, (f_score_next, tentative_g_score, next_state, new_path))\n  \n  # If the loop finishes (priority queue is empty or max_search_nodes reached)\n  # without finding the goal, it means the goal is not reachable within the defined limits.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:37:31.483366", "function_name": "craft", "function_body": "  import heapq # For priority queue\n\n  # Actions as per CraftLab.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  def get_state_key(state):\n    \"\"\"Creates a hashable representation of a CraftState.\"\"\"\n    # Convert numpy arrays (grid, inventory) to bytes for efficient hashing.\n    # pos and dir are already hashable (tuple and int).\n    return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Get the initial state from the environment\n  start_state = env._current_state\n  goal_item_idx = item\n\n  # Immediate check: if the item is already crafted, no actions needed.\n  if start_state.satisfies(None, goal_item_idx):\n    return []\n\n  # Pre-compute the total primitive requirements for the goal\n  # This dictionary maps primitive_kind_index -> count.\n  # This is crucial for the heuristic function.\n  cookbook = env.world.cookbook\n  primitives_needed = cookbook.primitives_for(goal_item_idx)\n\n  # Heuristic function: Estimates the minimum \"cost\" (actions) to reach the goal\n  # from the current state. A simple, admissible heuristic is the sum of missing\n  # primitive components needed for the final goal.\n  def calculate_heuristic(state):\n    h_score = 0\n    for p_idx, p_count_needed in primitives_needed.items():\n      # How many of this primitive are still missing from the current inventory?\n      h_score += max(0, p_count_needed - state.inventory[p_idx])\n    return h_score\n\n  # A* search data structures:\n  # open_set: Priority queue (min-heap) storing (f_score, g_score, state_object, actions_list)\n  # The f_score determines the priority. Lower f_score means higher priority.\n  # g_score is included for tie-breaking (prefer paths with fewer steps).\n  open_set = [] \n  \n  # closed_set: Dictionary storing the best g_score found so far for each visited state key.\n  # This prevents revisiting states via longer paths and ensures optimality.\n  closed_set = {} \n\n  # Initialize A* for the start state\n  initial_g_score = 0\n  initial_h_score = calculate_heuristic(start_state)\n  initial_f_score = initial_g_score + initial_h_score\n\n  # Push the initial state to the priority queue\n  heapq.heappush(open_set, (initial_f_score, initial_g_score, start_state, []))\n  closed_set[get_state_key(start_state)] = initial_g_score\n\n  # Safety limits to prevent excessively long searches for complex or impossible goals.\n  MAX_SEARCH_NODES = 200000  # Maximum number of nodes to explore. Increased for A* as it can be more efficient but also deeper.\n  MAX_PATH_LENGTH = 150    # Maximum length of the action sequence to return.\n\n  nodes_explored = 0\n\n  while open_set and nodes_explored < MAX_SEARCH_NODES:\n    # Pop the state with the lowest f_score (highest priority)\n    current_f_score, current_g_score, current_state, current_actions = heapq.heappop(open_set)\n    current_state_key = get_state_key(current_state)\n\n    # If we already found a shorter path to this state, ignore this longer path.\n    if current_g_score > closed_set.get(current_state_key, float('inf')):\n      continue\n\n    # Check if the current state satisfies the goal\n    if current_state.satisfies(None, goal_item_idx):\n      return current_actions\n\n    # Prune paths that are already too long to prevent extremely long action sequences.\n    if len(current_actions) >= MAX_PATH_LENGTH:\n      continue\n\n    # Explore all possible actions from the current state\n    for action in ACTIONS:\n      # Simulate the step to get the next state.\n      # CraftState.step returns (reward, new_state); reward is always 0.0 here.\n      _reward, next_state = current_state.step(action)\n      \n      # Cost of moving to the next state is 1 (uniform action cost)\n      next_g_score = current_g_score + 1 \n      next_state_key = get_state_key(next_state)\n\n      # If this path to next_state is better than any previously found path,\n      # or if next_state has not been visited yet:\n      if next_g_score < closed_set.get(next_state_key, float('inf')):\n        closed_set[next_state_key] = next_g_score\n        next_h_score = calculate_heuristic(next_state)\n        next_f_score = next_g_score + next_h_score\n        new_actions = current_actions + [action]\n        heapq.heappush(open_set, (next_f_score, next_g_score, next_state, new_actions))\n    \n    nodes_explored += 1\n\n  # If the loop finishes (priority queue is empty or max_search_nodes reached)\n  # without finding the goal, it means the goal is not reachable within the defined limits.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:39:05.499987", "function_name": "craft", "function_body": "  initial_state = env._current_state\n  goal_item_index = item\n\n  # Actions mapping: assuming standard DMLab integer actions.\n  # These are constant values used throughout the CraftWorld/CraftLab setup.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Queue for BFS: stores (current_CraftState_instance, list_of_actions_to_reach_this_state)\n  queue = collections.deque([(initial_state, [])])\n\n  # Set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, inventory, agent position, and agent direction.\n  # We use the byte representation of numpy arrays for hashing, which is reliable for integer/boolean data.\n  visited_states = set()\n\n  def get_state_key(state):\n      \"\"\"Generates a hashable key for a CraftState object.\"\"\"\n      # Combine the immutable parts of the state into a tuple for hashing.\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Add the initial state to the visited set.\n  initial_key = get_state_key(initial_state)\n  visited_states.add(initial_key)\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This serves as a practical depth limit for the BFS to prevent excessively long searches.\n  max_episode_steps = env.max_steps\n\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the goal is satisfied in the current state's inventory.\n      if current_state.satisfies(None, goal_item_index):\n          return current_actions\n\n      # Pruning: If the current path length exceeds the maximum allowed steps for an episode,\n      # there's no point in exploring further from this path as it won't lead to a valid solution.\n      if len(current_actions) >= max_episode_steps:\n          continue\n\n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS:\n          # Simulate the action. CraftState.step returns a *new* CraftState instance,\n          # ensuring that `current_state` remains unchanged.\n          # The reward is not used in this planning context.\n          _, next_state = current_state.step(action)\n\n          next_state_key = get_state_key(next_state)\n\n          # If this new state has not been visited before, add it to the queue\n          # and mark it as visited.\n          if next_state_key not in visited_states:\n              visited_states.add(next_state_key)\n              new_actions_path = current_actions + [action]\n              queue.append((next_state, new_actions_path))\n\n  # If the queue becomes empty and the goal was never reached, it means no path\n  # was found within the search limits (including max_episode_steps).\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:39:07.138231", "function_name": "craft", "function_body": "  import collections\n\n  # Define constants for actions\n  ACTIONS = {\n      'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4\n  }\n  USE_ACTION = ACTIONS['USE']\n\n  initial_state = env._current_state\n\n  def _find_path_and_interact(state: 'CraftState', target_idx: int) -> tuple[list[int], 'CraftState']:\n      \"\"\"\n      Finds a path to target_idx (primitive or workshop) and performs USE.\n      Returns (list of actions, final_state)\n      \"\"\"\n      target_pos = None\n      current_grid = state.grid\n      # Find the target item/workshop on the grid\n      for r in range(current_grid.shape[0]):\n          for c in range(current_grid.shape[1]):\n              if current_grid[r, c, target_idx] > 0:\n                  target_pos = (r, c)\n                  break\n          if target_pos:\n              break\n      \n      if target_pos is None:\n          # Target not found on the map\n          return [], state\n\n      # BFS for pathfinding to a cell adjacent to the target\n      q = collections.deque([(state.pos, state.dir, [])]) # (pos, dir, actions_list)\n      # Visited set for BFS: (position_tuple, direction_int)\n      visited_path = set([(state.pos, state.dir)])\n      \n      path_to_adjacent = None\n      \n      # Determine adjacent cells to the target for pathfinding goal\n      adj_cells = []\n      tr, tc = target_pos\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # N, S, W, E relative to target\n          nr, nc = tr + dr, tc + dc\n          # Check bounds (assuming grid shape is consistent)\n          if 0 <= nr < current_grid.shape[0] and 0 <= nc < current_grid.shape[1]:\n              adj_cells.append((nr, nc))\n\n      while q:\n          (r, c), d, current_path_actions = q.popleft()\n          \n          # Check if current position is adjacent to target_pos\n          if (r, c) in adj_cells:\n              path_to_adjacent = current_path_actions\n              break\n\n          # Simulate the state to get to (r,c,d) to explore next moves\n          temp_sim_state = state \n          for action_step in current_path_actions:\n              _, temp_sim_state = temp_sim_state.step(action_step)\n\n          # Explore neighbors (move actions)\n          for action_val in ACTIONS.values():\n              if action_val == USE_ACTION:\n                  continue # USE is for interacting, not moving\n              \n              _, next_sim_state_for_path = temp_sim_state.step(action_val)\n              next_pos = next_sim_state_for_path.pos\n              next_dir = next_sim_state_for_path.dir\n\n              if (next_pos, next_dir) not in visited_path:\n                  visited_path.add((next_pos, next_dir))\n                  q.append((next_pos, next_dir, current_path_actions + [action_val]))\n      \n      if not path_to_adjacent:\n          # Could not find a path to the target's vicinity\n          return [], state\n\n      # Actions to reach the adjacent cell\n      actions = list(path_to_adjacent)\n      sim_state = state\n      for action in path_to_adjacent:\n          _, sim_state = sim_state.step(action)\n      \n      # After moving to adjacent, face the item/workshop and USE\n      dr = target_pos[0] - sim_state.pos[0]\n      dc = target_pos[1] - sim_state.pos[1]\n      \n      # Convert relative position to target direction (0:N, 1:E, 2:S, 3:W)\n      target_dir = -1\n      if dr == -1 and dc == 0: target_dir = 0 # North\n      elif dr == 0 and dc == 1: target_dir = 1 # East\n      elif dr == 1 and dc == 0: target_dir = 2 # South\n      elif dr == 0 and dc == -1: target_dir = 3 # West\n      \n      if target_dir != -1:\n          current_dir = sim_state.dir\n          turns = (target_dir - current_dir + 4) % 4 # Calculate minimum turns\n          \n          # Add turn actions\n          if turns == 1: actions.append(ACTIONS['RIGHT'])\n          elif turns == 2: actions.extend([ACTIONS['RIGHT'], ACTIONS['RIGHT']])\n          elif turns == 3: actions.append(ACTIONS['LEFT'])\n          \n          # Simulate turns\n          for _ in range(turns):\n              if turns == 1: _, sim_state = sim_state.step(ACTIONS['RIGHT'])\n              elif turns == 2: _, sim_state = sim_state.step(ACTIONS['RIGHT'])\n              elif turns == 3: _, sim_state = sim_state.step(ACTIONS['LEFT'])\n          \n          # Perform the USE action\n          actions.append(USE_ACTION)\n          _, sim_state = sim_state.step(USE_ACTION)\n          return actions, sim_state\n      else:\n          # Should not happen if target_pos is truly adjacent and reachable, but included for robustness\n          return [], state\n\n  # Recursive helper function for crafting\n  def _recursive_craft(current_state: 'CraftState', target_item_idx: int, visited_craft_goals: set) -> tuple[list[int], 'CraftState']:\n      \"\"\"\n      Recursively finds actions to craft target_item_idx.\n      Returns (list of actions, final_state)\n      \"\"\"\n      # Base case: item already in inventory\n      if current_state.inventory[target_item_idx] > 0:\n          return [], current_state\n\n      cookbook = current_state.world.cookbook\n\n      # Prevent infinite recursion for cyclical recipes or repeated failed attempts\n      if target_item_idx in visited_craft_goals:\n          return [], current_state \n\n      # Add target to visited goals for this crafting branch to prevent re-attempting same goal in sub-steps\n      new_visited_craft_goals = visited_craft_goals.union({target_item_idx})\n\n      # If it's a primitive, collect it from the environment\n      if target_item_idx in cookbook.primitives:\n          actions, final_state = _find_path_and_interact(current_state, target_item_idx)\n          if final_state.inventory[target_item_idx] > 0:\n              return actions, final_state\n          else:\n              return [], current_state\n\n      # If it's a crafted item, get its recipe and craft ingredients\n      recipe = cookbook.recipes.get(target_item_idx)\n      if not recipe:\n          # No recipe found for this item\n          return [], current_state\n\n      recipe_actions = []\n      sim_state = current_state # Use a simulated state that updates through the crafting process\n\n      # Collect all necessary ingredients first\n      for ingredient_idx, count in recipe.items():\n          if ingredient_idx == \"_key\":\n              continue # Handle workshop key later\n\n          current_count = sim_state.inventory[ingredient_idx]\n          needed_count = count - current_count\n\n          if needed_count > 0:\n              # Recursively get each needed ingredient, one by one\n              for _ in range(needed_count):\n                  ing_actions, updated_sim_state = _recursive_craft(sim_state, ingredient_idx, new_visited_craft_goals)\n                  \n                  # If no actions were found or no progress was made on this ingredient, then crafting is impossible\n                  if not ing_actions and updated_sim_state.inventory[ingredient_idx] == sim_state.inventory[ingredient_idx]:\n                      return [], current_state # Failed to obtain ingredient\n                  \n                  recipe_actions.extend(ing_actions)\n                  sim_state = updated_sim_state # Update simulation state after collecting ingredient\n                  \n                  # Re-check count after attempting to get one unit\n                  if sim_state.inventory[ingredient_idx] >= count:\n                      break # Got enough of this ingredient\n\n      # Verify all ingredients are actually present after recursive calls\n      for ingredient_idx, count in recipe.items():\n          if ingredient_idx != \"_key\" and sim_state.inventory[ingredient_idx] < count:\n              return [], current_state # Still missing ingredients, indicating a failure\n\n      # Perform crafting (USE action)\n      workshop_key_idx = recipe.get(\"_key\")\n      \n      if workshop_key_idx is not None:\n          # Craft at a specific workshop\n          actions, final_state = _find_path_and_interact(sim_state, workshop_key_idx)\n          recipe_actions.extend(actions)\n          sim_state = final_state\n          \n          if sim_state.inventory[target_item_idx] > 0:\n              return recipe_actions, sim_state\n          else:\n              return [], current_state # Failed to craft at workshop\n      else:\n          # Hand crafting (no specific workshop needed)\n          # A single USE action is typically sufficient if ingredients are in inventory\n          recipe_actions.append(USE_ACTION)\n          _, sim_state = sim_state.step(USE_ACTION)\n          \n          if sim_state.inventory[target_item_idx] > 0:\n              return recipe_actions, sim_state\n          else:\n              return [], current_state # Failed to handcraft\n\n  # Start the crafting process from the initial environment state\n  final_actions, _ = _recursive_craft(initial_state, item, set())\n  \n  return final_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:40:58.058711", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # A reasonable maximum number of steps to prevent excessively long plans.\n    # Crafting tasks usually don't require an enormous number of steps.\n    MAX_PLANNING_DEPTH = 100 # Maximum number of actions in a total plan\n    # A reasonable limit for states explored in the movement BFS to prevent it from getting stuck on large grids.\n    MAX_SEARCH_NODES = 50000 \n\n    world = env.world\n    initial_state = env._current_state # Get the starting state from the CraftLab environment\n    \n    # Get action integer mappings (e.g., 'DOWN': 0)\n    action_map = env.action_specs()\n    _MOVE_ACTIONS = [action_map['DOWN'], action_map['UP'], action_map['LEFT'], action_map['RIGHT']]\n    _USE_ACTION = action_map['USE']\n\n    # Memoization cache for subgoals: maps (state_key, target_item_idx) -> list_of_actions or None\n    # A state_key needs to capture enough information to uniquely identify a state for planning:\n    # (agent_position, agent_direction, current_inventory_tuple, current_grid_hash).\n    # Using grid.tobytes() for grid hashing and tuple(inventory.flatten()) for inventory.\n    memo = {}\n\n    def get_state_key(state: 'CraftState'):\n        \"\"\"Generates a hashable key for a CraftState for memoization.\"\"\"\n        # .tobytes() is efficient for hashing numpy array content.\n        # .flatten() ensures inventory is 1D before converting to a tuple.\n        return (state.pos, state.dir, tuple(state.inventory.flatten()), state.grid.tobytes())\n\n    def plan_to_get_item(current_state: 'CraftState', target_item_idx: int, path_so_far_len: int) -> list[int]:\n        \"\"\"\n        Recursively plans actions to obtain target_item_idx from current_state.\n        `path_so_far_len` is used to limit the total plan length to prevent infinite recursion\n        or overly long, impractical plans.\n        Returns a list of actions or None if a plan is not found within reasonable limits.\n        \"\"\"\n        \n        # 1. Base case: If the item is already in the current inventory, no actions needed.\n        if current_state.satisfies(None, target_item_idx):\n            return []\n\n        # 2. Pruning: Check memoization cache to avoid recomputing plans for already visited states/subgoals.\n        state_key = get_state_key(current_state)\n        if (state_key, target_item_idx) in memo:\n            return memo[(state_key, target_item_idx)]\n        \n        # 3. Pruning: Limit the total length of the plan to prevent excessively long or infinite searches.\n        if path_so_far_len >= MAX_PLANNING_DEPTH:\n            return None # Plan is too long or seems unreachable within limits\n\n        plan_found = None # Initialize to None; will be updated if a plan is found.\n\n        # 4. Determine how to acquire the item: Is it craftable, or is it a primitive/environment item?\n        if target_item_idx in world.cookbook.recipes:\n            # The target item is craftable: we need to gather its ingredients and potentially use a workshop.\n            recipe = world.cookbook.recipes[target_item_idx]\n            ingredients = {k: v for k, v in recipe.items() if k != \"_key\"} # Extract ingredients\n            workshop_idx = recipe.get(\"_key\") # Get the required workshop index, if any\n\n            # Check for missing ingredients\n            missing_ingredients = {}\n            for ing_idx, ing_count in ingredients.items():\n                if current_state.inventory[ing_idx] < ing_count:\n                    missing_ingredients[ing_idx] = ing_count - current_state.inventory[ing_idx]\n            \n            if not missing_ingredients:\n                # All ingredients are already available. Now, perform the crafting action (USE).\n                \n                temp_state_before_use = current_state\n                movement_to_workshop_actions = []\n\n                if workshop_idx is not None:\n                    # If a specific workshop is required, find a path to it.\n                    movement_to_workshop_actions = find_path_to_kind(current_state, workshop_idx)\n                    if movement_to_workshop_actions is None:\n                        # Cannot reach the required workshop, so this crafting path is not viable.\n                        memo[(state_key, target_item_idx)] = None # Cache failure\n                        return None\n                    \n                    # Simulate moving to the workshop to get the state at the workshop.\n                    for action in movement_to_workshop_actions:\n                        _, temp_state_before_use = temp_state_before_use.step(action)\n                        # Intermediate plan length check during simulation\n                        if path_so_far_len + len(movement_to_workshop_actions) >= MAX_PLANNING_DEPTH:\n                            memo[(state_key, target_item_idx)] = None\n                            return None\n                \n                # Attempt to USE at the final position (either the workshop or current location if no workshop).\n                _, next_state_after_use = temp_state_before_use.step(_USE_ACTION)\n                \n                # Verify if crafting was successful by checking the inventory increase for the target item.\n                if next_state_after_use.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n                    plan_found = movement_to_workshop_actions + [_USE_ACTION]\n            else:\n                # Ingredients are missing: recursively plan to acquire them.\n                # This strategy tries to acquire one missing ingredient at a time and then re-plans.\n                # This greedy approach might not find the optimal plan, but can find a working one.\n                \n                # Iterate through missing ingredients (order can influence plan efficiency).\n                for ing_idx, needed_count in missing_ingredients.items(): # `needed_count` is not fully used here for simplicity\n                    # Recursively try to get the current missing ingredient.\n                    sub_plan_to_get_ing = plan_to_get_item(\n                        current_state, ing_idx, path_so_far_len # Pass current path length to limit sub-plans\n                    )\n                    \n                    if sub_plan_to_get_ing is not None:\n                        # If a sub-plan is found, simulate its execution to update the state.\n                        temp_state_after_ing_acquire = current_state\n                        for action in sub_plan_to_get_ing:\n                            _, temp_state_after_ing_acquire = temp_state_after_ing_acquire.step(action)\n                        \n                        # After acquiring the ingredient, recursively try to plan for the *original*\n                        # target item from this new, updated state.\n                        remaining_plan = plan_to_get_item(\n                            temp_state_after_ing_acquire, target_item_idx, \n                            path_so_far_len + len(sub_plan_to_get_ing)\n                        )\n                        \n                        if remaining_plan is not None:\n                            plan_found = sub_plan_to_get_ing + remaining_plan\n                            break # A complete plan found through this ingredient acquisition path.\n        \n        elif target_item_idx in world.cookbook.primitives or target_item_idx in world.cookbook.environment:\n            # The target item is a primitive resource or an interactable environment entity.\n            # We need to find its location on the grid and perform a USE action.\n            path_to_item = find_path_to_kind(current_state, target_item_idx)\n            \n            if path_to_item is not None:\n                temp_state_before_use = current_state\n                # Simulate movement to the item's location.\n                for action in path_to_item:\n                    _, temp_state_before_use = temp_state_before_use.step(action)\n                    # Intermediate plan length check during simulation.\n                    if path_so_far_len + len(path_to_item) >= MAX_PLANNING_DEPTH:\n                        memo[(state_key, target_item_idx)] = None\n                        return None\n\n                # Attempt to USE the item (e.g., pick it up, collect water).\n                _, next_state_after_use = temp_state_before_use.step(_USE_ACTION)\n                \n                # Check if the interaction was successful (e.g., item collected into inventory).\n                # This ensures we only consider \"pickup\" successful if inventory increases.\n                if next_state_after_use.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n                    plan_found = path_to_item + [_USE_ACTION]\n                # else: If `USE` didn't increase inventory, it's not considered successful for `satisfies`.\n        \n        # 5. Store the result in the memoization cache and return the found plan (or None if not found).\n        memo[(state_key, target_item_idx)] = plan_found\n        return plan_found\n\n\n    def find_path_to_kind(current_state: 'CraftState', target_kind_idx: int) -> list[int]:\n        \"\"\"\n        Finds a sequence of movement actions to get the agent adjacent to a cell\n        containing `target_kind_idx` using a Breadth-First Search (BFS).\n        Returns a list of movement actions or None if the target is unreachable.\n        \"\"\"\n        grid = current_state.grid # The grid is considered static during this movement search.\n        \n        # BFS Queue: Stores tuples of (current_position_tuple, current_direction, list_of_actions_taken_so_far)\n        q = collections.deque([((current_state.pos[0], current_state.pos[1]), current_state.dir, [])])\n        \n        # Visited set: Stores (row, col, direction) tuples to prevent revisiting states and cycles.\n        visited = set([(current_state.pos[0], current_state.pos[1], current_state.dir)])\n        \n        num_nodes_explored = 0\n        while q:\n            (r, c), d, path = q.popleft()\n            num_nodes_explored += 1\n\n            # Pruning: Limit the number of nodes explored in the movement BFS to prevent excessive computation.\n            if num_nodes_explored > MAX_SEARCH_NODES:\n                return None\n            \n            # Create a temporary CraftState to use its `next_to` method, which checks the 3x3 neighborhood.\n            # The grid and inventory are kept constant as they don't change during pure movement.\n            temp_state_for_check = current_state.scenario.init(\n                grid=grid, # Pass the current grid, not the scenario's initial grid\n                pos=(r, c),\n                dir=d,\n                inventory=current_state.inventory\n            )\n            # NOTE: scenario.init() creates a *new* CraftState instance. \n            # This is safer than modifying current_state and backing up, or creating dummy objects.\n            # However, if scenario.init() is slow, this will impact performance.\n            # A lighter weight constructor if available, or just directly constructing CraftState, is better.\n            # Assuming CraftState constructor takes these args:\n            # temp_state_for_check = CraftState(\n            #     scenario=current_state.scenario,\n            #     grid=grid, # Use the grid from the *start* of the movement planning\n            #     pos=(r, c),\n            #     dir=d,\n            #     inventory=current_state.inventory # Inventory is constant during movement for this search\n            # )\n            # The original prompt indicates CraftState(scenario, grid, pos, dir, inventory). So let's use that.\n            temp_state_for_check = CraftState(current_state.scenario, grid, (r,c), d, current_state.inventory)\n\n\n            if temp_state_for_check.next_to(target_kind_idx):\n                return path # Found a path that leads the agent adjacent to the target kind.\n\n            # Explore possible movement actions (UP, DOWN, LEFT, RIGHT).\n            for action in _MOVE_ACTIONS:\n                # Simulate the move on a temporary state to determine the next position and direction.\n                # The `step` method correctly handles agent movement and rotation.\n                _, next_state_simulated = temp_state_for_check.step(action)\n                \n                next_pos_tuple = (next_state_simulated.pos[0], next_state_simulated.pos[1])\n                next_dir = next_state_simulated.dir\n\n                next_state_key_for_bfs = (next_pos_tuple[0], next_pos_tuple[1], next_dir)\n\n                if next_state_key_for_bfs not in visited:\n                    visited.add(next_state_key_for_bfs)\n                    q.append((next_pos_tuple, next_dir, path + [action]))\n\n        return None # No path found to the target kind within the search limits.\n\n    # Start the overall planning process from the initial state provided by the environment.\n    final_plan = plan_to_get_item(initial_state, item, 0) # Start with initial path length of 0.\n    \n    # Return the found plan, or an empty list if no plan was found (consistent with previous versions).\n    return final_plan if final_plan is not None else []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:40:59.924184", "function_name": "craft", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:42:39.818849", "function_name": "craft", "function_body": "  import collections\n  import heapq # For A* search priority queue\n\n  # Constants for actions based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Ensure the environment is reset to a known state before starting search.\n  # This populates env._current_state.\n  _ = env.reset(seed=0)\n\n  # Get the initial CraftState instance directly from the CraftLab environment.\n  # We will use CraftState's own .step() method for search without involving CraftLab's step loop.\n  initial_craft_state = env._current_state\n\n  # Precompute primitive requirements for the goal item using the cookbook.\n  # This dictionary maps primitive-kind indices (int) to their required counts (int)\n  # to craft one unit of the target 'item'. This is crucial for the heuristic.\n  primitives_required_for_goal = env.world.cookbook.primitives_for(item)\n\n  # Heuristic function for A* search.\n  # It estimates the minimum number of additional \"primitive units\" needed to reach the goal.\n  # This heuristic is admissible because each action (movement, pickup, or successful craft)\n  # can at most reduce the sum of needed primitive units by one unit.\n  # (Picking up a primitive reduces its deficit by 1. Crafting an item might consume primitives,\n  # increasing their deficit, or might not affect primitives directly; it will never decrease the deficit\n  # by more than what a single pickup action would.)\n  def heuristic(state_obj):\n      # If the goal is already satisfied, no more steps are needed.\n      if state_obj.satisfies(None, item):\n          return 0 \n\n      h_cost = 0\n      # Sum up the deficit for each required primitive.\n      for p_idx, required_count in primitives_required_for_goal.items():\n          current_count = state_obj.inventory[p_idx]\n          h_cost += max(0, required_count - current_count)\n      return h_cost\n\n  # A* Priority Queue: stores tuples of (f_cost, g_cost, current_craft_state_object, list_of_actions_taken_to_reach_this_state)\n  # f_cost = g_cost + h_cost\n  # heapq is a min-heap, so it always pops the item with the smallest f_cost.\n  pq = []\n\n  # Visited set/dict: stores state_hash -> best_g_cost to reach that state.\n  # This prevents cycles and ensures we always explore the shortest path to a state.\n  # State hash: (grid_byte_string, position_tuple, direction_int, inventory_tuple)\n  visited = {}\n\n  # Initial state setup for A*\n  initial_g_cost = 0 # Cost from start to current state (number of actions taken)\n  initial_h_cost = heuristic(initial_craft_state) # Estimated cost from current state to goal\n  initial_f_cost = initial_g_cost + initial_h_cost # Total estimated cost\n\n  initial_actions = [] # No actions taken yet\n\n  # Create a hashable representation of the initial state\n  initial_hashable_state = (\n      initial_craft_state.grid.tobytes(), # Convert numpy array to bytes for hashing\n      initial_craft_state.pos,\n      initial_craft_state.dir,\n      tuple(initial_craft_state.inventory) # Convert numpy array to tuple for hashing\n  )\n\n  # Add the initial state to the priority queue and visited set\n  heapq.heappush(pq, (initial_f_cost, initial_g_cost, initial_craft_state, initial_actions))\n  visited[initial_hashable_state] = initial_g_cost\n\n  # Limit the search space to prevent excessively long runtimes for complex or unreachable goals.\n  # If the search depth or branching factor is very high, this might still be hit.\n  MAX_SEARCH_NODES = 100000 \n  nodes_visited_count = 0\n\n  while pq:\n      f_cost, g_cost, current_state, current_actions = heapq.heappop(pq)\n      nodes_visited_count += 1\n\n      # Check if we've exceeded the search limit.\n      if nodes_visited_count > MAX_SEARCH_NODES:\n          # If limit reached, assume goal is unreachable within reasonable bounds and return an empty path.\n          return []\n\n      # Create a hashable representation of the current state for visited lookup.\n      current_hashable_state = (\n          current_state.grid.tobytes(),\n          current_state.pos,\n          current_state.dir,\n          tuple(current_state.inventory)\n      )\n\n      # If we found a path to this state with a higher g_cost than a previously discovered path,\n      # then this path is suboptimal, so skip it. This is important because heapq doesn't remove\n      # duplicates, it just pops the minimum, and we might have added this state with a higher\n      # g_cost earlier before finding a better path.\n      if g_cost > visited.get(current_hashable_state, float('inf')):\n          continue \n\n      # Check if the current state satisfies the goal condition.\n      # CraftState.satisfies expects a goal_name (ignored here) and goal_arg (the item index).\n      if current_state.satisfies(None, item):\n          return current_actions # Goal achieved, return the sequence of actions.\n\n      # Explore all possible actions from the current state.\n      for action in ACTIONS:\n          # Apply the action to get the next CraftState.\n          # CraftState.step returns (reward, new_state). Reward is ignored for pathfinding.\n          _, next_state = current_state.step(action)\n          next_g_cost = g_cost + 1 # Each action costs 1 unit\n\n          # Create a hashable representation of the next state.\n          next_hashable_state = (\n              next_state.grid.tobytes(),\n              next_state.pos,\n              next_state.dir,\n              tuple(next_state.inventory)\n          )\n\n          # Only add to queue if this path to next_state is better than any previously found path\n          if next_g_cost < visited.get(next_hashable_state, float('inf')):\n              visited[next_hashable_state] = next_g_cost # Update the best g_cost found for this state\n              next_h_cost = heuristic(next_state) # Calculate heuristic for the next state\n              next_f_cost = next_g_cost + next_h_cost # Calculate total estimated cost\n              \n              # Add the new state to the priority queue\n              heapq.heappush(pq, (next_f_cost, next_g_cost, next_state, current_actions + [action]))\n\n  # If the priority queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted from the initial state.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:42:50.991172", "function_name": "craft", "function_body": "  import collections\n  import numpy as np # Placed here to adhere strictly to \"only return code that will fit in that function. Do not imports... on the top.\"\n\n  # Constants for actions based on CraftLab.action_specs()\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Ensure the environment is reset to a known state before starting search.\n  # This populates env._current_state.\n  _ = env.reset(seed=0)\n\n  # Get the initial CraftState instance directly from the CraftLab environment.\n  # We will use CraftState's own .step() method for search without involving CraftLab's step loop.\n  initial_craft_state = env._current_state\n\n  # Helper to get a hashable state representation for use in sets/dictionaries.\n  # This avoids recomputing it multiple times and ensures consistency for visited checks.\n  def _get_hashable_state(craft_state):\n      return (\n          craft_state.grid.tobytes(), # Convert numpy array to bytes for hashing\n          craft_state.pos,            # Agent's (x, y) position tuple\n          craft_state.dir,            # Agent's direction integer\n          tuple(craft_state.inventory) # Convert inventory numpy array to tuple for hashing\n      )\n\n  # BFS Queue: stores tuples of (current_craft_state_object, its_hashable_representation)\n  # This allows us to access the actual state object for step operations and its hash\n  # for visited checks without recomputing the hash.\n  initial_hashable_state = _get_hashable_state(initial_craft_state)\n  q = collections.deque([(initial_craft_state, initial_hashable_state)])\n\n  # Visited set: stores hashable representations of states to avoid revisiting.\n  # This ensures that each unique state is processed only once, guaranteeing the shortest path\n  # in terms of action count for BFS.\n  visited = {initial_hashable_state}\n\n  # Path reconstruction dictionary: maps a state's hashable_representation -> (parent_hashable_representation, action_taken_to_reach_this_state)\n  # This allows us to reconstruct the sequence of actions from the initial state to the goal state\n  # once the goal is found, without storing the full action list in the queue. This is a memory optimization.\n  path_info = {initial_hashable_state: (None, None)} # Initial state has no parent or action leading to it.\n\n  # Limit the search space to prevent excessively long runtimes for complex or unreachable goals.\n  MAX_SEARCH_NODES = 50000 \n  nodes_visited_count = 0\n\n  while q:\n      current_state, current_hashable_state = q.popleft()\n      nodes_visited_count += 1\n\n      # Check if we've exceeded the search limit.\n      if nodes_visited_count > MAX_SEARCH_NODES:\n          # If limit reached, assume goal is unreachable within reasonable bounds and return an empty path.\n          return []\n\n      # Check if the current state satisfies the goal condition.\n      # CraftState.satisfies expects a goal_name (ignored here) and goal_arg (the item index).\n      if current_state.satisfies(None, item):\n          # Goal achieved, reconstruct the sequence of actions by backtracking through path_info.\n          path = []\n          node_hash = current_hashable_state\n          while path_info[node_hash][0] is not None: # Backtrack until we reach the initial state (whose parent is None)\n              parent_hash, action = path_info[node_hash]\n              path.append(action)\n              node_hash = parent_hash\n          return path[::-1] # Reverse the path as it was built backwards from goal to start.\n\n      # Explore all possible actions from the current state.\n      for action in ACTIONS:\n          # Apply the action to get the next CraftState.\n          # CraftState.step returns (reward, new_state). Reward is ignored for pathfinding.\n          _, next_state = current_state.step(action)\n\n          # Create a hashable representation of the next state.\n          next_hashable_state = _get_hashable_state(next_state)\n\n          # If this state has not been visited before, add it to the queue and visited set.\n          if next_hashable_state not in visited:\n              visited.add(next_hashable_state)\n              # Record how we reached this new state for path reconstruction.\n              path_info[next_hashable_state] = (current_hashable_state, action)\n              q.append((next_state, next_hashable_state))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted from the initial state within the search limits.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
