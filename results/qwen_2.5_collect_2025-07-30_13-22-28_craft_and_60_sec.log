{"timestamp": "2025-07-30T13:50:24.649404", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, local to this function.\n  # They will be set on every call, which is slightly inefficient but safe\n  # if CraftLab's action_specs can change per instance or call, though unlikely.\n  ACTION_MAP = env.action_specs()\n  MOVE_NORTH = ACTION_MAP['UP']\n  MOVE_SOUTH = ACTION_MAP['DOWN']\n  MOVE_EAST = ACTION_MAP['RIGHT']\n  MOVE_WEST = ACTION_MAP['LEFT']\n  USE = ACTION_MAP['USE']\n\n  # Helper to convert state to hashable tuple for pathfinding BFS visited set\n  def _state_to_hashable(state):\n      # Grid and inventory are numpy arrays, convert to tuples for hashing\n      return (\n          tuple(state.grid.flatten()),\n          tuple(state.inventory),\n          state.pos,\n          state.dir\n      )\n\n  def _find_path_to_target_kind(start_state, target_kind_idx, max_path_length=200):\n      \"\"\"\n      Finds a sequence of movement actions to get adjacent to a target_kind_idx.\n      Uses BFS on grid positions and returns the path of actions and the state\n      after completing the path.\n      Returns (actions_list, end_state_after_path) or (None, None) if not found.\n      \"\"\"\n      queue = collections.deque([(start_state, [])])\n      visited_positions = {start_state.pos} # Only track position for BFS here\n\n      steps_explored = 0\n      while queue and steps_explored < max_path_length:\n          current_state, path_actions = queue.popleft()\n          steps_explored += 1\n\n          # Check if already adjacent to target_kind_idx\n          if current_state.next_to(target_kind_idx):\n              return path_actions, current_state\n\n          # Explore neighbors (movement actions)\n          for action_id in [MOVE_NORTH, MOVE_SOUTH, MOVE_EAST, MOVE_WEST]:\n              # Applying step creates a new state instance, crucial for exploration\n              reward, new_state = current_state.step(action_id)\n              new_pos = new_state.pos\n\n              if new_pos not in visited_positions:\n                  visited_positions.add(new_pos)\n                  queue.append((new_state, path_actions + [action_id]))\n                  \n      return None, None # Path not found within limits\n\n  def _can_craft_item(current_state, item_idx):\n      \"\"\"Checks if item_idx can be crafted given current_state.inventory.\"\"\"\n      cookbook = current_state.world.cookbook\n      \n      # Primitives are gathered, not crafted\n      if item_idx in cookbook.primitives:\n          return False \n\n      recipe = cookbook.recipes.get(item_idx)\n      if not recipe:\n          return False # No recipe found for this item\n\n      for ingredient_idx, count in recipe.items():\n          if ingredient_idx == \"_key\": continue # Special key, not an ingredient\n          if current_state.inventory[ingredient_idx] < count:\n              return False # Not enough of an ingredient\n      return True\n\n  def _craft_recursive(current_state, target_item_idx, desired_count, recursion_depth_limit=10):\n      \"\"\"\n      Recursively plans actions to get target_item_idx.\n      Returns (actions_list, final_state) or (None, None) if impossible.\n      The actions are relative to the current_state provided.\n      \"\"\"\n      if recursion_depth_limit < 0:\n          return None, None # Prevent excessive recursion\n\n      # Base case: if we already have enough of the target item\n      if current_state.inventory[target_item_idx] >= desired_count:\n          return [], current_state\n\n      all_actions = []\n      # Use a variable to track state changes during planning without modifying the original\n      current_working_state = current_state \n\n      cookbook = current_working_state.world.cookbook\n\n      if target_item_idx in cookbook.primitives:\n          # It's a primitive: find it, go to it, USE it\n          needed_to_collect = desired_count - current_working_state.inventory[target_item_idx]\n          \n          for _ in range(needed_to_collect):\n              path_to_primitive_actions, state_at_primitive = _find_path_to_target_kind(current_working_state, target_item_idx)\n              if path_to_primitive_actions is None:\n                  return None, None # Cannot find primitive to collect\n\n              all_actions.extend(path_to_primitive_actions)\n              current_working_state = state_at_primitive\n\n              # Apply the USE action\n              # The reward is not used for planning, but the new_state is.\n              reward, next_state_after_use = current_working_state.step(USE)\n              all_actions.append(USE)\n              current_working_state = next_state_after_use\n              \n              if current_working_state.inventory[target_item_idx] >= desired_count:\n                  break # Collected enough\n\n      else:\n          # It's a crafted item: get ingredients, go to workshop, USE it\n          recipe = cookbook.recipes.get(target_item_idx)\n          if not recipe:\n              return None, None # No recipe for this item\n\n          # Collect ingredients recursively\n          for ingredient_idx, count_needed_for_recipe in recipe.items():\n              if ingredient_idx == \"_key\": continue\n              \n              count_have = current_working_state.inventory[ingredient_idx]\n              if count_have < count_needed_for_recipe:\n                  # Recursively get the remaining quantity of this ingredient\n                  actions_for_ingredient, new_state_after_ingredient = _craft_recursive(\n                      current_working_state,\n                      ingredient_idx,\n                      count_needed_for_recipe, # Need this much for the recipe\n                      recursion_depth_limit - 1\n                  )\n                  if actions_for_ingredient is None:\n                      return None, None # Cannot obtain this ingredient\n                  \n                  all_actions.extend(actions_for_ingredient)\n                  current_working_state = new_state_after_ingredient\n          \n          # After collecting all ingredients, check if we can craft\n          if not _can_craft_item(current_working_state, target_item_idx):\n              # This indicates a planning failure, e.g., an ingredient was consumed elsewhere\n              # or the state is invalid for crafting despite having ingredients.\n              return None, None\n\n          # Find path to workshop\n          workshop_kind_idx = -1\n          if current_working_state.world.workshop_indices:\n               # Choose the first workshop if multiple exist\n               workshop_kind_idx = current_working_state.world.workshop_indices[0] \n          \n          if workshop_kind_idx != -1:\n              path_to_workshop_actions, state_at_workshop = _find_path_to_target_kind(current_working_state, workshop_kind_idx)\n              if path_to_workshop_actions is None:\n                  return None, None # Cannot find workshop\n              \n              all_actions.extend(path_to_workshop_actions)\n              current_working_state = state_at_workshop\n          else:\n              # If no workshop defined, and it's a craftable item, can't craft.\n              return None, None \n\n          # Apply the USE action at the workshop to craft\n          initial_target_item_count = current_working_state.inventory[target_item_idx]\n          reward, next_state_after_craft = current_working_state.step(USE)\n          all_actions.append(USE)\n          current_working_state = next_state_after_craft\n          \n          # Verify crafting success by checking inventory\n          if current_working_state.inventory[target_item_idx] <= initial_target_item_count:\n              return None, None # Crafting did not succeed\n\n      # Return the actions collected and the final state\n      return all_actions, current_working_state\n\n  # Start the planning process\n  initial_state = env._current_state\n\n  # If the item is already in the inventory, no actions are needed\n  if initial_state.satisfies(None, item):\n      return []\n\n  # Call the recursive planner to find actions for the goal item\n  # We aim to craft at least 1 instance of the item.\n  planned_actions, final_state_after_plan = _craft_recursive(initial_state, item, 1) \n\n  if planned_actions is None:\n      return [] # No valid plan found\n  else:\n      return planned_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:52:13.076825", "function_name": "craft", "function_body": "  # Initial state and setup\n  initial_craft_state = env._current_state # CraftLab stores the current state here\n\n  # Check if the item is already crafted in the initial state\n  if initial_craft_state.satisfies(None, item):\n    return [] # Already done, no actions needed\n\n  # BFS queue: stores tuples of (current_state, path_to_this_state)\n  # The path is a list of actions (integers).\n  q = collections.deque()\n  q.append((initial_craft_state, []))\n\n  # Visited set: stores hashable representations of states to avoid revisiting\n  # A state is defined by (grid, inventory, position, direction).\n  # We use grid.tobytes() for the grid for efficiency in hashing.\n  visited = set()\n\n  def get_state_key(state):\n    \"\"\"Returns a hashable tuple representing the given CraftState.\"\"\"\n    return (state.grid.tobytes(), tuple(state.inventory), state.pos, state.dir)\n\n  visited.add(get_state_key(initial_craft_state))\n\n  # Define all possible actions as per CraftLab action_specs:\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_IDS = [0, 1, 2, 3, 4]\n\n  # Set a maximum number of steps for the search to prevent infinite loops\n  # or excessively long computations for complex/unsolvable recipes.\n  # This limit can be tuned based on expected problem complexity.\n  MAX_SEARCH_STEPS = 5000 \n  steps_explored = 0\n\n  while q and steps_explored < MAX_SEARCH_STEPS:\n    current_state, current_path = q.popleft()\n    steps_explored += 1\n\n    # Explore each possible action from the current state\n    for action in ACTION_IDS:\n      # Apply the action to get the next state.\n      # The reward is always 0.0 in this implementation, so we ignore it.\n      _, new_state = current_state.step(action)\n      new_path = current_path + [action]\n\n      # Get the hashable key for the new state\n      new_state_key = get_state_key(new_state)\n\n      # If this state has not been visited before, add it to the queue\n      if new_state_key not in visited:\n        visited.add(new_state_key)\n        \n        # Check if the goal is satisfied in the new state\n        if new_state.satisfies(None, item):\n          return new_path # Goal reached, return the path\n\n        q.append((new_state, new_path))\n\n  # If the queue becomes empty or MAX_SEARCH_STEPS is reached without finding the item\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:52:13.105606", "function_name": "craft", "function_body": "    # Action constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function for pathfinding (BFS)\n    # This finds a path from start_pos to be adjacent to (or on) any of target_locations_list.\n    # It assumes all targets in target_locations_list are of the same \"type\"\n    # (i.e., either all grabbable or all non-grabbable).\n    def _find_path_to_target_locations(start_pos, target_locations_list, is_target_grabbable, current_grid, n_kinds, non_grabbable_indices):\n        \"\"\"\n        Finds a path (actions) from start_pos to be adjacent to (or on) any of target_locations_list.\n        Returns: (list of actions, final_agent_pos_after_path) or (None, None) if no path.\n        \"\"\"\n        if not target_locations_list:\n            return None, None\n\n        HEIGHT, WIDTH, _ = current_grid.shape\n        q = deque([(start_pos, [])]) # (current_pos, list_of_actions_to_reach_here)\n        visited = {start_pos}\n\n        # (dy, dx) offsets for (UP, DOWN, LEFT, RIGHT) movements\n        # Assuming (row, col) coordinates where row increases downwards\n        action_moves = {\n            UP: (-1, 0),\n            DOWN: (1, 0),\n            LEFT: (0, -1),\n            RIGHT: (0, 1)\n        }\n        \n        while q:\n            (r, c), path = q.popleft()\n\n            # Check if current position is satisfactory for interaction (USE action)\n            target_reached = False\n            for tr, tc in target_locations_list:\n                if is_target_grabbable:\n                    # For grabbable items, agent needs to be ON the cell\n                    if (r, c) == (tr, tc):\n                        target_reached = True\n                        break\n                else:\n                    # For non-grabbable items (like workshops, stone, water), agent needs to be ADJACENT\n                    for dr_adj, dc_adj in action_moves.values():\n                        if (r + dr_adj, c + dc_adj) == (tr, tc):\n                            target_reached = True\n                            break\n                if target_reached: break # Found a suitable target for interaction from current (r,c)\n            \n            if target_reached:\n                return path, (r, c) # Return path and the agent's final position\n\n            # Explore neighbors\n            for action, (dr, dc) in action_moves.items():\n                nr, nc = r + dr, c + dc\n                \n                # Check bounds\n                if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n                    continue\n                \n                # Obstacle check: cannot move into a cell containing any non-grabbable item.\n                is_obstacle = False\n                for nk_idx in non_grabbable_indices:\n                    if current_grid[nr, nc, nk_idx] > 0:\n                        is_obstacle = True\n                        break\n                \n                if is_obstacle:\n                    continue\n\n                if (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    q.append(((nr, nc), path + [action]))\n                    \n        return None, None # No path found\n\n    actions_sequence = []\n    current_state = env._current_state\n    world = env.world\n    cookbook = world.cookbook\n\n    # 1. Get required primitive ingredients for the item\n    # cookbook.primitives_for resolves recursive recipes down to base primitives.\n    required_primitives = cookbook.primitives_for(item)\n\n    # Maintain a mutable copy of the grid for planning to simulate resource depletion.\n    # This ensures that once an item is \"picked up\" in our plan, it's not reused.\n    planning_grid = np.copy(current_state.grid)\n    current_agent_pos = current_state.pos\n\n    # 2. Collect each required primitive\n    for p_idx, count_needed in required_primitives.items():\n        for _ in range(count_needed): # Repeat `count_needed` times for each primitive\n            # Find actual locations of `p_idx` on the current `planning_grid`\n            available_p_locations = []\n            for r_iter in range(planning_grid.shape[0]):\n                for c_iter in range(planning_grid.shape[1]):\n                    if planning_grid[r_iter, c_iter, p_idx] > 0:\n                        available_p_locations.append((r_iter, c_iter))\n            \n            if not available_p_locations:\n                # If a primitive is required but no instances are left on the grid, cannot complete.\n                return [] \n            \n            # Find path to the closest available instance of this primitive.\n            # Primitives are generally grabbable items.\n            path_actions, final_pos_after_move = _find_path_to_target_locations(\n                current_agent_pos, \n                available_p_locations, \n                is_target_grabbable=True, # Primitives are assumed grabbable\n                current_grid=planning_grid, \n                n_kinds=world.n_kinds, \n                non_grabbable_indices=world.non_grabbable_indices\n            )\n            \n            if path_actions is None:\n                # If no path found to any instance of the required primitive, cannot complete.\n                return [] \n\n            actions_sequence.extend(path_actions)\n            actions_sequence.append(USE)\n            current_agent_pos = final_pos_after_move # Update agent's conceptual position\n\n            # Simulate item depletion on the planning_grid:\n            # For grabbable items, the agent moves onto the item's cell (final_pos_after_move).\n            # So, we deplete the item at this position.\n            planning_grid[final_pos_after_move[0], final_pos_after_move[1], p_idx] = 0\n\n\n    # 3. Go to a workshop and craft the final item\n    # Find all workshop locations on the grid\n    all_workshop_locations = []\n    for ws_kind_idx in world.workshop_indices:\n        for r_iter in range(planning_grid.shape[0]):\n            for c_iter in range(planning_grid.shape[1]):\n                if planning_grid[r_iter, c_iter, ws_kind_idx] > 0:\n                    all_workshop_locations.append((r_iter, c_iter))\n\n    if not all_workshop_locations:\n        # If no workshops are found, crafting is impossible.\n        return [] \n\n    # Workshops are non-grabbable items. Agent needs to be adjacent to them to USE.\n    path_to_workshop_actions, final_pos_at_workshop = _find_path_to_target_locations(\n        current_agent_pos,\n        all_workshop_locations,\n        is_target_grabbable=False, # Workshops are non-grabbable\n        current_grid=planning_grid, \n        n_kinds=world.n_kinds,\n        non_grabbable_indices=world.non_grabbable_indices\n    )\n\n    if path_to_workshop_actions is None:\n        # If no path found to a workshop, cannot craft.\n        return [] \n\n    actions_sequence.extend(path_to_workshop_actions)\n    actions_sequence.append(USE) # Perform USE action at the workshop to craft\n\n    return actions_sequence", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:54:04.489248", "function_name": "craft", "function_body": "  # Ensure the environment's internal state is accessible and valid.\n  # This function assumes env.reset() has been called prior, making\n  # env._current_state available and representing the initial state.\n  initial_state = env._current_state\n\n  # Quick check: if the item is already in inventory, no actions are needed.\n  if initial_state.satisfies(None, item):\n    return []\n\n  # Define the full set of action indices (assuming DMLab-style: 0-DOWN, 1-UP, 2-LEFT, 3-RIGHT, 4-USE)\n  ALL_ACTIONS = list(env.action_specs().values())\n\n  # Helper function to convert a CraftState object into a hashable tuple.\n  # This is crucial for storing visited states in a set to avoid cycles and redundant work.\n  def _state_to_hashable(state):\n    \"\"\"Converts a CraftState object into a hashable tuple.\"\"\"\n    # Use tobytes() for numpy arrays for efficient hashing and comparison.\n    # All components that define a unique state are included.\n    return (\n        state.grid.tobytes(),      # The layout of the world\n        state.pos,                 # Agent's (x, y) position\n        state.dir,                 # Agent's facing direction (0-3)\n        state.inventory.tobytes()  # Agent's inventory counts\n    )\n\n  # Queue for Breadth-First Search (BFS): stores (current_state, actions_taken_to_reach_here)\n  queue = collections.deque([(initial_state, [])])\n\n  # Set to keep track of visited states, storing their hashable representations.\n  visited = {_state_to_hashable(initial_state)}\n\n  # A hard limit on the number of states to explore. This prevents the search\n  # from running indefinitely on very large or impossible problems.\n  # This value can be tuned based on expected problem complexity and performance needs.\n  MAX_SEARCH_STATES = 10000\n\n  states_explored_count = 0\n\n  while queue:\n    current_state, actions_path = queue.popleft()\n    states_explored_count += 1\n\n    # Check against the search limit\n    if states_explored_count > MAX_SEARCH_STATES:\n      # print(f\"BFS reached maximum search states ({MAX_SEARCH_STATES}). Goal might be unreachable or too deep.\")\n      return [] # No path found within the allowed search budget\n\n    # Iterate through all possible actions\n    for action_idx in ALL_ACTIONS:\n      # Simulate the action using the CraftState's step method.\n      # CraftState.step returns (reward, new_state). The reward is not used here\n      # as this is an unweighted pathfinding problem (all steps cost 1).\n      _reward, next_state = current_state.step(action_idx)\n\n      next_state_hashable = _state_to_hashable(next_state)\n\n      # If this new state has not been visited before, add it to the queue\n      if next_state_hashable not in visited:\n        visited.add(next_state_hashable)\n        new_actions_path = actions_path + [action_idx]\n\n        # Check if the goal is satisfied in the newly reached state\n        if next_state.satisfies(None, item):\n          return new_actions_path # Goal achieved! Return the sequence of actions\n\n        # If the goal is not yet satisfied, continue exploring from this state\n        queue.append((next_state, new_actions_path))\n\n  # If the queue becomes empty, it means all reachable states have been explored\n  # and the goal item was not found.\n  # print(\"BFS completed, but the goal item was not found.\")\n  return [] # Goal is not reachable from the initial state", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T13:54:05.824196", "function_name": "craft", "function_body": "  import collections\n  import copy\n\n  # Action constants (from problem description's action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction constants (common for grid worlds)\n  DIR_NORTH = 0\n  DIR_EAST = 1\n  DIR_SOUTH = 2\n  DIR_WEST = 3\n\n  # (dy, dx) offsets for each movement action\n  ACTION_TO_DELTA_POS = {\n      DOWN: (1, 0),   # South\n      UP: (-1, 0),  # North\n      LEFT: (0, -1),  # West\n      RIGHT: (0, 1),   # East\n  }\n\n  # (dy, dx) offsets for the cell in front based on agent's direction\n  DIR_TO_DELTA_FACING = {\n      DIR_NORTH: (-1, 0),\n      DIR_EAST: (0, 1),\n      DIR_SOUTH: (1, 0),\n      DIR_WEST: (0, -1),\n  }\n\n  # Assumption: A movement action (UP, DOWN, LEFT, RIGHT) also sets the agent's\n  # facing direction to the cardinal direction of the movement.\n  ACTION_TO_NEW_DIR = {\n      UP: DIR_NORTH,\n      DOWN: DIR_SOUTH,\n      LEFT: DIR_WEST,\n      RIGHT: DIR_EAST,\n  }\n\n  class _SimulatedCraftState:\n      \"\"\"\n      A simplified state representation for planning, mirroring CraftState.\n      It accurately simulates agent movement, item pickup, and crafting.\n      \"\"\"\n      def __init__(self, craft_state):\n          self.grid = np.copy(craft_state.grid)\n          self.inventory = np.copy(craft_state.inventory)\n          self.pos = tuple(craft_state.pos)  # (r, c)\n          self.dir = craft_state.dir # 0:N, 1:E, 2:S, 3:W\n          self.world = craft_state.world # Reference to the world for constants\n\n      def _is_valid_pos(self, r, c):\n          height, width, _ = self.grid.shape\n          return 0 <= r < height and 0 <= c < width\n\n      def _get_cell_contents(self, r, c):\n          \"\"\"Returns a set of kind indices present at (r,c) with count > 0.\"\"\"\n          if not self._is_valid_pos(r, c):\n              return set()\n          present_kinds = np.where(self.grid[r, c] > 0)[0]\n          return set(present_kinds)\n\n      def simulate_step(self, action):\n          \"\"\"Simulates one action, updating internal state.\"\"\"\n          \n          if action in ACTION_TO_DELTA_POS: # Movement action\n              dy, dx = ACTION_TO_DELTA_POS[action]\n              r, c = self.pos\n              next_r, next_c = r + dy, c + dx\n              \n              if not self._is_valid_pos(next_r, next_c):\n                  # Cannot move out of bounds, state remains unchanged\n                  return \n              \n              # Check for blocking entities in the target cell\n              # An entity is blocking if it's in non_grabbable_indices and present\n              blocking_kinds = self._get_cell_contents(next_r, next_c).intersection(self.world.non_grabbable_indices)\n              if blocking_kinds:\n                  # Cannot move into non-grabbable entities\n                  return \n\n              self.pos = (next_r, next_c)\n              self.dir = ACTION_TO_NEW_DIR[action] # Update direction based on movement action\n              \n          elif action == USE: # USE action\n              # Determine the cell in front of the agent\n              dr, dc = DIR_TO_DELTA_FACING[self.dir]\n              target_r, target_c = self.pos[0] + dr, self.pos[1] + dc\n\n              if not self._is_valid_pos(target_r, target_c):\n                  return # Cannot USE outside grid\n\n              facing_kinds = self._get_cell_contents(target_r, target_c)\n              \n              # --- Try to pick up primitive ---\n              grabbable_in_front = facing_kinds.intersection(self.world.grabbable_indices)\n              \n              # Prioritize picking up if possible\n              if grabbable_in_front:\n                  # Pick up the first grabbable item found (simple assumption if multiple)\n                  item_to_grab = next(iter(grabbable_in_front))\n                  if self.grid[target_r, target_c, item_to_grab] > 0:\n                      self.grid[target_r, target_c, item_to_grab] -= 1\n                      self.inventory[item_to_grab] += 1\n                      return # Action completed (picked up)\n              \n              # --- Try to craft an item at a workshop ---\n              workshop_in_front = facing_kinds.intersection(self.world.workshop_indices)\n              if workshop_in_front:\n                  # Iterate through all recipes and try to craft one that uses this workshop\n                  # and for which ingredients are available.\n                  \n                  for output_idx, recipe_details in self.world.cookbook.recipes.items():\n                      workshop_key = recipe_details.get(\"_key\")\n                      \n                      if workshop_key is not None: # This recipe requires a workshop\n                          workshop_idx_for_recipe = self.world.cookbook.index.get(workshop_key)\n                          \n                          if workshop_idx_for_recipe in workshop_in_front: # This workshop is in front\n                              can_craft = True\n                              for ing_idx, count in recipe_details.items():\n                                  if ing_idx == \"_key\": continue\n                                  if self.inventory[ing_idx] < count:\n                                      can_craft = False\n                                      break\n                              \n                              if can_craft:\n                                  # Consume ingredients\n                                  for ing_idx, count in recipe_details.items():\n                                      if ing_idx == \"_key\": continue\n                                      self.inventory[ing_idx] -= count\n                                  # Produce output\n                                  self.inventory[output_idx] += 1\n                                  return # Action completed (crafted)\n          # If no grab or craft occurred, USE effectively does nothing to the state.\n\n\n  def _find_path_to_interact_location(sim_state: _SimulatedCraftState, target_kind_idx: int) -> list[int] | None:\n      \"\"\"\n      Finds a path of actions (move+turn) to reach a position where the agent is adjacent\n      to `target_kind_idx` and facing it correctly.\n      Returns a list of actions or None if no such path exists.\n      \"\"\"\n      grid = sim_state.grid\n      start_pos = sim_state.pos\n      start_dir = sim_state.dir\n      height, width, _ = grid.shape\n\n      # BFS state: (current_row, current_col, current_dir, path_actions)\n      bfs_queue = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n      bfs_visited = {(start_pos[0], start_pos[1], start_dir)}\n\n      while bfs_queue:\n          r, c, current_dir, path_actions = bfs_queue.popleft()\n\n          # Check if current position allows for USE action on target_kind_idx\n          # Iterate over all possible directions the agent could be facing from (r,c)\n          for facing_dir, (dr, dc) in DIR_TO_DELTA_FACING.items():\n              facing_r, facing_c = r + dr, c + dc\n              \n              if not (0 <= facing_r < height and 0 <= facing_c < width):\n                  continue\n\n              # Check if the cell we are facing contains the target kind\n              facing_cell_contents = sim_state._get_cell_contents(facing_r, facing_c)\n              if target_kind_idx in facing_cell_contents:\n                  # We found a spot (r,c) from which we can USE (facing_r, facing_c)\n                  # IF the agent's current_dir matches the direction needed to face it.\n                  if current_dir == facing_dir:\n                      return path_actions # Path found to reach and face target\n\n          # Explore neighbors (movement actions)\n          for action, (dy, dx) in ACTION_TO_DELTA_POS.items(): # Only movement actions\n              next_r, next_c = r + dy, c + dx\n              \n              if not (0 <= next_r < height and 0 <= next_c < width):\n                  continue # Out of bounds\n\n              # Check for blocking entities\n              blocking_kinds = sim_state._get_cell_contents(next_r, next_c).intersection(sim_state.world.non_grabbable_indices)\n              if blocking_kinds:\n                  continue # Cannot move into non-grabbable entities\n\n              new_dir = ACTION_TO_NEW_DIR[action] # Direction after this move\n              \n              if (next_r, next_c, new_dir) not in bfs_visited:\n                  bfs_visited.add((next_r, next_c, new_dir))\n                  bfs_queue.append((next_r, next_c, new_dir, path_actions + [action]))\n\n      return None # No path found\n\n  def _plan_actions_to_get_item(sim_state: _SimulatedCraftState, target_item_idx: int,\n                                depth: int = 0, max_depth: int = 100) -> list[int]:\n      \"\"\"\n      Plans actions to obtain a single target item.\n      Returns a list of actions. Modifies sim_state in place (simulated).\n      Uses recursion for crafting dependencies.\n      \"\"\"\n      if depth > max_depth:\n          # Prevent excessively deep recursion\n          return []\n\n      actions_for_this_goal = []\n\n      # If already have it, no actions needed.\n      if sim_state.inventory[target_item_idx] > 0:\n          return []\n\n      # If it's a primitive, find it on the grid and pick it up\n      if target_item_idx in sim_state.world.cookbook.primitives:\n          path_to_use_location = _find_path_to_interact_location(sim_state, target_item_idx)\n          if path_to_use_location is None:\n              return [] # Cannot fulfill\n          \n          # Apply these actions to the simulated state\n          for action in path_to_use_location:\n              sim_state.simulate_step(action)\n              actions_for_this_goal.append(action)\n          \n          # Now at the correct spot and facing the item, perform USE.\n          sim_state.simulate_step(USE)\n          actions_for_this_goal.append(USE)\n          return actions_for_this_goal\n\n      # If it's a crafted item, get recipe and gather ingredients\n      recipe = sim_state.world.cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          return [] # Cannot craft, no recipe\n\n      required_ingredients = {ing_idx: count for ing_idx, count in recipe.items() if ing_idx != \"_key\"}\n      \n      # Keep trying to gather ingredients until all are met or no progress can be made.\n      # Max iterations to prevent infinite loops (e.g., if resources are exhausted or dependency loop).\n      max_ingredient_gathering_attempts = 20 \n      attempts = 0\n      \n      while any(sim_state.inventory[idx] < needed_count for idx, needed_count in required_ingredients.items()) and \\\n            attempts < max_ingredient_gathering_attempts:\n          \n          made_progress_in_attempt = False\n          for ing_idx, needed_count in required_ingredients.items():\n              current_ing_actual_count = sim_state.inventory[ing_idx]\n              num_to_get = max(0, needed_count - current_ing_actual_count)\n              \n              for _ in range(num_to_get): # Try to get remaining units of this ingredient\n                  # Recursively try to get one unit of this missing ingredient\n                  # Pass the *current* simulated state down the recursion\n                  ing_actions = _plan_actions_to_get_item(sim_state, ing_idx, depth + 1, max_depth)\n                  if not ing_actions:\n                      # Failed to get this ingredient, propagate failure\n                      return [] \n                  \n                  actions_for_this_goal.extend(ing_actions)\n                  made_progress_in_attempt = True\n                  # The recursive call `_plan_actions_to_get_item` already updates `sim_state.inventory`\n                  # for the item it successfully gathered. So the next check will see the updated count.\n                  \n                  # Break if we have enough of this specific ingredient now\n                  if sim_state.inventory[ing_idx] >= needed_count:\n                      break \n          \n          if not made_progress_in_attempt and \\\n             any(sim_state.inventory[idx] < needed_count for idx, needed_count in required_ingredients.items()):\n              # If we made no progress on any ingredient in this attempt, and still need items, we're stuck.\n              return []\n              \n          attempts += 1\n\n      # After gathering loop, verify all ingredients are truly met for this craft\n      if any(sim_state.inventory[idx] < needed_count for idx, needed_count in required_ingredients.items()):\n          return [] # Should not happen if previous checks were correct.\n\n      # All ingredients are gathered (in simulated state). Now craft.\n      workshop_key = recipe.get(\"_key\")\n      workshop_idx = None\n      if workshop_key:\n          workshop_idx = sim_state.world.cookbook.index.get(workshop_key)\n          if workshop_idx is None:\n              return [] # Unknown workshop specified in recipe\n\n      if workshop_idx is not None:\n          # Path to location where USE can be performed on workshop.\n          path_to_workshop_use_location = _find_path_to_interact_location(sim_state, workshop_idx)\n          if path_to_workshop_use_location is None:\n              return [] # Cannot reach workshop for crafting\n          \n          for action in path_to_workshop_use_location:\n              sim_state.simulate_step(action)\n              actions_for_this_goal.append(action)\n      \n      # Now at the correct spot and facing the workshop (or just generally ready if no workshop needed), perform USE.\n      sim_state.simulate_step(USE)\n      actions_for_this_goal.append(USE)\n      \n      return actions_for_this_goal\n\n\n  # Get the initial state from the environment using its internal attribute.\n  # The problem states \"Class: CraftLab ... _current_state: CraftState instance\"\n  initial_state = env._current_state\n  \n  # Create a deep copy of the initial state for simulation purposes.\n  # This ensures planning does not affect the actual environment state.\n  simulated_state = _SimulatedCraftState(initial_state)\n\n  # Plan actions to obtain the target item (assuming one unit is desired).\n  planned_actions = _plan_actions_to_get_item(simulated_state, item)\n\n  return planned_actions", "island_id": 3, "scores": {"3": -1}}
