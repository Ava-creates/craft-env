{"timestamp": "2025-07-30T15:51:19.383164", "function_name": "craft", "function_body": "    # Constants for actions\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Use deque for BFS, assuming it's available (from collections import deque)\n    # If not, would need to define a simple queue class or import it within the function.\n    from collections import deque \n\n    # Helper function for pathfinding and collection logic\n    def _get_path_and_collect_actions(current_state_in, target_kind_idx, world_config):\n        \"\"\"\n        Finds a path to an item of `target_kind_idx` and generates actions to collect it.\n        This includes movement and a final USE action if necessary.\n        Returns (list of actions, new_state) or (None, None) if path not found.\n        This function simulates state changes by stepping a copy of the input state.\n        \"\"\"\n        \n        # current_state_in is a CraftState object. CraftState.step returns a new state.\n        # We need to chain these new states for accurate simulation.\n        simulated_state = current_state_in \n\n        current_grid = simulated_state.grid\n        start_pos = simulated_state.pos\n        \n        grabbable_indices = world_config.grabbable_indices\n        workshop_indices = world_config.workshop_indices\n        non_grabbable_indices = world_config.non_grabbable_indices\n        \n        WIDTH, HEIGHT, _ = current_grid.shape\n\n        found_item_pos = None\n        min_dist = float('inf')\n\n        # Find the actual location of the item/workshop on the grid\n        for y in range(HEIGHT):\n            for x in range(WIDTH):\n                if current_grid[x, y, target_kind_idx] > 0:\n                    dist = abs(x - start_pos[0]) + abs(y - start_pos[1])\n                    if dist < min_dist:\n                        min_dist = dist\n                        found_item_pos = (x, y)\n\n        if found_item_pos is None:\n            return None, None # Item not found on grid\n\n        target_pos_for_path = None\n        requires_use_action = False\n\n        if target_kind_idx in grabbable_indices:\n            # If it's grabbable, agent moves onto the cell and uses it to pick up.\n            target_pos_for_path = found_item_pos\n            requires_use_action = True\n        elif target_kind_idx in workshop_indices:\n            # If it's a workshop, agent moves to an adjacent cell and uses it.\n            adj_cells = [\n                (found_item_pos[0], found_item_pos[1] + 1), # South\n                (found_item_pos[0], found_item_pos[1] - 1), # North\n                (found_item_pos[0] + 1, found_item_pos[1]), # East\n                (found_item_pos[0] - 1, found_item_pos[1]), # West\n            ]\n            \n            min_adj_dist = float('inf')\n            best_adj_pos = None\n\n            for adj_x, adj_y in adj_cells:\n                if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT:\n                    is_blocked = False\n                    for k_idx in non_grabbable_indices:\n                        # Check if the adjacent cell is blocked by a non-grabbable item\n                        if current_grid[adj_x, adj_y, k_idx] > 0:\n                            is_blocked = True\n                            break\n                    if not is_blocked:\n                        dist_to_adj = abs(adj_x - start_pos[0]) + abs(adj_y - start_pos[1])\n                        if dist_to_adj < min_adj_dist:\n                            min_adj_dist = dist_to_adj\n                            best_adj_pos = (adj_x, adj_y)\n            \n            if best_adj_pos:\n                target_pos_for_path = best_adj_pos\n                requires_use_action = True\n            else:\n                return None, None # No accessible adjacent cell for workshop\n        else:\n            # If the item is neither grabbable nor a workshop, it's generally not directly\n            # interactable for collection or crafting.\n            return None, None\n\n        if target_pos_for_path is None:\n            return None, None\n            \n        # BFS to find path from current_state.pos to target_pos_for_path\n        queue = deque([(start_pos[0], start_pos[1], [])]) # (x, y, path_actions)\n        visited = set([(start_pos[0], start_pos[1])])\n\n        move_deltas = {\n            RIGHT: (1, 0),\n            LEFT: (-1, 0),\n            UP: (0, -1),\n            DOWN: (0, 1),\n        }\n\n        path_found_actions = None\n        \n        while queue:\n            cx, cy, path = queue.popleft()\n\n            if (cx, cy) == target_pos_for_path:\n                path_found_actions = path\n                break\n\n            for action_val, (dx, dy) in move_deltas.items():\n                nx, ny = cx + dx, cy + dy\n\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and (nx, ny) not in visited:\n                    is_blocked = False\n                    for k_idx in non_grabbable_indices:\n                        # Agent cannot move onto a cell containing a non-grabbable item (e.g., water, stone)\n                        # unless that cell IS the target (e.g., if the target is a non-grabbable resource \n                        # that the agent needs to stand on to \"use\").\n                        if current_grid[nx, ny, k_idx] > 0: # Assume any non-grabbable blocks movement\n                            is_blocked = True\n                            break\n                    if is_blocked:\n                        continue\n                    \n                    visited.add((nx, ny))\n                    queue.append((nx, ny, path + [action_val]))\n                    \n        if path_found_actions is None:\n            return None, None # No path found\n            \n        final_actions = []\n        \n        # Simulate actions to update simulated_state\n        for action in path_found_actions:\n            final_actions.append(action)\n            _, simulated_state = simulated_state.step(action)\n        \n        if requires_use_action:\n            final_actions.append(USE)\n            _, simulated_state = simulated_state.step(USE)\n            \n        return final_actions, simulated_state\n\n\n    # Use a mutable list to hold the current state reference.\n    # This allows recursive calls to update the \"global\" state for subsequent steps.\n    current_state_wrapper = [env._current_state] \n    \n    # Memoization for storing actions taken to craft specific items.\n    # This helps avoid redundant computation and potential infinite loops in complex recipes.\n    memo_actions = {} \n\n    def _recursive_craft(target_item_idx):\n        # If target item is already in inventory of the current simulated state, we don't need to craft it.\n        if current_state_wrapper[0].inventory[target_item_idx] > 0:\n            return [] \n\n        # Check memoization: if we've already tried to craft this item in this path, return previous result.\n        # This prevents re-attempting failed crafts or getting stuck in cycles.\n        if target_item_idx in memo_actions:\n            return memo_actions[target_item_idx]\n\n        actions_for_item = []\n        current_cookbook = env.world.cookbook\n        recipe = current_cookbook.recipes.get(target_item_idx)\n\n        if recipe is None:\n            # If no recipe, it must be a primitive or an environment object that can be collected.\n            # We assume if it's an ingredient without a recipe, it must be grabbable.\n            if target_item_idx in current_cookbook.primitives or \\\n               target_item_idx in env.world.grabbable_indices:\n                \n                path_actions, new_state = _get_path_and_collect_actions(\n                    current_state_wrapper[0], target_item_idx, env.world)\n                \n                if path_actions is None:\n                    # Cannot find/collect this item. Mark as uncraftable in memo.\n                    memo_actions[target_item_idx] = []\n                    return [] \n                \n                actions_for_item.extend(path_actions)\n                current_state_wrapper[0] = new_state # Update the global current state after collection\n            else:\n                # Item is not craftable, not a grabbable primitive/environment item.\n                # Assume it's uncollectable for crafting purposes.\n                memo_actions[target_item_idx] = []\n                return []\n        else:\n            # It's a craftable item with a recipe. Process its ingredients.\n            ingredients_info = []\n            workshop_idx = None\n\n            for ingredient_idx, value in recipe.items():\n                if ingredient_idx == \"_key\":\n                    workshop_idx = value # Value is the workshop index\n                else:\n                    ingredients_info.append((ingredient_idx, value)) # (ingredient_idx, required_count)\n\n            # First, recursively craft/collect all missing ingredients\n            for ingredient_idx, needed_count in ingredients_info:\n                # Keep attempting to get the ingredient until enough is in inventory\n                while current_state_wrapper[0].inventory[ingredient_idx] < needed_count:\n                    # Attempt to get one unit of the ingredient (or whatever _recursive_craft yields).\n                    actions_for_ingredient_unit = _recursive_craft(ingredient_idx)\n                    \n                    if not actions_for_ingredient_unit:\n                        # Failed to get an ingredient, so cannot craft this item.\n                        memo_actions[target_item_idx] = []\n                        return []\n                    actions_for_item.extend(actions_for_ingredient_unit)\n\n            # Now, use the workshop if required to craft the target_item_idx\n            if workshop_idx is not None:\n                path_actions, new_state = _get_path_and_collect_actions(\n                    current_state_wrapper[0], workshop_idx, env.world)\n                \n                if path_actions is None:\n                    # Cannot reach or use the required workshop.\n                    memo_actions[target_item_idx] = []\n                    return []\n\n                actions_for_item.extend(path_actions)\n                current_state_wrapper[0] = new_state # Update global state after workshop actions\n            \n        # Store the actions needed to get this item in memoization.\n        memo_actions[target_item_idx] = actions_for_item\n        return actions_for_item\n\n    # Start the recursive crafting process for the desired item\n    final_actions = _recursive_craft(item)\n    return final_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:51:21.022882", "function_name": "craft", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:53:17.024121", "function_name": "craft", "function_body": "  # Define action constants inside the function.\n  # These values are based on CraftLab.action_specs() which maps\n  # DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Helper function to create a hashable key for a CraftState.\n  # This is crucial for the `visited` set to avoid revisiting states and cycles.\n  # `state.grid` and `state.inventory` are numpy arrays, so they must be converted to tuples.\n  def get_state_key(state):\n    # Flatten grid and convert to tuple for hashing.\n    # Assuming numpy is imported as 'np' at the module level as suggested by the problem context.\n    grid_key = tuple(state.grid.flatten())\n    # Convert inventory array to tuple for hashing.\n    inventory_key = tuple(state.inventory)\n    return (grid_key, state.pos, state.dir, inventory_key)\n\n  # The initial state is the current state of the CraftLab environment.\n  initial_state = env._current_state\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_state.satisfies(None, item):\n    return []\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  # Assuming `collections` is available at the module level.\n  queue = collections.deque([(initial_state, [])])\n  \n  # Initialize a set to keep track of visited states (using the hashable key).\n  # This prevents infinite loops and redundant exploration.\n  visited = {get_state_key(initial_state)}\n\n  # Safety limits for the search to prevent excessive computation or memory usage.\n  # These values may need tuning based on the specific environment complexity and desired search depth.\n  MAX_SEARCH_DEPTH = 100  # Maximum number of actions in a path to search.\n  MAX_QUEUE_SIZE = 50000  # Maximum number of states to hold in the queue.\n\n  # Perform BFS.\n  while queue:\n    # Check if the queue size exceeds the limit. If so, a path is likely too complex or non-existent\n    # within reasonable bounds, so we abort.\n    if len(queue) > MAX_QUEUE_SIZE:\n        return []\n\n    current_state, actions_taken = queue.popleft()\n\n    # If the current path exceeds the maximum allowed search depth, prune it.\n    if len(actions_taken) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in ALL_ACTIONS:\n      # Simulate taking the action.\n      # `current_state.step(action)` returns (reward, new_CraftState_object).\n      # We only care about the new state for pathfinding.\n      _, next_state = current_state.step(action)\n      \n      # Create the new sequence of actions that led to `next_state`.\n      new_actions_taken = actions_taken + [action]\n\n      # Check if the goal (item in inventory) is satisfied in the `next_state`.\n      if next_state.satisfies(None, item):\n        return new_actions_taken  # Goal reached! Return the sequence of actions.\n\n      # Get the hashable key for the `next_state`.\n      next_state_key = get_state_key(next_state)\n\n      # If this state has not been visited before, add it to the visited set and the queue.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        queue.append((next_state, new_actions_taken))\n  \n  # If the BFS queue becomes empty and the goal was never reached,\n  # it means no path exists within the defined limits.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:53:17.042522", "function_name": "craft", "function_body": "    # Action constants\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Direction mappings for movement (row_change, col_change)\n    _DIRECTIONS_MAP = {\n        _UP: (-1, 0),\n        _DOWN: (1, 0),\n        _LEFT: (0, -1),\n        _RIGHT: (0, 1)\n    }\n\n    # Reverse mapping from movement to action ID\n    _ACTION_FOR_MOVEMENT = {\n        (-1, 0): _UP,\n        (1, 0): _DOWN,\n        (0, -1): _LEFT,\n        (0, 1): _RIGHT\n    }\n\n    def _get_entity_coords(state, entity_kind_idx):\n        \"\"\"Finds the coordinates of the first instance of entity_kind_idx on the grid.\"\"\"\n        grid_h, grid_w, _ = state.grid.shape\n        for r in range(grid_h):\n            for c in range(grid_w):\n                if state.grid[r, c, entity_kind_idx] > 0:\n                    return (r, c)\n        return None\n\n    def _find_path_bfs(start_pos, target_pos, grid_shape):\n        \"\"\"Finds a path from start_pos to target_pos using BFS.\n        Returns a list of (dr, dc) movements relative to the current position.\"\"\"\n        q = [(start_pos, [])]  # Queue stores (current_pos, path_to_here as list of (dr, dc))\n        visited = {start_pos}\n\n        while q:\n            (r, c), path = q.pop(0)\n\n            if (r, c) == target_pos:\n                return path\n\n            for dr, dc in _DIRECTIONS_MAP.values():\n                nr, nc = r + dr, c + dc\n                # Check if new position is within grid boundaries and not already visited\n                if 0 <= nr < grid_shape[0] and 0 <= nc < grid_shape[1] and (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    q.append(((nr, nc), path + [(dr, dc)]))\n        return None  # No path found\n\n    def _move_agent_to_adjacent_recursive(current_state, target_kind_idx):\n        \"\"\"\n        Generates actions to move the agent adjacent to an object of target_kind_idx.\n        Returns (list of actions, new_simulated_state).\n        \"\"\"\n        actions = []\n        target_obj_pos = _get_entity_coords(current_state, target_kind_idx)\n        if not target_obj_pos:\n            # Target not found on grid. Cannot move to it.\n            return [], current_state\n\n        # Check if agent is already adjacent to the target\n        if current_state.next_to(target_kind_idx):\n            return [], current_state\n\n        best_path_movements = None\n        grid_h, grid_w, _ = current_state.grid.shape\n        \n        # Find path to any cell adjacent to the target object\n        for dr_adj, dc_adj in _DIRECTIONS_MAP.values():\n            adj_r, adj_c = target_obj_pos[0] + dr_adj, target_obj_pos[1] + dc_adj\n            # Check if adjacent cell is within grid boundaries\n            if 0 <= adj_r < grid_h and 0 <= adj_c < grid_w:\n                path_movements = _find_path_bfs(current_state.pos, (adj_r, adj_c), (grid_h, grid_w))\n                if path_movements is not None:\n                    # Choose the shortest path found to any adjacent cell\n                    if best_path_movements is None or len(path_movements) < len(best_path_movements):\n                        best_path_movements = path_movements\n\n        if best_path_movements is None:\n            # No path found to any adjacent cell\n            return [], current_state\n\n        # Simulate movement actions on a copy of the state\n        simulated_state = current_state\n        for dr, dc in best_path_movements:\n            action = _ACTION_FOR_MOVEMENT.get((dr, dc))\n            if action is not None:\n                actions.append(action)\n                # CraftState.step returns a new state object, which is ideal for simulation\n                _, simulated_state = simulated_state.step(action)\n        \n        return actions, simulated_state\n\n    # Recursive planning function\n    def _plan_craft(current_sim_state, target_item_idx, visited_goals_stack):\n        \"\"\"\n        Recursively finds a plan to craft target_item_idx.\n        Returns a tuple of (list of actions, final simulated state).\n        `visited_goals_stack` is a set of item IDs to detect and prevent cycles in crafting dependencies.\n        \"\"\"\n        # Base case 1: Item is already in inventory\n        if current_sim_state.inventory[target_item_idx] > 0:\n            return [], current_sim_state\n\n        # Base case 2: Cycle detection for crafting goals\n        if target_item_idx in visited_goals_stack:\n            # This goal is already in the current dependency path, indicating a cycle.\n            # In CraftWorld, recipes should be a DAG, so this usually implies an uncraftable scenario.\n            return [], current_sim_state\n        \n        # Add current goal to stack to detect future cycles\n        visited_goals_stack.add(target_item_idx)\n\n        cookbook = current_sim_state.world.cookbook\n        recipes = cookbook.recipes\n        \n        # Determine if target is a primitive or a craftable item\n        if target_item_idx in cookbook.primitives:\n            # It's a primitive resource, go collect it.\n            pickup_actions, state_at_primitive_location = _move_agent_to_adjacent_recursive(current_sim_state, target_item_idx)\n            \n            # If agent couldn't reach the primitive, or wasn't already adjacent and couldn't move there\n            if not state_at_primitive_location.next_to(target_item_idx):\n                visited_goals_stack.remove(target_item_idx) # Remove from stack before returning\n                return [], current_sim_state # Failed to position for pickup\n            \n            # Perform the USE action to pick up the primitive\n            _, final_state_after_pickup = state_at_primitive_location.step(_USE)\n            pickup_actions.append(_USE)\n            \n            # Verify if collection was successful. Inventory count should have increased.\n            if final_state_after_pickup.inventory[target_item_idx] > current_sim_state.inventory[target_item_idx]:\n                visited_goals_stack.remove(target_item_idx)\n                return pickup_actions, final_state_after_pickup\n            else:\n                # USE action didn't yield the item (e.g., it's a non-grabbable environment object like 'water')\n                visited_goals_stack.remove(target_item_idx)\n                return [], current_sim_state # Failed to collect\n\n        # If it's not a primitive, it must be a craftable item. Check for its recipe.\n        if target_item_idx not in recipes:\n            # Not a primitive and no recipe found. Cannot craft this item.\n            visited_goals_stack.remove(target_item_idx)\n            return [], current_sim_state\n\n        recipe = recipes[target_item_idx]\n        current_plan_actions = []\n        sim_state_for_current_plan = current_sim_state # This state will be updated through simulation\n\n        # 1. Collect all necessary ingredients for the recipe\n        ingredients_needed = {idx: count for idx, count in recipe.items() if idx != '_key'}\n        \n        for ing_idx, needed_count in ingredients_needed.items():\n            while sim_state_for_current_plan.inventory[ing_idx] < needed_count:\n                # Recursively plan to get the ingredient\n                ingredient_actions, state_after_ingredient_collection = _plan_craft(\n                    sim_state_for_current_plan, ing_idx, visited_goals_stack\n                )\n                \n                # If a sub-plan failed to get the ingredient, propagate the failure up\n                if not ingredient_actions and state_after_ingredient_collection.inventory[ing_idx] < needed_count:\n                    visited_goals_stack.remove(target_item_idx)\n                    return [], current_sim_state # Return original state to signify failure\n                \n                current_plan_actions.extend(ingredient_actions)\n                sim_state_for_current_plan = state_after_ingredient_collection\n\n        # 2. Use workshop to craft the item\n        workshop_key = recipe.get('_key')\n        if not workshop_key:\n            # A craftable item recipe (if not primitive) in CraftWorld must have a workshop key.\n            # This indicates an invalid recipe or unhandled case.\n            visited_goals_stack.remove(target_item_idx)\n            return [], current_sim_state\n\n        workshop_idx = cookbook.index.index(workshop_key) # Get numerical ID for the workshop\n\n        # Move to the workshop location\n        workshop_move_actions, state_at_workshop = _move_agent_to_adjacent_recursive(sim_state_for_current_plan, workshop_idx)\n        \n        # Check if agent successfully moved adjacent to the workshop\n        if not state_at_workshop.next_to(workshop_idx):\n            visited_goals_stack.remove(target_item_idx)\n            return [], current_sim_state # Failed to reach workshop\n        \n        current_plan_actions.extend(workshop_move_actions)\n        sim_state_for_current_plan = state_at_workshop\n\n        # Perform the USE action at the workshop. This consumes ingredients and produces the output.\n        _, final_state_after_craft = sim_state_for_current_plan.step(_USE)\n        current_plan_actions.append(_USE)\n        \n        # Verify if the target item was successfully crafted\n        if final_state_after_craft.inventory[target_item_idx] > current_sim_state.inventory[target_item_idx]:\n            visited_goals_stack.remove(target_item_idx)\n            return current_plan_actions, final_state_after_craft\n        else:\n            # Crafting failed (e.g., perhaps wrong workshop was used, or some other precondition)\n            visited_goals_stack.remove(target_item_idx)\n            return [], current_sim_state # Failed to craft at workshop\n    \n    # --- Main execution of craft_v2 ---\n    initial_state = env._current_state\n    \n    # If the item is already in the inventory, no actions are needed.\n    if initial_state.inventory[item] > 0:\n        return []\n\n    # Create a deep copy of the current state to simulate actions without modifying the actual env state.\n    # The `CraftState.step` method already returns a new state object, which simplifies simulation.\n    # However, we need a clean starting point for the recursive planner.\n    initial_sim_state = CraftState(\n        initial_state.scenario, \n        initial_state.grid.copy(), \n        initial_state.pos, \n        initial_state.dir, \n        initial_state.inventory.copy()\n    )\n\n    # Call the recursive planner to generate the action sequence\n    # An empty set is used for `visited_goals_stack` for the top-level call.\n    final_actions, _ = _plan_craft(initial_sim_state, item, set())\n\n    return final_actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:55:07.970426", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n  \n  # Mapping from direction index to (row_delta, col_delta) of the cell in front\n  # Assumes DMLab-style direction indices: 0=DOWN, 1=UP, 2=RIGHT, 3=LEFT\n  DIRECTION_TO_FRONT_CELL_DELTA = {\n      0: (1, 0),   # Facing DOWN, cell in front is (r+1, c)\n      1: (-1, 0),  # Facing UP, cell in front is (r-1, c)\n      2: (0, 1),   # Facing RIGHT, cell in front is (r, c+1)\n      3: (0, -1)   # Facing LEFT, cell in front is (r, c-1)\n  }\n\n  # Mapping from movement action to (row_delta, col_delta, new_facing_direction_index)\n  # The new facing direction is the direction of movement.\n  MOVE_ACTION_TO_DELTA_AND_DIR = {\n      UP:    (-1, 0, 1),  # Move Up: r-1, c, face Up (dir 1)\n      DOWN:  (1, 0, 0),   # Move Down: r+1, c, face Down (dir 0)\n      LEFT:  (0, -1, 3),  # Move Left: r, c-1, face Left (dir 3)\n      RIGHT: (0, 1, 2)    # Move Right: r, c+1, face Right (dir 2)\n  }\n\n  def _is_valid_pos(pos, grid_shape):\n      \"\"\"Checks if a given (row, col) position is within the grid boundaries.\"\"\"\n      r, c = pos\n      H, W, _ = grid_shape\n      return 0 <= r < H and 0 <= c < W\n\n  def _is_walkable(pos, current_grid, world_ref, target_kind_idx_for_pathfinding=None):\n      \"\"\"\n      Checks if a position `pos` is walkable by the agent.\n      - Water is always impassable.\n      - Other non-grabbable items are obstacles, unless the cell specifically contains\n        `target_kind_idx_for_pathfinding`, allowing the agent to move onto or adjacent to its target.\n      \"\"\"\n      r, c = pos\n      H, W, _ = current_grid.shape\n      if not (0 <= r < H and 0 <= c < W):\n          return False # Out of bounds\n\n      # Water is always impassable.\n      if current_grid[r, c, world_ref.water_index] > 0:\n          return False\n      \n      # Non-grabbable items generally block movement.\n      # Iterate through all non-grabbable indices to check for obstacles.\n      for idx in world_ref.non_grabbable_indices:\n          if current_grid[r, c, idx] > 0:\n              # If the cell contains a non-grabbable item that is NOT the specific target\n              # we're pathfinding towards, then it's an obstacle. Otherwise, we can pass.\n              if idx != target_kind_idx_for_pathfinding:\n                  return False\n      \n      return True\n\n  def _get_kind_positions(kind_index, grid):\n      \"\"\"\n      Returns a list of (row, col) positions where `kind_index` exists in the grid.\n      Grid shape: (H, W, N_KINDS).\n      \"\"\"\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      return [tuple(pos) for pos in positions]\n\n  def _bfs_path_with_facing(start_pos, start_dir, target_kind_idx, grid, world_obj):\n      \"\"\"\n      Finds a path (list of movement actions) from `start_pos` to reach a state\n      where `target_kind_idx` can be interacted with using the 'USE' action.\n      This means either being on the target's cell (for primitives) or adjacent to it\n      and facing it (for workshops/non-grabbables).\n\n      Args:\n          start_pos: Agent's starting (row, col) position.\n          start_dir: Agent's starting direction (0=DOWN, 1=UP, 2=RIGHT, 3=LEFT).\n          target_kind_idx: The integer index of the item/workshop to reach.\n          grid: The current numpy grid array.\n          world_obj: The CraftWorld instance (for cookbook, non_grabbable_indices).\n\n      Returns:\n          A tuple: (actions_list, final_pos, final_dir) or (None, None, None) if no path is found.\n          `final_pos` and `final_dir` represent the agent's state at the end of `actions_list`.\n      \"\"\"\n      queue = collections.deque([(start_pos, start_dir, [])]) # (pos, dir, path_actions)\n      # Visited set tracks (position, direction) to avoid redundant explorations and cycles.\n      visited = {(start_pos, start_dir)}\n\n      target_positions = _get_kind_positions(target_kind_idx, grid)\n      if not target_positions:\n          return None, None, None # Target does not exist on the current grid.\n\n      is_target_primitive = target_kind_idx in world_obj.cookbook.primitives\n      \n      # Pre-calculate all valid (agent_pos, agent_dir) pairs that enable 'USE' on a target.\n      goal_states_for_use = set()\n      for tr, tc in target_positions: # Iterate over all locations where the target kind is found.\n          if is_target_primitive:\n              # For primitives, the agent typically needs to be on the item's cell for pickup.\n              # All 4 directions are considered valid for being \"in position\" on a primitive.\n              for d in range(4):\n                  if _is_walkable((tr, tc), grid, world_obj, target_kind_idx):\n                      goal_states_for_use.add(((tr, tc), d))\n          else:\n              # For workshops (non-grabbables), the agent needs to be adjacent and facing the target.\n              for d_idx, (dr, dc) in DIRECTION_TO_FRONT_CELL_DELTA.items():\n                  # Calculate the agent's position (ar, ac) that would be facing (tr, tc)\n                  ar, ac = tr - dr, tc - dc \n                  if _is_valid_pos((ar, ac), grid.shape) and \\\n                     _is_walkable((ar, ac), grid, world_obj, target_kind_idx):\n                      goal_states_for_use.add(((ar, ac), d_idx))\n\n      while queue:\n          current_pos, current_dir, current_path = queue.popleft()\n\n          # If the current (position, direction) is a valid goal state for using the target, return the path.\n          if (current_pos, current_dir) in goal_states_for_use:\n              return current_path, current_pos, current_dir\n\n          # Explore possible next movements (UP, DOWN, LEFT, RIGHT).\n          for action in MOVEMENT_ACTIONS:\n              r_delta, c_delta, new_facing_dir = MOVE_ACTION_TO_DELTA_AND_DIR[action]\n              next_pos = (current_pos[0] + r_delta, current_pos[1] + c_delta)\n\n              # If the next position is walkable and this specific (position, direction) state\n              # hasn't been visited yet, add it to the queue for further exploration.\n              if _is_walkable(next_pos, grid, world_obj, target_kind_idx) and \\\n                 (next_pos, new_facing_dir) not in visited:\n                  next_path = current_path + [action]\n                  visited.add((next_pos, new_facing_dir))\n                  queue.append((next_pos, new_facing_dir, next_path))\n\n      return None, None, None # No path found to any suitable interaction point for the target.\n\n  def _craft_item_recursive(current_simulated_state, item_idx, world_obj, visited_recipes_in_stack):\n      \"\"\"\n      Recursively plans and simulates actions to craft or acquire a specific item.\n      This function takes a `current_simulated_state` which represents the agent's\n      and world's state after all preceding planned actions have been \"executed\" in simulation.\n\n      Args:\n          current_simulated_state: The current `CraftState` instance representing the world\n                                     and agent's state in the simulated future.\n          item_idx: The integer index of the item to craft/acquire.\n          world_obj: The `CraftWorld` instance, containing cookbook, grid information, etc.\n          visited_recipes_in_stack: A set tracking items currently in the recursion call stack\n                                    to detect and prevent infinite loops due to circular dependencies\n                                    (e.g., if item A needs B, and B needs A).\n\n      Returns:\n          A tuple: (actions_list, final_simulated_state_after_acquisition)\n          - `actions_list`: A list of actions (integers) planned to acquire the item.\n          - `final_simulated_state_after_acquisition`: The `CraftState` instance after\n            simulating the actions to get the item.\n          Returns `([], current_simulated_state)` if the item cannot be crafted/acquired\n          from the `current_simulated_state` along this particular path.\n      \"\"\"\n      actions_sequence = []\n\n      # Base case 1: If the item is already present in the current simulated inventory, no actions are needed.\n      if current_simulated_state.inventory[item_idx] > 0:\n          return actions_sequence, current_simulated_state\n\n      # Base case 2: Prevent infinite recursion. If this `item_idx` is already in the\n      # current call stack, it indicates a circular dependency, so we cannot proceed.\n      if item_idx in visited_recipes_in_stack:\n          return [], current_simulated_state \n\n      # Add this item to the set of currently visited recipes to detect cycles.\n      visited_recipes_in_stack.add(item_idx)\n\n      cookbook = world_obj.cookbook\n\n      # Strategy 1: Attempt to acquire the item if it's a primitive (can be picked up directly from the grid).\n      if item_idx in cookbook.primitives:\n          path_to_primitive_actions, _, _ = _bfs_path_with_facing(\n              current_simulated_state.pos, current_simulated_state.dir, item_idx, \n              current_simulated_state.grid, world_obj\n          )\n          if path_to_primitive_actions is None:\n              # Primitive not reachable/found on the grid from the current simulated state.\n              visited_recipes_in_stack.remove(item_idx) # Backtrack: remove from stack.\n              return [], current_simulated_state # Indicate failure.\n\n          actions_sequence.extend(path_to_primitive_actions)\n          \n          # Simulate the state after agent's movement to the primitive's location.\n          simulated_state_after_movement = current_simulated_state\n          for act in path_to_primitive_actions:\n              _, simulated_state_after_movement = simulated_state_after_movement.step(act)\n\n          # Agent is now in position and facing correctly. Execute the 'USE' action to pick it up.\n          _, final_state_after_use = simulated_state_after_movement.step(USE)\n          actions_sequence.append(USE)\n\n          # Verify if the item was successfully acquired after the 'USE' action.\n          if final_state_after_use.inventory[item_idx] > simulated_state_after_movement.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx) # Successfully acquired, remove from stack.\n              return actions_sequence, final_state_after_use\n          else:\n              # The 'USE' action failed to pick up the item (e.g., wrong item, or depleted).\n              visited_recipes_in_stack.remove(item_idx) # Failure, remove from stack.\n              return [], current_simulated_state # Indicate failure.\n\n      # Strategy 2: Attempt to craft the item if it has a recipe.\n      if item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[item_idx]\n          required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n          workshop_idx = recipe.get(\"_key\")\n\n          # All crafting recipes in CraftWorld that produce an item are assumed to require a workshop.\n          if workshop_idx is None:\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_simulated_state\n\n          # Recursively gather all required ingredients.\n          # `simulated_state_for_ingredients` will track the evolving state as each ingredient is acquired.\n          simulated_state_for_ingredients = current_simulated_state\n          for ingredient_idx, count_needed in required_ingredients.items():\n              while simulated_state_for_ingredients.inventory[ingredient_idx] < count_needed:\n                  # IMPORTANT: Pass a COPY of `visited_recipes_in_stack` to recursive calls for ingredients.\n                  # This allows different branches of the recipe tree to acquire the same ingredient\n                  # if needed, while still preventing direct cycles within a single ingredient's dependency chain.\n                  ingredient_actions, state_after_ingredient_acquisition = _craft_item_recursive(\n                      simulated_state_for_ingredients, ingredient_idx, world_obj, visited_recipes_in_stack.copy()\n                  )\n                  \n                  # If no actions were found to get the ingredient AND we still don't have enough,\n                  # then this branch of crafting has failed.\n                  if not ingredient_actions and state_after_ingredient_acquisition.inventory[ingredient_idx] < count_needed:\n                      visited_recipes_in_stack.remove(item_idx)\n                      return [], current_simulated_state # Propagate failure up the chain.\n                  \n                  actions_sequence.extend(ingredient_actions)\n                  simulated_state_for_ingredients = state_after_ingredient_acquisition\n\n          # All ingredients gathered. Now, navigate to the required workshop and use it to craft the item.\n          path_to_workshop_actions, _, _ = _bfs_path_with_facing(\n              simulated_state_for_ingredients.pos,\n              simulated_state_for_ingredients.dir,\n              workshop_idx,\n              simulated_state_for_ingredients.grid,\n              world_obj\n          )\n          if path_to_workshop_actions is None:\n              # Cannot reach the required workshop from the current simulated state.\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_simulated_state # Propagate failure.\n\n          actions_sequence.extend(path_to_workshop_actions)\n          # Simulate state after agent's movement to the workshop.\n          for act in path_to_workshop_actions:\n              _, simulated_state_for_ingredients = simulated_state_for_ingredients.step(act)\n\n          # Agent is now in position and facing correctly. Execute 'USE' action to craft.\n          _, final_state_after_crafting = simulated_state_for_ingredients.step(USE)\n          actions_sequence.append(USE)\n\n          # Verify if the item was successfully crafted after the 'USE' action.\n          if final_state_after_crafting.inventory[item_idx] > simulated_state_for_ingredients.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx)\n              return actions_sequence, final_state_after_crafting\n          else:\n              # The 'USE' action failed to craft the item (e.g., consumed ingredients without producing output).\n              visited_recipes_in_stack.remove(item_idx)\n              return [], current_simulated_state # Propagate failure.\n\n      # If the item is neither a primitive nor has a known recipe, it cannot be crafted or acquired.\n      visited_recipes_in_stack.remove(item_idx)\n      return [], current_simulated_state\n\n  # Retrieve the current state from the CraftLab environment.\n  # This is the actual starting point for our action plan.\n  initial_env_state = env._current_state\n  world_instance = env.world # Reference to the CraftWorld instance for cookbook and other configurations.\n\n  # Early exit: If the target item is already present in the initial inventory, no actions are needed.\n  if initial_env_state.inventory[item] > 0:\n      return []\n\n  # Initiate the recursive planning process from the initial environment state.\n  # The `visited_recipes_in_stack` set starts empty for the top-level call.\n  total_actions, final_simulated_state = _craft_item_recursive(\n      initial_env_state, item, world_instance, set()\n  )\n\n  # Final verification: Check if the target item's count in the simulated final state\n  # has increased compared to its count in the actual initial state.\n  if final_simulated_state.inventory[item] > initial_env_state.inventory[item]:\n      return total_actions\n  else:\n      # If the item was not successfully acquired in the simulation, return an empty list.\n      return []", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:55:09.366607", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants, derived from CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MOVEMENT_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n  \n  # Mapping from direction index to (row_delta, col_delta) of the cell in front\n  # Assumes DMLab-style direction indices: 0=DOWN, 1=UP, 2=RIGHT, 3=LEFT\n  DIRECTION_TO_FRONT_CELL_DELTA = {\n      0: (1, 0),   # Facing DOWN, cell in front is (r+1, c)\n      1: (-1, 0),  # Facing UP, cell in front is (r-1, c)\n      2: (0, 1),   # Facing RIGHT, cell in front is (r, c+1)\n      3: (0, -1)   # Facing LEFT, cell in front is (r, c-1)\n  }\n\n  # Mapping from movement action to (row_delta, col_delta, new_facing_direction_index)\n  # The new facing direction is the direction of movement.\n  MOVE_ACTION_TO_DELTA_AND_DIR = {\n      UP:    (-1, 0, 1),  # Move Up: r-1, c, face Up (dir 1)\n      DOWN:  (1, 0, 0),   # Move Down: r+1, c, face Down (dir 0)\n      LEFT:  (0, -1, 3),  # Move Left: r, c-1, face Left (dir 3)\n      RIGHT: (0, 1, 2)    # Move Right: r, c+1, face Right (dir 2)\n  }\n\n  def _is_valid_pos(pos, grid_shape):\n      r, c = pos\n      H, W, _ = grid_shape\n      return 0 <= r < H and 0 <= c < W\n\n  def _is_walkable(pos, current_grid, world_ref, target_kind_idx_for_pathfinding=None):\n      \"\"\"\n      Checks if a position `pos` is walkable.\n      `target_kind_idx_for_pathfinding`: The specific kind index the BFS is trying to reach.\n                                          Allows walking onto target primitive or ignoring target workshop as obstacle.\n      \"\"\"\n      r, c = pos\n      H, W, _ = current_grid.shape\n      if not (0 <= r < H and 0 <= c < W):\n          return False # Out of bounds\n\n      # Water is always impassable\n      if current_grid[r, c, world_ref.water_index] > 0:\n          return False\n      \n      # Non-grabbable items are generally obstacles.\n      # If a cell contains any non-grabbable item that is NOT our specific target, it's an obstacle.\n      # This allows us to walk onto a cell if it contains a primitive (which might be in non_grabbable_indices\n      # in some configurations, though typically primitives are grabbable), or to navigate around other workshops.\n      for idx in world_ref.non_grabbable_indices:\n          if current_grid[r, c, idx] > 0:\n              if idx != target_kind_idx_for_pathfinding:\n                  return False\n      \n      return True\n\n  def _get_kind_positions(kind_index, grid):\n      \"\"\"\n      Returns a list of (row, col) positions where kind_index exists in the grid.\n      grid shape: (H, W, N_KINDS)\n      \"\"\"\n      positions = np.argwhere(grid[:, :, kind_index] > 0)\n      return [tuple(pos) for pos in positions]\n\n  def _bfs_path_with_facing(start_pos, start_dir, target_kind_idx, grid, world_obj):\n      \"\"\"\n      Finds a path (list of actions) from `start_pos` to reach a state where the `target_kind_idx`\n      can be interacted with using the 'USE' action.\n      This means either being on the target's cell (for primitives) or adjacent to it and facing it\n      (for workshops).\n\n      Returns: (actions_list, final_pos, final_dir) or (None, None, None) if no path.\n      \"\"\"\n      queue = collections.deque([(start_pos, start_dir, [])])\n      # Visited set tracks (position, direction) to avoid cycles and redundant paths\n      visited = {(start_pos, start_dir)}\n\n      target_positions = _get_kind_positions(target_kind_idx, grid)\n      if not target_positions:\n          return None, None, None # Target does not exist on the current grid\n\n      is_target_primitive = target_kind_idx in world_obj.cookbook.primitives\n      \n      # Pre-calculate all valid (agent_pos, agent_dir) pairs that enable 'USE' on a target.\n      goal_states_for_use = set()\n      for tr, tc in target_positions:\n          if is_target_primitive:\n              # For primitives, agent needs to be on the item's cell. Direction might not matter for pickup.\n              # Assuming direction doesn't block pickup if on the cell for primitives.\n              for d in range(4): # All 4 directions are valid at the target cell for pickup\n                  if _is_walkable((tr, tc), grid, world_obj, target_kind_idx):\n                      goal_states_for_use.add(((tr, tc), d))\n          else:\n              # For workshops/non-grabbables, agent needs to be adjacent and face the target.\n              for d_idx, (dr, dc) in DIRECTION_TO_FRONT_CELL_DELTA.items():\n                  # Calculate agent position (ar, ac) if facing (dr, dc) towards (tr,tc)\n                  ar, ac = tr - dr, tc - dc \n                  if _is_valid_pos((ar, ac), grid.shape) and\\\n                     _is_walkable((ar, ac), grid, world_obj, target_kind_idx):\n                      goal_states_for_use.add(((ar, ac), d_idx))\n\n      while queue:\n          current_pos, current_dir, current_path = queue.popleft()\n\n          # Check if the current (pos, dir) is a goal state for 'USE' action\n          if ((current_pos, current_dir)) in goal_states_for_use:\n              return current_path, current_pos, current_dir\n\n          # Explore possible next movements\n          for action in MOVEMENT_ACTIONS:\n              r_delta, c_delta, new_facing_dir = MOVE_ACTION_TO_DELTA_AND_DIR[action]\n              next_pos = (current_pos[0] + r_delta, current_pos[1] + c_delta)\n\n              if _is_walkable(next_pos, grid, world_obj, target_kind_idx) and\\\n                 (next_pos, new_facing_dir) not in visited:\n                  next_path = current_path + [action]\n                  visited.add((next_pos, new_facing_dir))\n                  queue.append((next_pos, new_facing_dir, next_path))\n\n      return None, None, None # No path found to the target\n\n  def _craft_item_recursive(current_state_in_recursion, item_idx, world_obj, visited_recipes_in_stack):\n      \"\"\"\n      Recursively plans actions to craft or acquire a specific item.\n\n      Args:\n          current_state_in_recursion: The current CraftState of the agent and world.\n          item_idx: The integer index of the item to craft/acquire.\n          world_obj: The CraftWorld instance, containing cookbook, grid info, etc.\n          visited_recipes_in_stack: A set tracking items currently in the recursion call stack\n                                    to prevent infinite loops due to circular dependencies.\n\n      Returns:\n          A tuple: (actions_list, final_state) if successful.\n                   (None, None) if the item cannot be crafted/acquired.\n      \"\"\"\n      # Base case 1: If the item is already in the inventory, no actions are needed.\n      if current_state_in_recursion.inventory[item_idx] > 0:\n          return [], current_state_in_recursion\n\n      # Base case 2: Prevent infinite recursion for items involved in a dependency cycle\n      # within the current planning path.\n      if item_idx in visited_recipes_in_stack:\n          return None, None # Indicate failure due to circular dependency\n\n      # Mark this item as currently being processed in the recursion stack.\n      visited_recipes_in_stack.add(item_idx)\n\n      cookbook = world_obj.cookbook\n\n      # Strategy 1: Check if the item is a primitive (can be picked up directly from the grid).\n      if item_idx in cookbook.primitives:\n          path_actions, _final_pos, _final_dir = _bfs_path_with_facing(\n              current_state_in_recursion.pos, current_state_in_recursion.dir, item_idx, current_state_in_recursion.grid, world_obj\n          )\n          if path_actions is None:\n              # Primitive not reachable/found on the grid.\n              visited_recipes_in_stack.remove(item_idx) # Backtrack\n              return None, None\n\n          simulated_state = current_state_in_recursion\n          for act in path_actions:\n              _reward, simulated_state = simulated_state.step(act)\n          \n          # Agent is now in position and facing correctly. Use the 'USE' action to pick it up.\n          _reward, next_state = simulated_state.step(USE)\n          \n          # Verify if the item was successfully acquired after 'USE'.\n          if next_state.inventory[item_idx] > simulated_state.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx) # Backtrack\n              return path_actions + [USE], next_state\n          else:\n              # 'USE' action failed to pick up the item (e.g., wrong item used).\n              visited_recipes_in_stack.remove(item_idx) # Backtrack\n              return None, None\n\n      # Strategy 2: Check if the item has a recipe (requires crafting at a workshop).\n      if item_idx in cookbook.recipes:\n          recipe = cookbook.recipes[item_idx]\n          required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n          workshop_idx = recipe.get(\"_key\")\n\n          # All crafting recipes in CraftWorld that produce an item are assumed to require a workshop.\n          if workshop_idx is None:\n              visited_recipes_in_stack.remove(item_idx) # Backtrack\n              return None, None\n\n          actions_for_this_item = []\n          simulated_state_after_ingredients = current_state_in_recursion\n\n          for ingredient_idx, count_needed in required_ingredients.items():\n              while simulated_state_after_ingredients.inventory[ingredient_idx] < count_needed:\n                  # Recursively get the ingredient. Pass a COPY of `visited_recipes_in_stack`\n                  # to allow different branches of the dependency tree, while still preventing\n                  # cycles within the current path.\n                  ingredient_actions, state_after_ingredient_attempt = _craft_item_recursive(\n                      simulated_state_after_ingredients, ingredient_idx, world_obj, visited_recipes_in_stack.copy()\n                  )\n                  \n                  if ingredient_actions is None: # Failed to obtain a required ingredient\n                      visited_recipes_in_stack.remove(item_idx) # Backtrack\n                      return None, None # Indicate failure to craft the main item\n                  \n                  actions_for_this_item.extend(ingredient_actions)\n                  simulated_state_after_ingredients = state_after_ingredient_attempt\n\n          # All ingredients gathered. Now, navigate to the workshop and use it to craft the item.\n          path_actions_to_workshop, _final_pos, _final_dir = _bfs_path_with_facing(\n              simulated_state_after_ingredients.pos,\n              simulated_state_after_ingredients.dir,\n              workshop_idx,\n              simulated_state_after_ingredients.grid,\n              world_obj\n          )\n          if path_actions_to_workshop is None:\n              # Cannot reach the required workshop.\n              visited_recipes_in_stack.remove(item_idx) # Backtrack\n              return None, None\n\n          actions_for_this_item.extend(path_actions_to_workshop)\n          # Simulate state after movement to the workshop.\n          for act in path_actions_to_workshop:\n              _reward, simulated_state_after_ingredients = simulated_state_after_ingredients.step(act)\n\n          # Agent is now in position and facing correctly. Use the 'USE' action to craft.\n          _reward, next_state = simulated_state_after_ingredients.step(USE)\n          actions_for_this_item.append(USE)\n\n          # Verify if the item was successfully crafted after 'USE'.\n          if next_state.inventory[item_idx] > simulated_state_after_ingredients.inventory[item_idx]:\n              visited_recipes_in_stack.remove(item_idx) # Backtrack\n              return actions_for_this_item, next_state\n          else:\n              # 'USE' action failed to craft the item (e.g., consumed ingredients without success).\n              visited_recipes_in_stack.remove(item_idx) # Backtrack\n              return None, None\n\n      # If the item is neither a primitive nor has a known recipe, it cannot be crafted.\n      visited_recipes_in_stack.remove(item_idx) # Backtrack\n      return None, None\n\n  # Retrieve the current state from the CraftLab environment.\n  # We assume env._current_state holds the initial state for planning this sequence of actions.\n  initial_state = env._current_state\n  world = env.world # Reference to the CraftWorld instance, needed for cookbook and grid info.\n\n  # Early exit: If the item is already present in the initial inventory, no actions are needed.\n  if initial_state.inventory[item] > 0:\n      return []\n\n  # Initiate the recursive planning process.\n  # The _craft_item_recursive function will now return (None, None) if the item\n  # cannot be crafted or acquired.\n  actions, _ = _craft_item_recursive(initial_state, item, world, set())\n\n  # If actions is not None, it means a valid plan was found.\n  if actions is not None:\n      return actions\n  else:\n      return [] # Return an empty list if the item could not be crafted or acquired.", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:56:34.855792", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  _MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  def _hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Memoization dictionary for the main planning function\n  plan_memo = {}\n  # Memoization dictionary for the BFS movement function\n  bfs_memo = {}\n\n  cookbook = env.world.cookbook # Get cookbook once for efficiency\n\n  # Determine a reasonable max depth for BFS movement based on grid size.\n  # This makes the BFS more robust for different environment dimensions compared to a fixed constant.\n  # A safe upper bound for path length in a grid without loops is (width * height).\n  # Multiplying by 2 allows for some detours or less direct paths if necessary.\n  grid_width, grid_height, _ = env._current_state.grid.shape\n  _MAX_MOVE_DEPTH = grid_width * grid_height * 2\n\n  # A Breadth-First Search (BFS) helper function specifically for movement.\n  # It finds a sequence of movement actions from a start state to a state\n  # where the agent is next to a specified kind of entity.\n  def _bfs_move_to_kind(start_s, target_kind_idx, max_depth=_MAX_MOVE_DEPTH):\n      \"\"\"\n      Performs a BFS using only movement actions to find a path to a state\n      where the agent is next to the target_kind_idx. Memoized.\n\n      Args:\n          start_s (CraftState): The starting state.\n          target_kind_idx (int): The index of the entity kind to move next to.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths.\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found, else (None, None).\n      \"\"\"\n      memo_key = (_hash_craft_state(start_s), target_kind_idx)\n      if memo_key in bfs_memo:\n          return bfs_memo[memo_key]\n\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)} # Visited states to avoid cycles and redundant paths\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal: being next to the target kind\n          if curr_s.next_to(target_kind_idx):\n              bfs_memo[memo_key] = (curr_p, curr_s) # Cache success\n              return curr_p, curr_s\n\n          # Prune if path exceeds max_depth to prevent excessively long or infinite searches\n          if len(curr_p) >= max_depth:\n              continue\n\n          # Explore only movement actions\n          for action in _MOVE_ACTIONS:\n              _, next_s = curr_s.step(action) # Rewards are ignored as per problem spec\n              next_hash = _hash_craft_state(next_s)\n\n              # Add to queue only if the new state is unique and not previously visited\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      bfs_memo[memo_key] = (None, None) # Cache failure\n      return None, None  # No path found\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops).\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n      Memoized.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n\n      Returns:\n          tuple: (list of actions, final_state) required to craft the item, or (None, None) if impossible.\n      \"\"\"\n      # Use the hashed state and target item index as the memoization key\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n      \n      if memo_key in plan_memo:\n          return plan_memo[memo_key] # Return cached result\n\n      # Base Case 1: Item is already in inventory\n      if current_state_for_goal.inventory[target_item_idx] > 0:\n          plan_memo[memo_key] = ([], current_state_for_goal)\n          return [], current_state_for_goal\n\n      current_state_after_actions = current_state_for_goal # State to be updated through the planning process\n      actions_for_this_goal = [] # Accumulate actions for this specific crafting goal\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          # Step A: Move next to the primitive\n          path_to_primitive, state_at_primitive = _bfs_move_to_kind(\n              current_state_after_actions, target_item_idx\n          )\n          \n          if path_to_primitive is None:\n              plan_memo[memo_key] = (None, None)  # Cache failure\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_primitive)\n          current_state_after_actions = state_at_primitive\n\n          # Step B: Perform the USE action to gather the primitive\n          current_count_before_use = current_state_after_actions.inventory[target_item_idx]\n          _, state_after_use = current_state_after_actions.step(USE)\n\n          # Verify that the USE action successfully obtained the primitive\n          if state_after_use.inventory[target_item_idx] > current_count_before_use:\n              actions_for_this_goal.append(USE) # Add the USE action to the plan\n              plan_memo[memo_key] = (actions_for_this_goal, state_after_use) # Cache success\n              return actions_for_this_goal, state_after_use\n          else:\n              # USE action did not result in obtaining the primitive (e.g., failed pickup)\n              plan_memo[memo_key] = (None, None) # Cache failure\n              return None, None\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          plan_memo[memo_key] = (None, None) \n          return None, None \n      \n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      # Step A: Gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_actions.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_actions, ingredient_idx)\n              \n              if actions_for_one_ing is None:\n                  plan_memo[memo_key] = (None, None) # If an ingredient cannot be obtained, this craft fails\n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_state_after_actions = next_state_after_ingredient\n\n      # Step B: Move to workshop if required\n      if workshop_needed is not None:\n          path_to_workshop, state_at_workshop = _bfs_move_to_kind(\n              current_state_after_actions, workshop_needed\n          )\n          \n          if path_to_workshop is None:\n              plan_memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          current_state_after_actions = state_at_workshop\n\n      # Step C: Perform the USE action to craft the item\n      current_inv_of_target = current_state_after_actions.inventory[target_item_idx]\n      _, final_state_after_craft = current_state_after_actions.step(USE)\n\n      # Check if crafting was successful (inventory of target item increased)\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target:\n          actions_for_this_goal.append(USE) # Add the USE action to the plan\n          plan_memo[memo_key] = (actions_for_this_goal, final_state_after_craft)\n          return actions_for_this_goal, final_state_after_craft\n      else:\n          # Crafting failed (e.g., insufficient ingredients despite prior steps, wrong workshop, or unexpected condition)\n          plan_memo[memo_key] = (None, None)\n          return None, None\n\n  # Start the planning process for the top-level goal item\n  initial_state = env._current_state\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item)\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path not found", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:56:36.416911", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  _MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n  # Helper to make CraftState instances hashable for memoization and visited sets.\n  def _hash_craft_state(state):\n      \"\"\"Returns a hashable tuple representation of a CraftState for memoization.\"\"\"\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Memoization dictionaries for the main planning function and BFS movement function.\n  # These are defined inside craft_v2 to ensure they are fresh for each call to the function.\n  plan_memo = {}\n  bfs_memo = {}\n\n  cookbook = env.world.cookbook # Get cookbook once for efficiency\n\n  # A Breadth-First Search (BFS) helper function specifically for movement.\n  # It finds a sequence of movement actions from a start state to a state\n  # where the agent is next to a specified kind of entity.\n  def _bfs_move_to_kind(start_s, target_kind_idx, max_depth=100):\n      \"\"\"\n      Performs a BFS using only movement actions to find a path to a state\n      where the agent is next to the target_kind_idx. Memoized.\n\n      Args:\n          start_s (CraftState): The starting state.\n          target_kind_idx (int): The index of the entity kind to move next to.\n          max_depth (int): Maximum depth of the search to prevent excessively long paths.\n\n      Returns:\n          tuple: (list of actions, final_state) if a path is found, else (None, None).\n      \"\"\"\n      memo_key = (_hash_craft_state(start_s), target_kind_idx)\n      if memo_key in bfs_memo:\n          return bfs_memo[memo_key]\n\n      queue = collections.deque([(start_s, [])])  # (current_state, actions_to_reach_current_state)\n      visited = {_hash_craft_state(start_s)} # Visited states to avoid cycles and redundant paths\n\n      while queue:\n          curr_s, curr_p = queue.popleft()\n\n          # Check if the current state satisfies the goal: being next to the target kind\n          if curr_s.next_to(target_kind_idx):\n              bfs_memo[memo_key] = (curr_p, curr_s) # Cache success\n              return curr_p, curr_s\n\n          # Prune if path exceeds max_depth\n          if len(curr_p) >= max_depth:\n              continue\n\n          # Explore only movement actions\n          for action in _MOVE_ACTIONS:\n              _, next_s = curr_s.step(action) # Rewards are ignored as per problem spec\n              next_hash = _hash_craft_state(next_s)\n\n              # Add to queue only if the new state is unique and not previously visited\n              if next_hash not in visited:\n                  visited.add(next_hash)\n                  queue.append((next_s, curr_p + [action]))\n      \n      bfs_memo[memo_key] = (None, None) # Cache failure\n      return None, None  # No path found\n\n  # Recursive planning function to determine actions needed to craft a target item.\n  # It breaks down the crafting into sub-goals (gathering ingredients, moving to workshops).\n  def _plan_craft_recursive(current_state_for_goal, target_item_idx, current_recursion_path_set):\n      \"\"\"\n      Recursively plans the actions to craft a target item starting from a given state.\n      Memoized and includes cycle detection for circular recipe dependencies.\n\n      Args:\n          current_state_for_goal (CraftState): The current state of the environment for this planning step.\n          target_item_idx (int): The index of the item to be crafted.\n          current_recursion_path_set (set): A set of (state_hash_key, item_idx) tuples\n                                            currently in the recursion call stack to detect cycles.\n\n      Returns:\n          tuple: (list of actions, final_state) required to craft the item, or (None, None) if impossible.\n      \"\"\"\n      # Use the hashed state and target item index as the memoization key\n      state_hash_key = _hash_craft_state(current_state_for_goal)\n      memo_key = (state_hash_key, target_item_idx)\n\n      # Cycle detection: If we are trying to craft this item from this state *again*\n      # within the current recursion path, it indicates a circular dependency or\n      # an unresolvable goal within the current recursive path.\n      if memo_key in current_recursion_path_set:\n          return None, None # Detected a cycle, this path is impossible\n\n      # Check memoization cache (global to this `craft_v2` call)\n      if memo_key in plan_memo:\n          return plan_memo[memo_key] # Return cached result\n\n      # Add current goal to the recursion path set\n      current_recursion_path_set.add(memo_key)\n\n      current_state_after_actions = current_state_for_goal # State to be updated through the planning process\n      actions_for_this_goal = [] # Accumulate actions for this specific crafting goal\n\n      # Base Case 1: Item is already in inventory\n      if current_state_after_actions.inventory[target_item_idx] > 0:\n          current_recursion_path_set.remove(memo_key) # Clean up path set before returning\n          plan_memo[memo_key] = ([], current_state_for_goal)\n          return [], current_state_for_goal\n\n      # Case 1: Target item is a primitive (needs to be gathered from the grid)\n      if target_item_idx in cookbook.primitives:\n          # Step A: Move next to the primitive\n          path_to_primitive, state_at_primitive = _bfs_move_to_kind(\n              current_state_after_actions, target_item_idx\n          )\n          \n          if path_to_primitive is None:\n              current_recursion_path_set.remove(memo_key) # Clean up path set before returning\n              plan_memo[memo_key] = (None, None)  # Cache failure\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_primitive)\n          current_state_after_actions = state_at_primitive\n\n          # Step B: Perform the USE action to gather the primitive\n          current_count_before_use = current_state_after_actions.inventory[target_item_idx]\n          _, state_after_use = current_state_after_actions.step(USE)\n\n          # Verify that the USE action successfully obtained the primitive\n          if state_after_use.inventory[target_item_idx] > current_count_before_use:\n              actions_for_this_goal.append(USE) # Add the USE action to the plan\n              # Store success in memo and remove from current recursion path\n              current_recursion_path_set.remove(memo_key)\n              plan_memo[memo_key] = (actions_for_this_goal, state_after_use) # Cache success\n              return actions_for_this_goal, state_after_use\n          else:\n              # USE action did not result in obtaining the primitive (e.g., failed pickup)\n              current_recursion_path_set.remove(memo_key) # Clean up path set before returning\n              plan_memo[memo_key] = (None, None) # Cache failure\n              return None, None\n\n      # Case 2: Target item is a recipe output (needs to be crafted)\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable via recipe. Impossible.\n          current_recursion_path_set.remove(memo_key) # Clean up path set before returning\n          plan_memo[memo_key] = (None, None)\n          return None, None \n      \n      required_ingredients = recipe.copy()\n      workshop_needed = None\n      if \"_key\" in required_ingredients:\n          workshop_needed = required_ingredients.pop(\"_key\") # Extract workshop key if present\n\n      # Step A: Gather all required ingredients\n      for ingredient_idx, count_needed in required_ingredients.items():\n          while current_state_after_actions.inventory[ingredient_idx] < count_needed:\n              # Recursively call _plan_craft_recursive for each missing ingredient\n              actions_for_one_ing, next_state_after_ingredient = _plan_craft_recursive(\n                  current_state_after_actions, ingredient_idx, current_recursion_path_set) # Pass the set\n              \n              if actions_for_one_ing is None:\n                  # If an ingredient cannot be obtained (possibly due to a nested cycle), this craft fails\n                  current_recursion_path_set.remove(memo_key) # Clean up path set before returning\n                  plan_memo[memo_key] = (None, None) \n                  return None, None\n              \n              actions_for_this_goal.extend(actions_for_one_ing)\n              current_state_after_actions = next_state_after_ingredient\n\n      # Step B: Move to workshop if required\n      if workshop_needed is not None:\n          path_to_workshop, state_at_workshop = _bfs_move_to_kind(\n              current_state_after_actions, workshop_needed\n          )\n          \n          if path_to_workshop is None:\n              current_recursion_path_set.remove(memo_key) # Clean up path set before returning\n              plan_memo[memo_key] = (None, None) # Cannot reach workshop, so this craft fails\n              return None, None\n          \n          actions_for_this_goal.extend(path_to_workshop)\n          current_state_after_actions = state_at_workshop\n\n      # Step C: Perform the USE action to craft the item\n      current_inv_of_target = current_state_after_actions.inventory[target_item_idx]\n      _, final_state_after_craft = current_state_after_actions.step(USE)\n\n      # Check if crafting was successful (inventory of target item increased)\n      if final_state_after_craft.inventory[target_item_idx] > current_inv_of_target:\n          actions_for_this_goal.append(USE) # Add the USE action to the plan\n          # Store success in memo and remove from current recursion path\n          current_recursion_path_set.remove(memo_key)\n          plan_memo[memo_key] = (actions_for_this_goal, final_state_after_craft)\n          return actions_for_this_goal, final_state_after_craft\n      else:\n          # Crafting failed (e.g., insufficient ingredients despite prior steps, wrong workshop, or unexpected condition)\n          current_recursion_path_set.remove(memo_key) # Clean up path set before returning\n          plan_memo[memo_key] = (None, None)\n          return None, None\n\n  # Start the planning process for the top-level goal item\n  initial_state = env._current_state\n  # Initialize an empty set for tracking the recursion path for the top-level call\n  final_plan_actions, _ = _plan_craft_recursive(initial_state, item, set())\n\n  if final_plan_actions is not None:\n      return final_plan_actions\n  else:\n      return [] # Return empty list if crafting is impossible or path not found", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:58:22.986117", "function_name": "craft", "function_body": "    # Constants for actions\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    def _state_to_hashable(state):\n        \"\"\"Converts a CraftState to a hashable tuple for visited sets.\"\"\"\n        # Using .tobytes() for numpy arrays for hashability and efficiency\n        return (state.grid.tobytes(), tuple(state.pos), state.dir, state.inventory.tobytes())\n\n    def _find_item_or_workshop(initial_state, world, target_kind_idx, max_path_len=50):\n        \"\"\"\n        Performs a BFS to find a path to a cell adjacent to `target_kind_idx`.\n        If target_kind_idx is grabbable, it also includes the USE action to pick it up.\n        Returns (list of actions, final_state_after_all_actions) or (None, None) if not found.\n        \"\"\"\n        queue = collections.deque([(initial_state, [])]) # (CraftState, actions_list)\n        visited = set()\n        visited.add(_state_to_hashable(initial_state))\n\n        while queue:\n            current_state, current_actions = queue.popleft()\n\n            # Check if we are next to the target item/workshop\n            if current_state.next_to(target_kind_idx):\n                if target_kind_idx in world.grabbable_indices:\n                    # If it's a grabbable item, add the USE action to pick it up.\n                    # Simulate the USE action to get the actual effect on inventory.\n                    _r, final_state_after_use = current_state.step(ACTION_USE)\n                    # Check if the item was actually picked up (inventory increased)\n                    # This check is crucial to ensure the USE action was effective.\n                    # It's based on the inventory before the USE action for the specific target.\n                    if final_state_after_use.inventory[target_kind_idx] > current_state.inventory[target_kind_idx]:\n                        return current_actions + [ACTION_USE], final_state_after_use\n                    else:\n                        # Item not picked up, perhaps blocked or not pickable despite being in grabbable_indices.\n                        # Continue search or fail this path. For now, continue search.\n                        pass # Allows other paths to be explored if current one fails to pick up.\n                else:\n                    # If it's a workshop or ungrabbable, just being next to it is enough.\n                    return current_actions, current_state\n            \n            if len(current_actions) >= max_path_len:\n                continue # Prune long paths to manage complexity\n\n            # Explore movement actions (excluding USE for general exploration)\n            for action_code in ALL_ACTIONS[:-1]: # Only movement actions (0 to 3)\n                _r, next_state = current_state.step(action_code)\n                \n                # Check if the state actually changed to avoid redundant exploration\n                # for actions that result in no movement (e.g., hitting a wall).\n                if _state_to_hashable(next_state) == _state_to_hashable(current_state):\n                    continue\n\n                next_hashable = _state_to_hashable(next_state)\n                if next_hashable not in visited:\n                    visited.add(next_hashable)\n                    queue.append((next_state, current_actions + [action_code]))\n        \n        return None, None # Path not found\n\n    cookbook = env.world.cookbook\n    \n    # This represents the current simulated state of the world as we build the plan.\n    # Start with the environment's current state.\n    current_simulated_state = env._current_state\n    \n    # Recursive helper function to find actions for a sub-goal.\n    # It takes the target item and the *current simulated state* from which to start planning.\n    # It returns the *new simulated state* after the actions are applied, and the list of actions\n    # needed to reach that state from the `start_state_for_subgoal`.\n    def _get_actions_for_item(target_item_idx, start_state_for_subgoal):\n        \n        # If we already have the item in the current simulated state, no actions needed.\n        if start_state_for_subgoal.inventory[target_item_idx] > 0:\n            return start_state_for_subgoal, []\n\n        actions_for_this_subgoal = []\n        temp_state_for_subgoal = start_state_for_subgoal # This state will be updated as actions are planned\n\n        # 1. Handle primitive items (can be picked up directly)\n        if target_item_idx in cookbook.primitives:\n            path_actions, end_state = _find_item_or_workshop(\n                temp_state_for_subgoal, env.world, target_item_idx)\n            \n            if path_actions is None:\n                raise ValueError(\n                    f\"CRAFTING ERROR: Cannot find path to primitive item \"\n                    f\"'{cookbook.index.get(target_item_idx)}' (id: {target_item_idx}).\"\n                )\n            \n            # Verify the item was actually acquired.\n            if end_state.inventory[target_item_idx] == 0:\n                 raise ValueError(\n                    f\"CRAFTING ERROR: Failed to acquire primitive item \"\n                    f\"'{cookbook.index.get(target_item_idx)}' after pathfinding and USE action.\"\n                 )\n            \n            return end_state, path_actions\n\n        # 2. Handle craftable items (have a recipe)\n        if target_item_idx in cookbook.recipes:\n            recipe = cookbook.recipes[target_item_idx]\n            \n            # Recursively gather all required ingredients\n            for ingredient_idx, count_needed in recipe.items():\n                if ingredient_idx == \"_key\": # Skip workshop key; handle separately\n                    continue\n                \n                while temp_state_for_subgoal.inventory[ingredient_idx] < count_needed:\n                    # Plan actions to get one unit of the ingredient.\n                    # This call recursively resolves sub-dependencies (either picking up or crafting).\n                    state_after_ingredient_collection, actions_for_ingredient = _get_actions_for_item(\n                        ingredient_idx, temp_state_for_subgoal)\n                    \n                    temp_state_for_subgoal = state_after_ingredient_collection\n                    actions_for_this_subgoal.extend(actions_for_ingredient)\n                    \n                    # After attempting to get the ingredient, verify its count.\n                    if temp_state_for_subgoal.inventory[ingredient_idx] < count_needed:\n                        raise ValueError(\n                            f\"CRAFTING ERROR: Failed to obtain required ingredient \"\n                            f\"'{cookbook.index.get(ingredient_idx)}' (id: {ingredient_idx}) \"\n                            f\"for recipe of '{cookbook.index.get(target_item_idx)}'.\"\n                        )\n\n            # After all ingredients are collected, move to workshop (if needed) and craft\n            workshop_kind_idx = recipe.get(\"_key\")\n            if workshop_kind_idx is not None:\n                path_to_workshop_actions, state_at_workshop = _find_item_or_workshop(\n                    temp_state_for_subgoal, env.world, workshop_kind_idx)\n\n                if path_to_workshop_actions is None:\n                    raise ValueError(\n                        f\"CRAFTING ERROR: Cannot find path to workshop \"\n                        f\"'{cookbook.index.get(workshop_kind_idx)}' for '{cookbook.index.get(target_item_idx)}'.\"\n                    )\n                \n                actions_for_this_subgoal.extend(path_to_workshop_actions)\n                temp_state_for_subgoal = state_at_workshop\n                \n                # Perform the USE action at the workshop to craft\n                # Store inventory before USE to check if crafting was successful\n                inventory_before_craft = temp_state_for_subgoal.inventory[target_item_idx]\n                _r, state_after_craft = temp_state_for_subgoal.step(ACTION_USE)\n                actions_for_this_subgoal.append(ACTION_USE)\n                temp_state_for_subgoal = state_after_craft\n                \n                # Check if crafting was successful (target item count increased)\n                if state_after_craft.inventory[target_item_idx] <= inventory_before_craft:\n                    raise ValueError(\n                        f\"CRAFTING ERROR: Crafting '{cookbook.index.get(target_item_idx)}' (id: {target_item_idx}) \"\n                        f\"failed even after collecting ingredients and reaching workshop. \"\n                        f\"Inventory before: {inventory_before_craft}, after: {state_after_craft.inventory[target_item_idx]}.\"\n                    )\n            else: # No workshop needed, but still a craftable item (e.g., self-crafting)\n                 # Check if the item exists in inventory after ingredients are gathered\n                 # This scenario might not be common in CraftWorld, but for completeness.\n                 if temp_state_for_subgoal.inventory[target_item_idx] <= start_state_for_subgoal.inventory[target_item_idx]:\n                    raise ValueError(\n                        f\"CRAFTING ERROR: Item '{cookbook.index.get(target_item_idx)}' (id: {target_item_idx}) \"\n                        f\"did not appear in inventory after ingredients collected (no workshop needed).\"\n                    )\n            \n            return temp_state_for_subgoal, actions_for_this_subgoal\n        \n        # If the item is neither primitive nor has a recipe, it's an invalid target for 'craft'.\n        raise ValueError(f\"Invalid target item '{cookbook.index.get(item)}' (id: {item}): \"\n                         \"Neither primitive nor craftable with a known recipe.\")\n\n\n    # Start the recursive planning process for the final goal item.\n    # The `current_simulated_state` is passed as the starting point for the planning.\n    # The returned `actions_for_goal` is the complete sequence of actions.\n    final_state_after_planning, actions_for_goal = _get_actions_for_item(item, current_simulated_state)\n    \n    return actions_for_goal", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:58:24.788062", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  initial_craft_state = env._current_state\n  \n  # If the item is already in inventory, no actions needed\n  if initial_craft_state.inventory[item] > 0:\n      return []\n\n  # BFS Queue: stores (CraftState_object, list_of_actions)\n  q = collections.deque()\n  \n  # Visited set: stores state_tuples to avoid redundant exploration\n  # A state_tuple is (grid_tuple, pos_tuple, dir_int, inventory_tuple)\n  # Convert numpy arrays to tuples for hashing in the set\n  initial_grid_tuple = tuple(initial_craft_state.grid.flatten())\n  initial_inventory_tuple = tuple(initial_craft_state.inventory)\n  initial_state_tuple = (initial_grid_tuple, initial_craft_state.pos, \n                         initial_craft_state.dir, initial_inventory_tuple)\n\n  q.append((initial_craft_state, []))\n  visited = {initial_state_tuple} # Use a set for efficient lookup\n\n  # Maximum number of states to explore, to prevent excessive computation.\n  # This is a heuristic and might need tuning based on problem complexity.\n  MAX_SEARCH_STEPS = 2000 \n\n  steps_count = 0\n\n  # Get the number of actions from the environment spec\n  # This is more robust than hardcoding N_ACTIONS\n  num_actions = env.action_specs()['action'].max_value + 1\n\n  while q:\n      current_craft_state, actions_path = q.popleft()\n      \n      # Check if we've exceeded the maximum allowed search steps\n      if steps_count >= MAX_SEARCH_STEPS:\n          # If the goal is not found within limits, stop searching.\n          break\n      steps_count += 1\n\n      # Check if the goal is satisfied in the current state\n      if current_craft_state.inventory[item] > 0:\n          return actions_path\n\n      # Explore possible next actions\n      for action in range(num_actions):\n          # Simulate the step to get the next state\n          # CraftState.step returns a new CraftState instance\n          _reward, next_craft_state = current_craft_state.step(action)\n\n          # Create a tuple representation of the next state for the visited set\n          next_grid_tuple = tuple(next_craft_state.grid.flatten())\n          next_inventory_tuple = tuple(next_craft_state.inventory)\n          next_state_tuple = (next_grid_tuple, next_craft_state.pos, \n                              next_craft_state.dir, next_inventory_tuple)\n\n          # If this state has not been visited before, add it to the queue\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_craft_state, actions_path + [action]))\n\n  # If the queue is empty and the goal was not reached, it's considered impossible\n  # within the given search limits.\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T15:59:33.199805", "function_name": "craft", "function_body": "  import collections # Required for deque for BFS\n\n  # Define action constants for clarity\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  def _find_path_to_interaction_point(start_pos, current_grid, target_kind_idx, non_grabbable_indices):\n    \"\"\"\n    Finds a path of movement actions (0-3) from start_pos to a cell *adjacent* to target_kind_idx.\n    Returns a list of actions or None if no path is found.\n    The path leads to a position where `CraftState.next_to(target_kind_idx)` would be True.\n    A cell is an obstacle if it contains any non-grabbable item.\n    \"\"\"\n    height, width, _ = current_grid.shape\n    \n    # Identify all grid locations where the target_kind_idx is present.\n    # We need to find a path to a cell *adjacent* to one of these locations.\n    target_object_locations = []\n    for r in range(height):\n        for c in range(width):\n            if current_grid[r, c, target_kind_idx] == 1:\n                target_object_locations.append((r, c))\n    \n    if not target_object_locations:\n        return None # Target item/workshop not found on the grid at all\n\n    q = collections.deque([(start_pos, [])]) # (current_position, path_actions_so_far)\n    visited = {start_pos}\n\n    # Define movement deltas (dr, dc) and their corresponding actions\n    moves = {\n        (1, 0): ACTION_DOWN,\n        (-1, 0): ACTION_UP,\n        (0, -1): ACTION_LEFT,\n        (0, 1): ACTION_RIGHT\n    }\n\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # Check if the current position (r, c) is adjacent to any of the target objects.\n        # This is the goal condition for the BFS: being in a position suitable for `USE`.\n        is_adjacent_to_target = False\n        for tr, tc in target_object_locations:\n            # Check 3x3 neighborhood. A cell (r, c) is adjacent to (tr, tc) if \n            # abs(r - tr) <= 1 and abs(c - tc) <= 1, AND (r,c) is not the target cell itself.\n            # The agent cannot stand on the target object to use it, it must be next to it.\n            if (abs(r - tr) <= 1 and abs(c - tc) <= 1) and (r, c) != (tr, tc):\n                is_adjacent_to_target = True\n                break\n        \n        if is_adjacent_to_target:\n            return path_actions # Found a path to a cell adjacent to the target\n\n        # Explore valid neighbors\n        for (dr, dc), action in moves.items():\n            nr, nc = r + dr, c + dc # New potential position\n\n            # Check bounds\n            if not (0 <= nr < height and 0 <= nc < width):\n                continue\n\n            # Check if already visited in this BFS path\n            if (nr, nc) in visited:\n                continue\n            \n            # Check if the next cell (nr, nc) is walkable.\n            # A cell is considered an obstacle if it contains any non-grabbable item (e.g., water, stone, workshops).\n            # The agent cannot move onto these types of cells.\n            is_obstacle = False\n            for idx in non_grabbable_indices:\n                if current_grid[nr, nc, idx] == 1: \n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            visited.add((nr, nc))\n            q.append(((nr, nc), path_actions + [action]))\n\n    return None # No path found to any cell adjacent to the target\n\n  # --- Main craft_v2 function logic starts here ---\n  all_actions = []\n\n  # Get the initial state of the environment. `env` is a CraftLab instance.\n  # We will update `current_state` explicitly after each action simulated.\n  current_state = env._current_state \n\n  # Get cookbook for recipe information\n  cookbook = env.world.cookbook\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 1. Check if the goal item is already in inventory\n  if current_state.satisfies(None, item): # `goal_name` is ignored in `satisfies`\n      return all_actions # Already crafted, no actions needed\n\n  # Get the list of all primitive ingredients and their counts required for the final item.\n  # This returns a dictionary {primitive_idx: count_needed}\n  needed_primitives = cookbook.primitives_for(item) \n\n  # 2. Gather all required primitives iteratively\n  # We loop until all necessary primitives are collected.\n  # A simple safeguard to prevent infinite loops in complex scenarios or unreachability.\n  max_gathering_attempts = 500 # Sufficiently large to cover complex paths/multiple items\n\n  for attempt_num in range(max_gathering_attempts):\n      all_primitives_satisfied = True\n      missing_primitive_to_collect = None # Store the index of the first encountered missing primitive\n\n      # Check if any primitive is still missing\n      for p_idx, p_count in needed_primitives.items():\n          if current_state.inventory[p_idx] < p_count:\n              all_primitives_satisfied = False\n              missing_primitive_to_collect = p_idx\n              break # Found a missing primitive, focus on collecting this one\n\n      if all_primitives_satisfied:\n          break # All primitives are collected, exit the gathering loop\n\n      # If we reach here, a primitive is missing. Try to collect it.\n      # Find a path to a location adjacent to `missing_primitive_to_collect`\n      path_to_primitive = _find_path_to_interaction_point(\n          current_state.pos, current_state.grid, missing_primitive_to_collect, non_grabbable_indices\n      )\n\n      if path_to_primitive is None:\n          # Cannot find a path to the necessary primitive on the current grid.\n          # This might mean it's unreachable or doesn't exist anymore if already collected.\n          # If we're still missing it after max_gathering_attempts, it's a failure.\n          return [] # Indicate failure or unreachability\n\n      # Execute the path to the primitive\n      for action in path_to_primitive:\n          _, new_state = current_state.step(action) # Simulate action on the CraftState\n          all_actions.append(action)\n          current_state = new_state # Update current_state for the next iteration/step\n\n      # After moving, use the primitive if adjacent\n      if current_state.next_to(missing_primitive_to_collect):\n          _, new_state = current_state.step(ACTION_USE)\n          all_actions.append(ACTION_USE)\n          current_state = new_state # Update current_state\n          # The inventory is updated internally by CraftState.step; next loop iteration will reflect it.\n      else:\n          # This case indicates an issue: pathfinding led to a non-adjacent spot or obstacle appeared.\n          # For a deterministic environment, this should ideally not happen if pathfinding is correct.\n          return [] # Indicate failure\n\n  # If the loop finished due to max_gathering_attempts without collecting all primitives\n  if not all_primitives_satisfied:\n      return [] # Could not collect all needed primitives\n\n  # 3. Craft the final item if a workshop is required\n  workshop_needed_idx = None\n  recipe_dict = cookbook.recipes.get(item) # Get the specific recipe for the final item\n\n  if recipe_dict:\n      # A workshop is needed if one of the recipe keys is in the workshop_indices\n      # The problem description states recipe format as {ingredient_index or \"_key\": count}\n      # The workshop is identified by \"_key\" in the recipe_dict,\n      # and this \"_key\" maps to an index that should be in env.world.workshop_indices\n      workshop_key_from_recipe = recipe_dict.get(\"_key\")\n      if workshop_key_from_recipe is not None and workshop_key_from_recipe in env.world.workshop_indices:\n          workshop_needed_idx = workshop_key_from_recipe\n      \n  if workshop_needed_idx is not None:\n      # Pathfind to the required workshop\n      path_to_workshop = _find_path_to_interaction_point(\n          current_state.pos, current_state.grid, workshop_needed_idx, non_grabbable_indices\n      )\n\n      if path_to_workshop is None:\n          return [] # Indicate failure: Cannot find path to workshop\n\n      # Execute the path to the workshop\n      for action in path_to_workshop:\n          _, new_state = current_state.step(action)\n          all_actions.append(action)\n          current_state = new_state # Update current_state\n\n      # Use the workshop to craft the item\n      if current_state.next_to(workshop_needed_idx):\n          _, new_state = current_state.step(ACTION_USE)\n          all_actions.append(ACTION_USE)\n          current_state = new_state # Update current_state\n      else:\n          # Again, this indicates an issue in pathing or environmental state.\n          return [] # Indicate failure\n\n  # 4. Final verification: Check if the goal item is now in inventory\n  # `current_state` has been updated throughout the process.\n  if current_state.satisfies(None, item):\n      return all_actions # Successfully crafted\n  else:\n      # Goal not satisfied. This could be due to complex recipe logic not fully covered,\n      # or an actual failure in pathing/collection (e.g., dynamic environment changes not simulated).\n      # For the scope of this problem, if it's not satisfied here, it's a failure.\n      return [] # Goal not satisfied", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T15:59:34.575199", "function_name": "craft", "function_body": "  import collections # Required for deque for BFS\n\n  # Define action constants for clarity\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def _find_path_actions_to_adjacent(start_pos, current_grid, target_kind_idx, non_grabbable_indices):\n    \"\"\"\n    Finds a path of movement actions (DOWN, UP, LEFT, RIGHT) from start_pos to a cell\n    adjacent to an instance of target_kind_idx.\n    Considers cells containing non_grabbable_indices as obstacles.\n    Returns a list of actions or None if no path is found.\n    The path leads to a position where `current_state.next_to(target_kind_idx)` would be True.\n    \"\"\"\n    height, width, _ = current_grid.shape\n    \n    # Identify all grid locations where the target_kind_idx is present.\n    target_object_cells = []\n    for r in range(height):\n        for c in range(width):\n            if current_grid[r, c, target_kind_idx] == 1:\n                target_object_cells.append((r, c))\n    \n    if not target_object_cells:\n        return None # Target item not found on the grid at all\n\n    q = collections.deque([(start_pos, [])]) # (current_position, path_actions_so_far)\n    visited = {start_pos}\n\n    # Define movement deltas (dr, dc) and their corresponding actions\n    moves = {\n        (1, 0): DOWN,\n        (-1, 0): UP,\n        (0, -1): LEFT,\n        (0, 1): RIGHT\n    }\n\n    while q:\n        (r, c), path_actions = q.popleft()\n\n        # Check if the current position (r, c) is adjacent to any of the target objects.\n        # This is the goal condition for the BFS: being in a position suitable for `USE`.\n        is_adjacent_to_target = False\n        for tr, tc in target_object_cells:\n            # Check 3x3 neighborhood around target (tr, tc), excluding the target cell itself\n            # as a valid agent position for the `next_to` concept.\n            if abs(r - tr) <= 1 and abs(c - tc) <= 1 and (r,c) != (tr,tc):\n                is_adjacent_to_target = True\n                break\n        \n        if is_adjacent_to_target:\n            return path_actions # Found a path to a cell adjacent to the target\n\n        # Explore valid neighbors\n        for (dr, dc), action in moves.items():\n            nr, nc = r + dr, c + dc # New potential position\n\n            # Check bounds\n            if not (0 <= nr < height and 0 <= nc < width):\n                continue\n\n            # Check if already visited in this BFS path\n            if (nr, nc) in visited:\n                continue\n            \n            # Check if the next cell (nr, nc) is walkable.\n            # A cell is considered an obstacle if it contains any non-grabbable item.\n            is_obstacle = False\n            for idx in non_grabbable_indices:\n                if current_grid[nr, nc, idx] == 1: \n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            visited.add((nr, nc))\n            q.append(((nr, nc), path_actions + [action]))\n\n    return None # No path found to any cell adjacent to the target\n\n  # --- Main craft_v2 function logic starts here ---\n  all_actions = []\n\n  # Get initial state and world information from the CraftLab environment\n  current_state = env._current_state \n  cookbook = env.world.cookbook\n  non_grabbable_indices = env.world.non_grabbable_indices\n  workshop_indices = env.world.workshop_indices # Indices of entities that serve as workshops\n\n  # 1. Check if the goal item is already in inventory\n  if current_state.satisfies(None, item): # `goal_name` is ignored in `satisfies`\n      return all_actions # Already crafted, no actions needed\n\n  # Get the list of all primitive ingredients and their counts required for the final item.\n  # The `primitives_for` method recursively breaks down recipes to their base components.\n  needed_primitives = cookbook.primitives_for(item) # Returns {primitive_idx: count}\n\n  # 2. Gather all required primitives iteratively\n  # We loop until all necessary primitives are collected or a collection path is exhausted.\n  max_collection_attempts = 200 # Safety limit to prevent infinite loops in complex scenarios\n\n  for attempt in range(max_collection_attempts):\n      all_primitives_satisfied = True\n      missing_primitive_to_collect_idx = None # Store the index of the first encountered missing primitive\n\n      # Check if any primitive is still missing\n      for p_idx, p_count in needed_primitives.items():\n          if current_state.inventory[p_idx] < p_count:\n              all_primitives_satisfied = False\n              missing_primitive_to_collect_idx = p_idx\n              break # Found a missing primitive, focus on collecting this one\n\n      if all_primitives_satisfied:\n          break # All primitives are collected, exit the gathering loop\n      \n      if attempt == max_collection_attempts - 1:\n          # Cannot collect all primitives within the allowed attempts.\n          return [] # Indicate failure or unreachability\n\n      # Find a path to the missing primitive and attempt to collect it\n      path_to_primitive = _find_path_actions_to_adjacent(\n          current_state.pos, current_state.grid, missing_primitive_to_collect_idx, non_grabbable_indices\n      )\n\n      if path_to_primitive is None:\n          # Cannot find a path to the necessary primitive on the grid.\n          # This primitive might be exhausted or inherently unreachable.\n          return [] # Indicate failure (item likely uncraftable)\n\n      # Execute the path to the primitive\n      for action in path_to_primitive:\n          # Use env.step() to apply the action and update the actual environment state\n          _, _, _ = env.step(action) \n          all_actions.append(action)\n          # Always re-sync `current_state` with the environment's internal state after each step\n          current_state = e