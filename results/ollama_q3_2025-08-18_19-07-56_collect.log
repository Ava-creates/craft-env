rrent_state.inventory):\n      if count > 0:\n        reward, new_state = state.step(USE)\n\n        key_new = state_key(new_state)\n        if key_new not in visited_states:\n          visited_states.add(key_new)\n          queue.append((new_state, actions_taken + [USE]))\n\n    # Attempt to use the bridge\n    if world.cookbook.index.index(\"BRIDGE\") in tool_inventory and current_state.next_to(world.cookbook.index.index(\"WATER\")):\n      reward, new_state = state.step(USE)\n\n      key_new = state_key(new_state)\n      if key_new not in visited_states:\n        visited_states.add(key_new)\n        queue.append((new_state, actions_taken + [USE]))\n\n  # If no path is found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 1.0}}
{"timestamp": "2025-08-18T23:08:49.692907", "function_name": "collect", "function_body": "  # Retrieve the current state and world information\n  current_state = env._current_state\n  world = current_state.world\n\n  # Get the index for the target primitive\n  primitive_index = world.cookbook.index[primitive]\n\n  # Check if the agent already has the required primitive in their inventory\n  if current_state.inventory[primitive_index] > 0:\n      return []\n\n  # Define constants for movement actions\n  ACTIONS = {\n      \"UP\": 1,\n      \"DOWN\": 0,\n      \"LEFT\": 2,\n      \"RIGHT\": 3,\n      \"USE\": 4\n  }\n\n  def get_neighbors(pos):\n      x, y = pos\n      return [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n\n  # BFS to find the shortest path to any cell containing the target primitive\n  queue = collections.deque([(current_state.pos, [])])\n  visited = set()\n  visited.add(current_state.pos)\n\n  while queue:\n      pos, path = queue.popleft()\n\n      # Check if the current position contains the target primitive\n      if world.cookbook.get(primitive_index) in (world.index.get(idx) for idx in range(world.n_kinds) if current_state.grid[pos[0], pos[1], idx] > 0):\n          return path + [ACTIONS[\"USE\"]]\n\n      # Explore neighbors\n      for neighbor in get_neighbors(pos):\n          if 0 <= neighbor[0] < current_state.grid.shape[0] and 0 <= neighbor[1] < current_state.grid.shape[1]:\n              if neighbor not in visited:\n                  visited.add(neighbor)\n                  queue.append((neighbor, path + [ACTIONS[\"UP\" if pos[0] < neighbor[0] else \"DOWN\" if pos[0] > neighbor[0] else \"LEFT\" if pos[1] < neighbor[1] else \"RIGHT\"]]))\n\n  # If no path is found, return an empty list\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-18T23:08:50.683566", "function_name": "collect", "function_body": "  # Define constants\n  UP, DOWN, LEFT, RIGHT = 0, 1, 2, 3\n  USE = 4\n\n  # Utility function to check if the agent is next to a specific item\n  def is_next_to(state, kind):\n    return state.next_to(env.world.cookbook.index[kind])\n\n  # Utility function to get all available tools in inventory\n  def available_tools(state):\n      tools = []\n      cookbook = env.world.cookbook\n      for tool_name in [\"BRIDGE\", \"PICKAXE\"]:\n          if state.inventory[cookbook.index[tool_name]] > 0:\n              tools.append(cookbook.index[tool_name])\n      return tools\n\n  # Utility function to move the agent towards a target position\n  def move_towards(state, target_pos):\n      current_pos = np.array(state.pos)\n      target_pos = np.array(target_pos)\n\n      actions = []\n      direction = target_pos - current_pos\n      \n      if direction[1] < 0:\n          actions.append(UP)\n      elif direction[1] > 0:\n          actions.append(DOWN)\n      \n      if direction[0] < 0:\n          actions.append(LEFT)\n      elif direction[0] > 0:\n          actions.append(RIGHT)\n      \n      return actions\n\n  # Main logic to collect the primitive\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n  target_kind = cookbook.index[primitive]\n\n  if not is_next_to(initial_state, primitive):\n      # Find all positions of the target kind in the grid\n      target_positions = np.argwhere(initial_state.grid[:, :, target_kind] > 0)\n      \n      if len(target_positions) == 0:\n          raise ValueError(f\"No {primitive} found in the environment.\")\n      \n      # Choose the closest target position to move towards\n      current_pos = np.array(initial_state.pos)\n      distances = np.linalg.norm(current_pos - target_positions, axis=1)\n      closest_target_pos = tuple(target_positions[np.argmin(distances)])\n  else:\n      closest_target_pos = initial_state.pos\n\n  actions = []\n  \n  # If the agent is not next to the primitive, move towards it\n  if not is_next_to(initial_state, primitive):\n      actions.extend(move_towards(initial_state, closest_target_pos))\n\n  # Check if the primitive requires a tool and use it if available\n  tools = available_tools(initial_state)\n  tool_used = False\n\n  if target_kind in [cookbook.index[\"GOLD\"], cookbook.index[\"GEM\"]]:\n      if \"PICKAXE\" in tools:\n          actions.append(USE)\n          tool_used = True\n  elif target_kind == cookbook.index[\"WATER\"]:\n      if \"BRIDGE\" in tools:\n          actions.append(USE)\n          tool_used = True\n\n  # Collect the primitive\n  actions.append(USE)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
