(new_state)\n        if key_new not in visited_states:\n          visited_states.add(key_new)\n          queue.append((new_state, actions_taken + [action]))\n\n    # Optionally, handle specific tools to reach the primitive\n    if primitive == \"GEM\" and world.cookbook.index.index(\"PICKAXE\") in current_state.inventory:\n      for action in [UP, DOWN, LEFT, RIGHT]:\n        reward, new_state = state.step(action)\n\n        key_new = state_key(new_state)\n        if key_new not in visited_states:\n          visited_states.add(key_new)\n          queue.append((new_state, actions_taken + [action]))\n\n  # If no path is found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 1.0}}
{"timestamp": "2025-08-18T20:54:43.470235", "function_name": "collect", "function_body": "  UP, DOWN, LEFT, RIGHT = 0, 1, 2, 3\n  USE = 4\n\n  # Get the current state and world details\n  current_state = env._current_state\n  world = env.world\n\n  # Convert primitive name to its index\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Check if the agent is already next to the desired primitive\n  if current_state.next_to(primitive_index):\n    return [USE]\n\n  # Initialize a queue for BFS and visited set\n  queue = collections.deque([(current_state, [])])\n  visited_states = set()\n\n  def state_key(state):\n      \"\"\"Generate a unique key for each state based on its grid and position.\"\"\"\n      return tuple(state.grid.flatten()) + tuple(state.pos) + (state.dir,)\n\n  # Perform BFS to find the shortest path to the primitive\n  while queue:\n    state, actions_taken = queue.popleft()\n\n    if state.next_to(primitive_index):\n      return actions_taken + [USE]\n\n    # Explore all possible actions (UP, DOWN, LEFT, RIGHT)\n    for action in [UP, DOWN, LEFT, RIGHT]:\n      reward, new_state = state.step(action)\n\n      key_new = state_key(new_state)\n      if key_new not in visited_states:\n        visited_states.add(key_new)\n        queue.append((new_state, actions_taken + [action]))\n\n    # Check if the agent can use a tool to reach the primitive\n    for tool_index, count in enumerate(current_state.inventory):\n      if count > 0:\n        reward, new_state = state.step(USE)\n\n        key_new = state_key(new_state)\n        if key_new not in visited_states:\n          visited_states.add(key_new)\n          queue.append((new_state, actions_taken + [USE]))\n\n    # Handle specific tools to reach the primitive\n    tool_inventory = {world.cookbook.index.index(tool): count for tool, count in enumerate(current_state.inventory) if count > 0}\n    \n    # If there's a bridge and water is nearby, find a path that uses the bridge\n    if world.cookbook.index.index(\"BRIDGE\") in tool_inventory:\n      if any(world.cookbook.index.index(water) == primitive_index for water in [\"WATER\"]):\n        # Use BFS to find a path that includes using the bridge\n        queue = collections.deque([(state, actions_taken)])\n        while queue:\n          state, actions_taken = queue.popleft()\n\n          if state.next_to(primitive_index):\n            return actions_taken + [USE]\n\n          for action in [UP, DOWN, LEFT, RIGHT]:\n            reward, new_state = state.step(action)\n\n            key_new = state_key(new_state)\n            if key_new not in visited_states:\n              visited_states.add(key_new)\n              queue.append((new_state, actions_taken + [action]))\n\n          # Attempt to use the bridge\n          if world.cookbook.index.index(\"BRIDGE\") in tool_inventory:\n            reward, new_state = state.step(USE)\n\n            key_new = state_key(new_state)\n            if key_new not in visited_states:\n              visited_states.add(key_new)\n              queue.append((new_state, actions_taken + [USE]))\n\n  # If no path is found, return an empty list\n  return []", "island_id": 2, "scores": {"3": 1.0}}
