{"timestamp": "2025-07-23T15:39:42.545506", "function_name": "craft", "function_body": "  # The 'USE' action in the CraftWorld environment is typically mapped to integer 4.\n  # This function performs that action and returns the immediate reward.\n  # The 'item' argument is for the DSL's symbolic representation of what is being\n  # crafted, but the underlying `env.step` method does not directly consume it;\n  # it determines the outcome of 'USE' based on the agent's current state (inventory, position).\n  USE_ACTION = 4\n\n  # Perform the 'USE' action in the environment.\n  # The `env.step` method returns a tuple: (reward, done, observations).\n  # We are primarily interested in the reward for this function.\n  reward, _, _ = env.step(USE_ACTION)\n\n  return reward", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T15:42:34.720909", "function_name": "craft", "function_body": "  # Get the integer ID for the target item.\n  # The 'item' input is a string (e.g., \"PLANK\").\n  # The Cookbook's 'index' attribute maps string names to integer IDs.\n  try:\n    item_id = env.world.cookbook.index[item]\n  except KeyError:\n    # If the item name is not found in the cookbook index, it cannot be crafted.\n    # Return 0.0 reward, indicating no progress.\n    return 0.0\n\n  # Get the integer value for the 'USE' action.\n  # CraftLab's action_specs() method returns a dictionary mapping action names (e.g., 'USE')\n  # to their corresponding integer values (e.g., 4).\n  action_map = env.action_specs()\n  USE_ACTION = action_map.get('USE')\n\n  if USE_ACTION is None:\n    # This guard ensures that if for some reason the 'USE' action is not defined\n    # in the environment's action specifications, the function handles it gracefully.\n    return 0.0\n\n  # Perform the 'USE' action in the environment.\n  # The `env.step()` method executes the action and returns a tuple:\n  # (reward, done_status, observations_dict).\n  # The 'reward' is calculated by CraftLab's internal logic, which checks if\n  # the task's goal (i.e., having the crafted item in inventory) is satisfied.\n  reward, _, _ = env.step(USE_ACTION)\n\n  # Return the reward obtained from attempting the crafting action.\n  return reward", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T15:42:35.745470", "function_name": "craft", "function_body": "  \"\"\"Takes necessary steps in the enviornment to complete the task of crafting the input item and then returns the reward it collects from the enviornment when it takes the necessary steps\"\"\"\n  # The 'USE' action in the CraftLab environment is responsible for\n  # attempting to craft an item based on the agent's current position,\n  # inventory, and proximity to workshops.\n  # The 'item' argument specifies the *intended* item to be crafted.\n  # It is assumed that prior DSL commands (e.g., 'move', 'collect')\n  # have set the environment and agent state such that performing\n  # the 'USE' action will result in crafting the desired 'item'.\n\n  # Get the integer ID for the 'USE' action from the environment's action specifications.\n  action_specs = env.action_specs()\n  use_action_id = action_specs['USE']\n\n  # Perform the 'USE' action in the environment.\n  # env.step returns (reward, done, observations). We are interested in the reward.\n  reward, _, _ = env.step(use_action_id)\n\n  # Return the reward collected from this action.\n  return reward", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T15:44:59.582364", "function_name": "craft", "function_body": "  import numpy as np # Used for grid operations (np.where)\n\n  total_reward = 0.0\n\n  # 1. Get integer index for the item from the cookbook's index\n  item_idx = env.world.cookbook.index[item]\n\n  # 2. Determine if a specific workshop is required for crafting this item\n  required_workshop_idx = None\n  recipe_details = env.world.cookbook.recipes.get(item_idx)\n\n  if recipe_details:\n      # Check if the recipe includes a '_tool' key, which indicates a required workshop\n      for key, value in recipe_details.items():\n          if key == '_tool':\n              required_workshop_idx = value\n              break\n\n  # 3. If a workshop is required, move the agent next to it\n  if required_workshop_idx is not None:\n      # A rough upper bound for movement steps to prevent infinite loops,\n      # assuming the agent might move across the entire map.\n      # Max Manhattan distance is (WIDTH-1) + (HEIGHT-1). Multiply by 2 for safety with simple greedy pathing.\n      max_movement_attempts = 2 * (env.scenario.init_grid.shape[0] + env.scenario.init_grid.shape[1])\n\n      for _ in range(max_movement_attempts):\n          current_state = env._current_state\n\n          # Check if the agent is already in the 3x3 neighborhood of the required workshop\n          if current_state.next_to(required_workshop_idx):\n              break # Agent is in position, break loop and proceed to USE action\n\n          # If not in position, find the closest workshop and attempt to move towards it\n          current_pos = current_state.pos\n          grid = current_state.grid\n          \n          # Find all grid coordinates where the required workshop kind exists\n          # np.where returns a tuple of arrays (x_coords, y_coords)\n          workshop_coords_indices = np.where(grid[:, :, required_workshop_idx] == 1)\n          workshop_locations = list(zip(workshop_coords_indices[0], workshop_coords_indices[1]))\n\n          if not workshop_locations:\n              # No workshop of the required type found in the current grid.\n              # This item cannot be crafted in this scenario. Return current total_reward (0.0 usually).\n              return total_reward\n\n          # Find the workshop location closest to the agent's current position\n          closest_workshop_loc = None\n          min_dist = float('inf')\n          for loc_x, loc_y in workshop_locations:\n              dist = abs(loc_x - current_pos[0]) + abs(loc_y - current_pos[1])\n              if dist < min_dist:\n                  min_dist = dist\n                  closest_workshop_loc = (loc_x, loc_y)\n          \n          if closest_workshop_loc is None:\n              # Should logically not happen if workshop_locations is not empty.\n              # But as a failsafe, if we can't determine a target, stop movement.\n              break\n\n          # Determine the best single step to take towards the closest workshop\n          target_x, target_y = closest_workshop_loc\n          current_x, current_y = current_pos\n\n          action_to_take = -1\n          # Prioritize movement along the axis with the larger absolute difference\n          if abs(target_x - current_x) > abs(target_y - current_y):\n              if target_x > current_x:\n                  action_to_take = env.action_specs()['RIGHT']\n              elif target_x < current_x:\n                  action_to_take = env.action_specs()['LEFT']\n          else: # If Y difference is larger or equal, or if X difference is 0\n              if target_y > current_y:\n                  action_to_take = env.action_specs()['DOWN']\n              elif target_y < current_y:\n                  action_to_take = env.action_specs()['UP']\n          \n          if action_to_take == -1:\n              # This can happen if current_pos is already equal to target_pos,\n              # meaning agent is on the workshop. next_to() should have been true already.\n              # If not, it means we are stuck or next_to() has specific rules.\n              # Break to avoid infinite loop if no progress can be made.\n              break \n\n          # Take the determined movement step in the environment\n          reward, done, _ = env.step(action_to_take)\n          total_reward += reward\n\n          if done:\n              # If the task becomes done during movement (e.g., max_steps reached),\n              # stop further actions and return current total_reward.\n              return total_reward\n\n  # 4. Once positioned (or if no workshop was needed), perform the USE action.\n  # The environment's step function will handle the crafting logic based on\n  # agent's position, inventory, and the world's recipes.\n  reward, done, _ = env.step(env.action_specs()['USE'])\n  total_reward += reward\n\n  return total_reward", "island_id": 1, "scores": {"3": 0.0}}
