{"timestamp": "2025-07-23T16:08:56.324996", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # 1. Get the integer ID for the item string\n  # Use .get() with None default to handle cases where item string is not in the index\n  item_idx = env.world.cookbook.index.get(item)\n  if item_idx is None:\n    # Item not found in cookbook's index, cannot be crafted.\n    return total_reward\n\n  # 2. Get the recipe for item_idx\n  # Recipes dict maps output_index to a dict of ingredients and potentially '_key' for workshop\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if recipe is None:\n    # No recipe found for this item_idx, meaning it's not a craftable item\n    # (e.g., it's a primitive resource or an environment block that cannot be crafted).\n    return total_reward\n\n  # Initialize variable for workshop requirement\n  required_workshop_idx = None\n  \n  # 3. Check inventory for ingredients and identify workshop requirement\n  # Use a copy of the current inventory for checks to prevent unintended modifications.\n  current_inventory = env._current_state.inventory.copy() \n  \n  for ing_key, count in recipe.items():\n    if ing_key == \"_key\":\n      # This special key indicates a workshop requirement for crafting this item.\n      # The 'count' value associated with '_key' is assumed to be the integer ID\n      # of the required workshop (e.g., workbench, furnace).\n      required_workshop_idx = count \n      continue # Move to the next item in the recipe (either another ingredient or end)\n\n    # This is an ingredient requirement\n    # 'ing_key' is already the integer index of the ingredient\n    ing_idx = ing_key \n    \n    # Check if the agent has enough of the current ingredient in its inventory\n    if current_inventory[ing_idx] < count:\n      # Not enough ingredients. Cannot craft this item. Return 0 reward.\n      return total_reward\n\n  # 4. Check if the agent is next to the required workshop (if a workshop is specified in the recipe)\n  if required_workshop_idx is not None:\n    # Use the next_to method of the current CraftState to check proximity\n    if not env._current_state.next_to(required_workshop_idx):\n      # Agent is not next to the required workshop. Cannot craft. Return 0 reward.\n      return total_reward\n\n  # All preconditions are met:\n  # - The agent has a sufficient quantity of all required ingredients in its inventory.\n  # - If a specific workshop is required, the agent is currently positioned next to it.\n\n  # 5. Perform the 'USE' action to attempt crafting\n  # The USE action is typically mapped to the integer 4, as per CraftLab.action_specs.\n  USE_ACTION = 4 \n  \n  # Call env.step to apply the USE action. This will update the environment state\n  # (e.g., consume ingredients, add crafted item to inventory) and return reward.\n  # The reward for a single step in this implementation is typically 0.0,\n  # unless it's the final goal achievement detected by _get_reward.\n  reward, done, _ = env.step(USE_ACTION)\n  total_reward += reward\n\n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T16:08:57.444770", "function_name": "craft", "function_body": "  # The \"necessary steps\" to craft an item in CraftWorld typically involve\n  # being at the correct location (e.g., a workshop if required by the recipe)\n  # and then performing the 'USE' action.\n  # The CraftState's step method (called internally by CraftLab.step) handles\n  # the detailed logic of whether crafting is successful based on the agent's\n  # current inventory and position relative to any required workshops.\n\n  # The 'item' argument specifies which item is intended to be crafted.\n  # However, the underlying CraftWorld simulation's 'USE' action is generic;\n  # it attempts to craft whatever is possible given the current state.\n  # The DSL's `craft(item)` implicitly means \"try to craft this item by using\n  # the environment's crafting mechanism.\"\n\n  # Get the integer ID for the 'USE' action from the environment's action specifications.\n  # 'env' is an instance of the CraftLab class.\n  use_action_id = env.action_specs()['USE']\n\n  # Perform the 'USE' action in the environment.\n  # The `env.step()` method executes the action and returns a tuple containing\n  # the reward received for that step, a boolean indicating if the episode is done,\n  # and observation data.\n  # According to the CraftLab documentation, the 'reward' returned by `env.step()`\n  # reflects the overall task reward (computed by `_get_reward()`), which means it\n  # will typically be 0.0 unless the specific action completes the main task goal.\n  reward, _, _ = env.step(use_action_id)\n\n  # Return the reward collected from taking this crafting step.\n  # This reward will be a float, as specified by the function signature.\n  return reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T16:10:03.223376", "function_name": "craft", "function_body": "  import numpy as np # Used for grid operations (np.where)\n\n  total_reward = 0.0\n\n  # Define action constants for readability\n  ACTIONS = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = ACTIONS['UP'], ACTIONS['DOWN'], ACTIONS['LEFT'], ACTIONS['RIGHT'], ACTIONS['USE']\n\n  # 1. Get integer index for the item from the cookbook's index\n  try:\n      item_idx = env.world.cookbook.index[item]\n  except KeyError:\n      # Item not found in cookbook, cannot craft. Return 0.0 reward.\n      return total_reward\n\n  # 2. Determine if a specific workshop is required for crafting this item\n  required_workshop_idx = None\n  recipe_details = env.world.cookbook.recipes.get(item_idx)\n\n  if recipe_details:\n      # Check if the recipe includes a '_tool' key, which indicates a required workshop\n      for key, value in recipe_details.items():\n          if key == '_tool':\n              required_workshop_idx = value\n              break\n\n  # 3. If a workshop is required, move the agent next to it\n  if required_workshop_idx is not None:\n      # A robust upper bound for movement steps to prevent infinite loops.\n      max_movement_attempts = 150\n      \n      # Parameters for stuck detection and simple detour strategy\n      max_stuck_steps = 3 # Number of consecutive steps with no position change to consider agent stuck\n      stuck_counter = 0\n      last_pos = None\n      \n      # Detour strategy: If stuck, try moving in a fixed sequence of cardinal directions\n      # This provides a basic way to navigate around simple obstacles.\n      detour_sequence = [UP, DOWN, LEFT, RIGHT]\n      detour_idx = 0 # Index to cycle through detour_sequence\n\n      for _ in range(max_movement_attempts):\n          current_state = env._current_state\n\n          # Check if the agent is already in the 3x3 neighborhood of the required workshop\n          if current_state.next_to(required_workshop_idx):\n              break # Agent is in position, break loop and proceed to USE action\n\n          current_pos = current_state.pos\n          \n          # Check for being stuck: if position hasn't changed from the last step\n          if last_pos == current_pos:\n              stuck_counter += 1\n              if stuck_counter >= max_stuck_steps:\n                  # Agent is stuck, try a detour action if available\n                  if detour_idx < len(detour_sequence):\n                      detour_action = detour_sequence[detour_idx]\n                      reward, done, _ = env.step(detour_action)\n                      total_reward += reward\n                      detour_idx += 1 # Move to the next detour action in sequence\n                      stuck_counter = 0 # Reset stuck counter after a detour attempt\n                      if done:\n                          # If the task becomes done during a detour, stop further actions.\n                          return total_reward\n                      continue # Continue loop to re-evaluate position after detour\n                  else:\n                      # All detour attempts exhausted for this stuck instance.\n                      # Assume agent is truly stuck and cannot reach the workshop.\n                      return total_reward\n          else:\n              stuck_counter = 0 # Reset stuck counter if position changed\n              detour_idx = 0 # Reset detour attempts if we moved (successful progress)\n          last_pos = current_pos\n\n          # Find all grid coordinates where the required workshop kind exists\n          # np.where returns a tuple of arrays (x_coords, y_coords)\n          workshop_coords_indices = np.where(current_state.grid[:, :, required_workshop_idx] == 1)\n          workshop_locations = list(zip(workshop_coords_indices[0], workshop_coords_indices[1]))\n\n          if not workshop_locations:\n              # No workshop of the required type found in the current grid.\n              # This item cannot be crafted in this scenario.\n              return total_reward\n\n          # Find the workshop location closest to the agent's current position\n          closest_workshop_loc = None\n          min_dist = float('inf')\n          for loc_x, loc_y in workshop_locations:\n              dist = abs(loc_x - current_pos[0]) + abs(loc_y - current_pos[1])\n              if dist < min_dist:\n                  min_dist = dist\n                  closest_workshop_loc = (loc_x, loc_y)\n          \n          if closest_workshop_loc is None:\n              # This condition should logically not be met if workshop_locations is not empty.\n              # As a fail-safe, if target cannot be determined, stop movement.\n              break\n\n          # Determine the best single step to take towards the closest workshop\n          target_x, target_y = closest_workshop_loc\n          current_x, current_y = current_pos\n\n          action_to_take = -1\n          \n          # Calculate Manhattan distances\n          dx = target_x - current_x\n          dy = target_y - current_y\n\n          # Prioritize movement along the axis with the larger absolute difference\n          if abs(dx) > abs(dy):\n              if dx > 0:\n                  action_to_take = RIGHT\n              elif dx < 0:\n                  action_to_take = LEFT\n              else: # dx is 0, try to move vertically\n                  if dy > 0:\n                      action_to_take = DOWN\n                  elif dy < 0:\n                      action_to_take = UP\n          else: # abs(dy) >= abs(dx)\n              if dy > 0:\n                  action_to_take = DOWN\n              elif dy < 0:\n                  action_to_take = UP\n              else: # dy is 0, both dx and dy are 0 (implies agent is at target or next to it)\n                  break # Agent is already at target or no valid primary move, break out of movement loop\n          \n          if action_to_take == -1:\n              # If no movement action was determined, it means the agent is already\n              # at the exact target location or next to it (next_to() should have caught it).\n              # Break to avoid infinite loop.\n              break \n\n          # Take the determined movement step in the environment\n          reward, done, _ = env.step(action_to_take)\n          total_reward += reward\n\n          if done:\n              # If the task becomes done during movement (e.g., max_steps reached),\n              # stop further actions and return current total_reward.\n              return total_reward\n\n  # 4. Once positioned (or if no workshop was needed), perform the USE action.\n  # The environment's step function will handle the crafting logic based on\n  # agent's position, inventory, and the world's recipes.\n  reward, done, _ = env.step(USE)\n  total_reward += reward\n\n  if done:\n      # If the task is done immediately after USE, return current total_reward.\n      return total_reward\n\n  # Return the total reward accumulated from environment steps.\n  # Note: CraftState.step always returns 0.0. The actual reward comes from CraftLab.step\n  # which checks for the overall task goal. This function accumulates any reward yielded\n  # by CraftLab's step calls.\n  return total_reward", "island_id": 1, "scores": {"3": 0.0}}
