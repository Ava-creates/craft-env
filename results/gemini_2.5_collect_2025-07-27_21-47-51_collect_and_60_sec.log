{"timestamp": "2025-07-27T21:54:52.049435", "function_name": "collect", "function_body": "  import numpy as np\n  from collections import deque\n\n  # 1. Get primitive ID\n  primitive_idx = env.world.cookbook.index[primitive]\n  if primitive_idx is None:\n      # Primitive name not found in the game's index, cannot collect\n      return []\n\n  # Get the ID for BOUNDARY, which acts as an obstacle for movement\n  boundary_idx = env.world.cookbook.index[\"BOUNDARY\"]\n  # Assuming boundary_idx will always exist in a valid CraftWorld setup\n\n  # 2. Get current state details\n  current_state = env.observations()['_current_state']\n  grid = current_state.grid\n  start_pos_x, start_pos_y = current_state.pos\n\n  # Grid dimensions (rows/height, columns/width, kinds)\n  HEIGHT_GRID, WIDTH_GRID, _ = grid.shape\n\n  # Determine if the primitive is a grabbable item (requires a 'USE' action)\n  # Grabbable items are those listed in env.world.cookbook.primitives or env.world.grabbable_indices\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define movement deltas for (dx, dy) corresponding to (x, y) coordinates\n  # (dx, dy) will be added to (current_x, current_y)\n  move_deltas = {\n      UP: (0, -1),   # Moving up decreases y-coordinate (row index)\n      DOWN: (0, 1),    # Moving down increases y-coordinate (row index)\n      LEFT: (-1, 0),   # Moving left decreases x-coordinate (column index)\n      RIGHT: (1, 0)    # Moving right increases x-coordinate (column index)\n  }\n\n  # 3. Find all target locations where the primitive is present on the grid\n  # Target cells are (x, y) coordinates where grid[y, x, primitive_idx] > 0\n  target_primitive_locs = set()\n  for r_idx in range(HEIGHT_GRID):\n      for c_idx in range(WIDTH_GRID):\n          if grid[r_idx, c_idx, primitive_idx] > 0:\n              target_primitive_locs.add((c_idx, r_idx)) # Store as (x, y)\n\n  if not target_primitive_locs:\n      # The primitive is not found anywhere on the map, no path can be found\n      return []\n\n  # 4. Pathfinding using Breadth-First Search (BFS)\n  # Queue stores tuples of ((current_x, current_y), list_of_actions_to_reach_here)\n  q = deque([((start_pos_x, start_pos_y), [])])\n  # Set to keep track of visited positions to avoid cycles and redundant checks\n  visited = set([(start_pos_x, start_pos_y)])\n\n  while q:\n      (curr_x, curr_y), path = q.popleft()\n\n      # Check if the current position is one of the target primitive locations\n      if (curr_x, curr_y) in target_primitive_locs:\n          # Path found to a cell containing the primitive\n          final_actions = list(path) # Create a copy of the path\n\n          # If the item is grabbable, an additional 'USE' action is required to collect it\n          if is_grabbable:\n              final_actions.append(USE)\n          return final_actions\n\n      # Explore neighbors\n      for action_val, (dx, dy) in move_deltas.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_x < WIDTH_GRID and 0 <= next_y < HEIGHT_GRID):\n              continue\n\n          # Check if the next position is an obstacle (contains a 'BOUNDARY')\n          # Assuming 'BOUNDARY' cells are impassable\n          if grid[next_y, next_x, boundary_idx] > 0:\n              continue\n\n          # Check if the next position has already been visited\n          if (next_x, next_y) in visited:\n              continue\n\n          # Mark as visited and add to the queue for further exploration\n          visited.add((next_x, next_y))\n          q.append(((next_x, next_y), path + [action_val]))\n\n  # If the queue becomes empty and no path to any target primitive was found\n  return []", "island_id": 1, "scores": {"3": -1}}
