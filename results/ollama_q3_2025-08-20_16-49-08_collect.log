, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 0, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T20:11:56.869850", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  primitive_index = cookbook.index.index(primitive)\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    cell_index = grid[cell].argmax()\n\n    if cookbook.index[cookbook.index.index(\"WATER\")] == cell_index and \"BRIDGE\" in inventory:\n      return True  # Can walk over water using a bridge\n    elif cookbook.index[cookbook.index.index(\"ROCK\")] == cell_index and \"PICKAXE\" in inventory:\n      return True  # Can mine rock using a pickaxe\n\n    if cell_index in non_grabbable_indices:\n      return False\n\n    return True  # General case: assume all other cells are walkable\n\n  # BFS for finding the shortest path, considering the agent's inventory\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      if grid[current_pos[0], current_pos[1]].argmax() == target_index:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      # Explore neighbors (up, down, left, right) with priority to non-obstacle cells\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            # If the cell is an obstacle that can be overcome, prioritize it\n            if grid[new_pos[0], new_pos[1]].argmax() in [cookbook.index.index(\"WATER\"), cookbook.index.index(\"ROCK\")]:\n              queue.appendleft(new_pos)\n            else:\n              queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 4.0}}
{"timestamp": "2025-08-20T20:13:28.066748", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get the index of the primitive to collect from the world's cookbook\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a given position is within bounds\n  def is_within_bounds(pos):\n      x, y = pos\n      width, height = env._current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Helper function to get valid neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n      return [n for n in neighbors if is_within_bounds(n)]\n\n  # Helper function to perform a breadth-first search (BFS) to find the shortest path\n  def bfs(start_pos, goal_index):\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      while queue:\n          current_pos, path = queue.popleft()\n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n\n          # Check if the primitive is at the current position or nearby\n          if env._current_state.grid[current_pos[0], current_pos[1], goal_index] > 0:\n              return path\n\n          # Get valid neighbors and add them to the queue with updated path\n          for neighbor in get_neighbors(current_pos):\n              if neighbor not in visited:\n                  new_path = path + [neighbor]\n                  queue.append((neighbor, new_path))\n      return None\n\n  # Define a mapping from positions to actions\n  def pos_to_action(start_pos, end_pos):\n      dx = end_pos[0] - start_pos[0]\n      dy = end_pos[1] - start_pos[1]\n      if dx == 1:\n          return RIGHT\n      elif dx == -1:\n          return LEFT\n      elif dy == 1:\n          return DOWN\n      elif dy == -1:\n          return UP\n      else:\n          raise ValueError(\"Invalid move\")\n\n  # Perform BFS to find the shortest path to the primitive\n  start_pos = env._current_state.pos\n  path_to_primitive = bfs(start_pos, primitive_index)\n\n  if not path_to_primitive:\n      return []\n\n  actions = []\n  current_pos = start_pos\n\n  for target_pos in path_to_primitive:\n      action = pos_to_action(current_pos, target_pos)\n      actions.append(action)\n      current_pos = target_pos\n\n  # Add the USE action to collect the primitive\n  actions.append(USE)\n\n  # Check if the agent needs to use a bridge or other tool to cross water or rock\n  def can_use_tool(tool_index):\n      return env._current_state.grid[current_pos[0], current_pos[1], tool_index] > 0\n\n  # Indices for bridges and tools from the cookbook\n  BRIDGE_INDEX = env.world.cookbook.index['BRIDGE']\n  PICKAXE_INDEX = env.world.cookbook.index['PICKAXE']\n\n  if primitive == 'GOLD' and is_within_bounds((current_pos[0] + 1, current_pos[1])):\n      if env._current_state.grid[current_pos[0] + 1, current_pos[1], primitive_index] > 0:\n          if env._current_state.grid[current_pos[0] + 1, current_pos[1], env.world.cookbook.index['WATER']] > 0 and can_use_tool(BRIDGE_INDEX):\n              actions.append(USE)  # Use bridge to cross water\n          elif env._current_state.grid[current_pos[0] + 1, current_pos[1], env.world.cookbook.index['ROCK']] > 0 and can_use_tool(PICKAXE_INDEX):\n              actions.append(USE)  # Use pickaxe to mine rock\n\n  if primitive == 'GEM' and is_within_bounds((current_pos[0] + 1, current_pos[1])):\n      if env._current_state.grid[current_pos[0] + 1, current_pos[1], primitive_index] > 0:\n          if env._current_state.grid[current_pos[0] + 1, current_pos[1], env.world.cookbook.index['ROCK']] > 0 and can_use_tool(PICKAXE_INDEX):\n              actions.append(USE)  # Use pickaxe to mine rock\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T20:13:29.116300", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get the index of the primitive to collect from the world's cookbook\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a given position is within bounds\n  def is_within_bounds(pos):\n      x, y = pos\n      width, height = env._current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Helper function to get valid neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n      return [n for n in neighbors if is_within_bounds(n)]\n\n  # Helper function to perform a breadth-first search (BFS) to find the shortest path\n  def bfs(start_pos, goal_index):\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      while queue:\n          current_pos, path = queue.popleft()\n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n\n          # Check if the primitive is at the current position or nearby\n          if env._current_state.grid[current_pos[0], current_pos[1], goal_index] > 0:\n              return path\n\n          # Get valid neighbors and add them to the queue with updated path\n          for neighbor in get_neighbors(current_pos):\n              if neighbor not in visited:\n                  new_path = path + [neighbor]\n                  queue.append((neighbor, new_path))\n      return None\n\n  # Define a mapping from positions to actions\n  def pos_to_action(start_pos, end_pos):\n      dx = end_pos[0] - start_pos[0]\n      dy = end_pos[1] - start_pos[1]\n      if dx == 1:\n          return RIGHT\n      elif dx == -1:\n          return LEFT\n      elif dy == 1:\n          return DOWN\n      elif dy == -1:\n          return UP\n      else:\n          raise ValueError(\"Invalid move\")\n\n  # Perform BFS to find the shortest path to the primitive\n  start_pos = env._current_state.pos\n  path_to_primitive = bfs(start_pos, primitive_index)\n\n  if not path_to_primitive:\n      return []\n\n  actions = []\n  current_pos = start_pos\n\n  for target_pos in path_to_primitive:\n      action = pos_to_action(current_pos, target_pos)\n      actions.append(action)\n      current_pos = target_pos\n\n  # Add the USE action to collect the primitive\n  actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T20:15:42.223667", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map direction strings to action indices\n  direction_map = {\n      \"UP\": UP,\n      \"DOWN\": DOWN,\n      \"LEFT\": LEFT,\n      \"RIGHT\": RIGHT\n  }\n\n  def find_primitive_position(grid, primitive_index):\n    \"\"\"Finds the position of the primitive in the grid.\"\"\"\n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if grid[y, x, primitive_index] > 0:\n                return (x, y)\n    return None\n\n  def bfs(start, goal, grid):\n      \"\"\"Performs BFS to find a path from start to goal.\"\"\"\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          current, path = queue.popleft()\n          if current == goal:\n              return path\n          \n          for dir_idx in [UP, DOWN, LEFT, RIGHT]:\n              new_pos = (current[0] + (dir_idx % 2 == 1) * (2 * (dir_idx // 2) - 1),\n                         current[1] + (dir_idx % 2 == 0) * (2 * (dir_idx // 2) - 1))\n              \n              if (0 <= new_pos[0] < grid.shape[1] and\n                  0 <= new_pos[1] < grid.shape[0] and\n                  new_pos not in visited):\n                  \n                  # Check if the cell is empty or contains a passable obstacle\n                  if grid[new_pos[1], new_pos[0]].sum() == 0:\n                      queue.append((new_pos, path + [dir_idx]))\n                      visited.add(new_pos)\n                  elif grid[new_pos[1], new_pos[0]][env.world.cookbook.index[\"BRIDGE\"]] > 0:\n                      # If there's a bridge, treat it as passable\n                      queue.append((new_pos, path + [dir_idx]))\n                      visited.add(new_pos)\n      return None\n\n  def get_primitive_index(primitive_name):\n      \"\"\"Returns the index of the primitive from its name.\"\"\"\n      return env.world.cookbook.index[primitive_name]\n\n  def get_tool_for_primitive(primitive_index, inventory):\n      \"\"\"Finds a tool in inventory that can be used to collect the primitive.\"\"\"\n      # Define mappings for tools\n      tool_mappings = {\n          \"GOLD\": [\"PICKAXE\"],\n          \"GEM\": [\"PICKAXE\"],\n          \"WATER\": [\"BRIDGE\"],  # Assuming BRIDGE is used to cross WATER\n          # Add more mappings as needed\n      }\n      \n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      if primitive_name in tool_mappings:\n          for tool_name in tool_mappings[primitive_name]:\n              tool_index = env.world.cookbook.index[tool_name]\n              if inventory[tool_index] > 0:\n                  return tool_index\n      return None\n\n  def get_path_with_tool(start, goal, grid, tool_index):\n      \"\"\"Performs BFS to find a path from start to goal using a specific tool.\"\"\"\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          current, path = queue.popleft()\n          if current == goal:\n              return path\n          \n          for dir_idx in [UP, DOWN, LEFT, RIGHT]:\n              new_pos = (current[0] + (dir_idx % 2 == 1) * (2 * (dir_idx // 2) - 1),\n                         current[1] + (dir_idx % 2 == 0) * (2 * (dir_idx // 2) - 1))\n              \n              if (0 <= new_pos[0] < grid.shape[1] and\n                  0 <= new_pos[1] < grid.shape[0] and\n                  new_pos not in visited):\n                  \n                  # Check if the cell is empty or contains the tool\n                  if grid[new_pos[1], new_pos[0]].sum() == 0 or grid[new_pos[1], new_pos[0]][tool_index] > 0:\n                      queue.append((new_pos, path + [dir_idx]))\n                      visited.add(new_pos)\n      return None\n\n  # Get the primitive index\n  primitive_index = get_primitive_index(primitive)\n\n  # Find the position of the primitive in the grid\n  primitive_position = find_primitive_position(env._current_state.grid, primitive_index)\n  \n  if not primitive_position:\n      return []  # Primitive not found in the grid\n\n  # Check if a tool is needed for this primitive\n  tool_index = get_tool_for_primitive(primitive_index, env._current_state.inventory)\n\n  # Determine the path to the primitive\n  if tool_index:\n      path = get_path_with_tool(env._current_state.pos, primitive_position, env._current_state.grid, tool_index)\n  else:\n      path = bfs(env._current_state.pos, primitive_position, env._current_state.grid)\n\n  if not path:\n      return []  # No valid path found\n\n  # Convert path directions to action indices\n  path_actions = [direction_map[env.world.index.get(dir_name)] for dir_name in [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"]]\n\n  # Convert path directions to action indices\n  path_actions = [actions[dir_idx] for dir_idx in path]\n  \n  # Add the USE action to collect the primitive\n  path_actions.append(USE)\n\n  return path_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-20T20:15:43.320278", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map direction strings to action indices\n  direction_map = {\n      \"UP\": UP,\n      \"DOWN\": DOWN,\n      \"LEFT\": LEFT,\n      \"RIGHT\": RIGHT\n  }\n\n  def find_primitive_position(grid, primitive_index):\n    \"\"\"Finds the position of the primitive in the grid.\"\"\"\n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if grid[y, x, primitive_index] > 0:\n                return (x, y)\n    return None\n\n  def bfs(start, goal, grid):\n      \"\"\"Performs BFS to find a path from start to goal.\"\"\"\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          current, path = queue.popleft()\n          if current == goal:\n              return path\n          \n          for dir_idx in [UP, DOWN, LEFT, RIGHT]:\n              new_pos = (current[0] + (dir_idx % 2 == 1) * (2 * (dir_idx // 2) - 1),\n                         current[1] + (dir_idx % 2 == 0) * (2 * (dir_idx // 2) - 1))\n              \n              if (0 <= new_pos[0] < grid.shape[1] and\n                  0 <= new_pos[1] < grid.shape[0] and\n                  new_pos not in visited and\n                  grid[new_pos[1], new_pos[0]].sum() == 0):  # Ensure the cell is empty\n                  \n                  queue.append((new_pos, path + [dir_idx]))\n                  visited.add(new_pos)\n      return None\n\n  def get_primitive_index(primitive_name):\n      \"\"\"Returns the index of the primitive from its name.\"\"\"\n      return env.world.cookbook.index[primitive_name]\n\n  def get_tool_for_primitive(primitive_index, inventory):\n      \"\"\"Finds a tool in inventory that can be used to collect the primitive.\"\"\"\n      # Define mappings for tools\n      tool_mappings = {\n          \"GOLD\": [\"PICKAXE\"],\n          \"GEM\": [\"PICKAXE\"],\n          \"WATER\": [\"BRIDGE\"]\n          # Add more mappings as needed\n      }\n      \n      primitive_name = env.world.cookbook.index.get(primitive_index)\n      if primitive_name in tool_mappings:\n          for tool_name in tool_mappings[primitive_name]:\n              tool_index = env.world.cookbook.index[tool_name]\n              if inventory[tool_index] > 0:\n                  return tool_index\n      return None\n\n  def get_path_with_tool(start, goal, grid, tool_index):\n      \"\"\"Performs BFS to find a path from start to goal using a specific tool.\"\"\"\n      queue = collections.deque([(start, [])])\n      visited = set([start])\n\n      while queue:\n          current, path = queue.popleft()\n          if current == goal:\n              return path\n          \n          for dir_idx in [UP, DOWN, LEFT, RIGHT]:\n              new_pos = (current[0] + (dir_idx % 2 == 1) * (2 * (dir_idx // 2) - 1),\n                         current[1] + (dir_idx % 2 == 0) * (2 * (dir_idx // 2) - 1))\n              \n              if (0 <= new_pos[0] < grid.shape[1] and\n                  0 <= new_pos[1] < grid.shape[0] and\n                  new_pos not in visited):\n                  \n                  # Check if the cell is empty or contains the tool\n                  if grid[new_pos[1], new_pos[0]].sum() == 0 or grid[new_pos[1], new_pos[0]][tool_index] > 0:\n                      queue.append((new_pos, path + [dir_idx]))\n                      visited.add(new_pos)\n      return None\n\n  # Get the primitive index\n  primitive_index = get_primitive_index(primitive)\n\n  # Find the position of the primitive in the grid\n  primitive_position = find_primitive_position(env._current_state.grid, primitive_index)\n  \n  if not primitive_position:\n      return []  # Primitive not found in the grid\n\n  # Check if a tool is needed for this primitive\n  tool_index = get_tool_for_primitive(primitive_index, env._current_state.inventory)\n\n  # Determine the path to the primitive\n  if tool_index:\n      path = get_path_with_tool(env._current_state.pos, primitive_position, env._current_state.grid, tool_index)\n  else:\n      path = bfs(env._current_state.pos, primitive_position, env._current_state.grid)\n\n  if not path:\n      return []  # No valid path found\n\n  # Construct the actions to reach and collect the primitive\n  actions = [direction_map[env.world.index.get(dir_name)] for dir_name in [\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"]]\n\n  # Convert path directions to action indices\n  path_actions = [actions[dir_idx] for dir_idx in path]\n  \n  # Add the USE action to collect the primitive\n  path_actions.append(USE)\n\n  return path_actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-20T20:16:56.244333", "function_name": "collect", "function_body": "  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get the index of the primitive to collect from the world's cookbook\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Helper function to check if a given position is within bounds\n  def is_within_bounds(pos):\n      x, y = pos\n      width, height = env._current_state.grid.shape[:2]\n      return 0 <= x < width and 0 <= y < height\n\n  # Helper function to get valid neighbors of a given position\n  def get_neighbors(pos):\n      x, y = pos\n      neighbors = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]\n      return [n for n in neighbors if is_within_bounds(n)]\n\n  # Helper function to perform a breadth-first search (BFS) to find the shortest path\n  def bfs(start_pos, goal_index):\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      while queue:\n          current_pos, path = queue.popleft()\n          if current_pos in visited:\n              continue\n          visited.add(current_pos)\n\n          # Check if the primitive is at the current position or nearby\n          if env._current_state.grid[current_pos[0], current_pos[1], goal_index] > 0:\n              return path\n\n          # Get valid neighbors and add them to the queue with updated path\n          for neighbor in get_neighbors(current_pos):\n              if neighbor not in visited:\n                  new_path = path + [neighbor]\n                  queue.append((neighbor, new_path))\n      return None\n\n  # Define a mapping from positions to actions\n  def pos_to_action(start_pos, end_pos):\n      dx = end_pos[0] - start_pos[0]\n      dy = end_pos[1] - start_pos[1]\n      if dx == 1:\n          return RIGHT\n      elif dx == -1:\n          return LEFT\n      elif dy == 1:\n          return DOWN\n      elif dy == -1:\n          return UP\n      else:\n          raise ValueError(\"Invalid move\")\n\n  # Perform BFS to find the shortest path to the primitive\n  start_pos = env._current_state.pos\n  path_to_primitive = bfs(start_pos, primitive_index)\n\n  if not path_to_primitive:\n      return []\n\n  actions = []\n  current_pos = start_pos\n\n  for target_pos in path_to_primitive:\n      action = pos_to_action(current_pos, target_pos)\n      actions.append(action)\n      current_pos = target_pos\n\n  # Add the USE action to collect the primitive\n  actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
