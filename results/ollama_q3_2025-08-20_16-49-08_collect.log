{"timestamp": "2025-08-21T14:26:13.714307", "function_name": "collect", "function_body": "  # This function will now handle tools in the inventory\n  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Check if the primitive is water, rock, or gem\n  if primitive_index in [world.cookbook.index.index(\"WATER\"), world.cookbook.index.index(\"ROCK\"), world.cookbook.index.index(\"GEM\")]:\n      # Check for tools in inventory to handle these special cases\n      bridge_index = world.cookbook.index.index(\"BRIDGE\")\n      pickaxe_index = world.cookbook.index.index(\"PICKAXE\")\n\n      if primitive_index == world.cookbook.index.index(\"WATER\"):\n          if state.inventory[bridge_index] > 0:\n              # Place a bridge and then collect water\n              return [env.action_specs()[\"USE\"]] + bfs(state.pos, primitive_index) + [env.action_specs()[\"USE\"]]\n      \n      if primitive_index in [world.cookbook.index.index(\"ROCK\"), world.cookbook.index.index(\"GEM\")]:\n          if state.inventory[pickaxe_index] > 0:\n              # Use a pickaxe to collect rock or gem\n              return bfs(state.pos, primitive_index) + [env.action_specs()[\"USE\"]]\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
