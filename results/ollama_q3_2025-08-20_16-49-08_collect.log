 dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-21T11:11:12.951403", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def can_use_tool(tool_index, target_index):\n      \"\"\"Checks if the tool in inventory can be used on the target.\"\"\"\n      # Placeholder logic for tool usage\n      # This should be replaced with actual logic based on game mechanics\n      tools = world.cookbook.primitives\n      targets = world.cookbook.targets\n      return tool_index in tools and target_index in targets[tool_index]\n\n  def bfs_with_tools(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index,\n      considering tool usage.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n\n          # Check for tool usage\n          for i, tool_index in enumerate(state.inventory):\n              if can_use_tool(tool_index, state.grid[x, y].argmax()):\n                  # Use the tool and continue searching\n                  path_with_tool = path + [i]  # Action to use the tool\n                  queue.append(((x, y), path_with_tool))\n\n      return None\n\n  # Find the shortest path to collect the primitive, considering tool usage\n  path = bfs_with_tools(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T11:11:14.032702", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def use_tool_if_needed(x, y, goal_index):\n      \"\"\"Determines if a tool is needed to move from (x, y) to a cell with goal_index.\"\"\"\n      cell_type = state.grid[x, y].argmax()\n      required_tool = get_required_tool(cell_type, goal_index)\n      \n      if required_tool and state.inventory[required_tool] > 0:\n          return [env.action_specs()[get_tool_action(required_tool)]]\n      return []\n\n  def get_required_tool(current_cell, goal_cell):\n      \"\"\"Determines the tool needed to move from current_cell to goal_cell.\"\"\"\n      # Implement logic based on the environment specifics\n      if current_cell == world.cookbook.index.index(\"WATER\") and goal_cell != world.cookbook.index.index(\"BRIDGE\"):\n          return \"BRIDGE\"\n      elif current_cell == world.cookbook.index.index(\"ROCK\") and goal_cell != world.cookbook.index.index(\"PICKAXE\"):\n          return \"PICKAXE\"\n      return None\n\n  def get_tool_action(tool):\n      \"\"\"Determines the action index for using a tool.\"\"\"\n      # Implement logic based on the environment specifics\n      if tool == \"BRIDGE\":\n          return \"PLACE_BRIDGE\"\n      elif tool == \"PICKAXE\":\n          return \"USE_PICKAXE\"\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      actions = []\n      for (x, y) in path[:-1]:\n          actions.extend(use_tool_if_needed(x, y, primitive_index))\n          actions.append(get_action(path[x][0] - x, path[x][1] - y))\n      actions.extend(use_tool_if_needed(state.pos[0], state.pos[1], primitive_index))\n      actions.append(env.action_specs()[\"USE\"])\n      return actions\n  else:\n      return []", "island_id": 8, "scores": {"3": -1}}
