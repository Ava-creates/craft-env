{"timestamp": "2025-08-21T15:04:54.176066", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Initialize action mappings from direction changes\n  actions = {\n      (-1, 0): env.action_specs()[\"LEFT\"],\n      (1, 0): env.action_specs()[\"RIGHT\"],\n      (0, -1): env.action_specs()[\"DOWN\"],\n      (0, 1): env.action_specs()[\"UP\"]\n  }\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [actions[(dx, dy)]]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:04:55.259251", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:06:07.847422", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Utility function to check if a cell is passable, given the current inventory.\n  def is_passable(x, y):\n      \"\"\"Checks if the agent can move through (x, y) based on current inventory.\"\"\"\n      cell_contents = state.grid[x, y].argmax()\n      \n      if cell_contents == world.water_index:\n          return state.inventory[world.bridge_index] > 0\n      elif cell_contents in world.non_grabbable_indices:\n          return False\n      \n      return True\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if is_passable(nx, ny) and (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:06:08.859864", "function_name": "collect", "function_body": "  # Get the index for the primitive we need to collect\n  state = env._current_state\n  world = state.world\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_indices):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing any of the goal_indices.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() in goal_indices:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Identify all tools available in the inventory\n  tools = set()\n  tool_indices = [world.cookbook.index.index(tool) for tool in [\"BRIDGE\", \"PICKAXE\"]]\n  if state.inventory[\"BRIDGE\"] > 0:\n      tools.add(world.cookbook.index.index(\"BRIDGE\"))\n  if state.inventory[\"PICKAXE\"] > 0:\n      tools.add(world.cookbook.index.index(\"PICKAXE\"))\n\n  # Define goal indices based on the primitive and available tools\n  goal_indices = [primitive_index]\n  if primitive == \"GOLD\":\n      goal_indices.append(world.cookbook.index.index(\"ROCK\"))  # Assuming ROCK can be mined for GOLD\n\n  # Find the shortest path to collect the primitive or a required tool\n  path = bfs(state.pos, goal_indices)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:07:23.046489", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) in visited:\n                      continue\n\n                  # Check for obstacles and use tools from inventory to overcome them\n                  can_move = True\n                  tool_needed = None\n                  current_cell_index = state.grid[nx, ny].argmax()\n                  if world.cookbook.index.get(current_cell_index) == \"WATER\":\n                      tool_needed = \"BRIDGE\"\n                  elif world.cookbook.index.get(current_cell_index) == \"ROCK\":\n                      tool_needed = \"PICKAXE\"\n\n                  if tool_needed and state.inventory[world.cookbook.index.index(tool_needed)] > 0:\n                      # Use the tool\n                      path.append(env.action_specs()[\"USE\"])\n                      can_move = True\n                  elif not tool_needed:\n                      can_move = True\n\n                  if can_move:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:07:24.171586", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) in visited:\n                      continue\n\n                  # Check for obstacles and use tools from inventory to overcome them\n                  can_move = True\n                  tool_needed = None\n                  if world.cookbook.index.get(state.grid[nx, ny].argmax()) == \"WATER\":\n                      tool_needed = \"BRIDGE\"\n                  elif world.cookbook.index.get(state.grid[nx, ny].argmax()) == \"ROCK\":\n                      tool_needed = \"PICKAXE\"\n\n                  if tool_needed and state.inventory[world.cookbook.index.index(tool_needed)] > 0:\n                      # Use the tool\n                      path.append(env.action_specs()[\"USE\"])\n                      can_move = True\n                  elif not tool_needed:\n                      can_move = True\n\n                  if can_move:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:09:11.574687", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  primitive_index = cookbook.index.index(primitive)\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n    cell_index = grid[cell].argmax()\n\n    if cell_index in non_grabbable_indices:\n      return False\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    water_index = cookbook.index[cookbook.index.index(\"WATER\")]\n    rock_index = cookbook.index[cookbook.index.index(\"ROCK\")]\n\n    if cell_index == water_index and \"BRIDGE\" in inventory:\n        return True  # Can walk over water using a bridge\n    elif cell_index == rock_index and \"PICKAXE\" in inventory:\n        return True  # Can mine rock using a pickaxe\n\n    return True  # General case: ensure the cell is not an obstacle (assuming non-grabbable indices are obstacles)\n\n  # BFS for finding the shortest path, considering the agent's inventory\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      if grid[current_pos[0], current_pos[1]].argmax() == target_index:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:09:12.690927", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  primitive_index = cookbook.index.index(primitive)\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n    if cell in non_grabbable_indices:\n      return False\n\n    cell_index = grid[cell].argmax()\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    if cookbook.index[cookbook.index.index(\"WATER\")] == cell_index and \"BRIDGE\" in inventory:\n        return True  # Can walk over water using a bridge\n    elif cookbook.index[cookbook.index.index(\"ROCK\")] == cell_index and \"PICKAXE\" in inventory:\n        return True  # Can mine rock using a pickaxe\n\n    return cell != 0  # General case: ensure the cell is not an obstacle (assuming cell==0 is an invalid/obstacle)\n\n  # BFS for finding the shortest path, considering the agent's inventory\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      if grid[current_pos[0], current_pos[1]].argmax() == target_index:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:10:33.091475", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def use_tool(tool_index):\n    \"\"\"Returns the sequence of actions to use a tool if it is in the inventory.\"\"\"\n    if state.inventory[tool_index] > 0:\n        return [env.action_specs()[\"USE\"]]\n    else:\n        return []\n\n  # Check for obstacles and required tools\n  obstacle_indices = {\n      world.cookbook.index.index(\"WATER\"): world.cookbook.index.index(\"BRIDGE\"),\n      world.cookbook.index.index(\"ROCK\"): world.cookbook.index.index(\"PICKAXE\")\n  }\n\n  def can_cross_or_mine(x, y):\n    \"\"\"Checks if the agent can cross or mine the obstacle at (x, y) using available tools.\"\"\"\n    current_cell_index = state.grid[x, y].argmax()\n    tool_index = obstacle_indices.get(current_cell_index)\n    return tool_index is None or use_tool(tool_index)\n\n  # Find the shortest path to collect the primitive\n  def bfs_with_tools(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search with tool usage.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path + [env.action_specs()[\"USE\"]]\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if can_cross_or_mine(nx, ny):\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          new_path = path + [get_action(dx, dy)]\n                          queue.append(((nx, ny), new_path))\n      return None\n\n  path = bfs_with_tools(state.pos, primitive_index)\n  if path is not None:\n      return path\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:10:34.205917", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
