{"timestamp": "2025-08-21T14:29:34.180431", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  # Check for obstacles and use tools in inventory if necessary\n                  if (nx, ny) not in visited:\n                      can_move = True\n                      tool_required = None\n\n                      # Determine if a tool is required to move through the cell\n                      current_cell_index = state.grid[nx, ny].argmax()\n                      if current_cell_index == world.cookbook.index.index(\"WATER\"):\n                          if \"BRIDGE\" in state.inventory:\n                              tool_required = \"BRIDGE\"\n                          else:\n                              can_move = False\n                      elif current_cell_index == world.cookbook.index.index(\"ROCK\"):\n                          if \"PICKAXE\" in state.inventory:\n                              tool_required = \"PICKAXE\"\n                          else:\n                              can_move = False\n\n                      if can_move:\n                          visited.add((nx, ny))\n                          new_path = path + [get_action(dx, dy)]\n                          if tool_required:\n                              # Place the required tool before moving\n                              new_path.append(env.action_specs()[\"USE\"])\n                          queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 5, "scores": {"3": -1}}
