{"timestamp": "2025-08-21T15:48:09.199452", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def use_tool(tool_index):\n      \"\"\"Finds a tool in inventory and returns the action to use it.\"\"\"\n      if state.inventory[tool_index] > 0:\n          # Assuming USE tool action is available, we need to determine how to activate it.\n          # This might involve moving to a specific cell or using an existing action.\n          return env.action_specs()[\"USE\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      actions = path + [env.action_specs()[\"USE\"]]\n      \n      # Check for tools needed and use them if available in inventory\n      if primitive == \"GOLD\" or primitive == \"GEM\":\n          tool_index = world.cookbook.index.index(\"PICKAXE\")\n          pickaxe_action = use_tool(tool_index)\n          if pickaxe_action is not None:\n              actions.insert(0, pickaxe_action)  # Insert at the beginning to use it before reaching the goal\n      \n      return actions\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
