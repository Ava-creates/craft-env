 the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:20:55.701868", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Determine if the desired primitive is already in inventory\n  i_primitive = current_state.world.cookbook.index[primitive]\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Initialize BFS (Breadth-First Search) to find shortest path to collect the primitive\n  visited_grids = set()\n  queue = collections.deque([(current_state.grid.copy(), current_state.pos, current_state.dir, [])])\n\n  while queue:\n      grid, pos, dir, path = queue.popleft()\n\n      # Convert position tuple to a string for hashable comparison\n      pos_str = str(pos)\n\n      # Check if this state has been visited before\n      state_key = (pos_str, dir)\n      if state_key in visited_grids:\n          continue\n\n      # Mark this state as visited\n      visited_grids.add(state_key)\n\n      # Iterate through all possible actions: UP, DOWN, LEFT, RIGHT, USE\n      for action in range(5):\n          reward, new_state = current_state.step(action)\n\n          if new_state.grid is None:\n              continue  # Skip invalid states\n\n          # Check if the primitive is next to the agent's position after taking an action\n          if new_state.next_to(i_primitive):\n              path.append(action)\n              return path + [4]  # Add USE action to collect the primitive\n\n          # If not, add this state to the queue for further exploration\n          queue.append((new_state.grid.copy(), new_state.pos, new_state.dir, path + [action]))\n\n  return []  # Return an empty list if no path is found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:20:56.758082", "function_name": "collect", "function_body": "  def get_available_tools(current_state):\n    tools = []\n    for item in current_state.world.cookbook.primitives:\n      item_name = current_state.world.cookbook.index.get(item)\n      if item_name and current_state.inventory[item] > 0:\n        tools.append(item)\n    return tools\n\n  actions = []\n  current_state = env._current_state\n\n  # Determine if the desired primitive is already in inventory\n  i_primitive = current_state.world.cookbook.index[primitive]\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Initialize BFS (Breadth-First Search) to find shortest path to collect the primitive\n  visited_grids = set()\n  queue = collections.deque([(current_state.grid.copy(), current_state.pos, current_state.dir, [], current_state.inventory.copy())])\n\n  while queue:\n      grid, pos, dir, path, inventory = queue.popleft()\n\n      # Convert position tuple to a string for hashable comparison\n      pos_str = str(pos)\n\n      # Check if this state has been visited before\n      state_key = (pos_str, dir)\n      if state_key in visited_grids:\n          continue\n\n      # Mark this state as visited\n      visited_grids.add(state_key)\n\n      # Iterate through all possible actions: UP, DOWN, LEFT, RIGHT, USE\n      for action in range(5):\n          reward, new_state = current_state.step(action)\n\n          if new_state.grid is None:\n              continue  # Skip invalid states\n\n          # Check if the primitive is next to the agent's position after taking an action\n          if new_state.next_to(i_primitive):\n              path.append(action)\n              return path + [4]  # Add USE action to collect the primitive\n\n          # If not, add this state to the queue for further exploration\n          queue.append((new_state.grid.copy(), new_state.pos, new_state.dir, path + [action], new_state.inventory.copy()))\n\n  return []  # Return an empty list if no path is found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:22:28.035650", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def can_cross_water(state, x, y):\n      \"\"\"Check if the agent can cross water at (x, y) using a bridge.\"\"\"\n      # Check if there is water at (x, y)\n      if state.grid[x, y].argmax() == world.cookbook.index.index(\"WATER\"):\n          # Check if there is a bridge in inventory\n          if \"BRIDGE\" in [world.cookbook.index.primitive_from_index(i) for i in np.nonzero(state.inventory)[0]]:\n              return True\n      return False\n\n  def can_mine_gem(state, x, y):\n      \"\"\"Check if the agent can mine a gem at (x, y) using a pickaxe.\"\"\"\n      # Check if there is a gem at (x, y)\n      if state.grid[x, y].argmax() == world.cookbook.index.index(\"GEM\"):\n          # Check if there is a pickaxe in inventory\n          if \"PICKAXE\" in [world.cookbook.index.primitive_from_index(i) for i in np.nonzero(state.inventory)[0]]:\n              return True\n      return False\n\n  def bfs_with_tools(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index, considering tool use.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      # Check if the cell can be crossed using a bridge\n                      if can_cross_water(state, nx, ny):\n                          # Add action to place bridge and then move\n                          new_path = path + [env.action_specs()[\"USE\"]] + [get_action(dx, dy)]\n                      elif can_mine_gem(state, nx, ny):\n                          # Add action to use pickaxe and then move\n                          new_path = path + [env.action_specs()[\"USE\"]] + [get_action(dx, dy)]\n                      else:\n                          # Normal movement\n                          new_path = path + [get_action(dx, dy)]\n                      visited.add((nx, ny))\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  # Find the shortest path to collect the primitive, considering tool use\n  path = bfs_with_tools(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:22:29.088829", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:28:17.333918", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Determine if the desired primitive is already in inventory\n  i_primitive = current_state.world.cookbook.index[primitive]\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Initialize BFS (Breadth-First Search) to find shortest path to collect the primitive\n  visited_grids = set()\n  queue = collections.deque([(current_state, [])])\n\n  while queue:\n      state, path = queue.popleft()\n\n      # Check if this state has been visited before\n      state_key = tuple(state.grid.flatten()) + (state.pos[0], state.pos[1], state.dir)\n      if state_key in visited_grids:\n          continue\n\n      # Mark this state as visited\n      visited_grids.add(state_key)\n\n      # Iterate through all possible actions: UP, DOWN, LEFT, RIGHT, USE\n      for action in range(5):\n          reward, new_state = state.step(action)\n\n          if new_state.grid is None:\n              continue  # Skip invalid states\n\n          # Check if the primitive is next to the agent's position after taking an action\n          if new_state.next_to(i_primitive):\n              return path + [action, 4]  # Add USE action to collect the primitive\n\n          # If not, add this state to the queue for further exploration\n          queue.append((new_state, path + [action]))\n\n  return []  # Return an empty list if no path is found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:28:18.380354", "function_name": "collect", "function_body": "  def heuristic(pos_a, pos_b):\n    return abs(pos_a[0] - pos_b[0]) + abs(pos_a[1] - pos_b[1])\n\n  actions = []\n  current_state = env._current_state\n\n  # Determine if the desired primitive is already in inventory\n  i_primitive = current_state.world.cookbook.index[primitive]\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Initialize A* search to find shortest path to collect the primitive\n  visited_grids = set()\n  open_set = []\n  heapq.heappush(open_set, (0, current_state.grid.copy(), current_state.pos, current_state.dir, []))\n\n  while open_set:\n      _, grid, pos, dir, path = heapq.heappop(open_set)\n\n      # Convert position tuple to a string for hashable comparison\n      pos_str = str(pos)\n\n      # Check if this state has been visited before\n      state_key = (pos_str, dir)\n      if state_key in visited_grids:\n          continue\n\n      # Mark this state as visited\n      visited_grids.add(state_key)\n\n      # Iterate through all possible actions: UP, DOWN, LEFT, RIGHT, USE\n      for action in range(5):\n          reward, new_state = current_state.step(action)\n\n          if new_state.grid is None:\n              continue  # Skip invalid states\n\n          # Check if the primitive is next to the agent's position after taking an action\n          if new_state.next_to(i_primitive):\n              path.append(action)\n              return path + [4]  # Add USE action to collect the primitive\n\n          # Calculate heuristic cost\n          heuristic_cost = heuristic(new_state.pos, current_state.world.scenario.primitive_positions[primitive])\n\n          # Push this state into the open set for further exploration with A* cost\n          heapq.heappush(open_set, (len(path) + heuristic_cost, new_state.grid.copy(), new_state.pos, new_state.dir, path + [action]))\n\n  return []  # Return an empty list if no path is found", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:28:59.017696", "function_name": "collect", "function_body": "  def bfs_search(state, target):\n    visited = set()\n    queue = collections.deque([(state, [])])\n\n    while queue:\n        current_state, path = queue.popleft()\n\n        # Create a unique hash for the state\n        pos_str = str(current_state.pos)\n        dir_str = str(current_state.dir)\n        state_hash = (pos_str, dir_str)\n\n        if state_hash in visited:\n            continue\n\n        visited.add(state_hash)\n\n        # Check if we are next to the target primitive\n        if current_state.next_to(target):\n            return path + [4]\n\n        # Explore possible actions: UP, DOWN, LEFT, RIGHT, USE\n        for action in range(5):\n            reward, new_state = current_state.step(action)\n            if new_state.grid is None:\n                continue  # Skip invalid states\n\n            queue.append((new_state, path + [action]))\n\n    return []  # No path found\n\n  actions = []\n  current_state = env._current_state\n  i_primitive = current_state.world.cookbook.index[primitive]\n\n  # Check if the desired primitive is already in inventory\n  if current_state.inventory[i_primitive] > 0:\n      return []\n\n  # Perform BFS to find the shortest path to collect the primitive\n  actions = bfs_search(current_state, i_primitive)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:29:00.063822", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Determine if the desired primitive is already in inventory\n  i_primitive = current_state.world.cookbook.index[primitive]\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Initialize BFS (Breadth-First Search) to find shortest path to collect the primitive\n  visited_grids = set()\n  queue = collections.deque([(current_state.grid.copy(), current_state.pos, current_state.dir, [])])\n\n  while queue:\n      grid, pos, dir, path = queue.popleft()\n\n      # Convert position tuple to a string for hashable comparison\n      pos_str = str(pos)\n\n      # Check if this state has been visited before\n      state_key = (pos_str, dir)\n      if state_key in visited_grids:\n          continue\n\n      # Mark this state as visited\n      visited_grids.add(state_key)\n\n      # Iterate through all possible actions: UP, DOWN, LEFT, RIGHT, USE\n      for action in range(5):\n          reward, new_state = current_state.step(action)\n\n          if new_state.grid is None:\n              continue  # Skip invalid states\n\n          # Check if the primitive is next to the agent's position after taking an action\n          if new_state.next_to(i_primitive):\n              path.append(action)\n              return path + [4]  # Add USE action to collect the primitive\n\n          # If not, add this state to the queue for further exploration\n          queue.append((new_state.grid.copy(), new_state.pos, new_state.dir, path + [action]))\n\n  return []  # Return an empty list if no path is found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:29:53.375153", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:29:54.461734", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:35:46.522781", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Determine if the desired primitive is already in inventory\n  i_primitive = current_state.world.cookbook.index[primitive]\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Use a dictionary to track visited states for efficiency\n  visited_states = {}\n\n  # Initialize BFS (Breadth-First Search) to find shortest path to collect the primitive\n  queue = collections.deque([(current_state, [])])\n\n  while queue:\n      current_state, path = queue.popleft()\n\n      # Convert current state to a hashable form for tracking\n      pos_str = str(current_state.pos)\n      dir_str = str(current_state.dir)\n      grid_str = str(current_state.grid.tostring())\n      state_key = (pos_str, dir_str, grid_str)\n\n      # Check if this state has been visited before\n      if state_key in visited_states:\n          continue\n\n      # Mark this state as visited\n      visited_states[state_key] = True\n\n      # Iterate through all possible actions: UP, DOWN, LEFT, RIGHT, USE\n      for action in range(5):\n          reward, new_state = current_state.step(action)\n\n          if new_state is None or new_state.grid is None:\n              continue  # Skip invalid states\n\n          # Check if the primitive is next to the agent's position after taking an action\n          if new_state.next_to(i_primitive):\n              return path + [action] + [4]  # Add USE action to collect the primitive\n\n          # If not, add this state to the queue for further exploration\n          queue.append((new_state, path + [action]))\n\n  return []  # Return an empty list if no path is found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:35:47.586916", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n\n  # Determine if the desired primitive is already in inventory\n  i_primitive = current_state.world.cookbook.index[primitive]\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Initialize BFS (Breadth-First Search) to find shortest path to collect the primitive\n  visited_grids = set()\n  queue = collections.deque([(current_state.grid.copy(), current_state.pos, current_state.dir, [])])\n\n  while queue:\n      grid, pos, dir, path = queue.popleft()\n\n      # Convert position tuple to a string for hashable comparison\n      pos_str = str(pos)\n\n      # Check if this state has been visited before\n      state_key = (pos_str, dir)\n      if state_key in visited_grids:\n          continue\n\n      # Mark this state as visited\n      visited_grids.add(state_key)\n\n      # Iterate through all possible actions: UP, DOWN, LEFT, RIGHT, USE\n      for action in range(5):\n          reward, new_state = current_state.step(action)\n\n          if new_state.grid is None:\n              continue  # Skip invalid states\n\n          # Check if the primitive is next to the agent's position after taking an action\n          if new_state.next_to(i_primitive):\n              path.append(action)\n              return path + [4]  # Add USE action to collect the primitive\n\n          # If not, add this state to the queue for further exploration\n          queue.append((new_state.grid.copy(), new_state.pos, new_state.dir, path + [action]))\n\n  return []  # Return an empty list if no path is found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:37:34.397127", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  primitive_index = cookbook.index[primitive]\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n    if cell in non_grabbable_indices:\n      return False\n\n    cell_index = grid[cell].argmax()\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    if cookbook.index[cookbook.index.index(\"WATER\")] == cell_index and \"BRIDGE\" in inventory:\n        return True  # Can walk over water using a bridge\n    elif cookbook.index[cookbook.index.index(\"ROCK\")] == cell_index and \"PICKAXE\" in inventory:\n        return True  # Can mine rock using a pickaxe\n\n    return cell != 0  # General case: ensure the cell is not an obstacle (assuming cell==0 is an invalid/obstacle)\n\n  # BFS for finding the shortest path, considering the agent's inventory\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      cell_index = grid[current_pos[0], current_pos[1]].argmax()\n      if cell_index == target_index:\n          path = []\n          while current_pos is not None:\n              path.append(current_pos)\n              current_pos = parent[current_pos]\n          return path[::-1]\n\n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
