{"timestamp": "2025-08-21T16:57:52.423564", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  \n  if path is not None:\n      actions = path + [env.action_specs()[\"USE\"]]\n      \n      # Check if tools are needed and use them appropriately\n      for i in range(len(actions)):\n          current_pos = state.pos\n          \n          # If the next action leads to a cell requiring a tool, use that tool first\n          if needs_tool(current_pos):\n              tool_action = get_tool_action(current_pos)\n              if tool_action is not None:\n                  actions.insert(i, tool_action)\n      \n      return actions\n  else:\n      return []\n\n  def needs_tool(pos):\n      \"\"\"Determines if the current position requires a tool to collect the primitive.\"\"\"\n      x, y = pos\n      cell_kind = state.grid[x, y].argmax()\n      \n      # Example: If the cell is water and the agent has a bridge in inventory, it needs to place a bridge first\n      if cell_kind == world.water_index and world.index.get(\"BRIDGE\") in state.inventory:\n          return True\n      \n      # Add more conditions here for other tools and environmental constraints\n      return False\n\n  def get_tool_action(pos):\n      \"\"\"Returns the action to use a tool at the current position.\"\"\"\n      x, y = pos\n      cell_kind = state.grid[x, y].argmax()\n      \n      if cell_kind == world.water_index:\n          # Place a bridge if water is encountered and bridge is in inventory\n          return env.action_specs()[\"USE\"]\n      \n      # Add more conditions here for other tools\n      return None", "island_id": 2, "scores": {"3": -1}}
