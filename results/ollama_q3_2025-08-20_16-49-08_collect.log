{"timestamp": "2025-08-21T16:20:19.960809", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]):\n                  continue\n\n              # Check for obstacles and use tools from inventory to overcome them\n              can_move = True\n              tool_needed = None\n              obstacle_index = state.grid[nx, ny].argmax()\n              obstacle_name = world.cookbook.index.get(obstacle_index)\n              \n              if obstacle_name == \"WATER\":\n                  tool_needed = \"BRIDGE\"\n              elif obstacle_name == \"ROCK\" or obstacle_name == \"GEM\":\n                  tool_needed = \"PICKAXE\"\n\n              if tool_needed and state.inventory[world.cookbook.index.index(tool_needed)] > 0:\n                  # Use the tool\n                  path.append(env.action_specs()[\"USE\"])\n                  can_move = True\n              elif not tool_needed:\n                  can_move = True\n\n              if can_move and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  new_path = path + [get_action(dx, dy)]\n                  queue.append(((nx, ny), new_path))\n\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-21T16:20:21.056806", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) in visited:\n                      continue\n\n                  # Check for obstacles and use tools from inventory to overcome them\n                  can_move = True\n                  tool_needed = None\n                  obstacle_index = state.grid[nx, ny].argmax()\n                  obstacle_name = world.cookbook.index.get(obstacle_index)\n\n                  if obstacle_name == \"WATER\":\n                      tool_needed = \"BRIDGE\"\n                  elif obstacle_name in [\"ROCK\", \"IRON\"]:\n                      tool_needed = \"PICKAXE\"\n\n                  if tool_needed and state.inventory[world.cookbook.index.index(tool_needed)] > 0:\n                      # Use the tool\n                      new_path = path + [env.action_specs()[\"USE\"]]\n                      queue.append(((nx, ny), new_path))\n                      can_move = False\n\n                  if not tool_needed or (tool_needed and can_move):\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-21T16:21:19.684849", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      actions_to_collect = []\n      \n      for action in path:\n          actions_to_collect.append(action)\n      \n      # Add USE action to pick up the primitive\n      actions_to_collect.append(env.action_specs()[\"USE\"])\n      \n      return actions_to_collect\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
