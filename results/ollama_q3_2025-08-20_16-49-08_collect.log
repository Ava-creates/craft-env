ght)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-21T10:35:33.491603", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  target_index = cookbook.index.index(primitive)\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n\n    cell_index = grid[cell].argmax()\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    if cookbook.index[cookbook.index.index(\"WATER\")] == cell_index and \"BRIDGE\" in inventory:\n        return True  # Can walk over water using a bridge\n    elif cookbook.index[cookbook.index.index(\"ROCK\")] == cell_index and \"PICKAXE\" in inventory:\n        return True  # Can mine rock using a pickaxe\n\n    # General case: ensure the cell is not an obstacle (assuming cell==0 is an invalid/obstacle)\n    return cell_index not in non_grabbable_indices\n\n  # BFS for finding the shortest path, considering the agent's inventory\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      if grid[current_pos[0], current_pos[1]].argmax() == target_index:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, target_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T10:35:34.599510", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  primitive_index = cookbook.index.index(primitive)\n\n  def is_walkable(cell, inventory):\n    cell_type = grid[cell].argmax()\n\n    if cell in current_state.world.non_grabbable_indices:\n      return False\n\n    # Check for water and bridge condition\n    if cookbook.index.index(\"WATER\") == cell_type:\n      return \"BRIDGE\" in inventory\n    # Check for rock and pickaxe condition\n    elif cookbook.index.index(\"ROCK\") == cell_type:\n      return \"PICKAXE\" in inventory\n\n    return True  # If none of the above conditions are met, assume the cell is walkable\n\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      if grid[current_pos[0], current_pos[1]].argmax() == target_index:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T10:37:23.758976", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  primitive_index = cookbook.index.index(primitive)\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n    if cell in non_grabbable_indices:\n      return False\n\n    cell_index = grid[cell].argmax()\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    if cookbook.index[cookbook.index.index(\"WATER\")] == cell_index and \"BRIDGE\" in inventory:\n        return True  # Can walk over water using a bridge\n    elif cookbook.index[cookbook.index.index(\"ROCK\")] == cell_index and \"PICKAXE\" in inventory:\n        return True  # Can mine rock using a pickaxe\n\n    return cell != 0  # General case: ensure the cell is not an obstacle (assuming cell==0 is an invalid/obstacle)\n\n  # BFS for finding the shortest path, considering the agent's inventory\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      if grid[current_pos[0], current_pos[1]].argmax() == target_index:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T10:37:24.870975", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  primitive_index = cookbook.index.index(primitive)\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n    if cell in non_grabbable_indices:\n      return False\n\n    cell_index = grid[cell].argmax()\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    if cookbook.index[cookbook.index.index(\"WATER\")] == cell_index and \"BRIDGE\" in inventory:\n        return True  # Can walk over water using a bridge\n    elif cookbook.index[cookbook.index.index(\"ROCK\")] == cell_index and \"PICKAXE\" in inventory:\n        return True  # Can mine rock using a pickaxe\n\n    return cell != 0  # General case: ensure the cell is not an obstacle (assuming cell==0 is an invalid/obstacle)\n\n  # BFS for finding the shortest path, considering the agent's inventory\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      if grid[current_pos[0], current_pos[1]].argmax() == target_index:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T10:38:44.288710", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def can_cross_water(x, y):\n    \"\"\"Checks if the agent can cross water from the current position.\"\"\"\n    bridge_index = world.cookbook.index.index(\"BRIDGE\")\n    if state.inventory[bridge_index] > 0:\n        # Place a bridge and then move\n        return [env.action_specs()[\"USE\"]]\n    else:\n        return None\n\n  def handle_obstacles(path):\n      \"\"\"Modifies the path to account for obstacles.\"\"\"\n      new_path = []\n      i = 0\n      while i < len(path):\n          action = path[i]\n          next_pos = get_position(action)\n          if state.grid[next_pos].argmax() == world.cookbook.index.index(\"WATER\"):\n              # Try to cross water\n              bridge_actions = can_cross_water(*next_pos)\n              if bridge_actions:\n                  new_path.extend(bridge_actions)\n              else:\n                  return None  # Cannot cross water, path is invalid\n          else:\n              new_path.append(action)\n          i += 1\n      return new_path\n\n  def get_position(action):\n      \"\"\"Returns the next position based on the action.\"\"\"\n      dx, dy = get_direction(action)\n      x, y = state.pos\n      nx, ny = x + dx, y + dy\n      return (nx, ny)\n\n  def get_direction(action):\n      \"\"\"Returns the direction change corresponding to the action.\"\"\"\n      if action == env.action_specs()[\"LEFT\"]:\n          return (-1, 0)\n      elif action == env.action_specs()[\"RIGHT\"]:\n          return (1, 0)\n      elif action == env.action_specs()[\"DOWN\"]:\n          return (0, -1)\n      elif action == env.action_specs()[\"UP\"]:\n          return (0, 1)\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      modified_path = handle_obstacles(path)\n      if modified_path:\n          return modified_path + [env.action_specs()[\"USE\"]]\n  return []", "island_id": 6, "scores": {"3": -1}}
