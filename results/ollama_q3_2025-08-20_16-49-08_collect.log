{"timestamp": "2025-08-21T15:44:44.592534", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      actions = path + [env.action_specs()[\"USE\"]]\n\n      # Check for obstacles that can be crossed with tools in inventory\n      for i in range(len(actions) - 1):\n          action = actions[i]\n          nx, ny = state.pos[0] + get_direction(action)[0], state.pos[1] + get_direction(action)[1]\n          if world.cookbook.index.index(\"WATER\") == state.grid[nx, ny].argmax():\n              # Check if BRIDGE is in inventory\n              bridge_index = world.cookbook.index.index(\"BRIDGE\")\n              if state.inventory[bridge_index] > 0:\n                  actions.insert(i + 1, env.action_specs()[\"USE\"])  # Place a bridge\n\n      return actions\n  else:\n      return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:45:59.205139", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      # Check for obstacles and use tools from inventory to overcome them\n                      can_move = True\n                      tool_needed = None\n                      if world.cookbook.index.get(state.grid[nx, ny].argmax()) == \"WATER\":\n                          tool_needed = \"BRIDGE\"\n                      elif world.cookbook.index.get(state.grid[nx, ny].argmax()) == \"ROCK\":\n                          tool_needed = \"PICKAXE\"\n\n                      if tool_needed and state.inventory[world.cookbook.index.index(tool_needed)] > 0:\n                          # Use the tool\n                          new_path = path + [env.action_specs()[\"USE\"]]\n                          queue.append(((nx, ny), new_path))\n                          can_move = False\n\n                      if can_move:\n                          visited.add((nx, ny))\n                          new_path = path + [get_action(dx, dy)]\n                          queue.append(((nx, ny), new_path))\n\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
