_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-21T13:49:42.041929", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n    \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n        (x, y), path = queue.popleft()\n        \n        # Check if we are at a goal\n        if state.grid[x, y].argmax() == goal_index:\n            return path\n\n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                if (nx, ny) in visited:\n                    continue\n\n                # Check for obstacles and use tools from inventory to overcome them\n                can_move = True\n                tool_needed = None\n                obstacle_index = state.grid[nx, ny].argmax()\n                obstacle_name = world.cookbook.index.get(obstacle_index)\n\n                if obstacle_name == \"WATER\":\n                    tool_needed = \"BRIDGE\"\n                elif obstacle_name == \"ROCK\":\n                    tool_needed = \"PICKAXE\"\n\n                if tool_needed and state.inventory[world.cookbook.index.index(tool_needed)] > 0:\n                    # Use the tool\n                    path.append(env.action_specs()[\"USE\"])\n                    can_move = True\n                elif not tool_needed:\n                    can_move = True\n\n                if can_move:\n                    visited.add((nx, ny))\n                    new_path = path + [get_action(dx, dy)]\n                    queue.append(((nx, ny), new_path))\n\n    return None\n\n  def get_action(dx, dy):\n    \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n    if dx == -1 and dy == 0:\n        return env.action_specs()[\"LEFT\"]\n    elif dx == 1 and dy == 0:\n        return env.action_specs()[\"RIGHT\"]\n    elif dx == 0 and dy == -1:\n        return env.action_specs()[\"DOWN\"]\n    elif dx == 0 and dy == 1:\n        return env.action_specs()[\"UP\"]\n    return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-21T13:50:53.997045", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-21T13:50:55.031782", "function_name": "collect", "function_body": "  # Initialize state and world\n  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Define BFS with tool usage handling\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\n      Handles using tools in inventory if necessary.\"\"\"\n      queue = collections.deque([(start_pos, [], set())])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path, used_tools = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      \n                      # Check if the next cell requires a tool\n                      required_tool_index = get_required_tool(nx, ny)\n                      if required_tool_index is not None and required_tool_index in state.inventory:\n                          # Use the tool and add it to the used tools set\n                          new_path += [env.action_specs()[\"USE\"]]\n                          used_tools.add(required_tool_index)\n                          \n                      queue.append(((nx, ny), new_path, used_tools))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def get_required_tool(x, y):\n      \"\"\"Determines if a tool is required to move to the cell (x, y).\"\"\"\n      # Define mappings of environment features to required tools\n      feature_to_tool = {\n          world.cookbook.index.index(\"WATER\"): world.cookbook.index.index(\"BRIDGE\"),\n          world.cookbook.index.index(\"ROCK\"): world.cookbook.index.index(\"PICKAXE\")\n      }\n      \n      for feature, tool in feature_to_tool.items():\n          if state.grid[x, y][feature] > 0:\n              return tool\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-21T13:51:57.183934", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  # Check for obstacles and use tools if available\n                  if world.cookbook.index[\"BRIDGE\"] in state.inventory and state.grid[nx, ny].argmax() == world.cookbook.index[\"WATER\"]:\n                      new_path = path + [env.action_specs()[\"USE\"], get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n                  elif (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-21T13:51:58.309874", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
