{"timestamp": "2025-08-21T14:16:37.300367", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Get indices for tools in inventory\n  inventory = state.inventory\n  available_tools = set()\n  tool_indices = {\n      'BRIDGE': world.cookbook.index.index('BRIDGE'),\n      'PICKAXE': world.cookbook.index.index('PICKAXE')\n      # Add other necessary tools here\n  }\n\n  for tool, index in tool_indices.items():\n      if inventory[index] > 0:\n          available_tools.add(tool)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      # Check for obstacles and use tools if available\n                      obstacle_index = state.grid[nx, ny].argmax()\n                      if obstacle_index == world.cookbook.index.index('WATER'):\n                          if 'BRIDGE' in available_tools:\n                              tool_action = env.action_specs()[\"USE\"]  # Assuming USE places a bridge\n                              return path + [tool_action] + bfs((nx, ny), goal_index)\n                      elif obstacle_index == world.cookbook.index.index('ROCK'):\n                          if 'PICKAXE' in available_tools:\n                              tool_action = env.action_specs()[\"USE\"]  # Assuming USE mines the rock\n                              return path + [tool_action] + bfs((nx, ny), goal_index)\n\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 6, "scores": {"3": -1}}
