 dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-21T05:49:33.963200", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Find tools in inventory that can be used on water, rock, etc.\n  tools_in_inventory = find_tools(state.inventory, world)\n  \n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      \n                      # Check for obstacles and use tools if available\n                      obstacle_index = state.grid[nx, ny].argmax()\n                      if is_obstacle(obstacle_index):\n                          tool_needed = find_tool_for_obstacle(obstacle_index)\n                          if tool_needed in tools_in_inventory:\n                              tool_action = get_tool_use_action(tool_needed)\n                              return path + [tool_action] + bfs((nx, ny), goal_index)\n                      \n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def find_tools(inventory, world):\n      \"\"\"Finds tools available in the inventory.\"\"\"\n      tools = []\n      for item_name, count in enumerate(inventory):\n          if count > 0:\n              item_index = world.cookbook.index.index_from(item_name)\n              if is_tool(item_index):\n                  tools.append(item_index)\n      return tools\n\n  def find_tool_for_obstacle(obstacle_index):\n      \"\"\"Finds the tool needed to bypass an obstacle.\"\"\"\n      if obstacle_index == world.cookbook.index.index(\"WATER\"):\n          return world.cookbook.index.index(\"BRIDGE\")\n      elif obstacle_index == world.cookbook.index.index(\"ROCK\"):\n          return world.cookbook.index.index(\"PICKAXE\")\n      # Add more mappings as needed\n      return None\n\n  def get_tool_use_action(tool_index):\n      \"\"\"Returns the action index corresponding to using a tool.\"\"\"\n      if tool_index == world.cookbook.index.index(\"BRIDGE\"):\n          return env.action_specs()[\"USE\"] + 10  # Hypothetical action for placing a bridge\n      elif tool_index == world.cookbook.index.index(\"PICKAXE\"):\n          return env.action_specs()[\"USE\"] + 20  # Hypothetical action for using a pickaxe\n      # Add more mappings as needed\n      return None\n\n  def is_obstacle(index):\n      \"\"\"Checks if an index corresponds to an obstacle.\"\"\"\n      return index in [world.cookbook.index.index(\"WATER\"), world.cookbook.index.index(\"ROCK\")]\n\n  def is_tool(index):\n      \"\"\"Checks if an index corresponds to a tool.\"\"\"\n      tools = [\"BRIDGE\", \"PICKAXE\"]\n      return any(world.cookbook.index.index(tool) == index for tool in tools)\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T05:49:34.993160", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def use_tool(tool_index):\n      \"\"\"Find the shortest path to use a tool from inventory.\"\"\"\n      queue = collections.deque([(state.pos, [])])\n      visited = set([state.pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a cell where the tool can be used\n          if state.inventory[tool_index] > 0 and state.grid[x, y].argmax() == tool_index:\n              return path + [env.action_specs()[\"USE\"]]\n              \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  # Check if the primitive is already collected\n  if state.inventory[primitive_index] > 0:\n      return []\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      # Try using tools in inventory to reach the primitive\n      for tool_name, tool_index in world.cookbook.index.entries.items():\n          if state.inventory[tool_index] > 0 and tool_name in [\"BRIDGE\", \"PICKAXE\"]:\n              tool_path = use_tool(tool_index)\n              if tool_path:\n                  return tool_path + bfs(state.pos, primitive_index) + [env.action_specs()[\"USE\"]]\n      return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T05:50:40.501569", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  # Check for obstacles and tools in inventory\n                  next_cell = state.grid[nx, ny]\n                  if next_cell.argmax() not in world.cookbook.non_primitive_indices:\n                      # If the cell is not an obstacle, move to it\n                      if (nx, ny) not in visited:\n                          visited.add((nx, ny))\n                          new_path = path + [get_action(dx, dy)]\n                          queue.append(((nx, ny), new_path))\n                  else:\n                      # Handle obstacles using tools in inventory\n                      tool_needed = world.cookbook.tool_for_obstacle[next_cell.argmax()]\n                      if tool_needed in state.inventory:\n                          if (nx, ny) not in visited:\n                              visited.add((nx, ny))\n                              new_path = path + [get_action(dx, dy), env.action_specs()[\"USE\"]]\n                              queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"