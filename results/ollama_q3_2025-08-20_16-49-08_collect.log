n_use_tool_on_primitive(tool_name, primitive):\n                  return tool_name\n      return None\n\n  def can_use_tool_on_primitive(tool_name, primitive_name):\n      \"\"\"Check if the given tool can be used on the given primitive.\"\"\"\n      # Define mappings of tools to primitives they can interact with\n      tool_primitive_map = {\n          \"PICKAXE\": [\"GEM\", \"ROCK\"],\n          \"BRIDGE\": [\"WATER\"],\n          \"SHOVEL\": [\"GRAVE\"]\n          # Add more mappings as needed\n      }\n      return primitive_name in tool_primitive_map.get(tool_name, [])\n\n  tool_needed = is_tool_needed_for_primitive(primitive_index)\n  \n  if tool_needed:\n      print(f\"Tool {tool_needed} needed to collect {primitive}\")\n      # We need to first ensure we have the tool in our inventory and can use it\n      # This part is not yet implemented but should involve using the tool (if possible) before collecting the primitive\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-21T13:44:06.737223", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def use_tool_if_needed(x, y):\n      \"\"\"Determines if a tool is needed to collect the primitive at (x, y) and returns the action if so.\"\"\"\n      cell_contents = state.grid[x, y].argmax()\n      if cell_contents in world.cookbook.primitives_needing_tools:\n          for tool in world.cookbook.tools_for_primitive[cell_contents]:\n              if state.inventory[tool] > 0:  # Check if we have the tool in inventory\n                  return env.action_specs()[\"USE\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      final_actions = []\n      for action in path:\n          final_actions.append(action)\n          x, y = state.pos\n          use_tool_action = use_tool_if_needed(x, y)\n          if use_tool_action:\n              final_actions.append(use_tool_action)\n      return final_actions + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
