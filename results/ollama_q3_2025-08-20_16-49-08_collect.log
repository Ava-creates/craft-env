{"timestamp": "2025-08-21T15:21:24.620807", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Define a set of tools that can be used from inventory\n  tools = {\n      \"BRIDGE\": (world.cookbook.index.index(\"WATER\"), env.action_specs()[\"USE\"]),\n      \"PICKAXE\": (world.cookbook.index.index(\"GEM\"), env.action_specs()[\"USE\"])\n      # Add other tool mappings here as needed\n  }\n\n  def bfs(start_pos, goal_index):\n    \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n    queue = collections.deque([(start_pos, [], state.inventory.copy())])  # (pos, path, inventory)\n    visited = set([start_pos])\n\n    while queue:\n        (x, y), path, inventory = queue.popleft()\n        \n        # Check if we are at a goal\n        if state.grid[x, y].argmax() == goal_index:\n            return path + [env.action_specs()[\"USE\"]]\n        \n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                # Check for obstacles that can be overcome with tools in inventory\n                cell_content_index = state.grid[nx, ny].argmax()\n                tool_needed = None\n                for tool_name, (tool_target_index, tool_action) in tools.items():\n                    if cell_content_index == tool_target_index and inventory[world.cookbook.index.index(tool_name)] > 0:\n                        # We have the required tool, use it first\n                        new_path = path + [tool_action]\n                        nx, ny = x + dx, y + dy  # Move after using the tool\n                        break\n\n                if (nx, ny) not in visited:\n                    visited.add((nx, ny))\n                    new_path = path + [get_action(dx, dy)]\n                    queue.append(((nx, ny), new_path, inventory.copy()))\n    return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 7, "scores": {"3": -1}}
