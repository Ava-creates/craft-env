{"timestamp": "2025-08-21T15:18:09.974841", "function_name": "collect", "function_body": "  # Get the current state and world\n  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:19:11.038110", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Define the action indices based on the environment's action specs\n  ACTION_UP = env.action_specs()[\"UP\"]\n  ACTION_DOWN = env.action_specs()[\"DOWN\"]\n  ACTION_LEFT = env.action_specs()[\"LEFT\"]\n  ACTION_RIGHT = env.action_specs()[\"RIGHT\"]\n  ACTION_USE = env.action_specs()[\"USE\"]\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return ACTION_LEFT\n      elif dx == 1 and dy == 0:\n          return ACTION_RIGHT\n      elif dx == 0 and dy == -1:\n          return ACTION_DOWN\n      elif dx == 0 and dy == 1:\n          return ACTION_UP\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [ACTION_USE]\n  else:\n      return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-21T15:19:12.135687", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 0, "scores": {"3": -1}}
