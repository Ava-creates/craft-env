{"timestamp": "2025-08-21T13:33:57.614907", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Dictionary mapping primitive kinds to their indices in the action specs\n  action_indices = {\n      \"BRIDGE\": env.action_specs().get(\"USE_BRIDGE\", None),\n      \"PICKAXE\": env.action_specs().get(\"USE_PICKAXE\", None)\n  }\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [], [])])  # (position, path, used_tools)\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path, used_tools = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path + [env.action_specs()[\"USE\"]]\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path, used_tools))\n\n          # Check for tool usage\n          current_cell_index = state.grid[x, y].argmax()\n          if current_cell_index in action_indices and action_indices[current_cell_index] is not None:\n              if state.inventory[current_cell_index] > 0:  # Check if the tool is in inventory\n                  tool_action = action_indices[current_cell_index]\n                  new_path = path + [tool_action, env.action_specs()[\"USE\"]]\n                  queue.append(((x, y), new_path, used_tools + [current_cell_index]))\n\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
