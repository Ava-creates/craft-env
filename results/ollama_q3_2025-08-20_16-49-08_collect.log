{"timestamp": "2025-08-21T06:18:51.793942", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T06:18:52.841552", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Identify tools in inventory that can be used to navigate obstacles\n  tool_indices = {\n      world.cookbook.index.get(world.cookbook.index.index(\"BRIDGE\")): \"WATER\",\n      world.cookbook.index.get(world.cookbook.index.index(\"PICKAXE\")): \"GEM\"\n  }\n\n  # Check if there's a specific tool needed and the agent has it\n  required_tool = None\n  for tool_index, target_obstacle in tool_indices.items():\n      if state.inventory[tool_index] > 0:\n          required_tool = (tool_index, target_obstacle)\n          break\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      # Check for obstacles\n                      obstacle_index = state.grid[nx, ny].argmax()\n                      if required_tool and world.cookbook.index.get(obstacle_index) == required_tool[1]:\n                          # Use the tool to bypass the obstacle\n                          path_with_tool = path + [get_action(dx, dy), env.action_specs()[\"USE\"]]\n                          visited.add((nx, ny))\n                          queue.append(((nx, ny), path_with_tool))\n                      else:\n                          new_path = path + [get_action(dx, dy)]\n                          visited.add((nx, ny))\n                          queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-21T06:19:47.422361", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 3, "scores": {"3": -1}}
