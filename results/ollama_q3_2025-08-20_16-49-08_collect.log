      # Check for necessary tools and their usage in inventory\n      tools_needed = []\n      for x, y in [(state.pos[0] + dx, state.pos[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]]:\n          if 0 <= x < state.grid.shape[0] and 0 <= y < state.grid.shape[1]:\n              target_index = state.grid[x, y].argmax()\n              for tool in world.cookbook.index:\n                  tool_index = world.cookbook.index.index(tool)\n                  if can_use_tool(tool_index, target_index) and state.inventory[tool_index] > 0:\n                      tools_needed.append((tool_index, (x, y)))\n      \n      # Add tool usage actions before the collect action\n      for tool_index, (tx, ty) in tools_needed:\n          path_to_tool = bfs(state.pos, tool_index)\n          if path_to_tool is not None:\n              actions = path_to_tool + [env.action_specs()[\"USE\"]] + actions\n      \n      return actions\n  else:\n      return []", "island_id": 5, "scores": {"3": -1}}
