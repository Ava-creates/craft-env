dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  def has_tool_for_obstacle(state, obstacle_name):\n      \"\"\"Checks if the agent has a tool in its inventory that can bypass the given obstacle.\"\"\"\n      # Implement logic to check for tools (e.g., BRIDGE for WATER, PICKAXE for GEM)\n      return True  # Placeholder logic; needs to be implemented\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 1, "scores": {"3": -1}}
