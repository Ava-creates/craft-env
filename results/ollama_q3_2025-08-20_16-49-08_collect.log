{"timestamp": "2025-08-20T17:00:00.601753", "function_name": "collect", "function_body": "  # Initialize the list to store actions\n  actions = []\n\n  # Accessing the current state and world from the environment\n  current_state = env._current_state\n  world = current_state.world\n\n  # Get the index of the primitive we need to collect\n  primitive_index = world.cookbook.index[primitive]\n\n  # Check if the agent already has the primitive in inventory\n  if current_state.inventory[primitive_index] > 0:\n    return actions  # No action needed as we already have it\n\n  # Get positions of all the primitives in the grid\n  primitive_positions = np.argwhere(current_state.grid[:, :, primitive_index] == 1)\n\n  # If there are no primitives available, return empty actions list\n  if len(primitive_positions) == 0:\n    return actions\n\n  # Find the nearest primitive using Manhattan distance\n  current_pos = np.array(current_state.pos)\n  distances = np.sum(np.abs(primitive_positions - current_pos), axis=1)\n  nearest_primitive_pos = tuple(primitive_positions[np.argmin(distances)])\n\n  # Compute a path to the nearest primitive using A* algorithm (assuming a simple grid-based movement model)\n  def heuristic(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def get_neighbors(pos):\n    neighbors = []\n    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor_pos = (pos[0] + dx, pos[1] + dy)\n        if 0 <= neighbor_pos[0] < world.scenario.init_grid.shape[0] and 0 <= neighbor_pos[1] < world.scenario.init_grid.shape[1]:\n            neighbors.append(neighbor_pos)\n    return neighbors\n\n  def a_star(start, goal):\n      open_set = collections.deque([start])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          current = min(open_set, key=lambda x: f_score[x])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n\n          for neighbor in get_neighbors(current):\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  if neighbor not in open_set:\n                      open_set.append(neighbor)\n\n      return None  # No path found\n\n  path_to_primitive = a_star(tuple(current_pos), nearest_primitive_pos)\n\n  if path_to_primitive is None:\n      return actions  # No path available to the primitive\n\n  # Convert path to sequence of actions (assuming UP, DOWN, LEFT, RIGHT are indexed as 0, 1, 2, 3 respectively)\n  direction_map = {\n      (-1, 0): 2,  # LEFT\n      (1, 0): 3,   # RIGHT\n      (0, -1): 0,  # UP\n      (0, 1): 1    # DOWN\n  }\n\n  for i in range(len(path_to_primitive) - 1):\n      current_tile = path_to_primitive[i]\n      next_tile = path_to_primitive[i + 1]\n      move_direction = tuple(np.array(next_tile) - np.array(current_tile))\n      if move_direction in direction_map:\n          actions.append(direction_map[move_direction])\n\n  # Add action to collect the primitive (assuming COLLECT_FUNC maps to index 5)\n  actions.append(5)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
