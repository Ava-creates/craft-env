 dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:39:22.689787", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  primitive_index = cookbook.index.index(primitive)\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n    if cell in non_grabbable_indices:\n      return False\n\n    cell_index = grid[cell].argmax()\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    if cookbook.index[cookbook.index.index(\"WATER\")] == cell_index and \"BRIDGE\" in inventory:\n        return True  # Can walk over water using a bridge\n    elif cookbook.index[cookbook.index.index(\"ROCK\")] == cell_index and \"PICKAXE\" in inventory:\n        return True  # Can mine rock using a pickaxe\n\n    return cell != 0  # General case: ensure the cell is not an obstacle (assuming cell==0 is an invalid/obstacle)\n\n  # BFS for finding the shortest path, considering the agent's inventory\n  from collections import deque\n\n  def bfs_shortest_path(start, target_index, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position contains the target primitive\n      if grid[current_pos[0], current_pos[1]].argmax() == target_index:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find the shortest path to a cell containing the target primitive, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, primitive_index, inventory)\n\n  if path_to_primitive is None:\n    return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n      dx = next_pos[0] - current_pos[0]\n      dy = next_pos[1] - current_pos[1]\n\n      if dx == -1 and dy == 0:\n          return craft.LEFT\n      elif dx == 1 and dy == 0:\n          return craft.RIGHT\n      elif dx == 0 and dy == -1:\n          return craft.DOWN\n      elif dx == 0 and dy == 1:\n          return craft.UP\n      else:\n          raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:40:40.902788", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Define available tools and their usage conditions\n  tool_usage_conditions = {\n      world.cookbook.index.index(\"BRIDGE\"): lambda x, y: state.grid[x, y].argmax() == world.cookbook.index.index(\"WATER\"),\n      world.cookbook.index.index(\"PICKAXE\"): lambda x, y: state.grid[x, y].argmax() == world.cookbook.index.index(\"GEM\")\n  }\n\n  def bfs(start_pos, goal_index):\n      \"\"\"Performs a breadth-first search to find the shortest path from start_pos to the nearest cell containing goal_index.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          # Check if we are at a goal\n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      # Check if we need to use a tool\n                      for tool_index, condition in tool_usage_conditions.items():\n                          if condition(nx, ny) and state.inventory[tool_index] > 0:\n                              # Use the tool first\n                              return path + [env.action_specs()[\"USE\"]] + bfs((nx, ny), goal_index)\n                      \n                      visited.add((nx, ny))\n                      new_path = path + [get_action(dx, dy)]\n                      queue.append(((nx, ny), new_path))\n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:40:42.009998", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n\n  # Get the index for the primitive we need to collect\n  primitive_index = world.cookbook.index.index(primitive)\n\n  # Define a function for moving in different directions and using tools if necessary\n  def get_next_moves(pos, visited):\n      x, y = pos\n      moves = []\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nx, ny = x + dx, y + dy\n          \n          if 0 <= nx < state.grid.shape[0] and 0 <= ny < state.grid.shape[1]:\n              if (nx, ny) not in visited:\n                  action = get_action(dx, dy)\n                  moves.append(((nx, ny), action))\n      \n      # Check for tools that might help in reaching the goal\n      tool_needed_for_primitive = world.cookbook.primitives_for(primitive_index).get(primitive_index, 0)\n      \n      if tool_needed_for_primitive > 0 and state.inventory.get(tool_needed_for_primitive, 0) > 0:\n          # Use a tool to move over obstacles (e.g., bridge over water)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              \n              if state.next_to(nx, ny, tool_needed_for_primitive):\n                  action = env.action_specs()[\"USE\"]\n                  moves.append(((nx, ny), action))\n      \n      return moves\n\n  # BFS to find the shortest path to collect the primitive\n  def bfs(start_pos, goal_index):\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          (x, y), path = queue.popleft()\n          \n          if state.grid[x, y].argmax() == goal_index:\n              return path\n\n          next_moves = get_next_moves((x, y), visited)\n          for (nx, ny), action in next_moves:\n              visited.add((nx, ny))\n              new_path = path + [action]\n              queue.append(((nx, ny), new_path))\n      \n      return None\n\n  def get_action(dx, dy):\n      \"\"\"Returns the action index corresponding to the given direction change.\"\"\"\n      if dx == -1 and dy == 0:\n          return env.action_specs()[\"LEFT\"]\n      elif dx == 1 and dy == 0:\n          return env.action_specs()[\"RIGHT\"]\n      elif dx == 0 and dy == -1:\n          return env.action_specs()[\"DOWN\"]\n      elif dx == 0 and dy == 1:\n          return env.action_specs()[\"UP\"]\n      return None\n\n  # Find the shortest path to collect the primitive\n  path = bfs(state.pos, primitive_index)\n  \n  if path is not None:\n      return path + [env.action_specs()[\"USE\"]]\n  else:\n      return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-21T04:42:33.485876", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook = current_state.world.cookbook\n  grid = current_state.grid\n  pos = current_state.pos\n\n  # Get the index for the specified primitive\n  target_primitive_index = cookbook.index.index(primitive)\n\n  # Helper function to determine if a cell is walkable based on the agent's inventory and tools.\n  def is_walkable(cell, inventory):\n    non_grabbable_indices = set(current_state.world.non_grabbable_indices)\n    non_grabbable_indices.discard(cookbook.index.index(\"BRIDGE\"))  # Allow bridges\n    if cell in non_grabbable_indices:\n      return False\n\n    cell_index = grid[cell].argmax()\n\n    # Check if the cell contains an obstacle that can be overcome with a tool.\n    if cookbook.index[cookbook.index.index(\"WATER\")] == cell_index and \"BRIDGE\" in inventory:\n        return True  # Can walk over water using a bridge\n    elif cookbook.index[cookbook.index.index(\"ROCK\")] == cell_index and \"PICKAXE\" in inventory:\n        return True  # Can mine rock using a pickaxe\n\n    return cell != 0  # General case: ensure the cell is not an obstacle (assuming cell==0 is an invalid/obstacle)\n\n  # Function to find all target cells containing the primitive\n  def find_target_cells(grid, target_primitive_index):\n      target_cells = []\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j].argmax() == target_primitive_index:\n                  target_cells.append((i, j))\n      return target_cells\n\n  # BFS to find the shortest path to any target cell\n  def bfs_shortest_path(start, target_cells, inventory):\n    queue = deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current_pos = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check if the current position is a target cell\n      if current_pos in target_cells:\n        path = []\n        while current_pos is not None:\n          path.append(current_pos)\n          current_pos = parent[current_pos]\n        return path[::-1]\n\n      # Explore neighbors (up, down, left, right)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if 0 <= new_pos[0] < grid.shape[0] and 0 <= new_pos[1] < grid.shape[1]:\n          if is_walkable(new_pos, inventory) and new_pos not in visited:\n            queue.append(new_pos)\n            parent[new_pos] = current_pos\n\n    return None  # No path found\n\n  # Get the agent's current inventory\n  inventory_indices = np.where(current_state.inventory > 0)[0]\n  inventory = set(cookbook.index[inv_index] for inv_index in inventory_indices)\n\n  # Find all target cells containing the primitive\n  target_cells = find_target_cells(grid, target_primitive_index)\n\n  # Find the shortest path to any of the target cells, considering the agent's inventory\n  path_to_primitive = bfs_shortest_path(pos, target_cells, inventory)\n\n  if not path_to_primitive:\n      return []  # No valid path found\n\n  # Convert path of positions into sequence of actions\n  def position_to_action(current_pos, next_pos):\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n\n    if dx == -1 and dy == 0:\n        return craft.LEFT\n    elif dx == 1 and dy == 0:\n        return craft.RIGHT\n    elif dx == 0 and dy == -1:\n        return craft.DOWN\n    elif dx == 0 and dy == 1:\n        return craft.UP\n    else:\n        raise ValueError(\"Invalid next position\")\n\n  # Convert the path to a sequence of actions\n  actions = []\n  for i in range(len(path_to_primitive) - 1):\n      action = position_to_action(path_to_primitive[i], path_to_primitive[i + 1])\n      actions.append(action)\n\n  # Add action to collect the primitive at the final position\n  actions.append(craft.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
