n = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n      x_dir = np.sign(target_pos[0] - current_pos[0])\n      y_dir = np.sign(target_pos[1] - current_pos[1])\n      return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n      actions = []\n\n      # Align agent's direction with movement direction\n      while x_dir != 0 or y_dir != 0:\n          if x_dir < 0:\n              actions.append(LEFT)\n              x_dir += 1\n          elif x_dir > 0:\n              actions.append(RIGHT)\n              x_dir -= 1\n\n          if y_dir < 0:\n              actions.append(DOWN)\n              y_dir += 1\n          elif y_dir > 0:\n              actions.append(UP)\n              y_dir -= 1\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T07:55:46.048271", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                actions.extend(move_and_use(nearest_primitive_position))\n    \n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        actions.extend(move_and_use(workshop_position))\n    \n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def move_and_use(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent to the target position \n      and use the item or workshop at that position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the target position and use it.\n    \"\"\"\n    current_pos = env._current_state.pos\n    x_dir, y_dir = compute_direction(target_pos, current_pos)\n    \n    actions = []\n    \n    # Move in the x direction first\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    \n    # Then move in the y direction\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    # Finally, use the item or workshop at the target position\n    actions.append(USE)\n    \n    return actions\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T07:55:47.045714", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles multiple instances of each primitive if needed.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"Primitive '{primitive}' not found on the map.\")\n\n            # Calculate direction to move towards the nearest instance of the primitive\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n            count -= 1\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(\"No suitable workshop found on the map.\")\n\n    # Calculate direction to move towards the nearest workshop\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index if necessary\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It handles diagonal movements and ensures the agent faces the correct direction before moving.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Determine the sequence of moves needed based on x_dir and y_dir\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  def rotate_to(direction):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent towards the specified direction.\n      It assumes the agent can only face one of the four cardinal directions at a time.\n\n      Args:\n        direction: The target facing direction, represented as a tuple (x_dir, y_dir).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent towards the target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    actions = []\n\n    # Calculate the difference between current and target directions\n    x_diff = direction[0] - current_direction[0]\n    y_diff = direction[1] - current_direction[1]\n\n    if x_diff != 0:\n        if x_diff < 0:\n            actions.append(LEFT)\n        else:\n            actions.append(RIGHT)\n\n    if y_diff != 0:\n        if y_diff < 0:\n            actions.append(DOWN)\n        else:\n            actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-30T07:58:07.278213", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def get_direction_to_target(current_pos, target_pos):\n      \"\"\"\n      Calculate the direction to move from current position to target position.\n      \n      Args:\n          current_pos (tuple): Current position as (x, y).\n          target_pos (tuple): Target position as (x, y).\n\n      Returns:\n          tuple: Direction vector (dx, dy) where dx and dy are in {-1, 0, 1}.\n      \"\"\"\n      return np.sign(target_pos[0] - current_pos[0]), np.sign(target_pos[1] - current_pos[1])\n\n  def get_movement_actions(dx, dy):\n      \"\"\"\n      Generate movement actions based on the direction vector.\n      \n      Args:\n          dx (int): Change in x position (-1, 0, or 1).\n          dy (int): Change in y position (-1, 0, or 1).\n\n      Returns:\n          list: List of movement actions.\n      \"\"\"\n      actions = []\n      if dx < 0:\n          actions.append(LEFT)\n      elif dx > 0:\n          actions.append(RIGHT)\n      if dy < 0:\n          actions.append(DOWN)\n      elif dy > 0:\n          actions.append(UP)\n      return actions\n\n  def find_nearest_item(item_index, grid):\n      \"\"\"\n      Find the nearest instance of an item in the grid.\n      \n      Args:\n          item_index (int): Index of the item to be found.\n          grid (numpy.ndarray): Grid representing the environment.\n\n      Returns:\n          tuple or None: Position (x, y) of the nearest item, or None if not found.\n      \"\"\"\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      if len(positions) == 0:\n          return None\n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n      \"\"\"\n      Find the nearest workshop of a given type in the grid.\n      \n      Args:\n          workshop_type (str): Type of workshop to be found.\n          grid (numpy.ndarray): Grid representing the environment.\n\n      Returns:\n          tuple or None: Position (x, y) of the nearest workshop, or None if not found.\n      \"\"\"\n      workshop_index = env.world.cookbook.index[workshop_type]\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if len(positions) == 0:\n          return None\n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n      return tuple(positions[nearest_index])\n\n  def gather_and_craft(goal_item):\n      \"\"\"\n      Gather required primitives and craft the goal item.\n      \n      Args:\n          goal_item (str): Name of the item to be crafted.\n\n      Returns:\n          list: List of actions to achieve the goal.\n      \"\"\"\n      actions = []\n      goal_index = env.world.cookbook.index[goal_item]\n      if goal_index is None:\n          raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n      \n      # Fetch required primitives\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n      \n      for primitive, count in primitives_needed.items():\n          primitive_index = env.world.cookbook.index[primitive]\n          if primitive_index is None:\n              raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n          \n          for _ in range(count):\n              # Find nearest instance of the primitive\n              primitive_pos = find_nearest_item(primitive_index, env._current_state.grid)\n              if primitive_pos is None:\n                  print(f\"No more instances of {primitive} found. Continuing with available resources.\")\n                  break  # No more primitives available\n      \n              # Move to the primitive and gather it\n              dx, dy = get_direction_to_target(env._current_state.pos, primitive_pos)\n              actions.extend(get_movement_actions(dx, dy))\n              actions.append(USE)  # Gather the primitive\n      \n      # Find nearest workshop for crafting\n      workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n      workshop_pos = find_nearest_workshop(workshop_type, env._current_state.grid)\n      if workshop_pos is None:\n          raise ValueError(f\"No workshop of type '{workshop_type}' found in the environment.\")\n      \n      # Move to the workshop and craft the item\n      dx, dy = get_direction_to_target(env._current_state.pos, workshop_pos)\n      actions.extend(get_movement_actions(dx, dy))\n      actions.append(USE)  # Craft the item\n      \n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T07:58:08.270055", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item.\n      It handles movement and turning to reach each primitive.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives for the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move and turn to the position of the primitive\n                actions.extend(move_and_turn(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_and_turn(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move and turn the agent in the specified direction.\n      It checks if the agent needs to turn before moving.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move and turn the agent in the specified direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = compute_target_direction(x_dir, y_dir)\n    \n    # Calculate the difference between current and target directions\n    dir_diff_x = target_direction[0] - current_direction[0]\n    dir_diff_y = target_direction[1] - current_direction[1]\n\n    actions = []\n\n    if dir_diff_x != 0:\n        if dir_diff_x < 0:\n            actions.append(LEFT)\n        else:\n            actions.append(RIGHT)\n\n    if dir_diff_y != 0:\n        if dir_diff_y < 0:\n            actions.append(DOWN)\n        else:\n            actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    actions.append(USE)\n\n    return actions\n\n  def compute_target_direction(x_dir, y_dir):\n    \"\"\"\n      This function computes the target direction based on the desired change in x and y positions.\n      It ensures that the agent faces the correct direction before moving.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        Tuple[int, int]: The target direction as a tuple of (x, y) values.\n    \"\"\"\n    if x_dir < 0:\n        return (-1, 0)\n    elif x_dir > 0:\n        return (1, 0)\n    elif y_dir < 0:\n        return (0, -1)\n    elif y_dir > 0:\n        return (0, 1)\n    else:\n        return (0, 0)\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_primitives(goal_index)\n\n  # Find the nearest workshop for crafting the item\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n  \n  if workshop_position:\n      x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n      \n      # Move and turn to the position of the workshop\n      actions.extend(move_and_turn(x_dir, y_dir))\n      \n      # Use action to craft the item at the workshop\n      actions.append(USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:02:24.474892", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles agent orientation and ensures correct actions are taken to move \n      towards targets. Additionally, it checks for obstacles in the path and finds \n      alternative routes if necessary.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instance of '{primitive}' found on the grid.\")\n\n            # Find a path to the nearest instance of the primitive\n            path_to_primitive = find_path(env._current_state.pos, nearest_primitive_position)\n            \n            if not path_to_primitive:\n                raise ValueError(\"No valid path to the target position found.\")\n            \n            # Generate actions to follow the path and gather the primitive\n            for move in path_to_primitive:\n                actions.extend(move_and_orient(*move))\n                actions.append(USE)\n\n            # Decrement count after gathering one instance of the primitive\n            count -= 1\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No workshop of type '{env.world.cookbook.recipes[goal_index]['_at']}' found on the grid.\")\n\n    # Find a path to the nearest workshop\n    path_to_workshop = find_path(env._current_state.pos, workshop_position)\n    \n    if not path_to_workshop:\n        raise ValueError(\"No valid path to the workshop position found.\")\n    \n    # Generate actions to follow the path and craft the item\n    for move in path_to_workshop:\n        actions.extend(move_and_orient(*move))\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_and_orient(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction\n      and orient it correctly. It ensures that the agent faces the correct direction before moving.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move and orient the agent towards the target direction.\n    \"\"\"\n    # Determine current orientation\n    current_direction = env._current_state.dir\n    \n    # Map direction indices to action indices (assuming 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n    dir_to_action_map = {0: DOWN, 1: UP, 2: LEFT, 3: RIGHT}\n    \n    # Compute target orientation\n    if x_dir == -1 and y_dir == 0:\n        target_direction = 2  # LEFT\n    elif x_dir == 1 and y_dir == 0:\n        target_direction = 3  # RIGHT\n    elif x_dir == 0 and y_dir == -1:\n        target_direction = 0  # DOWN\n    elif x_dir == 0 and y_dir == 1:\n        target_direction = 1  # UP\n\n    actions = []\n    \n    # Turn to face the correct direction if not already facing it\n    while current_direction != target_direction:\n        if (current_direction + 1) % 4 == target_direction or (current_direction - 3) % 4 == target_direction:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        # Update the agent's direction after each turn action\n        current_direction = (current_direction + actions[-1] - LEFT) % 4\n\n    # Add movement action towards the target position\n    actions.append(dir_to_action_map[target_direction])\n\n    return actions\n\n  def find_path(start_pos, end_pos):\n    \"\"\"\n      This function finds a path from the start position to the end position on the grid.\n      It uses a simple breadth-first search (BFS) algorithm to explore the grid and find \n      an unobstructed path.\n\n      Args:\n        start_pos: A tuple representing the (x, y) coordinates of the start position.\n        end_pos: A tuple representing the (x, y) coordinates of the end position.\n\n      Returns:\n        List[Tuple[int, int]]: A list of direction vectors [(x_dir1, y_dir1), ..., (x_dirN, y_dirN)]\n                               representing the path from the start to the end position.\n    \"\"\"\n    # Directions for moving in the grid: right, up, left, down\n    directions = [(0, 1), (-1, 0), (0, -1), (1, 0)]\n    \n    # Initialize queue for BFS with the start position and an empty path\n    queue = [(start_pos, [])]\n    \n    # Set to keep track of visited positions\n    visited = set()\n    visited.add(start_pos)\n    \n    while queue:\n        current_pos, path = queue.pop(0)\n\n        # If we've reached the end position, return the path\n        if current_pos == end_pos:\n            return path\n\n        # Explore neighbors in all four directions\n        for direction in directions:\n            next_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n\n            # Check if the next position is within grid bounds and not an obstacle\n            if (0 <= next_pos[0] < env._current_state.grid.shape[0] and \n                0 <= next_pos[1] < env._current_state.grid.shape[1] and\n                env._current_state.grid[next_pos] == 0 and\n                next_pos not in visited):\n                \n                # Add the new position to the queue with the updated path\n                queue.append((next_pos, path + [direction]))\n                visited.add(next_pos)\n\n    return None  # Return None if no valid path is found\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  try:\n      goal_index = env.world.cookbook.index[goal_item]\n  except KeyError:\n      raise ValueError(f\"No item named '{goal_item}' found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:02:25.478392", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles agent orientation and ensures correct actions are taken to move \n      towards targets. Additionally, it uses a pathfinding approach to navigate around obstacles.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory[primitive] < count:\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise ValueError(f\"Primitive '{primitive}' not found in the grid.\")\n            \n            # Compute path to the primitive using A* algorithm\n            path_to_primitive = a_star(env._current_state.pos, nearest_primitive_position, env._current_state.grid)\n            \n            if not path_to_primitive:\n                raise ValueError(\"No valid path to the primitive.\")\n\n            # Follow the path and gather the primitive\n            actions.extend(follow_path(path_to_primitive))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    nearest_workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if nearest_workshop_position is None:\n        raise ValueError(f\"Workshop of type '{workshop_type}' not found in the grid.\")\n    \n    # Compute path to the workshop using A* algorithm\n    path_to_workshop = a_star(env._current_state.pos, nearest_workshop_position, env._current_state.grid)\n    \n    if not path_to_workshop:\n        raise ValueError(\"No valid path to the workshop.\")\n\n    # Follow the path and craft the item\n    actions.extend(follow_path(path_to_workshop))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if len(positions) == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if len(positions) == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_and_orient(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction\n      and orient it correctly. It ensures that the agent faces the correct direction before moving.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move and orient the agent towards the target direction.\n    \"\"\"\n    # Determine current orientation\n    current_direction = env._current_state.dir\n    \n    # Map direction indices to action indices (assuming 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n    dir_to_action_map = {0: DOWN, 1: UP, 2: LEFT, 3: RIGHT}\n    \n    # Compute target orientation\n    if x_dir == -1 and y_dir == 0:\n        target_direction = 2  # LEFT\n    elif x_dir == 1 and y_dir == 0:\n        target_direction = 3  # RIGHT\n    elif x_dir == 0 and y_dir == -1:\n        target_direction = 0  # DOWN\n    elif x_dir == 0 and y_dir == 1:\n        target_direction = 1  # UP\n\n    actions = []\n    \n    # Turn to face the correct direction if not already facing it\n    while current_direction != target_direction:\n        if (current_direction + 1) % 4 == target_direction or (current_direction - 3) % 4 == target_direction:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        # Update the agent's direction after each turn action\n        current_direction = (current_direction + actions[-1]) % 4\n\n    # Add movement action towards the target position\n    actions.append(dir_to_action_map[target_direction])\n\n    return actions\n\n  def a_star(start, goal, grid):\n    \"\"\"\n      This function implements the A* pathfinding algorithm to compute the shortest \n      path from a start position to a goal position on the given grid.\n\n      Args:\n        start: A tuple representing the (x, y) coordinates of the start position.\n        goal: A tuple representing the (x, y) coordinates of the goal position.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        List[Tuple[int, int]]: A list of (x, y) positions representing the shortest path \n                               from the start to the goal. If no valid path is found, returns an empty list.\n    \"\"\"\n    # Define heuristic function (Manhattan distance)\n    def heuristic(a, b):\n        return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    # Initialize open and closed sets\n    open_set = []\n    heapq.heappush(open_set, (0, start))\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while open_set:\n        current = heapq.heappop(open_set)[1]\n\n        if current == goal:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            path.reverse()\n            return path\n\n        for neighbor in get_neighbors(current, grid):\n            tentative_g_score = g_score[current] + 1\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n    return []\n\n  def get_neighbors(position, grid):\n    \"\"\"\n      This function returns the valid neighboring positions of a given position on the grid.\n      It considers only those neighbors that are within the grid boundaries and not blocked.\n\n      Args:\n        position: A tuple representing the (x, y) coordinates of the current position.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        List[Tuple[int, int]]: A list of (x, y) positions representing the valid neighbors \n                               of the given position.\n    \"\"\"\n    x, y = position\n    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n    neighbors = []\n\n    for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n            # Check if the neighbor is not blocked\n            if grid[nx, ny, 0] == 0:  # Assuming 0 represents an unblocked cell\n                neighbors.append((nx, ny))\n\n    return neighbors\n\n  def follow_path(path):\n    \"\"\"\n      This function generates a sequence of actions to follow a given path on the grid.\n      It ensures that the agent moves from each position in the path to the next.\n\n      Args:\n        path: A list of (x, y) positions representing the path to be followed.\n\n      Returns:\n        List[int]: A list of action indices corresponding to the movements required \n                   to follow the given path.\n    \"\"\"\n    actions = []\n\n    for i in range(len(path) - 1):\n        current_pos = path[i]\n        next_pos = path[i + 1]\n\n        x_dir = np.sign(next_pos[0] - current_pos[0])\n        y_dir = np.sign(next_pos[1] - current_pos[1])\n\n        actions.extend(move_and_orient(x_dir, y_dir))\n\n    return actions\n\n  def move_and_orient(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified \n      direction and orient it correctly.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of action indices corresponding to the movements required \n                   to move the agent in the specified direction and orient it correctly.\n    \"\"\"\n    actions = []\n\n    # Compute target orientation\n    if x_dir == -1 and y_dir == 0:\n        target_direction = 2  # LEFT\n    elif x_dir == 1 and y_dir == 0:\n        target_direction = 3  # RIGHT\n    elif x_dir == 0 and y_dir == -1:\n        target_direction = 0  # DOWN\n    elif x_dir == 0 and y_dir == 1:\n        target_direction = 1  # UP\n\n    # Determine current orientation\n    current_direction = env._current_state.dir\n    \n    # Map direction indices to action indices (assuming 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT)\n    dir_to_action_map = {0: DOWN, 1: UP, 2: LEFT, 3: RIGHT}\n\n    # Turn to face the correct direction if not already facing it\n    while current_direction != target_direction:\n        if (current_direction + 1) % 4 == target_direction or (current_direction - 3) % 4 == target_direction:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        # Update the agent's direction after each turn action\n        current_direction = (current_direction + actions[-1]) % 4\n\n    # Add movement action towards the target position\n    actions.append(dir_to_action_map[target_direction])\n\n    return actions\n\n  # Example usage\n  goal_item_index = env.world.cookbook.index(\"desired_item\")\n  crafting_actions = gather_and_craft(goal_item_index)\n  \n  for action in crafting_actions:\n      print(action)", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:04:02.165237", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move to the position of the primitive\n            actions.extend(turn_and_move(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n    \n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n    \n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    actions = []\n\n    if x_dir == 0 and y_dir == 0:\n        return actions\n    \n    # Calculate the target direction based on (x, y) directions\n    target_directions = {\n        (-1, 0): LEFT,\n        (1, 0): RIGHT,\n        (0, -1): DOWN,\n        (0, 1): UP\n    }\n\n    current_direction = env._current_state.dir\n\n    # Mapping from current direction to actions needed to reach the target direction\n    direction_map = {\n        (UP, LEFT): [LEFT],\n        (UP, RIGHT): [RIGHT],\n        (UP, DOWN): [DOWN, DOWN],\n        (UP, UP): [],\n        \n        (DOWN, LEFT): [LEFT],\n        (DOWN, RIGHT): [RIGHT],\n        (DOWN, UP): [UP, UP],\n        (DOWN, DOWN): [],\n        \n        (LEFT, LEFT): [],\n        (LEFT, RIGHT): [RIGHT, RIGHT],\n        (LEFT, DOWN): [DOWN],\n        (LEFT, UP): [UP],\n        \n        (RIGHT, LEFT): [LEFT, LEFT],\n        (RIGHT, RIGHT): [],\n        (RIGHT, DOWN): [DOWN],\n        (RIGHT, UP): [UP]\n    }\n\n    # Convert target direction to action\n    target_direction = target_directions.get((x_dir, y_dir), None)\n\n    if target_direction is not None:\n        actions.extend(direction_map.get((current_direction, target_direction), []))\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T08:04:03.128252", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move to the position of the primitive\n            actions.extend(turn_and_move(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n    \n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n    \n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    current_direction = env._current_state.dir\n    target_directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]  # down, right, up, left\n    target_indices = {direction: index for index, direction in enumerate(target_directions)}\n    \n    current_index = int(current_direction / 90) % 4\n\n    if x_dir == 0 and y_dir == 0:\n        return []\n\n    target_index = target_indices[(x_dir, y_dir)]\n    delta = (target_index - current_index + 4) % 4\n    \n    actions = []\n    for _ in range(delta):\n        actions.append(RIGHT)\n\n    # Add the movement action\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-30T08:05:22.567826", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MAX_STEPS = 500\n\n  # Helper functions\n  def get_workshop_index(world):\n    return world.workshop_indices[0]\n\n  def find_closest_resource(world_state, resource_index):\n    grid_view = world_state.features_dict()['features_ego_large']\n    positions = np.argwhere(grid_view[:, :, resource_index] > 0)\n    if not positions.size:\n        return None\n    distances = np.linalg.norm(positions - np.array([3, 3]), axis=1)\n    closest_position = positions[np.argmin(distances)]\n    return tuple(closest_position)\n\n  def move_towards(world_state, target_pos):\n      current_pos = world_state.pos\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      actions = []\n      if dx > 0:\n          actions.extend([RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([LEFT] * abs(dx))\n      if dy > 0:\n          actions.extend([DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([UP] * abs(dy))\n      return actions\n\n  def use_tool_if_needed(world_state, resource_index):\n    inventory = world_state.inventory\n    tools = {env.world.stone_index: 'pickaxe', env.world.water_index: 'bucket'}\n    for res, tool in tools.items():\n        if resource_index == res and tool in inventory:\n            return [USE]\n    return []\n\n  def craft_item(world_state, workshop_index):\n      actions = move_towards(world_state, (3, 3)) + [USE]\n      return actions\n\n  # Main sequence of actions\n  actions_sequence = []\n\n  # Get the cookbook and required primitives for arrow\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index['arrow']\n  primitives_needed = cookbook.primitives_for(goal_index)\n\n  resources_collected = collections.defaultdict(int)\n  step_count = 0\n\n  while not all(count == collected for resource, count in primitives_needed.items()):\n      if step_count >= MAX_STEPS:\n          break\n      for resource, required_count in primitives_needed.items():\n          while resources_collected[resource] < required_count and step_count < MAX_STEPS:\n              target_pos = find_closest_resource(env._current_state, resource)\n              if not target_pos:\n                  actions_sequence.append(USE)  # Explore around to find the resource\n                  step_count += 1\n                  continue\n              \n              actions_sequence.extend(move_towards(env._current_state, target_pos))\n              actions_sequence.extend(use_tool_if_needed(env._current_state, resource))\n              actions_sequence.append(USE)\n              resources_collected[resource] += 1\n              step_count += len(actions_sequence) + 1\n\n  # Move to the workshop and craft arrow\n  workshop_index = get_workshop_index(env.world)\n  actions_sequence.extend(craft_item(env._current_state, workshop_index))\n\n  return actions_sequence", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:05:23.551567", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MAX_STEPS = 500\n\n  # Helper functions\n  def get_workshop_index(world):\n    \"\"\"Returns the index of the workshop from the world.\"\"\"\n    return world.workshop_indices[0]\n\n  def find_closest_resource(world_state, resource_index):\n    \"\"\"Finds the closest position of a given resource in the agent's view.\"\"\"\n    grid_view = world_state.features_dict()['features_ego_large']\n    positions = np.argwhere(grid_view[:, :, resource_index] > 0)\n    if not positions.size:\n        return None\n    distances = np.linalg.norm(positions - np.array([3, 3]), axis=1)\n    closest_position = positions[np.argmin(distances)]\n    return tuple(closest_position)\n\n  def move_towards(world_state, target_pos):\n      \"\"\"Generates actions to move the agent towards a target position.\"\"\"\n      current_pos = world_state.pos\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      actions = []\n      if dx > 0:\n          actions.extend([RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([LEFT] * abs(dx))\n      if dy > 0:\n          actions.extend([DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([UP] * abs(dy))\n      return actions\n\n  def use_tool_if_needed(world_state, resource_index):\n    \"\"\"Uses the appropriate tool if needed to collect a resource.\"\"\"\n    inventory = world_state.inventory\n    tools = {env.world.stone_index: 'pickaxe', env.world.water_index: 'bucket'}\n    required_tool = None\n    for res, tool in tools.items():\n        if resource_index == res and tool in inventory:\n            return [USE]\n    return []\n\n  def craft_item(world_state, workshop_index):\n    \"\"\"Moves the agent to the workshop and crafts an item.\"\"\"\n    actions = move_towards(world_state, (3, 3)) + [USE]\n    return actions\n\n  # Main sequence of actions\n  actions_sequence = []\n\n  # Get the cookbook and required primitives for arrow\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index['arrow']\n  primitives_needed = cookbook.primitives_for(goal_index)\n\n  resources_collected = collections.defaultdict(int)\n  step_count = 0\n\n  while not all(count == collected for resource, count in primitives_needed.items()):\n      if step_count >= MAX_STEPS:\n          break\n      for resource, count in primitives_needed.items():\n          if resources_collected[resource] < count:\n              target_pos = find_closest_resource(env._current_state, resource)\n              while not target_pos and step_count < MAX_STEPS:\n                  env.step(USE)  # Explore around to find the resource\n                  target_pos = find_closest_resource(env._current_state, resource)\n                  step_count += 1\n              if target_pos:\n                  actions_sequence.extend(move_towards(env._current_state, target_pos))\n                  actions_sequence.extend(use_tool_if_needed(env._current_state, resource))\n                  actions_sequence.append(USE)\n                  resources_collected[resource] += 1\n      step_count += len(actions_sequence)\n\n  # Move to the workshop and craft arrow\n  workshop_index = get_workshop_index(env.world)\n  actions_sequence.extend(craft_item(env._current_state, workshop_index))\n\n  return actions_sequence", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:07:42.915973", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                actions.extend(navigate_to(nearest_primitive_position))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        actions.extend(navigate_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def navigate_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current \n      position to the target position. It considers the agent's current facing direction.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to navigate the agent to the target position.\n    \"\"\"\n    # Compute the direction vector needed to move towards the target\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T08:07:43.963499", "function_name": "make_arrow", "function_body": "  def gather_and_craft(item_name):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        item_name: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[item_name]\n    \n    if goal_index is None:\n        raise ValueError(f\"Item '{item_name}' not found in the cookbook.\")\n\n    primitives_needed = env.world.cookbook.primitives_for(item_name)\n    \n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instance of '{primitive}' found on the grid.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_name = env.world.cookbook.recipes[item_name][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    if workshop_index is None:\n        raise ValueError(f\"No workshop found for '{item_name}' in the cookbook.\")\n\n    workshop_position = find_nearest_workshop(workshop_name, env._current_state.grid)\n\n    if workshop_position is None:\n        raise ValueError(f\"No instance of '{workshop_name}' found on the grid.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_name, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_name: The name of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Convert item_name to index\n    item_index = env.world.cookbook.index[item_name]\n    \n    if item_index is None:\n        raise ValueError(f\"Item '{item_name}' not found in the cookbook.\")\n\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_name, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_name: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_name name to index\n    if isinstance(workshop_name, str):\n        workshop_index = env.world.cookbook.index[workshop_name]\n    else:\n        workshop_index = workshop_name\n    \n    if workshop_index is None:\n        raise ValueError(f\"Workshop '{workshop_name}' not found in the cookbook.\")\n\n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  goal_item = \"arrow\"\n  \n  try:\n      # Generate actions to gather primitives and craft the item\n      actions = gather_and_craft(goal_item)\n  except ValueError as e:\n      print(e)\n      actions = []\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:14:03.580378", "function_name": "make_arrow", "function_body": "  # Retrieve the cookbook for recipes\n  cookbook = env.world.cookbook\n\n  # Get the index for 'arrow' from the cookbook index\n  arrow_index = cookbook.index['arrow']\n\n  # Determine primitives needed to make an arrow\n  required_primitives = cookbook.primitives_for(arrow_index)\n\n  # Plan actions based on current environment and inventory state\n  actions = []\n\n  def pick_up(primitive_index):\n    \"\"\"Helper function to create a sequence of actions to pick up the given primitive.\"\"\"\n    while env._current_state.inventory[primitive_index] == 0:\n      pos = np.array(env._current_state.pos)\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        if env.world.cookbook.index.get(primitive_index) == \\\n           env._current_state.grid[pos[0] + dx, pos[1] + dy].argmax():\n          actions.append(env.action_specs()[env.ACTIONS['LEFT'] if dx == -1 else \n                                      env.ACTIONS['RIGHT'] if dx == 1 else \n                                      env.ACTIONS['DOWN'] if dy == -1 else \n                                      env.ACTIONS['UP']])\n          actions.append(env.action_specs()[env.ACTIONS['USE']])\n          return\n\n  # Collect required primitives\n  for primitive, count in required_primitives.items():\n    while env._current_state.inventory[primitive] < count:\n      pick_up(primitive)\n\n  # Navigate to the appropriate workshop and craft the arrow\n  workshop_index = cookbook.recipes[arrow_index]['_at']\n  pos = np.array(env._current_state.pos)\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n    if env.world.workshop_indices[workshop_index] == \\\n       env._current_state.grid[pos[0] + dx, pos[1] + dy].argmax():\n      actions.append(env.action_specs()[env.ACTIONS['LEFT'] if dx == -1 else \n                                  env.ACTIONS['RIGHT'] if dx == 1 else \n                                  env.ACTIONS['DOWN'] if dy == -1 else \n                                  env.ACTIONS['UP']])\n      actions.append(env.action_specs()[env.ACTIONS['USE']])\n      break\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:14:04.567047", "function_name": "make_arrow", "function_body": "  # Constants\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  \n  # Directions as coordinate deltas\n  DIRECTIONS = [(0, 1), (0, -1), (-1, 0), (1, 0)]\n  \n  def go_to_position(state: craft.CraftState, target_pos: tuple[int, int]) -> list[int]:\n    \"\"\"Helper function to move the agent to a specific position.\"\"\"\n    actions = []\n    current_pos = state.pos\n    dir = state.dir\n    delta_x, delta_y = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    # Adjust direction and move horizontally\n    if delta_x < 0:\n      if dir == RIGHT: actions.append(LEFT); dir = LEFT; actions.append(DOWN)\n      elif dir == LEFT: pass\n      elif dir == UP: actions.append(RIGHT); dir = RIGHT; actions.append(DOWN)\n      else: actions.append(LEFT); dir = LEFT\n    elif delta_x > 0:\n      if dir == LEFT: actions.append(RIGHT); dir = RIGHT; actions.append(DOWN)\n      elif dir == RIGHT: pass\n      elif dir == UP: actions.append(LEFT); dir = LEFT; actions.append(DOWN)\n      else: actions.append(RIGHT); dir = RIGHT\n    \n    # Move vertically\n    if delta_y < 0:\n      for _ in range(abs(delta_y)):\n        actions.append(UP)\n    elif delta_y > 0:\n      for _ in range(abs(delta_y)):\n        actions.append(DOWN)\n\n    return actions\n\n  def collect_item(state: craft.CraftState, item_index: int) -> list[int]:\n    \"\"\"Helper function to collect an item of a specific index.\"\"\"\n    actions = []\n    grid = state.grid\n    pos = state.pos\n    \n    # Search for the item in the neighborhood\n    for i in range(-1, 2):\n        for j in range(-1, 2):\n            if grid[pos[0] + i, pos[1] + j, item_index] > 0:\n                actions.extend(go_to_position(state, (pos[0] + i, pos[1] + j)))\n                actions.append(USE)\n                return actions\n    \n    # If not found, move to a likely location and search there\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, item_index] > 0:\n                actions.extend(go_to_position(state, (x, y)))\n                actions.append(USE)\n                return actions\n    \n    # If the item is not found, raise an error or handle it appropriately\n    raise ValueError(f\"Item with index {item_index} not found in the environment.\")\n\n  def craft_item(state: craft.CraftState, goal_index: int) -> list[int]:\n      \"\"\"Helper function to craft an item given its index.\"\"\"\n      actions = []\n      world = state.world\n      \n      # Get the recipe for the goal item\n      recipe = world.cookbook.recipes[goal_index]\n      \n      # Collect all required primitives and intermediate items\n      for ingredient, count in recipe.items():\n          if ingredient == \"_key\":\n              continue  # Skip the workshop key\n          \n          # Move to the appropriate workshop\n          workshop_index = world.index.get(recipe[\"_at\"])\n          actions.extend(go_to_position(state, world.workshop_positions[workshop_index]))\n          \n          # Collect each required item\n          for _ in range(count):\n              actions.extend(collect_item(state, ingredient))\n      \n      # Use the workshop to craft the goal item\n      workshop_index = world.index.get(recipe[\"_at\"])\n      actions.extend(go_to_position(state, world.workshop_positions[workshop_index]))\n      actions.append(USE)\n      \n      return actions\n\n  # Main logic to make an arrow\n  world = env.world\n  scenario = env.scenario\n  state = scenario.init()\n  \n  # Get the index of 'arrow' from the cookbook\n  arrow_index = world.index.get(\"arrow\")\n  \n  # Craft the arrow using the helper functions\n  actions = craft_item(state, arrow_index)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:15:33.088569", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  def get_closest_resource(world_state, resource_index):\n    grid_view = world_state.features_dict()['features_ego_large']\n    positions = np.argwhere(grid_view[:, :, resource_index] > 0)\n    if not positions.size:\n        return None\n    distances = np.linalg.norm(positions - np.array([3, 3]), axis=1)\n    closest_position = positions[np.argmin(distances)]\n    return tuple(closest_position)\n\n  def move_towards(world_state, target_pos):\n      current_pos = world_state.pos\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      actions = []\n      if dy > 0:\n          actions.extend([DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([UP] * abs(dy))\n      if dx > 0:\n          actions.extend([RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([LEFT] * abs(dx))\n      return actions\n\n  def find_closest_workshop(world_state, workshop_indices):\n    grid_view = world_state.features_dict()['features_ego_large']\n    distances = []\n    for i in range(len(workshop_indices)):\n        pos = np.argwhere(grid_view[:, :, workshop_indices[i]] > 0)\n        if pos.size > 0:\n            distance = np.linalg.norm(pos[0] - np.array([3, 3]), axis=1)[0]\n            distances.append((distance, i))\n    return workshop_indices[min(distances, key=lambda x: x[0])[1]]\n\n  def collect_primitives(primitive_indices):\n      actions = []\n      for primitive_index in primitive_indices:\n          if env._current_state.inventory[primitive_index] < primitives_needed[primitive_index]:\n              # Find the closest position of the primitive\n              target_pos = get_closest_resource(env._current_state, primitive_index)\n              if target_pos:\n                  actions.extend(move_towards(env._current_state, target_pos))\n                  actions.append(USE)  # Collect the item\n      return actions\n\n  def craft_item(world_state, workshop_indices):\n    workshop_index = find_closest_workshop(world_state, workshop_indices)\n    actions = move_towards(world_state, (3, 3)) + [USE]\n    return actions\n\n  actions_sequence = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index['arrow']\n  primitives_needed = cookbook.primitives_for(goal_index)\n\n  # Collect all required primitives\n  actions_sequence.extend(collect_primitives(primitives_needed.keys()))\n\n  # Find and move to the nearest crafting workshop for 'arrow'\n  arrow_workshop_indices = [env.world.workshop_indices[i] for i in range(len(env.world.workshop_indices)) if cookbook.recipes[goal_index]['_at'] == cookbook.index.get(i)]\n\n  actions_sequence.extend(craft_item(env._current_state, arrow_workshop_indices))\n\n  return actions_sequence", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:15:34.058012", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  MAX_STEPS = 100\n\n  def get_closest_resource(world_state, resource_index):\n    grid_view = world_state.features_dict()['features_ego_large']\n    positions = np.argwhere(grid_view[:, :, resource_index] > 0)\n    if not positions.size:\n        return None\n    distances = np.linalg.norm(positions - np.array([3, 3]), axis=1)\n    closest_position = positions[np.argmin(distances)]\n    return tuple(closest_position)\n\n  def move_towards(world_state, target_pos):\n      current_pos = world_state.pos\n      dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n      actions = []\n      if dy > 0:\n          actions.extend([DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([UP] * abs(dy))\n      if dx > 0:\n          actions.extend([RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([LEFT] * abs(dx))\n      return actions\n\n  def find_workshop(world_state, workshop_indices):\n    current_pos = world_state.pos\n    min_distance = float('inf')\n    target_workshop_pos = None\n    \n    for workshop_index in workshop_indices:\n        pos = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n        if pos.size > 0:\n            distance = abs(pos[0][0] - current_pos[0]) + abs(pos[0][1] - current_pos[1])\n            if distance < min_distance:\n                min_distance = distance\n                target_workshop_pos = pos[0]\n                \n    if target_workshop_pos is not None:\n        return move_towards(world_state, (target_workshop_pos[1], target_workshop_pos[0]))\n    else:\n        raise ValueError(\"No workshop found in the environment.\")\n\n  def collect_primitives(primitive_indices):\n      actions = []\n      for primitive_index in primitive_indices:\n          if env._current_state.inventory[primitive_index] < primitives_needed[primitive_index]:\n              # Find the closest position of the primitive\n              target_pos = get_closest_resource(env._current_state, primitive_index)\n              if target_pos:\n                  actions.extend(move_towards(env._current_state, target_pos))\n                  actions.append(USE)  # Collect the item\n      return actions\n\n  def craft_item(world_state, workshop_indices):\n    actions = []\n    for workshop_index in workshop_indices:\n        pos = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n        if pos.size > 0:\n            actions.extend(move_towards(world_state, (pos[0][1], pos[0][0])))\n            actions.append(USE)  # Craft the item\n            break\n    return actions\n\n  actions_sequence = []\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index['arrow']\n  primitives_needed = cookbook.primitives_for(goal_index)\n  \n  # Collect all required primitives\n  actions_sequence.extend(collect_primitives(primitives_needed.keys()))\n  \n  # Find and move to the nearest crafting workshop for 'arrow'\n  arrow_workshop_indices = [env.world.workshop_indices[i] for i in range(len(env.world.workshop_indices)) if cookbook.recipes[goal_index]['_at'] == cookbook.index.get(i)]\n  \n  actions_sequence.extend(find_workshop(env._current_state, arrow_workshop_indices))\n  \n  # Craft the arrow\n  actions_sequence.append(USE)\n  \n  return actions_sequence", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-09-30T08:18:03.210642", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Determine which direction to move first based on current orientation\n    if env._current_state.direction == 0:  # Facing right\n        if y_dir < 0:\n            actions.append(DOWN)\n        elif y_dir > 0:\n            actions.append(UP)\n        else:\n            if x_dir < 0:\n                actions.append(LEFT)\n    elif env._current_state.direction == 1:  # Facing down\n        if x_dir < 0:\n            actions.append(LEFT)\n        elif x_dir > 0:\n            actions.append(RIGHT)\n        else:\n            if y_dir > 0:\n                actions.append(UP)\n    elif env._current_state.direction == 2:  # Facing left\n        if y_dir < 0:\n            actions.append(DOWN)\n        elif y_dir > 0:\n            actions.append(UP)\n        else:\n            if x_dir > 0:\n                actions.append(RIGHT)\n    elif env._current_state.direction == 3:  # Facing up\n        if x_dir < 0:\n            actions.append(LEFT)\n        elif x_dir > 0:\n            actions.append(RIGHT)\n        else:\n            if y_dir < 0:\n                actions.append(DOWN)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:18:04.205919", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                actions.extend(move_to(nearest_primitive_position))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        actions.extend(move_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def move_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current \n      position to the target position. It accounts for the agent's facing direction and \n      rotates if necessary.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the target position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    x_dir, y_dir = compute_direction(target_pos, current_pos)\n    \n    # Determine the direction needed to face and move in the correct direction\n    if x_dir < 0:\n        actions = [LEFT]\n    elif x_dir > 0:\n        actions = [RIGHT]\n    else:\n        actions = []\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:20:49.059427", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft a given item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    \n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n    \n    primitives_needed = env.world.cookbook.primitives_for(goal_item)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find and gather all instances of the primitive needed\n        actions.extend(gather_primitive(primitive, count))\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_item][\"_at\"], env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No workshop found to craft '{goal_item}'.\")\n    \n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def gather_primitive(primitive_name, count):\n    \"\"\"\n      This function gathers a specified number of instances of a primitive.\n      \n      Args:\n        primitive_name: The name of the primitive to be gathered.\n        count: The number of instances needed.\n\n      Returns:\n        List[int]: A list of actions to gather the required number of primitives.\n    \"\"\"\n    actions = []\n    \n    for _ in range(count):\n        # Find the nearest instance of the primitive\n        primitive_index = env.world.cookbook.index[primitive_name]\n        \n        if primitive_index is None:\n            raise ValueError(f\"Primitive '{primitive_name}' not found in the cookbook.\")\n        \n        nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n        \n        if nearest_primitive_position is None:\n            raise ValueError(f\"No instance of '{primitive_name}' found to gather.\")\n        \n        x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n        \n        # Move to the position of the primitive\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to gather the primitive\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T08:20:50.044511", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles multiple items if needed and ensures that the agent aligns its direction\n      before moving.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Align direction before moving\n            actions.extend(align_direction(x_dir, y_dir))\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Align direction before moving\n        actions.extend(align_direction(x_dir, y_dir))\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def align_direction(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to align the agent's direction with the \n      specified movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to align the agent's direction with the specified movement.\n    \"\"\"\n    actions = []\n\n    if x_dir == -1 and y_dir == 0:\n        # Align left\n        actions.append(LEFT)\n    elif x_dir == 1 and y_dir == 0:\n        # Align right\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir == -1:\n        # Align down\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir == 1:\n        # Align up\n        actions.append(UP)\n\n    return actions\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Move based on the direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.5}}
