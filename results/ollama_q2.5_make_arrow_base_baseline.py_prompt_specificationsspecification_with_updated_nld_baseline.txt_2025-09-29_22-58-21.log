{"timestamp": "2025-09-30T16:00:08.096043", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 2, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T16:00:09.131472", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def get_direction_to_target(target_pos, current_pos):\n    \"\"\"\n      Computes the direction vector needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def navigate_to_target(env, target_pos):\n    \"\"\"\n      Navigates the agent to a specified target position.\n\n      Args:\n        env: The environment instance.\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the target position.\n    \"\"\"\n    actions = []\n\n    current_pos = env._current_state.pos\n\n    while current_pos != target_pos:\n        x_dir, y_dir = get_direction_to_target(target_pos, current_pos)\n\n        # Turn the agent if necessary\n        if x_dir < 0:\n            actions.append(LEFT)\n        elif x_dir > 0:\n            actions.append(RIGHT)\n        elif y_dir < 0:\n            actions.append(DOWN)\n        elif y_dir > 0:\n            actions.append(UP)\n\n        # Move forward\n        actions.append(USE)\n\n        # Update the current position based on movement\n        current_pos = (current_pos[0] + x_dir, current_pos[1] + y_dir)\n\n    return actions\n\n  def gather_primitive(env, primitive_index):\n    \"\"\"\n      Gathers a required primitive item.\n\n      Args:\n        env: The environment instance.\n        primitive_index: The index of the primitive item to be gathered.\n\n      Returns:\n        List[int]: A list of actions to gather the specified primitive.\n    \"\"\"\n    # Find all positions of the primitive in the grid\n    primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n    if len(primitive_positions) == 0:\n        raise ValueError(f\"No instances of item with index {primitive_index} found.\")\n\n    # Find the nearest position to the current agent's position\n    agent_pos = env._current_state.pos\n    distances = np.linalg.norm(primitive_positions - agent_pos, axis=1)\n    nearest_position = tuple(primitive_positions[np.argmin(distances)])\n\n    # Navigate to the nearest position and gather the primitive\n    actions = navigate_to_target(env, nearest_position) + [USE]\n    \n    return actions\n\n  def find_workshop(env, workshop_type):\n    \"\"\"\n      Finds a workshop of a specified type.\n\n      Args:\n        env: The environment instance.\n        workshop_type: The name or index representing the type of workshop to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n\n    # Find all positions of the workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n        raise ValueError(f\"No instances of workshop with index {workshop_index} found.\")\n\n    # Find the nearest position to the current agent's position\n    agent_pos = env._current_state.pos\n    distances = np.linalg.norm(workshop_positions - agent_pos, axis=1)\n    nearest_position = tuple(workshop_positions[np.argmin(distances)])\n\n    return nearest_position\n\n  def craft_item(env, goal_index):\n    \"\"\"\n      Crafts an item using the gathered primitives.\n\n      Args:\n        env: The environment instance.\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to craft the specified item.\n    \"\"\"\n    # Find the workshop needed for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_workshop(env, workshop_type)\n\n    # Navigate to the workshop and use it to craft the item\n    actions = navigate_to_target(env, workshop_position) + [USE]\n    \n    return actions\n\n  def gather_and_craft_item(env, goal_index):\n    \"\"\"\n      Gathers all required primitives and crafts an item.\n\n      Args:\n        env: The environment instance.\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the specified item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            actions.extend(gather_primitive(env, primitive))\n\n    # Craft the item using gathered primitives\n    actions.extend(craft_item(env, goal_index))\n    \n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft_item(env, goal_index)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-30T16:06:24.990641", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(primitives_needed):\n    actions = []\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive)\n        \n        if not nearest_primitive_position:\n            continue\n        \n        actions.extend(navigate_to(nearest_primitive_position))\n        \n        # Gather the primitive\n        actions.append(USE)\n\n    return actions\n\n  def craft_at_workshop(workshop_name):\n      workshop_index = env.world.cookbook.index[workshop_name]\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n      \n      if not workshop_positions.size:\n          return []\n\n      nearest_workshop_position = tuple(workshop_positions[np.argmin(np.linalg.norm(workshop_positions - env._current_state.pos, axis=1))])\n      \n      actions = navigate_to(nearest_workshop_position)\n\n      # Craft the item at the workshop\n      actions.append(USE)\n      \n      return actions\n\n  def find_nearest_instance(item_index):\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n\n    distances = np.linalg.norm(positions - env._current_state.pos, axis=1)\n\n    nearest_position = tuple(positions[np.argmin(distances)])\n    return nearest_position\n\n  def navigate_to(target_pos):\n      actions = []\n      target_x, target_y = target_pos\n      current_x, current_y = env._current_state.pos\n      \n      while (current_x != target_x) or (current_y != target_y):\n          x_dir = np.sign(target_x - current_x)\n          y_dir = np.sign(target_y - current_y)\n\n          # Determine the action based on the direction needed to move in each axis\n          if x_dir == 1:\n              actions.append(RIGHT)\n          elif x_dir == -1:\n              actions.append(LEFT)\n          \n          if y_dir == 1:\n              actions.append(UP)\n          elif y_dir == -1:\n              actions.append(DOWN)\n\n          # Update the current position after moving\n          env._current_state.pos = (env._current_state.pos[0] + x_dir, env._current_state.pos[1] + y_dir)\n\n      return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  # Gather required primitives\n  actions = gather_and_craft(primitives_needed)\n\n  # Craft arrow at workshop\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  actions.extend(craft_at_workshop(workshop_type))\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T16:06:26.002657", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_positions = find_nearest_instances(primitive, env._current_state.grid)\n        \n        if not nearest_primitive_positions:\n            raise ValueError(f\"No instances of item index {primitive} found.\")\n\n        # Sort positions by distance to the agent\n        agent_position = env._current_state.pos\n        distances = np.array([np.linalg.norm(np.array(pos) - np.array(agent_position)) for pos in nearest_primitive_positions])\n        sorted_indices = np.argsort(distances)\n        nearest_primitive_positions = [nearest_primitive_positions[i] for i in sorted_indices]\n\n        # Gather all required primitives of this type\n        for _ in range(count):\n            if not nearest_primitive_positions:\n                raise ValueError(f\"Not enough instances of item index {primitive} found.\")\n            \n            nearest_primitive_position = nearest_primitive_positions.pop(0)\n            actions.extend(navigate_to(nearest_primitive_position, env._current_state))\n            \n            # Gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if not workshop_position:\n        raise ValueError(f\"No instances of workshop type {env.world.cookbook.recipes[goal_index]['_at']} found.\")\n\n    actions.extend(navigate_to(workshop_position, env._current_state))\n        \n    # Craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n\n    return positions\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0).tolist()\n\n    if not positions:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = [np.linalg.norm(np.array(pos) - np.array(agent_position)) for pos in positions]\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def navigate_to(target_pos, current_state):\n    actions = []\n    target_x, target_y = target_pos\n    current_x, current_y = current_state.pos\n    \n    while current_x != target_x or current_y != target_y:\n        x_dir = np.sign(target_x - current_x)\n        y_dir = np.sign(target_y - current_y)\n\n        # Determine the action based on the direction needed to move in each axis\n        if x_dir == 1:\n            actions.append(RIGHT)\n        elif x_dir == -1:\n            actions.append(LEFT)\n        \n        if y_dir == 1:\n            actions.append(UP)\n        elif y_dir == -1:\n            actions.append(DOWN)\n\n        # Update the current position after moving\n        current_x += x_dir\n        current_y += y_dir\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T16:09:05.892215", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n        if x_dir < 0:\n            actions.append(LEFT)\n            x_dir += 1\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            x_dir -= 1\n        elif y_dir < 0:\n            actions.append(DOWN)\n            y_dir += 1\n        elif y_dir > 0:\n            actions.append(UP)\n            y_dir -= 1\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T16:14:06.006011", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory[primitive] < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n        if x_dir < 0:\n            actions.append(LEFT)\n            x_dir += 1\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            x_dir -= 1\n        elif y_dir < 0:\n            actions.append(DOWN)\n            y_dir += 1\n        elif y_dir > 0:\n            actions.append(UP)\n            y_dir -= 1\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
