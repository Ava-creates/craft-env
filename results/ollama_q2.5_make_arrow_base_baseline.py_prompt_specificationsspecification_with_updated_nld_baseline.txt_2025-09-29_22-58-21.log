ions = move_to_and_face(x_dir, y_dir)\n    \n    # Craft the item using the USE action\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the current grid.\n      \n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the current grid.\n      \n      Args:\n        workshop_type: The name or index representing the type of workshop.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current \n      position to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current \n                         position towards the target position. Values are -1, 0, or 1 \n                         indicating the direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def move_to_and_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified \n      direction and ensure that it is facing correctly before performing any action.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction and face correctly.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = 0 if x_dir == 0 and y_dir > 0 else \\\n                       1 if x_dir > 0 and y_dir == 0 else \\\n                       2 if x_dir == 0 and y_dir < 0 else \\\n                       3 if x_dir < 0 and y_dir == 0 else None\n\n    actions = []\n\n    # Calculate the number of rotations needed to face the target direction\n    if current_direction is not None and target_direction is not None:\n        num_rotations = (target_direction - current_direction) % 4\n        for _ in range(num_rotations):\n            actions.append(USE)  # Assuming USE can also be used to rotate\n\n    # Move towards the target position\n    actions.extend(move_to(x_dir, y_dir))\n\n    return actions\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Main function logic\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  \n  # Gather all required primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Craft the item at the nearest available workshop\n  actions.extend(craft_item(workshop_type))\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:01:42.491565", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It accounts for multiple instances of the same primitive and ensures that \n      the agent does not move unnecessarily.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory[primitive] < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instance of item '{env.world.cookbook.names[primitive]}' found.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No instance of workshop '{workshop_type}' found.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index if necessary\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It accounts for diagonal movements and ensures that the agent moves efficiently.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Calculate the total distance in each direction\n    x_distance = abs(x_dir)\n    y_distance = abs(y_dir)\n\n    # Determine the primary and secondary directions based on which has a larger absolute value\n    if x_distance > y_distance:\n        primary_direction = (x_dir, 0)\n        secondary_direction = (0, y_dir)\n    else:\n        primary_direction = (0, y_dir)\n        secondary_direction = (x_dir, 0)\n\n    # Move in the primary direction first\n    while primary_direction[0] != 0 or primary_direction[1] != 0:\n        if primary_direction[0] < 0 and primary_direction[1] == 0:\n            actions.append(LEFT)\n        elif primary_direction[0] > 0 and primary_direction[1] == 0:\n            actions.append(RIGHT)\n        elif primary_direction[0] == 0 and primary_direction[1] < 0:\n            actions.append(DOWN)\n        elif primary_direction[0] == 0 and primary_direction[1] > 0:\n            actions.append(UP)\n\n        # Update the remaining distance in the primary direction\n        if primary_direction[0] != 0:\n            primary_direction = (primary_direction[0] - np.sign(primary_direction[0]), primary_direction[1])\n        elif primary_direction[1] != 0:\n            primary_direction = (primary_direction[0], primary_direction[1] - np.sign(primary_direction[1]))\n\n    # Then move in the secondary direction\n    while secondary_direction[0] != 0 or secondary_direction[1] != 0:\n        if secondary_direction[0] < 0 and secondary_direction[1] == 0:\n            actions.append(LEFT)\n        elif secondary_direction[0] > 0 and secondary_direction[1] == 0:\n            actions.append(RIGHT)\n        elif secondary_direction[0] == 0 and secondary_direction[1] < 0:\n            actions.append(DOWN)\n        elif secondary_direction[0] == 0 and secondary_direction[1] > 0:\n            actions.append(UP)\n\n        # Update the remaining distance in the secondary direction\n        if secondary_direction[0] != 0:\n            secondary_direction = (secondary_direction[0] - np.sign(secondary_direction[0]), secondary_direction[1])\n        elif secondary_direction[1] != 0:\n            secondary_direction = (secondary_direction[0], secondary_direction[1] - np.sign(secondary_direction[1]))\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:01:43.460439", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if not nearest_primitive_position:\n                raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if not workshop_position:\n        raise ValueError(f\"Workshop type '{workshop_type}' not found on the grid.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index if necessary\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Calculate the total distance in each direction\n    x_distance = abs(x_dir)\n    y_distance = abs(y_dir)\n\n    # Determine the primary and secondary directions based on which has a larger absolute value\n    if x_distance > y_distance:\n        primary_direction = (x_dir, 0)\n        secondary_direction = (0, y_dir)\n    else:\n        primary_direction = (0, y_dir)\n        secondary_direction = (x_dir, 0)\n\n    # Move in the primary direction first\n    while primary_direction[0] != 0 or primary_direction[1] != 0:\n        if primary_direction[0] < 0 and primary_direction[1] == 0:\n            actions.append(LEFT)\n        elif primary_direction[0] > 0 and primary_direction[1] == 0:\n            actions.append(RIGHT)\n        elif primary_direction[0] == 0 and primary_direction[1] < 0:\n            actions.append(DOWN)\n        elif primary_direction[0] == 0 and primary_direction[1] > 0:\n            actions.append(UP)\n\n        # Update the remaining distance in the primary direction\n        if primary_direction[0] != 0:\n            primary_direction = (primary_direction[0] - np.sign(primary_direction[0]), primary_direction[1])\n        elif primary_direction[1] != 0:\n            primary_direction = (primary_direction[0], primary_direction[1] - np.sign(primary_direction[1]))\n\n    # Then move in the secondary direction\n    while secondary_direction[0] != 0 or secondary_direction[1] != 0:\n        if secondary_direction[0] < 0 and secondary_direction[1] == 0:\n            actions.append(LEFT)\n        elif secondary_direction[0] > 0 and secondary_direction[1] == 0:\n            actions.append(RIGHT)\n        elif secondary_direction[0] == 0 and secondary_direction[1] < 0:\n            actions.append(DOWN)\n        elif secondary_direction[0] == 0 and secondary_direction[1] > 0:\n            actions.append(UP)\n\n        # Update the remaining distance in the secondary direction\n        if secondary_direction[0] != 0:\n            secondary_direction = (secondary_direction[0] - np.sign(secondary_direction[0]), secondary_direction[1])\n        elif secondary_direction[1] != 0:\n            secondary_direction = (secondary_direction[0], secondary_direction[1] - np.sign(secondary_direction[1]))\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:04:04.949648", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_item)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while not env._current_state.inventory.get(primitive, 0) >= count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Turn and move to the position of the primitive\n                actions.extend(turn_and_move(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_item][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Turn and move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:04:05.912453", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    \n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Turn and move to the position of the primitive\n                actions.extend(turn_and_move(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    \n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    workshop_position = find_nearest_instance(workshop_index, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Turn and move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T19:05:28.346832", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n    \n    for primitive, count in primitives_needed.items():\n        # Find the nearest instance of each required primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive and gather it\n            actions.extend(move_to(x_dir, y_dir))\n            actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop and craft the item\n        actions.extend(move_to(x_dir, y_dir))\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    \n    if not positions:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = [np.linalg.norm(np.array(pos) - agent_position) for pos in positions]\n    \n    nearest_position = min(positions, key=lambda p: np.linalg.norm(np.array(p) - agent_position))\n    return tuple(nearest_position)\n\n  def find_nearest_workshop(workshop_type, grid):\n    workshop_index = env.world.cookbook.index[workshop_type]\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0).tolist()\n    \n    if not positions:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = [np.linalg.norm(np.array(pos) - agent_position) for pos in positions]\n    \n    nearest_position = min(positions, key=lambda p: np.linalg.norm(np.array(p) - agent_position))\n    return tuple(nearest_position)\n\n  def compute_direction(target_pos, current_pos):\n    x_dir, y_dir = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    if x_dir < 0:\n        x_action = LEFT\n    elif x_dir > 0:\n        x_action = RIGHT\n    else:\n        x_action = None\n\n    if y_dir < 0:\n        y_action = DOWN\n    elif y_dir > 0:\n        y_action = UP\n    else:\n        y_action = None\n    \n    return x_action, y_action\n\n  def move_to(x_action, y_action):\n    actions = []\n\n    # Prioritize moving in the X direction if both directions are required\n    if x_action is not None and x_action != 0:\n        actions.append(x_action)\n    \n    if y_action is not None and y_action != 0:\n        actions.append(y_action)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T19:05:29.337124", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        # Find all instances of the required primitive\n        primitive_positions = find_all_instances(primitive, env._current_state.grid)\n        \n        if not primitive_positions:\n            raise ValueError(f\"No instances found for primitive: {primitive}\")\n\n        # Sort positions by distance to the current position\n        sorted_primitive_positions = sort_by_distance(primitive_positions, env._current_state.pos)\n\n        for pos in sorted_primitive_positions:\n            x_dir, y_dir = compute_direction(pos, env._current_state.pos)\n            \n            actions.extend(move_to(x_dir, y_dir))\n            actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if not workshop_position:\n        raise ValueError(f\"No workshops found of type: {workshop_type}\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    actions.extend(move_to(x_dir, y_dir))\n    actions.append(USE)\n\n    return actions\n\n  def find_all_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    return positions if positions else None\n\n  def sort_by_distance(positions, current_pos):\n    distances = [np.linalg.norm(np.array(pos) - np.array(current_pos)) for pos in positions]\n    sorted_positions = [pos for _, pos in sorted(zip(distances, positions))]\n    return sorted_positions\n\n  def find_nearest_workshop(workshop_type, grid):\n    workshop_index = env.world.cookbook.index[workshop_type]\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    # Handle edge case when the target and current positions are the same\n    if x_dir == 0 and y_dir == 0:\n        return (0, 0)\n    \n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:08:33.061303", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It ensures that the agent faces in the correct direction before moving towards\n      each primitive or workshop.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Rotate to face the correct direction before moving\n            actions.extend(rotate_to(x_dir, y_dir))\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(nearest_primitive_position))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Rotate to face the correct direction before moving\n        actions.extend(rotate_to(x_dir, y_dir))\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def rotate_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent to face the \n      specified direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent to face the correct direction.\n    \"\"\"\n    # Determine the current facing direction of the agent\n    current_direction = env._current_state.direction\n    \n    # Define mappings from current direction to action required for each target direction\n    rotation_mapping = {\n        (0, 1): {(-1, 0): [LEFT], (1, 0): [RIGHT]},   # Facing UP\n        (0, -1): {(1, 0): [LEFT], (-1, 0): [RIGHT]},  # Facing DOWN\n        (-1, 0): {(0, -1): [LEFT], (0, 1): [RIGHT]},  # Facing LEFT\n        (1, 0): {(0, 1): [LEFT], (0, -1): [RIGHT]}    # Facing RIGHT\n    }\n    \n    # Get the required actions to rotate from current direction to target direction\n    rotation_actions = rotation_mapping.get(current_direction, {}).get((x_dir, y_dir), [])\n    \n    return rotation_actions\n\n  def move_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the \n      specified target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the target position.\n    \"\"\"\n    actions = []\n    \n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n    \n    while current_x != target_x or current_y != target_y:\n        x_dir = np.sign(target_x - current_x)\n        y_dir = np.sign(target_y - current_y)\n\n        # Rotate to face the correct direction before moving\n        actions.extend(rotate_to(x_dir, y_dir))\n        \n        # Add movement action based on the direction needed\n        if x_dir == 1:\n            actions.append(RIGHT)\n        elif x_dir == -1:\n            actions.append(LEFT)\n        \n        if y_dir == 1:\n            actions.append(UP)\n        elif y_dir == -1:\n            actions.append(DOWN)\n\n        # Update the current position after moving\n        current_x += x_dir\n        current_y += y_dir\n\n    return actions\n\n  def optimize_path(actions):\n    \"\"\"\n      This function optimizes the path by removing redundant movements.\n      For example, moving LEFT then RIGHT or UP then DOWN can be removed.\n\n      Args:\n        actions: A list of actions to be optimized.\n\n      Returns:\n        List[int]: The optimized sequence of actions.\n    \"\"\"\n    actions_array = np.array(actions)\n    optimized_actions = []\n    \n    i = 0\n    while i < len(actions_array):\n        action = actions_array[i]\n        \n        if i + 1 < len(actions_array):\n            next_action = actions_array[i + 1]\n            \n            # Check for opposite movements and remove them\n            if (action == LEFT and next_action == RIGHT) or\\\n               (action == RIGHT and next_action == LEFT) or\\\n               (action == UP and next_action == DOWN) or\\\n               (action == DOWN and next_action == UP):\n                i += 2\n            else:\n                optimized_actions.append(action)\n                i += 1\n        else:\n            optimized_actions.append(action)\n            i += 1\n    \n    return optimized_actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  optimized_actions = optimize_path(actions)\n\n  return optimized_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:08:34.020388", "function_name": "make_arrow", "function_body": "  def navigate_to_position(target_pos):\n    \"\"\"\n      This function navigates the agent to a target position on the grid.\n      It computes the direction needed to move and generates actions accordingly.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the target position.\n    \"\"\"\n    x_dir, y_dir = compute_direction(target_pos, env._current_state.pos)\n    \n    # Generate actions based on direction\n    return move_to(x_dir, y_dir)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives for crafting an item and crafts it.\n      It optimizes the path to reduce redundant movements.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Navigate to the position of the primitive\n            actions.extend(navigate_to_position(nearest_primitive_position))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Navigate to the position of the workshop\n        actions.extend(navigate_to_position(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def optimize_path(actions):\n    \"\"\"\n      This function optimizes the path by removing redundant movements.\n      For example, moving LEFT then RIGHT or UP then DOWN can be removed.\n\n      Args:\n        actions: A list of actions to be optimized.\n\n      Returns:\n        List[int]: The optimized sequence of actions.\n    \"\"\"\n    # Convert actions to a numpy array for easier manipulation\n    actions_array = np.array(actions)\n    \n    # Create an empty list to store the optimized path\n    optimized_actions = []\n    \n    i = 0\n    while i < len(actions_array):\n        action = actions_array[i]\n        \n        if i + 1 < len(actions_array):\n            next_action = actions_array[i + 1]\n            \n            # Check for opposite movements and remove them\n            if (action == LEFT and next_action == RIGHT) or\\\n               (action == RIGHT and next_action == LEFT) or\\\n               (action == UP and next_action == DOWN) or\\\n               (action == DOWN and next_action == UP):\n                i += 2  # Skip the opposite movement\n            else:\n                optimized_actions.append(action)\n                i += 1\n        else:\n            optimized_actions.append(action)\n            i += 1\n    \n    return optimized_actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  # Optimize the generated path\n  optimized_actions = optimize_path(actions)\n\n  return optimized_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:12:01.994787", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                target_direction = compute_direction(nearest_primitive_position, env._current_state.pos)\n                actions.extend(turn_to_face(target_direction))\n\n                # Move to the position of the primitive\n                actions.extend(move_towards(nearest_primitive_position[0], nearest_primitive_position[1]))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        target_direction = compute_direction(workshop_position, env._current_state.pos)\n        actions.extend(turn_to_face(target_direction))\n\n        # Move to the position of the workshop\n        actions.extend(move_towards(workshop_position[0], workshop_position[1]))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return (x_dir, y_dir)\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified \n      (x, y) position. It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos[0] != target_x or current_pos[1] != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), current_pos)\n        \n        # Move in the x-direction if needed\n        if x_dir < 0 and current_pos[1] == target_y:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0 and current_pos[1] == target_y:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0 and current_pos[0] == target_x:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0 and current_pos[0] == target_x:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(target_direction):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target direction. It assumes that the environment has a way to \n      determine and change the agent's current facing direction.\n\n      Args:\n        target_direction: A tuple representing the (x, y) direction vector needed to move from the \n                          current position towards the target position.\n\n      Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the \n                   specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    x_dir, y_dir = target_direction\n\n    # Mapping from (current_direction, target_direction) to actions\n    direction_map = {\n        ((0, 1), (-1, 0)): [LEFT],          # From UP to LEFT\n        ((0, 1), (0, -1)): [DOWN],         # From UP to DOWN\n        ((0, 1), (1, 0)): [RIGHT],         # From UP to RIGHT\n        ((-1, 0), (0, 1)): [UP, RIGHT],    # From LEFT to UP\n        ((-1, 0), (0, -1)): [DOWN, RIGHT],   # From LEFT to DOWN\n        ((-1, 0), (1, 0)): [RIGHT],         # From LEFT to RIGHT\n        ((0, -1), (-1, 0)): [LEFT],          # From DOWN to LEFT\n        ((0, -1), (0, 1)): [UP],            # From DOWN to UP\n        ((0, -1), (1, 0)): [RIGHT, UP],     # From DOWN to RIGHT\n        ((1, 0), (-1, 0)): [LEFT],          # From RIGHT to LEFT\n        ((1, 0), (0, 1)): [UP, LEFT],      # From RIGHT to UP\n        ((1, 0), (0, -1)): [DOWN, LEFT],     # From RIGHT to DOWN\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T19:12:02.961935", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n                # Turn towards the target direction\n                actions.extend(turn_to_face(x_dir, y_dir))\n\n                # Move to the position of the primitive and face it\n                actions.extend(move_towards(nearest_primitive_position[0], nearest_primitive_position[1]))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Turn towards the target direction\n        actions.extend(turn_to_face(x_dir, y_dir))\n\n        # Move to the position of the workshop and face it\n        actions.extend(move_towards(workshop_position[0], workshop_position[1]))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified \n      (x, y) position. It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos[0] != target_x or current_pos[1] != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), current_pos)\n        \n        # Turn towards the target direction\n        actions.extend(turn_to_face(x_dir, y_dir))\n\n        # Move in the x-direction if needed\n        if x_dir < 0 and current_pos[1] == target_y:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0 and current_pos[1] == target_y:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0 and current_pos[0] == target_x:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0 and current_pos[0] == target_x:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target direction. It assumes that the environment has a way to \n      determine and change the agent's current facing direction.\n\n      Args:\n        x_dir: The desired x direction (-1, 0, or 1).\n        y_dir: The desired y direction (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the \n                   specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = (x_dir, y_dir)\n\n    # Mapping from (current_direction, target_direction) to actions\n    direction_map = {\n        ((0, 1), (-1, 0)): [LEFT],          # From UP to LEFT\n        ((0, 1), (0, -1)): [DOWN],         # From UP to DOWN\n        ((0, 1), (1, 0)): [RIGHT],         # From UP to RIGHT\n        ((-1, 0), (0, 1)): [UP],            # From LEFT to UP\n        ((-1, 0), (0, -1)): [DOWN],         # From LEFT to DOWN\n        ((-1, 0), (1, 0)): [RIGHT],          # From LEFT to RIGHT\n        ((0, -1), (-1, 0)): [LEFT],          # From DOWN to LEFT\n        ((0, -1), (0, 1)): [UP],            # From DOWN to UP\n        ((0, -1), (1, 0)): [RIGHT],         # From DOWN to RIGHT\n        ((1, 0), (-1, 0)): [LEFT],          # From RIGHT to LEFT\n        ((1, 0), (0, 1)): [UP],            # From RIGHT to UP\n        ((1, 0), (0, -1)): [DOWN],         # From RIGHT to DOWN\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T19:15:09.567667", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n      while env._current_state.inventory[primitive] < count:\n        primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        if not primitive_position:\n          raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n        \n        # Compute direction to move towards the primitive\n        x_dir, y_dir = compute_direction(primitive_position, env._current_state.pos)\n\n        # Move to the position of the primitive\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to gather the primitive\n        actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if not workshop_position:\n      raise ValueError(f\"Workshop '{workshop_type}' not found on the grid.\")\n    \n    # Compute direction to move towards the workshop\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n  \n    return actions\n\n  def find_nearest_instance(item_index_or_name, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index_or_name: The index or name of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    if isinstance(item_index_or_name, str):\n      # Convert item name to index\n      item_index = env.world.cookbook.index[item_index_or_name]\n    else:\n      item_index = item_index_or_name\n\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type_name, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type_name: The name representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    \n    # Convert workshop_type name to index\n    workshop_index = env.world.cookbook.index[workshop_type_name]\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Calculate the total distance in each direction\n    x_distance = abs(x_dir)\n    y_distance = abs(y_dir)\n\n    # Determine the primary and secondary directions based on which has a larger absolute value\n    if x_distance > y_distance:\n        primary_direction = (x_dir, 0)\n        secondary_direction = (0, y_dir)\n    else:\n        primary_direction = (0, y_dir)\n        secondary_direction = (x_dir, 0)\n\n    # Move in the primary direction first\n    while primary_direction[0] != 0 or primary_direction[1] != 0:\n      if primary_direction[0] < 0 and primary_direction[1] == 0:\n        actions.append(LEFT)\n      elif primary_direction[0] > 0 and primary_direction[1] == 0:\n        actions.append(RIGHT)\n      elif primary_direction[0] == 0 and primary_direction[1] < 0:\n        actions.append(DOWN)\n      elif primary_direction[0] == 0 and primary_direction[1] > 0:\n        actions.append(UP)\n\n      # Update the remaining distance in the primary direction\n      if primary_direction[0] != 0:\n        primary_direction = (primary_direction[0] - np.sign(primary_direction[0]), primary_direction[1])\n      elif primary_direction[1] != 0:\n        primary_direction = (primary_direction[0], primary_direction[1] - np.sign(primary_direction[1]))\n\n    # Then move in the secondary direction\n    while secondary_direction[0] != 0 or secondary_direction[1] != 0:\n      if secondary_direction[0] < 0 and secondary_direction[1] == 0:\n        actions.append(LEFT)\n      elif secondary_direction[0] > 0 and secondary_direction[1] == 0:\n        actions.append(RIGHT)\n      elif secondary_direction[0] == 0 and secondary_direction[1] < 0:\n        actions.append(DOWN)\n      elif secondary_direction[0] == 0 and secondary_direction[1] > 0:\n        actions.append(UP)\n\n      # Update the remaining distance in the secondary direction\n      if secondary_direction[0] != 0:\n        secondary_direction = (secondary_direction[0] - np.sign(secondary_direction[0]), secondary_direction[1])\n      elif secondary_direction[1] != 0:\n        secondary_direction = (secondary_direction[0], secondary_direction[1] - np.sign(secondary_direction[1]))\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:15:10.528546", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitive_indices):\n    \"\"\"\n      This function gathers the required primitives for crafting an item.\n      \n      Args:\n        primitive_indices: A dictionary with keys as item names and values as their indices.\n\n      Returns:\n        List[int]: A list of actions to gather all required primitives.\n    \"\"\"\n    actions = []\n    for primitive_name, primitive_index in primitive_indices.items():\n        # Find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      \n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if len(positions) == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the environment's grid.\n      \n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index if necessary\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(positions) == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      \n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Calculate the total distance in each direction\n    x_distance = abs(x_dir)\n    y_distance = abs(y_dir)\n\n    # Determine the primary and secondary directions based on which has a larger absolute value\n    if x_distance > y_distance:\n        primary_direction = (x_dir, 0)\n        secondary_direction = (0, y_dir)\n    else:\n        primary_direction = (0, y_dir)\n        secondary_direction = (x_dir, 0)\n\n    # Move in the primary direction first\n    while primary_direction[0] != 0 or primary_direction[1] != 0:\n        if primary_direction[0] < 0 and primary_direction[1] == 0:\n            actions.append(LEFT)\n        elif primary_direction[0] > 0 and primary_direction[1] == 0:\n            actions.append(RIGHT)\n        elif primary_direction[0] == 0 and primary_direction[1] < 0:\n            actions.append(DOWN)\n        elif primary_direction[0] == 0 and primary_direction[1] > 0:\n            actions.append(UP)\n\n        # Update the remaining distance in the primary direction\n        if primary_direction[0] != 0:\n            primary_direction = (primary_direction[0] - np.sign(primary_direction[0]), primary_direction[1])\n        elif primary_direction[1] != 0:\n            primary_direction = (primary_direction[0], primary_direction[1] - np.sign(primary_direction[1]))\n\n    # Then move in the secondary direction\n    while secondary_direction[0] != 0 or secondary_direction[1] != 0:\n        if secondary_direction[0] < 0 and secondary_direction[1] == 0:\n            actions.append(LEFT)\n        elif secondary_direction[0] > 0 and secondary_direction[1] == 0:\n            actions.append(RIGHT)\n        elif secondary_direction[0] == 0 and secondary_direction[1] < 0:\n            actions.append(DOWN)\n        elif secondary_direction[0] == 0 and secondary_direction[1] > 0:\n            actions.append(UP)\n\n        # Update the remaining distance in the secondary direction\n        if secondary_direction[0] != 0:\n            secondary_direction = (secondary_direction[0] - np.sign(secondary_direction[0]), secondary_direction[1])\n        elif secondary_direction[1] != 0:\n            secondary_direction = (secondary_direction[0], secondary_direction[1] - np.sign(secondary_direction[1]))\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n\n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  primitive_indices = {item: env.world.cookbook.index[item] for item in primitives_needed}\n\n  # Generate actions to gather all required primitives\n  actions = gather_primitives(primitive_indices)\n\n  # Find the nearest workshop for crafting the item\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_position = find_nearest_workshop(workshop_type)\n  \n  if workshop_position:\n      x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n      # Move to the position of the workshop\n      actions.extend(move_to(x_dir, y_dir))\n      \n      # Use action to craft the item at the workshop\n      actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:17:08.611529", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitive_indices):\n      \"\"\"\n      This function gathers all required primitives from the environment.\n\n      Args:\n        primitive_indices: A dictionary where keys are primitive indices and values are their counts.\n\n      Returns:\n        List[int]: A list of actions to gather the primitives.\n      \"\"\"\n      actions = []\n\n      # Gather each required primitive\n      for primitive_index, count in primitive_indices.items():\n          while count > 0:\n              nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n              \n              if nearest_primitive_position is None:\n                  raise ValueError(f\"No instance of primitive {primitive_index} found.\")\n              \n              x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n              \n              # Move to the position of the primitive\n              actions.extend(move_to(x_dir, y_dir))\n              \n              # Use action to gather the primitive\n              actions.append(USE)\n\n              count -= 1\n\n      return actions\n\n  def craft_item(workshop_index):\n      \"\"\"\n      This function crafts an item at a workshop.\n\n      Args:\n        workshop_index: The index of the workshop where the item should be crafted.\n\n      Returns:\n        List[int]: A list of actions to move to and use the workshop.\n      \"\"\"\n      nearest_workshop_position = find_nearest_workshop(workshop_index, env._current_state.grid)\n      \n      if nearest_workshop_position is None:\n          raise ValueError(f\"No instance of workshop {workshop_index} found.\")\n      \n      x_dir, y_dir = compute_direction(nearest_workshop_position, env._current_state.pos)\n      \n      # Move to the position of the workshop\n      actions.extend(move_to(x_dir, y_dir))\n      \n      # Use action to craft the item at the workshop\n      actions.append(USE)\n\n      return actions\n\n  def find_nearest_instance(item_index, grid):\n      \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n      \"\"\"\n      # Get positions of all cells containing the item\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n\n      if positions.size == 0:\n          return None\n\n      # Compute distances from the agent's current position to each cell with the item\n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      \n      # Find the index of the closest position\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n      \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n      \"\"\"\n      # Convert workshop_type name to index\n      if isinstance(workshop_type, str):\n          workshop_index = env.world.cookbook.index[workshop_type]\n      else:\n          workshop_index = workshop_type\n      \n      # Get positions of all cells containing the workshop type\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n      if positions.size == 0:\n          return None\n\n      # Compute distances from the agent's current position to each cell with the workshop\n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      \n      # Find the index of the closest position\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n      \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n      \"\"\"\n      x_dir = np.sign(target_pos[0] - current_pos[0])\n      y_dir = np.sign(target_pos[1] - current_pos[1])\n\n      return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n      \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n      \"\"\"\n      actions = []\n\n      # Move vertically if needed\n      if y_dir < 0:\n          actions.append(DOWN)\n      elif y_dir > 0:\n          actions.append(UP)\n\n      # Move horizontally if needed\n      if x_dir < 0:\n          actions.append(LEFT)\n      elif x_dir > 0:\n          actions.append(RIGHT)\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Fetch required primitives for the goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  # Initialize action sequence\n  actions = []\n\n  # Gather each required primitive\n  gather_actions = gather_primitives(primitives_needed)\n  actions.extend(gather_actions)\n\n  # Find the nearest workshop for crafting the item\n  workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n  \n  if workshop_position is None:\n      raise ValueError(f\"No instance of workshop {env.world.cookbook.recipes[goal_index]['_at']} found.\")\n\n  # Craft the item at the nearest workshop\n  craft_actions = craft_item(workshop_position)\n  actions.extend(craft_actions)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:17:09.569634", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_closest_item(item_type):\n    current_pos = env._current_state.pos\n    grid = env._current_state.grid\n    \n    item_index = env.world.cookbook.index[item_type]\n    \n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    # Compute distances from the agent's current position to each cell with the item\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n    \n    # Find the index of the closest position\n    nearest_idx = np.argmin(distances)\n\n    return tuple(positions[nearest_idx])\n\n  def find_closest_workshop(workshop_type):\n    current_pos = env._current_state.pos\n    grid = env._current_state.grid\n    \n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n\n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    # Compute distances from the agent's current position to each cell with the workshop\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n\n    nearest_idx = np.argmin(distances)\n\n    return tuple(positions[nearest_idx])\n\n  def navigate_to(pos):\n    actions = []\n    \n    while env._current_state.pos != pos:\n        dx = pos[0] - env._current_state.pos[0]\n        dy = pos[1] - env._current_state.pos[1]\n\n        if dx < 0:\n            actions.append(LEFT)\n        elif dx > 0:\n            actions.append(RIGHT)\n\n        if dy < 0:\n            actions.append(DOWN)\n        elif dy > 0:\n            actions.append(UP)\n\n        # Execute the action\n        env.step(actions[-1])\n    \n    return actions\n\n  def gather_primitives():\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n    \n    for primitive, count in primitives_needed.items():\n        closest_primitive_pos = find_closest_item(primitive)\n        \n        if closest_primitive_pos:\n            # Navigate to the primitive\n            actions.extend(navigate_to(closest_primitive_pos))\n            \n            # Gather the primitive\n            actions.append(USE)\n\n    return actions\n\n  def craft_item(workshop_type):\n      closest_workshop_pos = find_closest_workshop(workshop_type)\n      \n      if closest_workshop_pos:\n          # Navigate to the workshop\n          actions.extend(navigate_to(closest_workshop_pos))\n          \n          # Craft the item\n          actions.append(USE)\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = []\n\n  # Gather required primitives\n  actions.extend(gather_primitives())\n\n  # Craft the item at the nearest workshop\n  craft_workshop = env.world.cookbook.recipes[goal_index][\"_at\"]\n  craft_item(craft_workshop)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:19:50.926622", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      Finds the nearest instance of an item in the grid.\n      \n      Args:\n          item_index (int): The index of the item to be found.\n          grid (numpy.ndarray): The current state of the grid world.\n\n      Returns:\n          Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                           If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      Finds the nearest workshop of a given type in the grid.\n      \n      Args:\n          workshop_type (str or int): The name or index representing the type of workshop to be found.\n          grid (numpy.ndarray): The current state of the grid world.\n\n      Returns:\n          Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                           If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      Computes the direction (x, y) needed to move from the current position \n      to the target position.\n      \n      Args:\n          target_pos (Tuple[int, int]): The (x, y) coordinates of the target position.\n\n      Returns:\n          Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                           towards the target position. Values are -1, 0, or 1 indicating the \n                           direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def turn_to_face(x_dir, y_dir):\n    \"\"\"\n      Generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target direction.\n      \n      Args:\n          x_dir (int): The desired change in x position (-1, 0, or 1).\n          y_dir (int): The desired change in y position (-1, 0, or 1).\n\n      Returns:\n          List[int]: A list of actions to rotate the agent's facing direction towards \n                     the specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = np.argmax([x_dir, y_dir])  # Assuming directions are in order: UP, DOWN, LEFT, RIGHT\n\n    # Mapping from (current_direction, target_direction) to actions\n    direction_map = {\n        (0, 1): [DOWN],         # From UP to DOWN\n        (0, 2): [LEFT],          # From UP to LEFT\n        (0, 3): [RIGHT],         # From UP to RIGHT\n        (1, 0): [UP],            # From DOWN to UP\n        (1, 2): [LEFT],          # From DOWN to LEFT\n        (1, 3): [RIGHT],         # From DOWN to RIGHT\n        (2, 0): [UP, RIGHT],     # From LEFT to UP\n        (2, 1): [DOWN, RIGHT],   # From LEFT to DOWN\n        (2, 3): [RIGHT],         # From LEFT to RIGHT\n        (3, 0): [UP, LEFT],      # From RIGHT to UP\n        (3, 1): [DOWN, LEFT],    # From RIGHT to DOWN\n        (3, 2): [LEFT],          # From RIGHT to LEFT\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  def move_to(target_pos):\n    \"\"\"\n      Generates a sequence of actions to move the agent towards the specified target position.\n      \n      Args:\n          target_pos (Tuple[int, int]): The (x, y) coordinates of the target position.\n\n      Returns:\n          List[int]: A list of actions to move the agent towards the specified target position.\n    \"\"\"\n    x_dir, y_dir = compute_direction(target_pos)\n    \n    # Turn to face the correct direction\n    actions = turn_to_face(x_dir, y_dir)\n\n    # Add movement action\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      Gathers the required primitives to craft an item and crafts it.\n      \n      Args:\n          goal_index (int): The index of the item to be crafted.\n\n      Returns:\n          List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                # Move to the position of the primitive\n                actions.extend(move_to(nearest_primitive_position))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T19:19:51.894659", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index: int, grid: np.ndarray) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds the nearest instance of an item in the given grid.\n    \n    Args:\n        item_index (int): The index of the item to be found.\n        grid (np.ndarray): A 3D numpy array representing the current state of the grid world.\n        \n    Returns:\n        Optional[Tuple[int, int]]: The (x, y) coordinates of the nearest instance of the item. \n                                   If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type: Union[str, int], grid: np.ndarray) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds the nearest workshop of a given type in the provided grid.\n    \n    Args:\n        workshop_type (Union[str, int]): The name or index representing the type of workshop to be found.\n        grid (np.ndarray): A 3D numpy array representing the current state of the grid world.\n        \n    Returns:\n        Optional[Tuple[int, int]]: The (x, y) coordinates of the nearest workshop of the specified type. \n                                   If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos: Tuple[int, int]) -> Tuple[int, int]:\n    \"\"\"\n    Computes the direction (x, y) needed to move from the current position to the target position.\n    \n    Args:\n        target_pos (Tuple[int, int]): The (x, y) coordinates of the target position.\n        \n    Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def turn_to_face(x_dir: int, y_dir: int) -> List[int]:\n    \"\"\"\n    Generates a sequence of actions to rotate the agent's facing direction towards the specified target direction.\n    \n    Args:\n        x_dir (int): The desired change in x position (-1, 0, or 1).\n        y_dir (int): The desired change in y position (-1, 0, or 1).\n        \n    Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = np.argmax([x_dir, y_dir])  # Assuming directions are in order: UP, DOWN, LEFT, RIGHT\n\n    direction_map = {\n        (0, 1): [DOWN],         # From UP to DOWN\n        (0, 2): [LEFT],          # From UP to LEFT\n        (0, 3): [RIGHT],         # From UP to RIGHT\n        (1, 0): [UP],            # From DOWN to UP\n        (1, 2): [LEFT],          # From DOWN to LEFT\n        (1, 3): [RIGHT],         # From DOWN to RIGHT\n        (2, 0): [UP, RIGHT],     # From LEFT to UP\n        (2, 1): [DOWN, RIGHT],   # From LEFT to DOWN\n        (2, 3): [RIGHT],         # From LEFT to RIGHT\n        (3, 0): [UP, LEFT],      # From RIGHT to UP\n        (3, 1): [DOWN, LEFT],    # From RIGHT to DOWN\n        (3, 2): [LEFT],          # From RIGHT to LEFT\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  def move_to(target_pos: Tuple[int, int]) -> List[int]:\n    \"\"\"\n    Generates a sequence of actions to move the agent to the specified target position.\n    \n    Args:\n        target_pos (Tuple[int, int]): The (x, y) coordinates of the target position.\n        \n    Returns:\n        List[int]: A list of actions to move the agent to the specified target position.\n    \"\"\"\n    actions = []\n    \n    x_dir, y_dir = compute_direction(target_pos)\n    \n    # Turn to face the correct direction\n    actions.extend(turn_to_face(x_dir, y_dir))\n    \n    # Move in the direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def gather_and_craft(goal_index: int) -> List[int]:\n    \"\"\"\n    Gathers the required primitives to craft an item and crafts it.\n    \n    Args:\n        goal_index (int): The index of the item to be crafted.\n        \n    Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                # Move to the position of the primitive\n                actions.extend(move_to(nearest_primitive_position))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:21:47.500168", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    while (x_dir != 0 or y_dir != 0):\n        if x_dir < 0:\n            actions.append(LEFT)\n            x_dir += 1\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            x_dir -= 1\n\n        if y_dir < 0:\n            actions.append(DOWN)\n            y_dir += 1\n        elif y_dir > 0:\n            actions.append(UP)\n            y_dir -= 1\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n\n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T19:21:48.478245", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_position(item_indices, grid):\n    \"\"\"\n      This function finds the nearest instance of any item from a given list of indices in the provided grid.\n      It searches for all items and returns the position of the closest one.\n\n      Args:\n        item_indices: A list of indices representing the types of items to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of any specified type. \n                         If no such item is found, returns None.\n    \"\"\"\n    positions = []\n\n    for index in item_indices:\n        # Get positions of all cells containing the item\n        pos = np.argwhere(grid[:, :, index] > 0)\n        \n        if pos.size > 0:\n            positions.extend(pos)\n\n    if not positions:\n        return None\n\n    # Convert list to numpy array for distance computation\n    positions = np.array(positions)\n\n    # Compute distances from the agent's current position to each cell with any of the items\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find nearest instances of the primitive\n        positions = find_nearest_position([primitive], env._current_state.grid)\n\n        if not positions:\n            raise ValueError(f\"No instance of item with index {primitive} found.\")\n\n        # Move to and gather each required instance of the primitive\n        for _ in range(count):\n            x_dir, y_dir = compute_direction(positions, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if not workshop_position:\n        raise ValueError(f\"No instance of workshop '{env.world.cookbook.recipes[goal_index]['_at']}' found.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:24:15.672079", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n      \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n      \"\"\"\n      # Fetch required primitives for the goal\n      goal_index = env.world.cookbook.index[goal_item]\n      \n      if goal_index is None:\n          raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n      \n      primitives_needed = env.world.cookbook.primitives_for(goal_item)\n      \n      # Initialize action sequence\n      actions = []\n\n      # Gather each required primitive\n      for primitive, count in primitives_needed.items():\n          primitive_index = env.world.cookbook.index[primitive]\n          \n          if primitive_index is None:\n              raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n          \n          while env._current_state.inventory.get(primitive_index, 0) < count:\n              nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n              \n              if nearest_primitive_position is None:\n                  raise RuntimeError(f\"No instances of '{primitive}' found on the grid.\")\n\n              x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n              \n              # Move to the position of the primitive\n              actions.extend(move_to(x_dir, y_dir))\n              \n              # Use action to gather the primitive\n              actions.append(USE)\n\n      # Find the nearest workshop for crafting the item\n      workshop_type = env.world.cookbook.recipes[goal_item][\"_at\"]\n      workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n      \n      if workshop_position is None:\n          raise RuntimeError(f\"No instances of '{workshop_type}' found on the grid.\")\n\n      x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n      \n      # Move to the position of the workshop\n      actions.extend(move_to(x_dir, y_dir))\n      \n      # Use action to craft the item at the workshop\n      actions.append(USE)\n\n      return actions\n\n  def find_nearest_instance(item_index, grid):\n      \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n      \"\"\"\n      # Get positions of all cells containing the item\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n\n      if positions.size == 0:\n          return None\n\n      # Compute distances from the agent's current position to each cell with the item\n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      \n      # Find the index of the closest position\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n      \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n      \"\"\"\n      # Convert workshop_type name to index\n      if isinstance(workshop_type, str):\n          workshop_index = env.world.cookbook.index[workshop_type]\n      else:\n          workshop_index = workshop_type\n      \n      # Get positions of all cells containing the workshop type\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n      if positions.size == 0:\n          return None\n\n      # Compute distances from the agent's current position to each cell with the workshop\n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      \n      # Find the index of the closest position\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n      \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n      \"\"\"\n      x_dir = np.sign(target_pos[0] - current_pos[0])\n      y_dir = np.sign(target_pos[1] - current_pos[1])\n\n      return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n      \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n      \"\"\"\n      actions = []\n\n      if x_dir < 0 and y_dir == 0:\n          actions.append(LEFT)\n      elif x_dir > 0 and y_dir == 0:\n          actions.append(RIGHT)\n      elif x_dir == 0 and y_dir < 0:\n          actions.append(DOWN)\n      elif x_dir == 0 and y_dir > 0:\n          actions.append(UP)\n\n      # Add a USE action to confirm the movement (assuming it's needed in the environment)\n      # actions.append(USE)\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:24:16.674915", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def get_directional_action(x_dir, y_dir):\n    \"\"\"\n      This function returns the action corresponding to a given direction vector.\n      \n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        int: The action required to move in the specified direction.\n    \"\"\"\n    if x_dir < 0 and y_dir == 0:\n        return LEFT\n    elif x_dir > 0 and y_dir == 0:\n        return RIGHT\n    elif x_dir == 0 and y_dir < 0:\n        return DOWN\n    elif x_dir == 0 and y_dir > 0:\n        return UP\n\n  def get_movement_sequence(target_pos, current_pos):\n    \"\"\"\n      This function computes the sequence of actions needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        List[int]: The list of actions required to move from the current position to the target position.\n    \"\"\"\n    x_dir, y_dir = compute_direction(target_pos, current_pos)\n    return [get_directional_action(x_dir, y_dir)]\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      \n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            movements = get_movement_sequence(nearest_primitive_position, env._current_state.pos)\n            actions.extend(movements)\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        movements = get_movement_sequence(workshop_position, env._current_state.pos)\n        actions.extend(movements)\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      \n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      \n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n\n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-30T19:26:59.074382", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(turn_and_move(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It adjusts the agent's facing direction if necessary before moving.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    current_direction = env._current_state.dir\n    target_direction = np.argmax([x_dir == -1, x_dir == 1, y_dir == -1, y_dir == 1])\n\n    # Define the mapping from current and target directions to rotation actions\n    rotations = {\n        (0, 1): [RIGHT],         # Facing down, turn right to face right\n        (0, 2): [LEFT, LEFT],   # Facing down, turn left twice to face up\n        (0, 3): [LEFT],           # Facing down, turn left to face left\n        (1, 0): [RIGHT, RIGHT], # Facing right, turn right twice to face down\n        (1, 2): [RIGHT],          # Facing right, turn right to face up\n        (1, 3): [LEFT],           # Facing right, turn left to face left\n        (2, 0): [LEFT],           # Facing up, turn left to face down\n        (2, 1): [LEFT, LEFT],   # Facing up, turn left twice to face right\n        (2, 3): [RIGHT],          # Facing up, turn right to face left\n        (3, 0): [LEFT],           # Facing left, turn left to face down\n        (3, 1): [RIGHT],          # Facing left, turn right to face right\n        (3, 2): [RIGHT, RIGHT]  # Facing left, turn right twice to face up\n    }\n\n    if target_direction != current_direction:\n        actions.extend(rotations.get((current_direction, target_direction), []))\n\n    # Add the movement action\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
