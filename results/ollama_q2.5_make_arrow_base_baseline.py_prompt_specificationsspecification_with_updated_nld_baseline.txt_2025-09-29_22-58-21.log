  else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def align_and_move(target_pos):\n    \"\"\"\n      This function computes the sequence of actions needed to move the agent from its current \n      position and direction towards a target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to align the agent's facing direction and move it to the \n                   target position.\n    \"\"\"\n    actions = []\n    \n    # Compute the direction needed to move towards the target position\n    x_dir, y_dir = compute_direction(target_pos, env._current_state.pos)\n    \n    # Determine the current direction the agent is facing (assuming UP=0, RIGHT=1, DOWN=2, LEFT=3)\n    current_direction = env._current_state.dir\n    \n    # Compute the target direction based on x_dir and y_dir\n    if x_dir < 0:\n        target_direction = 3  # LEFT\n    elif x_dir > 0:\n        target_direction = 1  # RIGHT\n    elif y_dir < 0:\n        target_direction = 2  # DOWN\n    elif y_dir > 0:\n        target_direction = 0  # UP\n\n    # Compute the sequence of actions needed to turn towards the target direction\n    if current_direction != target_direction:\n        # Calculate the difference in direction and determine the shortest path\n        diff = (target_direction - current_direction) % 4\n        if diff == 1:\n            actions.append(RIGHT)\n        elif diff == 2:\n            actions.extend([RIGHT, RIGHT])  # or [LEFT, LEFT]\n        elif diff == 3:\n            actions.append(LEFT)\n\n    # Add the movement action to reach the target position\n    actions.extend(move_to(x_dir, y_dir))\n    \n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T14:21:36.822443", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T14:28:57.480907", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current position\n      to the target position. It ensures that the agent faces the correct direction and moves step by step.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the target position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n        x_dir, y_dir = compute_direction(target_pos, current_pos)\n        \n        if x_dir < 0 and y_dir == 0:\n            actions.append(LEFT)\n        elif x_dir > 0 and y_dir == 0:\n            actions.append(RIGHT)\n        elif x_dir == 0 and y_dir < 0:\n            actions.append(DOWN)\n        elif x_dir == 0 and y_dir > 0:\n            actions.append(UP)\n\n        # Execute the action to move one step towards the target\n        env.step(actions[-1])\n        current_pos = env._current_state.pos\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It ensures that the agent has enough space in its inventory and handles the movement and\n      interaction with workshops correctly.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                # Move to the position of the primitive\n                actions.extend(move_to(nearest_primitive_position))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n                count -= 1\n\n    # Find the nearest workshop for crafting the item\n    workshop_name = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_name, env._current_state.grid)\n    \n    if workshop_position:\n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T14:28:58.450562", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current position\n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the target position.\n    \"\"\"\n    actions = []\n    current_pos = env._current_state.pos\n\n    while current_pos != target_pos:\n        x_dir, y_dir = compute_direction(target_pos, current_pos)\n\n        if x_dir < 0:\n            actions.append(LEFT)\n        elif x_dir > 0:\n            actions.append(RIGHT)\n        elif y_dir < 0:\n            actions.append(DOWN)\n        elif y_dir > 0:\n            actions.append(UP)\n\n        # Move to the next position\n        current_pos = (current_pos[0] + x_dir, current_pos[1] + y_dir)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Move to the position of the primitive\n            actions.extend(move_to(nearest_primitive_position))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T14:30:52.415521", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def get_goal_index(goal_item):\n    goal_index = env.world.cookbook.index[goal_item]\n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n    return goal_index\n\n  def gather_primitives(primitives_needed, grid, pos):\n      actions = []\n      for primitive, count in primitives_needed.items():\n          nearest_primitive_position = find_nearest_instance(primitive, grid)\n          \n          if nearest_primitive_position:\n              # Align agent's direction with movement direction\n              align_action = align_direction(nearest_primitive_position, pos)\n              if align_action is not None:\n                  actions.append(align_action)\n\n              x_dir, y_dir = compute_direction(nearest_primitive_position, pos)\n              \n              # Move to the position of the primitive\n              actions.extend(move_to(x_dir, y_dir))\n              \n              # Use action to gather the primitive\n              actions.append(USE)\n      return actions\n\n  def find_nearest_instance(item_index, grid):\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      if positions.size == 0:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n      if isinstance(workshop_type, str):\n          workshop_index = env.world.cookbook.index[workshop_type]\n      else:\n          workshop_index = workshop_type\n      \n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if positions.size == 0:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n      x_dir = target_pos[0] - current_pos[0]\n      y_dir = target_pos[1] - current_pos[1]\n      return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n      actions = []\n\n      while x_dir != 0 or y_dir != 0:\n          if x_dir < 0:\n              actions.append(LEFT)\n              x_dir += 1\n          elif x_dir > 0:\n              actions.append(RIGHT)\n              x_dir -= 1\n\n          if y_dir < 0:\n              actions.append(DOWN)\n              y_dir += 1\n          elif y_dir > 0:\n              actions.append(UP)\n              y_dir -= 1\n\n      return actions\n\n  def align_direction(target_pos, current_pos):\n      \"\"\" Aligns the agent's direction towards the target position \"\"\"\n      current_x, current_y = current_pos\n      target_x, target_y = target_pos\n      \n      # Prioritize horizontal movement\n      if target_x < current_x:\n          return LEFT\n      elif target_x > current_x:\n          return RIGHT\n\n      if target_y < current_y:\n          return DOWN\n      elif target_y > current_y:\n          return UP\n\n  def craft_item(workshop_position, grid, pos):\n    actions = []\n    # Align agent's direction with movement direction\n    align_action = align_direction(workshop_position, pos)\n    if align_action is not None:\n        actions.append(align_action)\n\n    x_dir, y_dir = compute_direction(workshop_position, pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n      actions = []\n      \n      # Gather all primitives needed for crafting\n      actions.extend(gather_primitives(primitives_needed, env._current_state.grid, env._current_state.pos))\n\n      workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n      \n      if workshop_position:\n          # Craft the item at the found workshop\n          actions.extend(craft_item(workshop_position, env._current_state.grid, env._current_state.pos))\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = get_goal_index(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T14:30:53.376327", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Align agent's direction with movement direction\n            align_action = align_direction(nearest_primitive_position, env._current_state.pos)\n            if align_action is not None:\n                actions.append(align_action)\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        # Align agent's direction with movement direction\n        align_action = align_direction(workshop_position, env._current_state.pos)\n        if align_action is not None:\n            actions.append(align_action)\n\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      if positions.size == 0:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n      if isinstance(workshop_type, str):\n          workshop_index = env.world.cookbook.index[workshop_type]\n      else:\n          workshop_index = workshop_type\n      \n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if positions.size == 0:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n      x_dir = target_pos[0] - current_pos[0]\n      y_dir = target_pos[1] - current_pos[1]\n      return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n      actions = []\n\n      while x_dir != 0 or y_dir != 0:\n          if abs(x_dir) > abs(y_dir):\n              # Prioritize horizontal movement\n              if x_dir < 0:\n                  actions.append(LEFT)\n                  x_dir += 1\n              elif x_dir > 0:\n                  actions.append(RIGHT)\n                  x_dir -= 1\n          else:\n              # Prioritize vertical movement\n              if y_dir < 0:\n                  actions.append(DOWN)\n                  y_dir += 1\n              elif y_dir > 0:\n                  actions.append(UP)\n                  y_dir -= 1\n\n      return actions\n\n  def align_direction(target_pos, current_pos):\n      \"\"\" Aligns the agent's direction towards the target position \"\"\"\n      current_x, current_y = current_pos\n      target_x, target_y = target_pos\n      \n      # Calculate differences in coordinates\n      x_diff = target_x - current_x\n      y_diff = target_y - current_y\n\n      if abs(x_diff) > abs(y_diff):\n          return LEFT if x_diff < 0 else RIGHT\n      else:\n          return DOWN if y_diff < 0 else UP\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T14:34:19.258216", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory.get(primitive, 0) < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"Could not find enough instances of {primitive}.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Rotate and move to the position of the primitive\n            actions.extend(rotate_and_move(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"Could not find a {workshop_type} workshop.\")\n    \n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Rotate and move to the position of the workshop\n    actions.extend(rotate_and_move(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if len(positions) == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if len(positions) == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop type\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def rotate_and_move(x_dir, y_dir):\n      \"\"\"\n      This function generates a sequence of actions to rotate and move the agent \n      in the specified direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate and move the agent in the specified direction.\n      \"\"\"\n      current_direction = env._current_state.dir\n      target_direction = np.arctan2(y_dir, x_dir) * (180 / np.pi)\n\n      # Normalize directions to be within [0, 360)\n      current_direction = (current_direction + 360) % 360\n      target_direction = (target_direction + 360) % 360\n\n      if target_direction == 0:\n          target_direction = 360\n\n      # Calculate the difference in direction\n      diff = target_direction - current_direction\n\n      # Normalize the difference to be within [-180, 180]\n      if diff > 180:\n          diff -= 360\n      elif diff < -180:\n          diff += 360\n\n      actions = []\n\n      # Turn left or right based on the difference in direction\n      while abs(diff) >= 90:\n          if diff < 0:\n              actions.append(LEFT)\n          else:\n              actions.append(RIGHT)\n          current_direction = (current_direction + 90 * np.sign(diff)) % 360\n          diff = target_direction - current_direction\n\n      # Move forward if there's no change in direction\n      if x_dir != 0 or y_dir != 0:\n          actions.append(USE)\n\n      return actions\n\n  def update_state(action):\n      \"\"\"\n      This function simulates the effect of an action on the environment state.\n      It updates the agent's position, direction, and inventory based on the action taken.\n\n      Args:\n        action: The action to be executed (e.g., LEFT, RIGHT, USE).\n\n      Returns:\n        None\n      \"\"\"\n      if action == LEFT:\n          env._current_state.dir = (env._current_state.dir - 90) % 360\n      elif action == RIGHT:\n          env._current_state.dir = (env._current_state.dir + 90) % 360\n      elif action == USE:\n          current_pos = env._current_state.pos\n          grid = env._current_state.grid\n\n          if env._current_state.dir == 0: # UP\n              target_pos = (current_pos[0], current_pos[1] - 1)\n          elif env._current_state.dir == 90: # RIGHT\n              target_pos = (current_pos[0] + 1, current_pos[1])\n          elif env._current_state.dir == 180: # DOWN\n              target_pos = (current_pos[0], current_pos[1] + 1)\n          elif env._current_state.dir == 270: # LEFT\n              target_pos = (current_pos[0] - 1, current_pos[1])\n\n          if grid[target_pos].any(): # Check if there's an item or a workshop at the target position\n              item_index = np.argmax(grid[target_pos])\n              item_name = env.world.cookbook.names[item_index]\n\n              if item_name in env.world.cookbook.primitives:\n                  # Gather the primitive\n                  env._current_state.inventory[item_name] = env._current_state.inventory.get(item_name, 0) + 1\n                  grid[current_pos][item_index] -= 1\n              elif item_name in env.world.cookbook.recipes.keys():\n                  # Craft an item at the workshop\n                  recipe = env.world.cookbook.recipes[item_name]\n                  if all(env._current_state.inventory.get(primitive, 0) >= count for primitive, count in recipe.items()):\n                      for primitive, count in recipe.items():\n                          env._current_state.inventory[primitive] -= count\n                      env._current_state.inventory[item_name] = env._current_state.inventory.get(item_name, 0) + 1\n\n      return None\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Could not find {goal_item} in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  for action in actions:\n      update_state(action)\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-30T14:34:20.224211", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find all instances of the primitive in the grid\n        positions = find_all_instances(primitive, env._current_state.grid)\n\n        if not positions:\n            raise ValueError(f\"No instances of '{primitive}' found in the grid.\")\n\n        # Sort positions by distance from the current position\n        agent_position = np.array(env._current_state.pos)\n        sorted_positions = sorted(positions, key=lambda pos: np.linalg.norm(np.array(pos) - agent_position))\n\n        for pos in sorted_positions:\n            x_dir, y_dir = compute_direction(pos, env._current_state.pos)\n\n            # Rotate and move to the position of the primitive\n            actions.extend(rotate_and_move(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if not workshop_position:\n        raise ValueError(f\"No workshop of type '{workshop_type}' found in the grid.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n    # Rotate and move to the position of the workshop\n    actions.extend(rotate_and_move(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_all_instances(item_index, grid):\n    \"\"\"\n      This function finds all instances of an item in the given grid.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        List[Tuple[int, int]]: A list of (x, y) coordinates of all instances of the item. \n                               If no instance is found, returns an empty list.\n    \"\"\"\n    return list(zip(*np.where(grid == item_index)))\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid == workshop_index)\n\n    if not positions.size > 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return (x_dir, y_dir)\n\n  def rotate_and_move(x_dir, y_dir):\n      \"\"\"\n      This function generates a sequence of actions to rotate and move the agent \n      in the specified direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate and move the agent in the specified direction.\n      \"\"\"\n      current_direction = env._current_state.dir\n      target_direction = np.arctan2(y_dir, x_dir) * (180 / np.pi)\n\n      # Normalize directions to be within [0, 360)\n      current_direction = (current_direction + 360) % 360\n      target_direction = (target_direction + 360) % 360\n\n      if target_direction == 0:\n          target_direction = 360\n\n      # Calculate the difference in direction\n      diff = target_direction - current_direction\n\n      # Normalize the difference to be within [-180, 180]\n      if diff > 180:\n          diff -= 360\n      elif diff < -180:\n          diff += 360\n\n      actions = []\n\n      # Turn left or right based on the difference in direction\n      while abs(diff) >= 90:\n          if diff < 0:\n              actions.append(LEFT)\n          elif diff > 0:\n              actions.append(RIGHT)\n          \n          current_direction = (current_direction + 90 * np.sign(diff)) % 360\n          target_direction = (target_direction + 90 * np.sign(diff)) % 360\n\n          if target_direction == 0:\n              target_direction = 360\n\n          diff = target_direction - current_direction\n\n      # Move forward if there's no change in direction or after rotating\n      if x_dir != 0 or y_dir != 0:\n          actions.append(USE)\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-30T14:37:24.267388", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It takes into account the agent's current direction when aligning for movement.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Align direction and move to the position of the primitive\n                actions.extend(align_and_move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Align direction and move to the position of the workshop\n        actions.extend(align_and_move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def align_and_move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to align the agent's direction with \n      the specified movement direction and then moves the agent.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to align the agent's direction and move it.\n    \"\"\"\n    current_direction = env._current_state.dir\n    actions = []\n\n    # Define mappings from current direction to target direction\n    direction_mapping = {\n        (LEFT, (0, 1)): [UP],\n        (LEFT, (0, -1)): [DOWN],\n        (LEFT, (1, 0)): [RIGHT],\n        (LEFT, (-1, 0)): [],\n        \n        (RIGHT, (0, 1)): [UP],\n        (RIGHT, (0, -1)): [DOWN],\n        (RIGHT, (-1, 0)): [LEFT],\n        (RIGHT, (1, 0)): [],\n        \n        (UP, (-1, 0)): [LEFT],\n        (UP, (1, 0)): [RIGHT],\n        (UP, (0, -1)): [DOWN],\n        (UP, (0, 1)): [],\n        \n        (DOWN, (-1, 0)): [LEFT],\n        (DOWN, (1, 0)): [RIGHT],\n        (DOWN, (0, 1)): [UP],\n        (DOWN, (0, -1)): []\n    }\n    \n    # Get the actions needed to align current direction with target\n    key = (current_direction, (x_dir, y_dir))\n    if key in direction_mapping:\n        actions.extend(direction_mapping[key])\n\n    # Move based on the direction after alignment\n    actions.extend(move_to(x_dir, y_dir))\n\n    return actions\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T14:37:25.261862", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It considers that the agent might need to turn around or adjust its direction \n      while moving.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Align the agent's direction with the movement direction\n                actions.extend(align_direction(x_dir, y_dir))\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Align the agent's direction with the movement direction\n        actions.extend(align_direction(x_dir, y_dir))\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def align_direction(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to align the agent's direction with the \n      specified movement direction. It considers the agent's current direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to align the agent's direction with the specified movement.\n    \"\"\"\n    current_direction = env._current_state.dir\n    actions = []\n\n    # Define mappings from current direction to target direction\n    direction_mapping = {\n        (LEFT, (0, 1)): [UP],\n        (LEFT, (0, -1)): [DOWN],\n        (LEFT, (1, 0)): [],\n        (LEFT, (-1, 0)): [],\n        \n        (RIGHT, (0, 1)): [UP],\n        (RIGHT, (0, -1)): [DOWN],\n        (RIGHT, (-1, 0)): [],\n        (RIGHT, (1, 0)): [],\n        \n        (UP, (-1, 0)): [LEFT],\n        (UP, (1, 0)): [RIGHT],\n        (UP, (0, -1)): [],\n        (UP, (0, 1)): [],\n        \n        (DOWN, (-1, 0)): [LEFT],\n        (DOWN, (1, 0)): [RIGHT],\n        (DOWN, (0, 1)): [],\n        (DOWN, (0, -1)): []\n    }\n    \n    # Get the actions needed to align current direction with target\n    key = (current_direction, (x_dir, y_dir))\n    if key in direction_mapping:\n        actions.extend(direction_mapping[key])\n\n    return actions\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.5}}
