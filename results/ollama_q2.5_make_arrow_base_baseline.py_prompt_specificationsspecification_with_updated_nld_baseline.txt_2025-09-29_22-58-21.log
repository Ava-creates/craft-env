  \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index if necessary\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop type\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Calculate the total distance in each direction\n    x_distance = abs(x_dir)\n    y_distance = abs(y_dir)\n\n    # Determine the primary and secondary directions based on which has a larger absolute value\n    if x_distance > y_distance:\n        primary_direction = (x_dir, 0)\n        secondary_direction = (0, y_dir)\n    else:\n        primary_direction = (0, y_dir)\n        secondary_direction = (x_dir, 0)\n\n    # Move in the primary direction first\n    while primary_direction[0] != 0 or primary_direction[1] != 0:\n        if primary_direction[0] < 0 and primary_direction[1] == 0:\n            actions.append(LEFT)\n        elif primary_direction[0] > 0 and primary_direction[1] == 0:\n            actions.append(RIGHT)\n        elif primary_direction[0] == 0 and primary_direction[1] < 0:\n            actions.append(DOWN)\n        elif primary_direction[0] == 0 and primary_direction[1] > 0:\n            actions.append(UP)\n        \n        # Update the remaining distance in the primary direction\n        if primary_direction[0] != 0:\n            primary_direction = (primary_direction[0] - np.sign(primary_direction[0]), primary_direction[1])\n        elif primary_direction[1] != 0:\n            primary_direction = (primary_direction[0], primary_direction[1] - np.sign(primary_direction[1]))\n\n    # Then move in the secondary direction\n    while secondary_direction[0] != 0 or secondary_direction[1] != 0:\n        if secondary_direction[0] < 0 and secondary_direction[1] == 0:\n            actions.append(LEFT)\n        elif secondary_direction[0] > 0 and secondary_direction[1] == 0:\n            actions.append(RIGHT)\n        elif secondary_direction[0] == 0 and secondary_direction[1] < 0:\n            actions.append(DOWN)\n        elif secondary_direction[0] == 0 and secondary_direction[1] > 0:\n            actions.append(UP)\n\n        # Update the remaining distance in the secondary direction\n        if secondary_direction[0] != 0:\n            secondary_direction = (secondary_direction[0] - np.sign(secondary_direction[0]), secondary_direction[1])\n        elif secondary_direction[1] != 0:\n            secondary_direction = (secondary_direction[0], secondary_direction[1] - np.sign(secondary_direction[1]))\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 9, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T11:45:31.855337", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      Gather all required primitives for crafting the item.\n      \n      Args:\n        primitives_needed: A dictionary with keys as primitive indices and values as counts.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n    current_state = env._current_state  # Assuming we can access the current state directly\n\n    for primitive, count in primitives_needed.items():\n        while current_state.inventory[primitive] < count:\n            nearest_primitive_position = find_nearest_instance(primitive, current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"Primitive with index {primitive} not found on the grid.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n            # Update the current state after gathering the primitive\n            current_state.grid[nearest_primitive_position] -= 1\n            current_state.inventory[primitive] += 1\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      Find the nearest instance of an item in the given grid.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos  # Assuming we can access the current state directly\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      Compute the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      Generate a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      Find the nearest workshop of a given type in the provided grid.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos  # Assuming we can access the current state directly\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def craft_item(workshop_position):\n    \"\"\"\n      Craft the item at the given workshop position.\n      \n      Args:\n        workshop_position: A tuple representing the (x, y) coordinates of the workshop.\n\n      Returns:\n        List[int]: A list of actions to craft the item.\n    \"\"\"\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions = move_to(x_dir, y_dir)\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Fetch required primitives for the goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  # Gather primitives\n  actions = gather_primitives(primitives_needed)\n  \n  # Find and use the nearest workshop to craft the item\n  workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n  \n  if workshop_position is None:\n      raise ValueError(\"No suitable workshop found on the grid.\")\n\n  actions.extend(craft_item(workshop_position))\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T11:45:32.820311", "function_name": "make_arrow", "function_body": "  def find_nearest_instance(item_index, grid, current_pos):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid, current_pos):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n    \n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      allows gathering and crafting without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid, env._current_state.pos)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid, env._current_state.pos)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
