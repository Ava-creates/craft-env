urns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def navigate_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current \n      position to the target position. It computes the necessary directions and translates \n      them into the appropriate movement actions.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the target position.\n    \"\"\"\n    # Initialize action sequence\n    actions = []\n\n    current_pos = env._current_state.pos\n\n    while current_pos != target_pos:\n        x_dir, y_dir = compute_direction(target_pos, current_pos)\n\n        if x_dir < 0:\n            actions.append(LEFT)\n        elif x_dir > 0:\n            actions.append(RIGHT)\n        \n        if y_dir < 0:\n            actions.append(DOWN)\n        elif y_dir > 0:\n            actions.append(UP)\n\n        # Execute the move action\n        env.step(actions[-1])\n        current_pos = env._current_state.pos\n\n    return actions\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:35:38.617526", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  def optimize_path(actions):\n    \"\"\"\n      This function optimizes the path by removing redundant movements.\n      For example, moving LEFT then RIGHT or UP then DOWN can be removed.\n\n      Args:\n        actions: A list of actions to be optimized.\n\n      Returns:\n        List[int]: The optimized sequence of actions.\n    \"\"\"\n    # Convert actions to a numpy array for easier manipulation\n    actions_array = np.array(actions)\n    \n    # Create an empty list to store the optimized path\n    optimized_actions = []\n    \n    i = 0\n    while i < len(actions_array):\n        action = actions_array[i]\n        \n        if i + 1 < len(actions_array):\n            next_action = actions_array[i + 1]\n            \n            # Check for opposite movements and remove them\n            if (action == LEFT and next_action == RIGHT) or \\\n               (action == RIGHT and next_action == LEFT) or \\\n               (action == UP and next_action == DOWN) or \\\n               (action == DOWN and next_action == UP):\n                i += 2  # Skip the opposite movement\n            else:\n                optimized_actions.append(action)\n                i += 1\n        else:\n            optimized_actions.append(action)\n            i += 1\n    \n    return optimized_actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  # Optimize the generated path\n  optimized_actions = optimize_path(actions)\n  \n  return optimized_actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T17:43:08.997127", "function_name": "make_arrow", "function_body": "  # Define action constants\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather all required primitives.\n\n      Args:\n        primitives_needed: A dictionary with item indices as keys and counts as values.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive)\n            \n            if nearest_primitive_position is not None:\n                x_dir, y_dir = compute_direction(nearest_primitive_position)\n                \n                # Align the agent's facing direction with the movement direction\n                actions.extend(align_facing_direction(x_dir, y_dir))\n                actions.extend(move_to(x_dir, y_dir))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n\n                count -= 1\n\n    return actions\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to move to and use the nearest workshop.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        List[int]: A list of actions to craft the item.\n    \"\"\"\n    actions = []\n    \n    workshop_position = find_nearest_workshop(workshop_type)\n    \n    if workshop_position is not None:\n        x_dir, y_dir = compute_direction(workshop_position)\n\n        # Align the agent's facing direction with the movement direction\n        actions.extend(align_facing_direction(x_dir, y_dir))\n        actions.extend(move_to(x_dir, y_dir))\n\n        # Use action to craft the item\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the current environment.\n\n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a specified type in the current environment.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def align_facing_direction(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to align the agent's facing direction with \n      the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to align the agent's facing direction with the movement \n                   direction.\n    \"\"\"\n    current_direction = env._current_state.direction\n    target_direction = np.arctan2(y_dir, x_dir)\n\n    if current_direction == target_direction:\n        return []\n\n    # Define direction angles in radians (assuming clockwise from north)\n    directions = [np.pi/2, 0, -np.pi/2]\n    \n    # Calculate the relative angle to rotate\n    relative_angle = target_direction - current_direction\n    \n    # Normalize the relative angle to be within [-pi, pi]\n    if relative_angle > np.pi:\n        relative_angle -= 2*np.pi\n    elif relative_angle < -np.pi:\n        relative_angle += 2*np.pi\n\n    actions = []\n\n    # Determine the direction of rotation (clockwise or counterclockwise)\n    if relative_angle < 0:\n        action = RIGHT\n    else:\n        action = LEFT\n\n    # Calculate the number of rotations needed based on the angle difference\n    num_rotations = int(abs(relative_angle) / (np.pi/2))\n\n    actions.extend([action] * num_rotations)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  # Gather primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Craft item\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  actions.extend(craft_item(workshop_type))\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:43:09.976446", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather all required primitives.\n\n      Args:\n        primitives_needed: A dictionary with item indices as keys and counts as values.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive)\n            \n            if nearest_primitive_position is not None:\n                x_dir, y_dir = compute_direction(nearest_primitive_position)\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    return actions\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to move to and use the nearest workshop.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        List[int]: A list of actions to craft the item.\n    \"\"\"\n    actions = []\n    \n    workshop_position = find_nearest_workshop(workshop_type)\n    \n    if workshop_position is not None:\n        x_dir, y_dir = compute_direction(workshop_position)\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the current environment.\n\n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a specified type in the current environment.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  # Gather primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Craft item\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  actions.extend(craft_item(workshop_type))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T17:46:03.143557", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory.get(primitive, 0) < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Align the agent's direction with the movement direction\n                current_direction = align_direction(env._current_state.direction, (x_dir, y_dir))\n                actions.extend(current_direction)\n\n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n            else:\n                raise ValueError(f\"No instance of '{primitive}' found in the environment.\")\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Align the agent's direction with the movement direction\n        current_direction = align_direction(env._current_state.direction, (x_dir, y_dir))\n        actions.extend(current_direction)\n\n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:46:04.098817", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It ensures that the agent faces the correct direction before moving.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Compute direction to move towards the primitive\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive while facing the correct direction\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Compute direction to move towards the workshop\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop while facing the correct direction\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It ensures that the agent faces the correct direction before moving.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Determine which action to take based on the direction vector\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T17:48:52.518656", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It ensures that the agent faces in the correct direction before moving or using.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n    \n    primitives_needed = env.world.cookbook.primitives_for(goal_item)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            actions.extend(gather_primitive(primitive))\n            \n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_item][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n      # Move to the position of the workshop\n      actions.extend(move_to(workshop_position))\n      \n      # Use action to craft the item at the workshop\n      actions.append(USE)\n\n    return actions\n\n  def gather_primitive(primitive_item):\n    \"\"\"\n      This function gathers a single instance of a primitive item.\n      It finds the nearest instance, moves to it, and uses the USE action.\n\n      Args:\n        primitive_item: The name of the primitive item to be gathered.\n\n      Returns:\n        List[int]: A list of actions to gather the primitive item.\n    \"\"\"\n    # Convert primitive item name to index\n    primitive_index = env.world.cookbook.index[primitive_item]\n    \n    if primitive_index is None:\n      raise ValueError(f\"Item '{primitive_item}' not found in the cookbook.\")\n      \n    # Find the nearest instance of the primitive item\n    nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n    \n    if nearest_primitive_position:\n        # Move to the position of the primitive item\n        actions = move_to(nearest_primitive_position)\n        \n        # Use action to gather the primitive item\n        actions.append(USE)\n\n        return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    if workshop_index is None:\n      raise ValueError(f\"Workshop type '{workshop_type}' not found in the cookbook.\")\n      \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def move_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current \n      position to the target position. It ensures that the agent faces in the correct \n      direction before moving.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Compute the direction vector from current position to target position\n    x_dir, y_dir = compute_direction(target_pos, current_pos)\n    \n    # Determine the sequence of actions needed to face and move towards the target\n    actions = []\n\n    if (x_dir == 0) and (y_dir == -1):  # Move down\n        while current_dir != 3:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(DOWN)\n    elif (x_dir == 0) and (y_dir == 1):  # Move up\n        while current_dir != 1:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(UP)\n    elif (x_dir == -1) and (y_dir == 0):  # Move left\n        while current_dir != 2:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(LEFT)\n    elif (x_dir == 1) and (y_dir == 0):  # Move right\n        while current_dir != 0:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(RIGHT)\n\n    return actions\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:48:53.489940", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It ensures that the agent faces in the correct direction before moving or using.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            while count > 0:\n                # Move to the position of the primitive\n                actions.extend(move_to(nearest_primitive_position))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n                count -= 1\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def move_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current \n      position to the target position. It ensures that the agent faces in the correct \n      direction before moving.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Compute the direction vector from current position to target position\n    x_dir, y_dir = compute_direction(target_pos, current_pos)\n    \n    # Determine the sequence of actions needed to face and move towards the target\n    actions = []\n\n    if (x_dir == 0) and (y_dir == -1):  # Move down\n        while current_dir != DOWN:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(DOWN)\n    elif (x_dir == 0) and (y_dir == 1):  # Move up\n        while current_dir != UP:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(UP)\n    elif (x_dir == -1) and (y_dir == 0):  # Move left\n        while current_dir != LEFT:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(LEFT)\n    elif (x_dir == 1) and (y_dir == 0):  # Move right\n        while current_dir != RIGHT:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(RIGHT)\n\n    return actions\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:50:47.427153", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Adjust direction based on agent's current facing\n            actions.extend(turn_to(x_dir, y_dir))\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(nearest_primitive_position[0], nearest_primitive_position[1]))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Adjust direction based on agent's current facing\n        actions.extend(turn_to(x_dir, y_dir))\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position[0], workshop_position[1]))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = target_pos[0] - current_pos[0]\n    y_dir = target_pos[1] - current_pos[1]\n\n    return x_dir, y_dir\n\n  def turn_to(x_dir, y_dir):\n    actions = []\n    \n    if x_dir < 0:\n        # Turn left\n        if env._current_state.dir == 2:  # Facing down\n            actions.append(LEFT)\n            actions.append(LEFT)\n        elif env._current_state.dir == 1:  # Facing right\n            actions.append(LEFT)\n        elif env._current_state.dir == 3:  # Facing left (no turn needed)\n            pass\n        elif env._current_state.dir == 0:  # Facing up\n            actions.append(RIGHT)\n    elif x_dir > 0:\n        # Turn right\n        if env._current_state.dir == 2:  # Facing down\n            actions.append(RIGHT)\n            actions.append(RIGHT)\n        elif env._current_state.dir == 3:  # Facing left\n            actions.append(RIGHT)\n        elif env._current_state.dir == 1:  # Facing right (no turn needed)\n            pass\n        elif env._current_state.dir == 0:  # Facing up\n            actions.append(LEFT)\n    elif y_dir < 0:\n        # Turn down\n        if env._current_state.dir == 3:  # Facing left\n            actions.append(RIGHT)\n        elif env._current_state.dir == 1:  # Facing right\n            actions.append(LEFT)\n        elif env._current_state.dir == 2:  # Facing down (no turn needed)\n            pass\n        elif env._current_state.dir == 0:  # Facing up\n            actions.append(RIGHT)\n            actions.append(RIGHT)\n    elif y_dir > 0:\n        # Turn up\n        if env._current_state.dir == 3:  # Facing left\n            actions.append(LEFT)\n        elif env._current_state.dir == 1:  # Facing right\n            actions.append(RIGHT)\n        elif env._current_state.dir == 0:  # Facing up (no turn needed)\n            pass\n        elif env._current_state.dir == 2:  # Facing down\n            actions.append(LEFT)\n            actions.append(LEFT)\n\n    return actions\n\n  def move_to(target_x, target_y):\n    current_x, current_y = env._current_state.pos\n    actions = []\n    \n    while current_x != target_x or current_y != target_y:\n        if current_x < target_x:\n            actions.append(RIGHT)\n            current_x += 1\n        elif current_x > target_x:\n            actions.append(LEFT)\n            current_x -= 1\n        \n        if current_y < target_y:\n            actions.append(DOWN)\n            current_y += 1\n        elif current_y > target_y:\n            actions.append(UP)\n            current_y -= 1\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-30T17:50:48.374918", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Compute the path to reach the primitive\n            path_to_primitive = compute_path(nearest_primitive_position, env._current_state.pos)\n\n            # Follow the computed path\n            actions.extend(follow_path(path_to_primitive))\n\n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        # Compute the path to reach the workshop\n        path_to_workshop = compute_path(workshop_position, env._current_state.pos)\n\n        # Follow the computed path\n        actions.extend(follow_path(path_to_workshop))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_path(target_pos, start_pos):\n    # Simple BFS to find the shortest path from start_pos to target_pos\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if current_pos == target_pos:\n            break\n\n        for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n            neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n            if (neighbor_pos not in visited and\n                0 <= neighbor_pos[0] < env._current_state.grid.shape[0] and\n                0 <= neighbor_pos[1] < env._current_state.grid.shape[1]):\n                \n                queue.append(neighbor_pos)\n                visited.add(neighbor_pos)\n                parent[neighbor_pos] = current_pos\n\n    path = []\n    while target_pos is not None:\n        path.append(target_pos)\n        target_pos = parent[target_pos]\n\n    return path[::-1]  # Reverse the path to get from start to target\n\n  def follow_path(path):\n    actions = []\n\n    for i in range(1, len(path)):\n        x_dir = np.sign(path[i][0] - path[i-1][0])\n        y_dir = np.sign(path[i][1] - path[i-1][1])\n\n        if x_dir < 0 and y_dir == 0:\n            actions.append(LEFT)\n        elif x_dir > 0 and y_dir == 0:\n            actions.append(RIGHT)\n        elif x_dir == 0 and y_dir < 0:\n            actions.append(DOWN)\n        elif x_dir == 0 and y_dir > 0:\n            actions.append(UP)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T17:52:19.931595", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if not nearest_primitive_position:\n                break\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n            count -= 1\n            \n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = target_pos[0] - current_pos[0]\n    y_dir = target_pos[1] - current_pos[1]\n\n    # Adjust direction based on agent's current facing\n    current_facing = env._current_state.dir\n\n    if current_facing == 0:  # Facing up\n        return (x_dir, -y_dir)\n    elif current_facing == 2:  # Facing down\n        return (-x_dir, y_dir)\n    elif current_facing == 3:  # Facing left\n        return (-y_dir, x_dir)\n    elif current_facing == 1:  # Facing right\n        return (y_dir, -x_dir)\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n    \n    while x_dir != 0 or y_dir != 0:\n        if abs(x_dir) > abs(y_dir):\n            if x_dir < 0:\n                actions.append(LEFT)\n                x_dir += 1\n            else:\n                actions.append(RIGHT)\n                x_dir -= 1\n        else:\n            if y_dir < 0:\n                actions.append(DOWN)\n                y_dir += 1\n            else:\n                actions.append(UP)\n                y_dir -= 1\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n\n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-09-30T17:52:20.947878", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if not nearest_primitive_position:\n                break\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n            \n            count -= 1\n            \n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n\n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = target_pos[0] - current_pos[0]\n    y_dir = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    # Adjust direction based on agent's current facing\n    current_facing = env._current_state.dir\n\n    if current_facing == 0:  # Facing up\n        if x_dir < 0:\n            actions.append(LEFT)\n        elif x_dir > 0:\n            actions.append(RIGHT)\n        else:\n            actions.extend([UP] * y_dir)\n\n    elif current_facing == 2:  # Facing down\n        if x_dir < 0:\n            actions.append(LEFT)\n        elif x_dir > 0:\n            actions.append(RIGHT)\n        else:\n            actions.extend([DOWN] * -y_dir)\n\n    elif current_facing == 3:  # Facing left\n        if y_dir < 0:\n            actions.append(DOWN)\n        elif y_dir > 0:\n            actions.append(UP)\n        else:\n            actions.extend([LEFT] * -x_dir)\n\n    elif current_facing == 1:  # Facing right\n        if y_dir < 0:\n            actions.append(DOWN)\n        elif y_dir > 0:\n            actions.append(UP)\n        else:\n            actions.extend([RIGHT] * x_dir)\n\n    return actions\n\n  def move_to(x_dir, y_dir):\n      return compute_direction((x_dir, y_dir), env._current_state.pos)\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:55:14.966595", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position is None:\n            raise ValueError(f\"Could not find the required primitive '{primitive}'.\")\n\n        x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n        \n        # Turn to face the target direction\n        actions.extend(turn_to(x_dir, y_dir))\n        \n        # Move to the position of the primitive and gather it\n        while env._current_state.pos != nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            actions.extend(move_and_turn(x_dir, y_dir))\n            current_state, reward, done, info = env.step(actions[-1])\n        \n        # Gather the primitive\n        actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"Could not find a workshop to craft '{env.world.cookbook.names[goal_index]}'.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Turn to face the target direction\n    actions.extend(turn_to(x_dir, y_dir))\n    \n    # Move to the position of the workshop and craft the item\n    while env._current_state.pos != workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        actions.extend(move_and_turn(x_dir, y_dir))\n        current_state, reward, done, info = env.step(actions[-1])\n    \n    # Craft the item\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir).\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    return actions\n\n  def move_and_turn(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It first turns the agent if necessary and then moves it one step.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction and move\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:55:15.930176", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles inventory space checks and ensures that the agent can move towards \n      the target positions correctly.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise ValueError(f\"Primitive '{primitive}' not found on the map.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            actions.extend(turn_and_move(x_dir, y_dir))\n            actions.append(USE)\n\n            # Update count after gathering one primitive\n            count -= 1\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"Workshop for '{goal_item}' not found on the map.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    actions.extend(turn_and_move(x_dir, y_dir))\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:57:47.275893", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def get_action_sequence_to_target(target_pos, current_state):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from the current state \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_state: An instance of CraftState representing the current state of the environment.\n\n      Returns:\n        List[int]: A list of actions to move the agent from the current state to the target position.\n    \"\"\"\n    actions = []\n    \n    # Compute the direction vector needed to reach the target\n    x_dir, y_dir = compute_direction(target_pos, current_state.pos)\n\n    # Move in the x-direction if necessary\n    while x_dir != 0:\n        if x_dir < 0:\n            actions.append(LEFT)\n        else:\n            actions.append(RIGHT)\n        \n        # Execute the action and update the current state\n        _, new_state = env.step(actions[-1])\n        current_state = CraftState(new_state)\n\n        # Recompute the direction vector after moving in the x-direction\n        x_dir, _ = compute_direction(target_pos, current_state.pos)\n    \n    # Move in the y-direction if necessary\n    while y_dir != 0:\n        if y_dir < 0:\n            actions.append(DOWN)\n        else:\n            actions.append(UP)\n        \n        # Execute the action and update the current state\n        _, new_state = env.step(actions[-1])\n        current_state = CraftState(new_state)\n\n        # Recompute the direction vector after moving in the y-direction\n        _, y_dir = compute_direction(target_pos, current_state.pos)\n    \n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, current_state.grid)\n        \n        if nearest_primitive_position:\n            # Generate a sequence of actions to move to the primitive\n            actions.extend(get_action_sequence_to_target(nearest_primitive_position, current_state))\n            \n            # Add a USE action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], current_state.grid)\n    \n    if workshop_position:\n        # Generate a sequence of actions to move to the workshop\n        actions.extend(get_action_sequence_to_target(workshop_position, current_state))\n        \n        # Add a USE action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = (current_state.x, current_state.y)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = (current_state.x, current_state.y)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  current_state = CraftState(env._current_state)\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:57:48.245869", "function_name": "make_arrow", "function_body": "  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory[primitive] < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instance of {primitive} found.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No {workshop_type} found.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n    \n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Define constants\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:00:16.759677", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles cases where additional steps might be necessary, such as turning \n      or adjusting the agent's facing direction before moving.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                # Compute direction to move towards the primitive\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive while facing correctly\n                actions.extend(move_to_and_face(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Compute direction to move towards the workshop\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop while facing correctly\n        actions.extend(move_to_and_face(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to_and_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction \n      and ensure that it is facing correctly before performing any action.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction and face correctly.\n    \"\"\"\n    # Determine which action to take based on the direction vector\n    if x_dir < 0 and y_dir == 0:\n        return [LEFT]\n    elif x_dir > 0 and y_dir == 0:\n        return [RIGHT]\n    elif x_dir == 0 and y_dir < 0:\n        return [DOWN]\n    elif x_dir == 0 and y_dir > 0:\n        return [UP]\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:00:17.711398", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid, current_pos):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for all cells containing the item and returns the position \n      of the closest one.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid, current_pos):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position \n      of the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Determine which action to take based on the direction vector\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid, env._current_state.pos)\n            \n            if nearest_primitive_position:\n                # Compute direction to move towards the primitive\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid, env._current_state.pos)\n    \n    if workshop_position:\n        # Compute direction to move towards the workshop\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:02:47.407432", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Turn and move to the position of the primitive\n                actions.extend(turn_and_move(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Turn and move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:02:48.361682", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Turn and move to the position of the primitive\n                actions.extend(turn_and_move(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Turn and move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:04:12.555192", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    # Gather all required primitives first\n    for primitive, count in primitives_needed.items():\n        for _ in range(count): \n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    # Handle edge case when the target and current positions are the same\n    if x_dir == 0 and y_dir == 0:\n        return (0, 0)\n    \n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n        if x_dir < 0:\n            actions.append(LEFT)\n            x_dir += 1\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            x_dir -= 1\n\n        if y_dir < 0:\n            actions.append(DOWN)\n            y_dir += 1\n        elif y_dir > 0:\n            actions.append(UP)\n            y_dir -= 1\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:04:13.512474", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        # Find all instances of the primitive\n        positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n\n        if not positions.size:\n            raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n        \n        # Sort positions by distance from current position\n        distances = np.linalg.norm(positions - env._current_state.pos, axis=1)\n        sorted_indices = np.argsort(distances)\n\n        # Gather primitives one by one\n        for i in range(count):\n            nearest_primitive_position = tuple(positions[sorted_indices[i]])\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if not workshop_position:\n        raise ValueError(f\"Workshop '{workshop_type}' not found on the grid.\")\n    \n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    # Handle edge case when the target and current positions are the same\n    if x_dir == 0 and y_dir == 0:\n        return (0, 0)\n    \n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:05:31.554846", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(primitives_needed):\n    actions = []\n\n    for primitive_index in primitives_needed:\n      nearest_primitive_positions = find_all_instances(primitive_index, env._current_state.grid)\n      \n      if nearest_primitive_positions:\n        # Move to the closest instance of the required primitive\n        target_pos = nearest_primitive_positions[0]\n        x_dir, y_dir = compute_direction(target_pos, env._current_state.pos)\n\n        actions.extend(move_to(x_dir, y_dir))\n        actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n      x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n      \n      actions.extend(move_to(x_dir, y_dir))\n      actions.append(USE)\n\n    return actions\n\n  def find_all_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    \n    if not positions:\n        return None\n    \n    agent_position = np.array(env._current_state.pos)\n    distances = [np.linalg.norm(np.array(pos) - agent_position) for pos in positions]\n    \n    sorted_positions = [pos for _, pos in sorted(zip(distances, positions))]\n    return sorted_positions\n\n  def find_nearest_workshop(workshop_type, grid):\n    workshop_index = env.world.cookbook.index[workshop_type]\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir, y_dir = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    if x_dir < 0:\n        x_action = LEFT\n    elif x_dir > 0:\n        x_action = RIGHT\n    else:\n        x_action = None\n\n    if y_dir < 0:\n        y_action = DOWN\n    elif y_dir > 0:\n        y_action = UP\n    else:\n        y_action = None\n    \n    return x_action, y_action\n\n  def move_to(x_action, y_action):\n    actions = []\n\n    # Prioritize moving in the X direction if both directions are required\n    if x_action is not None:\n        actions.append(x_action)\n    \n    if y_action is not None:\n        actions.append(y_action)\n\n    return actions\n\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n  \n  primitives_needed = list(env.world.cookbook.primitives_for(goal_index).keys())\n  actions = gather_and_craft(primitives_needed)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:10:31.764327", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_all_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    \n    if not positions:\n        return None\n    \n    agent_position = np.array(env._current_state.pos)\n    distances = [np.linalg.norm(np.array(pos) - agent_position) for pos in positions]\n    \n    sorted_positions = [pos for _, pos in sorted(zip(distances, positions))]\n    return sorted_positions\n\n  def find_nearest_workshop(workshop_type, grid):\n    workshop_index = env.world.cookbook.index[workshop_type]\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir, y_dir = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    if x_dir < 0:\n        x_action = LEFT\n    elif x_dir > 0:\n        x_action = RIGHT\n    else:\n        x_action = None\n\n    if y_dir < 0:\n        y_action = DOWN\n    elif y_dir > 0:\n        y_action = UP\n    else:\n        y_action = None\n    \n    return x_action, y_action\n\n  def move_to(x_action, y_action):\n    actions = []\n\n    # Prioritize moving in the X direction if both directions are required\n    if x_action is not None and x_action != env._current_state.dir:\n        actions.append(x_action)\n    \n    if y_action is not None and y_action != env._current_state.dir:\n        actions.append(y_action)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_positions = find_all_instances(primitive, env._current_state.grid)\n        \n        if nearest_primitive_positions:\n            # Move to the closest instance of the required primitive\n            target_pos = nearest_primitive_positions[0]\n            \n            while tuple(env._current_state.pos) != target_pos:\n                x_action, y_action = compute_direction(target_pos, env._current_state.pos)\n                \n                actions.extend(move_to(x_action, y_action))\n                if tuple(env._current_state.pos) == target_pos:\n                    actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        while tuple(env._current_state.pos) != workshop_position:\n            x_action, y_action = compute_direction(workshop_position, env._current_state.pos)\n\n            actions.extend(move_to(x_action, y_action))\n        \n        actions.append(USE)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:14:10.625191", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It includes handling for edge cases such as multiple instances of items and\n      aligning with the agent's current direction.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find all instances of the primitive on the grid\n        positions = find_all_instances(primitive, env._current_state.grid)\n        \n        if len(positions) < count:\n            raise ValueError(f\"Not enough instances of {primitive} found.\")\n        \n        for _ in range(count):\n            nearest_primitive_position = positions.pop()\n            \n            # Compute direction to the nearest primitive\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Turn to face the nearest primitive\n            actions.extend(turn_to_face(x_dir, y_dir))\n\n            # Move towards the nearest primitive and gather it\n            actions.extend(move_towards(nearest_primitive_position[0], nearest_primitive_position[1]))\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Turn to face the nearest workshop\n        actions.extend(turn_to_face(x_dir, y_dir))\n\n        # Move towards the nearest workshop and craft the item\n        actions.extend(move_towards(workshop_position[0], workshop_position[1]))\n        actions.append(USE)\n\n    return actions\n\n  def find_all_instances(item_index, grid):\n    \"\"\"\n      This function finds all instances of an item in the given grid.\n      It returns a list of positions where the item is found.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        List[Tuple[int, int]]: A list of (x, y) coordinates of all instances of the item. \n                               If no instances are found, returns an empty list.\n    \"\"\"\n    # Get positions of all cells containing the item\n    return [(pos[1], pos[0]) for pos in np.argwhere(grid[:, :, item_index] > 0)]\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index][::-1])  # Convert (y, x) to (x, y)\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return (x_dir, y_dir)\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified \n      (x, y) position. It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos[0] != target_x or current_pos[1] != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), current_pos)\n        \n        # Move in the x-direction if needed\n        if x_dir < 0 and current_pos[1] == target_y:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0 and current_pos[1] == target_y:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0 and current_pos[0] == target_x:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0 and current_pos[0] == target_x:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target direction. It assumes that the environment has a way to \n      determine and change the agent's current facing direction.\n\n      Args:\n        x_dir: The desired x direction (-1, 0, or 1).\n        y_dir: The desired y direction (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the \n                   specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = np.argmax([x_dir, y_dir])  # Assuming directions are in order: UP, DOWN, LEFT, RIGHT\n\n    # Mapping from (current_direction, target_direction) to actions\n    direction_map = {\n        (0, 1): [DOWN],         # From UP to DOWN\n        (0, 2): [LEFT],          # From UP to LEFT\n        (0, 3): [RIGHT],         # From UP to RIGHT\n        (1, 0): [UP],            # From DOWN to UP\n        (1, 2): [LEFT],          # From DOWN to LEFT\n        (1, 3): [RIGHT],         # From DOWN to RIGHT\n        (2, 0): [UP, RIGHT],     # From LEFT to UP\n        (2, 1): [DOWN, RIGHT],   # From LEFT to DOWN\n        (2, 3): [RIGHT],         # From LEFT to RIGHT\n        (3, 0): [UP, LEFT],      # From RIGHT to UP\n        (3, 1): [DOWN, LEFT],    # From RIGHT to DOWN\n        (3, 2): [LEFT],          # From RIGHT to LEFT\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:14:11.575199", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n                # Turn towards the target direction\n                actions.extend(turn_to_face(x_dir, y_dir))\n\n                # Move to the position of the primitive and face it\n                actions.extend(move_towards(nearest_primitive_position[0], nearest_primitive_position[1]))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Turn towards the target direction\n        actions.extend(turn_to_face(x_dir, y_dir))\n\n        # Move to the position of the workshop and face it\n        actions.extend(move_towards(workshop_position[0], workshop_position[1]))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified \n      (x, y) position. It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos[0] != target_x or current_pos[1] != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), current_pos)\n        \n        # Move in the x-direction if needed\n        if x_dir < 0 and current_pos[1] == target_y:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0 and current_pos[1] == target_y:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0 and current_pos[0] == target_x:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0 and current_pos[0] == target_x:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target direction. It assumes that the environment has a way to \n      determine and change the agent's current facing direction.\n\n      Args:\n        x_dir: The desired x direction (-1, 0, or 1).\n        y_dir: The desired y direction (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the \n                   specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = (x_dir, y_dir)\n\n    # Mapping from (current_direction, target_direction) to actions\n    direction_map = {\n        ((0, 1), (-1, 0)): [DOWN],         # From UP to DOWN\n        ((0, 1), (0, -1)): [LEFT],          # From UP to LEFT\n        ((0, 1), (0, 1)): [RIGHT],         # From UP to RIGHT\n        ((-1, 0), (0, 1)): [UP],            # From DOWN to UP\n        ((-1, 0), (0, -1)): [LEFT],          # From DOWN to LEFT\n        ((-1, 0), (0, 1)): [RIGHT],         # From DOWN to RIGHT\n        ((0, -1), (0, 1)): [UP, RIGHT],     # From LEFT to UP\n        ((0, -1), (-1, 0)): [DOWN, RIGHT],   # From LEFT to DOWN\n        ((0, -1), (0, -1)): [RIGHT],         # From LEFT to RIGHT\n        ((0, 1), (0, -1)): [UP, LEFT],      # From RIGHT to UP\n        ((0, 1), (-1, 0)): [DOWN, LEFT],    # From RIGHT to DOWN\n        ((0, 1), (0, 1)): [LEFT],          # From RIGHT to LEFT\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:15:53.360948", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Compute the path to reach the primitive\n            path_to_primitive = compute_path(nearest_primitive_position, env._current_state.pos)\n\n            # Follow the computed path\n            actions.extend(follow_path(path_to_primitive))\n\n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        # Compute the path to reach the workshop\n        path_to_workshop = compute_path(workshop_position, env._current_state.pos)\n\n        # Follow the computed path\n        actions.extend(follow_path(path_to_workshop))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_path(target_pos, start_pos):\n    # Simple BFS to find the shortest path from start_pos to target_pos\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if current_pos == target_pos:\n            break\n\n        for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n            neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n            if (neighbor_pos not in visited and\n                0 <= neighbor_pos[0] < env._current_state.grid.shape[0] and\n                0 <= neighbor_pos[1] < env._current_state.grid.shape[1]):\n                \n                queue.append(neighbor_pos)\n                visited.add(neighbor_pos)\n                parent[neighbor_pos] = current_pos\n\n    path = []\n    while target_pos is not None:\n        path.append(target_pos)\n        target_pos = parent[target_pos]\n\n    return path[::-1]  # Reverse the path to get from start to target\n\n  def follow_path(path):\n    actions = []\n\n    for i in range(1, len(path)):\n        x_dir = np.sign(path[i][0] - path[i-1][0])\n        y_dir = np.sign(path[i][1] - path[i-1][1])\n\n        if x_dir < 0 and y_dir == 0:\n            actions.append(LEFT)\n        elif x_dir > 0 and y_dir == 0:\n            actions.append(RIGHT)\n        elif x_dir == 0 and y_dir < 0:\n            actions.append(DOWN)\n        elif x_dir == 0 and y_dir > 0:\n            actions.append(UP)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:15:54.315477", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitive_indices):\n    actions = []\n\n    for primitive in primitive_indices:\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Compute the path to reach the primitive\n            path_to_primitive = compute_path(nearest_primitive_position, env._current_state.pos)\n\n            # Follow the computed path\n            actions.extend(follow_path(path_to_primitive))\n\n            # Use action to gather the primitive\n            actions.append(USE)\n            \n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_path(target_pos, start_pos):\n    # Simple BFS to find the shortest path from start_pos to target_pos\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n        current_pos = queue.popleft()\n\n        if current_pos == target_pos:\n            break\n\n        for dx, dy in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n            neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n\n            if (neighbor_pos not in visited and\n                0 <= neighbor_pos[0] < env._current_state.grid.shape[0] and\n                0 <= neighbor_pos[1] < env._current_state.grid.shape[1]):\n                \n                queue.append(neighbor_pos)\n                visited.add(neighbor_pos)\n                parent[neighbor_pos] = current_pos\n\n    path = []\n    while target_pos is not None:\n        path.append(target_pos)\n        target_pos = parent[target_pos]\n\n    return path[::-1]  # Reverse the path to get from start to target\n\n  def follow_path(path):\n    actions = []\n\n    for i in range(1, len(path)):\n        x_dir = np.sign(path[i][0] - path[i-1][0])\n        y_dir = np.sign(path[i][1] - path[i-1][1])\n\n        if x_dir < 0 and y_dir == 0:\n            actions.append(LEFT)\n        elif x_dir > 0 and y_dir == 0:\n            actions.append(RIGHT)\n        elif x_dir == 0 and y_dir < 0:\n            actions.append(DOWN)\n        elif x_dir == 0 and y_dir > 0:\n            actions.append(UP)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    # Gather the required primitives\n    primitive_indices = list(primitives_needed.keys())\n    actions.extend(gather_primitives(primitive_indices))\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n\n    if workshop_position:\n        # Compute the path to reach the workshop\n        path_to_workshop = compute_path(workshop_position, env._current_state.pos)\n\n        # Follow the computed path\n        actions.extend(follow_path(path_to_workshop))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:17:19.098672", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    # Gather all required primitives first\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_positions = find_all_instances(primitive, env._current_state.grid)\n        \n        if nearest_primitive_positions:\n            for _ in range(count):\n                x_dir, y_dir = compute_direction(nearest_primitive_positions[0], env._current_state.pos)\n\n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n                \n                # Update grid after gathering the primitive\n                nearest_primitive_positions.pop(0)\n                if not nearest_primitive_positions:\n                    break\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_all_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    \n    if not positions:\n        return None\n    \n    agent_position = np.array(env._current_state.pos)\n    distances = [np.linalg.norm(np.array(pos) - agent_position) for pos in positions]\n    \n    sorted_positions = [pos for _, pos in sorted(zip(distances, positions))]\n    return sorted_positions\n\n  def find_nearest_workshop(workshop_type, grid):\n    workshop_index = env.world.cookbook.index[workshop_type]\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir, y_dir = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    if x_dir < 0:\n        x_action = LEFT\n    elif x_dir > 0:\n        x_action = RIGHT\n    else:\n        x_action = None\n\n    if y_dir < 0:\n        y_action = DOWN\n    elif y_dir > 0:\n        y_action = UP\n    else:\n        y_action = None\n    \n    return x_action, y_action\n\n  def move_to(x_action, y_action):\n    actions = []\n\n    # Prioritize moving in the X direction if both directions are required\n    if x_action:\n        actions.append(x_action)\n    \n    if y_action:\n        actions.append(y_action)\n\n    return actions\n  \n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:17:20.061914", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    # Gather all required primitives first\n    for primitive, count in primitives_needed.items():\n        # Find the nearest instance of each required primitive\n        for _ in range(count): \n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = target_pos[0] - current_pos[0]\n    y_dir = target_pos[1] - current_pos[1]\n\n    # Determine actions based on direction\n    if x_dir > 0:\n        x_action = RIGHT\n    elif x_dir < 0:\n        x_action = LEFT\n    else:\n        x_action = None\n\n    if y_dir > 0:\n        y_action = UP\n    elif y_dir < 0:\n        y_action = DOWN\n    else:\n        y_action = None\n    \n    return x_action, y_action\n\n  def move_to(x_action, y_action):\n    actions = []\n\n    # Prioritize moving in the X direction if both directions are required\n    if x_action is not None:\n        actions.append(x_action)\n    \n    if y_action is not None:\n        actions.append(y_action)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:20:02.872807", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles cases where the agent might need to reorient itself to face different \n      directions while gathering items.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Turn and move to the position of the primitive\n                actions.extend(turn_and_move(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    \n    if isinstance(workshop_type, list):\n        workshop_types = workshop_type  # If multiple workshops are possible, consider all\n    else:\n        workshop_types = [workshop_type]  # Otherwise, just use the single type\n    \n    workshop_positions = []\n    for w_type in workshop_types:\n        position = find_nearest_workshop(w_type, env._current_state.grid)\n        if position is not None:\n            workshop_positions.append(position)\n\n    if workshop_positions:\n        closest_workshop_position = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n        x_dir, y_dir = compute_direction(closest_workshop_position, env._current_state.pos)\n        \n        # Turn and move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:20:03.884658", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory.get(primitive, 0) < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instances of item '{primitive}' found in the grid.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Turn and move to the position of the primitive\n            actions.extend(turn_and_move(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No workshop of type '{workshop_type}' found in the grid.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Turn and move to the position of the workshop\n    actions.extend(turn_and_move(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:23:54.995901", "function_name": "make_arrow", "function_body": "  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n    \n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        primitive_index = env.world.cookbook.index[primitive]\n        if primitive_index is None:\n            raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n        \n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                # Turn towards the target position\n                actions.extend(turn_to_face(nearest_primitive_position, env._current_state.pos))\n\n                # Move to the position of the primitive and face it\n                actions.extend(move_towards(nearest_primitive_position[0], nearest_primitive_position[1]))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_type]\n    if workshop_index is None:\n        raise ValueError(f\"Workshop type '{workshop_type}' not found in the cookbook.\")\n    \n    workshop_position = find_nearest_workshop(workshop_index, env._current_state.grid)\n    \n    if workshop_position:\n        # Turn towards the target position\n        actions.extend(turn_to_face(workshop_position, env._current_state.pos))\n\n        # Move to the position of the workshop and face it\n        actions.extend(move_towards(workshop_position[0], workshop_position[1]))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_index, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_index: The index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return (x_dir, y_dir)\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified \n      (x, y) position. It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos[0] != target_x or current_pos[1] != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), current_pos)\n        \n        # Move in the x-direction if needed\n        if x_dir < 0 and current_pos[1] == target_y:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0 and current_pos[1] == target_y:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0 and current_pos[0] == target_x:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0 and current_pos[0] == target_x:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(target_position, current_position):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target position. It assumes that the environment has a way to \n      determine and change the agent's current facing direction.\n\n      Args:\n        target_position: A tuple representing the (x, y) coordinates of the target position.\n        current_position: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the \n                   specified target position.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = compute_direction(target_position, current_position)\n\n    # Mapping from (current_direction, target_direction) to actions\n    direction_map = {\n        ((0, 1), (-1, 0)): [DOWN],         # From UP to DOWN\n        ((0, 1), (0, -1)): [LEFT],          # From UP to LEFT\n        ((0, 1), (0, 1)): [],               # Already facing RIGHT\n        ((-1, 0), (0, 1)): [UP],            # From DOWN to RIGHT\n        ((-1, 0), (0, -1)): [LEFT],         # From DOWN to LEFT\n        ((-1, 0), (-1, 0)): [],             # Already facing DOWN\n        ((0, -1), (0, 1)): [UP],            # From LEFT to RIGHT\n        ((0, -1), (-1, 0)): [DOWN],         # From LEFT to DOWN\n        ((0, -1), (0, -1)): [],             # Already facing LEFT\n        ((1, 0), (0, 1)): [UP],            # From RIGHT to UP\n        ((1, 0), (-1, 0)): [DOWN],         # From RIGHT to DOWN\n        ((1, 0), (1, 0)): [],               # Already facing RIGHT\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:23:55.960873", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n                # Turn towards the target direction\n                actions.extend(turn_to_face(x_dir, y_dir))\n\n                # Move to the position of the primitive and face it\n                actions.extend(move_towards(nearest_primitive_position[0], nearest_primitive_position[1]))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Turn towards the target direction\n        actions.extend(turn_to_face(x_dir, y_dir))\n\n        # Move to the position of the workshop and face it\n        actions.extend(move_towards(workshop_position[0], workshop_position[1]))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified \n      (x, y) position. It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos[0] != target_x or current_pos[1] != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), current_pos)\n        \n        # Move in the x-direction if needed\n        if x_dir < 0 and current_pos[1] == target_y:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0 and current_pos[1] == target_y:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0 and current_pos[0] == target_x:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0 and current_pos[0] == target_x:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target direction. It assumes that the environment has a way to \n      determine and change the agent's current facing direction.\n\n      Args:\n        x_dir: The desired x direction (-1, 0, or 1).\n        y_dir: The desired y direction (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the \n                   specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = (x_dir, y_dir)\n\n    # Define a mapping from current and target directions to required actions\n    direction_map = {\n        ((0, 1), (-1, 0)): [DOWN],         # From UP to DOWN\n        ((0, 1), (0, -1)): [LEFT],          # From UP to LEFT\n        ((0, 1), (0, 1)): [],               # Already facing RIGHT\n        ((0, 1), (1, 0)): [RIGHT],         # From UP to RIGHT\n\n        ((-1, 0), (-1, 0)): [],             # Already facing DOWN\n        ((-1, 0), (0, -1)): [LEFT],          # From DOWN to LEFT\n        ((-1, 0), (0, 1)): [RIGHT],         # From DOWN to RIGHT\n        ((-1, 0), (1, 0)): [UP],            # From DOWN to UP\n\n        ((0, -1), (-1, 0)): [DOWN],         # From LEFT to DOWN\n        ((0, -1), (0, -1)): [],             # Already facing LEFT\n        ((0, -1), (0, 1)): [UP, RIGHT],     # From LEFT to UP\n        ((0, -1), (1, 0)): [RIGHT],         # From LEFT to RIGHT\n\n        ((0, 1), (-1, 0)): [DOWN],          # From RIGHT to DOWN\n        ((0, 1), (0, -1)): [LEFT],          # From RIGHT to LEFT\n        ((0, 1), (0, 1)): [],               # Already facing RIGHT\n        ((0, 1), (1, 0)): [UP],             # From RIGHT to UP\n\n        ((1, 0), (-1, 0)): [DOWN, LEFT],    # From UP to DOWN (reversed)\n        ((1, 0), (0, -1)): [LEFT],          # From UP to LEFT (reversed)\n        ((1, 0), (0, 1)): [RIGHT],         # From UP to RIGHT (reversed)\n        ((1, 0), (1, 0)): [],               # Already facing UP\n\n        ((-1, 0), (-1, 0)): [],             # Already facing DOWN\n        ((-1, 0), (0, -1)): [UP],           # From DOWN to LEFT (reversed)\n        ((-1, 0), (0, 1)): [DOWN],          # From DOWN to RIGHT (reversed)\n        ((-1, 0), (1, 0)): [LEFT],          # From DOWN to UP (reversed)\n\n        ((0, -1), (-1, 0)): [RIGHT],        # From LEFT to DOWN (reversed)\n        ((0, -1), (0, -1)): [],             # Already facing LEFT\n        ((0, -1), (0, 1)): [LEFT],          # From LEFT to UP (reversed)\n        ((0, -1), (1, 0)): [DOWN],          # From LEFT to RIGHT (reversed)\n\n        ((1, 0), (-1, 0)): [UP],            # From RIGHT to DOWN (reversed)\n        ((1, 0), (0, -1)): [RIGHT],         # From RIGHT to LEFT (reversed)\n        ((1, 0), (0, 1)): [LEFT],           # From RIGHT to UP (reversed)\n        ((1, 0), (1, 0)): [],               # Already facing DOWN\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  def main():\n      # Assuming the goal item is at index 5 in the cookbook\n      goal_index = 5\n\n      actions_to_craft = gather_and_craft(goal_index)\n      \n      print(\"Actions to craft the item:\", actions_to_craft)\n\n  if __name__ == \"__main__\":\n      main()", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:25:58.817657", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather all required primitives.\n\n      Args:\n        primitives_needed: A dictionary with item indices as keys and counts as values.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive)\n            \n            if nearest_primitive_position is not None:\n                x_dir, y_dir = compute_direction(nearest_primitive_position)\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    return actions\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to move to and use the nearest workshop.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        List[int]: A list of actions to craft the item.\n    \"\"\"\n    actions = []\n    \n    workshop_position = find_nearest_workshop(workshop_type)\n    \n    if workshop_position is not None:\n        x_dir, y_dir = compute_direction(workshop_position)\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the current environment.\n\n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a specified type in the current environment.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  # Gather primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Craft item\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  actions.extend(craft_item(workshop_type))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:25:59.788864", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather all required primitives.\n\n      Args:\n        primitives_needed: A dictionary with item indices as keys and counts as values.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive)\n            \n            if nearest_primitive_position is not None:\n                x_dir, y_dir = compute_direction(nearest_primitive_position)\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    return actions\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to move to and use the nearest workshop.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        List[int]: A list of actions to craft the item.\n    \"\"\"\n    actions = []\n    \n    workshop_position = find_nearest_workshop(workshop_type)\n    \n    if workshop_position is not None:\n        x_dir, y_dir = compute_direction(workshop_position)\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the current environment.\n\n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a specified type in the current environment.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  # Gather primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Craft item\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  actions.extend(craft_item(workshop_type))\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:28:31.124808", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Align agent direction with target direction\n            actions.extend(align_direction(x_dir, y_dir))\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Align agent direction with target direction\n        actions.extend(align_direction(x_dir, y_dir))\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def align_direction(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to align the agent's facing direction \n      with the target direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to align the agent's facing direction with the target direction.\n    \"\"\"\n    current_direction = env._current_state.direction\n    actions = []\n\n    # Calculate the required changes in x and y directions\n    dx = np.sign(x_dir)\n    dy = np.sign(y_dir)\n\n    # Determine the target direction as a tuple (x, y) where one of the values is 0 and the other is -1 or 1\n    if dx == 0:\n        target_direction = (0, dy)\n    else:\n        target_direction = (dx, 0)\n\n    # Calculate the difference between the current direction and the target direction\n    diff_x = np.sign(target_direction[0] - current_direction[0])\n    diff_y = np.sign(target_direction[1] - current_direction[1])\n\n    # Generate actions to align the agent's facing direction with the target direction\n    if diff_x < 0:\n        actions.append(LEFT)\n    elif diff_x > 0:\n        actions.append(RIGHT)\n\n    if diff_y < 0:\n        actions.append(DOWN)\n    elif diff_y > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:28:32.081467", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    if positions.size == 0:\n        return None\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if positions.size == 0:\n        return None\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n      actions = []\n      if x_dir < 0 and y_dir == 0:\n          actions.append(LEFT)\n      elif x_dir > 0 and y_dir == 0:\n          actions.append(RIGHT)\n      elif x_dir == 0 and y_dir < 0:\n          actions.append(DOWN)\n      elif x_dir == 0 and y_dir > 0:\n          actions.append(UP)\n\n      # Optionally add a USE action to confirm the movement\n      actions.append(USE)\n      \n      return actions\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def face_towards(target_pos, current_pos):\n      x_diff = target_pos[0] - current_pos[0]\n      y_diff = target_pos[1] - current_pos[1]\n\n      if x_diff < 0:\n          return LEFT\n      elif x_diff > 0:\n          return RIGHT\n      elif y_diff < 0:\n          return DOWN\n      else: # y_diff > 0\n          return UP\n\n  def move_towards(target_pos, current_pos):\n      actions = []\n      \n      target_x, target_y = target_pos\n      current_x, current_y = current_pos\n      \n      while current_x != target_x or current_y != target_y:\n          if current_x < target_x:\n              actions.append(RIGHT)\n              current_x += 1\n          elif current_x > target_x:\n              actions.append(LEFT)\n              current_x -= 1\n          \n          if current_y < target_y:\n              actions.append(UP)\n              current_y += 1\n          elif current_y > target_y:\n              actions.append(DOWN)\n              current_y -= 1\n      \n      return actions\n\n  def gather_and_craft_v2(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Move to the position of the primitive\n            actions.extend(move_towards(nearest_primitive_position, env._current_state.pos))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Move to the position of the workshop\n        actions.extend(move_towards(workshop_position, env._current_state.pos))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft_v2(goal_index)\n  \n  return actions", "island_id": 7, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:31:14.684604", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index: int, grid: np.ndarray, current_pos: tuple) -> tuple:\n      \"\"\"\n      Finds the nearest instance of an item in the given grid.\n\n      Args:\n          item_index (int): The index of the item to be found.\n          grid (np.ndarray): A numpy array representing the current state of the grid world.\n          current_pos (tuple): A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n          tuple: The (x, y) coordinates of the nearest instance of the item. \n                 If no instance is found, returns None.\n      \"\"\"\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      if positions.size == 0:\n          return None\n      distances = np.linalg.norm(positions - current_pos, axis=1)\n      nearest_index = np.argmin(distances)\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type: str, grid: np.ndarray, current_pos: tuple) -> tuple:\n      \"\"\"\n      Finds the nearest workshop of a given type in the provided grid.\n\n      Args:\n          workshop_type (str): The name representing the type of workshop to be found.\n          grid (np.ndarray): A numpy array representing the current state of the grid world.\n          current_pos (tuple): A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n          tuple: The (x, y) coordinates of the nearest workshop of the specified type. \n                 If no such workshop is found, returns None.\n      \"\"\"\n      try:\n          workshop_index = env.world.cookbook.index[workshop_type]\n      except KeyError:\n          return None\n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      if positions.size == 0:\n          return None\n      distances = np.linalg.norm(positions - current_pos, axis=1)\n      nearest_index = np.argmin(distances)\n      return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos: tuple, current_pos: tuple) -> tuple:\n      \"\"\"\n      Computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n          target_pos (tuple): A tuple representing the (x, y) coordinates of the target position.\n          current_pos (tuple): A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n          tuple: The (x, y) direction vector needed to move from the current position \n                 towards the target position. Values are -1, 0, or 1 indicating the \n                 direction in each axis.\n      \"\"\"\n      x_dir = np.sign(target_pos[0] - current_pos[0])\n      y_dir = np.sign(target_pos[1] - current_pos[1])\n      return x_dir, y_dir\n\n  def generate_movement_actions(x_dir: int, y_dir: int) -> list:\n      \"\"\"\n      Generates a sequence of actions to move the agent in the specified direction.\n\n      Args:\n          x_dir (int): The desired change in x position (-1, 0, or 1).\n          y_dir (int): The desired change in y position (-1, 0, or 1).\n\n      Returns:\n          list: A list of actions to move the agent in the specified direction.\n      \"\"\"\n      actions = []\n      if x_dir < 0:\n          actions.append(LEFT)\n      elif x_dir > 0:\n          actions.append(RIGHT)\n      if y_dir < 0:\n          actions.append(DOWN)\n      elif y_dir > 0:\n          actions.append(UP)\n      return actions\n\n  def turn_and_move_to(target_pos: tuple, current_state: craft.CraftLabState) -> list:\n      \"\"\"\n      Generates a sequence of actions to turn the agent towards the specified direction\n      and then move in that direction.\n\n      Args:\n          target_pos (tuple): A tuple representing the (x, y) coordinates of the target position.\n          current_state (craft.CraftLabState): The current state of the environment.\n\n      Returns:\n          list: A list of actions to turn the agent towards the specified direction and move.\n      \"\"\"\n      current_pos = current_state.agent_position\n      x_dir, y_dir = compute_direction(target_pos, current_pos)\n      \n      # Determine the target facing direction based on the movement vector\n      if x_dir < 0:\n          target_direction = LEFT\n      elif x_dir > 0:\n          target_direction = RIGHT\n      elif y_dir < 0:\n          target_direction = DOWN\n      elif y_dir > 0:\n          target_direction = UP\n      else:\n          return []  # No movement needed\n\n      current_direction = current_state.agent_facing_direction\n      \n      # Calculate the difference in direction\n      direction_diff = (target_direction - current_direction) % 4\n      \n      actions = []\n      \n      if direction_diff == 1:\n          actions.append(RIGHT)\n      elif direction_diff == 2:\n          actions.extend([RIGHT, RIGHT])\n      elif direction_diff == 3:\n          actions.append(LEFT)\n\n      # Add movement actions\n      actions.extend(generate_movement_actions(x_dir, y_dir))\n      \n      return actions\n\n  def gather_and_craft(goal_index: int) -> list:\n      \"\"\"\n      Gathers the required primitives to craft an item and crafts it.\n\n      Args:\n          goal_index (int): The index of the item to be crafted.\n\n      Returns:\n          list: A list of actions to gather primitives and craft the item.\n      \"\"\"\n      # Fetch required primitives for the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n      \n      # Initialize action sequence\n      actions = []\n\n      # Gather each required primitive\n      for primitive, count in primitives_needed.items():\n          for _ in range(count):\n              # Find the nearest instance of the primitive\n              nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid, env._current_state.agent_position)\n              \n              if nearest_primitive_position:\n                  # Generate actions to turn and move towards the primitive\n                  actions.extend(turn_and_move_to(nearest_primitive_position, env._current_state))\n                  \n                  # Use action to gather the primitive\n                  actions.append(USE)\n\n      # Find the nearest workshop for crafting the item\n      workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n      workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid, env._current_state.agent_position)\n      \n      if workshop_position:\n          # Generate actions to turn and move towards the workshop\n          actions.extend(turn_and_move_to(workshop_position, env._current_state))\n          \n          # Use action to craft the item at the workshop\n          actions.append(USE)\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  try:\n      goal_index = env.world.cookbook.index[goal_item]\n  except KeyError:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:31:15.650796", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index: int, grid: np.ndarray, current_pos: tuple) -> tuple:\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for all cells containing the item and returns the position \n      of the closest one.\n\n      Args:\n        item_index (int): The index of the item to be found.\n        grid (np.ndarray): A numpy array representing the current state of the grid world.\n        current_pos (tuple): A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        tuple: The (x, y) coordinates of the nearest instance of the item. \n               If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type: str, grid: np.ndarray, current_pos: tuple) -> tuple:\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position \n      of the closest one.\n\n      Args:\n        workshop_type (str): The name representing the type of workshop to be found.\n        grid (np.ndarray): A numpy array representing the current state of the grid world.\n        current_pos (tuple): A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        tuple: The (x, y) coordinates of the nearest workshop of the specified type. \n               If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos: tuple, current_pos: tuple) -> tuple:\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos (tuple): A tuple representing the (x, y) coordinates of the target position.\n        current_pos (tuple): A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        tuple: The (x, y) direction vector needed to move from the current position \n               towards the target position. Values are -1, 0, or 1 indicating the \n               direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move_to(x_dir: int, y_dir: int) -> list:\n    \"\"\"\n      This function generates a sequence of actions to turn the agent towards the specified direction\n      and then move in that direction.\n\n      Args:\n        x_dir (int): The desired change in x position (-1, 0, or 1).\n        y_dir (int): The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        list: A list of actions to turn the agent towards the specified direction and move.\n    \"\"\"\n    actions = []\n\n    # Determine the target direction\n    if x_dir < 0 and y_dir == 0:\n        target_direction = LEFT\n    elif x_dir > 0 and y_dir == 0:\n        target_direction = RIGHT\n    elif x_dir == 0 and y_dir < 0:\n        target_direction = DOWN\n    elif x_dir == 0 and y_dir > 0:\n        target_direction = UP\n\n    # Calculate the difference in direction\n    current_direction = env._current_state.dir\n    direction_diff = (target_direction - current_direction) % 4\n\n    if direction_diff == 1:\n        actions.append(RIGHT)\n    elif direction_diff == 2:\n        actions.extend([RIGHT, RIGHT])\n    elif direction_diff == 3:\n        actions.append(LEFT)\n\n    # Add the movement action\n    actions.append(target_direction)\n\n    return actions\n\n  def gather_and_craft(goal_index: int) -> list:\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index (int): The index of the item to be crafted.\n\n      Returns:\n        list: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid, env._current_state.pos)\n            \n            if nearest_primitive_position:\n                # Compute direction to move towards the primitive\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Turn and move to the position of the primitive\n                actions.extend(turn_and_move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid, env._current_state.pos)\n    \n    if workshop_position:\n        # Compute direction to move towards the workshop\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Turn and move to the position of the workshop\n        actions.extend(turn_and_move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-30T18:34:20.450513", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def compute_direction(current_pos, target_pos):\n    \"\"\"\n      Computes the direction needed to move from current position to target position.\n\n      Args:\n        current_pos (tuple): Current position as a tuple (x, y).\n        target_pos (tuple): Target position as a tuple (x, y).\n\n      Returns:\n        tuple: Direction vector (-1, 0, or 1) for both x and y.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n    return (x_dir, y_dir)\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      Generates actions to move towards the specified target position.\n\n      Args:\n        target_x (int): X coordinate of the target.\n        target_y (int): Y coordinate of the target.\n\n      Returns:\n        list: List of actions to reach the target position.\n    \"\"\"\n    actions = []\n    current_pos = env._current_state.pos\n\n    while current_pos != (target_x, target_y):\n        x_dir, y_dir = compute_direction(current_pos, (target_x, target_y))\n        \n        # Move in the x-direction if needed\n        if x_dir < 0:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(target_direction):\n      \"\"\"\n      Generates actions to rotate the agent's facing direction towards the specified target direction.\n  \n      Args:\n        target_direction (tuple): Target direction vector (-1, 0, or 1) for both x and y.\n  \n      Returns:\n        list: List of actions to rotate the agent's facing direction.\n      \"\"\"\n      current_direction = env._current_state.dir\n      action_sequence = []\n      \n      # Mapping from current direction to target direction with corresponding actions\n      turn_map = {\n          ((0, 1), (-1, 0)): [DOWN],         # From UP to DOWN\n          ((0, 1), (0, -1)): [LEFT],          # From UP to LEFT\n          ((0, 1), (1, 0)): [RIGHT],         # From UP to RIGHT\n          ((-1, 0), (0, 1)): [UP],            # From DOWN to UP\n          ((-1, 0), (0, -1)): [LEFT],          # From DOWN to LEFT\n          ((-1, 0), (1, 0)): [RIGHT],         # From DOWN to RIGHT\n          ((0, -1), (0, 1)): [UP, RIGHT],     # From LEFT to UP\n          ((0, -1), (-1, 0)): [DOWN, RIGHT],   # From LEFT to DOWN\n          ((0, -1), (1, 0)): [RIGHT],         # From LEFT to RIGHT\n          ((1, 0), (0, 1)): [UP, LEFT],      # From RIGHT to UP\n          ((1, 0), (-1, 0)): [DOWN, LEFT],    # From RIGHT to DOWN\n          ((1, 0), (0, -1)): [LEFT],          # From RIGHT to LEFT\n          ((0, 1), (0, 1)): [],              # No change needed\n          ((-1, 0), (-1, 0)): [],            # No change needed\n          ((0, -1), (0, -1)): [],            # No change needed\n          ((1, 0), (1, 0)): []               # No change needed\n      }\n      \n      action_sequence.extend(turn_map.get((current_direction, target_direction), []))\n      return action_sequence\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      Finds the nearest instance of an item in the grid.\n  \n      Args:\n        item_index (int): Index of the item to find.\n  \n      Returns:\n        tuple: Coordinates of the nearest item or None if not found.\n      \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    if positions.size == 0:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n    \n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n      \"\"\"\n      Finds the nearest workshop of a given type in the grid.\n  \n      Args:\n        workshop_type (str): Type of the workshop to find.\n  \n      Returns:\n        tuple: Coordinates of the nearest workshop or None if not found.\n      \"\"\"\n      workshop_index = env.world.cookbook.index[workshop_type]\n      return find_nearest_instance(workshop_index)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      Generates actions to gather required primitives and craft the goal item.\n  \n      Args:\n        goal_item (str): Name of the item to craft.\n  \n      Returns:\n        list: List of actions to achieve the crafting objective.\n      \"\"\"", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:34:21.443637", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified \n      (x, y) position. It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos[0] != target_x or current_pos[1] != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), current_pos)\n        \n        # Turn to face the direction of movement if needed\n        actions.extend(turn_to_face(x_dir, y_dir))\n        \n        # Move in the x-direction if needed\n        if x_dir < 0 and current_pos[1] == target_y:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0 and current_pos[1] == target_y:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0 and current_pos[0] == target_x:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0 and current_pos[0] == target_x:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target direction. It assumes that the environment has a way to \n      determine and change the agent's current facing direction.\n\n      Args:\n        x_dir: The desired x direction (-1, 0, or 1).\n        y_dir: The desired y direction (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the \n                   specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = (x_dir, y_dir)\n\n    # Mapping from current_direction to target_direction based on agent's initial orientation\n    direction_map = {\n        ((0, 1), (-1, 0)): [DOWN],         # From UP to DOWN\n        ((0, 1), (0, -1)): [LEFT],          # From UP to LEFT\n        ((0, 1), (0, 1)): [],               # From UP to RIGHT\n        ((-1, 0), (0, 1)): [UP],            # From DOWN to UP\n        ((-1, 0), (0, -1)): [LEFT],          # From DOWN to LEFT\n        ((-1, 0), (1, 0)): [],               # From DOWN to RIGHT\n        ((0, -1), (0, 1)): [UP],            # From LEFT to UP\n        ((0, -1), (-1, 0)): [],              # From LEFT to DOWN\n        ((0, -1), (1, 0)): [RIGHT],         # From LEFT to RIGHT\n        ((1, 0), (0, 1)): [UP],            # From RIGHT to UP\n        ((1, 0), (-1, 0)): [DOWN],          # From RIGHT to DOWN\n        ((1, 0), (0, -1)): [],              # From RIGHT to LEFT\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n                # Turn to face the direction of movement\n                actions.extend(turn_to_face(x_dir, y_dir))\n\n                # Move towards the primitive and gather it\n                actions.extend(move_towards(nearest_primitive_position[0], nearest_primitive_position[1]))\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Turn to face the direction of movement\n        actions.extend(turn_to_face(x_dir, y_dir))\n\n        # Move towards the workshop and craft the item\n        actions.extend(move_towards(workshop_position[0], workshop_position[1]))\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:36:48.719885", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather all required primitives.\n\n      Args:\n        primitives_needed: A dictionary with item indices as keys and counts as values.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive)\n            \n            if nearest_primitive_position is not None:\n                x_dir, y_dir = compute_direction(nearest_primitive_position)\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    return actions\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to move to and use the nearest workshop.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        List[int]: A list of actions to craft the item.\n    \"\"\"\n    actions = []\n    \n    workshop_position = find_nearest_instance(workshop_type)\n    \n    if workshop_position is not None:\n        x_dir, y_dir = compute_direction(workshop_position)\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the current environment.\n\n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def find_workshop_type(goal_item):\n    \"\"\"\n      This function finds the type of workshop required for crafting a specific item.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        Any: The type of workshop needed for crafting the item.\n    \"\"\"\n    recipe = env.world.cookbook.recipes[goal_item]\n    \n    if \"_at\" in recipe:\n        return recipe[\"_at\"]\n    else:\n        raise ValueError(f\"No workshop specified for item '{goal_item}'.\")\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_item)\n  \n  # Gather primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Determine workshop type and craft item\n  workshop_type = find_workshop_type(goal_item)\n  actions.extend(craft_item(workshop_type))\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:36:49.697742", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather all required primitives.\n\n      Args:\n        primitives_needed: A dictionary with item indices as keys and counts as values.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive)\n            \n            if nearest_primitive_position is not None:\n                x_dir, y_dir = compute_direction(nearest_primitive_position)\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    return actions\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to move to and use the nearest workshop.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        List[int]: A list of actions to craft the item.\n    \"\"\"\n    actions = []\n    \n    workshop_position = find_nearest_workshop(workshop_type)\n    \n    if workshop_position is not None:\n        x_dir, y_dir = compute_direction(workshop_position)\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the current environment.\n\n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a specified type in the current environment.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def rotate_towards_direction(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent towards the specified direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent towards the specified direction.\n    \"\"\"\n    current_direction = env._current_state.direction\n    target_direction = np.arctan2(y_dir, x_dir) * 180 / np.pi\n\n    # Convert current_direction from enum to angle in degrees\n    if current_direction == (1, 0):   # RIGHT\n        current_angle = 90\n    elif current_direction == (-1, 0): # LEFT\n        current_angle = -90\n    elif current_direction == (0, 1):   # UP\n        current_angle = 0\n    elif current_direction == (0, -1):  # DOWN\n        current_angle = 180\n\n    # Calculate the difference in angles\n    angle_diff = target_direction - current_angle\n\n    # Normalize the angle difference to be within [-180, 180]\n    angle_diff = (angle_diff + 180) % 360 - 180\n\n    actions = []\n\n    if angle_diff > 0:\n        # Turn right\n        actions.append(RIGHT_TURN)\n    elif angle_diff < 0:\n        # Turn left\n        actions.append(LEFT_TURN)\n\n    return actions\n\n  def move_towards_direction(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified direction.\n      It includes both rotation and movement.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified direction.\n    \"\"\"\n    actions = []\n\n    # Rotate the agent towards the target direction\n    actions.extend(rotate_towards_direction(x_dir, y_dir))\n    \n    # Move in the target direction\n    actions.append(MOVE_FORWARD)\n\n    return actions\n\n  # Define additional action constants\n  RIGHT_TURN = 6  # Example action for turning right\n  LEFT_TURN = 7   # Example action for turning left\n  MOVE_FORWARD = 8# Example action for moving forward\n\n  # Update move_to function to use new rotation and movement logic\n  def move_to(x_dir, y_dir):\n    return move_towards_direction(x_dir, y_dir)\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  # Gather primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Craft item\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  actions.extend(craft_item(workshop_type))\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:40:39.757914", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It considers that the agent might need to turn around or adjust its direction \n      while moving. Additionally, it includes checks for obstacles.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Align the agent's direction with the movement direction\n                actions.extend(align_direction(x_dir, y_dir))\n                \n                # Move to the position of the primitive while checking for obstacles\n                actions.extend(move_to_avoiding_obstacles(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Align the agent's direction with the movement direction\n        actions.extend(align_direction(x_dir, y_dir))\n        \n        # Move to the position of the workshop while checking for obstacles\n        actions.extend(move_to_avoiding_obstacles(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def align_direction(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to align the agent's direction with the \n      specified movement direction. It considers the agent's current direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to align the agent's direction with the specified movement.\n    \"\"\"\n    current_direction = env._current_state.dir\n    actions = []\n\n    # Define mappings from current direction to target direction\n    direction_mapping = {\n        (LEFT, (0, 1)): [UP],\n        (LEFT, (0, -1)): [DOWN],\n        (LEFT, (1, 0)): [],\n        (LEFT, (-1, 0)): [],\n        \n        (RIGHT, (0, 1)): [UP],\n        (RIGHT, (0, -1)): [DOWN],\n        (RIGHT, (-1, 0)): [],\n        (RIGHT, (1, 0)): [],\n        \n        (UP, (-1, 0)): [LEFT],\n        (UP, (1, 0)): [RIGHT],\n        (UP, (0, -1)): [],\n        (UP, (0, 1)): [],\n        \n        (DOWN, (-1, 0)): [LEFT],\n        (DOWN, (1, 0)): [RIGHT],\n        (DOWN, (0, 1)): [],\n        (DOWN, (0, -1)): []\n    }\n    \n    # Get the actions needed to align current direction with target\n    key = (current_direction, (x_dir, y_dir))\n    if key in direction_mapping:\n        actions.extend(direction_mapping[key])\n\n    return actions\n\n  def move_to_avoiding_obstacles(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction \n      while avoiding obstacles. It assumes that the agent's facing direction is aligned with the \n      movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction while avoiding obstacles.\n    \"\"\"\n    actions = []\n    current_pos = env._current_state.pos\n    grid = env._current_state.grid\n\n    # Calculate target position\n    target_pos = (current_pos[0] + x_dir, current_pos[1] + y_dir)\n\n    # Check if the target position is clear of obstacles\n    while not is_position_clear(target_pos, grid):\n        # If an obstacle is found, turn to avoid it\n        actions.append(find_avoidance_turn(x_dir, y_dir))\n        \n        # Update direction based on the avoidance turn\n        x_dir, y_dir = rotate_direction((x_dir, y_dir), 90)\n        \n        # Recalculate target position after turning\n        target_pos = (current_pos[0] + x_dir, current_pos[1] + y_dir)\n\n    # Move in the specified direction if the path is clear\n    actions.extend(move_to(x_dir, y_dir))\n    \n    return actions\n\n  def find_avoidance_turn(x_dir, y_dir):\n    \"\"\"\n      This function determines the turn action needed to avoid an obstacle. It assumes that \n      the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The current change in x position (-1, 0, or 1).\n        y_dir: The current change in y position (-1, 0, or 1).\n\n      Returns:\n        int: The action needed to turn and avoid an obstacle.\n    \"\"\"\n    # Define turn actions based on the current direction\n    turn_mapping = {\n        (LEFT, 0): RIGHT,\n        (RIGHT, 0): LEFT,\n        (UP, 0): DOWN,\n        (DOWN, 0): UP\n    }\n    \n    key = (env._current_state.dir, x_dir)\n    if key in turn_mapping:\n        return turn_mapping[key]\n    \n    return NO_ACTION\n\n  def rotate_direction(direction, degrees):\n    \"\"\"\n      This function rotates a direction vector by the specified number of degrees.\n\n      Args:\n        direction: A tuple representing the current direction vector (x, y).\n        degrees: The angle by which to rotate the direction vector in degrees.\n\n      Returns:\n        Tuple[int, int]: The new direction vector after rotation.\n    \"\"\"\n    x, y = direction\n    \n    if degrees == 90:\n        return -y, x\n    elif degrees == 180:\n        return -x, -y\n    elif degrees == 270:\n        return y, -x\n    else:\n        raise ValueError(\"Unsupported rotation angle\")\n\n  def is_position_clear(position, grid):\n    \"\"\"\n      This function checks if a given position on the grid is clear of obstacles.\n\n      Args:\n        position: A tuple representing the (x, y) coordinates of the position to check.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        bool: True if the position is clear; False otherwise.\n    \"\"\"\n    # Check if the position is within bounds\n    if not (0 <= position[0] < grid.shape[0] and 0 <= position[1] < grid.shape[1]):\n        return False\n    \n    # Check if the position contains any obstacles\n    if np.any(grid[position[0], position[1]] > 0):\n        return False\n    \n    return True\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n    \n    if x_dir == -1:\n        actions.append(LEFT)\n    elif x_dir == 1:\n        actions.append(RIGHT)\n    \n    if y_dir == -1:\n        actions.append(DOWN)\n    elif y_dir == 1:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage\n  goal_item_name = \"wood\"  # Replace with the actual name of the item you want to craft\n  goal_index = env.world.cookbook.index[goal_item_name]\n  crafting_actions = gather_and_craft(goal_index)\n  print(crafting_actions)", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:40:40.712923", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It incorporates additional checks and optimizations for efficiency.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Align the agent's direction with the movement direction\n                actions.extend(align_direction(x_dir, y_dir))\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(nearest_primitive_position[0], nearest_primitive_position[1]))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Align the agent's direction with the movement direction\n        actions.extend(align_direction(x_dir, y_dir))\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position[0], workshop_position[1]))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def align_direction(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to align the agent's direction with the \n      specified movement direction. It considers the agent's current direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to align the agent's direction with the specified movement.\n    \"\"\"\n    current_direction = env._current_state.dir\n    actions = []\n\n    # Define mappings from current direction to target direction\n    direction_mapping = {\n        (LEFT, (0, 1)): [UP],\n        (LEFT, (0, -1)): [DOWN],\n        (LEFT, (1, 0)): [],\n        (LEFT, (-1, 0)): [],\n        \n        (RIGHT, (0, 1)): [UP],\n        (RIGHT, (0, -1)): [DOWN],\n        (RIGHT, (-1, 0)): [],\n        (RIGHT, (1, 0)): [],\n        \n        (UP, (-1, 0)): [LEFT],\n        (UP, (1, 0)): [RIGHT],\n        (UP, (0, -1)): [],\n        (UP, (0, 1)): [],\n        \n        (DOWN, (-1, 0)): [LEFT],\n        (DOWN, (1, 0)): [RIGHT],\n        (DOWN, (0, 1)): [],\n        (DOWN, (0, -1)): []\n    }\n    \n    # Get the actions needed to align current direction with target\n    key = (current_direction, (x_dir, y_dir))\n    if key in direction_mapping:\n        actions.extend(direction_mapping[key])\n\n    return actions\n\n  def move_to(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current position \n      to the target position. It assumes that the agent's facing direction is aligned with the \n      movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent from its current position to the target position.\n    \"\"\"\n    actions = []\n    current_pos = env._current_state.pos\n\n    # Determine steps needed in each direction\n    x_diff = target_x - current_pos[0]\n    y_diff = target_y - current_pos[1]\n\n    # Move horizontally if necessary\n    if x_diff < 0:\n        actions.extend([LEFT] * abs(x_diff))\n    elif x_diff > 0:\n        actions.extend([RIGHT] * abs(x_diff))\n\n    # Move vertically if necessary\n    if y_diff < 0:\n        actions.extend([DOWN] * abs(y_diff))\n    elif y_diff > 0:\n        actions.extend([UP] * abs(y_diff))\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:41:54.705604", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if not nearest_primitive_position:\n                break\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n            count -= 1\n            \n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n\n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:41:55.677545", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if not nearest_primitive_position:\n                break\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n            count -= 1\n            \n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n\n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:44:25.272730", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft a specified item and crafts it.\n      \n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch the index of the goal item\n    goal_index = env.world.cookbook.index[goal_item]\n    \n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n    # Fetch required primitives for the goal item\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n      primitive_index = env.world.cookbook.index[primitive]\n      \n      if primitive_index is None:\n        raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n      \n      while env._current_state.inventory[primitive] < count:\n        # Find all instances of the primitive\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n        \n        if primitive_positions.size == 0:\n          raise ValueError(f\"No available instances of '{primitive}' found in the environment.\")\n\n        nearest_position = find_nearest_instance(primitive_positions, env._current_state.pos)\n\n        x_dir, y_dir = compute_direction(nearest_position, env._current_state.pos)\n\n        # Turn and move to the position of the primitive\n        actions.extend(turn_and_move(x_dir, y_dir))\n        \n        # Use action to gather the primitive\n        actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position is None:\n      raise ValueError(f\"No available workshops of type '{workshop_type}' found in the environment.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Turn and move to the position of the workshop\n    actions.extend(turn_and_move(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(positions, current_pos):\n    \"\"\"\n      This function finds the nearest instance from a list of positions.\n      \n      Args:\n        positions: A numpy array of (x, y) coordinates.\n        current_pos: The current position as an (x, y) tuple.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance. \n    \"\"\"\n    distances = np.linalg.norm(positions - current_pos, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      \n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n      return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:44:26.247736", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def compute_target_direction(current_pos, target_pos):\n    \"\"\"\n      Compute the direction needed to move from current position to target position.\n      \n      Args:\n        current_pos: Tuple[int, int] representing the agent's current position (x, y).\n        target_pos: Tuple[int, int] representing the target position (x, y).\n\n      Returns:\n        str: The direction ('UP', 'DOWN', 'LEFT', 'RIGHT') to move.\n    \"\"\"\n    x_diff = target_pos[0] - current_pos[0]\n    y_diff = target_pos[1] - current_pos[1]\n\n    if abs(x_diff) > abs(y_diff):\n        return \"LEFT\" if x_diff < 0 else \"RIGHT\"\n    else:\n        return \"DOWN\" if y_diff < 0 else \"UP\"\n\n  def compute_turn_actions(current_dir, target_direction):\n    \"\"\"\n      Compute the sequence of turn actions needed to face the target direction.\n      \n      Args:\n        current_dir: int representing the agent's current facing direction (0=RIGHT, 1=UP, 2=LEFT, 3=DOWN).\n        target_direction: str representing the target direction ('UP', 'DOWN', 'LEFT', 'RIGHT').\n\n      Returns:\n        List[int]: The sequence of turn actions.\n    \"\"\"\n    target_dir = {'RIGHT': 0, 'UP': 1, 'LEFT': 2, 'DOWN': 3}[target_direction]\n    action_sequence = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            action_sequence.append(RIGHT)\n        else:\n            action_sequence.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    return action_sequence\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      Gather the required primitives and craft the goal item.\n      \n      Args:\n        goal_index: int representing the index of the goal item in the cookbook.\n\n      Returns:\n        List[int]: The sequence of actions to achieve the goal.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        if primitive_index is None:\n            raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                # Compute direction and actions\n                target_direction = compute_target_direction(env._current_state.pos, nearest_primitive_position)\n                turn_actions = compute_turn_actions(env._current_state.dir, target_direction)\n                \n                # Add turn and move actions\n                actions.extend(turn_actions)\n                actions.append(MOVE_ACTIONS[target_direction])\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Compute direction and actions to reach the workshop\n        target_direction = compute_target_direction(env._current_state.pos, workshop_position)\n        turn_actions = compute_turn_actions(env._current_state.dir, target_direction)\n\n        # Add turn and move actions\n        actions.extend(turn_actions)\n        actions.append(MOVE_ACTIONS[target_direction])\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      Find the nearest instance of an item in the given grid.\n      \n      Args:\n        item_index: int representing the index of the item in the cookbook.\n        grid: np.ndarray representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      Find the nearest workshop of a given type in the provided grid.\n      \n      Args:\n        workshop_type: str representing the type of workshop to be found.\n        grid: np.ndarray representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  MOVE_ACTIONS = {\n      \"UP\": UP,\n      \"DOWN\": DOWN,\n      \"LEFT\": LEFT,\n      \"RIGHT\": RIGHT\n  }\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:47:38.784369", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather the required primitives.\n\n      Args:\n        primitives_needed: A dictionary where keys are item indices and values are counts.\n\n      Returns:\n        List[int]: A list of actions to gather the primitives.\n    \"\"\"\n    actions = []\n\n    for primitive_index, count in primitives_needed.items():\n        while env._current_state.inventory[primitive_index] < count:\n            nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instance of item with index {primitive_index} found.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n        if x_dir < 0:\n            actions.append(LEFT)\n            x_dir += 1\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            x_dir -= 1\n        elif y_dir < 0:\n            actions.append(DOWN)\n            y_dir += 1\n        elif y_dir > 0:\n            actions.append(UP)\n            y_dir -= 1\n\n    return actions\n\n  def find_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index if necessary\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n\n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to move to the nearest workshop and \n      craft the desired item.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be used for crafting.\n\n      Returns:\n        List[int]: A list of actions to move to the workshop and use it.\n    \"\"\"\n    # Find the nearest workshop\n    workshop_position = find_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position is None:\n        raise ValueError(f\"No workshop of type '{workshop_type}' found.\")\n\n    # Compute direction to the workshop\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions = move_to(x_dir, y_dir)\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def make_item(item_name):\n    \"\"\"\n      This function orchestrates the process of making a specified item.\n      It gathers the required primitives and crafts the item using the appropriate workshop.\n\n      Args:\n        item_name: The name of the item to be made.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Retrieve the goal index from the cookbook\n    goal_index = env.world.cookbook.index[item_name]\n    \n    if goal_index is None:\n        raise ValueError(f\"Item '{item_name}' not found in the cookbook.\")\n\n    # Fetch required primitives for the goal item\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Gather primitives\n    actions = gather_primitives(primitives_needed)\n\n    # Determine the type of workshop needed to craft the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    \n    # Craft the item using the appropriate workshop\n    actions.extend(craft_item(workshop_type))\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to make the arrow\n  actions = make_item(goal_item)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:52:38.898691", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Turn towards the position of the primitive\n            actions.extend(turn_towards(x_dir, y_dir))\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(nearest_primitive_position[0] - env._current_state.pos[0], nearest_primitive_position[1] - env._current_state.pos[1]))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Turn towards the position of the workshop\n        actions.extend(turn_towards(x_dir, y_dir))\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position[0] - env._current_state.pos[0], workshop_position[1] - env._current_state.pos[1]))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n        if x_dir < 0:\n            actions.append(LEFT)\n            x_dir += 1\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            x_dir -= 1\n        elif y_dir < 0:\n            actions.append(DOWN)\n            y_dir += 1\n        elif y_dir > 0:\n            actions.append(UP)\n            y_dir -= 1\n\n    return actions\n\n  def turn_towards(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent towards the specified direction.\n      It assumes that the agent's facing direction is initially unknown and needs to be aligned \n      with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn the agent towards the specified direction.\n    \"\"\"\n    # Define a mapping from current direction to target direction\n    directions = {\n        (0, 1): RIGHT,  # Facing up, want to move right\n        (0, -1): LEFT,   # Facing down, want to move left\n        (-1, 0): DOWN,   # Facing left, want to move down\n        (1, 0): UP       # Facing right, want to move up\n    }\n\n    current_direction = compute_direction(env._current_state.pos, env._current_state.pos)\n    target_direction = (x_dir, y_dir)\n\n    actions = []\n\n    while current_direction != target_direction:\n        if x_dir == 0 and y_dir > 0:  # Want to face up\n            if current_direction == (-1, 0):  # Facing left\n                actions.append(RIGHT)\n            elif current_direction == (1, 0):   # Facing right\n                actions.append(LEFT)\n            elif current_direction == (0, -1):  # Facing down\n                actions.append(RIGHT)\n                actions.append(RIGHT)\n        elif x_dir > 0 and y_dir == 0:  # Want to face right\n            if current_direction == (-1, 0):  # Facing left\n                actions.append(RIGHT)\n                actions.append(RIGHT)\n            elif current_direction == (0, -1):  # Facing down\n                actions.append(LEFT)\n            elif current_direction == (0, 1):   # Facing up\n                actions.append(RIGHT)\n        elif x_dir == 0 and y_dir < 0:  # Want to face down\n            if current_direction == (-1, 0):  # Facing left\n                actions.append(LEFT)\n            elif current_direction == (1, 0):   # Facing right\n                actions.append(RIGHT)\n            elif current_direction == (0, 1):    # Facing up\n                actions.append(RIGHT)\n                actions.append(RIGHT)\n        elif x_dir < 0 and y_dir == 0:  # Want to face left\n            if current_direction == (-1, 0):  # Facing right\n                actions.append(RIGHT)\n                actions.append(RIGHT)\n            elif current_direction == (0, -1):  # Facing down\n                actions.append(RIGHT)\n            elif current_direction == (0, 1):   # Facing up\n                actions.append(LEFT)\n\n        if actions:\n            env._current_state.pos = move_to(x_dir, y_dir)[-1]\n            current_direction = compute_direction(env._current_state.pos, env._current_state.pos)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n\n  if goal_index is not None:\n      actions = gather_and_craft(goal_index)\n  else:\n      print(f\"Goal item '{goal_item}' not found in the cookbook.\")\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:55:42.989886", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles cases where additional steps might be necessary, such as turning \n      or adjusting the agent's facing direction before moving.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                # Compute direction to move towards the primitive\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive while facing correctly\n                actions.extend(move_to_and_face(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Compute direction to move towards the workshop\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop while facing correctly\n        actions.extend(move_to_and_face(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to_and_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction \n      and ensure that it is facing correctly before performing any action.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction and face correctly.\n    \"\"\"\n    current_direction = env._current_state.dir\n    actions = []\n\n    # Determine which action(s) are needed based on the direction vector and current facing\n    if x_dir < 0 and y_dir == 0:  # LEFT\n        if current_direction != 3:\n            actions.append((4 - (current_direction - 3)) % 4)\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:  # RIGHT\n        if current_direction != 1:\n            actions.append((4 - (current_direction - 1)) % 4)\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:  # DOWN\n        if current_direction != 2:\n            actions.append((4 - (current_direction - 2)) % 4)\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:  # UP\n        if current_direction != 0:\n            actions.append((4 - (current_direction - 0)) % 4)\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T18:55:43.952679", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles cases where additional steps might be necessary, such as turning \n      or adjusting the agent's facing direction before moving.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                # Compute direction to move towards the primitive\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive while facing correctly\n                actions.extend(move_to_and_face(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Compute direction to move towards the workshop\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop while facing correctly\n        actions.extend(move_to_and_face(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to_and_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction \n      and ensure that it is facing correctly before performing any action.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction and face correctly.\n    \"\"\"\n    # Determine which action to take based on the direction vector\n    current_direction = get_current_direction(env._current_state)\n\n    target_actions = []\n    \n    if x_dir < 0 and y_dir == 0:\n        if current_direction != LEFT:\n            target_actions.extend(turn_to(LEFT))\n        target_actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        if current_direction != RIGHT:\n            target_actions.extend(turn_to(RIGHT))\n        target_actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        if current_direction != DOWN:\n            target_actions.extend(turn_to(DOWN))\n        target_actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        if current_direction != UP:\n            target_actions.extend(turn_to(UP))\n        target_actions.append(UP)\n\n    return target_actions\n\n  def get_current_direction(state):\n    \"\"\"\n      This function determines the current direction the agent is facing based on its state.\n\n      Args:\n        state: The current state of the environment containing the agent's orientation.\n\n      Returns:\n        int: The direction the agent is currently facing (LEFT, RIGHT, UP, DOWN).\n    \"\"\"\n    # Assuming that the state has an attribute 'orientation' which indicates the current direction\n    return state.orientation\n\n  def turn_to(target_direction):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent to face the target direction.\n\n      Args:\n        target_direction: The direction the agent should be facing (LEFT, RIGHT, UP, DOWN).\n\n      Returns:\n        List[int]: A list of actions to turn the agent to the target direction.\n    \"\"\"\n    current_direction = get_current_direction(env._current_state)\n    turns = []\n\n    # Define turn sequences for each direction\n    turn_sequences = {\n        (RIGHT, LEFT): [LEFT],\n        (LEFT, RIGHT): [RIGHT],\n        (UP, DOWN): [DOWN],\n        (DOWN, UP): [UP],\n        (RIGHT, UP): [UP, LEFT],  # Clockwise turns\n        (UP, LEFT): [LEFT, DOWN],\n        (LEFT, DOWN): [DOWN, RIGHT],\n        (DOWN, RIGHT): [RIGHT, UP],\n        (LEFT, UP): [UP, RIGHT],   # Counterclockwise turns\n        (UP, RIGHT): [RIGHT, DOWN],\n        (RIGHT, DOWN): [DOWN, LEFT],\n        (DOWN, LEFT): [LEFT, UP]\n    }\n\n    if current_direction != target_direction:\n        # Find the sequence of turns needed to reach the target direction\n        turns = turn_sequences.get((current_direction, target_direction), [])\n\n    return turns\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T18:58:31.424568", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function gathers the required primitives to craft an item.\n      It handles cases where additional steps might be necessary, such as turning \n      or adjusting the agent's facing direction before moving.\n\n      Args:\n        primitives_needed: A dictionary specifying the number of each primitive required.\n\n      Returns:\n        List[int]: A list of actions to gather all required primitives.\n    \"\"\"\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive)\n            \n            if nearest_primitive_position:\n                # Compute direction to move towards the primitive\n                x_dir, y_dir = compute_direction(nearest_primitive_position)\n                \n                # Move to and face the position of the primitive\n                actions.extend(move_to_and_face(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    return actions\n\n  def craft_item(goal_index):\n    \"\"\"\n      This function crafts an item at the nearest available workshop.\n      It handles cases where additional steps might be necessary, such as turning \n      or adjusting the agent's facing direction before moving.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to craft the specified item.\n    \"\"\"\n    actions = []\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type)\n    \n    if workshop_position:\n        # Compute direction to move towards the workshop\n        x_dir, y_dir = compute_direction(workshop_position)\n        \n        # Move to and face the position of the workshop\n        actions.extend(move_to_and_face(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    grid = env._current_state.grid\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    grid = env._current_state.grid\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    agent_position = env._current_state.pos\n    x_dir = np.sign(target_pos[0] - agent_position[0])\n    y_dir = np.sign(target_pos[1] - agent_position[1])\n\n    return x_dir, y_dir\n\n  def move_to_and_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction \n      and ensure that it is facing correctly before performing any action.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction and face correctly.\n    \"\"\"\n    current_direction = env._current_state.dir\n    actions = []\n\n    # Determine which action(s) are needed based on the direction vector and current facing\n    if x_dir < 0 and y_dir == 0:  # LEFT\n        if current_direction != 3:\n            actions.append((4 - (current_direction - 3)) % 4)\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:  # RIGHT\n        if current_direction != 1:\n            actions.append((4 - (current_direction - 1)) % 4)\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:  # DOWN\n        if current_direction != 2:\n            actions.append((4 - (current_direction - 2)) % 4)\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:  # UP\n        if current_direction != 0:\n            actions.append((4 - (current_direction - 0)) % 4)\n        actions.append(UP)\n\n    return actions\n\n  def get_actions_to_goal():\n    \"\"\"\n      This function generates a sequence of actions to achieve the goal of crafting an arrow.\n      It first gathers all required primitives and then crafts the item at the nearest workshop.\n\n      Returns:\n        List[int]: A list of actions to craft the specified item (arrow in this case).\n    \"\"\"\n    # Example usage: Make an arrow\n    goal_item = \"arrow\"\n    goal_index = env.world.cookbook.index[goal_item]\n    \n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Gather required primitives\n    actions = gather_primitives(primitives_needed)\n\n    # Craft item\n    actions.extend(craft_item(goal_index))\n  \n    return actions\n\n  return get_actions_to_goal()", "island_id": 6, "scores": {"3": 0.5}}
