= env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def align_and_move(target_pos, current_pos):\n      \"\"\"Aligns and moves the agent to a target position.\"\"\"\n      \n      x_dir = target_pos[0] - current_pos[0]\n      y_dir = target_pos[1] - current_pos[1]\n\n      actions = []\n\n      # Align the agent's direction\n      if x_dir < 0:\n          while env._current_state.pos[0] > target_pos[0]:\n              actions.append(LEFT)\n              current_pos = (current_pos[0] - 1, current_pos[1])\n      elif x_dir > 0:\n          while env._current_state.pos[0] < target_pos[0]:\n              actions.append(RIGHT)\n              current_pos = (current_pos[0] + 1, current_pos[1])\n\n      if y_dir < 0:\n          while env._current_state.pos[1] > target_pos[1]:\n              actions.append(DOWN)\n              current_pos = (current_pos[0], current_pos[1] - 1)\n      elif y_dir > 0:\n          while env._current_state.pos[1] < target_pos[1]:\n              actions.append(UP)\n              current_pos = (current_pos[0], current_pos[1] + 1)\n\n      return actions\n  \n  # Define the goal item and get its index in the cookbook\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T14:43:51.731658", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Align and move to the position of the primitive\n            align_and_move_actions = align_and_move(nearest_primitive_position)\n            actions.extend(align_and_move_actions)\n\n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        # Align and move to the position of the workshop\n        align_and_move_actions = align_and_move(workshop_position)\n        actions.extend(align_and_move_actions)\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      \n      if not positions.size:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n      if isinstance(workshop_type, str):\n          workshop_index = env.world.cookbook.index[workshop_type]\n      else:\n          workshop_index = workshop_type\n      \n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if not positions.size:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def align_and_move(target_pos):\n      \"\"\"Aligns and moves the agent to a target position.\"\"\"\n      \n      x_dir = target_pos[0] - env._current_state.pos[0]\n      y_dir = target_pos[1] - env._current_state.pos[1]\n\n      actions = []\n\n      # Align the agent's direction\n      if x_dir < 0:\n          actions.append(LEFT)\n      elif x_dir > 0:\n          actions.append(RIGHT)\n\n      if y_dir < 0:\n          actions.append(DOWN)\n      elif y_dir > 0:\n          actions.append(UP)\n\n      # Move the agent to the target position\n      while x_dir or y_dir:\n          if x_dir != 0:\n              move_action = LEFT if x_dir < 0 else RIGHT\n              actions.append(move_action)\n              x_dir -= np.sign(x_dir)\n          \n          if y_dir != 0:\n              move_action = DOWN if y_dir < 0 else UP\n              actions.append(move_action)\n              y_dir -= np.sign(y_dir)\n\n      return actions\n  \n  # Define the goal item and get its index in the cookbook\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T14:46:23.667078", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item, None)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-09-30T14:46:24.630060", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T14:49:35.672637", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function gathers the required primitives to craft an item.\n      \n      Args:\n        primitives_needed: A dictionary where keys are primitive indices and values are counts.\n\n      Returns:\n        List[int]: A list of actions to gather all required primitives.\n    \"\"\"\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instance of item '{primitive}' found in the grid.\")\n            \n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Align agent's facing direction with movement direction\n            actions.extend(orient_agent(x_dir, y_dir))\n            \n            # Move to the position of the primitive\n            actions.extend(move_towards(nearest_primitive_position, env._current_state.pos))\n\n            # Use action to gather the primitive\n            actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      \n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if len(positions) == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def orient_agent(x_dir, y_dir):\n    \"\"\"\n      This function computes the sequence of actions needed to rotate the agent \n      towards the target direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent towards the target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = None\n\n    if x_dir < 0 and y_dir == 0:\n        target_direction = LEFT\n    elif x_dir > 0 and y_dir == 0:\n        target_direction = RIGHT\n    elif x_dir == 0 and y_dir < 0:\n        target_direction = DOWN\n    elif x_dir == 0 and y_dir > 0:\n        target_direction = UP\n\n    if target_direction is None:\n        return []\n\n    rotation_actions = []\n    \n    # Calculate the shortest path to rotate towards the target direction\n    while current_direction != target_direction:\n        clockwise = (current_direction + 1) % 4\n        counterclockwise = (current_direction - 1) % 4\n\n        if clockwise == target_direction:\n            rotation_actions.append(USE)\n        elif counterclockwise == target_direction:\n            rotation_actions.append(LEFT)\n\n        current_direction = clockwise if clockwise == target_direction else counterclockwise\n\n    return rotation_actions\n\n  def move_towards(target_pos, current_pos):\n    \"\"\"\n      This function computes the sequence of actions needed to move the agent towards \n      the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the target position.\n    \"\"\"\n    x_dir, y_dir = compute_direction(target_pos, current_pos)\n\n    # Align agent's facing direction with movement direction\n    actions = orient_agent(x_dir, y_dir)\n    \n    # Move step-by-step towards the target position\n    while env._current_state.pos != target_pos:\n        x_dir, y_dir = compute_direction(target_pos, env._current_state.pos)\n        \n        if x_dir < 0 and y_dir == 0:\n            actions.append(LEFT)\n        elif x_dir > 0 and y_dir == 0:\n            actions.append(RIGHT)\n        elif x_dir == 0 and y_dir < 0:\n            actions.append(DOWN)\n        elif x_dir == 0 and y_dir > 0:\n            actions.append(UP)\n\n    return actions\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      \n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(positions) == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def craft_item(workshop_position):\n    \"\"\"\n      This function crafts the desired item at the specified workshop.\n\n      Args:\n        workshop_position: A tuple representing the (x, y) coordinates of the workshop.\n\n      Returns:\n        List[int]: A list of actions to move to and use the workshop.\n    \"\"\"\n    actions = []\n\n    # Align agent's facing direction with movement direction\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    actions.extend(orient_agent(x_dir, y_dir))\n    \n    # Move towards the workshop\n    actions.extend(move_towards(workshop_position, env._current_state.pos))\n\n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def make_item(env: env.CraftLab, goal_item):\n      \"\"\"\n          This function generates a sequence of actions to gather required primitives \n          and craft the desired item.\n\n          Args:\n              env: The environment in which the agent operates.\n              goal_item: The name of the item to be crafted.\n\n          Returns:\n              List[int]: A list of actions to achieve the goal.\n      \"\"\"\n      DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n      # Get the index of the goal item\n      goal_index = env.world.cookbook.index[goal_item]\n      \n      if goal_index is None:\n          raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n      # Fetch required primitives for the goal\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n      # Initialize action sequence\n      actions = []\n\n      # Gather all required primitives\n      actions.extend(gather_primitives(primitives_needed))\n\n      # Find and use the nearest workshop to craft the item\n      workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"])\n      \n      if workshop_position is None:\n          raise ValueError(f\"No suitable workshop found for crafting '{goal_item}'.\")\n      \n      actions.extend(craft_item(workshop_position))\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = make_item(env, goal_item)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-30T14:49:36.617747", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  def rotate_to(target_direction):\n      \"\"\"\n          This function computes the sequence of actions needed to rotate the agent \n          towards the target direction.\n\n          Args:\n              target_direction: The desired direction for the agent (LEFT, RIGHT, UP, DOWN).\n\n          Returns:\n              List[int]: A list of actions to rotate the agent towards the target direction.\n      \"\"\"\n      current_direction = env._current_state.dir\n      rotation_actions = []\n\n      # Compute the sequence of actions to rotate towards the target direction\n      while current_direction != target_direction:\n          if (current_direction + 1) % 4 == target_direction or\\\n             (current_direction - 3) % 4 == target_direction:\n              rotation_actions.append(USE)  # Rotate clockwise\n          elif (current_direction - 1) % 4 == target_direction or\\\n               (current_direction + 3) % 4 == target_direction:\n              rotation_actions.append(LEFT)  # Rotate counterclockwise\n          current_direction = (current_direction + 1) % 4\n\n      return rotation_actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Rotate towards the direction of movement\n            target_direction = None\n            if x_dir < 0 and y_dir == 0:\n                target_direction = LEFT\n            elif x_dir > 0 and y_dir == 0:\n                target_direction = RIGHT\n            elif x_dir == 0 and y_dir < 0:\n                target_direction = DOWN\n            elif x_dir == 0 and y_dir > 0:\n                target_direction = UP\n\n            actions.extend(rotate_to(target_direction))\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Rotate towards the direction of movement\n        target_direction = None\n        if x_dir < 0 and y_dir == 0:\n            target_direction = LEFT\n        elif x_dir > 0 and y_dir == 0:\n            target_direction = RIGHT\n        elif x_dir == 0 and y_dir < 0:\n            target_direction = DOWN\n        elif x_dir == 0 and y_dir > 0:\n            target_direction = UP\n\n        actions.extend(rotate_to(target_direction))\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T14:56:16.547036", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            actions.extend(navigate_and_use(nearest_primitive_position))\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        actions.extend(navigate_and_use(workshop_position))\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      \n      if not positions.size:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n      if isinstance(workshop_type, str):\n          workshop_index = env.world.cookbook.index[workshop_type]\n      else:\n          workshop_index = workshop_type\n      \n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if not positions.size:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def navigate_and_use(target_pos):\n      actions = []\n      \n      while env._current_state.pos != target_pos:\n          current_direction = compute_direction(target_pos, env._current_state.pos)\n          actions.append(current_direction)\n          # Execute the action and update the environment\n          _, _, _ = env.step(current_direction)\n          \n      actions.append(USE)\n      return actions\n\n  def compute_direction(target_pos, current_pos):\n      x_dir = target_pos[0] - current_pos[0]\n      y_dir = target_pos[1] - current_pos[1]\n\n      # Compute the direction vectors\n      if abs(x_dir) > abs(y_dir):\n          if x_dir > 0:\n              return RIGHT\n          else:\n              return LEFT\n      else:\n          if y_dir > 0:\n              return UP\n          else:\n              return DOWN\n\n  # Define the goal item and get its index in the cookbook\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:01:16.912192", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n\n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n      positions = np.argwhere(grid[:, :, item_index] > 0)\n      \n      if not positions.size:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n      if isinstance(workshop_type, str):\n          workshop_index = env.world.cookbook.index[workshop_type]\n      else:\n          workshop_index = workshop_type\n      \n      positions = np.argwhere(grid[:, :, workshop_index] > 0)\n      \n      if not positions.size:\n          return None\n      \n      agent_position = env._current_state.pos\n      distances = np.linalg.norm(positions - agent_position, axis=1)\n      nearest_index = np.argmin(distances)\n\n      return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n      x_dir = target_pos[0] - current_pos[0]\n      y_dir = target_pos[1] - current_pos[1]\n\n      # Compute the direction vectors\n      if x_dir > 0:\n          x_action = RIGHT\n      elif x_dir < 0:\n          x_action = LEFT\n      else:\n          x_action = None\n\n      if y_dir > 0:\n          y_action = UP\n      elif y_dir < 0:\n          y_action = DOWN\n      else:\n          y_action = None\n\n      return x_action, y_action\n\n  def move_to(x_action, y_action):\n      actions = []\n\n      # Move in the x direction if there's a need to do so\n      while x_action is not None:\n          actions.append(x_action)\n          \n          # Update position after each action\n          current_pos = env._current_state.pos\n          next_x = current_pos[0] + (1 if x_action == RIGHT else -1) if x_action in [LEFT, RIGHT] else current_pos[0]\n          next_y = current_pos[1] + (1 if x_action == UP else -1) if x_action in [UP, DOWN] else current_pos[1]\n          \n          # Check if the agent has reached the target position\n          if compute_direction((next_x, next_y), env._current_state.pos)[0] is None:\n              break\n      \n      # Move in the y direction if there's a need to do so\n      while y_action is not None:\n          actions.append(y_action)\n          \n          # Update position after each action\n          current_pos = env._current_state.pos\n          next_x = current_pos[0] + (1 if y_action == RIGHT else -1) if y_action in [LEFT, RIGHT] else current_pos[0]\n          next_y = current_pos[1] + (1 if y_action == UP else -1) if y_action in [UP, DOWN] else current_pos[1]\n          \n          # Check if the agent has reached the target position\n          if compute_direction((next_x, next_y), env._current_state.pos)[1] is None:\n              break\n\n      return actions\n  \n  def align_and_move(target_pos):\n      \"\"\"Aligns and moves the agent to a target position.\"\"\"\n      \n      x_dir = target_pos[0] - env._current_state.pos[0]\n      y_dir = target_pos[1] - env._current_state.pos[1]\n\n      actions = []\n\n      # Align the agent's direction\n      if x_dir < 0:\n          actions.append(LEFT)\n      elif x_dir > 0:\n          actions.append(RIGHT)\n      \n      if y_dir < 0:\n          actions.append(DOWN)\n      elif y_dir > 0:\n          actions.append(UP)\n\n      # Move the agent to the target position\n      while x_dir or y_dir:\n          if x_dir < 0:\n              actions.append(LEFT)\n              x_dir += 1\n          elif x_dir > 0:\n              actions.append(RIGHT)\n              x_dir -= 1\n\n          if y_dir < 0:\n              actions.append(DOWN)\n              y_dir += 1\n          elif y_dir > 0:\n              actions.append(UP)\n              y_dir -= 1\n\n      return actions\n  \n  # Define the goal item and get its index in the cookbook\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:03:02.273571", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      Finds the nearest instance of an item in the grid.\n      \n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    \n    if len(positions) == 0:\n        return None\n\n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      Finds the nearest workshop of a given type in the grid.\n      \n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(positions) == 0:\n        return None\n\n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      Computes the direction to move from the current position to the target position.\n      \n      Args:\n        target_pos: The (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move towards the target position.\n                         Values are -1, 0, or 1 indicating the direction in each axis.\n    \"\"\"\n    current_pos = np.array(env._current_state.pos)\n    return tuple(np.sign(target_pos - current_pos))\n\n  def get_actions_to_move(x_dir, y_dir):\n    \"\"\"\n      Generates a sequence of actions to move the agent in the specified direction.\n      \n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n    \n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      Gathers the required primitives to craft an item and crafts it.\n      \n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position)\n            actions.extend(get_actions_to_move(x_dir, y_dir))\n            actions.append(USE)\n\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position)\n        actions.extend(get_actions_to_move(x_dir, y_dir))\n        actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:03:03.235755", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  # Helper functions to find nearest instances and workshops\n  def find_nearest_instance(item_index):\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n    if positions.size == 0:\n        return None\n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    if positions.size == 0:\n        return None\n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  # Function to compute direction from current position to target position\n  def compute_direction(target_pos):\n      x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n      y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n      return x_dir, y_dir\n\n  # Function to generate actions for moving towards a target direction\n  def move_to(x_dir, y_dir):\n    actions = []\n    current_dir = env._current_state.dir\n    target_dir = np.degrees(np.arctan2(y_dir, x_dir)) % 360\n    \n    # Calculate the shortest rotation\n    if target_dir > current_dir:\n        turn_left = (target_dir - current_dir) % 360\n        turn_right = (current_dir - target_dir + 360) % 360\n    else:\n        turn_left = (current_dir - target_dir + 360) % 360\n        turn_right = (target_dir - current_dir) % 360\n    \n    if turn_left < turn_right:\n        actions.append(LEFT)\n    elif turn_right < turn_left:\n        actions.append(RIGHT)\n    \n    # Add move forward action\n    actions.append(USE)\n    \n    return actions\n\n  # Function to gather and craft an item\n  def gather_and_craft(goal_index):\n      primitives_needed = env.world.cookbook.primitives_for(goal_index)\n      actions = []\n      \n      for primitive, count in primitives_needed.items():\n          nearest_primitive_position = find_nearest_instance(primitive)\n          \n          if nearest_primitive_position:\n              x_dir, y_dir = compute_direction(nearest_primitive_position)\n              \n              # Move to the position of the primitive\n              actions.extend(move_to(x_dir, y_dir))\n              \n              # Use action to gather the primitive\n              actions.append(USE)\n\n      workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n      workshop_position = find_nearest_workshop(workshop_type)\n      \n      if workshop_position:\n          x_dir, y_dir = compute_direction(workshop_position)\n          \n          # Move to the position of the workshop\n          actions.extend(move_to(x_dir, y_dir))\n          \n          # Use action to craft the item at the workshop\n          actions.append(USE)\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-09-30T15:10:26.781641", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather all required primitives.\n\n      Args:\n        primitives_needed: A dictionary where keys are the primitive indices and values are their counts.\n\n      Returns:\n        List[int]: A list of actions to gather the primitives.\n    \"\"\"\n    actions = []\n    \n    for primitive, count in primitives_needed.items():\n        # Find the nearest instance of each required primitive\n        while env._current_state.inventory[primitive] < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n    \n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n        if x_dir < 0:\n            actions.append(LEFT)\n            x_dir += 1\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            x_dir -= 1\n        elif y_dir < 0:\n            actions.append(DOWN)\n            y_dir += 1\n        elif y_dir > 0:\n            actions.append(UP)\n            y_dir -= 1\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Fetch required primitives for the goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  # Generate actions to gather primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Find the nearest workshop for crafting the item\n  workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n  \n  if workshop_position:\n      x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n      # Move to the position of the workshop\n      actions.extend(move_to(x_dir, y_dir))\n      \n      # Use action to craft the item at the workshop\n      actions.append(USE)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:10:27.747416", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory.get(primitive, 0) < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instance of '{primitive}' found in the grid.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No '{workshop_type}' workshop found in the grid.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n        if x_dir < 0:\n            actions.append(LEFT)\n            x_dir += 1\n        elif x_dir > 0:\n            actions.append(RIGHT)\n            x_dir -= 1\n        elif y_dir < 0:\n            actions.append(DOWN)\n            y_dir += 1\n        elif y_dir > 0:\n            actions.append(UP)\n            y_dir -= 1\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:13:39.546599", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instance of {primitive} found in the grid.\")\n            \n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move to and face the position of the primitive\n            actions.extend(move_and_face(nearest_primitive_position, env._current_state))\n\n            # Use action to gather the primitive\n            actions.append(USE)\n            \n            count -= 1\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No {workshop_type} workshop found in the grid.\")\n    \n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n    # Move to and face the position of the workshop\n    actions.extend(move_and_face(workshop_position, env._current_state))\n\n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Determine the current facing direction based on the movement vector\n    if x_dir < 0 and y_dir == 0:  # Left\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:  # Right\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:  # Down\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:  # Up\n        actions.append(UP)\n\n    return actions\n\n  def move_and_face(target_pos, current_state):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the target position.\n      It also includes turning actions to face the correct direction before moving.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_state: The current state of the environment.\n\n      Returns:\n        List[int]: A list of actions to move and face the agent towards the target position.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - current_state.pos[1])\n\n    # Determine the current facing direction\n    current_facing = current_state.facing\n\n    # Calculate the target facing direction based on movement vector\n    if x_dir < 0 and y_dir == 0:  # Left\n        target_facing = LEFT\n    elif x_dir > 0 and y_dir == 0:  # Right\n        target_facing = RIGHT\n    elif x_dir == 0 and y_dir < 0:  # Down\n        target_facing = DOWN\n    elif x_dir == 0 and y_dir > 0:  # Up\n        target_facing = UP\n\n    # Generate actions to turn towards the target facing direction\n    if current_facing != target_facing:\n        actions = turn_to(target_facing)\n    else:\n        actions = []\n\n    # Add movement action\n    actions.extend(move_to(x_dir, y_dir))\n\n    return actions\n\n  def turn_to(direction):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent towards the specified direction.\n      It assumes that the environment provides turning actions and that these are represented by \n      specific constants.\n\n      Args:\n        direction: The target facing direction (LEFT, RIGHT, UP, DOWN).\n\n      Returns:\n        List[int]: A list of actions to turn the agent towards the specified direction.\n    \"\"\"\n    current_facing = env._current_state.facing\n    actions = []\n\n    # Calculate the difference in direction indices\n    dir_diff = (direction - current_facing + 4) % 4\n\n    if dir_diff == 1:\n        actions.append(RIGHT)\n    elif dir_diff == 2:\n        actions.extend([RIGHT, RIGHT])\n    elif dir_diff == 3:\n        actions.append(LEFT)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:13:40.513718", "function_name": "make_arrow", "function_body": "  def get_item_index(item_name):\n    \"\"\"\n      This function retrieves the index of an item by its name.\n\n      Args:\n        item_name: The name of the item to find in the cookbook.\n\n      Returns:\n        int: The index of the item if found, None otherwise.\n    \"\"\"\n    return env.world.cookbook.index.get(item_name)\n\n  def gather_primitives(primitive_indices):\n    \"\"\"\n      This function generates actions to gather all required primitives.\n\n      Args:\n        primitive_indices: A dictionary mapping item indices to their required counts.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n    for primitive_index, count in primitive_indices.items():\n      for _ in range(count):\n        nearest_position = find_nearest_instance(primitive_index, env._current_state.grid)\n        if nearest_position:\n          actions.extend(move_and_face(nearest_position, env._current_state.pos))\n          actions.append(USE)\n    return actions\n\n  def move_to_target(target_pos):\n    \"\"\"\n      This function generates actions to move the agent to a target position.\n\n      Args:\n        target_pos: The target position (x, y).\n\n      Returns:\n        List[int]: A list of actions to reach the target position.\n    \"\"\"\n    actions = []\n    current_pos = env._current_state.pos\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n    \n    while current_pos != target_pos:\n      if x_dir != 0 and (x_dir == 0 or abs(x_dir) >= abs(y_dir)):\n        actions.extend(move_and_face((current_pos[0] + x_dir, current_pos[1]), current_pos))\n        current_pos = (current_pos[0] + x_dir, current_pos[1])\n      else:\n        actions.extend(move_and_face((current_pos[0], current_pos[1] + y_dir), current_pos))\n        current_pos = (current_pos[0], current_pos[1] + y_dir)\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    if positions.size == 0:\n      return None\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n    return x_dir, y_dir\n\n  def move_and_face(target_pos, current_pos):\n    \"\"\"\n      This function generates actions to move the agent towards the target position.\n      It also includes turning actions to face the correct direction before moving.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        List[int]: A list of actions to move and face the agent towards the target position.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n    target_facing = None\n\n    if x_dir < 0:\n      target_facing = LEFT\n    elif x_dir > 0:\n      target_facing = RIGHT\n    elif y_dir < 0:\n      target_facing = DOWN\n    elif y_dir > 0:\n      target_facing = UP\n\n    actions = []\n    current_facing = env._current_state.facing\n\n    if target_facing and current_facing != target_facing:\n      actions.extend(turn_to(target_facing))\n\n    actions.append(MOVE)\n    return actions\n\n  def turn_to(direction):\n    \"\"\"\n      This function generates actions to turn the agent towards the specified direction.\n      It assumes that the environment provides turning actions and that these are represented by \n      specific constants.\n\n      Args:\n        direction: The target facing direction (LEFT, RIGHT, UP, DOWN).\n\n      Returns:\n        List[int]: A list of actions to turn the agent towards the specified direction.\n    \"\"\"\n    current_facing = env._current_state.facing\n    actions = []\n\n    if direction == LEFT:\n      if current_facing == RIGHT:\n        actions.extend([RIGHT, RIGHT])\n      elif current_facing == UP:\n        actions.append(LEFT)\n      elif current_facing == DOWN:\n        actions.append(RIGHT)\n    elif direction == RIGHT:\n      if current_facing == LEFT:\n        actions.extend([RIGHT, RIGHT])\n      elif current_facing == UP:\n        actions.append(RIGHT)\n      elif current_facing == DOWN:\n        actions.append(LEFT)\n    elif direction == UP:\n      if current_facing == LEFT:\n        actions.append(RIGHT)\n      elif current_facing == RIGHT:\n        actions.append(LEFT)\n      elif current_facing == DOWN:\n        actions.extend([RIGHT, RIGHT])\n    elif direction == DOWN:\n      if current_facing == LEFT:\n        actions.append(LEFT)\n      elif current_facing == RIGHT:\n        actions.append(RIGHT)\n      elif current_facing == UP:\n        actions.extend([RIGHT, RIGHT])\n\n    return actions\n\n  # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = range(5)\n  MOVE = RIGHT  # Assuming MOVE is represented by RIGHT in this context\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = get_item_index(goal_item)\n\n  if goal_index is None:\n    raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  actions = gather_primitives(primitives_needed)\n\n  # Find nearest workshop for crafting\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  workshop_index = get_item_index(workshop_type)\n\n  if workshop_index is None:\n    raise ValueError(f\"Workshop '{workshop_type}' not found in the cookbook.\")\n\n  workshop_position = find_nearest_instance(workshop_index, env._current_state.grid)\n  if workshop_position:\n    actions.extend(move_to_target(workshop_position))\n    actions.append(USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:16:05.777759", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def get_actions_to_target(target_pos):\n    \"\"\"\n      Generates a sequence of actions to move the agent to a target position.\n      \n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to reach the target position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    x_dir, y_dir = compute_direction(target_pos, current_pos)\n    \n    actions = []\n\n    # Move in the x-direction first\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n\n    # Then move in the y-direction\n    if x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      \n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if not nearest_primitive_position:\n                raise ValueError(f\"No instance of item '{primitive}' found in the grid.\")\n\n            actions.extend(get_actions_to_target(nearest_primitive_position))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if not workshop_position:\n        raise ValueError(f\"No instance of workshop '{workshop_type}' found in the grid.\")\n    \n    actions.extend(get_actions_to_target(workshop_position))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n    \n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      \n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      \n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n      \n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:16:06.737624", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Find nearest instance of the current primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(turn_and_move(x_dir, y_dir, env._current_state.dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(turn_and_move(x_dir, y_dir, env._current_state.dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir, current_direction):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent towards the specified direction\n      and then move in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n        current_direction: The current facing direction of the agent (assumed to be encoded as an integer).\n\n      Returns:\n        List[int]: A list of actions to turn the agent towards the specified direction and move.\n    \"\"\"\n    actions = []\n\n    # Determine the target direction\n    if x_dir < 0 and y_dir == 0:\n        target_direction = LEFT\n    elif x_dir > 0 and y_dir == 0:\n        target_direction = RIGHT\n    elif x_dir == 0 and y_dir < 0:\n        target_direction = DOWN\n    elif x_dir == 0 and y_dir > 0:\n        target_direction = UP\n    else:\n        return actions  # No movement needed\n\n    # Calculate the difference in direction\n    direction_diff = (target_direction - current_direction) % 4\n\n    if direction_diff == 1:\n        actions.append(RIGHT)\n    elif direction_diff == 2:\n        actions.extend([RIGHT, RIGHT])\n    elif direction_diff == 3:\n        actions.append(LEFT)\n\n    # Add the movement action\n    actions.append(target_direction)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-09-30T15:18:47.102365", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        primitive_index = env.world.cookbook.index[primitive]\n        if primitive_index is None:\n            raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n\n        nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index]['_at']\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    if workshop_index is None:\n        raise ValueError(f\"Workshop type '{workshop_type}' not found in the cookbook.\")\n\n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:18:48.066827", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find all instances of the primitive and prioritize closer ones\n        positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n        \n        if positions.size == 0:\n            raise ValueError(f\"Primitive '{primitive}' not found in the grid.\")\n        \n        # Calculate distances from the agent's current position to each cell with the primitive\n        agent_position = np.array(env._current_state.pos)\n        distances = np.linalg.norm(positions - agent_position, axis=1)\n\n        # Sort positions by distance (ascending) and prioritize closer ones\n        sorted_indices = np.argsort(distances)\n        \n        for index in sorted_indices:\n            nearest_primitive_position = tuple(positions[index])\n            \n            x_dir, y_dir = compute_direction(nearest_primitive_position, agent_position)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    \n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if positions.size == 0:\n        raise ValueError(f\"Workshop for '{goal_item}' not found in the grid.\")\n    \n    # Calculate distances from the agent's current position to each cell with the workshop\n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    # Sort positions by distance (ascending) and prioritize closer ones\n    sorted_indices = np.argsort(distances)\n    \n    for index in sorted_indices:\n        nearest_workshop_position = tuple(positions[index])\n        \n        x_dir, y_dir = compute_direction(nearest_workshop_position, agent_position)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:21:58.045045", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory[primitive] < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise ValueError(f\"Could not find the required item '{primitive}'.\")\n            \n            # Compute direction to move\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move towards the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n            # Update current state after gathering (for simulation purposes)\n            env._current_state = simulate_step(env._current_state, LEFT)  # Placeholder for actual movement\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"Could not find a workshop of type '{workshop_type}'.\")\n\n    # Compute direction to move\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n    # Move towards the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def simulate_step(current_state, action):\n    \"\"\"\n      This function simulates the effect of an action on the current state.\n      It's a placeholder function that should be replaced with actual state transition logic.\n\n      Args:\n        current_state: The current state of the environment.\n        action: The action to be performed.\n\n      Returns:\n        Object: The new state after performing the action.\n    \"\"\"\n    # Placeholder implementation\n    if action == LEFT:\n        return type(current_state)(grid=current_state.grid, pos=(current_state.pos[0] - 1, current_state.pos[1]), inventory=current_state.inventory)\n    elif action == RIGHT:\n        return type(current_state)(grid=current_state.grid, pos=(current_state.pos[0] + 1, current_state.pos[1]), inventory=current_state.inventory)\n    elif action == DOWN:\n        return type(current_state)(grid=current_state.grid, pos=(current_state.pos[0], current_state.pos[1] - 1), inventory=current_state.inventory)\n    elif action == UP:\n        return type(current_state)(grid=current_state.grid, pos=(current_state.pos[0], current_state.pos[1] + 1), inventory=current_state.inventory)\n    else:\n        return current_state\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n\n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:21:58.996228", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n                # Move to the position of the primitive and face it\n                actions.extend(turn_to_face(x_dir, y_dir))\n                actions.extend(move_towards(nearest_primitive_position[0], nearest_primitive_position[1]))\n\n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop and face it\n        actions.extend(turn_to_face(x_dir, y_dir))\n        actions.extend(move_towards(workshop_position[0], workshop_position[1]))\n\n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_towards(target_x, target_y):\n    \"\"\"\n      This function generates a sequence of actions to move the agent towards the specified \n      (x, y) position. It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        target_x: The x-coordinate of the target position.\n        target_y: The y-coordinate of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent towards the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos[0] != target_x or current_pos[1] != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), current_pos)\n        \n        # Move in the x-direction if needed\n        if x_dir < 0 and current_pos[1] == target_y:\n            actions.append(LEFT)\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif x_dir > 0 and current_pos[1] == target_y:\n            actions.append(RIGHT)\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n        # Move in the y-direction if needed\n        elif y_dir < 0 and current_pos[0] == target_x:\n            actions.append(DOWN)\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif y_dir > 0 and current_pos[0] == target_x:\n            actions.append(UP)\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return actions\n\n  def turn_to_face(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent's facing direction \n      towards the specified target direction. It assumes that the environment has a way to \n      determine and change the agent's current facing direction.\n\n      Args:\n        x_dir: The desired x direction (-1, 0, or 1).\n        y_dir: The desired y direction (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent's facing direction towards the \n                   specified target direction.\n    \"\"\"\n    current_direction = env._current_state.dir\n    target_direction = np.argmax([x_dir, y_dir])  # Assuming directions are in order: UP, DOWN, LEFT, RIGHT\n\n    # Mapping from (current_direction, target_direction) to actions\n    direction_map = {\n        (0, 1): [DOWN],         # From UP to DOWN\n        (0, 2): [LEFT],          # From UP to LEFT\n        (0, 3): [RIGHT],         # From UP to RIGHT\n        (1, 0): [UP],            # From DOWN to UP\n        (1, 2): [LEFT],          # From DOWN to LEFT\n        (1, 3): [RIGHT],         # From DOWN to RIGHT\n        (2, 0): [UP, RIGHT],     # From LEFT to UP\n        (2, 1): [DOWN, RIGHT],   # From LEFT to DOWN\n        (2, 3): [RIGHT],         # From LEFT to RIGHT\n        (3, 0): [UP, LEFT],      # From RIGHT to UP\n        (3, 1): [DOWN, LEFT],    # From RIGHT to DOWN\n        (3, 2): [LEFT],          # From RIGHT to LEFT\n    }\n\n    return direction_map.get((current_direction, target_direction), [])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:23:16.340657", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            actions.extend(navigate_to(nearest_primitive_position, env._current_state))\n            \n            # Gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        actions.extend(navigate_to(workshop_position, env._current_state))\n        \n        # Craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def navigate_to(target_pos, current_state):\n    actions = []\n    target_x, target_y = target_pos\n    current_x, current_y = current_state.pos\n    \n    while current_x != target_x or current_y != target_y:\n        x_dir = np.sign(target_x - current_x)\n        y_dir = np.sign(target_y - current_y)\n\n        # Determine the action based on the direction needed to move in each axis\n        if x_dir == 1:\n            actions.append(RIGHT)\n        elif x_dir == -1:\n            actions.append(LEFT)\n        \n        if y_dir == 1:\n            actions.append(UP)\n        elif y_dir == -1:\n            actions.append(DOWN)\n\n        # Update the current position after moving\n        current_x += x_dir\n        current_y += y_dir\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:23:17.336793", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_positions = find_nearest_instances(primitive, env._current_state.grid)\n        \n        if not nearest_primitive_positions:\n            raise ValueError(f\"No instances of item with index {primitive} found.\")\n            \n        for _ in range(count):\n            nearest_primitive_position = nearest_primitive_positions.pop(0)\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            actions.extend(move_to(x_dir, y_dir))\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_positions = find_nearest_workshops(workshop_type, env._current_state.grid)\n    \n    if not workshop_positions:\n        raise ValueError(f\"No workshops of type {workshop_type} found.\")\n        \n    nearest_workshop_position = workshop_positions.pop(0)\n\n    x_dir, y_dir = compute_direction(nearest_workshop_position, env._current_state.pos)\n    actions.extend(move_to(x_dir, y_dir))\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    if positions.size == 0:\n        return None\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    sorted_indices = np.argsort(distances)\n    nearest_positions = [tuple(positions[i]) for i in sorted_indices]\n    return nearest_positions\n\n  def find_nearest_workshops(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if positions.size == 0:\n        return None\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    sorted_indices = np.argsort(distances)\n    nearest_positions = [tuple(positions[i]) for i in sorted_indices]\n    return nearest_positions\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:26:01.194905", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n    \n    recipe = env.world.cookbook.recipes[goal_index]\n    primitives_needed = {env.world.cookbook.items[i]: count for i, count in enumerate(recipe['in'])}\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory.get(primitive, 0) < count:\n            nearest_primitive_position = find_nearest_instance(env.world.cookbook.index[primitive], env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise ValueError(f\"Primitive '{primitive}' not found in the grid.\")\n            \n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = recipe['_at']\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    workshop_position = find_nearest_workshop(workshop_index, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"Workshop '{workshop_type}' not found in the grid.\")\n    \n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_index, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_index: The index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:26:02.154118", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move agent to face in the direction of the target position\n            actions.extend(turn_to(x_dir, y_dir))\n\n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move agent to face in the direction of the target position\n        actions.extend(turn_to(x_dir, y_dir))\n\n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    # actions.append(USE)\n\n    return actions\n\n  def turn_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to rotate the agent to face in the specified direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to rotate the agent to face in the specified direction.\n    \"\"\"\n    # Map the (x_dir, y_dir) pair to a turn action\n    # Assuming LEFT is 0, RIGHT is 1, DOWN is 2, UP is 3\n    current_direction = env._current_state.dir\n\n    target_direction = None\n    if x_dir < 0 and y_dir == 0:\n        target_direction = LEFT\n    elif x_dir > 0 and y_dir == 0:\n        target_direction = RIGHT\n    elif x_dir == 0 and y_dir < 0:\n        target_direction = DOWN\n    elif x_dir == 0 and y_dir > 0:\n        target_direction = UP\n\n    # Calculate the number of turns needed to reach the target direction\n    num_turns = (target_direction - current_direction) % 4\n    \n    actions = [num_turns] * abs(num_turns)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 0, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:27:49.564889", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n\n            # Move to the position of the primitive and gather it\n            actions.extend(navigate_and_use(x_dir, y_dir))\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop and craft the item\n        actions.extend(navigate_and_use(x_dir, y_dir))\n\n    return actions\n\n  def navigate_and_use(x_dir, y_dir):\n    \"\"\"\n      This function navigates the agent towards a given direction and then uses an action.\n      \n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent towards a direction and use an action.\n    \"\"\"\n    actions = []\n    \n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n        \n    actions.append(USE) # Use action to gather the primitive or craft at the workshop\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:27:50.523224", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It ensures that the agent faces in the correct direction before moving or using.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            # Move to the position of the primitive\n            actions.extend(move_to(nearest_primitive_position))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        # Move to the position of the workshop\n        actions.extend(move_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def move_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current \n      position to the target position. It ensures that the agent faces in the correct \n      direction before moving.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to move the agent to the specified position.\n    \"\"\"\n    current_pos = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Compute the direction vector from current position to target position\n    x_dir, y_dir = compute_direction(target_pos, current_pos)\n    \n    # Determine the sequence of actions needed to face and move towards the target\n    actions = []\n\n    if (x_dir == 0) and (y_dir == -1):  # Move down\n        while current_dir != 3:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(DOWN)\n    elif (x_dir == 0) and (y_dir == 1):  # Move up\n        while current_dir != 1:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(UP)\n    elif (x_dir == -1) and (y_dir == 0):  # Move left\n        while current_dir != 2:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(LEFT)\n    elif (x_dir == 1) and (y_dir == 0):  # Move right\n        while current_dir != 0:\n            actions.append((current_dir + 1) % 4)\n            current_dir = (current_dir + 1) % 4\n        actions.append(RIGHT)\n\n    return actions\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:29:47.143451", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:29:48.109819", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive and pick it up\n            actions.extend(move_and_pickup(x_dir, y_dir))\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n\n        # Move to the position of the workshop and use it\n        actions.extend(move_and_use(x_dir, y_dir))\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_and_pickup(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction\n      and pick up an item.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction and pick up an item.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to pick up the item\n    actions.append(USE)\n\n    return actions\n\n  def move_and_use(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction\n      and use an object (e.g., a workshop).\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction and use an object.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to use the object\n    actions.append(USE)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 8, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:32:21.500374", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def get_action_sequence(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It aligns the agent's facing direction with the movement direction if necessary.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n    \n    # Determine current facing direction based on previous movements\n    current_facing_direction = env._current_state.init_dir\n    \n    # Map direction vectors to action indices\n    direction_to_action = {\n        (-1, 0): LEFT,\n        (1, 0): RIGHT,\n        (0, -1): DOWN,\n        (0, 1): UP\n    }\n    \n    # Calculate target facing direction based on the movement vector\n    target_facing_direction = (x_dir, y_dir)\n    \n    # If current facing direction is not aligned with target facing direction, turn first\n    if current_facing_direction != target_facing_direction:\n        # Determine the turning action needed to align with the target direction\n        if target_facing_direction == (-1, 0):  # LEFT\n            actions.append(LEFT)\n        elif target_facing_direction == (1, 0):  # RIGHT\n            actions.append(RIGHT)\n        elif target_facing_direction == (0, -1):  # DOWN\n            actions.append(DOWN)\n        elif target_facing_direction == (0, 1):  # UP\n            actions.append(UP)\n    \n    # Add the movement action to move in the target direction\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    # Add a USE action to confirm the movement (assuming it's needed in the environment)\n    actions.append(USE)\n    \n    return actions\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It accounts for the agent's facing direction when moving between items.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Find all positions of the current primitive in the grid\n        primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive] > 0)\n\n        if primitive_positions.size == 0:\n            raise ValueError(f\"No instances of '{primitive}' found in the environment.\")\n\n        # Sort positions by distance from the agent's current position\n        agent_position = env._current_state.pos\n        distances = np.linalg.norm(primitive_positions - agent_position, axis=1)\n        sorted_indices = np.argsort(distances)\n\n        for index in sorted_indices:\n            nearest_primitive_position = tuple(primitive_positions[index])\n            \n            x_dir, y_dir = compute_direction(nearest_primitive_position, agent_position)\n            \n            # Generate actions to move and gather the primitive\n            actions.extend(get_action_sequence(x_dir, y_dir))\n            \n            # Update agent's current position after gathering the primitive\n            env._current_state.pos = nearest_primitive_position\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_type] > 0)\n\n    if workshop_positions.size == 0:\n        raise ValueError(f\"No '{workshop_type}' found in the environment.\")\n\n    # Sort positions by distance from the agent's current position\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(workshop_positions - agent_position, axis=1)\n    sorted_indices = np.argsort(distances)\n\n    for index in sorted_indices:\n        nearest_workshop_position = tuple(workshop_positions[index])\n        \n        x_dir, y_dir = compute_direction(nearest_workshop_position, agent_position)\n        \n        # Generate actions to move and use the workshop\n        actions.extend(get_action_sequence(x_dir, y_dir))\n        \n        break  # Only need one workshop\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:32:22.474453", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while count > 0:\n            # Find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instances of '{primitive}' found on the grid.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n            count -= 1\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No workshops of type '{env.world.cookbook.recipes[goal_index]['_at']}' found on the grid.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(move_to(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-30T15:33:37.130123", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        # Find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    # Handle edge case when the target and current positions are the same\n    if x_dir == 0 and y_dir == 0:\n        return (0, 0)\n    \n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:33:38.107463", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_positions = find_all_instances(primitive, env._current_state.grid)\n        \n        if nearest_primitive_positions:\n            # Move to the first instance of the required primitive\n            x_dir, y_dir = compute_direction(nearest_primitive_positions[0], env._current_state.pos)\n            \n            actions.extend(move_to(x_dir, y_dir))\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        actions.extend(move_to(x_dir, y_dir))\n        actions.append(USE)\n\n    return actions\n\n  def find_all_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    return list(map(tuple, positions))\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T15:34:11.844536", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_positions = find_all_instances(primitive, env._current_state.grid)\n        \n        if nearest_primitive_positions:\n            # Move to the closest instance of the required primitive\n            x_dir, y_dir = compute_direction(nearest_primitive_positions[0], env._current_state.pos)\n\n            actions.extend(move_to(x_dir, y_dir))\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        actions.extend(move_to(x_dir, y_dir))\n        actions.append(USE)\n\n    return actions\n\n  def find_all_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0).tolist()\n    \n    return positions if positions else None\n\n  def find_nearest_workshop(workshop_type, grid):\n    workshop_index = env.world.cookbook.index[workshop_type]\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    \n    if not positions.size:\n        return None\n    \n    agent_position = np.array(env._current_state.pos)\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n\n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir, y_dir = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    if x_dir < 0:\n        x_action = LEFT\n    elif x_dir > 0:\n        x_action = RIGHT\n    else:\n        x_action = None\n\n    if y_dir < 0:\n        y_action = DOWN\n    elif y_dir > 0:\n        y_action = UP\n    else:\n        y_action = None\n    \n    return x_action, y_action\n\n  def move_to(x_action, y_action):\n    actions = []\n\n    if x_action:\n        actions.append(x_action)\n    \n    if y_action:\n        actions.append(y_action)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.5}}
