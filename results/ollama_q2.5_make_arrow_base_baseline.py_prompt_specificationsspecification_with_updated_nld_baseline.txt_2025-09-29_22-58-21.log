the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        # Assume we have a method to find the nearest instance of the primitive\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def align_facing_direction(current_pos, target_pos):\n      \"\"\"\n      This function computes the sequence of actions needed to align the agent's facing direction \n      with the direction of movement from the current position to the target position.\n\n      Args:\n          current_pos: A tuple representing the (x, y) coordinates of the current position.\n          target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n          List[int]: A list of actions to align the agent's facing direction with the movement direction.\n      \"\"\"\n      x_dir = np.sign(target_pos[0] - current_pos[0])\n      y_dir = np.sign(target_pos[1] - current_pos[1])\n\n      current_direction = env._current_state.dir\n      target_direction = None\n\n      # Determine the target direction based on x and y directions\n      if x_dir == 0:\n          if y_dir > 0:\n              target_direction = UP\n          elif y_dir < 0:\n              target_direction = DOWN\n      elif y_dir == 0:\n          if x_dir > 0:\n              target_direction = RIGHT\n          elif x_dir < 0:\n              target_direction = LEFT\n\n      actions = []\n\n      # Align the agent's facing direction with the target direction\n      if current_direction != target_direction:\n          if current_direction == UP or current_direction == DOWN:\n              if target_direction == LEFT:\n                  actions.append(LEFT)\n              elif target_direction == RIGHT:\n                  actions.append(RIGHT)\n          elif current_direction == LEFT or current_direction == RIGHT:\n              if target_direction == UP:\n                  actions.append(UP)\n              elif target_direction == DOWN:\n                  actions.append(DOWN)\n\n      return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T17:11:15.606871", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            # Assume we have a method to find the nearest instance of the primitive\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position:\n                # Compute direction to move towards the primitive\n                x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n                \n                # Move to the position of the primitive\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Compute direction to move towards the workshop\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    # Determine which action to take based on the direction vector\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T17:11:16.564017", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitives(primitives_needed):\n    \"\"\"\n      This function generates a sequence of actions to gather all required primitives.\n\n      Args:\n        primitives_needed: A dictionary with item indices as keys and counts as values.\n\n      Returns:\n        List[int]: A list of actions to gather the required primitives.\n    \"\"\"\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive)\n            \n            if nearest_primitive_position is not None:\n                x_dir, y_dir = compute_direction(nearest_primitive_position)\n                actions.extend(move_to(x_dir, y_dir))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    return actions\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to move to and use the nearest workshop.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        List[int]: A list of actions to craft the item.\n    \"\"\"\n    actions = []\n    \n    workshop_position = find_nearest_workshop(workshop_type)\n    \n    if workshop_position is not None:\n        x_dir, y_dir = compute_direction(workshop_position)\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index):\n    \"\"\"\n      This function finds the nearest instance of an item in the current environment.\n\n      Args:\n        item_index: The index of the item to be found.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(env._current_state.grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type):\n    \"\"\"\n      This function finds the nearest workshop of a specified type in the current environment.\n\n      Args:\n        workshop_type: The type of workshop needed for crafting (name or index).\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It assumes that the agent's facing direction is aligned with the movement direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    actions = []\n\n    if x_dir < 0 and y_dir == 0:\n        actions.append(LEFT)\n    elif x_dir > 0 and y_dir == 0:\n        actions.append(RIGHT)\n    elif x_dir == 0 and y_dir < 0:\n        actions.append(DOWN)\n    elif x_dir == 0 and y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  # Gather primitives\n  actions = gather_primitives(primitives_needed)\n\n  # Craft item\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  actions.extend(craft_item(workshop_type))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T17:13:53.660647", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It assumes that the agent has enough space in its inventory and that the environment \n      is designed such that gathering and crafting can be done without additional steps.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n    \n    primitives_needed = env.world.cookbook.primitives_for(goal_item)\n    \n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        primitive_index = env.world.cookbook.index[primitive]\n        if primitive_index is None:\n            raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n        \n        while env._current_state.inventory.get(primitive, 0) < count:\n            nearest_primitive_position = find_nearest_instance(primitive_index, env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise RuntimeError(f\"No instance of primitive '{primitive}' found on the grid.\")\n            \n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(turn_and_move(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_item][\"_at\"]\n    workshop_index = env.world.cookbook.index[workshop_type]\n    \n    if workshop_index is None:\n        raise ValueError(f\"Workshop type '{workshop_type}' not found in the cookbook.\")\n    \n    nearest_workshop_position = find_nearest_instance(workshop_index, env._current_state.grid)\n    \n    if nearest_workshop_position is None:\n        raise RuntimeError(f\"No instance of workshop type '{workshop_type}' found on the grid.\")\n    \n    x_dir, y_dir = compute_direction(nearest_workshop_position, env._current_state.pos)\n    \n    # Move to the position of the workshop\n    actions.extend(turn_and_move(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to move the agent in the specified direction.\n      It includes turning if necessary.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to move the agent in the specified direction.\n    \"\"\"\n    # Determine the required facing direction\n    target_direction = (x_dir, y_dir)\n    \n    current_direction = compute_agent_facing_direction()\n    \n    turn_actions = align_agent_to_direction(target_direction, current_direction)\n    \n    move_action = translate_movement(target_direction)\n    \n    return turn_actions + [move_action]\n\n  def compute_agent_facing_direction():\n    \"\"\"\n      This function computes the direction in which the agent is currently facing.\n      \n      Returns:\n        Tuple[int, int]: The (x, y) direction vector indicating the current facing direction of the agent.\n                         Values are -1, 0, or 1 indicating the direction in each axis.\n    \"\"\"\n    # Assuming the agent's facing direction is stored in the state\n    return env._current_state.direction\n\n  def align_agent_to_direction(target_direction, current_direction):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent to face the target direction.\n\n      Args:\n        target_direction: A tuple representing the desired (x, y) facing direction.\n        current_direction: A tuple representing the current (x, y) facing direction.\n\n      Returns:\n        List[int]: A list of actions to turn the agent to face the target direction.\n    \"\"\"\n    # Define the mapping from current and target directions to turning actions\n    turn_map = {\n        ((-1, 0), (0, 1)): RIGHT,\n        ((-1, 0), (1, 0)): RIGHT,\n        ((-1, 0), (0, -1)): LEFT,\n\n        ((1, 0), (0, 1)): LEFT,\n        ((1, 0), (-1, 0)): LEFT,\n        ((1, 0), (0, -1)): RIGHT,\n\n        ((0, 1), (-1, 0)): LEFT,\n        ((0, 1), (1, 0)): RIGHT,\n        ((0, 1), (0, -1)): DOWN,\n\n        ((0, -1), (-1, 0)): RIGHT,\n        ((0, -1), (1, 0)): LEFT,\n        ((0, -1), (0, 1)): UP\n    }\n    \n    # Return the corresponding turn action if the current and target directions are different\n    return [turn_map[(current_direction, target_direction)]] if current_direction != target_direction else []\n\n  def translate_movement(direction):\n    \"\"\"\n      This function translates a direction vector into the corresponding movement action.\n\n      Args:\n        direction: A tuple representing the desired (x, y) movement direction.\n                   Values are -1, 0, or 1 indicating the direction in each axis.\n\n      Returns:\n        int: The corresponding movement action.\n    \"\"\"\n    # Define the mapping from direction vectors to actions\n    move_map = {\n        (-1, 0): LEFT,\n        (1, 0): RIGHT,\n        (0, -1): DOWN,\n        (0, 1): UP\n    }\n    \n    return move_map[direction]\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:13:54.616426", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def get_direction(current_pos: tuple, target_pos: tuple) -> int:\n    \"\"\"\n      Determines the action needed to move from current position to target position.\n      \n      Args:\n          current_pos (tuple): Current (x, y) coordinates of the agent.\n          target_pos (tuple): Target (x, y) coordinates to move towards.\n\n      Returns:\n          int: The action to take (LEFT, RIGHT, DOWN, UP).\n    \"\"\"\n    x_diff = np.sign(target_pos[0] - current_pos[0])\n    y_diff = np.sign(target_pos[1] - current_pos[1])\n\n    if x_diff == 1:\n        return RIGHT\n    elif x_diff == -1:\n        return LEFT\n    elif y_diff == 1:\n        return UP\n    elif y_diff == -1:\n        return DOWN\n    else:\n        raise ValueError(\"Invalid target position.\")\n\n  def navigate_to_position(current_pos: tuple, target_pos: tuple) -> list[int]:\n    \"\"\"\n      Generates actions to move the agent from current position to target position.\n      \n      Args:\n          current_pos (tuple): Current (x, y) coordinates of the agent.\n          target_pos (tuple): Target (x, y) coordinates to move towards.\n\n      Returns:\n          List[int]: The sequence of actions needed to reach the target position.\n    \"\"\"\n    path = []\n    while current_pos != target_pos:\n        action = get_direction(current_pos, target_pos)\n        path.append(action)\n\n        # Simulate the agent moving in the chosen direction\n        if action == LEFT:\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif action == RIGHT:\n            current_pos = (current_pos[0] + 1, current_pos[1])\n        elif action == DOWN:\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif action == UP:\n            current_pos = (current_pos[0], current_pos[1] + 1)\n\n    return path\n\n  def find_nearest_instance(item_index: int, grid: np.ndarray) -> tuple or None:\n    \"\"\"\n      Finds the nearest instance of an item in the grid.\n      \n      Args:\n          item_index (int): The index of the item to search for.\n          grid (np.ndarray): The current state of the grid world.\n\n      Returns:\n          Tuple[int, int] or None: The (x, y) coordinates of the nearest instance or None if not found.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type: str or int, grid: np.ndarray) -> tuple or None:\n    \"\"\"\n      Finds the nearest workshop of a given type in the grid.\n      \n      Args:\n          workshop_type (str or int): The name or index of the workshop to search for.\n          grid (np.ndarray): The current state of the grid world.\n\n      Returns:\n          Tuple[int, int] or None: The (x, y) coordinates of the nearest workshop or None if not found.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def gather_and_craft(goal_item: str) -> list[int]:\n    \"\"\"\n      Generates actions to gather required primitives and craft the goal item.\n      \n      Args:\n          goal_item (str): The name of the item to be crafted.\n\n      Returns:\n          List[int]: The sequence of actions needed to gather primitives and craft the item.\n    \"\"\"\n    actions = []\n\n    # Fetch required primitives for the goal\n    goal_index = env.world.cookbook.index[goal_item]\n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        primitive_index = env.world.cookbook.index[primitive]\n        \n        if primitive_index is None:\n            raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n\n        for _ in range(count):\n            nearest_primitive_pos = find_nearest_instance(primitive_index, env._current_state.grid)\n            \n            if nearest_primitive_pos:\n                path_to_primitive = navigate_to_position(env._current_state.pos, nearest_primitive_pos)\n                actions.extend(path_to_primitive)\n                actions.append(USE)  # Gather the primitive\n\n    # Find the nearest workshop for crafting\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    nearest_workshop_pos = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if nearest_workshop_pos:\n        path_to_workshop = navigate_to_position(env._current_state.pos, nearest_workshop_pos)\n        actions.extend(path_to_workshop)\n        actions.append(USE)  # Craft the item\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  try:\n      actions = gather_and_craft(goal_item)\n  except ValueError as e:\n      print(e)\n      actions = []\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:15:23.066371", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(primitives_needed):\n    actions = []\n\n    for primitive, count in primitives_needed.items():\n      nearest_primitive_positions = find_all_instances(primitive, env._current_state.grid)\n      \n      if not nearest_primitive_positions:\n        continue\n      \n      # Prioritize closer primitives\n      nearest_primitive_positions.sort(key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n\n      for _ in range(count):\n        primitive_position = nearest_primitive_positions.pop(0)\n\n        x_dir, y_dir = compute_direction(primitive_position, env._current_state.pos)\n        \n        actions.extend(move_to(x_dir, y_dir))\n        actions.append(USE)\n\n    return actions\n\n  def find_all_instances(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n      return None\n\n    return list(map(tuple, positions))\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    # Handle edge case when the target and current positions are the same\n    if x_dir == 0 and y_dir == 0:\n      return (0, 0)\n\n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n      if x_dir < 0:\n        actions.append(LEFT)\n        x_dir += 1\n      elif x_dir > 0:\n        actions.append(RIGHT)\n        x_dir -= 1\n\n      if y_dir < 0:\n        actions.append(DOWN)\n        y_dir += 1\n      elif y_dir > 0:\n        actions.append(UP)\n        y_dir -= 1\n\n    return actions\n\n  def craft_at_workshop(workshop_type, grid):\n    workshop_position = find_nearest_workshop(workshop_type, grid)\n\n    if not workshop_position:\n      raise ValueError(f\"No {workshop_type} found in the environment.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    actions = move_to(x_dir, y_dir)\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n      workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n      workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if not positions.size:\n      return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n  \n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n\n  actions = gather_and_craft(primitives_needed)\n  \n  # Craft the item at the nearest workshop\n  workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n  actions.extend(craft_at_workshop(workshop_type, env._current_state.grid))\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:15:24.029016", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    actions = []\n    \n    # Sort primitives by distance to minimize travel time\n    sorted_primitives = sort_primitives_by_distance(primitives_needed, env._current_state.grid)\n    \n    for primitive in sorted_primitives:\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n        if nearest_primitive_position:\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Move to the position of the primitive\n            actions.extend(move_to(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n    \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n\n    if workshop_position:\n        x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n        \n        # Move to the position of the workshop\n        actions.extend(move_to(x_dir, y_dir))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n    if not positions.size:\n        return None\n    \n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    # Handle edge case when the target and current positions are the same\n    if x_dir == 0 and y_dir == 0:\n        return (0, 0)\n    \n    return x_dir, y_dir\n\n  def move_to(x_dir, y_dir):\n    actions = []\n\n    while x_dir != 0 or y_dir != 0:\n      if x_dir < 0:\n          actions.append(LEFT)\n          x_dir += 1\n      elif x_dir > 0:\n          actions.append(RIGHT)\n          x_dir -= 1\n\n      if y_dir < 0:\n          actions.append(DOWN)\n          y_dir += 1\n      elif y_dir > 0:\n          actions.append(UP)\n          y_dir -= 1\n\n    return actions\n  \n  def sort_primitives_by_distance(primitives_needed, grid):\n    agent_position = env._current_state.pos\n    \n    sorted_primitives = sorted(primitives_needed.keys(), key=lambda p: min(np.linalg.norm(find_nearest_instance(p, grid) - agent_position, axis=0)))\n    \n    return sorted_primitives\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:22:23.088300", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      Computes the direction vector from the current position to the target position.\n      \n      Args:\n          target_pos: A tuple representing the (x, y) coordinates of the target position.\n          current_pos: A tuple representing the (x, y) coordinates of the current position.\n          \n      Returns:\n          Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                           towards the target position. Values are -1, 0, or 1 indicating the \n                           direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def move_to(target_pos):\n    \"\"\"\n      Generates a sequence of actions to navigate the agent from its current position \n      to the target position. It includes turning in the correct direction before moving.\n      \n      Args:\n          target_pos: A tuple representing the (x, y) coordinates of the target position.\n          \n      Returns:\n          List[int]: A list of actions to move the agent towards the target position.\n    \"\"\"\n    actions = []\n    \n    while env._current_state.pos != target_pos:\n        x_dir, y_dir = compute_direction(target_pos, env._current_state.pos)\n        \n        # Align direction\n        if x_dir < 0 and env._current_state.pos[1] == target_pos[1]:\n            actions.append(LEFT)\n        elif x_dir > 0 and env._current_state.pos[1] == target_pos[1]:\n            actions.append(RIGHT)\n        elif y_dir < 0 and env._current_state.pos[0] == target_pos[0]:\n            actions.append(DOWN)\n        elif y_dir > 0 and env._current_state.pos[0] == target_pos[0]:\n            actions.append(UP)\n\n        # Move step\n        if x_dir != 0:\n            actions.extend([LEFT if x_dir < 0 else RIGHT])\n        elif y_dir != 0:\n            actions.extend([DOWN if y_dir < 0 else UP])\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      Finds the nearest instance of an item in the given grid.\n      \n      Args:\n          item_index: The index of the item to be found.\n          grid: A numpy array representing the current state of the grid world.\n          \n      Returns:\n          Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                           If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      Finds the nearest workshop of a given type in the provided grid.\n      \n      Args:\n          workshop_type: The name or index representing the type of workshop to be found.\n          grid: A numpy array representing the current state of the grid world.\n          \n      Returns:\n          Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                           If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n    return tuple(positions[nearest_index])\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      Gathers the required primitives to craft an item and crafts it.\n      \n      Args:\n          goal_index: The index of the item to be crafted.\n          \n      Returns:\n          List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n        \n        if nearest_primitive_position:\n            actions.extend(move_to(nearest_primitive_position))\n            \n            # Gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position:\n        actions.extend(move_to(workshop_position))\n        \n        # Craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:22:24.079688", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      Computes the direction needed to move from the current position to the target position.\n      \n      Args:\n        target_pos: The (x, y) coordinates of the target position.\n        current_pos: The (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current \n                         position towards the target position.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def navigate_to(target_pos, current_state):\n    \"\"\"\n      Generates actions to navigate from the current state's position to the target position.\n      \n      Args:\n        target_pos: The (x, y) coordinates of the target position.\n        current_state: The current state of the environment.\n\n      Returns:\n        List[int]: A list of actions needed to move from the current position to the target position.\n    \"\"\"\n    actions = []\n    target_x, target_y = target_pos\n    current_x, current_y = current_state.pos\n\n    # Determine if we need to change directions or just move forward\n    while current_x != target_x or current_y != target_y:\n        x_dir, y_dir = compute_direction((target_x, target_y), (current_x, current_y))\n\n        # Determine the action based on the direction needed to move in each axis\n        if x_dir < 0 and y_dir == 0:\n            actions.append(LEFT)\n        elif x_dir > 0 and y_dir == 0:\n            actions.append(RIGHT)\n        elif x_dir == 0 and y_dir < 0:\n            actions.append(DOWN)\n        elif x_dir == 0 and y_dir > 0:\n            actions.append(UP)\n\n        # Update the current position after moving\n        current_x += x_dir\n        current_y += y_dir\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      Finds the nearest instance of an item in the given grid.\n      \n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      Finds the nearest workshop of a given type in the provided grid.\n      \n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if not positions.size:\n        return None\n\n    agent_position = current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      Gathers the required primitives to craft an item and crafts it.\n      \n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    actions = []\n\n    for primitive, count in primitives_needed.items():\n        nearest_primitive_position = find_nearest_instance(primitive, current_state.grid)\n        \n        if nearest_primitive_position:\n            actions.extend(navigate_to(nearest_primitive_position, current_state))\n            \n            # Gather the primitive\n            actions.append(USE)\n\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], current_state.grid)\n    \n    if workshop_position:\n        actions.extend(navigate_to(workshop_position, current_state))\n        \n        # Craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  current_state = env._current_state\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 5, "scores": {"3": 0.5}}
{"timestamp": "2025-09-30T17:25:15.981690", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_primitive(primitive_index):\n    \"\"\"\n      This function generates a sequence of actions to gather the specified primitive.\n      It finds the nearest instance of the primitive and moves the agent there.\n\n      Args:\n        primitive_index: The index of the primitive item to be gathered.\n\n      Returns:\n        List[int]: A list of actions to navigate to and gather the primitive.\n    \"\"\"\n    # Find the nearest instance of the primitive\n    target_position = find_nearest_instance(primitive_index, env._current_state.grid)\n    \n    if not target_position:\n        return []  # If no instance found, return empty action list\n\n    # Generate navigation actions to reach the target position\n    actions = navigate_to(target_position)\n\n    # Append USE action to gather the primitive\n    actions.append(USE)\n\n    return actions\n\n  def craft_item(workshop_type):\n    \"\"\"\n      This function generates a sequence of actions to craft an item at the nearest workshop \n      of the specified type. It navigates the agent to the workshop and performs the crafting.\n\n      Args:\n        workshop_type: The name or index of the workshop where the item can be crafted.\n\n      Returns:\n        List[int]: A list of actions to navigate to and use the workshop for crafting.\n    \"\"\"\n    # Find the nearest workshop of the specified type\n    target_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if not target_position:\n        return []  # If no workshop found, return empty action list\n\n    # Generate navigation actions to reach the target position\n    actions = navigate_to(target_position)\n\n    # Append USE action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def navigate_to(target_pos):\n    \"\"\"\n      This function generates a sequence of actions to move the agent from its current \n      position to the target position. It calculates the direction vector needed and \n      appends the corresponding LEFT, RIGHT, UP, or DOWN actions.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions to navigate the agent to the target position.\n    \"\"\"\n    # Compute the direction vector needed to move towards the target\n    x_dir = np.sign(target_pos[0] - env._current_state.pos[0])\n    y_dir = np.sign(target_pos[1] - env._current_state.pos[1])\n\n    actions = []\n\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n\n    if y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for all cells containing the specified item and returns the \n      position of the closest one.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no such instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position \n      of the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index if necessary\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It handles multiple instances of the same primitive if needed.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            actions.extend(gather_primitive(primitive))\n            \n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    \n    actions.extend(craft_item(workshop_type))\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index.get(goal_item)\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:25:16.962641", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def find_path_to(target_pos):\n    \"\"\"\n      This function uses a simple Breadth-First Search (BFS) algorithm to find a path from \n      the agent's current position to the target position. It avoids obstacles and considers \n      only walkable cells.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n\n      Returns:\n        List[int]: A list of actions that form a path to the target position. If no path is found,\n                   returns an empty list.\n    \"\"\"\n    current_state = env._current_state\n    grid = current_state.grid\n\n    # Directions: (dx, dy)\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    \n    # Map from position to action that led there\n    prev_action_map = {}\n\n    queue = collections.deque([current_state.pos])\n    visited = set([current_state.pos])\n\n    while queue:\n        current_pos = queue.popleft()\n        \n        if current_pos == target_pos:\n            break\n        \n        for direction in directions:\n            new_x, new_y = current_pos[0] + direction[0], current_pos[1] + direction[1]\n            \n            # Check if the new position is within bounds and walkable\n            if 0 <= new_x < grid.shape[0] and 0 <= new_y < grid.shape[1]:\n                if not env.world.is_blocked((new_x, new_y), grid):\n                    if (new_x, new_y) not in visited:\n                        queue.append((new_x, new_y))\n                        visited.add((new_x, new_y))\n                        # Map the new position to the action that led there\n                        prev_action_map[(new_x, new_y)] = direction_to_action(direction)\n\n    if target_pos not in prev_action_map:\n        return []\n\n    # Reconstruct path from start to end\n    path_actions = []\n    current_pos = target_pos\n    \n    while current_pos != current_state.pos:\n        action = prev_action_map[current_pos]\n        path_actions.append(action)\n        \n        # Convert action back to position change\n        if action == UP:\n            current_pos = (current_pos[0], current_pos[1] - 1)\n        elif action == DOWN:\n            current_pos = (current_pos[0], current_pos[1] + 1)\n        elif action == LEFT:\n            current_pos = (current_pos[0] - 1, current_pos[1])\n        elif action == RIGHT:\n            current_pos = (current_pos[0] + 1, current_pos[1])\n\n    # Reverse path to get correct order\n    return list(reversed(path_actions))\n\n  def direction_to_action(direction):\n      \"\"\"\n      Converts a direction vector to the corresponding action.\n\n      Args:\n          direction: A tuple representing the (dx, dy) direction vector.\n\n      Returns:\n          int: The corresponding action.\n      \"\"\"\n      dx, dy = direction\n      \n      if dx == -1:\n          return LEFT\n      elif dx == 1:\n          return RIGHT\n      elif dy == -1:\n          return UP\n      elif dy == 1:\n          return DOWN\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It uses pathfinding to navigate around obstacles.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        for _ in range(count):\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position:\n                # Find path to the nearest instance\n                actions.extend(find_path_to(nearest_primitive_position))\n                \n                # Use action to gather the primitive\n                actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position:\n        # Find path to the nearest workshop\n        actions.extend(find_path_to(workshop_position))\n        \n        # Use action to craft the item at the workshop\n        actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:28:00.894960", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_item):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It also handles cases where the agent might need to move back to its original \n      position after gathering all primitives.\n\n      Args:\n        goal_item: The name of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Get the index of the goal item\n    goal_index = env.world.cookbook.index[goal_item]\n    \n    if goal_index is None:\n        raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n    \n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence and original position\n    actions = []\n    original_pos = env._current_state.pos\n    \n    # Gather each required primitive\n    gathered_primitives = 0\n\n    while gathered_primitives < sum(primitives_needed.values()):\n        for primitive, count in primitives_needed.items():\n            if env._current_state.inventory.get(primitive, 0) >= count:\n                continue\n            \n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n            \n            if nearest_primitive_position is None:\n                raise ValueError(f\"Primitive '{primitive}' not found on the grid.\")\n            \n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Turn and move to the position of the primitive\n            actions.extend(turn_and_move(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n            \n            gathered_primitives += 1\n\n    # Find the nearest workshop for crafting the item\n    workshop_position = find_nearest_workshop(env.world.cookbook.recipes[goal_index][\"_at\"], env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"Workshop not found on the grid.\")\n    \n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Turn and move to the position of the workshop\n    actions.extend(turn_and_move(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    # Move back to the original position if needed\n    if env._current_state.pos != original_pos:\n        x_dir, y_dir = compute_direction(original_pos, env._current_state.pos)\n        actions.extend(turn_and_move(x_dir, y_dir))\n    \n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  \n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_item)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-09-30T17:28:01.910043", "function_name": "make_arrow", "function_body": "  DOWN, UP, LEFT, RIGHT, USE = range(5)\n\n  def gather_and_craft(goal_index):\n    \"\"\"\n      This function gathers the required primitives to craft an item and crafts it.\n      It includes optimizations such as reusing previously gathered items if available in \n      the inventory and avoiding unnecessary turns.\n\n      Args:\n        goal_index: The index of the item to be crafted.\n\n      Returns:\n        List[int]: A list of actions to gather primitives and craft the item.\n    \"\"\"\n    # Fetch required primitives for the goal\n    primitives_needed = env.world.cookbook.primitives_for(goal_index)\n    \n    # Initialize action sequence\n    actions = []\n\n    # Gather each required primitive\n    for primitive, count in primitives_needed.items():\n        while env._current_state.inventory[primitive] < count:\n            nearest_primitive_position = find_nearest_instance(primitive, env._current_state.grid)\n\n            if nearest_primitive_position is None:\n                raise ValueError(f\"No instances of '{primitive}' found in the grid.\")\n\n            x_dir, y_dir = compute_direction(nearest_primitive_position, env._current_state.pos)\n            \n            # Turn and move to the position of the primitive\n            actions.extend(turn_and_move(x_dir, y_dir))\n            \n            # Use action to gather the primitive\n            actions.append(USE)\n\n    # Find the nearest workshop for crafting the item\n    workshop_type = env.world.cookbook.recipes[goal_index][\"_at\"]\n    workshop_position = find_nearest_workshop(workshop_type, env._current_state.grid)\n    \n    if workshop_position is None:\n        raise ValueError(f\"No instances of '{workshop_type}' found in the grid.\")\n\n    x_dir, y_dir = compute_direction(workshop_position, env._current_state.pos)\n    \n    # Turn and move to the position of the workshop\n    actions.extend(turn_and_move(x_dir, y_dir))\n    \n    # Use action to craft the item at the workshop\n    actions.append(USE)\n\n    return actions\n\n  def find_nearest_instance(item_index, grid):\n    \"\"\"\n      This function finds the nearest instance of an item in the given grid.\n      It searches for the closest cell containing the specified item and returns its position.\n\n      Args:\n        item_index: The index of the item to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest instance of the item. \n                         If no instance is found, returns None.\n    \"\"\"\n    # Get positions of all cells containing the item\n    positions = np.argwhere(grid[:, :, item_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the item\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def find_nearest_workshop(workshop_type, grid):\n    \"\"\"\n      This function finds the nearest workshop of a given type in the provided grid.\n      It searches for all workshops of the specified type and returns the position of \n      the closest one.\n\n      Args:\n        workshop_type: The name or index representing the type of workshop to be found.\n        grid: A numpy array representing the current state of the grid world.\n\n      Returns:\n        Tuple[int, int]: The (x, y) coordinates of the nearest workshop of the specified type. \n                         If no such workshop is found, returns None.\n    \"\"\"\n    # Convert workshop_type name to index\n    if isinstance(workshop_type, str):\n        workshop_index = env.world.cookbook.index[workshop_type]\n    else:\n        workshop_index = workshop_type\n    \n    # Get positions of all cells containing the workshop type\n    positions = np.argwhere(grid[:, :, workshop_index] > 0)\n\n    if positions.size == 0:\n        return None\n\n    # Compute distances from the agent's current position to each cell with the workshop\n    agent_position = env._current_state.pos\n    distances = np.linalg.norm(positions - agent_position, axis=1)\n    \n    # Find the index of the closest position\n    nearest_index = np.argmin(distances)\n\n    return tuple(positions[nearest_index])\n\n  def compute_direction(target_pos, current_pos):\n    \"\"\"\n      This function computes the direction (x, y) needed to move from the current position \n      to the target position.\n\n      Args:\n        target_pos: A tuple representing the (x, y) coordinates of the target position.\n        current_pos: A tuple representing the (x, y) coordinates of the current position.\n\n      Returns:\n        Tuple[int, int]: The (x, y) direction vector needed to move from the current position \n                         towards the target position. Values are -1, 0, or 1 indicating the \n                         direction in each axis.\n    \"\"\"\n    x_dir = np.sign(target_pos[0] - current_pos[0])\n    y_dir = np.sign(target_pos[1] - current_pos[1])\n\n    return x_dir, y_dir\n\n  def turn_and_move(x_dir, y_dir):\n    \"\"\"\n      This function generates a sequence of actions to turn the agent in the direction \n      specified by (x_dir, y_dir) and then move one step in that direction.\n\n      Args:\n        x_dir: The desired change in x position (-1, 0, or 1).\n        y_dir: The desired change in y position (-1, 0, or 1).\n\n      Returns:\n        List[int]: A list of actions to turn and move the agent.\n    \"\"\"\n    current_dir = env._current_state.dir\n    target_dir = np.argmax([x_dir == -1, x_dir == 1, y_dir == 1, y_dir == -1])  # Convert direction vector to index\n    \n    # Determine the sequence of actions needed to face the target direction\n    actions = []\n    \n    while current_dir != target_dir:\n        if (current_dir + 1) % 4 == target_dir or (current_dir - 3) % 4 == target_dir:\n            actions.append(RIGHT)\n        else:\n            actions.append(LEFT)\n        current_dir = (current_dir + 1) % 4\n\n    # Add a move action in the target direction\n    if x_dir < 0:\n        actions.append(LEFT)\n    elif x_dir > 0:\n        actions.append(RIGHT)\n    elif y_dir < 0:\n        actions.append(DOWN)\n    elif y_dir > 0:\n        actions.append(UP)\n\n    return actions\n\n  # Example usage: Make an arrow\n  goal_item = \"arrow\"\n  goal_index = env.world.cookbook.index[goal_item]\n  \n  if goal_index is None:\n      raise ValueError(f\"Item '{goal_item}' not found in the cookbook.\")\n\n  # Generate actions to gather primitives and craft the item\n  actions = gather_and_craft(goal_index)\n  \n  return actions", "island_id": 1, "scores": {"3": -1}}
