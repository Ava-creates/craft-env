{"timestamp": "2025-07-24T01:54:42.465057", "function_name": "craft", "function_body": "    total_reward = 0.0\n    cookbook = env.world.cookbook\n    \n    # Get the index of the item to craft\n    item_kind_idx = cookbook.index[item]\n\n    # Retrieve the recipe for the item.\n    # This function assumes 'item' is a craftable item with a recipe.\n    # If 'item' is a primitive (e.g., \"wood\"), it should ideally be handled by a separate 'collect' function\n    # in the DSL. If this function is called with a primitive, it won't have a recipe.\n    # We add a check, but a robust system would rely on the DSL planner calling the correct function.\n    if item_kind_idx not in cookbook.recipes:\n        # If the item has no recipe, it's a primitive. This 'craft' function isn't designed for it.\n        # In a real DSL, a 'collect' function would handle this.\n        # For the purpose of providing a working body, and if 'craft' might sometimes be called\n        # for a primitive in simplified tests, one would implement collection here.\n        # Based on the problem's DSL, assume 'item' for CRAFT_FUNC always has a recipe.\n        return total_reward # Item is not craftable via a recipe.\n\n    recipe = cookbook.recipes[item_kind_idx]\n    \n    # Determine the required workshop and its location\n    workshop_name = recipe.get(\"_at\")\n    if not workshop_name:\n        # Recipe might not require a specific workshop (e.g., hand crafting).\n        # For Craft environment, workshops are explicitly defined.\n        return total_reward\n\n    workshop_idx = cookbook.index[workshop_name]\n    \n    # Find the workshop's coordinates on the grid\n    workshop_coords = None\n    # Iterate through the grid to find the workshop.\n    # Assuming WIDTH and HEIGHT are globally accessible constants as in the provided code.\n    for x_g in range(WIDTH):\n        for y_g in range(HEIGHT):\n            if env._current_state.grid[x_g, y_g, workshop_idx] == 1:\n                workshop_coords = (x_g, y_g)\n                break\n        if workshop_coords: # Break outer loop once found\n            break\n    \n    if not workshop_coords:\n        # If the required workshop isn't in the environment, cannot craft.\n        return total_reward\n\n    # Ensure all ingredients are available in the inventory.\n    # This involves recursively calling craft_v2 for craftable ingredients\n    # and \"collecting\" (via environment steps) for primitive ingredients.\n    for ingredient_idx, count_needed in recipe.items():\n        if isinstance(ingredient_idx, int): # Skip metadata like \"_at\", \"_yield\"\n            while env._current_state.inventory[ingredient_idx] < count_needed:\n                ingredient_name = cookbook.index.get(ingredient_idx)\n                \n                if ingredient_idx in cookbook.primitives:\n                    # It's a primitive ingredient, needs to be collected from the grid.\n                    # The collection strategy here mimics the behavior observed in simple_scenario_simple:\n                    # To collect an item (e.g., wood at (5,6)) from an adjacent cell (e.g., (5,5)),\n                    # the agent tries to move onto the item. This move is blocked by the item,\n                    # so the agent stays in its current cell but its direction is updated.\n                    # Then a USE action collects the item from the adjacent cell.\n                    \n                    primitive_target_coords = None\n                    # Find the primitive on the grid (current state's grid, as it changes after collection)\n                    current_grid = env._current_state.grid\n                    for x_p in range(WIDTH):\n                        for y_p in range(HEIGHT):\n                            if current_grid[x_p, y_p, ingredient_idx] == 1:\n                                primitive_target_coords = (x_p, y_p)\n                                break\n                        if primitive_target_coords:\n                            break\n                    \n                    if not primitive_target_coords:\n                        # Cannot find the primitive on the map, so cannot collect.\n                        return total_reward\n\n                    # Determine the direction to move/face towards the primitive.\n                    # This assumes direct alignment, like in the sample scenario.\n                    # E.g., if primitive is at (x, y+1) and agent is at (x,y), agent moves UP.\n                    action_to_reach_primitive = -1\n                    cx, cy = env._current_state.pos\n                    px, py = primitive_target_coords\n\n                    # Basic greedy movement towards the adjacent position to primitive\n                    # before attempting the \"turn by collision\" and USE.\n                    # The movement part needs to get the agent to the specific adjacent square.\n                    # For a primitive at (px,py), agent needs to be at (px, py-1) and face UP, etc.\n                    \n                    # Target adjacent positions to primitive_target_coords\n                    possible_adj_targets = [\n                        ((px, py - 1), UP),    # Below, facing UP\n                        ((px, py + 1), DOWN),  # Above, facing DOWN\n                        ((px - 1, py), RIGHT), # Left, facing RIGHT\n                        ((px + 1, py), LEFT)   # Right, facing LEFT\n                    ]\n                    \n                    chosen_adj_pos = None\n                    chosen_action_to_face = -1\n\n                    # Find an accessible adjacent spot and the action to face the primitive\n                    for (adj_x, adj_y), action_dir in possible_adj_targets:\n                        # Check if adj_x, adj_y is within bounds and not occupied by boundary or another static obstacle\n                        if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT and \\\n                           not env._current_state.grid[adj_x, adj_y, cookbook.index[\"boundary\"]]:\n                            chosen_adj_pos = (adj_x, adj_y)\n                            chosen_action_to_face = action_dir\n                            break # Found a suitable adjacent position\n\n                    if not chosen_adj_pos:\n                        # No accessible adjacent position found\n                        return total_reward\n\n                    # Move agent to the chosen adjacent position\n                    while env._current_state.pos != chosen_adj_pos:\n                        cx, cy = env._current_state.pos\n                        if cx < chosen_adj_pos[0]:\n                            r, _, _ = env.step(RIGHT)\n                            total_reward += r\n                        elif cx > chosen_adj_pos[0]:\n                            r, _, _ = env.step(LEFT)\n                            total_reward += r\n                        elif cy < chosen_adj_pos[1]:\n                            r, _, _ = env.step(UP)\n                            total_reward += r\n                        elif cy > chosen_adj_pos[1]:\n                            r, _, _ = env.step(DOWN)\n                            total_reward += r\n                        \n                        if env.steps >= env.max_steps: return total_reward\n                    \n                    # Agent is now at `chosen_adj_pos`. Perform a blocked move to turn, then USE.\n                    # This step attempts to move ONTO the primitive, gets blocked, but changes direction.\n                    r, _, _ = env.step(chosen_action_to_face)\n                    total_reward += r\n                    if env.steps >= env.max_steps: return total_reward\n\n                    # Now perform the USE action to collect the primitive.\n                    r, _, _ = env.step(USE)\n                    total_reward += r\n                    if env.steps >= env.max_steps: return total_reward\n\n                else:\n                    # It's a craftable intermediate item, recursively call craft_v2 to obtain it.\n                    r_sub_craft = craft_v2(env, ingredient_name)\n                    total_reward += r_sub_craft\n                    \n                    # Check if max steps reached during sub-craft\n                    if env.steps >= env.max_steps:\n                        return total_reward\n    \n    # All ingredients gathered. Now move to the workshop and craft the target item.\n    current_agent_x, current_agent_y = env._current_state.pos\n    target_wx, target_wy = workshop_coords\n\n    # Determine the adjacent position for the workshop and the direction to face it.\n    action_to_face_workshop = -1\n    chosen_adj_pos_workshop = None\n\n    possible_adj_targets_workshop = [\n        ((target_wx, target_wy - 1), UP),    # Below workshop, facing UP\n        ((target_wx, target_wy + 1), DOWN),  # Above workshop, facing DOWN\n        ((target_wx - 1, target_wy), RIGHT), # Left of workshop, facing RIGHT\n        ((target_wx + 1, target_wy), LEFT)   # Right of workshop, facing LEFT\n    ]\n\n    for (adj_x, adj_y), action_dir in possible_adj_targets_workshop:\n        # Check if adj_x, adj_y is within bounds and not occupied by boundary or another static obstacle\n        if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT and \\\n           not env._current_state.grid[adj_x, adj_y, cookbook.index[\"boundary\"]]:\n            chosen_adj_pos_workshop = (adj_x, adj_y)\n            action_to_face_workshop = action_dir\n            break # Found a suitable adjacent position\n\n    if not chosen_adj_pos_workshop:\n        # No accessible adjacent position to the workshop.\n        return total_reward\n\n    # Move agent to the chosen adjacent position for the workshop\n    while env._current_state.pos != chosen_adj_pos_workshop:\n        cx, cy = env._current_state.pos\n        if cx < chosen_adj_pos_workshop[0]:\n            r, _, _ = env.step(RIGHT)\n            total_reward += r\n        elif cx > chosen_adj_pos_workshop[0]:\n            r, _, _ = env.step(LEFT)\n            total_reward += r\n        elif cy < chosen_adj_pos_workshop[1]:\n            r, _, _ = env.step(UP)\n            total_reward += r\n        elif cy > chosen_adj_pos_workshop[1]:\n            r, _, _ = env.step(DOWN)\n            total_reward += r\n        \n        if env.steps >= env.max_steps: return total_reward\n\n    # Agent is now at `chosen_adj_pos_workshop`. Make sure it faces the workshop.\n    # Perform a step in the direction of the workshop. This step should move the agent *onto* the workshop,\n    # but the workshop is assumed to be an immovable crafting station. So it will get blocked and turn.\n    r, _, _ = env.step(action_to_face_workshop)\n    total_reward += r\n    if env.steps >= env.max_steps: return total_reward\n\n    # Finally, perform the USE action to craft the item at the workshop.\n    r, _, _ = env.step(USE)\n    total_reward += r\n    \n    return total_reward", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-24T01:54:44.178444", "function_name": "craft", "function_body": "  total_reward = 0.0\n  cookbook = env.world.cookbook\n  item_idx = cookbook.index[item]\n\n  # Max steps to prevent infinite loop for unreachable items or complex paths\n  max_craft_attempts_per_item = 50 \n  attempts = 0\n\n  # Constants like DOWN, UP, LEFT, RIGHT, USE are assumed to be globally available\n  # from the CraftWorld environment.\n  # Similarly, MOVE_FUNC and COLLECT_FUNC are assumed to be implemented elsewhere\n  # as part of the DSL, so they are called directly.\n\n  while attempts < max_craft_attempts_per_item:\n    attempts += 1\n    current_inventory = env.observations()['features_dict']['inventory']\n\n    # Check if the item is already crafted\n    if current_inventory[item_idx] > 0:\n      break # Item is successfully crafted, exit loop\n\n    # Get the recipe for the current item\n    recipe = cookbook.recipes.get(item_idx)\n    if not recipe:\n      # If no recipe, it's not a craftable item (e.g., a primitive), so return\n      # accumulated reward as it cannot be crafted.\n      return total_reward \n\n    # Extract required ingredients (filtering out special keys like '_at', '_yield')\n    required_ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}\n    \n    # Determine the crafting station (workshop)\n    workshop_name = recipe.get('_at')\n    workshop_idx = None\n    if workshop_name:\n      workshop_idx = cookbook.index[workshop_name]\n    else:\n      # A craftable item must specify where it's crafted. If not, it's an error in recipe.\n      return total_reward\n\n    # Check for missing ingredients\n    missing_ingredient_to_get = None\n    for ing_idx, count_needed in required_ingredients.items():\n      if current_inventory[ing_idx] < count_needed:\n        missing_ingredient_to_get = (ing_idx, cookbook.index.get(ing_idx)) # (index, name)\n        break # Prioritize getting one missing ingredient at a time\n\n    if missing_ingredient_to_get:\n      ing_idx, ing_name = missing_ingredient_to_get\n      \n      if ing_idx in cookbook.primitives:\n        # If it's a primitive, use COLLECT_FUNC (assumed DSL function)\n        total_reward += COLLECT_FUNC(env, ing_name)\n      else:\n        # If it's another crafted item, recursively call craft_v2 (CRAFT_FUNC)\n        total_reward += craft_v2(env, ing_name)\n      \n      # After attempting to get an ingredient, loop again to re-evaluate inventory\n      continue \n\n    # If all ingredients are present, proceed to crafting at the workshop\n    \n    # Move to the workshop\n    workshop_pos = None\n    current_state = env._current_state\n    grid = current_state.grid \n    \n    # Find the workshop location using numpy (assuming np is available in execution env)\n    workshop_locations = np.argwhere(grid[:, :, workshop_idx] == 1)\n    if len(workshop_locations) > 0:\n      workshop_pos = workshop_locations[0] # Pick the first one if multiple exist\n\n    if workshop_pos is None:\n      # Workshop not found in the environment (e.g., not spawned or already gone)\n      return total_reward \n\n    # Keep moving towards the workshop until adjacent or an obstacle is hit\n    move_attempts = 50 # Limit movement attempts to prevent infinite loops during pathfinding\n    moved_to_adjacent = False\n    for _ in range(move_attempts):\n      current_state = env._current_state # Refresh state after each step\n      if current_state.next_to(workshop_idx):\n        moved_to_adjacent = True\n        break\n      \n      # Calculate direction to move towards workshop\n      target_x, target_y = workshop_pos\n      agent_x, agent_y = current_state.pos\n      \n      dx = target_x - agent_x\n      dy = target_y - agent_y\n      \n      chosen_dir = None\n      if abs(dx) > abs(dy):\n        if dx < 0: chosen_dir = \"LEFT\"\n        elif dx > 0: chosen_dir = \"RIGHT\"\n      else:\n        if dy < 0: chosen_dir = \"DOWN\"\n        elif dy > 0: chosen_dir = \"UP\"\n      \n      if chosen_dir:\n        total_reward += MOVE_FUNC(env, chosen_dir)\n        # Agent's position is updated by MOVE_FUNC via env.step()\n      else:\n        # Agent is stuck (e.g., surrounded by obstacles) or on the target (should be handled by next_to)\n        break \n\n    if not moved_to_adjacent:\n      # Could not reach workshop within allowed moves\n      return total_reward \n\n    # Once adjacent, USE the workshop\n    reward, _, _ = env.step(USE) # USE constant is assumed available\n    total_reward += reward\n    \n    # After USE, the item should be in inventory. The loop condition will check this\n    # in the next iteration.\n    continue # Re-evaluate state at the beginning of the while loop\n\n  return total_reward", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-24T02:05:57.093843", "function_name": "craft", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-24T02:05:58.202863", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Helper for directions to iterate through\n  # (dx, dy) -> action_name mapping for finding items\n  move_directions = [\n      (0, -1, 'DOWN'),\n      (0, 1, 'UP'),\n      (-1, 0, 'LEFT'),\n      (1, 0, 'RIGHT')\n  ]\n\n  # 1. Get the target item's index and its recipe\n  cookbook = env.world.cookbook\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # If item is not in index or no recipe, cannot craft\n    return total_reward \n\n  if recipe is None:\n    # If it's a primitive or unknown, cannot craft via recipe\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # Cannot craft without a workshop\n    return total_reward\n  workshop_idx = cookbook.index[workshop_name]\n\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients\n  for ingredient_idx, needed_count in ingredients.items():\n    while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n      current_state = env._current_state # Direct access to the internal CraftState\n\n      # Check if ingredient is directly adjacent and try to collect it\n      collected_in_this_step = False\n      \n      # Determine if a direct USE action would work\n      target_adjacent_dir_action = None\n      x, y = current_state.pos\n      grid = current_state.grid\n      for dx, dy, action_name in move_directions:\n          nx, ny = x + dx, y + dy\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, ingredient_idx] == 1:\n              target_adjacent_dir_action = action_name\n              break\n      \n      if target_adjacent_dir_action is not None:\n          # If facing the wrong direction, change direction first\n          if current_state.dir != action_map[target_adjacent_dir_action]:\n              reward, done, _ = env.step(action_map[target_adjacent_dir_action])\n              total_reward += reward\n              if done: return total_reward\n              # After changing direction, re-loop to perform USE in the correct direction\n              continue \n          else:\n              # Already facing correct direction or just moved to face it, now USE\n              reward, done, _ = env.step(ACTION_USE)\n              total_reward += reward\n              if done: return total_reward\n              collected_in_this_step = True\n              # Break from this inner logic, inventory is updated, re-evaluate while condition\n      \n      if collected_in_this_step:\n        # Successfully collected, continue to the next iteration of the while loop to check if more are needed\n        continue\n\n      # If not collected yet (either not adjacent or USE failed), try moving to find it\n      moved_to_find_item = False\n      for action_name in ['RIGHT', 'UP', 'LEFT', 'DOWN']: # Simple ordered exploration\n          reward, done, _ = env.step(action_map[action_name])\n          total_reward += reward\n          if done: return total_reward\n          \n          current_state = env._current_state # Update state after move\n          \n          # After moving, check if ingredient is now adjacent and try to collect\n          target_adjacent_dir_action = None\n          x, y = current_state.pos\n          grid = current_state.grid\n          for dx, dy, dir_action_name in move_directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, ingredient_idx] == 1:\n                  target_adjacent_dir_action = dir_action_name\n                  break\n          \n          if target_adjacent_dir_action is not None:\n              if current_state.dir != action_map[target_adjacent_dir_action]:\n                  reward, done, _ = env.step(action_map[target_adjacent_dir_action])\n                  total_reward += reward\n                  if done: return total_reward\n                  \n              reward, done, _ = env.step(ACTION_USE)\n              total_reward += reward\n              if done: return total_reward\n              moved_to_find_item = True\n              break # Break from action_name loop (found and collected)\n      \n      if not moved_to_find_item and not collected_in_this_step:\n          # Fallback: If after trying immediate collection and simple moves, item still not collected.\n          # This indicates limitations of the simple exploration or item is not accessible.\n          # For designed scenarios, this part should ideally not be hit repeatedly without progress.\n          pass # Continue the while loop, relying on max_steps for termination if stuck.\n\n  # 3. Move to the workshop\n  while not env._current_state.next_to(workshop_idx):\n    moved_to_find_workshop = False\n    for action_name in ['RIGHT', 'UP', 'LEFT', 'DOWN']: # Simple ordered exploration\n        reward, done, _ = env.step(action_map[action_name])\n        total_reward += reward\n        if done: return total_reward\n        if env._current_state.next_to(workshop_idx):\n            moved_to_find_workshop = True\n            break\n    if not moved_to_find_workshop:\n        pass # Still not next to workshop, continue trying (or indicate failure)\n\n  # 4. Craft the item at the workshop\n  current_state = env._current_state\n  \n  # Orient towards the workshop\n  target_adjacent_dir_action = None\n  x, y = current_state.pos\n  grid = current_state.grid\n  for dx, dy, action_name in move_directions:\n      nx, ny = x + dx, y + dy\n      if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, workshop_idx] == 1:\n          target_adjacent_dir_action = action_name\n          break\n  \n  if target_adjacent_dir_action is not None:\n      if current_state.dir != action_map[target_adjacent_dir_action]:\n          reward, done, _ = env.step(action_map[target_adjacent_dir_action])\n          total_reward += reward\n          if done: return total_reward\n      \n      # Now USE to craft\n      reward, done, _ = env.step(ACTION_USE)\n      total_reward += reward\n      if done: return total_reward\n  \n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T02:15:16.567601", "function_name": "craft", "function_body": "    item_idx = env.world.cookbook.index[item]\n    recipe = env.world.cookbook.recipes[item_idx]\n    workshop_name = recipe[\"_at\"]\n    workshop_idx = env.world.cookbook.index[workshop_name]\n\n    total_reward = 0.0\n\n    # 1. Find the workshop's position on the grid\n    workshop_pos = None\n    grid = env._current_state.grid\n    WIDTH, HEIGHT, _ = grid.shape\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid[x, y, workshop_idx] == 1:\n                workshop_pos = (x, y)\n                break\n        if workshop_pos:\n            break\n\n    if workshop_pos is None:\n        # The workshop required for crafting the item is not found in the environment.\n        # This task cannot be completed.\n        return total_reward\n\n    # 2. Move the agent to be adjacent to the workshop, face it, and then USE\n    # A generous number of attempts to allow for movement and turning\n    max_attempts = 200\n\n    for _ in range(max_attempts):\n        agent_x, agent_y = env._current_state.pos\n        agent_dir = env._current_state.dir\n        wx, wy = workshop_pos\n\n        is_next_to = env._current_state.next_to(workshop_idx)\n\n        # Determine the required direction the agent needs to face the workshop\n        required_dir = -1\n        if is_next_to:\n            if wx == agent_x + 1 and wy == agent_y:  # Workshop is to the right\n                required_dir = RIGHT\n            elif wx == agent_x - 1 and wy == agent_y:  # Workshop is to the left\n                required_dir = LEFT\n            elif wx == agent_x and wy == agent_y + 1:  # Workshop is up (higher Y)\n                required_dir = UP\n            elif wx == agent_x and wy == agent_y - 1:  # Workshop is down (lower Y)\n                required_dir = DOWN\n\n        if is_next_to and required_dir != -1 and agent_dir == required_dir:\n            # Agent is in position and facing the workshop, so perform the USE action.\n            reward, done, _ = env.step(USE)\n            total_reward += reward\n            # Crafting attempt made, exit loop.\n            break\n\n        elif is_next_to and required_dir != -1 and agent_dir != required_dir:\n            # Agent is next to the workshop but not facing it. Perform an action to turn.\n            # Moving in the 'required_dir' will update the agent's internal direction.\n            # If the target cell is occupied (like the workshop itself), the agent will stay\n            # in its current position but its direction will be updated.\n            action_to_take = required_dir\n            reward, done, _ = env.step(action_to_take)\n            total_reward += reward\n            # Continue the loop to re-check conditions after turning.\n\n        else:  # Agent is not yet next to the workshop, so move towards it.\n            action_to_take = -1\n            dx = wx - agent_x\n            dy = wy - agent_y\n\n            # Prioritize moving along the dimension with the larger absolute difference\n            # to get closer to the workshop.\n            if abs(dx) > abs(dy):\n                if dx > 0:\n                    action_to_take = RIGHT\n                elif dx < 0:\n                    action_to_take = LEFT\n                # If dx is 0 (agent is already aligned on X), then try to move along Y.\n                elif dy > 0:\n                    action_to_take = UP\n                elif dy < 0:\n                    action_to_take = DOWN\n            else:  # abs(dy) >= abs(dx)\n                if dy > 0:\n                    action_to_take = UP\n                elif dy < 0:\n                    action_to_take = DOWN\n                # If dy is 0 (agent is already aligned on Y), then try to move along X.\n                elif dx > 0:\n                    action_to_take = RIGHT\n                elif dx < 0:\n                    action_to_take = LEFT\n\n            if action_to_take != -1:\n                reward, done, _ = env.step(action_to_take)\n                total_reward += reward\n            else:\n                # This case implies the agent is stuck or cannot find a path\n                # towards the workshop (e.g., completely surrounded by obstacles,\n                # or already on the workshop's cell, which shouldn't happen for movement).\n                # Break to prevent an infinite loop.\n                break\n\n    return total_reward", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-24T02:15:18.118017", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Get the integer ID for the target item from the cookbook's index\n  target_item_id = env.world.cookbook.index[item]\n  # Retrieve the recipe for the target item\n  recipe = env.world.cookbook.recipes.get(target_item_id)\n\n  # If no recipe is found for the item, it means it's not craftable\n  # (or an environment item/primitive not intended for this function),\n  # so return the current total reward (0.0).\n  if not recipe:\n    return total_reward\n\n  # 1. Gather Ingredients\n  # Filter out special keys like \"_at\" and \"_yield\" to get only ingredient IDs and counts.\n  ingredients_needed = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  for ingredient_id, count_needed in ingredients_needed.items():\n    # Loop until the agent has the required quantity of the current ingredient\n    while env._current_state.inventory[ingredient_id] < count_needed:\n      # Get the string name of the ingredient from the cookbook's index\n      ingredient_name = env.world.cookbook.index.get(ingredient_id)\n\n      # Check if the ingredient is a primitive (collectable directly) or another craftable item\n      if ingredient_id in env.world.cookbook.primitives:\n        # If primitive, call the DSL's COLLECT_FUNC.\n        # Assumes COLLECT_FUNC finds, navigates to, and picks up one instance.\n        total_reward += COLLECT_FUNC(env, ingredient_name)\n      else:\n        # If craftable, recursively call craft_v2 to craft it.\n        # Assumes the recursive call will craft one instance.\n        total_reward += craft_v2(env, ingredient_name)\n\n  # 2. Move to Workshop\n  # Get the name and ID of the workshop required for this recipe\n  workshop_name = recipe[\"_at\"]\n  workshop_id = env.world.cookbook.index[workshop_name]\n\n  # Find the exact (x, y) coordinates of the workshop on the grid\n  workshop_pos = None\n  # WIDTH and HEIGHT are assumed to be globally accessible constants from the environment setup\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      if env._current_state.grid[x, y, workshop_id] == 1:\n        workshop_pos = (x, y)\n        break\n    if workshop_pos:\n      break\n\n  if not workshop_pos:\n    # If the workshop is not found, it's an unexpected scenario. Return current reward.\n    return total_reward\n\n  # Define potential adjacent positions to the workshop where the agent can stand\n  # and the direction it should face from that position to interact with the workshop.\n  # Constants UP, DOWN, LEFT, RIGHT are assumed globally accessible.\n  target_adj_states = []\n  wx, wy = workshop_pos\n  if wx > 0:\n    target_adj_states.append((wx - 1, wy, RIGHT)) # Agent at (wx-1, wy) faces RIGHT to workshop\n  if wx < WIDTH - 1:\n    target_adj_states.append((wx + 1, wy, LEFT))  # Agent at (wx+1, wy) faces LEFT\n  if wy > 0:\n    target_adj_states.append((wx, wy - 1, UP))    # Agent at (wx, wy-1) faces UP\n  if wy < HEIGHT - 1:\n    target_adj_states.append((wx, wy + 1, DOWN))  # Agent at (wx, wy+1) faces DOWN\n\n  stuck_counter = 0\n  max_stuck_attempts = 100 # Safeguard to prevent infinite loops if agent gets stuck\n\n  reached_adjacent_position = False\n  # Loop to move the agent until it is in one of the desired adjacent positions\n  while not reached_adjacent_position and stuck_counter < max_stuck_attempts:\n    current_x, current_y = env._current_state.pos\n\n    # Check if the agent is already at one of the target adjacent positions\n    for target_x, target_y, _ in target_adj_states:\n      if current_x == target_x and current_y == target_y:\n        reached_adjacent_position = True\n        break\n    if reached_adjacent_position:\n      break # Exit loop if position reached\n\n    old_pos = (current_x, current_y) # Store position to detect if agent got stuck\n\n    # Determine the closest valid adjacent position to move towards\n    best_target_pos = None\n    min_dist = float('inf')\n    for tx, ty, _ in target_adj_states:\n      dist = abs(current_x - tx) + abs(current_y - ty)\n      if dist < min_dist:\n        min_dist = dist\n        best_target_pos = (tx, ty)\n\n    if not best_target_pos:\n      # No valid adjacent target positions found, break (e.g., workshop unreachable)\n      break\n\n    # Perform a greedy move towards the best target position\n    # Prioritize horizontal movement first\n    moved_this_step = False\n    if current_x < best_target_pos[0]:\n      total_reward += MOVE_FUNC(env, \"RIGHT\")\n      moved_this_step = True\n    elif current_x > best_target_pos[0]:\n      total_reward += MOVE_FUNC(env, \"LEFT\")\n      moved_this_step = True\n    elif current_y < best_target_pos[1]: # Move vertically if horizontal target reached or not possible\n      total_reward += MOVE_FUNC(env, \"UP\")\n      moved_this_step = True\n    elif current_y > best_target_pos[1]:\n      total_reward += MOVE_FUNC(env, \"DOWN\")\n      moved_this_step = True\n\n    # Check if the agent's position changed after the move attempt\n    if env._current_state.pos == old_pos:\n      stuck_counter += 1 # Agent did not move, increment stuck counter\n    else:\n      stuck_counter = 0 # Agent moved, reset stuck counter\n\n  # After reaching an adjacent position (or getting stuck), ensure agent faces the workshop.\n  # The MOVE_FUNC sets the agent's direction upon completion.\n  # If the agent is already in the correct adjacent position but facing the wrong way\n  # (e.g., arrived from a different direction), we need to force a direction change.\n  # The DSL lacks a 'TURN' action, so we perform a dummy move in the desired direction.\n  # This move will likely fail (as the cell is occupied by the workshop or blocked),\n  # but it will correctly update the agent's internal direction state.\n  \n  final_dir_action_constant = -1 # Integer constant for the final desired direction (UP, DOWN, etc.)\n  current_x, current_y = env._current_state.pos\n\n  # Find the required direction based on the agent's current adjacent position\n  for target_x, target_y, required_dir_const in target_adj_states:\n    if current_x == target_x and current_y == target_y:\n      final_dir_action_constant = required_dir_const\n      break\n\n  # If the agent successfully reached a valid adjacent position\n  if final_dir_action_constant != -1:\n    # Map the direction constant back to its string representation for MOVE_FUNC\n    dir_map_rev = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\"}\n    \n    # Perform a dummy move in the correct direction. This sets the agent's facing direction.\n    total_reward += MOVE_FUNC(env, dir_map_rev[final_dir_action_constant])\n\n    # 3. Use Workshop (Craft)\n    # USE is a constant assumed to be globally accessible.\n    reward_use, _, _ = env.step(USE)\n    total_reward += reward_use\n\n  return total_reward", "island_id": 6, "scores": {}}
{"timestamp": "2025-07-24T02:25:27.604039", "function_name": "craft", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-24T02:25:27.622548", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    # Get item index from the cookbook's index\n    item_idx = env.world.cookbook.index[item]\n\n    # Get required primitive ingredients for the item\n    # This returns a dictionary mapping primitive item indices to their required counts\n    needed_primitives = env.world.cookbook.primitives_for(item_idx)\n\n    current_state = env._current_state # Get the current state of the environment\n\n    # Cache grid dimensions for efficient iteration\n    grid_width = current_state.grid.shape[0]\n    grid_height = current_state.grid.shape[1]\n\n    # Phase 1: Collect all necessary primitive ingredients\n    for primitive_idx, required_count in needed_primitives.items():\n        # Loop until enough of the current primitive is in inventory\n        while current_state.inventory[primitive_idx] < required_count:\n            # Find the closest instance of this primitive on the grid\n            grid = current_state.grid\n            current_pos = current_state.pos\n            min_dist = float('inf')\n            target_item_pos = None\n\n            for x_g in range(grid_width):\n                for y_g in range(grid_height):\n                    if grid[x_g, y_g, primitive_idx] == 1: # If the primitive is found at (x_g, y_g)\n                        # Calculate Manhattan distance to the item\n                        dist = abs(x_g - current_pos[0]) + abs(y_g - current_pos[1])\n                        if dist < min_dist:\n                            min_dist = dist\n                            target_item_pos = (x_g, y_g)\n            \n            # If the primitive is no longer on the grid (e.g., already collected by a previous action)\n            if target_item_pos is None:\n                break # Exit this inner loop, moving to the next primitive or phase 2\n\n            tx, ty = target_item_pos\n            cx, cy = current_pos\n\n            action_taken = False\n            \n            # If the item is directly adjacent (Manhattan distance 1), use it\n            if min_dist == 1:\n                # Set agent's direction to face the item for the 'USE' action\n                # Action constants: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n                if tx > cx: # Item is to the right\n                    current_state.dir = 3 # RIGHT\n                elif tx < cx: # Item is to the left\n                    current_state.dir = 2 # LEFT\n                elif ty > cy: # Item is above (UP)\n                    current_state.dir = 1 # UP\n                elif ty < cy: # Item is below (DOWN)\n                    current_state.dir = 0 # DOWN\n                \n                # Perform the USE action\n                reward, done, obs = env.step(4) # USE is action 4\n                total_reward += reward\n                current_state = env._current_state # Update the local state reference from the environment\n                action_taken = True\n            \n            # If the item is not adjacent, move closer\n            elif min_dist > 1:\n                # Prioritize horizontal movement, then vertical\n                if cx != tx:\n                    action_to_take = 3 if tx > cx else 2 # RIGHT (3) or LEFT (2)\n                    reward, done, obs = env.step(action_to_take)\n                    total_reward += reward\n                    current_state = env._current_state\n                    action_taken = True\n                elif cy != ty:\n                    action_to_take = 1 if ty > cy else 0 # UP (1) or DOWN (0)\n                    reward, done, obs = env.step(action_to_take)\n                    total_reward += reward\n                    current_state = env._current_state\n                    action_taken = True\n            \n            # If no action was taken (e.g., agent is blocked or on the same tile as item, which shouldn't happen for collectibles)\n            # Break to prevent infinite loops if unable to reach the item.\n            if not action_taken and min_dist > 0:\n                break \n\n    # Phase 2: Move to the required workshop (if any) and craft the item\n    # First, check if the item is already in inventory after collecting primitives (unlikely for a craftable item)\n    if current_state.inventory[item_idx] > 0:\n        return total_reward\n\n    # Get the recipe for the item to find its crafting requirements (e.g., specific workshop)\n    recipe = env.world.cookbook.recipes.get(item_idx)\n    \n    # If no recipe is found for the item (e.g., it's a primitive or an invalid item)\n    if recipe is None:\n        return total_reward # Cannot craft\n\n    workshop_idx = -1\n    workshop_name = None\n    # Check if the recipe requires a specific workshop using the \"_at\" key\n    if \"_at\" in recipe:\n        workshop_name = recipe[\"_at\"]\n        workshop_idx = env.world.cookbook.index[workshop_name]\n    else:\n        # All craftable items in Craft environment typically require a workshop.\n        # If \"_at\" is missing, crafting with 'USE' is not supported for this item.\n        return total_reward\n\n    # Find the workshop's location on the grid\n    target_x, target_y = -1, -1\n    grid = current_state.grid\n    for x_g in range(grid_width):\n        for y_g in range(grid_height):\n            if grid[x_g, y_g, workshop_idx] == 1:\n                target_x, target_y = x_g, y_g\n                break\n        if target_x != -1: break # Workshop found\n\n    # If the workshop is not found on the grid, cannot craft\n    if target_x == -1:\n        return total_reward \n\n    # Move to the workshop until the agent is adjacent to it\n    # `CraftState.next_to(kind_index)` checks if an item of `kind_index` is adjacent\n    while not current_state.next_to(workshop_idx):\n        cx, cy = current_state.pos\n        tx, ty = target_x, target_y\n\n        action_taken = False\n        # Move horizontally towards the workshop\n        if cx != tx:\n            action_to_take = 3 if tx > cx else 2 # RIGHT (3) or LEFT (2)\n            reward, done, obs = env.step(action_to_take)\n            total_reward += reward\n            current_state = env._current_state\n            action_taken = True\n        # If horizontally aligned, move vertically\n        elif cy != ty:\n            action_to_take = 1 if ty > cy else 0 # UP (1) or DOWN (0)\n            reward, done, obs = env.step(action_to_take)\n            total_reward += reward\n            current_state = env._current_state\n            action_taken = True\n        \n        # If no action was taken (e.g., agent is stuck or already at target location but not adjacent)\n        # Break to prevent infinite loops.\n        if not action_taken:\n            break \n\n    # Agent is now adjacent to the workshop. Perform the USE action to craft.\n    # Set agent's direction to face the workshop for the 'USE' action to ensure it interacts correctly.\n    workshop_neighbor_pos = None\n    cx, cy = current_state.pos\n    # Check direct neighbors (right, left, up, down) relative to the agent's position\n    for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n        nx, ny = cx + dx, cy + dy\n        if 0 <= nx < grid_width and 0 <= ny < grid_height:\n            if grid[nx, ny, workshop_idx] == 1:\n                workshop_neighbor_pos = (nx, ny)\n                break\n    \n    if workshop_neighbor_pos: # If a workshop neighbor position was found\n        # Update current_state.dir to face the workshop\n        if workshop_neighbor_pos[0] > cx:\n            current_state.dir = 3 # RIGHT\n        elif workshop_neighbor_pos[0] < cx:\n            current_state.dir = 2 # LEFT\n        elif workshop_neighbor_pos[1] > cy:\n            current_state.dir = 1 # UP\n        elif workshop_neighbor_pos[1] < cy:\n            current_state.dir = 0 # DOWN\n\n    # Perform the USE action at the workshop to craft the item\n    reward, done, obs = env.step(4) # USE is action 4\n    total_reward += reward\n    # current_state is automatically updated internally by env.step()\n\n    return total_reward", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-24T02:33:29.946167", "function_name": "craft", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-24T02:33:29.963531", "function_name": "craft", "function_body": "    total_reward = 0.0\n    cookbook = env.world.cookbook\n    target_item_idx = cookbook.index[item]\n\n    # Check if the item is a primitive. If so, collect it.\n    if target_item_idx in cookbook.primitives:\n        # Find the primitive on the grid\n        item_found_pos = None\n        current_grid = env._current_state.grid\n        # WIDTH and HEIGHT are global constants from craft_env.py\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if current_grid[x, y, target_item_idx] == 1:\n                    item_found_pos = (x, y)\n                    break\n            if item_found_pos:\n                break\n\n        if item_found_pos:\n            target_x, target_y = item_found_pos\n\n            # Move agent adjacent to the item\n            # The loop continues as long as the agent is not directly adjacent (Manhattan distance > 1)\n            while abs(env._current_state.pos[0] - target_x) + abs(env._current_state.pos[1] - target_y) != 1:\n                current_x, current_y = env._current_state.pos\n                action_to_take = -1\n\n                # Prioritize horizontal movement to align x, then vertical to align y\n                if current_x < target_x:\n                    action_to_take = env.action_specs()['RIGHT']\n                elif current_x > target_x:\n                    action_to_take = env.action_specs()['LEFT']\n                elif current_y < target_y: # Only if x is already aligned or cannot move horizontally\n                    action_to_take = env.action_specs()['UP']\n                elif current_y > target_y:\n                    action_to_take = env.action_specs()['DOWN']\n                \n                if action_to_take != -1:\n                    reward, _, _ = env.step(action_to_take)\n                    total_reward += reward\n                else:\n                    # Should only happen if already adjacent or stuck. Break to avoid infinite loop.\n                    break \n            \n            # Now, the agent should be adjacent to the item.\n            # Ensure the agent is facing the item. The last move would have set the direction.\n            # However, if the agent *started* adjacent but facing the wrong way, we need to explicitly turn.\n            # Turning is done by attempting to move in the desired direction, which updates `dir` even if `pos` doesn't change.\n            current_x, current_y = env._current_state.pos\n            rel_x = target_x - current_x\n            rel_y = target_y - current_y\n\n            dir_to_face = -1\n            if rel_x == 1 and rel_y == 0: dir_to_face = env.action_specs()['RIGHT']\n            elif rel_x == -1 and rel_y == 0: dir_to_face = env.action_specs()['LEFT']\n            elif rel_x == 0 and rel_y == 1: dir_to_face = env.action_specs()['UP']\n            elif rel_x == 0 and rel_y == -1: dir_to_face = env.action_specs()['DOWN']\n\n            # If current direction is not the desired direction, take a step to change direction\n            if dir_to_face != -1 and env._current_state.dir != dir_to_face:\n                reward, _, _ = env.step(dir_to_face)\n                total_reward += reward\n            \n            # Finally, perform the USE action to pick up the item\n            reward, _, _ = env.step(env.action_specs()['USE'])\n            total_reward += reward\n\n    # If the item is craftable (not a primitive)\n    elif target_item_idx in cookbook.recipes:\n        recipe = cookbook.recipes[target_item_idx]\n\n        # 1. Gather ingredients recursively\n        for ingredient_idx, count_needed in recipe.items():\n            if isinstance(ingredient_idx, int): # It's a real ingredient (not a special key like \"_at\")\n                item_name_to_craft = cookbook.index.get(ingredient_idx)\n                current_inventory_count = env._current_state.inventory[ingredient_idx]\n                num_to_get = count_needed - current_inventory_count\n                \n                for _ in range(num_to_get):\n                    # Recursively call craft_v1 for this ingredient\n                    # This ensures all necessary sub-items are acquired (either picked up or crafted)\n                    reward_from_ingredient = craft_v1(env, item_name_to_craft)\n                    total_reward += reward_from_ingredient\n\n        # 2. Move to the required workshop (if any)\n        if \"_at\" in recipe:\n            workshop_name = recipe[\"_at\"]\n            workshop_idx = cookbook.index[workshop_name]\n\n            # Find workshop location on the grid\n            workshop_pos = None\n            current_grid = env._current_state.grid\n            for x in range(WIDTH):\n                for y in range(HEIGHT):\n                    if current_grid[x, y, workshop_idx] == 1:\n                        workshop_pos = (x, y)\n                        break\n                if workshop_pos:\n                    break\n\n            if workshop_pos:\n                target_x, target_y = workshop_pos\n                \n                # Move agent adjacent to the workshop\n                # Similar movement logic as for primitives, to get adjacent and face it\n                while abs(env._current_state.pos[0] - target_x) + abs(env._current_state.pos[1] - target_y) != 1:\n                    current_x, current_y = env._current_state.pos\n                    action_to_take = -1\n\n                    if current_x < target_x:\n                        action_to_take = env.action_specs()['RIGHT']\n                    elif current_x > target_x:\n                        action_to_take = env.action_specs()['LEFT']\n                    elif current_y < target_y:\n                        action_to_take = env.action_specs()['UP']\n                    elif current_y > target_y:\n                        action_to_take = env.action_specs()['DOWN']\n                    \n                    if action_to_take != -1:\n                        reward, _, _ = env.step(action_to_take)\n                        total_reward += reward\n                    else:\n                        break # Agent is already adjacent or stuck\n\n                # Ensure agent is facing the workshop, same as for primitives\n                current_x, current_y = env._current_state.pos\n                rel_x = target_x - current_x\n                rel_y = target_y - current_y\n\n                dir_to_face = -1\n                if rel_x == 1 and rel_y == 0: dir_to_face = env.action_specs()['RIGHT']\n                elif rel_x == -1 and rel_y == 0: dir_to_face = env.action_specs()['LEFT']\n                elif rel_x == 0 and rel_y == 1: dir_to_face = env.action_specs()['UP']\n                elif rel_x == 0 and rel_y == -1: dir_to_face = env.action_specs()['DOWN']\n\n                if dir_to_face != -1 and env._current_state.dir != dir_to_face:\n                    reward, _, _ = env.step(dir_to_face)\n                    total_reward += reward\n        \n        # 3. Perform the USE action to craft the item\n        reward, _, _ = env.step(env.action_specs()['USE'])\n        total_reward += reward\n\n    return total_reward", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-24T02:56:50.240069", "function_name": "craft", "function_body": "    total_reward = 0.0\n    item_idx = env.world.cookbook.index[item]\n\n    # Constants (assuming they are accessible from the global scope where CraftLab is defined)\n    # WIDTH = 12\n    # HEIGHT = 12\n    # DOWN = 0\n    # UP = 1\n    # LEFT = 2\n    # RIGHT = 3\n    # USE = 4\n\n    # Max steps for the entire crafting attempt within this function call.\n    # This prevents infinite loops if the item is unreachable or ingredients are missing.\n    # It should not exceed the environment's total max_steps.\n    craft_attempts_limit = 200 \n    steps_taken_by_craft_func = 0\n\n    while env._current_state.inventory[item_idx] == 0 and not env._is_done() and steps_taken_by_craft_func < craft_attempts_limit:\n        recipe = env.world.cookbook.recipes.get(item_idx)\n        if recipe is None:\n            # If the item is not a craftable recipe output, this function cannot craft it.\n            # It might be a primitive that needs to be 'collected' by a different DSL function.\n            break # Exit if item is not craftable\n\n        ingredients_needed = {idx: count for idx, count in recipe.items() if isinstance(idx, int)}\n        workshop_name = recipe.get(\"_at\")\n        workshop_idx = env.world.cookbook.index[workshop_name] if workshop_name else None\n\n        # Phase 1: Acquire all necessary ingredients\n        all_ingredients_present = True\n        for ing_idx, count_needed in ingredients_needed.items():\n            if env._current_state.inventory[ing_idx] < count_needed:\n                all_ingredients_present = False\n                \n                # Attempt to collect this missing ingredient\n                # Simple reactive strategy: try moving around and using until we get it.\n                initial_ing_count = env._current_state.inventory[ing_idx]\n                \n                # Loop for a few steps to actively search for and pick up the ingredient\n                sub_steps_for_ing = 0\n                max_sub_steps = 10 \n                while env._current_state.inventory[ing_idx] < count_needed and sub_steps_for_ing < max_sub_steps and not env._is_done():\n                    # Try moving in all cardinal directions to explore adjacent cells\n                    # and potentially position for pickup.\n                    for action_dir in [UP, DOWN, LEFT, RIGHT]:\n                        r, d, o = env.step(action_dir)\n                        total_reward += r\n                        steps_taken_by_craft_func += 1\n                        if env._is_done(): return total_reward\n                        \n                        # If a useful item was picked up (inventory increased), break early\n                        if env._current_state.inventory[ing_idx] > initial_ing_count: \n                            break \n                    \n                    # After exploring directions, try to USE to pick up if now adjacent/facing\n                    r, d, o = env.step(USE)\n                    total_reward += r\n                    steps_taken_by_craft_func += 1\n                    if env._is_done(): return total_reward\n                    \n                    # If the ingredient count increased, we succeeded in this sub-attempt\n                    if env._current_state.inventory[ing_idx] > initial_ing_count:\n                        break \n                    \n                    sub_steps_for_ing += 1\n\n                if env._current_state.inventory[ing_idx] < count_needed: # If still missing after active search\n                    # Fallback: take a general exploration step (e.g., move RIGHT) to find items further away\n                    r, d, o = env.step(RIGHT)\n                    total_reward += r\n                    steps_taken_by_craft_func += 1\n                    if env._is_done(): return total_reward\n                \n                # After trying to collect one instance of this ingredient, re-evaluate all ingredients\n                # in the next iteration of the main loop.\n                break \n\n        if env._is_done(): return total_reward\n        if not all_ingredients_present:\n            # If not all ingredients are present after an attempt to collect,\n            # continue the main loop to re-check and try again.\n            continue\n\n        # Phase 2: Move to workshop and Use (if required)\n        if workshop_idx is not None:\n            # First, move to be adjacent to the workshop\n            sub_steps_for_workshop = 0\n            max_sub_steps = 10\n            while not env._current_state.next_to(workshop_idx) and sub_steps_for_workshop < max_sub_steps and not env._is_done():\n                # Explore by trying all cardinal directions\n                for action_dir in [UP, DOWN, LEFT, RIGHT]:\n                    r, d, o = env.step(action_dir)\n                    total_reward += r\n                    steps_taken_by_craft_func += 1\n                    if env._is_done(): return total_reward\n                    if env._current_state.next_to(workshop_idx): # Check if we are now next to it\n                        break\n\n                if not env._current_state.next_to(workshop_idx): # If still not next to it after directional steps\n                    # Fallback: take a general exploration step\n                    r, d, o = env.step(RIGHT) \n                    total_reward += r\n                    steps_taken_by_craft_func += 1\n                    if env._is_done(): return total_reward\n                \n                sub_steps_for_workshop += 1\n\n            if env._is_done(): return total_reward\n\n            # Now that agent is (ideally) next to the workshop, attempt to USE it.\n            if env._current_state.next_to(workshop_idx):\n                # Orient the agent towards the workshop for the USE action to be effective.\n                # Find the exact coordinates of the adjacent workshop\n                current_x, current_y = env._current_state.pos\n                found_workshop_pos = None\n                for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Check immediate neighbors\n                    nx, ny = current_x + dx, current_y + dy\n                    if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and env._current_state.grid[nx, ny, workshop_idx] == 1:\n                        found_workshop_pos = (nx, ny)\n                        break\n                \n                if found_workshop_pos:\n                    # Calculate the direction to face the workshop\n                    target_dx, target_dy = found_workshop_pos[0] - current_x, found_workshop_pos[1] - current_y\n                    target_dir_action = -1\n                    if target_dx == -1: target_dir_action = LEFT\n                    elif target_dx == 1: target_dir_action = RIGHT\n                    elif target_dy == -1: target_dir_action = DOWN\n                    elif target_dy == 1: target_dir_action = UP\n                    \n                    # If current direction is not already correct, attempt to turn by taking a step in that direction.\n                    # This might result in moving (if space is free) or staying put (if hitting an obstacle/wall),\n                    # but crucially it updates the agent's internal direction.\n                    if target_dir_action != -1 and env._current_state.dir != target_dir_action:\n                        r, d, o = env.step(target_dir_action) \n                        total_reward += r\n                        steps_taken_by_craft_func += 1\n                        if env._is_done(): return total_reward\n\n                # Perform the USE action to craft the item\n                r, d, o = env.step(USE)\n                total_reward += r\n                steps_taken_by_craft_func += 1\n                if env._is_done(): return total_reward\n            else:\n                # If for some reason agent is not next to workshop, try general exploration.\n                r, d, o = env.step(RIGHT)\n                total_reward += r\n                steps_taken_by_craft_func += 1\n                if env._is_done(): return total_reward\n    \n    return total_reward", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-24T02:56:50.255751", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    cookbook = env.world.cookbook\n    # Get the integer index for the item to craft (e.g., \"PLANK\" -> 10)\n    item_idx = cookbook.index[item] \n    # Get the recipe for this item from the cookbook\n    recipe = cookbook.recipes[item_idx]\n\n    # 1. Collect all necessary primitive ingredients for the item\n    # `primitives_for` expands sub-recipes to their base primitive components\n    needed_primitives = cookbook.primitives_for(item_idx)\n    for primitive_idx, count in needed_primitives.items():\n        primitive_name = cookbook.index.get(primitive_idx) # Get string name (e.g., \"wood\")\n\n        # Keep collecting this primitive until we have the required count\n        while env._current_state.inventory[primitive_idx] < count:\n            # Call the DSL's COLLECT_FUNC to acquire one unit of the primitive.\n            # Assume COLLECT_FUNC handles navigation to the item and picking it up.\n            # Assume COLLECT_FUNC returns the reward obtained from this collection step.\n            step_reward = COLLECT_FUNC(env, primitive_name)\n            total_reward += step_reward\n            \n            # If the environment has run out of steps or COLLECT_FUNC failed to collect\n            # (indicated by not increasing inventory and non-positive reward), stop trying.\n            if env.steps >= env.max_steps or (env._current_state.inventory[primitive_idx] < count and step_reward <= 0):\n                # Return current total_reward, potentially indicating an incomplete task\n                return total_reward\n\n    # 2. Identify the target crafting workshop\n    # The recipe specifies which workshop is needed (e.g., \"workshop1\")\n    workshop_name = recipe[\"_at\"]\n    workshop_idx = cookbook.index[workshop_name] # Get integer index for the workshop\n\n    # Find the exact coordinates of the workshop on the grid\n    target_wx, target_wy = -1, -1\n    grid = env._current_state.grid\n    # np.where returns a tuple of arrays: (x_coords, y_coords, kind_indices)\n    workshop_coords = np.where(grid[:, :, workshop_idx] == 1)\n    if workshop_coords[0].size > 0:\n        # Assuming there's at least one instance of the required workshop, pick the first one found\n        target_wx, target_wy = workshop_coords[0][0], workshop_coords[1][0]\n    else:\n        # If the workshop isn't found, the item cannot be crafted in this scenario.\n        # Return a penalized reward to indicate failure.\n        return total_reward - 1.0 \n\n    # Constants for direction actions, mapping DSL directions to CraftWorld integer IDs\n    # These integer IDs are used by env.step and assumed to be understood by MOVE_FUNC.\n    DOWN = 0 \n    UP = 1\n    LEFT = 2\n    RIGHT = 3 \n\n    # Navigate the agent to be adjacent to the workshop\n    # Set a maximum number of navigation attempts to prevent infinite loops,\n    # especially if the path is blocked or the greedy navigation gets stuck.\n    max_nav_attempts = env.max_steps # Heuristic: allow up to total max steps for navigation\n    nav_attempts = 0\n\n    # Loop until the agent is adjacent to the workshop or max attempts are reached\n    while not env._current_state.next_to(workshop_idx) and nav_attempts < max_nav_attempts:\n        ax, ay = env._current_state.pos # Current agent position\n\n        # Determine the target direction based on Manhattan distance\n        dx = target_wx - ax\n        dy = target_wy - ay\n\n        dir_to_move = None\n        # Prioritize movement along the axis with the larger coordinate difference\n        # This is a simple greedy approach for pathfinding.\n        if abs(dx) > abs(dy): \n            if dx > 0:\n                dir_to_move = RIGHT \n            elif dx < 0:\n                dir_to_move = LEFT \n        else: # If vertical distance is greater or equal, prioritize vertical movement\n            if dy > 0:\n                dir_to_move = UP \n            elif dy < 0:\n                dir_to_move = DOWN \n        \n        # If no movement is determined (e.g., agent is already on target, or dx/dy are both 0)\n        if dir_to_move is None:\n            break # Exit navigation loop\n\n        # Call the DSL's MOVE_FUNC to move the agent in the determined direction.\n        # Assume MOVE_FUNC returns the reward obtained from this move step.\n        step_reward = MOVE_FUNC(env, dir_to_move)\n        total_reward += step_reward\n        nav_attempts += 1\n        \n        # Check if the overall environment step limit has been reached during navigation\n        if env.steps >= env.max_steps:\n            return total_reward\n\n    # 3. Perform the USE action to craft the item at the workshop\n    # The agent should now be positioned adjacent to the workshop and correctly oriented\n    # by the last navigation step that brought it adjacent.\n    if env._current_state.next_to(workshop_idx):\n        use_action_id = env.action_specs()['USE'] # Get the integer ID for the 'USE' action\n        use_reward, done, _ = env.step(use_action_id) # Perform the USE action\n        total_reward += use_reward\n        # At this point, if crafting was successful, `done` might be true if this completes the main task.\n        # The reward for crafting the actual item is given by CraftLab's _get_reward.\n    else:\n        # If after all navigation attempts, the agent is still not next to the workshop,\n        # it means crafting cannot proceed. Penalize for failed navigation.\n        total_reward -= 0.5 # Penalty for failing to reach crafting station.\n\n    return total_reward", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:10:58.031956", "function_name": "craft", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:10:58.048740", "function_name": "craft", "function_body": "    total_reward = 0.0\n    \n    # Map item string to its index in the cookbook\n    item_idx = env.world.cookbook.index[item]\n    \n    # Get the recipe for the target item\n    recipe = env.world.cookbook.recipes.get(item_idx)\n    \n    if recipe is None:\n        # If the item is not in recipes, it might be a primitive that should be collected, not crafted.\n        # Or it's an invalid item name.\n        # Given the DSL structure, CRAFT_FUNC is specifically for crafting.\n        print(f\"Error: {item} is not a craftable item (no recipe found).\")\n        return total_reward\n\n    # Determine how many units this recipe yields per craft (default to 1)\n    yield_amount = recipe.get(\"_yield\", 1)\n\n    # Maximum attempts to craft the item, to prevent infinite loops in case of issues\n    max_crafting_overall_attempts = 50 \n    overall_craft_attempts = 0\n\n    # Loop until at least one unit of the target item is in inventory\n    # or we exceed maximum attempts.\n    while env._current_state.inventory[item_idx] == 0 and overall_craft_attempts < max_crafting_overall_attempts:\n        \n        # 1. Ensure all necessary ingredients are in inventory for one craft\n        has_all_ingredients_for_one_craft = True\n        \n        # Iterate over ingredients required for one craft of the target item\n        for ing_idx, count_needed in recipe.items():\n            # Skip special recipe keys like '_at', '_yield'\n            if not isinstance(ing_idx, int):\n                continue\n\n            current_ing_count = env._current_state.inventory[ing_idx]\n            \n            # If we don't have enough of this ingredient, try to get it\n            if current_ing_count < count_needed:\n                has_all_ingredients_for_one_craft = False\n                ing_name = env.world.cookbook.index.get(ing_idx)\n                \n                # Determine if the missing ingredient is a primitive or itself craftable\n                if ing_idx in env.world.cookbook.primitives:\n                    # Call COLLECT_FUNC from DSL to get the missing amount.\n                    # Assume COLLECT_FUNC handles movement and USE for primitives, and returns reward.\n                    # Assume COLLECT_FUNC aims to get ONE unit per call.\n                    print(f\"  (CRAFT_FUNC) Collecting missing primitive: {ing_name} (need {count_needed - current_ing_count}).\")\n                    for _ in range(int(count_needed - current_ing_count)):\n                        reward_from_subtask = COLLECT_FUNC(env, ing_name)\n                        total_reward += reward_from_subtask\n                        # Check if COLLECT_FUNC made progress. If not, it might be stuck.\n                        if env._current_state.inventory[ing_idx] == current_ing_count:\n                            print(f\"  (CRAFT_FUNC) COLLECT_FUNC for {ing_name} made no progress. Aborting craft attempt for {item}.\")\n                            return total_reward # Cannot acquire ingredient, give up on current craft.\n                        current_ing_count = env._current_state.inventory[ing_idx] # Update count for loop\n                else:\n                    # Recursively call CRAFT_FUNC from DSL to craft the missing amount.\n                    # Assume recursive CRAFT_FUNC crafts ONE unit per call.\n                    print(f\"  (CRAFT_FUNC) Crafting missing ingredient: {ing_name} (need {count_needed - current_ing_count}).\")\n                    for _ in range(int(count_needed - current_ing_count)):\n                        reward_from_subtask = CRAFT_FUNC(env, ing_name) # Recursive call\n                        total_reward += reward_from_subtask\n                        # Check if recursive CRAFT_FUNC made progress.\n                        if env._current_state.inventory[ing_idx] == current_ing_count:\n                            print(f\"  (CRAFT_FUNC) Recursive CRAFT_FUNC for {ing_name} made no progress. Aborting craft attempt for {item}.\")\n                            return total_reward # Cannot acquire ingredient, give up.\n                        current_ing_count = env._current_state.inventory[ing_idx] # Update count for loop\n\n                # After attempting to get one missing ingredient, break this inner loop\n                # and re-evaluate overall ingredient status from scratch as the state has changed.\n                break \n\n        # If after checking/acquiring, all ingredients are now available, proceed to move to workshop and craft\n        if has_all_ingredients_for_one_craft:\n            # 2. Move to the required workshop (if any)\n            workshop_name = recipe.get(\"_at\")\n            if workshop_name: # If a specific workshop is required for this recipe\n                workshop_idx = env.world.cookbook.index[workshop_name]\n                print(f\"  (CRAFT_FUNC) All ingredients gathered. Moving to workshop: {workshop_name}.\")\n                \n                # Safety limit for movement attempts to prevent infinite loops during navigation\n                max_move_attempts_to_workshop = 200 \n                current_move_attempts = 0\n\n                # Loop until agent is next to the workshop (within 3x3 grid, excluding itself)\n                while not env._current_state.next_to(workshop_idx) and current_move_attempts < max_move_attempts_to_workshop:\n                    ws_pos = None\n                    grid = env._current_state.grid\n                    \n                    # Find the absolute position of the workshop on the current grid\n                    # (assuming workshop locations are static and visible).\n                    for gx in range(WIDTH):\n                        for gy in range(HEIGHT):\n                            if grid[gx, gy, workshop_idx] == 1:\n                                ws_pos = (gx, gy)\n                                break\n                        if ws_pos: break\n\n                    if not ws_pos:\n                        print(f\"  (CRAFT_FUNC) Error: Workshop {workshop_name} not found on grid. Cannot proceed with crafting {item}.\")\n                        return total_reward # Cannot proceed without workshop\n\n                    agent_x, agent_y = env._current_state.pos\n                    target_x, target_y = ws_pos\n\n                    # Determine best direction to move to get closer to the workshop\n                    action_to_take = None\n                    # Prioritize movement along the larger dimension difference\n                    if abs(target_x - agent_x) > 0 and (abs(target_x - agent_x) >= abs(target_y - agent_y) or target_y == agent_y):\n                        action_to_take = RIGHT if target_x > agent_x else LEFT\n                    elif abs(target_y - agent_y) > 0:\n                        action_to_take = UP if target_y > agent_y else DOWN\n                    \n                    if action_to_take is not None:\n                        # Perform the chosen movement action\n                        reward_from_move, _, _ = env.step(action_to_take)\n                        total_reward += reward_from_move\n                    else:\n                        # If no movement action was taken, it implies the agent is at the target\n                        # coordinates but not \"next to\" it (e.g., due to an obstacle or being exactly on it,\n                        # though agent cannot move onto occupied squares). This might indicate a stuck state.\n                        print(f\"  (CRAFT_FUNC) Agent stuck trying to move adjacent to {workshop_name} at {agent_x, agent_y}. Target {target_x, target_y}. Breaking move loop.\")\n                        break # Cannot reach workshop, give up on current craft.\n\n                    current_move_attempts += 1\n\n                if current_move_attempts == max_move_attempts_to_workshop and not env._current_state.next_to(workshop_idx):\n                    print(f\"  (CRAFT_FUNC) Failed to reach workshop {workshop_name} after {max_move_attempts_to_workshop} moves. Cannot craft {item}.\")\n                    return total_reward # Give up on crafting this item if workshop is unreachable.\n\n            # 3. Perform the USE action to craft the item\n            # Snapshot inventory to check if crafting was successful\n            initial_target_item_count_in_inv = env._current_state.inventory[item_idx]\n            print(f\"  (CRAFT_FUNC) Performing USE action to craft {item}.\")\n            reward_from_use, _, _ = env.step(USE)\n            total_reward += reward_from_use\n            \n            # Check if the target item's count increased by at least the yield_amount\n            if env._current_state.inventory[item_idx] >= initial_target_item_count_in_inv + yield_amount:\n                print(f\"  (CRAFT_FUNC) Successfully crafted {item}. Current count: {env._current_state.inventory[item_idx]}.\")\n                # Break the outer while loop as at least one unit of the target item is crafted.\n                break \n            else:\n                print(f\"  (CRAFT_FUNC) USE action did not result in crafting {item} (count unchanged or less than expected yield). Retrying craft cycle.\")\n                # Increment overall_craft_attempts only if USE didn't produce the target item,\n                # to prevent infinite loops if the environment never crafts it for some reason.\n                overall_craft_attempts += 1\n        else:\n            # If ingredients were not fully available after attempts to get them (e.g., sub-task failed permanently),\n            # increment overall attempt count to prevent infinite loop.\n            overall_craft_attempts += 1\n            print(f\"  (CRAFT_FUNC) Ingredients not fully gathered after attempts for {item}. Retrying craft cycle.\")\n\n    # Return the total reward accumulated during the crafting process\n    return total_reward", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:25:05.311514", "function_name": "craft", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:25:05.327430", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    # 1. Get item index from its string name\n    item_index = env.world.cookbook.index[item]\n\n    # 2. Retrieve the recipe for the item\n    # We assume 'item' is a valid craftable item with a recipe.\n    recipe = env.world.cookbook.recipes.get(item_index)\n    if recipe is None:\n        # Item is not craftable or no recipe found, which implies an issue\n        # with the DSL program or environment setup.\n        return total_reward\n\n    # 3. Determine the required workshop for crafting this item\n    workshop_name = recipe.get(\"_at\")\n    if workshop_name is None:\n        # If no specific workshop is required, this function might not be applicable\n        # or the item is crafted by hand (e.g., just by having ingredients).\n        # For this problem, we assume crafting implies interaction with a workshop.\n        return total_reward\n\n    workshop_index = env.world.cookbook.index[workshop_name]\n\n    # 4. Locate the workshop on the current game grid\n    workshop_location = None\n    # Iterate through the entire grid to find the coordinates of the workshop.\n    # WIDTH and HEIGHT are global constants from the environment definition.\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if env._current_state.grid[x, y, workshop_index] == 1:\n                workshop_location = (x, y)\n                break\n        if workshop_location: # If found, break outer loop too\n            break\n\n    if not workshop_location:\n        # Workshop not found in the current state (e.g., not spawned or destroyed).\n        return total_reward\n\n    # 5. Determine the optimal adjacent position for the agent to stand\n    # and the direction the agent should face to USE the workshop.\n    target_pos = None\n    target_dir = None\n    wx, wy = workshop_location\n\n    # Define possible positions relative to the workshop and the corresponding direction\n    # the agent would need to face to interact with it.\n    possible_adj_targets = [\n        ((wx, wy - 1), UP),    # Agent is below workshop, faces UP\n        ((wx, wy + 1), DOWN),  # Agent is above workshop, faces DOWN\n        ((wx - 1, wy), RIGHT), # Agent is left of workshop, faces RIGHT\n        ((wx + 1, wy), LEFT)   # Agent is right of workshop, faces LEFT\n    ]\n\n    for (tx, ty), tdir in possible_adj_targets:\n        # Check if the potential target position is within grid boundaries\n        if 0 <= tx < WIDTH and 0 <= ty < HEIGHT:\n            # Check if the spot is currently empty (not occupied by any other item).\n            # We assume any necessary ingredients at this spot would have been collected by other DSL functions.\n            if not env._current_state.grid[tx, ty, :].any():\n                target_pos = (tx, ty)\n                target_dir = tdir\n                break # Found a suitable free spot\n\n    if not target_pos:\n        # No free and valid adjacent spot found for the agent to perform crafting.\n        return total_reward\n\n    # 6. Move the agent to the `target_pos`.\n    current_x, current_y = env._current_state.pos\n\n    # Move along the X-axis first until target X-coordinate is reached.\n    while current_x != target_pos[0]:\n        action = RIGHT if current_x < target_pos[0] else LEFT\n        reward, done, _ = env.step(action)\n        total_reward += reward\n        current_x, current_y = env._current_state.pos # Update current position after step\n        if done: return total_reward # Exit early if episode terminates\n\n    # Then move along the Y-axis until target Y-coordinate is reached.\n    while current_y != target_pos[1]:\n        action = UP if current_y < target_pos[1] else DOWN\n        reward, done, _ = env.step(action)\n        total_reward += reward\n        current_x, current_y = env._current_state.pos # Update current position after step\n        if done: return total_reward # Exit early if episode terminates\n\n    # The agent is now at `target_pos`.\n\n    # 7. Ensure the agent is facing the `target_dir`.\n    # The `step` method for movement actions (UP/DOWN/LEFT/RIGHT) updates the agent's direction.\n    # If the current direction is not `target_dir`, perform a dummy step in `target_dir`\n    # to orient the agent correctly. This step only changes direction if the move is blocked.\n    # In CraftWorld, if movement is blocked, direction is still updated.\n    if env._current_state.dir != target_dir:\n        reward, done, _ = env.step(target_dir)\n        total_reward += reward\n        if done: return total_reward # Exit early if episode terminates\n\n    # 8. Perform the USE action.\n    # This action will attempt to craft the item if all ingredients are in inventory\n    # and the agent is correctly positioned and oriented.\n    reward, done, _ = env.step(USE)\n    total_reward += reward\n    if done: return total_reward # Exit early if episode terminates\n\n    return total_reward", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:35:50.030396", "function_name": "craft", "function_body": "  # Define constants within the function body as per constraint\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  \n  WIDTH = 12\n  HEIGHT = 12\n\n  def _is_cardinal_adjacent(pos1, pos2):\n      \"\"\"\n      Checks if two positions are cardinally (not diagonally) adjacent.\n      \"\"\"\n      x1, y1 = pos1\n      x2, y2 = pos2\n      # Check if positions are adjacent cardinally (one unit apart on one axis, same on the other)\n      return (abs(x1 - x2) == 1 and y1 == y2) or \\\n             (abs(y1 - y2) == 1 and x1 == x2)\n\n  total_reward = 0.0\n\n  # 1. Get target item index from the cookbook's index.\n  # Convert item name to lowercase as Cookbook index typically uses lowercase strings.\n  target_item_idx = env.world.cookbook.index[item.lower()] \n\n  # 2. Find the recipe for the target item.\n  recipe_info = None\n  workshop_name = None\n  ingredients = {}\n  for output_idx, recipe_data in env.world.cookbook.recipes.items():\n    if output_idx == target_item_idx:\n      recipe_info = recipe_data\n      # \"_at\" is the string name of the workshop (e.g., \"workshop1\")\n      workshop_name = recipe_data[\"_at\"] \n      # Filter out special keys like \"_at\" and \"_yield\" to get actual ingredient indices and counts.\n      ingredients = {k: v for k, v in recipe_data.items() if isinstance(k, int)} \n      break\n\n  if not recipe_info:\n    # If no recipe is found for the item, it might be a primitive or an uncraftable item.\n    # In the context of a CRAFT_FUNC, this implies the task cannot be completed.\n    return total_reward\n\n  # 3. Check if the agent already has the target item in its inventory.\n  current_inventory = env.observations()['features_dict']['inventory']\n  if current_inventory[target_item_idx] > 0:\n    return total_reward # Already crafted or acquired.\n\n  # 4. Collect all required ingredients.\n  # `collect` is assumed to be an implemented DSL function: `collect(env, kind_name_string)`.\n  # This function should handle moving to and picking up the specified item.\n  for ingredient_idx, count_needed in ingredients.items():\n    while env.observations()['features_dict']['inventory'][ingredient_idx] < count_needed:\n      ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n      \n      # Call the DSL's collect function to obtain the ingredient.\n      current_reward_from_step = collect(env, ingredient_name) \n      total_reward += current_reward_from_step\n      \n      # Check if the environment task is done (e.g., ran out of steps or goal achieved unexpectedly).\n      if env._is_done(): \n        return total_reward\n\n      # Refresh inventory state after each collection attempt for the next loop iteration.\n      current_inventory = env.observations()['features_dict']['inventory']\n\n  # 5. Move to be cardinally adjacent to the workshop.\n  # Get the index of the required workshop.\n  workshop_idx = env.world.cookbook.index[workshop_name.lower()]\n  \n  # Find the workshop's coordinates on the global grid.\n  workshop_coords = None\n  grid = env.observations()['features_dict']['features_global']\n  for x_coord in range(WIDTH):\n    for y_coord in range(HEIGHT):\n      if grid[x_coord, y_coord, workshop_idx] == 1:\n        workshop_coords = (x_coord, y_coord)\n        break\n    if workshop_coords:\n      break\n\n  if not workshop_coords:\n    # If the workshop cannot be found on the map, the crafting task cannot be completed.\n    return total_reward\n\n  wx, wy = workshop_coords # Target workshop coordinates\n\n  # `move` is assumed to be an implemented DSL function: `move(env, direction_int)`.\n  # This loop moves the agent until it is cardinally adjacent to the workshop.\n  while not _is_cardinal_adjacent(env._current_state.pos, workshop_coords):\n    cx, cy = env._current_state.pos # Current agent position\n    prev_pos = (cx, cy) # Store current position to detect if agent gets stuck\n\n    moved_this_iteration = False # Flag to track if a move action was attempted\n\n    # Prioritize movement along the axis with the larger absolute distance to minimize steps.\n    if abs(cx - wx) > abs(cy - wy): # Prioritize horizontal movement\n      if cx < wx:\n        current_reward_from_step = move(env, RIGHT)\n      else: # cx > wx\n        current_reward_from_step = move(env, LEFT)\n      total_reward += current_reward_from_step\n      moved_this_iteration = True\n    elif abs(cy - wy) > 0: # Prioritize vertical movement if horizontally aligned or vertical distance is greater\n      if cy < wy:\n        current_reward_from_step = move(env, UP)\n      else: # cy > wy\n        current_reward_from_step = move(env, DOWN)\n      total_reward += current_reward_from_step\n      moved_this_iteration = True\n    \n    # Check if the agent is stuck: position did not change despite attempting a move,\n    # and it is still not adjacent to the workshop.\n    new_cx, new_cy = env._current_state.pos\n    if (new_cx, new_cy) == prev_pos and moved_this_iteration:\n        break # Exit loop to avoid infinite loop if path is blocked.\n        \n    if env._is_done(): # Check if max_steps reached during movement.\n      return total_reward\n\n  # 6. Orient the agent to face the workshop.\n  # After the loop, the agent should be cardinally adjacent to the workshop.\n  # A `move` action changes the agent's direction even if the movement itself is blocked.\n  cx, cy = env._current_state.pos\n  \n  # Determine the relative direction of the workshop from the agent's current position.\n  dx = wx - cx\n  dy = wy - cy\n\n  # Attempt a move in the direction of the workshop to orient the agent.\n  if dx == 1: # Workshop is to the RIGHT of the agent.\n    total_reward += move(env, RIGHT)\n  elif dx == -1: # Workshop is to the LEFT of the agent.\n    total_reward += move(env, LEFT)\n  elif dy == 1: # Workshop is UP (north) from the agent.\n    total_reward += move(env, UP)\n  elif dy == -1: # Workshop is DOWN (south) from the agent.\n    total_reward += move(env, DOWN)\n  # If dx and dy are both 0, the agent is conceptually on the workshop spot, which is an obstacle,\n  # so this case should not be reached if the previous movement loop works correctly.\n\n  if env._is_done(): # Check if max_steps reached during orientation.\n    return total_reward\n\n  # 7. Perform the USE action at the workshop.\n  # The agent should now be cardinally adjacent to the workshop and facing it correctly.\n  # `env.step(USE)` executes the crafting action.\n  reward_from_use, done_after_use, _ = env.step(USE)\n  total_reward += reward_from_use\n  \n  if done_after_use: # Check if goal achieved or max steps hit after USE.\n    return total_reward\n\n  return total_reward", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:35:51.086568", "function_name": "craft", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:44:02.478552", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Directions and actions defined in the CraftWorld code\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Helper function to move the agent towards a target item/workshop and interact\n  def _move_and_interact(env, target_idx, target_needed_count=1, max_steps_per_attempt=200) -> float:\n      \"\"\"\n      Moves the agent towards `target_idx` (either an item to collect or a workshop to use)\n      and then performs the USE action when adjacent.\n      Returns the reward accumulated during this process.\n      `target_needed_count` is relevant only for collection to know when to stop.\n      \"\"\"\n      current_interaction_reward = 0.0\n      item_is_workshop = (target_idx in env.world.workshop_indices)\n\n      # For collection, track initial inventory to know when enough is collected.\n      # For workshops, we just need to use it once we're next to it.\n      initial_inventory_count_for_target = env._current_state.inventory[target_idx] if not item_is_workshop else 0\n\n      current_steps = 0\n      while current_steps < max_steps_per_attempt:\n          agent_x, agent_y = env._current_state.pos\n          current_grid = env._current_state.grid\n\n          # If collecting, check if we've already met the target count for this specific call.\n          if not item_is_workshop and env._current_state.inventory[target_idx] >= initial_inventory_count_for_target + target_needed_count:\n              return current_interaction_reward # Successfully collected desired count\n\n          # Find location of the target_idx on the grid\n          locations = np.argwhere(current_grid[:, :, target_idx] == 1)\n          \n          # If target is a collectable item and it's no longer on the grid,\n          # it might have been picked up or doesn't exist.\n          if not item_is_workshop and len(locations) == 0:\n              # Check if it was picked up by confirming inventory increase\n              if env._current_state.inventory[target_idx] > initial_inventory_count_for_target:\n                  return current_interaction_reward # Successfully picked up\n              else:\n                  # Item not found and not in inventory (or not incremented), cannot collect\n                  return current_interaction_reward\n\n          # If it's a workshop and it's gone (shouldn't happen for workshops in Craft), can't proceed.\n          if item_is_workshop and len(locations) == 0:\n              return current_interaction_reward\n\n          # Find the closest target location\n          closest_dist = float('inf')\n          closest_pos = None\n          for lx, ly in locations:\n              dist = abs(lx - agent_x) + abs(ly - agent_y) # Manhattan distance\n              if dist < closest_dist:\n                  closest_dist = dist\n                  closest_pos = (lx, ly)\n          \n          if closest_pos is None:\n              # Should not happen if 'locations' is not empty\n              return current_interaction_reward\n\n          target_x, target_y = closest_pos\n\n          # Check if agent is adjacent to the target\n          if closest_dist == 1:\n              # Agent is adjacent, set direction and USE\n              # Determine the correct direction to face the item\n              if agent_x < target_x:\n                  env._current_state.dir = RIGHT\n              elif agent_x > target_x:\n                  env._current_state.dir = LEFT\n              elif agent_y < target_y:\n                  env._current_state.dir = UP\n              elif agent_y > target_y:\n                  env._current_state.dir = DOWN\n              \n              reward, done, _ = env.step(USE)\n              current_interaction_reward += reward\n              \n              if item_is_workshop:\n                  # For workshops, one USE action is the goal of this helper.\n                  # The calling craft_v2 function will check if the final item is crafted.\n                  return current_interaction_reward\n              else:\n                  # For collectable items, check if inventory increased after USE\n                  if env._current_state.inventory[target_idx] > initial_inventory_count_for_target:\n                      # Successfully collected at least one instance, which is enough for one call\n                      return current_interaction_reward\n\n          else: # Not adjacent, move closer\n              moved = False\n              if agent_x < target_x:\n                  reward, done, _ = env.step(RIGHT)\n                  current_interaction_reward += reward\n                  moved = True\n              elif agent_x > target_x:\n                  reward, done, _ = env.step(LEFT)\n                  current_interaction_reward += reward\n                  moved = True\n              elif agent_y < target_y:\n                  reward, done, _ = env.step(UP)\n                  current_interaction_reward += reward\n                  moved = True\n              elif agent_y > target_y:\n                  reward, done, _ = env.step(DOWN)\n                  current_interaction_reward += reward\n                  moved = True\n              \n              if not moved:\n                  # Agent is stuck or cannot reach the target (e.g., blocked).\n                  # Max steps will prevent infinite loop.\n                  break \n          \n          current_steps += 1\n      \n      return current_interaction_reward # Failed to reach/interact within max steps\n\n  # --- Main logic for craft_v2 ---\n  target_item_idx = env.world.cookbook.index[item]\n\n  # If the item is already in inventory, no crafting is needed.\n  if env._current_state.inventory[target_item_idx] > 0:\n      return total_reward\n\n  recipe = env.world.cookbook.recipes.get(target_item_idx)\n  if recipe is None:\n      # If no recipe exists, the item cannot be crafted (e.g., it's a primitive or unknown).\n      # This function specifically handles crafting, so return if not craftable.\n      return total_reward \n\n  # Phase 1: Ensure all necessary ingredients are in inventory\n  ingredients_for_recipe = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  \n  for ing_idx, needed_count in ingredients_for_recipe.items():\n    ing_name = env.world.cookbook.index.get(ing_idx)\n    \n    # Keep collecting/crafting this ingredient until the required count is met\n    while env._current_state.inventory[ing_idx] < needed_count:\n      if ing_idx in env.world.cookbook.primitives:\n        # If it's a primitive, collect it from the environment using the helper\n        r = _move_and_interact(env, ing_idx, target_needed_count=1) # Collect one instance at a time\n        total_reward += r\n        # If no reward was received and count is still not met, it implies collection failed\n        if env._current_state.inventory[ing_idx] < needed_count and r == 0:\n            return total_reward # Cannot acquire this primitive, so craft fails\n      else:\n        # If it's an intermediate item, recursively call craft_v2 for it\n        r = craft_v2(env, ing_name)\n        total_reward += r\n        # If no reward and count not met, it implies sub-crafting failed\n        if env._current_state.inventory[ing_idx] < needed_count and r == 0:\n            return total_reward # Cannot craft this intermediate, so main craft fails\n\n  # Phase 2: Move to the required workshop and use it to craft the item\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = env.world.cookbook.index.get(workshop_name)\n      \n      # Use the helper to move to and interact with the workshop\n      r = _move_and_interact(env, workshop_idx, target_needed_count=1) # target_needed_count is not really used for workshops\n      total_reward += r\n      \n      # After attempting to use the workshop, check if the target item is now in inventory\n      if env._current_state.inventory[target_item_idx] > 0:\n          return total_reward # Craft successful\n      else:\n          # Craft failed even after reaching and attempting to use the workshop.\n          # This could be due to missing ingredients (despite collection attempts) or environment issues.\n          return total_reward\n  else:\n      # This case should ideally not happen for standard crafting recipes which always have an \"_at\" field.\n      # If it did, it would imply the item is \"crafted\" by merely having ingredients, which is usually not how Craft works.\n      return total_reward # No workshop specified, craft assumed to fail or be invalid for this function\n\n  return total_reward # Fallback return, though logic should exit earlier", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:44:02.495641", "function_name": "craft", "function_body": "    # Define constants if not globally accessible (they usually are in this setup)\n    # They are provided in the problem description's context.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    total_reward = 0.0\n    cookbook = env.world.cookbook\n    \n    # Get the ID of the item to craft.\n    # The 'item' input is expected to be a string name (e.g., \"PLANK\").\n    item_to_craft_id = cookbook.index[item]\n\n    # Get the current state directly from the environment.\n    # This state will be updated by subsequent env.step() calls.\n    current_state = env._current_state\n\n    # --- Phase 1: Check if the item is already in inventory. ---\n    if current_state.inventory[item_to_craft_id] > 0:\n        # Item is already crafted, no steps needed for this crafting task.\n        return total_reward \n\n    # --- Phase 2: Retrieve the recipe for the item. ---\n    recipe = cookbook.recipes.get(item_to_craft_id)\n    if not recipe:\n        # The item is not craftable (e.g., it's a primitive or an unknown item).\n        # This function should ideally only be called for valid craftable items as per DSL design.\n        return total_reward\n\n    # --- Phase 3: Determine all primitive ingredients required. ---\n    # This method correctly handles recursive dependencies (e.g., if crafting 'A' needs 'B', and 'B' needs 'C',\n    # it will list 'C' as a primitive needed for 'A').\n    needed_primitives = cookbook.primitives_for(item_to_craft_id)\n\n    # --- Helper Function: Move agent to be adjacent to target and orient. ---\n    # This nested function performs the movement and orientation logic,\n    # updating the environment state and accumulating reward.\n    def _move_to_and_orient(target_pos, current_env, current_total_reward_val):\n        \"\"\"\n        Moves the agent to a position adjacent to `target_pos` (Manhattan distance of 1) and\n        orients the agent to face `target_pos`.\n        Updates the environment via `current_env.step()` and returns the\n        accumulated reward for these movement/orientation steps.\n        \"\"\"\n        agent_x, agent_y = current_env._current_state.pos\n        tx, ty = target_pos\n\n        # Continue moving until the agent is one Manhattan distance unit away from the target.\n        # This means the agent is directly adjacent (up, down, left, or right) to the target.\n        while not (abs(agent_x - tx) <= 1 and abs(agent_y - ty) <= 1 and\n                   (abs(agent_x - tx) + abs(agent_y - ty) == 1)):\n            \n            action_resulted_in_move = False\n            \n            # Prioritize horizontal movement if not aligned with target's X coordinate.\n            if agent_x < tx:\n                # Simulate a step to check if the move is actually possible (i.e., not blocked).\n                # `CraftState.step` will return a `new_state` where `pos` is same if blocked.\n                _, next_state_sim = current_env._current_state.step(RIGHT)\n                if next_state_sim.pos != current_env._current_state.pos: # If the simulated move was successful\n                    r, done, _ = current_env.step(RIGHT) # Execute the move in the actual environment\n                    current_total_reward_val += r\n                    agent_x, agent_y = current_env._current_state.pos # Update agent's position from the actual env\n                    if done: return current_total_reward_val # If the global task is done, propagate immediate return.\n                    action_resulted_in_move = True\n            elif agent_x > tx:\n                _, next_state_sim = current_env._current_state.step(LEFT)\n                if next_state_sim.pos != current_env._current_state.pos:\n                    r, done, _ = current_env.step(LEFT)\n                    current_total_reward_val += r\n                    agent_x, agent_y = current_env._current_state.pos\n                    if done: return current_total_reward_val\n                    action_resulted_in_move = True\n            \n            # If no horizontal move was made (either not needed or blocked), try vertical movement.\n            if not action_resulted_in_move:\n                if agent_y < ty:\n                    _, next_state_sim = current_env._current_state.step(UP)\n                    if next_state_sim.pos != current_env._current_state.pos:\n                        r, done, _ = current_env.step(UP)\n                        current_total_reward_val += r\n                        agent_x, agent_y = current_env._current_state.pos\n                        if done: return current_total_reward_val\n                        action_resulted_in_move = True\n                elif agent_y > ty:\n                    _, next_state_sim = current_env._current_state.step(DOWN)\n                    if next_state_sim.pos != current_env._current_state.pos:\n                        r, done, _ = current_env.step(DOWN)\n                        current_total_reward_val += r\n                        agent_x, agent_y = current_env._current_state.pos\n                        if done: return current_total_reward_val\n                        action_resulted_in_move = True\n            \n            # If no action (move) was taken in this iteration, it means the agent is stuck or\n            # cannot reach an adjacent empty cell to the target by direct greedy movement.\n            # This simple pathfinding might fail in complex environments with obstacles (e.g., walls).\n            if not action_resulted_in_move:\n                break # Break to prevent infinite loop if stuck.\n        \n        # After reaching an adjacent cell, orient the agent to face the target.\n        # This is crucial for the subsequent 'USE' action, as 'USE' checks neighbors in the agent's current direction.\n        dx = tx - current_env._current_state.pos[0]\n        dy = ty - current_env._current_state.pos[1]\n\n        target_dir = -1 # Default to an invalid direction\n        if dx == 1 and dy == 0: target_dir = RIGHT # Target is to the right\n        elif dx == -1 and dy == 0: target_dir = LEFT # Target is to the left\n        elif dx == 0 and dy == 1: target_dir = UP # Target is up\n        elif dx == 0 and dy == -1: target_dir = DOWN # Target is down\n\n        # If the agent is not already facing the target direction, perform a directional step.\n        # Even if this step doesn't change position (e.g., trying to move into a wall or item),\n        # the agent's internal direction (`current_env._current_state.dir`) will be updated.\n        if target_dir != -1 and current_env._current_state.dir != target_dir:\n            r, done, _ = current_env.step(target_dir) \n            current_total_reward_val += r\n            if done: return current_total_reward_val # Propagate immediate return if global task is done.\n        \n        return current_total_reward_val\n\n    # --- Phase 4: Collect all necessary primitive ingredients. ---\n    for p_id, p_count_needed in needed_primitives.items():\n        # Loop until enough of the current primitive is in inventory.\n        while current_state.inventory[p_id] < p_count_needed:\n            best_target_pos = None\n            min_dist = float('inf')\n\n            # Search the entire grid to find the nearest instance of the primitive.\n            # WIDTH and HEIGHT are assumed to be accessible from the environment's context (e.g., craft_env.py).\n            # If not, use current_state.grid.shape[0] and [1].\n            grid_width = current_state.grid.shape[0]\n            grid_height = current_state.grid.shape[1]\n            for x in range(grid_width):\n                for y in range(grid_height):\n                    # Check if the cell contains the primitive item (value is 1).\n                    if current_state.grid[x, y, p_id] == 1:\n                        # Calculate Manhattan distance from the agent's current position to the primitive.\n                        dist = abs(current_state.pos[0] - x) + abs(current_state.pos[1] - y)\n                        if dist < min_dist:\n                            min_dist = dist\n                            best_target_pos = (x, y)\n            \n            if best_target_pos is None:\n                # If no instance of the primitive is found on the grid,\n                # it means the crafting goal cannot be fulfilled in this scenario.\n                return total_reward # Return accumulated reward and exit.\n\n            # Move the agent to be adjacent to the primitive and orient it to face the primitive.\n            # `_move_to_and_orient` will update the environment's state and `total_reward`.\n            total_reward = _move_to_and_orient(best_target_pos, env, total_reward)\n            # Ensure `current_state` variable reflects the actual environment state after movements.\n            current_state = env._current_state \n            \n            # After moving, check if the needed item was already collected (e.g., by a previous successful\n            # loop iteration, or if the environment reset and this item was part of the initial inventory).\n            if current_state.inventory[p_id] >= p_count_needed:\n                break # Enough of this primitive is now in inventory, move to next.\n\n            # Perform the 'USE' action to pick up the primitive.\n            r, done, _ = env.step(USE)\n            total_reward += r\n            current_state = env._current_state # Update state after the USE action.\n            if done: return total_reward # If the global task is marked as done, immediately return.\n\n    # --- Phase 5: Move to the crafting station (if required by the recipe) and use it. ---\n    # Recipes may specify a required workshop via the \"_at\" key (e.g., \"workshop1\").\n    workshop_name = recipe.get(\"_at\")\n    if workshop_name: \n        workshop_id = cookbook.index[workshop_name]\n\n        best_workshop_pos = None\n        min_dist = float('inf')\n\n        # Search the entire grid for the nearest instance of the required workshop.\n        grid_width = current_state.grid.shape[0]\n        grid_height = current_state.grid.shape[1]\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if current_state.grid[x, y, workshop_id] == 1:\n                    dist = abs(current_state.pos[0] - x) + abs(current_state.pos[1] - y)\n                    if dist < min_dist:\n                        min_dist = dist\n                        best_workshop_pos = (x, y)\n        \n        if best_workshop_pos is None:\n            # If the required workshop is not found on the grid.\n            return total_reward # Return accumulated reward and exit, as crafting is not possible.\n\n        # Move the agent to be adjacent to the workshop and orient it.\n        total_reward = _move_to_and_orient(best_workshop_pos, env, total_reward)\n        current_state = env._current_state # Ensure `current_state` reflects the actual environment state.\n        \n        # Perform the 'USE' action at the workshop to craft the item.\n        r, done, _ = env.step(USE)\n        total_reward += r\n        current_state = env._current_state # Update state after the USE action.\n        if done: return total_reward # If the global task is marked as done, immediately return.\n    \n    return total_reward", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:49:42.352407", "function_name": "craft", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-24T03:49:43.433202", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # 1. Get Item Index\n  # Convert the item name (string) to its corresponding integer ID\n  item_idx = env.world.cookbook.index[item]\n\n  # 2. Get Recipe\n  # Retrieve the recipe for the desired item from the cookbook\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # 3. Acquire Ingredients\n  # Iterate through the required ingredients for the recipe.\n  # Filter out special keys like \"_at\" and \"_yield\" which are not ingredients.\n  ingredients = {i_id: count for i_id, count in recipe.items() if isinstance(i_id, int)}\n\n  for ing_idx, count_needed in ingredients.items():\n    ing_name = env.world.cookbook.index.get(ing_idx) # Get the string name of the ingredient\n    \n    # Continuously collect the ingredient until the required quantity is in inventory\n    while env._current_state.inventory[ing_idx] < count_needed:\n      # Call the DSL's COLLECT_FUNC to acquire the ingredient.\n      # It is assumed that COLLECT_FUNC handles movement to the item and picking it up.\n      # The reward returned by COLLECT_FUNC is accumulated.\n      reward_from_collect = COLLECT_FUNC(env, ing_name)\n      total_reward += reward_from_collect\n\n  # 4. Move to Crafting Station (if required)\n  # Check if the recipe specifies a crafting station (e.g., \"workshop1\")\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n    # Use COLLECT_FUNC to move the agent next to the specified workshop.\n    # For a workshop (which is not a grabbable item), COLLECT_FUNC is assumed\n    # to primarily focus on positioning the agent adjacent to it.\n    reward_from_move_to_workshop = COLLECT_FUNC(env, workshop_name)\n    total_reward += reward_from_move_to_workshop\n\n  # 5. Perform Crafting Action\n  # Once all ingredients are acquired and the agent is positioned correctly\n  # (next to the workshop, if required), perform the USE action.\n  # The CraftState.step method's logic will handle the actual crafting process,\n  # consuming ingredients and producing the output item.\n  reward_step, done, obs = env.step(env.action_specs()['USE'])\n  total_reward += reward_step\n\n  return total_reward", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-24T04:15:12.103874", "function_name": "craft", "function_body": "        total_reward = 0.0\n        item_idx = env.world.cookbook.index[item]\n\n        # Main loop to repeatedly try to craft the item until successful or max steps reached\n        while True:\n            # Check if the goal item is already in inventory\n            if env._current_state.satisfies(\"goal\", item_idx):\n                break\n            # Check if the maximum number of steps has been exceeded\n            if env.steps >= env.max_steps:\n                break\n\n            current_inventory = env.observations()['features_dict']['inventory']\n            current_pos = env._current_state.pos\n            current_dir = env._current_state.dir\n            current_grid = env._current_state.grid\n            world_width, world_height, _ = current_grid.shape\n\n            action_taken_this_step = False\n\n            # --- Phase 1: Collect missing primitive ingredients ---\n            # Get the list of primitive ingredients needed for the target item\n            needed_primitives = env.world.cookbook.primitives_for(item_idx)\n            \n            # Find the nearest missing primitive ingredient on the grid\n            min_ing_dist = float('inf')\n            nearest_ing_loc = None\n\n            for ing_idx, count in needed_primitives.items():\n                if current_inventory[ing_idx] < count: # If we need more of this ingredient\n                    # Find all locations of this specific ingredient on the grid\n                    ing_locations = []\n                    for x in range(world_width):\n                        for y in range(world_height):\n                            if current_grid[x, y, ing_idx] == 1:\n                                ing_locations.append((x, y))\n                    \n                    # From the found locations, determine the one with minimum Manhattan distance\n                    if ing_locations:\n                        for loc_x, loc_y in ing_locations:\n                            dist = abs(current_pos[0] - loc_x) + abs(current_pos[1] - loc_y)\n                            if dist < min_ing_dist:\n                                min_ing_dist = dist\n                                nearest_ing_loc = (loc_x, loc_y)\n            \n            if nearest_ing_loc:\n                tx, ty = nearest_ing_loc\n                cx, cy = current_pos\n                \n                # Determine which direction the target is relative to current position\n                # and if the agent is adjacent to it to perform a USE action\n                target_direction_to_face = -1 # Placeholder for UP, DOWN, LEFT, RIGHT\n                is_adjacent_to_target = False\n                \n                # Check adjacency in all 4 cardinal directions\n                if cx - 1 == tx and cy == ty: # Target is LEFT\n                    target_direction_to_face = LEFT\n                    is_adjacent_to_target = True\n                elif cx + 1 == tx and cy == ty: # Target is RIGHT\n                    target_direction_to_face = RIGHT\n                    is_adjacent_to_target = True\n                elif cx == tx and cy - 1 == ty: # Target is DOWN (lower y-coordinate)\n                    target_direction_to_face = DOWN\n                    is_adjacent_to_target = True\n                elif cx == tx and cy + 1 == ty: # Target is UP (higher y-coordinate)\n                    target_direction_to_face = UP\n                    is_adjacent_to_target = True\n                \n                if is_adjacent_to_target:\n                    if current_dir == target_direction_to_face:\n                        # Agent is adjacent and facing the target, perform USE (pickup)\n                        reward, _, _ = env.step(USE)\n                        total_reward += reward\n                        action_taken_this_step = True\n                    else:\n                        # Agent is adjacent but not facing, change direction to face the target\n                        reward, _, _ = env.step(target_direction_to_face)\n                        total_reward += reward\n                        action_taken_this_step = True\n                else: # Not adjacent, move towards target\n                    action_to_move = -1\n                    # Prioritize moving in X direction first, then Y\n                    if cx < tx: action_to_move = RIGHT\n                    elif cx > tx: action_to_move = LEFT\n                    elif cy < ty: action_to_move = UP\n                    elif cy > ty: action_to_move = DOWN\n                    \n                    if action_to_move != -1: # Ensure a valid move action was determined\n                        reward, _, _ = env.step(action_to_move)\n                        total_reward += reward\n                        action_taken_this_step = True\n            \n            if action_taken_this_step:\n                continue # An action was taken, re-evaluate loop conditions in the next iteration\n\n            # --- Phase 2: If all primitive ingredients collected, move to workshop and craft ---\n            # This phase applies only if the item is a craftable recipe item that needs a workshop.\n            # Primitives themselves would be handled by Phase 1.\n            if item_idx in env.world.cookbook.recipes:\n                recipe = env.world.cookbook.recipes[item_idx]\n                workshop_name = recipe.get('_at') # e.g., 'workshop1'\n\n                # Check if all ingredients required by this specific recipe (not just primitives)\n                # are currently in the agent's inventory.\n                can_craft_now = True\n                for ing_key, count_needed in recipe.items():\n                    # Only consider actual ingredient indices (integers), ignore special keys like '_at', '_yield'\n                    if isinstance(ing_key, int) and current_inventory[ing_key] < count_needed:\n                        can_craft_now = False\n                        break\n                \n                if can_craft_now and workshop_name:\n                    workshop_idx = env.world.cookbook.index[workshop_name]\n                    \n                    # Find the nearest workshop location on the grid\n                    min_ws_dist = float('inf')\n                    nearest_ws_loc = None\n                    for x in range(world_width):\n                        for y in range(world_height):\n                            if current_grid[x, y, workshop_idx] == 1:\n                                dist = abs(current_pos[0] - x) + abs(current_pos[1] - y)\n                                if dist < min_ws_dist:\n                                    min_ws_dist = dist\n                                    nearest_ws_loc = (x, y)\n                    \n                    if nearest_ws_loc:\n                        tx, ty = nearest_ws_loc\n                        cx, cy = current_pos\n\n                        # Check if agent is already adjacent and facing the workshop to USE (craft)\n                        target_direction_to_face = -1\n                        is_adjacent_to_target = False\n                        \n                        if cx - 1 == tx and cy == ty:\n                            target_direction_to_face = LEFT\n                            is_adjacent_to_target = True\n                        elif cx + 1 == tx and cy == ty:\n                            target_direction_to_face = RIGHT\n                            is_adjacent_to_target = True\n                        elif cx == tx and cy - 1 == ty:\n                            target_direction_to_face = DOWN\n                            is_adjacent_to_target = True\n                        elif cx == tx and cy + 1 == ty:\n                            target_direction_to_face = UP\n                            is_adjacent_to_target = True\n\n                        if is_adjacent_to_target:\n                            if current_dir == target_direction_to_face:\n                                # Agent is adjacent and facing the workshop, perform USE (craft)\n                                reward, _, _ = env.step(USE)\n                                total_reward += reward\n                                action_taken_this_step = True\n                            else:\n                                # Agent is adjacent but not facing, change direction to face workshop\n                                reward, _, _ = env.step(target_direction_to_face)\n                                total_reward += reward\n                                action_taken_this_step = True\n                        else: # Not adjacent, move towards workshop\n                            action_to_move = -1\n                            if cx < tx: action_to_move = RIGHT\n                            elif cx > tx: action_to_move = LEFT\n                            elif cy < ty: action_to_move = UP\n                            elif cy > ty: action_to_move = DOWN\n                            \n                            if action_to_move != -1:\n                                reward, _, _ = env.step(action_to_move)\n                                total_reward += reward\n                                action_taken_this_step = True\n            \n            if action_taken_this_step:\n                continue # An action was taken, re-evaluate loop conditions\n\n            # --- Fallback: If no specific action could be taken ---\n            # This indicates that the agent might be stuck, unable to find missing items/workshops,\n            # or is blocked from reaching them.\n            # To prevent an infinite loop if `max_steps` is large and the goal isn't met,\n            # we perform a simple exploratory action (rotate direction).\n            \n            # Ensure current_dir is a valid movement direction (0-3)\n            # If for some reason it's USE (4), default it to 0 (DOWN)\n            if current_dir not in [DOWN, UP, LEFT, RIGHT]:\n                action_to_break_stall = DOWN\n            else:\n                action_to_break_stall = (current_dir + 1) % 4 # Cycle through movement directions\n\n            reward, _, _ = env.step(action_to_break_stall)\n            total_reward += reward\n            # The loop will continue, relying on `max_steps` to eventually terminate\n            # if the task remains unachievable.\n\n        return total_reward", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-24T04:15:13.663718", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Define constants within the function body as per strict instruction\n  # These are derived from the problem description's craft_env.py\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  WIDTH = env._current_state.grid.shape[0]\n  HEIGHT = env._current_state.grid.shape[1]\n\n  # Helper function to collect a primitive item\n  # This function simulates the \"collect\" DSL command\n  def _collect_primitive(env, primitive_name):\n      nonlocal total_reward # Allow modification of total_reward from outer scope\n      item_idx = env.world.cookbook.index[primitive_name]\n      initial_inventory = env._current_state.inventory[item_idx]\n\n      # Find the primitive item on the grid\n      target_pos = None\n      grid = env._current_state.grid\n      for x in range(WIDTH): \n          for y in range(HEIGHT):\n              if grid[x, y, item_idx] == 1:\n                  target_pos = (x, y)\n                  break\n          if target_pos:\n              break\n      \n      if target_pos is None:\n          # Item not found in the environment, cannot collect\n          return # No reward, cannot proceed\n\n      # Move to the target and use\n      max_attempts = 100 # Prevent infinite loops for a single collection attempt\n      attempts = 0\n\n      while env._current_state.inventory[item_idx] <= initial_inventory and attempts < max_attempts:\n          attempts += 1\n          # Check if next to the item\n          if env._current_state.next_to(item_idx):\n              r, done, _ = env.step(USE)\n              total_reward += r\n              if done: return # Global task completed, stop\n              if env._current_state.inventory[item_idx] > initial_inventory:\n                  # Successfully picked up the item\n                  return\n\n          # If not next to, move towards it\n          current_x, current_y = env._current_state.pos\n          tx, ty = target_pos\n          move_action = -1\n\n          # Simple greedy movement: prioritize X, then Y\n          if current_x < tx:\n              move_action = RIGHT\n          elif current_x > tx:\n              move_action = LEFT\n          elif current_y < ty: # Note: Craft uses positive Y as 'up'\n              move_action = UP\n          elif current_y > ty:\n              move_action = DOWN\n          \n          if move_action != -1:\n              r, done, _ = env.step(move_action)\n              total_reward += r\n              if done: return # Global task completed, stop\n          else:\n              # Agent is at target x,y but somehow not adjacent (e.g., blocked or on target).\n              # If it's blocked, we can't get it.\n              break # Cannot move, break loop to prevent infinite loop\n\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n\n  if recipe is None:\n      # If it's not a craftable item according to the cookbook recipes,\n      # it might be a primitive, or an environment object. This function is for crafting.\n      # So, if not in recipes, we can't craft it.\n      return total_reward\n\n  # 1. Acquire all needed ingredients\n  # Iterate through ingredients required by the recipe\n  for ingredient_idx, count in recipe.items():\n      if not isinstance(ingredient_idx, int): # Skip special keys like '_at', '_yield'\n          continue\n      \n      ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n      needed_count = count\n      \n      # Check current inventory to see how many more are needed\n      current_inventory_of_ingredient = env._current_state.inventory[ingredient_idx]\n      to_get = needed_count - current_inventory_of_ingredient\n\n      for _ in range(to_get):\n          # Decide if ingredient needs to be collected (primitive) or crafted (complex)\n          if ingredient_idx in env.world.cookbook.primitives:\n              # If it's a primitive, use the helper collect function\n              _collect_primitive(env, ingredient_name)\n              # Check if the overall task was completed during collection (e.g., ran out of steps)\n              if env._is_done(): return total_reward\n          else:\n              # If it's another craftable item, recursively call craft_v2\n              total_reward += craft_v2(env, ingredient_name)\n              if env._is_done(): return total_reward\n          \n          # After attempting to acquire, check if inventory has actually increased.\n          # If not, it means we failed to acquire this specific unit of the ingredient.\n          # In such a case, we cannot proceed with crafting this item successfully.\n          if env._current_state.inventory[ingredient_idx] <= current_inventory_of_ingredient:\n              # Failed to get this unit of ingredient, so cannot complete the craft.\n              return total_reward \n          current_inventory_of_ingredient += 1 # Update our internal tracker for the next iteration\n\n  # 2. Move to the workshop (if applicable)\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name: # Only if a specific workshop is required\n      workshop_idx = env.world.cookbook.index[workshop_name]\n      \n      # Find workshop location on the grid\n      target_pos = None\n      grid = env._current_state.grid\n      for x in range(WIDTH):\n          for y in range(HEIGHT):\n              if grid[x, y, workshop_idx] == 1:\n                  target_pos = (x, y)\n                  break\n          if target_pos:\n              break\n      \n      if target_pos is None:\n          # Workshop not found in the environment, cannot craft this item.\n          return total_reward\n      \n      # Move agent to be adjacent to the workshop\n      max_attempts = 100 # Prevent infinite loops\n      attempts = 0\n      while not env._current_state.next_to(workshop_idx) and attempts < max_attempts:\n          attempts += 1\n          current_x, current_y = env._current_state.pos\n          tx, ty = target_pos\n          move_action = -1\n\n          # Simple greedy movement\n          if current_x < tx:\n              move_action = RIGHT\n          elif current_x > tx:\n              move_action = LEFT\n          elif current_y < ty:\n              move_action = UP\n          elif current_y > ty:\n              move_action = DOWN\n          \n          if move_action != -1:\n              r, done, _ = env.step(move_action)\n              total_reward += r\n              if done: return total_reward # Global task completed, stop\n          else:\n              # Agent is blocked or already at target X/Y but not adjacent in general.\n              # If stuck, break to avoid infinite loop.\n              break \n\n  # 3. Perform the USE action to craft the item\n  # The environment's _get_reward will handle rewards for successfully crafting the goal item\n  # or intermediate items, and penalties.\n  r, done, _ = env.step(USE)\n  total_reward += r\n  \n  if done: return total_reward # Global task completed, stop\n\n  return total_reward", "island_id": 1, "scores": {}}
{"timestamp": "2025-07-24T04:21:10.044602", "function_name": "craft", "function_body": "  total_reward = 0.0\n  cookbook = env.world.cookbook\n  current_state = env._current_state\n\n  # 1. Get the integer ID for the target item\n  item_id = cookbook.index[item]\n\n  # 2. Check if the item is already in the inventory\n  if current_state.inventory[item_id] > 0:\n    # Item is already available, no further steps needed.\n    return total_reward\n\n  # 3. Determine all primitive ingredients needed for the final item\n  # This function from the Cookbook class handles recursive recipe lookups.\n  needed_primitives = cookbook.primitives_for(item_id)\n\n  # 4. Gather all required primitive ingredients\n  for primitive_id, count_needed in needed_primitives.items():\n    while current_state.inventory[primitive_id] < count_needed:\n      # Try to locate the primitive item on the grid\n      primitive_pos = None\n      grid = current_state.grid\n      for x in range(WIDTH):\n        for y in range(HEIGHT):\n          if grid[x, y, primitive_id] == 1:\n            primitive_pos = (x, y)\n            break\n        if primitive_pos:\n          break\n\n      if primitive_pos is None:\n        # The primitive item is not found on the grid.\n        # This can happen if it was already picked up, or if the scenario\n        # does not provide enough of this item. Cannot proceed with gathering more.\n        break # Exit inner while loop for this primitive\n\n      # Navigate to the primitive's location and pick it up using the USE action\n      # Set a maximum number of navigation steps to prevent infinite loops in case of obstacles\n      max_nav_steps = WIDTH * HEIGHT * 2 # Heuristic: twice the grid area\n\n      for _ in range(max_nav_steps):\n        current_state = env._current_state # Get the latest state\n        \n        # If the agent is next to the primitive, perform the USE action\n        if current_state.next_to(primitive_id):\n          prev_inventory_count = current_state.inventory[primitive_id]\n          r, d, _ = env.step(USE)\n          total_reward += r\n          if d: return total_reward # Episode ended (e.g., max_steps reached)\n          \n          # Check if the item was successfully picked up\n          if env._current_state.inventory[primitive_id] > prev_inventory_count:\n            # Successfully picked up one unit of the primitive\n            break # Exit navigation loop, move to next unit or next primitive\n          # If not picked up, it means the USE action failed (e.g., item not grabbable directly, or needs tool)\n          # For primitives_for, it should return grabbable items. So this indicates a problem.\n          break # Cannot pick up, stop trying for this item\n\n        curr_x, curr_y = current_state.pos\n        target_x, target_y = primitive_pos\n\n        action_to_take = -1\n\n        # Greedy movement: prioritize aligning along X-axis, then Y-axis\n        if curr_x < target_x:\n          action_to_take = RIGHT\n        elif curr_x > target_x:\n          action_to_take = LEFT\n        elif curr_y < target_y:\n          action_to_take = UP\n        elif curr_y > target_y:\n          action_to_take = DOWN\n        \n        if action_to_take != -1:\n          prev_pos = current_state.pos\n          r, d, _ = env.step(action_to_take)\n          total_reward += r\n          if d: return total_reward # Episode ended\n          \n          if prev_pos == env._current_state.pos:\n            # Agent did not move (e.g., hit an obstacle).\n            # If already aligned on one axis, try the other.\n            if curr_x == target_x and curr_y != target_y:\n              if curr_y < target_y: action_to_take = UP\n              elif curr_y > target_y: action_to_take = DOWN\n              if action_to_take != -1:\n                r, d, _ = env.step(action_to_take)\n                total_reward += r\n                if d: return total_reward\n                if prev_pos == env._current_state.pos:\n                  # Still stuck after trying both axes, break navigation\n                  break\n              else:\n                # Should not happen: both X and Y aligned but not 'next_to'\n                break\n            else:\n              # Not aligned on any axis and stuck, give up on this path\n              break\n        else:\n          # Agent is at target_pos but not 'next_to' the item. This could mean the item\n          # is blocked by the agent itself or an immovable object, or the primitive_pos\n          # is not the interactable location (e.g., workshop is usually _adjacent_ to agent).\n          # For primitives, this means something is wrong with the path or grid setup.\n          break # Cannot move closer\n\n  # Update current_state after gathering attempts\n  current_state = env._current_state \n\n  # 5. Check if all required ingredients have been gathered\n  has_all_ingredients = True\n  for primitive_id, count_needed in needed_primitives.items():\n    if current_state.inventory[primitive_id] < count_needed:\n      has_all_ingredients = False\n      break\n  \n  if not has_all_ingredients:\n    # Cannot craft because we failed to gather all necessary ingredients\n    return total_reward\n\n  # 6. Craft the item at the appropriate workshop, if required by the recipe\n  recipe = cookbook.recipes.get(item_id)\n  if recipe and \"_at\" in recipe: # Check if crafting requires a specific workshop\n    workshop_name = recipe[\"_at\"]\n    workshop_id = cookbook.index[workshop_name]\n\n    # Locate the workshop on the grid\n    workshop_pos = None\n    grid = current_state.grid\n    for x in range(WIDTH):\n      for y in range(HEIGHT):\n        if grid[x, y, workshop_id] == 1:\n          workshop_pos = (x, y)\n          break\n      if workshop_pos:\n        break\n    \n    if workshop_pos is None:\n      # Workshop not found, unable to complete crafting\n      return total_reward\n\n    # Navigate to the workshop and use it\n    max_nav_steps = WIDTH * HEIGHT * 2 # Heuristic limit for navigation\n\n    for _ in range(max_nav_steps):\n      current_state = env._current_state # Get the latest state\n      \n      if current_state.next_to(workshop_id):\n        prev_inventory_count = current_state.inventory[item_id]\n        r, d, _ = env.step(USE)\n        total_reward += r\n        if d: return total_reward # Episode ended\n        \n        # Check if the target item was successfully crafted\n        if env._current_state.inventory[item_id] > prev_inventory_count:\n          return total_reward # Item successfully crafted!\n        else:\n          # USE action at workshop did not result in crafting the item.\n          # This implies ingredients might still be insufficient (despite check),\n          # or some other crafting condition is not met.\n          break # Cannot craft here, stop trying for this item\n\n      curr_x, curr_y = current_state.pos\n      target_x, target_y = workshop_pos\n\n      action_to_take = -1\n      if curr_x < target_x:\n        action_to_take = RIGHT\n      elif curr_x > target_x:\n        action_to_take = LEFT\n      elif curr_y < target_y:\n        action_to_take = UP\n      elif curr_y > target_y:\n        action_to_take = DOWN\n\n      if action_to_take != -1:\n        prev_pos = current_state.pos\n        r, d, _ = env.step(action_to_take)\n        total_reward += r\n        if d: return total_reward # Episode ended\n        \n        if prev_pos == env._current_state.pos:\n          # Agent did not move (e.g., hit an obstacle). Try other axis if aligned.\n          if curr_x == target_x and curr_y != target_y:\n            if curr_y < target_y: action_to_take = UP\n            elif curr_y > target_y: action_to_take = DOWN\n            if action_to_take != -1:\n              r, d, _ = env.step(action_to_take)\n              total_reward += r\n              if d: return total_reward\n              if prev_pos == env._current_state.pos:\n                break\n            else:\n              break\n          else:\n            break\n      else:\n        # Agent is at target_pos but not 'next_to' workshop, implies a block.\n        break\n  else:\n    # If the item does not have a recipe with \"_at\" (e.g., it's a primitive or\n    # a crafted item that doesn't need a specific workshop like \"bundle\"),\n    # then the \"gathering\" step already completed its \"crafting\" implicitly.\n    pass # No workshop interaction is needed for this item\n\n  return total_reward", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-24T04:21:11.097753", "function_name": "craft", "function_body": "  total_reward = 0.0\n  \n  # Ensure item name is in the correct format for lookup (lowercase)\n  item_lower = item.lower()\n  \n  # Get target item index from the cookbook\n  # Using .get() for safer lookup; returns None if not found\n  target_item_idx = env.world.cookbook.index.get(item_lower)\n  if target_item_idx is None:\n      # Item does not exist in the cookbook index, so it cannot be crafted.\n      return total_reward\n\n  # Get the recipe for the target item\n  recipe = env.world.cookbook.recipes.get(target_item_idx)\n\n  if recipe is None:\n      # Item is not craftable (e.g., it's a primitive like \"wood\" that is collected, not crafted).\n      # Or it might be an invalid item name that exists in index but not in recipes.\n      return total_reward\n\n  # Identify the required workshop for crafting\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # All crafting recipes in the Craft environment are expected to specify a workshop with \"_at\".\n      # If this is missing, it implies a non-craftable item or a malformed recipe.\n      return total_reward\n\n  workshop_idx = env.world.cookbook.index.get(workshop_name)\n  if workshop_idx is None:\n      # Workshop name from recipe not found in index (e.g., \"workshop3\" if only 0-2 exist, or typo).\n      return total_reward\n\n  # Find the workshop's position on the grid\n  workshop_pos = None\n  # Get grid dimensions directly from the current state's grid shape\n  grid_width, grid_height, _ = env._current_state.grid.shape\n\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if env._current_state.grid[x, y, workshop_idx] == 1: # Check if this cell contains the workshop item\n              workshop_pos = (x, y)\n              break # Found workshop, exit inner loop\n      if workshop_pos:\n          break # Found workshop, exit outer loop\n\n  if workshop_pos is None:\n      # The required workshop is not present on the current map, so crafting is impossible.\n      return total_reward\n\n  # Navigate the agent to be adjacent to the workshop\n  # Using `env.max_steps` as a global limit for environment steps.\n  # This navigation segment should not exceed available steps.\n  max_navigation_steps = env.max_steps - env.steps # Remaining steps\n  current_navigation_steps_taken = 0\n\n  # Loop until agent is next to the workshop or runs out of steps\n  while not env._current_state.next_to(workshop_idx) and \\\n        current_navigation_steps_taken < max_navigation_steps:\n      \n      agent_x, agent_y = env._current_state.pos\n      workshop_x, workshop_y = workshop_pos\n\n      dx = workshop_x - agent_x\n      dy = workshop_y - agent_y\n\n      action_taken_in_this_iteration = False\n      \n      # Determine preferred movement direction based on Manhattan distance\n      # Try to reduce the largest coordinate difference first.\n      \n      # List of action values to try, prioritized by reducing distance to workshop\n      possible_actions_to_try = []\n      \n      # Prioritize moving along the axis with the larger absolute distance\n      if abs(dx) >= abs(dy):\n          if dx > 0: possible_actions_to_try.append(env.action_specs()['RIGHT'])\n          elif dx < 0: possible_actions_to_try.append(env.action_specs()['LEFT'])\n          \n          # If dx is 0 or no horizontal move possible, consider vertical moves\n          if dy > 0: possible_actions_to_try.append(env.action_specs()['UP'])\n          elif dy < 0: possible_actions_to_try.append(env.action_specs()['DOWN'])\n      else: # abs(dy) > abs(dx)\n          if dy > 0: possible_actions_to_try.append(env.action_specs()['UP'])\n          elif dy < 0: possible_actions_to_try.append(env.action_specs()['DOWN'])\n          \n          # If dy is 0 or no vertical move possible, consider horizontal moves\n          if dx > 0: possible_actions_to_try.append(env.action_specs()['RIGHT'])\n          elif dx < 0: possible_actions_to_try.append(env.action_specs()['LEFT'])\n\n      # Iterate through possible actions and take the first one that results in movement\n      for action_value in possible_actions_to_try:\n          # Take a step using the determined action\n          reward, done, _ = env.step(action_value)\n          total_reward += reward\n          current_navigation_steps_taken += 1\n\n          # If the agent moved successfully or environment reset (goal achieved/max steps hit)\n          if env._current_state.pos != (agent_x, agent_y) or done:\n              action_taken_in_this_iteration = True\n              break # Break from trying other actions for this iteration\n          \n          # If max steps reached after this step, break the outer loop too\n          if current_navigation_steps_taken >= max_navigation_steps:\n              break\n\n      if not action_taken_in_this_iteration:\n          # If no action resulted in movement after trying all sensible directions\n          # (e.g., agent is blocked by obstacles on all paths to target, or at target)\n          # break the loop as agent is stuck or target is unreachable.\n          break\n\n  # After navigation, if the agent is now adjacent to the workshop, perform the USE action\n  if env._current_state.next_to(workshop_idx):\n      reward_from_use_action, _, _ = env.step(env.action_specs()['USE'])\n      total_reward += reward_from_use_action\n\n  return total_reward", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-24T04:22:45.074510", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # 1. Get the target item's index from the cookbook.\n  # The 'item' argument is expected to be a string (e.g., \"plank\").\n  item_idx = env.world.cookbook.index[item]\n\n  # 2. Retrieve the recipe for the item. This recipe tells us what ingredients are\n  # needed and, critically for crafting, which workshop is required ('_at' field).\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if recipe is None:\n    # If the item is not found in the recipes (e.g., it's a primitive that can't be crafted,\n    # or an invalid item name), we cannot craft it.\n    return total_reward\n\n  # Get the name of the workshop required for this recipe.\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # If the recipe does not specify a workshop (e.g., it's a direct pickup item),\n    # it cannot be crafted via a workshop.\n    return total_reward\n\n  # 3. Find the index of the required workshop from the cookbook.\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  \n  # Locate the coordinates of all instances of the required workshop on the current grid.\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if len(workshop_coords) == 0:\n    # If no such workshop exists on the map, the item cannot be crafted.\n    return total_reward\n  \n  # For simplicity, we target the first found workshop. In more complex scenarios,\n  # one might choose the closest workshop, but for this environment, any is sufficient.\n  workshop_x, workshop_y = workshop_coords[0]\n\n  # Get the action mappings from the environment's action_specs.\n  ACTIONS = env.action_specs()\n  ACTION_UP = ACTIONS['UP']\n  ACTION_DOWN = ACTIONS['DOWN']\n  ACTION_LEFT = ACTIONS['LEFT']\n  ACTION_RIGHT = ACTIONS['RIGHT']\n  ACTION_USE = ACTIONS['USE']\n\n  # Phase 1: Move the agent adjacent to the workshop.\n  # We loop until the agent is next to the workshop or the maximum steps are reached.\n  # `env.max_steps` provides a natural limit for this movement phase.\n  steps_taken_for_movement = 0\n  max_steps_for_movement = env.max_steps \n  \n  while not env._current_state.next_to(workshop_idx) and steps_taken_for_movement < max_steps_for_movement:\n    curr_x, curr_y = env._current_state.pos\n    action_to_take = -1 # Initialize with an invalid action\n\n    # Determine the best movement action to get closer to the workshop.\n    # We prioritize horizontal movement, then vertical.\n    if curr_x < workshop_x:\n      action_to_take = ACTION_RIGHT\n    elif curr_x > workshop_x:\n      action_to_take = ACTION_LEFT\n    elif curr_y < workshop_y:\n      action_to_take = ACTION_UP\n    elif curr_y > workshop_y:\n      action_to_take = ACTION_DOWN\n    else:\n        # If agent is at the same coordinates as the workshop, or no clear path to become adjacent\n        # is immediately obvious with this greedy movement, break the loop.\n        break \n\n    # Execute the chosen movement action if valid.\n    if action_to_take != -1:\n        reward, done, _ = env.step(action_to_take)\n        total_reward += reward\n        steps_taken_for_movement += 1\n        \n        # If the environment signals 'done' (e.g., max steps reached or goal achieved unexpectedly),\n        # return the accumulated reward immediately.\n        if done:\n          return total_reward \n    else:\n        # No valid movement action could be determined, indicating the agent might be stuck\n        # or already at the target location (though not adjacent in the `next_to` sense yet).\n        break\n\n  # After attempting to move, verify if the agent is indeed adjacent to the workshop.\n  if not env._current_state.next_to(workshop_idx):\n      # If not adjacent, it means we couldn't reach it (e.g., blocked path, ran out of steps).\n      return total_reward\n\n  # Phase 2: Orient the agent to face the workshop.\n  # The agent is now adjacent. We need to make sure its 'dir' matches the direction of the workshop.\n  curr_x, curr_y = env._current_state.pos\n  \n  # Calculate the relative position of the workshop to the agent.\n  dx = workshop_x - curr_x\n  dy = workshop_y - curr_y\n\n  target_dir_action = -1\n  # Determine the action that corresponds to facing the workshop.\n  if dx == 1: \n    target_dir_action = ACTION_RIGHT\n  elif dx == -1:\n    target_dir_action = ACTION_LEFT\n  elif dy == 1: \n    target_dir_action = ACTION_UP\n  elif dy == -1:\n    target_dir_action = ACTION_DOWN\n  \n  # If the agent is not already facing the correct direction, perform a step in that direction.\n  # When an agent tries to move into a blocked cell (like a workshop), its position remains unchanged,\n  # but its internal direction (self.dir) updates. This is how we change orientation.\n  if target_dir_action != -1 and env._current_state.dir != target_dir_action:\n    reward, done, _ = env.step(target_dir_action)\n    total_reward += reward\n    if done:\n      return total_reward\n\n  # Phase 3: Use the workshop.\n  # The agent is now adjacent to the workshop and facing it. Execute the USE action.\n  # This action will attempt to craft the item, consuming ingredients if available.\n  reward, done, _ = env.step(ACTION_USE)\n  total_reward += reward\n  \n  # Check for 'done' status again after the USE action, as crafting can complete the task.\n  if done:\n    return total_reward\n\n  return total_reward", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T04:22:46.157967", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # 1. Get the target item's index.\n  # Item is typically a string, e.g., \"plank\"\n  item_idx = env.world.cookbook.index[item]\n\n  # 2. Get the recipe for the item to find the required workshop.\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if recipe is None:\n    # Item cannot be crafted or doesn't exist as a recipe output\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # Item might be a primitive (not craftable), or its recipe doesn't specify a workshop.\n    # For the 'craft' function, we assume a workshop is involved.\n    return total_reward\n\n  # 3. Find the coordinates of the required workshop in the current grid.\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  \n  # Find all instances of the workshop in the current grid\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if len(workshop_coords) == 0:\n    # Workshop not found in the current grid\n    return total_reward\n  \n  # For simplicity, target the first found workshop (assuming only one is relevant or first is fine)\n  target_workshop_x, target_workshop_y = workshop_coords[0]\n\n  # Get action mappings from the environment\n  ACTIONS = env.action_specs()\n  ACTION_UP = ACTIONS['UP']\n  ACTION_DOWN = ACTIONS['DOWN']\n  ACTION_LEFT = ACTIONS['LEFT']\n  ACTION_RIGHT = ACTIONS['RIGHT']\n  ACTION_USE = ACTIONS['USE']\n\n  # Phase 1: Move adjacent to the workshop.\n  # We use env._is_done() to check if max_steps is reached or goal is satisfied.\n  # The loop continues as long as the agent is not next to the workshop AND the environment is not done.\n  while not env._current_state.next_to(workshop_idx) and not env._is_done():\n    curr_x, curr_y = env._current_state.pos\n    action_to_take = -1 # Initialize with an invalid action\n\n    # Determine movement action towards the workshop.\n    # Prioritize moving in X direction first, then Y, to provide a consistent path.\n    # This greedy approach works for simple mazes without complex obstacles.\n    if curr_x < target_workshop_x:\n      action_to_take = ACTION_RIGHT\n    elif curr_x > target_workshop_x:\n      action_to_take = ACTION_LEFT\n    elif curr_y < target_workshop_y: # Only check Y if X is aligned or impossible to move in X\n      action_to_take = ACTION_UP\n    elif curr_y > target_workshop_y:\n      action_to_take = ACTION_DOWN\n    \n    # If agent is at (target_workshop_x, target_workshop_y) (which should mean on the workshop itself)\n    # or no clear path for simple moves, break to prevent infinite loop if stuck.\n    if action_to_take == -1: \n        break # Agent is stuck or already on target spot.\n\n    reward, done, _ = env.step(action_to_take)\n    total_reward += reward\n    \n    if done:\n      # If the task is completed or failed (e.g., ran out of steps) during movement\n      return total_reward \n\n  # After movement, check if the agent is indeed adjacent to the workshop.\n  # If not, it means it couldn't reach it, so return current reward.\n  if not env._current_state.next_to(workshop_idx):\n      return total_reward\n\n  # Phase 2: Face the workshop.\n  # The agent is now adjacent to the workshop. We need to turn to face it for the USE action.\n  curr_x, curr_y = env._current_state.pos\n  \n  dx = target_workshop_x - curr_x\n  dy = target_workshop_y - curr_y\n\n  target_dir_action = -1\n  if dx == 1: # Workshop is to the right of the agent\n    target_dir_action = ACTION_RIGHT\n  elif dx == -1: # Workshop is to the left of the agent\n    target_dir_action = ACTION_LEFT\n  elif dy == 1: # Workshop is above the agent (y-coordinate increases upwards)\n    target_dir_action = ACTION_UP\n  elif dy == -1: # Workshop is below the agent\n    target_dir_action = ACTION_DOWN\n  \n  # If the agent is not already facing the target direction, perform a step\n  # in that direction. The agent's position will not change if blocked by the workshop,\n  # but its direction will update.\n  if env._current_state.dir != target_dir_action and target_dir_action != -1:\n    reward, done, _ = env.step(target_dir_action)\n    total_reward += reward\n    if done:\n      return total_reward\n\n  # Phase 3: Use the workshop.\n  # Agent is adjacent to the workshop and facing it. Perform the USE action.\n  reward, done, _ = env.step(ACTION_USE)\n  total_reward += reward\n  \n  # Check if the task is done after attempting to use the workshop\n  if done:\n    return total_reward\n\n  return total_reward", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T04:45:12.614019", "function_name": "craft", "function_body": "        total_reward = 0.0\n        cookbook = env.world.cookbook\n        \n        # Get the name of the item to check against the 'satisfies' condition later\n        item_name = cookbook.index.get(item)\n\n        # Retrieve the recipe for the item from the cookbook\n        recipe = cookbook.recipes[item]\n        \n        # Determine the crafting station required, if any\n        crafting_station_name = recipe.get(\"_at\")\n        crafting_station_id = cookbook.index[crafting_station_name] if crafting_station_name else None\n        \n        # Extract the list of ingredients and their required quantities\n        ingredients_info = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n        # Set a safety limit for the number of attempts to prevent infinite loops\n        MAX_CRAFT_ATTEMPTS = 500 \n\n        for _ in range(MAX_CRAFT_ATTEMPTS):\n            # Get the current state of the environment for decision making\n            current_state = env._current_state\n\n            # Check if the target item has already been crafted\n            if current_state.satisfies(item_name, item):\n                break # Goal achieved, exit the loop\n\n            # Stage 1: Check if all necessary ingredients are in the inventory\n            all_ingredients_present = True\n            missing_ingredient_id = None\n            for ing_id, count_needed in ingredients_info.items():\n                if current_state.inventory[ing_id] < count_needed:\n                    all_ingredients_present = False\n                    missing_ingredient_id = ing_id\n                    break # Found a missing ingredient, focus on collecting it\n\n            if not all_ingredients_present:\n                # If ingredients are missing, try to collect the first missing one\n                target_id = missing_ingredient_id\n                \n                # Find the location of the ingredient on the grid\n                target_pos = None\n                for x_grid in range(WIDTH):\n                    for y_grid in range(HEIGHT):\n                        if current_state.grid[x_grid, y_grid, target_id] == 1:\n                            target_pos = (x_grid, y_grid)\n                            break\n                    if target_pos:\n                        break\n                \n                if not target_pos:\n                    # If the ingredient cannot be found on the map, it's uncollectable\n                    break # Give up on crafting this item\n\n                agent_x, agent_y = current_state.pos\n                target_x, target_y = target_pos\n\n                # Check if the agent is adjacent to the ingredient\n                is_adjacent_to_ingredient = False\n                for nx, ny in neighbors(current_state.pos):\n                    if (nx, ny) == target_pos:\n                        is_adjacent_to_ingredient = True\n                        break\n\n                if is_adjacent_to_ingredient:\n                    # If adjacent, set direction towards the ingredient and USE to collect\n                    if target_x == agent_x - 1: current_state.dir = LEFT\n                    elif target_x == agent_x + 1: current_state.dir = RIGHT\n                    elif target_y == agent_y - 1: current_state.dir = DOWN\n                    elif target_y == agent_y + 1: current_state.dir = UP\n                    \n                    reward, done, _ = env.step(USE)\n                    total_reward += reward\n                    if done: return total_reward # Episode ended\n                else:\n                    # If not adjacent, move towards the ingredient\n                    moved = False\n                    # Prioritize vertical movement, then horizontal\n                    if agent_y < target_y and current_state.grid[agent_x, agent_y + 1, :].sum() == 0:\n                        reward, done, _ = env.step(UP)\n                        total_reward += reward\n                        moved = True\n                    elif agent_y > target_y and current_state.grid[agent_x, agent_y - 1, :].sum() == 0:\n                        reward, done, _ = env.step(DOWN)\n                        total_reward += reward\n                        moved = True\n                    elif agent_x < target_x and current_state.grid[agent_x + 1, agent_y, :].sum() == 0:\n                        reward, done, _ = env.step(RIGHT)\n                        total_reward += reward\n                        moved = True\n                    elif agent_x > target_x and current_state.grid[agent_x - 1, agent_y, :].sum() == 0:\n                        reward, done, _ = env.step(LEFT)\n                        total_reward += reward\n                        moved = True\n                    \n                    if done: return total_reward # Episode ended\n                    \n                    if not moved:\n                        # Agent is stuck (e.g., path blocked) or no direct path, cannot reach ingredient.\n                        break # Give up on crafting this item\n            \n            else: # All ingredients are present in the inventory\n                # Stage 2: Move to the crafting station and try to craft\n                if crafting_station_id is None:\n                    # If no specific crafting station is defined in the recipe, this logic cannot proceed.\n                    # This case implies the item might not be craftable or is a primitive.\n                    break \n\n                target_id = crafting_station_id\n                \n                # Find the location of the crafting station on the grid\n                target_pos = None\n                for x_grid in range(WIDTH):\n                    for y_grid in range(HEIGHT):\n                        if current_state.grid[x_grid, y_grid, target_id] == 1:\n                            target_pos = (x_grid, y_grid)\n                            break\n                    if target_pos:\n                        break\n                \n                if not target_pos:\n                    # Crafting station not found on the map, likely a scenario issue\n                    break # Give up on crafting this item\n                \n                agent_x, agent_y = current_state.pos\n                target_x, target_y = target_pos\n\n                # Check if the agent is adjacent to the crafting station\n                is_adjacent_to_station = False\n                for nx, ny in neighbors(current_state.pos):\n                    if (nx, ny) == target_pos:\n                        is_adjacent_to_station = True\n                        break\n\n                if is_adjacent_to_station:\n                    # If adjacent, set direction towards the station and USE to craft\n                    if target_x == agent_x - 1: current_state.dir = LEFT\n                    elif target_x == agent_x + 1: current_state.dir = RIGHT\n                    elif target_y == agent_y - 1: current_state.dir = DOWN\n                    elif target_y == agent_y + 1: current_state.dir = UP\n                    \n                    reward, done, _ = env.step(USE)\n                    total_reward += reward\n                    if done: return total_reward # Episode ended\n                else:\n                    # If not adjacent, move towards the crafting station\n                    moved = False\n                    # Prioritize vertical movement, then horizontal\n                    if agent_y < target_y and current_state.grid[agent_x, agent_y + 1, :].sum() == 0:\n                        reward, done, _ = env.step(UP)\n                        total_reward += reward\n                        moved = True\n                    elif agent_y > target_y and current_state.grid[agent_x, agent_y - 1, :].sum() == 0:\n                        reward, done, _ = env.step(DOWN)\n                        total_reward += reward\n                        moved = True\n                    elif agent_x < target_x and current_state.grid[agent_x + 1, agent_y, :].sum() == 0:\n                        reward, done, _ = env.step(RIGHT)\n                        total_reward += reward\n                        moved = True\n                    elif agent_x > target_x and current_state.grid[agent_x - 1, agent_y, :].sum() == 0:\n                        reward, done, _ = env.step(LEFT)\n                        total_reward += reward\n                        moved = True\n                    \n                    if done: return total_reward # Episode ended\n                    \n                    if not moved:\n                        # Agent is stuck or no path to station. Cannot craft.\n                        break # Give up on crafting this item\n        \n        return total_reward", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-24T04:45:12.630368", "function_name": "craft", "function_body": "    # Ensure constants are accessible within the function's scope.\n    # These are typically globally defined in the environment setup.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    # WIDTH = 12 # These are available via env._current_state.grid.shape\n    # HEIGHT = 12\n\n    total_reward = 0.0\n\n    # 1. Identify the target item's index\n    item_idx = env.world.cookbook.index[item]\n\n    # 2. Find the recipe for the item\n    recipe = env.world.cookbook.recipes.get(item_idx)\n    if not recipe:\n        # If there's no recipe for the item, it means it's not craftable\n        # or it's a primitive. This function is for crafting.\n        return total_reward\n\n    # 3. Determine the required workshop (crafting station)\n    workshop_name = recipe.get('_at')\n    workshop_idx = None\n    if workshop_name:\n        workshop_idx = env.world.cookbook.index[workshop_name]\n    else:\n        # If no workshop is specified in the recipe, the item might be crafted anywhere\n        # or by simply having the ingredients. For this environment, most crafting\n        # requires a workshop. If no workshop, we might still try USE, but\n        # the problem implies interaction with a station for CRAFT_FUNC.\n        # Assuming for items with recipes, _at will be specified.\n        # If not, this might be a task that doesn't fit the 'move to workshop and use' pattern.\n        # For simplicity and typical Craft scenarios, we'll proceed assuming a workshop is needed if _at is found.\n        # If no workshop is specified, we can't perform the movement logic below, so we'll just try to USE.\n        # But this is an edge case given typical Craft recipes.\n        pass # The current implementation will proceed to 'USE' directly if workshop_idx remains None.\n\n    # Find the workshop's exact location on the grid\n    target_wx, target_wy = -1, -1 # Initialize with invalid coordinates\n    if workshop_idx is not None:\n        grid_width, grid_height, _ = env._current_state.grid.shape\n        for x in range(grid_width):\n            for y in range(grid_height):\n                if env._current_state.grid[x, y, workshop_idx] == 1:\n                    target_wx, target_wy = x, y\n                    break\n            if target_wx != -1: # Found the workshop\n                break\n    \n    # If a workshop is required (workshop_idx is not None) but not found on the map,\n    # or if the item can be crafted without a specific workshop,\n    # we can try to perform the USE action directly from the current position.\n    # However, for typical crafting, movement is required.\n    # We proceed with movement if a workshop was identified and found on the map.\n    if workshop_idx is not None and target_wx != -1:\n        # Movement loop: Move to be adjacent to the workshop\n        # The loop continues until the agent is next to the workshop.\n        # env.step also handles if max_steps is reached or goal is achieved.\n        while not env._current_state.next_to(workshop_idx):\n            current_x, current_y = env._current_state.pos\n\n            # Choose move action towards the workshop\n            action_to_take = None\n            # Prioritize moving horizontally, then vertically\n            if target_wx > current_x:\n                action_to_take = RIGHT\n            elif target_wx < current_x:\n                action_to_take = LEFT\n            elif target_wy > current_y:\n                action_to_take = UP\n            elif target_wy < current_y:\n                action_to_take = DOWN\n            \n            if action_to_take is None:\n                # Agent is already at the same x and y coordinates as the workshop.\n                # This should not happen if not next_to, unless blocked or on top of it.\n                # If stuck and not next to, break to prevent infinite loop.\n                break \n\n            r, done, _ = env.step(action_to_take)\n            total_reward += r\n            if done:\n                return total_reward\n\n        # Facing loop: Turn to face the workshop\n        current_x, current_y = env._current_state.pos\n        current_dir = env._current_state.dir\n\n        req_dir = -1 # Initialize with an invalid direction\n        # Determine the required direction to face the workshop from the current adjacent position\n        if target_wx == current_x: # Workshop is directly above or below\n            if target_wy > current_y: # Workshop is above (higher Y)\n                req_dir = UP\n            elif target_wy < current_y: # Workshop is below (lower Y)\n                req_dir = DOWN\n        elif target_wy == current_y: # Workshop is directly left or right\n            if target_wx > current_x: # Workshop is to the right (higher X)\n                req_dir = RIGHT\n            elif target_wx < current_x: # Workshop is to the left (lower X)\n                req_dir = LEFT\n        \n        # If the required direction is determined and different from current direction\n        if req_dir != -1 and current_dir != req_dir:\n            # Perform a step in the required direction to change agent's facing direction.\n            # If the cell is blocked (like by the workshop itself), the agent's position won't change,\n            # but its direction will update, which is what we need.\n            r, done, _ = env.step(req_dir)\n            total_reward += r\n            if done:\n                return total_reward\n\n    # Perform USE action at the workshop (or current position if no workshop needed/found)\n    r, done, _ = env.step(USE)\n    total_reward += r\n    if done:\n        return total_reward\n\n    return total_reward", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-24T04:52:49.715796", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    # Helper function to move the agent to be adjacent to a target position\n    # and face it. Optionally performs a USE action.\n    # Returns reward accumulated by this helper, or -1.0 if a critical failure occurs\n    # (e.g., ran out of steps, path blocked).\n    def _move_to_adjacent_and_face_and_use(env, target_pos, perform_use=False):\n        local_reward = 0.0\n        \n        # Max iterations for pathfinding loop to prevent infinite loops.\n        # We use env.max_steps as an upper bound, ensuring we respect the overall episode limit.\n        pathfinding_steps_limit = env.max_steps + 1 \n        \n        for _ in range(pathfinding_steps_limit):\n            current_pos = env._current_state.pos\n            \n            # Check if already adjacent (Manhattan distance 1)\n            if abs(current_pos[0] - target_pos[0]) + abs(current_pos[1] - target_pos[1]) == 1:\n                break # Reached an adjacent position\n            \n            # Check if overall environment steps limit is reached\n            if env.steps >= env.max_steps: \n                return -1.0 # Signal failure: ran out of total steps\n\n            dx = target_pos[0] - current_pos[0]\n            dy = target_pos[1] - current_pos[1]\n\n            action_taken_this_step = False\n            \n            # Prioritize moving along the axis with the larger displacement first\n            if abs(dx) >= abs(dy) and dx != 0: \n                desired_dir = RIGHT if dx > 0 else LEFT\n                initial_agent_pos = env._current_state.pos # Record position to check if agent moved\n                reward, _, _ = env.step(desired_dir)\n                local_reward += reward\n                if env._current_state.pos != initial_agent_pos: # Agent successfully moved\n                    action_taken_this_step = True\n            \n            # If no horizontal move was attempted, or it failed (blocked), try vertical\n            if not action_taken_this_step and dy != 0: \n                desired_dir = UP if dy > 0 else DOWN\n                initial_agent_pos = env._current_state.pos\n                reward, _, _ = env.step(desired_dir)\n                local_reward += reward\n                if env._current_state.pos != initial_agent_pos:\n                    action_taken_this_step = True\n            \n            # If agent couldn't move and is not yet adjacent (meaning it's stuck)\n            if not action_taken_this_step and (dx != 0 or dy != 0):\n                return -1.0 # Signal failure: path blocked or stuck\n\n        # After the loop, explicitly check if the agent is adjacent.\n        # This covers cases where the loop finished due to `pathfinding_steps_limit`\n        # but the agent still didn't reach an adjacent position.\n        if abs(env._current_state.pos[0] - target_pos[0]) + abs(env._current_state.pos[1] - target_pos[1]) != 1:\n            return -1.0 # Signal failure: did not reach adjacent position\n\n        # Now agent is adjacent to target_pos. Next, ensure it faces the target.\n        current_pos = env._current_state.pos \n\n        face_dir = -1\n        if current_pos[0] == target_pos[0] - 1: # Target is to the RIGHT of agent\n            face_dir = RIGHT\n        elif current_pos[0] == target_pos[0] + 1: # Target is to the LEFT of agent\n            face_dir = LEFT\n        elif current_pos[1] == target_pos[1] - 1: # Target is UP (higher Y) from agent\n            face_dir = UP\n        elif current_pos[1] == target_pos[1] + 1: # Target is DOWN (lower Y) from agent\n            face_dir = DOWN\n        \n        # If the agent's current direction is not the desired facing direction,\n        # perform a step in that direction. This will update `self.dir` in CraftState,\n        # even if the move is blocked.\n        if face_dir != -1 and env._current_state.dir != face_dir:\n            if env.steps >= env.max_steps:\n                return -1.0\n            reward, _, _ = env.step(face_dir)\n            local_reward += reward\n\n        # If `perform_use` is True, execute the USE action.\n        if perform_use:\n            if env.steps >= env.max_steps:\n                return -1.0\n            reward, _, _ = env.step(USE)\n            local_reward += reward\n\n        return local_reward # Return the total reward collected by this helper function\n\n    item_idx = env.world.cookbook.index[item]\n\n    # 0. Check if the target item is already in the agent's inventory.\n    if env._current_state.inventory[item_idx] > 0:\n        return total_reward # Item is already crafted, no actions needed, return 0 reward.\n\n    # 1. Get recipe details for the item to be crafted.\n    recipe = env.world.cookbook.recipes[item_idx]\n    \n    # Identify the required workshop for this crafting recipe.\n    workshop_name = recipe[\"_at\"]\n    workshop_idx = env.world.cookbook.index[workshop_name]\n    \n    # Extract the list of required ingredients (by their indices) and their quantities.\n    required_ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n    # 2. Acquire all necessary ingredients.\n    for ing_idx, needed_count in required_ingredients.items():\n        ing_name = env.world.cookbook.index.get(ing_idx)\n        \n        # Continue acquiring this ingredient until the needed_count is met or steps run out.\n        while env._current_state.inventory[ing_idx] < needed_count and env.steps < env.max_steps:\n            if ing_idx in env.world.cookbook.primitives:\n                # If the ingredient is a primitive (e.g., wood, iron), locate it on the grid\n                # and collect it using the 'USE' action.\n                \n                target_primitive_pos = None\n                min_dist_to_primitive = float('inf')\n                current_agent_pos = env._current_state.pos\n                \n                grid = env._current_state.grid\n                width, height, _ = grid.shape\n                \n                # Search the grid for the closest instance of the primitive ingredient.\n                for x_grid in range(width):\n                    for y_grid in range(height):\n                        if grid[x_grid, y_grid, ing_idx] == 1: # If this grid cell contains the primitive\n                            # Calculate Manhattan distance from agent to this primitive\n                            dist = abs(current_agent_pos[0] - x_grid) + abs(current_agent_pos[1] - y_grid)\n                            if dist < min_dist_to_primitive:\n                                min_dist_to_primitive = dist\n                                target_primitive_pos = (x_grid, y_grid)\n                \n                if target_primitive_pos is None:\n                    # No more of this primitive found on the map, cannot acquire.\n                    # This means the crafting goal cannot be fulfilled. Break from current ingredient loop.\n                    break \n\n                # Move to be adjacent to the primitive, face it, and then USE to pick it up.\n                reward_from_helper = _move_to_adjacent_and_face_and_use(env, target_primitive_pos, perform_use=True)\n                if reward_from_helper == -1.0:\n                    # A critical failure occurred (e.g., stuck, ran out of steps) during collection.\n                    # Cannot proceed with crafting, return accumulated reward so far.\n                    return total_reward \n                total_reward += reward_from_helper\n            else:\n                # If the ingredient is not a primitive, it must be another craftable item.\n                # Recursively call `craft_v2` to acquire this sub-ingredient.\n                \n                # Check if we still need to craft this sub-ingredient, as a previous recursive call\n                # might have already yielded enough for this iteration.\n                if env._current_state.inventory[ing_idx] < needed_count:\n                    reward_from_subcraft = craft_v2(env, ing_name) # Recursive call\n                    total_reward += reward_from_subcraft\n                else:\n                    break # Already have enough, break from this sub-ingredient's acquisition loop\n\n    # After attempting to acquire all ingredients, verify if all are present.\n    # If not, the final item cannot be crafted.\n    for ing_idx, needed_count in required_ingredients.items():\n        if env._current_state.inventory[ing_idx] < needed_count:\n            return total_reward # Missing ingredients, cannot craft.\n\n    # 3. Craft the final item at the designated workshop.\n    # First, locate the workshop's position on the grid.\n    workshop_location_on_grid = None\n    grid = env._current_state.grid\n    width, height, _ = grid.shape\n    for x_grid in range(width):\n        for y_grid in range(height):\n            if grid[x_grid, y_grid, workshop_idx] == 1:\n                workshop_location_on_grid = (x_grid, y_grid)\n                break\n        if workshop_location_on_grid is not None:\n            break\n            \n    if workshop_location_on_grid is None:\n        # The required workshop was not found on the map. Cannot craft.\n        return total_reward \n\n    # Move to be adjacent to the workshop, face it, and then perform the 'USE' action\n    # to initiate the crafting process.\n    reward_from_helper = _move_to_adjacent_and_face_and_use(env, workshop_location_on_grid, perform_use=True)\n    if reward_from_helper == -1.0:\n        # A critical failure occurred during movement or using the workshop.\n        # Cannot complete crafting.\n        return total_reward\n\n    total_reward += reward_from_helper\n\n    return total_reward", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-24T04:52:51.253846", "function_name": "craft", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-24T04:55:36.810685", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Constants for grid dimensions (assuming these are globally accessible from the CraftWorld/CraftLab context)\n  # These are usually defined at the module level in the game's codebase (e.g., in craft_world.py).\n  # WIDTH = 12\n  # HEIGHT = 12\n\n  # Helper to map (dx, dy) relative position to the integer action for facing that direction.\n  # These are the 4 cardinal directions where the USE action can be applied.\n  cardinal_dir_to_action = {\n      (0, -1): ACTION_DOWN,\n      (0, 1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT\n  }\n\n  # 1. Get the target item's index and its recipe from the cookbook\n  cookbook = env.world.cookbook\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # If the item name is not in the cookbook's index, it cannot be crafted.\n    return total_reward\n\n  if recipe is None:\n    # If there is no recipe for this item (e.g., it's a primitive or environment object),\n    # it cannot be crafted via a recipe.\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n      try:\n          workshop_idx = cookbook.index[workshop_name]\n      except KeyError:\n          # If the required workshop is not in the cookbook's index, cannot craft.\n          return total_reward\n  # Note: If workshop_name is None, workshop_idx remains None, implying no specific workshop is needed.\n  # Based on the provided recipes, all crafts seem to require a workshop.\n\n  # Extract ingredients and their counts from the recipe\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients\n  for ingredient_idx, needed_count in ingredients.items():\n      while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n          current_state = env._current_state\n          x, y = current_state.pos\n          grid = current_state.grid\n          \n          found_ingredient_adjacent_cardinal = False\n          action_to_face_ingredient = None\n          \n          # Check if the ingredient is directly adjacent in one of the four cardinal directions\n          for (dx, dy), face_action in cardinal_dir_to_action.items():\n              nx, ny = x + dx, y + dy\n              # Ensure the neighboring coordinates are within grid bounds (using assumed global WIDTH, HEIGHT)\n              if 0 <= nx < 12 and 0 <= ny < 12 and grid[nx, ny, ingredient_idx] == 1: # Assuming WIDTH=12, HEIGHT=12\n                  found_ingredient_adjacent_cardinal = True\n                  action_to_face_ingredient = face_action\n                  break # Found it, no need to check other directions\n          \n          if found_ingredient_adjacent_cardinal:\n              # If the ingredient is found adjacent, orient the agent towards it if not already facing\n              if current_state.dir != action_to_face_ingredient:\n                  reward, done, _ = env.step(action_to_face_ingredient)\n                  total_reward += reward\n                  if done: return total_reward # Exit if environment signals done (e.g., max steps reached)\n              \n              # Perform the USE action to pick up the ingredient\n              reward, done, _ = env.step(ACTION_USE)\n              total_reward += reward\n              if done: return total_reward # Exit if environment signals done\n              \n              # The while loop condition (checking inventory count) will re-evaluate after pickup\n          else:\n              # Ingredient not directly adjacent. Try to move to find it.\n              # Simple exploration strategy: try moving in a fixed order (RIGHT, UP, LEFT, DOWN).\n              # We take only one step per iteration of the outer while loop to allow for re-evaluation.\n              moved_this_step = False\n              for move_action_name in ['RIGHT', 'UP', 'LEFT', 'DOWN']:\n                  reward, done, _ = env.step(action_map[move_action_name])\n                  total_reward += reward\n                  if done: return total_reward # Exit if environment signals done\n                  moved_this_step = True\n                  break # Take only one step, then re-evaluate adjacency in the next while iteration\n\n              if not moved_this_step:\n                  # If no movement happened (e.g., agent is stuck against a boundary),\n                  # it implies the ingredient might be unreachable with this simple strategy.\n                  # Breaking here prevents an infinite loop if the agent gets permanently stuck.\n                  # This will likely result in the craft failing if ingredients cannot be obtained.\n                  break \n\n  # 3. Move to the workshop (if a workshop is required for crafting)\n  if workshop_idx is not None:\n      # Loop until the agent is adjacent to the workshop.\n      # env._current_state.next_to(workshop_idx) checks all 8 adjacent cells (cardinal and diagonal).\n      while not env._current_state.next_to(workshop_idx):\n          # Try to move to get closer to the workshop.\n          # Again, a simple exploration strategy.\n          moved_this_step = False\n          for move_action_name in ['RIGHT', 'UP', 'LEFT', 'DOWN']:\n              reward, done, _ = env.step(action_map[move_action_name])\n              total_reward += reward\n              if done: return total_reward # Exit if environment signals done\n              moved_this_step = True\n              break # Take only one step, then re-evaluate adjacency\n\n          if not moved_this_step:\n              # If cannot move, similar to ingredient collection, implies being stuck.\n              break \n\n  # 4. Craft the item at the workshop (if a workshop was required and the agent is positioned correctly)\n  # First, ensure all ingredients are actually collected before attempting to craft.\n  all_ingredients_collected = True\n  for ingredient_idx, needed_count in ingredients.items():\n      if env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n          all_ingredients_collected = False\n          break\n  \n  if all_ingredients_collected:\n      # If a workshop is required, proceed with the crafting action\n      if workshop_idx is not None:\n          current_state = env._current_state\n          x, y = current_state.pos\n          grid = current_state.grid\n          \n          # Find the workshop's cardinal direction relative to the agent to orient correctly for USE\n          action_to_face_workshop = None\n          for (dx, dy), face_action in cardinal_dir_to_action.items():\n              nx, ny = x + dx, y + dy\n              # Assuming WIDTH=12, HEIGHT=12\n              if 0 <= nx < 12 and 0 <= ny < 12 and grid[nx, ny, workshop_idx] == 1: \n                  action_to_face_workshop = face_action\n                  break # Found it, no need to check other directions\n          \n          if action_to_face_workshop is not None:\n              # Orient towards the workshop if not already facing\n              if current_state.dir != action_to_face_workshop:\n                  reward, done, _ = env.step(action_to_face_workshop)\n                  total_reward += reward\n                  if done: return total_reward # Exit if environment signals done\n              \n              # Perform the USE action to craft the item at the workshop\n              reward, done, _ = env.step(ACTION_USE)\n              total_reward += reward\n              if done: return total_reward # Exit if environment signals done\n      # else:\n          # If no workshop required and ingredients collected, this is where a \"workshop-less\"\n          # crafting action would go if such a concept existed and needed an explicit action.\n          # As per the problem description and observed recipes, all crafts involve a workshop.\n          # So, this 'else' block implicitly means the craft won't happen here.\n          # For example, to craft a 'stick' from 'wood', the recipe specifies 'workshop1'.\n\n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T04:55:37.875361", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Helper for directions to check adjacent cells and face them\n  # (dx, dy, action_name_to_face_that_direction)\n  # WIDTH and HEIGHT are globally defined in the craft environment logic\n  relative_directions_to_face = [\n      (0, -1, 'DOWN'),  # Item is at (x, y-1), so agent needs to face DOWN\n      (0, 1, 'UP'),     # Item is at (x, y+1), so agent needs to face UP\n      (-1, 0, 'LEFT'),  # Item is at (x-1, y), so agent needs to face LEFT\n      (1, 0, 'RIGHT')   # Item is at (x+1, y), so agent needs to face RIGHT\n  ]\n\n  cookbook = env.world.cookbook\n  \n  # 1. Get the target item's index and its recipe\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # If item is not in index, it cannot be crafted\n    return total_reward \n\n  if recipe is None:\n    # If there's no recipe (e.g., it's a primitive or uncraftable), return\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # If the recipe doesn't specify a workshop, it implies it cannot be crafted this way\n    return total_reward\n  \n  try:\n    workshop_idx = cookbook.index[workshop_name]\n  except KeyError:\n    # Workshop name from recipe not found in index, indicates an invalid recipe setup\n    return total_reward\n\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients\n  for ingredient_idx, needed_count in ingredients.items():\n    # Loop until enough of this ingredient is in the inventory\n    while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n      current_state = env._current_state\n\n      collected_in_this_step = False\n      \n      # First, check if the ingredient is adjacent and try to collect it directly\n      for dx, dy, action_to_face in relative_directions_to_face:\n          nx, ny = current_state.pos[0] + dx, current_state.pos[1] + dy\n          \n          # Check grid bounds for the neighbor cell\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          if current_state.grid[nx, ny, ingredient_idx] == 1:\n              # Ingredient found adjacent at (nx, ny). 'action_to_face' is the required direction.\n              \n              # If not facing the required direction, turn.\n              if current_state.dir != action_map[action_to_face]:\n                  reward, done, _ = env.step(action_map[action_to_face])\n                  total_reward += reward\n                  if done: return total_reward # Environment ended prematurely\n                  current_state = env._current_state # Update state after turning\n\n              # Now, agent should be facing the item. Try to USE.\n              reward, done, _ = env.step(ACTION_USE)\n              total_reward += reward\n              if done: return total_reward # Environment ended prematurely\n              collected_in_this_step = True\n              break # Break from dx, dy loop, as one ingredient is collected\n      \n      if collected_in_this_step:\n          # Successfully collected one ingredient, re-evaluate the 'while' condition for this ingredient.\n          continue\n\n      # If not collected yet (either not adjacent or USE failed),\n      # try simple exploration by moving around to find it.\n      # This is a basic heuristic, not a full pathfinding algorithm.\n      moved_to_find_item = False\n      for action_name in ['RIGHT', 'UP', 'LEFT', 'DOWN']: # Simple ordered exploration\n          reward, done, _ = env.step(action_map[action_name])\n          total_reward += reward\n          if done: return total_reward # Environment ended prematurely\n          current_state = env._current_state # Update state after moving\n\n          # After moving, immediately re-check for adjacency and collection.\n          # This is the same logic as the initial check within the while loop.\n          for dx, dy, action_to_face in relative_directions_to_face:\n              nx, ny = current_state.pos[0] + dx, current_state.pos[1] + dy\n              if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                  continue\n\n              if current_state.grid[nx, ny, ingredient_idx] == 1:\n                  if current_state.dir != action_map[action_to_face]:\n                      reward, done, _ = env.step(action_map[action_to_face])\n                      total_reward += reward\n                      if done: return total_reward\n                  \n                  reward, done, _ = env.step(ACTION_USE)\n                  total_reward += reward\n                  if done: return total_reward\n                  moved_to_find_item = True\n                  break # Break from dx, dy loop\n          if moved_to_find_item:\n              break # Break from action_name (exploration) loop, one item collected.\n      \n      # If still not collected after a round of exploration, the outer while loop continues.\n      # It will eventually terminate due to max_steps if the item is truly unreachable or agent gets stuck.\n      if not moved_to_find_item and not collected_in_this_step:\n          # Agent is stuck or cannot reach the item with current strategy.\n          # The loop will rely on max_steps to prevent infinite execution.\n          pass \n\n  # 3. Move to the workshop\n  # Find the exact coordinates of the workshop on the grid.\n  workshop_coords = None\n  grid_data = env._current_state.grid\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if grid_data[x_grid, y_grid, workshop_idx] == 1:\n              workshop_coords = (x_grid, y_grid)\n              break\n      if workshop_coords:\n          break\n\n  if workshop_coords is None:\n      # Workshop not found in the environment. This indicates an issue with the scenario setup.\n      return total_reward\n\n  # Navigate until adjacent to the workshop\n  while not env._current_state.next_to(workshop_idx):\n      current_pos = env._current_state.pos\n      \n      # Greedy movement: try to reduce Manhattan distance to the workshop.\n      dx, dy = 0, 0\n      if current_pos[0] < workshop_coords[0]:\n          dx = 1 # Move right\n      elif current_pos[0] > workshop_coords[0]:\n          dx = -1 # Move left\n      \n      # Prioritize horizontal movement for simplicity, then vertical if x is aligned.\n      # Or could be swapped, depending on scenario.\n      if dx == 0: # Only try vertical if horizontal is aligned or complete.\n          if current_pos[1] < workshop_coords[1]:\n              dy = 1 # Move up\n          elif current_pos[1] > workshop_coords[1]:\n              dy = -1 # Move down\n\n      action_to_move = None\n      if dx == 1: action_to_move = ACTION_RIGHT\n      elif dx == -1: action_to_move = ACTION_LEFT\n      elif dy == 1: action_to_move = ACTION_UP\n      elif dy == -1: action_to_move = ACTION_DOWN\n      \n      if action_to_move is not None:\n          reward, done, _ = env.step(action_to_move)\n          total_reward += reward\n          if done: return total_reward # Environment ended prematurely\n      else:\n          # This branch means dx=0 and dy=0, implying agent is at workshop_coords (or stuck).\n          # If not adjacent despite this, it means the greedy movement alone isn't enough (e.g., diagonal).\n          # For Craft env, simple cardinal movements generally suffice to get adjacent.\n          break # Break from the loop if no progress can be made by greedy movement.\n\n  # 4. Craft the item at the workshop\n  current_state = env._current_state\n  \n  # Orient towards the workshop (which the agent should now be adjacent to)\n  target_adjacent_dir_action = None\n  x, y = current_state.pos\n  grid = current_state.grid\n  for dx, dy, action_name in relative_directions_to_face:\n      nx, ny = x + dx, y + dy\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n          continue\n      if grid[nx, ny, workshop_idx] == 1:\n          target_adjacent_dir_action = action_name\n          break\n  \n  if target_adjacent_dir_action is not None:\n      if current_state.dir != action_map[target_adjacent_dir_action]:\n          reward, done, _ = env.step(action_map[target_adjacent_dir_action])\n          total_reward += reward\n          if done: return total_reward\n      \n      # Now USE to craft the item\n      reward, done, _ = env.step(ACTION_USE)\n      total_reward += reward\n      if done: return total_reward\n  \n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T05:01:22.671835", "function_name": "craft", "function_body": "    total_reward = 0.0\n    cookbook = env.world.cookbook\n\n    item_idx = cookbook.index[item]\n    recipe = cookbook.recipes[item_idx]\n\n    # --- Step 1: Collect all required primitive ingredients ---\n    needed_ingredients = {}\n    for ing_idx, count in recipe.items():\n        if isinstance(ing_idx, int):  # It's an ingredient (represented by its index)\n            needed_ingredients[ing_idx] = count\n\n    for ing_idx, needed_count in needed_ingredients.items():\n        ing_name = cookbook.index.get(ing_idx)\n        \n        # Max moves for collecting one unit of an item: Heuristic value to prevent infinite loops.\n        # It should be sufficient to cross the map a few times and attempt interaction.\n        max_moves_per_unit = 2 * WIDTH * HEIGHT  \n\n        while env._current_state.inventory[ing_idx] < needed_count:\n            # Attempt to collect one more unit\n            current_amount_before_attempt = env._current_state.inventory[ing_idx]\n            collected_one_unit_in_attempt = False\n\n            for move_attempt_idx in range(max_moves_per_unit):\n                if env._current_state.inventory[ing_idx] > current_amount_before_attempt:\n                    collected_one_unit_in_attempt = True\n                    break # Successfully collected one unit\n\n                # Find any instance of the item on the grid\n                grid = env._current_state.grid\n                item_coords = np.argwhere(grid[:, :, ing_idx] == 1)\n                \n                if item_coords.size == 0:\n                    # Item not found on map (might have been picked up by previous attempts or doesn't exist)\n                    break # Cannot collect this specific unit, exit inner loop\n\n                target_item_x, target_item_y = item_coords[0] # Go for the first one found\n\n                # Check if already next to the item\n                if env._current_state.next_to(ing_idx):\n                    # Agent is next to the item, attempt to USE\n                    use_r, _, _ = env.step(env.action_specs()['USE'])\n                    total_reward += use_r\n                    if env._current_state.inventory[ing_idx] > current_amount_before_attempt:\n                        collected_one_unit_in_attempt = True\n                        break # Successfully collected one unit\n                    else:\n                        # Failed to collect after USE (e.g., not grabbable, or required tool missing)\n                        # No more attempts for this unit if USE didn't work while next to it\n                        break\n\n                # If not next to it, move towards it\n                agent_x, agent_y = env._current_state.pos\n                dx = target_item_x - agent_x\n                dy = target_item_y - agent_y\n\n                chosen_move_action = None\n                # Simple greedy pathfinding: prioritize axis with larger distance\n                if abs(dx) > abs(dy):\n                    if dx > 0: chosen_move_action = env.action_specs()['RIGHT']\n                    elif dx < 0: chosen_move_action = env.action_specs()['LEFT']\n                else: # Prioritize vertical movement, or if dx == 0\n                    if dy > 0: chosen_move_action = env.action_specs()['UP']\n                    elif dy < 0: chosen_move_action = env.action_specs()['DOWN']\n                \n                if chosen_move_action is None: \n                    # Agent is on target, or no direct path, or stuck. Cannot move further effectively.\n                    break \n\n                r, _, _ = env.step(chosen_move_action)\n                total_reward += r\n\n            if not collected_one_unit_in_attempt:\n                # If after all attempts, we still haven't collected enough of this ingredient,\n                # then we cannot craft the target item.\n                return total_reward # Return what was gathered so far (may be partial)\n\n    # --- Step 2: Move to the required workshop (if any) ---\n    required_workshop_name = recipe.get(\"_at\")\n    workshop_reached_and_next_to = False\n    \n    # Max moves for reaching workshop\n    max_workshop_moves = 2 * WIDTH * HEIGHT # Heuristic for crossing map to reach workshop\n\n    if required_workshop_name:\n        required_workshop_idx = cookbook.index[required_workshop_name]\n        \n        for move_attempt_idx in range(max_workshop_moves):\n            if env._current_state.next_to(required_workshop_idx):\n                workshop_reached_and_next_to = True\n                break # Agent is next to the workshop\n\n            # Find workshop on grid\n            grid = env._current_state.grid\n            workshop_coords = np.argwhere(grid[:, :, required_workshop_idx] == 1)\n            \n            if workshop_coords.size == 0:\n                # Workshop not found on map - impossible to craft\n                workshop_reached_and_next_to = False \n                break # Exit loop, cannot reach workshop\n\n            target_workshop_x, target_workshop_y = workshop_coords[0] # Go for the first one found\n\n            agent_x, agent_y = env._current_state.pos\n            dx = target_workshop_x - agent_x\n            dy = target_workshop_y - agent_y\n\n            chosen_move_action = None\n            if abs(dx) > abs(dy):\n                if dx > 0: chosen_move_action = env.action_specs()['RIGHT']\n                elif dx < 0: chosen_move_action = env.action_specs()['LEFT']\n            else:\n                if dy > 0: chosen_move_action = env.action_specs()['UP']\n                elif dy < 0: chosen_move_action = env.action_specs()['DOWN']\n            \n            if chosen_move_action is None:\n                # Agent is stuck or on the workshop but not \"next_to\" due to boundary logic, etc.\n                # If target is reachable, we expect chosen_move_action to be non-None until next_to is true.\n                break \n\n            r, _, _ = env.step(chosen_move_action)\n            total_reward += r\n\n        # If workshop was required but not reached, then crafting fails.\n        if not workshop_reached_and_next_to:\n            return total_reward # Return partial reward from failed attempt\n\n    else: # No workshop required for this recipe\n        workshop_reached_and_next_to = True # Assume ready to craft\n\n    # --- Step 3: Perform the USE action to craft ---\n    # This action is only taken if ingredients are gathered and workshop is reached (or not needed).\n    if workshop_reached_and_next_to:\n        craft_r, _, _ = env.step(env.action_specs()['USE'])\n        total_reward += craft_r\n\n    return total_reward", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-24T05:01:22.690972", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    cookbook = env.world.cookbook\n    current_state = env._current_state # Get current state from the environment\n\n    # 1. Get target item index, recipe, and workshop index\n    try:\n        target_item_idx = cookbook.index[item_to_craft_str]\n    except KeyError:\n        # Item string not found in cookbook index, cannot craft.\n        return total_reward\n\n    if target_item_idx not in cookbook.recipes:\n        # Item is not craftable (e.g., it's a primitive or environment item),\n        # or it's an invalid item for crafting.\n        return total_reward\n\n    recipe = cookbook.recipes[target_item_idx]\n    \n    # Identify the required workshop\n    workshop_str = recipe.get(\"_at\")\n    if workshop_str is None:\n        # Recipe has no \"_at\" key, which implies it might be a direct primitive or\n        # an invalid recipe for crafting (e.g., something always available).\n        # Assuming all crafting requires a workshop based on CraftWorld.\n        return total_reward\n    \n    workshop_idx = cookbook.index[workshop_str]\n\n    # 2. Acquire ingredients recursively\n    for ingredient_idx, required_count in recipe.items():\n        if isinstance(ingredient_idx, int):  # It's an actual ingredient (not \"_at\" or \"_yield\")\n            ingredient_name = cookbook.index.get(ingredient_idx)\n            \n            # Loop until enough of this ingredient is acquired\n            while current_state.inventory[ingredient_idx] < required_count:\n                acquisition_reward = 0.0\n                if ingredient_idx in cookbook.primitives:\n                    # If it's a primitive, use the DSL 'collect' function\n                    # Assumes 'collect' function is available in scope and acquires one item.\n                    acquisition_reward = collect(env, ingredient_name)\n                else:\n                    # If it's craftable, recursively call craft_v2\n                    # Assumes 'craft_v2' (this function) produces one item.\n                    acquisition_reward = craft_v2(env, ingredient_name)\n                \n                total_reward += acquisition_reward\n                current_state = env._current_state # Update current_state reference after acquisition attempt\n\n                # Break condition if item cannot be acquired (to prevent infinite loops)\n                # If no reward was gained and inventory didn't increase for this ingredient, it might be stuck.\n                # In a real environment, max_steps would prevent infinite loops.\n                if acquisition_reward == 0 and current_state.inventory[ingredient_idx] < required_count:\n                    # This implies either the item wasn't found, or its prerequisites couldn't be met.\n                    # Cannot proceed with crafting the target item without this ingredient.\n                    return total_reward\n\n    # Verify all ingredients are in inventory before proceeding\n    for ingredient_idx, required_count in recipe.items():\n        if isinstance(ingredient_idx, int) and current_state.inventory[ingredient_idx] < required_count:\n            # Should not happen if the while loop logic is robust, but a safeguard.\n            return total_reward\n\n    # 3. Move to the workshop\n    workshop_coords = None\n    grid_data = current_state.grid\n    # Search for the workshop on the grid\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if grid_data[x, y, workshop_idx] == 1:\n                workshop_coords = (x, y)\n                break\n        if workshop_coords:\n            break\n    \n    if workshop_coords is None:\n        # Workshop not found on the grid, cannot craft.\n        return total_reward\n\n    # Perform BFS (Breadth-First Search) to find a path to a cell adjacent to the workshop\n    # This uses `collections.deque` which is available in the provided codebase.\n    q = collections.deque([(current_state.pos, [])]) # (position, path_of_actions)\n    visited = {current_state.pos}\n    \n    # Target positions are any neighbors of the workshop, as 'USE' acts on adjacent cells.\n    target_cells = neighbors(workshop_coords) \n    \n    best_path_actions = []\n    path_found = False\n\n    while q:\n        (curr_x, curr_y), path_actions = q.popleft()\n        \n        # Check if current position is one of the target cells\n        if (curr_x, curr_y) in target_cells:\n            best_path_actions = path_actions\n            path_found = True\n            break\n            \n        # Explore valid neighbors (the global `neighbors` function is used)\n        for next_pos in neighbors((curr_x, curr_y)):\n            if next_pos not in visited:\n                visited.add(next_pos)\n                \n                # Determine direction action to get to next_pos\n                dx = next_pos[0] - curr_x\n                dy = next_pos[1] - curr_y\n                \n                action_dir = None\n                if dx == -1: action_dir = LEFT\n                elif dx == 1: action_dir = RIGHT\n                elif dy == -1: action_dir = DOWN\n                elif dy == 1: action_dir = UP\n                \n                if action_dir is not None:\n                    q.append((next_pos, path_actions + [action_dir]))\n    \n    if not path_found:\n        # Could not find a path to the workshop's vicinity.\n        return total_reward\n\n    # Execute path to workshop using the DSL 'move' function\n    for action_dir in best_path_actions:\n        # The 'move' function is provided by the DSL and internally updates env._current_state\n        move_reward = move(env, action_dir) \n        total_reward += move_reward\n        current_state = env._current_state # Keep local reference updated after each move\n\n    # 4. Perform USE action at the workshop\n    # The agent should now be adjacent to the workshop.\n    use_reward, final_state = env.step(USE)\n    total_reward += use_reward\n    env._current_state = final_state # Update the environment's state\n\n    return total_reward", "island_id": 4, "scores": {"3": -1}}
