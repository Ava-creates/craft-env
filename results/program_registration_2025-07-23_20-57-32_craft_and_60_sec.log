{"timestamp": "2025-07-24T08:54:29.423286", "function_name": "craft", "function_body": "  total_reward = 0.0\n  \n  # Get the integer ID for the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if recipe is None:\n      # If the item doesn't have a recipe (e.g., it's a primitive or unknown),\n      # it cannot be crafted by this function. Return accumulated reward (0.0).\n      return total_reward\n\n  # Get the name of the workshop required for this recipe\n  # \"_at\" is a special key in the recipe dict specifying the required workshop.\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # If the recipe doesn't specify a workshop, this item might not be craftable\n      # at a fixed station, or it's a basic gathering/tool use which is outside\n      # the scope of a 'craft' function in this DSL context.\n      return total_reward \n  \n  # Get the integer ID for the required workshop (e.g., 'workshop1' -> 4)\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find the actual coordinates of the workshop on the current grid\n  workshop_pos = None\n  # Get the current grid from the environment's state\n  current_grid = env._current_state.grid \n  \n  # Grid dimensions are constants defined in CraftWorld. We can also get them from current_grid.shape\n  # Assuming WIDTH and HEIGHT are defined in the global scope or accessible.\n  # If not, retrieve from current_grid.shape\n  WIDTH, HEIGHT, _ = current_grid.shape \n  \n  # Iterate through the grid to locate the workshop\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          # Check if this grid cell contains the workshop (value is 1 at workshop_idx)\n          if current_grid[x_grid, y_grid, workshop_idx] == 1:\n              workshop_pos = (x_grid, y_grid)\n              break # Found the workshop, exit inner loop\n      if workshop_pos:\n          break # Found the workshop, exit outer loop\n\n  if not workshop_pos:\n      # If the workshop is not present in the current environment, cannot craft.\n      return total_reward\n\n  # Define a maximum number of steps for this crafting operation to prevent infinite loops.\n  # This acts as a safeguard, similar to the environment's max_steps.\n  # A reasonable value could be proportional to grid size or a fixed large number.\n  max_craft_steps = WIDTH * HEIGHT * 2 # Allow enough steps to traverse the map twice\n\n  # Get the action mapping from the environment (e.g., {'UP': 1, 'DOWN': 0, ...})\n  action_map = env.action_specs()\n  \n  # Main loop for navigating and crafting\n  for _ in range(max_craft_steps):\n      # Always get the most current state of the agent and world\n      current_state = env._current_state \n      \n      # 1. Check if the agent is currently adjacent to the required workshop\n      # CraftState.next_to checks if the given item is in any of the 8 surrounding cells (including diagonals)\n      if current_state.next_to(workshop_idx):\n          # If adjacent, attempt to use the workshop to craft the item\n          reward, done, obs = env.step(action_map['USE'])\n          total_reward += reward\n          \n          # Check if the item has been successfully crafted (i.e., it's in inventory)\n          # or if the environment signaled termination (e.g., task completed, max steps reached).\n          if current_state.inventory[item_idx] > 0 or done:\n              return total_reward \n          \n          # If 'USE' was attempted but the item wasn't crafted and the environment didn't terminate,\n          # it likely means prerequisites (ingredients) were missing. This function primarily focuses\n          # on the physical act of crafting at a workshop. If ingredients are missing, it can't proceed.\n          # We might want to break here or continue trying. For simplicity, breaking implies\n          # we couldn't craft despite being at the workshop.\n          break # Agent is at the workshop but couldn't craft, maybe missing ingredients.\n                # Continuing might lead to infinite loops if ingredients are never obtained.\n\n      # 2. If not adjacent, determine the best move to get closer to the workshop\n      agent_x, agent_y = current_state.pos\n      \n      best_action = -1\n      # Initialize with a very large distance\n      min_dist_to_workshop = float('inf') \n\n      # Possible movement actions and their corresponding (dx, dy) changes\n      # Note: DOWN moves -1 in y, UP moves +1 in y, LEFT moves -1 in x, RIGHT moves +1 in x\n      # This matches how `CraftState.step` defines dx, dy for actions.\n      moves_dxdy = {\n          action_map['DOWN']: (0, -1),\n          action_map['UP']: (0, 1),\n          action_map['LEFT']: (-1, 0),\n          action_map['RIGHT']: (1, 0)\n      }\n\n      # Iterate through each possible cardinal movement to find the best next step\n      found_better_move = False\n      for action, (dx, dy) in moves_dxdy.items():\n          n_x, n_y = agent_x + dx, agent_y + dy\n\n          # Check if the proposed next position (n_x, n_y) is within grid boundaries\n          # and if it is an empty space (agent cannot move onto occupied cells like workshops or items).\n          # The `grid[nx, ny, :].any()` check returns True if *anything* is in that cell.\n          # We want to move to a cell that has *nothing* in it.\n          if 0 <= n_x < WIDTH and 0 <= n_y < HEIGHT and not current_grid[n_x, n_y, :].any():\n              # Calculate the Manhattan distance from the proposed next position to the workshop\n              current_dist = abs(n_x - workshop_pos[0]) + abs(n_y - workshop_pos[1])\n              \n              # If this move results in a shorter distance to the workshop, update best_action\n              if current_dist < min_dist_to_workshop:\n                  min_dist_to_workshop = current_dist\n                  best_action = action\n                  found_better_move = True\n      \n      # If a valid and beneficial move was found, execute it\n      if found_better_move and best_action != -1: # Ensure a best action was actually picked\n          reward, done, obs = env.step(best_action)\n          total_reward += reward\n          if done: # If env terminated after this step (e.g., goal reached by other means, or max_steps)\n              return total_reward\n      else:\n          # If no valid or beneficial move was found (e.g., agent is blocked by walls/items,\n          # or already at the closest possible empty spot near the workshop but not adjacent,\n          # or completely surrounded by obstacles that it cannot move onto).\n          # In this case, the agent is stuck and cannot reach the workshop or get adjacent.\n          break # Cannot proceed with crafting\n\n  # If the loop finishes without crafting the item or reaching the max_craft_steps\n  return total_reward", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:54:30.519340", "function_name": "craft", "function_body": "  total_reward = 0.0\n  \n  # Get the integer ID for the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if recipe is None:\n      # If the item doesn't have a recipe (e.g., it's a primitive or unknown),\n      # it cannot be crafted by this function. Return accumulated reward (0.0).\n      return total_reward\n\n  # Get the name of the workshop required for this recipe\n  # \"_at\" key specifies the required workshop\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # If the recipe doesn't specify a workshop, or it's implicitly craftable anywhere,\n      # this crafting function is not designed for it.\n      return total_reward \n  \n  # Get the integer ID for the required workshop\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find the actual coordinates of the workshop on the current grid\n  workshop_pos = None\n  current_grid = env._current_state.grid \n  # Get grid dimensions from the current state's grid shape\n  WIDTH, HEIGHT, _ = current_grid.shape \n  \n  # Iterate through the grid to locate the workshop\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if current_grid[x_grid, y_grid, workshop_idx] == 1:\n              workshop_pos = (x_grid, y_grid)\n              break\n      if workshop_pos:\n          break\n\n  if not workshop_pos:\n      # If the workshop is not present in the current environment, cannot craft.\n      return total_reward\n\n  # Define a maximum number of steps for this crafting operation to prevent infinite loops.\n  max_craft_steps = 50 # Arbitrary limit, can be adjusted. Environment also has max_steps.\n\n  # Get the action mapping from the environment (e.g., {'UP': 1, 'DOWN': 0, ...})\n  action_map = env.action_specs()\n  \n  # Define movement deltas for each action\n  moves_dxdy_map = {\n      action_map['DOWN']: (0, -1),\n      action_map['UP']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0)\n  }\n\n  for _ in range(max_craft_steps):\n      current_state = env._current_state # Always get the most current state of the agent and world\n      \n      # 1. Check if the agent is currently adjacent to the required workshop\n      if current_state.next_to(workshop_idx):\n          # If adjacent, attempt to use the workshop to craft the item\n          reward, done, obs = env.step(action_map['USE'])\n          total_reward += reward\n          \n          # Check if the item has been successfully crafted (i.e., it's in inventory)\n          # or if the environment signaled termination (e.g., task completed, max steps reached).\n          # inventory[item_idx] might be > 0 even if it wasn't the *goal*, but was crafted.\n          # The _get_reward function will determine if this counts towards the goal reward.\n          if current_state.inventory[item_idx] > 0 or done:\n              return total_reward \n          \n          # If 'USE' was attempted but the item wasn't crafted and the environment didn't terminate,\n          # it likely means prerequisites (ingredients) were missing or the _yield was 0.\n          # We continue the loop, but if this happens repeatedly, it indicates a problem\n          # with state or missing ingredients, which this function doesn't address.\n\n      # 2. If not adjacent, determine the best move to get closer to the workshop\n      agent_x, agent_y = current_state.pos\n      \n      best_action = -1\n      # Initialize with a very large distance\n      min_dist_to_workshop = float('inf') \n\n      # Iterate through all possible cardinal movement actions\n      for action, (dx, dy) in moves_dxdy_map.items():\n          n_x, n_y = agent_x + dx, agent_y + dy\n\n          # Check if the proposed next position (n_x, n_y) is within grid boundaries\n          # and if it is an empty space (agent cannot move onto occupied cells like items or obstacles)\n          if 0 <= n_x < WIDTH and 0 <= n_y < HEIGHT and not current_grid[n_x, n_y, :].any():\n              # Calculate the Manhattan distance from the proposed next position to the workshop\n              current_dist = abs(n_x - workshop_pos[0]) + abs(n_y - workshop_pos[1])\n              \n              # If this move results in a shorter distance to the workshop, update best_action\n              if current_dist < min_dist_to_workshop:\n                  min_dist_to_workshop = current_dist\n                  best_action = action\n      \n      # If a valid and beneficial move was found, execute it\n      if best_action != -1:\n          reward, done, obs = env.step(best_action)\n          total_reward += reward\n          if done: # If env terminated after this step (e.g., goal reached by other means, or max_steps)\n              return total_reward\n      else:\n          # If no valid or beneficial move was found (e.g., agent is blocked by obstacles,\n          # or already at the closest possible empty spot near the workshop but not adjacent,\n          # or completely surrounded by obstacles, or already adjacent and used USE action).\n          # In this case, the agent is stuck and cannot reach the workshop or get adjacent.\n          break # Cannot proceed with crafting (stuck)\n\n  return total_reward", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:56:09.442594", "function_name": "craft", "function_body": "  total_reward = 0.0\n  \n  # Get the integer ID for the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if recipe is None:\n      # If the item doesn't have a recipe (e.g., it's a primitive or unknown),\n      # it cannot be crafted by this function. Return accumulated reward (0.0).\n      return total_reward\n\n  # Get the name of the workshop required for this recipe\n  # \"_at\" is a special key in the recipe dict specifying the required workshop.\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # If the recipe doesn't specify a workshop, this item might not be craftable\n      # at a fixed station, or it's a basic gathering/tool use which is outside\n      # the scope of a 'craft' function in this DSL context.\n      return total_reward \n  \n  # Get the integer ID for the required workshop (e.g., 'workshop1' -> 4)\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find the actual coordinates of the workshop on the current grid\n  workshop_pos = None\n  # Get the current grid from the environment's state\n  current_grid = env._current_state.grid \n  \n  # Grid dimensions are constants defined in CraftWorld.\n  WIDTH, HEIGHT, _ = current_grid.shape \n  \n  # Iterate through the grid to locate the workshop\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          # Check if this grid cell contains the workshop (value is 1 at workshop_idx)\n          if current_grid[x_grid, y_grid, workshop_idx] == 1:\n              workshop_pos = (x_grid, y_grid)\n              break # Found the workshop, exit inner loop\n      if workshop_pos:\n          break # Found the workshop, exit outer loop\n\n  if not workshop_pos:\n      # If the workshop is not present in the current environment, cannot craft.\n      return total_reward\n\n  # Define a maximum number of steps for this crafting operation to prevent infinite loops.\n  # This acts as a safeguard, similar to the environment's max_steps.\n  # A reasonable value could be proportional to grid size or a fixed large number.\n  max_craft_steps = WIDTH * HEIGHT * 2 # Allow enough steps to traverse the map twice\n\n  # Get the action mapping from the environment (e.g., {'UP': 1, 'DOWN': 0, ...})\n  action_map = env.action_specs()\n  \n  # Main loop for navigating and crafting\n  for _ in range(max_craft_steps):\n      # Always get the most current state of the agent and world\n      current_state = env._current_state \n      \n      # 1. Check if the agent is currently adjacent to the required workshop\n      # CraftState.next_to checks if the given item is in any of the 8 surrounding cells (including diagonals)\n      if current_state.next_to(workshop_idx):\n          # If adjacent, attempt to use the workshop to craft the item\n          reward, done, obs = env.step(action_map['USE'])\n          total_reward += reward\n          \n          # Check if the item has been successfully crafted (i.e., it's in inventory)\n          # or if the environment signaled termination (e.g., task completed, max steps reached).\n          if current_state.inventory[item_idx] > 0 or done:\n              return total_reward \n          \n          # If 'USE' was attempted but the item wasn't crafted and the environment didn't terminate,\n          # it likely means prerequisites (ingredients) were missing. This function primarily focuses\n          # on the physical act of crafting at a workshop.\n          break # Agent is at the workshop but couldn't craft, maybe missing ingredients.\n\n      # 2. If not adjacent, determine the best move to get closer to the workshop\n      agent_x, agent_y = current_state.pos\n      \n      best_action = -1\n      # Initialize with the current Manhattan distance to the workshop. We aim to find a move that reduces this.\n      min_dist_after_move = abs(agent_x - workshop_pos[0]) + abs(agent_y - workshop_pos[1]) \n\n      # Possible movement actions and their corresponding (dx, dy) changes\n      # Note: DOWN moves -1 in y, UP moves +1 in y, LEFT moves -1 in x, RIGHT moves +1 in x\n      # This matches how `CraftState.step` defines dx, dy for actions.\n      moves_dxdy = {\n          action_map['DOWN']: (0, -1),\n          action_map['UP']: (0, 1),\n          action_map['LEFT']: (-1, 0),\n          action_map['RIGHT']: (1, 0)\n      }\n\n      found_better_move = False\n      # Iterate through each possible cardinal movement to find the best next step\n      for action, (dx, dy) in moves_dxdy.items():\n          n_x, n_y = agent_x + dx, agent_y + dy\n\n          # Check if the proposed next position (n_x, n_y) is within grid boundaries\n          # and if it is an empty space (agent cannot move onto occupied cells like workshops or items).\n          # The `grid[nx, ny, :].any()` check returns True if *anything* is in that cell.\n          # We want to move to a cell that has *nothing* in it.\n          if 0 <= n_x < WIDTH and 0 <= n_y < HEIGHT and not current_grid[n_x, n_y, :].any():\n              # Calculate the Manhattan distance from the proposed next position to the workshop\n              current_dist = abs(n_x - workshop_pos[0]) + abs(n_y - workshop_pos[1])\n              \n              # If this move results in a shorter distance to the workshop, update best_action\n              if current_dist < min_dist_after_move:\n                  min_dist_after_move = current_dist\n                  best_action = action\n                  found_better_move = True\n      \n      # If a valid and beneficial move was found, execute it\n      if found_better_move and best_action != -1: # Ensure a best action was actually picked\n          reward, done, obs = env.step(best_action)\n          total_reward += reward\n          if done: # If env terminated after this step (e.g., goal reached by other means, or max_steps)\n              return total_reward\n      else:\n          # If no valid or beneficial move was found (e.g., agent is blocked by walls/items,\n          # or already at the closest possible empty spot near the workshop but not adjacent,\n          # or completely surrounded by obstacles that it cannot move onto).\n          # In this case, the agent is stuck and cannot reach the workshop or get adjacent.\n          break # Cannot proceed with crafting\n\n  # If the loop finishes without crafting the item or reaching the max_craft_steps\n  return total_reward", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:56:10.480041", "function_name": "craft", "function_body": "  total_reward = 0.0\n  \n  # 1. Setup: Get item index and recipe\n  item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  \n  if recipe is None:\n      # If the item doesn't have a recipe (e.g., it's a primitive or unknown),\n      # it cannot be crafted by this function.\n      return total_reward\n\n  # Recipes include a \"_at\" key indicating the required workshop.\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n      # If the recipe doesn't specify a workshop, this item might not be craftable\n      # at a fixed station, or it's not a crafting task in this context.\n      return total_reward \n  \n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find workshop position on the grid\n  workshop_pos = None\n  current_grid = env._current_state.grid \n  WIDTH, HEIGHT, _ = current_grid.shape \n  \n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if current_grid[x_grid, y_grid, workshop_idx] == 1:\n              workshop_pos = (x_grid, y_grid)\n              break\n      if workshop_pos:\n          break\n\n  if not workshop_pos:\n      # If the required workshop is not present in the current environment, cannot craft.\n      return total_reward\n\n  # A generous limit for steps to allow movement, rotation, and crafting attempts.\n  max_craft_attempts = WIDTH * HEIGHT * 5 \n  action_map = env.action_specs()\n  \n  # Map actions to their (dx, dy) effect on agent's position for calculating facing cell.\n  action_to_delta = {\n      action_map['DOWN']: (0, -1),\n      action_map['UP']: (0, 1),\n      action_map['LEFT']: (-1, 0),\n      action_map['RIGHT']: (1, 0),\n  }\n\n  # Main loop for navigating and crafting\n  for _ in range(max_craft_attempts):\n      current_state = env._current_state \n      agent_x, agent_y = current_state.pos\n      agent_dir = current_state.dir\n      \n      # 2.b. Check for Goal: If item is already crafted, the task is complete.\n      if current_state.inventory[item_idx] > 0:\n          return total_reward\n\n      # Calculate the coordinates of the cell the agent is currently facing\n      dx_facing, dy_facing = action_to_delta[agent_dir]\n      facing_x, facing_y = agent_x + dx_facing, agent_y + dy_facing\n      \n      # Check if the cell the agent is facing is the workshop\n      is_facing_workshop_and_adjacent = False\n      if (facing_x, facing_y) == workshop_pos:\n          is_facing_workshop_and_adjacent = True\n\n      if is_facing_workshop_and_adjacent:\n          # Agent is correctly positioned and facing the workshop. Attempt to USE.\n          reward, done, obs = env.step(action_map['USE'])\n          total_reward += reward\n          \n          if obs['features_dict']['inventory'][item_idx] > 0:\n              # If crafting was successful (item is now in inventory), return.\n              return total_reward \n          \n          # If USE failed (e.g., missing ingredients), we cannot craft this item.\n          # The DSL function CRAFT_FUNC doesn't handle ingredient collection. Break.\n          break \n      \n      # If not in the ideal position/direction, plan next move or rotation.\n      \n      # Determine if the agent is currently cardinally adjacent to the workshop.\n      # This is required for the USE action to succeed on the workshop.\n      required_dir_to_face_workshop = -1\n      adj_dx = workshop_pos[0] - agent_x\n      adj_dy = workshop_pos[1] - agent_y\n\n      # Agent is cardinally adjacent if Manhattan distance to workshop is 1.\n      if abs(adj_dx) + abs(adj_dy) == 1:\n          # Find the action (direction) that points from agent's current position to the workshop.\n          for action, (dx, dy) in action_to_delta.items():\n              if dx == adj_dx and dy == adj_dy:\n                  required_dir_to_face_workshop = action\n                  break\n      \n      # If agent is adjacent to the workshop but facing a different direction\n      if required_dir_to_face_workshop != -1 and agent_dir != required_dir_to_face_workshop:\n          # Perform a \"rotation\" move. The agent will attempt to move into the workshop,\n          # but since the cell is occupied, it will stay put, only changing its direction.\n          reward, done, obs = env.step(required_dir_to_face_workshop)\n          total_reward += reward\n          if done: return total_reward\n          continue # Re-evaluate state in the next loop iteration (agent is now facing correctly).\n      \n      # If not adjacent or already facing (meaning not yet adjacent to the workshop),\n      # pathfind to an empty cell adjacent to the workshop.\n\n      # Identify all empty cells that are cardinally adjacent to the workshop.\n      potential_target_cells = []\n      ws_x, ws_y = workshop_pos\n      for dx_adj, dy_adj in [(0, 1), (0, -1), (1, 0), (-1, 0)]: # UP, DOWN, RIGHT, LEFT relative to workshop\n          adj_x, adj_y = ws_x + dx_adj, ws_y + dy_adj\n          # Check bounds and ensure the cell is empty (not occupied by any item).\n          if 0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT and not current_grid[adj_x, adj_y, :].any():\n              potential_target_cells.append((adj_x, adj_y))\n\n      best_move_action = -1\n      # Initialize with a very large distance to find the minimum.\n      min_dist_to_target = float('inf')\n\n      # Find the best movement action (UP/DOWN/LEFT/RIGHT) to get closer to any of the\n      # `potential_target_cells`.\n      for action_name, (dx, dy) in action_to_delta.items():\n          n_x, n_y = agent_x + dx, agent_y + dy\n\n          # Check if the proposed next position (n_x, n_y) is valid to move into (empty and in bounds).\n          if 0 <= n_x < WIDTH and 0 <= n_y < HEIGHT and not current_grid[n_x, n_y, :].any():\n              # Calculate Manhattan distance from this potential next position to the closest target cell.\n              dist_from_next_pos_to_targets = float('inf')\n              for pt_x, pt_y in potential_target_cells:\n                  dist_from_next_pos_to_targets = min(dist_from_next_pos_to_targets, abs(n_x - pt_x) + abs(n_y - pt_y))\n              \n              # If this move leads to a position closer to an empty adjacent cell of the workshop\n              if dist_from_next_pos_to_targets < min_dist_to_target:\n                  min_dist_to_target = dist_from_next_pos_to_targets\n                  best_move_action = action_name\n      \n      # If a beneficial movement action was found, execute it.\n      if best_move_action != -1:\n          reward, done, obs = env.step(best_move_action)\n          total_reward += reward\n          if done: return total_reward\n      else:\n          # If no move was possible (agent is stuck, or all adjacent cells are blocked/occupied,\n          # and rotation was not needed or possible), then the agent cannot proceed. Break the loop.\n          break\n\n  return total_reward", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:57:21.025005", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Constants from the Craft environment logic\n  WIDTH = 12\n  HEIGHT = 12\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Helper for directions to check adjacent cells and face them\n  # (dx, dy, action_name_to_face_that_direction)\n  # (dx, dy) represents the relative position of the object from the agent's current position (x, y).\n  # If object is at (x, y-1), it's DOWN from agent, so agent faces DOWN.\n  relative_directions_to_face = [\n      (0, -1, 'DOWN'),  # Object at (x, y-1) requires agent to face DOWN\n      (0, 1, 'UP'),     # Object at (x, y+1) requires agent to face UP\n      (-1, 0, 'LEFT'),  # Object at (x-1, y) requires agent to face LEFT\n      (1, 0, 'RIGHT')   # Object at (x+1, y) requires agent to face RIGHT\n  ]\n\n  cookbook = env.world.cookbook\n  \n  # 1. Get the target item's index and its recipe\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # Item name not found in the cookbook index\n    return total_reward \n\n  if recipe is None:\n    # No recipe for this item (e.g., it's a primitive or invalid craft goal)\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # Recipe doesn't specify a workshop, so it's not crafted via workshop mechanics\n    return total_reward\n  \n  try:\n    workshop_idx = cookbook.index[workshop_name]\n  except KeyError:\n    # Workshop name from recipe not found in index, indicates an invalid recipe setup.\n    return total_reward\n\n  # Filter out special keys like '_at', '_yield' from ingredients\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients\n  for ingredient_idx, needed_count in ingredients.items():\n    # Loop until enough of this ingredient is in the inventory\n    while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n      current_state = env._current_state # Get current state after any previous steps\n      \n      collected_in_this_step = False\n      \n      # Try to collect if the ingredient is adjacent\n      for dx, dy, action_to_face_name in relative_directions_to_face:\n          nx, ny = current_state.pos[0] + dx, current_state.pos[1] + dy\n          \n          # Check grid bounds for the neighbor cell\n          if not (0 <= nx < WIDTH and not (dx == 0 and dy == 0) and 0 <= ny < HEIGHT):\n              continue\n\n          # Check if the ingredient is at the neighbor cell and is grabbable\n          # Check if the cell contains exactly the ingredient (argmax == ingredient_idx)\n          # and if it's grabbable (not environment, not workshop, etc.)\n          if current_state.grid[nx, ny, ingredient_idx] == 1 and \\\n             ingredient_idx in env.world.grabbable_indices:\n\n              # If not facing the required direction, turn.\n              action_to_face = action_map[action_to_face_name]\n              if current_state.dir != action_to_face:\n                  reward, done, _ = env.step(action_to_face)\n                  total_reward += reward\n                  if done: return total_reward # Environment ended prematurely\n                  current_state = env._current_state # Update state after turning\n              \n              # Now, agent should be facing the item. Try to USE.\n              reward, done, _ = env.step(ACTION_USE)\n              total_reward += reward\n              if done: return total_reward # Environment ended prematurely\n              collected_in_this_step = True\n              break # Break from dx, dy loop, as one ingredient is collected\n      \n      if collected_in_this_step:\n          # Successfully collected one ingredient, re-evaluate the 'while' condition for this ingredient.\n          continue\n\n      # If not collected yet (either not adjacent or USE failed),\n      # try simple exploration by moving around to find it.\n      moved_to_find_item = False\n      # Simple ordered exploration strategy for movement\n      exploration_actions = [ACTION_RIGHT, ACTION_UP, ACTION_LEFT, ACTION_DOWN] \n      \n      # Try one step of exploration (moving one step in a cardinal direction)\n      for action_to_move in exploration_actions:\n          # Check if moving in this direction would lead to a boundary or occupied cell\n          current_x, current_y = current_state.pos\n          target_x, target_y = current_x, current_y\n          if action_to_move == ACTION_RIGHT: target_x += 1\n          elif action_to_move == ACTION_LEFT: target_x -= 1\n          elif action_to_move == ACTION_UP: target_y += 1\n          elif action_to_move == ACTION_DOWN: target_y -= 1\n          \n          # Only move if the target cell is within bounds and not occupied by a static object\n          # (Agent can move into empty cells or cells with grabbable items which will be picked up)\n          # Simplified: the environment's step function handles collisions. Just attempt the move.\n          reward, done, _ = env.step(action_to_move)\n          total_reward += reward\n          if done: return total_reward # Environment ended prematurely\n          current_state = env._current_state # Update state after moving\n\n          # After moving, immediately re-check for adjacency and collection.\n          for dx, dy, action_to_face_name in relative_directions_to_face:\n              nx, ny = current_state.pos[0] + dx, current_state.pos[1] + dy\n              if not (0 <= nx < WIDTH and not (dx == 0 and dy == 0) and 0 <= ny < HEIGHT):\n                  continue\n              if current_state.grid[nx, ny, ingredient_idx] == 1 and \\\n                 ingredient_idx in env.world.grabbable_indices:\n                  # Found it after moving! Now turn and pick up.\n                  action_to_face = action_map[action_to_face_name]\n                  if current_state.dir != action_to_face:\n                      reward, done, _ = env.step(action_to_face)\n                      total_reward += reward\n                      if done: return total_reward\n                      current_state = env._current_state # Update state after turning\n                  \n                  reward, done, _ = env.step(ACTION_USE)\n                  total_reward += reward\n                  if done: return total_reward\n                  moved_to_find_item = True\n                  break # Break from dx, dy loop\n          if moved_to_find_item:\n              break # Break from exploration_actions loop, one item collected.\n      \n      # If still not collected after a round of exploration, the outer while loop continues.\n      # It will eventually terminate due to max_steps if the item is truly unreachable or agent gets stuck.\n      if not moved_to_find_item and not collected_in_this_step:\n          # This indicates the agent might be stuck or the item is unreachable with current simple strategy.\n          # To prevent infinite loops in cases where an item is truly unreachable,\n          # we can add a counter or a more sophisticated pathfinding.\n          # For this problem, relying on max_steps for termination is generally acceptable.\n          pass \n\n  # 3. Move to the workshop\n  # Find the exact coordinates of the workshop on the grid.\n  workshop_coords = None\n  grid_data = env._current_state.grid\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if grid_data[x_grid, y_grid, workshop_idx] == 1:\n              workshop_coords = (x_grid, y_grid)\n              break\n      if workshop_coords:\n          break\n\n  if workshop_coords is None:\n      # Workshop not found in the environment. This indicates an issue with the scenario setup.\n      return total_reward\n\n  # Navigate until adjacent to the workshop\n  while not env._current_state.next_to(workshop_idx):\n      current_pos = env._current_state.pos\n      \n      # Greedy movement: try to reduce Manhattan distance to the workshop.\n      dx, dy = 0, 0\n      \n      # Prioritize horizontal movement\n      if current_pos[0] < workshop_coords[0]:\n          dx = 1 # Move right\n      elif current_pos[0] > workshop_coords[0]:\n          dx = -1 # Move left\n      \n      # If horizontal is aligned or blocked, try vertical\n      if dx == 0 or (dx != 0 and (current_pos[0] + dx == workshop_coords[0] and current_pos[1] != workshop_coords[1])):\n          if current_pos[1] < workshop_coords[1]:\n              dy = 1 # Move up\n          elif current_pos[1] > workshop_coords[1]:\n              dy = -1 # Move down\n\n      action_to_move = None\n      if dx == 1: action_to_move = ACTION_RIGHT\n      elif dx == -1: action_to_move = ACTION_LEFT\n      elif dy == 1: action_to_move = ACTION_UP\n      elif dy == -1: action_to_move = ACTION_DOWN\n      \n      # If no movement action determined, it means agent is at the same X/Y as workshop\n      # but not adjacent, likely blocked or already on top of it (which shouldn't happen for workshop).\n      # Try an alternative move if straight path is blocked\n      if action_to_move is None or (current_pos[0] + dx, current_pos[1] + dy) == current_pos:\n          # Simple fallback if direct path is blocked: try a different direction\n          # This is a very basic attempt to unblock, could be improved with A*\n          # Try moving perpendicular for one step\n          if dx == 0 and dy == 0: # Agent is at the same spot as workshop (error case)\n              return total_reward\n          \n          # If horizontal blocked or aligned, try moving perpendicular to unblock for Y\n          if dx == 0 and current_pos[1] != workshop_coords[1]: # Trying to move Y, but maybe blocked\n              # Try moving left/right if not at target X\n              if current_pos[0] > 0 and current_pos[0] != workshop_coords[0]:\n                  action_to_move = ACTION_LEFT\n              elif current_pos[0] < WIDTH - 1 and current_pos[0] != workshop_coords[0]:\n                  action_to_move = ACTION_RIGHT\n              else: # Fallback: if at boundary or same X, try other Y\n                  if current_pos[1] > 0: action_to_move = ACTION_DOWN\n                  elif current_pos[1] < HEIGHT - 1: action_to_move = ACTION_UP\n          \n          # If vertical blocked or aligned, try moving perpendicular to unblock for X\n          elif dy == 0 and current_pos[0] != workshop_coords[0]: # Trying to move X, but maybe blocked\n              if current_pos[1] > 0 and current_pos[1] != workshop_coords[1]:\n                  action_to_move = ACTION_DOWN\n              elif current_pos[1] < HEIGHT - 1 and current_pos[1] != workshop_coords[1]:\n                  action_to_move = ACTION_UP\n              else: # Fallback: if at boundary or same Y, try other X\n                  if current_pos[0] > 0: action_to_move = ACTION_LEFT\n                  elif current_pos[0] < WIDTH - 1: action_to_move = ACTION_RIGHT\n\n          # If still no action_to_move, means it's fully blocked or at workshop, break.\n          if action_to_move is None:\n              break # Cannot move, potentially stuck or already there\n      \n      if action_to_move is not None:\n          reward, done, _ = env.step(action_to_move)\n          total_reward += reward\n          if done: return total_reward # Environment ended prematurely\n      else:\n          # If no action could be taken, break to prevent infinite loop\n          break \n\n  # 4. Craft the item at the workshop\n  current_state = env._current_state\n  \n  # Orient towards the workshop (which the agent should now be adjacent to)\n  target_adjacent_dir_action = None\n  x, y = current_state.pos\n  grid = current_state.grid\n  \n  # Find which neighbor cell contains the workshop\n  for dx, dy, action_name in relative_directions_to_face:\n      nx, ny = x + dx, y + dy\n      if not (0 <= nx < WIDTH and not (dx == 0 and dy == 0) and 0 <= ny < HEIGHT):\n          continue\n      if grid[nx, ny, workshop_idx] == 1: # Found workshop at (nx, ny)\n          target_adjacent_dir_action = action_name\n          break\n  \n  if target_adjacent_dir_action is not None:\n      # Turn to face the workshop if not already\n      if current_state.dir != action_map[target_adjacent_dir_action]:\n          reward, done, _ = env.step(action_map[target_adjacent_dir_action])\n          total_reward += reward\n          if done: return total_reward\n          current_state = env._current_state # Update state after turning\n      \n      # Now USE to craft the item\n      reward, done, _ = env.step(ACTION_USE)\n      total_reward += reward\n      if done: return total_reward\n  \n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:57:22.061317", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Constants from the Craft environment logic\n  WIDTH = 12\n  HEIGHT = 12\n\n  # Action mappings\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Helper for directions to check adjacent cells and face them\n  # (dx, dy, action_name_to_face_that_direction)\n  # (dx, dy) represents the relative position of the object from the agent's current position (x, y).\n  # If object is at (x, y-1), it's DOWN from agent, so agent faces DOWN.\n  relative_directions_to_face = [\n      (0, -1, 'DOWN'),  # Object at (x, y-1) requires agent to face DOWN\n      (0, 1, 'UP'),     # Object at (x, y+1) requires agent to face UP\n      (-1, 0, 'LEFT'),  # Object at (x-1, y) requires agent to face LEFT\n      (1, 0, 'RIGHT')   # Object at (x+1, y) requires agent to face RIGHT\n  ]\n\n  cookbook = env.world.cookbook\n  \n  # 1. Get the target item's index and its recipe\n  try:\n    goal_idx = cookbook.index[item]\n  except KeyError:\n    # Item name not recognized by the cookbook.\n    return total_reward \n\n  recipe = cookbook.recipes.get(goal_idx)\n  if recipe is None:\n    # Item is a primitive or uncraftable via recipe (e.g., environment item or just not craftable).\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # Recipe does not specify a workshop. Not craftable through this mechanism.\n    return total_reward\n  \n  try:\n    workshop_idx = cookbook.index[workshop_name]\n  except KeyError:\n    # Workshop name from recipe not found in index, indicates an invalid recipe setup.\n    return total_reward\n\n  # Filter out special keys like '_at', '_yield' from ingredients\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients\n  for ingredient_idx, needed_count in ingredients.items():\n    # Loop until enough of this ingredient is in the inventory\n    while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n      current_state = env._current_state # Get current state after any previous steps\n      \n      # Find the closest instance of the ingredient on the grid\n      target_ing_coords = None\n      min_dist = float('inf')\n      agent_x, agent_y = current_state.pos\n\n      for x_grid in range(WIDTH):\n          for y_grid in range(HEIGHT):\n              if current_state.grid[x_grid, y_grid, ingredient_idx] == 1:\n                  dist = abs(x_grid - agent_x) + abs(y_grid - agent_y)\n                  if dist < min_dist:\n                      min_dist = dist\n                      target_ing_coords = (x_grid, y_grid)\n      \n      if target_ing_coords is None:\n          # Ingredient not found on the grid. Cannot collect.\n          # In this simplified v0, we return if a required ingredient is unreachable.\n          return total_reward \n          \n      # Move towards the ingredient until adjacent\n      # The loop continues until the ingredient is adjacent or agent is stuck\n      while not current_state.next_to(ingredient_idx):\n          agent_x, agent_y = current_state.pos\n          target_x, target_y = target_ing_coords\n\n          dx, dy = 0, 0\n          \n          # Prioritize horizontal movement\n          if agent_x < target_x:\n              dx = 1 # Move right\n          elif agent_x > target_x:\n              dx = -1 # Move left\n          \n          # If horizontal is aligned, try vertical\n          if dx == 0: # Only change Y if X is aligned OR X movement is blocked\n              if agent_y < target_y:\n                  dy = 1 # Move up\n              elif agent_y > target_y:\n                  dy = -1 # Move down\n\n          action_to_move = None\n          if dx == 1: action_to_move = ACTION_RIGHT\n          elif dx == -1: action_to_move = ACTION_LEFT\n          elif dy == 1: action_to_move = ACTION_UP\n          elif dy == -1: action_to_move = ACTION_DOWN\n          \n          if action_to_move is not None:\n              prev_pos = current_state.pos # Store to check if movement occurred\n              reward, done, _ = env.step(action_to_move)\n              total_reward += reward\n              if done: return total_reward # Environment ended prematurely\n              current_state = env._current_state # Update state after moving\n              \n              if current_state.pos == prev_pos and (dx != 0 or dy != 0):\n                  # Agent tried to move but didn't (path blocked). Break movement loop.\n                  # This means it's stuck trying to reach this particular item.\n                  # The outer while loop will then re-evaluate the inventory need.\n                  break \n          else:\n              # No movement action identified (e.g., agent is already at target_ing_coords,\n              # but next_to is false, implying target is within the same cell or no clear path)\n              break\n      \n      # Now that agent should be adjacent or stuck, try to USE\n      if current_state.next_to(ingredient_idx):\n          # Find which neighbor cell contains the ingredient and face it\n          target_adjacent_dir_action = None\n          x, y = current_state.pos\n          grid = current_state.grid\n          \n          for dx, dy, action_name in relative_directions_to_face:\n              nx, ny = x + dx, y + dy\n              if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n                  continue\n              if grid[nx, ny, ingredient_idx] == 1: # Found ingredient at (nx, ny)\n                  target_adjacent_dir_action = action_name\n                  break\n          \n          if target_adjacent_dir_action is not None:\n              # Turn to face the ingredient if not already\n              if current_state.dir != action_map[target_adjacent_dir_action]:\n                  reward, done, _ = env.step(action_map[target_adjacent_dir_action])\n                  total_reward += reward\n                  if done: return total_reward\n                  current_state = env._current_state # Update state after turning\n              \n              # Now USE to collect the item\n              reward, done, _ = env.step(ACTION_USE)\n              total_reward += reward\n              if done: return total_reward\n          # If target_adjacent_dir_action is None, it implies next_to was true but no specific\n          # neighbor had the item, which indicates an unexpected state. The loop will re-evaluate.\n      \n      # If after attempting to move and USE, the inventory is still not met,\n      # the while loop will continue. If no progress, this might loop until max_steps.\n\n  # 3. Move to the workshop\n  # Find the exact coordinates of the workshop on the grid.\n  workshop_coords = None\n  grid_data = env._current_state.grid\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if grid_data[x_grid, y_grid, workshop_idx] == 1:\n              workshop_coords = (x_grid, y_grid)\n              break\n      if workshop_coords:\n          break\n\n  if workshop_coords is None:\n      # Workshop not found in the environment. This indicates an issue with the scenario setup.\n      return total_reward\n\n  # Navigate until adjacent to the workshop\n  # Using the same greedy movement logic as for ingredients\n  while not env._current_state.next_to(workshop_idx):\n      current_state = env._current_state\n      agent_x, agent_y = current_state.pos\n      \n      dx, dy = 0, 0\n      \n      # Prioritize horizontal movement\n      if agent_x < workshop_coords[0]:\n          dx = 1 # Move right\n      elif agent_x > workshop_coords[0]:\n          dx = -1 # Move left\n      \n      # If horizontal is aligned, try vertical\n      if dx == 0:\n          if agent_y < workshop_coords[1]:\n              dy = 1 # Move up\n          elif agent_y > workshop_coords[1]:\n              dy = -1 # Move down\n\n      action_to_move = None\n      if dx == 1: action_to_move = ACTION_RIGHT\n      elif dx == -1: action_to_move = ACTION_LEFT\n      elif dy == 1: action_to_move = ACTION_UP\n      elif dy == -1: action_to_move = ACTION_DOWN\n      \n      if action_to_move is not None:\n          prev_pos = current_state.pos\n          reward, done, _ = env.step(action_to_move)\n          total_reward += reward\n          if done: return total_reward # Environment ended prematurely\n          current_state = env._current_state # Update state after moving\n          \n          if current_state.pos == prev_pos and (dx != 0 or dy != 0):\n              # Agent tried to move but didn't (path blocked). Break movement loop.\n              # It's stuck trying to reach the workshop.\n              break \n      else:\n          # No movement action identified (already at target coords, but not adjacent)\n          break \n\n  # 4. Craft the item at the workshop\n  current_state = env._current_state\n  \n  # Orient towards the workshop (which the agent should now be adjacent to)\n  target_adjacent_dir_action = None\n  x, y = current_state.pos\n  grid = current_state.grid\n  \n  # Find which neighbor cell contains the workshop\n  for dx, dy, action_name in relative_directions_to_face:\n      nx, ny = x + dx, y + dy\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n          continue\n      if grid[nx, ny, workshop_idx] == 1: # Found workshop at (nx, ny)\n          target_adjacent_dir_action = action_name\n          break\n  \n  if target_adjacent_dir_action is not None:\n      # Turn to face the workshop if not already\n      if current_state.dir != action_map[target_adjacent_dir_action]:\n          reward, done, _ = env.step(action_map[target_adjacent_dir_action])\n          total_reward += reward\n          if done: return total_reward\n          current_state = env._current_state # Update state after turning\n      \n      # Now USE to craft the item\n      reward, done, _ = env.step(ACTION_USE)\n      total_reward += reward\n      if done: return total_reward\n  \n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T09:15:48.587341", "function_name": "craft", "function_body": "    def _move_to_adjacent_and_face(env, target_kind_idx, target_item_pos):\n        \"\"\"\n        Helper function: Moves the agent until it is adjacent to an item of `target_kind_idx`\n        at `target_item_pos`, and then ensures the agent is facing that item.\n        Returns the total reward collected during movement and turning.\n        \"\"\"\n        total_movement_reward = 0.0\n\n        # Phase 1: Move until adjacent to the target_kind_idx\n        # The `next_to` check (CraftState.next_to) considers adjacency regardless of agent's current direction.\n        # If the agent is already adjacent, this loop will be skipped.\n        \n        # Add a safety counter to prevent infinite loops if agent gets stuck.\n        stuck_counter = 0\n        last_pos = env._current_state.pos\n        MAX_STUCK_ATTEMPTS = 50 # A reasonable limit for grid size 12x12 environments\n\n        while not env._current_state.next_to(target_kind_idx):\n            current_x, current_y = env._current_state.pos\n            target_x, target_y = target_item_pos\n\n            action_to_take = -1\n            \n            # Determine the primary direction of movement based on distance to target\n            dx = target_x - current_x\n            dy = target_y - current_y\n\n            # Prioritize movement along the dimension with the larger difference\n            if abs(dx) > abs(dy):\n                if dx > 0:\n                    action_to_take = RIGHT\n                elif dx < 0:\n                    action_to_take = LEFT\n            else: # abs(dy) >= abs(dx) or dx == 0\n                if dy > 0: # Y increases UP (UP action moves to y+1)\n                    action_to_take = UP\n                elif dy < 0: # Y decreases DOWN (DOWN action moves to y-1)\n                    action_to_take = DOWN\n            \n            # If no action can be determined (e.g., already at target pos, or path completely blocked),\n            # or agent is stuck, break the loop.\n            if action_to_take != -1:\n                reward, _, _ = env.step(action_to_take)\n                total_movement_reward += reward\n                \n                # Check if agent is stuck (position hasn't changed)\n                if env._current_state.pos == last_pos:\n                    stuck_counter += 1\n                else:\n                    stuck_counter = 0\n                last_pos = env._current_state.pos\n\n                if stuck_counter > MAX_STUCK_ATTEMPTS:\n                    # Agent is stuck and cannot reach target. Abort movement.\n                    break\n            else:\n                # This case implies the agent is exactly at the target_item_pos,\n                # or there's no direct cardinal path, suggesting a more complex environment layout.\n                # Since CraftState.step prevents moving onto items, being at target_item_pos\n                # is not typical for an item on the grid. Break to prevent infinite loop.\n                break\n\n        # Phase 2: Ensure agent faces the target item/workshop\n        # At this point, the agent is adjacent to the target (or was stuck trying to get there).\n        current_x, current_y = env._current_state.pos\n        target_x, target_y = target_item_pos\n\n        # Determine desired direction to face the item/workshop based on its relative position.\n        desired_dir = env._current_state.dir # Default to current if no clear direction\n\n        if target_x < current_x:\n            desired_dir = LEFT\n        elif target_x > current_x:\n            desired_dir = RIGHT\n        elif target_y > current_y: # Target is \"above\" the agent on the map\n            desired_dir = UP\n        elif target_y < current_y: # Target is \"below\" the agent on the map\n            desired_dir = DOWN\n        \n        # Loop until agent's direction matches the desired direction.\n        # Calling `env.step(action)` always updates `env._current_state.dir`,\n        # even if the movement itself is blocked (e.g., trying to move into an obstacle).\n        while env._current_state.dir != desired_dir:\n            reward, _, _ = env.step(desired_dir)\n            total_movement_reward += reward\n\n        return total_movement_reward\n\n    # --- Main CRAFT_V2 function logic ---\n    total_reward = 0.0\n    cookbook = env.world.cookbook\n    \n    # Get the integer index of the item to craft from the cookbook's index.\n    item_idx = cookbook.index[item]\n\n    # --- Step 1: Gather all necessary primitive ingredients ---\n    # `cookbook.primitives_for(goal_item_idx)` provides a flattened dictionary\n    # of all primitive ingredients (and their counts) required for the `item_idx`,\n    # recursively resolving all sub-recipes.\n    required_primitives = cookbook.primitives_for(item_idx)\n\n    # Iterate through each required primitive and ensure the agent has enough.\n    for primitive_idx, needed_count in required_primitives.items():\n        current_inv_count = env._current_state.inventory[primitive_idx]\n        to_collect = needed_count - current_inv_count\n\n        if to_collect > 0:\n            # Collect each required primitive one by one\n            for _ in range(to_collect):\n                # Find the current location of an available primitive on the grid.\n                # After an item is picked up (USE action), it is removed from the grid.\n                # So, we must search the grid again for each instance we need to collect.\n                primitive_pos = None\n                grid = env._current_state.grid\n                world_width, world_height, _ = grid.shape\n                for x in range(world_width):\n                    for y in range(world_height):\n                        if grid[x, y, primitive_idx] == 1:\n                            primitive_pos = (x, y)\n                            break\n                    if primitive_pos:\n                        break # Found an instance, break outer loop\n\n                if primitive_pos is None:\n                    # If a required primitive is not found on the map, it implies\n                    # the scenario does not provide enough resources to craft.\n                    # In this case, we cannot complete the task, so return current reward.\n                    return total_reward \n\n                # Move the agent to be adjacent to the primitive and face it,\n                # accumulating rewards from movement.\n                total_reward += _move_to_adjacent_and_face(env, primitive_idx, primitive_pos)\n                \n                # Perform the USE action to pick up the primitive.\n                # This will update inventory and remove the item from the grid.\n                reward, _, _ = env.step(USE)\n                total_reward += reward\n\n    # --- Step 2: Move to the correct workshop and craft the item ---\n    \n    # Get the recipe for the specific item to be crafted to identify the required workshop.\n    # The DSL's `item` definitions ensure `item_idx` will always have a recipe.\n    item_recipe = cookbook.recipes[item_idx]\n    workshop_name = item_recipe[\"_at\"] # E.g., \"workshop1\"\n    workshop_idx = cookbook.index[workshop_name] # Convert workshop name to its integer index\n\n    # Find the location of the workshop on the grid.\n    workshop_pos = None\n    grid = env._current_state.grid\n    world_width, world_height, _ = grid.shape\n    for x in range(world_width):\n        for y in range(world_height):\n            if grid[x, y, workshop_idx] == 1:\n                workshop_pos = (x, y)\n                break\n        if workshop_pos:\n            break\n\n    if workshop_pos is None:\n        # If the required workshop is not found on the map, we cannot craft.\n        return total_reward # Abort if workshop not available\n\n    # Move the agent to be adjacent to the workshop and face it,\n    # accumulating rewards from movement.\n    total_reward += _move_to_adjacent_and_face(env, workshop_idx, workshop_pos)\n\n    # Perform the USE action at the workshop to craft the item.\n    # This consumes the collected ingredients from inventory and adds the crafted item.\n    reward, _, _ = env.step(USE)\n    total_reward += reward\n\n    return total_reward", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-24T09:15:48.606076", "function_name": "craft", "function_body": "    import collections\n\n    # Accessing global constants for grid dimensions (defined in craft_env.py)\n    # These are assumed to be accessible in the execution environment.\n    WIDTH, HEIGHT, _ = env._current_state.grid.shape\n\n    total_reward = 0.0\n    cookbook = env.world.cookbook\n\n    # Helper function to find a path to a target_kind_idx and interact with it.\n    # This function uses Breadth-First Search (BFS) for navigation.\n    def _find_path_and_interact(target_kind_idx):\n        nonlocal total_reward # Allows modifying the outer total_reward variable\n\n        current_grid = env._current_state.grid\n        initial_agent_pos = env._current_state.pos\n        initial_agent_dir = env._current_state.dir\n\n        # BFS state: ((current_x, current_y), current_direction, path_actions_list)\n        queue = collections.deque([((initial_agent_pos[0], initial_agent_pos[1]), initial_agent_dir, [])])\n        # Visited set to avoid cycles and redundant paths: ((x, y), direction)\n        visited = set([(initial_agent_pos, initial_agent_dir)]) \n\n        best_path_actions = None\n        \n        # Action constants (from CraftLab's action_specs, assumed globally accessible)\n        DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n        # Mapping of movement actions to coordinate deltas\n        action_deltas = {\n            DOWN: (0, -1),\n            UP: (0, 1),\n            LEFT: (-1, 0),\n            RIGHT: (1, 0)\n        }\n\n        # BFS loop\n        while queue:\n            (curr_x, curr_y), curr_dir, path = queue.popleft()\n\n            # Check if the current state allows interaction with the target_kind_idx\n            # The `neighbors` function is a global utility from the environment.\n            can_interact = False\n            for nx, ny in neighbors((curr_x, curr_y), curr_dir):\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and current_grid[nx, ny, target_kind_idx] == 1:\n                    can_interact = True\n                    break\n            \n            if can_interact:\n                best_path_actions = path\n                break # Path to interactable state found\n\n            # Explore possible next states (moves and turns)\n            \n            # 1. Try moving to an adjacent empty cell\n            for action_move, (dx, dy) in action_deltas.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n                \n                if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT): \n                    continue # Out of bounds\n\n                # In CraftWorld, an agent cannot move into a cell that contains ANY item.\n                # It must interact (USE) with items from an adjacent empty cell.\n                if current_grid[next_x, next_y, :].any(): \n                    continue # Cell is occupied, cannot move into it\n\n                next_state_pos = (next_x, next_y)\n                next_state_dir = action_move # Agent faces the direction it just moved\n                \n                if (next_state_pos, next_state_dir) not in visited:\n                    visited.add((next_state_pos, next_state_dir))\n                    queue.append((next_state_pos, next_state_dir, path + [action_move]))\n            \n            # 2. Try turning in place\n            for action_turn in [DOWN, UP, LEFT, RIGHT]:\n                if action_turn != curr_dir: # Only add if it's a different direction\n                    next_state_pos = (curr_x, curr_y) # Position remains unchanged\n                    next_state_dir = action_turn\n                    if (next_state_pos, next_state_dir) not in visited:\n                        visited.add((next_state_pos, next_state_dir))\n                        queue.append((next_state_pos, next_state_dir, path + [action_turn]))\n\n        if best_path_actions is None:\n            # Failed to find a path to interact with the target.\n            # This indicates the target might be unreachable or not present.\n            return \n\n        # Execute the actions found by BFS in the actual environment\n        for action in best_path_actions:\n            reward, done, obs = env.step(action)\n            total_reward += reward\n            if done: \n                return # If task is done, exit early\n\n        # Agent should now be in the correct position and facing the target.\n        # Perform the USE action to interact with the target.\n        reward, done, obs = env.step(USE)\n        total_reward += reward\n        if done: \n            return # If task is done, exit early\n\n\n    # Main logic for craft_v2 function begins here\n    item_idx = cookbook.index[item]\n\n    # Check if the requested item is actually craftable (i.e., has a recipe)\n    if item_idx not in cookbook.recipes:\n        # If the item cannot be crafted (e.g., it's a primitive or invalid),\n        # return the current accumulated reward without performing any craft steps.\n        return total_reward\n\n    recipe = cookbook.recipes[item_idx]\n\n    # First, ensure all necessary ingredients are in the inventory.\n    for ingredient_idx, count in recipe.items():\n        # Iterate over ingredients (excluding special recipe keys like '_at', '_yield')\n        if isinstance(ingredient_idx, int): \n            needed_count = count\n            current_inv_count = env._current_state.inventory[ingredient_idx]\n            to_acquire = max(0, needed_count - current_inv_count)\n\n            if to_acquire > 0:\n                # If the ingredient is a primitive (raw material), collect it from the world.\n                if ingredient_idx in cookbook.primitives:\n                    for _ in range(to_acquire):\n                        _find_path_and_interact(ingredient_idx)\n                        if env._is_done(): \n                            return total_reward # Exit if task goal is met\n\n                # If the ingredient is another craftable item, recursively call craft_v2 for it.\n                elif ingredient_idx in cookbook.recipes:\n                    for _ in range(to_acquire):\n                        total_reward += craft_v2(env, cookbook.index.get(ingredient_idx))\n                        if env._is_done(): \n                            return total_reward # Exit if task goal is met\n                # No 'else' needed as all recognized items are either primitive or craftable.\n\n    # After all ingredients are (theoretically) in the inventory, proceed to craft the main item.\n    # This usually requires being at a specific crafting station.\n    if \"_at\" in recipe:\n        workshop_name = recipe[\"_at\"]\n        workshop_idx = cookbook.index[workshop_name]\n        _find_path_and_interact(workshop_idx) # Navigate to and use the workshop\n        if env._is_done(): \n            return total_reward # Final check after the main crafting action\n    else:\n        # If a recipe does not specify an \"_at\" location, it implies crafting\n        # can happen anywhere using only inventory. However, the `CraftState.step`\n        # implementation of the `USE` action requires interaction with a grid cell.\n        # Without an explicit target cell, the `USE` action will not trigger a craft.\n        # Therefore, we assume all valid crafting actions require an \"_at\" station in this environment.\n        pass # No action performed if no _at is specified and environment doesn't support implicit crafting.\n\n    return total_reward", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-24T09:21:38.069908", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Constants from the environment (assuming they are globally available or defined elsewhere)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  cookbook = env.world.cookbook\n  item_id = cookbook.index[item]\n\n  # 1. Check if the item is craftable (has a recipe)\n  if item_id not in cookbook.recipes:\n    # If the item is not in recipes, it's not something that can be crafted\n    # using a workshop. Return 0 reward as no crafting action can be taken.\n    return 0.0\n\n  recipe = cookbook.recipes[item_id]\n  workshop_name = recipe.get(\"_at\") # Get the name of the workshop required\n\n  if not workshop_name:\n      # If no workshop is specified in the recipe, it might not be a craftable item\n      # or requires a different mechanism not handled by CRAFT_FUNC.\n      return 0.0\n\n  workshop_id = cookbook.index[workshop_name]\n\n  # 2. Find the workshop's location (x,y) on the grid\n  workshop_pos = None\n  grid = env._current_state.grid\n  grid_width, grid_height, _ = grid.shape # Get dimensions of the grid\n\n  # Iterate through the grid to find the coordinates of the workshop\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if grid[x, y, workshop_id] == 1: # If the cell contains the workshop\n        workshop_pos = (x, y)\n        break\n    if workshop_pos: # Break outer loop if workshop found\n      break\n\n  if not workshop_pos:\n    # Workshop not found on the current grid, cannot craft.\n    return 0.0\n\n  # 3. Move to the workshop (until adjacent)\n  # The environment's 'max_steps' limits the total number of actions an agent can take.\n  # We use this as a safeguard to prevent infinite loops if the workshop is unreachable.\n  # Add 1 to max_steps to account for the final 'USE' action.\n  max_operation_steps = env.max_steps\n\n  for _ in range(max_operation_steps + 1):\n    # Check if the environment indicates the episode is 'done' (e.g., goal achieved or max steps reached).\n    # If done, stop taking actions.\n    if env._is_done():\n      break\n\n    current_state = env._current_state\n    \n    # Check if the agent is currently adjacent to the workshop\n    if current_state.next_to(workshop_id):\n      # If adjacent, attempt to craft by performing the 'USE' action.\n      reward, done, _ = env.step(USE)\n      total_reward += reward\n      # If the 'USE' action results in the episode being done, break the loop.\n      if done:\n          break\n      # Assuming one attempt to USE after reaching the workshop is sufficient for v0.\n      break \n    \n    # If not adjacent, determine the next movement action to get closer to the workshop.\n    cx, cy = current_state.pos\n    tx, ty = workshop_pos\n\n    action_to_take = -1 # Initialize with an invalid action\n\n    # Simple greedy movement strategy: prioritize horizontal movement, then vertical.\n    if cx < tx:\n      action_to_take = RIGHT\n    elif cx > tx:\n      action_to_take = LEFT\n    elif cy < ty: \n      action_to_take = UP\n    elif cy > ty:\n      action_to_take = DOWN\n    # If cx == tx and cy == ty, it implies the agent is at the workshop's exact position.\n    # Craft environments usually prevent moving onto obstacles like workshops, so this\n    # state should ideally not be reached by movement, but it acts as a fallback if the agent is stuck.\n\n    if action_to_take != -1:\n        # Take the determined action and accumulate reward.\n        reward, done, _ = env.step(action_to_take)\n        total_reward += reward\n        # If the environment becomes 'done' after this step, break.\n        if done:\n            break\n    # If action_to_take remains -1, it means the agent could not find a valid greedy\n    # move to get closer (e.g., blocked). It will just continue looping, relying on\n    # `max_operation_steps` to terminate.\n\n  return total_reward", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T09:21:38.086495", "function_name": "craft", "function_body": "    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    total_reward = 0.0\n    current_state = env._current_state\n    cookbook = current_state.world.cookbook\n\n    # 1. Get item ID from its string name\n    item_id = cookbook.index.index(item)\n\n    # 2. Check if a recipe exists for the given item\n    if item_id not in cookbook.recipes:\n        # Cannot craft this item if no recipe is defined.\n        return total_reward\n\n    recipe = cookbook.recipes[item_id]\n\n    # 3. Identify the required crafting station (workshop) for the recipe\n    if \"_at\" not in recipe:\n        # If the recipe does not specify a workshop, it's not craftable via the 'USE' action at a station.\n        return total_reward\n    \n    workshop_name = recipe[\"_at\"] # e.g., \"workshop1\"\n    workshop_id = cookbook.index.index(workshop_name)\n\n    # 4. Locate the coordinates of the workshop on the current grid\n    workshop_pos = None\n    grid = current_state.grid\n    # Iterate through the grid to find the workshop's position.\n    # grid[x, y, thing_id] where x is column index and y is row index.\n    for x in range(grid.shape[0]):\n        for y in range(grid.shape[1]):\n            if grid[x, y, workshop_id] == 1:\n                workshop_pos = (x, y)\n                break\n        if workshop_pos: # Workshop found, break outer loop\n            break\n\n    if not workshop_pos:\n        # The required workshop is not present in the current environment state.\n        return total_reward\n\n    # 5. Move the agent to a position adjacent to the workshop\n    # A heuristic maximum number of steps to prevent infinite loops during movement.\n    # This is roughly twice the grid's perimeter, ensuring enough steps to traverse.\n    max_movement_steps = 2 * (grid.shape[0] + grid.shape[1]) \n    steps_taken_for_movement = 0\n\n    while not current_state.next_to(workshop_id) and steps_taken_for_movement < max_movement_steps:\n        agent_x, agent_y = current_state.pos\n        target_x, target_y = workshop_pos\n\n        action_to_take = -1\n\n        # Determine the primary direction of movement (horizontal or vertical)\n        # based on which axis has a larger distance to cover.\n        if abs(agent_x - target_x) > abs(agent_y - target_y):\n            if agent_x < target_x:\n                action_to_take = RIGHT\n            elif agent_x > target_x:\n                action_to_take = LEFT\n        else: # If Y-distance is equal or greater than X-distance, or X-distance is zero\n            if agent_y < target_y:\n                action_to_take = UP\n            elif agent_y > target_y:\n                action_to_take = DOWN\n        \n        # If an action was determined, execute it\n        if action_to_take != -1:\n            reward, done, observations = env.step(action_to_take)\n            total_reward += reward\n            current_state = env._current_state # Update the current state after the step\n            steps_taken_for_movement += 1\n            if done:\n                # If the overall environment episode terminates (e.g., max_steps reached globally),\n                # return the accumulated reward immediately.\n                return total_reward\n        else:\n            # This case occurs if agent_x == target_x and agent_y == target_y,\n            # meaning the agent is attempting to occupy the same cell as the workshop.\n            # Since the agent cannot move onto an occupied cell, it will remain in its\n            # current position, which should be adjacent to the workshop.\n            # The `current_state.next_to(workshop_id)` check should then become true,\n            # allowing the loop to exit. If not, break to prevent an infinite loop.\n            break\n\n    # 6. Perform the 'USE' action if the agent successfully reached an adjacent position\n    if current_state.next_to(workshop_id):\n        reward, done, observations = env.step(USE)\n        total_reward += reward\n\n    return total_reward", "island_id": 9, "scores": {"3": -1}}
