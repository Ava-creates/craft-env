{"timestamp": "2025-07-24T08:09:40.548972", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # 1. Get the target item's index.\n  item_idx = env.world.cookbook.index[item]\n\n  # 2. Get the recipe for the item.\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if recipe is None:\n    # Item cannot be crafted or doesn't exist as a recipe output.\n    # This function expects 'item' to be a craftable output.\n    return total_reward\n\n  # 3. Determine the required workshop from the recipe.\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # If the recipe doesn't specify a workshop, it's likely a primitive\n    # or something acquired differently, not by crafting at a station.\n    return total_reward\n\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # 4. Find the coordinates of the required workshop in the current grid.\n  workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if len(workshop_coords) == 0:\n    # Workshop not found in the current grid, cannot craft.\n    return total_reward\n\n  # Find the closest workshop if multiple exist.\n  curr_x, curr_y = env._current_state.pos\n  min_distance = float('inf')\n  target_workshop_x, target_workshop_y = -1, -1\n\n  for wx, wy in workshop_coords:\n    # Manhattan distance as a heuristic for pathfinding in grid.\n    dist = abs(curr_x - wx) + abs(curr_y - wy)\n    if dist < min_distance:\n      min_distance = dist\n      target_workshop_x, target_workshop_y = wx, wy\n\n  # Get action mappings from the environment.\n  ACTIONS = env.action_specs()\n  ACTION_UP = ACTIONS['UP']\n  ACTION_DOWN = ACTIONS['DOWN']\n  ACTION_LEFT = ACTIONS['LEFT']\n  ACTION_RIGHT = ACTIONS['RIGHT']\n  ACTION_USE = ACTIONS['USE']\n\n  # Phase 1: Move adjacent to the target workshop.\n  # We loop, taking one step at a time, until adjacent or max steps reached.\n  # A safety limit to prevent infinite loops, though `env.step` also handles `max_steps`.\n  max_movement_steps = env.max_steps \n  steps_taken_in_phase = 0\n\n  while not env._current_state.next_to(workshop_idx) and steps_taken_in_phase < max_movement_steps:\n    curr_x, curr_y = env._current_state.pos\n    action_to_take = -1\n\n    # Determine movement action towards the workshop. Prioritize X then Y.\n    if curr_x < target_workshop_x:\n      action_to_take = ACTION_RIGHT\n    elif curr_x > target_workshop_x:\n      action_to_take = ACTION_LEFT\n    elif curr_y < target_workshop_y:\n      action_to_take = ACTION_UP\n    elif curr_y > target_workshop_y:\n      action_to_take = ACTION_DOWN\n    else:\n      # Agent is at the same (x,y) as the target workshop but not adjacent.\n      # This implies an obstruction or impossible adjacency. Break to prevent infinite loop.\n      break \n\n    if action_to_take != -1:\n      reward, done, _ = env.step(action_to_take)\n      total_reward += reward\n      steps_taken_in_phase += 1\n      if done:\n        return total_reward\n    else:\n      # Should ideally not happen if target_workshop_x/y are different from curr_x/y\n      # but agent is not next to it. Means something is blocking.\n      break\n\n  # Check if agent is now adjacent to the workshop.\n  if not env._current_state.next_to(workshop_idx):\n    # Failed to get adjacent to the workshop.\n    return total_reward\n\n  # Phase 2: Face the workshop.\n  curr_x, curr_y = env._current_state.pos\n  \n  dx = target_workshop_x - curr_x\n  dy = target_workshop_y - curr_y\n\n  target_dir_action = -1\n  # Determine the required direction action to face the workshop.\n  if dx == 1:\n    target_dir_action = ACTION_RIGHT\n  elif dx == -1:\n    target_dir_action = ACTION_LEFT\n  elif dy == 1:\n    target_dir_action = ACTION_UP\n  elif dy == -1:\n    target_dir_action = ACTION_DOWN\n  \n  # If the agent is not already facing the target direction, perform a \"move\" step\n  # in that direction. The agent's position will not change if blocked (e.g., by workshop),\n  # but its internal direction will update.\n  if target_dir_action != -1 and env._current_state.dir != target_dir_action:\n    reward, done, _ = env.step(target_dir_action)\n    total_reward += reward\n    if done:\n      return total_reward\n\n  # Phase 3: Use the workshop.\n  # Agent should now be adjacent to the workshop and facing it.\n  reward, done, _ = env.step(ACTION_USE)\n  total_reward += reward\n  \n  if done:\n    return total_reward\n\n  return total_reward", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:13:06.842964", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Helper for directions to check adjacent cells and face them.\n  # (dx, dy, action_to_face_that_direction) relative to agent's current position.\n  cardinal_directions_for_use = [\n      (0, -1, ACTION_DOWN),   # Object at (x, y-1), face DOWN\n      (0, 1, ACTION_UP),      # Object at (x, y+1), face UP\n      (-1, 0, ACTION_LEFT),   # Object at (x-1, y), face LEFT\n      (1, 0, ACTION_RIGHT)    # Object at (x+1, y), face RIGHT\n  ]\n\n  cookbook = env.world.cookbook\n  # Get grid dimensions from the current state.\n  # Assuming grid is 3D: (WIDTH, HEIGHT, N_KINDS)\n  WIDTH, HEIGHT, _ = env._current_state.grid.shape \n\n  # --- Phase 1: Identify the target item and its recipe ---\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # Item name not found in the cookbook's index.\n    return total_reward \n\n  if recipe is None:\n    # No recipe found for this item (e.g., it's a primitive or environment object).\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # If the recipe doesn't specify a workshop, we assume it's not craftable\n    # in the manner expected by this DSL (which implies using a workshop).\n    return total_reward\n  \n  try:\n    workshop_idx = cookbook.index[workshop_name]\n  except KeyError:\n    # The workshop specified in the recipe is not found in the cookbook's index.\n    return total_reward\n\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # --- Phase 2: Collect all necessary ingredients ---\n  for ingredient_idx, needed_count in ingredients.items():\n    # Keep trying to collect this ingredient until enough is in inventory.\n    # Add a safety break to prevent infinite loops if an item is uncollectible/unreachable.\n    # A simple way to prevent infinite loops is to cap the number of steps tried for collection\n    # or to detect if no progress is being made (e.g., stuck in a loop of moves).\n    # For now, relying on 'done' from env.step for max_steps.\n    \n    while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n      current_state = env._current_state\n      \n      # 2.1 Find the ingredient's location on the grid\n      ingredient_coords = None\n      for x_grid in range(WIDTH):\n          for y_grid in range(HEIGHT):\n              if current_state.grid[x_grid, y_grid, ingredient_idx] == 1:\n                  ingredient_coords = (x_grid, y_grid)\n                  break\n          if ingredient_coords: # Found it\n              break\n      \n      if ingredient_coords is None:\n          # Ingredient not found on the map. Cannot collect. Break from this ingredient.\n          # This might happen if the ingredient was consumed, or never existed, or is hidden.\n          # This means we cannot complete the craft.\n          return total_reward # Return current reward, as craft is likely impossible.\n\n      # 2.2 Check if agent is adjacent to the ingredient and can use it\n      agent_pos = current_state.pos\n      collected_in_this_attempt = False\n\n      for dx_adj, dy_adj, action_to_face in cardinal_directions_for_use:\n          nx, ny = agent_pos[0] + dx_adj, agent_pos[1] + dy_adj\n          \n          # Ensure neighbor coordinates are within grid bounds.\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          # Check if the ingredient is present at this specific adjacent cell.\n          if current_state.grid[nx, ny, ingredient_idx] == 1:\n              # Ingredient found adjacent.\n              \n              # First, orient the agent towards the ingredient.\n              if current_state.dir != action_to_face:\n                  reward, done, _ = env.step(action_to_face)\n                  total_reward += reward\n                  if done: return total_reward # Environment ended (e.g., max steps reached)\n                  current_state = env._current_state # Update state after action.\n              \n              # Now, perform the USE action to pick up the ingredient.\n              reward, done, _ = env.step(ACTION_USE)\n              total_reward += reward\n              if done: return total_reward # Environment ended\n              \n              collected_in_this_attempt = True\n              break # Break from cardinal_directions_for_use loop as we've attempted collection.\n      \n      if collected_in_this_attempt:\n          # Successfully attempted collection (either collected or failed, but we tried).\n          # The outer while loop will re-check inventory. Continue to next iteration.\n          continue \n\n      # 2.3 If not collected yet (not adjacent or USE failed), then move closer to the ingredient.\n      # Simple greedy movement towards ingredient_coords.\n      dx_move, dy_move = 0, 0\n      \n      # Prioritize moving horizontally.\n      if agent_pos[0] < ingredient_coords[0]:\n          dx_move = 1 # Move right\n      elif agent_pos[0] > ingredient_coords[0]:\n          dx_move = -1 # Move left\n      \n      # If horizontal position is aligned, then try vertical movement.\n      if dx_move == 0:\n          if agent_pos[1] < ingredient_coords[1]:\n              dy_move = 1 # Move up\n          elif agent_pos[1] > ingredient_coords[1]:\n              dy_move = -1 # Move down\n\n      action_to_take_for_move = None\n      if dx_move == 1: action_to_take_for_move = ACTION_RIGHT\n      elif dx_move == -1: action_to_take_for_move = ACTION_LEFT\n      elif dy_move == 1: action_to_take_for_move = ACTION_UP\n      elif dy_move == -1: action_to_take_for_move = ACTION_DOWN\n      \n      if action_to_take_for_move is not None:\n          reward, done, _ = env.step(action_to_take_for_move)\n          total_reward += reward\n          if done: return total_reward # Environment ended\n      else:\n          # This case implies agent_pos == ingredient_coords and it couldn't be collected\n          # by USE (e.g., not grabbable, or on top of it, but not next to it for some reason,\n          # or blocked). This is a \"stuck\" condition for this ingredient.\n          return total_reward # Cannot reach or collect ingredient, terminate craft attempt.\n\n  # --- Phase 3: Move to the workshop ---\n  # First, find the exact coordinates of the workshop on the grid.\n  workshop_coords = None\n  grid_data = env._current_state.grid\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if grid_data[x_grid, y_grid, workshop_idx] == 1:\n              workshop_coords = (x_grid, y_grid)\n              break\n      if workshop_coords:\n          break\n\n  if workshop_coords is None:\n      # Workshop not found in the environment. Cannot craft without it.\n      return total_reward \n\n  # Navigate until agent is adjacent to the workshop.\n  # CraftState.next_to checks any of the 8 surrounding cells.\n  # This makes navigation simpler.\n  while not env._current_state.next_to(workshop_idx):\n      current_pos = env._current_state.pos\n      \n      # Simple greedy movement towards the workshop.\n      dx_move, dy_move = 0, 0\n      \n      # Prioritize horizontal movement.\n      if current_pos[0] < workshop_coords[0]:\n          dx_move = 1 # Move right\n      elif current_pos[0] > workshop_coords[0]:\n          dx_move = -1 # Move left\n      \n      # If horizontal position is aligned, then try vertical movement.\n      if dx_move == 0:\n          if current_pos[1] < workshop_coords[1]:\n              dy_move = 1 # Move up\n          elif current_pos[1] > workshop_coords[1]:\n              dy_move = -1 # Move down\n\n      action_to_take_for_move = None\n      if dx_move == 1: action_to_take_for_move = ACTION_RIGHT\n      elif dx_move == -1: action_to_take_for_move = ACTION_LEFT\n      elif dy_move == 1: action_to_take_for_move = ACTION_UP\n      elif dy_move == -1: action_to_take_for_move = ACTION_DOWN\n      \n      if action_to_take_for_move is not None:\n          reward, done, _ = env.step(action_to_take_for_move)\n          total_reward += reward\n          if done: return total_reward # Environment ended\n      else:\n          # Agent is stuck or already at workshop_coords but not adjacent\n          # based on next_to function definition (e.g., workshop is non-passable).\n          return total_reward # Cannot reach workshop.\n\n  # --- Phase 4: Craft the item at the workshop ---\n  # Agent is now adjacent to the workshop. Need to face it and USE.\n  current_state = env._current_state\n  \n  # Find which cardinal direction the workshop is in relative to the agent.\n  action_to_face_workshop = None\n  x_agent, y_agent = current_state.pos\n  grid = current_state.grid # Re-get grid as it might have changed\n\n  for dx_adj, dy_adj, action_face in cardinal_directions_for_use:\n      nx, ny = x_agent + dx_adj, y_agent + dy_adj\n      if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n          continue\n      # Check if the workshop is at this specific adjacent cell.\n      if grid[nx, ny, workshop_idx] == 1: \n          action_to_face_workshop = action_face\n          break\n  \n  if action_to_face_workshop is not None:\n      # Orient towards the workshop.\n      if current_state.dir != action_to_face_workshop:\n          reward, done, _ = env.step(action_to_face_workshop)\n          total_reward += reward\n          if done: return total_reward\n      \n      # Perform the USE action to craft the item.\n      reward, done, _ = env.step(ACTION_USE)\n      total_reward += reward\n      if done: return total_reward\n  else:\n      # This implies the agent is \"next_to\" the workshop (per next_to's 8-dir check),\n      # but the workshop is not in one of the 4 cardinal directions for USE.\n      # This can happen if the workshop is diagonal or if next_to logic is broad.\n      # In such cases, the craft might not be possible with direct USE.\n      return total_reward # Cannot face and use workshop.\n\n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:13:07.895105", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Helper for directions to check adjacent cells and face them\n  # (dx, dy, action_name_to_face_that_direction)\n  relative_directions_to_face = [\n      (0, -1, 'DOWN'),  # Item is at (x, y-1), so agent needs to face DOWN\n      (0, 1, 'UP'),     # Item is at (x, y+1), so agent needs to face UP\n      (-1, 0, 'LEFT'),  # Item is at (x-1, y), so agent needs to face LEFT\n      (1, 0, 'RIGHT')   # Item is at (x+1, y), so agent needs to face RIGHT\n  ]\n\n  cookbook = env.world.cookbook\n  WIDTH, HEIGHT, _ = env._current_state.grid.shape # Get grid dimensions dynamically\n\n  # 1. Get the target item's index and its recipe\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # If the item name is not in the cookbook's index, it cannot be crafted.\n    return total_reward \n\n  if recipe is None:\n    # If there's no recipe for this item (e.g., it's a primitive or uncraftable), return.\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # If the recipe doesn't specify a workshop, it implies it cannot be crafted via a station.\n    return total_reward\n  \n  try:\n    workshop_idx = cookbook.index[workshop_name]\n  except KeyError:\n    # Workshop name from recipe not found in index, indicates an invalid recipe setup.\n    return total_reward\n\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients\n  for ingredient_idx, needed_count in ingredients.items():\n    # Loop until enough of this ingredient is in the inventory\n    while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n      current_state = env._current_state\n      agent_pos = current_state.pos\n      grid = current_state.grid\n      \n      # Try to find an instance of the ingredient's coordinates on the grid\n      item_coords = None\n      for x_grid in range(WIDTH):\n          for y_grid in range(HEIGHT):\n              if grid[x_grid, y_grid, ingredient_idx] == 1:\n                  item_coords = (x_grid, y_grid)\n                  break\n          if item_coords:\n              break\n      \n      if item_coords is None:\n          # Ingredient not found on the grid. Cannot collect.\n          break \n\n      # First, check if agent is adjacent to the item and can use it.\n      collected_in_this_step = False\n      action_to_face_ingredient = None\n\n      for dx_adj, dy_adj, action_name in relative_directions_to_face:\n          nx, ny = agent_pos[0] + dx_adj, agent_pos[1] + dy_adj\n          \n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          if grid[nx, ny, ingredient_idx] == 1:\n              action_to_face_ingredient = action_name\n              break\n      \n      if action_to_face_ingredient:\n          # Ingredient found adjacent. Face it and USE.\n          if current_state.dir != action_map[action_to_face_ingredient]:\n              reward, done, _ = env.step(action_map[action_to_face_ingredient])\n              total_reward += reward\n              if done: return total_reward\n              current_state = env._current_state # Update state after turning.\n          \n          reward, done, _ = env.step(ACTION_USE)\n          total_reward += reward\n          if done: return total_reward\n          \n          collected_in_this_step = True\n          # After attempting USE, the while loop condition will re-evaluate inventory.\n          continue \n\n      # If not collected (not adjacent or USE didn't pick it up), move closer.\n      moved_successfully_this_iteration = False\n      \n      # Option 1: Try greedy move towards the ingredient\n      dx, dy = 0, 0\n      if agent_pos[0] < item_coords[0]: dx = 1\n      elif agent_pos[0] > item_coords[0]: dx = -1\n      \n      if dx == 0: # If X aligned, try Y\n          if agent_pos[1] < item_coords[1]: dy = 1\n          elif agent_pos[1] > item_coords[1]: dy = -1\n      \n      action_to_take = None\n      if dx == 1: action_to_take = ACTION_RIGHT\n      elif dx == -1: action_to_take = ACTION_LEFT\n      elif dy == 1: action_to_take = ACTION_UP\n      elif dy == -1: action_to_take = ACTION_DOWN\n\n      if action_to_take is not None:\n          old_pos = env._current_state.pos\n          reward, done, _ = env.step(action_to_take)\n          total_reward += reward\n          if done: return total_reward\n          if env._current_state.pos != old_pos:\n              moved_successfully_this_iteration = True\n      \n      # Option 2: If greedy move didn't work (agent didn't move), try other cardinal moves\n      if not moved_successfully_this_iteration:\n          for action_name in ['RIGHT', 'UP', 'LEFT', 'DOWN']: # Fixed order to ensure some exploration\n              action = action_map[action_name]\n              old_pos = env._current_state.pos\n              reward, done, _ = env.step(action)\n              total_reward += reward\n              if done: return total_reward\n              if env._current_state.pos != old_pos:\n                  moved_successfully_this_iteration = True\n                  break # Successfully moved, exit this inner loop\n      \n      if not moved_successfully_this_iteration:\n          # If after all movement attempts, the agent couldn't move, it's stuck or target unreachable.\n          break # Exit the while loop for this ingredient, cannot collect.\n\n  # 3. Move to the workshop\n  # Find the exact coordinates of the workshop on the grid.\n  workshop_coords = None\n  grid_data = env._current_state.grid\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if grid_data[x_grid, y_grid, workshop_idx] == 1:\n              workshop_coords = (x_grid, y_grid)\n              break\n      if workshop_coords:\n          break\n\n  if workshop_coords is None:\n      # Workshop not found in the environment. Cannot craft.\n      return total_reward \n\n  # Navigate until adjacent to the workshop\n  while not env._current_state.next_to(workshop_idx):\n      current_state = env._current_state\n      agent_pos = current_state.pos\n\n      moved_successfully_this_iteration = False\n      \n      # Option 1: Try greedy move towards the workshop\n      dx, dy = 0, 0\n      if agent_pos[0] < workshop_coords[0]: dx = 1\n      elif agent_pos[0] > workshop_coords[0]: dx = -1\n      \n      if dx == 0: # If X aligned, try Y\n          if agent_pos[1] < workshop_coords[1]: dy = 1\n          elif agent_pos[1] > workshop_coords[1]: dy = -1\n\n      action_to_take = None\n      if dx == 1: action_to_take = ACTION_RIGHT\n      elif dx == -1: action_to_take = ACTION_LEFT\n      elif dy == 1: action_to_take = ACTION_UP\n      elif dy == -1: action_to_take = ACTION_DOWN\n      \n      if action_to_take is not None:\n          old_pos = env._current_state.pos\n          reward, done, _ = env.step(action_to_take)\n          total_reward += reward\n          if done: return total_reward\n          if env._current_state.pos != old_pos:\n              moved_successfully_this_iteration = True\n      \n      # Option 2: If greedy move didn't work, try other cardinal moves\n      if not moved_successfully_this_iteration:\n          for action_name in ['RIGHT', 'UP', 'LEFT', 'DOWN']: # Fixed order\n              action = action_map[action_name]\n              old_pos = env._current_state.pos\n              reward, done, _ = env.step(action)\n              total_reward += reward\n              if done: return total_reward\n              if env._current_state.pos != old_pos:\n                  moved_successfully_this_iteration = True\n                  break\n      \n      if not moved_successfully_this_iteration:\n          # Agent is stuck or workshop unreachable.\n          break \n\n  # 4. Craft the item at the workshop (only if agent is adjacent and all ingredients are met)\n  current_state = env._current_state\n  \n  # Before attempting to craft, double-check if all ingredients are collected.\n  all_ingredients_collected = True\n  for ingredient_idx, needed_count in ingredients.items():\n      if env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n          all_ingredients_collected = False\n          break\n  \n  if all_ingredients_collected and current_state.next_to(workshop_idx):\n      # Orient towards the workshop.\n      action_to_face_workshop = None\n      x, y = current_state.pos\n      grid = current_state.grid\n      for dx, dy, action_name in relative_directions_to_face:\n          nx, ny = x + dx, y + dy\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n          if grid[nx, ny, workshop_idx] == 1: # Check if the workshop is in this adjacent cell.\n              action_to_face_workshop = action_name\n              break\n      \n      if action_to_face_workshop is not None:\n          # Turn to face the workshop.\n          if current_state.dir != action_map[action_to_face_workshop]:\n              reward, done, _ = env.step(action_map[action_to_face_workshop])\n              total_reward += reward\n              if done: return total_reward\n          \n          # Now, USE the workshop to craft the item.\n          reward, done, _ = env.step(ACTION_USE)\n          total_reward += reward\n          if done: return total_reward\n  \n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:26:33.642582", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Get the integer index for the item to be crafted\n  item_idx = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # Collect all necessary ingredients\n  # Iterate through the recipe's ingredients (keys that are integers)\n  for ingredient_idx, required_count in recipe.items():\n    # Skip special keys like '_at' or '_yield' which are not ingredients\n    if not isinstance(ingredient_idx, int):\n      continue\n\n    # Get the string name of the ingredient from its index\n    ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n    \n    # Check current inventory for this ingredient\n    current_inventory_count = env._current_state.inventory[ingredient_idx]\n\n    # Calculate how much more of this ingredient is needed\n    needed_count = required_count - current_inventory_count\n    \n    # If more is needed, call COLLECT_FUNC repeatedly\n    # COLLECT_FUNC is assumed to handle moving to and picking up one unit of the specified 'kind'.\n    for _ in range(int(needed_count)):\n      # COLLECT_FUNC is an assumed DSL function provided externally.\n      # It takes care of navigation and performing the USE action to get the item.\n      reward_from_collect = COLLECT_FUNC(env, ingredient_name)\n      total_reward += reward_from_collect\n      # The inventory is updated internally by env.step() within COLLECT_FUNC\n\n  # Determine if a specific workshop is required for crafting\n  workshop_name = None\n  workshop_idx = -1\n  if \"_at\" in recipe:\n    workshop_name = recipe[\"_at\"]\n    # Get the integer index for the required workshop\n    workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # If a workshop is needed, move the agent adjacent to it and orient it\n  if workshop_name:\n    # Find the exact (x, y) coordinates of the workshop on the grid\n    workshop_x, workshop_y = -1, -1\n    grid = env._current_state.grid\n    # Search the entire grid for the workshop\n    for x_coord in range(WIDTH): # WIDTH is a global constant from the environment code\n      for y_coord in range(HEIGHT): # HEIGHT is a global constant from the environment code\n        if grid[x_coord, y_coord, workshop_idx] == 1:\n          workshop_x, workshop_y = x_coord, y_coord\n          break\n      if workshop_x != -1: # Break outer loop if workshop found\n        break\n    \n    # If for some reason the workshop wasn't found (should not happen in well-formed scenarios)\n    if workshop_x == -1:\n        # Cannot proceed with crafting if workshop is missing or unlocatable.\n        # Return accumulated reward so far.\n        return total_reward\n\n    # Pathfinding loop to move the agent adjacent to the workshop\n    max_path_moves = WIDTH * HEIGHT * 2 # Safety break to prevent infinite loops\n    moves_made = 0\n    \n    # Check if the agent is already adjacent to the workshop\n    # CraftState.next_to checks if any object of kind_idx is in the 3x3 surrounding grid.\n    is_adjacent_to_workshop = env._current_state.next_to(workshop_idx)\n\n    # Continue moving until adjacent or max_path_moves reached\n    while not is_adjacent_to_workshop and moves_made < max_path_moves:\n      current_agent_x, current_agent_y = env._current_state.pos\n      \n      # Calculate the required movement direction (greedy approach towards workshop)\n      dx = workshop_x - current_agent_x\n      dy = workshop_y - current_agent_y\n      \n      move_direction_str = None\n      if abs(dx) > abs(dy): # Prioritize horizontal movement if difference is larger\n        if dx > 0:\n          move_direction_str = \"RIGHT\"\n        elif dx < 0:\n          move_direction_str = \"LEFT\"\n      else: # Prioritize vertical movement or if dx is 0\n        if dy > 0:\n          move_direction_str = \"UP\"\n        elif dy < 0:\n          move_direction_str = \"DOWN\"\n      \n      # If a valid move direction is determined\n      if move_direction_str:\n        # MOVE_FUNC is an assumed DSL function provided externally.\n        reward_from_move = MOVE_FUNC(env, move_direction_str)\n        total_reward += reward_from_move\n      else:\n        # This case implies agent is at same coordinates as workshop (not possible for workshops as obstacles)\n        # or agent is stuck/blocked and cannot move closer. Break the loop if no progress can be made.\n        break \n\n      # Re-check adjacency after attempting a move\n      is_adjacent_to_workshop = env._current_state.next_to(workshop_idx)\n      moves_made += 1\n\n    # After being adjacent, orient the agent to face the workshop directly.\n    # The USE action in CraftState only checks the cell in the agent's current direction.\n    final_agent_x, final_agent_y = env._current_state.pos\n    \n    target_direction_name = None\n    # Determine the cardinal direction from the agent to the workshop\n    if workshop_x == final_agent_x + 1 and workshop_y == final_agent_y:\n      target_direction_name = \"RIGHT\"\n    elif workshop_x == final_agent_x - 1 and workshop_y == final_agent_y:\n      target_direction_name = \"LEFT\"\n    elif workshop_x == final_agent_x and workshop_y == final_agent_y + 1:\n      target_direction_name = \"UP\"\n    elif workshop_x == final_agent_x and workshop_y == final_agent_y - 1:\n      target_direction_name = \"DOWN\"\n\n    # If the agent is not already facing the target direction, perform a 'dummy' move.\n    # This move won't change position if blocked by the workshop, but will change direction.\n    if target_direction_name and env._current_state.dir != eval(target_direction_name.upper()):\n      # MOVE_FUNC is an assumed DSL function.\n      reward_from_orient = MOVE_FUNC(env, target_direction_name)\n      total_reward += reward_from_orient\n\n  # Finally, execute the USE action to perform the crafting\n  # USE is a constant action defined in the Craft environment (value 4).\n  reward_from_use, _, _ = env.step(USE)\n  total_reward += reward_from_use\n\n  return total_reward", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-24T08:26:34.698780", "function_name": "craft", "function_body": "  import collections\n\n  total_reward = 0.0\n  cookbook = env.world.cookbook\n  target_item_idx = cookbook.index.index(item)\n\n  # 1. Collect all primitive ingredients required for the target item.\n  needed_primitives = cookbook.primitives_for(target_item_idx)\n  for primitive_idx, required_count in needed_primitives.items():\n      primitive_name = cookbook.index.get(primitive_idx)\n      # Keep collecting until the required count of the primitive is in inventory.\n      while env._current_state.inventory[primitive_idx] < required_count:\n          # COLLECT_FUNC is a DSL construct assumed to handle navigation and 'USE'\n          # action to pick up one instance of the specified 'kind' (primitive).\n          # It returns the reward obtained from that collection action.\n          step_reward = COLLECT_FUNC(env, primitive_name)\n          total_reward += step_reward\n\n  # 2. Move to the specific workshop needed for crafting the item.\n  recipe = cookbook.recipes[target_item_idx]\n  workshop_name = recipe['_at']\n  workshop_idx = cookbook.index.index(workshop_name)\n\n  # Find the coordinates of the workshop on the grid.\n  workshop_coords = None\n  grid = env._current_state.grid\n  # WIDTH and HEIGHT are global constants from the Craft environment definition.\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, workshop_idx] == 1:\n              workshop_coords = (x, y)\n              break\n      if workshop_coords:\n          break\n\n  # If for some reason the workshop is not found (should not happen in valid scenarios),\n  # return the accumulated reward, indicating inability to craft.\n  if not workshop_coords:\n      return total_reward\n\n  # BFS to find a path to a position *adjacent* to the workshop.\n  start_pos = env._current_state.pos\n  queue = collections.deque([(start_pos, [])])  # (current_position, list_of_actions_to_reach_here)\n  visited = {start_pos}\n  path_to_workshop_actions = []\n  found_path = False\n\n  # Max iterations for BFS to prevent infinite loops for safety in complex/large maps.\n  # A reasonable upper bound for grid traversal is `WIDTH * HEIGHT`.\n  max_bfs_steps = WIDTH * HEIGHT * 2 # Safety margin\n  bfs_steps_taken = 0\n\n  while queue and not found_path and bfs_steps_taken < max_bfs_steps:\n      bfs_steps_taken += 1\n      current_pos, current_path = queue.popleft()\n      \n      # Check if the current position is adjacent to the workshop.\n      # `neighbors(pos)` is a global function from the Craft environment.\n      is_adjacent_to_workshop = False\n      for nx, ny in neighbors(current_pos):\n          if (nx, ny) == workshop_coords:\n              is_adjacent_to_workshop = True\n              break\n              \n      if is_adjacent_to_workshop:\n          path_to_workshop_actions = current_path\n          found_path = True\n          break\n\n      # Explore valid neighboring cells.\n      # Action mapping: DOWN=0 (0,-1), UP=1 (0,1), LEFT=2 (-1,0), RIGHT=3 (1,0)\n      possible_actions = [DOWN, UP, LEFT, RIGHT]\n      delta_coords = {\n          DOWN: (0, -1),\n          UP: (0, 1),\n          LEFT: (-1, 0),\n          RIGHT: (1, 0)\n      }\n\n      for action_dir in possible_actions:\n          dx, dy = delta_coords[action_dir]\n          next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n          next_pos = (next_x, next_y)\n          \n          # Check if the next position is within grid bounds.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n          \n          # Check if the next position is traversable (i.e., empty).\n          # The agent cannot move onto any square that contains an item or obstacle.\n          if grid[next_x, next_y, :].any():\n              continue\n              \n          # If the position is valid and not visited, add to queue.\n          if next_pos not in visited:\n              visited.add(next_pos)\n              queue.append((next_pos, current_path + [action_dir]))\n\n  # If a path to the workshop could not be found, return current reward.\n  if not found_path:\n      return total_reward\n\n  # Execute the determined path to move the agent adjacent to the workshop.\n  for action_dir in path_to_workshop_actions:\n      # MOVE_FUNC is a DSL construct assumed to execute a single step action.\n      step_reward = MOVE_FUNC(env, action_dir)\n      total_reward += step_reward\n\n  # 3. Perform the USE action at the workshop to craft the item.\n  # The agent is now positioned adjacent to the workshop.\n  step_reward, _, _ = env.step(USE) # USE is a global constant from Craft environment.\n  total_reward += step_reward\n\n  return total_reward", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-24T08:35:25.810329", "function_name": "craft", "function_body": "  total_reward = 0.0\n  cookbook = env.world.cookbook\n  current_state = env._current_state # Get initial state before any steps for tracking\n\n  # 1. Get the item index for the item to be crafted\n  item_idx = cookbook.index[item]\n\n  # Ensure the item is actually a craftable item (i.e., has a recipe)\n  if item_idx not in cookbook.recipes:\n      # This function is for crafting; if no recipe exists, it cannot be crafted.\n      return total_reward\n\n  recipe = cookbook.recipes[item_idx]\n  \n  # Get the index of the required crafting station (if any)\n  workshop_idx = None\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name:\n      workshop_idx = cookbook.index[workshop_name]\n\n  # Get all primitive ingredients needed for the final item\n  needed_primitives = cookbook.primitives_for(item_idx)\n\n  # 3. Collect all necessary primitive ingredients\n  for primitive_idx, required_count in needed_primitives.items():\n      while current_state.inventory[primitive_idx] < required_count:\n          # Find the location of the primitive on the grid\n          # np.argwhere returns coordinates (row, col) where grid value is 1\n          primitive_locations = np.argwhere(current_state.grid[:, :, primitive_idx] == 1)\n\n          if len(primitive_locations) == 0:\n              # Cannot find the ingredient on the map, task might be impossible.\n              return total_reward \n\n          # For simplicity, target the first found instance.\n          target_x, target_y = primitive_locations[0]\n\n          moves_made = 0\n          # Max moves safeguard to prevent infinite loops in complex or blocked paths\n          max_moves_limit = WIDTH + HEIGHT \n\n          # Move towards the primitive until adjacent to it.\n          # The `CraftState.step` method updates the agent's direction to the last attempted move.\n          # `current_state.next_to(primitive_idx)` checks if primitive is in 3x3 area around agent.\n          while not current_state.next_to(primitive_idx) and moves_made < max_moves_limit:\n              agent_x, agent_y = current_state.pos\n              action = -1\n              \n              # Prioritize movement along the axis with the larger difference to the target\n              if abs(agent_x - target_x) > abs(agent_y - target_y):\n                  if agent_x < target_x:\n                      action = RIGHT\n                  elif agent_x > target_x:\n                      action = LEFT\n              else: # If X difference is smaller or equal, prioritize Y movement\n                  if agent_y < target_y:\n                      action = UP\n                  elif agent_y > target_y:\n                      action = DOWN\n              \n              if action != -1:\n                  reward, new_state, _ = env.step(action)\n                  total_reward += reward\n                  current_state = new_state\n                  moves_made += 1\n              else: \n                  # This break handles cases where the agent might be stuck (e.g., path blocked,\n                  # or already at the target but target is non-grabbable/non-useable in that way)\n                  break\n\n          # After moving (or if already adjacent/on target), perform USE action to collect the primitive.\n          # The `USE` action in CraftState.step checks the cell in the agent's current direction.\n          reward, new_state, _ = env.step(USE)\n          total_reward += reward\n          current_state = new_state\n          \n          # The loop for collecting continues until `required_count` is met in inventory.\n\n  # 4. Move to the crafting station (if required) and perform the craft action.\n  if workshop_idx is not None:\n      workshop_locations = np.argwhere(current_state.grid[:, :, workshop_idx] == 1)\n      if len(workshop_locations) == 0:\n          # Cannot find the crafting station on the map.\n          return total_reward \n\n      target_x, target_y = workshop_locations[0] # Target the first found workshop\n\n      moves_made = 0\n      max_moves_limit = WIDTH + HEIGHT \n\n      # Move towards the workshop until adjacent to it.\n      while not current_state.next_to(workshop_idx) and moves_made < max_moves_limit:\n          agent_x, agent_y = current_state.pos\n          action = -1\n          \n          # Prioritize movement along the axis with the larger difference\n          if abs(agent_x - target_x) > abs(agent_y - target_y):\n              if agent_x < target_x:\n                  action = RIGHT\n              elif agent_x > target_x:\n                  action = LEFT\n          else:\n              if agent_y < target_y:\n                  action = UP\n              elif agent_y > target_y:\n                  action = DOWN\n          \n          if action != -1:\n              reward, new_state, _ = env.step(action)\n              total_reward += reward\n              current_state = new_state\n              moves_made += 1\n          else:\n              break # Agent stuck or already at target location\n\n  # Perform USE action at the crafting station (or when conditions for crafting are met).\n  # The CraftState.step(USE) logic handles the actual crafting based on inventory and adjacency.\n  reward, new_state, _ = env.step(USE)\n  total_reward += reward\n  current_state = new_state\n\n  # Return the total reward accumulated during this crafting process.\n  return total_reward", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:35:26.882278", "function_name": "craft", "function_body": "  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  total_reward = 0.0\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if not recipe:\n      # Item is not craftable (e.g., a primitive or not in recipes)\n      return total_reward\n\n  # Get the required workshop for crafting\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n      # Recipe does not specify a workshop, cannot craft\n      return total_reward\n\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # Find the exact coordinates of the workshop on the grid\n  workshop_coords = None\n  grid = env._current_state.grid\n  # Use environment's defined dimensions (WIDTH, HEIGHT are global in the provided code)\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, workshop_idx] == 1:\n              workshop_coords = (x, y)\n              break\n      if workshop_coords:\n          break\n\n  if not workshop_coords:\n      # Workshop not found on the map\n      return total_reward\n\n  # Navigate the agent to be adjacent to the workshop\n  max_nav_steps = 100 # Safety limit to prevent infinite loops during navigation\n  nav_steps = 0\n  while not env._current_state.next_to(workshop_idx) and nav_steps < max_nav_steps:\n      current_x, current_y = env._current_state.pos\n      wx, wy = workshop_coords\n\n      action_to_take = -1\n\n      # Greedy movement: try to align with the workshop's X coordinate first, then Y\n      if current_x < wx:\n          action_to_take = _RIGHT\n      elif current_x > wx:\n          action_to_take = _LEFT\n      elif current_y < wy: # If X is aligned, try to align Y\n          action_to_take = _UP\n      elif current_y > wy:\n          action_to_take = _DOWN\n      \n      # If action_to_take is still -1, it implies the agent is at the workshop's coordinates.\n      # This state should not be reachable as the agent cannot move onto an occupied cell.\n      # This case handles scenarios where greedy pathfinding might get stuck, or workshop is diagonal.\n      if action_to_take != -1:\n          reward, done, _ = env.step(action_to_take)\n          total_reward += reward\n          if done: # If goal is achieved or max environment steps reached during navigation\n              return total_reward\n      else:\n          # Agent cannot make progress with greedy moves (e.g., completely blocked)\n          break \n      nav_steps += 1\n\n  # Check if navigation was successful (agent is now next to the workshop)\n  if not env._current_state.next_to(workshop_idx):\n      # Failed to reach the workshop\n      return total_reward\n\n  # Orient the agent to face the workshop\n  current_x, current_y = env._current_state.pos\n  wx, wy = workshop_coords\n\n  direction_to_face = -1\n  if current_x - 1 == wx and current_y == wy: # Workshop is to the left\n      direction_to_face = _LEFT\n  elif current_x + 1 == wx and current_y == wy: # Workshop is to the right\n      direction_to_face = _RIGHT\n  elif current_x == wx and current_y - 1 == wy: # Workshop is below/down\n      direction_to_face = _DOWN\n  elif current_x == wx and current_y + 1 == wy: # Workshop is above/up\n      direction_to_face = _UP\n  \n  if direction_to_face != -1:\n      # Take a step to change agent's direction. Position will not change if target cell is occupied.\n      reward, done, _ = env.step(direction_to_face)\n      total_reward += reward\n      if done: # If goal is achieved or max environment steps reached during orientation\n          return total_reward\n  else:\n      # This should ideally not happen if `next_to` is true, as it implies the workshop\n      # is a neighbor but not in a cardinal direction (which is not how CraftWorld works).\n      return total_reward\n\n  # Perform the USE action to craft the item\n  reward, done, _ = env.step(_USE)\n  total_reward += reward\n\n  return total_reward", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:39:31.869770", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Get grid dimensions dynamically from the current state\n  # This makes the solution robust to different map sizes.\n  grid_shape = env._current_state.grid.shape\n  WIDTH = grid_shape[0]\n  HEIGHT = grid_shape[1]\n\n  # Map action names to their integer codes using the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define relative positions (dx, dy) and the corresponding action to face that direction.\n  # This is crucial for orienting the agent before performing a 'USE' action.\n  # For example, if a target is at (x, y-1) relative to the agent, it's 'DOWN', so the agent needs to face DOWN.\n  relative_directions = [\n      ((0, -1), ACTION_DOWN),  # Target is below agent (y-1), agent faces DOWN\n      ((0, 1), ACTION_UP),     # Target is above agent (y+1), agent faces UP\n      ((-1, 0), ACTION_LEFT),  # Target is left of agent (x-1), agent faces LEFT\n      ((1, 0), ACTION_RIGHT)   # Target is right of agent (x+1), agent faces RIGHT\n  ]\n\n  # 1. Identify the target item and its crafting requirements (recipe).\n  cookbook = env.world.cookbook\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # If the item name is not in the cookbook's index, it cannot be crafted.\n    return total_reward\n\n  if recipe is None:\n    # If there's no recipe (e.g., it's a primitive item or unknown), it cannot be crafted via recipe.\n    return total_reward\n\n  # Extract the workshop required for crafting from the recipe.\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # If the recipe doesn't specify a workshop, it cannot be crafted through this process.\n    return total_reward\n  try:\n    workshop_idx = cookbook.index[workshop_name]\n  except KeyError:\n    # If the workshop name itself is not in the cookbook's index.\n    return total_reward\n\n  # Extract the list of ingredients and their required quantities from the recipe.\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients.\n  # Iterate through each required ingredient.\n  for ingredient_idx, needed_count in ingredients.items():\n    # Keep trying to collect this ingredient until the needed amount is in the inventory.\n    while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n      current_state = env._current_state\n      x, y = current_state.pos\n      grid = current_state.grid\n      \n      found_target_adjacent = False\n      # First, check if the ingredient is already in an adjacent cell.\n      for (dx, dy), action_to_face in relative_directions:\n        nx, ny = x + dx, y + dy\n        # Check if the neighboring cell is within bounds and contains the ingredient.\n        if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, ingredient_idx] == 1:\n          # If found adjacent, orient the agent towards it if necessary.\n          if current_state.dir != action_to_face:\n            reward, done, _ = env.step(action_to_face)\n            total_reward += reward\n            if done: return total_reward  # If environment is done (e.g., max_steps reached), terminate.\n            current_state = env._current_state # Update state after the action.\n\n          # Perform the 'USE' action to pick up the ingredient.\n          reward, done, _ = env.step(ACTION_USE)\n          total_reward += reward\n          if done: return total_reward\n          found_target_adjacent = True\n          break # Successfully found and attempted to pick up one instance of the ingredient. Re-check quantity.\n\n      # If the ingredient was not found in an adjacent cell after checking all directions,\n      # the agent needs to move to find it.\n      if not found_target_adjacent:\n        # Implement a simple \"search\" strategy: try moving in a fixed cycle (UP, RIGHT, DOWN, LEFT).\n        # This is a basic exploration and might not be optimal but should work for simple layouts.\n        moved_to_find_item = False\n        for action_to_move in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n          original_pos = current_state.pos\n          reward, done, _ = env.step(action_to_move)\n          total_reward += reward\n          if done: return total_reward\n          current_state = env._current_state # Update state after the move.\n          \n          # If the agent's position changed, it means it successfully moved to an empty spot.\n          if current_state.pos != original_pos:\n            moved_to_find_item = True\n            break # Break from this inner movement loop and re-evaluate adjacency from the new position.\n        \n        # If the agent is stuck (e.g., surrounded by boundaries) and cannot move in any direction,\n        # this loop will continue to iterate without moving, eventually hitting max_steps.\n\n  # 3. Move to the workshop required for crafting.\n  # Loop until the agent is positioned in a cell adjacent to the workshop.\n  while not env._current_state.next_to(workshop_idx):\n    current_state = env._current_state\n    \n    # Implement a simple movement strategy to get adjacent to the workshop.\n    moved_to_find_workshop = False\n    for action_to_move in [ACTION_UP, ACTION_RIGHT, ACTION_DOWN, ACTION_LEFT]:\n      original_pos = current_state.pos\n      reward, done, _ = env.step(action_to_move)\n      total_reward += reward\n      if done: return total_reward\n      current_state = env._current_state # Update state after the move.\n\n      if current_state.pos != original_pos:\n        moved_to_find_workshop = True\n        break # Agent moved, re-check adjacency to the workshop.\n\n    # If the agent gets stuck and cannot move to a position adjacent to the workshop,\n    # this loop will continue, eventually hitting max_steps.\n\n  # 4. Craft the item at the workshop.\n  current_state = env._current_state\n  x, y = current_state.pos\n  grid = current_state.grid\n  \n  # Find the workshop in adjacent cells and determine the direction to face it.\n  target_adjacent_dir_action = None\n  for (dx, dy), action_to_face in relative_directions:\n    nx, ny = x + dx, y + dy\n    # Check if the neighboring cell is within bounds and contains the workshop.\n    if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, workshop_idx] == 1:\n      target_adjacent_dir_action = action_to_face\n      break\n  \n  # If a workshop was found adjacent (which it should be after the previous loop).\n  if target_adjacent_dir_action is not None:\n      # Orient the agent towards the workshop if not already facing it.\n      if current_state.dir != target_adjacent_dir_action:\n          reward, done, _ = env.step(target_adjacent_dir_action)\n          total_reward += reward\n          if done: return total_reward\n          current_state = env._current_state # Update state after action.\n\n      # Perform the 'USE' action to craft the item at the workshop.\n      reward, done, _ = env.step(ACTION_USE)\n      total_reward += reward\n      if done: return total_reward\n  # If target_adjacent_dir_action is None here, it means the workshop was not found adjacent\n  # despite the previous loop, indicating an unexpected state. The function will simply return\n  # the accumulated reward without crafting.\n\n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:39:32.908014", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Constants for grid dimensions (from CraftWorld, assumed available in context)\n  # Included explicitly for self-containment as per prompt's strict instruction.\n  WIDTH = 12\n  HEIGHT = 12\n\n  # Helper for cardinal directions and their corresponding action IDs\n  # (dx, dy, action_id)\n  cardinal_directions_actions = [\n      (0, -1, ACTION_DOWN),\n      (0, 1, ACTION_UP),\n      (-1, 0, ACTION_LEFT),\n      (1, 0, ACTION_RIGHT)\n  ]\n\n  # Helper function to find the action ID to face an adjacent item\n  def get_action_to_face_adjacent_item(current_pos, current_grid, item_idx):\n      x, y = current_pos\n      for dx, dy, action_id in cardinal_directions_actions:\n          nx, ny = x + dx, y + dy\n          # Check if neighbor is within bounds and contains the item\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and current_grid[nx, ny, item_idx] == 1:\n              return action_id # Return the action ID to face that direction\n      return -1 # Not found adjacent\n\n  # 1. Get the target item's index and its recipe\n  cookbook = env.world.cookbook\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # If item is not in index, cannot craft\n    return total_reward\n\n  if recipe is None:\n    # If it's a primitive or unknown item that doesn't have a crafting recipe, cannot craft\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # Cannot craft without a specified workshop\n    return total_reward\n  workshop_idx = cookbook.index[workshop_name]\n\n  # Extract ingredients (numeric indices) and their required counts\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients\n  for ingredient_idx, needed_count in ingredients.items():\n    # Keep looping until enough of the current ingredient is in inventory\n    while env._current_state.inventory[ingredient_idx] < needed_count:\n      current_state = env._current_state\n\n      # First, try to collect if an ingredient is directly adjacent\n      face_action = get_action_to_face_adjacent_item(current_state.pos, current_state.grid, ingredient_idx)\n      \n      if face_action != -1: # If an ingredient is adjacent\n          # If not already facing the correct direction, turn\n          if current_state.dir != face_action:\n              reward, done, _ = env.step(face_action) # Turn to face it\n              total_reward += reward\n              if done: return total_reward\n              current_state = env._current_state # Update state after turning\n\n          # Now, use the action to pick up the item\n          reward, done, _ = env.step(ACTION_USE) # Use to collect\n          total_reward += reward\n          if done: return total_reward\n          # After successful USE, the inventory is updated. The while loop condition will be re-evaluated.\n          continue # Go to the next iteration of the while loop for this ingredient\n\n      # If the ingredient is not adjacent, try to move to find it\n      moved_to_find = False\n      # Simple exploration strategy: try moving in all four cardinal directions.\n      # This isn't a sophisticated pathfinding but works for simple, open environments.\n      for dx, dy, action_id in cardinal_directions_actions:\n          reward, done, _ = env.step(action_id) # Try moving\n          total_reward += reward\n          if done: return total_reward\n          \n          # Check if the move made the ingredient adjacent\n          if get_action_to_face_adjacent_item(env._current_state.pos, env._current_state.grid, ingredient_idx) != -1:\n              moved_to_find = True\n              break # Successfully moved closer, the ingredient should now be adjacent.\n      \n      if not moved_to_find:\n          # If after trying all possible single moves, the ingredient is still not adjacent,\n          # it implies it's unreachable with this simple movement strategy, or the agent is stuck.\n          # The loop will continue, relying on `max_steps` to eventually terminate the episode.\n          pass\n\n  # 3. Move to the workshop\n  # Keep looping until the agent is next to the required workshop\n  while not env._current_state.next_to(workshop_idx):\n    moved_towards_workshop = False\n    # Simple movement strategy: try moving in all cardinal directions\n    for dx, dy, action_id in cardinal_directions_actions:\n        reward, done, _ = env.step(action_id)\n        total_reward += reward\n        if done: return total_reward\n        if env._current_state.next_to(workshop_idx): # Check if next to workshop after this move\n            moved_towards_workshop = True\n            break\n    if not moved_towards_workshop:\n        # Agent is stuck or cannot reach the workshop with simple moves.\n        # The loop will continue, relying on `max_steps` for termination.\n        pass\n\n  # 4. Craft the item at the workshop\n  current_state = env._current_state\n\n  # Orient towards the workshop. At this point, the workshop should be adjacent.\n  face_action = get_action_to_face_adjacent_item(current_state.pos, current_state.grid, workshop_idx)\n\n  if face_action != -1: # This condition should ideally always be true if the previous loop exited correctly\n      # If not already facing the workshop, turn\n      if current_state.dir != face_action:\n          reward, done, _ = env.step(face_action)\n          total_reward += reward\n          if done: return total_reward\n      \n      # Now, perform the USE action to craft the item\n      reward, done, _ = env.step(ACTION_USE)\n      total_reward += reward\n      if done: return total_reward\n  \n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:49:35.567996", "function_name": "craft", "function_body": "    total_reward = 0.0\n    item_idx = env.world.cookbook.index.index(item)\n\n    # Helper function for moving to an item/workshop and interacting with it\n    # This function attempts to move the agent adjacent to a target (item on grid or workshop)\n    # and then uses the 'USE' action to interact with it.\n    def _move_and_interact(target_name):\n        nonlocal total_reward  # Allow modification of total_reward from outer scope\n\n        target_idx = env.world.cookbook.index.index(target_name)\n        max_movement_attempts = 50  # Limit steps to avoid infinite loops in complex scenarios\n\n        for _ in range(max_movement_attempts):\n            current_x, current_y = env._current_state.pos\n\n            # 1. Find the target's current position on the grid\n            target_pos_on_grid = None\n            grid = env._current_state.features_dict()['features_global']\n            for gx in range(grid.shape[0]):\n                for gy in range(grid.shape[1]):\n                    if grid[gx, gy, target_idx] == 1:\n                        target_pos_on_grid = (gx, gy)\n                        break\n                if target_pos_on_grid:\n                    break\n            \n            if not target_pos_on_grid:\n                # Target not found on the grid (e.g., already collected, or not present)\n                # For workshops, they should always be present. For collectables, they might be gone.\n                return  # Cannot interact if target is gone or never existed\n\n            # 2. Check if agent is currently adjacent to the target\n            is_adjacent_to_target = False\n            action_to_orient = -1  # Action to take to face the target\n\n            # Check all 4 direct neighbors to see if the target is there\n            # dx, dy represent relative coordinates from agent to target\n            # action_val is the move action that would set the agent's direction towards it\n            for dx, dy, action_val in [(-1, 0, env.action_specs()['LEFT']),\n                                       (1, 0, env.action_specs()['RIGHT']),\n                                       (0, -1, env.action_specs()['DOWN']),  # CraftWorld's Y- corresponds to DOWN action\n                                       (0, 1, env.action_specs()['UP'])]:   # CraftWorld's Y+ corresponds to UP action\n                \n                check_x, check_y = current_x + dx, current_y + dy\n                # Ensure check_x, check_y are within grid boundaries before checking\n                if 0 <= check_x < grid.shape[0] and 0 <= check_y < grid.shape[1]:\n                    if (check_x, check_y) == target_pos_on_grid:\n                        is_adjacent_to_target = True\n                        action_to_orient = action_val\n                        break\n            \n            if is_adjacent_to_target:\n                # Agent is adjacent to the target, now orient and USE\n                # Taking the action_to_orient step will set the agent's direction.\n                # If the target cell is occupied (e.g., wood), the agent's position will not change.\n                # But its internal 'dir' will update, which is crucial for the 'USE' action.\n                reward, _, _ = env.step(action_to_orient)\n                total_reward += reward\n                \n                # Now perform the 'USE' action\n                reward, _, _ = env.step(env.action_specs()['USE'])\n                total_reward += reward\n                return  # Interaction successful, exit helper\n            \n            # 3. If not adjacent, move towards the target\n            action_move = -1\n            \n            # Simple greedy movement: prioritize moving horizontally, then vertically.\n            # This is a basic pathfinding heuristic and might get stuck if paths are complex.\n            if current_x < target_pos_on_grid[0]:\n                action_move = env.action_specs()['RIGHT']\n            elif current_x > target_pos_on_grid[0]:\n                action_move = env.action_specs()['LEFT']\n            elif current_y < target_pos_on_grid[1]:\n                action_move = env.action_specs()['UP']\n            elif current_y > target_pos_on_grid[1]:\n                action_move = env.action_specs()['DOWN']\n            else:\n                # Should not be reached if target_pos_on_grid is different from current_pos\n                # and target is not adjacent.\n                break # No valid move direction determined (e.g., agent is already on target's coordinates,\n                      # which means it cannot move but also cannot be adjacent in typical setup for interaction)\n\n            if action_move != -1:\n                prev_pos = env._current_state.pos\n                reward, _, _ = env.step(action_move)\n                total_reward += reward\n                if env._current_state.pos == prev_pos:\n                    # Agent is stuck (tried to move onto an obstacle like a boundary or another item)\n                    break # Cannot reach target with simple direct moves, break loop\n            else:\n                break # Should not happen if a direction was picked, but as a safeguard.\n        \n        # If the loop finishes without successful interaction within max_movement_attempts\n        return\n\n    # Check if the requested item is a known craftable recipe\n    recipe = env.world.cookbook.recipes.get(item_idx)\n    if not recipe:\n        # If the item is not a craftable recipe (e.g., it's a primitive or an unknown item),\n        # the 'craft' function cannot fulfill it. Return current reward (0.0).\n        return total_reward\n\n    # --- Step 1: Gather all necessary ingredients for the recipe ---\n    for ingredient_key, count_needed in recipe.items():\n        # Skip special recipe keys like '_at' (workshop location) and '_yield' (amount produced)\n        if isinstance(ingredient_key, str) and ingredient_key.startswith('_'):\n            continue\n\n        ingredient_idx = env.world.cookbook.index.index(ingredient_key)\n        \n        # Loop until enough of the current ingredient is in inventory\n        while env._current_state.inventory[ingredient_idx] < count_needed:\n            old_inventory_count = env._current_state.inventory[ingredient_idx]\n\n            # Determine if the ingredient is a primitive or another craftable item\n            if ingredient_idx in env.world.cookbook.primitives:\n                # If it's a primitive, collect it from the environment\n                _move_and_interact(env.world.cookbook.index.get(ingredient_idx))\n            elif ingredient_idx in env.world.cookbook.recipes:\n                # If it's another craftable item, recursively call craft_v2 for it\n                reward_from_sub_craft = craft_v2(env, env.world.cookbook.index.get(ingredient_idx))\n                total_reward += reward_from_sub_craft\n            else:\n                # This case handles ingredients that are neither primitive nor craftable\n                # (e.g., a conceptual item that cannot be obtained).\n                break # Cannot obtain this ingredient, stop trying\n\n            new_inventory_count = env._current_state.inventory[ingredient_idx]\n            if new_inventory_count <= old_inventory_count:\n                # If no progress was made in acquiring this ingredient in the last attempt,\n                # break to avoid an infinite loop (e.g., item not on map, or stuck).\n                break\n\n    # --- Step 2: Move to and use the designated workshop to craft the item ---\n    workshop_name = recipe[\"_at\"]\n    _move_and_interact(workshop_name)\n\n    return total_reward", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-24T08:49:37.051401", "function_name": "craft", "function_body": "  total_reward = 0.0\n  cookbook = env.world.cookbook\n  \n  item_idx = cookbook.index[item]\n\n  # If the item is not a craftable item (e.g., a primitive or environment object),\n  # this function cannot \"craft\" it.\n  if item_idx not in cookbook.recipes:\n    return total_reward\n\n  # Get the recipe for the main item to know the target workshop\n  main_recipe = cookbook.recipes[item_idx]\n  main_workshop_name = main_recipe.get(\"_at\")\n  main_workshop_idx = cookbook.index[main_workshop_name] if main_workshop_name else None\n\n  # Retrieve global dimensions from the environment world\n  WIDTH = env.world.WIDTH\n  HEIGHT = env.world.HEIGHT\n\n  # Phase 1: Collect all necessary primitives\n  # This function returns a dictionary mapping primitive kind (index) to the total count needed\n  # to produce the target item, including any intermediate recipes.\n  all_required_primitives = cookbook.primitives_for(item_idx)\n  \n  # Arbitrary maximum steps for the collection phase to prevent infinite loops.\n  MAX_COLLECTION_STEPS = 200 \n\n  for _ in range(MAX_COLLECTION_STEPS):\n    current_state = env._current_state\n    \n    # Check if the target item is already in inventory (could happen if collected as a drop or previous craft)\n    if current_state.inventory[item_idx] > 0:\n      return total_reward\n\n    # Check if all required primitives are collected (or surpassed)\n    all_primitives_collected = True\n    for p_idx, p_count_needed in all_required_primitives.items():\n      if current_state.inventory[p_idx] < p_count_needed:\n        all_primitives_collected = False\n        break\n    \n    if all_primitives_collected:\n      break # Exit collection phase and proceed to crafting phase\n\n    # Find the closest primitive on the map that is still needed\n    primitive_to_collect_idx = -1\n    primitive_target_pos = None\n    min_dist_to_primitive = float('inf')\n    \n    grid = current_state.grid\n    \n    for p_idx, p_count_needed in all_required_primitives.items():\n      if current_state.inventory[p_idx] < p_count_needed: # We still need more of this primitive\n        for x_grid in range(WIDTH):\n          for y_grid in range(HEIGHT):\n            if grid[x_grid, y_grid, p_idx] == 1: # Found an instance of this primitive on the map\n              dist = abs(x_grid - current_state.pos[0]) + abs(y_grid - current_state.pos[1])\n              if dist < min_dist_to_primitive:\n                min_dist_to_primitive = dist\n                primitive_to_collect_idx = p_idx\n                primitive_target_pos = (x_grid, y_grid)\n    \n    # If no more needed primitives are found on the map, we cannot proceed.\n    if primitive_to_collect_idx == -1:\n      return total_reward\n\n    # Move towards the chosen primitive\n    tx, ty = primitive_target_pos\n    cx, cy = current_state.pos\n\n    action_to_take = -1\n    if cx < tx: action_to_take = RIGHT\n    elif cx > tx: action_to_take = LEFT\n    elif cy < ty: action_to_take = UP\n    elif cy > ty: action_to_take = DOWN\n    \n    # Check if agent is adjacent to the primitive\n    is_adjacent = False\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]: # Check all 4 directions\n      if cx + dx == tx and cy + dy == ty:\n        is_adjacent = True\n        break\n\n    if not is_adjacent and action_to_take != -1:\n      # If not adjacent, move closer\n      reward, new_state = env.step(action_to_take)\n      total_reward += reward\n      env._current_state = new_state\n    elif is_adjacent:\n      # If adjacent, first adjust direction to face the primitive, then USE\n      target_dir = -1\n      if cx == tx and cy + 1 == ty: target_dir = UP\n      elif cx == tx and cy - 1 == ty: target_dir = DOWN\n      elif cx + 1 == tx and cy == ty: target_dir = RIGHT\n      elif cx - 1 == tx and cy == ty: target_dir = LEFT\n\n      if target_dir != -1:\n        # Taking a movement action towards an occupied square (the primitive)\n        # will keep the agent's position but update its direction.\n        reward, new_state = env.step(target_dir) \n        total_reward += reward\n        env._current_state = new_state\n        \n        # Now perform the USE action to collect the primitive\n        reward, new_state = env.step(USE)\n        total_reward += reward\n        env._current_state = new_state\n      # else: unable to determine facing direction, cannot collect.\n\n  # Phase 2: Craft the item at the workshop\n  # This phase assumes all necessary primitives are now in the inventory.\n  # The `step(USE)` action at a workshop will automatically craft any recipe\n  # for which the agent has ingredients, including intermediate products.\n  \n  MAX_CRAFTING_STEPS = 100 # Arbitrary, enough steps to keep using the workshop\n\n  for _ in range(MAX_CRAFTING_STEPS):\n    current_state = env._current_state\n    \n    # If the target item is successfully crafted, return the total reward.\n    if current_state.inventory[item_idx] > 0:\n      return total_reward\n\n    # Ensure there is a workshop associated with this item\n    if main_workshop_idx is None:\n      return total_reward\n\n    # Find the workshop on the grid\n    workshop_pos = None\n    min_dist_to_workshop = float('inf')\n    for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n        if grid[x_grid, y_grid, main_workshop_idx] == 1:\n          dist = abs(x_grid - current_state.pos[0]) + abs(y_grid - current_state.pos[1])\n          if dist < min_dist_to_workshop:\n            min_dist_to_workshop = dist\n            workshop_pos = (x_grid, y_grid)\n    \n    # If the workshop is not found on the map, cannot complete craft\n    if workshop_pos is None:\n      return total_reward\n\n    # Move towards the workshop\n    wx, wy = workshop_pos\n    cx, cy = current_state.pos\n\n    # Check if agent is adjacent to the workshop\n    is_adjacent_to_workshop = False\n    for dx, dy in [(0, -1), (0, 1), (-1, 0), (1, 0)]:\n      if cx + dx == wx and cy + dy == wy:\n        is_adjacent_to_workshop = True\n        break\n    \n    if not is_adjacent_to_workshop:\n      # If not adjacent, move closer to the workshop\n      action_to_take = -1\n      if cx < wx: action_to_take = RIGHT\n      elif cx > wx: action_to_take = LEFT\n      elif cy < wy: action_to_take = UP\n      elif cy > wy: action_to_take = DOWN\n      \n      if action_to_take != -1:\n        reward, new_state = env.step(action_to_take)\n        total_reward += reward\n        env._current_state = new_state\n    else: # Agent is adjacent to the workshop\n      # First, ensure agent is facing the workshop\n      target_dir = -1\n      if cx == wx and cy + 1 == wy: target_dir = UP\n      elif cx == wx and cy - 1 == wy: target_dir = DOWN\n      elif cx + 1 == wx and cy == wy: target_dir = RIGHT\n      elif cx - 1 == wx and cy == wy: target_dir = LEFT\n\n      if target_dir != -1:\n        reward, new_state = env.step(target_dir) # Face the workshop\n        total_reward += reward\n        env._current_state = new_state\n        \n        # Now perform the USE action to trigger crafting\n        reward, new_state = env.step(USE)\n        total_reward += reward\n        env._current_state = new_state\n      # else: unable to determine facing direction.\n\n  # If the loop finishes without crafting the item (e.g., ran out of steps or stuck)\n  return total_reward", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:52:23.989890", "function_name": "craft", "function_body": "    total_reward = 0.0\n    cookbook = env.world.cookbook\n    item_idx = cookbook.index[item]\n\n    # Get workshop information for the item\n    recipe = cookbook.recipes.get(item_idx)\n    if not recipe:\n        # If item is not in recipes, it cannot be crafted\n        return total_reward\n\n    workshop_name = recipe.get(\"_at\")\n    if not workshop_name:\n        # If the recipe doesn't specify a workshop, this function does not handle it.\n        # This is for items crafted at a specific workshop station.\n        return total_reward\n\n    workshop_idx = cookbook.index[workshop_name]\n\n    # Find the workshop's coordinates on the global grid\n    workshop_pos = None\n    current_grid = env._current_state.grid\n    grid_width, grid_height, _ = current_grid.shape\n\n    for x in range(grid_width):\n        for y in range(grid_height):\n            if current_grid[x, y, workshop_idx] == 1:\n                workshop_pos = (x, y)\n                break\n        if workshop_pos:\n            break\n\n    if not workshop_pos:\n        # Workshop not found in the current grid, cannot craft\n        return total_reward\n\n    # Action constants (from craft_world.py)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Loop for movement and crafting until the item is obtained or environment is done\n    done = False\n    while not done:\n        current_state = env._current_state\n        current_pos = current_state.pos\n        current_dir = current_state.dir\n        current_inventory = current_state.inventory\n\n        # Check if the desired item is already in the inventory\n        if current_inventory[item_idx] > 0:\n            break  # Item successfully crafted or already present\n\n        # Determine the relative position of the workshop to the agent\n        dx_workshop = workshop_pos[0] - current_pos[0]\n        dy_workshop = workshop_pos[1] - current_pos[1]\n\n        action_to_take = None\n\n        # Check if agent is directly adjacent to the workshop and facing it\n        # Workshop is to the RIGHT of agent\n        if dx_workshop == 1 and dy_workshop == 0:\n            if current_dir == RIGHT:\n                action_to_take = USE\n            else:\n                action_to_take = RIGHT # Turn by attempting to move into it\n        # Workshop is to the LEFT of agent\n        elif dx_workshop == -1 and dy_workshop == 0:\n            if current_dir == LEFT:\n                action_to_take = USE\n            else:\n                action_to_take = LEFT # Turn by attempting to move into it\n        # Workshop is UP (North) from agent\n        elif dx_workshop == 0 and dy_workshop == 1:\n            if current_dir == UP:\n                action_to_take = USE\n            else:\n                action_to_take = UP # Turn by attempting to move into it\n        # Workshop is DOWN (South) from agent\n        elif dx_workshop == 0 and dy_workshop == -1:\n            if current_dir == DOWN:\n                action_to_take = USE\n            else:\n                action_to_take = DOWN # Turn by attempting to move into it\n\n        if action_to_take is None:\n            # Agent is not adjacent to the workshop, needs to move closer\n            if dx_workshop != 0:\n                action_to_take = RIGHT if dx_workshop > 0 else LEFT\n            elif dy_workshop != 0:\n                action_to_take = UP if dy_workshop > 0 else DOWN\n            else:\n                # This case implies agent is at workshop_pos, which should be impossible\n                # as workshops are not traversable. Or agent is completely blocked.\n                # Break to prevent an infinite loop.\n                break\n\n        # Execute the determined action\n        r, done, obs = env.step(action_to_take)\n        total_reward += r\n\n        # If the environment signals done (e.g., max_steps reached), stop\n        if done:\n            break\n\n    return total_reward", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-24T08:52:24.011014", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    # Define action constants, assuming they are available in the scope where this function is executed\n    # If not, they would need to be imported or defined globally, but the request implies no code outside.\n    # Therefore, we re-define them here for clarity and self-containment within the function body.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Convert the item name string (e.g., \"PLANK\") to its internal numerical index\n    target_item_idx = env.world.cookbook.index[item.lower()]\n    \n    # Get the crafting recipe for the target item to identify its crafting station\n    recipe = env.world.cookbook.recipes[target_item_idx]\n    crafting_station_name = recipe[\"_at\"]\n    crafting_station_idx = env.world.cookbook.index[crafting_station_name]\n\n    # Get the list of primitive ingredients (and their quantities) needed for the target item\n    # This recursively breaks down complex items into their base primitive components.\n    needed_primitives = env.world.cookbook.primitives_for(target_item_idx)\n\n    # Main loop: Continue taking actions until the target item is successfully crafted\n    # (i.e., appears in the agent's inventory) or the maximum allowed steps are reached.\n    while not env._current_state.satisfies(\"goal\", target_item_idx) and env.steps < env.max_steps:\n        current_state = env._current_state\n        current_grid = current_state.grid\n        current_pos = current_state.pos\n        current_inventory = current_state.inventory\n        \n        action_performed_this_step = False\n\n        # Phase 1: Prioritize collecting any missing ingredients.\n        # Iterate through the required primitive ingredients.\n        for ing_idx, count_needed in needed_primitives.items():\n            if current_inventory[ing_idx] < count_needed: # If this ingredient is still needed\n                # Find all locations of this missing ingredient on the current grid\n                ing_locations = np.argwhere(current_grid[:, :, ing_idx] == 1)\n                \n                if ing_locations.size > 0:\n                    # For simplicity, pick the first available location of the ingredient\n                    target_x, target_y = ing_locations[0]\n                    \n                    # Check if the agent is currently adjacent to this ingredient\n                    is_adjacent_to_ingredient = False\n                    for nx, ny in neighbors(current_pos):\n                        if (nx, ny) == (target_x, target_y):\n                            is_adjacent_to_ingredient = True\n                            break\n\n                    if is_adjacent_to_ingredient:\n                        # If adjacent, use the \"USE\" action to pick up the ingredient\n                        reward, done, _ = env.step(USE)\n                        total_reward += reward\n                        action_performed_this_step = True\n                        break # An action was performed, re-evaluate the state and loop conditions\n                    else:\n                        # If not adjacent, move towards the ingredient\n                        px, py = current_pos\n                        move_action = None\n                        if px < target_x: # Target is to the right\n                            move_action = RIGHT\n                        elif px > target_x: # Target is to the left\n                            move_action = LEFT\n                        elif py < target_y: # Target is up\n                            move_action = UP\n                        elif py > target_y: # Target is down\n                            move_action = DOWN\n                        \n                        if move_action is not None:\n                            reward, done, _ = env.step(move_action)\n                            total_reward += reward\n                            action_performed_this_step = True\n                            break # An action was performed, re-evaluate the state and loop conditions\n\n        if action_performed_this_step:\n            continue # If an action was taken, restart the loop to re-evaluate the current state\n\n        # Phase 2: If all ingredients are collected, move to the crafting station and use it.\n        all_ingredients_in_inventory = True\n        for ing_idx, count_needed in needed_primitives.items():\n            if current_inventory[ing_idx] < count_needed:\n                all_ingredients_in_inventory = False\n                break\n\n        if all_ingredients_in_inventory:\n            # Find all locations of the required crafting station on the grid\n            station_locations = np.argwhere(current_grid[:, :, crafting_station_idx] == 1)\n            \n            if station_locations.size > 0:\n                # Pick the first available crafting station location\n                target_x, target_y = station_locations[0]\n                \n                # Check if the agent is currently adjacent to the crafting station\n                is_adjacent_to_station = False\n                for nx, ny in neighbors(current_pos):\n                    if (nx, ny) == (target_x, target_y):\n                        is_adjacent_to_station = True\n                        break\n\n                if is_adjacent_to_station:\n                    # If adjacent, use the \"USE\" action to craft the item\n                    reward, done, _ = env.step(USE)\n                    total_reward += reward\n                    action_performed_this_step = True\n                else:\n                    # If not adjacent, move towards the crafting station\n                    px, py = current_pos\n                    move_action = None\n                    if px < target_x:\n                        move_action = RIGHT\n                    elif px > target_x:\n                        move_action = LEFT\n                    elif py < target_y:\n                        move_action = UP\n                    elif py > target_y:\n                        move_action = DOWN\n                    \n                    if move_action is not None:\n                        reward, done, _ = env.step(move_action)\n                        total_reward += reward\n                        action_performed_this_step = True\n        \n        # If no productive action (collecting or crafting) was performed in this step,\n        # it indicates that the agent might be stuck (e.g., path blocked), or cannot find\n        # what it needs on the map, or all prerequisites are fulfilled but crafting failed.\n        # In such cases, break the loop to prevent an infinite loop.\n        if not action_performed_this_step:\n            break\n\n    return total_reward", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-24T08:52:54.897120", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Define constants from the environment logic\n  WIDTH = 12\n  HEIGHT = 12\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # 1. Get the integer index for the target item\n  target_item_idx = env.world.cookbook.index[item]\n\n  # 2. Retrieve the recipe for the target item from the cookbook\n  recipe = env.world.cookbook.recipes.get(target_item_idx)\n  if recipe is None:\n    # Item cannot be crafted (e.g., it's a primitive or unknown)\n    return total_reward\n\n  # 3. Identify the required crafting station (workshop) from the recipe\n  if \"_at\" not in recipe:\n    # Recipe doesn't specify a crafting station, or it's a primitive.\n    return total_reward \n\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # 4. Find the exact coordinates of the workshop on the grid\n  workshop_pos = None\n  grid = env._current_state.grid\n  for x_grid in range(WIDTH):\n    for y_grid in range(HEIGHT):\n      # Check if the workshop index is at this grid position\n      if grid[x_grid, y_grid, workshop_idx] == 1:\n        workshop_pos = (x_grid, y_grid)\n        break\n    if workshop_pos:\n      break\n\n  if not workshop_pos:\n    # Workshop not found in the current grid, cannot craft.\n    return total_reward\n\n  # 5. Determine a suitable adjacent position for the agent to stand for crafting\n  target_agent_pos = None\n  wx, wy = workshop_pos\n  # Define possible relative positions (neighbors) around the workshop\n  # (dx, dy) where dx, dy are relative to the workshop's position\n  possible_relative_agent_positions = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n  \n  for dx, dy in possible_relative_agent_positions:\n    nx, ny = wx + dx, wy + dy\n    # Check if the potential position is within grid boundaries\n    if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n      # Check if the spot is empty (no other object, including boundary, is there)\n      # A spot is empty if the sum of all item counts at that spot is 0.\n      if np.sum(grid[nx, ny, :]) == 0:\n        target_agent_pos = (nx, ny)\n        break\n\n  if not target_agent_pos:\n    # No empty spot found next to the workshop.\n    return total_reward\n\n  # 6. Move the agent to the `target_agent_pos`\n  current_agent_pos = env._current_state.pos\n  # Max attempts to prevent infinite loops, generous enough for small maps\n  max_move_attempts = WIDTH * HEIGHT * 2 \n\n  attempts = 0\n  while current_agent_pos != target_agent_pos and attempts < max_move_attempts:\n    ax, ay = current_agent_pos\n    tx, ty = target_agent_pos\n\n    action_to_take = -1 \n    \n    # Simple pathfinding: prioritize moving horizontally, then vertically.\n    # This might not be optimal but should get the agent there if reachable.\n    if tx > ax: \n      action_to_take = RIGHT\n    elif tx < ax: \n      action_to_take = LEFT\n    elif ty > ay: \n      action_to_take = UP\n    elif ty < ay: \n      action_to_take = DOWN\n    else:\n      # Agent is already at the target_agent_pos or no clear path.\n      break \n\n    if action_to_take != -1:\n      reward, done, obs = env.step(action_to_take)\n      total_reward += reward\n      if done: \n        return total_reward\n      \n      current_agent_pos = env._current_state.pos \n    else:\n      # No valid action could move the agent closer, likely stuck.\n      break\n    \n    attempts += 1 \n\n  # If agent failed to reach the target position after attempts\n  if current_agent_pos != target_agent_pos:\n      return total_reward\n\n  # 7. Orient the agent to face the workshop\n  ax, ay = current_agent_pos\n  wx, wy = workshop_pos\n\n  direction_to_face = -1\n  if wx == ax - 1 and wy == ay: # Workshop is to the left of agent\n    direction_to_face = LEFT\n  elif wx == ax + 1 and wy == ay: # Workshop is to the right of agent\n    direction_to_face = RIGHT\n  elif wy == ay - 1 and wx == ax: # Workshop is below agent\n    direction_to_face = DOWN\n  elif wy == ay + 1 and wx == ax: # Workshop is above agent\n    direction_to_face = UP\n\n  if direction_to_face != -1 and env._current_state.dir != direction_to_face:\n    reward, done, obs = env.step(direction_to_face)\n    total_reward += reward\n    if done: \n      return total_reward\n\n  # 8. Perform the USE action to craft the item\n  reward, done, obs = env.step(USE)\n  total_reward += reward\n  if done: \n    return total_reward\n\n  return total_reward", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:52:55.949975", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Define constants from the environment logic\n  WIDTH = 12\n  HEIGHT = 12\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # 1. Get the integer index for the target item\n  target_item_idx = env.world.cookbook.index[item]\n\n  # 2. Retrieve the recipe for the target item from the cookbook\n  if target_item_idx not in env.world.cookbook.recipes:\n    # Item cannot be crafted or no recipe defined.\n    # This might happen if trying to \"craft\" a primitive resource.\n    return total_reward\n\n  recipe = env.world.cookbook.recipes[target_item_idx]\n\n  # 3. Identify the required crafting station (workshop) from the recipe\n  if \"_at\" not in recipe:\n    # If the recipe doesn't specify a \"_at\" location, it's not crafted at a workshop.\n    # For this function, we assume \"craft\" implies using a station.\n    return total_reward \n\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # 4. Find the exact coordinates of the workshop on the grid\n  workshop_pos = None\n  grid = env._current_state.grid\n  for x_grid in range(WIDTH):\n    for y_grid in range(HEIGHT):\n      if grid[x_grid, y_grid, workshop_idx] == 1:\n        workshop_pos = (x_grid, y_grid)\n        break\n    if workshop_pos:\n      break\n\n  if not workshop_pos:\n    # Workshop not found in the current grid, cannot craft.\n    return total_reward\n\n  # 5. Determine a suitable adjacent position for the agent to stand for crafting\n  target_agent_pos = None\n  wx, wy = workshop_pos\n  # Define possible relative positions (neighbors) around the workshop\n  # These are potential spots for the agent to stand.\n  possible_relative_agent_positions = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n  \n  for dx, dy in possible_relative_agent_positions:\n    nx, ny = wx + dx, wy + dy\n    # Check if the potential position is within grid boundaries\n    if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n      # Check if the spot is empty (no other object, including boundary, is there)\n      # grid[..., :].any() checks if any kind of item is at that cell.\n      # We need it to be completely empty for the agent to move there.\n      if not grid[nx, ny, :].any(): \n        target_agent_pos = (nx, ny)\n        break\n\n  if not target_agent_pos:\n    # No empty spot found next to the workshop where the agent can stand.\n    return total_reward\n\n  # 6. Move the agent to the `target_agent_pos`\n  current_agent_pos = env._current_state.pos\n  # Set a reasonable maximum number of steps to prevent infinite loops in complex scenarios.\n  max_move_attempts = WIDTH * HEIGHT * 2 \n\n  attempts = 0\n  while current_agent_pos != target_agent_pos and attempts < max_move_attempts:\n    ax, ay = current_agent_pos\n    tx, ty = target_agent_pos\n\n    action_to_take = -1 \n    \n    # Simple pathfinding strategy: prioritize horizontal movement, then vertical.\n    # This might not find the shortest path but should eventually reach the target if reachable.\n    if tx > ax: \n      action_to_take = RIGHT\n    elif tx < ax: \n      action_to_take = LEFT\n    elif ty > ay: \n      action_to_take = UP\n    elif ty < ay: \n      action_to_take = DOWN\n    else:\n      # Agent is already at the target_agent_pos or cannot move further.\n      break \n\n    if action_to_take != -1:\n      reward, done, obs = env.step(action_to_take)\n      total_reward += reward\n      if done: \n        # If the environment signals \"done\" (e.g., max steps reached, goal achieved),\n        # stop and return current reward.\n        return total_reward\n      \n      # Update current_agent_pos based on the actual new state.\n      current_agent_pos = env._current_state.pos \n    else:\n      # No valid action could move the agent closer, likely stuck or already there.\n      break\n    \n    attempts += 1 \n\n  # If agent failed to reach the target position after attempts\n  if current_agent_pos != target_agent_pos:\n      return total_reward\n\n  # 7. Orient the agent to face the workshop\n  ax, ay = current_agent_pos\n  wx, wy = workshop_pos\n\n  direction_to_face = -1\n  if wx == ax - 1 and wy == ay: # Workshop is to the left\n    direction_to_face = LEFT\n  elif wx == ax + 1 and wy == ay: # Workshop is to the right\n    direction_to_face = RIGHT\n  elif wy == ay - 1 and wx == ax: # Workshop is below (y-1 means south/down in game coordinates)\n    direction_to_face = DOWN\n  elif wy == ay + 1 and wx == ax: # Workshop is above (y+1 means north/up in game coordinates)\n    direction_to_face = UP\n\n  # Only step if the agent is not already facing the correct direction\n  if direction_to_face != -1 and env._current_state.dir != direction_to_face:\n    reward, done, obs = env.step(direction_to_face)\n    total_reward += reward\n    if done: \n      return total_reward\n\n  # 8. Perform the USE action to craft the item\n  reward, done, obs = env.step(USE)\n  total_reward += reward\n  if done: \n    return total_reward\n\n  return total_reward", "island_id": 7, "scores": {"3": 0.0}}
