{"timestamp": "2025-07-23T23:17:18.978088", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  item_idx = env.world.cookbook.index[item]\n\n  # If goal item is already in inventory, no crafting needed\n  if env._current_state.inventory[item_idx] > 0:\n    return 0.0\n\n  # Get recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if not recipe:\n    return 0.0  # Cannot craft this item\n\n  required_ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  workshop_name = recipe.get('_at')\n  workshop_idx = None\n  if workshop_name:\n    workshop_idx = env.world.cookbook.index[workshop_name]\n\n  boundary_idx = env.world.cookbook.index[\"boundary\"]\n\n  # Map (dx, dy) to action for movement. These also define the direction the agent faces.\n  action_map_movement = {\n      (0, 1): env.action_specs['UP'],\n      (0, -1): env.action_specs['DOWN'],\n      (-1, 0): env.action_specs['LEFT'],\n      (1, 0): env.action_specs['RIGHT'],\n  }\n\n  # Iterate through needed ingredients and collect them\n  # Loop as long as we still need ingredients and can find them\n  # A `while True` with break conditions handles collecting multiple of one item\n  # and iterating over different ingredients.\n  collected_any_item_in_loop = True\n  while collected_any_item_in_loop:\n    collected_any_item_in_loop = False\n    \n    # Check if all ingredients are met. If so, break this collection phase.\n    all_ingredients_met_for_craft = True\n    for ing_check_idx, ing_check_count in required_ingredients.items():\n        if env._current_state.inventory[ing_check_idx] < ing_check_count:\n            all_ingredients_met_for_craft = False\n            break\n    if all_ingredients_met_for_craft:\n        break # All ingredients collected, proceed to crafting\n\n    for ing_idx, needed_count_for_craft in required_ingredients.items():\n      if env._current_state.inventory[ing_idx] < needed_count_for_craft:\n        current_grid = env._current_state.grid\n        current_agent_pos = env._current_state.pos\n\n        # Find the ingredient on the grid\n        ing_locs = np.argwhere(current_grid[:, :, ing_idx] == 1)\n        if ing_locs.size == 0:\n          continue # Ingredient not found on grid, skip to next ingredient\n\n        # Find the closest ingredient location\n        target_ing_pos = None\n        min_dist = float('inf')\n        for loc_arr in ing_locs:\n            loc = tuple(loc_arr)\n            dist = abs(loc[0] - current_agent_pos[0]) + abs(loc[1] - current_agent_pos[1])\n            if dist < min_dist:\n                min_dist = dist\n                target_ing_pos = loc\n        \n        if not target_ing_pos: # Should not happen if ing_locs was not empty\n            continue\n\n        # Determine the adjacent position for the agent and the direction to face the ingredient\n        # (adj_pos, dir_to_face_target_action)\n        candidate_interaction_points = [\n            ((target_ing_pos[0] - 1, target_ing_pos[1]), env.action_specs['RIGHT']),\n            ((target_ing_pos[0] + 1, target_ing_pos[1]), env.action_specs['LEFT']),\n            ((target_ing_pos[0], target_ing_pos[1] - 1), env.action_specs['UP']),\n            ((target_ing_pos[0], target_ing_pos[1] + 1), env.action_specs['DOWN'])\n        ]\n\n        best_target_adj_pos = None\n        best_interaction_dir = None\n        min_path_len = float('inf')\n        best_path_actions = []\n\n        # BFS to find shortest path to an adjacent cell, ending with correct direction\n        # State: (current_position, current_direction, path_taken)\n        queue = collections.deque([(current_agent_pos, env._current_state.dir, [])])\n        visited = {(current_agent_pos, env._current_state.dir)}\n        \n        # Max path length to prevent very long searches (e.g., if path is blocked)\n        max_bfs_path_length = 2 * (env.world.WIDTH + env.world.HEIGHT) \n\n        while queue:\n            (cx, cy), c_dir, path = queue.popleft()\n\n            if len(path) > min_path_len: # Prune paths that are already longer than the best found\n                continue\n            \n            # Check if this state is a valid interaction point for any candidate\n            for (tx, ty), required_interaction_dir in candidate_interaction_points:\n                if (cx, cy) == (tx, ty) and c_dir == required_interaction_dir:\n                    # Found a path to a valid interaction point\n                    if len(path) < min_path_len:\n                        min_path_len = len(path)\n                        best_target_adj_pos = (cx, cy)\n                        best_interaction_dir = required_interaction_dir\n                        best_path_actions = path\n                    \n            if len(path) >= max_bfs_path_length: # Limit overall search depth\n                continue\n\n            # Explore neighbors\n            for action_val, next_dx, next_dy in [(env.action_specs['UP'], 0, 1), \n                                                (env.action_specs['DOWN'], 0, -1),\n                                                (env.action_specs['LEFT'], -1, 0),\n                                                (env.action_specs['RIGHT'], 1, 0)]:\n                nx, ny = cx + next_dx, cy + next_dy\n                \n                # Check bounds and boundary obstacle\n                if not (0 <= nx < env.world.WIDTH and 0 <= ny < env.world.HEIGHT):\n                    continue\n                if current_grid[nx, ny, boundary_idx] == 1:\n                    continue\n                \n                # Agent can only move into empty cells. `is_grabbable_target` is not needed here\n                # because the path is to an *adjacent* empty cell.\n                if current_grid[nx, ny, :].sum() > 0:\n                    continue # Cell is occupied by a non-boundary object\n\n                new_state_tuple = ((nx, ny), action_val) # new_pos, new_dir\n                if new_state_tuple not in visited:\n                    visited.add(new_state_tuple)\n                    queue.append(((nx, ny), action_val, path + [action_val]))\n        \n        # If a path was found, execute it\n        if best_path_actions:\n            for action in best_path_actions:\n                reward, done, obs = env.step(action)\n                total_reward += reward\n                if done: return total_reward\n            \n            # After moving and setting direction, USE to collect\n            reward, done, obs = env.step(env.action_specs()['USE'])\n            total_reward += reward\n            if done: return total_reward\n            \n            # If we picked something up, mark that we collected something\n            # and restart the outer loop to re-evaluate ingredient needs and search.\n            if env._current_state.inventory[ing_idx] > needed_count_for_craft - 1: # Check if inventory increased\n                collected_any_item_in_loop = True\n                break # Break from this ingredient loop, outer loop will re-check all ingredients.\n    \n    if not collected_any_item_in_loop and not all_ingredients_met_for_craft:\n      # If no items were collected in this full pass and we still need ingredients, we are stuck.\n      # Cannot collect all ingredients, give up.\n      return total_reward", "island_id": 4, "scores": {"3": -1}}
