{"timestamp": "2025-07-23T21:25:51.521616", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    item_idx = env.world.cookbook.index[item]\n\n    # Check if item is already in inventory\n    current_inventory = env.observations()['features_dict']['inventory']\n    if current_inventory[item_idx] > 0:\n        return total_reward\n\n    recipe = env.world.cookbook.recipes.get(item_idx)\n\n    # If the item is a primitive, it means we need to \"collect\" it directly from the environment.\n    # The DSL's CRAFT_FUNC is being asked, but if the \"item\" is a primitive, it effectively acts as a collect.\n    if not recipe and item_idx in env.world.cookbook.primitives:\n        target_item_idx = item_idx\n        \n        # Loop until the item is collected or no longer found on the grid/stuck\n        while env.observations()['features_dict']['inventory'][target_item_idx] == 0:\n            obs = env.observations()\n            global_grid = obs['features_dict']['features_global']\n            player_x, player_y = env._current_state.pos\n\n            # Find closest instance of the target item on the grid\n            closest_pos = None\n            min_dist = float('inf')\n            for x_coord in range(env._width):\n                for y_coord in range(env._height):\n                    if global_grid[x_coord, y_coord, target_item_idx] == 1:\n                        dist = abs(x_coord - player_x) + abs(y_coord - player_y)\n                        if dist < min_dist:\n                            min_dist = dist\n                            closest_pos = (x_coord, y_coord)\n            \n            if closest_pos is None: # Item not found on grid (all collected or none existed)\n                return total_reward # Cannot collect\n\n            target_x, target_y = closest_pos\n            \n            initial_player_pos = env._current_state.pos\n            moved_this_step = False\n            \n            # Simple greedy movement towards the target\n            action_to_move = None\n            if target_x > player_x:\n                action_to_move = env.action_specs()['RIGHT']\n            elif target_x < player_x:\n                action_to_move = env.action_specs()['LEFT']\n            elif target_y > player_y:\n                action_to_move = env.action_specs()['UP']\n            elif target_y < player_y:\n                action_to_move = env.action_specs()['DOWN']\n            \n            if action_to_move is not None:\n                r, d, o = env.step(action_to_move)\n                total_reward += r\n                if d or env.steps >= env.max_steps: return total_reward\n                if env._current_state.pos != initial_player_pos:\n                    moved_this_step = True\n            \n            # If adjacent to item after movement (or if no movement needed but already adjacent)\n            if env._current_state.next_to(target_item_idx):\n                # Orient to face the item before using\n                px, py = env._current_state.pos\n                face_action = None\n                for nx, ny in [(px-1,py), (px+1,py), (px,py-1), (px,py+1)]:\n                    if 0 <= nx < env._width and 0 <= ny < env._height and global_grid[nx, ny, target_item_idx] == 1:\n                        if nx == px - 1: face_action = env.action_specs()['LEFT']\n                        elif nx == px + 1: face_action = env.action_specs()['RIGHT']\n                        elif ny == py - 1: face_action = env.action_specs()['DOWN']\n                        elif ny == py + 1: face_action = env.action_specs()['UP']\n                        break\n                \n                if face_action is not None and env._current_state.dir != face_action:\n                    r, d, o = env.step(face_action)\n                    total_reward += r\n                    if d or env.steps >= env.max_steps: return total_reward\n\n                # Now USE to pick up\n                initial_item_count_before_use = env.observations()['features_dict']['inventory'][target_item_idx]\n                r, d, o = env.step(env.action_specs()['USE'])\n                total_reward += r\n                if d or env.steps >= env.max_steps: return total_reward\n                \n                if env.observations()['features_dict']['inventory'][target_item_idx] > initial_item_count_before_use:\n                    return total_reward # Successfully collected the primitive\n                else:\n                    # Failed to pick up, possibly due to a barrier, wrong direction, or item isn't grabbable.\n                    return total_reward # Cannot collect, stuck or impossible.\n            \n            # If no movement occurred and not adjacent, agent is stuck or cannot reach.\n            if not moved_this_step and not env._current_state.next_to(target_item_idx):\n                return total_reward # Stuck or cannot reach item\n\n        # If loop finishes, item was collected.\n        return total_reward\n\n    # If it's a craftable item (has a recipe)\n    if not recipe: # No recipe found and not a primitive, means invalid craft request for this function.\n        return total_reward\n\n    ingredients = {idx: count for idx, count in recipe.items() if isinstance(idx, int)}\n    workshop_name = recipe.get('_at')\n    workshop_idx = env.world.cookbook.index[workshop_name] if workshop_name else None\n\n    # Step 1: Collect all necessary ingredients\n    for ing_idx, required_count in ingredients.items():\n        while env.observations()['features_dict']['inventory'][ing_idx] < required_count:\n            obs = env.observations()\n            global_grid = obs['features_dict']['features_global']\n            player_x, player_y = env._current_state.pos\n\n            # Find closest instance of the ingredient on the grid\n            closest_pos = None\n            min_dist = float('inf')\n            for x_coord in range(env._width):\n                for y_coord in range(env._height):\n                    if global_grid[x_coord, y_coord, ing_idx] == 1:\n                        dist = abs(x_coord - player_x) + abs(y_coord - player_y)\n                        if dist < min_dist:\n                            min_dist = dist\n                            closest_pos = (x_coord, y_coord)\n            \n            if closest_pos is None: # Ingredient not found on grid\n                return total_reward # Cannot collect more of this ingredient\n\n            target_x, target_y = closest_pos\n            \n            initial_player_pos = env._current_state.pos\n            moved_this_step = False\n\n            # Movement logic\n            action_to_move = None\n            if target_x > player_x:\n                action_to_move = env.action_specs()['RIGHT']\n            elif target_x < player_x:\n                action_to_move = env.action_specs()['LEFT']\n            elif target_y > player_y:\n                action_to_move = env.action_specs()['UP']\n            elif target_y < player_y:\n                action_to_move = env.action_specs()['DOWN']\n            \n            if action_to_move is not None:\n                r, d, o = env.step(action_to_move)\n                total_reward += r\n                if d or env.steps >= env.max_steps: return total_reward\n                if env._current_state.pos != initial_player_pos:\n                    moved_this_step = True\n            \n            # If adjacent, attempt to USE\n            if env._current_state.next_to(ing_idx):\n                px, py = env._current_state.pos\n                face_action = None\n                for nx, ny in [(px-1,py), (px+1,py), (px,py-1), (px,py+1)]:\n                    if 0 <= nx < env._width and 0 <= ny < env._height and global_grid[nx, ny, ing_idx] == 1:\n                        if nx == px - 1: face_action = env.action_specs()['LEFT']\n                        elif nx == px + 1: face_action = env.action_specs()['RIGHT']\n                        elif ny == py - 1: face_action = env.action_specs()['DOWN']\n                        elif ny == py + 1: face_action = env.action_specs()['UP']\n                        break\n                \n                if face_action is not None and env._current_state.dir != face_action:\n                    r, d, o = env.step(face_action)\n                    total_reward += r\n                    if d or env.steps >= env.max_steps: return total_reward\n\n                initial_ing_count = env.observations()['features_dict']['inventory'][ing_idx]\n                r, d, o = env.step(env.action_specs()['USE'])\n                total_reward += r\n                if d or env.steps >= env.max_steps: return total_reward\n                \n                if not (env.observations()['features_dict']['inventory'][ing_idx] > initial_ing_count):\n                    # Failed to pick up after USE, stuck for this ingredient.\n                    return total_reward \n            \n            # If no movement occurred and not adjacent, then stuck\n            if not moved_this_step and not env._current_state.next_to(ing_idx):\n                return total_reward # Stuck or cannot reach ingredient\n\n    # Step 2: Move to workshop if required by the recipe\n    if workshop_idx is not None:\n        while not env._current_state.next_to(workshop_idx):\n            obs = env.observations()\n            global_grid = obs['features_dict']['features_global']\n            player_x, player_y = env._current_state.pos\n\n            # Find closest workshop\n            closest_pos = None\n            min_dist = float('inf')\n            for x_coord in range(env._width):\n                for y_coord in range(env._height):\n                    if global_grid[x_coord, y_coord, workshop_idx] == 1:\n                        dist = abs(x_coord - player_x) + abs(y_coord - player_y)\n                        if dist < min_dist:\n                            min_dist = dist\n                            closest_pos = (x_coord, y_coord)\n            \n            if closest_pos is None: # Workshop not found\n                return total_reward # Cannot craft without workshop\n\n            target_x, target_y = closest_pos\n            \n            initial_player_pos = env._current_state.pos\n            moved_this_step = False\n\n            # Movement logic\n            action_to_move = None\n            if target_x > player_x:\n                action_to_move = env.action_specs()['RIGHT']\n            elif target_x < player_x:\n                action_to_move = env.action_specs()['LEFT']\n            elif target_y > player_y:\n                action_to_move = env.action_specs()['UP']\n            elif target_y < player_y:\n                action_to_move = env.action_specs()['DOWN']\n\n            if action_to_move is not None:\n                r, d, o = env.step(action_to_move)\n                total_reward += r\n                if d or env.steps >= env.max_steps: return total_reward\n                if env._current_state.pos != initial_player_pos:\n                    moved_this_step = True\n            \n            # If no movement occurred and not adjacent, then stuck\n            if not moved_this_step and not env._current_state.next_to(workshop_idx):\n                return total_reward # Stuck or cannot reach workshop\n\n    # Step 3: Perform crafting (USE action)\n    initial_item_count_final = env.observations()['features_dict']['inventory'][item_idx]\n    \n    # If workshop exists, agent should be adjacent. Orient to face it.\n    if workshop_idx is not None:\n        px, py = env._current_state.pos\n        face_action = None\n        obs = env.observations()\n        global_grid = obs['features_dict']['features_global'] # Re-fetch updated grid\n        \n        for nx, ny in [(px-1,py), (px+1,py), (px,py-1), (px,py+1)]:\n            if 0 <= nx < env._width and 0 <= ny < env._height and global_grid[nx, ny, workshop_idx] == 1:\n                if nx == px - 1: face_action = env.action_specs()['LEFT']\n                elif nx == px + 1: face_action = env.action_specs()['RIGHT']\n                elif ny == py - 1: face_action = env.action_specs()['DOWN']\n                elif ny == py + 1: face_action = env.action_specs()['UP']\n                break\n        \n        if face_action is not None and env._current_state.dir != face_action:\n            r, d, o = env.step(face_action)\n            total_reward += r\n            if d or env.steps >= env.max_steps: return total_reward\n\n    r, d, o = env.step(env.action_specs()['USE'])\n    total_reward += r\n    if d or env.steps >= env.max_steps: return total_reward\n    \n    # Check if item was successfully crafted\n    if env.observations()['features_dict']['inventory'][item_idx] > initial_item_count_final:\n        return total_reward # Successfully crafted\n    else:\n        # Crafting failed for some reason (e.g., ingredients used up but not enough to craft,\n        # or agent not correctly positioned/oriented).\n        return total_reward", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-23T21:25:51.539919", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    # 1. Get item ID\n    # Assuming env.world.cookbook.index is available and correctly indexed.\n    item_id = env.world.cookbook.index[item]\n\n    # 2. Check if already has item\n    if env._current_state.inventory[item_id] > 0:\n        # Item already crafted, no need to do anything.\n        # Returning 0.0, as the goal is typically to produce it if not already present.\n        return total_reward\n\n    # 3. Get recipe details\n    # Ensure the item is craftable (has a recipe)\n    if item_id not in env.world.cookbook.recipes:\n        return total_reward # Cannot craft, so no reward\n\n    recipe = env.world.cookbook.recipes[item_id]\n\n    # Check for \"_at\" key which indicates the required crafting station\n    if \"_at\" not in recipe:\n        return total_reward # Cannot craft without a station\n\n    workshop_name = recipe[\"_at\"]\n    workshop_id = env.world.cookbook.index[workshop_name]\n\n    # 4. Find workshop location on the current grid\n    current_grid = env._current_state.grid\n    WIDTH, HEIGHT = current_grid.shape[0], current_grid.shape[1]\n    workshop_pos = None\n    for x in range(WIDTH):\n        for y in range(HEIGHT):\n            if current_grid[x, y, workshop_id] == 1:\n                workshop_pos = (x, y)\n                break\n        if workshop_pos:\n            break\n\n    if not workshop_pos:\n        return total_reward # Workshop not present, cannot craft\n\n    # 5. Determine goal states for BFS (position, required_facing_direction)\n    # The agent needs to be in an empty cell adjacent to the workshop AND facing the workshop.\n    # Constants DOWN, UP, LEFT, RIGHT, USE are assumed to be globally defined.\n    \n    # Delta map for movement actions (dx, dy)\n    delta_map = {\n        DOWN: (0, -1),\n        UP: (0, 1),\n        LEFT: (-1, 0),\n        RIGHT: (1, 0)\n    }\n    \n    # This map gives the action/direction corresponding to a (dx, dy) vector\n    # e.g., (1,0) is RIGHT, (0,1) is UP, (-1,0) is LEFT, (0,-1) is DOWN\n    direction_from_delta = {\n        (0, -1): DOWN,\n        (0, 1): UP,\n        (-1, 0): LEFT,\n        (1, 0): RIGHT\n    }\n\n    goal_states = [] # List of ((agent_x, agent_y), required_agent_direction)\n\n    # Iterate through all 4 possible neighbor cells around the workshop\n    for agent_to_workshop_dir_key, (dx_relative_to_agent, dy_relative_to_agent) in delta_map.items():\n        # Calculate the potential agent position if it were a neighbor of the workshop\n        # If the workshop is at (wx, wy), and the agent needs to face (dx_agent_to_workshop, dy_agent_to_workshop)\n        # then the agent's position is (wx - dx_agent_to_workshop, wy - dy_agent_to_workshop)\n        \n        # The direction the agent must face to look at the workshop is simply the 'agent_to_workshop_dir_key'\n        # e.g., if workshop is to the agent's RIGHT, agent must face RIGHT.\n        required_agent_dir = agent_to_workshop_dir_key\n\n        # Calculate the actual (x,y) position of the agent given it must face 'required_agent_dir'\n        # and be next to the workshop. This means the agent's position is 'opposite' to the direction.\n        # e.g., if agent must face RIGHT (dx=1, dy=0), its position relative to workshop is (wx-1, wy).\n        potential_agent_pos = (workshop_pos[0] - dx_relative_to_agent, workshop_pos[1] - dy_relative_to_agent)\n        \n        # Check if potential_agent_pos is within bounds and is an empty/traversable cell\n        if (0 <= potential_agent_pos[0] < WIDTH and\n                0 <= potential_agent_pos[1] < HEIGHT and\n                not current_grid[potential_agent_pos[0], potential_agent_pos[1], :].any()):\n            goal_states.append((potential_agent_pos, required_agent_dir))\n\n    if not goal_states:\n        return total_reward # No traversable adjacent cells found, cannot reach workshop\n\n    # 6. BFS to find shortest path to a goal state\n    # collections.deque is assumed to be available\n    start_pos = env._current_state.pos\n    start_dir = env._current_state.dir # Initial direction\n    \n    # BFS state: ((current_pos_tuple, current_direction_int), list_of_actions_taken_so_far)\n    queue = collections.deque([((start_pos, start_dir), [])])\n    visited = {(start_pos, start_dir)} # Set of (position, direction) tuples to avoid cycles and redundant paths\n\n    best_path_actions = None\n\n    while queue:\n        (curr_pos, curr_dir), path_actions = queue.popleft()\n\n        # Check if current state is a goal state\n        if (curr_pos, curr_dir) in goal_states:\n            best_path_actions = path_actions\n            break # Found shortest path\n\n        # Explore possible moves\n        for action in [DOWN, UP, LEFT, RIGHT]:\n            dx, dy = delta_map[action]\n            next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n            next_pos = (next_x, next_y)\n            next_dir = action # Agent's direction changes to the direction of the move\n\n            # Check bounds\n            if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                continue\n            # Check if target cell is traversable (empty).\n            # The environment's step function automatically handles non-traversable cells by preventing movement.\n            # Here, we prevent adding such moves to the BFS path for efficiency and correct pathfinding.\n            if current_grid[next_x, next_y, :].any():\n                continue # Cell is occupied, agent cannot move here\n\n            next_state = (next_pos, next_dir)\n            if next_state not in visited:\n                visited.add(next_state)\n                queue.append((next_state, path_actions + [action]))\n\n    # 7. Execute path and perform USE action\n    if best_path_actions is None:\n        return total_reward # Cannot find a path to the workshop\n\n    for action in best_path_actions:\n        reward, done, _ = env.step(action)\n        total_reward += reward\n        if done: # Episode ended (e.g., max steps reached or goal achieved)\n            return total_reward\n\n    # Agent should now be in the correct position and facing the workshop.\n    # Perform the USE action.\n    reward, done, _ = env.step(USE)\n    total_reward += reward\n    if done:\n        return total_reward\n\n    return total_reward", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-23T21:28:46.995222", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Define action map locally as per constraint \"no code outside of it\"\n  ACTION_MAP = {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4}\n\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Check if the item is already crafted to avoid unnecessary steps\n  if env._current_state.inventory[item_index] > 0:\n      return total_reward\n\n  # Get recipe for the item\n  if item_index not in cookbook.recipes:\n      # If item is not a craftable recipe, return 0 reward\n      return total_reward\n\n  recipe = cookbook.recipes[item_index]\n  required_workshop_name = recipe[\"_at\"]\n  required_workshop_index = cookbook.index[required_workshop_name]\n  \n  # Extract actual ingredients (excluding special recipe keys like _at, _yield)\n  ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  # Step 1: Ensure all ingredients are collected or crafted\n  for ing_index, count_needed in ingredients.items():\n      ing_name = cookbook.index.get(ing_index)\n      \n      # Continue collecting/crafting this ingredient until the required count is met\n      while env._current_state.inventory[ing_index] < count_needed:\n          # If the overall task goal is already met (e.g., by a sub-crafting step), stop and return\n          if env._is_done():\n              return total_reward\n\n          # Determine if the ingredient is a primitive (collectable) or another craftable item\n          if ing_index in cookbook.primitives:\n              # Assuming `collect_func` is a callable Python function that implements `COLLECT_FUNC`\n              # and handles moving to and collecting one instance of the primitive.\n              reward_from_subtask = collect_func(env, ing_name)\n              total_reward += reward_from_subtask\n          else:\n              # Recursively call `craft_v1` for craftable ingredients\n              reward_from_subtask = craft_v1(env, ing_name)\n              total_reward += reward_from_subtask\n          \n          # Important check: If after attempting to collect/craft, the inventory count for this ingredient\n          # did not increase or is still less than needed, it means it cannot be obtained right now.\n          # Break to avoid an infinite loop if an ingredient is unobtainable.\n          if env._current_state.inventory[ing_index] < count_needed:\n              break # Cannot proceed with this ingredient, break out of its collection loop\n\n  # If the item was somehow crafted as a side effect or if overall task is done\n  if env._current_state.inventory[item_index] > 0 or env._is_done():\n      return total_reward\n\n  # Step 2: Move the agent to be next to the required workshop\n  max_move_attempts = 200 # A safety limit to prevent infinite loops in movement\n  current_moves = 0\n  \n  while not env._current_state.next_to(required_workshop_index) and current_moves < max_move_attempts:\n      # Check if overall task goal is met during movement\n      if env._is_done():\n          return total_reward\n\n      x, y = env._current_state.pos # Current agent position\n      \n      # Find the exact location of the workshop on the grid\n      target_x, target_y = -1, -1\n      grid = env._current_state.grid\n      for gx in range(env.world.WIDTH):\n          for gy in range(env.world.HEIGHT):\n              if grid[gx, gy, required_workshop_index] == 1:\n                  target_x, target_y = gx, gy\n                  break\n          if target_x != -1:\n              break\n      \n      if target_x == -1: # Workshop not found on the map (should not happen in valid scenarios)\n          return total_reward # Cannot craft if workshop is missing\n\n      # Calculate the difference to the target position\n      dx = target_x - x\n      dy = target_y - y\n      \n      move_action = -1 # Initialize with an invalid action\n      \n      # Prioritize moving along the axis with the larger distance difference\n      if abs(dx) > abs(dy):\n          if dx > 0: move_action = ACTION_MAP['RIGHT']\n          elif dx < 0: move_action = ACTION_MAP['LEFT']\n      else: # If abs(dy) >= abs(dx) or dx == 0\n          if dy > 0: move_action = ACTION_MAP['UP']\n          elif dy < 0: move_action = ACTION_MAP['DOWN']\n\n      # If no direct greedy move is selected (e.g., dx=0, dy=0 which means agent is AT target\n      # or agent is perfectly aligned but blocked), or if the greedy move hits an obstacle,\n      # try a random movement action to unblock or explore.\n      # If `move_action` is still -1, it implies agent is at target (x,y) = (target_x, target_y).\n      # However, `next_to` check would still be false if agent is ON the workshop itself.\n      # `env.step` will prevent moving into an occupied tile.\n      if move_action == -1 or (x, y) == env._current_state.pos: # If stuck at current pos or no clear move\n          # Pick a random movement action (0-3) to try and unstuck or explore\n          move_action = env.random.randint(0, 3) \n          \n      reward_step, done_step, obs_step = env.step(move_action)\n      total_reward += reward_step\n      current_moves += 1\n      \n      if done_step: # If overall task goal is met during movement\n          return total_reward\n\n  # After movement loop, verify agent is next to the workshop\n  if not env._current_state.next_to(required_workshop_index):\n      # If the agent failed to reach the workshop after max attempts, crafting cannot proceed\n      return total_reward\n\n  # Step 3: Perform the USE action at the workshop to craft the item\n  reward_use, done_use, obs_use = env.step(ACTION_MAP['USE'])\n  total_reward += reward_use\n  \n  if done_use: # If overall task goal is met after the crafting attempt\n      return total_reward\n\n  return total_reward", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-23T21:28:47.013185", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    # Get the integer index for the target item to craft\n    target_item_idx = env.world.cookbook.index[item]\n    # Retrieve the recipe for the target item\n    recipe = env.world.cookbook.recipes[target_item_idx]\n\n    # --- Step 1: Collect all necessary ingredients ---\n    needed_ingredients = {}\n    required_workshop_name = None\n\n    # Parse the recipe to identify ingredients and the required workshop\n    for key, value in recipe.items():\n        if isinstance(key, int):  # Key is an ingredient index\n            needed_ingredients[key] = value\n        elif key == \"_at\":  # Key specifies the required workshop\n            required_workshop_name = value\n\n    # Create a copy of the current inventory to track changes for prerequisite collection\n    current_inventory = env._current_state.inventory.copy()\n\n    # Iterate through each required ingredient\n    for ingredient_idx, required_count in needed_ingredients.items():\n        # Get the string name of the ingredient for DSL function calls\n        ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n        \n        # Determine how many of this ingredient are currently missing\n        has_count = current_inventory[ingredient_idx]\n        missing_count = required_count - has_count\n\n        if missing_count > 0:\n            # Check if the ingredient is a primitive (can be collected directly)\n            if ingredient_idx in env.world.cookbook.primitives:\n                # If it's a primitive, use COLLECT_FUNC for each missing unit\n                for _ in range(missing_count):\n                    # COLLECT_FUNC is assumed to handle movement and 'USE' action\n                    # and return the reward for that action.\n                    r = COLLECT_FUNC(env, ingredient_name)\n                    total_reward += r\n                    # Update inventory from environment after each collection\n                    current_inventory = env._current_state.inventory.copy()\n            else:\n                # If it's another craftable item, recursively call craft_v1\n                # First, find out how many of this prerequisite item we need to craft\n                prerequisite_recipe = env.world.cookbook.recipes[ingredient_idx]\n                prerequisite_yield = prerequisite_recipe.get(\"_yield\", 1) # Default yield is 1\n\n                # Calculate the number of times to craft the prerequisite to meet 'missing_count'\n                import numpy as np # np.ceil is needed for this calculation\n                num_prereq_crafts_needed = int(np.ceil(missing_count / prerequisite_yield))\n                \n                for _ in range(num_prereq_crafts_needed):\n                    # Recursive call to craft the prerequisite item\n                    r = craft_v1(env, ingredient_name)\n                    total_reward += r\n                    # Update inventory from environment after each crafting step\n                    current_inventory = env._current_state.inventory.copy()\n\n    # --- Step 2: Move to the required workshop if necessary ---\n    if required_workshop_name is not None:\n        required_workshop_idx = env.world.cookbook.index[required_workshop_name]\n        \n        # Get grid dimensions (assuming WIDTH, HEIGHT are accessible or from env)\n        # They are global in the provided craft_env.py, so directly accessible or via env.\n        # Safest way to get them is from the grid shape:\n        WIDTH, HEIGHT, _ = env._current_state.grid.shape \n\n        # Limit the number of moves to prevent infinite loops (e.g., if path is blocked)\n        # Using env.max_steps as a generous upper bound for total operations,\n        # so half of it for just movement to prevent exceeding overall task steps.\n        MAX_MOVES_TO_WORKSHOP = env.max_steps // 2 \n        moves_taken = 0\n        \n        # Loop until the agent is adjacent to the workshop or max moves are reached\n        while not env._current_state.next_to(required_workshop_idx) and moves_taken < MAX_MOVES_TO_WORKSHOP:\n            # Find the workshop's current position on the grid\n            workshop_pos = None\n            grid = env._current_state.grid\n            for x_coord in range(WIDTH):\n                for y_coord in range(HEIGHT):\n                    if grid[x_coord, y_coord, required_workshop_idx] == 1:\n                        workshop_pos = (x_coord, y_coord)\n                        break\n                if workshop_pos:\n                    break # Break outer loop once workshop is found\n            \n            if workshop_pos is None:\n                # If the workshop cannot be found, something is wrong with the environment setup\n                # or it has been removed (unlikely for workshops). Cannot proceed.\n                return total_reward \n            \n            agent_x, agent_y = env._current_state.pos\n            target_x, target_y = workshop_pos\n\n            # Determine the primary direction to move towards the workshop (greedy approach)\n            dx = target_x - agent_x\n            dy = target_y - agent_y\n            \n            move_direction_str = None\n            if abs(dx) > 0: # Prioritize horizontal movement if there's horizontal distance\n                if dx > 0:\n                    move_direction_str = \"RIGHT\"\n                else: # dx < 0\n                    move_direction_str = \"LEFT\"\n            elif abs(dy) > 0: # If no horizontal distance, then move vertically\n                if dy > 0:\n                    move_direction_str = \"UP\"\n                else: # dy < 0\n                    move_direction_str = \"DOWN\"\n            \n            if move_direction_str is None:\n                # This case implies agent is on the workshop's exact tile, or no movement needed\n                # (e.g., already adjacent, or trapped). The while loop condition should then handle it.\n                break \n\n            # Perform the move using the DSL's MOVE_FUNC and accumulate reward\n            # MOVE_FUNC is assumed to take the environment object and direction string,\n            # and return the reward from that single step.\n            r = MOVE_FUNC(env, move_direction_str)\n            total_reward += r\n            moves_taken += 1\n            \n            # The environment state (agent position) is updated by MOVE_FUNC,\n            # so the next loop iteration will use the new position.\n\n        # If after attempting moves, the agent is still not adjacent to the workshop,\n        # it means it's unreachable within the given move limit.\n        if not env._current_state.next_to(required_workshop_idx):\n            # The task might not be completable, return current accumulated reward.\n            return total_reward\n\n    # --- Step 3: Perform the crafting action (USE) ---\n    # At this point, all ingredients should be in the inventory (or handled by prerequisite calls),\n    # and the agent should be positioned correctly next to the workshop (if one was required).\n    # Perform the 'USE' action to craft the item.\n    reward_from_use, _, _ = env.step(env.action_specs()['USE'])\n    total_reward += reward_from_use\n\n    return total_reward", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-23T21:37:34.467620", "function_name": "craft", "function_body": "    # Constants from the CraftWorld environment (assumed to be accessible in this scope)\n    # WIDTH = 12\n    # HEIGHT = 12\n    # DOWN = 0\n    # UP = 1\n    # LEFT = 2\n    # RIGHT = 3\n    # USE = 4\n\n    total_reward = 0.0\n    target_item_id = env.world.cookbook.index.index(item)\n\n    # 1. Collect all necessary primitive ingredients for the target item\n    # This uses the cookbook's ability to recursively find all base ingredients.\n    required_primitives = env.world.cookbook.primitives_for(target_item_id)\n    \n    for ing_id, required_count in required_primitives.items():\n        ing_name = env.world.cookbook.index.get(ing_id)\n\n        # Skip collection for environmental items that are not 'grabbable'\n        # (e.g., boundary, water, stone, workshops) which might show up in primitives_for\n        # if they are part of a crafting process for something like a bridge or axe.\n        # `COLLECT_FUNC` should handle this, but an explicit check here can save steps.\n        if ing_id in env.world.non_grabbable_indices:\n            continue # Cannot \"collect\" these in the traditional sense\n\n        current_amount = env._current_state.inventory[ing_id]\n        tries = 0\n        max_tries_per_item = 1000  # Safeguard to prevent infinite loops if item is unreachable/gone\n\n        while current_amount < required_count and tries < max_tries_per_item:\n            prev_inventory_amount = env._current_state.inventory[ing_id]\n            reward_collect = COLLECT_FUNC(env, ing_name)  # Assumes COLLECT_FUNC is implemented and accessible\n            total_reward += reward_collect\n            current_amount = env._current_state.inventory[ing_id]\n\n            if current_amount == prev_inventory_amount and reward_collect <= 0.0:\n                # If no progress in inventory and no positive reward, assume stuck or item unavailable\n                # print(f\"Warning: Failed to collect {ing_name}. Stuck or unavailable.\")\n                break\n            tries += 1\n\n    # 2. Identify the required workshop and move the agent to be adjacent to it\n    recipe = env.world.cookbook.recipes.get(target_item_id)\n    workshop_id = None\n    if \"_at\" in recipe:\n        workshop_name = recipe[\"_at\"]\n        workshop_id = env.world.cookbook.index.index(workshop_name)\n\n        workshop_x, workshop_y = -1, -1\n        grid = env._current_state.grid\n        for x_grid in range(WIDTH):\n            for y_grid in range(HEIGHT):\n                if grid[x_grid, y_grid, workshop_id] == 1:\n                    workshop_x, workshop_y = x_grid, y_grid\n                    break\n            if workshop_x != -1: break\n\n        if workshop_x == -1:\n            # Workshop specified in recipe not found on the current grid\n            # print(f\"Warning: Workshop {workshop_name} not found on grid for crafting {item}.\")\n            return total_reward  # Cannot proceed with crafting\n\n        max_steps_for_move = WIDTH * HEIGHT * 2  # Safeguard for movement\n        steps_count = 0\n        \n        while not env._current_state.next_to(workshop_id) and steps_count < max_steps_for_move:\n            current_x, current_y = env._current_state.pos\n            \n            dx = workshop_x - current_x\n            dy = workshop_y - current_y\n\n            moved_this_step = False\n            \n            # Prioritize movement along the axis with the larger absolute difference\n            # Attempt horizontal movement first if not already aligned or if it's the dominant axis\n            if dx != 0 and (abs(dx) >= abs(dy) or dy == 0):\n                chosen_dir = RIGHT if dx > 0 else LEFT\n                prev_pos = env._current_state.pos\n                reward_move = MOVE_FUNC(env, chosen_dir)  # Assumes MOVE_FUNC is implemented and accessible\n                total_reward += reward_move\n                steps_count += 1\n                if env._current_state.pos != prev_pos:\n                    moved_this_step = True\n            \n            # If horizontal movement didn't happen or didn't move, try vertical\n            if not moved_this_step and dy != 0:\n                chosen_dir = UP if dy > 0 else DOWN  # Y-axis in CraftWorld: increasing Y is UP\n                prev_pos = env._current_state.pos\n                reward_move = MOVE_FUNC(env, chosen_dir)\n                total_reward += reward_move\n                steps_count += 1\n                if env._current_state.pos != prev_pos:\n                    moved_this_step = True\n            \n            if not moved_this_step:\n                # Agent is either at the target (which `next_to` handles), or blocked, or dx and dy are both 0\n                # If dx and dy are 0, it means agent is on the same spot as workshop, which is not allowed.\n                # So it must be blocked.\n                # print(f\"Warning: Agent stuck trying to reach workshop {workshop_name}.\")\n                break # Cannot move further\n\n        # Ensure agent is facing the workshop for the USE action\n        if env._current_state.next_to(workshop_id):\n            current_x, current_y = env._current_state.pos\n            # Find which adjacent cell the workshop is located in\n            target_nx, target_ny = -1, -1\n            # Iterate through potential neighbor positions to find the workshop\n            for nx_offset in [-1, 0, 1]:\n                for ny_offset in [-1, 0, 1]:\n                    if nx_offset == 0 and ny_offset == 0: continue # Skip current position\n                    check_x, check_y = current_x + nx_offset, current_y + ny_offset\n                    # Check bounds\n                    if 0 <= check_x < WIDTH and 0 <= check_y < HEIGHT:\n                        if env._current_state.grid[check_x, check_y, workshop_id] == 1:\n                            target_nx, target_ny = check_x, check_y\n                            break\n                if target_nx != -1: break\n            \n            if target_nx != -1: # Found adjacent workshop\n                # Determine the direction to face the workshop\n                face_dir = -1\n                if target_nx == current_x - 1: face_dir = LEFT\n                elif target_nx == current_x + 1: face_dir = RIGHT\n                elif target_ny == current_y - 1: face_dir = DOWN\n                elif target_ny == current_y + 1: face_dir = UP\n\n                if face_dir != -1 and env._current_state.dir != face_dir:\n                    # Perform a move action in the desired direction to change agent's orientation.\n                    # In CraftWorld, moving into an occupied cell (like a workshop) updates direction but not position.\n                    reward_turn = MOVE_FUNC(env, face_dir)\n                    total_reward += reward_turn\n        else:\n            # Failed to get adjacent to workshop after max_steps_for_move\n            # print(f\"Failed to get adjacent to workshop {workshop_name} for crafting {item} after maximum steps.\")\n            return total_reward\n\n    # 3. Perform the USE action to craft the item\n    # This action will only succeed if all ingredients are met and agent is at correct workshop facing it.\n    reward_craft, _, _ = env.step(USE)\n    total_reward += reward_craft\n\n    return total_reward", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-23T21:37:36.641470", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Get the index of the item to craft\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if the item is craftable (i.e., has a recipe)\n  if item_idx not in env.world.cookbook.recipes:\n      # If not craftable (e.g., a primitive like \"wood\"), there's nothing to do.\n      # Return the accumulated reward (which would be 0.0 at this point).\n      return total_reward \n\n  recipe = env.world.cookbook.recipes[item_idx]\n  \n  # Determine if a crafting station is required\n  if \"_at\" in recipe:\n      station_name = recipe[\"_at\"]\n      station_idx = env.world.cookbook.index[station_name]\n\n      # Find the crafting station's location on the grid\n      station_x, station_y = -1, -1\n      for x_grid in range(WIDTH):\n          for y_grid in range(HEIGHT):\n              if env._current_state.grid[x_grid, y_grid, station_idx] == 1:\n                  station_x, station_y = x_grid, y_grid\n                  break\n          if station_x != -1:\n              break\n\n      if station_x == -1:\n          # Crafting station not found on the grid, cannot proceed with crafting.\n          return total_reward\n\n      # Define a list of possible approach points (adjacent positions + required facing direction)\n      # We try them in a specific order (e.g., from below, then left, then above, then right)\n      target_approach_points = [\n          (station_x, station_y - 1, UP),    # Stand below the station, face UP\n          (station_x - 1, station_y, RIGHT), # Stand to the left of the station, face RIGHT\n          (station_x, station_y + 1, DOWN),  # Stand above the station, face DOWN\n          (station_x + 1, station_y, LEFT)   # Stand to the right of the station, face LEFT\n      ]\n\n      # Iterate through the approach points, trying to reach and orient for each\n      station_reached_and_oriented = False\n      for target_px, target_py, target_d in target_approach_points:\n          moves_count = 0\n          # Set a generous limit for movement attempts to prevent infinite loops\n          # if the target is unreachable (e.g., blocked by boundaries/obstacles).\n          max_moves_to_reach_pos = 2 * (WIDTH + HEIGHT) + 10 \n\n          # 1. Move the agent to the target adjacent position (target_px, target_py)\n          while env._current_state.pos != (target_px, target_py) and moves_count < max_moves_to_reach_pos:\n              current_x, current_y = env._current_state.pos\n              action_to_take = -1\n\n              # Determine the action to move towards the target position\n              if current_x < target_px:\n                  action_to_take = RIGHT\n              elif current_x > target_px:\n                  action_to_take = LEFT\n              elif current_y < target_py:\n                  action_to_take = UP\n              elif current_y > target_py:\n                  action_to_take = DOWN\n              \n              if action_to_take != -1:\n                  prev_pos = env._current_state.pos # Store previous position to detect if agent gets stuck\n                  reward, done, _ = env.step(action_to_take)\n                  total_reward += reward\n                  moves_count += 1\n                  if done: return total_reward # If environment terminates, return immediately\n                  if env._current_state.pos == prev_pos:\n                      # Agent did not move, likely due to an obstacle. This path is blocked.\n                      break # Break from this inner movement loop, try next approach point\n              else:\n                  # If action_to_take is -1, it implies current_pos is already target_pos for this axis,\n                  # or that current_pos is exactly target_pos.\n                  # The while loop condition handles the full target_pos check.\n                  break # Current position is target_pos, exit inner movement loop\n\n          # If the agent failed to reach the target position, try the next approach point\n          if env._current_state.pos != (target_px, target_py):\n              continue\n          \n          # 2. Orient the agent to face the crafting station (target_d)\n          spins_count = 0\n          max_spins = 4 # A maximum of 4 attempts to change direction (one for each cardinal direction)\n          while env._current_state.dir != target_d and spins_count < max_spins:\n              # Performing a \"move\" action in the target direction also changes the agent's orientation.\n              # If the space in that direction is blocked, the agent will only change its facing direction.\n              reward, done, _ = env.step(target_d)\n              total_reward += reward\n              spins_count += 1\n              if done: return total_reward # If environment terminates, return immediately\n          \n          # If successfully reached the position and oriented correctly\n          if env._current_state.dir == target_d:\n              station_reached_and_oriented = True\n              break # Break from the outer loop of approach points as a suitable position is found\n      \n      # If no suitable crafting station approach point was found or reachable\n      if not station_reached_and_oriented:\n          return total_reward\n\n  # 3. Perform the USE action to attempt crafting\n  # This action will only succeed if the agent is at the correct location (if applicable),\n  # facing the correct object (if applicable), and has all required ingredients in inventory.\n  # The environment's _get_reward function will determine the specific reward.\n  reward, done, _ = env.step(USE)\n  total_reward += reward\n  if done: return total_reward\n\n  return total_reward", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T21:57:53.347541", "function_name": "craft", "function_body": "  # Constants from craft_env.py, defined within the function for strict adherence to \"no code outside\"\n  WIDTH = 12\n  HEIGHT = 12\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  total_reward = 0.0\n  cookbook = env.world.cookbook\n  \n  # Map DSL item names (string) to cookbook indices (int ID)\n  item_idx = cookbook.index[item]\n\n  # Get all primitive ingredients needed for the item, including quantities.\n  # This handles recursive expansion of sub-crafts based on the cookbook recipes.\n  needed_primitives = cookbook.primitives_for(item_idx)\n\n  # Acquire all necessary primitive ingredients\n  for primitive_name_idx, needed_count in needed_primitives.items():\n    # Loop until the required count of the primitive is in inventory\n    while env._current_state.inventory[primitive_name_idx] < needed_count:\n      # Find the closest available instance of the primitive on the grid\n      target_pos = None\n      min_dist_sq = float('inf')\n      \n      current_grid = env._current_state.grid\n      agent_x, agent_y = env._current_state.pos\n\n      found_on_grid = False\n      # Iterate through the entire grid to find an available primitive\n      for x_grid in range(WIDTH): \n        for y_grid in range(HEIGHT):\n          # Check if the primitive exists at this grid location\n          if current_grid[x_grid, y_grid, primitive_name_idx] == 1:\n            found_on_grid = True\n            # Calculate squared distance to find the closest one\n            dist_sq = (x_grid - agent_x)**2 + (y_grid - agent_y)**2\n            if dist_sq < min_dist_sq:\n              min_dist_sq = dist_sq\n              target_pos = (x_grid, y_grid)\n      \n      # If the primitive is not found on the grid, it means we cannot acquire it.\n      # This simple agent cannot generate new items or explore beyond visible.\n      if not found_on_grid:\n          # Return the accumulated reward, indicating partial or full failure to craft.\n          return total_reward\n\n      # Move towards the target primitive until adjacent or stuck\n      # A safety limit to prevent infinite loops in case of blocked paths or other issues.\n      max_moves_to_target = WIDTH * HEIGHT * 5 \n      moves_taken = 0\n      \n      # Loop until the agent is next to the primitive or hits the move limit\n      while not env._current_state.next_to(primitive_name_idx) and moves_taken < max_moves_to_target:\n        agent_x, agent_y = env._current_state.pos\n        target_x, target_y = target_pos\n\n        dx = target_x - agent_x\n        dy = target_y - agent_y\n\n        action_to_take = -1\n        # Prioritize movement along the dimension with the larger difference to close distance faster\n        if abs(dx) >= abs(dy) and dx != 0:\n            action_to_take = RIGHT if dx > 0 else LEFT\n        elif dy != 0: # If dx is 0 or smaller than dy, move in y direction\n            action_to_take = UP if dy > 0 else DOWN\n        \n        # If no movement is needed (agent is already at target_pos or next to it)\n        # or if movement is blocked (dx=0 and dy=0 but not adjacent), break from movement loop.\n        if action_to_take == -1: \n            break \n\n        reward, done, _ = env.step(action_to_take)\n        total_reward += reward\n        moves_taken += 1\n        if done: return total_reward # Environment terminated (e.g., max_steps reached)\n\n      # After attempting to move, if the agent is now adjacent to the primitive, USE it.\n      if env._current_state.next_to(primitive_name_idx):\n        reward, done, _ = env.step(USE)\n        total_reward += reward\n        if done: return total_reward\n      else:\n        # If not adjacent after maximum moves, or due to being blocked,\n        # it means the agent failed to acquire this specific primitive.\n        # Break from the current primitive's collection loop and proceed.\n        break \n\n  # After collecting all primitives, move to the crafting station if the item requires one\n  item_recipe = cookbook.recipes[item_idx]\n  if \"_at\" in item_recipe:\n    workshop_name = item_recipe[\"_at\"]\n    workshop_idx = cookbook.index[workshop_name]\n\n    # Find the closest workshop instance on the grid\n    workshop_pos = None\n    min_dist_sq = float('inf')\n    current_grid = env._current_state.grid\n    agent_x, agent_y = env._current_state.pos\n\n    for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n        if current_grid[x_grid, y_grid, workshop_idx] == 1:\n          dist_sq = (x_grid - agent_x)**2 + (y_grid - agent_y)**2\n          if dist_sq < min_dist_sq:\n            min_dist_sq = dist_sq\n            workshop_pos = (x_grid, y_grid)\n\n    # If the required workshop is not found on the grid, return accumulated reward.\n    if workshop_pos is None:\n        return total_reward\n\n    # Move to the workshop until adjacent or stuck\n    max_moves_to_workshop = WIDTH * HEIGHT * 5 # Safety limit\n    moves_taken = 0\n    while not env._current_state.next_to(workshop_idx) and moves_taken < max_moves_to_workshop:\n      agent_x, agent_y = env._current_state.pos\n      target_x, target_y = workshop_pos\n\n      dx = target_x - agent_x\n      dy = target_y - agent_y\n\n      action_to_take = -1\n      if abs(dx) >= abs(dy) and dx != 0:\n          action_to_take = RIGHT if dx > 0 else LEFT\n      elif dy != 0:\n          action_to_take = UP if dy > 0 else DOWN\n      \n      # If no movement is possible or needed, break.\n      if action_to_take == -1: \n          break\n\n      reward, done, _ = env.step(action_to_take)\n      total_reward += reward\n      moves_taken += 1\n      if done: return total_reward\n\n    # Once adjacent to the workshop, use the USE action to craft the item.\n    if env._current_state.next_to(workshop_idx):\n      reward, done, _ = env.step(USE)\n      total_reward += reward\n      if done: return total_reward\n    # else: # If agent couldn't reach the workshop, the task implicitly failed.\n    #     pass \n\n  return total_reward", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-23T21:57:54.453418", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # 1. Get the integer index for the item to be crafted\n  # The `item` input is a string (e.g., \"PLANK\").\n  target_item_idx = env.world.cookbook.index[item]\n\n  # 2. Retrieve the crafting recipe details for the target item.\n  # Using .get() provides a safe way to handle cases where the item might not be craftable.\n  recipe_details = env.world.cookbook.recipes.get(target_item_idx)\n\n  if recipe_details is None:\n      # If no recipe is found for the item, it cannot be crafted by this function's logic.\n      return total_reward # Returns 0.0\n\n  # 3. Identify the specific workshop required for crafting this item.\n  # Recipes typically contain an \"_at\" key specifying the workshop name (e.g., \"workshop1\").\n  workshop_name = recipe_details.get(\"_at\")\n  if workshop_name is None:\n      # If the recipe does not specify a workshop, this item is not crafted at a workshop.\n      # This function specifically handles workshop-based crafting.\n      return total_reward # Returns 0.0\n\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # 4. Locate the workshop's coordinates on the current grid.\n  workshop_coords = None\n  grid = env._current_state.grid\n  # WIDTH and HEIGHT are global constants from the Craft environment definition.\n  for x_coord in range(WIDTH):\n      for y_coord in range(HEIGHT):\n          if grid[x_coord, y_coord, workshop_idx] == 1:\n              workshop_coords = (x_coord, y_coord)\n              break\n      if workshop_coords:\n          break\n\n  if workshop_coords is None:\n      # If the required workshop is not present in the current environment scenario.\n      return total_reward # Returns 0.0\n\n  # 5. Move the agent until it is adjacent to the identified workshop.\n  # `env._current_state.next_to(workshop_idx)` checks if the agent is next to the workshop.\n  while not env._current_state.next_to(workshop_idx):\n      # Check if the maximum number of steps for the environment has been reached.\n      # This prevents infinite loops if the path is blocked or the workshop is unreachable.\n      if env.steps >= env.max_steps:\n          return total_reward # Returns accumulated reward up to this point\n\n      px, py = env._current_state.pos # Current agent position\n      ws_x, ws_y = workshop_coords    # Workshop position\n\n      dx = ws_x - px\n      dy = ws_y - py\n\n      action_to_take = -1 # Initialize with an invalid action code\n\n      # Determine the next movement action (UP, DOWN, LEFT, RIGHT)\n      # Prioritize movement along the dimension where the agent is further away.\n      # DOWN, UP, LEFT, RIGHT are global constants from the Craft environment definition.\n      if abs(dx) > abs(dy):\n          if dx > 0: # Workshop is to the right\n              action_to_take = RIGHT\n          elif dx < 0: # Workshop is to the left\n              action_to_take = LEFT\n      else: # abs(dy) >= abs(dx) (including cases where dx or dy is 0)\n          if dy > 0: # Workshop is up\n              action_to_take = UP\n          elif dy < 0: # Workshop is down\n              action_to_take = DOWN\n        \n      # If no valid movement action is determined (i.e., dx=0 and dy=0, meaning agent is on\n      # the same tile as workshop, but `next_to` is still false), this implies an unexpected state.\n      # Break to prevent an infinite loop.\n      if action_to_take == -1:\n          break\n\n      # Execute the determined movement action and accumulate the reward.\n      reward_step, done_step, _ = env.step(action_to_take)\n      total_reward += reward_step\n\n      # If the environment indicates `done` (e.g., max_steps reached) during movement,\n      # stop further actions and return the current total reward.\n      if done_step:\n          return total_reward\n\n  # 6. Once the agent is next to the workshop, perform the USE action to craft the item.\n  # A final check for max_steps before the USE action.\n  if env.steps >= env.max_steps:\n      return total_reward\n\n  # USE is a global constant from the Craft environment definition.\n  reward_use, done_use, _ = env.step(USE)\n  total_reward += reward_use\n\n  # The `done_use` flag from the last step will be handled by the caller of `env.step()`,\n  # so no need for specific early return logic here based on `done_use`.\n\n  return total_reward", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T22:05:16.688550", "function_name": "craft", "function_body": "  import collections\n\n  # Constants defined locally to ensure \"no code outside of it\"\n  # These are taken directly from the Craft environment code base.\n  WIDTH = 12\n  HEIGHT = 12\n\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  total_reward = 0.0\n  cookbook = env.world.cookbook\n  \n  # 1. Get the item's index from the cookbook and retrieve its recipe.\n  # The 'item' argument is expected to be a string name (e.g., \"plank\", \"axe\").\n  # The cookbook.index[] converts these names to integer indices.\n  item_idx = cookbook.index[item]\n  \n  # If there's no recipe for the requested item, it cannot be crafted.\n  if item_idx not in cookbook.recipes:\n      return total_reward\n\n  recipe = cookbook.recipes[item_idx]\n\n  # 2. Check if the agent possesses all necessary ingredients for the recipe.\n  current_state = env._current_state # Get the current state of the environment\n  ingredients_ok = True\n  for ingredient_idx, count in recipe.items():\n      # Ingredients are identified by integer indices; special keys like \"_at\" are strings.\n      if isinstance(ingredient_idx, int):\n          if current_state.inventory[ingredient_idx] < count:\n              ingredients_ok = False\n              break\n  \n  # If ingredients are missing, crafting cannot proceed.\n  if not ingredients_ok:\n      return total_reward\n\n  # 3. Identify the specific workshop required for crafting this item.\n  # Recipes typically have an \"_at\" key specifying the workshop.\n  if \"_at\" not in recipe:\n      # If no workshop is specified, this crafting logic does not apply.\n      return total_reward \n\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = cookbook.index[workshop_name]\n\n  # 4. Locate the workshop's position on the grid.\n  workshop_pos = None\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if current_state.grid[x_grid, y_grid, workshop_idx] == 1:\n              workshop_pos = (x_grid, y_grid)\n              break\n      if workshop_pos: # Workshop found, exit outer loop\n          break\n  \n  # If the required workshop is not present in the current grid, crafting is impossible.\n  if not workshop_pos:\n      return total_reward\n\n  # 5. Pathfinding to an empty cell adjacent to the workshop, ensuring the agent faces it correctly.\n  start_pos = current_state.pos\n  \n  # Define possible movement actions and their corresponding (dx, dy) vectors.\n  move_actions_map = {\n      DOWN: (0, -1),\n      UP: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n  \n  # Determine all valid target cells adjacent to the workshop, and the direction\n  # the agent needs to face from each of those cells to interact with the workshop.\n  target_adj_cells_info = [] # Stores: ((adj_x, adj_y), required_facing_dir)\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Check all four direct neighbors\n      adj_x, adj_y = workshop_pos[0] + dx, workshop_pos[1] + dy\n      \n      # Determine the direction the agent needs to face to interact with the workshop\n      # when standing at (adj_x, adj_y).\n      required_facing_dir = None\n      if dx == -1: required_facing_dir = RIGHT # If adj_cell is left of workshop, agent faces right\n      elif dx == 1: required_facing_dir = LEFT # If adj_cell is right of workshop, agent faces left\n      elif dy == -1: required_facing_dir = UP   # If adj_cell is below workshop, agent faces up\n      elif dy == 1: required_facing_dir = DOWN # If adj_cell is above workshop, agent faces down\n      \n      # Check if the adjacent cell is within bounds, is empty, and is not a boundary wall.\n      if (0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT and \n          not current_state.grid[adj_x, adj_y, :].any() and # Cell is empty (no items present)\n          current_state.grid[adj_x, adj_y, cookbook.index[\"boundary\"]] == 0): # Not a boundary\n          \n          target_adj_cells_info.append(((adj_x, adj_y), required_facing_dir))\n\n  # If no valid adjacent and empty cells are found, cannot reach the workshop.\n  if not target_adj_cells_info:\n      return total_reward\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path to an\n  # appropriate crafting spot (adjacent cell with correct orientation).\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here, agent_direction_at_this_position)\n  queue = collections.deque([(start_pos, [], current_state.dir)])\n  # The visited set stores: ((position_x, position_y), agent_direction_at_that_pos)\n  # This prevents redundant exploration of the same state (position + direction).\n  visited = {(start_pos, current_state.dir)} \n\n  path_to_craft_spot = None # This will store (list_of_actions, final_required_direction_at_craft_spot)\n\n  while queue:\n      (x, y), path, agent_dir = queue.popleft()\n\n      # Check if the current (position, direction) matches any of our target crafting spots.\n      for (target_x, target_y), required_dir in target_adj_cells_info:\n          if (x, y) == (target_x, target_y) and agent_dir == required_dir:\n              path_to_craft_spot = (path, required_dir)\n              break # Found a valid path, exit inner loop\n      if path_to_craft_spot:\n          break # Found a valid path, exit outer BFS loop\n\n      # Explore possible next moves (actions) from the current state.\n      for action, (dx, dy) in move_actions_map.items():\n          next_x, next_y = x + dx, y + dy\n          \n          # Simulate the outcome of taking 'action':\n          # The agent's direction always changes to the 'action' taken.\n          sim_next_dir = action \n\n          # Movement is blocked if the target cell is out of bounds or occupied by any object.\n          is_blocked = False\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              is_blocked = True # Out of bounds\n          elif current_state.grid[next_x, next_y, :].any():\n              # The CraftState.step function states: `if self.grid[n_x, n_y, :].any(): n_x, n_y = x, y`\n              # This means movement is blocked if ANY item is present in the target cell.\n              is_blocked = True\n          \n          # Determine the simulated next position:\n          sim_next_pos = (x, y) # Default: agent stays put if blocked\n          if not is_blocked:\n              sim_next_pos = (next_x, next_y) # Agent successfully moves\n\n          # If this simulated new state (position + direction) hasn't been visited, add it to the queue.\n          if (sim_next_pos, sim_next_dir) not in visited:\n              visited.add((sim_next_pos, sim_next_dir))\n              queue.append((sim_next_pos, path + [action], sim_next_dir))\n\n  # If no path to a valid crafting spot (with correct orientation) was found, return current total_reward.\n  if not path_to_craft_spot:\n      return total_reward\n\n  # Extract the sequence of actions to take from the found path.\n  path_actions, _ = path_to_craft_spot\n\n  # 6. Execute the determined movement actions in the environment.\n  # Update current_state and total_reward after each step.\n  for action in path_actions:\n      reward, _, _ = env.step(action)\n      total_reward += reward\n      current_state = env._current_state # Crucially update current_state after each step\n\n  # At this point, the agent is at the correct position adjacent to the workshop\n  # and is facing the correct direction, as ensured by the BFS.\n\n  # 7. Execute the USE action to craft the item.\n  reward, _, _ = env.step(USE)\n  total_reward += reward\n\n  return total_reward", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T22:05:17.752424", "function_name": "craft", "function_body": "  # Action constants derived from CraftLab.action_specs and craft_env.py\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  total_reward = 0.0\n\n  # 1. Get item ID and recipe\n  # Convert item string from DSL (e.g., \"PLANK\") to lowercase for cookbook index\n  item_lower = item.lower()\n  \n  # Ensure the item exists in the cookbook's index.\n  # If it doesn't, it's an invalid item for the current cookbook, so we cannot craft it.\n  if item_lower not in env.world.cookbook.index.contents:\n      return total_reward\n\n  item_id = env.world.cookbook.index[item_lower]\n\n  # Check if the item is craftable (i.e., has a recipe in the cookbook).\n  if item_id not in env.world.cookbook.recipes:\n    # If it's not in recipes, it might be a primitive or an invalid craft goal.\n    return total_reward\n\n  recipe = env.world.cookbook.recipes[item_id]\n\n  # 2. Identify target workshop from the recipe\n  # Recipes specify the required workshop via a \"_at\" key, e.g., \"_at\": \"workshop1\".\n  if \"_at\" not in recipe:\n      # If no workshop is specified in the recipe, crafting is not possible via a workshop.\n      return total_reward\n      \n  workshop_name = recipe[\"_at\"]\n  \n  # Ensure the workshop name exists in the cookbook's index.\n  if workshop_name not in env.world.cookbook.index.contents:\n      return total_reward\n\n  workshop_id = env.world.cookbook.index[workshop_name]\n\n  # 3. Locate the workshop on the current grid\n  workshop_pos = None\n  current_grid = env._current_state.grid\n  # Get grid dimensions directly from the current state's grid for robustness.\n  WIDTH, HEIGHT, _ = current_grid.shape \n\n  for x in range(WIDTH):\n    for y in range(HEIGHT):\n      # Check if the workshop_id is present at this grid cell.\n      if current_grid[x, y, workshop_id] == 1:\n        workshop_pos = (x, y)\n        break # Found workshop, exit inner loop\n    if workshop_pos:\n      break # Found workshop, exit outer loop\n\n  if not workshop_pos:\n    # Workshop not found on the current map, crafting is not possible.\n    return total_reward\n\n  wx, wy = workshop_pos\n\n  # 4. Move to be adjacent to the workshop and face it\n  # A safety break for the movement loop to prevent infinite loops in cases\n  # where the path is blocked or due to sub-optimal greedy pathfinding.\n  MAX_MOVEMENT_ATTEMPTS = WIDTH * HEIGHT * 4 \n\n  for _ in range(MAX_MOVEMENT_ATTEMPTS):\n    current_x, current_y = env._current_state.pos\n    current_dir = env._current_state.dir\n\n    # Determine if the agent is currently adjacent to the workshop.\n    is_adjacent = False\n    target_direction_to_workshop = -1 # Direction agent needs to face to use the workshop.\n\n    # Check all 4 cardinal directions for adjacency.\n    if current_x + 1 == wx and current_y == wy: # Workshop is to the right.\n        is_adjacent = True\n        target_direction_to_workshop = RIGHT\n    elif current_x - 1 == wx and current_y == wy: # Workshop is to the left.\n        is_adjacent = True\n        target_direction_to_workshop = LEFT\n    elif current_x == wx and current_y + 1 == wy: # Workshop is above (higher Y).\n        is_adjacent = True\n        target_direction_to_workshop = UP\n    elif current_x == wx and current_y - 1 == wy: # Workshop is below (lower Y).\n        is_adjacent = True\n        target_direction_to_workshop = DOWN\n    \n    if is_adjacent:\n        # Agent is adjacent to the workshop. Now, ensure it faces it.\n        if current_dir != target_direction_to_workshop:\n            # If not facing the right direction, perform the corresponding movement action.\n            # CraftState.step updates the agent's direction even if movement is blocked\n            # (e.g., by the workshop itself, which is an impassable object).\n            r, d, o = env.step(target_direction_to_workshop)\n            total_reward += r\n            if d: return total_reward # Environment done (goal achieved or max steps reached), stop.\n            # After this step, current_dir should be updated. The loop will re-check in the next iteration.\n            \n        else:\n            # Agent is already adjacent AND facing the workshop. We are ready to perform the USE action.\n            break # Exit movement loop.\n    else:\n        # Agent is not adjacent to the workshop. Determine the best movement action to get closer.\n        action_to_take = -1\n        \n        # Greedy movement strategy: prioritize moving along the axis with the larger difference\n        # to converge towards the target faster, especially for diagonal paths.\n        if abs(wx - current_x) > 0 and (abs(wy - current_y) == 0 or abs(wx - current_x) >= abs(wy - current_y)):\n            # Need to move horizontally, or horizontal movement is equally important/more important.\n            if wx > current_x:\n                action_to_take = RIGHT\n            else: # wx < current_x\n                action_to_take = LEFT\n        elif abs(wy - current_y) > 0:\n            # Need to move vertically.\n            if wy > current_y:\n                action_to_take = UP\n            else: # wy < current_y\n                action_to_take = DOWN\n        \n        if action_to_take != -1: # If a valid movement action was determined.\n            r, d, o = env.step(action_to_take)\n            total_reward += r\n            if d: return total_reward # Environment done, stop.\n        else:\n            # This case occurs if (wx,wy) is the same as (current_x, current_y),\n            # implying the agent is on the workshop's exact location. Workshops are typically\n            # impassable, so this indicates an unusual state or that the agent is \"at\"\n            # the target for the USE action already.\n            break # Exit movement loop.\n\n  # After the loop, the agent should ideally be adjacent and facing the workshop.\n  # If MAX_MOVEMENT_ATTEMPTS were exhausted, it might not be in optimal position,\n  # but we still attempt the USE action.\n\n  # 5. Perform the USE action to attempt crafting.\n  r, d, o = env.step(USE)\n  total_reward += r\n\n  return total_reward", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-23T22:06:19.346744", "function_name": "craft", "function_body": "  import collections\n\n  # Constants defined locally for clarity, derived from the Craft environment code base.\n  WIDTH = 12\n  HEIGHT = 12\n\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  total_reward = 0.0\n  cookbook = env.world.cookbook\n  \n  # 1. Get the item's index from the cookbook.\n  # The 'item' argument is expected to be a string name (e.g., \"plank\", \"axe\").\n  # The cookbook.index[] converts these names to integer indices.\n  # If the item name is not in the index, it cannot be processed.\n  if item not in cookbook.index.contents:\n      return total_reward\n  item_idx = cookbook.index[item]\n  \n  # If there's no recipe for the requested item, it cannot be crafted.\n  if item_idx not in cookbook.recipes:\n      return total_reward\n\n  recipe = cookbook.recipes[item_idx]\n\n  # 2. Check if the agent possesses all necessary ingredients for the recipe.\n  current_state = env._current_state # Get the current state of the environment\n  ingredients_ok = True\n  for ingredient_idx, count in recipe.items():\n      # Ingredients are identified by integer indices; special keys like \"_at\" are strings.\n      if isinstance(ingredient_idx, int):\n          if current_state.inventory[ingredient_idx] < count:\n              ingredients_ok = False\n              break\n  \n  # If ingredients are missing, crafting cannot proceed.\n  if not ingredients_ok:\n      return total_reward\n\n  # 3. Identify the specific workshop required for crafting this item.\n  # Recipes typically have an \"_at\" key specifying the workshop.\n  if \"_at\" not in recipe:\n      # If no workshop is specified, this crafting logic does not apply.\n      return total_reward \n\n  workshop_name = recipe[\"_at\"]\n  # If the workshop name is not in the cookbook index, it cannot be processed.\n  if workshop_name not in cookbook.index.contents:\n      return total_reward\n  workshop_idx = cookbook.index[workshop_name]\n\n  # 4. Locate the workshop's position on the grid.\n  workshop_pos = None\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          # Check if the workshop item is at this grid position\n          if current_state.grid[x_grid, y_grid, workshop_idx] == 1:\n              workshop_pos = (x_grid, y_grid)\n              break\n      if workshop_pos: # Workshop found, exit outer loop\n          break\n  \n  # If the required workshop is not present in the current grid, crafting is impossible.\n  if not workshop_pos:\n      return total_reward\n\n  # 5. Pathfinding to an empty cell adjacent to the workshop, ensuring the agent faces it correctly.\n  start_pos = current_state.pos\n  start_dir = current_state.dir\n  \n  # Define possible movement actions and their corresponding (dx, dy) vectors.\n  move_actions_map = {\n      DOWN: (0, -1),\n      UP: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n  \n  # Determine all valid target cells adjacent to the workshop, and the direction\n  # the agent needs to face from each of those cells to interact with the workshop.\n  target_adj_cells_info = [] # Stores: ((adj_x, adj_y), required_facing_dir)\n  # Iterate over relative positions to find neighbors: (dx, dy) and corresponding required facing direction.\n  # Agent at (adj_x, adj_y) must face (workshop_x, workshop_y).\n  # If workshop is at (adj_x+1, adj_y), agent must face RIGHT.\n  # If workshop is at (adj_x-1, adj_y), agent must face LEFT.\n  # If workshop is at (adj_x, adj_y+1), agent must face UP.\n  # If workshop is at (adj_x, adj_y-1), agent must face DOWN.\n  \n  neighbor_deltas = {\n      (-1, 0): RIGHT, # Neighbor is to the left, must face right\n      (1, 0): LEFT,   # Neighbor is to the right, must face left\n      (0, -1): UP,    # Neighbor is below, must face up\n      (0, 1): DOWN    # Neighbor is above, must face down\n  }\n\n  for dx, dy in neighbor_deltas:\n      adj_x, adj_y = workshop_pos[0] + dx, workshop_pos[1] + dy\n      \n      # Determine the direction the agent needs to face to interact with the workshop\n      required_facing_dir = neighbor_deltas[(dx, dy)]\n      \n      # Check if the adjacent cell is within bounds, is empty, and is not a boundary wall.\n      if (0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT and \n          not current_state.grid[adj_x, adj_y, :].any() and # Cell is empty (no items present)\n          current_state.grid[adj_x, adj_y, cookbook.index[\"boundary\"]] == 0): # Not a boundary\n          \n          target_adj_cells_info.append(((adj_x, adj_y), required_facing_dir))\n\n  # If no valid adjacent and empty cells are found, cannot reach the workshop.\n  if not target_adj_cells_info:\n      return total_reward\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path to an\n  # appropriate crafting spot (adjacent cell with correct orientation).\n  # The queue stores tuples: (current_position, list_of_actions_to_reach_here, agent_direction_at_this_position)\n  queue = collections.deque([(start_pos, [], start_dir)])\n  # The visited set stores: ((position_x, position_y), agent_direction_at_that_pos)\n  # This prevents redundant exploration of the same state (position + direction).\n  visited = {(start_pos, start_dir)} \n\n  path_to_craft_spot = None # This will store (list_of_actions, final_required_direction_at_craft_spot)\n\n  while queue:\n      (x, y), path, agent_dir = queue.popleft()\n\n      # Check if the current (position, direction) matches any of our target crafting spots.\n      for (target_x, target_y), required_dir in target_adj_cells_info:\n          if (x, y) == (target_x, target_y) and agent_dir == required_dir:\n              path_to_craft_spot = (path, required_dir)\n              break # Found a valid path, exit inner loop\n      if path_to_craft_spot:\n          break # Found a valid path, exit outer BFS loop\n\n      # Explore possible next moves (actions) from the current state.\n      for action, (dx, dy) in move_actions_map.items():\n          next_x, next_y = x + dx, y + dy\n          \n          # Simulate the outcome of taking 'action':\n          # The agent's direction always changes to the 'action' taken.\n          sim_next_dir = action \n\n          # Movement is blocked if the target cell is out of bounds or occupied by any object.\n          is_blocked = False\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              is_blocked = True # Out of bounds\n          # CraftState.step function's logic: if grid[n_x, n_y, :].any(), agent stays at (x, y)\n          elif current_state.grid[next_x, next_y, :].any():\n              is_blocked = True\n          \n          # Determine the simulated next position:\n          sim_next_pos = (x, y) # Default: agent stays put if blocked\n          if not is_blocked:\n              sim_next_pos = (next_x, next_y) # Agent successfully moves\n\n          # If this simulated new state (position + direction) hasn't been visited, add it to the queue.\n          if (sim_next_pos, sim_next_dir) not in visited:\n              visited.add((sim_next_pos, sim_next_dir))\n              queue.append((sim_next_pos, path + [action], sim_next_dir))\n\n  # If no path to a valid crafting spot (with correct orientation) was found, return current total_reward.\n  if not path_to_craft_spot:\n      return total_reward\n\n  # Extract the sequence of actions to take from the found path.\n  path_actions, _ = path_to_craft_spot\n\n  # 6. Execute the determined movement actions in the environment.\n  # Update current_state and total_reward after each step.\n  for action in path_actions:\n      reward, _, _ = env.step(action)\n      total_reward += reward\n      # It's good practice to update current_state from env, though for a sequence of moves\n      # without intermediate checks that depend on grid changes, it's not strictly necessary here.\n      current_state = env._current_state \n\n  # At this point, the agent is at the correct position adjacent to the workshop\n  # and is facing the correct direction, as ensured by the BFS.\n\n  # 7. Execute the USE action to craft the item.\n  reward, _, _ = env.step(USE)\n  total_reward += reward\n\n  return total_reward", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T22:06:20.480405", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Constants for environment dimensions and actions.\n  # These are defined locally within the function to adhere to the \"no code outside of it\" rule.\n  WIDTH = 12\n  HEIGHT = 12\n\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  total_reward = 0.0\n  cookbook = env.world.cookbook\n  \n  # 1. Get the item's index and its recipe from the cookbook.\n  # The 'item' argument is a string name (e.g., \"plank\"), which is converted to an integer index.\n  item_idx = cookbook.index[item]\n  recipe = cookbook.recipes.get(item_idx)\n  \n  # If no recipe exists for the requested item, it cannot be crafted.\n  if not recipe:\n      return total_reward\n\n  current_state = env._current_state # Get the agent's current state.\n  \n  # 2. Check if the agent possesses all necessary ingredients for the recipe.\n  ingredients_ok = True\n  for ingredient_idx, count in recipe.items():\n      # Filter for actual ingredients (integer indices), ignoring special keys like \"_at\".\n      if isinstance(ingredient_idx, int):\n          if current_state.inventory[ingredient_idx] < count:\n              ingredients_ok = False\n              break\n  \n  # If any ingredients are missing, crafting cannot proceed.\n  if not ingredients_ok:\n      return total_reward\n\n  # 3. Identify the specific workshop required for crafting this item.\n  # Recipes typically include an \"_at\" key specifying the workshop name.\n  workshop_name = recipe.get(\"_at\")\n  if not workshop_name:\n      return total_reward # No workshop specified for this recipe.\n\n  workshop_idx = cookbook.index[workshop_name]\n\n  # 4. Locate the workshop's position on the grid.\n  workshop_pos = None\n  for x_grid in range(WIDTH):\n      for y_grid in range(HEIGHT):\n          if current_state.grid[x_grid, y_grid, workshop_idx] == 1:\n              workshop_pos = (x_grid, y_grid)\n              break\n      if workshop_pos: # Workshop found, exit outer loop.\n          break\n  \n  # If the required workshop is not present in the current grid, crafting is impossible.\n  if not workshop_pos:\n      return total_reward\n\n  # 5. Pathfinding to an empty cell adjacent to the workshop, ensuring the agent faces it correctly.\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Get the agent's initial direction.\n  \n  # Map movement actions to their corresponding (dx, dy) vectors.\n  move_actions_map = {\n      DOWN: (0, -1),\n      UP: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n  \n  # Determine all valid target cells adjacent to the workshop and the required facing direction.\n  target_adj_cells_info = [] # Stores: ((adj_x, adj_y), required_facing_dir)\n  for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Check all four direct neighbors of the workshop.\n      adj_x, adj_y = workshop_pos[0] + dx, workshop_pos[1] + dy\n      \n      # Determine the direction the agent needs to face to interact with the workshop from this adjacent cell.\n      required_facing_dir = None\n      if dx == -1: required_facing_dir = RIGHT\n      elif dx == 1: required_facing_dir = LEFT\n      elif dy == -1: required_facing_dir = UP\n      elif dy == 1: required_facing_dir = DOWN\n      \n      # Check if the adjacent cell is within bounds and is completely empty (no items, no boundaries).\n      if (0 <= adj_x < WIDTH and 0 <= adj_y < HEIGHT and \n          not current_state.grid[adj_x, adj_y, :].any()):\n          target_adj_cells_info.append(((adj_x, adj_y), required_facing_dir))\n\n  # If no valid adjacent and empty cells are found, the workshop cannot be accessed.\n  if not target_adj_cells_info:\n      return total_reward\n\n  # Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  # to reach an appropriate crafting spot (adjacent to workshop with correct orientation).\n  # The queue stores (current_position_tuple, current_direction_integer, list_of_actions_taken).\n  queue = collections.deque([(start_pos, start_dir, [])])\n  # The 'visited' set stores (position_tuple, direction_integer) to prevent redundant exploration.\n  visited = {(start_pos, start_dir)} \n\n  path_to_craft_spot = None # This will store the list of actions to take.\n\n  while queue:\n      (x, y), current_dir, path = queue.popleft()\n\n      # Check if the current (position, direction) is one of our target crafting spots.\n      for (target_x, target_y), required_dir in target_adj_cells_info:\n          if (x, y) == (target_x, target_y) and current_dir == required_dir:\n              path_to_craft_spot = path\n              break # Found a valid path, exit inner loop.\n      if path_to_craft_spot:\n          break # Found a valid path, exit outer BFS loop.\n\n      # Explore possible next moves (actions) from the current state.\n      for action, (dx, dy) in move_actions_map.items():\n          next_x_attempt, next_y_attempt = x + dx, y + dy\n          \n          # The agent's direction always changes to the 'action' taken.\n          sim_next_dir = action \n\n          # Simulate the outcome of taking 'action' on position:\n          # Movement is blocked if the target cell is out of bounds or occupied by any object.\n          sim_next_pos = (x, y) # Default: agent stays put if blocked or out of bounds.\n          if (0 <= next_x_attempt < WIDTH and 0 <= next_y_attempt < HEIGHT and\n              not current_state.grid[next_x_attempt, next_y_attempt, :].any()):\n              sim_next_pos = (next_x_attempt, next_y_attempt) # Agent successfully moves.\n\n          # If this simulated new state (position + direction) hasn't been visited, add it to the queue.\n          if (sim_next_pos, sim_next_dir) not in visited:\n              visited.add((sim_next_pos, sim_next_dir))\n              queue.append((sim_next_pos, sim_next_dir, path + [action]))\n\n  # If no path to a valid crafting spot (with correct orientation) was found, return the current reward.\n  if not path_to_craft_spot:\n      return total_reward\n\n  # 6. Execute the determined movement actions in the environment.\n  for action in path_to_craft_spot:\n      reward, _, _ = env.step(action)\n      total_reward += reward\n\n  # At this point, the agent is at the correct position adjacent to the workshop\n  # and is facing the correct direction, as determined by the BFS.\n\n  # 7. Execute the USE action to perform the crafting.\n  reward, _, _ = env.step(USE)\n  total_reward += reward\n  \n  return total_reward", "island_id": 7, "scores": {"3": 0.0}}
