{"timestamp": "2025-07-24T08:08:51.172098", "function_name": "craft", "function_body": "  total_reward = 0.0\n  # Define constants for grid dimensions\n  WIDTH = 12\n  HEIGHT = 12\n\n  # A generous upper bound for navigation and action attempts.\n  # This prevents infinite loops if the agent gets stuck or the item is uncraftable.\n  max_action_attempts = WIDTH * HEIGHT * 5 \n\n  cookbook = env.world.cookbook\n  \n  # Get the item ID from the cookbook index\n  item_id = cookbook.index[item]\n\n  # 1. Validate if the item is craftable according to recipes.\n  if item_id not in cookbook.recipes:\n    # If the item is not a known craftable recipe, return 0 reward.\n    return total_reward \n\n  recipe = cookbook.recipes[item_id]\n\n  # 2. Identify the required workshop for crafting this item.\n  # Craftable items in this environment's recipes typically specify a workshop with \"_at\".\n  if \"_at\" not in recipe:\n    # If the recipe does not specify a workshop, we cannot craft it.\n    return total_reward \n\n  workshop_name = recipe[\"_at\"]\n  workshop_id = cookbook.index[workshop_name]\n\n  # Store action specifications for cleaner code\n  action_specs = env.action_specs()\n  DOWN = action_specs['DOWN']\n  UP = action_specs['UP']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  # Mapping of direction index to (dx, dy) deltas for facing calculation\n  direction_deltas = {\n      DOWN: (0, -1),\n      UP: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  # 3. Loop to navigate to the workshop and then perform the 'USE' action.\n  for _ in range(max_action_attempts):\n    obs = env.observations()\n    current_state_features = obs['features_dict']\n\n    # Get agent's actual (x, y) coordinates on the grid.\n    # The 'pos' in features_dict is normalized (0-1), so scale it back.\n    agent_x = int(current_state_features['pos'][0] * WIDTH)\n    agent_y = int(current_state_features['pos'][1] * HEIGHT)\n    grid = current_state_features['features_global']\n\n    # Find the precise (x, y) coordinates of the required workshop on the global grid.\n    # Assumes there's only one instance of the required workshop.\n    workshop_coords = None\n    # Iterate through the grid to find the workshop's location\n    for x_coord in range(WIDTH):\n      for y_coord in range(HEIGHT):\n        if grid[x_coord, y_coord, workshop_id] == 1:\n          workshop_coords = (x_coord, y_coord)\n          break # Found workshop, break inner loop\n      if workshop_coords:\n        break # Found workshop, break outer loop\n\n    if workshop_coords is None:\n      # Workshop is not present on the map. Cannot craft.\n      return total_reward\n\n    wx, wy = workshop_coords\n\n    # Get the agent's current direction\n    agent_dir_idx = np.argmax(current_state_features['direction'])\n    dx_facing, dy_facing = direction_deltas.get(agent_dir_idx, (0,0)) \n\n    # Calculate the coordinates of the cell the agent is currently facing.\n    target_nx, target_ny = agent_x + dx_facing, agent_y + dy_facing\n\n    # Check if the cell the agent is currently facing contains the workshop.\n    is_facing_workshop = False\n    if (0 <= target_nx < WIDTH and 0 <= target_ny < HEIGHT and \n        grid[target_nx, target_ny, workshop_id] == 1):\n        is_facing_workshop = True\n\n    # 4. If agent is positioned correctly and facing the workshop, perform 'USE' action.\n    if is_facing_workshop:\n      reward, done, _ = env.step(USE)\n      total_reward += reward\n      if done:\n        # If the environment signals 'done', it means the overall task (which might be crafting) is complete\n        # or max_steps were reached for the environment.\n        return total_reward\n      else:\n        # If 'USE' was successful but 'done' is not True, it implies crafting was attempted.\n        # For a 'craft' function, a successful 'USE' at the workshop for the item is\n        # typically considered its completion, even if the overall environment task isn't finished.\n        # We can exit here as the specific \"craft\" action is completed.\n        return total_reward \n\n    # 5. If not positioned for 'USE', decide on a movement or turn action.\n    action_to_take = -1 # Initialize with an invalid action.\n\n    # Priority 1: If workshop is adjacent but not faced, turn to face it.\n    # Check all 4 cardinal directions around the agent for the workshop.\n    # This ensures we prioritize turning over moving if already adjacent.\n    if agent_y > 0 and grid[agent_x, agent_y - 1, workshop_id] == 1: # Workshop is to agent's DOWN\n        if agent_dir_idx != DOWN:\n            action_to_take = DOWN\n    elif agent_y < HEIGHT - 1 and grid[agent_x, agent_y + 1, workshop_id] == 1: # Workshop is to agent's UP\n        if agent_dir_idx != UP:\n            action_to_take = UP\n    elif agent_x > 0 and grid[agent_x - 1, agent_y, workshop_id] == 1: # Workshop is to agent's LEFT\n        if agent_dir_idx != LEFT:\n            action_to_take = LEFT\n    elif agent_x < WIDTH - 1 and grid[agent_x + 1, agent_y, workshop_id] == 1: # Workshop is to agent's RIGHT\n        if agent_dir_idx != RIGHT:\n            action_to_take = RIGHT\n    \n    # Priority 2: If no turn was needed (i.e., workshop not adjacent or already facing,\n    # but not in a position to USE), move closer to the workshop using Manhattan distance heuristic.\n    if action_to_take == -1:\n        dx = wx - agent_x\n        dy = wy - agent_y\n\n        # Prefer moving along the dimension with the largest absolute distance.\n        if abs(dx) > abs(dy): \n            if dx > 0:\n                action_to_take = RIGHT\n            elif dx < 0:\n                action_to_take = LEFT\n        else: # Prefer moving vertically if vertical distance is greater or equal, or dx is 0\n            if dy > 0:\n                action_to_take = UP\n            elif dy < 0:\n                action_to_take = DOWN\n            # If dx == 0 and dy == 0, it means agent_x, agent_y == wx, wy.\n            # Agent cannot occupy the same cell as a workshop, so this case implies being stuck or an issue.\n            else: # dx == 0 and dy == 0, agent is at workshop location (should be impossible)\n                break # Exit loop, cannot resolve.\n\n    # 6. Execute the chosen movement/turn action.\n    if action_to_take != -1:\n        reward, done, _ = env.step(action_to_take)\n        total_reward += reward\n        if done:\n          # Overall task completed or max environment steps reached.\n          return total_reward\n    else:\n        # This branch implies an unhandled state where no action was determined (e.g., stuck, no path).\n        break # Exit loop.\n\n  # If the loop completes (max_action_attempts exhausted) without the 'done' flag\n  # being set to True by the environment, or the 'USE' action being successfully executed and exited.\n  return total_reward", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T08:08:52.325719", "function_name": "craft", "function_body": "  total_reward = 0.0\n  # Define environment constants. WIDTH and HEIGHT are hardcoded in CraftWorld.\n  WIDTH = 12\n  HEIGHT = 12\n  # A generous upper bound for navigation and action attempts.\n  # This prevents infinite loops if the agent gets stuck or the item is uncraftable.\n  max_action_attempts = WIDTH * HEIGHT * 5 \n\n  cookbook = env.world.cookbook\n  \n  # Get the numerical ID for the target item.\n  item_id = cookbook.index[item]\n\n  # 1. Validate if the item is craftable according to recipes.\n  if item_id not in cookbook.recipes:\n    # If the item is not a known craftable recipe, return 0 reward.\n    return total_reward \n\n  recipe = cookbook.recipes[item_id]\n\n  # 2. Identify the required workshop for crafting this item.\n  # Craftable items in this environment's recipes typically specify a workshop with \"_at\".\n  if \"_at\" not in recipe:\n    # If the recipe does not specify a workshop, it cannot be crafted this way.\n    return total_reward \n\n  workshop_name = recipe[\"_at\"]\n  workshop_id = cookbook.index[workshop_name]\n\n  # Define direction deltas for calculating the cell the agent is facing.\n  # These correspond to DOWN, UP, LEFT, RIGHT actions and the direction they result in.\n  direction_to_delta = {\n      env.action_specs()['DOWN']: (0, -1),\n      env.action_specs()['UP']: (0, 1),\n      env.action_specs()['LEFT']: (-1, 0),\n      env.action_specs()['RIGHT']: (1, 0),\n  }\n\n  # 3. Loop to navigate to the workshop and then perform the 'USE' action.\n  for _ in range(max_action_attempts):\n    obs = env.observations()\n    current_state_features = obs['features_dict']\n\n    # Get agent's actual (x, y) coordinates on the grid.\n    # The 'pos' in features_dict is normalized (0-1).\n    agent_x = int(round(current_state_features['pos'][0] * (WIDTH - 1))) # Scale back to grid coords\n    agent_y = int(round(current_state_features['pos'][1] * (HEIGHT - 1)))\n    grid = current_state_features['features_global']\n    \n    # Get current facing direction of the agent.\n    agent_dir_idx = np.argmax(current_state_features['direction'])\n\n    # Find the precise (x, y) coordinates of the required workshop on the global grid.\n    # Assumes there's at most one instance of the required workshop.\n    workshop_coords = None\n    # Iterate over a slightly larger area around the agent first, then full grid if not found.\n    # This optimization is less critical for a 12x12 grid, but good practice.\n    for x_coord in range(WIDTH):\n      for y_coord in range(HEIGHT):\n        if grid[x_coord, y_coord, workshop_id] == 1:\n          workshop_coords = (x_coord, y_coord)\n          break\n      if workshop_coords:\n        break\n\n    if workshop_coords is None:\n      # Workshop is not present on the map. Cannot craft.\n      return total_reward\n\n    wx, wy = workshop_coords\n\n    # Determine the cell the agent is currently facing.\n    dx_facing, dy_facing = direction_to_delta.get(agent_dir_idx, (0, 0))\n    target_facing_x, target_facing_y = agent_x + dx_facing, agent_y + dy_facing\n\n    # Check if the cell the agent is currently facing contains the workshop.\n    is_facing_workshop = False\n    if (0 <= target_facing_x < WIDTH and 0 <= target_facing_y < HEIGHT and \n        grid[target_facing_x, target_facing_y, workshop_id] == 1):\n        is_facing_workshop = True\n\n    # 4. If agent is positioned correctly and facing the workshop, perform 'USE' action.\n    if is_facing_workshop:\n      reward, done, _ = env.step(env.action_specs()['USE'])\n      total_reward += reward\n      # If the environment signals \"done\", it means the overall task (which might be crafting this item)\n      # is complete, or max_steps were reached.\n      if done:\n        return total_reward \n      else:\n        # If 'USE' was performed but 'done' is not True, it implies the crafting itself\n        # was attempted. For the purpose of this function, we can consider the craft \"attempted\".\n        # If the environment requires more steps (e.g., picking up the crafted item),\n        # that would be handled by subsequent DSL calls.\n        return total_reward \n\n    # 5. If not positioned for 'USE', decide on a movement or turn action.\n    action_to_take = -1 # Initialize with an invalid action.\n\n    # Priority 1: If workshop is adjacent but not faced, turn to face it.\n    # Check all 4 cardinal directions around the agent for the workshop.\n    # (x, y-1) is DOWN from agent\n    if agent_y > 0 and grid[agent_x, agent_y - 1, workshop_id] == 1:\n        if agent_dir_idx != env.action_specs()['DOWN']:\n            action_to_take = env.action_specs()['DOWN']\n    # (x, y+1) is UP from agent\n    elif agent_y < HEIGHT - 1 and grid[agent_x, agent_y + 1, workshop_id] == 1:\n        if agent_dir_idx != env.action_specs()['UP']:\n            action_to_take = env.action_specs()['UP']\n    # (x-1, y) is LEFT from agent\n    elif agent_x > 0 and grid[agent_x - 1, agent_y, workshop_id] == 1:\n        if agent_dir_idx != env.action_specs()['LEFT']:\n            action_to_take = env.action_specs()['LEFT']\n    # (x+1, y) is RIGHT from agent\n    elif agent_x < WIDTH - 1 and grid[agent_x + 1, agent_y, workshop_id] == 1:\n        if agent_dir_idx != env.action_specs()['RIGHT']:\n            action_to_take = env.action_specs()['RIGHT']\n\n    # Priority 2: If no turn was needed (i.e., workshop not adjacent or already facing, but not at correct position),\n    # move closer to the workshop using a simple Manhattan distance heuristic.\n    if action_to_take == -1:\n        dx_to_workshop = wx - agent_x\n        dy_to_workshop = wy - agent_y\n\n        # If agent is already adjacent to workshop, but not facing it,\n        # the previous block should have set an action_to_take.\n        # This block is for when the agent needs to move to become adjacent.\n\n        # Prefer moving horizontally if horizontal distance is greater or equal\n        if abs(dx_to_workshop) >= abs(dy_to_workshop):\n            if dx_to_workshop > 0:\n                action_to_take = env.action_specs()['RIGHT']\n            elif dx_to_workshop < 0:\n                action_to_take = env.action_specs()['LEFT']\n            elif dy_to_workshop != 0: # If dx is 0, but dy is not, move vertically\n                if dy_to_workshop > 0:\n                    action_to_take = env.action_specs()['UP']\n                else: # dy_to_workshop < 0\n                    action_to_take = env.action_specs()['DOWN']\n            else: # dx_to_workshop == 0 and dy_to_workshop == 0. Agent is at workshop location (impossible scenario).\n                break # Cannot proceed.\n        else: # Prefer moving vertically\n            if dy_to_workshop > 0:\n                action_to_take = env.action_specs()['UP']\n            elif dy_to_workshop < 0:\n                action_to_take = env.action_specs()['DOWN']\n            # dx_to_workshop must be non-zero if we are in this 'else' branch and dy_to_workshop is 0\n            elif dx_to_workshop != 0: \n                if dx_to_workshop > 0:\n                    action_to_take = env.action_specs()['RIGHT']\n                else: # dx_to_workshop < 0\n                    action_to_take = env.action_specs()['LEFT']\n            else: # dx_to_workshop == 0 and dy_to_workshop == 0. Agent is at workshop location.\n                break # Cannot proceed.\n\n\n    # 6. Execute the chosen movement/turn action.\n    if action_to_take != -1:\n        reward, done, _ = env.step(action_to_take)\n        total_reward += reward\n        if done:\n          return total_reward # Overall task completed or max environment steps reached.\n    else:\n        # This branch implies an unhandled state where no action was determined (e.g., stuck, or already at target).\n        # Since we check for `is_facing_workshop` first, this `else` indicates an issue if `action_to_take` is still -1.\n        break # Exit loop.\n\n  # If the loop completes (max_action_attempts exhausted) without the 'done' flag\n  # being set to True by the environment, or without successfully performing USE.\n  return total_reward", "island_id": 9, "scores": {"3": 0.0}}
