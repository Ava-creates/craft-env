{"timestamp": "2025-07-24T09:31:34.740406", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Constants for grid dimensions (from CraftWorld.py)\n  WIDTH = 12\n  HEIGHT = 12\n\n  # Helper for directions (dx, dy) to their corresponding action values.\n  # Used for orienting and checking adjacency.\n  move_deltas = {\n      (0, -1): ACTION_DOWN,\n      (0, 1): ACTION_UP,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT\n  }\n\n  def perform_step(action):\n      nonlocal total_reward # Allows modification of total_reward from outer scope\n      reward, done, _ = env.step(action)\n      total_reward += reward\n      return done\n\n  # 1. Get the target item's index and its recipe\n  cookbook = env.world.cookbook\n  try:\n    goal_idx = cookbook.index[item]\n    recipe = cookbook.recipes.get(goal_idx)\n  except KeyError:\n    # Item not in cookbook index, cannot craft.\n    return total_reward \n\n  if recipe is None:\n    # If it's a primitive or an item without a recipe (e.g., \"boundary\"), cannot craft via recipe.\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # Recipe requires no specific workshop, or malformed recipe. Cannot craft without workshop for now.\n    return total_reward\n  workshop_idx = cookbook.index[workshop_name]\n\n  ingredients = {\n      idx: count\n      for idx, count in recipe.items() if isinstance(idx, int)\n  }\n\n  # 2. Collect all necessary ingredients\n  for ingredient_idx, needed_count in ingredients.items():\n    while env.observations()['features_dict']['inventory'][ingredient_idx] < needed_count:\n      current_state = env._current_state\n      x, y = current_state.pos\n      grid = current_state.grid\n      \n      # Step 2a: Check if ingredient is directly adjacent and try to collect it\n      collected_adjacent = False\n      for (dx, dy), action_val in move_deltas.items():\n          nx, ny = x + dx, y + dy\n          # Check bounds and if the ingredient is at this adjacent cell\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, ingredient_idx] == 1:\n              # Ingredient found adjacent. Orient towards it if necessary.\n              if current_state.dir != action_val:\n                  if perform_step(action_val): return total_reward # Turn\n                  current_state = env._current_state # Update state after turning\n              \n              # Now USE to collect the item\n              if perform_step(ACTION_USE): return total_reward\n              collected_adjacent = True\n              break # Item collected, exit inner direction-check loop\n      \n      if collected_adjacent:\n          continue # Successfully collected, re-check inventory for this ingredient\n\n      # Step 2b: If not adjacent or not collected, try to move towards the closest ingredient\n      item_locations = np.argwhere(grid[:, :, ingredient_idx] == 1)\n      \n      if len(item_locations) == 0:\n          # Ingredient not currently visible on the grid. This might happen if it's outside\n          # the current view (if a partial view was used for `grid`) or if it's simply\n          # not in a reachable area (unlikely for simple Craft scenarios).\n          # As a fallback, try a random exploratory move.\n          random_action = np.random.choice([ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT])\n          if perform_step(random_action): return total_reward\n          continue # Re-evaluate after moving\n\n      # Find the closest item location using Manhattan distance\n      current_pos_array = np.array(current_state.pos)\n      distances = np.sum(np.abs(item_locations - current_pos_array), axis=1)\n      closest_item_pos = item_locations[np.argmin(distances)]\n      \n      target_x, target_y = closest_item_pos\n      \n      # Determine the best single step to reduce Manhattan distance\n      moved_towards_target = False\n      # Prioritize movement along the X-axis first, then Y-axis to ensure consistent progress.\n      if target_x > x: # Need to move RIGHT\n          if perform_step(ACTION_RIGHT): return total_reward\n          moved_towards_target = True\n      elif target_x < x: # Need to move LEFT\n          if perform_step(ACTION_LEFT): return total_reward\n          moved_towards_target = True\n      elif target_y > y: # Need to move UP (Y increases upwards in Craft env)\n          if perform_step(ACTION_UP): return total_reward\n          moved_towards_target = True\n      elif target_y < y: # Need to move DOWN\n          if perform_step(ACTION_DOWN): return total_reward\n          moved_towards_target = True\n      \n      if not moved_towards_target:\n          # This case implies agent is at the target's coordinates but not yet collected,\n          # or the path is blocked, or no simple move reduces distance.\n          # If a targeted move didn't occur, try a random exploratory move.\n          random_action = np.random.choice([ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT])\n          if perform_step(random_action): return total_reward\n\n  # 3. Move to the workshop\n  while not env._current_state.next_to(workshop_idx):\n    current_state = env._current_state\n    x, y = current_state.pos\n    grid = current_state.grid\n    \n    # Find workshop location on the grid\n    workshop_locations = np.argwhere(grid[:, :, workshop_idx] == 1)\n    \n    if len(workshop_locations) == 0:\n        # Workshop not found on grid (should not happen in typical Craft scenarios).\n        # Fallback to random exploration if workshop isn't immediately visible/reachable.\n        random_action = np.random.choice([ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT])\n        if perform_step(random_action): return total_reward\n        continue\n    \n    current_pos_array = np.array(current_state.pos)\n    distances = np.sum(np.abs(workshop_locations - current_pos_array), axis=1)\n    closest_workshop_pos = workshop_locations[np.argmin(distances)]\n    \n    target_x, target_y = closest_workshop_pos\n    \n    moved_towards_target = False\n    # Prioritize moving in X direction first, then Y.\n    if target_x > x: # Need to move RIGHT\n        if perform_step(ACTION_RIGHT): return total_reward\n        moved_towards_target = True\n    elif target_x < x: # Need to move LEFT\n        if perform_step(ACTION_LEFT): return total_reward\n        moved_towards_target = True\n    elif target_y > y: # Need to move UP\n        if perform_step(ACTION_UP): return total_reward\n        moved_towards_target = True\n    elif target_y < y: # Need to move DOWN\n        if perform_step(ACTION_DOWN): return total_reward\n        moved_towards_target = True\n    \n    if not moved_towards_target:\n        # If no simple targeted move could be made (e.g., blocked or already at target X/Y but not adjacent)\n        random_action = np.random.choice([ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT])\n        if perform_step(random_action): return total_reward\n\n  # 4. Craft the item at the workshop\n  current_state = env._current_state # Get latest state after moving to be adjacent\n  \n  # Orient towards the workshop block\n  target_adjacent_action = None\n  x, y = current_state.pos\n  grid = current_state.grid\n  for (dx, dy), action_val in move_deltas.items():\n      nx, ny = x + dx, y + dy\n      if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and grid[nx, ny, workshop_idx] == 1:\n          target_adjacent_action = action_val\n          break\n  \n  if target_adjacent_action is not None:\n      # If not facing the workshop, turn towards it\n      if current_state.dir != target_adjacent_action:\n          if perform_step(target_adjacent_action): return total_reward\n      \n      # Now USE the workshop to craft\n      if perform_step(ACTION_USE): return total_reward\n  \n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-24T09:31:35.857416", "function_name": "craft", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-24T09:32:34.466963", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Get action mappings from the environment\n  ACTIONS = env.action_specs()\n  ACTION_UP = ACTIONS['UP']\n  ACTION_DOWN = ACTIONS['DOWN']\n  ACTION_LEFT = ACTIONS['LEFT']\n  ACTION_RIGHT = ACTIONS['RIGHT']\n  ACTION_USE = ACTIONS['USE']\n\n  # 1. Get the target item's index.\n  # Use .get() to safely handle cases where the item might not be in the index.\n  item_idx = env.world.cookbook.index.get(item)\n  if item_idx is None:\n      # Item not recognized by the cookbook.\n      return total_reward\n\n  # 2. Get the recipe for the item to find the required workshop.\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  if recipe is None:\n    # Item cannot be crafted or doesn't exist as a recipe output in recipes.\n    return total_reward\n\n  workshop_name = recipe.get('_at')\n  if workshop_name is None:\n    # Item might be a primitive (not craftable), or its recipe does not specify a workshop.\n    # For the 'craft' function, we assume a workshop is involved.\n    return total_reward\n\n  # 3. Find the coordinates of the required workshop in the current grid.\n  workshop_idx = env.world.cookbook.index.get(workshop_name)\n  if workshop_idx is None:\n      # Workshop name not recognized by the cookbook.\n      return total_reward\n  \n  # Find all instances of the workshop in the current grid.\n  all_workshop_coords = np.argwhere(env._current_state.grid[:, :, workshop_idx] == 1)\n\n  if len(all_workshop_coords) == 0:\n    # The required workshop is not present in the current grid.\n    return total_reward\n\n  # Determine the single workshop to target: the one closest to the agent.\n  curr_agent_x, curr_agent_y = env._current_state.pos\n  closest_workshop_x, closest_workshop_y = -1, -1\n  min_distance_to_workshop = float('inf')\n\n  for wx, wy in all_workshop_coords:\n      # Calculate Manhattan distance to workshop.\n      dist = abs(curr_agent_x - wx) + abs(curr_agent_y - wy)\n      if dist < min_distance_to_workshop:\n          min_distance_to_workshop = dist\n          closest_workshop_x, closest_workshop_y = wx, wy\n  \n  target_workshop_x, target_workshop_y = closest_workshop_x, closest_workshop_y\n\n  # 4. Identify valid cardinal positions around the chosen workshop where the agent can stand and use.\n  # These are potential \"staging\" positions.\n  WIDTH = env.world.WIDTH\n  HEIGHT = env.world.HEIGHT\n\n  possible_use_positions_and_dirs = []\n  \n  # Agent to the left of workshop, facing RIGHT\n  possible_use_positions_and_dirs.append(((target_workshop_x - 1, target_workshop_y), ACTION_RIGHT))\n  # Agent to the right of workshop, facing LEFT\n  possible_use_positions_and_dirs.append(((target_workshop_x + 1, target_workshop_y), ACTION_LEFT))\n  # Agent below workshop, facing UP\n  possible_use_positions_and_dirs.append(((target_workshop_x, target_workshop_y - 1), ACTION_UP))\n  # Agent above workshop, facing DOWN\n  possible_use_positions_and_dirs.append(((target_workshop_x, target_workshop_y + 1), ACTION_DOWN))\n\n  valid_target_agent_states = [] # Stores ( (x,y), direction_to_face_workshop_from_this_position )\n  for (tx, ty), tdir in possible_use_positions_and_dirs:\n      # Check if the target position is within grid boundaries.\n      if not (0 <= tx < WIDTH and 0 <= ty < HEIGHT):\n          continue\n      # Check if the target position is free (not occupied by any item).\n      # A position is free if the sum of all item counts at that position is 0.\n      if not env._current_state.grid[tx, ty, :].any():\n          valid_target_agent_states.append(((tx, ty), tdir))\n  \n  if not valid_target_agent_states:\n      # No valid free position around the workshop to stand.\n      return total_reward\n\n  # Choose the closest valid agent target state (position + direction) from the current agent position.\n  target_agent_pos = None\n  target_agent_dir = -1\n  min_dist_to_target_pos = float('inf')\n\n  for (tx, ty), tdir in valid_target_agent_states:\n      dist = abs(curr_agent_x - tx) + abs(curr_agent_y - ty)\n      if dist < min_dist_to_target_pos:\n          min_dist_to_target_pos = dist\n          target_agent_pos = (tx, ty)\n          target_agent_dir = tdir\n  \n  if target_agent_pos is None:\n      # This should theoretically not happen if valid_target_agent_states was not empty.\n      return total_reward\n\n  # 5. Move the agent to the selected target position and orient it correctly.\n  # Set a maximum number of steps for this sub-task to prevent infinite loops.\n  # Using a multiplier of grid size is a common heuristic.\n  max_movement_attempts = env.world.WIDTH * env.world.HEIGHT * 2 \n  steps_taken_in_subtask = 0\n  \n  while (env._current_state.pos != target_agent_pos or \n         env._current_state.dir != target_agent_dir) and steps_taken_in_subtask < max_movement_attempts:\n      \n    curr_x, curr_y = env._current_state.pos\n    curr_dir = env._current_state.dir\n    action_to_take = -1\n\n    # First priority: Move towards the target position.\n    # Prefer moving horizontally if not aligned, then vertically.\n    if curr_x < target_agent_pos[0]:\n      action_to_take = ACTION_RIGHT\n    elif curr_x > target_agent_pos[0]:\n      action_to_take = ACTION_LEFT\n    elif curr_y < target_agent_pos[1]:\n      action_to_take = ACTION_UP\n    elif curr_y > target_agent_pos[1]:\n      action_to_take = ACTION_DOWN\n    \n    # If a movement action was determined AND agent is not yet at the target position.\n    if action_to_take != -1 and env._current_state.pos != target_agent_pos:\n        old_pos = env._current_state.pos # Store old position to detect if agent gets stuck.\n        reward, done, _ = env.step(action_to_take)\n        total_reward += reward\n        steps_taken_in_subtask += 1\n        \n        if done: # Check if the overall task is completed or failed.\n            return total_reward\n        \n        # If the agent tried to move but didn't change position (means it was blocked),\n        # and it's not at the target position yet, then it's stuck on this path.\n        if env._current_state.pos == old_pos and env._current_state.pos != target_agent_pos:\n            break # Cannot reach target position with simple greedy movement.\n\n    else: # Agent is already at target_agent_pos OR no movement action was determined.\n        # If at the target position, second priority: Ensure facing the correct direction.\n        if curr_dir != target_agent_dir:\n            # Taking a movement action that would move the agent into an occupied space (like the workshop)\n            # will result in the agent's position not changing, but its direction updating. This is\n            # the desired behavior for simply changing orientation.\n            reward, done, _ = env.step(target_agent_dir)\n            total_reward += reward\n            steps_taken_in_subtask += 1\n            if done: \n                return total_reward\n        else:\n            # Agent is at the target position AND facing the correct direction.\n            break # Successfully positioned and oriented, exit loop.\n\n  # After the loop, verify if the agent successfully reached the desired position and orientation.\n  if env._current_state.pos != target_agent_pos or env._current_state.dir != target_agent_dir:\n      # Failed to get into the required position or direction within allowed steps.\n      return total_reward\n\n  # 6. Perform the USE action at the workshop.\n  # The agent is now at `target_agent_pos` and facing `target_agent_dir`, which points directly to the workshop.\n  reward, done, _ = env.step(ACTION_USE)\n  total_reward += reward\n  \n  if done: # Check if the task is completed after attempting to use the workshop.\n    return total_reward\n\n  return total_reward", "island_id": 3, "scores": {"3": 0.0}}
