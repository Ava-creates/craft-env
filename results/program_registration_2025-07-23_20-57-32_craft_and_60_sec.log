{"timestamp": "2025-07-23T21:06:10.696754", "function_name": "craft", "function_body": "  # Constants from Craft environment, assumed to be globally available or defined within scope for this function.\n  # For the purpose of \"function body only\", they are defined here.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  total_reward = 0.0\n\n  # Get item ID from string name\n  try:\n    item_id = env.world.cookbook.index[item]\n  except KeyError:\n    # Item name not found in cookbook, likely an invalid item.\n    return total_reward\n\n  # Get the recipe for the item. Recipes for primitives might not exist or be empty.\n  recipe = env.world.cookbook.recipes.get(item_id)\n\n  # Get needed primitives recursively (this includes primitives for sub-recipes).\n  needed_primitives = env.world.cookbook.primitives_for(item_id)\n\n  # Determine the workshop required for crafting (if any)\n  workshop_id = None\n  if recipe is not None and '_at' in recipe:\n    try:\n      workshop_name = recipe['_at']\n      workshop_id = env.world.cookbook.index[workshop_name]\n    except KeyError:\n      # Workshop name specified in recipe but not found in cookbook index.\n      return total_reward\n\n  # Main loop for acquiring ingredients and crafting the item.\n  # We loop for a maximum number of operations to prevent infinite loops in complex scenarios,\n  # also relying on the environment's `max_steps` to eventually terminate.\n  max_loop_iterations = 200 # A reasonable upper bound for simple scenarios\n\n  for _ in range(max_loop_iterations):\n    current_state = env._current_state\n\n    # Check if the goal item is already in inventory\n    # `satisfies` method checks if `inventory[goal_arg] > 0`.\n    if current_state.satisfies(item, item_id):\n      break # Goal achieved, exit crafting loop\n\n    # Check if the environment has run out of steps\n    if env.steps >= env.max_steps:\n      break # Cannot complete task due to max steps limit\n\n    # Phase 1: Collect missing primitive ingredients\n    all_primitives_collected = True\n    for p_id, p_count_needed in needed_primitives.items():\n      if current_state.inventory[p_id] < p_count_needed:\n        all_primitives_collected = False # Mark that we still need primitives\n\n        # Find the primitive on the grid. Find the closest one if multiple exist.\n        target_pos = None\n        min_dist = float('inf')\n        current_x, current_y = current_state.pos\n        \n        found_primitive_on_map = False\n        # Iterate through the entire grid to find an instance of the primitive\n        for x_coord in range(WIDTH): # WIDTH and HEIGHT are global constants from the environment\n          for y_coord in range(HEIGHT):\n            if current_state.grid[x_coord, y_coord, p_id] == 1:\n              # Calculate Manhattan distance to prioritize closer items\n              dist = abs(x_coord - current_x) + abs(y_coord - current_y)\n              if dist < min_dist:\n                min_dist = dist\n                target_pos = (x_coord, y_coord)\n                found_primitive_on_map = True\n        \n        if not found_primitive_on_map:\n          # If a needed primitive is not found on the map, we cannot complete the task.\n          return total_reward\n\n        # Move towards the target_pos (primitive) until adjacent\n        # The agent needs to be adjacent to the item to `USE` it.\n        while not current_state.next_to(p_id):\n          (ax, ay) = current_state.pos\n          (tx, ty) = target_pos\n          \n          action_to_take = -1\n          # Simple greedy pathing: prioritize moving horizontally then vertically\n          if tx > ax:\n            action_to_take = RIGHT\n          elif tx < ax:\n            action_to_take = LEFT\n          elif ty > ay: # In CraftWorld, Y increases upwards\n            action_to_take = UP\n          elif ty < ay:\n            action_to_take = DOWN\n          \n          if action_to_take != -1:\n            r, _, _ = env.step(action_to_take)\n            total_reward += r\n            current_state = env._current_state # Update state after action\n            \n            # Check if agent is stuck (e.g., hit a boundary or another impassable object)\n            if current_state.pos == (ax, ay):\n              return total_reward # Cannot reach target, stuck\n          else:\n            # This case means (ax,ay) is already (tx,ty), or no simple greedy path.\n            # `next_to` check should prevent this if `target_pos` is always valid.\n            return total_reward # Should not happen if target is reachable and distinct.\n\n          # Check max_steps during movement as well\n          if env.steps >= env.max_steps:\n            return total_reward\n\n        # Once adjacent to the primitive, use it to collect\n        (ax, ay) = current_state.pos\n        (tx, ty) = target_pos\n        \n        # Orient the agent towards the target for the USE action\n        if tx > ax:\n          current_state.dir = RIGHT\n        elif tx < ax:\n          current_state.dir = LEFT\n        elif ty > ay:\n          current_state.dir = UP\n        elif ty < ay:\n          current_state.dir = DOWN\n        # If the item is directly above/below/left/right, current_state.dir is set.\n\n        r, _, _ = env.step(USE)\n        total_reward += r\n        # The environment state (`env._current_state`) is automatically updated by `env.step()`.\n        \n        # After collecting one primitive, break from this inner loop and re-evaluate\n        # all primitive needs from scratch in the main loop, as inventory has changed.\n        break # Exit `for p_id, p_count_needed` loop\n\n    # Phase 2: If all primitives are collected (or no more are found on the map\n    # but still needed, the outer loop will terminate), move to workshop and craft.\n    if all_primitives_collected:\n      if workshop_id is not None:\n        # Find the workshop on the grid. Find the closest one.\n        target_pos = None\n        min_dist = float('inf')\n        current_x, current_y = current_state.pos\n        \n        found_workshop_on_map = False\n        for x_coord in range(WIDTH):\n          for y_coord in range(HEIGHT):\n            if current_state.grid[x_coord, y_coord, workshop_id] == 1:\n              dist = abs(x_coord - current_x) + abs(y_coord - current_y)\n              if dist < min_dist:\n                min_dist = dist\n                target_pos = (x_coord, y_coord)\n                found_workshop_on_map = True\n        \n        if not found_workshop_on_map:\n          # If the required workshop is not found, cannot craft.\n          return total_reward\n\n        # Move towards the workshop until adjacent\n        while not current_state.next_to(workshop_id):\n          (ax, ay) = current_state.pos\n          (tx, ty) = target_pos\n          \n          action_to_take = -1\n          if tx > ax:\n            action_to_take = RIGHT\n          elif tx < ax:\n            action_to_take = LEFT\n          elif ty > ay:\n            action_to_take = UP\n          elif ty < ay:\n            action_to_take = DOWN\n          \n          if action_to_take != -1:\n            r, _, _ = env.step(action_to_take)\n            total_reward += r\n            current_state = env._current_state\n            if current_state.pos == (ax, ay): # Stuck while moving to workshop\n              return total_reward\n          else:\n            return total_reward # Should not happen\n\n          if env.steps >= env.max_steps:\n            return total_reward\n        \n        # Once adjacent to workshop, use it to craft\n        (ax, ay) = current_state.pos\n        (tx, ty) = target_pos\n\n        # Orient agent towards workshop\n        if tx > ax:\n          current_state.dir = RIGHT\n        elif tx < ax:\n          current_state.dir = LEFT\n        elif ty > ay:\n          current_state.dir = UP\n        elif ty < ay:\n          current_state.dir = DOWN\n\n        r, _, _ = env.step(USE)\n        total_reward += r\n        # The next iteration of the main loop will check if the goal item is now in inventory.\n      else:\n        # If no workshop is specified for the recipe (e.g., crafting \"in hand\"),\n        # and all primitives are collected, the item is conceptually crafted.\n        # The `satisfies` check at the beginning of the loop will handle this.\n        pass\n    \n  # Return the total reward accumulated during the crafting process.\n  return total_reward", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-23T21:06:11.726826", "function_name": "craft", "function_body": "  total_reward = 0.0\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  item_idx = index.index(item)\n\n  # 1. Get the recipe for the item to find the workshop needed\n  recipe = cookbook.recipes.get(item_idx)\n  if recipe is None:\n    # Item is not craftable via a recipe or is a primitive.\n    # In this context, \"craft\" implies a recipe.\n    return total_reward\n\n  workshop_name = recipe.get(\"_at\")\n  if workshop_name is None:\n    # If a recipe doesn't specify a \"_at\" workshop, it might imply\n    # hand-crafting or a special type of crafting not covered by the\n    # typical workshop interaction. For this function, we assume a workshop is required.\n    return total_reward\n\n  workshop_idx = index.index(workshop_name)\n\n  # 2. Find the workshop location on the grid\n  workshop_pos = None\n  # Access the global grid from the current state's features_dict\n  grid = env._current_state.features_dict()['features_global']\n  workshop_locations = np.argwhere(grid[:, :, workshop_idx] == 1)\n\n  if workshop_locations.size > 0:\n    # Pick the first workshop found (assuming any instance of the workshop will do)\n    workshop_pos = tuple(workshop_locations[0])\n  else:\n    # No workshop of the required type found in the environment. Cannot craft.\n    return total_reward\n\n  # 3. Attempt to move to be adjacent to the workshop and then craft\n  # We limit movement attempts to prevent infinite loops and respect environment step limits.\n  # The environment's max_steps is a reasonable upper bound for any single action.\n  max_movement_attempts = env.max_steps\n\n  for _ in range(max_movement_attempts):\n    current_state = env._current_state\n    agent_x, agent_y = current_state.pos\n    workshop_x, workshop_y = workshop_pos\n\n    # Check if the agent is already adjacent to the workshop\n    is_adjacent = abs(agent_x - workshop_x) + abs(agent_y - workshop_y) == 1\n\n    if is_adjacent:\n      # Agent is adjacent. Now perform the USE action.\n      # The CraftState.step function for USE action checks neighbors(self.pos, self.dir).\n      # This means the agent must be facing the workshop.\n      # Our movement strategy (below) naturally sets the agent's direction\n      # towards the last successful move, which should be towards the target workshop\n      # when it reaches an adjacent position.\n      reward, done, _ = env.step(USE) # USE is a global constant (from craft.py)\n      total_reward += reward\n\n      # After attempting to craft, we exit the function.\n      # The environment might reset if the goal is achieved (done=True).\n      return total_reward\n\n    # If not adjacent, attempt to move closer to the workshop\n    moved_this_step = False\n\n    # Determine preferred movement direction (greedy approach)\n    dx = workshop_x - agent_x\n    dy = workshop_y - agent_y\n\n    action_to_take = -1\n\n    # Prioritize moving horizontally to reduce x-distance\n    if dx > 0:\n      action_to_take = RIGHT # RIGHT is a global constant\n    elif dx < 0:\n      action_to_take = LEFT  # LEFT is a global constant\n    # If x-distance is 0, try to reduce y-distance\n    elif dy > 0:\n      action_to_take = UP   # UP is a global constant\n    elif dy < 0:\n      action_to_take = DOWN # DOWN is a global constant\n\n    if action_to_take != -1:\n      original_agent_pos = current_state.pos\n      reward, done, _ = env.step(action_to_take)\n      total_reward += reward\n\n      # Check if the agent actually moved (i.e., wasn't blocked by an obstacle)\n      if env._current_state.pos != original_agent_pos:\n        moved_this_step = True\n\n    # If no movement occurred (either no action was needed, or the chosen path was blocked)\n    # and the agent is still not adjacent, it means it's stuck or cannot reach the workshop.\n    if not moved_this_step:\n      return total_reward\n\n  # If the loop finishes (max_movement_attempts reached) without successfully crafting,\n  # it means the workshop was not reached or crafting failed.\n  return total_reward", "island_id": 2, "scores": {"3": 0.0}}
