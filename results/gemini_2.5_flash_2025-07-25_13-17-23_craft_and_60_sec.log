{"timestamp": "2025-07-25T15:16:59.050045", "function_name": "craft", "function_body": "  import numpy as np\n  import collections\n\n  # Define action constants locally within the function\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n\n  class _SimulatedCraftState:\n      \"\"\"\n      A simplified state representation for planning purposes, mirroring essential\n      attributes and methods from CraftState but allowing direct manipulation for simulation.\n      \"\"\"\n      def __init__(self, state: 'CraftState'):\n          # Deep copy mutable attributes to ensure independent simulation\n          self.grid = state.grid.copy()\n          self.inventory = state.inventory.copy()\n          self.pos = state.pos\n          self.dir = state.dir\n          # Reference immutable/complex objects from the actual environment\n          self.world = state.world \n          self.scenario = state.scenario \n\n      def get_kind_index(self, kind_name: str) -> int:\n          \"\"\"Helper to get the integer index for a named entity kind.\"\"\"\n          return self.world.cookbook.index[kind_name]\n\n      def _is_traversable(self, r: int, c: int) -> bool:\n          \"\"\"Checks if a grid cell (r, c) is traversable by the agent.\"\"\"\n          grid_width, grid_height, _ = self.grid.shape\n          if not (0 <= r < grid_width and 0 <= c < grid_height):\n              return False\n          \n          # Obstacles like BOUNDARY and WATER are typically not traversable.\n          # We check if these kinds are present at the given cell.\n          boundary_idx = self.get_kind_index('BOUNDARY')\n          water_idx = self.get_kind_index('WATER')\n          \n          # A cell is traversable if it does not contain a boundary or water entity\n          # (assuming a value > 0 indicates presence).\n          return self.grid[r, c, boundary_idx] == 0.0 and self.grid[r, c, water_idx] == 0.0\n\n      def simulate_move(self, action: int):\n          \"\"\"Simulates a move action, updating position and direction if the move is valid.\"\"\"\n          new_r, new_c = self.pos\n          new_dir = self.dir\n\n          if action == _ACTION_UP:\n              new_r -= 1\n              new_dir = 1 # Corresponds to DMLab's UP direction for consistency\n          elif action == _ACTION_DOWN:\n              new_r += 1\n              new_dir = 0 # Corresponds to DMLab's DOWN direction\n          elif action == _ACTION_LEFT:\n              new_c -= 1\n              new_dir = 2 # Corresponds to DMLab's LEFT direction\n          elif action == _ACTION_RIGHT:\n              new_c += 1\n              new_dir = 3 # Corresponds to DMLab's RIGHT direction\n          else:\n              # Not a movement action or an invalid action. No change in pos/dir.\n              return False \n\n          if self._is_traversable(new_r, new_c):\n              self.pos = (new_r, new_c)\n              self.dir = new_dir\n              return True\n          return False\n\n      def get_adjacent_cells(self, pos: tuple[int, int]) -> list[tuple[int, int]]:\n          \"\"\"Returns a list of valid (row, col) coordinates for cells immediately adjacent to `pos`.\"\"\"\n          r, c = pos\n          adj = []\n          # Check 4-directional adjacency (up, down, left, right)\n          for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n              nr, nc = r + dr, c + dc\n              grid_width, grid_height, _ = self.grid.shape\n              if 0 <= nr < grid_width and 0 <= nc < grid_height:\n                  adj.append((nr, nc))\n          return adj\n\n      def is_next_to(self, i_kind: int) -> bool:\n          \"\"\"\n          Checks if the agent's current simulated position is within a 3x3 neighborhood\n          (including the agent's own cell) of any instance of `i_kind`.\n          This mirrors the CraftState.next_to method.\n          \"\"\"\n          r, c = self.pos\n          grid_width, grid_height, _ = self.grid.shape\n          # Iterate over the 3x3 neighborhood around the agent's position\n          for dr in [-1, 0, 1]:\n              for dc in [-1, 0, 1]:\n                  nr, nc = r + dr, c + dc\n                  if 0 <= nr < grid_width and 0 <= nc < grid_height:\n                      # Check if the kind is present at this neighboring cell\n                      if self.grid[nr, nc, i_kind] > 0: \n                          return True\n          return False\n\n      def find_kind_on_grid(self, i_kind: int) -> list[tuple[int, int]]:\n          \"\"\"Returns a list of (row, col) tuples where the specified kind is found on the grid.\"\"\"\n          # np.argwhere returns coordinates where the condition is true.\n          locations = np.argwhere(self.grid[:, :, i_kind] > 0)\n          return [tuple(loc) for loc in locations]\n\n\n  def _pathfind_to_adjacent(sim_state: '_SimulatedCraftState', target_kind_idx: int) -> list[int]:\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find a sequence of movement actions\n      from the current simulated agent's position (`sim_state.pos`) to any cell\n      from which the agent would be considered \"next to\" the `target_kind_idx`.\n      Returns the list of actions or None if no path is found.\n      \"\"\"\n      q = collections.deque([(sim_state.pos, [])]) # Queue stores (current_position, actions_taken_to_reach_here)\n      visited = {sim_state.pos} # Set of visited positions to avoid cycles\n\n      # Action mapping for BFS movement (delta row, delta column) -> action code\n      move_deltas = {\n          (-1, 0): _ACTION_UP,\n          (1, 0): _ACTION_DOWN,\n          (0, -1): _ACTION_LEFT,\n          (0, 1): _ACTION_RIGHT,\n      }\n\n      while q:\n          current_pos, actions_so_far = q.popleft()\n\n          # Check if the agent, if at `current_pos`, would be next to the target kind.\n          # Create a temporary state to use the `is_next_to` method efficiently without modifying the main sim_state.\n          temp_sim_state = _SimulatedCraftState(sim_state) \n          temp_sim_state.pos = current_pos \n          if temp_sim_state.is_next_to(target_kind_idx):\n              return actions_so_far # Path found!\n\n          # Explore valid neighboring cells\n          for (dr, dc), action in move_deltas.items():\n              next_r, next_c = current_pos[0] + dr, current_pos[1] + dc\n              next_pos = (next_r, next_c)\n\n              if sim_state._is_traversable(next_r, next_c) and next_pos not in visited:\n                  visited.add(next_pos)\n                  q.append((next_pos, actions_so_far + [action]))\n      return None # No path found to any adjacent cell of the target kind\n\n\n  def _plan_craft_actions(target_item_idx: int, sim_state: '_SimulatedCraftState') -> list[int]:\n      \"\"\"\n      Recursively plans the sequence of actions needed to acquire a `target_item_idx`.\n      This function modifies the `sim_state` object in place to reflect changes\n      in inventory, position, etc., as actions are \"simulated\".\n      \"\"\"\n      total_actions = []\n      cookbook = sim_state.world.cookbook\n\n      # Base Case 1: If the item is already in the simulated inventory, no actions are needed.\n      if sim_state.inventory[target_item_idx] > 0:\n          return []\n\n      # Base Case 2: If the item is a primitive (can be collected directly from the environment).\n      if target_item_idx in cookbook.primitives:\n          # Find a path to a location adjacent to the primitive and then 'USE' to collect it.\n          path_actions = _pathfind_to_adjacent(sim_state, target_item_idx)\n          if path_actions is None:\n              # Primitive not found on the map or is unreachable. Cannot acquire.\n              return [] \n          \n          total_actions.extend(path_actions)\n          \n          # Simulate the movement actions to update the `sim_state`'s position.\n          for action in path_actions:\n              sim_state.simulate_move(action) \n\n          # Add the 'USE' action and simulate its effect on inventory (assume 1 unit collected per USE).\n          total_actions.append(_ACTION_USE)\n          sim_state.inventory[target_item_idx] += 1 \n          return total_actions\n\n      # Recursive Step: The item is craftable, so we need to process its recipe.\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # Not a primitive and no recipe found. This item cannot be acquired.\n          return [] \n\n      # Separate ingredients from the special '_key' which indicates the required workshop.\n      required_ingredients = {}\n      workshop_kind_idx = None\n      for ingredient_idx_or_key, count in recipe.items():\n          if isinstance(ingredient_idx_or_key, str) and ingredient_idx_or_key.startswith('_key'):\n              # The value associated with '_key' is the name of the workshop (e.g., \"WORKSHOP0\", \"BENCH\").\n              workshop_name = count \n              workshop_kind_idx = sim_state.get_kind_index(workshop_name)\n          else:\n              required_ingredients[ingredient_idx_or_key] = count\n\n      # Recursively acquire all missing ingredients.\n      for ingredient_idx, required_count in required_ingredients.items():\n          while sim_state.inventory[ingredient_idx] < required_count:\n              # Plan actions to get one unit of this ingredient.\n              ingredient_actions = _plan_craft_actions(ingredient_idx, sim_state)\n              if not ingredient_actions:\n                  # If no actions could be planned for a required ingredient, we cannot craft the target item.\n                  return [] \n              \n              total_actions.extend(ingredient_actions)\n              # The `_plan_craft_actions` recursive call already updates `sim_state`'s inventory and position.\n\n      # After all ingredients are in the simulated inventory, move to the required workshop (if any) and 'USE'.\n      if workshop_kind_idx is not None:\n          # If the agent is not already next to the workshop, plan a path to it.\n          if not sim_state.is_next_to(workshop_kind_idx):\n              path_to_workshop_actions = _pathfind_to_adjacent(sim_state, workshop_kind_idx)\n              if path_to_workshop_actions is None:\n                  # Workshop not found or unreachable. Cannot craft.\n                  return [] \n              total_actions.extend(path_to_workshop_actions)\n              # Simulate movement to the workshop location.\n              for action in path_to_workshop_actions:\n                  sim_state.simulate_move(action)\n      \n      # Perform the 'USE' action to craft the item.\n      total_actions.append(_ACTION_USE)\n\n      # Simulate the inventory update: deduct consumed ingredients and add the newly crafted item.\n      sim_state.inventory[target_item_idx] += 1 \n      for ingredient_idx, count in required_ingredients.items():\n          sim_state.inventory[ingredient_idx] -= count \n\n      return total_actions\n\n  # --- Main logic of craft_v2 function ---\n\n  # Create an initial simulated state from the current actual environment state.\n  initial_sim_state = _SimulatedCraftState(env._current_state)\n\n  # If the target item is already in the agent's inventory at the start, no actions are needed.\n  if initial_sim_state.inventory[item_idx_to_craft] > 0:\n      return []\n\n  # Initiate the recursive planning process to find actions for crafting the target item.\n  # The `_plan_craft_actions` function will internally manage the `initial_sim_state`\n  # to track inventory, position, etc., as it determines the action sequence.\n  actions = _plan_craft_actions(item_idx_to_craft, initial_sim_state)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
