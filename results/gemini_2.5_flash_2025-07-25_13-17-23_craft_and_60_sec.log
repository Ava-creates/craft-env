{"timestamp": "2025-07-25T14:48:18.128105", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Define action constants based on the DSL and problem description\n    # These are derived from env.action_specs to ensure correctness.\n    ACTION_DOWN = env.action_specs['DOWN']\n    ACTION_UP = env.action_specs['UP']\n    ACTION_LEFT = env.action_specs['LEFT']\n    ACTION_RIGHT = env.action_specs['RIGHT']\n    ACTION_USE = env.action_specs['USE']\n\n    # Map (dx, dy) to action for pathfinding\n    DELTAS_TO_ACTION = {\n        (0, -1): ACTION_DOWN,\n        (0, 1): ACTION_UP,\n        (-1, 0): ACTION_LEFT,\n        (1, 0): ACTION_RIGHT,\n    }\n\n    def _find_path_and_simulate_moves(start_sim_state, target_condition_func):\n        \"\"\"\n        Finds a path from start_sim_state.pos to a target cell and returns actions and the\n        simulated state after executing those moves. This function uses BFS for pathfinding\n        and simulates each step using CraftState.step() to accurately model environment changes\n        (like blocked paths) and agent position.\n        \n        Args:\n            start_sim_state (CraftState): The initial simulated state for pathfinding.\n            target_condition_func (callable): A function that takes a CraftState and returns True if that state\n                                              satisfies the target condition (e.g., on a resource, next to a workshop).\n        Returns:\n            tuple[list[int], CraftState]: A tuple containing:\n                                          - List of actions (integers) to reach the target.\n                                          - The simulated CraftState after executing these moves.\n                                          Returns (None, None) if no path is found.\n        \"\"\"\n        WIDTH, HEIGHT, _ = start_sim_state.grid.shape\n        \n        queue = collections.deque([(start_sim_state.pos, [], start_sim_state)]) # (current_pos, path_actions, current_sim_state)\n        visited_states = set() \n        \n        def get_hashable_state(state):\n            # Creates a hashable representation of the relevant parts of the state for the visited set.\n            # This includes position, inventory, direction, and a byte representation of the grid.\n            # Using grid.tobytes() is crucial to account for changes in the grid (e.g., resources being collected).\n            return (state.pos, tuple(state.inventory), state.dir, state.grid.tobytes()) \n\n        visited_states.add(get_hashable_state(start_sim_state))\n\n        # Pathfinding loop (BFS)\n        while queue:\n            curr_pos, curr_path_actions, curr_sim_state = queue.popleft()\n\n            # Check if the current simulated state satisfies the target condition\n            if target_condition_func(curr_sim_state):\n                return curr_path_actions, curr_sim_state\n            \n            # Explore neighbors by attempting to move in all four directions\n            for (dx, dy), action_val in DELTAS_TO_ACTION.items():\n                # Simulate the step using the CraftState's step method.\n                # This ensures all environment rules (boundaries, unwalkable cells, etc.) are applied.\n                _, simulated_next_state = curr_sim_state.step(action_val)\n                \n                # If the agent's position did not change after a movement action, it means\n                # the move was blocked (e.g., by a wall or unwalkable tile). Skip this path.\n                if simulated_next_state.pos == curr_sim_state.pos and action_val in DELTAS_TO_ACTION.values():\n                     continue\n\n                # Get hashable representation of the next simulated state to check if it has been visited\n                hashable_next_state = get_hashable_state(simulated_next_state)\n                if hashable_next_state not in visited_states:\n                    visited_states.add(hashable_next_state)\n                    # Add the new state and its path to the queue\n                    queue.append((simulated_next_state.pos, curr_path_actions + [action_val], simulated_next_state))\n\n        return None, None # No path found to the target condition\n\n    # Get references to world and cookbook from the environment\n    world = env.world\n    cookbook = world.cookbook\n\n    # Start with a copy of the initial state for planning and simulation.\n    # CraftState.step() returns a new state, so we update this reference in our simulation.\n    current_sim_state = env._current_state \n    all_actions = [] # List to store the sequence of actions to be returned\n\n    # --- Phase 1: Gather all necessary primitive ingredients ---\n    # `cookbook.primitives_for(item)` returns a dictionary of all primitive resources\n    # required to craft the 'item', including those for intermediate crafts.\n    required_primitives = cookbook.primitives_for(item)\n\n    for p_idx, p_count in required_primitives.items():\n        while current_sim_state.inventory[p_idx] < p_count:\n            # Define the target condition for collecting a primitive:\n            # The agent must be positioned directly on the grid cell containing the primitive.\n            def target_on_primitive(state_obj, current_p_idx=p_idx):\n                return state_obj.grid[state_obj.pos[0], state_obj.pos[1], current_p_idx] > 0\n\n            # Find a path to the closest instance of this primitive\n            path_actions, final_sim_state_after_moves = _find_path_and_simulate_moves(\n                current_sim_state,\n                target_on_primitive\n            )\n\n            if path_actions is None:\n                # If a primitive cannot be reached, the item cannot be crafted.\n                # Return an empty list to indicate that crafting is not possible.\n                return [] \n\n            all_actions.extend(path_actions)\n            # Update our simulated state to reflect the agent's position after moving\n            current_sim_state = final_sim_state_after_moves \n\n            # Perform the USE action to collect the primitive\n            all_actions.append(ACTION_USE)\n            # Simulate the USE action's effect (collection) on our internal state.\n            # This will update the inventory and potentially remove the resource from the grid.\n            _, current_sim_state = current_sim_state.step(ACTION_USE)\n\n    # --- Phase 2: Move to the correct workshop (if needed) and craft the final item ---\n    recipe = cookbook.recipes.get(item)\n    workshop_kind_idx = None\n    \n    # Check if the target item itself is a primitive and doesn't have a crafting recipe.\n    # If so, all required actions (collection) have already been planned in Phase 1.\n    if recipe is None and item in cookbook.primitives:\n        pass # No further crafting action is required for this type of item.\n    elif recipe is not None: # The item has a crafting recipe\n        # Check if the recipe requires a specific workshop (indicated by the '_key' in the recipe)\n        if '_key' in recipe:\n            workshop_kind_idx = recipe['_key']\n\n        if workshop_kind_idx is not None:\n            # Define the target condition for crafting at a workshop:\n            # The agent must be adjacent to the required workshop.\n            def target_next_to_workshop(state_obj, current_workshop_idx=workshop_kind_idx):\n                return state_obj.next_to(current_workshop_idx)\n\n            # Find a path to a cell adjacent to the required workshop\n            path_actions, final_sim_state_after_moves = _find_path_and_simulate_moves(\n                current_sim_state,\n                target_next_to_workshop\n            )\n\n            if path_actions is None:\n                # If the workshop cannot be reached, crafting is not possible.\n                return [] \n\n            all_actions.extend(path_actions)\n            # Update our simulated state after moving to the workshop\n            current_sim_state = final_sim_state_after_moves \n\n        # Perform the USE action to craft the item.\n        # This action will succeed in the simulation if all ingredients are in inventory\n        # and the agent is at the correct workshop location (if required).\n        all_actions.append(ACTION_USE)\n        # Simulate the USE action's effect (crafting), which consumes ingredients and adds the item.\n        _, current_sim_state = current_sim_state.step(ACTION_USE)\n\n    return all_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:48:18.154828", "function_name": "craft", "function_body": "    import numpy as np\n    import collections\n    import copy\n\n    def craft_v2(env, item) -> list[int]:\n        ACTION_MAP = env.action_specs()\n        USE_ACTION = ACTION_MAP['USE']\n\n        def find_path_to_kind(sim_state, target_kind_id):\n            \"\"\"\n            Performs a BFS to find the shortest path from the agent's current position\n            to a cell adjacent to an instance of `target_kind_id`.\n            Returns a list of integer actions (UP, DOWN, LEFT, RIGHT).\n            \"\"\"\n            grid = sim_state.grid\n            start_pos = sim_state.pos\n            width, height, _ = grid.shape\n\n            q = collections.deque([(start_pos, [])]) # (current_pos, path_actions)\n            visited = {start_pos}\n\n            move_deltas_with_actions = {\n                ACTION_MAP['UP']: (0, -1),\n                ACTION_MAP['DOWN']: (0, 1),\n                ACTION_MAP['LEFT']: (-1, 0),\n                ACTION_MAP['RIGHT']: (1, 0),\n            }\n            \n            while q:\n                (curr_x, curr_y), path = q.popleft()\n\n                # Check if current position is adjacent to target_kind_id\n                # Agent needs to be 1 step away from the target to 'USE' it.\n                for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Relative deltas for adjacent cells\n                    target_x, target_y = curr_x + dx, curr_y + dy\n                    if 0 <= target_x < width and 0 <= target_y < height:\n                        if grid[target_x, target_y, target_kind_id] > 0:\n                            return path # Path found to be adjacent\n\n                # Explore neighbors (possible next positions for the agent)\n                for action, (dx, dy) in move_deltas_with_actions.items():\n                    next_x, next_y = curr_x + dx, curr_y + dy\n\n                    if not (0 <= next_x < width and 0 <= next_y < height):\n                        continue # Out of bounds\n\n                    # Check if the next cell is an obstacle (cannot move onto it)\n                    is_obstacle = False\n                    for non_grab_idx in sim_state.world.non_grabbable_indices:\n                        if grid[next_x, next_y, non_grab_idx] > 0:\n                            is_obstacle = True\n                            break\n                    if is_obstacle:\n                        continue # Cannot move onto an obstacle\n\n                    if (next_x, next_y) not in visited:\n                        visited.add((next_x, next_y))\n                        q.append(((next_x, next_y), path + [action]))\n            \n            return [] # No path found to be adjacent to target_kind_id\n\n        def _get_item_actions(current_sim_state, target_item_id):\n            \"\"\"\n            Recursively plans actions to obtain `target_item_id`.\n            It simulates state changes (position, inventory) during planning.\n            Returns a tuple: (list of integer actions, updated_sim_state).\n            If unable to obtain the item, returns ([], original_sim_state).\n            \"\"\"\n            item_actions_planned = []\n            cookbook = current_sim_state.world.cookbook\n\n            # Case 1: Primitive item (can be collected directly from the grid)\n            if target_item_id in cookbook.primitives:\n                # If we already have the item, no actions are needed for this quantity.\n                if current_sim_state.inventory[target_item_id] > 0:\n                    return [], current_sim_state \n\n                # Plan path to the primitive\n                path_to_target = find_path_to_kind(current_sim_state, target_item_id)\n                \n                # Simulate state changes along the planned path\n                temp_sim_state = copy.deepcopy(current_sim_state) # Start planning from a copy\n                for action in path_to_target:\n                    _, temp_sim_state = temp_sim_state.step(action)\n                    item_actions_planned.append(action)\n                \n                # After moving, perform USE action if now adjacent to the target\n                if temp_sim_state.next_to(target_item_id):\n                    _, new_sim_state = temp_sim_state.step(USE_ACTION)\n                    item_actions_planned.append(USE_ACTION)\n                    return item_actions_planned, new_sim_state\n                else:\n                    # Failed to get to a position next to the target\n                    return [], current_sim_state # Indicate failure by no actions and no state change\n            \n            # Case 2: Craftable item (requires a recipe and possibly a workshop)\n            elif target_item_id in cookbook.recipes:\n                # If we already have the item, no actions are needed to craft it again.\n                if current_sim_state.inventory[target_item_id] > 0:\n                    return [], current_sim_state\n\n                recipe = cookbook.recipes[target_item_id]\n                \n                # Create a working copy of the state for planning the ingredients and craft\n                # This ensures that inventory changes from getting ingredients propagate within this planning call.\n                temp_sim_state_for_craft = copy.deepcopy(current_sim_state)\n                \n                # First, gather all required ingredients recursively\n                for ingredient_id, count_needed in recipe.items():\n                    if ingredient_id == \"_key\": # Special key for workshop, not an ingredient\n                        continue \n                    \n                    amount_in_inventory = temp_sim_state_for_craft.inventory[ingredient_id]\n                    num_to_get = count_needed - amount_in_inventory\n                    \n                    # Recursively get each needed quantity of the ingredient\n                    for _ in range(num_to_get):\n                        # The recursive call updates its own sim_state. We use the updated one.\n                        ing_actions, updated_temp_sim_state = _get_item_actions(temp_sim_state_for_craft, ingredient_id)\n                        \n                        # Check if getting the ingredient failed AND it wasn't already available\n                        # (i.e., inventory didn't increase after the attempt)\n                        if not ing_actions and updated_temp_sim_state.inventory[ingredient_id] <= temp_sim_state_for_craft.inventory[ingredient_id]:\n                            return [], current_sim_state # Propagate failure: cannot craft this item\n                        \n                        item_actions_planned.extend(ing_actions)\n                        temp_sim_state_for_craft = updated_temp_sim_state # Update simulated state after getting ingredient\n\n                # Second, after all ingredients are (simulated to be) in inventory, move to workshop and craft\n                workshop_id = None\n                if \"_key\" in recipe:\n                    workshop_id = recipe[\"_key\"] # This is the ID of the required workshop\n\n                if workshop_id is not None:\n                    # Plan path to the workshop\n                    path_to_workshop = find_path_to_kind(temp_sim_state_for_craft, workshop_id)\n                    \n                    # Simulate state changes along the path to the workshop\n                    for action in path_to_workshop:\n                        _, temp_sim_state_for_craft = temp_sim_state_for_craft.step(action)\n                        item_actions_planned.append(action)\n\n                    # After moving, perform USE action if now adjacent to workshop\n                    if temp_sim_state_for_craft.next_to(workshop_id):\n                        _, new_sim_state = temp_sim_state_for_craft.step(USE_ACTION)\n                        item_actions_planned.append(USE_ACTION)\n                        return item_actions_planned, new_sim_state\n                    else:\n                        # Failed to get to a position next to the workshop\n                        return [], current_sim_state # Indicate failure\n                else: \n                    # No specific workshop required (e.g., crafting by hand / in-place)\n                    _, new_sim_state = temp_sim_state_for_craft.step(USE_ACTION) \n                    item_actions_planned.append(USE_ACTION)\n                    return item_actions_planned, new_sim_state\n\n            # If item is neither primitive nor craftable (invalid or unknown item ID)\n            return [], current_sim_state\n\n        # Main execution for the `craft_v2` function:\n        # Start planning from a deep copy of the initial environment state.\n        # This ensures that our planning simulation doesn't alter the actual environment state\n        # before the actions are executed by the `solve` function.\n        initial_sim_state = copy.deepcopy(env._current_state)\n        \n        final_actions, _ = _get_item_actions(initial_sim_state, item)\n        return final_actions", "island_id": 1, "scores": {"3": -1}}
