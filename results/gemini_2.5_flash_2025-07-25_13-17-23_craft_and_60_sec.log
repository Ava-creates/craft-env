{"timestamp": "2025-07-25T14:14:43.554902", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants for the CraftLab environment\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Mapping of (dx, dy) to movement action\n    _MOVE_DELTAS = {\n        (0, -1): _UP,\n        (0, 1): _DOWN,\n        (-1, 0): _LEFT,\n        (1, 0): _RIGHT\n    }\n    \n    # Simple mutable class to hold and update state during planning simulation\n    class _SimulatedPlanningState:\n        def __init__(self, initial_state):\n            self.pos = initial_state.pos\n            # Create a copy of inventory and grid to avoid modifying the original environment state\n            self.inventory = initial_state.inventory.copy() \n            self.grid = initial_state.grid.copy() \n            self.world = initial_state.world # Reference to the CraftWorld instance for recipes, indices etc.\n            self.n_kinds = initial_state.world.cookbook.n_kinds\n\n    def _bfs_find_target_coords(grid, target_kind_idx):\n        \"\"\"\n        Finds the coordinates (x, y) of the first instance of target_kind_idx in the grid.\n        Returns (x, y) or None if not found.\n        \"\"\"\n        WIDTH, HEIGHT, _ = grid.shape\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if grid[x, y, target_kind_idx] > 0:\n                    return (x, y)\n        return None\n\n    def _get_path_and_final_pos_for_interaction(sim_state, target_item_idx):\n        \"\"\"\n        Determines the path of agent positions and the final position the agent needs to be at\n        to interact with target_item_idx. Handles grabbable vs. workshop/adjacent interactions.\n        \n        Returns (list of (x,y) positions forming the path, final_interaction_pos (x,y))\n        or (None, None) if no path is found.\n        The final_interaction_pos is the cell the agent *ends up on* to perform the USE action.\n        \"\"\"\n        target_coords = _bfs_find_target_coords(sim_state.grid, target_item_idx)\n        if target_coords is None:\n            return None, None\n\n        WIDTH, HEIGHT, _ = sim_state.grid.shape\n        # Queue stores (current_pos, path_list_so_far)\n        queue = collections.deque([(sim_state.pos, [sim_state.pos])])\n        visited = {sim_state.pos}\n\n        is_grabbable = target_item_idx in sim_state.world.grabbable_indices\n        is_workshop = target_item_idx in sim_state.world.workshop_indices\n        \n        # Directions for 4-directional movement\n        neighbor_dirs = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Down, Up, Right, Left\n\n        while queue:\n            (cx, cy), path = queue.popleft()\n\n            # Check if (cx,cy) is a valid final interaction position for target_item_idx\n            is_interaction_cell = False\n            if is_grabbable:\n                # For grabbable items, agent must be directly on the target square.\n                if (cx, cy) == target_coords:\n                    is_interaction_cell = True\n            elif is_workshop or (target_item_idx in sim_state.world.non_grabbable_indices):\n                # For workshops or other non-grabbable items that require adjacency (e.g., water, stone for tools),\n                # agent needs to be in a 3x3 neighborhood of the target.\n                # CraftState.next_to(idx) checks if any cell in 3x3 of agent's position contains idx.\n                # So we need to find a path to (cx,cy) such that target_coords is in the 3x3 neighborhood of (cx,cy).\n                for dx_adj in [-1, 0, 1]:\n                    for dy_adj in [-1, 0, 1]:\n                        if (cx + dx_adj, cy + dy_adj) == target_coords:\n                            is_interaction_cell = True\n                            break\n                    if is_interaction_cell: break\n            \n            if is_interaction_cell:\n                return path, (cx, cy) # Return the path leading to this interaction cell\n\n            # Explore neighbors for pathfinding\n            for dx, dy in neighbor_dirs:\n                nx, ny = cx + dx, cy + dy\n                # Ensure neighbor is within grid bounds and not already visited\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and (nx, ny) not in visited:\n                    # Assuming all non-boundary cells are traversable.\n                    visited.add((nx, ny))\n                    queue.append(((nx, ny), path + [(nx, ny)]))\n        \n        return None, None # No path found to an interactable position\n\n    def _convert_path_to_actions(path):\n        \"\"\"Converts a list of (x,y) positions to a list of integer action codes.\"\"\"\n        actions = []\n        if not path or len(path) < 2:\n            return []\n\n        for i in range(len(path) - 1):\n            cx, cy = path[i]\n            nx, ny = path[i+1]\n            \n            dx = nx - cx\n            dy = ny - cy\n            \n            action = _MOVE_DELTAS.get((dx, dy))\n            if action is not None:\n                actions.append(action)\n            # If action is None, it implies a non-adjacent or invalid path step,\n            # which should not occur with a correctly implemented BFS.\n        return actions\n\n    def _plan_actions_recursive(sim_state, target_item_idx, needed_count=1):\n        \"\"\"\n        Recursively plans actions to obtain target_item_idx.\n        Modifies sim_state (inventory, pos, grid) in place to simulate progress.\n        Returns a list of actions required for this specific item, including dependencies.\n        \"\"\"\n        actions_sequence = []\n\n        # Base case: If already have enough of the item, no actions needed for this item.\n        if sim_state.inventory[target_item_idx] >= needed_count:\n            return []\n\n        recipe = sim_state.world.cookbook.recipes.get(target_item_idx)\n\n        if recipe is None: # It's a primitive item (needs to be collected from the environment)\n            path_coords, final_interaction_pos = _get_path_and_final_pos_for_interaction(sim_state, target_item_idx)\n\n            if path_coords:\n                # Add movement actions to reach the interaction position\n                move_actions = _convert_path_to_actions(path_coords)\n                actions_sequence.extend(move_actions)\n                sim_state.pos = final_interaction_pos # Update simulated agent position\n\n                # Add the USE action to collect the primitive\n                actions_sequence.append(_USE)\n\n                # Simulate inventory update: assume 1 unit is collected per USE action for primitives.\n                sim_state.inventory[target_item_idx] += 1 \n                \n                # Simulate removal from grid if it's a grabbable item that is consumed.\n                # Only decrement if the item was actually present at the interaction spot.\n                if target_item_idx in sim_state.world.grabbable_indices:\n                     if sim_state.grid[sim_state.pos[0], sim_state.pos[1], target_item_idx] > 0:\n                         sim_state.grid[sim_state.pos[0], sim_state.pos[1], target_item_idx] -= 1\n            else:\n                # Primitive not found on the grid or is unreachable. Cannot obtain this item.\n                # Return empty list to signify failure to complete this part of the plan.\n                return [] \n                \n        else: # It's a crafted item (requires ingredients and possibly a workshop)\n            workshop_kind_idx = None\n            ingredients_to_obtain = []\n            \n            # Separate ingredients from workshop key\n            for ingredient_idx_or_key, count in recipe.items():\n                if isinstance(ingredient_idx_or_key, str) and ingredient_idx_or_key.startswith(\"_\"):\n                    # This is a special key, typically for a required workshop\n                    workshop_name = ingredient_idx_or_key[1:] \n                    workshop_kind_idx = sim_state.world.cookbook.index[workshop_name]\n                else:\n                    ingredients_to_obtain.append((ingredient_idx_or_key, count))\n            \n            # Recursively obtain all necessary ingredients\n            for ingredient_idx, count in ingredients_to_obtain:\n                needed = count - sim_state.inventory[ingredient_idx]\n                if needed > 0:\n                    # Recursive call to plan actions for obtaining the ingredient.\n                    # The sim_state is updated in place by the recursive call.\n                    ingredient_actions = _plan_actions_recursive(sim_state, ingredient_idx, needed)\n                    actions_sequence.extend(ingredient_actions)\n                    \n                    # After the recursive call, check if we successfully obtained enough.\n                    if sim_state.inventory[ingredient_idx] < count:\n                        # If not, it means this craft cannot be completed.\n                        return [] # Fail and return no actions.\n\n            # After all ingredients are (simulated to be) collected, move to workshop if required, then craft\n            if workshop_kind_idx is not None:\n                path_coords, final_interaction_pos = _get_path_and_final_pos_for_interaction(sim_state, workshop_kind_idx)\n\n                if path_coords:\n                    move_actions = _convert_path_to_actions(path_coords)\n                    actions_sequence.extend(move_actions)\n                    sim_state.pos = final_interaction_pos # Update simulated agent position\n                else:\n                    # Workshop not found or unreachable. Cannot craft this item.\n                    return [] # Fail.\n            \n            # Perform the USE action to craft the item\n            actions_sequence.append(_USE)\n\n            # Simulate inventory update for the crafted item\n            sim_state.inventory[target_item_idx] += 1\n            \n            # Simulate consumption of ingredients\n            for ingredient_idx, count in recipe.items():\n                if isinstance(ingredient_idx, str) and ingredient_idx.startswith(\"_\"):\n                    continue # Skip workshop key\n                sim_state.inventory[ingredient_idx] -= count\n        \n        return actions_sequence\n\n    # --- Main logic for craft_v2 ---\n    \n    # Get the initial state from the provided environment's current state.\n    # The solve function calls craft_v2 BEFORE env.reset(), so _current_state\n    # will reflect the scenario's initial configuration.\n    initial_state = env._current_state\n    \n    # Create a mutable snapshot of the initial state for planning simulation.\n    planning_state = _SimulatedPlanningState(initial_state)\n\n    # Begin recursive planning to get the target item (needed_count=1 for a single item).\n    total_actions = _plan_actions_recursive(planning_state, item, needed_count=1)\n\n    return total_actions", "island_id": 7, "scores": {"3": -1}}
