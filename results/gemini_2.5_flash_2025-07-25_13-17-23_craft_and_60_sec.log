{"timestamp": "2025-07-25T13:54:51.326442", "function_name": "craft", "function_body": "  import numpy as np\n  import collections\n\n  # Action mappings, derived from CraftLab.action_specs()\n  DOWN_ACTION = 0\n  UP_ACTION = 1\n  LEFT_ACTION = 2\n  RIGHT_ACTION = 3\n  USE_ACTION = 4\n  ACTIONS = [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION, USE_ACTION]\n\n  initial_craft_state = env._current_state\n\n  # Check if the goal item is already in the inventory at the start\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # BFS setup\n  # Queue stores tuples of (current_state_object, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(initial_craft_state, [])])\n  \n  # Visited set to keep track of states already explored to prevent loops and redundant work.\n  # A state is defined by (agent_position, agent_direction, agent_inventory, grid_layout).\n  # Numpy arrays (inventory, grid) are converted to bytes for efficient hashing in the set.\n  visited = set()\n  \n  def get_state_hash(state):\n      \"\"\"Generates a hashable representation of the CraftState.\"\"\"\n      return (state.pos, state.dir, state.inventory.tobytes(), state.grid.tobytes())\n\n  # Add the initial state to the visited set\n  initial_hash = get_state_hash(initial_craft_state)\n  visited.add(initial_hash)\n\n  # Maximum number of steps to explore in the BFS to prevent excessively long searches\n  # or infinite loops in complex environments. This value may need tuning depending\n  # on the complexity of recipes and map sizes.\n  MAX_PLANNING_STEPS = 500000 \n  \n  step_count = 0\n\n  # Start BFS search\n  while queue and step_count < MAX_PLANNING_STEPS:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the crafting goal\n      if current_state.satisfies(None, item):\n          return current_actions # Goal reached, return the sequence of actions\n\n      step_count += 1\n      \n      # Explore all possible actions from the current state\n      for action in ACTIONS:\n          # Simulate the action: CraftState.step returns a *new* state object,\n          # which is crucial for BFS as it allows exploring different paths without\n          # modifying the original state or the environment passed to the function.\n          _, next_state = current_state.step(action)\n          \n          # Append the current action to the sequence of actions taken\n          next_actions = current_actions + [action]\n          \n          # Get the hash for the next state\n          next_hash = get_state_hash(next_state)\n\n          # If this state has not been visited before, add it to the queue and visited set\n          if next_hash not in visited:\n              visited.add(next_hash)\n              queue.append((next_state, next_actions))\n\n  # If the queue becomes empty or MAX_PLANNING_STEPS is reached without finding a solution,\n  # it means no path to craft the item was found within the defined limits.\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-25T13:57:28.289230", "function_name": "craft", "function_body": "  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  actions = []\n  cookbook = env.world.cookbook\n\n  # Recursive helper function to process an item:\n  # If it's a primitive, add actions to collect it.\n  # If it's craftable, recursively gather its ingredients, then add actions to craft it.\n  def _process_item(current_item_idx):\n      recipe = cookbook.recipes.get(current_item_idx)\n\n      if recipe is None:\n          # This item (current_item_idx) is a primitive resource (e.g., WOOD, STONE) or an environment entity.\n          # To \"collect\" it, we assume the agent is either already positioned correctly or\n          # a single `_USE` action is sufficient to interact with it in its vicinity.\n          # This represents the low-level actions for `COLLECT_FUNC` from the DSL.\n          actions.append(_USE)\n      else:\n          # This item is a craftable item, defined by a recipe.\n          # First, recursively gather all required ingredients for this item.\n          for ingredient_idx_str, count in recipe.items():\n              # The \"_key\" in the recipe specifies the workshop type, not an ingredient.\n              if ingredient_idx_str == \"_key\":\n                  continue\n\n              ingredient_idx = int(ingredient_idx_str) # Recipe keys for ingredients are strings of integers.\n              # Gather 'count' units of this specific ingredient.\n              for _ in range(count):\n                  _process_item(ingredient_idx) # Recursive call to get each ingredient\n\n          # After all ingredients for the current item have been gathered,\n          # perform the crafting action for the current item.\n          # This generally involves interacting with a workshop.\n          # We assume a single `_USE` action is sufficient for the crafting interaction,\n          # implying the agent is correctly positioned next to the required workshop (if any)\n          # or that crafting can happen in place.\n          actions.append(_USE)\n\n  # Start the recursive process for the initial target item that needs to be crafted.\n  _process_item(item)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-25T13:57:28.307555", "function_name": "craft", "function_body": "    cookbook = env.world.cookbook\n    action_map = env.action_specs()\n    ACTION_USE = action_map['USE']\n    ACTION_LEFT = action_map['LEFT']\n    ACTION_RIGHT = action_map['RIGHT']\n    ACTION_UP = action_map['UP']\n    ACTION_DOWN = action_map['DOWN']\n\n    # Initial state information available from env.scenario\n    init_grid = env.scenario.init_grid\n    init_pos = env.scenario.init_pos # (row, col) tuple\n    # Note: init_grid.shape is (grid_height, grid_width, n_kinds)\n    GRID_HEIGHT, GRID_WIDTH, N_KINDS = init_grid.shape\n\n    # Mutable state for planning:\n    # 1. current_sim_inventory_counts: Simulates inventory changes during planning.\n    # 2. current_agent_pos: Simulates agent's position changes during planning.\n    current_sim_inventory_counts = np.zeros(N_KINDS, dtype=np.int32)\n    current_agent_pos = list(init_pos) # Use a mutable list for agent's simulated position\n\n    # BFS for pathfinding to a target kind.\n    # Returns actions to reach a cell from which the target is in the 3x3 neighborhood\n    # (including on the cell itself).\n    # Returns None if no path found.\n    def find_path(start_pos, target_kind_idx, grid):\n        q = [(start_pos, [])] # (current_pos, path_actions)\n        visited = {start_pos}\n\n        # Check if target is already in 3x3 neighborhood from start_pos\n        # This covers cases where the agent starts right next to the target.\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                nr, nc = start_pos[0] + dr, start_pos[1] + dc\n                if 0 <= nr < GRID_HEIGHT and 0 <= nc < GRID_WIDTH:\n                    if grid[nr, nc, target_kind_idx] > 0:\n                        return [] # Already next to it, no movement needed\n\n        # Perform BFS to find the shortest path\n        head = 0\n        while head < len(q):\n            (r, c), path = q[head]\n            head += 1\n\n            # Explore neighbors for movement. Order matters for consistent plans.\n            possible_moves = []\n            if r > 0: possible_moves.append(((r - 1, c), path + [ACTION_UP]))\n            if r < GRID_HEIGHT - 1: possible_moves.append(((r + 1, c), path + [ACTION_DOWN]))\n            if c > 0: possible_moves.append(((r, c - 1), path + [ACTION_LEFT]))\n            if c < GRID_WIDTH - 1: possible_moves.append(((r, c + 1), path + [ACTION_RIGHT]))\n\n            for next_pos, next_path in possible_moves:\n                nr, nc = next_pos\n                if next_pos not in visited:\n                    # Check if this new position makes the target_kind_idx accessible\n                    # (i.e., target is in 3x3 neighborhood around next_pos)\n                    for dr_next in [-1, 0, 1]:\n                        for dc_next in [-1, 0, 1]:\n                            nnr, nnc = nr + dr_next, nc + dc_next\n                            if 0 <= nnr < GRID_HEIGHT and 0 <= nnc < GRID_WIDTH:\n                                if grid[nnr, nnc, target_kind_idx] > 0:\n                                    return next_path # Path found to a position from which target is accessible\n\n                    visited.add(next_pos)\n                    q.append((next_pos, next_path))\n        return None # No path found\n\n    # Recursive helper function to plan for acquiring a target item.\n    # It updates the `current_sim_inventory_counts` and `current_agent_pos` directly.\n    def _plan_for_item(target_item_idx):\n        # If the item is already in our simulated inventory, no actions are needed.\n        if current_sim_inventory_counts[target_item_idx] > 0:\n            return []\n\n        plan_actions = []\n\n        # Case 1: Primitive item (no recipe, directly collected from the world)\n        if target_item_idx in cookbook.primitives:\n            # Plan to move to the primitive's location and collect it using 'USE'.\n            path_to_primitive = find_path(tuple(current_agent_pos), target_item_idx, init_grid)\n            if path_to_primitive is None:\n                # If no path is found, it implies the primitive is unreachable in this scenario.\n                # In a solvable environment, this case should ideally not be hit.\n                return [] # Return empty list, implying failure to acquire.\n\n            plan_actions.extend(path_to_primitive)\n            # Update simulated agent position after performing the pathfinding actions.\n            for action in path_to_primitive:\n                if action == ACTION_UP: current_agent_pos[0] -= 1\n                elif action == ACTION_DOWN: current_agent_pos[0] += 1\n                elif action == ACTION_LEFT: current_agent_pos[1] -= 1\n                elif action == ACTION_RIGHT: current_agent_pos[1] += 1\n\n            plan_actions.append(ACTION_USE) # Action to collect the primitive.\n            current_sim_inventory_counts[target_item_idx] += 1 # Simulate acquisition.\n            return plan_actions\n\n        # Case 2: Crafted item (has a recipe defined in the cookbook)\n        recipe = cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            # This case should ideally not happen for a valid craftable item that's not a primitive.\n            return []\n\n        # First, recursively plan to gather all necessary ingredients.\n        for ing_idx, count in recipe.items():\n            if ing_idx == \"_key\":\n                continue # \"_key\" specifies the workshop, not an ingredient.\n\n            # Calculate how many units of this ingredient are still needed.\n            needed_count = count - current_sim_inventory_counts[ing_idx]\n            for _ in range(needed_count):\n                if needed_count > 0: # Only plan if we actually need more units.\n                    # Recursively get the ingredient. The mutable state (inventory, pos)\n                    # is passed implicitly and updated by each recursive call.\n                    ing_plan = _plan_for_item(ing_idx)\n                    plan_actions.extend(ing_plan)\n\n        # After all ingredients are planned for (and are simulated to be in inventory),\n        # plan to move to the required workshop (if any) and perform the craft action.\n        workshop_needed_idx = recipe.get(\"_key\")\n        if workshop_needed_idx:\n            path_to_workshop = find_path(tuple(current_agent_pos), workshop_needed_idx, init_grid)\n            if path_to_workshop is None:\n                # If no path to workshop, craft is impossible.\n                return [] # Fail gracefully.\n\n            plan_actions.extend(path_to_workshop)\n            # Update simulated agent position after performing workshop pathfinding actions.\n            for action in path_to_workshop:\n                if action == ACTION_UP: current_agent_pos[0] -= 1\n                elif action == ACTION_DOWN: current_agent_pos[0] += 1\n                elif action == ACTION_LEFT: current_agent_pos[1] -= 1\n                elif action == ACTION_RIGHT: current_agent_pos[1] += 1\n\n        plan_actions.append(ACTION_USE) # Action to perform the craft at the workshop.\n        current_sim_inventory_counts[target_item_idx] += 1 # Simulate crafting the item.\n        return plan_actions\n\n    # Start the overall planning process for the target item.\n    final_actions = _plan_for_item(item_idx)\n\n    return final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:00:31.580572", "function_name": "craft", "function_body": "    total_actions = []\n\n    # Get action mappings from the environment\n    action_specs = env.action_specs()\n    ACTION_DOWN = action_specs['DOWN']\n    ACTION_UP = action_specs['UP']\n    ACTION_LEFT = action_specs['LEFT']\n    ACTION_RIGHT = action_specs['RIGHT']\n    ACTION_USE = action_specs['USE']\n\n    # Make a deep copy of the initial state for simulation\n    # CraftState doesn't have a direct copy method, so reconstruct it.\n    initial_state = env._current_state\n    simulated_state = CraftState(\n        scenario=initial_state.scenario,\n        grid=initial_state.grid.copy(),\n        pos=initial_state.pos,\n        dir=initial_state.dir,\n        inventory=initial_state.inventory.copy()\n    )\n\n    cookbook = env.world.cookbook\n    recipes = cookbook.recipes\n\n    # Helper function for BFS pathfinding\n    def _get_path_actions(start_pos: tuple[int, int], target_pos: tuple[int, int], current_grid: np.ndarray) -> list[int]:\n        \"\"\"\n        Finds a shortest path from start_pos to target_pos using BFS on the grid.\n        Returns a list of integer actions (UP, DOWN, LEFT, RIGHT).\n        \"\"\"\n        # If already at target, no movement needed\n        if start_pos == target_pos:\n            return []\n\n        queue = [(start_pos[0], start_pos[1], [])]\n        visited = set([(start_pos[0], start_pos[1])])\n\n        grid_width, grid_height, _ = current_grid.shape\n\n        # Define possible moves: (dx, dy, action_constant)\n        # Assuming (0,0) is top-left, x increases right, y increases down\n        moves_defs = [\n            (0, 1, ACTION_DOWN),   # Move down (Y increases)\n            (0, -1, ACTION_UP),    # Move up (Y decreases)\n            (1, 0, ACTION_RIGHT),  # Move right (X increases)\n            (-1, 0, ACTION_LEFT)   # Move left (X decreases)\n        ]\n\n        while queue:\n            cx, cy, path = queue.pop(0)\n\n            # Check if we are at the target\n            if (cx, cy) == target_pos:\n                return path\n\n            for dx, dy, action in moves_defs:\n                nx, ny = cx + dx, cy + dy\n\n                # Check boundary conditions\n                if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                    # Assume all in-bounds cells are traversable unless explicitly blocked by `CraftState.step`.\n                    # For a simple planner, we don't pre-check for complex obstacles in BFS.\n                    if (nx, ny) not in visited:\n                        visited.add((nx, ny))\n                        queue.append((nx, ny, path + [action]))\n        \n        return [] # No path found (e.g., target unreachable)\n\n    # Recursive helper function to plan for gathering an item (primitive or craftable)\n    def _plan_for_item(target_item_idx: int, current_hypothetical_state: 'CraftState') -> tuple[list[int], 'CraftState']:\n        \"\"\"\n        Recursively plans actions to acquire a target item.\n        Returns a tuple: (list of actions, updated_hypothetical_state after performing actions).\n        If acquisition fails, returns ([], original_hypothetical_state).\n        \"\"\"\n        actions_for_item = []\n\n        # If the item is already in the inventory of the current hypothetical state, we're done.\n        # The goal is to ensure inventory[target_item_idx] > 0\n        if current_hypothetical_state.inventory[target_item_idx] > 0:\n            return [], current_hypothetical_state \n\n        # Check if the item is craftable (i.e., has its own recipe)\n        if target_item_idx in recipes:\n            # It's craftable, so recursively plan for its ingredients\n            recipe_ingredients = recipes[target_item_idx]\n            \n            # Create a temporary state for simulation during this crafting process\n            # This state will be updated as ingredients are gathered and the item is crafted.\n            temp_state = CraftState(\n                scenario=current_hypothetical_state.scenario,\n                grid=current_hypothetical_state.grid.copy(),\n                pos=current_hypothetical_state.pos,\n                dir=current_hypothetical_state.dir,\n                inventory=current_hypothetical_state.inventory.copy()\n            )\n\n            for ing_idx, ing_count in recipe_ingredients.items():\n                if ing_idx == \"_key\": # Special key in recipe dict, ignore\n                    continue\n\n                current_ing_count = temp_state.inventory[ing_idx]\n                needed_ing_count = ing_count - current_ing_count\n\n                if needed_ing_count <= 0:\n                    continue # Already have enough of this ingredient\n\n                # Plan to get the needed quantity of this ingredient\n                for _ in range(needed_ing_count): # Assume one collect/craft operation produces one unit\n                    prev_ing_count = temp_state.inventory[ing_idx]\n                    sub_actions, updated_sub_state = _plan_for_item(ing_idx, temp_state)\n                    \n                    # If sub-plan failed to acquire the ingredient, propagate failure.\n                    # We check if the inventory for this ingredient actually increased.\n                    if not updated_sub_state.inventory[ing_idx] > prev_ing_count:\n                         return [], current_hypothetical_state # Cannot craft this item, ingredient unreachable/uncraftable\n\n                    actions_for_item.extend(sub_actions)\n                    temp_state = updated_sub_state # Update the hypothetical state with the result of sub-plan\n\n            # After gathering all ingredients, now craft the target_item_idx\n            # Find a workshop\n            workshop_indices = env.world.workshop_indices\n            target_adjacent_workshop_cell = None\n\n            # Find the closest workshop (by path length to an adjacent cell)\n            min_dist = float('inf')\n            \n            grid_width, grid_height, _ = temp_state.grid.shape\n\n            # Iterate through grid to find workshop locations\n            for w_kind_idx in workshop_indices:\n                for wx in range(grid_width):\n                    for wy in range(grid_height):\n                        if temp_state.grid[wx, wy, w_kind_idx] > 0: # Found a workshop at (wx, wy)\n                            \n                            # Define adjacent cells to the workshop\n                            adj_cells = [\n                                (wx, wy + 1), (wx, wy - 1), (wx + 1, wy), (wx - 1, wy)\n                            ]\n                            \n                            for adj_x, adj_y in adj_cells:\n                                # Check if adjacent cell is within bounds\n                                if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n                                    # Path from current agent pos to this adjacent cell\n                                    path_to_adj = _get_path_actions(temp_state.pos, (adj_x, adj_y), temp_state.grid)\n                                    if path_to_adj:\n                                        dist = len(path_to_adj)\n                                        if dist < min_dist:\n                                            min_dist = dist\n                                            target_adjacent_workshop_cell = (adj_x, adj_y)\n            \n            if not target_adjacent_workshop_cell:\n                return [], current_hypothetical_state # No reachable workshop found\n\n            # Move to the workshop's adjacent cell\n            move_actions = _get_path_actions(temp_state.pos, target_adjacent_workshop_cell, temp_state.grid)\n            actions_for_item.extend(move_actions)\n            \n            # Update hypothetical state after movement simulation\n            for action in move_actions:\n                _, temp_state = temp_state.step(action)\n            \n            # Now use the workshop to craft\n            actions_for_item.append(ACTION_USE)\n            _, temp_state = temp_state.step(ACTION_USE) # Simulate crafting action\n            \n            # Return actions and the updated state\n            return actions_for_item, temp_state\n\n        else: # It's a primitive (not in recipes), needs to be collected\n            target_primitive_cell = None\n            grid_width, grid_height, _ = current_hypothetical_state.grid.shape\n            \n            # Find the closest instance of the primitive\n            min_dist = float('inf')\n            \n            is_grabbable = target_item_idx in env.world.grabbable_indices\n\n            for x in range(grid_width):\n                for y in range(grid_height):\n                    if current_hypothetical_state.grid[x, y, target_item_idx] > 0: # Found primitive at (x, y)\n                        if is_grabbable:\n                            # If grabbable, agent needs to move ONTO the cell to pick it up\n                            path_to_target = _get_path_actions(current_hypothetical_state.pos, (x, y), current_hypothetical_state.grid)\n                            if path_to_target:\n                                dist = len(path_to_target)\n                                if dist < min_dist:\n                                    min_dist = dist\n                                    target_primitive_cell = (x, y)\n                        else: # Non-grabbable, needs 'USE' while adjacent\n                            adj_cells = [\n                                (x, y + 1), (x, y - 1), (x + 1, y), (x - 1, y)\n                            ]\n                            for adj_x, adj_y in adj_cells:\n                                if 0 <= adj_x < grid_width and 0 <= adj_y < grid_height:\n                                    path_to_adj = _get_path_actions(current_hypothetical_state.pos, (adj_x, adj_y), current_hypothetical_state.grid)\n                                    if path_to_adj:\n                                        dist = len(path_to_adj)\n                                        if dist < min_dist:\n                                            min_dist = dist\n                                            target_primitive_cell = (adj_x, adj_y)\n\n            if not target_primitive_cell:\n                return [], current_hypothetical_state # Cannot find/collect this item\n\n            # Move to the primitive's cell (or adjacent for non-grabbable)\n            move_actions = _get_path_actions(current_hypothetical_state.pos, target_primitive_cell, current_hypothetical_state.grid)\n            actions_for_item.extend(move_actions)\n\n            # Update hypothetical state after movement simulation\n            for action in move_actions:\n                _, current_hypothetical_state = current_hypothetical_state.step(action)\n            \n            # Use action to collect the primitive (e.g., cut wood, mine stone)\n            actions_for_item.append(ACTION_USE)\n            _, current_hypothetical_state = current_hypothetical_state.step(ACTION_USE) # Simulate collection\n            \n            return actions_for_item, current_hypothetical_state\n\n    # Initial check: if the item is already satisfied in the current environment state\n    if env._current_state.satisfies(None, item):\n        return []\n\n    # Start the planning process by calling the recursive helper\n    final_actions, _ = _plan_for_item(item, simulated_state)\n    \n    return final_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:00:31.605543", "function_name": "craft", "function_body": "    import numpy as np\n    import collections\n\n    # Constants for actions based on CraftLab.action_specs()\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    def _bfs_path(initial_state: 'CraftState', target_kind_idx: int = None,\n                  target_pos: tuple = None, max_steps: int = 200) -> list[int] | None:\n        \"\"\"\n        Finds a path of actions (UP, DOWN, LEFT, RIGHT) to reach a state where\n        the agent is next to target_kind_idx or at target_pos.\n        \n        Args:\n            initial_state: The starting CraftState for BFS.\n            target_kind_idx: The index of the kind to be next to.\n            target_pos: The exact position (x, y) to reach.\n            max_steps: Maximum number of movement steps to search.\n        \n        Returns:\n            A list of actions (integers) to reach the target, or None if unreachable.\n        \"\"\"\n        \n        q = collections.deque([(initial_state, [])]) # (current_CraftState, list_of_actions_so_far)\n        \n        # Visited set to avoid cycles and redundant paths.\n        # State key: (pos_x, pos_y, dir)\n        visited = set([(initial_state.pos[0], initial_state.pos[1], initial_state.dir)])\n        \n        while q:\n            current_state_bfs, actions_so_far = q.popleft()\n\n            if len(actions_so_far) > max_steps:\n                continue # Prune this path, too long\n\n            # Check if target condition is met\n            if target_kind_idx is not None:\n                if current_state_bfs.next_to(target_kind_idx):\n                    return actions_so_far\n            elif target_pos is not None:\n                if current_state_bfs.pos == target_pos:\n                    return actions_so_far\n            \n            # Explore possible actions (movement only for BFS pathfinding)\n            for action in [UP, DOWN, LEFT, RIGHT]:\n                # Simulate the step to get the next state.\n                # Reward is always 0.0 for movement steps, we only care about new_state.\n                # CraftState.step creates a new state object without modifying the original.\n                _, next_state_bfs = current_state_bfs.step(action)\n                \n                state_key = (next_state_bfs.pos[0], next_state_bfs.pos[1], next_state_bfs.dir)\n                \n                if state_key not in visited:\n                    visited.add(state_key)\n                    q.append((next_state_bfs, actions_so_far + [action]))\n                        \n        return None # Target not reachable\n\n    def _get_actions_to_acquire(current_state: 'CraftState', target_item_idx: int, \n                                memo: dict[tuple, tuple]) -> tuple[list[int], 'CraftState'] | tuple[None, None]:\n        \"\"\"\n        Recursively determines the actions needed to acquire a target item,\n        including its sub-ingredients or primitive collection. Simulates state changes.\n\n        Args:\n            current_state: The CraftState from which to start planning.\n            target_item_idx: The index of the item to acquire.\n            memo: A dictionary for memoization to store results of (state, target_item_idx)\n                  to avoid redundant computations and cycles in the planning graph.\n                  Key: (tuple(current_state.inventory.tolist()), current_state.pos, current_state.dir, target_item_idx)\n                  Value: (list_of_actions, final_CraftState_after_acquiring_item)\n        Returns:\n            A tuple of (list_of_actions, final_CraftState_after_acquiring_item)\n            or (None, None) if the item cannot be acquired.\n        \"\"\"\n        \n        # Memoization key: (current_inventory, current_position, current_direction, target_item_index)\n        # Using full inventory tuple as part of the key to uniquely identify the state.\n        state_key_inv = tuple(current_state.inventory.tolist())\n        memo_key = (state_key_inv, current_state.pos, current_state.dir, target_item_idx)\n        \n        if memo_key in memo:\n            return memo[memo_key]\n\n        # 1. Base Case: Item already in inventory\n        if current_state.inventory[target_item_idx] > 0:\n            result = ([], current_state)\n            memo[memo_key] = result\n            return result\n\n        # 2. Check if target is a primitive resource\n        if target_item_idx in current_state.world.cookbook.primitives:\n            move_actions = _bfs_path(current_state, target_kind_idx=target_item_idx)\n            if move_actions is None:\n                result = (None, None) # Cannot reach primitive\n                memo[memo_key] = result\n                return result\n            \n            # Simulate moves to get to the primitive location\n            temp_state_after_moves = current_state\n            for action in move_actions:\n                _, temp_state_after_moves = temp_state_after_moves.step(action)\n            \n            # Perform USE action to attempt acquiring the primitive\n            # This step implicitly checks for required tools (e.g., AXE for WOOD)\n            _, final_state = temp_state_after_moves.step(USE)\n            \n            # Check if the item was actually acquired (inventory increased)\n            if final_state.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n                result = (move_actions + [USE], final_state)\n                memo[memo_key] = result\n                return result\n            else:\n                # USE action did not yield the item, likely missing a required tool.\n                result = (None, None)\n                memo[memo_key] = result\n                return result\n\n        # 3. Check if target is a craftable item (has a recipe)\n        recipe = current_state.world.cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            result = (None, None) # Not a primitive and no recipe (uncraftable)\n            memo[memo_key] = result\n            return result\n\n        total_actions = []\n        current_simulated_state = current_state\n\n        # Acquire all ingredients recursively\n        for ingredient_id_or_key, count in recipe.items():\n            if ingredient_id_or_key == \"_key\":\n                continue # Skip workshop key, handle separately later\n\n            # ingredient_id_or_key is an integer index if not \"_key\"\n            ingredient_idx = ingredient_id_or_key\n            \n            needed = count - current_simulated_state.inventory[ingredient_idx]\n            \n            for _ in range(needed): # Craft/collect multiple times if necessary\n                # Recursive call to acquire the sub-ingredient\n                sub_actions, sub_final_state = _get_actions_to_acquire(current_simulated_state, ingredient_idx, memo)\n                \n                if sub_actions is None:\n                    result = (None, None) # Cannot get this ingredient\n                    memo[memo_key] = result\n                    return result\n                \n                total_actions.extend(sub_actions)\n                current_simulated_state = sub_final_state # Update state for next ingredient/crafting step\n\n        # Now, all ingredients are assumed to be in current_simulated_state.inventory\n\n        # Move to workshop if required\n        if \"_key\" in recipe:\n            # Convert workshop name string to its integer index\n            workshop_name = recipe[\"_key\"]\n            workshop_idx = current_simulated_state.world.cookbook.index[workshop_name]\n            \n            move_to_workshop_actions = _bfs_path(current_simulated_state, target_kind_idx=workshop_idx)\n            \n            if move_to_workshop_actions is None:\n                result = (None, None) # Cannot reach required workshop\n                memo[memo_key] = result\n                return result\n            \n            total_actions.extend(move_to_workshop_actions)\n            for action in move_to_workshop_actions:\n                _, current_simulated_state = current_simulated_state.step(action) # Update state after moving\n\n        # Perform the final USE action for crafting the target item\n        _, final_state_after_craft = current_simulated_state.step(USE)\n        \n        # Verify that the target item was actually crafted.\n        # The `CraftState.step(USE)` method automatically handles ingredient consumption and output production.\n        if final_state_after_craft.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n            result = (total_actions + [USE], final_state_after_craft)\n            memo[memo_key] = result\n            return result\n        else:\n            # Crafting failed despite ingredients/workshop being seemingly correct.\n            result = (None, None)\n            memo[memo_key] = result\n            return result\n\n    # Get the initial CraftState from the CraftLab environment\n    initial_craft_state = env._current_state\n\n    # Initialize memoization dictionary for the top-level call.\n    # It will be passed down to recursive calls to store subproblem results.\n    craft_memo = {} \n    \n    actions, final_state = _get_actions_to_acquire(initial_craft_state, item_idx, craft_memo)\n    \n    if actions is None:\n        # If planning failed, return an empty list of actions.\n        return [] \n    else:\n        return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:03:02.846526", "function_name": "craft", "function_body": "    # Action constants (from CraftLab.action_specs)\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    all_actions = []\n    # Start from a fresh state by resetting the environment.\n    # The `env.reset()` returns an observation dict, we need the `_current_state` from it.\n    simulated_state = env.reset(seed=0)['_current_state']\n\n    cookbook = env.world.cookbook\n\n    # Helper for pathfinding (BFS) to a cell containing target_kind_idx.\n    # Used for workshops where the agent must be on the spot.\n    def _bfs_path_to_cell(sim_state, target_kind_idx):\n        grid = sim_state.grid\n        WIDTH, HEIGHT, N_KINDS = grid.shape\n        \n        target_locations = []\n        for y in range(HEIGHT):\n            for x in range(WIDTH):\n                # Check if the cell at (x,y) contains the target_kind_idx\n                if grid[y, x, target_kind_idx] > 0:\n                    target_locations.append((x, y))\n\n        if not target_locations:\n            return [] # Target kind not found on grid\n\n        start_pos = sim_state.pos\n        q = [(start_pos, [])] # (current_pos, path_actions)\n        visited = {start_pos}\n\n        # Define possible moves for BFS\n        possible_moves = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n        while q:\n            (cx, cy), current_path = q.pop(0)\n\n            # If current position is one of the target locations, path found\n            if (cx, cy) in target_locations:\n                return current_path\n\n            for dx, dy, action in possible_moves:\n                nx, ny = cx + dx, cy + dy\n                new_pos = (nx, ny)\n\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and new_pos not in visited:\n                    # Create a temporary CraftState copy at (cx, cy) to simulate the move.\n                    # This is crucial for checking traversability based on the *current* grid state.\n                    temp_state_for_check = sim_state.scenario.init(\n                        grid=sim_state.grid.copy(), \n                        pos=(cx, cy), \n                        dir=sim_state.dir, \n                        inventory=sim_state.inventory.copy() # Also copy inventory for complete state\n                    )\n                    # Simulate the step on the temporary state\n                    temp_state_after_step = temp_state_for_check.step(action)[1]\n                    \n                    # If the move was successful (position actually changed)\n                    if temp_state_after_step.pos == new_pos:\n                        visited.add(new_pos)\n                        q.append((new_pos, current_path + [action]))\n        return [] # No path found\n\n    # Helper for pathfinding (BFS) to a cell *adjacent* to target_kind_idx.\n    # Used for collecting primitives where the agent needs to be next to it.\n    def _bfs_path_to_adjacent_cell(sim_state, target_kind_idx):\n        grid = sim_state.grid\n        WIDTH, HEIGHT, N_KINDS = grid.shape\n        \n        target_adjacent_locations = set()\n        for ty in range(HEIGHT):\n            for tx in range(WIDTH):\n                if grid[ty, tx, target_kind_idx] > 0:\n                    # Add all 8 neighbors around the target cell\n                    for dx in [-1, 0, 1]:\n                        for dy in [-1, 0, 1]:\n                            if dx == 0 and dy == 0: continue # Exclude the target cell itself\n                            nx, ny = tx + dx, ty + dy\n                            if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                                target_adjacent_locations.add((nx, ny))\n\n        if not target_adjacent_locations:\n            return [] # No target or adjacent cells found\n        \n        start_pos = sim_state.pos\n        q = [(start_pos, [])]\n        visited = {start_pos}\n\n        possible_moves = [(0, 1, DOWN), (0, -1, UP), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n        while q:\n            (cx, cy), current_path = q.pop(0)\n\n            # If current position is one of the target adjacent locations, path found\n            if (cx, cy) in target_adjacent_locations:\n                return current_path\n\n            for dx, dy, action in possible_moves:\n                nx, ny = cx + dx, cy + dy\n                new_pos = (nx, ny)\n\n                if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and new_pos not in visited:\n                    # Create a temporary CraftState copy at (cx, cy) to simulate the move.\n                    temp_state_for_check = sim_state.scenario.init(\n                        grid=sim_state.grid.copy(), \n                        pos=(cx, cy), \n                        dir=sim_state.dir, \n                        inventory=sim_state.inventory.copy()\n                    )\n                    # Simulate the step on the temporary state\n                    temp_state_after_step = temp_state_for_check.step(action)[1]\n                    \n                    # If the move was successful\n                    if temp_state_after_step.pos == new_pos:\n                        visited.add(new_pos)\n                        q.append((new_pos, current_path + [action]))\n        return [] # No path found\n\n\n    # Recursive function to acquire an item (primitive or craftable)\n    # Returns (updated_sim_state, actions_list_added_in_this_call, success_status)\n    def acquire_item(target_idx, current_sim_state, current_all_actions_list):\n        \n        # Base case: If the item is already in inventory, no actions needed.\n        if current_sim_state.inventory[target_idx] > 0:\n            return current_sim_state, current_all_actions_list, True\n\n        # Check if the target is a primitive resource\n        if target_idx in cookbook.primitives:\n            # Find path to a cell adjacent to the primitive resource\n            path_actions = _bfs_path_to_adjacent_cell(current_sim_state, target_idx)\n            \n            # If no path found and not already adjacent, acquisition fails\n            if not path_actions and not current_sim_state.next_to(target_idx):\n                return current_sim_state, current_all_actions_list, False\n\n            # Execute movement actions in simulation\n            current_all_actions_list.extend(path_actions)\n            for action in path_actions:\n                _, current_sim_state = current_sim_state.step(action)\n            \n            # Agent should now be next to the primitive, perform USE action\n            current_all_actions_list.append(USE)\n            _, current_sim_state = current_sim_state.step(USE)\n            \n            # Verify if the item was successfully collected\n            if current_sim_state.inventory[target_idx] > 0:\n                return current_sim_state, current_all_actions_list, True\n            else:\n                return current_sim_state, current_all_actions_list, False\n        \n        # If the target is a craftable item (has a recipe)\n        recipe = cookbook.recipes.get(target_idx)\n        if recipe:\n            # Collect all necessary ingredients first\n            ingredients_to_get = []\n            for ingredient_idx_or_key, count_needed in recipe.items():\n                # Skip metadata keys like \"_key\"\n                if isinstance(ingredient_idx_or_key, str) and ingredient_idx_or_key.startswith('_'):\n                    continue\n                ingredients_to_get.append((ingredient_idx_or_key, count_needed))\n            \n            # Recursively acquire each ingredient until enough are present\n            for ingredient_idx, count_needed in ingredients_to_get:\n                while current_sim_state.inventory[ingredient_idx] < count_needed:\n                    current_sim_state, current_all_actions_list, success = acquire_item(ingredient_idx, current_sim_state, current_all_actions_list)\n                    if not success:\n                        # If an ingredient cannot be acquired, the target item also cannot be crafted\n                        return current_sim_state, current_all_actions_list, False\n                    \n                    # After acquiring an ingredient, check if the target item itself was already crafted\n                    # This can happen if an intermediate craft (recursive call) produced the main target item.\n                    if current_sim_state.inventory[target_idx] > 0:\n                        return current_sim_state, current_all_actions_list, True\n\n            # After all ingredients are acquired, move to the required workshop and craft\n            workshop_key = recipe.get('_key')\n            workshop_idx = None\n            if workshop_key:\n                workshop_idx = cookbook.index.getitem(workshop_key)\n            \n            if workshop_idx is not None:\n                # Find path to the workshop cell (agent must be on it for crafting)\n                path_actions_to_workshop = _bfs_path_to_cell(current_sim_state, workshop_idx)\n                \n                # If no path found and not already on the workshop cell, crafting fails\n                is_on_workshop = current_sim_state.grid[current_sim_state.pos[1], current_sim_state.pos[0], workshop_idx] > 0\n                if not path_actions_to_workshop and not is_on_workshop:\n                    return current_sim_state, current_all_actions_list, False\n\n                # Execute movement actions in simulation\n                current_all_actions_list.extend(path_actions_to_workshop)\n                for action in path_actions_to_workshop:\n                    _, current_sim_state = current_sim_state.step(action)\n                \n                # Agent should now be on the workshop cell, perform USE action\n                current_all_actions_list.append(USE)\n                _, current_sim_state = current_sim_state.step(USE)\n                \n                # Verify if the item was successfully crafted\n                if current_sim_state.inventory[target_idx] > 0:\n                    return current_sim_state, current_all_actions_list, True\n                else:\n                    return current_sim_state, current_all_actions_list, False\n            else:\n                # If no specific workshop is required, perform USE action anywhere\n                current_all_actions_list.append(USE)\n                _, current_sim_state = current_sim_state.step(USE)\n                if current_sim_state.inventory[target_idx] > 0:\n                    return current_sim_state, current_all_actions_list, True\n                else:\n                    return current_sim_state, current_all_actions_list, False\n        \n        # If the target item is neither a primitive nor has a defined recipe, it cannot be acquired\n        return current_sim_state, current_all_actions_list, False\n\n    # Main call to initiate the acquisition process for the target item\n    final_sim_state, all_actions, success = acquire_item(item_idx, simulated_state, all_actions)\n    \n    return all_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:03:02.870660", "function_name": "craft", "function_body": "    import numpy as np\n\n    # Helper function to find an entity's first location on the grid\n    def _find_entity_location(grid, entity_idx):\n        width, height, n_kinds = grid.shape\n        for x in range(width):\n            for y in range(height):\n                if grid[x, y, entity_idx] > 0: # Assuming 1 for presence, 0 for absence\n                    return (x, y)\n        return None\n\n    # Helper function to generate movement actions\n    def _get_move_actions(start_pos, target_pos):\n        actions = []\n        current_x, current_y = start_pos\n        target_x, target_y = target_pos\n\n        # Action constants based on CraftLab.action_specs\n        DOWN = 0\n        UP = 1\n        LEFT = 2\n        RIGHT = 3\n\n        # Move horizontally\n        while current_x != target_x:\n            if current_x < target_x:\n                actions.append(RIGHT)\n                current_x += 1\n            else:\n                actions.append(LEFT)\n                current_x -= 1\n        \n        # Move vertically\n        while current_y != target_y:\n            if current_y < target_y:\n                actions.append(UP)\n                current_y += 1\n            else:\n                actions.append(DOWN)\n                current_y -= 1\n                \n        return actions\n\n    # Main planner class to manage state and actions during planning\n    class CraftPlanner:\n        def __init__(self, env):\n            self.env = env\n            self.cookbook = env.world.cookbook\n            self.initial_grid = env.scenario.init_grid\n            self.current_pos = list(env.scenario.init_pos) # Make it mutable for simulation\n            self.simulated_inventory = np.zeros(self.cookbook.n_kinds, dtype=np.int32)\n            self.actions = []\n            \n            # Populate name to ID and ID to name maps for debugging and _key lookup\n            self.item_id_to_name = {idx: name for name, idx in self.cookbook.index.contents.items()}\n            self.item_name_to_id = self.cookbook.index.contents\n\n            # Action constants based on CraftLab.action_specs\n            self.USE = 4\n            \n            # Cache for visited items to prevent infinite recursion and redundant planning for sub-crafts\n            self._craft_memo = {} # {item_idx: bool} to mark if crafting plan for this item has been initiated\n\n        def _add_action(self, action):\n            self.actions.append(action)\n\n        def _move_to(self, target_pos):\n            move_actions = _get_move_actions(tuple(self.current_pos), target_pos)\n            self.actions.extend(move_actions)\n            self.current_pos = list(target_pos)\n\n        def _collect_primitive(self, kind_idx, count_needed=1):\n            # Find all locations of this primitive on the grid\n            all_locs = []\n            width, height, n_kinds = self.initial_grid.shape\n            for x in range(width):\n                for y in range(height):\n                    if self.initial_grid[x, y, kind_idx] > 0:\n                        all_locs.append((x, y))\n\n            if not all_locs:\n                raise ValueError(f\"Required primitive '{self.item_id_to_name.get(kind_idx, 'unknown')}' (ID: {kind_idx}) not found in the initial grid.\")\n            \n            # Sort locations by Manhattan distance to current_pos (closer ones first)\n            all_locs.sort(key=lambda loc: abs(loc[0] - self.current_pos[0]) + abs(loc[1] - self.current_pos[1]))\n\n            collected_count = 0\n            for loc in all_locs:\n                if collected_count >= count_needed:\n                    break\n                \n                # Move to the location and USE to collect\n                self._move_to(loc)\n                self._add_action(self.USE)\n                self.simulated_inventory[kind_idx] += 1 # Simulate collection\n                collected_count += 1\n                \n            if collected_count < count_needed:\n                raise RuntimeError(f\"Could not collect enough of primitive '{self.item_id_to_name.get(kind_idx, 'unknown')}' (ID: {kind_idx}). Needed {count_needed}, got {collected_count}.\")\n\n        def _find_workshop_location(self, workshop_name=None):\n            if workshop_name:\n                workshop_idx = self.item_name_to_id.get(workshop_name)\n                if workshop_idx is None:\n                    raise ValueError(f\"Specified workshop '{workshop_name}' not found in cookbook index.\")\n                \n                loc = _find_entity_location(self.initial_grid, workshop_idx)\n                if loc is None:\n                    raise ValueError(f\"Specified workshop '{workshop_name}' (ID: {workshop_idx}) not found on grid.\")\n                return loc\n            else:\n                # If no specific workshop name, find any general workshop from world's list\n                for w_idx in self.env.world.workshop_indices:\n                    loc = _find_entity_location(self.initial_grid, w_idx)\n                    if loc:\n                        return loc\n            return None # No workshop found (for \"in-hand\" crafting, or error)\n\n        def plan_craft(self, item_idx):\n            # This memoization helps prevent infinite loops for circular dependencies and\n            # ensures that a crafting plan for a sub-item is only initiated once per \"branch\" of dependencies.\n            if item_idx in self._craft_memo:\n                return \n\n            self._craft_memo[item_idx] = True # Mark as being processed\n\n            recipe = self.cookbook.recipes.get(item_idx)\n\n            # If no recipe, it's not a craftable item for this function's purpose.\n            if not recipe:\n                if item_idx in self.cookbook.primitives:\n                    raise ValueError(f\"Cannot craft primitive item '{self.item_id_to_name.get(item_idx, 'unknown')}' (ID: {item_idx}). This function is for crafting composite items. For primitives, rely on their need as ingredients.\")\n                else:\n                    raise ValueError(f\"Item '{self.item_id_to_name.get(item_idx, 'unknown')}' (ID: {item_idx}) is neither primitive nor has a recipe. Cannot plan its acquisition.\")\n\n            ingredients_needed = recipe.copy()\n            \n            # Extract workshop key if present\n            workshop_name = ingredients_needed.pop(\"_key\", None)\n            \n            # Gather all ingredients recursively\n            for ing_idx, count_needed in ingredients_needed.items():\n                current_ing_count = self.simulated_inventory[ing_idx]\n                if current_ing_count < count_needed:\n                    amount_to_obtain = count_needed - current_ing_count\n                    \n                    if ing_idx in self.cookbook.primitives:\n                        # It's a primitive, collect the required amount\n                        self._collect_primitive(ing_idx, amount_to_obtain)\n                    else:\n                        # It's a composite item, recursively plan its crafting 'amount_to_obtain' times\n                        for _ in range(amount_to_obtain):\n                            self.plan_craft(ing_idx) \n            \n            # Now all ingredients are (simulated) in inventory. Perform the final crafting step.\n            \n            # Move to workshop if a specific one is required and found\n            workshop_loc = None\n            if workshop_name:\n                workshop_loc = self._find_workshop_location(workshop_name)\n            \n            if workshop_loc: # Only move if a specific workshop was identified\n                self._move_to(workshop_loc)\n\n            # Perform the crafting action\n            self._add_action(self.USE)\n            self.simulated_inventory[item_idx] += 1 # Simulate crafting the item\n\n            # Consume ingredients from simulated inventory\n            for ing_idx, count_needed in ingredients_needed.items():\n                self.simulated_inventory[ing_idx] -= count_needed\n\n            self._craft_memo.pop(item_idx) # Remove from memo, done processing this crafting step for now.\n\n    # Instantiate the planner and execute the plan\n    planner = CraftPlanner(env)\n    planner.plan_craft(item) # This call will populate planner.actions\n    return planner.actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:05:21.267942", "function_name": "craft", "function_body": "  # Action constants (local to this function's scope)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Helper for movement deltas\n  DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  def _is_valid_pos(pos, grid_shape):\n      x, y = pos\n      width, height, _ = grid_shape\n      return 0 <= x < width and 0 <= y < height\n\n  def _can_move_to(pos, grid_state, non_grabbable_indices_set):\n      \"\"\"\n      Checks if agent can move onto a given position `pos`.\n      Agent cannot move onto cells occupied by non-grabbable items.\n      \"\"\"\n      if not _is_valid_pos(pos, grid_state.shape):\n          return False\n      \n      # Check if any non-grabbable item occupies this cell\n      cell_contents = grid_state[pos[0], pos[1], :]\n      for idx in np.where(cell_contents > 0)[0]:\n          if idx in non_grabbable_indices_set:\n              return False # Cannot move onto a non-grabbable item\n      \n      return True # Cell is traversable\n\n  def _get_adjacent_positions(pos, grid_shape):\n      x, y = pos\n      adj_pos = []\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Left, Right, Up, Down\n          nx, ny = x + dx, y + dy\n          if _is_valid_pos((nx, ny), grid_shape):\n              adj_pos.append((nx, ny))\n      return adj_pos\n\n  def _find_path_bfs(start_pos, target_pos, grid_state, non_grabbable_indices_set):\n      \"\"\"\n      Performs a BFS to find the shortest path (list of actions) from start_pos to target_pos.\n      Returns (list_of_actions) or None if not reachable.\n      \"\"\"\n      q = collections.deque([(start_pos, [])]) # (current_pos, path_actions)\n      visited = {start_pos}\n\n      while q:\n          curr_pos, path_actions = q.popleft()\n\n          if curr_pos == target_pos:\n              return path_actions\n\n          for action_val, (dx, dy) in DELTAS.items():\n              next_pos = (curr_pos[0] + dx, curr_pos[1] + dy)\n\n              if next_pos not in visited and _can_move_to(next_pos, grid_state, non_grabbable_indices_set):\n                  visited.add(next_pos)\n                  q.append((next_pos, path_actions + [action_val]))\n      \n      return None # Target not reachable\n\n  class SimulatedCraftState:\n      \"\"\"\n      A lightweight class to simulate CraftState changes during planning.\n      It needs: grid, inventory, pos.\n      \"\"\"\n      def __init__(self, current_state, world):\n          self.grid = np.copy(current_state.grid)\n          self.inventory = np.copy(current_state.inventory)\n          self.pos = current_state.pos\n          self.world = world # Reference to CraftWorld for cookbook, indices etc.\n\n      def step(self, action):\n          \"\"\"Simulate a movement step.\"\"\"\n          if action in [UP, DOWN, LEFT, RIGHT]:\n              next_pos = (self.pos[0] + DELTAS[action][0], self.pos[1] + DELTAS[action][1])\n              self.pos = next_pos\n          # Note: Actual `USE` logic is handled in `_acquire_item` directly.\n\n      def find_target_kind_pos(self, target_kind_idx):\n          \"\"\"Finds *any* coordinate (x,y) of target_kind_idx in the grid.\"\"\"\n          width, height, _ = self.grid.shape\n          for x in range(width):\n              for y in range(height):\n                  if self.grid[x, y, target_kind_idx] > 0:\n                      return (x, y)\n          return None\n\n  actions_plan = []\n  \n  # Create a simulated state to plan moves without affecting the actual environment\n  sim_state = SimulatedCraftState(env._current_state, env.world)\n  \n  cookbook = env.world.cookbook\n  # Convert lists to sets for efficient lookups\n  non_grabbable_indices_set = set(env.world.non_grabbable_indices)\n  grabbable_indices_set = set(env.world.grabbable_indices)\n\n  # Use a set to detect and prevent infinite recursion for circular dependencies in recipes\n  crafting_stack = set() \n\n  # Recursive helper to plan acquiring an item (primitive or craftable)\n  def _acquire_item(current_sim_state, target_item_idx):\n      nonlocal actions_plan # Allow modification of the outer list\n\n      # Base case: If item already in simulated inventory, we don't need to acquire more\n      if current_sim_state.inventory[target_item_idx] > 0:\n          return True\n\n      # Prevent infinite recursion for mutually dependent recipes or if already working on this\n      if target_item_idx in crafting_stack:\n          return False\n\n      crafting_stack.add(target_item_idx)\n\n      try:\n          # Case 1: Primitive Item (e.g., WOOD, STONE, WATER)\n          if target_item_idx in cookbook.primitives:\n              # Find the location of the primitive on the grid\n              resource_location = current_sim_state.find_target_kind_pos(target_item_idx)\n              if resource_location is None:\n                  return False # Resource not found on grid\n\n              path_to_target_pos = None\n              \n              # Determine if we need to move ONTO the resource cell or ADJACENT to it\n              if target_item_idx in grabbable_indices_set: # e.g., WOOD. Can move onto it.\n                  path_to_target_pos = _find_path_bfs(\n                      current_sim_state.pos, resource_location, current_sim_state.grid, non_grabbable_indices_set\n                  )\n              elif target_item_idx in non_grabbable_indices_set: # e.g., STONE, WATER. Must be adjacent.\n                  # Find a traversable adjacent cell closest to current_sim_state.pos\n                  possible_adj_cells_with_paths = []\n                  for adj_cell in _get_adjacent_positions(resource_location, current_sim_state.grid.shape):\n                      if _can_move_to(adj_cell, current_sim_state.grid, non_grabbable_indices_set):\n                          path = _find_path_bfs(current_sim_state.pos, adj_cell, current_sim_state.grid, non_grabbable_indices_set)\n                          if path is not None:\n                              possible_adj_cells_with_paths.append((len(path), path))\n                  \n                  if not possible_adj_cells_with_paths:\n                      return False # No reachable adjacent cell\n                  \n                  # Pick the shortest path to an adjacent cell\n                  possible_adj_cells_with_paths.sort(key=lambda x: x[0])\n                  path_to_target_pos = possible_adj_cells_with_paths[0][1]\n              else:\n                  # This primitive is neither explicitly grabbable nor non-grabbable, should not happen.\n                  return False\n\n              if path_to_target_pos is None:\n                  return False # Cannot reach the resource location/adjacent cell\n\n              # Execute path in simulation and add actions to plan\n              for action in path_to_target_pos:\n                  current_sim_state.step(action)\n                  actions_plan.append(action)\n              \n              # Perform USE action for collection\n              actions_plan.append(USE)\n              current_sim_state.inventory[target_item_idx] += 1 # Simulate collection\n              \n              # Simulate consumption from grid if it's a countable resource\n              if current_sim_state.grid[resource_location[0], resource_location[1], target_item_idx] > 0:\n                   current_sim_state.grid[resource_location[0], resource_location[1], target_item_idx] -= 1\n              \n              return True\n          \n          # Case 2: Craftable Item\n          if target_item_idx in cookbook.recipes:\n              recipe = cookbook.recipes[target_item_idx]\n              \n              # Acquire all ingredients recursively\n              ingredients_acquired = True\n              ingredients_to_consume = collections.defaultdict(int)\n              for ing_idx, count in recipe.items():\n                  if ing_idx == '_key':\n                      continue # Skip workshop key\n                  \n                  needed_count = count - current_sim_state.inventory[ing_idx]\n                  for _ in range(int(needed_count)): # Ensure int for loop\n                      if not _acquire_item(current_sim_state, ing_idx):\n                          ingredients_acquired = False\n                          break\n                  if not ingredients_acquired:\n                      break\n                  ingredients_to_consume[ing_idx] += count # Track total ingredients required for THIS craft\n\n              if not ingredients_acquired:\n                  return False\n\n              # After acquiring ingredients, handle workshop if required\n              workshop_idx = recipe.get('_key')\n              if workshop_idx is not None:\n                  # Find the workshop on the grid\n                  workshop_pos = current_sim_state.find_target_kind_pos(workshop_idx)\n                  if workshop_pos is None:\n                      return False # Workshop not found\n\n                  # Pathfind to an adjacent traversable position to the workshop\n                  path_to_workshop_adj = None\n                  \n                  possible_adj_cells_with_paths = []\n                  for adj_cell in _get_adjacent_positions(workshop_pos, current_sim_state.grid.shape):\n                      # Workshops are non-grabbable, so we only try to move to a traversable adjacent cell\n                      if _can_move_to(adj_cell, current_sim_state.grid, non_grabbable_indices_set):\n                          path = _find_path_bfs(current_sim_state.pos, adj_cell, current_sim_state.grid, non_grabbable_indices_set)\n                          if path is not None:\n                              possible_adj_cells_with_paths.append((len(path), path))\n                  \n                  if not possible_adj_cells_with_paths:\n                      return False # No reachable adjacent cell to workshop\n                  \n                  possible_adj_cells_with_paths.sort(key=lambda x: x[0])\n                  path_to_workshop_adj = possible_adj_cells_with_paths[0][1]\n\n                  for action in path_to_workshop_adj:\n                      current_sim_state.step(action)\n                      actions_plan.append(action)\n\n              # Perform USE action for crafting\n              actions_plan.append(USE)\n              current_sim_state.inventory[target_item_idx] += 1 # Simulate crafting\n\n              # Simulate consumption of ingredients from inventory\n              for ing_idx, count in ingredients_to_consume.items():\n                  current_sim_state.inventory[ing_idx] -= count\n                  # Ensure inventory doesn't go negative in simulation (shouldn't if planning is correct)\n                  if current_sim_state.inventory[ing_idx] < 0:\n                      current_sim_state.inventory[ing_idx] = 0\n              \n              return True\n          \n          # Case 3: Item is neither primitive nor craftable (e.g., invalid item ID)\n          return False\n      finally:\n          crafting_stack.remove(target_item_idx) # Remove from stack when done with this item's acquisition\n\n  # Start the recursive planning process for the desired `item`\n  success = _acquire_item(sim_state, item)\n  \n  if not success:\n      return [] # If the item couldn't be acquired, return an empty plan\n  \n  return actions_plan", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:05:22.531570", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Action constants based on CraftLab.action_specs\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  actions = []\n\n  # 1. Get recipe information for the target item\n  recipe_info = cookbook.recipes.get(item)\n\n  if recipe_info is None:\n      # If no recipe is found for the given item, it cannot be crafted\n      # or is an error case. Return an empty list of actions.\n      return []\n\n  # 2. Determine if a specific workshop is required for this recipe\n  workshop_key = recipe_info.get(\"_key\")\n\n  if workshop_key is None:\n      # No specific workshop is required (e.g., crafting by hand).\n      # The only action needed is USE, assuming ingredients are present\n      # (the problem statement implies we generate actions for crafting,\n      # not for gathering ingredients).\n      actions.append(USE)\n  else:\n      # A workshop is required. Find its integer ID from the cookbook's index.\n      workshop_idx = cookbook.index.get(workshop_key)\n      if workshop_idx is None:\n          # This case indicates a malformed recipe or environment setup\n          # where the workshop key exists but its index is not found.\n          return []\n\n      # 3. Pathfinding to a cell adjacent to the required workshop.\n      # This helper function uses Breadth-First Search (BFS) to find\n      # the shortest path.\n      def find_path_to_adjacent_target(start_pos, target_kind_idx, game_grid, game_world):\n          # Queue for BFS: stores tuples of (current_position, path_taken_so_far)\n          q = deque([(start_pos, [])]) \n          # Set to keep track of visited positions to avoid cycles and redundant paths\n          visited = {start_pos}\n          \n          # Get grid dimensions for boundary checks\n          WIDTH, HEIGHT, _ = game_grid.shape\n          \n          # Define movement directions and their corresponding action IDs\n          moves = {\n              (0, -1): UP,    # Move North (decreases Y coordinate)\n              (0, 1): DOWN,   # Move South (increases Y coordinate)\n              (-1, 0): LEFT,  # Move West (decreases X coordinate)\n              (1, 0): RIGHT   # Move East (increases X coordinate)\n          }\n          \n          # Helper function to check if a position is within the grid boundaries\n          def is_valid_pos(p):\n              return 0 <= p[0] < WIDTH and 0 <= p[1] < HEIGHT\n\n          # Helper function to check if a given position is adjacent to the target kind\n          # (i.e., if any cell in its 3x3 neighborhood contains the target kind).\n          def is_adjacent_to_target(pos, target_kind_idx, game_grid_local):\n              x, y = pos\n              # Check all 8 neighboring cells (including diagonals)\n              for dx_offset in [-1, 0, 1]:\n                  for dy_offset in [-1, 0, 1]:\n                      # Skip the current cell itself (0,0 offset)\n                      if dx_offset == 0 and dy_offset == 0:\n                          continue\n                      \n                      nx, ny = x + dx_offset, y + dy_offset\n                      # Check if the neighbor is valid and contains the target kind\n                      if is_valid_pos((nx, ny)) and game_grid_local[nx, ny, target_kind_idx] > 0:\n                          return True\n              return False\n\n          # Get the index for boundary elements to avoid moving into them.\n          boundary_idx = game_world.cookbook.index.get(\"boundary\")\n\n          while q:\n              current_pos, path = q.popleft()\n\n              # If the current position is already adjacent to the target,\n              # we've found the shortest path, so return it.\n              if is_adjacent_to_target(current_pos, target_kind_idx, game_grid):\n                  return path\n\n              # Explore all possible moves from the current position\n              for (dx, dy), action in moves.items():\n                  next_pos = (current_pos[0] + dx, current_pos[1] + dy)\n                  \n                  # Check if the next position is valid and has not been visited yet\n                  if is_valid_pos(next_pos) and next_pos not in visited:\n                      # Also ensure we don't move into a \"boundary\" element.\n                      # If \"boundary\" index is not found, assume all cells are passable.\n                      if boundary_idx is None or game_grid[next_pos[0], next_pos[1], boundary_idx] == 0:\n                          visited.add(next_pos)\n                          q.append((next_pos, path + [action]))\n          \n          return [] # No path found to an adjacent cell from the start_pos\n\n      # Get the agent's current position and the current state of the grid\n      start_pos = current_state.pos\n      grid = current_state.grid\n\n      # Get the sequence of movement actions to reach a position adjacent to the workshop\n      path_to_workshop = find_path_to_adjacent_target(start_pos, workshop_idx, grid, world)\n      actions.extend(path_to_workshop)\n      \n      # 4. After moving to (or if already at) the workshop, perform the USE action to craft the item.\n      actions.append(USE)\n        \n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:07:39.775931", "function_name": "craft", "function_body": "  import numpy as np\n  import collections\n\n  # Memoization cache for recursive planner, cleared for each top-level call\n  _memo = {} \n\n  # Define action constants based on the provided action_specs\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Helper to create a deep copy of a CraftState\n  def _copy_craft_state(state):\n      \"\"\"Creates a new CraftState instance with copies of mutable attributes.\"\"\"\n      return CraftState(\n          scenario=state.scenario,\n          grid=state.grid.copy(), # Grid is a mutable numpy array\n          pos=state.pos,           # Tuple (immutable)\n          dir=state.dir,           # Int (immutable)\n          inventory=state.inventory.copy() # Inventory is a mutable numpy array\n      )\n\n  # BFS pathfinding function to find actions to reach a state where\n  # target_kind_idx is in the 3x3 neighborhood of the agent.\n  # Returns (list_of_actions, final_state_after_path) or (None, None) if no path.\n  def _find_path_to_adj(start_state, target_kind_idx):\n      \"\"\"\n      Finds a path of movement actions from start_state to a state where\n      target_kind_idx is adjacent to the agent.\n      \"\"\"\n      q = collections.deque([(start_state, [])]) # (current_state, path_actions_to_reach_current_state)\n      \n      # Visited set stores (position, direction) to avoid cycles and redundant paths.\n      # Inventory is not included as pathfinding assumes a static traversable environment.\n      visited = set([(start_state.pos, start_state.dir)])\n\n      # Max steps heuristic to prevent overly long paths and infinite loops.\n      # A generous upper bound based on grid dimensions.\n      max_path_length = start_state.grid.shape[0] * start_state.grid.shape[1] * 2 \n      \n      while q:\n          current_state, path_actions = q.popleft()\n\n          # Check if current_state is adjacent to the target\n          if current_state.next_to(target_kind_idx):\n              return path_actions, current_state\n\n          # Pruning long paths to improve performance and prevent infinite loops in complex scenarios.\n          if len(path_actions) >= max_path_length:\n              continue \n\n          # Explore possible movements (UP, DOWN, LEFT, RIGHT)\n          for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n              # Simulate the step to get the next state.\n              # CraftState.step creates a new CraftState object, so deepcopy is handled internally.\n              _, next_state = current_state.step(action)\n              \n              # Check if movement actually occurred. If pos and dir are unchanged, the move was blocked.\n              if next_state.pos == current_state.pos and next_state.dir == current_state.dir:\n                  continue # Blocked path, don't add to queue.\n\n              # State key for the visited set.\n              next_state_key = (next_state.pos, next_state.dir) \n              \n              if next_state_key not in visited:\n                  visited.add(next_state_key)\n                  q.append((next_state, path_actions + [action]))\n\n      return None, None # No path found\n\n  # Recursive planner function to determine actions to get a specific item\n  def _recursive_craft_planner(current_state, target_item_idx):\n      \"\"\"\n      Recursively plans the actions required to obtain a target item.\n      Returns (list_of_actions, final_state_after_planning) or (None, None) if impossible.\n      \"\"\"\n      # Base case: Item is already in inventory\n      if current_state.inventory[target_item_idx] > 0:\n          return [], _copy_craft_state(current_state)\n\n      # Memoization key: (tuple(current_state.inventory), current_state.pos, current_state.dir, target_item_idx)\n      # Using a tuple of inventory to make it hashable.\n      state_key = (tuple(current_state.inventory), current_state.pos, current_state.dir, target_item_idx)\n      if state_key in _memo:\n          return _memo[state_key]\n\n      cookbook = current_state.world.cookbook\n      recipe = cookbook.recipes.get(target_item_idx)\n\n      total_actions_for_item = []\n      current_sim_state = _copy_craft_state(current_state)\n\n      if recipe is None: # Target item is a primitive (e.g., WOOD, STONE), needs to be collected\n          # Find path to a location adjacent to the primitive\n          path_actions, reached_state = _find_path_to_adj(current_sim_state, target_item_idx)\n\n          if path_actions is None:\n              # Cannot reach the primitive, so this item cannot be obtained.\n              _memo[state_key] = (None, None)\n              return None, None\n\n          total_actions_for_item.extend(path_actions)\n          current_sim_state = reached_state\n\n          # Perform USE action to collect the primitive\n          _, new_state_after_use = current_sim_state.step(ACTION_USE)\n          total_actions_for_item.append(ACTION_USE)\n          current_sim_state = new_state_after_use\n          \n          # Verify collection: If item count is still zero, collection failed.\n          if current_sim_state.inventory[target_item_idx] == 0:\n              _memo[state_key] = (None, None)\n              return None, None\n\n      else: # Target item is a crafted item, needs ingredients and possibly a workshop\n          required_ingredients = {}\n          required_workshop_idx = None\n\n          for key, value in recipe.items():\n              if key == \"_workshop\":\n                  required_workshop_idx = value\n              else:\n                  required_ingredients[key] = value\n\n          # First, recursively gather all required ingredients\n          for ing_idx, count_needed in required_ingredients.items():\n              while current_sim_state.inventory[ing_idx] < count_needed:\n                  ing_actions, updated_state = _recursive_craft_planner(current_sim_state, ing_idx)\n                  if ing_actions is None:\n                      # Failed to get an ingredient, so this craft is impossible.\n                      _memo[state_key] = (None, None)\n                      return None, None\n                  total_actions_for_item.extend(ing_actions)\n                  current_sim_state = updated_state\n          \n          # Now, move to the workshop if one is required for this recipe\n          if required_workshop_idx is not None:\n              path_actions, reached_state = _find_path_to_adj(current_sim_state, required_workshop_idx)\n              if path_actions is None:\n                  # Cannot reach the required workshop.\n                  _memo[state_key] = (None, None)\n                  return None, None\n              total_actions_for_item.extend(path_actions)\n              current_sim_state = reached_state\n\n          # Perform USE action to craft the item\n          inventory_before_craft = current_sim_state.inventory[target_item_idx] # Store current count for verification\n          _, new_state_after_craft = current_sim_state.step(ACTION_USE)\n          total_actions_for_item.append(ACTION_USE)\n          current_sim_state = new_state_after_craft\n          \n          # Verify crafting: If the item count didn't increase, crafting failed.\n          if current_sim_state.inventory[target_item_idx] == inventory_before_craft:\n              _memo[state_key] = (None, None)\n              return None, None\n\n      # Cache the result before returning\n      _memo[state_key] = (total_actions_for_item, current_sim_state)\n      return total_actions_for_item, current_sim_state\n\n  # --- Main logic of CRAFT_FUNC starts here ---\n\n  # Clear the memoization cache for each top-level call to ensure fresh planning.\n  _memo.clear()\n\n  # Create the initial simulated CraftState from the CraftLab environment's scenario.\n  # This state represents the environment at the beginning of an episode, before any actions.\n  initial_sim_state = CraftState(\n      scenario=env.scenario,\n      grid=env.scenario.init_grid.copy(),\n      pos=env.scenario.init_pos,\n      dir=env.scenario.init_dir,\n      inventory=np.zeros(env.world.n_kinds, dtype=int) # Agent starts with an empty inventory\n  )\n\n  # If the target item is already present in the initial inventory, no actions are needed.\n  if initial_sim_state.inventory[item] > 0:\n      return []\n\n  # Start the recursive planning process to find actions for the target item.\n  actions, final_state = _recursive_craft_planner(initial_sim_state, item)\n\n  # If planning failed (returned None), return an empty list of actions, indicating impossibility.\n  if actions is None:\n      return []\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:07:41.023500", "function_name": "craft", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:09:58.474617", "function_name": "craft", "function_body": "    # Define constants for actions. These are integer IDs used by the environment.\n    # From CraftLab.action_specs(): DOWN:0, UP:1, LEFT:2, RIGHT:3, USE:4.\n    ACTION_USE = 4\n\n    # Define a recursive helper function to build the action sequence.\n    # This helper manages a cache to avoid redundant computations for shared ingredients.\n    # The cache is passed down through recursion to ensure it's shared across calls\n    # for a single top-level `craft_v2` invocation.\n    def _craft_recursive(current_target_idx: int, action_cache: dict) -> list[int]:\n        \"\"\"\n        Recursively determines the actions needed to craft an item or collect a primitive.\n        \n        Args:\n            current_target_idx: The integer index of the item or primitive to acquire.\n            action_cache: A dictionary used as a memoization cache {item_idx: list_of_actions}.\n        \n        Returns:\n            A list of integer actions required to acquire the current_target_idx.\n        \"\"\"\n        \n        # If the action sequence for this item is already in the cache, return it.\n        if current_target_idx in action_cache:\n            return action_cache[current_target_idx]\n\n        current_actions = []\n        cookbook = env.world.cookbook\n        \n        # Get the recipe for the current target item.\n        # If there's no recipe for current_target_idx, it means it's a primitive resource\n        # that needs to be collected, not crafted through a recipe.\n        recipe = cookbook.recipes.get(current_target_idx)\n\n        if recipe is None:\n            # This item is a primitive resource (e.g., 'wood', 'stone').\n            # To \"acquire\" a primitive, we assume a simple 'USE' action is sufficient,\n            # implying the agent is already in a position to collect it.\n            # This is a simplification due to the `craft_v2` function's inability to\n            # dynamically interact with the environment (e.g., pathfinding, checking `next_to`).\n            acquired_actions = [ACTION_USE]\n            action_cache[current_target_idx] = acquired_actions\n            return acquired_actions\n        \n        # This item is craftable, process its recipe.\n        required_ingredients = {}\n        # The `_key` in the recipe usually specifies the workshop required for crafting.\n        # For this simplified action planner, we assume the final `ACTION_USE` for crafting\n        # will implicitly happen at the correct workshop, or that movement to workshops\n        # is handled by a higher-level logic (not within this `CRAFT_FUNC`'s scope).\n        # Therefore, we just parse it but don't generate explicit movement actions for it.\n        # required_workshop_idx = None \n\n        for ingredient_idx_or_key, count_or_idx in recipe.items():\n            if ingredient_idx_or_key == \"_key\":\n                # required_workshop_idx = count_or_idx # Store if needed for more complex planning\n                pass\n            else:\n                required_ingredients[ingredient_idx_or_key] = count_or_idx\n\n        # Recursively gather actions for all required ingredients.\n        for ingredient_idx, count in required_ingredients.items():\n            # Get the action sequence for each sub-ingredient.\n            sub_item_actions = _craft_recursive(ingredient_idx, action_cache)\n            \n            # Extend the current action list by repeating the sub-item's actions\n            # for the required `count` of that ingredient.\n            current_actions.extend(sub_item_actions * count)\n\n        # After all ingredients are accounted for, add the final 'USE' action\n        # to perform the crafting of the target item.\n        current_actions.append(ACTION_USE)\n\n        # Cache the complete action sequence for the current_target_idx\n        # before returning, to speed up future lookups.\n        action_cache[current_target_idx] = current_actions\n        return current_actions\n\n    # Initialize a new cache for this top-level call to `craft_v2`.\n    # This ensures that each `solve` function call (which invokes `craft_v2`)\n    # starts with a clean slate for its crafting plan.\n    initial_call_cache = {}\n    \n    # Start the recursive action generation process.\n    return _craft_recursive(target_item_idx, initial_call_cache)", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:09:58.499139", "function_name": "craft", "function_body": "    import collections\n\n    # Global constants for actions (as per action_specs)\n    # These are hardcoded in CraftLab, so it's safe to define them here.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    def _get_action_coords(action):\n        \"\"\"Returns (dx, dy) for a given action.\"\"\"\n        if action == ACTION_UP: return (0, -1)\n        if action == ACTION_DOWN: return (0, 1)\n        if action == ACTION_LEFT: return (-1, 0)\n        if action == ACTION_RIGHT: return (1, 0)\n        return (0, 0) # For USE, etc.\n\n    def _is_valid_pos(pos, grid_shape):\n        \"\"\"Checks if a given position (x, y) is within the grid boundaries.\"\"\"\n        x, y = pos\n        WIDTH, HEIGHT, _ = grid_shape\n        return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n    def _find_path_to_kind(start_state, target_kind_idx, is_target_grabbable):\n        \"\"\"\n        Finds a path (list of actions) from start_state.pos to a cell\n        containing target_kind_idx (if grabbable) or adjacent to it (if non-grabbable).\n        Uses Breadth-First Search (BFS).\n        Returns a list of actions or None if no path found.\n        \"\"\"\n        initial_pos = start_state.pos\n        grid = start_state.grid\n        WIDTH, HEIGHT, N_KINDS = grid.shape\n\n        q = collections.deque([(initial_pos, [])]) # (current_pos, actions_taken_so_far)\n        visited = {initial_pos}\n\n        cookbook_index = start_state.world.cookbook.index\n        # Get indices for blocking terrain from the cookbook index\n        water_idx = cookbook_index['water']\n        boundary_idx = cookbook_index['boundary'] \n        \n        # Directions for movement\n        moves = {\n            ACTION_UP: (0, -1),\n            ACTION_DOWN: (0, 1),\n            ACTION_LEFT: (-1, 0),\n            ACTION_RIGHT: (1, 0)\n        }\n\n        while q:\n            current_pos, actions_taken = q.popleft()\n            cx, cy = current_pos\n\n            # Check if current_pos satisfies the goal condition\n            is_goal = False\n            if is_target_grabbable:\n                # Goal for grabbable items: be ON the cell with the item\n                if grid[cx, cy, target_kind_idx] > 0:\n                    is_goal = True\n            else:\n                # Goal for non-grabbable items (like workshops): be ADJACENT to the cell with the item.\n                # Check 3x3 neighborhood including current position\n                for dx_nb in [-1, 0, 1]:\n                    for dy_nb in [-1, 0, 1]:\n                        nx_nb, ny_nb = cx + dx_nb, cy + dy_nb\n                        if _is_valid_pos((nx_nb, ny_nb), grid.shape) and grid[nx_nb, ny_nb, target_kind_idx] > 0:\n                            is_goal = True\n                            break\n                    if is_goal: break\n            \n            if is_goal:\n                return actions_taken\n\n            # Explore neighbors\n            for action, (dx, dy) in moves.items():\n                next_x, next_y = cx + dx, cy + dy\n                next_pos = (next_x, next_y)\n\n                if _is_valid_pos(next_pos, grid.shape) and next_pos not in visited:\n                    # Check for obstacles (water, boundary)\n                    is_blocked = False\n                    # A cell is blocked if it contains a significant amount of the blocking kind.\n                    if grid[next_x, next_y, water_idx] > 0 or \\\n                       grid[next_x, next_y, boundary_idx] > 0:\n                        is_blocked = True\n                    \n                    if not is_blocked:\n                        visited.add(next_pos)\n                        q.append((next_pos, actions_taken + [action]))\n        return None # No path found\n\n    # Actions list to accumulate all steps\n    actions_to_take = []\n    \n    # Get the current state from the environment\n    # The `solve` function calls `env.reset()` before `craft`, so `env._current_state` is the initial state.\n    current_state = env._current_state\n\n    # Recursive helper function to plan and execute actions in the environment\n    # This function updates the `current_state` by performing steps on the actual `env`\n    # and appends the taken actions to `actions_to_take`.\n    def _plan_and_execute(target_item_idx):\n        nonlocal current_state\n        nonlocal actions_to_take\n        \n        # Base case: If we already have the item in inventory, we're done with this sub-goal.\n        if current_state.inventory[target_item_idx] > 0:\n            return True # Success\n\n        cookbook = env.world.cookbook\n        \n        # Check if the target item is a primitive resource (i.e., it can be collected directly from the grid)\n        if target_item_idx in cookbook.primitives:\n            # Primitives are generally grabbable; we need to move onto their cell to collect them.\n            path_actions = _find_path_to_kind(current_state, target_item_idx, is_target_grabbable=True)\n            if path_actions is None:\n                # If no path is found, this primitive cannot be collected.\n                return False \n            \n            # Execute path actions to reach the primitive\n            for action in path_actions:\n                _, done, _ = env.step(action) # Step the actual environment\n                actions_to_take.append(action)\n                current_state = env._current_state # Update current_state reference\n                if done: return False # If environment is done during collection, something went wrong\n\n            # After reaching the primitive, use the 'USE' action to collect it\n            _, done, _ = env.step(ACTION_USE)\n            actions_to_take.append(ACTION_USE)\n            current_state = env._current_state \n            if done: return False\n            \n            # Verify if the item was successfully collected\n            return current_state.inventory[target_item_idx] > 0\n\n        # If it's not a primitive, it must be a crafted item. Look up its recipe.\n        recipe = cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            # No recipe found for this item, so it cannot be crafted.\n            return False \n\n        # Recursively acquire all necessary ingredients for this recipe\n        for ingredient_idx, count in recipe.items():\n            if ingredient_idx == \"_key\": # \"_key\" is a special entry for workshop location\n                continue\n\n            current_has = current_state.inventory[ingredient_idx]\n            needed_count = count - current_has\n            \n            if needed_count > 0:\n                # For each unit of ingredient still needed, try to acquire it\n                for _ in range(needed_count):\n                    if not _plan_and_execute(ingredient_idx):\n                        # If we fail to acquire any ingredient, the crafting fails.\n                        return False \n\n        # All ingredients have been acquired. Now, move to the required workshop (if any) and perform the craft.\n        workshop_key = recipe.get(\"_key\")\n        if workshop_key is not None:\n            # Workshops are non-grabbable; the agent needs to be adjacent to them.\n            path_actions = _find_path_to_kind(current_state, workshop_key, is_target_grabbable=False) \n            if path_actions is None:\n                # If no path to the workshop is found, crafting fails.\n                return False \n\n            # Execute path actions to reach the workshop\n            for action in path_actions:\n                _, done, _ = env.step(action)\n                actions_to_take.append(action)\n                current_state = env._current_state \n                if done: return False\n\n        # Now at the correct location (either a workshop or no specific location needed), perform the 'USE' action to craft.\n        _, done, _ = env.step(ACTION_USE)\n        actions_to_take.append(ACTION_USE)\n        current_state = env._current_state \n        if done: return False\n\n        # Verify if the item was successfully crafted\n        return current_state.inventory[target_item_idx] > 0\n\n    # Start the planning process for the initial 'item' goal\n    success = _plan_and_execute(item)\n    \n    if not success:\n        # If the goal cannot be achieved (e.g., no recipe, blocked path, missing resources),\n        # return an empty list of actions.\n        return []\n    \n    # Return the accumulated list of actions.\n    return actions_to_take", "island_id": 7, "scores": {"3": -1}}
