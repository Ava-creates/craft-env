{"timestamp": "2025-07-25T13:33:23.975981", "function_name": "craft", "function_body": "    world = env.world\n    cookbook = world.cookbook\n    index = cookbook.index\n\n    # Action constants (from env.action_specs())\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Helper to get item name from its integer ID\n    def _get_item_name(item_id):\n        return index.get(item_id)\n\n    # Pathfinding helper (BFS) to move to a cell next to a target kind.\n    # Returns a list of (primitive) actions and the new simulated state after moves.\n    # The BFS state only considers position and direction, as grid/inventory don't change from simple moves.\n    def _plan_move_to_kind(start_state, target_kind_id):\n        q = [(start_state, [])] # (current_sim_state, path_actions)\n        \n        # Visited set stores (position_tuple, direction_int) to avoid cycles and redundant exploration\n        visited = set()\n        visited.add((start_state.pos, start_state.dir))\n\n        while q:\n            current_sim_state, current_path = q.pop(0)\n\n            # Check 3x3 neighborhood for target kind\n            if current_sim_state.next_to(target_kind_id):\n                return current_path, current_sim_state\n\n            # Explore possible moves (UP, DOWN, LEFT, RIGHT)\n            for action_val in [UP, DOWN, LEFT, RIGHT]:\n                # current_sim_state.step() returns a *new* CraftState instance\n                # For movement actions, reward is always 0.0.\n                # The grid and inventory within this new state are copies.\n                reward, next_sim_state = current_sim_state.step(action_val)\n                \n                next_state_key = (next_sim_state.pos, next_sim_state.dir)\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((next_sim_state, current_path + [action_val]))\n        \n        # If target_kind_id is not found reachable, return empty path and original state\n        return [], start_state\n\n    # Recursive helper to get an item (primitive or craftable).\n    # This function takes `sim_state_ref` (a list containing the current simulated state)\n    # and `item_actions_plan` (a list to accumulate actions).\n    # It attempts to obtain `target_item_id` and updates the `sim_state_ref[0]` to reflect\n    # the state after the planned actions.\n    def _get_item_recursive(sim_state_ref, target_item_id, item_actions_plan):\n        current_sim_state = sim_state_ref[0]\n\n        # Base case: If already has it, no actions needed for this branch.\n        if current_sim_state.inventory[target_item_id] > 0:\n            return\n\n        # Check if it's a primitive resource (cannot be crafted, must be collected)\n        if target_item_id in cookbook.primitives:\n            # Collect the primitive: Move to it, then USE to pick it up.\n            \n            # 1. Plan moves to get next to the primitive\n            move_actions, state_after_move = _plan_move_to_kind(current_sim_state, target_item_id)\n            \n            # If no move actions are generated and we're not already next to it,\n            # it means the primitive is unreachable.\n            if not move_actions and not current_sim_state.next_to(target_item_id):\n                return # Cannot obtain this item.\n\n            # Append movement actions to the overall plan\n            item_actions_plan.extend(move_actions)\n            # Update the simulated state to reflect the agent's new position\n            sim_state_ref[0] = state_after_move \n\n            # 2. Perform USE action to collect the item\n            # Only perform USE if we are currently next to the target_item_id in the simulated state.\n            if sim_state_ref[0].next_to(target_item_id):\n                # Store the inventory count before USE to check for success\n                initial_item_count = sim_state_ref[0].inventory[target_item_id]\n                \n                # Apply the USE action in the simulated environment\n                reward, state_after_use = sim_state_ref[0].step(USE)\n                item_actions_plan.append(USE)\n                sim_state_ref[0] = state_after_use # Update simulated state\n                \n                # Verify if collection was successful (inventory increased)\n                if sim_state_ref[0].inventory[target_item_id] > initial_item_count:\n                    return # Successfully collected.\n                else:\n                    return # Collection failed for some reason (e.g., item depleted).\n            else:\n                return # Failed to get next to the item.\n            \n            # If we reached here, either move_actions was empty (meaning already next to it or unreachable),\n            # or `next_to` check failed. In either case, if not collected, return.\n            return\n\n        # If not a primitive, it must be craftable.\n        if target_item_id not in cookbook.recipes:\n            # This item is neither primitive nor craftable (e.g., an invalid ID or an environment object).\n            return # Cannot obtain this item.\n\n        recipe = cookbook.recipes[target_item_id]\n        workshop_id = None\n        ingredients_needed = {}\n\n        for ing_id, count in recipe.items():\n            if ing_id == \"_key\":\n                workshop_id = count # `_key` stores the required workshop's index\n            else:\n                ingredients_needed[ing_id] = count\n\n        # 1. Recursively gather all ingredients for this craft\n        for ing_id, required_count in ingredients_needed.items():\n            while sim_state_ref[0].inventory[ing_id] < required_count:\n                # Store the current inventory count of the ingredient before recursive call\n                # to check if _get_item_recursive was successful in obtaining more.\n                initial_ing_count = sim_state_ref[0].inventory[ing_id]\n                \n                _get_item_recursive(sim_state_ref, ing_id, item_actions_plan)\n                \n                # After recursive call, sim_state_ref[0] is updated.\n                # If we still don't have enough, something went wrong with getting the ingredient.\n                if sim_state_ref[0].inventory[ing_id] <= initial_ing_count:\n                    # Failed to obtain the required ingredient. Cannot craft this item.\n                    return # Propagate failure upwards.\n\n        # 2. Once all ingredients are (simulated to be) in inventory, move to the required workshop.\n        if workshop_id is not None:\n            move_actions, state_after_move = _plan_move_to_kind(sim_state_ref[0], workshop_id)\n            \n            # If no move actions are generated and we're not already next to it,\n            # it means the workshop is unreachable.\n            if not move_actions and not sim_state_ref[0].next_to(workshop_id):\n                return # Cannot craft this item (workshop unreachable).\n\n            item_actions_plan.extend(move_actions)\n            sim_state_ref[0] = state_after_move # Update simulated state\n\n            # Ensure we are next to the workshop after planned moves before attempting USE.\n            if not sim_state_ref[0].next_to(workshop_id):\n                return # Failed to get next to workshop.\n\n        # 3. Perform the USE action to craft the item\n        initial_target_item_count = sim_state_ref[0].inventory[target_item_id]\n        \n        # Apply the USE action in the simulated environment.\n        reward, state_after_use = sim_state_ref[0].step(USE)\n        item_actions_plan.append(USE)\n        sim_state_ref[0] = state_after_use # Update simulated state\n\n        # Verify if crafting was successful (item count increased)\n        if sim_state_ref[0].inventory[target_item_id] <= initial_target_item_count:\n            return # Crafting failed (e.g., not enough ingredients, wrong workshop, etc.).\n        \n        return # Successfully crafted.\n\n    # Main execution logic for craft_v1:\n    # `simulated_state_ref` is a list holding the current simulated `CraftState`.\n    # It's passed by reference so recursive calls update the same state object.\n    simulated_state_ref = [env._current_state]\n    final_actions = []\n\n    # Start the recursive planning process for the target item.\n    _get_item_recursive(simulated_state_ref, item, final_actions)\n\n    return final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-25T13:33:25.583138", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Helper function for BFS pathfinding. It is defined within `craft_v0`\n  # to encapsulate it and adhere to the \"no code outside of it\" constraint\n  # for the overall solution structure.\n  def _find_path_to_adjacent(start_pos, grid, target_kind_idx, non_walkable_indices, world_instance):\n      WIDTH, HEIGHT, _ = grid.shape\n      queue = collections.deque([(start_pos, [])]) # Stores (current_position, list_of_actions_to_reach_here)\n      visited = {start_pos} # Keep track of visited positions to avoid cycles and redundant paths\n\n      # Map (dx, dy) movement vectors to their corresponding integer action codes\n      # These action codes are obtained from env.action_specs() which ensures compatibility\n      # with the specific environment instance.\n      action_map = {\n          (0, -1): env.action_specs()['UP'],    # Move Up (decrement y)\n          (0, 1): env.action_specs()['DOWN'],   # Move Down (increment y)\n          (-1, 0): env.action_specs()['LEFT'],  # Move Left (decrement x)\n          (1, 0): env.action_specs()['RIGHT']   # Move Right (increment x)\n      }\n\n      # Helper to check if a given position is adjacent to the target_kind_idx.\n      # This mimics the behavior of CraftState.next_to: checks the 3x3 neighborhood\n      # including the current position itself.\n      def _is_adjacent_to_kind(current_pos, target_kind_idx, current_grid):\n          px, py = current_pos\n          grid_w, grid_h, _ = current_grid.shape\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  nx, ny = px + dx, py + dy\n                  # Ensure the checked cell is within grid boundaries\n                  if 0 <= nx < grid_w and 0 <= ny < grid_h:\n                      # Check if the target_kind_idx is present at (nx, ny)\n                      if current_grid[nx, ny, target_kind_idx] > 0: # >0 indicates presence of the item kind\n                          return True\n          return False\n\n      while queue:\n          current_pos, current_path = queue.popleft()\n\n          # If the current position is already adjacent to the target workshop,\n          # we have found the shortest path to a valid crafting location.\n          if _is_adjacent_to_kind(current_pos, target_kind_idx, grid):\n              return current_path\n\n          x, y = current_pos\n          # Define possible moves (dx, dy) for standard grid movement\n          moves = [(0, -1), (0, 1), (-1, 0), (1, 0)] # Corresponds to UP, DOWN, LEFT, RIGHT\n\n          for dx, dy in moves:\n              next_x, next_y = x + dx, y + dy\n              next_pos = (next_x, next_y)\n\n              # Check if the next position is within grid boundaries and has not been visited\n              if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and next_pos not in visited:\n                  # Determine if the next position is an obstacle (non-walkable)\n                  is_obstacle = False\n                  for idx in non_walkable_indices:\n                      # If the cell contains any non-walkable entity, it's an obstacle\n                      if grid[next_x, next_y, idx] > 0:\n                          is_obstacle = True\n                          break\n                  \n                  # If not an obstacle, add to the queue for further exploration\n                  if not is_obstacle:\n                      visited.add(next_pos)\n                      action = action_map[(dx, dy)] # Get the action code for this move\n                      queue.append((next_pos, current_path + [action]))\n      \n      return None # If the queue becomes empty and no path is found\n\n  actions = [] # List to store the sequence of actions to be returned\n  \n  state = env._current_state # Get the current state of the environment\n  cookbook = env.world.cookbook # Access the cookbook for recipes and indices\n  \n  item_idx = item # The target item to craft, provided as an integer index\n  recipe = cookbook.recipes.get(item_idx) # Get the recipe for the target item\n\n  if recipe is None:\n    # If no recipe exists for the item (e.g., it's a primitive or unknown),\n    # then it cannot be crafted by this function. Return an empty list of actions.\n    return []\n\n  required_workshop_idx = None\n  # Iterate through the recipe's keys to find if a specific workshop is required.\n  # Workshop requirements are typically indicated by keys that correspond to workshop indices.\n  for key in recipe.keys():\n    # Check if the key in the recipe corresponds to one of the known workshop indices\n    if key in env.world.workshop_indices:\n      required_workshop_idx = key\n      break\n\n  # Get the integer action code for the 'USE' action\n  ACTION_USE = env.action_specs()['USE']\n\n  if required_workshop_idx is not None:\n    # If a specific workshop is required, the agent needs to move to it.\n    start_pos = state.pos # Agent's current position\n    grid = state.grid # Current grid layout\n\n    # Get the indices of non-grabbable items, which typically include obstacles like\n    # boundaries and water, and thus are not walkable.\n    non_walkable_indices = env.world.non_grabbable_indices\n    \n    # Use BFS to find the shortest path from the agent's current position to\n    # a position adjacent to the required workshop.\n    path_to_workshop_adj = _find_path_to_adjacent(start_pos, grid, required_workshop_idx, non_walkable_indices, env.world)\n\n    if path_to_workshop_adj is None:\n      # If no path to the workshop could be found, the item cannot be crafted.\n      return []\n    else:\n      # Extend the action list with the movement actions\n      actions.extend(path_to_workshop_adj)\n  \n  # After moving to the workshop (or if no workshop was needed), perform the USE action\n  actions.append(ACTION_USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
