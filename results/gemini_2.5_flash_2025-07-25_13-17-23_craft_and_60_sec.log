{"timestamp": "2025-07-25T13:38:28.024763", "function_name": "craft", "function_body": "  import numpy as np\n  import collections\n\n  # Action constants (from CraftLab.action_specs())\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Map directions to delta changes (dx, dy)\n  DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0),\n  }\n\n  # Helper function to check if a specific kind is in the 3x3 neighborhood of a position\n  def _is_next_to_pos(grid, pos, kind_idx):\n      width, height, _ = grid.shape\n      px, py = pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = px + dx, py + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  if grid[nx, ny, kind_idx] > 0:\n                      return True\n      return False\n\n  def _move_and_use_to_collect(env, target_kind_idx, current_actions):\n      \"\"\"\n      Moves the agent to be adjacent to `target_kind_idx` and performs a USE action.\n      Updates env._current_state and `current_actions` list.\n      Returns True if successful, False otherwise.\n      \"\"\"\n      # Max steps for pathfinding to prevent infinite loops in large maps\n      # A generous upper bound based on grid size.\n      grid_width, grid_height, _ = env._current_state.grid.shape\n      MAX_PATH_LENGTH = grid_width * grid_height * 2 \n\n      initial_pos = env._current_state.pos\n      current_grid = env._current_state.grid # Grid is static for movement actions\n\n      # BFS to find the shortest path to a position where agent is next to target_kind_idx\n      q = collections.deque([(initial_pos, [])]) # (current_position, actions_to_reach_current_position)\n      visited = {initial_pos}\n\n      best_path_actions = None\n\n      while q:\n          current_pos, path_so_far = q.popleft()\n\n          # Check if at this current_pos, we are next to the target_kind_idx\n          if _is_next_to_pos(current_grid, current_pos, target_kind_idx):\n              best_path_actions = path_so_far\n              break # Found a path!\n\n          if len(path_so_far) >= MAX_PATH_LENGTH: # Prune long paths to avoid excessive search\n              continue # Don't expand further from this path\n\n          # Explore neighbors\n          for action, (dx, dy) in DELTAS.items():\n              next_x, next_y = current_pos[0] + dx, current_pos[1] + dy\n              next_pos = (next_x, next_y)\n\n              # Check bounds\n              if 0 <= next_x < grid_width and 0 <= next_y < grid_height:\n                  if next_pos not in visited:\n                      visited.add(next_pos)\n                      q.append((next_pos, path_so_far + [action]))\n      \n      if best_path_actions is not None:\n          for action in best_path_actions:\n              current_actions.append(action)\n              env.step(action) # Update the live environment state\n          \n          # After moving to the target position, perform USE\n          current_actions.append(USE)\n          env.step(USE)\n          \n          return True\n      \n      return False # Failed to find/reach the item\n\n  actions_taken = []\n  cookbook = env.world.cookbook\n\n  # Recursive helper function to achieve a target item\n  # It modifies the `actions_taken` list and the `env._current_state`\n  def _get_item_recursive(target_item_idx):\n      nonlocal actions_taken # This allows modifying the outer `actions_taken` list\n      \n      current_state = env._current_state\n      \n      # 1. Base case: If item is already in inventory, no action needed for this sub-goal\n      if current_state.inventory[target_item_idx] > 0:\n          return True # Successfully \"got\" the item (already had it)\n\n      # 2. Check if it's a primitive (no recipe in cookbook.recipes, but in cookbook.primitives)\n      if target_item_idx in cookbook.primitives:\n          # It's a primitive, so we need to collect it by moving and using\n          success = _move_and_use_to_collect(env, target_item_idx, actions_taken)\n          # After attempting to collect, verify if it's now in inventory\n          return env._current_state.inventory[target_item_idx] > 0\n      \n      # 3. It's a craftable item, get its recipe\n      recipe = cookbook.recipes.get(target_item_idx)\n      if recipe is None:\n          # This case indicates an invalid `item` passed that is neither primitive nor craftable.\n          return False\n\n      # 4. Recursively acquire all ingredients\n      ingredients_to_acquire = {} # {ingredient_idx: count_needed}\n      for ing_idx, count in recipe.items():\n          if ing_idx == \"_key\":\n              continue # Skip workshop key, handled separately for the final crafting step\n          \n          # Re-fetch current state to get up-to-date inventory before calculating needed count\n          current_state = env._current_state \n          needed = max(0, count - current_state.inventory[ing_idx])\n          if needed > 0:\n              ingredients_to_acquire[ing_idx] = needed\n      \n      for ing_idx, needed_count in ingredients_to_acquire.items():\n          for _ in range(needed_count): # For each required quantity of the ingredient\n              # Attempt to get each needed ingredient recursively\n              if not _get_item_recursive(ing_idx):\n                  # If any ingredient fails to be acquired, the crafting of target_item_idx also fails\n                  return False\n      \n      # 5. All ingredients are (hopefully) acquired. Now, perform the final craft action.\n      # Check if a specific workshop is required for this recipe\n      workshop_idx = recipe.get(\"_key\")\n      \n      if workshop_idx is not None:\n          # Move to the workshop and use\n          success = _move_and_use_to_collect(env, workshop_idx, actions_taken)\n          if not success:\n              # Failed to reach or use the required workshop\n              return False\n      else:\n          # No specific workshop required, just perform a USE action (crafting by hand)\n          actions_taken.append(USE)\n          env.step(USE) # Update the environment state\n      \n      # 6. After attempting to craft, verify if the target item is now in inventory\n      return env._current_state.inventory[target_item_idx] > 0\n\n  # Start the recursive crafting process for the initial target item\n  _get_item_recursive(item)\n  \n  return actions_taken", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-25T13:38:28.042377", "function_name": "craft", "function_body": "    # --- Constants and Setup ---\n    # Action constants (assuming these are globally understood or part of the environment spec)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # The `env` passed here is a CraftLab instance.\n    # Its internal state is `env._current_state`.\n    # Its world configuration is `env.world`.\n    world = env.world\n    cookbook = world.cookbook\n\n    # --- Helper: Pathfinding BFS ---\n    def _find_path_to_kind(initial_state, target_kind_idx):\n        \"\"\"\n        Performs a BFS to find the shortest sequence of movement actions\n        to get 'next to' the target_kind_idx.\n        Returns a list of action integers, or None if no path is found.\n        \"\"\"\n        \n        q = deque([(initial_state, [])]) # (current_state_copy, actions_list)\n        \n        # Visited states: (position_tuple, direction_int)\n        # For pathfinding to static grid elements, inventory doesn't change via movement,\n        # so it's not needed in the visited set key.\n        visited = set([(initial_state.pos, initial_state.dir)]) \n        \n        while q:\n            current_simulated_state, path = q.popleft() # Use popleft for BFS\n\n            # Check if we are already next to the target kind\n            if current_simulated_state.next_to(target_kind_idx):\n                return path\n\n            # Explore possible moves (UP, DOWN, LEFT, RIGHT)\n            for action in [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]:\n                # CraftState.step returns a *new* state instance, which is what we need for BFS.\n                _, next_simulated_state = current_simulated_state.step(action) \n                \n                next_pos = next_simulated_state.pos\n                next_dir = next_simulated_state.dir\n                \n                state_key = (next_pos, next_dir)\n                \n                if state_key not in visited:\n                    visited.add(state_key)\n                    q.append((next_simulated_state, path + [action]))\n                    \n        return None # Path not found\n\n    # --- Helper: Recursive Crafting Planner ---\n    def _get_actions_to_craft_or_collect(current_simulated_state, target_item_idx):\n        \"\"\"\n        Recursively determines the actions needed to craft or collect a target_item_idx\n        starting from a given simulated state.\n        \n        Args:\n            current_simulated_state (CraftState): The state object to simulate actions on.\n                                                  This object should be a deepcopy before being passed\n                                                  to the initial call of this function, or any recursive call\n                                                  that might diverge (e.g., trying different ingredients).\n            target_item_idx (int): The index of the item to obtain.\n            \n        Returns:\n            tuple: (list_of_actions, resulting_simulated_state) if successful,\n                   or (None, None) if impossible to obtain the item.\n        \"\"\"\n\n        # Base case 1: If already have the item, no actions needed\n        if current_simulated_state.inventory[target_item_idx] > 0:\n            return [], current_simulated_state\n\n        all_actions_for_this_item = []\n        \n        # Check if it's a primitive item (can be collected directly)\n        if target_item_idx in cookbook.primitives:\n            # This is the \"COLLECT_FUNC\" logic from the DSL\n            \n            # First, check if the primitive item is actually present on the grid.\n            # If not present anywhere, it's impossible to collect.\n            if not np.any(current_simulated_state.grid[:, :, target_item_idx] > 0):\n                 return None, None # Primitive not present on map\n\n            path_actions = _find_path_to_kind(current_simulated_state, target_item_idx)\n            \n            if path_actions is None:\n                # Cannot find a path to the primitive\n                return None, None \n\n            for action in path_actions:\n                all_actions_for_this_item.append(action)\n                # Update the simulated state by applying the action\n                _, current_simulated_state = current_simulated_state.step(action)\n            \n            # Now, agent is next to the primitive. Perform USE action to collect it.\n            all_actions_for_this_item.append(ACTION_USE)\n            _, final_simulated_state = current_simulated_state.step(ACTION_USE)\n            \n            return all_actions_for_this_item, final_simulated_state\n            \n        # If not primitive, it must be craftable (or impossible)\n        recipe = cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            # Not primitive and no recipe, thus impossible to obtain\n            return None, None\n\n        # --- Handle crafting an item with a recipe ---\n        required_ingredients = recipe.copy()\n        \n        # Check for workshop requirement\n        workshop_key_idx = None\n        if \"_key\" in required_ingredients:\n            workshop_name = required_ingredients.pop(\"_key\")\n            # Convert workshop name string to its integer index\n            workshop_key_idx = cookbook.index.index(workshop_name)\n\n        # Recursively gather/craft all required ingredients\n        for ing_idx, count_needed in required_ingredients.items():\n            # Keep crafting/collecting this ingredient until we have enough\n            while current_simulated_state.inventory[ing_idx] < count_needed:\n                # IMPORTANT: Pass a deep copy of the current_simulated_state to the recursive call.\n                # This ensures that if the recursive call explores different paths (e.g., trying to get\n                # a sub-ingredient multiple ways or if its own sub-dependencies fail), it doesn't\n                # corrupt the state for other ingredient requirements or future attempts.\n                actions_for_ing, new_simulated_state = _get_actions_to_craft_or_collect(\n                    copy.deepcopy(current_simulated_state), \n                    ing_idx\n                )\n                \n                if actions_for_ing is None:\n                    # If this ingredient cannot be obtained, then the target item cannot be crafted.\n                    return None, None \n                \n                all_actions_for_this_item.extend(actions_for_ing)\n                # Update our current simulated state with the result of obtaining this ingredient\n                current_simulated_state = new_simulated_state \n\n        # After gathering all ingredients, move to workshop if needed\n        if workshop_key_idx is not None:\n            # Check if agent is already next to the required workshop\n            if not current_simulated_state.next_to(workshop_key_idx):\n                # Pathfind to the workshop\n                path_to_workshop = _find_path_to_kind(current_simulated_state, workshop_key_idx)\n                if path_to_workshop is None:\n                    # Cannot reach the workshop\n                    return None, None \n\n                all_actions_for_this_item.extend(path_to_workshop)\n                for action in path_to_workshop:\n                    # Apply movements to the simulated state\n                    _, current_simulated_state = current_simulated_state.step(action) \n\n        # Finally, perform the USE action to craft the item itself.\n        # This will consume the ingredients and add the crafted item to inventory in the simulated state.\n        all_actions_for_this_item.append(ACTION_USE)\n        _, final_simulated_state = current_simulated_state.step(ACTION_USE) \n\n        return all_actions_for_this_item, final_simulated_state\n\n    # --- Main `craft_v2` function execution ---\n    \n    # Start the planning process from a deep copy of the environment's current state.\n    # This ensures that the planning logic does not alter the actual environment state\n    # until the computed actions are applied externally.\n    initial_simulated_state = copy.deepcopy(env._current_state)\n\n    # Call the recursive planner to get the actions and the final simulated state.\n    # The final simulated state is not strictly needed for the return value of craft_v2,\n    # but it's returned by the helper for internal consistency.\n    final_actions, _ = _get_actions_to_craft_or_collect(initial_simulated_state, item)\n    \n    # If the planner returns None, it means the item cannot be crafted/collected.\n    if final_actions is None:\n        return [] # Return an empty list of actions for impossible goals\n    \n    return final_actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-25T13:41:02.309837", "function_name": "craft", "function_body": "  import numpy as np\n  import collections\n\n  # Define action constants based on CraftLab.action_specs()\n  ACTIONS = {\n      'DOWN': 0,\n      'UP': 1,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4,\n  }\n\n  # Define movement deltas for position updates\n  _DELTAS = {\n      ACTIONS['UP']: (-1, 0),\n      ACTIONS['DOWN']: (1, 0),\n      ACTIONS['LEFT']: (0, -1),\n      ACTIONS['RIGHT']: (0, 1),\n  }\n\n  # --- Helper functions for pathfinding and simulated state management ---\n\n  # Get grid dimensions and initial state details from the environment\n  WIDTH = env.scenario.init_grid.shape[0]\n  HEIGHT = env.scenario.init_grid.shape[1]\n  NON_GRABBABLE_INDICES = env.world.non_grabbable_indices\n  INITIAL_GRID = env.scenario.init_grid\n\n  def is_valid_pos(x, y):\n      \"\"\"Checks if a given (x, y) coordinate is within grid bounds.\"\"\"\n      return 0 <= x < WIDTH and 0 <= y < HEIGHT\n\n  def is_obstacle_at(x, y):\n      \"\"\"\n      Checks if a cell at (x, y) contains any non-grabbable item,\n      making it an obstacle for movement.\n      \"\"\"\n      if not is_valid_pos(x, y):\n          return True # Out of bounds is always an obstacle\n      \n      # Check if any non-grabbable item type is present at this cell\n      for kind_idx in NON_GRABBABLE_INDICES:\n          if INITIAL_GRID[x, y, kind_idx] > 0:\n              return True\n      return False\n\n  def get_final_pos_from_actions(start_pos, actions):\n      \"\"\"\n      Calculates the final position after applying a sequence of movement actions.\n      Ignores 'USE' actions for position calculation.\n      \"\"\"\n      curr_x, curr_y = start_pos\n      for action in actions:\n          if action in _DELTAS: # Only movement actions change position\n              dx, dy = _DELTAS[action]\n              curr_x, curr_y = curr_x + dx, curr_y + dy\n      return (curr_x, curr_y)\n\n  def find_path_and_use(start_pos, target_kind_idx):\n      \"\"\"\n      Performs a Breadth-First Search (BFS) to find a path from start_pos\n      to a cell adjacent to an instance of `target_kind_idx`, then appends a 'USE' action.\n      Returns the list of actions or None if no path is found.\n      \"\"\"\n      q = collections.deque([(start_pos, [])]) # (current_position, list_of_actions_to_reach_current_position)\n      visited = {start_pos}\n\n      while q:\n          (curr_x, curr_y), path_actions = q.popleft()\n\n          # Check if any adjacent cell to (curr_x, curr_y) contains the target_kind_idx\n          # The agent needs to be adjacent to the target to 'USE' it.\n          for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # 4 cardinal directions\n              target_x, target_y = curr_x + dx_adj, curr_y + dy_adj\n              \n              if is_valid_pos(target_x, target_y) and \\\n                 INITIAL_GRID[target_x, target_y, target_kind_idx] > 0:\n                  # Found a cell (target_x, target_y) containing target_kind_idx that is adjacent to (curr_x, curr_y).\n                  # The agent is at (curr_x, curr_y), so it is \"next to\" the target.\n                  return path_actions + [ACTIONS['USE']]\n\n          # Explore valid neighboring cells (move actions)\n          for dx, dy, action in [(-1, 0, ACTIONS['UP']), (1, 0, ACTIONS['DOWN']), \n                                 (0, -1, ACTIONS['LEFT']), (0, 1, ACTIONS['RIGHT'])]:\n              next_x, next_y = curr_x + dx, curr_y + dy\n              if is_valid_pos(next_x, next_y) and \\\n                 (next_x, next_y) not in visited and \\\n                 not is_obstacle_at(next_x, next_y):\n                  visited.add((next_x, next_y))\n                  q.append(((next_x, next_y), path_actions + [action]))\n      \n      return None # No path found to be adjacent to target_kind_idx\n\n  # --- Main crafting logic ---\n\n  all_actions = [] # This list will accumulate all planned actions\n  \n  # Initialize a simulated inventory and position for planning purposes.\n  # This simulated state helps the planner determine required ingredients and\n  # current agent location *during planning*, without affecting the actual environment state.\n  simulated_inventory = np.zeros(env.world.cookbook.n_kinds, dtype=int)\n  simulated_pos = env.scenario.init_pos\n  \n  # Recursive helper function to plan how to obtain a single unit of an item.\n  # Returns True if the item was successfully planned for, False otherwise.\n  def plan_obtain_item(item_idx):\n      nonlocal simulated_inventory, simulated_pos, all_actions\n      \n      # Base case: If the item is a primitive resource\n      if item_idx in env.world.cookbook.primitives:\n          # Plan actions to move to and 'USE' the primitive\n          path_and_use_actions = find_path_and_use(simulated_pos, item_idx)\n          if path_and_use_actions is None:\n              # Primitive is unreachable or not on the initial grid.\n              return False # Cannot obtain this item\n          \n          all_actions.extend(path_and_use_actions)\n          # Update simulated position after movement actions (before the 'USE')\n          simulated_pos = get_final_pos_from_actions(simulated_pos, path_and_use_actions[:-1])\n          simulated_inventory[item_idx] += 1 # Assume 1 unit is collected per 'USE'\n          return True\n          \n      else: # If the item is a crafted item (not a primitive)\n          recipe = env.world.cookbook.recipes.get(item_idx)\n          if recipe is None:\n              # Item is neither primitive nor craftable via a known recipe.\n              return False # Cannot obtain this item\n\n          # Recursively plan to obtain all required ingredients for this recipe\n          ingredients_needed_counts = {k: v for k, v in recipe.items() if k != \"_key\"} # Exclude \"_key\" which specifies workshop\n          \n          for ingredient_idx, count in ingredients_needed_counts.items():\n              while simulated_inventory[ingredient_idx] < count:\n                  # Attempt to obtain one unit of the missing ingredient\n                  if not plan_obtain_item(ingredient_idx):\n                      # If an ingredient cannot be obtained, this crafting path is blocked.\n                      return False\n\n          # Once all ingredients are in the simulated inventory, plan to craft the item\n          \n          # Determine the specific workshop needed for this recipe (if any)\n          required_workshop_name = recipe.get(\"_key\")\n          required_workshop_idx = None\n          if required_workshop_name:\n              required_workshop_idx = env.world.cookbook.index[required_workshop_name]\n          elif env.world.workshop_indices:\n              # If no specific workshop is indicated by \"_key\", use the first available workshop type as a default\n              required_workshop_idx = env.world.workshop_indices[0]\n          \n          # If a workshop is required (either specified or a default was found)\n          if required_workshop_idx is not None:\n              path_to_workshop_and_use = find_path_and_use(simulated_pos, required_workshop_idx)\n              if path_to_workshop_and_use is None:\n                  # The required workshop is unreachable.\n                  return False # Cannot craft this item\n              \n              all_actions.extend(path_to_workshop_and_use)\n              # Update simulated position after movement actions (before the 'USE')\n              simulated_pos = get_final_pos_from_actions(simulated_pos, path_to_workshop_and_use[:-1])\n          \n          # Consume ingredients from the simulated inventory\n          for ingredient_idx, count in ingredients_needed_counts.items():\n              simulated_inventory[ingredient_idx] -= count\n          \n          # Add the newly crafted item to the simulated inventory\n          simulated_inventory[item_idx] += 1 # Assume 1 unit is crafted per 'USE' at workshop\n          return True\n            \n  # Start the planning process for the target item.\n  # We assume the goal is to obtain at least one instance of the `item`.\n  if not plan_obtain_item(item):\n      # If the entire crafting plan could not be fulfilled (e.g., due to unreachable resources),\n      # return an empty list of actions.\n      return []\n\n  return all_actions", "island_id": 5, "scores": {"3": -1}}
