{"timestamp": "2025-07-25T14:37:24.515745", "function_name": "craft", "function_body": "    import numpy as np\n    import collections\n\n    # Define action constants (from CraftLab.action_specs)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper functions nested inside craft_v2\n    def _get_item_idx_by_name(env_world, name):\n        \"\"\"Helper to get an item index from its string name.\"\"\"\n        return env_world.cookbook.index[name]\n\n    def _get_item_name_by_idx(env_world, idx):\n        \"\"\"Helper to get an item name from its index.\"\"\"\n        return env_world.cookbook.index.get(idx)\n\n    def _is_primitive(env_world, item_idx):\n        \"\"\"Check if an item is a primitive resource.\"\"\"\n        return item_idx in env_world.cookbook.primitives\n\n    def _get_recipe(env_world, item_idx):\n        \"\"\"Get the recipe for an item.\"\"\"\n        return env_world.cookbook.recipes.get(item_idx)\n\n    def _get_required_workshop_idx(env_world, item_idx):\n        \"\"\"Determine the workshop required for an item (if any).\"\"\"\n        recipe = _get_recipe(env_world, item_idx)\n        if recipe and \"_key\" in recipe:\n            workshop_name = recipe[\"_key\"]\n            return _get_item_idx_by_name(env_world, workshop_name)\n        return None\n\n    def _get_actions_to_move_next_to_target(initial_state, target_kind_idx):\n        \"\"\"\n        Finds a path using BFS from initial_state.pos to a cell adjacent to target_kind_idx\n        and returns the sequence of actions.\n        Returns (actions_list, final_simulated_state)\n        \"\"\"\n        q = collections.deque([(initial_state, [])]) # (current_sim_state, actions_to_reach_here)\n        # Visited set stores (position, direction) to avoid cycles and redundant paths\n        visited = set([(initial_state.pos, initial_state.dir)])\n\n        while q:\n            curr_s, curr_actions = q.popleft()\n\n            # Check if already adjacent to target in current simulated state\n            if curr_s.next_to(target_kind_idx):\n                return curr_actions, curr_s\n\n            # Explore possible moves (UP, DOWN, LEFT, RIGHT)\n            for action in [UP, DOWN, LEFT, RIGHT]:\n                # Simulate the action: get the next state.\n                # CraftState.step returns a *new* CraftState instance,\n                # which is crucial for simulating without modifying the original state.\n                _, next_s = curr_s.step(action) \n                \n                # Check if this new state has been visited\n                if (next_s.pos, next_s.dir) not in visited:\n                    visited.add((next_s.pos, next_s.dir))\n                    q.append((next_s, curr_actions + [action]))\n                    \n        return [], initial_state # No path found\n\n    # This is the core recursive planner function to obtain a single unit of an item.\n    def _plan_to_obtain_single_unit(current_sim_state, item_idx_to_obtain, depth=0, max_depth=15):\n        \"\"\"\n        Recursively plans actions to obtain one unit of a specified item.\n        Returns (list of actions, final_simulated_state after obtaining item).\n        \"\"\"\n        # Prevent infinite recursion for impossible items or deeply nested dependencies.\n        if depth > max_depth:\n            return [], current_sim_state\n\n        all_actions = []\n        initial_inventory_count = current_sim_state.inventory[item_idx_to_obtain]\n\n        # Case 1: Item is a primitive resource (must be collected/grabbed)\n        if _is_primitive(current_sim_state.world, item_idx_to_obtain):\n            # Plan actions to move to a cell adjacent to the primitive\n            move_actions, state_after_move = _get_actions_to_move_next_to_target(current_sim_state, item_idx_to_obtain)\n            all_actions.extend(move_actions)\n            current_sim_state = state_after_move\n\n            # Perform the USE action to try and collect it\n            _, state_after_use = current_sim_state.step(USE)\n            \n            # Check if USE action was successful in acquiring the primitive\n            if state_after_use.inventory[item_idx_to_obtain] > initial_inventory_count:\n                all_actions.append(USE)\n                return all_actions, state_after_use\n            else:\n                # Failed to pick up (e.g., nothing there, or non-grabbable/depleted, or not truly 'next to' a grabbable instance)\n                return [], current_sim_state # Cannot acquire this primitive\n\n        # Case 2: Item is craftable (not primitive)\n        recipe = _get_recipe(current_sim_state.world, item_idx_to_obtain)\n        if not recipe:\n            # No recipe found for this item, so it cannot be crafted.\n            return [], current_sim_state\n\n        ingredients_to_obtain = {}\n        for ing_idx_str, count in recipe.items():\n            if ing_idx_str == \"_key\": # This key specifies the required workshop\n                continue\n            ing_idx = int(ing_idx_str)\n            ingredients_to_obtain[ing_idx] = count\n\n        # Recursively obtain all required ingredients\n        for ing_idx, required_count in ingredients_to_obtain.items():\n            # Keep trying to get units of this ingredient until the required count is met\n            while current_sim_state.inventory[ing_idx] < required_count:\n                # Recursively call to obtain one more unit of the ingredient\n                actions_to_get_one_ing, state_after_getting_one = _plan_to_obtain_single_unit(\n                    current_sim_state, ing_idx, depth + 1, max_depth)\n                \n                # If no actions were found or no inventory gain occurred for the ingredient,\n                # it means this ingredient cannot be obtained, thus the main item cannot be crafted.\n                if not actions_to_get_one_ing and state_after_getting_one.inventory[ing_idx] <= current_sim_state.inventory[ing_idx]:\n                    return [], current_sim_state # Cannot obtain required ingredient\n                \n                all_actions.extend(actions_to_get_one_ing)\n                current_sim_state = state_after_getting_one # Update current state for subsequent steps\n\n        # All ingredients have been obtained. Now, move to the crafting workshop (if any) and craft.\n        required_workshop_idx = _get_required_workshop_idx(current_sim_state.world, item_idx_to_obtain)\n\n        if required_workshop_idx:\n            # Plan actions to move to a cell adjacent to the required workshop\n            move_actions, state_after_move = _get_actions_to_move_next_to_target(current_sim_state, required_workshop_idx)\n            all_actions.extend(move_actions)\n            current_sim_state = state_after_move\n\n        # Perform the USE action to try and craft the item\n        _, state_after_use = current_sim_state.step(USE)\n        \n        # Check if crafting was successful (inventory increased for the target item)\n        if state_after_use.inventory[item_idx_to_obtain] > initial_inventory_count:\n            all_actions.append(USE)\n            return all_actions, state_after_use\n        else:\n            # Crafting failed (e.g., still not enough ingredients, or not next to the correct workshop, etc.)\n            return [], current_sim_state\n\n    # --- Main logic of craft_v2 function ---\n\n    # Initialize the current simulated state from the environment's current state.\n    # This state will be passed around and modified (copied) by the planner functions.\n    initial_sim_state = env._current_state\n\n    # If the target item is already present in the initial inventory, no actions are needed.\n    if initial_sim_state.inventory[item] > 0:\n        return []\n\n    # Call the recursive planner to obtain one unit of the target item.\n    actions_to_craft, final_sim_state = _plan_to_obtain_single_unit(initial_sim_state, item)\n\n    # After the planning is complete, verify if the item was successfully crafted in the simulation.\n    if final_sim_state.inventory[item] > initial_sim_state.inventory[item]:\n        return actions_to_craft\n    else:\n        # If the item was not successfully crafted (e.g., due to impossible recipe, missing resources),\n        # return an empty list of actions.\n        return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:37:26.037510", "function_name": "craft", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:40:01.659175", "function_name": "craft", "function_body": "  import collections # Need to import collections for deque\n\n  # BFS implementation for planning actions to craft the target item.\n\n  start_state = env._current_state\n  \n  # Action mapping from CraftLab.action_specs to integer IDs.\n  # These are constant across the environment.\n  ACTION_IDS = {\n      'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4\n  }\n\n  # Queue for BFS: stores tuples of (current_CraftState, list_of_actions_to_reach_this_state).\n  # We start with the initial state and an empty path.\n  q = collections.deque([(start_state, [])])\n\n  # Visited set: stores hashable representations of states to avoid cycles and redundant work.\n  # A state is uniquely defined by (agent's position, agent's direction, agent's inventory).\n  # Inventory is a numpy array, so convert it to a tuple to make it hashable for the set.\n  visited = set()\n\n  # Helper function to get a hashable key for a CraftState object.\n  def get_state_key(state):\n      return (state.pos, state.dir, tuple(state.inventory))\n\n  # Pre-check: If the target item is already in the initial inventory, no actions are needed.\n  if start_state.satisfies(None, item):\n      return []\n\n  # Maximum steps for the BFS search to prevent excessively long paths or infinite loops.\n  # This value might need tuning based on the complexity of recipes and map layouts.\n  # A reasonable upper bound is chosen to ensure the search terminates in a practical timeframe.\n  MAX_PLANNING_STEPS = 200 \n\n  # Start the BFS search\n  while q:\n      current_state, path_so_far = q.popleft()\n\n      # Pruning: If the current path exceeds the maximum allowed planning steps,\n      # stop exploring this branch to avoid excessively long computation times.\n      if len(path_so_far) >= MAX_PLANNING_STEPS:\n          continue\n\n      # Get the hashable key for the current state.\n      state_key = get_state_key(current_state)\n\n      # If this state has already been visited (with the same position, direction, and inventory),\n      # skip it to prevent redundant exploration and cycles.\n      if state_key in visited:\n          continue\n      # Mark the current state as visited.\n      visited.add(state_key)\n\n      # Explore all possible actions from the current state.\n      for action_id in ACTION_IDS.values():\n          # Simulate taking the action using the CraftState's step method.\n          # The step method returns (reward, new_state).\n          # In this CraftState implementation, reward is always 0.0 for step,\n          # and we are interested in the `new_state`.\n          _, next_state = current_state.step(action_id)\n          \n          # Create a new path by appending the current action to the path that led to `current_state`.\n          new_path = path_so_far + [action_id]\n\n          # Check if the target item is satisfied (i.e., crafted and in inventory) in the `next_state`.\n          if next_state.satisfies(None, item):\n              return new_path # Found a path to craft the item! Return the sequence of actions.\n\n          # If the goal is not yet satisfied, and the `next_state` has not been visited before,\n          # add it to the queue for further exploration.\n          next_state_key = get_state_key(next_state)\n          if next_state_key not in visited: \n              q.append((next_state, new_path))\n  \n  # If the queue becomes empty and the target item was not crafted,\n  # it means no path was found within the defined search limits.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:40:02.897870", "function_name": "craft", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:43:11.041644", "function_name": "craft", "function_body": "  # Constants for actions\n  # These are typically globally available in the environment setup\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  class PlanningState:\n      \"\"\"A simplified state representation for planning purposes.\"\"\"\n      def __init__(self, initial_grid, initial_pos, initial_dir, n_kinds, cookbook):\n          self.grid = np.copy(initial_grid)\n          self.pos = initial_pos\n          self.dir = initial_dir\n          self.inventory = np.zeros(n_kinds, dtype=np.int32)\n          self.width, self.height, _ = initial_grid.shape\n          self.cookbook = cookbook # Reference to the Cookbook for checking impassable kinds\n\n      def _get_neighbor_pos(self, action):\n          r, c = self.pos\n          if action == UP: return (r, c - 1)\n          elif action == DOWN: return (r, c + 1)\n          elif action == LEFT: return (r - 1, c)\n          elif action == RIGHT: return (r + 1, c)\n          return self.pos\n\n      def _is_valid_grid_pos(self, r, c):\n          return 0 <= r < self.width and 0 <= c < self.height\n\n      def simulate_move_step(self, action: int) -> 'PlanningState':\n          \"\"\"Simulates the effect of a movement action.\"\"\"\n          new_state = PlanningState(self.grid, self.pos, self.dir, self.inventory.shape[0], self.cookbook)\n          new_state.inventory = np.copy(self.inventory) # Carry over inventory\n\n          if action in [UP, DOWN, LEFT, RIGHT]:\n              new_pos = new_state._get_neighbor_pos(action)\n              \n              if new_state._is_valid_grid_pos(new_pos[0], new_pos[1]):\n                  # Check passability of the new cell\n                  is_passable = True\n                  boundary_idx = self.cookbook.index.get(\"boundary\")\n                  water_idx = self.cookbook.index.get(\"water\")\n                  bridge_idx = self.cookbook.index.get(\"bridge\") # Assuming 'bridge' is an item ID in cookbook.index\n\n                  for k_idx_at_next_cell in range(self.grid.shape[2]):\n                      if self.grid[new_pos[0], new_pos[1], k_idx_at_next_cell] == 1:\n                          if k_idx_at_next_cell == boundary_idx:\n                              is_passable = False\n                              break\n                          if k_idx_at_next_cell == water_idx:\n                              # Water is passable if agent has a bridge\n                              if new_state.inventory[bridge_idx] == 0:\n                                  is_passable = False\n                                  break\n                  \n                  if is_passable:\n                      new_state.pos = new_pos\n                      new_state.dir = action\n          return new_state\n\n  def _find_path_and_actions(start_pos: tuple, target_kind_idx: int, current_p_state: PlanningState) -> (list[int], tuple):\n      \"\"\"\n      Performs a BFS to find the nearest cell containing `target_kind_idx`\n      and returns the path as a list of actions and the target cell position.\n      This BFS is sensitive to the PlanningState's inventory (e.g., for crossing water).\n      Returns (list_of_actions, target_cell_pos) or ([], None) if not found.\n      \"\"\"\n      q = collections.deque([(start_pos, [])]) # (current_pos, path_actions)\n      visited = {start_pos}\n\n      moves_and_actions = [\n          ((0, -1), UP),\n          ((0, 1), DOWN),\n          ((-1, 0), LEFT),\n          ((1, 0), RIGHT),\n      ]\n\n      grid = current_p_state.grid\n      cookbook = current_p_state.cookbook\n      inventory = current_p_state.inventory\n\n      while q:\n          (r, c), path_actions = q.popleft()\n\n          # Check if the current cell contains the target kind\n          if grid[r, c, target_kind_idx] == 1:\n              return path_actions, (r, c)\n\n          # Explore neighbors\n          for (dr, dc), action in moves_and_actions:\n              nr, nc = r + dr, c + dc\n              \n              if not current_p_state._is_valid_grid_pos(nr, nc):\n                  continue # Out of bounds\n\n              if (nr, nc) in visited:\n                  continue # Already visited\n\n              # Check passability of the new cell\n              is_passable = True\n              boundary_idx = cookbook.index.get(\"boundary\")\n              water_idx = cookbook.index.get(\"water\")\n              bridge_idx = cookbook.index.get(\"bridge\")\n              \n              for k_idx_at_next_cell in range(grid.shape[2]):\n                  if grid[nr, nc, k_idx_at_next_cell] == 1:\n                      if k_idx_at_next_cell == boundary_idx:\n                          is_passable = False\n                          break\n                      if k_idx_at_next_cell == water_idx:\n                          if inventory[bridge_idx] == 0: # Only impassable if no bridge in inventory\n                              is_passable = False\n                              break\n              \n              if is_passable:\n                  visited.add((nr, nc))\n                  q.append(((nr, nc), path_actions + [action]))\n\n      return [], None # Target kind not found\n\n  # Recursive helper to gather resources and craft items\n  # It returns actions needed *and* updates the planning state\n  def _gather_and_craft(goal_item_idx: int, current_p_state: PlanningState) -> (list[int], PlanningState):\n      actions_for_subgoal = []\n\n      # Base case: item is already available in current planning state's inventory\n      if current_p_state.inventory[goal_item_idx] > 0:\n          return actions_for_subgoal, current_p_state\n\n      recipe = current_p_state.cookbook.recipes.get(goal_item_idx)\n\n      if recipe: # It's a craftable item\n          ingredients_to_get = collections.defaultdict(int)\n          for ing_key, count in recipe.items():\n              if ing_key == \"_key\": continue\n              ingredients_to_get[ing_key] += count\n\n          for ing_idx, required_count in ingredients_to_get.items():\n              while current_p_state.inventory[ing_idx] < required_count:\n                  # Determine if ingredient is primitive or craftable\n                  if ing_idx in current_p_state.cookbook.primitives:\n                      # Collect primitive\n                      path_to_primitive_actions, primitive_pos_on_grid = _find_path_and_actions(\n                          current_p_state.pos, ing_idx, current_p_state\n                      )\n                      \n                      if not primitive_pos_on_grid:\n                          # Cannot find primitive, propagate failure.\n                          return [], current_p_state\n                      \n                      # Add actions to move to the primitive\n                      for action in path_to_primitive_actions:\n                          actions_for_subgoal.append(action)\n                          current_p_state = current_p_state.simulate_move_step(action)\n\n                      # Perform USE to collect\n                      actions_for_subgoal.append(USE)\n                      # Manually update planning state: add item to inventory, remove from grid\n                      current_p_state.inventory[ing_idx] += 1\n                      current_p_state.grid[primitive_pos_on_grid[0], primitive_pos_on_grid[1], ing_idx] = 0\n\n                  else:\n                      # Craft ingredient recursively\n                      ing_actions, current_p_state = _gather_and_craft(ing_idx, current_p_state)\n                      actions_for_subgoal.extend(ing_actions)\n                      \n                      # If after recursion, we still don't have enough, it means it failed to craft a sub-ingredient.\n                      if current_p_state.inventory[ing_idx] < required_count:\n                          return [], current_p_state # Propagate failure\n\n          # All ingredients collected/crafted for goal_item_idx\n          # Now, perform the actual craft action at a workshop if needed\n          \n          workshop_idx = None\n          if \"_key\" in recipe:\n              workshop_name = recipe[\"_key\"]\n              workshop_idx = current_p_state.cookbook.index[workshop_name]\n\n          if workshop_idx is not None:\n              # Move to the workshop\n              path_to_workshop_actions, workshop_pos_on_grid = _find_path_and_actions(\n                  current_p_state.pos, workshop_idx, current_p_state\n              )\n              if not workshop_pos_on_grid:\n                  return [], current_p_state # Failed to find workshop\n\n              for action in path_to_workshop_actions:\n                  actions_for_subgoal.append(action)\n                  current_p_state = current_p_state.simulate_move_step(action)\n\n          # Perform USE action to craft the goal_item_idx\n          actions_for_subgoal.append(USE)\n          \n          # Manually simulate the USE for crafting on the planning state\n          # Consume ingredients\n          for ing_key, count in recipe.items():\n              if ing_key == \"_key\": continue\n              current_p_state.inventory[ing_key] -= count\n          # Produce item\n          current_p_state.inventory[goal_item_idx] += 1\n\n      else: # Item is not craftable. If it's not a primitive, it's an invalid goal for 'craft'.\n          # This case indicates an invalid or unresolvable goal for the 'craft' function,\n          # as it should only be called for craftable items or recursively for their primitive ingredients.\n          if goal_item_idx not in current_p_state.cookbook.primitives: \n              # print(f\"Warning: Goal item {current_p_state.cookbook.index.get(goal_item_idx)} is neither craftable nor a known primitive.\")\n              return [], current_p_state\n\n      return actions_for_subgoal, current_p_state\n\n  # Initialize a planning state based on the scenario's initial conditions\n  initial_grid = env.scenario.init_grid\n  initial_pos = env.scenario.init_pos\n  initial_dir = env.scenario.init_dir \n\n  current_planning_state = PlanningState(initial_grid, initial_pos, initial_dir, \n                                         env.world.cookbook.n_kinds, env.world.cookbook)\n\n  # Start the recursive crafting process for the main goal item\n  final_actions, _ = _gather_and_craft(item_idx, current_planning_state)\n  return final_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:43:11.059341", "function_name": "craft", "function_body": "    # Initialize action mappings\n    action_map = env.action_specs()\n    UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n    # Helper class for internal state simulation\n    class SimulatedState:\n        def __init__(self, grid, pos, inventory):\n            self.grid = grid.copy()\n            self.pos = pos\n            self.inventory = inventory.copy()\n\n        # Simplistic movement logic for simulation.\n        # Only updates position for pathfinding, without affecting direction or complex USE effects.\n        def apply_move_action(self, action, world):\n            new_r, new_c = self.pos\n            \n            dr, dc = 0, 0\n            if action == UP: dr = -1\n            elif action == DOWN: dr = 1\n            elif action == LEFT: dc = -1\n            elif action == RIGHT: dc = 1\n            \n            next_r, next_c = new_r + dr, new_c + dc\n            \n            grid_height, grid_width, n_kinds = self.grid.shape\n\n            # Check boundaries\n            if 0 <= next_r < grid_height and 0 <= next_c < grid_width:\n                # Check for non-grabbable obstructions (e.g., water, boundary)\n                is_blocked = False\n                for kind_idx in world.non_grabbable_indices:\n                    if self.grid[next_r, next_c, kind_idx] > 0:\n                        is_blocked = True\n                        break\n                \n                if not is_blocked:\n                    self.pos = (next_r, next_c)\n    \n    # Pathfinding BFS helper\n    # Returns a list of actions (UP/DOWN/LEFT/RIGHT) to reach a cell *adjacent* to the target_kind_idx.\n    # Also returns the specific (row, col) of the found item on the grid.\n    # It finds the closest available instance of the target_kind_idx.\n    def _find_path_to_kind(sim_state: SimulatedState, world, target_kind_idx: int) -> tuple[list[int], tuple[int, int]]:\n        q = collections.deque()\n        q.append((sim_state.pos, []))  # (current_pos, list_of_actions)\n        visited = {sim_state.pos}\n\n        grid_height, grid_width, _ = sim_state.grid.shape\n        \n        # Precompute neighbor offsets for BFS\n        # (dr, dc, action)\n        moves_list = [\n            (-1, 0, UP),  # Up\n            (1, 0, DOWN), # Down\n            (0, -1, LEFT),# Left\n            (0, 1, RIGHT) # Right\n        ]\n\n        target_item_location = None\n\n        while q:\n            (r, c), path_actions = q.popleft()\n\n            # Check 3x3 neighborhood around current (r, c) for the target_kind_idx.\n            # The agent needs to be adjacent to the item/workshop to `USE` it.\n            for dr_adj in [-1, 0, 1]:\n                for dc_adj in [-1, 0, 1]:\n                    item_r, item_c = r + dr_adj, c + dc_adj\n                    if 0 <= item_r < grid_height and 0 <= item_c < grid_width:\n                        # Check if this cell contains the target kind and if its count is > 0\n                        if sim_state.grid[item_r, item_c, target_kind_idx] > 0:\n                            target_item_location = (item_r, item_c)\n                            # Path found: path_actions leads to (r,c), which is adjacent to (item_r, item_c)\n                            return path_actions, target_item_location\n\n            # Explore neighbors\n            for dr, dc, action in moves_list:\n                nr, nc = r + dr, c + dc\n                if (0 <= nr < grid_height and 0 <= nc < grid_width and (nr, nc) not in visited):\n                    # Check if the next cell is blocked (non-grabbable like water/boundary)\n                    is_blocked = False\n                    for kind_idx in world.non_grabbable_indices:\n                        if sim_state.grid[nr, nc, kind_idx] > 0:\n                            is_blocked = True\n                            break\n                    \n                    if not is_blocked:\n                        visited.add((nr, nc))\n                        q.append(((nr, nc), path_actions + [action]))\n        \n        return [], None # Path not found, or item not found on grid\n\n    # Core Crafting Logic: `_craft_recursive`\n    # This function plans the actions to obtain `target_item_idx` and updates the `sim_state` accordingly.\n    # `visited_items` is used to prevent infinite recursion in case of circular dependencies.\n    def _craft_recursive(target_item_idx: int, sim_state: SimulatedState, visited_items: set) -> list[int]:\n        current_actions = []\n        cookbook = env.world.cookbook\n        world = env.world\n\n        # Base case 1: item is already in simulated inventory\n        if sim_state.inventory[target_item_idx] > 0:\n            return []\n\n        # Base case 2: Prevent infinite recursion. If we are already trying to craft this item upstream,\n        # it means there's a circular dependency or an unresolvable path.\n        if target_item_idx in visited_items:\n            return []\n\n        # Add to visited set to mark as currently being processed\n        visited_items.add(target_item_idx)\n\n        recipe = cookbook.recipes.get(target_item_idx)\n\n        # Case 1: Item is a primitive (no recipe)\n        if recipe is None:\n            # Check if it's a known primitive. If not, it's an uncraftable/uncollectable item.\n            if target_item_idx not in cookbook.primitives:\n                visited_items.remove(target_item_idx)\n                return [] # Cannot obtain this item\n\n            # Collect primitive:\n            # 1. Find the item on the grid (closest available instance).\n            # 2. Pathfind to a position adjacent to it.\n            # 3. Add USE action.\n            \n            path_to_item_adj, item_actual_location = _find_path_to_kind(sim_state, world, target_item_idx)\n            \n            if item_actual_location is None:\n                # Cannot find item on grid (e.g., all instances already collected in simulation)\n                visited_items.remove(target_item_idx)\n                return [] # Indicate failure to collect\n\n            # Add pathfinding actions to the plan\n            current_actions.extend(path_to_item_adj)\n            # Update simulated agent position after pathfinding steps\n            for action in path_to_item_adj:\n                sim_state.apply_move_action(action, world)\n\n            # Now agent is adjacent to `item_actual_location`. Add USE action.\n            current_actions.append(USE)\n            \n            # Update simulated inventory: +1 for collected item\n            sim_state.inventory[target_item_idx] += 1\n            \n            # Simulate consumption: decrement item count at the specific location on the grid.\n            # This is crucial for collecting multiple of the same primitive.\n            sim_state.grid[item_actual_location[0], item_actual_location[1], target_item_idx] -= 1\n            \n            # Remove from visited set as this item is now handled\n            visited_items.remove(target_item_idx)\n            return current_actions\n        \n        # Case 2: Item is craftable (has a recipe)\n        \n        # Recursively craft/collect all required ingredients\n        for ingredient_idx_str, count in recipe.items():\n            if ingredient_idx_str == \"_key\": # This is for workshop type\n                continue\n            \n            ingredient_idx = int(ingredient_idx_str)\n            \n            # Determine how many of this ingredient are missing from simulated inventory\n            missing_count = count - sim_state.inventory[ingredient_idx]\n            \n            for _ in range(missing_count):\n                # Recursively call _craft_recursive for each missing instance\n                ingredient_actions = _craft_recursive(ingredient_idx, sim_state, visited_items)\n                current_actions.extend(ingredient_actions)\n                \n                # After the recursive call, check if the ingredient was successfully obtained.\n                # If not, this crafting path is impossible.\n                if sim_state.inventory[ingredient_idx] < count:\n                    visited_items.remove(target_item_idx)\n                    return [] # Indicate failure to craft\n        \n        # All ingredients are (theoretically) in simulated inventory. Now perform the craft.\n        \n        # Consume ingredients from simulated inventory\n        for ingredient_idx_str, count in recipe.items():\n            if ingredient_idx_str == \"_key\":\n                continue\n            ingredient_idx = int(ingredient_idx_str)\n            sim_state.inventory[ingredient_idx] -= count\n\n        # Determine required workshop and move to it if necessary\n        workshop_name = recipe.get(\"_key\")\n        workshop_idx = None\n        if workshop_name:\n            workshop_idx = cookbook.index[workshop_name]\n\n        if workshop_idx is not None:\n            # Find path to a cell adjacent to the workshop. Workshops are stationary and not consumed.\n            path_to_workshop_adj, _ = _find_path_to_kind(sim_state, world, workshop_idx)\n            \n            if not path_to_workshop_adj:\n                # If path_to_workshop_adj is empty, it means agent is already adjacent to the workshop.\n                # Otherwise, it means no path could be found (e.g., workshop not on grid).\n                # We assume if the path is empty, agent is already in position.\n                # A more robust check might be `sim_state.next_to(workshop_idx)` if it were implemented for SimulatedState.\n                # For simplicity, if path_to_workshop_adj is empty AND workshop_idx is needed, assume already adjacent.\n                # If workshop is needed and not found, this branch fails.\n                # It would only be None if the workshop does not exist on the map.\n                \n                # Check if current position is already adjacent to a workshop\n                is_adjacent_to_workshop = False\n                current_r, current_c = sim_state.pos\n                grid_height, grid_width, _ = sim_state.grid.shape\n                for dr_adj in [-1, 0, 1]:\n                    for dc_adj in [-1, 0, 1]:\n                        adj_r, adj_c = current_r + dr_adj, current_c + dc_adj\n                        if 0 <= adj_r < grid_height and 0 <= adj_c < grid_width:\n                            if sim_state.grid[adj_r, adj_c, workshop_idx] > 0:\n                                is_adjacent_to_workshop = True\n                                break\n                    if is_adjacent_to_workshop:\n                        break\n                \n                if not is_adjacent_to_workshop: # Workshop is needed but agent is not adjacent and no path found\n                    visited_items.remove(target_item_idx)\n                    return [] # Indicate failure (cannot reach workshop)\n\n            else: # Path was found, so add movement actions\n                current_actions.extend(path_to_workshop_adj)\n                # Update simulated agent position\n                for action in path_to_workshop_adj:\n                    sim_state.apply_move_action(action, world)\n\n        # Perform USE action for crafting\n        current_actions.append(USE)\n        \n        # Update simulated inventory: +1 for crafted item\n        sim_state.inventory[target_item_idx] += 1\n\n        # Remove from visited set\n        visited_items.remove(target_item_idx)\n        return current_actions\n\n    # --- Start of craft_v2 main execution ---\n\n    # Initialize a mutable simulated state based on the current actual environment state.\n    initial_state = env._current_state\n    simulated_initial_state = SimulatedState(initial_state.grid, initial_state.pos, initial_state.inventory)\n    \n    # Start the recursive crafting process.\n    # The `visited_items` set tracks items in the current recursion stack to prevent cycles.\n    final_actions = _craft_recursive(item, simulated_initial_state, set())\n\n    return final_actions", "island_id": 6, "scores": {"3": -1}}
