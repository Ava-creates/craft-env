{"timestamp": "2025-07-25T15:18:57.371771", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Delta (dx, dy) for each action (where x is column, y is row)\n  ACTION_DELTAS = {\n      DOWN: (0, 1),   # dy increases (move down)\n      UP: (0, -1),  # dy decreases (move up)\n      LEFT: (-1, 0),  # dx decreases (move left)\n      RIGHT: (1, 0),   # dx increases (move right)\n  }\n\n  actions_to_take = []\n  state = env._current_state\n  cookbook = env.world.cookbook\n\n  recipe = cookbook.recipes.get(item)\n  \n  # A craftable item must have a recipe. If not found, cannot craft.\n  if not recipe:\n      return []\n\n  # Crafted items typically require a specific workshop, identified by '_key' in the recipe.\n  required_workshop_idx = recipe.get('_key')\n  \n  # If there's no specified workshop, it's either an uncraftable item,\n  # or not crafted via the standard 'USE' action next to a workshop.\n  # Given the problem context for CRAFT_FUNC, we assume a workshop is always required if an item is truly craftable.\n  if required_workshop_idx is None:\n      return [] # Cannot craft without a specified workshop.\n\n  # Check if the agent is already adjacent to the required workshop\n  if state.next_to(required_workshop_idx):\n      actions_to_take.append(USE) # Perform USE action to craft\n      return actions_to_take\n  \n  # If not adjacent, we need to find the workshop and path to it.\n  grid = state.grid\n  width, height, _ = grid.shape # grid.shape is (WIDTH, HEIGHT, n_kinds)\n\n  # Find all locations on the grid where the required workshop is present\n  workshop_locations = []\n  for x in range(width):\n      for y in range(height):\n          if grid[x, y, required_workshop_idx] == 1:\n              workshop_locations.append((x, y))\n\n  if not workshop_locations:\n      # Workshop not found anywhere on the map. Cannot craft.\n      return []\n\n  start_pos_x, start_pos_y = state.pos\n  \n  # Initialize BFS queue with starting position and empty path\n  q = collections.deque([(start_pos_x, start_pos_y, [])]) # (current_x, current_y, list_of_actions_taken)\n  visited = {(start_pos_x, start_pos_y)} # Keep track of visited cells to avoid loops and redundant paths\n\n  # Get indices for common non-traversable elements (like boundary or water)\n  # These are generally not places the agent can move into.\n  boundary_idx = cookbook.index.get('boundary', -1) # Use .get() with default to handle cases where index might not exist\n  water_idx = cookbook.index.get('water', -1)\n\n  path_found = False\n  while q:\n      curr_x, curr_y, path_actions = q.popleft()\n\n      # Check if the current position (curr_x, curr_y) is adjacent to any workshop location.\n      # 'Adjacent' means within a 3x3 neighborhood (Chebyshev distance of 1).\n      is_adjacent_to_workshop = False\n      for wx, wy in workshop_locations:\n          if abs(curr_x - wx) <= 1 and abs(curr_y - wy) <= 1:\n              is_adjacent_to_workshop = True\n              break\n      \n      if is_adjacent_to_workshop:\n          actions_to_take.extend(path_actions) # Add all movement actions\n          actions_to_take.append(USE)          # Add the final USE action to craft\n          path_found = True\n          break # Path found, exit BFS\n\n      # Explore neighboring cells\n      for action_val, (dx, dy) in ACTION_DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_x < width and 0 <= next_y < height):\n              continue\n          \n          # Check if the next position has already been visited in the BFS\n          if (next_x, next_y) in visited:\n              continue\n\n          # Check if the next position is blocked by non-traversable entities\n          is_blocked = False\n          if boundary_idx != -1 and grid[next_x, next_y, boundary_idx] == 1:\n              is_blocked = True\n          if water_idx != -1 and grid[next_x, next_y, water_idx] == 1:\n              is_blocked = True\n          \n          if is_blocked:\n              continue # This cell is blocked, cannot move here\n\n          # If traversable and unvisited, add to queue and mark as visited\n          visited.add((next_x, next_y))\n          q.append((next_x, next_y, path_actions + [action_val]))\n  \n  if not path_found:\n      # No path could be found to any workshop from the current position.\n      return []\n\n  return actions_to_take", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-25T15:20:49.580730", "function_name": "craft", "function_body": "  # Helper functions defined locally to fit the \"only function body\" requirement\n  # (This is generally not ideal Python style, but fits the constraint of the prompt)\n\n  # Action mapping for easier readability\n  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  def _get_kind_positions(grid, kind_idx):\n      \"\"\"\n      Finds all (x, y) positions on the grid where the given kind_idx exists.\n      \"\"\"\n      positions = []\n      # grid is (WIDTH, HEIGHT, n_kinds)\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, kind_idx] > 0:\n                  positions.append((x, y))\n      return positions\n\n  def _manhattan_distance(pos1, pos2):\n      \"\"\"\n      Calculates the Manhattan distance between two positions.\n      \"\"\"\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def _pathfind_to_adjacent_and_use(current_sim_state, target_kind_idx):\n      \"\"\"\n      Plans actions to move the agent from current_sim_state.pos to a position\n      adjacent to target_kind_idx, then performs a USE action.\n      Returns the list of actions and the updated simulation state.\n      \"\"\"\n      sim_actions = []\n      sim_state = current_sim_state # This state will be updated and returned\n\n      grid_width = sim_state.grid.shape[0]\n      grid_height = sim_state.grid.shape[1]\n\n      target_positions = _get_kind_positions(sim_state.grid, target_kind_idx)\n      if not target_positions:\n          # Target kind not found on the grid, cannot proceed.\n          return [], sim_state\n\n      # Find the closest target position (considering the current agent position)\n      closest_target_pos = None\n      min_dist = float('inf')\n      for tp in target_positions:\n          dist = _manhattan_distance(sim_state.pos, tp)\n          if dist < min_dist:\n              min_dist = dist\n              closest_target_pos = tp\n      \n      if closest_target_pos is None: # Should not happen if target_positions is not empty\n          return [], sim_state\n\n      # Move until adjacent\n      # Add a generous max_steps to prevent infinite loops in case of impassable terrain\n      # or logic errors, although simple pathfinding doesn't account for impassable terrain.\n      max_move_steps = grid_width * grid_height * 2 \n      steps_taken = 0\n\n      while not sim_state.next_to(target_kind_idx) and steps_taken < max_move_steps:\n          agent_x, agent_y = sim_state.pos\n          target_x, target_y = closest_target_pos\n\n          # Calculate shortest path considering wrapping around the grid\n          dx = target_x - agent_x\n          dy = target_y - agent_y\n\n          move_action = None\n\n          # Prioritize horizontal movement if not at target_x, then vertical\n          if dx != 0:\n              dist_right = (dx + grid_width) % grid_width\n              dist_left = (-dx + grid_width) % grid_width\n\n              if dist_right <= dist_left: # Prefer RIGHT for positive dx, or if distances are equal\n                  move_action = RIGHT\n              else:\n                  move_action = LEFT\n          elif dy != 0: # If at target_x, move vertically\n              dist_down = (dy + grid_height) % grid_height\n              dist_up = (-dy + grid_height) % grid_height\n\n              if dist_down <= dist_up: # Prefer DOWN for positive dy, or if distances are equal\n                  move_action = DOWN\n              else:\n                  move_action = UP\n          \n          if move_action is None:\n              # Agent is already at target_x,y or cannot move further to satisfy next_to.\n              # This break is a safety measure.\n              break \n\n          sim_actions.append(move_action)\n          _, sim_state = sim_state.step(move_action) # Simulate the action to update state\n          steps_taken += 1\n\n      # After loop, if not adjacent, it means pathfinding failed or target is unreachable.\n      if not sim_state.next_to(target_kind_idx):\n          return [], sim_state # Indicate failure to reach target\n\n      # Now agent is adjacent, perform USE action\n      sim_actions.append(USE)\n      _, sim_state = sim_state.step(USE) # Simulate USE to update inventory/grid\n\n      return sim_actions, sim_state\n\n  # --- Main recursive planning function for crafting ---\n  def _recursive_plan_and_update_state(current_sim_state, item_to_get_idx):\n      \"\"\"\n      Recursively plans actions to obtain item_to_get_idx.\n      It uses a simulated state (current_sim_state) to track inventory and position.\n      Returns a list of actions and the updated simulation state.\n      \"\"\"\n      plan_actions = []\n\n      # Base case: If item is already in inventory, no actions needed.\n      if current_sim_state.inventory[item_to_get_idx] > 0:\n          return plan_actions, current_sim_state\n\n      cookbook = env.world.cookbook\n      \n      # Check if the item is a primitive (can be collected from the environment)\n      if item_to_get_idx in cookbook.primitives:\n          actions_to_collect, new_sim_state = _pathfind_to_adjacent_and_use(current_sim_state, item_to_get_idx)\n          plan_actions.extend(actions_to_collect)\n          return plan_actions, new_sim_state\n      \n      # If not a primitive, it must be a craftable item. Get its recipe.\n      recipe = cookbook.recipes.get(item_to_get_idx)\n      if recipe is None:\n          # Item is neither primitive nor craftable, cannot obtain.\n          return [], current_sim_state\n\n      ingredients_info = recipe.copy()\n      workshop_key_idx = None\n      if \"_key\" in ingredients_info:\n          workshop_key_idx = ingredients_info.pop(\"_key\") # Extract workshop requirement\n\n      # Recursively collect/craft all required ingredients\n      for ing_idx, ing_count in ingredients_info.items():\n          # For each unit of ingredient needed, try to obtain it\n          for _ in range(ing_count - current_sim_state.inventory[ing_idx]):\n              initial_ing_count = current_sim_state.inventory[ing_idx] # Snapshot before attempt\n              \n              # Recursively call to get this ingredient\n              sub_actions, current_sim_state = _recursive_plan_and_update_state(current_sim_state, ing_idx)\n              plan_actions.extend(sub_actions)\n              \n              # Check if the ingredient count actually increased.\n              # If not, it implies we failed to obtain it (e.g., resource depleted).\n              if current_sim_state.inventory[ing_idx] <= initial_ing_count:\n                  # Cannot get this specific ingredient. Propagate failure.\n                  return plan_actions, current_sim_state \n\n      # All ingredients supposedly collected/crafted. Now, perform the final crafting step.\n      if workshop_key_idx is not None:\n          # Move to and use the specific workshop required by the recipe\n          actions_to_workshop, new_sim_state = _pathfind_to_adjacent_and_use(current_sim_state, workshop_key_idx)\n          plan_actions.extend(actions_to_workshop)\n          current_sim_state = new_sim_state\n      else:\n          # No specific workshop, crafting can be done anywhere by using the USE action.\n          # Simulate the USE action to update inventory (i.e., consume ingredients and add item).\n          # Note: The reward is always 0.0 in CraftState.step, we only care about state change.\n          sim_actions.append(USE)\n          _, current_sim_state = current_sim_state.step(USE)\n          plan_actions.append(USE) # Add to the list of actions\n\n      return plan_actions, current_sim_state\n\n  # --- Main execution of craft_v2 ---\n  # Initialize the simulation state from the environment's initial scenario state.\n  # This ensures we start planning from a clean, known initial condition.\n  sim_state = env.scenario.init()\n\n  # Begin the recursive planning process to obtain the target item.\n  final_actions, _ = _recursive_plan_and_update_state(sim_state, item)\n  \n  return final_actions", "island_id": 6, "scores": {"3": -1}}
