{"timestamp": "2025-07-25T13:20:01.623205", "function_name": "craft", "function_body": "  import numpy as np\n  import collections\n\n  # Define a simple VirtualState class to manage the planning state.\n  # This mimics the Struct class functionality locally to avoid external dependencies\n  # beyond standard libraries, strictly adhering to \"no code outside of it\".\n  class VirtualState(object):\n      def __init__(self, **entries):\n          self.__dict__.update(entries)\n\n  def _is_walkable(grid, r, c, width, height, boundary_idx):\n      \"\"\"Checks if a cell (r, c) is within bounds and not a boundary.\"\"\"\n      return 0 <= r < width and 0 <= c < height and grid[r, c, boundary_idx] == 0\n\n  def _get_path_actions(start_pos, target_pos, grid, width, height, boundary_idx, action_map):\n      \"\"\"\n      Performs a BFS to find a path from start_pos to target_pos on the grid\n      and returns the sequence of actions.\n      \"\"\"\n      if start_pos == target_pos:\n          return []\n\n      queue = collections.deque([(start_pos, [])]) # (position, path_actions)\n      visited = {start_pos}\n\n      # dr, dc for DOWN, UP, LEFT, RIGHT actions\n      dr = [1, -1, 0, 0]\n      dc = [0, 0, -1, 1]\n      \n      # Map (dr, dc) delta back to action constants\n      action_from_delta = {(1, 0): action_map['DOWN'], (-1, 0): action_map['UP'],\n                           (0, -1): action_map['LEFT'], (0, 1): action_map['RIGHT']}\n\n      while queue:\n          curr_pos, path = queue.popleft()\n\n          for i in range(4): # Iterate through possible movements (DOWN, UP, LEFT, RIGHT)\n              next_r, next_c = curr_pos[0] + dr[i], curr_pos[1] + dc[i]\n              next_pos = (next_r, next_c)\n\n              if _is_walkable(grid, next_r, next_c, width, height, boundary_idx) and next_pos not in visited:\n                  new_path = path + [action_from_delta[(dr[i], dc[i])]]\n                  if next_pos == target_pos:\n                      return new_path\n                  visited.add(next_pos)\n                  queue.append((next_pos, new_path))\n      \n      # If no path found (e.g., target unreachable), return empty list.\n      return []\n\n  def _find_nearest_item(grid, item_idx, current_pos, width, height):\n      \"\"\"\n      Finds the nearest location of an item_idx on the grid from current_pos\n      using Manhattan distance.\n      \"\"\"\n      min_dist = float('inf')\n      nearest_loc = None\n      \n      for r in range(width):\n          for c in range(height):\n              if grid[r, c, item_idx] > 0: # Check if item exists at this cell\n                  dist = abs(r - current_pos[0]) + abs(c - current_pos[1])\n                  if dist < min_dist:\n                      min_dist = dist\n                      nearest_loc = (r, c)\n      return nearest_loc\n\n  def _plan_actions_recursive(target_idx, virtual_state, cookbook, world, action_map):\n      \"\"\"\n      Recursively plans actions to obtain a target item, considering dependencies\n      and updating a virtual state.\n      \n      Args:\n          target_idx: The integer index of the item to obtain.\n          virtual_state: A VirtualState object representing the current virtual state (pos, inventory, grid).\n          cookbook: The Cookbook instance.\n          world: The CraftWorld instance.\n          action_map: Dictionary mapping action names to integer constants.\n          \n      Returns:\n          A tuple: (list of actions, updated_virtual_state_object)\n      \"\"\"\n      all_actions = []\n\n      # Make copies to avoid modifying the caller's virtual state directly\n      current_inventory = virtual_state.inventory.copy()\n      current_pos = virtual_state.pos\n      current_grid = virtual_state.grid.copy()\n\n      # Get grid dimensions and boundary index for pathfinding\n      WIDTH, HEIGHT = current_grid.shape[0], current_grid.shape[1]\n      BOUNDARY_IDX = cookbook.index['boundary']\n      USE_ACTION = action_map['USE']\n\n      recipe = cookbook.recipes.get(target_idx)\n\n      # Case 1: Target is a primitive item or has no recipe (needs to be collected)\n      if target_idx in cookbook.primitives or recipe is None:\n          # We need to find and collect this item\n          target_location = _find_nearest_item(current_grid, target_idx, current_pos, WIDTH, HEIGHT)\n          \n          if target_location is None:\n              # Item not found on grid or consumed. Cannot collect. Return current state without actions.\n              return [], VirtualState(pos=current_pos, inventory=current_inventory, grid=current_grid)\n\n          path_actions = _get_path_actions(current_pos, target_location, current_grid, WIDTH, HEIGHT, BOUNDARY_IDX, action_map)\n          all_actions.extend(path_actions)\n          all_actions.append(USE_ACTION) # Action to collect the item\n          \n          # Update virtual state after collection\n          current_pos = target_location # Agent is now at the collected item's location\n          current_inventory[target_idx] += 1\n          \n          # Primitives are consumed from the grid when collected\n          current_grid[target_location[0], target_location[1], target_idx] = 0 # Remove it from the virtual grid\n          \n          return all_actions, VirtualState(pos=current_pos, inventory=current_inventory, grid=current_grid)\n\n      # Case 2: Target is a crafted item (has a recipe)\n      else:\n          ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n          workshop_idx = recipe.get(\"_key\") # Can be None if no workshop needed for crafting\n\n          # Recursively gather all required ingredients\n          for ingr_idx, ingr_count in ingredients.items():\n              while current_inventory[ingr_idx] < ingr_count:\n                  # Plan actions to get one unit of the missing ingredient\n                  sub_actions, updated_state = _plan_actions_recursive(ingr_idx,\n                                                                       VirtualState(pos=current_pos, inventory=current_inventory, grid=current_grid),\n                                                                       cookbook, world, action_map)\n                  all_actions.extend(sub_actions)\n                  # Update our current virtual state based on the actions taken for the ingredient\n                  current_pos = updated_state.pos\n                  current_inventory = updated_state.inventory\n                  current_grid = updated_state.grid\n                  \n                  # If after sub-planning, we still don't have enough, it means it's impossible to get this ingredient.\n                  if current_inventory[ingr_idx] < ingr_count:\n                      return [], VirtualState(pos=current_pos, inventory=current_inventory, grid=current_grid)\n\n          # All ingredients are now virtually in inventory. Proceed to craft.\n          if workshop_idx is not None:\n              # Move to the required workshop\n              workshop_location = _find_nearest_item(current_grid, workshop_idx, current_pos, WIDTH, HEIGHT)\n              if workshop_location is None:\n                  # Required workshop not found. Cannot craft.\n                  return [], VirtualState(pos=current_pos, inventory=current_inventory, grid=current_grid)\n              \n              path_actions = _get_path_actions(current_pos, workshop_location, current_grid, WIDTH, HEIGHT, BOUNDARY_IDX, action_map)\n              all_actions.extend(path_actions)\n              current_pos = workshop_location # Agent is now at the workshop\n\n          all_actions.append(USE_ACTION) # Action to craft the item\n\n          # Update virtual inventory: consume ingredients, produce the target item\n          for ingr_idx, ingr_count in ingredients.items():\n              current_inventory[ingr_idx] -= ingr_count\n          current_inventory[target_idx] += 1\n\n          return all_actions, VirtualState(pos=current_pos, inventory=current_inventory, grid=current_grid)\n\n\n  # --- Main logic for craft_v1 function ---\n\n  # Initialize necessary data from the environment\n  cookbook = env.world.cookbook\n  world = env.world\n  action_map = env.action_specs()\n\n  # Get the *initial* state from the scenario, as env.reset() happens *after* this function call.\n  # The initial inventory is assumed to be empty unless the scenario explicitly starts with items.\n  initial_grid = env.scenario.init_grid.copy()\n  initial_pos = env.scenario.init_pos\n  initial_inventory = np.zeros(env.world.n_kinds, dtype=np.int32) \n  \n  # Create an initial virtual state to start planning from\n  initial_virtual_state = VirtualState(pos=initial_pos,\n                                       inventory=initial_inventory,\n                                       grid=initial_grid)\n\n  # Check if the item is already in initial inventory (though typically it won't be)\n  if initial_virtual_state.inventory[item] > 0:\n      return [] # Already have it, no actions needed\n\n  # Begin the recursive planning process\n  actions, final_virtual_state = _plan_actions_recursive(item, initial_virtual_state, cookbook, world, action_map)\n  \n  # After planning, verify if the item was successfully 'crafted' in the virtual state\n  if final_virtual_state.inventory[item] > 0:\n      return actions\n  else:\n      # If the item could not be crafted (e.g., due to unreachable ingredients/workshops), return an empty list.\n      return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-25T13:20:02.894988", "function_name": "craft", "function_body": "  import numpy as np\n\n  # Action constants, as defined in CraftLab.action_specs\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Helper for pathfinding (BFS) to find the closest instance of a kind on the grid\n  # and return the actions to reach it.\n  def _get_path_and_target_pos(grid, start_pos, target_kind_idx, non_grabbable_indices, workshop_indices, water_index):\n      # grid: numpy.ndarray of shape (WIDTH, HEIGHT, n_kinds)\n      # start_pos: tuple(int, int) (agent's current position)\n      # target_kind_idx: int (index of the entity kind to find)\n      # non_grabbable_indices: set of int indices for non-grabbable entities\n      # workshop_indices: list of int indices for different types workshop locations (these are walkable)\n      # water_index: int index for the \u201cwater\u201d entity (this is walkable)\n\n      WIDTH, HEIGHT, _ = grid.shape\n      q = [(start_pos, [])] # (current_pos, path_actions)\n      visited = {start_pos}\n\n      # Directions (dx, dy) for (UP, DOWN, LEFT, RIGHT) actions\n      # Mapping from action value to (dx, dy) delta\n      deltas_map = {\n          UP: (0, -1),\n          DOWN: (0, 1),\n          LEFT: (-1, 0),\n          RIGHT: (1, 0)\n      }\n\n      # BFS to find the target_kind_idx\n      while q:\n          (curr_x, curr_y), path = q.pop(0)\n\n          # Check if the current position contains the target kind.\n          # We aim to reach the exact square where the item/workshop is located.\n          if grid[curr_x, curr_y, target_kind_idx] > 0:\n              return path, (curr_x, curr_y)\n\n          # Explore neighbors\n          for action_val, (dx, dy) in deltas_map.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n\n              # Check boundaries\n              if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n                  continue\n\n              # Check if already visited to avoid loops and redundant paths\n              if (next_x, next_y) in visited:\n                  continue\n\n              # Check for obstacles (non-walkable entities)\n              # A cell is walkable if it does not contain any non-grabbable entity,\n              # *unless* that entity is water or a workshop.\n              is_obstacle = False\n              for k_idx in non_grabbable_indices:\n                  # Water and workshops are generally walkable, even if they are non-grabbable.\n                  if k_idx == water_index or k_idx in workshop_indices:\n                      continue\n                  # If the cell contains any other non-grabbable item, it's an obstacle.\n                  if grid[next_x, next_y, k_idx] > 0:\n                      is_obstacle = True\n                      break\n              if is_obstacle:\n                  continue\n\n              visited.add((next_x, next_y))\n              q.append(((next_x, next_y), path + [action_val]))\n\n      return [], None # No path found to the target kind\n\n  # Initialize the list to store all generated actions\n  all_actions = []\n\n  # Create a copy of the current inventory and grid for simulation purposes\n  # This allows the planner to track assumed inventory changes without\n  # actually modifying the live environment state during planning.\n  simulated_inventory = env._current_state.inventory.copy()\n  initial_grid = env._current_state.grid.copy() # The grid is assumed static for planning\n  current_simulated_pos = env._current_state.pos\n\n  # Get dictionary to map string names (e.g., \"workbench\") to their integer indices\n  name_to_index = env.world.cookbook.index.contents\n\n  # Helper to get the integer index of a workshop given its string name (e.g., \"workbench\")\n  def _get_workshop_index_from_name(workshop_name_str):\n      return name_to_index.get(workshop_name_str, None)\n\n  # --- Dependency Graph and Requirements Calculation ---\n  # Build a dependency graph: item_idx -> set(ingredient_idx)\n  dependency_graph = {}\n  # Store workshop index for each craftable item\n  item_workshops = {}\n\n  for output_idx, recipe_data in env.world.cookbook.recipes.items():\n      dependencies = set()\n      workshop_key = None\n      for ingredient_idx_or_key, _ in recipe_data.items():\n          if ingredient_idx_or_key == \"_key\":\n              workshop_key = recipe_data[\"_key\"]\n          else:\n              dependencies.add(ingredient_idx_or_key)\n      dependency_graph[output_idx] = dependencies\n      item_workshops[output_idx] = _get_workshop_index_from_name(workshop_key)\n\n  # Dictionaries to store the total counts of primitives and craftable items required\n  # across all levels of the crafting tree, adjusted for initial inventory.\n  required_craftable_items = {} # item_idx -> count needed (total across all levels)\n  required_primitives = {}      # item_idx -> count needed (total across all levels)\n\n  # Recursive function to traverse the crafting tree and determine all required components\n  def _get_requirements_recursive(current_target_item_idx, desired_count):\n      # If the item has no recipe, it's a primitive\n      if env.world.cookbook.recipes.get(current_target_item_idx) is None:\n          required_primitives[current_target_item_idx] = required_primitives.get(current_target_item_idx, 0) + desired_count\n      else: # It's a craftable item\n          required_craftable_items[current_target_item_idx] = required_craftable_items.get(current_target_item_idx, 0) + desired_count\n\n          recipe = env.world.cookbook.recipes[current_target_item_idx]\n          for ingredient_idx_or_key, count_needed in recipe.items():\n              if ingredient_idx_or_key != \"_key\":\n                  _get_requirements_recursive(ingredient_idx_or_key, count_needed * desired_count)\n\n  # Start the recursive requirement calculation for the target item\n  _get_requirements_recursive(item, 1)\n\n  # Adjust required counts based on what's already in the simulated inventory\n  # This avoids planning to acquire items the agent already possesses at the start.\n  for p_idx in list(required_primitives.keys()):\n      if simulated_inventory[p_idx] > 0:\n          actual_needed = required_primitives[p_idx] - simulated_inventory[p_idx]\n          if actual_needed <= 0:\n              del required_primitives[p_idx]\n          else:\n              required_primitives[p_idx] = actual_needed\n\n  for c_idx in list(required_craftable_items.keys()):\n      if simulated_inventory[c_idx] > 0:\n          actual_needed = required_craftable_items[c_idx] - simulated_inventory[c_idx]\n          if actual_needed <= 0:\n              del required_craftable_items[c_idx]\n          else:\n              required_craftable_items[c_idx] = actual_needed\n              \n  # --- Topological Sort for Crafting Order ---\n  # Build a crafting order using topological sort for the required craftable items.\n  # This ensures ingredients are crafted before the items that depend on them.\n  crafting_order = []\n  \n  # Calculate in-degrees for craftable items, considering only craftable dependencies.\n  # Primitives are considered \"base\" nodes with no craftable dependencies.\n  in_degree_craft = {}\n  for output_idx in required_craftable_items:\n      craftable_deps_count = 0\n      if output_idx in dependency_graph:\n          for dep_idx in dependency_graph[output_idx]:\n              if env.world.cookbook.recipes.get(dep_idx) is not None: # It's a craftable ingredient\n                  craftable_deps_count += 1\n      in_degree_craft[output_idx] = craftable_deps_count\n\n  # Initialize queue with craftable items that have no craftable dependencies (in this sub-graph)\n  q_craft = [node for node, degree in in_degree_craft.items() if degree == 0]\n  \n  # Simple topological sort (assumes the recipe graph is a Directed Acyclic Graph - DAG)\n  while q_craft:\n      node = q_craft.pop(0)\n      crafting_order.append(node)\n\n      # For all other craftable items, decrement their in-degree if 'node' is a dependency\n      for other_node in list(in_degree_craft.keys()):\n          if other_node == node: # Skip self-comparison\n              continue\n          if node in dependency_graph.get(other_node, set()):\n              in_degree_craft[other_node] -= 1\n              if in_degree_craft[other_node] == 0:\n                  q_craft.append(other_node)\n\n  # Ensure the final target item is at the end of the crafting order if it's craftable\n  # and wasn't naturally placed there by the topological sort (e.g., if it had no craftable dependencies).\n  if item in required_craftable_items and item not in crafting_order:\n      crafting_order.append(item)\n\n  # --- Action Generation ---\n  # 1. Collect all required primitives.\n  # 2. Craft intermediate and final items in the determined `crafting_order`.\n\n  # 1. Collect Primitives\n  for p_idx, count_to_collect in required_primitives.items():\n      for _ in range(count_to_collect):\n          # Find the primitive on the initial grid and get path actions\n          path_actions, target_pos = _get_path_and_target_pos(\n              initial_grid, current_simulated_pos, p_idx,\n              env.non_grabbable_indices, env.workshop_indices, env.water_index\n          )\n          if target_pos is None:\n              # If a primitive is needed but unreachable, the plan fails.\n              return [] # Return empty list to indicate failure or impossible task\n\n          all_actions.extend(path_actions)\n          current_simulated_pos = target_pos # Update simulated agent position\n\n          # Once at the target position (or adjacent), use the item to collect it.\n          all_actions.append(USE)\n\n          # Simulate inventory update for this primitive collection.\n          # This helps subsequent planning steps (e.g., checking if enough ingredients are present).\n          simulated_inventory[p_idx] += 1\n\n  # 2. Craft Items in Order\n  for c_idx in crafting_order:\n      # Only craft if this item is still needed and not already in simulated inventory\n      if c_idx not in required_craftable_items or required_craftable_items[c_idx] <= 0:\n          continue\n\n      # Before crafting, verify that all necessary ingredients are in the simulated inventory.\n      # This check should ideally pass if the `_get_requirements_recursive` and\n      # primitive collection/topological sort logic are robust.\n      recipe = env.world.cookbook.recipes.get(c_idx)\n      if recipe is None: # Should not happen for items in `crafting_order`\n          return [] # Indicate error\n\n      has_all_ingredients = True\n      for ingredient_idx_or_key, count_needed in recipe.items():\n          if ingredient_idx_or_key != \"_key\":\n              if simulated_inventory[ingredient_idx_or_key] < count_needed:\n                  has_all_ingredients = False\n                  break\n      if not has_all_ingredients:\n          # This signifies a planning failure (e.g., missing ingredients).\n          return [] # Indicate failure\n\n      # Find the correct workshop for this craftable item\n      workshop_idx = item_workshops.get(c_idx)\n      if workshop_idx is None:\n          return [] # No workshop specified or found for a craftable item (planning error)\n\n      # Move to the workshop\n      path_actions, target_pos = _get_path_and_target_pos(\n          initial_grid, current_simulated_pos, workshop_idx,\n          env.non_grabbable_indices, env.workshop_indices, env.water_index\n      )\n      if target_pos is None:\n          return [] # Workshop unreachable (planning failure)\n\n      all_actions.extend(path_actions)\n      current_simulated_pos = target_pos # Update simulated agent position\n\n      # Use the workshop to perform the craft\n      all_actions.append(USE)\n\n      # Simulate inventory update for this craft: add the crafted item, consume ingredients.\n      simulated_inventory[c_idx] += 1\n      required_craftable_items[c_idx] -= 1 # Decrement count needed\n\n      for ingredient_idx_or_key, count_needed in recipe.items():\n          if ingredient_idx_or_key != \"_key\":\n              simulated_inventory[ingredient_idx_or_key] -= count_needed\n\n  return all_actions", "island_id": 6, "scores": {"3": -1}}
