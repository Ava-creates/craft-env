{"timestamp": "2025-07-25T13:44:24.232891", "function_name": "craft", "function_body": "  import numpy as np\n  import collections\n\n  # Define action mappings locally within the function's scope\n  actions_map = env.action_specs()\n  DOWN = actions_map['DOWN']\n  UP = actions_map['UP']\n  LEFT = actions_map['LEFT']\n  RIGHT = actions_map['RIGHT']\n  USE = actions_map['USE']\n\n  class _SimulatedState:\n    \"\"\"A simplified state representation for planning, tracking position and inventory.\"\"\"\n    def __init__(self, initial_pos, initial_inventory, initial_grid):\n      self.pos = initial_pos\n      self.inventory = np.copy(initial_inventory)\n      self.grid = initial_grid # Reference to the unchanging grid layout\n\n    def update_pos(self, new_pos):\n      self.pos = new_pos\n\n    def update_inventory(self, item_idx, delta_count):\n      # Ensure inventory doesn't go negative (though delta_count should be positive here)\n      self.inventory[item_idx] = max(0, self.inventory[item_idx] + delta_count)\n\n  def _get_path_actions(start_pos, target_pos):\n    \"\"\"\n    Generates a list of low-level movement actions (UP, DOWN, LEFT, RIGHT)\n    to move from start_pos to target_pos using Manhattan distance.\n    Assumes a clear path without obstacles.\n    \"\"\"\n    actions = []\n    curr_x, curr_y = start_pos\n    target_x, target_y = target_pos\n\n    # Move horizontally\n    while curr_x != target_x:\n      if curr_x < target_x:\n        actions.append(RIGHT)\n        curr_x += 1\n      else:\n        actions.append(LEFT)\n        curr_x -= 1\n\n    # Move vertically\n    while curr_y != target_y:\n      if curr_y < target_y:\n        actions.append(DOWN)\n        curr_y += 1\n      else:\n        actions.append(UP)\n        curr_y -= 1\n    return actions\n\n  def _find_kind_on_grid(grid, current_pos, kind_idx):\n    \"\"\"\n    Finds the position (x, y) of the closest cell containing kind_idx in the grid.\n    Performs a simple BFS to find the closest one.\n    Returns (x, y) of the cell containing the kind, or None if not found.\n    \"\"\"\n    WIDTH, HEIGHT, N_KINDS = grid.shape\n    \n    q = collections.deque([(current_pos, 0)]) # (pos, distance)\n    visited = {current_pos}\n    \n    while q:\n      (x, y), dist = q.popleft()\n\n      # Check the cell itself for the kind\n      if grid[x, y, kind_idx] > 0:\n        return (x, y) # Return the first found, which is guaranteed to be closest by BFS.\n\n      # Explore neighbors\n      neighbors = []\n      if x > 0: neighbors.append((x - 1, y))\n      if x < WIDTH - 1: neighbors.append((x + 1, y))\n      if y > 0: neighbors.append((x, y - 1))\n      if y < HEIGHT - 1: neighbors.append((x, y + 1))\n\n      for next_pos in neighbors:\n        if next_pos not in visited:\n          visited.add(next_pos)\n          q.append((next_pos, dist + 1))\n              \n    return None # Not found\n\n  def _plan_crafting_sequence(env_world, target_item_idx, simulated_state, all_actions_list):\n    \"\"\"\n    Recursively plans the actions to craft target_item_idx, updating simulated_state and all_actions_list.\n    Returns True if successful, False otherwise (e.g., item uncraftable, no path to resources/workshop).\n    \"\"\"\n\n    # If already have at least one unit of the target item, no more actions are needed for this specific crafting goal.\n    if simulated_state.inventory[target_item_idx] > 0:\n      return True \n\n    recipe = env_world.cookbook.recipes.get(target_item_idx)\n    if not recipe:\n      # Item cannot be crafted (no recipe defined in cookbook)\n      return False\n\n    # 1. Handle workshop requirement (if any)\n    workshop_idx = None\n    ingredients = {} # Separate dictionary for actual ingredients\n    for ing_idx, count_needed in recipe.items():\n      if isinstance(ing_idx, str) and ing_idx == '_key':\n        # This is the workshop key.\n        # Assume its value is the actual workshop index, or 1 if any workshop suffices.\n        if count_needed in env_world.workshop_indices:\n          workshop_idx = count_needed\n        elif env_world.workshop_indices:\n          # Fallback to the first workshop if the _key value is not a specific valid index.\n          # This is a heuristic and might not be optimal for all maps.\n          workshop_idx = env_world.workshop_indices[0]\n      else:\n        ingredients[ing_idx] = count_needed\n\n    # 2. Recursively gather all ingredients required\n    for ing_idx, count_needed in ingredients.items():\n      while simulated_state.inventory[ing_idx] < count_needed:\n        if ing_idx in env_world.cookbook.primitives:\n          # This is a primitive resource, collect it\n          target_pos = _find_kind_on_grid(simulated_state.grid, simulated_state.pos, ing_idx)\n          if target_pos is None:\n            return False # Primitive not found on grid, cannot proceed\n          \n          path_actions = _get_path_actions(simulated_state.pos, target_pos)\n          all_actions_list.extend(path_actions)\n          simulated_state.update_pos(target_pos) # Update simulated position\n\n          # Perform USE action to collect the primitive.\n          # Assumes one USE action yields one unit of the primitive.\n          all_actions_list.append(USE)\n          simulated_state.update_inventory(ing_idx, 1)\n        else:\n          # This is a crafted item, recursively plan its crafting\n          success = _plan_crafting_sequence(env_world, ing_idx, simulated_state, all_actions_list)\n          if not success:\n            return False # Cannot craft sub-item, so main craft also fails\n    \n    # 3. Move to the required workshop (if any)\n    if workshop_idx is not None:\n      target_pos = _find_kind_on_grid(simulated_state.grid, simulated_state.pos, workshop_idx)\n      if target_pos is None:\n        return False # Workshop not found on grid, cannot craft\n      \n      path_actions = _get_path_actions(simulated_state.pos, target_pos)\n      all_actions_list.extend(path_actions)\n      simulated_state.update_pos(target_pos) # Update simulated position\n\n    # 4. Perform USE action to craft the target item\n    all_actions_list.append(USE)\n    # The game logic (via env.step) handles ingredient consumption.\n    # We simulate the creation of the target item in our planning state.\n    simulated_state.update_inventory(target_item_idx, 1) # Assume 1 unit crafted per USE\n    \n    return True\n\n  # --- Main logic for craft_v1 function ---\n  initial_state = env._current_state\n  \n  # Initialize a simulated state based on the actual initial state of the environment.\n  # This simulated state will be updated as the planner generates actions.\n  simulated_state = _SimulatedState(\n      initial_pos=initial_state.pos,\n      initial_inventory=initial_state.inventory,\n      initial_grid=initial_state.grid\n  )\n  \n  # List to accumulate all planned actions.\n  all_planned_actions = []\n\n  # Call the recursive planner to generate the sequence of actions needed to craft the item.\n  success = _plan_crafting_sequence(env.world, item, simulated_state, all_planned_actions)\n\n  if not success:\n    # If planning failed (e.g., cannot find resources or workshop, or item uncraftable),\n    # return an empty list of actions.\n    return []\n  \n  return all_planned_actions", "island_id": 1, "scores": {"3": -1}}
