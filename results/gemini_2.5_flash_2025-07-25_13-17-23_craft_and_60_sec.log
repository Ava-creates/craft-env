{"timestamp": "2025-07-25T15:11:57.702197", "function_name": "craft", "function_body": "    import numpy as np\n\n    # Action constants (from problem description: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4)\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # Environment dimensions and data, accessed from the provided `env` (CraftLab instance)\n    WIDTH = env.scenario.init_grid.shape[0]\n    HEIGHT = env.scenario.init_grid.shape[1]\n    # N_KINDS = env.world.cookbook.n_kinds # Not directly used in helpers, but good to note.\n\n    # The `Struct` class is described in the problem statement as a general-purpose class.\n    # It is assumed to be available in the execution environment.\n\n    # --- Helper functions (nested for self-containment within craft_v2) ---\n\n    def _get_neighbors(pos):\n        \"\"\"Returns valid adjacent (x, y) coordinates on the grid.\"\"\"\n        x, y = pos\n        neighbors = []\n        if x > 0: neighbors.append((x - 1, y)) # Left\n        if x < WIDTH - 1: neighbors.append((x + 1, y)) # Right\n        if y > 0: neighbors.append((x, y - 1)) # Down\n        if y < HEIGHT - 1: neighbors.append((x, y + 1)) # Up\n        return neighbors\n\n    def _get_action_for_move(current_pos, next_pos):\n        \"\"\"Converts a (current_pos, next_pos) step into a corresponding action integer.\"\"\"\n        cx, cy = current_pos\n        nx, ny = next_pos\n        if nx > cx: return RIGHT\n        elif nx < cx: return LEFT\n        elif ny > cy: return UP\n        elif ny < cy: return DOWN\n        return None # Should not happen for valid neighbors\n\n    def _get_path_actions(start_pos, target_pos):\n        \"\"\"\n        Finds a path of move actions from start_pos to target_pos using BFS.\n        Returns a list of actions (UP, DOWN, LEFT, RIGHT).\n        Assumes all grid cells are traversable for pathfinding.\n        \"\"\"\n        if start_pos == target_pos:\n            return []\n\n        # BFS queue: stores (current_position, list_of_actions_to_reach_current_position)\n        queue = [(start_pos, [])]\n        visited = {start_pos}\n\n        while queue:\n            current_pos, path_actions = queue.pop(0)\n\n            for neighbor_pos in _get_neighbors(current_pos):\n                if neighbor_pos in visited:\n                    continue\n\n                action_to_neighbor = _get_action_for_move(current_pos, neighbor_pos)\n                if action_to_neighbor is None:\n                    continue # Skip invalid moves (should not happen with _get_neighbors)\n\n                new_path_actions = path_actions + [action_to_neighbor]\n\n                if neighbor_pos == target_pos:\n                    return new_path_actions\n\n                visited.add(neighbor_pos)\n                queue.append((neighbor_pos, new_path_actions))\n        return [] # No path found\n\n    def _find_kind_location(grid, kind_idx, current_pos, is_adjacent_target):\n        \"\"\"\n        Finds the closest location on the grid related to `kind_idx`.\n        If `is_adjacent_target` is True, returns a position *adjacent* to the kind.\n        Otherwise, returns a position *on* the kind.\n        Returns (x, y) coordinates or None if not found.\n        \"\"\"\n        possible_targets = []\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if grid[x, y, kind_idx] > 0: # This cell contains the `kind_idx`\n                    if is_adjacent_target:\n                        # For workshops, agent needs to be adjacent to 'USE'\n                        for nx, ny in _get_neighbors((x, y)):\n                            # Ensure the adjacent cell itself doesn't contain the same kind\n                            # (e.g., don't target standing on a workshop if you need to be next to it)\n                            # This simplified check assumes any adjacent empty cell is fine.\n                            possible_targets.append((nx, ny))\n                    else:\n                        # For primitives, agent needs to be on the cell to 'USE' (collect/mine)\n                        possible_targets.append((x, y))\n\n        if not possible_targets:\n            return None\n\n        # Sort by Manhattan distance to the agent's current position to find the closest target\n        possible_targets.sort(key=lambda p: abs(p[0] - current_pos[0]) + abs(p[1] - current_pos[1]))\n        return possible_targets[0]\n\n    # Recursive planning function\n    # `current_sim_state` is a `Struct` holding the simulated `inventory`, `pos`, and static `grid`.\n    # Returns a tuple: (list_of_actions_taken_in_this_step, new_sim_state_after_actions).\n    def _plan_craft_recursive(current_sim_state, target_item_idx):\n        # Base case: If the item is already in the simulated inventory, no actions needed.\n        if current_sim_state.inventory[target_item_idx] > 0:\n            return [], current_sim_state\n\n        actions = []\n        # Create mutable copies of state components for simulation purposes\n        sim_inv = np.copy(current_sim_state.inventory)\n        sim_pos = current_sim_state.pos # Position (tuple) is immutable, so reference is fine\n        sim_grid = current_sim_state.grid # Grid (ndarray) is static for the scenario, so reference is fine\n        \n        cookbook = env.world.cookbook\n        is_primitive = target_item_idx in cookbook.primitives\n\n        if is_primitive:\n            # Step 1: Collect the primitive\n            # Find the closest position *on* the primitive to collect it\n            target_pos_on_kind = _find_kind_location(sim_grid, target_item_idx, sim_pos, is_adjacent_target=False)\n            if target_pos_on_kind is None:\n                # Primitive not found on map, cannot collect. Return current state without changes.\n                return [], current_sim_state\n\n            # Get actions to move to the primitive's position\n            move_actions = _get_path_actions(sim_pos, target_pos_on_kind)\n            actions.extend(move_actions)\n            sim_pos = target_pos_on_kind # Update simulated position after moves\n\n            # Perform USE action to collect the primitive\n            actions.append(USE)\n            sim_inv[target_item_idx] += 1 # Assume 1 item is collected per USE action\n\n        else: # The target item is a crafted item (requires a recipe)\n            recipe = cookbook.recipes.get(target_item_idx)\n            if recipe is None:\n                # No recipe found for this item, cannot craft. Return current state without changes.\n                return [], current_sim_state\n\n            workshop_needed_idx = None\n            ingredients = {}\n            for ing_idx_or_key, count in recipe.items():\n                if isinstance(ing_idx_or_key, str) and ing_idx_or_key.startswith('_'):\n                    # This key represents a workshop needed for crafting (e.g., \"_0\" for workshop0)\n                    workshop_needed_idx = int(ing_idx_or_key[1:])\n                else:\n                    ingredients[ing_idx_or_key] = count\n\n            # Step 2: Recursively gather all required ingredients\n            for ing_idx, needed_count in ingredients.items():\n                while sim_inv[ing_idx] < needed_count:\n                    # Create a temporary simulated state for the recursive call to `_plan_craft_recursive`.\n                    # This ensures the recursive call operates on a snapshot of the current simulated state.\n                    temp_sim_state_for_ing = Struct(\n                        inventory=np.copy(sim_inv),\n                        pos=sim_pos,\n                        grid=sim_grid\n                    )\n                    \n                    ing_actions, updated_temp_state = _plan_craft_recursive(temp_sim_state_for_ing, ing_idx)\n                    \n                    if not ing_actions and updated_temp_state.inventory[ing_idx] < needed_count:\n                        # If the recursive call failed to get the ingredient, then the current crafting goal also fails.\n                        return [], current_sim_state\n\n                    actions.extend(ing_actions)\n                    # Update *this* simulation's inventory and position based on the outcome of the recursive call.\n                    sim_inv = np.copy(updated_temp_state.inventory)\n                    sim_pos = updated_temp_state.pos # Agent's position updated after collecting ingredient\n\n            # Step 3: Move to the required workshop if necessary\n            if workshop_needed_idx is not None:\n                # Find the closest position *adjacent* to the workshop to 'USE' it\n                target_pos_adj_workshop = _find_kind_location(sim_grid, workshop_needed_idx, sim_pos, is_adjacent_target=True)\n                if target_pos_adj_workshop is None:\n                    # Workshop not found on map, cannot craft.\n                    return [], current_sim_state\n\n                move_actions = _get_path_actions(sim_pos, target_pos_adj_workshop)\n                actions.extend(move_actions)\n                sim_pos = target_pos_adj_workshop # Update simulated position\n\n            # Step 4: Perform USE action to craft the item\n            actions.append(USE)\n            sim_inv[target_item_idx] += 1 # Assume 1 item is crafted per USE action\n\n            # Step 5: Consume ingredients from the simulated inventory\n            for ing_idx, needed_count in ingredients.items():\n                sim_inv[ing_idx] -= needed_count\n                if sim_inv[ing_idx] < 0: sim_inv[ing_idx] = 0 # Prevent negative inventory counts\n\n        # Return the complete list of actions and the final simulated state after planning this item\n        return actions, Struct(inventory=sim_inv, pos=sim_pos, grid=sim_grid)\n\n    # --- Main `craft` function entry point ---\n    \n    # Get the actual initial state of the environment from the `CraftLab` instance.\n    initial_actual_state = env._current_state\n    \n    # Create an initial `Struct` representing the state for our recursive planning simulation.\n    # We use `np.copy` for inventory to ensure the simulation doesn't modify the actual environment state.\n    initial_simulated_state = Struct(\n        inventory=np.copy(initial_actual_state.inventory),\n        pos=initial_actual_state.pos,\n        grid=initial_actual_state.grid # The grid is static for the scenario, no need to copy\n    )\n    \n    # Call the recursive planner to determine the full sequence of actions needed.\n    final_actions, _ = _plan_craft_recursive(initial_simulated_state, item)\n    return final_actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-25T15:14:25.656731", "function_name": "craft", "function_body": "    # Define basic action constants for clarity\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    # This pattern represents a fixed sequence of moves and USE actions\n    # designed to \"explore and interact\" with the immediate surroundings.\n    # It attempts to cover a small area and use the environment's step logic\n    # to pick up primitives or craft items if conditions are met.\n    # The actual path covered is: (start) -> UP -> UP+RIGHT -> UP+RIGHT+DOWN -> ...\n    # This is a heuristic that assumes relevant items/workshops are within reach\n    # of these generalized movements in the simplified scenarios.\n    FIXED_INTERACT_PATTERN = [\n        UP, USE,            # Move up, interact\n        RIGHT, USE,         # Move right, interact\n        DOWN, USE,          # Move down, interact\n        DOWN, USE,          # Move down again, interact\n        LEFT, USE,          # Move left, interact\n        LEFT, USE,          # Move left again, interact\n        UP, USE,            # Move up, interact\n        UP, USE             # Move up again, interact\n    ]\n    # Total actions in pattern: 16 (8 moves, 8 uses)\n\n    cookbook = env.world.cookbook\n    all_planned_actions = []\n\n    # Simulate inventory for planning purposes.\n    # We assume starting with zero of all craftable/primitive items for a fresh plan,\n    # as the actual `env.reset()` occurs after `craft` returns.\n    simulated_inventory = {k_idx: 0 for k_idx in cookbook.kinds}\n\n    # Recursive function to plan the acquisition (collection or crafting) of a single unit of an item.\n    # target_item_idx: The integer index of the item to acquire.\n    # current_sim_inventory: A dictionary representing the current state of the simulated inventory.\n    # actions_to_add: The list to append the low-level actions to.\n    def _plan_acquisition_recursive(target_item_idx, current_sim_inventory, actions_to_add):\n        # If we already have this item in our simulated inventory, no actions needed for this unit.\n        if current_sim_inventory.get(target_item_idx, 0) > 0:\n            return\n\n        # Check if the target item is a primitive (i.e., it has no recipe in the cookbook).\n        recipe = cookbook.recipes.get(target_item_idx)\n\n        if recipe is None:\n            # If it's a primitive, we append the fixed interaction pattern\n            # assuming it will lead to collecting the primitive.\n            actions_to_add.extend(FIXED_INTERACT_PATTERN)\n            # Update simulated inventory to reflect that this primitive has been acquired.\n            current_sim_inventory[target_item_idx] += 1\n            return\n\n        # If it's a craftable item (has a recipe):\n        # First, plan actions to acquire all necessary ingredients for this single craft.\n        for ingredient_idx, required_count_for_one_craft in recipe.items():\n            # Skip the special \"_key\" entry which indicates the workshop.\n            if ingredient_idx == cookbook.index.get('_key'):\n                continue\n\n            # Recursively plan to acquire each required unit of the ingredient.\n            for _ in range(required_count_for_one_craft):\n                _plan_acquisition_recursive(ingredient_idx, current_sim_inventory, actions_to_add)\n                \n                # After an ingredient unit is \"acquired\" (planned for),\n                # \"consume\" it from the simulated inventory as it's used for the current craft.\n                current_sim_inventory[ingredient_idx] -= 1\n\n        # After all ingredients for the current item have been planned for (and consumed),\n        # plan the actions to perform the craft itself. This involves being near a workshop and using it.\n        # We again use the general fixed interaction pattern, assuming it will lead to the correct\n        # workshop and trigger the craft if ingredients are met.\n        actions_to_add.extend(FIXED_INTERACT_PATTERN)\n        # Update simulated inventory to reflect that this item has been crafted.\n        current_sim_inventory[target_item_idx] += 1\n\n    # Start the recursive planning process for the main item requested.\n    _plan_acquisition_recursive(item, simulated_inventory, all_planned_actions)\n\n    return all_planned_actions", "island_id": 0, "scores": {"3": -1}}
