{"timestamp": "2025-07-25T14:26:36.607311", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants within the function body as per instructions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  def _find_path_and_state(current_planner_state, world, target_kind_idx=None, target_pos_exact=None, needs_adjacent=True):\n      \"\"\"\n      Finds a path to a location satisfying the target condition and returns the actions and final state.\n      Starts a BFS from `current_planner_state` to find the shortest path.\n      Returns: (list_of_actions, final_simulated_state) or (None, None) if no path is found.\n      \"\"\"\n      q = collections.deque([(current_planner_state, [])])\n      # Visited states are (position, direction) to handle cases where agent changes direction\n      visited = {(current_planner_state.pos, current_planner_state.dir)}\n\n      # Limit pathfinding depth to prevent excessively long searches or infinite loops\n      max_steps_per_path = 500 \n\n      while q:\n          current_sim_state, current_actions = q.popleft()\n\n          if len(current_actions) > max_steps_per_path:\n              continue # Skip path if it exceeds max allowed steps\n\n          # Check if the target condition is met by the current simulated state\n          target_achieved = False\n          if target_pos_exact is not None:\n              # Target is a specific grid coordinate\n              if current_sim_state.pos == target_pos_exact:\n                  target_achieved = True\n          elif target_kind_idx is not None:\n              # Target is a type of item/entity (kind)\n              if needs_adjacent:\n                  # For collecting primitives, agent needs to be next to the item\n                  target_achieved = current_sim_state.next_to(target_kind_idx)\n              else: \n                  # For workshops or grabbable items on which the agent must stand\n                  r, c = current_sim_state.pos\n                  # Check if the target kind is at the current position (r,c)\n                  if current_sim_state.grid[r, c, target_kind_idx] > 0:\n                      target_achieved = True\n              \n          if target_achieved:\n              return current_actions, current_sim_state\n\n          # Explore possible next movement actions (UP, DOWN, LEFT, RIGHT)\n          for action in [UP, DOWN, LEFT, RIGHT]:\n              # Simulate the action: CraftState.step returns a NEW CraftState object\n              _, next_simulated_state = current_sim_state.step(action)\n              next_pos = next_simulated_state.pos\n              next_dir = next_simulated_state.dir\n\n              # If this new state (position, direction) has not been visited, add to queue\n              if (next_pos, next_dir) not in visited:\n                  visited.add((next_pos, next_dir))\n                  q.append((next_simulated_state, current_actions + [action]))\n      \n      # No path found to the target\n      return None, None\n\n\n  def _plan_collect_recursive(world, current_planner_state, target_kind_idx):\n      \"\"\"\n      Plans actions to collect a primitive item, starting from `current_planner_state`.\n      Returns: (list_of_actions, final_simulated_state) or (None, None) if collection fails.\n      \"\"\"\n      # Base case: If the item is already in the inventory, no collection is needed\n      if current_planner_state.inventory[target_kind_idx] > 0:\n          return [], current_planner_state\n\n      # Find a path to a location adjacent to the primitive item\n      move_actions, resource_reached_state = _find_path_and_state(\n          current_planner_state, world, target_kind_idx=target_kind_idx, needs_adjacent=True)\n\n      if move_actions is None:\n          return None, None # Cannot find path to resource\n\n      all_planned_actions = move_actions\n      \n      # Simulate the USE action to collect the item\n      _, final_collected_state = resource_reached_state.step(USE)\n      all_planned_actions.append(USE)\n\n      # Verify that collection was successful (item count increased)\n      if final_collected_state.inventory[target_kind_idx] > resource_reached_state.inventory[target_kind_idx]:\n          return all_planned_actions, final_collected_state\n      else:\n          # Collection failed (e.g., resource exhausted or not actually next to it)\n          return None, None\n\n\n  def _plan_craft_recursive(world, current_planner_state, target_item_idx, path_visited_craft_goals):\n      \"\"\"\n      Recursively plans actions to craft an item, starting from `current_planner_state`.\n      `path_visited_craft_goals` is a set to prevent infinite recursion in case of cyclic recipes.\n      Returns: (list_of_actions, final_simulated_state) or (None, None) if crafting fails.\n      \"\"\"\n      # Base case: If the target item is already in the inventory, no crafting is needed\n      if current_planner_state.inventory[target_item_idx] > 0:\n          return [], current_planner_state\n\n      # Prevent immediate infinite recursion for cyclic recipes (though recipes should be acyclic)\n      if target_item_idx in path_visited_craft_goals:\n          return None, None # Cycle detected in planning path\n\n      # Add the current target item to the visited set for this planning branch\n      new_path_visited = path_visited_craft_goals.union({target_item_idx})\n\n      # Get the recipe for the target item\n      recipe_info = world.cookbook.recipes.get(target_item_idx)\n\n      # If no recipe exists, the item is a primitive and must be collected\n      if recipe_info is None:\n          return _plan_collect_recursive(world, current_planner_state, target_item_idx)\n\n      all_planned_actions = []\n      current_sim_state = current_planner_state # This state will be updated as ingredients are acquired\n\n      # Determine which ingredients are needed\n      ingredients_to_get = []\n      for ingredient_idx_str, count in recipe_info.items():\n          if ingredient_idx_str == \"_key\": # \"_key\" specifies the workshop type\n              continue\n          ingredient_idx = int(ingredient_idx_str)\n          needed_count = count - current_sim_state.inventory[ingredient_idx]\n          if needed_count > 0:\n              ingredients_to_get.append((ingredient_idx, needed_count))\n      \n      # Recursively plan to acquire each needed ingredient\n      for ingredient_idx, needed_count_initial in ingredients_to_get:\n          for _ in range(needed_count_initial): # Try to get each unit of the ingredient\n              # Check if enough of this ingredient is already in the simulated inventory\n              # (might have been acquired by a previous sub-plan in this loop)\n              if current_sim_state.inventory[ingredient_idx] >= recipe_info[str(ingredient_idx)]:\n                  break # Already have enough for this specific recipe requirement\n\n              # Determine if the ingredient is primitive or another craftable item\n              sub_recipe_info = world.cookbook.recipes.get(ingredient_idx)\n              \n              sub_actions = None\n              final_sub_state = None\n\n              if sub_recipe_info is None: # Ingredient is a primitive, collect it\n                  sub_actions, final_sub_state = _plan_collect_recursive(world, current_sim_state, ingredient_idx)\n              else: # Ingredient is craftable, recurse on crafting it\n                  sub_actions, final_sub_state = _plan_craft_recursive(world, current_sim_state, ingredient_idx, new_path_visited)\n              \n              if sub_actions is None: # Sub-plan failed to get an ingredient\n                  return None, None # Cannot craft the target item\n\n              all_planned_actions.extend(sub_actions)\n              current_sim_state = final_sub_state # Update the simulated state with results of sub-plan\n\n      # All ingredients are now (theoretically) in `current_sim_state.inventory`.\n      # Proceed with the final crafting step.\n\n      # Identify the required workshop (if any)\n      workshop_idx_str = recipe_info.get(\"_key\")\n      \n      if workshop_idx_str is None: # No workshop needed (e.g., plank from wood)\n          # Directly simulate consumption of ingredients and production of item\n          for ingredient_idx_str, count in recipe_info.items():\n              if ingredient_idx_str != \"_key\":\n                  ingredient_idx = int(ingredient_idx_str)\n                  current_sim_state.inventory[ingredient_idx] -= count\n          current_sim_state.inventory[target_item_idx] += 1 # Produce the item\n          return all_planned_actions, current_sim_state\n\n      # Crafting requires a workshop\n      workshop_idx = world.cookbook.index[workshop_idx_str]\n\n      # Find a path to the workshop (agent needs to be ON the workshop location)\n      move_actions, workshop_reached_state = _find_path_and_state(\n          current_sim_state, world, target_kind_idx=workshop_idx, needs_adjacent=False)\n      \n      if move_actions is None:\n          return None, None # Cannot find path to workshop\n\n      all_planned_actions.extend(move_actions)\n      current_sim_state = workshop_reached_state\n\n      # Simulate the USE action at the workshop\n      # This action consumes ingredients from inventory and adds the crafted item\n      _, final_crafted_state = current_sim_state.step(USE)\n      all_planned_actions.append(USE)\n      \n      # Verify that crafting was successful (item count increased)\n      if final_crafted_state.inventory[target_item_idx] > current_sim_state.inventory[target_item_idx]:\n          return all_planned_actions, final_crafted_state\n      else:\n          # Crafting failed after USE (e.g., wrong workshop type, or missing ingredients)\n          return None, None\n\n  # --- Main logic for craft_v2 starts here ---\n  \n  # Get the initial state from the environment's current internal state\n  initial_state = env._current_state\n  \n  # Check if the item is already present in the initial inventory\n  if initial_state.inventory[item] > 0:\n      return [] # No actions needed if already have the item\n\n  # Start the recursive planning process.\n  # The initial `current_planner_state` is the `initial_state` from the environment.\n  # `path_visited_craft_goals` starts as an empty set.\n  planned_actions, final_simulated_state = _plan_craft_recursive(env.world, initial_state, item, set())\n\n  if planned_actions is None:\n      # If planning failed (e.g., item is impossible to craft or ingredients unreachable)\n      return [] \n  else:\n      return planned_actions", "island_id": 9, "scores": {"3": -1}}
