{"timestamp": "2025-07-25T13:52:41.161343", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Helper function for pathfinding (nested inside craft_v2)\n  # This function finds a path from start_pos to any cell from which target_kind_idx\n  # would be accessible via a 'USE' action (i.e., within 3x3 neighborhood).\n  def _find_path_actions_internal(start_pos, target_kind_idx, grid, non_grabbable_indices, action_map):\n      WIDTH, HEIGHT = grid.shape[0], grid.shape[1]\n      \n      # Find all cells where the target_kind_idx is actually present\n      target_object_locations = []\n      for r in range(WIDTH):\n          for c in range(HEIGHT):\n              if grid[r, c, target_kind_idx] > 0:\n                  target_object_locations.append((r, c))\n      \n      if not target_object_locations:\n          return [] # Target not found on grid\n\n      # Determine all valid agent positions from which the target object would be \"next_to\"\n      # (i.e., within the 3x3 neighborhood of the agent's position)\n      potential_agent_target_positions = set()\n      for tr, tc in target_object_locations:\n          for dr in [-1, 0, 1]:\n              for dc in [-1, 0, 1]:\n                  nr, nc = tr + dr, tc + dc\n                  if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n                      # Check if this potential agent position (nr, nc) is traversable\n                      is_obstacle = False\n                      for k_idx in non_grabbable_indices:\n                          if grid[nr, nc, k_idx] > 0: # If cell contains a non-grabbable item, it's an obstacle\n                              is_obstacle = True\n                              break\n                      if not is_obstacle:\n                          potential_agent_target_positions.add((nr, nc))\n      \n      if not potential_agent_target_positions: # No traversable spots next to target\n          return []\n\n      # If already at a position where target is \"next_to\", no movement is needed\n      # We check `env._current_state.next_to` as it encapsulates the actual game logic for \"next to\"\n      # This check must be done against the *current* game state.\n      # The `_find_path_actions_internal` function is called *before* actions are taken, so `env._current_state` is valid.\n      if env._current_state.next_to(target_kind_idx):\n          return []\n\n      q = collections.deque([(start_pos, [])]) # Queue: (current_position, path_actions_to_reach_here)\n      visited = {start_pos} # Set of visited positions to prevent cycles and redundant paths\n\n      while q:\n          current_pos, path_actions = q.popleft()\n          \n          # Explore neighbors (4-directional movement: UP, DOWN, LEFT, RIGHT)\n          for dr, dc, action_key in [(-1, 0, 'UP'), (1, 0, 'DOWN'), (0, -1, 'LEFT'), (0, 1, 'RIGHT')]:\n              nr, nc = current_pos[0] + dr, current_pos[1] + dc\n              \n              if 0 <= nr < WIDTH and 0 <= nc < HEIGHT and (nr, nc) not in visited:\n                  is_obstacle = False\n                  for k_idx in non_grabbable_indices:\n                      if grid[nr, nc, k_idx] > 0: # Check if the proposed next cell contains an obstacle\n                          is_obstacle = True\n                          break\n                  \n                  if not is_obstacle:\n                      # If this neighbor position is one of our desired agent target positions (where target_kind_idx is \"next_to\")\n                      if (nr, nc) in potential_agent_target_positions:\n                          return path_actions + [action_map[action_key]] # Found shortest path, return actions\n                      \n                      visited.add((nr, nc))\n                      new_path_actions = path_actions + [action_map[action_key]]\n                      q.append(((nr, nc), new_path_actions))\n      \n      return [] # No path found to any valid agent target position\n\n  total_actions_sequence = []\n\n  # Get action mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_USE = action_map['USE']\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # --- Step 1: Determine Crafting Order and Dependencies ---\n  \n  # Store parsed recipe information:\n  # {output_idx: {'ingredients': {ingredient_idx: count}, 'workshop': workshop_idx_or_None}}\n  crafting_details = {}\n  \n  # Set of all items that can be crafted (have a recipe)\n  all_craftable_items = set(cookbook.recipes.keys())\n  \n  # Populate crafting_details for all recipes in the cookbook\n  for output_idx, recipe in cookbook.recipes.items():\n      ingredients = {}\n      workshop_idx = None\n      for ing_idx_or_key, count_or_key_name in recipe.items():\n          if ing_idx_or_key == \"_key\":\n              # If the key is \"_key\", its value is the string name of the workshop (e.g., \"workshop0\")\n              workshop_idx = index[count_or_key_name] # Convert workshop name to its integer index\n          else:\n              ingredients[ing_idx_or_key] = count_or_key_name # ingredient_idx maps to its count\n      crafting_details[output_idx] = {'ingredients': ingredients, 'workshop': workshop_idx}\n  \n  # Identify all craftable items required for the target `item` (including `item` itself if craftable)\n  required_craftables = set()\n  \n  # If the target 'item' itself is a primitive, then no crafting steps are needed.\n  # We just proceed to collect primitives.\n  if item in cookbook.primitives:\n      final_craft_order = [] \n  else:\n      # Use a stack (DFS-like) to find all craftable prerequisites for the target 'item'\n      stack_prereq = [item]\n      while stack_prereq:\n          current_target = stack_prereq.pop()\n          # Add to required_craftables if it's a craftable item and not already processed\n          if current_target in all_craftable_items and current_target not in required_craftables:\n              required_craftables.add(current_target)\n              # Add all its craftable ingredients to the stack to process their dependencies\n              for ing_idx in crafting_details[current_target]['ingredients']:\n                  if ing_idx in all_craftable_items:\n                      stack_prereq.append(ing_idx)\n\n      # Perform a topological sort on the `required_craftables` to determine the correct crafting order\n      in_degree = {idx: 0 for idx in required_craftables}\n      # Calculate in-degrees for all items within the required_craftables subgraph\n      for output_idx in required_craftables:\n          for ing_idx in crafting_details[output_idx]['ingredients']:\n              if ing_idx in required_craftables: # Only count dependencies that are also in our required set\n                  in_degree[output_idx] += 1\n      \n      # Initialize queue with items that have no craftable dependencies (in-degree 0)\n      craft_queue = collections.deque()\n      for idx in required_craftables:\n          if in_degree[idx] == 0:\n              craft_queue.append(idx)\n\n      final_craft_order = []\n      while craft_queue:\n          current_craft_item = craft_queue.popleft()\n          final_craft_order.append(current_craft_item)\n\n          # For each item that depends on `current_craft_item`, decrement its in-degree\n          for dependent_item_idx in required_craftables:\n              if current_craft_item in crafting_details[dependent_item_idx]['ingredients']:\n                  in_degree[dependent_item_idx] -= 1\n                  # If a dependent item now has 0 in-degree, add it to the queue\n                  if in_degree[dependent_item_idx] == 0:\n                      craft_queue.append(dependent_item_idx)\n      \n      # The `final_craft_order` list now contains items in an order where dependencies are met first.\n      # The target `item` will be correctly placed at the end of its dependency chain if it's craftable.\n\n\n  # --- Step 2: Collect all necessary primitives ---\n  # `cookbook.primitives_for(item)` provides the total raw materials (primitives) needed for the final item\n  # and all its intermediate crafted components.\n  all_primitives_needed = cookbook.primitives_for(item)\n\n  for p_idx, p_count_needed in all_primitives_needed.items():\n      # Keep collecting until we have enough of the current primitive in inventory\n      while env._current_state.inventory[p_idx] < p_count_needed:\n          # Find a path to collect this primitive from the current agent position\n          # The grid and agent position are taken from the current environment state\n          path = _find_path_actions_internal(\n              env._current_state.pos, p_idx, env._current_state.grid,\n              non_grabbable_indices, action_map\n          )\n          \n          if not path:\n              # If no path is found, it means the primitive is either exhausted from the map\n              # or currently unreachable. We must break to avoid infinite loops.\n              break \n\n          # Execute the path actions one by one\n          for action in path:\n              _reward, _done, _obs = env.step(action)\n              total_actions_sequence.append(action)\n              if _done: # If the task finishes (e.g., max steps reached) return immediately\n                  return total_actions_sequence\n\n          # After reaching the primitive's vicinity, use the 'USE' action to collect it\n          _reward, _done, _obs = env.step(ACTION_USE)\n          total_actions_sequence.append(ACTION_USE)\n          if _done: # Check if task finished after 'USE'\n              return total_actions_sequence\n\n  # --- Step 3: Craft items in the determined order ---\n  for item_to_craft_idx in final_craft_order:\n      # If the item is already in inventory, skip crafting it\n      if env._current_state.inventory[item_to_craft_idx] > 0:\n          continue\n\n      # Get the recipe details for the current item to craft\n      recipe_details = crafting_details[item_to_craft_idx]\n      \n      # Verify that all ingredients required for this craft are present in the inventory\n      ingredients_met = True\n      for ing_idx, count in recipe_details['ingredients'].items():\n          if env._current_state.inventory[ing_idx] < count:\n              ingredients_met = False\n              break\n      \n      if not ingredients_met:\n          # This scenario should ideally not occur if the primitive collection and topological sort\n          # logic is robust. If it does, it implies an unrecoverable state for this crafting plan.\n          # Return the actions performed so far.\n          return total_actions_sequence \n\n      workshop_idx = recipe_details['workshop']\n      \n      if workshop_idx is not None: # If a specific workshop is required for crafting\n          # Find a path to the required workshop\n          path_to_workshop = _find_path_actions_internal(\n              env._current_state.pos, workshop_idx, env._current_state.grid,\n              non_grabbable_indices, action_map\n          )\n          \n          if not path_to_workshop:\n              # If no path to workshop, cannot complete this crafting step.\n              return total_actions_sequence \n          \n          # Execute path actions to reach the workshop\n          for action in path_to_workshop:\n              _reward, _done, _obs = env.step(action)\n              total_actions_sequence.append(action)\n              if _done: return total_actions_sequence\n\n          # Once next to the workshop, use the 'USE' action to craft\n          _reward, _done, _obs = env.step(ACTION_USE)\n          total_actions_sequence.append(ACTION_USE)\n          if _done: return total_actions_sequence\n\n      else: # If no specific workshop is required (e.g., \"on-person\" craft)\n          # In this case, simply perform the 'USE' action from the current position.\n          # The environment's `step` logic for `USE` is expected to handle this.\n          _reward, _done, _obs = env.step(ACTION_USE)\n          total_actions_sequence.append(ACTION_USE)\n          if _done: return total_actions_sequence\n  \n  return total_actions_sequence", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-25T13:52:41.179907", "function_name": "craft", "function_body": "    import numpy as np\n    import collections \n\n    # Constants for actions (local to function to avoid external code)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Helper function to find a path to a kind using BFS on a fixed grid.\n    # Returns a list of actions to reach a cell adjacent to the target_kind, followed by ACTION_USE.\n    # It assumes the target kind is 'collectible' or 'interactable' by being adjacent.\n    def _find_path_to_kind_from_fixed_grid(grid, start_pos, target_kind_idx, blocking_indices):\n        q = collections.deque([(start_pos, [])]) # (current_pos, path_actions)\n        visited = {start_pos}\n        width, height, _ = grid.shape\n\n        moves = [\n            ((0, -1), ACTION_UP),\n            ((0, 1), ACTION_DOWN),\n            ((-1, 0), ACTION_LEFT),\n            ((1, 0), ACTION_RIGHT),\n        ]\n\n        # Find all locations of the target kind on the grid\n        target_cells = []\n        for x in range(width):\n            for y in range(height):\n                if grid[x, y, target_kind_idx] > 0:\n                    target_cells.append((x, y))\n\n        if not target_cells:\n            # Target kind not found on the grid. This scenario implies impossibility or no path.\n            return [] \n\n        while q:\n            (curr_x, curr_y), path = q.popleft()\n\n            # Check if current position is adjacent to any target cell\n            for tx, ty in target_cells:\n                if (abs(curr_x - tx) == 1 and curr_y == ty) or \\\n                   (abs(curr_y - ty) == 1 and curr_x == tx):\n                    # Found an adjacent cell, return path to it plus USE action\n                    return path + [ACTION_USE]\n\n            for (dx, dy), action_id in moves:\n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                # Check bounds\n                if not (0 <= next_x < width and 0 <= next_y < height):\n                    continue\n\n                # Check if already visited\n                if next_pos in visited:\n                    continue\n\n                # Check for obstacles (blocking indices)\n                is_blocking = False\n                for block_idx in blocking_indices:\n                    if grid[next_x, next_y, block_idx] > 0:\n                        is_blocking = True\n                        break\n                if is_blocking:\n                    continue\n\n                visited.add(next_pos)\n                q.append((next_pos, path + [action_id]))\n        \n        return [] # No path found\n\n    # Helper function to update simulated position after a movement action\n    def _update_sim_pos(sim_pos_list_mutable, action):\n        if action == ACTION_UP:\n            sim_pos_list_mutable[1] -= 1\n        elif action == ACTION_DOWN:\n            sim_pos_list_mutable[1] += 1\n        elif action == ACTION_LEFT:\n            sim_pos_list_mutable[0] -= 1\n        elif action == ACTION_RIGHT:\n            sim_pos_list_mutable[0] += 1\n\n    # Recursive helper function to plan actions for crafting an item and its dependencies\n    # It updates the `all_actions` list, `sim_inventory`, and `sim_pos` in place.\n    def _craft_recursive(target_item_idx, all_actions_list, sim_inventory_np_array, sim_pos_list_mutable, initial_grid, cookbook, blocking_indices, env_world):\n        # Base case: Item already in simulated inventory\n        if sim_inventory_np_array[target_item_idx] > 0:\n            return\n\n        recipe = cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            # Item has no recipe (e.g., it's a primitive or an invalid item index for crafting)\n            # This indicates an inability to craft. We stop here for this branch.\n            return \n\n        ingredients = {k: v for k, v in recipe.items() if k != '_key'}\n        workshop_idx = recipe.get('_key')\n\n        # First, ensure all ingredients are gathered/crafted\n        for ing_idx, ing_count in ingredients.items():\n            while sim_inventory_np_array[ing_idx] < ing_count:\n                if ing_idx in cookbook.primitives:\n                    # Ingredient is a primitive, need to collect it\n                    path_to_collect = _find_path_to_kind_from_fixed_grid(\n                        initial_grid, \n                        tuple(sim_pos_list_mutable), # Pass current simulated position\n                        ing_idx, \n                        blocking_indices\n                    )\n                    \n                    if not path_to_collect:\n                        # Cannot find or reach the primitive, so this craft is impossible\n                        return # Propagate failure up the recursion stack\n\n                    all_actions_list.extend(path_to_collect)\n                    \n                    # Simulate movement for all actions in path except the final USE\n                    for action in path_to_collect[:-1]:\n                        _update_sim_pos(sim_pos_list_mutable, action)\n                    \n                    # Simulate inventory update: assumes the last action (USE) collected one item\n                    sim_inventory_np_array[ing_idx] += 1 \n                    # Note: We don't simulate grid depletion because initial_grid is fixed.\n                    # This relies on the environment having enough of the primitive kind or that\n                    # the specific location doesn't matter, only proximity to *any* instance.\n                else:\n                    # Ingredient is a craftable item, recurse to craft it\n                    _craft_recursive(ing_idx, all_actions_list, sim_inventory_np_array, sim_pos_list_mutable, initial_grid, cookbook, blocking_indices, env_world)\n                    \n                    # If after recursive call, we still don't have enough (e.g., sub-craft failed), propagate failure\n                    if sim_inventory_np_array[ing_idx] < ing_count:\n                        return # Cannot craft this ingredient, so cannot craft target_item_idx\n\n        # After gathering/crafting all ingredients, perform the final crafting step\n        # Check if the target_item_idx has been crafted by now (e.g. if another craft added it)\n        if sim_inventory_np_array[target_item_idx] > 0:\n            return # Already done by a parallel path or previous attempt.\n\n        if workshop_idx is not None:\n            # Crafting requires a workshop. Move to it and USE.\n            path_to_workshop = _find_path_to_kind_from_fixed_grid(\n                initial_grid,\n                tuple(sim_pos_list_mutable),\n                workshop_idx,\n                blocking_indices \n            )\n            \n            if not path_to_workshop:\n                # Cannot reach the workshop, cannot craft\n                return # Propagate failure\n\n            all_actions_list.extend(path_to_workshop)\n            # Simulate movement to workshop location\n            for action in path_to_workshop[:-1]:\n                _update_sim_pos(sim_pos_list_mutable, action)\n        else:\n            # No specific workshop required, simply perform a USE action (craft \"in place\")\n            all_actions_list.append(ACTION_USE)\n\n        # Simulate inventory update: add the crafted item, consume ingredients\n        sim_inventory_np_array[target_item_idx] += 1\n        for ing_idx, ing_count in ingredients.items():\n            sim_inventory_np_array[ing_idx] -= ing_count\n\n\n    # --- Main execution flow of craft_v2 ---\n    all_actions = []\n    \n    # Get initial state for planning\n    initial_state = env._current_state \n    \n    # Create mutable copies for simulated state that the recursive planner can update\n    sim_inventory = np.copy(initial_state.inventory)\n    sim_pos = list(initial_state.pos) # Agent's (x, y) position as a mutable list\n    initial_grid = initial_state.grid # The grid is considered static for pathfinding\n\n    cookbook = env.world.cookbook\n    env_world = env.world # Reference to CraftWorld instance for specific indices\n\n    # Identify blocking terrain types. These are usually environmental obstacles.\n    # From the DSL and `CraftWorld` attributes, `water`, `stone`, `boundary` are common obstacles.\n    blocking_indices = set()\n    blocking_indices.add(env_world.water_index) \n    \n    stone_idx = cookbook.index.get('stone')\n    if stone_idx is not None:\n        blocking_indices.add(stone_idx)\n    boundary_idx = cookbook.index.get('boundary')\n    if boundary_idx is not None:\n        blocking_indices.add(boundary_idx)\n    \n    # Start the recursive crafting process.\n    # The `all_actions`, `sim_inventory`, and `sim_pos` are modified in place by recursion.\n    _craft_recursive(item, all_actions, sim_inventory, sim_pos, initial_grid, cookbook, blocking_indices, env_world)\n    \n    return all_actions", "island_id": 8, "scores": {"3": -1}}
