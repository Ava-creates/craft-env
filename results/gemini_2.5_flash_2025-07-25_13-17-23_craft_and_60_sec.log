{"timestamp": "2025-07-25T14:53:37.390698", "function_name": "craft", "function_body": "    import numpy as np\n    import collections\n\n    # Action constants, as defined by CraftLab.action_specs\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    initial_state = env._current_state\n    cookbook = env.world.cookbook\n\n    # Initial simulated state for planning\n    # These will be updated within the recursive plan_to_obtain function\n    # The initial call will use these, and subsequent recursive calls will use the updated states.\n    simulated_inventory = initial_state.inventory.copy()\n    initial_agent_pos = initial_state.pos # Agent's current (x, y) position\n    simulated_grid = initial_state.grid.copy() # Grid is assumed static for planning of resource locations\n    \n    WIDTH, HEIGHT, N_KINDS = simulated_grid.shape\n\n    # Memoization cache for plan_to_obtain\n    # Key: (target_item_idx, tuple(current_inventory_counts), current_pos_tuple)\n    # Value: (list_of_actions, updated_inventory_tuple, new_pos_tuple)\n    memo = {} \n\n    def _find_path_to_kind_actions(start_pos, target_kind_idx, grid_data, width, height, is_workshop_target=False):\n        \"\"\"\n        Finds a sequence of actions (moves + USE) to reach and interact with a target_kind_idx.\n        \n        Args:\n            start_pos: current (x, y) of the agent.\n            target_kind_idx: integer index of the item/workshop to target.\n            grid_data: the current simulated grid (read-only for locations).\n            width, height: dimensions of the grid.\n            is_workshop_target: True if the target is a workshop (agent needs to be ON cell to USE).\n                                False if it's a grabbable item (agent needs to be ADJACENT or ON cell to USE).\n        \n        Returns:\n            A list of actions (movements followed by USE) or None if no path found.\n        \"\"\"\n        \n        kind_locations = []\n        for x in range(width):\n            for y in range(height):\n                if grid_data[x, y, target_kind_idx] > 0:\n                    kind_locations.append((x, y))\n\n        if not kind_locations:\n            return None # Target kind not found on grid\n\n        # BFS state: (current_position_tuple, list_of_actions_taken)\n        queue = collections.deque([(start_pos, [])])\n        visited = {start_pos} # Set of visited (x, y) positions to avoid cycles and redundant paths\n\n        # Possible movement directions and corresponding actions\n        # (dx, dy, action_constant)\n        moves = [\n            (0, -1, UP),    # Move Up: change in y is -1\n            (0, 1, DOWN),   # Move Down: change in y is +1\n            (-1, 0, LEFT),  # Move Left: change in x is -1\n            (1, 0, RIGHT)   # Move Right: change in x is +1\n        ]\n\n        while queue:\n            (curr_x, curr_y), path = queue.popleft()\n\n            # Check if the current position (curr_x, curr_y) allows for the USE action\n            # to interact with the target_kind_idx, based on whether it's a workshop or grabbable.\n            can_use = False\n            if is_workshop_target:\n                # For workshops, the agent typically needs to be directly ON the workshop cell.\n                if (curr_x, curr_y) in kind_locations:\n                    can_use = True\n            else:\n                # For grabbable items (like WOOD, STONE), CraftState.next_to checks a 3x3 neighborhood.\n                # So, the agent can be at the item's cell or any directly adjacent cell (including diagonals).\n                for kx, ky in kind_locations:\n                    if abs(curr_x - kx) <= 1 and abs(curr_y - ky) <= 1:\n                        can_use = True\n                        break\n            \n            if can_use:\n                return path + [USE] # Found a path, append USE action and return\n\n            # Explore neighbors for next steps in BFS\n            for dx, dy, action in moves:\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                # Check grid boundary conditions\n                if not (0 <= next_x < width and 0 <= next_y < height):\n                    continue # Out of bounds\n\n                # Check if this cell has already been visited in this BFS traversal\n                if (next_x, next_y) in visited:\n                    continue # Already processed this position in a shorter/equal path\n\n                # NOTE: No explicit check for impassable terrain (like 'BOUNDARY' kind) is added here\n                # as the problem description does not specify which kinds block movement.\n                # If such a mechanic existed, it would be added here (e.g., `if grid_data[next_x, next_y, boundary_idx] > 0: continue`).\n\n                visited.add((next_x, next_y))\n                queue.append(((next_x, next_y), path + [action]))\n        \n        return None # No path found to the target kind\n\n    def plan_to_obtain(target_item_idx, current_agent_pos_sim, current_inventory_sim, current_grid_sim):\n        \"\"\"\n        Recursively plans the actions required to obtain a specific `target_item_idx`.\n        \n        Args:\n            target_item_idx: The integer index of the item to be obtained.\n            current_agent_pos_sim: The agent's current simulated (x, y) position.\n            current_inventory_sim: The agent's current simulated inventory (numpy array).\n            current_grid_sim: The current simulated grid (read-only for locations).\n\n        Returns:\n            A tuple: (list_of_actions, updated_inventory_array, new_agent_position_tuple).\n            Returns ([], original_inventory, original_position) if the item cannot be obtained.\n        \"\"\"\n        # Create a hashable key for memoization from mutable inputs\n        inventory_key = tuple(current_inventory_sim)\n        pos_key = tuple(current_agent_pos_sim)\n        memo_key = (target_item_idx, inventory_key, pos_key)\n        \n        if memo_key in memo:\n            # If result is already memoized, return it (converting inventory tuple back to array)\n            actions, inv_tuple, pos_tuple = memo[memo_key]\n            return actions, np.array(inv_tuple), pos_tuple\n\n        actions_for_target = []\n        # Create a mutable copy of inventory for this planning branch\n        updated_inventory = current_inventory_sim.copy()\n        # The agent's position will be updated throughout this planning step\n        agent_pos_after_segment = current_agent_pos_sim \n\n        # 1. Base Case: Check if we already have the item (assuming 1 is sufficient as output of craft is 1)\n        if updated_inventory[target_item_idx] > 0:\n            memo[memo_key] = ([], tuple(updated_inventory), pos_key)\n            return [], updated_inventory, agent_pos_after_segment\n\n        # 2. Case: Target item is a primitive resource\n        if target_item_idx in cookbook.primitives:\n            # Plan actions to move to the primitive and USE it\n            path_actions = _find_path_to_kind_actions(agent_pos_after_segment, target_item_idx, current_grid_sim, WIDTH, HEIGHT, is_workshop_target=False)\n            \n            if path_actions is None:\n                # If primitive not found or reachable, this branch fails.\n                memo[memo_key] = ([], tuple(current_inventory_sim), pos_key)\n                return [], current_inventory_sim, current_agent_pos_sim # Return original state as failure\n            \n            actions_for_target.extend(path_actions)\n            updated_inventory[target_item_idx] += 1 # Simulate acquiring one unit of the primitive\n\n            # Update simulated agent position after movements (excluding the final USE action)\n            temp_pos = list(agent_pos_after_segment)\n            for action in path_actions[:-1]: # Iterate over movement actions, ignoring the last USE\n                if action == UP: temp_pos[1] -= 1\n                elif action == DOWN: temp_pos[1] += 1\n                elif action == LEFT: temp_pos[0] -= 1\n                elif action == RIGHT: temp_pos[0] += 1\n            agent_pos_after_segment = tuple(temp_pos) # Agent is now at the cell where USE was performed\n            \n            memo[memo_key] = (actions_for_target, tuple(updated_inventory), agent_pos_after_segment)\n            return actions_for_target, updated_inventory, agent_pos_after_segment\n        \n        # 3. Recursive Case: Target item is a craftable item (has a recipe)\n        recipe = cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            # Item is neither primitive nor craftable, so it cannot be obtained.\n            memo[memo_key] = ([], tuple(current_inventory_sim), pos_key)\n            return [], current_inventory_sim, current_agent_pos_sim\n\n        required_ingredients = {}\n        workshop_kind_idx = None # Integer ID of the required workshop, if any\n        for ingredient_idx_or_key, value in recipe.items():\n            if ingredient_idx_or_key == \"_key\":\n                # The value here is the string name of the workshop (e.g., \"bench\")\n                workshop_kind_idx = cookbook.index[value] \n            else:\n                required_ingredients[ingredient_idx_or_key] = value # Value is the quantity needed\n\n        # Recursively obtain all required ingredients\n        for ingredient_idx, needed_count in required_ingredients.items():\n            while updated_inventory[ingredient_idx] < needed_count:\n                # Plan to get one instance of the current ingredient\n                ing_actions, new_inv, new_pos = plan_to_obtain(ingredient_idx, agent_pos_after_segment, updated_inventory, current_grid_sim)\n                \n                if not ing_actions and updated_inventory[ingredient_idx] < needed_count:\n                    # If `plan_to_obtain` returned no actions AND we still don't have enough,\n                    # it means this ingredient cannot be obtained, so the current craft also fails.\n                    memo[memo_key] = ([], tuple(current_inventory_sim), pos_key)\n                    return [], current_inventory_sim, current_agent_pos_sim\n                \n                actions_for_target.extend(ing_actions)\n                updated_inventory = new_inv\n                agent_pos_after_segment = new_pos # Agent's position is updated after obtaining this ingredient\n\n        # All ingredients obtained. Now, perform the final crafting step.\n        if workshop_kind_idx is not None:\n            # If a workshop is required, move to it and USE it.\n            path_to_workshop_actions = _find_path_to_kind_actions(agent_pos_after_segment, workshop_kind_idx, current_grid_sim, WIDTH, HEIGHT, is_workshop_target=True)\n            \n            if path_to_workshop_actions is None:\n                # Cannot reach the required workshop, so craft fails.\n                memo[memo_key] = ([], tuple(current_inventory_sim), pos_key)\n                return [], current_inventory_sim, current_agent_pos_sim\n            \n            actions_for_target.extend(path_to_workshop_actions)\n            \n            # Update simulated agent position after movements (excluding the final USE action at workshop)\n            temp_pos = list(agent_pos_after_segment)\n            for action in path_to_workshop_actions[:-1]: # All actions except the last USE\n                if action == UP: temp_pos[1] -= 1\n                elif action == DOWN: temp_pos[1] += 1\n                elif action == LEFT: temp_pos[0] -= 1\n                elif action == RIGHT: temp_pos[0] += 1\n            agent_pos_after_segment = tuple(temp_pos) # Agent is now at the workshop cell\n        \n        # Simulate consuming ingredients and gaining the crafted item\n        for ingredient_idx, needed_count in required_ingredients.items():\n            updated_inventory[ingredient_idx] -= needed_count\n        updated_inventory[target_item_idx] += 1 # Each craft typically produces 1 unit of the output item\n\n        memo[memo_key] = (actions_for_target, tuple(updated_inventory), agent_pos_after_segment)\n        return actions_for_target, updated_inventory, agent_pos_after_segment\n\n    # Initiate the planning process from the initial environment state\n    final_actions, _, _ = plan_to_obtain(item, initial_agent_pos, simulated_inventory, simulated_grid)\n\n    return final_actions", "island_id": 9, "scores": {"3": -1}}
