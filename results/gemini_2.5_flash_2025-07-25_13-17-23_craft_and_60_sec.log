{"timestamp": "2025-07-25T13:25:08.315497", "function_name": "craft", "function_body": "    # Define action mappings based on CraftLab.action_specs\n    ACTIONS = {\n        'DOWN': 0,\n        'UP': 1,\n        'LEFT': 2,\n        'RIGHT': 3,\n        'USE': 4,\n    }\n\n    # Get initial state of the environment from the scenario\n    # This state will be mutated as we simulate actions\n    initial_state = env.scenario.init()\n    current_state = initial_state\n    \n    # This list will accumulate all actions to be returned\n    action_plan = []\n\n    # Reference to the CraftWorld object for recipes, indices etc.\n    world = env.world\n\n    def _move_to_adjacent_coords_recursive(target_coords_list, current_sim_state_ref, current_action_plan_ref):\n        \"\"\"\n        Finds the shortest path from current_sim_state_ref.pos to any cell\n        that is adjacent (3x3 neighborhood) to any of the target_coords_list.\n        Applies the path actions to current_sim_state_ref and current_action_plan_ref.\n        \"\"\"\n        \n        # BFS queue: (current_position, current_direction, path_segment_actions)\n        queue = collections.deque([(current_sim_state_ref.pos, current_sim_state_ref.dir, [])])\n        \n        # Visited set to avoid cycles and redundant paths: (position, direction)\n        visited = set()\n        visited.add((current_sim_state_ref.pos, current_sim_state_ref.dir))\n\n        shortest_path_actions = None\n        \n        while queue:\n            curr_pos, curr_dir, path_segment = queue.popleft()\n\n            # Check if current position is adjacent (within 3x3 neighborhood) to any target coordinate\n            is_adjacent = False\n            for tr, tc in target_coords_list:\n                if abs(curr_pos[0] - tr) <= 1 and abs(curr_pos[1] - tc) <= 1:\n                    is_adjacent = True\n                    break\n            \n            if is_adjacent:\n                # Found a path to an adjacent cell\n                if shortest_path_actions is None or len(path_segment) < len(shortest_path_actions):\n                    shortest_path_actions = path_segment\n                \n                # If a path of length 0 is found, it means the agent is already adjacent, which is optimal.\n                if len(path_segment) == 0:\n                    break \n\n            # Pruning: If the current path segment is already longer than or equal to\n            # the shortest path found so far, skip exploring this branch.\n            if shortest_path_actions is not None and len(path_segment) >= len(shortest_path_actions):\n                continue\n\n            # Explore possible moves (DOWN, UP, LEFT, RIGHT)\n            for action in [ACTIONS['DOWN'], ACTIONS['UP'], ACTIONS['LEFT'], ACTIONS['RIGHT']]:\n                # Create a temporary state for simulating this single step.\n                # It must reflect the state (position, direction, inventory, grid)\n                # at the start of this BFS path segment.\n                temp_sim_state_for_step = current_sim_state_ref._scenario.init()\n                temp_sim_state_for_step.pos = curr_pos\n                temp_sim_state_for_step.dir = curr_dir\n                # Copy current overall inventory and grid for path validity (e.g., needing axe to break wood)\n                temp_sim_state_for_step.inventory = current_sim_state_ref.inventory.copy() \n                temp_sim_state_for_step.grid = current_sim_state_ref.grid.copy()\n\n                # Simulate the step using the temporary state. `step` returns (reward, new_state_object).\n                _, next_temp_sim_state = temp_sim_state_for_step.step(action)\n                next_pos = next_temp_sim_state.pos\n                next_dir = next_temp_sim_state.dir\n\n                if (next_pos, next_dir) not in visited:\n                    visited.add((next_pos, next_dir))\n                    queue.append((next_pos, next_dir, path_segment + [action]))\n\n        if shortest_path_actions is None:\n            # If no path found, this indicates an unsolvable state given current resources/map.\n            # The problem description implies that goals are always achievable.\n            raise ValueError(f\"No path found to target coordinates: {target_coords_list}\")\n        \n        # Apply the determined shortest path actions to the actual current_sim_state_ref\n        # and accumulate them in the global action_plan.\n        for action in shortest_path_actions:\n            current_action_plan_ref.append(action)\n            # Update current_sim_state_ref by stepping it\n            _, new_state = current_sim_state_ref.step(action)\n            # Update the existing current_sim_state_ref object with attributes from the new_state object\n            current_sim_state_ref.__dict__.update(new_state.__dict__) \n\n    def _move_to_kind_recursive(target_kind_idx, current_sim_state_ref, current_action_plan_ref):\n        \"\"\"\n        Moves the agent to be adjacent to an object of the specified kind (e.g., a workshop, wood).\n        \"\"\"\n        target_coords_on_grid = []\n        grid_h, grid_w, _ = current_sim_state_ref.grid.shape\n        for r in range(grid_h):\n            for c in range(grid_w):\n                # Check if the cell contains the target kind\n                if current_sim_state_ref.grid[r, c, target_kind_idx] == 1:\n                    target_coords_on_grid.append((r, c))\n        \n        if not target_coords_on_grid:\n            kind_name = world.cookbook.index.get(target_kind_idx)\n            raise ValueError(f\"Target kind '{kind_name}' (ID: {target_kind_idx}) not found on grid.\")\n\n        _move_to_adjacent_coords_recursive(target_coords_on_grid, current_sim_state_ref, current_action_plan_ref)\n\n    def _collect_primitive_recursive(primitive_idx, current_sim_state_ref, current_action_plan_ref):\n        \"\"\"\n        Collects a single unit of a primitive item.\n        \"\"\"\n        # If we already have the primitive, nothing to do for this call\n        if current_sim_state_ref.inventory[primitive_idx] > 0:\n            return\n\n        # Find where the primitive is located on the grid\n        target_coords_on_grid = []\n        grid_h, grid_w, _ = current_sim_state_ref.grid.shape\n        for r in range(grid_h):\n            for c in range(grid_w):\n                if current_sim_state_ref.grid[r, c, primitive_idx] == 1:\n                    target_coords_on_grid.append((r, c))\n        \n        if not target_coords_on_grid:\n            primitive_name = world.cookbook.index.get(primitive_idx)\n            raise ValueError(f\"Primitive '{primitive_name}' (ID: {primitive_idx}) not found on grid!\")\n        \n        # Move the agent to be adjacent to the primitive\n        _move_to_adjacent_coords_recursive(target_coords_on_grid, current_sim_state_ref, current_action_plan_ref)\n\n        # Perform the USE action to collect the primitive\n        current_action_plan_ref.append(ACTIONS['USE'])\n        _, new_state = current_sim_state_ref.step(ACTIONS['USE'])\n        current_sim_state_ref.__dict__.update(new_state.__dict__)\n\n    def _craft_recursive(target_item_idx, current_sim_state_ref, current_action_plan_ref):\n        \"\"\"\n        Recursively determines actions to craft a target item.\n        \"\"\"\n        # Base case: If the item is already in inventory, no further actions needed for this item in this call.\n        if current_sim_state_ref.inventory[target_item_idx] > 0:\n            return\n\n        recipe = world.cookbook.recipes.get(target_item_idx)\n\n        if recipe is None:\n            # If no recipe, it's a primitive item that needs to be collected\n            _collect_primitive_recursive(target_item_idx, current_sim_state_ref, current_action_plan_ref)\n            return\n        \n        # Recursive step: Gather all required ingredients\n        for ing_idx, count in recipe.items():\n            if ing_idx == \"_key\":\n                continue # Skip workshop key, it's not an ingredient\n\n            num_have = current_sim_state_ref.inventory[ing_idx]\n            num_to_get = count - num_have\n\n            for _ in range(num_to_get):\n                # Recursively call _craft_recursive for each missing unit of the ingredient.\n                # After this call, the ingredient should have been acquired and added to inventory.\n                _craft_recursive(ing_idx, current_sim_state_ref, current_action_plan_ref)\n                \n                # Check if sufficient amount of the current ingredient is now in inventory\n                # This handles cases where _craft_recursive might yield more than one item\n                # or if an earlier recursive call satisfied part of the need.\n                if current_sim_state_ref.inventory[ing_idx] >= count: \n                    break # Stop trying to collect more of this specific ingredient\n\n        # After all ingredients are (theoretically) in inventory, move to the required workshop if any\n        workshop_key_idx = recipe.get(\"_key\")\n        if workshop_key_idx is not None:\n            _move_to_kind_recursive(workshop_key_idx, current_sim_state_ref, current_action_plan_ref)\n\n        # Perform the crafting action (USE)\n        current_action_plan_ref.append(ACTIONS['USE'])\n        _, new_state = current_sim_state_ref.step(ACTIONS['USE'])\n        current_sim_state_ref.__dict__.update(new_state.__dict__) # Update the current simulated state\n\n    # Start the recursive crafting process for the target item\n    _craft_recursive(item, current_state, action_plan)\n\n    return action_plan", "island_id": 7, "scores": {"3": -1}}
