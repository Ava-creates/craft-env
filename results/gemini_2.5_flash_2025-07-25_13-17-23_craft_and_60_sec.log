{"timestamp": "2025-07-25T14:59:19.245764", "function_name": "craft", "function_body": "  import numpy as np\n  from collections import deque\n\n  # Internal action map, specific to this call of craft_v2\n  action_map = None\n\n  def _init_action_map_internal():\n      \"\"\"Initializes the action map from the environment's action_specs.\"\"\"\n      nonlocal action_map\n      if action_map is None:\n          action_map = {name: val for name, val in env.action_specs().items()}\n\n  def _get_action_internal(name):\n      \"\"\"Helper to get integer action value from its string name.\"\"\"\n      return action_map[name]\n\n  def _find_path_to_kind_internal(current_state, target_kind_idx, world_cookbook, require_adjacent=True):\n      \"\"\"\n      Finds a path of movement actions to get adjacent to (or on) target_kind_idx.\n      Uses BFS to find the shortest path in terms of actions.\n      Args:\n          current_state: The starting CraftState.\n          target_kind_idx: The index of the kind to reach.\n          world_cookbook: The Cookbook instance (not directly used in this helper but passed for consistency).\n          require_adjacent: If True, find path to be in 3x3 neighborhood. If False, find path to be *on* the cell.\n      Returns:\n          (list of int actions, final_CraftState after moves) or (None, None) if no path.\n      \"\"\"\n      q = deque([(current_state, [])]) # (CraftState, actions_list_so_far)\n      # visited set stores a hashable representation of the state to prevent cycles and redundant exploration.\n      # State key: (pos_tuple, dir, inventory_tuple)\n      visited = set() \n\n      initial_state_key = (current_state.pos, current_state.dir, tuple(current_state.inventory))\n      visited.add(initial_state_key)\n\n      while q:\n          state, path_actions = q.popleft()\n\n          # Check if goal is met\n          is_goal_met = False\n          if require_adjacent:\n              is_goal_met = state.next_to(target_kind_idx)\n          else:\n              # Check if current position contains target_kind_idx\n              x, y = state.pos\n              # Ensure index is within grid bounds (state.grid should already be valid)\n              if 0 <= x < state.grid.shape[0] and 0 <= y < state.grid.shape[1]:\n                  is_goal_met = state.grid[x, y, target_kind_idx] > 0\n          \n          if is_goal_met:\n              return path_actions, state\n\n          # Explore possible next states via movement actions\n          for action_name in ['DOWN', 'UP', 'LEFT', 'RIGHT']:\n              action_val = _get_action_internal(action_name)\n              \n              # Simulate the step using the current state's step method.\n              # CraftState.step creates a new instance, which is safe for simulation without side effects.\n              _reward, next_state = state.step(action_val)\n\n              # Create state key for visited set.\n              next_state_key = (next_state.pos, next_state.dir, tuple(next_state.inventory))\n              if next_state_key not in visited:\n                  visited.add(next_state_key)\n                  q.append((next_state, path_actions + [action_val]))\n      \n      return None, None # No path found\n\n  def _collect_and_craft_internal(current_state, target_item_idx, world_cookbook):\n      \"\"\"\n      Recursively plans actions to get target_item_idx.\n      Args:\n          current_state: The starting CraftState for this planning step. This state will be used as the\n                         basis for simulated actions and subsequent recursive calls.\n          target_item_idx: The index of the item we want to get.\n          world_cookbook: The Cookbook instance for recipes and primitives.\n      Returns: \n          (list of int actions to take, final_CraftState after actions) or (None, None) if impossible.\n          The returned CraftState is the final state after applying the actions in the list.\n      \"\"\"\n      # Base case: Item already in inventory\n      if current_state.inventory[target_item_idx] > 0:\n          return [], current_state\n      \n      total_actions = []\n      \n      # Case 1: Target item is a primitive (can be collected)\n      if target_item_idx in world_cookbook.primitives:\n          path_moves, final_move_state = _find_path_to_kind_internal(current_state, target_item_idx, world_cookbook, require_adjacent=True)\n          if path_moves is None:\n              return None, None # Cannot reach primitive\n          \n          total_actions.extend(path_moves)\n          \n          # Simulate the state after moving to the primitive\n          current_state_for_planning = final_move_state \n\n          # Use action to collect the primitive\n          initial_target_item_count = current_state_for_planning.inventory[target_item_idx]\n          _reward, collected_state = current_state_for_planning.step(_get_action_internal('USE'))\n          \n          # Verify collection: if inventory count didn't increase, it failed.\n          if collected_state.inventory[target_item_idx] <= initial_target_item_count:\n               return None, None # USE action failed to collect the item (e.g., not a grabbable primitive, or requires tool)\n\n          total_actions.append(_get_action_internal('USE'))\n          return total_actions, collected_state\n\n      # Case 2: Target item has a recipe (must be crafted)\n      elif target_item_idx in world_cookbook.recipes:\n          recipe = world_cookbook.recipes[target_item_idx]\n          \n          required_ingredients = {}\n          required_workshop_idx = None # Store int index of workshop\n\n          for key, count in recipe.items():\n              if key == \"_key\": \n                  # The value associated with \"_key\" is the *name* of the workshop, e.g., \"workbench\"\n                  workshop_name = count \n                  required_workshop_idx = world_cookbook.index[workshop_name]\n              else:\n                  required_ingredients[key] = count # key is ingredient_index, count is quantity\n\n          current_planning_state = current_state # This will be the evolving state during ingredient collection\n\n          # First, collect all ingredients\n          for ingredient_idx, required_count in required_ingredients.items():\n              while current_planning_state.inventory[ingredient_idx] < required_count:\n                  # Recursively plan to get one more of this ingredient\n                  # Pass the current_planning_state to the recursive call, which will simulate from there\n                  actions_to_get_one, state_after_getting_one = _collect_and_craft_internal(current_planning_state, ingredient_idx, world_cookbook)\n                  \n                  if actions_to_get_one is None:\n                      return None, None # Cannot get this ingredient\n                  \n                  total_actions.extend(actions_to_get_one)\n                  current_planning_state = state_after_getting_one\n          \n          # Now all ingredients are gathered in current_planning_state's inventory.\n          # Move to workshop if required, then USE.\n          if required_workshop_idx is not None:\n              path_moves, final_move_state = _find_path_to_kind_internal(current_planning_state, required_workshop_idx, world_cookbook, require_adjacent=True)\n              if path_moves is None:\n                  return None, None # Cannot reach workshop\n              \n              total_actions.extend(path_moves)\n              current_planning_state = final_move_state\n          \n          # Craft the item using USE action\n          # Store initial inventory of target item to check if it increased\n          initial_target_item_count = current_planning_state.inventory[target_item_idx]\n\n          _reward, crafted_state = current_planning_state.step(_get_action_internal('USE'))\n          \n          if crafted_state.inventory[target_item_idx] <= initial_target_item_count:\n              # Crafting failed (item count did not increase). Likely missing ingredients or wrong workshop.\n              return None, None\n          \n          total_actions.append(_get_action_internal('USE'))\n          return total_actions, crafted_state\n\n      # Case 3: Item is not a primitive and has no recipe -> cannot be obtained by crafting/collecting\n      return None, None\n\n  # --- Main logic for craft_v2 ---\n  _init_action_map_internal() # Ensure action mappings are initialized\n\n  # Get the initial state from the environment. The `solve` function calls `env.reset()` first,\n  # so `env._current_state` holds the initial state for planning.\n  initial_state = env._current_state\n  world_cookbook = env.world.cookbook\n\n  # Start the recursive planning process\n  # The initial_state is passed to the planner, which will simulate actions and return a final state.\n  actions, final_state_after_plan = _collect_and_craft_internal(initial_state, item, world_cookbook)\n\n  if actions is None:\n      # If planning fails (e.g., item is impossible to craft/collect), return an empty list of actions.\n      return [] \n  else:\n      return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-25T14:59:19.264224", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Actions as defined by env.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    def _get_neighbors_and_actions(r, c, grid_shape):\n        \"\"\"Returns a list of tuples ((neighbor_r, neighbor_c), action_to_take) for valid moves.\"\"\"\n        neighbors = []\n        rows, cols, _ = grid_shape\n        if r > 0: neighbors.append(((r - 1, c), ACTION_UP))\n        if r < rows - 1: neighbors.append(((r + 1, c), ACTION_DOWN))\n        if c > 0: neighbors.append(((r, c - 1), ACTION_LEFT))\n        if c < cols - 1: neighbors.append(((r, c + 1), ACTION_RIGHT))\n        return neighbors\n\n    def _get_path_actions(start_pos, target_pos, current_grid, world_info, max_path_len=100):\n        \"\"\"\n        Finds a path from start_pos to target_pos (on the cell) using BFS.\n        Returns a list of actions to take, or None if no path found.\n        \"\"\"\n        q = collections.deque([(start_pos, [])])  # (current_pos, actions_taken)\n        visited = {start_pos}\n\n        rows, cols, _ = current_grid.shape\n        cookbook_index = world_info['cookbook'].index\n        boundary_idx = cookbook_index['boundary'] if 'boundary' in cookbook_index.contents else -1\n\n        while q:\n            (r, c), actions = q.popleft()\n\n            if (r, c) == target_pos:\n                return actions\n\n            if len(actions) >= max_path_len: # Prevent excessively long paths or infinite loops\n                continue\n\n            for next_pos, action_to_take in _get_neighbors_and_actions(r, c, current_grid.shape):\n                nr, nc = next_pos\n                if next_pos not in visited:\n                    is_obstacle = False\n                    # Avoid moving into 'boundary' cells. Other non-grabbables like workshops are traversable.\n                    if boundary_idx != -1 and current_grid[nr, nc, boundary_idx] > 0:\n                        is_obstacle = True\n                    \n                    if not is_obstacle:\n                        visited.add(next_pos)\n                        q.append((next_pos, actions + [action_to_take]))\n        return None\n\n    def _get_path_actions_to_be_next_to(start_pos, target_pos, current_grid, world_info, max_path_len=100):\n        \"\"\"\n        Finds a path from start_pos to a cell adjacent to target_pos using BFS.\n        Returns a list of actions to take, or None if no path found.\n        \"\"\"\n        q = collections.deque([(start_pos, [])])\n        visited = {start_pos}\n\n        rows, cols, _ = current_grid.shape\n        cookbook_index = world_info['cookbook'].index\n        boundary_idx = cookbook_index['boundary'] if 'boundary' in cookbook_index.contents else -1\n\n        while q:\n            (r, c), actions = q.popleft()\n\n            # Check if current position is adjacent to target_pos\n            for dr, dc in [(-1,0), (1,0), (0,-1), (0,1)]:\n                if (r + dr, c + dc) == target_pos:\n                    return actions # Actions to reach (r,c), which is adjacent to target_pos\n\n            if len(actions) >= max_path_len:\n                continue\n\n            for next_pos, action_to_take in _get_neighbors_and_actions(r, c, current_grid.shape):\n                nr, nc = next_pos\n                if next_pos not in visited:\n                    is_obstacle = False\n                    if boundary_idx != -1 and current_grid[nr, nc, boundary_idx] > 0:\n                        is_obstacle = True\n                    \n                    if not is_obstacle:\n                        visited.add(next_pos)\n                        q.append((next_pos, actions + [action_to_take]))\n        return None\n\n    def _find_closest_target_on_grid(start_pos, target_kind_idx, current_grid, world_info, max_search_dist=50):\n        \"\"\"\n        Performs a BFS-like search to find the closest cell containing `target_kind_idx`.\n        Returns (r, c) of the found target, or None if not found within max_search_dist.\n        \"\"\"\n        q_find = collections.deque([(start_pos, 0)]) # (r, c, dist)\n        visited_find = {start_pos}\n        \n        rows, cols, _ = current_grid.shape\n        cookbook_index = world_info['cookbook'].index\n        boundary_idx = cookbook_index['boundary'] if 'boundary' in cookbook_index.contents else -1\n\n        while q_find:\n            r, c, dist = q_find.popleft()\n\n            if dist > max_search_dist:\n                continue\n\n            if current_grid[r, c, target_kind_idx] > 0: # Found an instance\n                return (r, c)\n\n            for next_pos, _ in _get_neighbors_and_actions(r, c, current_grid.shape):\n                nr, nc = next_pos\n                if next_pos not in visited_find:\n                    is_obstacle = False\n                    if boundary_idx != -1 and current_grid[nr, nc, boundary_idx] > 0:\n                        is_obstacle = True\n                    \n                    if not is_obstacle:\n                        visited_find.add(next_pos)\n                        q_find.append((nr, nc, dist + 1))\n        return None\n\n    all_actions = []\n    initial_state = env._current_state\n    cookbook = env.world.cookbook\n    world_info = {\n        'cookbook': cookbook,\n    }\n\n    # Planner's conceptual state, modified by recursive calls\n    current_inventory = initial_state.inventory.copy()\n    current_pos_ref = list(initial_state.pos) # Use a mutable list [r, c] for current position\n    current_grid_ref = initial_state.grid.copy() # Make a copy to modify virtually (e.g., consume resources)\n\n    # Recursive function to plan for acquiring a single instance of an item\n    def _plan_for_item(item_idx):\n        nonlocal current_inventory, current_pos_ref, current_grid_ref, all_actions\n\n        # If item is a primitive (collectable directly from grid)\n        if item_idx in cookbook.primitives:\n            # Find the closest instance of the primitive on the grid\n            target_location = _find_closest_target_on_grid(tuple(current_pos_ref), item_idx, current_grid_ref, world_info)\n            if target_location is None:\n                # Cannot find this primitive on the grid, so cannot obtain it.\n                return False \n\n            # Get actions to move to the primitive's location\n            path_actions = _get_path_actions(tuple(current_pos_ref), target_location, current_grid_ref, world_info)\n            if path_actions is None:\n                # Cannot path to the primitive.\n                return False\n\n            all_actions.extend(path_actions)\n            # Update planner's conceptual position after pathing\n            sim_r, sim_c = current_pos_ref[0], current_pos_ref[1]\n            for action in path_actions:\n                if action == ACTION_UP: sim_r -= 1\n                elif action == ACTION_DOWN: sim_r += 1\n                elif action == ACTION_LEFT: sim_c -= 1\n                elif action == ACTION_RIGHT: sim_c += 1\n            current_pos_ref[0], current_pos_ref[1] = sim_r, sim_c\n            \n            # After reaching, perform USE action to collect\n            all_actions.append(ACTION_USE)\n            current_inventory[item_idx] += 1\n            \n            # Conceptually remove the item from the grid for planning (assumes finite resources)\n            # This is crucial for planning to collect multiple items of the same type or for subsequent crafting attempts.\n            current_grid_ref[target_location[0], target_location[1], item_idx] = 0\n            \n            return True\n\n        # If item is craftable (has a recipe)\n        elif item_idx in cookbook.recipes:\n            recipe = cookbook.recipes[item_idx]\n            \n            # Recursively acquire all necessary ingredients\n            for ing_idx, count in recipe.items():\n                if ing_idx == '_key': # Skip workshop key\n                    continue\n                \n                needed = count - current_inventory[ing_idx]\n                for _ in range(needed):\n                    if not _plan_for_item(ing_idx):\n                        # If an ingredient cannot be obtained, this item cannot be crafted.\n                        return False\n            \n            # If a workshop is required, move next to it\n            workshop_key = recipe.get('_key')\n            if workshop_key is not None:\n                workshop_idx = cookbook.index[workshop_key]\n                \n                # Find the closest workshop on the grid\n                workshop_location = _find_closest_target_on_grid(tuple(current_pos_ref), workshop_idx, current_grid_ref, world_info)\n                if workshop_location is None:\n                    # Cannot find the required workshop.\n                    return False\n                \n                # Get actions to move adjacent to the workshop\n                path_actions = _get_path_actions_to_be_next_to(tuple(current_pos_ref), workshop_location, current_grid_ref, world_info)\n                if path_actions is None:\n                    # Cannot path to be next to the workshop.\n                    return False\n                \n                all_actions.extend(path_actions)\n                # Update planner's conceptual position\n                sim_r, sim_c = current_pos_ref[0], current_pos_ref[1]\n                for action in path_actions:\n                    if action == ACTION_UP: sim_r -= 1\n                    elif action == ACTION_DOWN: sim_r += 1\n                    elif action == ACTION_LEFT: sim_c -= 1\n                    elif action == ACTION_RIGHT: sim_c += 1\n                current_pos_ref[0], current_pos_ref[1] = sim_r, sim_c\n\n            # Consume ingredients from inventory (virtually)\n            for ing_idx, count in recipe.items():\n                if ing_idx == '_key':\n                    continue\n                current_inventory[ing_idx] -= count\n            \n            # Perform USE action for crafting\n            all_actions.append(ACTION_USE)\n            current_inventory[item_idx] += 1 # Add crafted item to inventory\n            \n            return True\n        else:\n            # Item is neither primitive nor craftable (e.g., environment item like boundary, water)\n            # This indicates an invalid item_idx for crafting.\n            return False\n\n    # Start the planning process for the target item\n    # The task asks to \"craft the item\", implying we need to produce at least one instance.\n    if not _plan_for_item(item_to_craft_idx):\n        # If planning failed at any point (e.g., cannot find resource/workshop, or pathing failed),\n        # return an empty list of actions to indicate failure.\n        return []\n\n    return all_actions", "island_id": 4, "scores": {"3": -1}}
