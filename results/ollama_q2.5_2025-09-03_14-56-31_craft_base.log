{"timestamp": "2025-09-04T14:32:20.270481", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def get_closest_workshop_and_target():\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      nearest_target_pos = None\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  \n              # Find the nearest position to any cell of the current workshop\n              min_nearest_distance = float('inf')\n              nearest_target_pos = None\n              for target_pos in workshop_pos_list:\n                  distance_to_target = np.linalg.norm(pos - target_pos, ord=2)\n                  if distance_to_target < min_nearest_distance:\n                      nearest_target_pos = target_pos\n                      min_nearest_distance = distance_to_target\n\n              # Update the closest workshop if the nearest target position is closer than any previously found\n              if min_nearest_distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  min_distance = min_nearest_distance\n\n      return closest_workshop_idx, nearest_target_pos\n\n  closest_workshop_idx, nearest_target_pos = get_closest_workshop_and_target()\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the nearest target position of the closest workshop\n  pos = np.array(env._current_state.pos)\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n\n      actions.append(direction)\n\n      if abs(dx) >= abs(dy):  \n          pos[0] += 1 if dx > 0 else -1\n      else:  \n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  \n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:32:22.286818", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def get_closest_workshop_and_target():\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      nearest_target_pos = None\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  \n              # Find the nearest position to any cell of the current workshop\n              min_nearest_distance = float('inf')\n              nearest_target_pos = None\n              for target_pos in workshop_pos_list:\n                  distance_to_target = np.linalg.norm(pos - target_pos, ord=2)\n                  if distance_to_target < min_nearest_distance:\n                      nearest_target_pos = target_pos\n                      min_nearest_distance = distance_to_target\n\n              # Update the closest workshop if the nearest target position is closer than any previously found\n              if min_nearest_distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  min_distance = min_nearest_distance\n\n      return closest_workshop_idx, nearest_target_pos\n\n  closest_workshop_idx, nearest_target_pos = get_closest_workshop_and_target()\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the nearest target position of the closest workshop\n  pos = np.array(env._current_state.pos)\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n\n      actions.append(direction)\n      \n      if abs(dx) >= abs(dy):  \n          pos[0] += 1 if dx > 0 else -1\n      else:  \n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  \n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:33:58.468585", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using a more efficient pathfinding algorithm (A*)\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def astar(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(pos): float('inf') for pos in np.argwhere(env._current_state.grid)}\n      g_score[tuple(start)] = 0\n      f_score = {tuple(pos): float('inf') for pos in np.argwhere(env._current_state.grid)}\n      f_score[tuple(start)] = heuristic(start, goal)\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if tuple(current) == tuple(goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.reverse()\n              return path\n\n          for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if not env._current_state.grid[neighbor].any():  # Check if the neighbor is walkable\n                  continue\n\n              tentative_g_score = g_score[tuple(current)] + 1\n\n              if tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[tuple(neighbor)], neighbor))\n\n      return None\n\n  path = astar(tuple(pos), tuple(nearest_target_pos))\n  \n  if not path:\n      raise ValueError(\"No valid path to workshop found\")\n\n  # Convert the path into actions\n  for next_pos in path[1:]:\n      dx, dy = np.array(next_pos) - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-04T14:38:58.520686", "function_name": "craft", "function_body": "  def move_towards(pos: np.ndarray, target_pos: np.ndarray, actions: list[int]):\n      dx, dy = target_pos - pos\n      while not np.array_equal(pos, target_pos):\n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n              dx -= 1 if dx > 0 else (1 if dx < 0 else 0)\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n              dy -= 1 if dy > 0 else (1 if dy < 0 else 0)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  move_towards(pos, nearest_target_pos, actions)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
