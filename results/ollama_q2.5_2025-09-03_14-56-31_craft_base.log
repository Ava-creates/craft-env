  min_distance = float('inf')\n    nearest_target_pos = None\n\n    for pos in target_positions:\n        distance = np.linalg.norm(current_pos - pos, ord=2)\n        if distance < min_distance:\n            nearest_target_pos = pos\n            min_distance = distance\n    \n    return nearest_target_pos\n  \n  nearest_target_pos = find_nearest_target_position(target_positions, env._current_state.pos)\n\n  # Move to the closest workshop position\n  actions = move_towards(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": 0.5}}
