dx) >= abs(dy):  \n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:43:55.283468", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to(target_pos, current_pos):\n    while not np.array_equal(current_pos, target_pos):\n        dx, dy = target_pos - current_pos\n        direction = get_direction(dx, dy)\n        actions.append(direction)\n\n        if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n            current_pos[0] += 1 if dx > 0 else -1\n        else:  # Then move in y-direction\n            current_pos[1] += 1 if dy > 0 else -1\n\n    actions.append(4)  # USE after reaching the target position\n\n  closest_workshop = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip if no workshops of this type\n          continue\n\n      nearest_target_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - env._current_state.pos))\n      \n      distance = np.linalg.norm(np.array(nearest_target_pos) - env._current_state.pos)\n      if distance < min_distance:\n          closest_workshop = nearest_target_pos\n          min_distance = distance\n\n  # Move to the closest workshop and use it\n  if closest_workshop is not None:\n      move_to(closest_workshop, np.array(env._current_state.pos))\n  else:\n      raise ValueError(\"No available workshop found\")\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:43:56.537195", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to(target_pos, current_pos):\n    path = []\n    while not np.array_equal(current_pos, target_pos):\n        dx, dy = target_pos - current_pos\n        direction = get_direction(dx, dy)\n        path.append(direction)\n        if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n            current_pos[0] += 1 if dx > 0 else -1\n        else:  # Then move in y-direction\n            current_pos[1] += 1 if dy > 0 else -1\n    actions.extend(path)\n  \n  closest_workshop = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      # If there are no workshops of this type, skip to the next one\n      if len(workshop_positions) == 0:\n          continue\n\n      # Find the nearest workshop of this type\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - env._current_state.pos)\n          if distance < min_distance:\n              closest_workshop = pos\n              min_distance = distance\n\n  # Move to the closest workshop and use it\n  if closest_workshop is not None:\n      move_to(closest_workshop, np.array(env._current_state.pos))\n      actions.append(4)  # USE\n  else:\n      raise ValueError(\"No available workshop found\")\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:44:54.617483", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_pos, min_distance = None, float('inf')\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  nearest_workshop_pos = target_pos\n                  min_distance = distance\n\n          while not np.array_equal(pos, nearest_workshop_pos):\n              dx, dy = nearest_workshop_pos - pos\n              direction = get_direction(dx, dy)\n              actions.append(direction)\n              if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n                  pos[0] += 1 if dx > 0 else -1\n              else:  # Then move in y-direction\n                  pos[1] += 1 if dy > 0 else -1\n\n          actions.append(4)  # USE\n          break\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:44:56.499458", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  nearest_workshop_pos = target_pos\n                  min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Calculate next position based on the chosen direction\n      if direction == 0:\n          pos[1] -= 1\n      elif direction == 1:\n          pos[1] += 1\n      elif direction == 2:\n          pos[0] -= 1\n      elif direction == 3:\n          pos[0] += 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:46:24.408272", "function_name": "craft", "function_body": "  def find_closest_workshop_position(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) == 0:\n          return None, float('inf')\n      nearest_target_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x, ord=2))\n      distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n      return nearest_target_pos, distance\n\n  def move_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          # Prioritize moving in the direction with the largest absolute difference\n          if abs(dx) > abs(dy):  # Move in x-direction first\n              dir_x = 3 if dx > 0 else 2\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx):  # Then move in y-direction\n              dir_y = 1 if dy > 0 else 0\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n          else:  # If dx == dy, choose a direction arbitrarily\n              dir_xy = (3 if dx > 0 else 2) if abs(dx) > abs(dy) else (1 if dy > 0 else 0)\n              actions.append(dir_xy)\n              pos[0] += 1 if dx > 0 else -1 if dx < 0 else 0\n              pos[1] += 1 if dy > 0 else -1 if dy < 0 else 0\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      nearest_target_pos, distance = find_closest_workshop_position(workshop_idx)\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos, _ = find_closest_workshop_position(closest_workshop_idx)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available target position found\")\n\n  # Move to the closest workshop position\n  actions_to_move = move_to(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions_to_move.append(4)  # USE\n  \n  return actions_to_move", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:46:26.292388", "function_name": "craft", "function_body": "  def find_closest_workshop_position(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) == 0:\n          return None, float('inf')\n      nearest_target_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x, ord=2))\n      distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n      return nearest_target_pos, distance\n\n  def move_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              if dir_x is not None:\n                  actions.append(dir_x)\n                  pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              if dir_y is not None:\n                  actions.append(dir_y)\n                  pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      nearest_target_pos, distance = find_closest_workshop_position(workshop_idx)\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos, _ = find_closest_workshop_position(closest_workshop_idx)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available target position found\")\n\n  # Move to the closest workshop position\n  actions_to_move = move_to(nearest_target_pos)\n  \n  # Check if already at a workshop and next to it\n  current_pos = env._current_state.pos\n  current_grid = env._current_state.grid\n  \n  # Check adjacent cells for any workshop of interest\n  adjacent_positions = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  adjacent_workshops = [pos for dx, dy in adjacent_positions if \n                        0 <= current_pos[0] + dx < current_grid.shape[0] and \n                        0 <= current_pos[1] + dy < current_grid.shape[1] and \n                        current_grid[current_pos[0] + dx, current_pos[1] + dy, closest_workshop_idx]]\n\n  if adjacent_workshops:\n      # If already next to a workshop, no need to move\n      actions_to_move = []\n  \n  # Use the workshop to craft the item\n  actions_to_move.append(4)  # USE\n  \n  return actions_to_move", "island_id": 0, "scores": {"": 0.5}}
