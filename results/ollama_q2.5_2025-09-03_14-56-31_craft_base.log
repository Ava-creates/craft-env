f dy < 0 else None)\n          if dir_y is not None:\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T01:57:55.868125", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Determine the step to take\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          step_x = 1 if dx > 0 else -1\n          pos[0] += step_x\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          step_y = 1 if dy > 0 else -1\n          pos[1] += step_y\n\n      # Handle boundary conditions to prevent out-of-bounds movement\n      pos = np.clip(pos, [0, 0], [env._current_state.grid.shape[0]-1, env._current_state.grid.shape[1]-1])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T01:57:57.743116", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Determine the step to take\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          step_x = 1 if dx > 0 else -1\n          new_pos = np.array([pos[0] + step_x, pos[1]])\n          if not env._current_state.next_to_boundary(new_pos):\n              pos[0] += step_x\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          step_y = 1 if dy > 0 else -1\n          new_pos = np.array([pos[0], pos[1] + step_y])\n          if not env._current_state.next_to_boundary(new_pos):\n              pos[1] += step_y\n\n      # Handle boundary conditions to prevent out-of-bounds movement\n      pos = np.clip(pos, [0, 0], [env._current_state.grid.shape[0]-1, env._current_state.grid.shape[1]-1])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-04T01:59:41.078254", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move in x-direction first, then y-direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n  \n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  target_positions = []\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_positions.extend(workshop_pos_list)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = None\n  min_distance = float('inf')\n  \n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_distance:\n          nearest_target_pos = target_pos\n          min_distance = distance\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T01:59:42.959531", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move in x-direction first, then y-direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n  \n  def calculate_nearest_target(pos, target_positions):\n      nearest_target_pos = None\n      min_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n\n      return nearest_target_pos\n  \n  closest_workshop_idx = None\n  nearest_target_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_target = calculate_nearest_target(pos, workshop_pos_list)\n          distance = np.linalg.norm(pos - nearest_workshop_target, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = nearest_workshop_target\n              min_distance = distance\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T02:01:09.440756", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_pos = min(\n              workshop_positions, key=lambda p: np.linalg.norm(current_pos - p)\n          )\n          distance = np.linalg.norm(current_pos - nearest_workshop_pos)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = nearest_workshop_pos\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          current_pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Turn to face the workshop if necessary\n  target_dir = (np.arctan2(nearest_target_pos[1] - current_pos[1], nearest_target_pos[0] - current_pos[0]) * 180 / np.pi) % 360 // 90\n  while env._current_state.dir != target_dir:\n      actions.append(2 if (env._current_state.dir - target_dir) % 4 == 1 else 3)\n      current_pos = nearest_target_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T02:01:11.338119", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  min_distance = float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          nearest_workshop_pos = min(\n              workshop_positions, key=lambda p: np.linalg.norm(current_pos - p)\n          )\n          distance = np.linalg.norm(current_pos - nearest_workshop_pos)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = nearest_workshop_pos\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          current_pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T02:03:09.598514", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  # Calculate the distance to each workshop type and choose the closest one\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest target position among all positions of the closest workshop type\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos, min_nearest_distance = None, float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* search algorithm\n  def heuristic(a, b):\n      return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])\n\n  open_set = collections.deque([(pos, [])])\n  closed_set = set()\n\n  while open_set:\n      current_pos, path = open_set.popleft()\n      closed_set.add(tuple(current_pos))\n\n      if np.array_equal(current_pos, nearest_target_pos):\n          actions.extend(path)\n          break\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          neighbor = current_pos + np.array([dx, dy])\n\n          if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n                  0 <= neighbor[1] < env._current_state.grid.shape[1]):\n              continue\n\n          if tuple(neighbor) in closed_set:\n              continue\n\n          tentative_path = path + [3 if dx > 0 else 2 if dx < 0 else 1 if dy > 0 else 0]\n          open_set.append((neighbor, tentative_path))\n          closed_set.add(tuple(neighbor))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
