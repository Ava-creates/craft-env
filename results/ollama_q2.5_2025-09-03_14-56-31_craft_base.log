ving in x-direction first\n          new_x = pos[0] + (1 if dx > 0 else -1)\n          if env._current_state.grid[new_x, pos[1], closest_workshop_idx]:\n              pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) >= abs(dx):  # Then move in y-direction\n          new_y = pos[1] + (1 if dy > 0 else -1)\n          if env._current_state.grid[pos[0], new_y, closest_workshop_idx]:\n              pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": -1}}
