 ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = calculate_nearest_target(pos, target_positions)\n\n  # Ensure we are in front of a workshop before using it\n  if not env._current_state.next_to(nearest_target_pos):\n      actions.extend(move_towards_target(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T01:17:30.345606", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move in x-direction first, then y-direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n  \n  def calculate_nearest_target(pos, target_positions):\n      nearest_target_pos = None\n      min_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = calculate_nearest_target(pos, target_positions)\n\n  # Ensure we are in front of a workshop before using it\n  current_pos = np.array(env._current_state.pos)\n  if not env._current_state.next_to(nearest_target_pos):\n      actions.extend(move_towards_target(current_pos, nearest_target_pos))\n  \n  # Check if the agent is already next to any workshop position and move towards the closest one if needed\n  if not any(np.allclose(current_pos, pos) for pos in target_positions):\n      nearest_workshop_pos = calculate_nearest_target(current_pos, target_positions)\n      actions.extend(move_towards_target(current_pos, nearest_workshop_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T01:17:32.296092", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move in x-direction first, then y-direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n  \n  def calculate_nearest_target(pos, target_positions):\n      nearest_target_pos = None\n      min_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = calculate_nearest_target(pos, target_positions)\n\n  # Ensure we are in front of a workshop before using it\n  if not env._current_state.next_to(nearest_target_pos):\n      actions.extend(move_towards_target(pos, nearest_target_pos))\n  \n  # Check the direction the agent is facing and turn towards the workshop if necessary\n  current_direction = env._current_state.dir\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  \n  angle_difference = (target_direction - current_direction) % (2 * np.pi)\n  if angle_difference > np.pi:\n      angle_difference -= 2 * np.pi\n\n  # Calculate the number of turns required\n  num_turns = round(angle_difference / (np.pi / 2))\n  if num_turns < 0:\n      actions.extend([5] * (-num_turns))  # Turn LEFT\n  elif num_turns > 0:\n      actions.extend([6] * num_turns)  # Turn RIGHT\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-04T01:19:19.261599", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          new_x = pos[0] + (1 if dx > 0 else -1)\n          if env._current_state.next_to(workshop_indices):\n              break\n          pos[0] = new_x\n      else:  # Then move in y-direction\n          new_y = pos[1] + (1 if dy > 0 else -1)\n          if env._current_state.next_to(workshop_indices):\n              break\n          pos[1] = new_y\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
