{"timestamp": "2025-09-04T00:30:28.135180", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Calculate the closest workshop position to the current position\n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n      distance_to_closest_workshop = np.linalg.norm(pos - closest_workshop_pos)\n      if distance_to_closest_workshop < min_distance:\n          nearest_workshop_pos = closest_workshop_pos\n          min_distance = distance_to_closest_workshop\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using a more efficient pathfinding algorithm (A* or BFS)\n  def bfs(start, goal):\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n        current = queue.popleft()\n\n        if np.array_equal(current, goal):\n            break\n\n        for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n            neighbor = current + np.array(direction)\n\n            # Check bounds and obstacles\n            if 0 <= neighbor[0] < env._current_state.grid.shape[0] and \\\n               0 <= neighbor[1] < env._current_state.grid.shape[1] and \\\n               tuple(neighbor) not in visited:\n                queue.append(neighbor)\n                visited.add(tuple(neighbor))\n                parent[tuple(neighbor)] = current\n\n    # Reconstruct path from start to goal\n    if np.array_equal(current, goal):\n        path = []\n        while not np.array_equal(current, start):\n            path.append(direction_from_positions(parent[tuple(current)], current))\n            current = parent[tuple(current)]\n        return path[::-1]\n    else:\n        return []\n\n  def direction_from_positions(pos1, pos2):\n      dx, dy = pos2 - pos1\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  path = bfs(pos, nearest_workshop_pos)\n  actions.extend(path)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T00:30:30.017150", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Calculate the closest workshop position to the current position\n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n      distance_to_closest_workshop = np.linalg.norm(pos - closest_workshop_pos)\n      if distance_to_closest_workshop < min_distance:\n          nearest_workshop_pos = closest_workshop_pos\n          min_distance = distance_to_closest_workshop\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the path to the closest workshop position using A* algorithm\n  def heuristic(a, b):\n    return np.linalg.norm(np.array(a) - np.array(b))\n\n  def a_star(start, goal):\n    open_set = set([start])\n    came_from = {}\n    g_score = {start: 0}\n    f_score = {start: heuristic(start, goal)}\n\n    while open_set:\n        current = min(open_set, key=lambda x: f_score[x])\n\n        if current == goal:\n            path = []\n            while current in came_from:\n                path.append(current)\n                current = came_from[current]\n            return path[::-1] + [goal]\n\n        open_set.remove(current)\n\n        neighbors = [\n            (current[0] - 1, current[1]),\n            (current[0] + 1, current[1]),\n            (current[0], current[1] - 1),\n            (current[0], current[1] + 1)\n        ]\n\n        for neighbor in neighbors:\n            if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and\n                    0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                continue\n\n            tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n            if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                came_from[neighbor] = current\n                g_score[neighbor] = tentative_g_score\n                f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                open_set.add(neighbor)\n\n    return []\n\n  path_to_workshop = a_star(tuple(pos), tuple(nearest_workshop_pos))\n\n  for point in path_to_workshop[:-1]:\n      dx, dy = point - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      pos[0], pos[1] = point\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
