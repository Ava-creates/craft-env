{"timestamp": "2025-09-03T20:47:01.364535", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n      # Check for collisions with boundaries or other obstacles\n      next_pos = (pos[0], pos[1])\n      if env._current_state.grid[next_pos, :].sum() == 0:  # Assuming grid cell sum of zero means traversable\n          actions.append(direction)\n      else:\n          # Avoid obstacle by moving in the alternative direction\n          alt_direction = get_direction(-dx, -dy)  # Opposite direction\n          if env._current_state.grid[next_pos[0], next_pos[1] + (1 if dy > 0 else -1), :].sum() == 0:\n              actions.append(alt_direction)\n          elif env._current_state.grid[next_pos[0] + (1 if dx > 0 else -1), next_pos[1], :].sum() == 0:\n              actions.append(alt_direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 7, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T20:49:28.378871", "function_name": "craft", "function_body": "  def move_towards_target(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Optimize the path to minimize turns and moves\n      if steps_x <= steps_y:\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n          \n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n      else:\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n          \n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n      \n      return actions\n\n  def get_workshop_positions(env, workshop_idx):\n      return np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_positions = get_workshop_positions(env, workshop_idx)\n      \n      if len(workshop_positions) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_positions.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = get_workshop_positions(env, closest_workshop_idx)\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(current_pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T20:49:30.428290", "function_name": "craft", "function_body": "  def move_towards_target(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Optimize the path to minimize turns and moves\n      if steps_x <= steps_y:\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n      else:\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n      \n      return actions\n  \n  def can_craft(item, inventory):\n      \"\"\"Check if the agent has all required primitives to craft an item.\"\"\"\n      cookbook = env.world.cookbook\n      primitives_needed = cookbook.primitives_needed[item]\n      for primitive, quantity in primitives_needed.items():\n          if inventory[primitive] < quantity:\n              return False\n      return True\n\n  def get_primitives_needed(item):\n      \"\"\"Get the primitives needed to craft an item.\"\"\"\n      cookbook = env.world.cookbook\n      return cookbook.primitives_needed[item]\n\n  def collect_primitives(primitives_needed, current_pos):\n      actions = []\n      inventory = collections.defaultdict(int)\n      \n      for primitive, quantity in primitives_needed.items():\n          while inventory[primitive] < quantity:\n              target_positions = np.argwhere(env._current_state.grid[:, :, env.world.cookbook.index[primitive]])\n              nearest_target_pos = None\n              min_distance = float('inf')\n\n              for pos in target_positions:\n                  distance = np.linalg.norm(current_pos - pos, ord=2)\n                  if distance < min_distance:\n                      nearest_target_pos = pos\n                      min_distance = distance\n\n              actions.extend(move_towards_target(current_pos, nearest_target_pos))\n              actions.append(4)  # USE to collect the primitive\n              \n              inventory[primitive] += 1\n              current_pos = nearest_target_pos\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Check if the agent has all required primitives to craft the item\n  primitives_needed = get_primitives_needed(item)\n  if not can_craft(item, env._current_state.inventory):\n      actions.extend(collect_primitives(primitives_needed, np.array(env._current_state.pos)))\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :,