{"timestamp": "2025-09-04T02:37:03.601072", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_nearest_workshop():\n    closest_workshop_idx, min_distance = None, float('inf')\n    for workshop_idx in workshop_indices:\n        workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n        if len(workshop_pos_list) > 0:\n            workshop_pos_mean = workshop_pos_list.mean(axis=0)\n            distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n            if distance < min_distance:\n                closest_workshop_idx, min_distance = workshop_idx, distance\n    return closest_workshop_idx\n\n  def find_nearest_target(closest_workshop_idx):\n    target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n    nearest_target_pos = None\n    min_nearest_distance = float('inf')\n    for target_pos in target_positions:\n        distance = np.linalg.norm(pos - target_pos, ord=2)\n        if distance < min_nearest_distance:\n            nearest_target_pos = target_pos\n            min_nearest_distance = distance\n    return nearest_target_pos\n\n  closest_workshop_idx = find_nearest_workshop()\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = find_nearest_target(closest_workshop_idx)\n\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update position with a single step in the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          pos[1] += np.sign(dy)\n\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T02:37:05.518291", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  def find_nearest_workshops():\n      workshops = {}\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              workshops[workshop_idx] = (distance, workshop_pos_list)\n      return workshops\n\n  def find_nearest_target(workshops):\n      closest_workshop_idx, min_distance = None, float('inf')\n      nearest_target_pos = None\n      for workshop_idx, (distance, pos_list) in workshops.items():\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n              target_positions = pos_list\n              nearest_target_pos = target_positions[np.argmin(np.linalg.norm(pos - target_positions, axis=1))]\n      return closest_workshop_idx, nearest_target_pos\n\n  workshops = find_nearest_workshops()\n  if not workshops:\n      raise ValueError(\"No available workshop found\")\n\n  closest_workshop_idx, nearest_target_pos = find_nearest_target(workshops)\n\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update position with a single step in the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          pos[1] += np.sign(dy)\n\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T02:38:40.986424", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move in x-direction first, then y-direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n  \n  def calculate_nearest_target(pos, target_positions):\n      nearest_target_pos = None\n      min_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  target_positions = []\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_positions.extend(workshop_pos_list)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = calculate_nearest_target(pos, target_positions)\n  \n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Check if already at a workshop to prevent unnecessary movement\n  current_state = env._current_state\n  if not any(current_state.grid[current_state.pos[0], current_state.pos[1], workshop_idx] for workshop_idx in workshop_indices):\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
