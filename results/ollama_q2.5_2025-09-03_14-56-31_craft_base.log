aken\n      if env._current_state.dir == direction:\n          # Move forward only if facing in the correct direction\n          new_pos = tuple(pos + craft.DIRECTION_VECTORS[direction])\n          if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n              pos = np.array(new_pos)\n      else:\n          # Turn towards the correct direction\n          actions.append(direction)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"": -1}}
