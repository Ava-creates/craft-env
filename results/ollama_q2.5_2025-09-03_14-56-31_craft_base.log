he chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-04T14:40:13.887497", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  \n  current_pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) == 0:  # Check if there are any locations for the workshop\n          continue\n      \n      mean_workshop_pos = workshop_positions.mean(axis=0)\n      distance = np.linalg.norm(current_pos - mean_workshop_pos, ord=2)\n      \n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Get all positions of the closest workshops\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n\n  # Determine the nearest position to move towards\n  nearest_target_pos = min(target_positions, key=lambda pos: np.linalg.norm(current_pos - pos))\n\n  # Generate actions to move to the nearest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update position based on the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:41:38.040257", "function_name": "craft", "function_body": "  def get_direction_to_target(pos: np.ndarray, target_pos: np.ndarray) -> int:\n      dx, dy = target_pos - pos\n      if abs(dx) >= abs(dy):\n          return 3 if dx > 0 else 2 if dx < 0 else None\n      else:\n          return 1 if dy > 0 else 0 if dy < 0 else None\n\n  def get_adjacent_positions(pos: np.ndarray, direction: int) -> list[np.ndarray]:\n      \"\"\"Returns the positions adjacent to `pos` in the given `direction`.\"\"\"\n      directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n      delta_x, delta_y = directions[direction]\n      adjacent_positions = []\n      for i in range(1, 4):  # Check up to 3 steps ahead\n          new_pos = pos + np.array([delta_x * i, delta_y * i])\n          if env._current_state.grid[new_pos[0], new_pos[1]].sum() == 0:  # Ensure it's not blocked\n              adjacent_positions.append(new_pos)\n      return adjacent_positions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      direction = get_direction_to_target(pos, nearest_target_pos)\n      if direction is not None:\n          adjacent_positions = get_adjacent_positions(pos, direction)\n          next_pos = adjacent_positions[0] if adjacent_positions else pos\n\n          # Check if the next position is the target\n          while np.array_equal(next_pos, nearest_target_pos):\n              actions.append(direction)\n              pos = next_pos\n              adjacent_positions = get_adjacent_positions(pos, direction)\n              next_pos = adjacent_positions[0] if adjacent_positions else pos\n          else:\n              # Move to the next valid position\n              actions.append(direction)\n              pos += (direction == 3) - (direction == 2), (direction == 1) - (direction == 0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"": -1}}
