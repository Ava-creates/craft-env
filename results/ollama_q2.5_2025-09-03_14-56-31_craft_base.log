{"timestamp": "2025-09-04T00:26:51.448789", "function_name": "craft", "function_body": "  def move_towards(state, target):\n      dx, dy = target - np.array(state.pos)\n      actions = []\n\n      while not np.array_equal(np.array(state.pos), target):\n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)  # RIGHT: 3, LEFT: 2\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)   # DOWN: 1, UP: 0\n\n          if abs(dx) >= abs(dy) and dir_x is not None:\n              actions.append(dir_x)\n              state.pos = (state.pos[0] + (1 if dx > 0 else -1), state.pos[1])\n          elif abs(dy) > abs(dx) and dir_y is not None:\n              actions.append(dir_y)\n              state.pos = (state.pos[0], state.pos[1] + (1 if dy > 0 else -1))\n\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  current_state = env._current_state\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(np.array(current_state.pos) - x, ord=2))\n          distance = np.linalg.norm(np.array(current_state.pos) - nearest_target_pos, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(np.array(current_state.pos) - x, ord=2))\n\n  actions.extend(move_towards(current_state, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-04T00:26:53.616184", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      dx, dy = target_pos - pos\n      actions = []\n      \n      # Determine direction to move in\n      while not np.array_equal(pos, target_pos):\n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Prioritize moving in x-direction first\n          if abs(dx) >= abs(dy) and dir_x is not None:\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def find_closest_workshop(env, goal_index):\n      workshop_indices = env.world.workshop_indices\n      pos = np.array(env._current_state.pos)\n\n      closest_workshop_idx, min_distance = None, float('inf')\n\n      for workshop_idx in workshop_indices:\n          # Calculate all positions of this type of workshop\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              nearest_workshop_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x, ord=2))\n              distance = np.linalg.norm(pos - nearest_workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, nearest_workshop_pos\n      return closest_workshop_idx, min_distance\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_workshop_pos = find_closest_workshop(env, goal_index)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n  actions.extend(move_towards(pos, nearest_workshop_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": -1}}
