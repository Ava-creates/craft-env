{"timestamp": "2025-09-04T21:23:50.145940", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      \n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          if dx > 0:\n              pos[0] += 1\n              actions.append(3)  # RIGHT\n          else:\n              pos[0] -= 1\n              actions.append(2)  # LEFT\n      else:  # Then move in y-direction\n          if dy > 0:\n              pos[1] += 1\n              actions.append(1)  # UP\n          else:\n              pos[1] -= 1\n              actions.append(0)  # DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T21:24:53.167582", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      \"\"\"Get the direction based on the difference in coordinates.\"\"\"\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  def move_towards(current_pos, target_pos):\n      \"\"\"Generate actions to move from current position to target position.\"\"\"\n      actions = []\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              current_pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              current_pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  current_pos = np.array(env._current_state.pos)\n\n  actions = []\n\n  # Determine the closest workshop for crafting the item\n  min_distance = float('inf')\n  closest_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) > 0:  # Check if there are any workshops of this type\n          workshop_mean_pos = workshop_positions.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshops found\")\n\n  # Find the nearest position to move towards on the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda pos: np.linalg.norm(pos - current_pos))\n\n  # Move towards the nearest target position and add actions\n  actions.extend(move_towards(current_pos, nearest_target_pos))\n  \n  # Add the USE action to craft the item at the workshop\n  actions.append(4)\n  \n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T21:24:55.036468", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  current_pos = np.array(env._current_state.pos)\n\n  actions = []\n\n  # Determine the closest workshop for crafting the item\n  min_distance = float('inf')\n  closest_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) > 0:  # Check if there are any workshops of this type\n          workshop_mean_pos = workshop_positions.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_mean_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshops found\")\n\n  # Find the nearest position to move towards on the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda pos: np.linalg.norm(pos - current_pos))\n\n  # Move towards the nearest target position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update current position based on the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          current_pos[1] += 1 if dy > 0 else -1\n\n  actions.append(4)  # USE action to craft the item at the workshop\n\n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T21:26:05.389945", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Prioritize moving in x-direction first if closer than y-direction\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              pos[0] += 1\n              actions.append(3)  # RIGHT\n          else:\n              pos[0] -= 1\n              actions.append(2)  # LEFT\n      else:  # Then move in y-direction\n          if dy > 0:\n              pos[1] += 1\n              actions.append(1)  # UP\n          else:\n              pos[1] -= 1\n              actions.append(0)  # DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
