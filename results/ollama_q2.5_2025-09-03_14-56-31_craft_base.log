pos[1] += 1 if dy > 0 else -1\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:54:52.311867", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update position with a single step in the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          pos[1] += np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  # Verify if we are next to the workshop and can use it\n  workshop_idx = closest_workshop_idx\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n  nearest_workshop_distance = float('inf')\n  for w_pos in workshop_positions:\n      distance = np.linalg.norm(pos - w_pos, ord=2)\n      if distance < nearest_workshop_distance:\n          nearest_workshop_distance = distance\n\n  if nearest_workshop_distance <= 1:\n      actions.append(4)  # USE\n  else:\n      raise ValueError(\"Failed to reach the workshop\")\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:54:54.206292", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Calculate the closest workshop position to the current position\n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n      distance_to_closest_workshop = np.linalg.norm(pos - closest_workshop_pos)\n      if distance_to_closest_workshop < min_distance:\n          nearest_workshop_pos = closest_workshop_pos\n          min_distance = distance_to_closest_workshop\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update position with a single step in the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          pos[1] += np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:57:34.678127", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Move in the direction that requires fewer steps first\n      if steps_x <= steps_y:\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n          \n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n      else:\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n          \n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n      \n      return actions\n\n  def get_closest_workshop_pos(pos, workshop_indices):\n      closest_workshop_idx = None\n      min_distance = float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  min_distance = distance\n      \n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          \n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  def orient_and_move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      actions = []\n      \n      # Determine the direction to move first based on orientation\n      if env._current_state.direction == 0:  # Facing DOWN\n          if dy < 0:\n              actions.extend([4] * abs(dy))  # Move UP directly\n          else:\n              if dx > 0:\n                  actions.append(3)  # Turn RIGHT\n              elif dx < 0:\n                  actions.append(2)  # Turn LEFT\n              actions.extend([1] * abs(dy))  # Move UP\n      \n      elif env._current_state.direction == 1:  # Facing UP\n          if dy > 0:\n              actions.extend([4] * abs(dy))  # Move DOWN directly\n          else:\n              if dx > 0:\n                  actions.append(3)  # Turn RIGHT\n              elif dx < 0:\n                  actions.append(2)  # Turn LEFT\n              actions.extend([0] * abs(dy))  # Move DOWN\n      \n      elif env._current_state.direction == 2:  # Facing LEFT\n          if dx < 0:\n              actions.extend([4] * abs(dx))  # Move RIGHT directly\n          else:\n              if dy > 0:\n                  actions.append(1)  # Turn UP\n              elif dy < 0:\n                  actions.append(0)  # Turn DOWN\n              actions.extend([3] * abs(dx))  # Move RIGHT\n      \n      elif env._current_state.direction == 3:  # Facing RIGHT\n          if dx > 0:\n              actions.extend([4] * abs(dx))  # Move LEFT directly\n          else:\n              if dy > 0:\n                  actions.append(1)  # Turn UP\n              elif dy < 0:\n                  actions.append(0)  # Turn DOWN\n              actions.extend([2] * abs(dx))  # Move LEFT\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Get the position of the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = get_closest_workshop_pos(pos, workshop_indices)\n\n  # Move towards the closest workshop position considering orientation\n  actions.extend(orient_and_move_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-03T21:57:36.856504", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move based on which is closer first\n      if dx != 0 and dy != 0:\n          # Diagonal movement (not directly supported but we can simulate it by alternating moves)\n          # First move in x-direction until aligned, then y-direction\n          if steps_x <= steps_y:\n              actions.extend([3] * steps_x if dx > 0 else [2] * steps_x)  # Move RIGHT/LEFT\n              actions.extend([1] * steps_y if dy > 0 else [0] * steps_y)  # Move UP/DOWN\n          else:\n              actions.extend([1] * steps_y if dy > 0 else [0] * steps_y)  # Move UP/DOWN\n              actions.extend([3] * steps_x if dx > 0 else [2] * steps_x)  # Move RIGHT/LEFT\n      elif dx != 0:\n          actions.extend([3] * steps_x if dx > 0 else [2] * steps_x)  # Move RIGHT/LEFT\n      elif dy != 0:\n          actions.extend([1] * steps_y if dy > 0 else [0] * steps_y)  # Move UP/DOWN\n      \n      return actions\n\n  def get_closest_workshop_pos(pos, workshop_indices):\n      closest_workshop_idx = None\n      min_distance = float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  min_distance = distance\n      \n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          \n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Get the position of the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = get_closest_workshop_pos(pos, workshop_indices)\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:59:39.785506", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Determine the next step based on the current direction and proximity\n      if abs(dx) > abs(dy):\n          new_x = pos[0] + (1 if dx > 0 else -1)\n          if 0 <= new_x < env._current_state.grid.shape[0]:\n              pos[0] = new_x\n      elif abs(dy) > abs(dx):\n          new_y = pos[1] + (1 if dy > 0 else -1)\n          if 0 <= new_y < env._current_state.grid.shape[1]:\n              pos[1] = new_y\n      else:\n          # If we are equidistant, choose the direction with the smallest absolute difference\n          direction = get_direction(dx, dy)\n          if dx != 0:\n              pos[0] += 1 if dx > 0 else -1\n          elif dy != 0:\n              pos[1] += 1 if dy > 0 else -1\n\n      # Ensure the new position is within grid boundaries\n      pos = np.clip(pos, [0, 0], [env._current_state.grid.shape[0]-1, env._current_state.grid.shape[1]-1])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"": 0.5}}
