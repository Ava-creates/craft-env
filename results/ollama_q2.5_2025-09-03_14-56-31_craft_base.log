if abs(dx) >= abs(dy) else pos[0]\n      new_y = pos[1] + (1 if dy > 0 else -1) if abs(dx) < abs(dy) else pos[1]\n\n      # Update position and check if next to a workshop\n      if env._current_state.next_to(workshop_indices):\n          break\n\n      if np.array_equal([new_x, new_y], nearest_target_pos):\n          break  # Avoid infinite loop if we reach the target but are not next to a workshop\n\n      pos[0] = new_x\n      pos[1] = new_y\n\n  # Once at the closest position, find the exact workshop to use\n  nearest_workshop_pos = None\n  min_nearest_distance_to_workshop = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      for workshop_pos in workshop_positions:\n          distance = np.linalg.norm(pos - workshop_pos, ord=2)\n          if distance < min_nearest_distance_to_workshop:\n              nearest_workshop_pos = workshop_pos\n              min_nearest_distance_to_workshop = distance\n\n  # Move to the exact workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      new_x = pos[0] + (1 if dx > 0 else -1) if abs(dx) >= abs(dy) else pos[0]\n      new_y = pos[1] + (1 if dy > 0 else -1) if abs(dx) < abs(dy) else pos[1]\n\n      pos[0] = new_x\n      pos[1] = new_y\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T05:09:52.450512", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target, ord=2) for target in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      new_x = pos[0] + (1 if dx > 0 else -1) if abs(dx) >= abs(dy) else pos[0]\n      new_y = pos[1] + (1 if dy > 0 else -1) if abs(dx) < abs(dy) else pos[1]\n\n      # Update position and check if next to a workshop\n      if env._current_state.next_to(workshop_indices):\n          break\n\n      if np.array_equal([new_x, new_y], nearest_target_pos):\n          break  # Avoid infinite loop if we reach the target but are not next to a workshop\n\n      pos[0] = new_x\n      pos[1] = new_y\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T05:12:06.769424", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest target position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding\n  start_node = (pos[0], pos[1])\n  target_node = (nearest_target_pos[0], nearest_target_pos[1])\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  open_set = set()\n  closed_set = set()\n  g_costs = {start_node: 0}\n  f_costs = {start_node: heuristic(start_node, target_node)}\n  came_from = {}\n\n  open_set.add(start_node)\n\n  while open_set:\n      current_node = min(open_set, key=lambda k: f_costs[k])\n      if current_node == target_node:\n          break\n\n      open_set.remove(current_node)\n      closed_set.add(current_node)\n\n      neighbors = [\n          (current_node[0] + 1, current_node[1]),\n          (current_node[0] - 1, current_node[1]),\n          (current_node[0], current_node[1] + 1),\n          (current_node[0], current_node[1] - 1)\n      ]\n\n      for neighbor in neighbors:\n          if neighbor in closed_set or env._current_state.grid[neighbor[0], neighbor[1], 0] == 1:  # Assuming 1 represents a boundary\n              continue\n\n          tentative_g_cost = g_costs[current_node] + 1\n\n          if neighbor not in open_set:\n              open_set.add(neighbor)\n          elif tentative_g_cost >= g_costs.get(neighbor, float('inf')):\n              continue\n\n          came_from[neighbor] = current_node\n          g_costs[neighbor] = tentative_g_cost\n          f_costs[neighbor] = tentative_g_cost + heuristic(neighbor, target_node)\n\n  if target_node not in came_from:\n      raise ValueError(\"Path to the workshop not found\")\n\n  # Reconstruct path\n  path = []\n  while target_node != start_node:\n      path.append(target_node)\n      target_node = came_from[target_node]\n  path.reverse()\n\n  for node in path:\n      dx, dy = node[0] - pos[0], node[1] - pos[1]\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      pos[0], pos[1] = node\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T05:12:08.942914", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p, ord=2))\n\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      # Update the position based on the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"": 0.5}}
