d_nearest_target_position(target_positions, current_pos):\n    min_distance = float('inf')\n    nearest_target_pos = None\n\n    for pos in target_positions:\n        distance = np.linalg.norm(current_pos - pos, ord=2)\n        if distance < min_distance:\n            nearest_target_pos = pos\n            min_distance = distance\n    \n    return nearest_target_pos\n  \n  nearest_target_pos = find_nearest_target_position(target_positions, env._current_state.pos)\n\n  # Move to the closest workshop position\n  actions = move_towards(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T12:49:07.591800", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  nearest_workshop_pos = target_pos\n                  min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Move in a diagonal if possible\n      if dx != 0 and dy != 0:\n          if abs(dx) > abs(dy):\n              pos[0] += np.sign(dx)\n          else:\n              pos[1] += np.sign(dy)\n      elif dx != 0:\n          pos[0] += np.sign(dx)\n      elif dy != 0:\n          pos[1] += np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T12:49:08.841037", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  nearest_workshop_pos = target_pos\n                  min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using A* pathfinding\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = np.array([current[0] + dx, current[1] + dy])\n              tentative_g_score = g_score[tuple(current)] + 1\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[tuple(neighbor)], neighbor))\n\n      return None\n\n  path = a_star(pos, nearest_workshop_pos)\n\n  if path is None:\n      raise ValueError(\"No path found to the workshop\")\n\n  # Follow the path to the closest workshop\n  for target_pos in path[1:]:  # Skip the starting position\n      dx, dy = np.array(target_pos) - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      pos = np.array(target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-04T12:50:26.422777", "function_name": "craft", "function_body": "  def find_closest_workshop_position(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) == 0:\n          return None, float('inf')\n      nearest_target_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x, ord=2))\n      distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n      return nearest_target_pos, distance\n\n  def move_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              if dir_x is not None:\n                  actions.append(dir_x)\n                  pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              if dir_y is not None:\n                  actions.append(dir_y)\n                  pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      nearest_target_pos, distance = find_closest_workshop_position(workshop_idx)\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos, _ = find_closest_workshop_position(closest_workshop_idx)\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available target position found\")\n\n  # Move to the closest workshop position\n  actions_to_move = move_to(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions_to_move.append(4)  # USE\n  \n  return actions_to_move", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T12:50:27.672587", "function_name": "craft", "function_body": "  def move_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              if dir_x is not None:\n                  actions.append(dir_x)\n                  pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              if dir_y is not None:\n                  actions.append(dir_y)\n                  pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Get the recipe for the desired item\n  recipe = cookbook.primitives[goal_index]\n  \n  # Check inventory to see if we have all required primitives\n  inventory = env._current_state.features_dict['inventory']\n  missing_primitives = [prim for prim, count in recipe.items() if inventory.get(prim, 0) < count]\n\n  if missing_primitives:\n      raise ValueError(f\"Missing required primitives: {missing_primitives}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available target position found\")\n\n  # Move to the closest workshop position\n  actions_to_move = move_to(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions_to_move.append(4)  # USE\n  \n  return actions_to_move", "island_id": 0, "scores": {"": -1}}
