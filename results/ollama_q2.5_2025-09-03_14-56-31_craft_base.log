{"timestamp": "2025-09-03T20:11:40.434817", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding\n  def heuristic(a, b):\n      return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])\n\n  def astar(grid, start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while not open_set.empty():\n          current = open_set.get()[1]\n\n          if np.array_equal(current, goal):\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.put((f_score[neighbor], neighbor))\n\n      return []\n\n  path_to_workshop = astar(env._current_state.grid[:, :, closest_workshop_idx], tuple(pos), tuple(nearest_target_pos))\n  \n  for next_step in path_to_workshop:\n      dx, dy = np.array(next_step) - pos\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": -1}}
{"timestamp": "2025-09-03T20:12:59.286895", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the relative position from current to target\n  dx, dy = nearest_target_pos - pos\n\n  # Calculate the number of steps needed to reach the closest workshop position\n  steps_x = abs(dx)\n  steps_y = abs(dy)\n\n  # Determine the direction to move in x-direction first, then y-direction\n  if dx > 0:\n      actions.extend([3] * steps_x)  # Move RIGHT\n  elif dx < 0:\n      actions.extend([2] * steps_x)  # Move LEFT\n\n  if dy > 0:\n      actions.extend([1] * steps_y)  # Move UP\n  elif dy < 0:\n      actions.extend([0] * steps_y)  # Move DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T20:13:01.550237", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the relative position from current to target\n  dx, dy = nearest_target_pos - pos\n\n  # Calculate the number of steps needed to reach the closest workshop position\n  steps_x = abs(dx)\n  steps_y = abs(dy)\n\n  # Determine the direction to move in x-direction first, then y-direction\n  while steps_x > 0 or steps_y > 0:\n      if steps_x > 0:\n          action = 3 if dx > 0 else 2  # RIGHT or LEFT\n          actions.append(action)\n          steps_x -= 1\n      elif steps_y > 0:\n          action = 1 if dy > 0 else 0  # UP or DOWN\n          actions.append(action)\n          steps_y -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T20:14:58.089003", "function_name": "craft", "function_body": "  def move_towards_target(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Optimize the path to minimize turns and moves\n      if steps_x <= steps_y:\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n          \n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n      else:\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n          \n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  current_pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(current_pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T20:15:00.218624", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Move in the direction that requires fewer steps first\n      if steps_x <= steps_y:\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n          \n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n      else:\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n          \n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n      \n      return actions\n\n  def get_closest_workshop_pos(pos, workshop_indices):\n      closest_workshop_idx = None\n      min_distance = float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  min_distance = distance\n      \n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n      \n      # Calculate the closest position to move towards\n      target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          \n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Get the position of the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = get_closest_workshop_pos(pos, workshop_indices)\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T20:16:39.293072", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  if len(target_positions) == 0:  # No workshops of this type in the grid\n      raise ValueError(\"Workshops are not present on the map.\")\n\n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):  # Prioritize moving in y-direction first\n          direction = (1 if dy > 0 else 0)\n      else:  # If equal, choose an arbitrary direction\n          direction = np.random.choice([1, 3]) if dx >= 0 else np.random.choice([2, 0])\n\n      actions.append(direction)\n\n      # Update the position based on the chosen direction\n      pos += np.array(([-1, 0] if direction == 2 else [1, 0] if direction == 3 else \n                       [0, -1] if direction == 0 else [0, 1]))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
