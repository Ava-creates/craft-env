{"timestamp": "2025-09-04T14:51:10.789947", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = [index for index in env.world.workshop_indices if any(recipe.get(goal_index) for recipe in cookbook.recipes.values())]\n  \n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  \n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          # Check if this workshop can actually craft the desired item\n          if any(recipe.get(goal_index) for recipe in cookbook.recipes.values()):\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Adjust position based on current facing direction\n      if abs(dx) >= abs(dy):  \n          pos[0] += 1 if dx > 0 else -1\n      else:  \n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:52:20.500995", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:52:22.549876", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          # Find the closest individual workshop position to the current agent position\n          nearest_target_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x))\n          nearest_distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n\n          if nearest_distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = nearest_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      # Update position based on the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:53:55.415802", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:53:57.380733", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* algorithm for pathfinding\n  def heuristic(a, b):\n      return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])\n\n  def a_star(start, goal, grid):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              path = []\n              while current in came_from:\n                  path.append(tuple(came_from[current]))\n                  current = came_from[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = tuple(current + np.array([dx, dy]))\n\n              # Check if the neighbor is within bounds and passable\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + heuristic(current, neighbor)\n\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      open_set.put((f_score[neighbor], neighbor))\n\n      return None\n\n  path = a_star(tuple(pos), tuple(nearest_target_pos), env._current_state.grid)\n\n  if path is not None:\n      for next_step in path:\n          dx, dy = np.array(next_step) - pos\n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-04T14:55:48.803639", "function_name": "craft", "function_body": "  def move_towards(target_positions):\n      pos = np.array(env._current_state.pos)\n      distances = {tuple(pos): float('inf')}\n      \n      queue = collections.deque([pos])\n      parent_map = {}\n\n      while queue:\n          current_pos = queue.popleft()\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_pos = current_pos + np.array([dx, dy])\n              if tuple(new_pos) not in distances and 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                  queue.append(new_pos)\n                  parent_map[tuple(new_pos)] = current_pos\n                  distances[tuple(new_pos)] = distances[tuple(current_pos)] + 1\n\n      # Reconstruct the path to the closest target position\n      path = []\n      best_target_pos = min(target_positions, key=lambda x: distances.get(tuple(x), float('inf')))\n      \n      while tuple(best_target_pos) in parent_map:\n          path.append(best_target_pos)\n          best_target_pos = parent_map[tuple(best_target_pos)]\n\n      path.reverse()\n      return path\n\n  def move_to(path):\n      actions = []\n      pos = np.array(env._current_state.pos)\n      \n      for next_pos in path:\n          dx, dy = next_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              if dir_x is not None:\n                  actions.append(dir_x)\n                  pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              if dir_y is not None:\n                  actions.append(dir_y)\n                  pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  path = move_towards(target_positions)\n\n  if not path:\n      raise ValueError(\"No path to any of the target positions found\")\n\n  actions_to_move = move_to(path)\n  actions_to_move.append(4)  # USE\n  \n  return actions_to_move", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:55:50.883051", "function_name": "craft", "function_body": "  def move_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              if dir_x is not None:\n                  actions.append(dir_x)\n                  pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              if dir_y is not None:\n                  actions.append(dir_y)\n                  pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n  if nearest_target_pos is None:\n      raise ValueError(\"No available target position found\")\n\n  # Move to the closest workshop position\n  actions_to_move = move_to(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions_to_move.append(4)  # USE\n\n  return actions_to_move", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:57:26.042258", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  def get_closest_workshops():\n    pos = np.array(env._current_state.pos)\n    workshops = []\n    \n    for workshop_idx in workshop_indices:\n      # Find all positions where the workshop is present\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n        distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n        min_distance = distances.min()\n        nearest_target_pos = workshop_pos_list[distances.argmin()]\n        \n        workshops.append((workshop_idx, nearest_target_pos, min_distance))\n    \n    return sorted(workshops, key=lambda x: x[2])\n\n  closest_workshops = get_closest_workshops()\n\n  if not closest_workshops:\n    raise ValueError(\"No available workshop found\")\n\n  # Choose the closest workshop\n  _, nearest_target_pos, _ = closest_workshops[0]\n\n  # Move to the closest workshop position\n  pos = np.array(env._current_state.pos)\n  \n  while not np.array_equal(pos, nearest_target_pos):\n    dx, dy = nearest_target_pos - pos\n    \n    if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n      direction = get_direction(dx, 0)\n      actions.append(direction)\n      pos[0] += 1 if dx > 0 else -1\n    else:  # Then move in y-direction\n      direction = get_direction(0, dy)\n      actions.append(direction)\n      pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:57:28.052147", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n      return 3  # RIGHT\n    elif dx < 0:\n      return 2  # LEFT\n    elif dy > 0:\n      return 1  # UP\n    else:\n      return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  def get_closest_workshops():\n    pos = np.array(env._current_state.pos)\n    workshops = []\n    for workshop_idx in workshop_indices:\n      # Find all positions where the workshop is present\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n        distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n        min_distance = distances.min()\n        nearest_target_pos = workshop_pos_list[distances.argmin()]\n        \n        workshops.append((workshop_idx, nearest_target_pos, min_distance))\n    \n    return sorted(workshops, key=lambda x: x[2])\n\n  closest_workshops = get_closest_workshops()\n\n  if not closest_workshops:\n    raise ValueError(\"No available workshop found\")\n\n  # Choose the closest workshop\n  _, nearest_target_pos, _ = closest_workshops[0]\n\n  # Move to the closest workshop position\n  pos = np.array(env._current_state.pos)\n  while not np.array_equal(pos, nearest_target_pos):\n    dx, dy = nearest_target_pos - pos\n    direction = get_direction(dx, dy)\n\n    if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n      actions.append(direction)\n      pos[0] += 1 if dx > 0 else -1\n    else:  # Then move in y-direction\n      actions.append(direction)\n      pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"": 0.5}}
