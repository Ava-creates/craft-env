pos[1] += 1 if dy > 0 else -1\n\n      # Wait for a short time to ensure the environment updates properly\n      time.sleep(0.1)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:30:42.863558", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the relative position from current to target\n  dx, dy = nearest_target_pos - pos\n\n  # Determine the direction to move in x-direction first, then y-direction\n  actions.extend([3] * abs(dx) if dx > 0 else [2] * abs(dx))  # RIGHT/LEFT\n  actions.extend([1] * abs(dy) if dy > 0 else [0] * abs(dy))  # UP/DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:30:44.723801", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the relative position from current to target\n  dx, dy = nearest_target_pos - pos\n\n  # Calculate the number of steps needed to reach the closest workshop position\n  steps_x = abs(dx)\n  steps_y = abs(dy)\n\n  # Determine the direction to move in a more optimal way by considering the agent's current facing direction\n  if env._current_state.dir == 0:  # Facing UP\n      actions.extend([3] * steps_x)  # Move RIGHT\n      actions.extend([1] * steps_y)  # Move UP\n      actions.extend([2] * steps_x)  # Move LEFT\n      actions.extend([0] * steps_y)  # Move DOWN\n  elif env._current_state.dir == 1:  # Facing DOWN\n      actions.extend([3] * steps_x)  # Move RIGHT\n      actions.extend([0] * steps_y)  # Move DOWN\n      actions.extend([2] * steps_x)  # Move LEFT\n      actions.extend([1] * steps_y)  # Move UP\n  elif env._current_state.dir == 2:  # Facing LEFT\n      actions.extend([1] * steps_y)  # Move UP\n      actions.extend([3] * steps_x)  # Move RIGHT\n      actions.extend([0] * steps_y)  # Move DOWN\n      actions.extend([2] * steps_x)  # Move LEFT\n  elif env._current_state.dir == 3:  # Facing RIGHT\n      actions.extend([1] * steps_y)  # Move UP\n      actions.extend([2] * steps_x)  # Move LEFT\n      actions.extend([0] * steps_y)  # Move DOWN\n      actions.extend([3] * steps_x)  # Move RIGHT\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:37:40.961337", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  def get_path(start, end):\n      \"\"\"Simple BFS to find the shortest path from start to end.\"\"\"\n      queue = collections.deque([start])\n      visited = set()\n      parent = {tuple(start): None}\n      \n      while queue:\n          pos = queue.popleft()\n          if tuple(pos) == tuple(end):\n              break\n          for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n              new_pos = np.array([pos[0] + dx, pos[1] + dy])\n              if tuple(new_pos) not in visited and env._current_state.grid[new_pos[1], new_pos[0], :].sum() == 0:\n                  queue.append(new_pos)\n                  visited.add(tuple(new_pos))\n                  parent[tuple(new_pos)] = tuple(pos)\n\n      path = []\n      while end is not None:\n          path.append(end)\n          end = parent[tuple(end)]\n      return path[::-1]\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n  \n  workshop_indices = env.world.workshop_indices\n  \n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n  \n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n  \n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n  \n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n  \n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n  \n  # Get the shortest path to the closest workshop position using BFS\n  path_to_workshop = get_path(pos, nearest_target_pos)\n\n  for next_pos in path_to_workshop[1:]:  # Skip the first element which is current pos\n      dx, dy = next_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      pos = next_pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 8, "scores": {"": -1}}
{"timestamp": "2025-09-03T23:37:42.937180", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  def path_to_target(pos, target_pos):\n      \"\"\"Returns a list of actions to reach the target position.\"\"\"\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n\n          if direction == 0:  # DOWN\n              pos[1] -= 1\n          elif direction == 1:  # UP\n              pos[1] += 1\n          elif direction == 2:  # LEFT\n              pos[0] -= 1\n          elif direction == 3:  # RIGHT\n              pos[0] += 1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(path_to_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:39:01.765609", "function_name": "craft", "function_body": "  def move_towards(pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - pos\n      actions = []\n      actions.extend([3] * abs(dx) if dx > 0 else [2] * abs(dx))  # RIGHT/LEFT\n      actions.extend([1] * abs(dy) if dy > 0 else [0] * abs(dy))  # UP/DOWN\n      return actions\n\n  def find_nearest_workshop(pos: np.ndarray, workshop_indices):\n      min_distance = float('inf')\n      nearest_workshop_idx = None\n      nearest_target_pos = None\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) == 0:\n              continue\n\n          distances = np.linalg.norm(workshop_pos_list - pos, axis=1)\n          nearest_idx = np.argmin(distances)\n\n          if distances[nearest_idx] < min_distance:\n              min_distance = distances[nearest_idx]\n              nearest_workshop_idx = workshop_idx\n              nearest_target_pos = workshop_pos_list[nearest_idx]\n\n      return nearest_workshop_idx, nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop and its position\n  nearest_workshop_idx, nearest_target_pos = find_nearest_workshop(pos, workshop_indices)\n  \n  if nearest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(move_towards(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:39:03.623421", "function_name": "craft", "function_body": "  def move_towards(pos: np.ndarray, target_pos: np.ndarray):\n      dx, dy = target_pos - pos\n      actions = []\n      if abs(dx) > abs(dy):  # Prioritize moving in the x-direction first\n          actions.extend([3] * dx if dx > 0 else [2] * (-dx))  # RIGHT/LEFT\n          actions.extend([1] * dy if dy > 0 else [0] * (-dy))  # UP/DOWN\n      else:  # Prioritize moving in the y-direction first\n          actions.extend([1] * dy if dy > 0 else [0] * (-dy))  # UP/DOWN\n          actions.extend([3] * dx if dx > 0 else [2] * (-dx))  # RIGHT/LEFT\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  actions.extend(move_towards(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:40:52.904627", "function_name": "craft", "function_body": "  def move_towards_target(current_pos, target_pos):\n      \"\"\"\n      Move towards a target position given the current position.\n      Returns the list of action indices to reach the target position.\n\n      Args:\n          current_pos (np.array): Current position of the agent.\n          target_pos (np.array): Target position to reach.\n\n      Returns:\n          List[int]: Actions to move from current position to target position.\n      \"\"\"\n      actions = []\n      dx, dy = target_pos - current_pos\n\n      # Determine direction in x and y\n      if dx > 0:\n          actions.extend([3] * abs(dx))  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * abs(dx))  # Move LEFT\n      \n      if dy > 0:\n          actions.extend([1] * abs(dy))  # Move UP\n      elif dy < 0:\n          actions.extend([0] * abs(dy))  # Move DOWN\n\n      return actions\n\n  def find_closest_workshop_index(workshops, current_pos):\n      \"\"\"\n      Find the closest workshop index to the agent's current position.\n\n      Args:\n          workshops (List[Tuple[int]]): List of positions of all available workshops.\n          current_pos (np.array): Current position of the agent.\n\n      Returns:\n          int: Index of the closest workshop.\n      \"\"\"\n      min_distance = float('inf')\n      closest_workshop_idx = None\n\n      for i, target_pos in enumerate(workshops):\n          distance = np.linalg.norm(current_pos - target_pos, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx = i\n              min_distance = distance\n      \n      return closest_workshop_idx\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  all_workshops_positions = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      all_workshops_positions.extend(workshop_pos_list)\n\n  if not all_workshops_positions:\n      raise ValueError(\"No available workshops found\")\n\n  current_pos = np.array(env._current_state.pos)\n  closest_workshop_idx = find_closest_workshop_index(all_workshops_positions, current_pos)\n  nearest_target_pos = all_workshops_positions[closest_workshop_idx]\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:40:54.787763", "function_name": "craft", "function_body": "  def move_towards_target(current_state, target_pos):\n      pos = np.array(current_state.pos)\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move based on current direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      # Then move in the y-direction\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n\n  def find_closest_workshop(current_state, workshop_indices):\n      pos = np.array(current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(current_state, workshop_idx):\n      target_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n      pos = np.array(current_state.pos)\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          \n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(env._current_state, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target_position(env._current_state, closest_workshop_idx)\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(env._current_state, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:42:54.705987", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item by checking all workshops in grid and their distances to items needing crafting.\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  def is_item_at_workshop(grid, workshop_idx, goal_index):\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, workshop_idx] > 0:\n                  # Check if the item can be crafted here\n                  recipe = cookbook.recipes.get(goal_index)\n                  if recipe and all(grid[x, y, primitive_idx] >= amount for primitive_idx, amount in recipe.items()):\n                      return True\n      return False\n\n  for workshop_idx in workshop_indices:\n      if is_item_at_workshop(env._current_state.grid, workshop_idx, goal_index):\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found that can craft the desired item\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):  # Prioritize moving in y-direction first\n          direction = (1 if dy > 0 else 0)\n      else:  # If equal, choose an arbitrary direction based on current position and target position\n          if dx >= 0 and dy >= 0:\n              direction = np.random.choice([3, 1])\n          elif dx >= 0 and dy < 0:\n              direction = np.random.choice([3, 0])\n          elif dx < 0 and dy >= 0:\n              direction = np.random.choice([2, 1])\n          else:\n              direction = np.random.choice([2, 0])\n\n      actions.append(direction)\n\n      # Update the position based on the chosen direction\n      pos += np.array(([-1, 0] if direction == 2 else [1, 0] if direction == 3 else \n                       [0, -1] if direction == 0 else [0, 1]))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-03T23:42:56.571441", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):  # Prioritize moving in y-direction first\n          direction = (1 if dy > 0 else 0)\n      else:  # If equal, choose an arbitrary direction based on current position and target position\n          direction = np.random.choice([3, 2, 1, 0])\n\n      actions.append(direction)\n\n      # Update the position based on the chosen direction\n      pos += np.array(([-1, 0] if direction == 2 else [1, 0] if direction == 3 else \n                       [0, -1] if direction == 0 else [0, 1]))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:44:27.961968", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n\n  actions.extend(move_towards(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:44:29.859853", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos, min_distance = find_nearest_workshop(pos, workshop_indices, env._current_state.grid)\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T23:46:12.993138", "function_name": "craft", "function_body": "  def navigate_to_workshop(target_pos):\n      pos = np.array(env._current_state.pos)\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      # Determine the direction to move in x-direction first, then y-direction\n      actions = []\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n\n      return actions\n\n  def find_closest_workshop():\n      cookbook = env.world.cookbook\n      goal_index = cookbook.index[item]\n      if goal_index is None:\n          raise ValueError(\"Unknown item\")\n\n      workshop_indices = env.world.workshop_indices\n      recipes = cookbook.recipes\n\n      closest_workshop_idx, min_distance = None, float('inf')\n      pos = np.array(env._current_state.pos)\n\n      for workshop_idx in workshop_indices:\n          # Check if the workshop can craft the desired item\n          if goal_index in recipes[workshop_idx]:\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n              if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                  workshop_pos_mean = workshop_pos_list.mean(axis=0)\n                  distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = workshop_idx, distance\n\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found that can craft the desired item\")\n\n      return closest_workshop_idx\n\n  def find_nearest_target_position(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      pos = np.array(env._current_state.pos)\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n      return nearest_target_pos\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop()\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target_position(closest_workshop_idx)\n\n  # Navigate to the closest workshop position\n  actions.extend(navigate_to_workshop(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-03T23:46:14.881821", "function_name": "craft", "function_body": "  def navigate_to_workshop(target_pos):\n      pos = np.array(env._current_state.pos)\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      # Determine the direction to move in x-direction first, then y-direction\n      actions = []\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n\n      return actions\n\n  def find_closest_workshop():\n      cookbook = env.world.cookbook\n      goal_index = cookbook.index[item]\n      if goal_index is None:\n          raise ValueError(\"Unknown item\")\n\n      workshop_indices = env.world.workshop_indices\n\n      closest_workshop_idx, min_distance = None, float('inf')\n      pos = np.array(env._current_state.pos)\n\n      for workshop_idx in workshop_indices:\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n      if closest_workshop_idx is None:\n          raise ValueError(\"No available workshop found\")\n\n      return closest_workshop_idx\n\n  def find_nearest_target_position(workshop_idx):\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      pos = np.array(env._current_state.pos)\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n      return nearest_target_pos\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop()\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target_position(closest_workshop_idx)\n\n  # Navigate to the closest workshop position\n  actions.extend(navigate_to_workshop(nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:47:50.717798", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Find the nearest single position of each workshop type to the current position\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      distances = [np.linalg.norm(pos - target_pos, ord=2) for target_pos in workshop_positions]\n      nearest_target_pos = workshop_positions[np.argmin(distances)]\n\n      # Move to the nearest single position of each type of workshop\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              pos[0] += np.sign(dx)\n          else:  # Then move in y-direction\n              pos[1] += np.sign(dy)\n\n      # Use the workshop to craft the item and check if it's the correct one\n      actions.append(4)  # USE\n      env.step(actions[-1])  # Perform the action to see if we can craft the item\n      obs = env.observations()\n\n      # Check if the desired item is in inventory after using the workshop\n      if any(obs['features_dict']['inventory'] == goal_index):\n          return actions\n\n  raise ValueError(\"No available workshop found that can craft the desired item\")", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-03T23:47:52.581578", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n                  nearest_target_pos = target_pos\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Prioritize moving in the direction with the larger component first\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          pos[1] += np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:49:59.238364", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  def find_closest_workshop(workshop_indices, pos):\n      closest_workshop_idx = None\n      min_distance = float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def find_nearest_target_position(target_positions, pos):\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      return nearest_target_pos\n\n  def move_to_position(start_pos, end_pos):\n      actions = []\n      pos = np.array(start_pos)\n      while not np.array_equal(pos, end_pos):\n          dx, dy = end_pos - pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n\n          if direction == 0:  # DOWN\n              pos[1] -= 1\n          elif direction == 1:  # UP\n              pos[1] += 1\n          elif direction == 2:  # LEFT\n              pos[0] -= 1\n          elif direction == 3:  # RIGHT\n              pos[0] += 1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx = find_closest_workshop(workshop_indices, pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = find_nearest_target_position(target_positions, pos)\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:50:01.244825", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          return 1 if dy > 0 else 0  # UP or DOWN\n      else:  # If equal, choose a direction based on the first non-zero component\n          if dx > 0:\n              return 3  # RIGHT\n          elif dx < 0:\n              return 2  # LEFT\n          elif dy > 0:\n              return 1  # UP\n          else:\n              return 0  # DOWN\n\n  def find_closest_workshop(workshop_indices, pos):\n      closest_workshop_idx = None\n      min_distance = float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def find_nearest_target_position(target_positions, pos):\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx = find_closest_workshop(workshop_indices, pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = find_nearest_target_position(target_positions, pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"": 0.5}}
