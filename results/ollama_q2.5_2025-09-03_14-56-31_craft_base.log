se the workshop to craft the item\n  actions.append(4)  # USE\n  \n  # Check if crafting is successful\n  state = env._current_state\n  if not state.inventory[goal_index] and state.next_to(closest_workshop_idx):\n      print(\"Crafting failed. Trying again...\")\n      actions.extend(craft_v1(env, item))  # Retry crafting\n\n  return actions", "island_id": 9, "scores": {}}
{"timestamp": "2025-09-03T17:34:23.663228", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Adjust the direction based on the current facing direction of the agent\n  def adjust_direction(current_state, dx, dy):\n      # Assuming the agent is initially facing up (0) for simplicity\n      if dy < 0: return 0  # UP\n      elif dy > 0: return 1  # DOWN\n      elif dx < 0: return 2  # LEFT\n      else: return 3  # RIGHT\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in and adjust based on current facing\n      dir_idx = adjust_direction(current_state, dx, dy)\n      actions.append(dir_idx)\n\n      # Update the position accordingly\n      if dir_idx == 0:\n          pos[1] -= 1\n      elif dir_idx == 1:\n          pos[1] += 1\n      elif dir_idx == 2:\n          pos[0] -= 1\n      else:\n          pos[0] += 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T17:34:26.051119", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Check if there is any location for the workshop\n      workshop_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Compute mean position of all workshops of this type\n      workshop_pos_mean = workshop_positions.mean(axis=0)\n\n      # Calculate distance to the mean workshop position\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n      # Update closest workshop if necessary\n      if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Find the nearest position to move towards among all workshops of the closest type\n  target_positions = np.argwhere(current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda target: np.linalg.norm(pos - target))\n\n  # Move to the nearest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in based on the largest distance component\n      if abs(dx) > abs(dy):\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": 0.0}}
