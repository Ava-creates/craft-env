{"timestamp": "2025-09-04T14:00:57.152646", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to(target_pos, current_pos):\n    path = []\n    while not np.array_equal(current_pos, target_pos):\n        dx, dy = target_pos - current_pos\n        direction = get_direction(dx, dy)\n        path.append(direction)\n\n        if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n            current_pos[0] += 1 if dx > 0 else -1\n        else:  # Then move in y-direction\n            current_pos[1] += 1 if dy > 0 else -1\n\n    path.append(4)  # USE after reaching the target position\n    return path\n\n  closest_workshop = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip if no workshops of this type\n          continue\n\n      nearest_target_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - env._current_state.pos))\n      \n      distance = np.linalg.norm(np.array(nearest_target_pos) - env._current_state.pos)\n      if distance < min_distance:\n          closest_workshop = nearest_target_pos\n          min_distance = distance\n\n  # Move to the closest workshop and use it\n  if closest_workshop is not None:\n      actions.extend(move_to(closest_workshop, np.array(env._current_state.pos)))\n  else:\n      raise ValueError(\"No available workshop found\")\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:00:59.037810", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to(target_pos, current_pos):\n    while not np.array_equal(current_pos, target_pos):\n        dx, dy = target_pos - current_pos\n        direction = get_direction(dx, dy)\n        actions.append(direction)\n\n        # Move in the direction with the largest distance first\n        if abs(dx) >= abs(dy):  \n            current_pos[0] += 1 if dx > 0 else -1\n        else:\n            current_pos[1] += 1 if dy > 0 else -1\n\n    actions.append(4)  # USE after reaching the target position\n\n  closest_workshop = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip if no workshops of this type\n          continue\n\n      nearest_target_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - env._current_state.pos))\n      \n      distance = np.linalg.norm(np.array(nearest_target_pos) - env._current_state.pos)\n      if distance < min_distance:\n          closest_workshop = nearest_target_pos\n          min_distance = distance\n\n  # Move to the closest workshop and use it\n  if closest_workshop is not None:\n      move_to(closest_workshop, np.array(env._current_state.pos))\n  else:\n      raise ValueError(\"No available workshop found\")\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
