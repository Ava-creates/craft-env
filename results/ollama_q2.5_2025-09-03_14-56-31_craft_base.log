ving in x-direction first\n          new_x = pos[0] + (1 if dx > 0 else -1)\n          pos[0] = new_x\n      else:  # Then move in y-direction\n          new_y = pos[1] + (1 if dy > 0 else -1)\n          pos[1] = new_y\n\n      # Check if we are next to a workshop after each step\n      if env._current_state.next_to(workshop_indices):\n          break\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:16:32.270961", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  closest_workshops = {}\n  \n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          closest_workshops[workshop_idx] = (workshop_pos_mean, distance)\n\n  if not closest_workshops:\n      raise ValueError(\"No available workshop found\")\n\n  # Sort workshops by distance\n  sorted_workshops = sorted(closest_workshops.items(), key=lambda x: x[1])\n\n  for workshop_idx, (mean_pos, _) in sorted_workshops:\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n\n      while not np.array_equal(pos, nearest_target_pos):\n          dx, dy = nearest_target_pos - pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n\n          new_x = pos[0] + (1 if dx > 0 else -1)\n          new_y = pos[1] + (1 if dy > 0 else -1)\n\n          # Check if the next position is a workshop\n          if env._current_state.next_to(workshop_indices):\n              break\n\n          # Move in x-direction first if closer to target\n          if abs(dx) >= abs(dy):\n              pos[0] = new_x\n          else:\n              pos[1] = new_y\n\n      # Check if we are next to a workshop after moving\n      if env._current_state.next_to(workshop_indices):\n          actions.append(4)  # USE\n          return actions\n\n  raise ValueError(\"No reachable workshop found\")", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-04T13:17:27.671314", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to(target_pos, current_pos):\n    while not np.array_equal(current_pos, target_pos):\n        dx, dy = target_pos - current_pos\n        direction = get_direction(dx, dy)\n        actions.append(direction)\n        if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n            current_pos[0] += 1 if dx > 0 else -1\n        else:  # Then move in y-direction\n            current_pos[1] += 1 if dy > 0 else -1\n\n  closest_workshop = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      # If there are no workshops of this type, skip to the next one\n      if len(workshop_positions) == 0:\n          continue\n\n      # Find the nearest workshop of this type\n      for pos in workshop_positions:\n          distance = np.linalg.norm(np.array(pos) - env._current_state.pos)\n          if distance < min_distance:\n              closest_workshop = pos\n              min_distance = distance\n\n  # Move to the closest workshop and use it\n  if closest_workshop is not None:\n      move_to(closest_workshop, np.array(env._current_state.pos))\n      actions.append(4)  # USE\n  else:\n      raise ValueError(\"No available workshop found\")\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:17:28.922863", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              pos[1] += 1 if dy > 0 else -1\n\n      actions.append(4)  # USE after reaching the target position\n\n  # Find the closest workshop that can craft the desired item\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = min(workshop_pos_list, key=lambda pos: np.linalg.norm(np.array(pos) - env._current_state.pos))\n          move_to(nearest_target_pos)\n          break\n\n  if not actions:\n      raise ValueError(\"No available workshop found\")\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:18:22.986383", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      pos += (1 if dx > 0 else (-1 if dx < 0 else 0), 1 if dy > 0 else (-1 if dy < 0 else 0))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T13:18:24.340982", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to_position(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      return (current_pos[0] + (1 if dx > 0 else -1), current_pos[1]) if abs(dx) >= abs(dy) else (current_pos[0], current_pos[1] + (1 if dy > 0 else -1))\n\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target_pos, ord=2) for target_pos in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      pos = move_to_position(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T13:19:36.067791", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  current_pos = np.array(env._current_state.pos)\n  \n  # Determine the most suitable workshop for crafting the item\n  closest_workshop_idx, min_distance = None, float('inf')\n  target_positions = []\n\n  for workshop_idx in workshop_indices:\n      # Find all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos_list) > 0:  # Ensure there are workshops available\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          \n          # Determine if any workshop can craft the desired item\n          for pos in workshop_pos_list:\n              env._current_state.pos = tuple(pos)  # Temporarily set position to check crafting possibility\n              \n              # Check if using a workshop at this position allows crafting the desired item\n              _, done, _ = env.step(4, num_steps=1)  # Attempt to use the workshop\n              \n              if done:  # If crafting was successful, consider this workshop suitable\n                  distance = np.linalg.norm(current_pos - pos, ord=2)\n                  \n                  if distance < min_distance:\n                      closest_workshop_idx, min_distance = workshop_idx, distance\n                      target_positions = [pos]\n                  elif distance == min_distance:\n                      target_positions.append(pos)\n\n  # Reset the agent's position to its original state after checking workshops\n  env._current_state.pos = tuple(current_pos)\n  \n  if not target_positions:  # No suitable workshop found that can craft the desired item\n      raise ValueError(\"No available workshop found that can craft the specified item\")\n  \n  # Calculate the closest position among suitable workshops\n  nearest_target_pos = min(target_positions, key=lambda pos: np.linalg.norm(current_pos - pos, ord=2))\n  \n  # Move to the closest workshop position\n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n      direction = get_direction(dx, dy)\n      \n      actions.append(direction)\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          current_pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"": -1}}
