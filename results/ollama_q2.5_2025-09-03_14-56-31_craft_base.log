{"timestamp": "2025-09-04T14:20:22.659686", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          nearest_target_pos = workshop_pos_list[np.argmin(np.linalg.norm(pos - workshop_pos_list, axis=1))]\n          distance = np.linalg.norm(nearest_target_pos - pos)\n\n          if distance < min_distance:\n              nearest_workshop_idx = workshop_idx\n              min_distance = distance\n\n  if nearest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  nearest_target_pos = np.argwhere(env._current_state.grid[:, :, nearest_workshop_idx])[np.argmin(np.linalg.norm(pos - np.argwhere(env._current_state.grid[:, :, nearest_workshop_idx]), axis=1))]\n  \n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:20:24.637707", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  def move_to(target_pos, current_pos):\n    path = []\n    while not np.array_equal(current_pos, target_pos):\n        dx, dy = target_pos - current_pos\n        direction = get_direction(dx, dy)\n        path.append(direction)\n\n        if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n            current_pos[0] += 1 if dx > 0 else -1\n        else:  # Then move in y-direction\n            current_pos[1] += 1 if dy > 0 else -1\n\n    path.append(4)  # USE after reaching the target position\n    return path\n\n  closest_workshop = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_positions) == 0:  # Skip if no workshops of this type\n          continue\n      \n      nearest_target_pos = min(workshop_positions, key=lambda pos: np.linalg.norm(np.array(pos) - env._current_state.pos))\n      \n      distance = np.linalg.norm(np.array(nearest_target_pos) - env._current_state.pos)\n      if distance < min_distance:\n          closest_workshop = nearest_target_pos\n          min_distance = distance\n\n  # Move to the closest workshop and use it\n  if closest_workshop is not None:\n      actions.extend(move_to(closest_workshop, np.array(env._current_state.pos)))\n  else:\n      raise ValueError(\"No available workshop found\")\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:21:38.893404", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def get_closest_workshop_and_target():\n      pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      nearest_target_pos = None\n      for workshop_idx in workshop_indices:\n          # Find all positions where the workshop is present\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n              if distance < min_distance:\n                  closest_workshop_idx = workshop_idx\n                  min_distance = distance\n\n                  # Find nearest target position to this workshop\n                  min_nearest_distance = float('inf')\n                  for target_pos in workshop_pos_list:\n                      distance_to_target = np.linalg.norm(pos - target_pos, ord=2)\n                      if distance_to_target < min_nearest_distance:\n                          nearest_target_pos = target_pos\n                          min_nearest_distance = distance_to_target\n\n      return closest_workshop_idx, nearest_target_pos\n\n  closest_workshop_idx, nearest_target_pos = get_closest_workshop_and_target()\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  pos = np.array(env._current_state.pos)\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n\n      actions.append(direction)\n      env.step(action=direction, num_steps=1)  # Take the step to move closer\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 1, "scores": {"": 0.5}}
