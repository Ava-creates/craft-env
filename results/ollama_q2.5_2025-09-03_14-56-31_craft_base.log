{"timestamp": "2025-09-03T20:51:19.109979", "function_name": "craft", "function_body": "  def move_towards_target(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n\n      # Optimize the path to minimize turns and moves\n      if steps_x <= steps_y:\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n      else:\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n\n      return actions\n\n  def find_nearest_workshop(env, goal_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      current_pos = np.array(env._current_state.pos)\n\n      for workshop_idx in workshop_indices:\n          if workshop_idx not in cookbook.primitives_for_item(goal_index):\n              continue\n\n          # Calculate the mean position of all workshops of this type\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              return workshop_idx, workshop_pos_mean\n\n      raise ValueError(\"No available workshop found\")\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_target_pos = find_nearest_workshop(env, goal_index)\n\n  actions = []\n\n  # Move towards the closest workshop position\n  current_pos = np.array(env._current_state.pos)\n  actions.extend(move_towards_target(current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-03T20:51:21.107603", "function_name": "craft", "function_body": "  def move_towards_target(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Optimize the path to minimize turns and moves\n      if steps_x > 0:\n          if dx > 0:\n              actions.extend([3] * steps_x)  # Move RIGHT\n          elif dx < 0:\n              actions.extend([2] * steps_x)  # Move LEFT\n      \n      if steps_y > 0:\n          if dy > 0:\n              actions.extend([1] * steps_y)  # Move UP\n          elif dy < 0:\n              actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n\n  def find_closest_workshop(item_index, workshop_indices):\n      current_pos = np.array(env._current_state.pos)\n      closest_workshop_idx, min_distance = None, float('inf')\n      \n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          \n          if len(workshop_pos_list) > 0:\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(current_pos - workshop_pos_mean, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      \n      return closest_workshop_idx\n\n  def find_nearest_target_position(workshop_idx):\n      current_pos = np.array(env._current_state.pos)\n      target_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      \n      for target_pos in target_positions:\n          distance = np.linalg.norm(current_pos - target_pos, ord=2)\n          \n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      \n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(goal_index, workshop_indices)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  nearest_target_pos = find_nearest_target_position(closest_workshop_idx)\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(current_pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-03T20:53:31.196173", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Use A* search to find the optimal path to the closest workshop position\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def a_star(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = tuple(np.array(current) + np.array((dx, dy)))\n\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and \n                      0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              tentative_g_score = g_score[tuple(current)] + heuristic(current, neighbor)\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[neighbor], neighbor))\n\n      return None\n\n  path = a_star(pos, nearest_target_pos)\n\n  if path is None:\n      raise ValueError(\"No valid path to the workshop\")\n\n  # Convert path to actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-03T20:53:33.996520", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      \n      # Move directly to the nearest target position\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)  # RIGHT or LEFT\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)   # DOWN or UP\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n  \n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T20:55:12.146515", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp) for tp in target_positions])]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):  # Prioritize moving in y-direction first\n          direction = (1 if dy > 0 else 0)\n      else:  # If equal, choose an arbitrary direction\n          direction = np.random.choice([1, 3]) if dx >= 0 else np.random.choice([2, 0])\n\n      actions.append(direction)\n\n      # Update the position based on the chosen direction\n      pos += np.array(([-1, 0] if direction == 2 else [1, 0] if direction == 3 else \n                       [0, -1] if direction == 0 else [0, 1]))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
