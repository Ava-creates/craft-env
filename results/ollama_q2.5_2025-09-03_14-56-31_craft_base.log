if abs(dx) >= abs(dy) else pos[0]\n      new_y = pos[1] + (1 if dy > 0 else -1) if abs(dx) < abs(dy) else pos[1]\n\n      # Update position and check if next to a workshop\n      pos[0] = new_x\n      pos[1] = new_y\n\n      # Check if the agent is next to any workshop\n      for w_idx in workshop_indices:\n          if env._current_state.next_to(w_idx):\n              actions.append(4)  # USE\n              return actions\n\n  # Final check before using the workshop\n  if env._current_state.next_to(closest_workshop_idx):\n      actions.append(4)  # USE\n  else:\n      raise ValueError(\"Failed to reach a workshop\")\n\n  return actions", "island_id": 7, "scores": {"": -1}}
{"timestamp": "2025-09-04T09:43:51.770637", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      new_x = pos[0] + (1 if dx > 0 else -1) if abs(dx) >= abs(dy) else pos[0]\n      new_y = pos[1] + (1 if dy > 0 else -1) if abs(dx) < abs(dy) else pos[1]\n\n      # Handle boundary conditions to prevent out-of-bounds movement\n      new_x = max(0, min(new_x, env._current_state.grid.shape[0]-1))\n      new_y = max(0, min(new_y, env._current_state.grid.shape[1]-1))\n\n      # Update position and check if next to a workshop\n      pos[0] = new_x\n      pos[1] = new_y\n\n      for w_idx in workshop_indices:\n          if env._current_state.next_to(w_idx):\n              actions.append(4)  # USE\n              return actions\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T09:45:36.358033", "function_name": "craft", "function_body": "  def path_to(pos, target_pos):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # UP, RIGHT, DOWN, LEFT\n    queue = collections.deque([(pos, [])])\n    visited = set([tuple(pos)])\n    \n    while queue:\n        current_pos, path = queue.popleft()\n        \n        if np.array_equal(current_pos, target_pos):\n            return path\n        \n        for direction in directions:\n            next_pos = current_pos + np.array(direction)\n            \n            # Check bounds and obstacles\n            if (0 <= next_pos[0] < env._current_state.grid.shape[0] and\n                0 <= next_pos[1] < env._current_state.grid.shape[1]):\n                if tuple(next_pos) not in visited:\n                    queue.append((next_pos, path + [direction]))\n                    visited.add(tuple(next_pos))\n    \n    return []\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  def find_closest_workshop():\n    min_distance = float('inf')\n    closest_workshop_idx = None\n    current_pos = np.array(env._current_state.pos)\n\n    for workshop_idx in workshop_indices:\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n        if len(workshop_positions) == 0: continue\n\n        # Calculate the mean position of all workshops of this type\n        workshop_mean_position = workshop_positions.mean(axis=0)\n        distance_to_workshop = np.linalg.norm(current_pos - workshop_mean_position, ord=2)\n\n        if distance_to_workshop < min_distance:\n            closest_workshop_idx = workshop_idx\n            min_distance = distance_to_workshop\n    \n    return closest_workshop_idx\n\n  closest_workshop_idx = find_closest_workshop()\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  def find_nearest_target_position(target_positions, current_pos):\n    min_distance = float('inf')\n    nearest_target_pos = None\n\n    for pos in target_positions:\n        distance = np.linalg.norm(current_pos - pos, ord=2)\n        if distance < min_distance:\n            nearest_target_pos = pos\n            min_distance = distance\n    \n    return nearest_target_pos\n  \n  nearest_target_pos = find_nearest_target_position(target_positions, env._current_state.pos)\n\n  # Get path to the closest workshop position\n  current_pos = np.array(env._current_state.pos)\n  path = path_to(current_pos, nearest_target_pos)\n\n  # Convert directions to actions\n  direction_to_action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}\n  for direction in path:\n      action = direction_to_action[tuple(direction)]\n      actions.append(action)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T09:45:38.331003", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  def find_closest_workshop():\n    min_distance = float('inf')\n    closest_workshop_idx = None\n    current_pos = np.array(env._current_state.pos)\n\n    for workshop_idx in workshop_indices:\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n        if len(workshop_positions) == 0: continue\n\n        # Calculate the mean position of all workshops of this type\n        workshop_mean_position = workshop_positions.mean(axis=0)\n        distance_to_workshop = np.linalg.norm(current_pos - workshop_mean_position, ord=2)\n\n        if distance_to_workshop < min_distance:\n            closest_workshop_idx = workshop_idx\n            min_distance = distance_to_workshop\n    \n    return closest_workshop_idx\n\n  closest_workshop_idx = find_closest_workshop()\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  def find_nearest_target_position(target_positions, current_pos):\n    min_distance = float('inf')\n    nearest_target_pos = None\n\n    for pos in target_positions:\n        distance = np.linalg.norm(current_pos - pos, ord=2)\n        if distance < min_distance:\n            nearest_target_pos = pos\n            min_distance = distance\n    \n    return nearest_target_pos\n  \n  nearest_target_pos = find_nearest_target_position(target_positions, env._current_state.pos)\n\n  # Move to the closest workshop position using A* search for efficiency\n  current_pos = np.array(env._current_state.pos)\n  \n  def a_star_search(start, goal):\n      open_set = [(0, start)]\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while open_set:\n          _, current = min(open_set, key=lambda x: x[0])\n          open_set.remove((f_score[tuple(current)], current))\n\n          if np.array_equal(current, goal):\n              return reconstruct_path(came_from, current)\n\n          for neighbor in get_neighbors(current):\n              tentative_g_score = g_score[tuple(current)] + 1\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  if tuple(neighbor) not in [f[1] for f in open_set]:\n                      open_set.append((f_score[tuple(neighbor)], neighbor))\n      return None\n\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=2)\n\n  def get_neighbors(pos):\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      neighbors = []\n      \n      for direction in directions:\n          next_pos = pos + np.array(direction)\n          \n          # Check bounds and obstacles\n          if (0 <= next_pos[0] < env._current_state.grid.shape[0] and\n              0 <= next_pos[1] < env._current_state.grid.shape[1]):\n              neighbors.append(next_pos)\n      \n      return neighbors\n\n  def reconstruct_path(came_from, current):\n      total_path = [tuple(current)]\n      while tuple(current) in came_from:\n          current = came_from[tuple(current)]\n          total_path.append(tuple(current))\n      total_path.reverse()\n      return total_path\n  \n  path = a_star_search(current_pos, nearest_target_pos)\n\n  if not path:\n      raise ValueError(\"No valid path found to the workshop\")\n\n  # Convert path to actions\n  direction_to_action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}\n  \n  for i in range(len(path) - 1):\n      direction = tuple(path[i + 1] - path[i])\n      action = direction_to_action[direction]\n      actions.append(action)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-04T09:47:11.630527", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* pathfinding\n  def heuristic(a, b):\n      return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])\n\n  def a_star(start, goal):\n      open_set = collections.deque([start])\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while open_set:\n          current = min(open_set, key=lambda x: f_score[tuple(x)])\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              return path[::-1]\n\n          open_set.remove(tuple(current))\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = np.array([current[0] + dx, current[1] + dy])\n\n              # Check if the neighbor is within grid bounds and traversable\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0] and 0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              tentative_g_score = g_score[tuple(current)] + 1\n\n              # If the neighboring grid cell is blocked, skip it\n              if any(env._current_state.grid[neighbor[0], neighbor[1], block_idx] > 0 for block_idx in env.world.non_grabbable_indices):\n                  continue\n\n              if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n                  came_from[tuple(neighbor)] = current\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  if tuple(neighbor) not in open_set:\n                      open_set.append(tuple(neighbor))\n\n      return None\n\n  path = a_star(pos, nearest_target_pos)\n\n  if path is None:\n      raise ValueError(\"No valid path to the workshop found\")\n\n  # Convert path to actions\n  for step in path[1:]:  # Skip the starting point\n      dx, dy = step - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
