tion\n      if direction == 3:  # RIGHT\n          pos[0] += 1\n      elif direction == 2:  # LEFT\n          pos[0] -= 1\n      elif direction == 1:  # UP\n          pos[1] += 1\n      else:  # DOWN\n          pos[1] -= 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:13:09.665402", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  \n          closest_workshop, _ = min(\n              ((pos2, np.linalg.norm(pos - pos2)) for pos2 in workshop_pos_list),\n              key=lambda x: x[1]\n          )\n          distance = np.linalg.norm(pos - closest_workshop)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda pos2: np.linalg.norm(pos - pos2))\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      if abs(dx) >= abs(dy):  \n          pos[0] += 1 if dx > 0 else -1\n      else:  \n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T14:13:11.602558", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  \n          closest_workshop, _ = min(\n              ((pos2, np.linalg.norm(pos - pos2)) for pos2 in workshop_pos_list),\n              key=lambda x: x[1]\n          )\n          distance = np.linalg.norm(pos - closest_workshop)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda pos2: np.linalg.norm(pos - pos2))\n\n  # Move to the closest workshop position using A* search for better path finding\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star_search(start, goal, grid):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      f_score = {tuple(start): heuristic(start, goal)}\n\n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.reverse()\n              return path\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if grid[neighbor[0], neighbor[1]] > 0 and tuple(neighbor) not in g_score:\n                  tentative_g_score = g_score[tuple(current)] + 1\n                  came_from[tuple(neighbor)] = tuple(current)\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n                  open_set.put((f_score[tuple(neighbor)], neighbor))\n      return None\n\n  path_to_workshop = a_star_search(tuple(pos), tuple(nearest_target_pos), env._current_state.grid[:, :, 0])\n\n  if not path_to_workshop:\n      raise ValueError(\"Path to workshop not found\")\n\n  for step in path_to_workshop[1:]:  \n      dx, dy = step[0] - pos[0], step[1] - pos[1]\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      pos[0], pos[1] = step\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-04T14:14:21.935908", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to_position(current_pos, target_pos):\n      while not np.array_equal(current_pos, target_pos):\n          dx, dy = target_pos - current_pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n\n          # Adjust position based on chosen direction\n          if direction == 3:  # RIGHT\n              current_pos[0] += 1\n          elif direction == 2:  # LEFT\n              current_pos[0] -= 1\n          elif direction == 1:  # UP\n              current_pos[1] += 1\n          else:  # DOWN\n              current_pos[1] -= 1\n\n      return current_pos\n\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - target_pos, ord=2) for target_pos in target_positions])]\n\n  # Move to the closest workshop position\n  pos = move_to_position(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": 0.5}}
