{"timestamp": "2025-09-03T22:43:45.455958", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Prioritize moving in the direction with the largest component first\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          pos[1] += np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T22:45:53.857071", "function_name": "craft", "function_body": "  def bfs(start_pos, target_idx):\n      queue = collections.deque([(start_pos, [])])\n      visited = set([tuple(start_pos)])\n      while queue:\n          current_pos, path = queue.popleft()\n          if env._current_state.grid[current_pos[0], current_pos[1], target_idx] == 1:\n              return path\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              new_pos = (current_pos[0] + dx, current_pos[1] + dy)\n              if (0 <= new_pos[0] < env._current_state.grid.shape[0] and\n                  0 <= new_pos[1] < env._current_state.grid.shape[1] and\n                  tuple(new_pos) not in visited):\n                  visited.add(tuple(new_pos))\n                  queue.append((new_pos, path + [get_direction(current_pos, new_pos)]))\n      return None\n\n  def get_direction(from_pos, to_pos):\n      dx, dy = to_pos[0] - from_pos[0], to_pos[1] - from_pos[1]\n      if dx == 1:\n          return 3\n      elif dx == -1:\n          return 2\n      elif dy == 1:\n          return 1\n      elif dy == -1:\n          return 0\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the path to the closest workshop position using BFS\n  path_to_workshop = bfs(tuple(pos), closest_workshop_idx)\n  \n  if path_to_workshop is None:\n      raise ValueError(\"Path to workshop not found\")\n\n  actions.extend(path_to_workshop)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T22:50:53.944065", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the shortest path to the closest workshop position\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Use a simple BFS for finding the shortest path\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {tuple(start): None}\n\n      while queue:\n          current = queue.popleft()\n          if tuple(current) == tuple(goal):\n              break\n\n          # Get valid neighbors (up, down, left, right)\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = current + np.array([dx, dy])\n              if (0 <= neighbor[0] < env._current_state.grid.shape[0] and \n                  0 <= neighbor[1] < env._current_state.grid.shape[1] and\n                  tuple(neighbor) not in visited):\n                  queue.append(neighbor)\n                  visited.add(tuple(neighbor))\n                  parent[tuple(neighbor)] = current\n\n      # Reconstruct path from start to goal\n      path = []\n      step = goal\n      while parent[tuple(step)] is not None:\n          path.append(step)\n          step = parent[tuple(step)]\n      path.reverse()\n      return path\n\n  path_to_workshop = bfs(pos, nearest_target_pos)\n\n  # Move along the path\n  for next_step in path_to_workshop:\n      dx, dy = next_step - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):  # Prioritize moving in y-direction first\n          direction = (1 if dy > 0 else 0)\n      else:  # If equal, choose an arbitrary direction\n          direction = np.random.choice([1, 3]) if dx >= 0 else np.random.choice([2, 0])\n\n      actions.append(direction)\n\n      # Update the position based on the chosen direction\n      pos += np.array(([-1, 0] if direction == 2 else [1, 0] if direction == 3 else \n                       [0, -1] if direction == 0 else [0, 1]))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": -1}}
