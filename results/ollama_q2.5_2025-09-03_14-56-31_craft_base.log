{"timestamp": "2025-09-03T23:00:32.732222", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the positions of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n          nearest_workshop_pos = workshop_pos_list[np.argmin(distances)]\n          distance = np.min(distances)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  nearest_target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])[np.argmin(distances)]\n  \n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in based on Manhattan distance heuristic\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx):  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:00:34.862681", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the shortest path to the closest workshop position using BFS\n  def bfs(start, goal):\n      queue = collections.deque([start])\n      parent = {tuple(start): None}\n\n      while queue:\n          current = queue.popleft()\n          if np.array_equal(current, goal):\n              break\n\n          neighbors = []\n          if current[0] > 0: neighbors.append((current[0]-1, current[1]))\n          if current[0] < env._current_state.grid.shape[0] - 1: neighbors.append((current[0]+1, current[1]))\n          if current[1] > 0: neighbors.append((current[0], current[1]-1))\n          if current[1] < env._current_state.grid.shape[1] - 1: neighbors.append((current[0], current[1]+1))\n\n          for neighbor in neighbors:\n              if tuple(neighbor) not in parent:\n                  queue.append(neighbor)\n                  parent[tuple(neighbor)] = current\n\n      path = []\n      while goal is not None:\n          path.append(goal)\n          goal = parent.get(tuple(goal))\n      return path[::-1]\n\n  # Get the shortest path to the closest workshop position\n  path = bfs(tuple(pos), tuple(nearest_target_pos))\n\n  if not path:\n      raise ValueError(\"No valid path found to the workshop\")\n\n  # Translate path into actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i+1][0] - path[i][0], path[i+1][1] - path[i][1]\n      if dx > 0:\n          actions.append(3)\n      elif dx < 0:\n          actions.append(2)\n      elif dy > 0:\n          actions.append(1)\n      elif dy < 0:\n          actions.append(0)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T23:02:32.972886", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      direction = None\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          direction = (3 if dx > 0 else 2)\n      elif abs(dx) < abs(dy):  # Prioritize moving in y-direction first\n          direction = (1 if dy > 0 else 0)\n      else:  # If equal, choose an arbitrary direction based on current position and target position\n          if dx >= 0 and dy >= 0:\n              direction = np.random.choice([3, 1])\n          elif dx >= 0 and dy < 0:\n              direction = np.random.choice([3, 0])\n          elif dx < 0 and dy >= 0:\n              direction = np.random.choice([2, 1])\n          else:\n              direction = np.random.choice([2, 0])\n\n      actions.append(direction)\n\n      # Update the position based on the chosen direction\n      pos += np.array(([-1, 0] if direction == 2 else [1, 0] if direction == 3 else \n                       [0, -1] if direction == 0 else [0, 1]))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": 0.5}}
