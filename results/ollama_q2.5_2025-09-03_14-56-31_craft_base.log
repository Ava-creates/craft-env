lign direction with the target position\n  current_dir = env._current_state.dir\n  required_dir = np.argmax(nearest_target_pos - pos + (pos == nearest_target_pos) * (np.array([0, 1]) * (2 * (current_dir % 2) - 1)))\n\n  while required_dir != current_dir:\n      if (required_dir - current_dir) % 4 == 1 or (required_dir - current_dir) % 4 == -3:\n          actions.append(5)  # RIGHT\n      elif (required_dir - current_dir) % 4 == 2:\n          actions.append(5)  # RIGHT * 2\n          actions.append(5)\n      elif (required_dir - current_dir) % 4 == 3 or (required_dir - current_dir) % 4 == -1:\n          actions.append(6)  # LEFT\n      current_dir = required_dir\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"": 0.0}}
