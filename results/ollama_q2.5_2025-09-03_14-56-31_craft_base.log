.extend(move_towards(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T00:05:54.292371", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest available workshop position that can craft the desired item\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      for workshop_pos in workshop_pos_list:\n          distance = np.linalg.norm(pos - workshop_pos, ord=2)\n          if distance < min_distance:\n              nearest_workshop_pos = workshop_pos\n              min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  actions.extend(move_towards(pos, nearest_workshop_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T00:08:02.752353", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Path planning to reach the nearest workshop without obstacles\n  def path_planning(start, goal):\n      # Simple BFS for pathfinding\n      queue = collections.deque([(start, [])])\n      visited = set()\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if tuple(current_pos) == tuple(goal):\n              return path\n\n          if tuple(current_pos) in visited:\n              continue\n\n          visited.add(tuple(current_pos))\n\n          # Possible moves: UP, DOWN, LEFT, RIGHT\n          for d in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              next_pos = current_pos + np.array(d)\n              if (next_pos[0] >= 0 and next_pos[0] < env._current_state.grid.shape[0] and\n                  next_pos[1] >= 0 and next_pos[1] < env._current_state.grid.shape[1] and\n                  not any(env._current_state.grid[next_pos[0], next_pos[1], b] for b in env.world.cookbook.primitives)):\n                  queue.append((next_pos, path + [get_direction(d[0], d[1])]))\n\n      return None\n\n  path = path_planning(pos, nearest_target_pos)\n  if path is None:\n      raise ValueError(\"No available path to the workshop\")\n\n  actions.extend(path)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T00:08:04.634499", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  nearest_target_pos = target_positions[np.argmin([np.linalg.norm(pos - tp, ord=2) for tp in target_positions])]\n\n  # Path planning to reach the nearest workshop without obstacles\n  def path_planning(start, goal):\n      # Simple BFS for pathfinding\n      queue = collections.deque([(start, [])])\n      visited = set()\n\n      while queue:\n          current_pos, path = queue.popleft()\n          if tuple(current_pos) == tuple(goal):\n              return path\n\n          if tuple(current_pos) in visited:\n              continue\n\n          visited.add(tuple(current_pos))\n\n          # Possible moves: UP, DOWN, LEFT, RIGHT\n          for d in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n              next_pos = current_pos + np.array(d)\n              if (next_pos[0] >= 0 and next_pos[0] < env._current_state.grid.shape[0] and\n                  next_pos[1] >= 0 and next_pos[1] < env._current_state.grid.shape[1]):\n                  # Check if the next position is a valid move by ensuring it's not blocked by any primitives\n                  is_blocked = False\n                  for primitive_idx in env.world.cookbook.primitives:\n                      if env._current_state.grid[next_pos[0], next_pos[1], primitive_idx]:\n                          is_blocked = True\n                          break\n\n                  if not is_blocked:\n                      queue.append((next_pos, path + [get_direction(d[0], d[1])]))\n\n      return None\n\n  path = path_planning(pos, nearest_target_pos)\n  if path is None:\n      raise ValueError(\"No available path to the workshop\")\n\n  actions.extend(path)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"": 0.5}}
