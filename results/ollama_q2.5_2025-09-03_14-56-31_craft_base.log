{"timestamp": "2025-09-04T02:55:16.572875", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)  # RIGHT or LEFT\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)   # DOWN or UP\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def find_closest_workshop_with_item(env, item_index):\n      cookbook = env.world.cookbook\n      workshop_indices = env.world.workshop_indices\n      \n      for workshop_idx in workshop_indices:\n          # Check if the workshop can craft the desired item\n          recipe = cookbook.primitives.get(item_index)\n          \n          if recipe is not None and any(wkspc_type == workshop_idx for wkspc_type in recipe[\"workshops\"]):\n              # Calculate the mean position of all workshops of this type\n              workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n              if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n                  return workshop_idx, workshop_pos_list.mean(axis=0)\n      \n      raise ValueError(\"No available workshop found that can craft the item\")\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, nearest_workshop_pos = find_closest_workshop_with_item(env, goal_index)\n  \n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  # Find the nearest target position\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n  \n  # Move directly to the nearest target position\n  actions.extend(move_towards(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": -1}}
{"timestamp": "2025-09-04T02:55:18.610048", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)  # RIGHT or LEFT\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)   # DOWN or UP\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n      return actions\n\n  def get_workshop_positions(env, workshop_indices):\n      positions = []\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          positions.extend(workshop_pos_list)\n      return positions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Get all workshop positions\n  workshop_positions = get_workshop_positions(env, workshop_indices)\n  \n  # Find the nearest target position\n  nearest_target_pos = min(workshop_positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n  \n  # Move directly to the nearest target position\n  actions.extend(move_towards(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T02:57:13.089766", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position using A* algorithm\n  def heuristic(a, b):\n      return np.sum((a-b)**2)\n\n  def a_star_search(start, goal):\n      open_set = collections.PriorityQueue()\n      open_set.put((0, start))\n      came_from = {}\n      g_score = {tuple(start): 0}\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n\n          if np.array_equal(current, goal):\n              path = []\n              while tuple(current) in came_from:\n                  path.append(tuple(current))\n                  current = came_from[tuple(current)]\n              path.reverse()\n              return path[1:]  # Exclude the start position\n\n          neighbors = [\n              (current[0] + 1, current[1]),\n              (current[0] - 1, current[1]),\n              (current[0], current[1] + 1),\n              (current[0], current[1] - 1)\n          ]\n\n          for neighbor in neighbors:\n              tentative_g_score = g_score[tuple(current)] + 1\n              \n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[tuple(neighbor)] = tuple(current)\n                  g_score[tuple(neighbor)] = tentative_g_score\n                  f_score = tentative_g_score + heuristic(np.array(neighbor), goal)\n                  open_set.put((f_score, neighbor))\n      \n      return None\n\n  path_to_workshop = a_star_search(tuple(pos), tuple(nearest_target_pos))\n\n  if path_to_workshop is None:\n      raise ValueError(\"No path found to the workshop\")\n\n  # Convert path into actions\n  for next_pos in path_to_workshop:\n      dx, dy = next_pos[0] - pos[0], next_pos[1] - pos[1]\n      \n      if abs(dx) >= abs(dy):\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"": -1}}
{"timestamp": "2025-09-04T02:57:15.007123", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(target_positions - pos, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T02:59:53.392749", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # A* search to find the shortest path to the workshop\n  def get_path_astar(start, goal):\n      open_set = set([start])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: np.linalg.norm(np.array(start) - np.array(goal), ord=2)}\n\n      while open_set:\n          current = min(open_set, key=lambda x: f_score[x])\n\n          if current == goal:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n\n          open_set.remove(current)\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if not (0 <= neighbor[0] < env._current_state.grid.shape[0]) or\\\n                 not (0 <= neighbor[1] < env._current_state.grid.shape[1]):\n                  continue\n\n              tentative_g_score = g_score[current] + 1\n              if tentative_g_score < g_score.get(neighbor, float('inf')):\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + np.linalg.norm(np.array(neighbor) - np.array(goal), ord=2)\n                  open_set.add(neighbor)\n\n      return []\n\n  path_to_workshop = get_path_astar(tuple(pos), tuple(nearest_target_pos))\n\n  # Translate the path into actions\n  for next_step in path_to_workshop[1:]:\n      dx, dy = np.array(next_step) - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += dx\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += dy\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"": 0.5}}
