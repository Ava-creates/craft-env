{"timestamp": "2025-09-04T13:34:26.433855", "function_name": "craft", "function_body": "  def find_closest_workshop_position(workshop_idx):\n      pos = np.array(env._current_state.pos)\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) == 0:\n          return None, float('inf')\n      nearest_target_pos = min(workshop_pos_list, key=lambda x: np.linalg.norm(pos - x, ord=2))\n      distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n      return nearest_target_pos, distance\n\n  def move_to(target_pos):\n      pos = np.array(env._current_state.pos)\n      actions = []\n      \n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          \n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              if dir_x is not None:\n                  actions.append(dir_x)\n                  pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              if dir_y is not None:\n                  actions.append(dir_y)\n                  pos[1] += 1 if dy > 0 else -1\n      \n      return actions\n\n  def find_workshop_for_item(goal_index):\n      cookbook = env.world.cookbook\n      for recipe, ingredients in cookbook.recipes.items():\n          if goal_index in ingredients:\n              workshop_idx = None\n              # Determine the type of workshop required based on the item index\n              if goal_index in [PLANK, STICK]:\n                  workshop_idx = WORKSHOP0  # Example assignment\n              elif goal_index in [HAMMER, KNIFE]:\n                  workshop_idx = WORKSHOP1  # Example assignment\n              else:\n                  workshop_idx = WORKSHOP2  # Default assignment\n              return workshop_idx\n      return None\n\n