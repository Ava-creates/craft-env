     else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T09:27:12.101469", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          step_x = 1 if dx > 0 else -1\n          while not np.array_equal(pos, nearest_target_pos) and abs(nearest_target_pos[0] - pos[0]) >= abs(step_x):\n              actions.append(direction)\n              pos[0] += step_x\n      else:  # Then move in y-direction\n          step_y = 1 if dy > 0 else -1\n          while not np.array_equal(pos, nearest_target_pos) and abs(nearest_target_pos[1] - pos[1]) >= abs(step_y):\n              actions.append(direction)\n              pos[1] += step_y\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T09:28:39.001719", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(pos - target_positions, axis=1))]\n\n  # Calculate path using A* algorithm for better efficiency\n  def heuristic(a, b):\n      return np.abs(a[0] - b[0]) + np.abs(a[1] - b[1])\n\n  def a_star(start, goal, grid_shape):\n      open_set = []\n      heapq.heappush(open_set, (0, start))\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, goal)}\n\n      while open_set:\n          _, current = heapq.heappop(open_set)\n\n          if np.array_equal(current, goal):\n              path = []\n              while current in came_from:\n                  path.append(tuple(current))\n                  current = came_from[current]\n              return path[::-1]\n\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = tuple(np.array(current) + np.array((dx, dy)))\n              if 0 <= neighbor[0] < grid_shape[0] and 0 <= neighbor[1] < grid_shape[1]:\n                  tentative_g_score = g_score[current] + heuristic(current, neighbor)\n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                      heapq.heappush(open_set, (f_score[neighbor], neighbor))\n\n      return None\n\n  path = a_star(tuple(pos), tuple(nearest_target_pos), env._current_state.grid.shape[:2])\n  if path is None:\n      raise ValueError(\"No valid path to workshop found\")\n\n  # Convert path into actions\n  for target_pos in path[1:]:  # Skip the start position\n      dx, dy = np.array(target_pos) - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      pos = np.array(target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-04T09:28:41.169361", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = target_positions[np.argmin(np.linalg.norm(pos - target_positions, axis=1))]\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update the current position based on the move\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n      # Check for obstacles and adjust path if necessary (simple obstacle avoidance)\n      next_pos = np.array([pos[0], pos[1]])\n      if env._current_state.grid[next_pos[0], next_pos[1], env.world.cookbook.index['BOUNDARY']]:\n          actions.append(get_direction(-dx, -dy))  # Reverse direction to avoid boundary\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-04T09:29:48.590545", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  actions = []\n\n  # Check if the closest workshop can craft the desired item\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          closest_workshop_pos = None\n          min_distance = float('inf')\n\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_pos = target_pos\n                  min_distance = distance\n\n          if closest_workshop_pos is not None:\n              # Move to the closest workshop position\n              while not np.array_equal(pos, closest_workshop_pos):\n                  dx, dy = closest_workshop_pos - pos\n                  direction = get_direction(dx, dy)\n                  actions.append(direction)\n                  if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n                      pos[0] += 1 if dx > 0 else -1\n                  else:  # Then move in y-direction\n                      pos[1] += 1 if dy > 0 else -1\n\n              # Use the workshop to craft the item\n              actions.append(4)  # USE\n              return actions\n\n  raise ValueError(\"No available workshop found that can craft the desired item\")", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T09:29:50.778916", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Check if already on a workshop tile before using it\n  if env._current_state.grid[pos[0], pos[1], closest_workshop_idx] == 1:\n      actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"": 0.5}}
