step_y == 1 else 0)  # Move UP/DOWN\n          pos[1] += step_y\n          dy -= step_y\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T21:45:48.631449", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  nearest_target_pos = min(target_positions, key=lambda p: np.linalg.norm(pos - p, ord=2))\n\n  # Move directly to the nearest target position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      \n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)  # RIGHT or LEFT\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)   # DOWN or UP\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:45:50.621449", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n    # Calculate the mean position of all workshops of this type\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n    if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n      workshop_pos_mean = workshop_pos_list.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n\n  # Find the nearest target position\n  nearest_target_pos = min(target_positions, key=lambda x: np.linalg.norm(pos - x))\n\n  # Move directly to the nearest target position\n  while not np.array_equal(pos, nearest_target_pos):\n    dx, dy = nearest_target_pos - pos\n    \n    dir_x = 3 if dx > 0 else (2 if dx < 0 else None)  # RIGHT or LEFT\n    dir_y = 1 if dy > 0 else (0 if dy < 0 else None)   # DOWN or UP\n\n    # Determine direction to move in\n    if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n      actions.append(dir_x)\n      pos[0] += 1 if dx > 0 else -1\n    elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n      actions.append(dir_y)\n      pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:47:57.700776", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  def find_closest_workshop(workshop_indices, pos):\n      closest_workshop_idx = None\n      min_distance = float('inf')\n      for workshop_idx in workshop_indices:\n          workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              workshop_pos_mean = workshop_pos_list.mean(axis=0)\n              distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n      return closest_workshop_idx\n\n  def find_nearest_target_position(target_positions, pos):\n      nearest_target_pos = None\n      min_nearest_distance = float('inf')\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_nearest_distance:\n              nearest_target_pos = target_pos\n              min_nearest_distance = distance\n      return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  closest_workshop_idx = find_closest_workshop(workshop_indices, pos)\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = find_nearest_target_position(target_positions, pos)\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      if direction == 0:  # DOWN\n          pos[1] -= 1\n      elif direction == 1:  # UP\n          pos[1] += 1\n      elif direction == 2:  # LEFT\n          pos[0] -= 1\n      elif direction == 3:  # RIGHT\n          pos[0] += 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:48:00.329784", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          return 3 if dx > 0 else 2  # RIGHT or LEFT\n      else:  # Then move in y-direction\n          return 1 if dy > 0 else 0  # UP or DOWN\n\n  def calculate_direction(pos, target_pos):\n      \"\"\"Calculate the direction to move from current position to target position.\"\"\"\n      dx = target_pos[0] - pos[0]\n      dy = target_pos[1] - pos[1]\n      return get_direction(dx, dy)\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      direction = calculate_direction(pos, nearest_target_pos)\n      actions.append(direction)\n\n      if direction == 0:  # DOWN\n          pos[1] -= 1\n      elif direction == 1:  # UP\n          pos[1] += 1\n      elif direction == 2:  # LEFT\n          pos[0] -= 1\n      elif direction == 3:  # RIGHT\n          pos[0] += 1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 8, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:50:11.408314", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T21:50:13.309882", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using BFS (Breadth-First Search) for pathfinding\n  def bfs(start, end):\n      queue = collections.deque([start])\n      parent_map = {tuple(start): None}\n      \n      while queue:\n          current = queue.popleft()\n          \n          if np.array_equal(current, end):\n              break\n          \n          neighbors = []\n          if current[0] > 0: \n              neighbors.append((current[0] - 1, current[1]))\n          if current[0] < env._current_state.grid.shape[0] - 1:\n              neighbors.append((current[0] + 1, current[1]))\n          if current[1] > 0:\n              neighbors.append((current[0], current[1] - 1))\n          if current[1] < env._current_state.grid.shape[1] - 1:\n              neighbors.append((current[0], current[1] + 1))\n          \n          for neighbor in neighbors:\n              if tuple(neighbor) not in parent_map and env._current_state.next_to(env.world.grabbable_indices, neighbor):\n                  queue.append(np.array(neighbor))\n                  parent_map[tuple(neighbor)] = tuple(current)\n      \n      # Reconstruct path\n      path = []\n      current = end\n      while current is not None:\n          path.append(current)\n          current = parent_map[current]\n      path.reverse()\n      return path\n\n  path_to_workshop = bfs(pos, nearest_target_pos)\n\n  for target_pos in path_to_workshop[1:]:  # Skip the starting position which is already pos\n      dx, dy = target_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"": -1}}
