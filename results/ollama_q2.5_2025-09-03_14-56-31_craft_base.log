ing in x-direction first\n          step_x = 1 if dx > 0 else -1\n          pos[0] += step_x\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          step_y = 1 if dy > 0 else -1\n          pos[1] += step_y\n\n      # If both directions are equal, choose one (e.g., x-direction)\n      else:\n          step_x = 1 if dx >= 0 else -1\n          pos[0] += step_x\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 7, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T12:41:23.813111", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Check if the agent is close enough to use the workshop and avoid unnecessary movement\n      if np.linalg.norm(np.array([dx, dy]), ord=1) == 1:  # Manhattan distance of 1 means adjacent\n          break\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T12:41:25.051559", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          # Check if this workshop can craft the desired item by looking at its recipe\n          recipes = cookbook.recipes.get(goal_index, [])\n          if any(workshop_idx in r['workshops'] for r in recipes):\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-04T12:42:18.662742", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to(target_pos, pos):\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              pos[1] += 1 if dy > 0 else -1\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if no locations for the workshop\n          continue\n\n      nearest_target_pos = min(\n          workshop_pos_list,\n          key=lambda pos: np.linalg.norm(np.array(pos) - env._current_state.pos)\n      )\n\n      move_to(nearest_target_pos, np.array(env._current_state.pos))\n      actions.append(4)  # USE\n\n      # Verify if the item is crafted\n      if env._current_state.next_has_item(goal_index):\n          return actions\n\n  raise ValueError(\"No available workshop found to craft the item\")", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-04T12:42:19.927858", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  def move_to(target_pos, pos):\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          direction = get_direction(dx, dy)\n          actions.append(direction)\n          if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n              pos[0] += 1 if dx > 0 else -1\n          else:  # Then move in y-direction\n              pos[1] += 1 if dy > 0 else -1\n\n  # Find the closest workshop that can craft the desired item\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) == 0:  # Skip if no locations for the workshop\n          continue\n\n      nearest_target_pos = min(workshop_pos_list, key=lambda pos: np.linalg.norm(np.array(pos) - env._current_state.pos))\n\n      move_to(nearest_target_pos, np.array(env._current_state.pos))\n      actions.append(4)  # USE\n      return actions  # Return immediately after finding and using the first available workshop\n\n  if not actions:\n      raise ValueError(\"No available workshop found\")\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
