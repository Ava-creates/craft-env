ng in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 2, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:40:18.333123", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      \n      # Adjust position based on current direction\n      if env._current_state.dir == direction:\n          pos += [1 if dx > 0 else -1, 1 if dy > 0 else -1]\n      elif (env._current_state.dir + 1) % 4 == direction or (env._current_state.dir + 3) % 4 == direction:\n          actions.append(direction)\n          env._current_state.dir = direction\n          pos += [1 if dx > 0 else -1, 1 if dy > 0 else -1]\n      else:\n          # Turn to the correct direction\n          turn_direction = (direction + 2) % 4\n          actions.append(turn_direction)\n          env._current_state.dir = turn_direction\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-04T04:42:06.747747", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n    dx, dy = target_pos - pos\n    steps_x = abs(dx)\n    steps_y = abs(dy)\n\n    actions = []\n    \n    # Determine the direction to move in x-direction first, then y-direction\n    if dx > 0:\n        actions.extend([3] * steps_x)  # Move RIGHT\n    elif dx < 0:\n        actions.extend([2] * steps_x)  # Move LEFT\n\n    if dy > 0:\n        actions.extend([1] * steps_y)  # Move UP\n    elif dy < 0:\n        actions.extend([0] * steps_y)  # Move DOWN\n    \n    return actions\n  \n  def calculate_nearest_target(pos, target_positions):\n    nearest_target_pos = None\n    min_distance = float('inf')\n\n    for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_distance:\n        nearest_target_pos = target_pos\n        min_distance = distance\n\n    return nearest_target_pos\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  target_positions = []\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_positions.extend(workshop_pos_list)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = calculate_nearest_target(pos, target_positions)\n  \n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Check if already at a workshop to prevent unnecessary movement\n  current_state = env._current_state\n\n  if any(current_state.grid[current_state.pos[0], current_state.pos[1], workshop_idx] for workshop_idx in workshop_indices):\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n  \n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T04:42:08.628366", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n\n      # Determine the direction to move in x-direction first, then y-direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n\n      return actions\n\n  def calculate_nearest_target(pos, target_positions):\n      nearest_target_pos = None\n      min_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(pos - target_pos, ord=2)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n\n      return nearest_target_pos\n\n  def is_at_workshop(current_state):\n      workshop_indices = env.world.workshop_indices\n      x, y = current_state.pos\n      for idx in workshop_indices:\n          if current_state.grid[x, y, idx]:\n              return True\n      return False\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  target_positions = []\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_positions.extend(workshop_pos_list)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = calculate_nearest_target(pos, target_positions)\n  \n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Check if already at a workshop to prevent unnecessary movement\n  current_state = env._current_state\n  if not is_at_workshop(current_state):\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:43:29.080763", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move in x-direction first, then y-direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  target_positions = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_positions.extend(workshop_pos_list)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = calculate_nearest_target(pos, target_positions)\n  \n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
{"timestamp": "2025-09-04T04:43:30.958120", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      actions = []\n      dx, dy = target_pos - pos\n      \n      # Determine the direction to move in x-direction first, then y-direction\n      while dx != 0 or dy != 0:\n          if dx > 0:\n              actions.append(3)  # Move RIGHT\n              dx -= 1\n          elif dx < 0:\n              actions.append(2)  # Move LEFT\n              dx += 1\n\n          if dy > 0:\n              actions.append(1)  # Move UP\n              dy -= 1\n          elif dy < 0:\n              actions.append(0)  # Move DOWN\n              dy += 1\n      \n      return actions\n  \n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  target_positions = []\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          target_positions.extend(workshop_pos_list)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  pos = np.array(env._current_state.pos)\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  actions = move_towards_target(pos, nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 3, "scores": {"": 0.0}}
