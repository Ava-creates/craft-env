 + dy < grid.shape[1]\n          ]\n\n          for neighbor in neighbors:\n              if neighbor not in visited:\n                  queue.append(neighbor)\n                  parent[neighbor] = current\n      return None\n\n  path = bfs_shortest_path(env._current_state.grid, start_pos, target_positions)\n\n  if path is None:\n      raise ValueError(\"No valid path to the workshop\")\n\n  # Convert path into actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      \n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T17:26:24.267091", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          distances = np.linalg.norm(pos - workshop_pos_list, axis=1)\n          min_workshop_distance = np.min(distances)\n          min_workshop_index = np.argmin(distances)\n\n          if min_workshop_distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = workshop_pos_list[min_workshop_index]\n              min_distance = min_workshop_distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T17:26:26.282806", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* algorithm for optimal path\n  def heuristic(a, b):\n      return abs(b[0] - a[0]) + abs(b[1] - a[1])\n\n  open_set = collections.PriorityQueue()\n  open_set.put((0, tuple(pos)))\n  came_from = {}\n  g_score = {tuple(pos): 0}\n  f_score = {tuple(pos): heuristic(pos, nearest_target_pos)}\n\n  while not open_set.empty():\n      _, current = open_set.get()\n      current = np.array(current)\n\n      if np.array_equal(current, nearest_target_pos):\n          break\n\n      for direction in [(1, 0), (-1, 0), (0, 1), (0, -1)]:  # RIGHT, LEFT, DOWN, UP\n          neighbor = current + np.array(direction)\n          tentative_g_score = g_score[tuple(current)] + heuristic(current, neighbor)\n\n          if tuple(neighbor) not in g_score or tentative_g_score < g_score[tuple(neighbor)]:\n              came_from[tuple(neighbor)] = tuple(current)\n              g_score[tuple(neighbor)] = tentative_g_score\n              f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, nearest_target_pos)\n              open_set.put((f_score[tuple(neighbor)], tuple(neighbor)))\n\n  current = tuple(nearest_target_pos)\n  path = []\n  while current in came_from:\n      path.append(current)\n      current = came_from[current]\n  path.reverse()\n  \n  # Convert the optimal path to actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1] - path[i]\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      if abs(dx) >= abs(dy) and dir_x is not None:\n          actions.append(dir_x)\n      elif abs(dy) > abs(dx) and dir_y is not None:\n          actions.append(dir_y)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": -1}}
