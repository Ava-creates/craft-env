{"timestamp": "2025-09-04T01:32:07.014191", "function_name": "craft", "function_body": "  def move_towards(current_pos, target_pos):\n      actions = []\n      delta_x, delta_y = target_pos - current_pos\n      \n      while not np.array_equal(current_pos, target_pos):\n          if abs(delta_x) > abs(delta_y):  # Move horizontally first\n              direction = 3 if delta_x > 0 else 2  # RIGHT or LEFT\n              actions.append(direction)\n              current_pos[0] += 1 if delta_x > 0 else -1\n              delta_x -= 1 if delta_x > 0 else 1\n          elif abs(delta_y) > 0:  # Then move vertically\n              direction = 1 if delta_y > 0 else 0  # DOWN or UP\n              actions.append(direction)\n              current_pos[1] += 1 if delta_y > 0 else -1\n              delta_y -= 1 if delta_y > 0 else 1\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  current_pos = np.array(env._current_state.pos)\n  closest_workshop_idx, nearest_target_pos = None, None\n  min_distance = float('inf')\n\n  # Find the closest workshop that can craft the desired item\n  for workshop_idx in workshop_indices:\n      positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(positions) > 0:\n          distances = np.linalg.norm(positions - current_pos, axis=1)\n          nearest_index = np.argmin(distances)\n          \n          if distances[nearest_index] < min_distance:\n              closest_workshop_idx = workshop_idx\n              nearest_target_pos = positions[nearest_index]\n              min_distance = distances[nearest_index]\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions = move_towards(current_pos, nearest_target_pos)\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-04T01:32:09.097918", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n      actions = []\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def closest_workshop(pos, workshop_indices):\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_idx in workshop_indices:\n          positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n          if len(positions) > 0:\n              nearest_pos = min(positions, key=lambda x: np.linalg.norm(pos - x, ord=2))\n              distance = np.linalg.norm(nearest_pos - pos, ord=2)\n              \n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, nearest_pos\n      \n      return closest_workshop_idx\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  pos = np.array(env._current_state.pos)\n  \n  # Find the closest workshop that can craft the desired item\n  workshop_idx, nearest_target_pos = closest_workshop(pos, workshop_indices)\n\n  if workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  actions.extend(move_towards(pos, nearest_target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-04T01:34:31.274452", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Calculate the closest workshop position to the current position\n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n      distance_to_closest_workshop = np.linalg.norm(pos - closest_workshop_pos)\n      if distance_to_closest_workshop < min_distance:\n          nearest_workshop_pos = closest_workshop_pos\n          min_distance = distance_to_closest_workshop\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using a more efficient pathfinding algorithm (A* or BFS)\n  def bfs(start, goal):\n    queue = collections.deque([start])\n    visited = set()\n    parent = {tuple(start): None}\n\n    while queue:\n        current = queue.popleft()\n\n        if np.array_equal(current, goal):\n            break\n\n        for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n            neighbor = current + np.array(direction)\n\n            # Check bounds and obstacles\n            if 0 <= neighbor[0] < env._current_state.grid.shape[0] and\\\n               0 <= neighbor[1] < env._current_state.grid.shape[1]:\n                if tuple(neighbor) not in visited:\n                    is_blocked = False\n                    for workshop_idx in workshop_indices:  # Ensure we're not stepping into a workshop or boundary\n                        if env._current_state.grid[neighbor[0], neighbor[1], workshop_idx] > 0:\n                            is_blocked = True\n                            break\n                    if not is_blocked:\n                        queue.append(neighbor)\n                        visited.add(tuple(neighbor))\n                        parent[tuple(neighbor)] = current\n\n    # Reconstruct path from start to goal\n    if np.array_equal(current, goal):\n        path = []\n        while not np.array_equal(current, start):\n            path.append(direction_from_positions(parent[tuple(current)], current))\n            current = parent[tuple(current)]\n        return path[::-1]\n    else:\n        return []\n\n  def direction_from_positions(pos1, pos2):\n      dx, dy = pos2 - pos1\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  path = bfs(pos, nearest_workshop_pos)\n  actions.extend(path)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T01:34:33.511932", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  nearest_workshop_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_positions) == 0:\n          continue\n\n      # Calculate the closest workshop position to the current position\n      distances = np.linalg.norm(pos - workshop_positions, axis=1)\n      closest_workshop_pos = workshop_positions[np.argmin(distances)]\n\n      distance_to_closest_workshop = np.linalg.norm(pos - closest_workshop_pos)\n      if distance_to_closest_workshop < min_distance:\n          nearest_workshop_pos = closest_workshop_pos\n          min_distance = distance_to_closest_workshop\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position using A* pathfinding algorithm\n  def heuristic(a, b):\n    return np.linalg.norm(np.array(a) - np.array(b), ord=1)  # Manhattan distance\n\n  def a_star(start, goal):\n    open_set = set()\n    closed_set = set()\n    g_score = {tuple(start): 0}\n    f_score = {tuple(start): heuristic(start, goal)}\n    came_from = {}\n\n    open_set.add(tuple(start))\n\n    while open_set:\n        current = min(open_set, key=lambda x: f_score[x])\n\n        if np.array_equal(np.array(current), goal):\n            path = []\n            while current in came_from:\n                path.append(direction_from_positions(came_from[current], np.array(current)))\n                current = came_from[current]\n            return path[::-1]\n\n        open_set.remove(tuple(current))\n        closed_set.add(tuple(current))\n\n        for direction in [(0, 1), (1, 0), (0, -1), (-1, 0)]:\n            neighbor = np.array(current) + np.array(direction)\n\n            # Check bounds and obstacles\n            if 0 <= neighbor[0] < env._current_state.grid.shape[0] and\\\n               0 <= neighbor[1] < env._current_state.grid.shape[1]:\n                tentative_g_score = g_score[tuple(current)] + 1\n\n                if tuple(neighbor) in closed_set:\n                    continue\n                elif tuple(neighbor) not in open_set:\n                    open_set.add(tuple(neighbor))\n                elif tentative_g_score >= g_score[tuple(neighbor)]:\n                    continue\n\n                came_from[tuple(neighbor)] = np.array(current)\n                g_score[tuple(neighbor)] = tentative_g_score\n                f_score[tuple(neighbor)] = tentative_g_score + heuristic(neighbor, goal)\n\n    return []\n\n  def direction_from_positions(pos1, pos2):\n      dx, dy = pos2 - pos1\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  path = a_star(pos, nearest_workshop_pos)\n  actions.extend(path)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": -1}}
