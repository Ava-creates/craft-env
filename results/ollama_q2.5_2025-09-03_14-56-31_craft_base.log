{"timestamp": "2025-09-04T01:05:58.923893", "function_name": "craft", "function_body": "  def move_towards_target(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      # Determine the direction to move in x-direction first, then y-direction\n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n  \n  def calculate_nearest_target(current_pos, target_positions):\n      nearest_target_pos = None\n      min_distance = float('inf')\n\n      for target_pos in target_positions:\n          distance = np.linalg.norm(target_pos - current_pos)\n          if distance < min_distance:\n              nearest_target_pos = target_pos\n              min_distance = distance\n\n      return nearest_target_pos\n  \n  def get_valid_workshop_positions(workshop_indices, grid):\n      valid_workshop_positions = []\n      \n      for workshop_idx in workshop_indices:\n          # Calculate all positions of this type of workshop\n          workshop_pos_list = np.argwhere(grid[:, :, workshop_idx])\n\n          if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n              valid_workshop_positions.extend(workshop_pos_list)\n      \n      return valid_workshop_positions\n\n  def can_craft_at_workshop(workshop_position, grid):\n      # Check if the agent is next to a workshop position and can interact with it.\n      # Assuming the agent can only interact when they are at the exact same position as the workshop\n      return True\n  \n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Get current state and grid information\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n  grid = current_state.grid\n\n  # Find the closest workshop that can craft the desired item\n  target_positions = get_valid_workshop_positions(workshop_indices, grid)\n\n  if not target_positions:\n      raise ValueError(\"No available workshop found\")\n\n  nearest_target_pos = calculate_nearest_target(pos, target_positions)\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
