) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:27:53.822635", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the relative position from current to target\n  dx, dy = nearest_target_pos - pos\n\n  # Determine the direction to move in x-direction first, then y-direction\n  while not np.array_equal(pos, nearest_target_pos):\n      if dx > 0:\n          actions.append(3)  # Move RIGHT\n          pos[0] += 1\n      elif dx < 0:\n          actions.append(2)  # Move LEFT\n          pos[0] -= 1\n\n      if dy > 0:\n          actions.append(1)  # Move UP\n          pos[1] += 1\n      elif dy < 0:\n          actions.append(0)  # Move DOWN\n          pos[1] -= 1\n\n      dx, dy = nearest_target_pos - pos\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:27:55.056474", "function_name": "craft", "function_body": "  def move_towards_target(pos, target_pos):\n      dx, dy = target_pos - pos\n      steps_x = abs(dx)\n      steps_y = abs(dy)\n\n      actions = []\n      \n      if dx > 0:\n          actions.extend([3] * steps_x)  # Move RIGHT\n      elif dx < 0:\n          actions.extend([2] * steps_x)  # Move LEFT\n\n      if dy > 0:\n          actions.extend([1] * steps_y)  # Move UP\n      elif dy < 0:\n          actions.extend([0] * steps_y)  # Move DOWN\n      \n      return actions\n  \n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move towards the closest workshop position\n  actions.extend(move_towards_target(pos, nearest_target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:30:18.677626", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position using A* algorithm\n  def heuristic(a, b):\n      return np.linalg.norm(np.array(a) - np.array(b), ord=1)\n\n  def a_star(start, goal, grid):\n      neighbors = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n      close_set = set()\n      came_from = {}\n      gscore = {start: 0}\n      fscore = {start: heuristic(start, goal)}\n\n      oheap = []\n      heapq.heappush(oheap, (fscore[start], start))\n\n      while oheap:\n          current = heapq.heappop(oheap)[1]\n\n          if current == goal:\n              data = []\n              while current in came_from:\n                  data.append(current)\n                  current = came_from[current]\n              return data[::-1] + [goal]\n\n          close_set.add(current)\n          for i, j in neighbors:\n              neighbor = (current[0] + i, current[1] + j)\n              tentative_g_score = gscore[current] + heuristic(current, neighbor)\n\n              if 0 <= neighbor[0] < grid.shape[0]:\n                  if 0 <= neighbor[1] < grid.shape[1]:\n                      if grid[neighbor[0], neighbor[1]] == 0:\n                          continue\n                  else:\n                      # array bound y walls\n                      continue\n              else:\n                  # array bound x walls\n                  continue\n\n              if neighbor in close_set and tentative_g_score >= gscore.get(neighbor, 0):\n                  continue\n\n              if tentative_g_score < gscore.get(neighbor, 0) or neighbor not in [i[1]for i in oheap]:\n                  came_from[neighbor] = current\n                  gscore[neighbor] = tentative_g_score\n                  fscore[neighbor] = tentative_g_score + heuristic(neighbor, goal)\n                  heapq.heappush(oheap, (fscore[neighbor], neighbor))\n      return False\n\n  path = a_star(tuple(pos), tuple(nearest_target_pos), env._current_state.grid[:, :, closest_workshop_idx])\n\n  if not path:\n      raise ValueError(\"No valid path found to the workshop\")\n\n  for p in path[:-1]:\n      dx, dy = np.array(p) - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": -1}}
{"timestamp": "2025-09-03T16:30:19.906640", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for workshop_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - workshop_pos, ord=2)\n              if distance < min_distance:\n                  closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 4, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:32:28.894569", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the shortest path to the nearest workshop position using BFS\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  start_pos = tuple(pos)\n  \n  def bfs_shortest_path(grid, start, targets):\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if tuple(current) in [tuple(target) for target in targets]:\n              path = []\n              while current is not None:\n                  path.append(tuple(current))\n                  current = parent[current]\n              return path[::-1]\n\n          visited.add(tuple(current))\n\n          # Get valid neighboring positions (assuming 4-directional movement)\n          neighbors = [\n              (current[0] + dx, current[1] + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]\n              if 0 <= current[0] + dx < grid.shape[0] and 0 <= current[1] + dy < grid.shape[1]\n          ]\n\n          for neighbor in neighbors:\n              if neighbor not in visited:\n                  queue.append(neighbor)\n                  parent[neighbor] = current\n      return None\n\n  path = bfs_shortest_path(env._current_state.grid, start_pos, target_positions)\n\n  if path is None:\n      raise ValueError(\"No valid path to the workshop\")\n\n  # Convert path into actions\n  for i in range(len(path) - 1):\n      dx, dy = path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1]\n      \n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 0, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:32:30.125753", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n\n      # Determine direction to move in\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n          actions.append(3 if dx > 0 else 2)\n          pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Then move in y-direction if needed\n          actions.append(1 if dy > 0 else 0)\n          pos[1] += 1 if dy > 0 else -1\n\n  # Align the agent to face the workshop before using it\n  target_direction = np.arctan2(nearest_target_pos[1] - pos[1], nearest_target_pos[0] - pos[0])\n  current_direction = env._current_state.dir * (np.pi / 2)\n\n  # Calculate the difference in direction and determine the turn actions needed\n  angle_diff = target_direction - current_direction\n\n  if abs(angle_diff) > np.pi:\n      angle_diff -= 2 * np.pi * np.sign(angle_diff)\n\n  if angle_diff > 0:\n      actions.append(1)  # Turn right (UP)\n  elif angle_diff < 0:\n      actions.append(0)  # Turn left (DOWN)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"": 0.0}}
{"timestamp": "2025-09-03T16:34:04.387953", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Calculate the relative position from current to target\n  dx, dy = nearest_target_pos - pos\n\n  # Determine the direction to move in x-direction first, then y-direction\n  if dx > 0:\n      actions.extend([3] * abs(dx))  # Move RIGHT\n  elif dx < 0:\n      actions.extend([2] * abs(dx))  # Move LEFT\n\n  if dy > 0:\n      actions.extend([1] * abs(dy))  # Move UP\n  elif dy < 0:\n      actions.extend([0] * abs(dy))  # Move DOWN\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": 0.5}}
{"timestamp": "2025-09-03T16:39:04.500166", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_pos = None\n  min_distance = float('inf')\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              target_pos = workshop_pos_mean\n              min_distance = distance\n\n  if target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the relative position from current to target\n  dx, dy = target_pos - pos\n\n  # Determine the direction to move in x-direction first, then y-direction\n  while dx != 0 or dy != 0:\n      if dx > 0:\n          actions.append(3)  # Move RIGHT\n          dx -= 1\n      elif dx < 0:\n          actions.append(2)  # Move LEFT\n          dx += 1\n\n      if dy > 0:\n          actions.append(1)  # Move UP\n      elif dy < 0:\n          actions.append(0)  # Move DOWN\n      dy = np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 3, "scores": {"": -1}}
