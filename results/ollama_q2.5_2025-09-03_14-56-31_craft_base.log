{"timestamp": "2025-09-04T04:46:31.767938", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  nearest_workshop_pos = target_pos\n                  min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Prioritize moving in x-direction first\n      if abs(dx) >= abs(dy):\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n      # Update the current position based on the action taken\n      env._current_state.pos = tuple(pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T04:46:33.872514", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for workshop_idx in workshop_indices:\n      # Get all positions of this type of workshop\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          for target_pos in workshop_pos_list:\n              distance = np.linalg.norm(pos - target_pos, ord=2)\n              if distance < min_distance:\n                  nearest_workshop_pos = target_pos\n                  min_distance = distance\n\n  if nearest_workshop_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_workshop_pos):\n      dx, dy = nearest_workshop_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      else:  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:48:32.021236", "function_name": "craft", "function_body": "  def path_to(pos, target_pos):\n      \"\"\"Helper function to find a path from pos to target_pos.\"\"\"\n      directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # UP, RIGHT, DOWN, LEFT\n      queue = collections.deque([(pos, [])])\n      visited = set([tuple(pos)])\n      \n      while queue:\n          current_pos, path = queue.popleft()\n          \n          if np.array_equal(current_pos, target_pos):\n              return path\n      \n          for direction in directions:\n              next_pos = current_pos + np.array(direction)\n              \n              # Check bounds and obstacles\n              if (0 <= next_pos[0] < env._current_state.grid.shape[0] and\n                  0 <= next_pos[1] < env._current_state.grid.shape[1]):\n                  if tuple(next_pos) not in visited:\n                      queue.append((next_pos, path + [direction]))\n                      visited.add(tuple(next_pos))\n      \n      return []\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Get path to the closest workshop position\n  path = path_to(np.array(env._current_state.pos), nearest_target_pos)\n\n  # Convert directions to actions\n  direction_to_action = {(-1, 0): 2, (1, 0): 3, (0, -1): 0, (0, 1): 1}\n  for direction in path:\n      action = direction_to_action[tuple(direction)]\n      actions.append(action)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:48:34.173970", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  \n  # Find the closest workshop that can craft the desired item\n  def find_closest_workshop():\n    min_distance = float('inf')\n    closest_workshop_idx = None\n    current_pos = np.array(env._current_state.pos)\n\n    for workshop_idx in workshop_indices:\n        workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n        if len(workshop_positions) == 0: continue\n\n        # Calculate the mean position of all workshops of this type\n        workshop_mean_position = workshop_positions.mean(axis=0)\n        distance_to_workshop = np.linalg.norm(current_pos - workshop_mean_position, ord=2)\n\n        if distance_to_workshop < min_distance:\n            closest_workshop_idx = workshop_idx\n            min_distance = distance_to_workshop\n    \n    return closest_workshop_idx\n\n  closest_workshop_idx = find_closest_workshop()\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  def find_nearest_target_position(target_positions, current_pos):\n    min_distance = float('inf')\n    nearest_target_pos = None\n\n    for pos in target_positions:\n        distance = np.linalg.norm(current_pos - pos, ord=2)\n        if distance < min_distance:\n            nearest_target_pos = pos\n            min_distance = distance\n    \n    return nearest_target_pos\n  \n  nearest_target_pos = find_nearest_target_position(target_positions, env._current_state.pos)\n\n  # Move to the closest workshop position\n  current_pos = np.array(env._current_state.pos)\n  \n  while not np.array_equal(current_pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - current_pos\n      dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n      dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n      # Determine direction to move in\n      if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n          actions.append(dir_x)\n          current_pos[0] += 1 if dx > 0 else -1\n      elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n          actions.append(dir_y)\n          current_pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 5, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:50:17.001140", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  closest_workshop_idx = None\n  nearest_target_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n              nearest_target_pos = None\n              min_nearest_distance = float('inf')\n              for target_pos in workshop_pos_list:\n                  pos_dist = np.linalg.norm(pos - target_pos, ord=2)\n                  if pos_dist < min_nearest_distance:\n                      nearest_target_pos = target_pos\n                      min_nearest_distance = pos_dist\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos[:2], nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update position with a single step in the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          pos[1] += np.sign(dy)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 6, "scores": {"": 0.5}}
{"timestamp": "2025-09-04T04:50:18.869390", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n    if dx > 0:\n        return 3  # RIGHT\n    elif dx < 0:\n        return 2  # LEFT\n    elif dy > 0:\n        return 1  # UP\n    else:\n        return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  closest_workshop_idx = None\n  nearest_target_pos = None\n\n  for workshop_idx in workshop_indices:\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n\n          if distance < min_distance:\n              closest_workshop_idx = workshop_idx\n              min_distance = distance\n\n              nearest_target_pos = None\n              min_nearest_distance = float('inf')\n              for target_pos in workshop_pos_list:\n                  pos_dist = np.linalg.norm(pos - target_pos, ord=2)\n                  if pos_dist < min_nearest_distance:\n                      nearest_target_pos = target_pos\n                      min_nearest_distance = pos_dist\n\n  if closest_workshop_idx is None or nearest_target_pos is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos[:2], nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update position with a single step in the chosen direction\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += np.sign(dx)\n      else:  # Then move in y-direction\n          pos[1] += np.sign(dy)\n\n      # Check for obstacles and update position accordingly\n      if env._current_state.grid[pos[1], pos[0], cookbook.index['BOUNDARY']]:\n          actions.pop()  # Remove the last action that led to an obstacle\n          new_direction = (direction + 2) % 4  # Turn around\n          actions.append(new_direction)\n          dx, dy = nearest_target_pos - pos\n          direction = get_direction(dx, dy)\n\n      env._current_state.pos = (pos[0], pos[1])  # Update the state position\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 6, "scores": {"": -1}}
{"timestamp": "2025-09-04T04:52:15.205806", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      if abs(dx) >= abs(dy):  # Prioritize moving in x-direction first\n          pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move in y-direction\n          pos[1] += 1 if dy > 0 else -1\n\n      # Check for proximity to the target position and adjust accordingly\n      if np.linalg.norm(pos - nearest_target_pos, ord=2) == 1:\n          break\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"": 0.0}}
{"timestamp": "2025-09-04T04:52:17.087694", "function_name": "craft", "function_body": "  def get_direction(dx, dy):\n      if dx > 0:\n          return 3  # RIGHT\n      elif dx < 0:\n          return 2  # LEFT\n      elif dy > 0:\n          return 1  # UP\n      else:\n          return 0  # DOWN\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n      dx, dy = nearest_target_pos - pos\n      direction = get_direction(dx, dy)\n      actions.append(direction)\n\n      # Update position based on current facing direction and action taken\n      new_x, new_y = pos[0], pos[1]\n      if env._current_state.env.world.index[\"UP\"] == direction:\n          new_y -= 1\n      elif env._current_state.env.world.index[\"DOWN\"] == direction:\n          new_y += 1\n      elif env._current_state.env.world.index[\"LEFT\"] == direction:\n          new_x -= 1\n      elif env._current_state.env.world.index[\"RIGHT\"] == direction:\n          new_x += 1\n\n      pos[0], pos[1] = new_x, new_y\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n  return actions", "island_id": 2, "scores": {"": -1}}
{"timestamp": "2025-09-04T04:55:00.839696", "function_name": "craft", "function_body": "  def move_to_position(target_pos, current_state):\n      actions = []\n      pos = np.array(current_state.pos)\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n          dir_x = 3 if dx > 0 else (2 if dx < 0 else None)\n          dir_y = 1 if dy > 0 else (0 if dy < 0 else None)\n\n          # Determine direction to move in\n          if abs(dx) >= abs(dy) and dir_x is not None:  # Prioritize moving in x-direction first\n              actions.append(dir_x)\n              pos[0] += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx) and dir_y is not None:  # Then move in y-direction\n              actions.append(dir_y)\n              pos[1] += 1 if dy > 0 else -1\n\n      return actions\n\n  def use_workshop(current_state, workshop_idx):\n      pos = np.array(current_state.pos)\n      adjacent_cells = [(pos[0] + dx, pos[1] + dy) for dx in (-1, 0, 1) for dy in (-1, 0, 1)\n                        if np.linalg.norm(np.array([dx, dy]), ord=2) == 1]\n      \n      actions = []\n      for cell in adjacent_cells:\n          # Check if the agent is already on top of a workshop\n          if current_state.grid[cell[1], cell[0], workshop_idx] == 1:\n              actions.append(4)  # USE\n              return actions\n      \n      # Move to an adjacent cell and then use the workshop\n      for cell in adjacent_cells:\n          actions.extend(move_to_position(cell, current_state))\n          actions.append(4)  # USE\n          pos = np.array(cell)\n      \n      return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n      # Calculate the mean position of all workshops of this type\n      workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n          workshop_pos_mean = workshop_pos_list.mean(axis=0)\n          distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_position(nearest_target_pos, env._current_state))\n\n  # Use the workshop to craft the item\n  actions.extend(use_workshop(env._current_state, closest_workshop_idx))\n  \n  return actions", "island_id": 1, "scores": {"": 0.20000000298023224}}
