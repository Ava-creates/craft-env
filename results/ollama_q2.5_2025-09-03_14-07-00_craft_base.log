{"timestamp": "2025-09-03T14:08:38.056394", "function_name": "craft", "function_body": "  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting this item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if \"_key\" not in recipe:\n    raise ValueError(f\"No known recipe for {item} or it does not require a specific workshop.\")\n\n  workshop_key = recipe[\"_key\"]\n  workshop_indices = [\n      index \n      for index, name in enumerate(env.world.cookbook.index) \n      if name.startswith(workshop_key)\n  ]\n\n  # If no workshops are found, raise an error\n  if not workshop_indices:\n    raise ValueError(f\"No known workshop for crafting {item}.\")\n\n  actions = []\n\n  # Find the closest workshop from current position\n  closest_workshop_index = None\n  closest_distance = float('inf')\n  \n  for index in workshop_indices:\n      pos = np.argwhere(env._current_state.grid[:, :, index]).mean(axis=0)\n      \n      if len(pos) == 2:  # Ensure we have a valid position\n          distance = np.linalg.norm(\n              env._current_state.pos - pos, ord=1\n          )\n          \n          if distance < closest_distance:\n              closest_workshop_index = index\n              closest_distance = distance\n\n  # If no workshop is found within the grid, raise an error\n  if closest_workshop_index is None:\n    raise ValueError(\"No workshop found in the current grid.\")\n\n  # Move to the position of the closest workshop\n  pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_index]).mean(axis=0)\n  \n  target_x, target_y = int(pos[1]), int(pos[0])\n  current_x, current_y = env._current_state.pos\n\n  # Calculate moves needed to reach the target position\n  while current_x != target_x or current_y != target_y:\n      if current_x < target_x:\n          actions.append(env.action_specs()[\"RIGHT\"])\n          current_x += 1\n      elif current_x > target_x:\n          actions.append(env.action_specs()[\"LEFT\"])\n          current_x -= 1\n      \n      if current_y < target_y:\n          actions.append(env.action_specs()[\"DOWN\"])\n          current_y += 1\n      elif current_y > target_y:\n          actions.append(env.action_specs()[\"UP\"])\n          current_y -= 1\n\n  # Perform the USE action to craft the item at the workshop\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 5, "scores": {"": -1}}
