{"timestamp": "2025-07-23T15:14:57.988473", "function_name": "craft", "function_body": "    total_reward = 0.0\n    cookbook = env.world.cookbook\n\n    # Get action constants from env.action_specs()\n    # These are specific integer codes for actions like moving and using.\n    actions = env.action_specs()\n    ACTION_DOWN = actions['DOWN']\n    ACTION_UP = actions['UP']\n    ACTION_LEFT = actions['LEFT']\n    ACTION_RIGHT = actions['RIGHT']\n    ACTION_USE = actions['USE']\n\n    # Convert the item name (string, e.g., \"PLANK\") to its integer ID\n    item_id = cookbook.index.index(item)\n\n    # Step 1: Determine all primitive ingredients required for the final item.\n    # The cookbook's `primitives_for` method recursively finds all base ingredients.\n    all_needed_primitives = cookbook.primitives_for(item_id)\n\n    # Step 2: Collect all necessary primitive ingredients.\n    for p_id, p_count in all_needed_primitives.items():\n        # Keep collecting this primitive until the required count is met.\n        while env._current_state.inventory[p_id] < p_count:\n            # Check if the environment has run out of steps. If so, return early.\n            if env.steps >= env.max_steps:\n                return total_reward\n\n            # Find the primitive item's location on the grid.\n            target_pos = None\n            # Iterate through the grid dimensions (WIDTH x HEIGHT) to find the item.\n            # `env._current_state.grid` holds the current state of the world grid.\n            for x_grid in range(env._current_state.grid.shape[0]):\n                for y_grid in range(env._current_state.grid.shape[1]):\n                    if env._current_state.grid[x_grid, y_grid, p_id] == 1:\n                        target_pos = (x_grid, y_grid)\n                        break\n                if target_pos is not None:\n                    break\n            \n            # If a needed primitive is not found on the grid, we cannot complete the task.\n            # This indicates an issue with the scenario setup. Return current reward.\n            if target_pos is None:\n                return total_reward\n\n            # Move the agent towards the target primitive until it is adjacent.\n            # `env._current_state.next_to(p_id)` checks if the agent is next to the item.\n            while not env._current_state.next_to(p_id):\n                # Check for max steps before each movement action to prevent infinite loops.\n                if env.steps >= env.max_steps:\n                    return total_reward\n\n                current_x, current_y = env._current_state.pos\n                \n                # Determine the best movement action (left/right or up/down) to get closer.\n                action_to_take = None\n                if current_x < target_pos[0]:\n                    action_to_take = ACTION_RIGHT\n                elif current_x > target_pos[0]:\n                    action_to_take = ACTION_LEFT\n                elif current_y < target_pos[1]:\n                    action_to_take = ACTION_UP\n                elif current_y > target_pos[1]:\n                    action_to_take = ACTION_DOWN\n                \n                # If no movement action is determined (e.g., already at target X/Y, or stuck),\n                # break the movement loop and proceed to attempt 'USE'.\n                if action_to_take is None:\n                    break \n\n                # Perform the determined movement action.\n                # `env.step` returns reward, done status, and new observations.\n                reward, done, _ = env.step(action_to_take)\n                total_reward += reward\n                # If the environment signals 'done' (e.g., max_steps reached, task completed by other means),\n                # exit and return current reward.\n                if done: \n                    return total_reward\n\n            # Once adjacent to the primitive (or if movement loop exited), use the 'USE' action.\n            # This action will attempt to pick up the item.\n            reward, done, _ = env.step(ACTION_USE)\n            total_reward += reward\n            if done:\n                return total_reward\n\n    # Step 3: Move to the appropriate workshop, if required by the recipe for the final item.\n    recipe = cookbook.recipes[item_id]\n    workshop_id = None\n    if \"_at\" in recipe: # Check if the recipe specifies a crafting location.\n        workshop_name = recipe[\"_at\"] # E.g., \"workshop1\"\n        workshop_id = cookbook.index.index(workshop_name)\n\n        if workshop_id is not None: # If a specific workshop is identified.\n            target_pos = None\n            # Find the workshop's location on the grid.\n            for x_grid in range(env._current_state.grid.shape[0]):\n                for y_grid in range(env._current_state.grid.shape[1]):\n                    if env._current_state.grid[x_grid, y_grid, workshop_id] == 1:\n                        target_pos = (x_grid, y_grid)\n                        break\n                if target_pos is not None:\n                    break\n            \n            # If the required workshop is not found, cannot craft. Return current reward.\n            if target_pos is None:\n                return total_reward\n\n            # Move the agent towards the workshop until it is adjacent.\n            while not env._current_state.next_to(workshop_id):\n                if env.steps >= env.max_steps:\n                    return total_reward\n\n                current_x, current_y = env._current_state.pos\n                \n                action_to_take = None\n                if current_x < target_pos[0]:\n                    action_to_take = ACTION_RIGHT\n                elif current_x > target_pos[0]:\n                    action_to_take = ACTION_LEFT\n                elif current_y < target_pos[1]:\n                    action_to_take = ACTION_UP\n                elif current_y > target_pos[1]:\n                    action_to_take = ACTION_DOWN\n                \n                if action_to_take is None:\n                    break \n\n                reward, done, _ = env.step(action_to_take)\n                total_reward += reward\n                if done:\n                    return total_reward\n\n    # Step 4: Perform the final 'USE' action to craft the item.\n    # This action will be successful if all ingredients are collected and the agent is\n    # at the correct crafting location (either a workshop or open space for default crafting).\n    reward, done, _ = env.step(ACTION_USE)\n    total_reward += reward\n    if done:\n        return total_reward\n\n    return total_reward", "island_id": 4, "scores": {"3": -1}}
