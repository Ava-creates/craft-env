owards(current_dir, target_dir):\n      turns = []\n      while current_dir != target_dir:\n          if (target_dir - current_dir) % 4 <= 2:\n              turns.append((current_dir + 1) % 4)\n              current_dir = (current_dir + 1) % 4\n          else:\n              turns.append((current_dir + 3) % 4)\n              current_dir = (current_dir + 3) % 4\n      return turns\n\n  def move_to_position(target_pos):\n      dx = target_pos[0] - state.pos[0]\n      dy = target_pos[1] - state.pos[1]\n\n      action_list = []\n      \n      # Turn to face the target direction\n      current_dir = state.dir\n      target_dir = None\n      \n      if dx > 0:  # Move right\n          target_dir = 2\n      elif dx < 0:  # Move left\n          target_dir = 3\n      elif dy > 0:  # Move up\n          target_dir = 0\n      elif dy < 0:  # Move down\n          target_dir = 1\n      \n      if current_dir != target_dir:\n          action_list.extend(turn_towards(current_dir, target_dir))\n      \n      # Append the movement actions based on the target direction\n      for _ in range(abs(dx)):\n          action_list.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          action_list.append(1 if dy > 0 else 0)\n\n      return action_list\n\n  def collect_primitive(target_pos):\n    actions = []\n    \n    # Move to the target position\n    actions.extend(move_to_position(target_pos))\n    \n    # Collect the primitive by using the tool if necessary\n    actions.append(4)  # USE\n    \n    return actions\n\n  state = env._current_state\n  primitive_index = state.world.cookbook.index.index(primitive)\n\n  # Get the path to the primitive\n  path_to_primitive, target_pos = bfs_for_primitive(primitive_index)\n  \n  action_list = []\n  reward = 0\n  \n  if path_to_primitive and target_pos:\n    action_list.extend(collect_primitive(target_pos))\n\n  for action in action_list:\n      r, state, _ = env.step(action)\n      reward += r\n\n  return state, reward, action_list", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-14T12:53:11.887549", "function_name": "collect", "function_body": "  # Index the primitive\n  index_primitive = env.world.cookbook.index.primitive(primitive)\n\n  # Find the positions of all primitives in the grid that match the given primitive index\n  target_positions = np.argwhere(state.grid[:, :, index_primitive] == 1)\n  \n  # Placeholder for the shortest path algorithm\n  def find_shortest_path(grid, start_pos, end_pos):\n      \"\"\"Find the shortest path from start_pos to end_pos on a grid.\"\"\"\n      queue = collections.deque([(start_pos, [])])\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.popleft()\n          \n          if (x, y) == end_pos:\n              return path\n          \n          if (x, y) in visited:\n              continue\n          \n          visited.add((x, y))\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              \n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  queue.append(((nx, ny), path + [(dx, dy)]))\n      \n      return None\n\n  # Initialize the shortest path\n  shortest_path = None\n  \n  # Find the shortest path to each target position\n  for pos in target_positions:\n      current_path = find_shortest_path(state.grid, state.pos, tuple(pos))\n      if current_path is not None and (shortest_path is None or len(current_path) < len(shortest_path)):\n          shortest_path = current_path\n  \n  # If a path was found, convert the directions to actions\n  if shortest_path:\n      for direction in shortest_path:\n          dx, dy = direction\n          if dx == -1:\n              action_list.append(env.action_specs()['LEFT'])\n          elif dx == 1:\n              action_list.append(env.action_specs()['RIGHT'])\n          elif dy == -1:\n              action_list.append(env.action_specs()['UP'])\n          elif dy == 1:\n              action_list.append(env.action_specs()['DOWN'])\n      \n      # Attempt to collect the primitive\n      action_list.append(env.action_specs()['USE'])\n\n  # Execute actions in the environment\n  state = env._current_state\n  for a in action_list:\n      r, done, info = env.step(a)\n      reward += r\n\n  return state, reward, action_list", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-14T12:53:12.853618", "function_name": "collect", "function_body": "  # Retrieve the index of the target primitive\n  primitive_index = env.scenario.world.cookbook.index[primitive]\n  \n  # Retrieve a list of all grabbable indices (items that can be picked up)\n  grabbable_indices = env.scenario.world.grabbable_indices\n  \n  # Filter out only the grabbable primitives in the inventory\n  inventory = state.inventory.copy()\n  target_primitive_count = inventory[primitive_index]\n\n  # Initialize action queue and visited set to implement BFS\n  action_queue = collections.deque([(state, [])])  \n  visited_states = set()\n\n  while action_queue:\n      current_state, actions_taken = action_queue.popleft()\n      \n      # Check if the desired primitive has been collected\n      if current_state.inventory[primitive_index] > target_primitive_count:\n          return actions_taken\n      \n      # Generate possible next states based on valid actions (DOWN, UP, LEFT, RIGHT)\n      for action in range(4):  # Assuming actions are indexed as DOWN=0, UP=1, LEFT=2, RIGHT=3\n          next_state, _ = current_state.step(action)\n          \n          # Create a hashable state representation for visited set tracking\n          grid_tuple = tuple(map(tuple, next_state.grid))\n          inventory_tuple = tuple(next_state.inventory)\n          state_repr = (grid_tuple, next_state.pos, next_state.dir, inventory_tuple)\n          \n          if state_repr not in visited_states:\n              visited_states.add(state_repr)\n              action_queue.append((next_state, actions_taken + [action]))\n              \n  # If no path to collect the primitive is found\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-14T12:55:47.932802", "function_name": "collect", "function_body": "  def bfs_for_primitive(primitive_index):\n    queue = collections.deque([(state.pos, [])])\n    visited = set()\n    \n    while queue:\n      current_pos, path = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check the 3x3 neighborhood for the primitive and available tools\n      for dx, dy in [(-1, -1), (-1, 0), (-1, 1), (0, -1), (0, 0), (0, 1), (1, -1), (1, 0), (1, 1)]:\n        neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if not (0 <= neighbor_pos[0] < state.grid.shape[0]) or not (0 <= neighbor_pos[1] < state.grid.shape[1]):\n          continue\n        \n        # Check for primitive\n        if np.any(state.grid[neighbor_pos] == primitive_index):\n          return path, neighbor_pos\n        \n        # Check for available tools and move to them if necessary\n        tool_indices = np.where(state.grid[neighbor_pos] != 0)[0]\n        for tool_index in tool_indices:\n          if state.inventory[tool_index] > 0 and can_use_tool(tool_index, primitive_index):\n            queue.append((neighbor_pos, path + [(dx, dy)]))\n            break\n\n    return None, None\n\n  def get_movement_actions(dx, dy):\n      actions = []\n      current_dir = state.dir\n      target_dir = None\n      \n      # Determine the target direction based on dx and dy\n      if dx > 0:  # Move right\n          target_dir = 2\n      elif dx < 0:  # Move left\n          target_dir = 3\n      elif dy > 0:  # Move up\n          target_dir = 0\n      elif dy < 0:  # Move down\n          target_dir = 1\n      \n      if current_dir != target_dir:\n          actions.extend(turn_towards(current_dir, target_dir))\n      \n      # Append the movement action based on the target direction\n      for _ in range(abs(dx)):\n          actions.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          actions.append(1 if dy > 0 else 0)\n\n      return actions\n\n  def turn_towards(current_dir, target_dir):\n      turns = []\n      while current_dir != target_dir:\n          if (target_dir - current_dir) % 4 <= 2:\n              turns.append((current_dir + 1) % 4)\n              current_dir = (current_dir + 1) % 4\n          else:\n              turns.append((current_dir + 3) % 4)\n              current_dir = (current_dir + 3) % 4\n      return turns\n\n  def move_to_position(target_pos):\n      dx = target_pos[0] - state.pos[0]\n      dy = target_pos[1] - state.pos[1]\n\n      action_list = []\n      \n      # Turn to face the target direction\n      current_dir = state.dir\n      target_dir = None\n      \n      if dx > 0:  # Move right\n          target_dir = 2\n      elif dx < 0:  # Move left\n          target_dir = 3\n      elif dy > 0:  # Move up\n          target_dir = 0\n      elif dy < 0:  # Move down\n          target_dir = 1\n      \n      if current_dir != target_dir:\n          action_list.extend(turn_towards(current_dir, target_dir))\n      \n      # Append the movement actions based on the target direction\n      for _ in range(abs(dx)):\n          action_list.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          action_list.append(1 if dy > 0 else 0)\n\n      return action_list\n\n  def can_use_tool(tool_index, primitive_index):\n    tool_name = state.world.cookbook.index[tool_index]\n    primitive_name = state.world.cookbook.index[primitive_index]\n\n    # Define which tools can be used on which primitives\n    if tool_name == \"BRIDGE\" and primitive_name == \"WATER\":\n        return True\n    elif tool_name == \"PICKAXE\" and primitive_name == \"GEM\":\n        return True\n\n    return False  # Simplified for demonstration\n\n  def use_tool_if_necessary(tool_index):\n      action_list.append(4)  # USE the tool\n      r, state, _ = env.step(4)\n      reward += r\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  primitive_index = state.world.cookbook.index.index(primitive)\n\n  # Get the path to the primitive\n  path_to_primitive, target_pos = bfs_for_primitive(primitive_index)\n\n  if path_to_primitive and target_pos:\n    action_list.extend(move_to_position(target_pos))\n\n    for action in action_list:\n        r, state, _ = env.step(action)\n        reward += r\n\n    # Check the neighborhood for tools that can be used\n    tool_indices = []\n    for dx, dy in [(-1, -1), (-1, 0), (-1, 1), (0, -1), (0, 0), (0, 1), (1, -1), (1, 0), (1, 1)]:\n        neighbor_pos = (target_pos[0] + dx, target_pos[1] + dy)\n        if not (0 <= neighbor_pos[0] < state.grid.shape[0]) or not (0 <= neighbor_pos[1] < state.grid.shape[1]):\n            continue\n        tool_indices.extend(np.where(state.grid[neighbor_pos] != 0)[0])\n    \n    for tool_index in tool_indices:\n      if state.inventory[tool_index] > 0 and can_use_tool(tool_index, primitive_index):\n          use_tool_if_necessary(tool_index)\n\n    # Collect the primitive\n    if np.any(state.grid[state.pos] == primitive_index):\n      action_list.append(4)  # USE to collect the primitive\n      r, state, _ = env.step(4)\n      reward += r\n\n  return state, reward, action_list", "island_id": 0, "scores": {"3": 0.0}}
