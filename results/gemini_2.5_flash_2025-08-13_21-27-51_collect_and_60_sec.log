           if dx > 0:   action_list.append(env.action_specs()[\"RIGHT\"])\n                  elif dx < 0: action_list.append(env.action_specs()[\"LEFT\"])\n                  elif dy > 0: action_list.append(env.action_specs()[\"DOWN\"])\n                  elif dy < 0: action_list.append(env.action_specs()[\"UP\"])\n                  \n                  r, state = env.step(state, action_list[-1])\n                  reward += r\n              # Use a bridge if available\n              if \"BRIDGE\" in inventory_indices:\n                  action_list.append(env.action_specs()[\"USE\"])\n                  r, state = env.step(state, action_list[-1])\n                  reward += r\n      \n      return state\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  \n  # Get the index of the primitive to collect\n  target_kind_index = env.world.cookbook.index[primitive]\n  \n  # Use tools if necessary before moving\n  state = use_tool_if_necessary(state, target_kind_index)\n  \n  # Perform BFS to find the shortest path to a cell with the target kind\n  path_to_target = bfs(state.pos, target_kind_index)\n  \n  if path_to_target:\n      for (nx, ny) in path_to_target:\n          # Calculate direction from current position to next position\n          dx, dy = nx - state.pos[0], ny - state.pos[1]\n          \n          if dx > 0:   action_list.append(env.action_specs()[\"RIGHT\"])\n          elif dx < 0: action_list.append(env.action_specs()[\"LEFT\"])\n          elif dy > 0: action_list.append(env.action_specs()[\"DOWN\"])\n          elif dy < 0: action_list.append(env.action_specs()[\"UP\"])\n          \n          # Move to the next position\n          r, state = env.step(state, action_list[-1])\n          reward += r\n      \n      # Collect the primitive by using the appropriate tool if necessary\n      action_list.append(env.action_specs()[\"USE\"])\n      r, state = env.step(state, action_list[-1])\n      reward += r\n  \n  return state, reward, action_list",