ple(new_state.grid.tobytes())) not in visited_states:\n              heapq.heappush(queue,\n                              (heuristic(new_state.pos, goal_positions) + distance + 1,\n                               new_state_tuple,\n                               actions_taken + [new_action],\n                               distance + 1))\n\n      # Check for tool usage opportunities\n      if any(current_inventory[index] > 0 for index in state.world.workshop_indices):\n          _, new_state = current_state.step(ACTION_INDEX_MAP['USE'])\n          new_state_tuple = tuple((new_state.pos, new_state.dir, tuple(new_state.grid.tobytes()), tuple(new_state.inventory)))\n          if (new_state.pos, tuple(new_state.grid.tobytes())) not in visited_states:\n              heapq.heappush(queue,\n                              (heuristic(new_state.pos, goal_positions) + distance + 1,\n                               new_state_tuple,\n                               actions_taken + [ACTION_INDEX_MAP['USE']],\n                               distance + 1))\n\n  # Once next to the primitive, use it if we can\n  if action_list and current_state.next_to(primitive_index):\n      _, _ = current_state.step(ACTION_INDEX_MAP['USE'])\n      action_list.append(ACTION_INDEX_MAP['USE'])\n\n  return state, reward, action_list", "island_id": 8, "scores": {"3": -1}}
