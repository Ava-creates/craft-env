dy > 0 else 0)\n\n      return actions\n\n  def turn_towards(current_dir, target_dir):\n      turns = []\n      while current_dir != target_dir:\n          if (target_dir - current_dir) % 4 <= 2:\n              turns.append((current_dir + 1) % 4)\n              current_dir = (current_dir + 1) % 4\n          else:\n              turns.append((current_dir + 3) % 4)\n              current_dir = (current_dir + 3) % 4\n      return turns\n\n  def move_to_position(target_pos):\n      dx = target_pos[0] - state.pos[0]\n      dy = target_pos[1] - state.pos[1]\n\n      action_list = []\n      \n      # Turn to face the target direction\n      current_dir = state.dir\n      target_dir = None\n      \n      if dx > 0:  # Move right\n          target_dir = 2\n      elif dx < 0:  # Move left\n          target_dir = 3\n      elif dy > 0:  # Move up\n          target_dir = 0\n      elif dy < 0:  # Move down\n          target_dir = 1\n      \n      if current_dir != target_dir:\n          action_list.extend(turn_towards(current_dir, target_dir))\n      \n      # Append the movement actions based on the target direction\n      for _ in range(abs(dx)):\n          action_list.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          action_list.append(1 if dy > 0 else 0)\n\n      return action_list\n\n  def can_use_tool(tool_index, primitive_index):\n    # Implement logic to determine if a tool can be used on a primitive\n    tool_name = state.world.cookbook.index.get(tool_index)\n    primitive_name = state.world.cookbook.index.get(primitive_index)\n    \n    # Placeholder logic for demonstration purposes\n    tool_to_primitives = {\n        \"BRIDGE\": [\"WATER\"],\n        \"PICKAXE\": [\"GEM\"]\n    }\n    \n    return primitive_name in tool_to_primitives.get(tool_name, [])\n\n  def get_tool_use_action(tool_index):\n    # This function should map the tool index to its corresponding use action index\n    # For example, BRIDGE might be mapped to action index 5\n    # Placeholder implementation, needs to be updated based on actual environment actions\n    tool_to_action = {\n        \"BRIDGE\": 5,\n        \"PICKAXE\": 6,\n        # Add other tools and their corresponding actions here\n    }\n    return tool_to_action.get(state.world.cookbook.index.get(tool_index))\n\n  state = env._current_state\n  primitive_index = state.world.cookbook.index.index(primitive)\n\n  # Get the path to the primitive\n  path_to_primitive, target_pos = bfs_for_primitive(primitive_index)\n  \n  action_list = []\n  reward = 0\n  \n  if path_to_primitive and target_pos:\n    for dx, dy in path_to_primitive:\n      action_list.extend(get_movement_actions(dx, dy))\n      \n      # Use tools if necessary before moving\n      tool_indices = np.where(state.grid[(state.pos[0] + dx, state.pos[1] + dy)] != 0)[0]\n      for tool_index in tool_indices:\n        if state.inventory[tool_index] > 0 and can_use_tool(tool_index, primitive_index):\n          action_list.append(get_tool_use_action(tool_index))\n    \n    # Move to the final position of the primitive\n    action_list.extend(move_to_position(target_pos))\n\n    # Collect the primitive\n    action_list.append(4)  # USE to collect the primitive\n\n  for action in action_list:\n      r, done, obs_dict = env.step(action)\n      reward += r\n      state = env._current_state\n\n  return state, reward, action_list", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-14T12:38:54.021881", "function_name": "collect", "function_body": "  def heuristic(pos1, pos2):\n    # Manhattan distance heuristic\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  action_map = {\n      'UP': env.world.N_ACTIONS['UP'],\n      'DOWN': env.world.N_ACTIONS['DOWN'],\n      'LEFT': env.world.N_ACTIONS['LEFT'],\n      'RIGHT': env.world.N_ACTIONS['RIGHT']\n  }\n\n  # Find the index of the primitive in the environment\n  primitive_index = env.world.cookbook.index(primitive)\n  if primitive_index is None:\n    raise ValueError(f\"Primitive {primitive} not found in the environment.\")\n\n  # Create a priority queue for A* search\n  open_set = collections.PriorityQueue()\n  start_pos = state.pos\n  start_dir = state.dir\n\n  # Dictionary to store the cost of reaching each position\n  g_score = {start_pos: 0}\n\n  # Dictionary to store the total cost (g + h) from start to finish through a given position\n  f_score = {start_pos: heuristic(start_pos, primitive_index)}\n\n  # Dictionary to reconstruct path once goal is reached\n  came_from = {}\n\n  # Add starting position and direction to the open set\n  open_set.put((f_score[start_pos], (start_pos, start_dir)))\n\n  while not open_set.empty():\n    _, current_state = open_set.get()\n    current_pos, current_dir = current_state\n\n    if state.next_to(primitive_index):\n      return construct_path(came_from, current_state)\n\n    # Explore neighbors\n    for dir_name in ['UP', 'DOWN', 'LEFT', 'RIGHT']:\n      action = action_map[dir_name]\n      next_state, _ = state.step(action)\n      neighbor_pos = next_state.pos\n\n      tentative_g_score = g_score[current_pos] + 1  # Assume each move has a cost of 1\n\n      if neighbor_pos not in g_score or tentative_g_score < g_score[neighbor_pos]:\n        came_from[next_state] = (current_state, action)\n        g_score[neighbor_pos] = tentative_g_score\n        f_score[neighbor_pos] = tentative_g_score + heuristic(neighbor_pos, primitive_index)\n        open_set.put((f_score[neighbor_pos], next_state))\n\n  raise ValueError(f\"No path to {primitive} found.\")", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-14T12:38:54.987582", "function_name": "collect", "function_body": "  def find_path_to_primitive(start_pos, goal_kind):\n    # Implement the pathfinding logic here\n    pass\n\n  def use_tool_if_needed(current_state, target_item):\n    # Implement the tool usage logic here\n    pass\n\n  action_list = []\n  reward = 0\n  current_state = env._current_state\n  \n  primitive_index = env.world.cookbook.index[primitive]\n  \n  while not current_state.next_to(primitive_index):\n      path_to_primitive = find_path_to_primitive(current_state.pos, primitive_index)\n      \n      if path_to_primitive is None:\n          break\n      \n      for pos in path_to_primitive:\n          move_action = get_move_action(current_state, pos)\n          action_list.append(move_action)\n          \n          r, current_state = env.step(current_state, move_action)\n          reward += r\n  \n  # Once next to the primitive, pick it up\n  if current_state.next_to(primitive_index):\n      collect_action = env.world.cookbook.index[\"USE\"]\n      action_list.append(collect_action)\n      \n      r, current_state = env.step(current_state, collect_action)\n      reward += r\n\n  return current_state, reward, action_list", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-14T12:39:53.899067", "function_name": "collect", "function_body": "  ACTION_INDEX_MAP = {\n      'UP': 0,\n      'DOWN': 1,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  action_list = []\n  reward = 0.0\n\n  # Get the index of the primitive we want to collect\n  primitive_index = env.world.cookbook.index[primitive]\n\n  state = env._current_state\n\n  def is_valid(state):\n      return tuple(state.grid.tobytes()) not in visited_states\n  \n  def heuristic(current_state, positions):\n      \"\"\"Heuristic function to estimate distance to the nearest primitive.\"\"\"\n      if positions.size == 0:\n          return float('inf')\n      distances = [np.linalg.norm(np.array(pos) - np.array(current_state.pos)) for pos in positions]\n      return min(distances)\n\n  # Implement an A* search with heuristic to find a path to the nearest instance of the desired primitive\n  queue = [(heuristic(state, np.argwhere(state.grid[:, :, primitive_index] > 0)), state, [])]  # Priority queue with (heuristic_cost, state, actions_taken)\n  visited_states = set()\n  \n  while queue:\n      _, current_state, actions_taken = queue.pop(0)\n\n      if current_state.next_to(primitive_index):\n          # We've found a state where we're next to the desired primitive\n          action_list.extend(actions_taken)\n          break\n\n      for direction in ['UP', 'DOWN', 'LEFT', 'RIGHT']:\n          new_action = ACTION_INDEX_MAP[direction]\n          _, new_state = current_state.step(new_action)\n\n          if is_valid(new_state):\n              # Update positions dynamically based on the new state\n              positions = np.argwhere(new_state.grid[:, :, primitive_index] > 0)\n              queue.append((heuristic(new_state, positions), new_state, actions_taken + [new_action]))\n              visited_states.add(tuple(new_state.grid.tobytes()))\n              \n      # Sort the queue to ensure we always expand the least costly node first\n      queue.sort()\n\n  # Once next to the primitive, use it if we can\n  if action_list and current_state.next_to(primitive_index):\n      _, _ = current_state.step(ACTION_INDEX_MAP['USE'])\n      action_list.append(ACTION_INDEX_MAP['USE'])\n\n  return state, reward, action_list", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-14T12:39:54.878174", "function_name": "collect", "function_body": "  ACTION_INDEX_MAP = {\n      'UP': 0,\n      'DOWN': 1,\n      'LEFT': 2,\n      'RIGHT': 3,\n      'USE': 4\n  }\n\n  action_list = []\n  reward = 0.0\n\n  # Get the index of the primitive we want to collect\n  primitive_index = env.world.cookbook.index[primitive]\n\n  state = env._current_state\n\n  def is_valid(state):\n      return tuple(state.grid.tobytes()) not in visited_states\n\n  def heuristic(state, pos):\n      \"\"\"Heuristic function to estimate distance to a specific position.\"\"\"\n      return np.linalg.norm(np.array(pos) - np.array(state.pos))\n\n  # Find all positions of the desired primitive\n  positions = np.argwhere(state.grid[:, :, primitive_index] > 0)\n  \n  if not positions.size:\n      return state, reward, action_list\n\n  best_actions = None\n  min_cost = float('inf')\n\n  for target_pos in positions:\n      queue = [(heuristic(state, target_pos), state, [])]\n      visited_states = set()\n      \n      while queue:\n          _, current_state, actions_taken = queue.pop(0)\n\n          if tuple(current_state.grid.tobytes()) == tuple(target_pos.tobytes()):\n              # We've reached the desired primitive position\n              if len(actions_taken) < min_cost:\n                  best_actions = actions_taken\n                  min_cost = len(actions_taken)\n              break\n\n          for direction in ['UP', 'DOWN', 'LEFT', 'RIGHT']:\n              new_action = ACTION_INDEX_MAP[direction]\n              _, new_state = current_state.step(new_action)\n\n              if is_valid(new_state):\n                  queue.append((heuristic(new_state, target_pos), new_state, actions_taken + [new_action]))\n                  visited_states.add(tuple(new_state.grid.tobytes()))\n                  \n          # Sort the queue to ensure we always expand the least costly node first\n          queue.sort()\n\n  action_list = best_actions if best_actions else []\n\n  # Once next to the primitive, use it if we can\n  if action_list and state.next_to(primitive_index):\n      _, _ = state.step(ACTION_INDEX_MAP['USE'])\n      action_list.append(ACTION_INDEX_MAP['USE'])\n\n  return env._current_state, reward, action_list", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-08-14T12:42:31.669316", "function_name": "collect", "function_body": "  def bfs_for_primitive(primitive_index):\n    queue = collections.deque([(state.pos, [])])\n    visited = set()\n    \n    while queue:\n      current_pos, path = queue.popleft()\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n\n      # Check the 3x3 neighborhood for the primitive and available tools\n      for dx, dy in [(-1, -1), (-1, 0), (-1, 1), (0, -1), (0, 0), (0, 1), (1, -1), (1, 0), (1, 1)]:\n        neighbor_pos = (current_pos[0] + dx, current_pos[1] + dy)\n        if not (0 <= neighbor_pos[0] < state.grid.shape[0]) or not (0 <= neighbor_pos[1] < state.grid.shape[1]):\n          continue\n        \n        # Check for primitive\n        if np.any(state.grid[neighbor_pos] == primitive_index):\n          return path, neighbor_pos\n        \n        # Check for available tools and move to them if necessary\n        tool_indices = np.where(state.grid[neighbor_pos] != 0)[0]\n        for tool_index in tool_indices:\n          if state.inventory[tool_index] > 0 and can_use_tool(tool_index, primitive_index):\n            queue.append((neighbor_pos, path + [(dx, dy)]))\n            break\n\n    return None, None\n\n  def get_movement_actions(dx, dy):\n      actions = []\n      current_dir = state.dir\n      target_dir = None\n      \n      # Determine the target direction based on dx and dy\n      if dx > 0:  # Move right\n          target_dir = 2\n      elif dx < 0:  # Move left\n          target_dir = 3\n      elif dy > 0:  # Move up\n          target_dir = 0\n      elif dy < 0:  # Move down\n          target_dir = 1\n      \n      if current_dir != target_dir:\n          actions.extend(turn_towards(current_dir, target_dir))\n      \n      # Append the movement action based on the target direction\n      for _ in range(abs(dx)):\n          actions.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          actions.append(1 if dy > 0 else 0)\n\n      return actions\n\n  def turn_towards(current_dir, target_dir):\n      turns = []\n      while current_dir != target_dir:\n          if (target_dir - current_dir) % 4 <= 2:\n              turns.append((current_dir + 1) % 4)\n              current_dir = (current_dir + 1) % 4\n          else:\n              turns.append((current_dir + 3) % 4)\n              current_dir = (current_dir + 3) % 4\n      return turns\n\n  def move_to_position(target_pos):\n      dx = target_pos[0] - state.pos[0]\n      dy = target_pos[1] - state.pos[1]\n\n      action_list = []\n      \n      # Turn to face the target direction\n      current_dir = state.dir\n      target_dir = None\n      \n      if dx > 0:  # Move right\n          target_dir = 2\n      elif dx < 0:  # Move left\n          target_dir = 3\n      elif dy > 0:  # Move up\n          target_dir = 0\n      elif dy < 0:  # Move down\n          target_dir = 1\n      \n      if current_dir != target_dir:\n          action_list.extend(turn_towards(current_dir, target_dir))\n      \n      # Append the movement actions based on the target direction\n      for _ in range(abs(dx)):\n          action_list.append(3 if dx > 0 else 2)\n      for _ in range(abs(dy)):\n          action_list.append(1 if dy > 0 else 0)\n\n      return action_list\n\n  def can_use_tool(tool_index, primitive_index):\n    tool_name = state.world.cookbook.index[tool_index]\n    primitive_name = state.world.cookbook.index[primitive_index]\n\n    # Define the tool use map based on the environment's rules\n    if tool_name == \"BRIDGE\" and primitive_name == \"WATER\":\n        return True\n    elif tool_name == \"PICKAXE\" and primitive_name == \"GEM\":\n        return True\n    elif tool_name == \"SHOVEL\" and primitive_name == \"DIRT\":\n        return True\n    # Add more conditions as needed\n\n    return False  # Simplified for demonstration\n\n  def use_tool_if_necessary(tool_index):\n      action_list.append(4)  # USE the tool\n      r, state, _ = env.step(4)\n      reward += r\n\n  action_list = []\n  reward = 0\n  state = env._current_state\n  primitive_index = state.world.cookbook.index.index(primitive)\n\n  # Get the path to the primitive\n  path_to_primitive, target_pos = bfs_for_primitive(primitive_index)\n  \n  if path_to_primitive and target_pos:\n    action_list.extend(move_to_position(target_pos))\n\n    for action in action_list:\n        r, state, _ = env.step(action)\n        reward += r\n\n    # Check the 3x3 neighborhood for tools that can be used\n    tool_indices = []\n    for dx, dy in [(-1, -1), (-1, 0), (-1, 1), (0, -1), (0, 0), (0, 1), (1, -1), (1, 0), (1, 1)]:\n        neighbor_pos = (target_pos[0] + dx, target_pos[1] + dy)\n        if not (0 <= neighbor_pos[0] < state.grid.shape[0]) or not (0 <= neighbor_pos[1] < state.grid.shape[1]):\n            continue\n        tool_indices.extend(np.where(state.grid[neighbor_pos] != 0)[0])\n    \n    for tool_index in tool_indices:\n      if state.inventory[tool_index] > 0 and can_use_tool(tool_index, primitive_index):\n          use_tool_if_necessary(tool_index)\n\n    # Collect the primitive\n    if np.any(state.grid[state.pos] == primitive_index):\n      action_list.append(4)  # USE to collect the primitive\n      r, state, _ = env.step(4)\n      reward += r\n\n  return state, reward, action_list", "island_id": 0, "scores": {"3": 0.0}}
