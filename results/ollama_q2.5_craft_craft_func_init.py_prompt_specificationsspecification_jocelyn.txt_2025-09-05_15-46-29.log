{"timestamp": "2025-09-05T15:51:43.472895", "function_name": "craft", "function_body": "  # Get the index of the desired item using the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe available for {item}.\")\n\n  # Find the workshop required for crafting the item\n  workshop_index = None\n  for i, workshop_indices in enumerate(env.world.workshop_indices):\n      if any(env.world.cookbook.recipes[item_index].get(workshop_kind) is not None for workshop_kind in workshop_indices):\n          workshop_index = env.world.workshop_indices[i]\n          break\n\n  if workshop_index is None:\n    raise ValueError(f\"No suitable workshop found for crafting {item}.\")\n\n  # Define the actions to move towards the nearest workshop\n  def find_nearest_workshop_position(env, workshop_indices):\n      pos = np.array(env._current_state.pos)\n      closest_workshop_pos = None\n      min_distance = float('inf')\n      grid = env._current_state.grid\n\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if any(grid[x, y, workshop_kind] > 0 for workshop_kind in workshop_indices):\n                  distance = np.linalg.norm(pos - np.array([x, y]))\n                  if distance < min_distance:\n                      closest_workshop_pos = (x, y)\n                      min_distance = distance\n\n      return closest_workshop_pos\n\n  def path_to_position(env, target_pos):\n      pos = env._current_state.pos\n      actions = []\n\n      while tuple(pos) != target_pos:\n          dx = target_pos[0] - pos[0]\n          dy = target_pos[1] - pos[1]\n\n          if dx < 0:\n              actions.append(2)  # LEFT\n          elif dx > 0:\n              actions.append(3)  # RIGHT\n\n          if dy < 0:\n              actions.append(0)  # DOWN\n          elif dy > 0:\n              actions.append(1)  # UP\n\n          pos = (pos[0] + (dx != 0), pos[1] + (dy != 0))\n\n      return actions\n\n  nearest_workshop_pos = find_nearest_workshop_position(env, workshop_index)\n  move_actions = path_to_position(env, nearest_workshop_pos)\n\n  # Add the USE action to craft the item\n  use_action = [4]  # USE\n\n  # Combine all actions and return\n  return move_actions + use_action", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-05T15:53:17.745936", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index of the desired item\n  i_goal = env.world.cookbook.index[item]\n  \n  # Get all recipe details for the goal from cookbook recipes\n  recipe_details = env.world.cookbook.recipes[i_goal]\n\n  # Check if a workshop is needed (exists in the recipe)\n  if '_key' in recipe_details:\n    key_index = recipe_details['_key']\n    i_workshop = None\n\n    # Find which workshop can be used to craft this item\n    for i, workshop_indices in enumerate(env.world.workshop_indices):\n        if key_index == workshop_indices[0]:  # Assuming the key is always at index 0 of the workshop list\n            i_workshop = i\n            break\n    \n    if i_workshop is not None:\n      # Navigate to the workshop using move actions based on current pos and goal pos\n      workshop_pos = env.world.workshop_indices[i_workshop][1:]  # Assuming the first element is key_index\n\n      # Calculate the required moves to reach the workshop\n      current_pos = env._current_state.pos\n      moves_to_workshop = calculate_moves(current_pos, workshop_pos)\n\n      # Add move actions to navigate to the workshop\n      actions.extend(moves_to_workshop)\n      \n      # Add the USE action to craft the item at the workshop\n      actions.append(env.world.n_actions - 1)  # Assuming USE is always the last action\n\n    else:\n        raise ValueError(f\"No suitable workshop found for crafting {item}.\")\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-09-05T15:53:19.090036", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Find the recipe for the item\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # Check if there is a \"_key\" entry in the recipe, which indicates a specific workshop type\n  workshop_key = None\n  if \"_key\" in recipe:\n      workshop_key = recipe[\"_key\"]\n  \n  # Find the index of the appropriate workshop based on the recipe key\n  if workshop_key == \"workshop0\":\n      workshop_idx = env.world.workshop_indices[0]\n  elif workshop_key == \"workshop1\":\n      workshop_idx = env.world.workshop_indices[1]\n  elif workshop_key == \"workshop2\":\n      workshop_idx = env.world.workshop_indices[2]\n  else:\n      # Default to the first workshop if no specific key is found\n      workshop_idx = env.world.workshop_indices[0]\n\n  # Find a position next to the selected workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n  target_pos = None\n\n  for pos in workshop_positions:\n      if env._current_state.next_to(workshop_idx, tuple(pos)):\n          target_pos = tuple(pos)\n          break\n  \n  # If no position next to the workshop is found, default to the first one\n  if target_pos is None:\n      target_pos = tuple(workshop_positions[0])\n\n  # Calculate actions needed to move to the target position\n  actions_to_move = []\n  while env._current_state.pos != target_pos:\n      dx = target_pos[0] - env._current_state.pos[0]\n      dy = target_pos[1] - env._current_state.pos[1]\n\n      if dx > 0:\n          actions_to_move.append(env.world.cookbook.index[\"RIGHT\"])\n      elif dx < 0:\n          actions_to_move.append(env.world.cookbook.index[\"LEFT\"])\n\n      if dy > 0:\n          actions_to_move.append(env.world.cookbook.index[\"DOWN\"])\n      elif dy < 0:\n          actions_to_move.append(env.world.cookbook.index[\"UP\"])\n\n  # Add the USE action to craft the item\n  actions_to_move.append(env.world.cookbook.index[\"USE\"])\n\n  return actions_to_move", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-09-05T15:55:14.071261", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the recipe for the item from the cookbook\n  recipe = env.world.cookbook.recipes.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n    \n  # Determine the workshop type required for crafting\n  # Assuming that recipes with \"_key\" indicate a specific workshop requirement\n  workshop_type = None\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          workshop_type = recipe[\"_key\"]\n  \n  # Find the nearest workshop of the required type\n  # This assumes that workshops are indexed in some way and their types can be inferred from their indices\n  available_workshops = env.world.workshop_indices\n  closest_workshop_index = None\n  min_distance = float('inf')\n  \n  for workshop_index in available_workshops:\n      # Assuming workshop types can be determined by the index range or some other attribute\n      if workshop_type is not None and workshop_type != workshop_index // len(env.world.workshop_indices):\n          continue\n      \n      # Calculate the distance to the nearest cell of the workshop type\n      x, y = env._current_state.pos\n      grid = env._current_state.grid[:, :, workshop_index]\n      \n      # Find the nearest cell with the workshop type\n      workshop_cells = np.argwhere(grid > 0)\n      if len(workshop_cells) == 0:\n          continue\n      \n      for cx, cy in workshop_cells:\n          distance = abs(cx - x) + abs(cy - y)\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = (cx, cy)\n  \n  # If no valid workshop is found, raise an error\n  if closest_workshop_index is None:\n      raise ValueError(f\"No suitable workshop found for item: {item}\")\n  \n  # Generate actions to move to the nearest cell of the workshop type\n  x_target, y_target = closest_workshop_index\n  x_current, y_current = env._current_state.pos\n  actions = []\n  \n  # Move vertically first\n  if y_target > y_current:\n      actions.extend([craft.DOWN] * (y_target - y_current))\n  elif y_target < y_current:\n      actions.extend([craft.UP] * (y_current - y_target))\n  \n  # Then move horizontally\n  if x_target > x_current:\n      actions.extend([craft.RIGHT] * (x_target - x_current))\n  elif x_target < x_current:\n      actions.extend([craft.LEFT] * (x_current - x_target))\n  \n  # Use the USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-05T15:55:15.518903", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Fetch the recipe for the desired item from the cookbook\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  # Check if the recipe exists\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  # Initialize the list of actions\n  actions = []\n  \n  # Assuming we have all the primitives required in the inventory,\n  # we only need to find the workshop and perform the USE action.\n  \n  # Extract the workshop index from the recipe (assuming \"_key\" is used for the workshop)\n  if \"_key\" not in recipe:\n    raise ValueError(f\"No workshop key found in recipe for item: {item}\")\n    \n  workshop_index = recipe[\"_key\"]\n  \n  # Find the position of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop found for item: {item} with index: {workshop_index}\")\n    \n  # Choose the first available workshop position\n  target_workshop_pos = tuple(workshop_positions[0])\n  \n  # Calculate the path to the workshop from the current agent position\n  start_pos = env._current_state.pos\n  path_to_workshop = find_path(start_pos, target_workshop_pos)\n  \n  # Convert the path into actions (DOWN, UP, LEFT, RIGHT)\n  for step in path_to_workshop:\n    direction = calculate_direction(env._current_state.pos, step)\n    if direction == \"UP\":\n      actions.append(1)  # Assuming DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923\n    elif direction == \"DOWN\":\n      actions.append(0)\n    elif direction == \"LEFT\":\n      actions.append(2)\n    elif direction == \"RIGHT\":\n      actions.append(3)\n    \n    # Move the agent to the next position in the path\n    env._current_state.pos = step\n  \n  # Once at the workshop, perform the USE action\n  actions.append(4)  # Assuming USE\u21924\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-09-05T15:56:34.516471", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Find the required workshop (if any)\n  workshop_index = None\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if \"_key\" in recipe:\n    key = recipe[\"_key\"]\n    if key.startswith(\"workshop\"):\n      workshop_index = int(key.split(\"workshop\")[1])\n    \n  # Get the agent's initial position and direction\n  current_pos = env._current_state.pos\n  current_dir = env._current_state.dir\n  \n  actions = []\n  \n  if workshop_index is not None:\n    # Move to the workshop location (assuming a direct path)\n    target_workshop_pos = env.world.workshop_indices[workshop_index]\n    actions.extend(move_to(env, target_workshop_pos))\n    \n    # Turn towards the workshop\n    target_dir = compute_direction(current_pos, target_workshop_pos)\n    actions.extend(turn_towards(env, current_dir, target_dir))\n  \n  # Perform USE action to craft the item at the workshop\n  actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
