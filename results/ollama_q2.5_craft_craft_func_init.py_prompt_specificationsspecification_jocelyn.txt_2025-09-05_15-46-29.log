{"timestamp": "2025-09-05T15:49:43.486889", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the index for the item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the workshop required to make the item\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  if recipe is None:\n    return []  # No recipe found\n  \n  # Determine which workshop is used for this recipe (if any \"_key\" is present)\n  workshop_key = next((k for k in recipe.keys() if isinstance(k, str) and k.startswith(\"workshop\")), None)\n  workshop_index = env.world.cookbook.index.get(workshop_key, None) if workshop_key else None\n\n  # If a workshop is needed\n  if workshop_index:\n    # Find the position of the first available workshop in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n    \n    if len(workshop_positions) == 0:\n      return []  # No workshop found\n    \n    # Move to the closest workshop\n    target_pos = workshop_positions[0]\n    current_pos = env._current_state.pos\n    path_actions = move_to(env, current_pos, target_pos)\n    actions.extend(path_actions)\n\n    # Use the USE action at the workshop\n    actions.append(4)  # Action index for USE\n    \n  else:\n    # If no workshop is needed, just use the USE action where we are\n    actions.append(4)  # Action index for USE\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-09-05T15:50:41.404166", "function_name": "craft", "function_body": "  def get_workshop_for_item(item_index):\n    # Find the workshop required for the given item_index\n    for recipe in env.world.cookbook.recipes.values():\n      if item_index == recipe.get(\"_key\"):\n        return recipe.get(\"workshop\")\n    return None\n\n  actions = []\n  item_index = env.world.cookbook.index[item]\n\n  # Get the workshop index required for crafting the item\n  workshop_index = get_workshop_for_item(item_index)\n\n  if workshop_index is not None:\n      # Find the position of the workshop in the grid\n      workshop_position = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n      \n      if workshop_position.size > 0:\n          # Get the first occurrence of the workshop\n          target_x, target_y = workshop_position[0]\n\n          # Calculate the relative direction to the workshop\n          current_x, current_y = env._current_state.pos\n          delta_x = target_x - current_x\n          delta_y = target_y - current_y\n\n          # Move to the workshop position\n          if delta_x > 0:\n              actions.extend([env.world.N_ACTIONS.RIGHT] * abs(delta_x))\n          elif delta_x < 0:\n              actions.extend([env.world.N_ACTIONS.LEFT] * abs(delta_x))\n\n          if delta_y > 0:\n              actions.extend([env.world.N_ACTIONS.DOWN] * abs(delta_y))\n          elif delta_y < 0:\n              actions.extend([env.world.N_ACTIONS.UP] * abs(delta_y))\n\n          # Use the USE action to craft the item\n          actions.append(env.world.N_ACTIONS.USE)\n      else:\n          raise ValueError(\"Workshop not found in the grid.\")\n  else:\n      raise ValueError(\"No workshop specified for this item.\")\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-09-05T15:50:42.654766", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_idx = env.world.cookbook.index[item]\n  \n  # Get recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_idx)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}.\")\n    \n  # Determine the type of workshop required based on the recipe\n  workshop_idx = determine_workshop_index(recipe, env)\n\n  # Plan actions to move to the workshop and perform USE action\n  actions_to_take = plan_crafting_steps(env, workshop_idx)\n  \n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
