{"timestamp": "2025-07-29T21:47:17.418551", "function_name": "craft", "function_body": "    # Define action constants for readability within the function\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper function for BFS pathfinding to a target cell\n    # This function is nested to have access to `world` and `current_state` implicitly.\n    def _bfs_path_to_target_cell(start_pos, target_cell_pos, current_state, world):\n        grid_shape = current_state.grid.shape[:2] # (WIDTH, HEIGHT)\n        non_grabbable_indices = world.non_grabbable_indices\n\n        # Mapping of actions to (dx, dy) movements on the grid\n        moves = {\n            UP: (0, -1),\n            DOWN: (0, 1),\n            LEFT: (-1, 0),\n            RIGHT: (1, 0),\n        }\n        \n        # Queue for BFS: stores (current_position, list_of_actions_to_reach_here)\n        queue = collections.deque([(start_pos, [])])\n        visited = {start_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n        while queue:\n            (curr_x, curr_y), path = queue.popleft()\n\n            if (curr_x, curr_y) == target_cell_pos:\n                return path # Path found!\n\n            for action, (dx, dy) in moves.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                # Check if the next position is within grid boundaries\n                if not (0 <= next_x < grid_shape[0] and 0 <= next_y < grid_shape[1]):\n                    continue # Out of bounds\n\n                # Check if the next position has already been visited\n                if (next_x, next_y) in visited:\n                    continue\n\n                # Check if the next position is blocked by a non-grabbable item\n                is_blocked = False\n                for k_idx in range(current_state.grid.shape[2]):\n                    if current_state.grid[next_x, next_y, k_idx] > 0 and k_idx in non_grabbable_indices:\n                        is_blocked = True\n                        break\n                \n                if is_blocked:\n                    continue # Cannot move into a blocked cell\n\n                visited.add((next_x, next_y))\n                queue.append(((next_x, next_y), path + [action]))\n                \n        return None # No path found\n\n    # Helper function for BFS pathfinding to a cell adjacent to target\n    # This function is nested to have access to `world` and `current_state` implicitly.\n    def _bfs_path_to_adjacent_cell(start_pos, target_cell_pos, current_state, world):\n        grid_shape = current_state.grid.shape[:2]\n        non_grabbable_indices = world.non_grabbable_indices\n\n        # Mapping of actions to (dx, dy) movements on the grid\n        moves = {\n            UP: (0, -1),\n            DOWN: (0, 1),\n            LEFT: (-1, 0),\n            RIGHT: (1, 0),\n        }\n        \n        # Define relative positions for adjacency check (Manhattan distance 1)\n        adjacent_offsets = [(0, 1), (0, -1), (1, 0), (-1, 0)] # (dx, dy) for Down, Up, Right, Left\n        \n        queue = collections.deque([(start_pos, [])])\n        visited = {start_pos}\n\n        while queue:\n            (curr_x, curr_y), path = queue.popleft()\n\n            # Check if current position is adjacent to the target\n            is_adjacent = False\n            for dx_adj, dy_adj in adjacent_offsets:\n                adj_x, adj_y = target_cell_pos[0] + dx_adj, target_cell_pos[1] + dy_adj\n                if (curr_x, curr_y) == (adj_x, adj_y):\n                    is_adjacent = True\n                    break\n            \n            if is_adjacent:\n                return path # Path to an adjacent cell found!\n\n            for action, (dx, dy) in moves.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                if not (0 <= next_x < grid_shape[0] and 0 <= next_y < grid_shape[1]):\n                    continue\n\n                if (next_x, next_y) in visited:\n                    continue\n\n                is_blocked = False\n                for k_idx in range(current_state.grid.shape[2]):\n                    if current_state.grid[next_x, next_y, k_idx] > 0 and k_idx in non_grabbable_indices:\n                        is_blocked = True\n                        break\n                \n                if is_blocked:\n                    continue\n\n                visited.add((next_x, next_y))\n                queue.append(((next_x, next_y), path + [action]))\n                \n        return None # No path found\n\n    # This list will accumulate all actions required to craft the item\n    all_actions = []\n    \n    # Get the current state and world configuration from the environment\n    # CraftState.step() returns a new CraftState object, so `state` can be updated by re-assignment.\n    current_state = env._current_state \n    world = env.world\n    cookbook = world.cookbook\n\n    # Recursive helper function to satisfy a single item requirement\n    # It attempts to gather/craft 'target_count' of 'needed_idx'\n    # 'state': The current CraftState, which gets updated through actions.\n    # 'path_to_item': The list where actions are accumulated.\n    # 'visited_goals': A set to detect and prevent circular dependencies in recipes.\n    # Returns (success_bool, new_state_after_actions)\n    def _satisfy_item(state, needed_idx, target_count, path_to_item, visited_goals):\n        # Base case: If we already have enough of the item, no further actions are needed for this requirement.\n        if state.inventory[needed_idx] >= target_count:\n            return True, state\n\n        # Check for circular dependencies or if this item is already being processed in the current call stack.\n        if needed_idx in visited_goals:\n            return False, state \n\n        visited_goals.add(needed_idx) # Mark this item as currently being sought\n\n        try:\n            # 1. Check if the item is a primitive resource (can be picked up from the grid)\n            if needed_idx in cookbook.primitives:\n                # Search for an instance of this primitive item on the grid\n                target_pos = None\n                grid_shape = state.grid.shape[:2]\n                for x in range(grid_shape[0]):\n                    for y in range(grid_shape[1]):\n                        if state.grid[x, y, needed_idx] > 0: # If the item exists at (x,y)\n                            target_pos = (x, y)\n                            break\n                    if target_pos:\n                        break\n                \n                if target_pos:\n                    # Find a path to the primitive's cell\n                    path_to_target = _bfs_path_to_target_cell(state.pos, target_pos, state, world)\n                    if path_to_target is None:\n                        return False, state # Cannot reach the primitive\n                    \n                    # Execute movement actions\n                    for action in path_to_target:\n                        _, state = state.step(action) # Update the state by performing the action\n                        path_to_item.append(action) # Record the action\n                    \n                    # After moving to the cell, perform a USE action to pick it up\n                    _, state = state.step(USE)\n                    path_to_item.append(USE)\n                    \n                    # Verify if the item was successfully picked up\n                    if state.inventory[needed_idx] >= target_count:\n                        return True, state\n                    else:\n                        # Pickup failed or not enough picked up\n                        return False, state\n                else:\n                    # Primitive not found on the grid\n                    return False, state \n\n            # 2. Check if the item has a crafting recipe\n            recipe = cookbook.recipes.get(needed_idx)\n            if recipe:\n                # Identify all ingredients needed, considering current inventory\n                ingredients_to_get = []\n                for ingredient_idx_raw, ingredient_count in recipe.items():\n                    if ingredient_idx_raw == '_key':\n                        continue # Special key for workshop type, handled separately\n\n                    # Calculate how much of this ingredient is actually needed (beyond what's in inventory)\n                    actual_needed = max(0, ingredient_count - state.inventory[ingredient_idx_raw])\n                    if actual_needed > 0:\n                        ingredients_to_get.append((ingredient_idx_raw, actual_needed))\n\n                # Recursively satisfy each required ingredient\n                for ingredient_idx, actual_needed in ingredients_to_get:\n                    # The recursive call targets the current count of the ingredient plus the additional needed\n                    success, state = _satisfy_item(state, ingredient_idx, state.inventory[ingredient_idx] + actual_needed, path_to_item, visited_goals)\n                    if not success:\n                        return False, state # Failed to get an ingredient, so cannot craft\n\n                # All ingredients are now acquired, proceed with crafting\n                workshop_kind_idx = None\n                if '_key' in recipe:\n                    workshop_kind_str = recipe['_key']\n                    # Convert the workshop name string to its integer index\n                    workshop_kind_idx = cookbook.index.index(workshop_kind_str)\n                \n                if workshop_kind_idx: # Crafting requires a specific workshop\n                    # Find the location of the required workshop on the grid\n                    target_workshop_pos = None\n                    grid_shape = state.grid.shape[:2]\n                    for x in range(grid_shape[0]):\n                        for y in range(grid_shape[1]):\n                            if state.grid[x, y, workshop_kind_idx] > 0:\n                                target_workshop_pos = (x, y)\n                                break\n                        if target_workshop_pos:\n                            break\n                    \n                    if target_workshop_pos is None:\n                        return False, state # Workshop not found\n\n                    # Find a path to a cell adjacent to the workshop\n                    path_to_workshop = _bfs_path_to_adjacent_cell(state.pos, target_workshop_pos, state, world)\n                    if path_to_workshop is None:\n                        return False, state # Cannot reach the workshop\n\n                    # Execute movement actions to get next to the workshop\n                    for action in path_to_workshop:\n                        _, state = state.step(action)\n                        path_to_item.append(action)\n\n                    # Perform a USE action at the workshop to craft the item\n                    _, state = state.step(USE)\n                    path_to_item.append(USE)\n                    \n                    # Verify if the item was successfully crafted\n                    if state.inventory[needed_idx] >= target_count:\n                        return True, state\n                    else:\n                        # Crafting failed (e.g., ingredients not consumed, or other game rule)\n                        return False, state\n                else: # No specific workshop required, implies self-crafting by USE action\n                    # This branch is for recipes that just require ingredients and a USE action from anywhere.\n                    _, state = state.step(USE)\n                    path_to_item.append(USE)\n                    \n                    # Verify if the item was successfully crafted\n                    if state.inventory[needed_idx] >= target_count:\n                        return True, state\n                    else:\n                        return False, state\n            \n            # If the item is neither a primitive nor has a known recipe, it cannot be acquired.\n            return False, state\n        \n        finally:\n            # Always remove the current goal from visited_goals when returning from the function call.\n            # This allows other branches of the recursion to potentially craft this item if needed.\n            visited_goals.remove(needed_idx)\n\n    # --- Main logic of craft_v1 ---\n    \n    # Get the initial count of the target item in the inventory\n    initial_item_count = current_state.inventory[item]\n    \n    # If the item is already present (count > 0), no actions are needed.\n    if initial_item_count > 0:\n        return []\n\n    # Attempt to satisfy the goal: acquire at least one instance of the 'item'.\n    # `target_count` is set to `initial_item_count + 1` to ensure we actually get a new item.\n    success, final_state = _satisfy_item(current_state, item, initial_item_count + 1, all_actions, set())\n\n    # Return the collected actions if successful, otherwise an empty list.\n    if success and final_state.inventory[item] > initial_item_count:\n        return all_actions\n    else:\n        return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:47:18.392907", "function_name": "craft", "function_body": "  import collections\n\n  # Helper function for BFS pathfinding\n  # Finds a sequence of movement actions to get adjacent to an item of kind `target_kind_idx`.\n  # It simulates state transitions to find paths without affecting the actual environment.\n  def _bfs_path_to_adjacent(start_state, target_kind_idx, world):\n      q = collections.deque([(start_state, [])]) # Queue stores (current_sim_state, actions_path_to_current_state)\n      visited = set() # Stores (position, direction) to avoid cycles in the search\n      visited.add((start_state.pos, start_state.dir))\n\n      # List of movement actions (assuming DOWN=0, UP=1, LEFT=2, RIGHT=3)\n      # These constants are from env_factory.ACTIONS\n      movement_actions = [env_factory.ACTIONS[\"DOWN\"], env_factory.ACTIONS[\"UP\"],\n                          env_factory.ACTIONS[\"LEFT\"], env_factory.ACTIONS[\"RIGHT\"]]\n\n      while q:\n          curr_state, path = q.popleft()\n\n          # If the current state is already next to the target kind, we found a path\n          if curr_state.next_to(target_kind_idx):\n              return path\n\n          # Explore possible next states by applying movement actions\n          for action in movement_actions:\n              # Simulate the step: CraftState.step returns a new CraftState instance, effectively a copy\n              _, next_state = curr_state.step(action)\n\n              # Check if this (position, direction) configuration has been visited\n              state_key = (next_state.pos, next_state.dir)\n              if state_key not in visited:\n                  visited.add(state_key)\n                  q.append((next_state, path + [action]))\n      return None # Target kind not reachable\n\n  # Recursive solver function to find actions to craft a target item\n  # `current_sim_state`: The current simulated state of the agent (grid, inventory, pos, dir)\n  # `target_item_idx`: The integer index of the item to be crafted/obtained\n  # `world`: Reference to the CraftWorld instance for recipes and item properties\n  # `visited_goals_stack`: A list used as a stack to detect and prevent circular dependencies in recipes\n  def _solve_craft_goal(current_sim_state, target_item_idx, world, visited_goals_stack):\n      # Base case: If the target item is already in the inventory, no actions needed\n      if current_sim_state.inventory[target_item_idx] > 0:\n          return []\n\n      # Prevent infinite recursion for circular dependencies in recipes (e.g., A needs B, B needs A)\n      if target_item_idx in visited_goals_stack:\n          return None\n\n      # Add the current goal to the stack to track dependencies\n      visited_goals_stack.append(target_item_idx)\n\n      # List to accumulate actions for this goal\n      actions_sequence = []\n\n      try:\n          # Case 1: The target item is a primitive (can be picked up from the grid)\n          if target_item_idx in world.cookbook.primitives:\n              path_to_primitive = _bfs_path_to_adjacent(current_sim_state, target_item_idx, world)\n              if path_to_primitive is None:\n                  return None # Primitive not found or unreachable\n\n              actions_sequence.extend(path_to_primitive)\n              # Simulate the path actions to update the `current_sim_state`\n              for action in path_to_primitive:\n                  _, current_sim_state = current_sim_state.step(action)\n\n              # After reaching the primitive, use the 'USE' action to pick it up\n              actions_sequence.append(env_factory.ACTIONS[\"USE\"])\n              _, current_sim_state = current_sim_state.step(env_factory.ACTIONS[\"USE\"]) # Simulate pickup\n              return actions_sequence\n\n          # Case 2: The target item is a crafted item (requires a recipe)\n          if target_item_idx in world.cookbook.recipes:\n              recipe = world.cookbook.recipes[target_item_idx]\n              required_workshop_idx = None\n              ingredients_needed = [] # Stores (ingredient_index, count_needed)\n\n              # Parse the recipe to identify workshop and ingredients\n              for key, count in recipe.items():\n                  if key == \"_key\":\n                      required_workshop_idx = count # The 'count' here is the index of the workshop\n                  else:\n                      ingredients_needed.append((key, count))\n\n              # Recursively obtain all required ingredients\n              for ingredient_idx, needed_count in ingredients_needed:\n                  current_count_in_inventory = current_sim_state.inventory[ingredient_idx]\n                  # Only try to obtain if we don't have enough\n                  for _ in range(needed_count - current_count_in_inventory):\n                      # Recursively call _solve_craft_goal for each ingredient\n                      ingredient_actions = _solve_craft_goal(current_sim_state, ingredient_idx, world, visited_goals_stack)\n                      if ingredient_actions is None:\n                          # If an ingredient cannot be obtained, the target item cannot be crafted\n                          return None\n\n                      actions_sequence.extend(ingredient_actions)\n                      # Simulate the actions for the ingredient acquisition to update `current_sim_state`\n                      for action in ingredient_actions:\n                          _, current_sim_state = current_sim_state.step(action)\n\n              # After all ingredients are (simulated to be) in the inventory,\n              # move to the required workshop (if any) and perform the 'USE' action to craft\n              if required_workshop_idx is not None:\n                  path_to_workshop = _bfs_path_to_adjacent(current_sim_state, required_workshop_idx, world)\n                  if path_to_workshop is None:\n                      return None # Cannot reach the required workshop\n                  actions_sequence.extend(path_to_workshop)\n                  # Simulate movement to workshop\n                  for action in path_to_workshop:\n                      _, current_sim_state = current_sim_state.step(action)\n\n              # Perform the 'USE' action to craft the item\n              actions_sequence.append(env_factory.ACTIONS[\"USE\"])\n              _, current_sim_state = current_sim_state.step(env_factory.ACTIONS[\"USE\"]) # Simulate crafting\n              return actions_sequence\n\n          # Case 3: The item is neither primitive nor craftable via any known recipe\n          return None\n      finally:\n          # Always remove the current goal from the stack when its branch finishes\n          visited_goals_stack.pop()\n\n  # Get the initial simulated state from the environment\n  initial_sim_state = env._current_state\n  # Get the CraftWorld instance for access to recipes, primitives, etc.\n  world = env.world\n\n  # Start the recursive solver. The `visited_goals_stack` is initially empty.\n  actions_sequence = _solve_craft_goal(initial_sim_state, item, world, [])\n\n  # Return the sequence of actions, or an empty list if the item cannot be crafted\n  if actions_sequence is None:\n      return []\n  else:\n      return actions_sequence", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:48:22.295360", "function_name": "craft", "function_body": "  # Helper to create a hashable representation of a CraftState\n  # This function is nested to ensure all code is within craft_v2\n  def _hashable_craft_state(craft_state):\n      \"\"\"\n      Creates a hashable tuple representation of a CraftState for BFS visited set.\n      Includes position, direction, inventory, and a hash of the grid's bytes.\n      \"\"\"\n      # Using .tobytes() for numpy arrays for a consistent hashable representation\n      return (\n          craft_state.pos,\n          craft_state.dir,\n          tuple(craft_state.inventory.tolist()),\n          craft_state.grid.tobytes()\n      )\n\n  # Get the initial state from the environment\n  initial_state = env._current_state\n\n  # Check if the goal item is already in the inventory\n  if initial_state.satisfies(None, item):\n    return [] # Already have the item, no actions needed\n\n  # Initialize BFS queue: (CraftState, list_of_actions_to_reach_this_state)\n  # A tuple `(state, path)` where `state` is a CraftState object and `path` is a list of actions\n  q = collections.deque([(initial_state, [])])\n\n  # Initialize set to keep track of visited states (to avoid cycles and redundant work)\n  # A state is defined by (position, direction, inventory, grid content)\n  visited = {_hashable_craft_state(initial_state)}\n\n  # Get possible actions (assuming 0-4 as per DMLab convention: DOWN, UP, LEFT, RIGHT, USE)\n  # env.n_actions provides the total number of distinct actions.\n  possible_actions = range(env.n_actions)\n\n  # BFS loop\n  while q:\n    current_state, current_path = q.popleft()\n\n    # Iterate over all possible actions from the current state\n    for action in possible_actions:\n      # Apply the action to get the new state\n      # CraftState.step returns (reward, new_state)\n      # We ignore the reward as this is a pathfinding problem, not a reinforcement learning one\n      # The problem description states reward is always 0.0 for step, so it's not relevant for path cost.\n      _, new_state = current_state.step(action)\n\n      # Create the path to the new state\n      new_path = current_path + [action]\n\n      # Check if the new state has been visited before\n      hashable_new_state = _hashable_craft_state(new_state)\n\n      if hashable_new_state not in visited:\n        visited.add(hashable_new_state)\n\n        # Check if the goal is satisfied in the new state\n        if new_state.satisfies(None, item):\n          return new_path # Found a path to craft the item!\n\n        # If not satisfied, add the new state to the queue for further exploration\n        q.append((new_state, new_path))\n\n  # If the queue becomes empty and the goal was not reached, it means the item\n  # cannot be crafted from the current state within the explored search space.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:48:22.364660", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Actions as defined in action_specs() for CraftWorld\n    # These values are standard for DMLab-style environments\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    # Initialize the environment to its starting state.\n    # This sets the internal _current_state of the CraftLab instance.\n    _ = env.reset()\n    initial_state = env._current_state\n\n    # Queue for Breadth-First Search (BFS).\n    # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_to_reach_this_state).\n    q = collections.deque()\n    q.append((initial_state, []))\n\n    # Set to store visited state representations.\n    # This helps to avoid redundant computations and infinite loops by preventing\n    # re-visiting states that have already been explored.\n    # A state is uniquely identified by its grid configuration (as bytes),\n    # inventory content (as a tuple), agent's position (as a tuple), and direction (as an int).\n    visited = set()\n\n    def get_state_key(state: 'CraftState'):\n        \"\"\"\n        Generates a hashable key for a CraftState object.\n        This key is used to store and look up states in the 'visited' set.\n        The grid's byte representation is included because 'USE' actions can modify the grid.\n        \"\"\"\n        return (state.grid.tobytes(), tuple(state.inventory), state.pos, state.dir)\n\n    # Add the initial state to the visited set.\n    initial_key = get_state_key(initial_state)\n    visited.add(initial_key)\n\n    # Set a maximum search depth to limit computational resources.\n    # The 'max_steps' parameter of the CraftLab environment is a suitable limit.\n    max_search_depth = env.max_steps\n\n    # Check if the goal item is already present in the initial inventory.\n    # If so, no actions are needed.\n    if initial_state.satisfies(goal_name=None, goal_arg=item):\n        return []\n\n    # BFS loop\n    while q:\n        current_state, current_path = q.popleft()\n\n        # Pruning: If the current path length exceeds the maximum allowed steps,\n        # stop exploring this path to prevent excessively long solutions and manage complexity.\n        if len(current_path) >= max_search_depth:\n            continue\n\n        # Explore all possible actions from the current state.\n        for action in ACTIONS:\n            # Apply the action to get the next state.\n            # CraftState.step returns (reward, new_state). The reward from CraftState.step\n            # is always 0.0, so we only need the new_state for the search.\n            _, next_state = current_state.step(action)\n\n            # Generate the unique key for the next state.\n            next_key = get_state_key(next_state)\n\n            # If this state has not been visited before, add it to the queue and visited set.\n            if next_key not in visited:\n                visited.add(next_key)\n                new_path = current_path + [action]\n\n                # Check if the goal is satisfied in this new state.\n                # If satisfied, we have found the shortest path to the goal.\n                if next_state.satisfies(goal_name=None, goal_arg=item):\n                    return new_path\n                \n                # If goal not yet satisfied, add the new state to the queue for further exploration.\n                q.append((next_state, new_path))\n\n    # If the queue becomes empty and the goal was not found, it means\n    # the item cannot be crafted or reached within the specified maximum search depth.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:50:24.458616", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops\n  # in cases where the goal might be unreachable or require too many steps.\n  # This is a heuristic value; adjust based on expected plan complexity.\n  MAX_SEARCH_DEPTH = 100 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T21:50:25.406770", "function_name": "craft", "function_body": "  import collections\n\n  # Define action constants\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Helper for pathfinding to a cell that contains a specific kind (for grabbable items)\n  def _bfs_path_to_cell_with_kind(start_pos, current_grid, target_kind_idx, world_ref):\n      q = collections.deque([(start_pos, [])])\n      visited = {start_pos}\n      width, height = world_ref.WIDTH, world_ref.HEIGHT\n      # (dx, dy, action) for moving to neighbor cells\n      moves = [(0, -1, UP), (0, 1, DOWN), (-1, 0, LEFT), (1, 0, RIGHT)]\n\n      while q:\n          (x, y), path = q.popleft()\n\n          # Check if the current cell contains the target kind\n          if current_grid[x, y, target_kind_idx] > 0:\n              return path # Path of actions to reach this cell\n          \n          for dx, dy, action in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [action]))\n      return None # No path found\n\n  # Helper for pathfinding to a cell that is ADJACENT to a specific kind (for workshops/environment interactions)\n  def _bfs_path_to_adjacent_kind(start_pos, current_grid, target_kind_indices, world_ref):\n      q = collections.deque([(start_pos, [])])\n      visited = {start_pos}\n      width, height = world_ref.WIDTH, world_ref.HEIGHT\n      # (dx, dy, action) for exploring agent moves\n      moves = [(0, -1, UP), (0, 1, DOWN), (-1, 0, LEFT), (1, 0, RIGHT)]\n      \n      # Check if current position is already adjacent to any target kind (no movement needed)\n      for target_idx in target_kind_indices:\n          for dx_adj, dy_adj, _ in moves: # Neighbors of start_pos\n              nx_adj, ny_adj = start_pos[0] + dx_adj, start_pos[1] + dy_adj\n              if 0 <= nx_adj < width and 0 <= ny_adj < height:\n                  if current_grid[nx_adj, ny_adj, target_idx] > 0:\n                      return [] # Already adjacent\n\n      while q:\n          (x, y), path = q.popleft()\n\n          # Check if moving to (x,y) makes the agent adjacent to any target kind\n          is_adjacent = False\n          for dx_adj, dy_adj, _ in moves: # Neighbors of (x,y)\n              nx_adj, ny_adj = x + dx_adj, y + dy_adj\n              if 0 <= nx_adj < width and 0 <= ny_adj < height:\n                  for target_idx in target_kind_indices:\n                      if current_grid[nx_adj, ny_adj, target_idx] > 0:\n                          is_adjacent = True\n                          break\n              if is_adjacent: break\n          if is_adjacent:\n              return path # Path of actions to reach cell (x,y), which is adjacent to a target\n          \n          # Explore neighbors for pathfinding\n          for dx, dy, action in moves:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [action]))\n      return None # No path found\n\n  # Get initial state from the environment\n  current_craft_state = env._current_state\n  world = env.world # This is the CraftWorld instance\n  cookbook = world.cookbook\n\n  # List to accumulate all actions\n  all_actions_sequence = []\n\n  # Recursive helper function to gather ingredients or craft items\n  # Returns the updated CraftState if successful, None otherwise.\n  def _gather_or_craft_recursive(target_item_idx, current_state):\n      nonlocal all_actions_sequence # To modify the outer list of actions\n      \n      # Base case: if we already have the item in inventory, we're done with this item\n      if current_state.inventory[target_item_idx] > 0:\n          return current_state \n\n      # Check if the target item is a primitive resource\n      if target_item_idx in cookbook.primitives:\n          # Primitives are picked up from the grid using USE action\n          \n          # Pathfind to the cell containing the primitive\n          path_to_item_cell = _bfs_path_to_cell_with_kind(\n              current_state.pos, current_state.grid, target_item_idx, world)\n          \n          if path_to_item_cell is None:\n              return None # Cannot reach the primitive\n          \n          # Execute movement actions\n          temp_state = current_state\n          for action in path_to_item_cell:\n              _, temp_state = temp_state.step(action)\n              all_actions_sequence.append(action)\n          \n          # After moving, the agent should be on the primitive's cell. Use USE to pick it up.\n          _, new_state = temp_state.step(USE)\n          all_actions_sequence.append(USE)\n          \n          # Return new state if item was successfully picked up, else None\n          return new_state if new_state.inventory[target_item_idx] > 0 else None\n\n      # If not a primitive, it must be a craftable item with a recipe\n      if target_item_idx not in cookbook.recipes:\n          return None # No recipe found for this item, cannot craft\n\n      recipe = cookbook.recipes[target_item_idx]\n      \n      # Step 1: Gather all required ingredients recursively\n      temp_state = current_state # Use a mutable state reference for this branch\n      for ingredient_idx_or_key, count in recipe.items():\n          if ingredient_idx_or_key.startswith(\"_\"): # Skip special recipe keys like \"_workshop\"\n              continue\n              \n          ingredient_idx = int(ingredient_idx_or_key)\n          \n          # Determine how many of this ingredient are still needed\n          needed_count = count - temp_state.inventory[ingredient_idx]\n          \n          for _ in range(needed_count):\n              # Recursively try to get each needed instance of the ingredient\n              updated_state_after_ingredient = _gather_or_craft_recursive(ingredient_idx, temp_state)\n              if updated_state_after_ingredient is None:\n                  return None # Failed to get an ingredient, so cannot craft target item\n              temp_state = updated_state_after_ingredient # Update the working state\n\n      # Step 2: Handle workshop/environment requirements if specified in the recipe\n      required_workshop_keys = []\n      if \"_workshop\" in recipe: required_workshop_keys.append(\"_workshop\")\n      if \"_water\" in recipe: required_workshop_keys.append(\"_water\")\n      if \"_stone\" in recipe: required_workshop_keys.append(\"_stone\")\n      # Extend with other special keys if they appear in recipes\n\n      if required_workshop_keys:\n          # Map string keys to their corresponding integer indices (or list of indices)\n          target_kind_indices_for_workshop = []\n          for key in required_workshop_keys:\n              if key == \"_workshop\":\n                  target_kind_indices_for_workshop.extend(world.workshop_indices)\n              elif key == \"_water\":\n                  target_kind_indices_for_workshop.append(world.water_index)\n              elif key == \"_stone\":\n                  target_kind_indices_for_workshop.append(world.stone_index)\n          \n          if not target_kind_indices_for_workshop:\n              return None # Should not happen if parsing keys correctly\n\n          # Pathfind to a cell adjacent to the required crafting location\n          path_to_adjacent_workshop = _bfs_path_to_adjacent_kind(\n              temp_state.pos, temp_state.grid, target_kind_indices_for_workshop, world)\n          \n          if path_to_adjacent_workshop is None:\n              return None # Cannot reach the required crafting location\n\n          # Execute movement actions to get adjacent to the workshop\n          for action in path_to_adjacent_workshop:\n              _, temp_state = temp_state.step(action)\n              all_actions_sequence.append(action)\n          \n          # Now agent is adjacent to the crafting location. Perform USE action to craft.\n          _, new_state = temp_state.step(USE)\n          all_actions_sequence.append(USE)\n          \n          # Return new state if item was successfully crafted, else None\n          return new_state if new_state.inventory[target_item_idx] > 0 else None\n      else:\n          # No specific workshop key. Assume crafting is immediate if ingredients are met\n          # or a generic USE action is sufficient. Perform USE action.\n          _, new_state = temp_state.step(USE)\n          all_actions_sequence.append(USE)\n          # Return new state if item was successfully crafted, else None\n          return new_state if new_state.inventory[target_item_idx] > 0 else None\n\n  # Start the recursive crafting process from the initial state\n  final_state_after_crafting = _gather_or_craft_recursive(item, current_craft_state)\n\n  # Check if the target item was successfully crafted and is in the inventory\n  if final_state_after_crafting and final_state_after_crafting.inventory[item] > 0:\n      return all_actions_sequence\n  else:\n      return [] # Return empty list if crafting failed", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:52:03.175555", "function_name": "craft", "function_body": "  # Action constants (internal to this function for scope)\n  _ACTION_DOWN = 0\n  _ACTION_UP = 1\n  _ACTION_LEFT = 2\n  _ACTION_RIGHT = 3\n  _ACTION_USE = 4\n  _ALL_ACTIONS = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT, _ACTION_USE]\n\n  def _get_craft_state_key(craft_state):\n      \"\"\"\n      Generates a hashable key for a CraftState.\n      This key is used to represent a unique state in the BFS 'visited' set.\n      It combines the grid, agent position, direction, and inventory.\n      \"\"\"\n      # Convert numpy arrays (grid, inventory) to bytes for hashing.\n      # This captures the full state of the grid and inventory.\n      # Note: For very large grids, .tobytes() can be memory intensive,\n      # leading to a large 'visited' set and potential MemoryError.\n      grid_bytes = craft_state.grid.tobytes()\n      inventory_bytes = craft_state.inventory.tobytes()\n      return (grid_bytes, craft_state.pos, craft_state.dir, inventory_bytes)\n\n  # 1. Get the initial state of the environment for planning.\n  # We reset the environment to a known initial configuration.\n  # Using a fixed seed for reset here for deterministic planning, can be made configurable.\n  env.reset(seed=0)\n  initial_state = env._current_state # Access the current CraftState from the CraftLab instance\n\n  # Check if the item is already present in the initial inventory\n  if initial_state.satisfies(None, item):\n      return []\n\n  # 2. Initialize Breadth-First Search (BFS) data structures.\n  # `queue`: Stores tuples of (current_CraftState, list_of_actions_taken_to_reach_this_state).\n  # We use a deque for efficient popleft operations.\n  queue = collections.deque([(initial_state, [])])\n\n  # `visited`: Stores hashable keys of CraftState objects that have already been\n  # added to the queue, to prevent cycles and redundant exploration.\n  visited = {_get_craft_state_key(initial_state)}\n\n  # Optional: Set a maximum search depth to prevent excessively long searches\n  # and to bound computation time. This heuristic is based on the episode limit.\n  max_search_depth = env.max_steps * 2 # Allows for more planning steps than typical episode steps\n\n  # 3. BFS Loop: Explore states layer by layer\n  while queue:\n    current_state, actions_so_far = queue.popleft()\n\n    # Pruning: If the current path is too long, discard this branch.\n    # This helps manage computation time and memory for very deep searches.\n    if len(actions_so_far) >= max_search_depth:\n        continue # Skip this path, it's too long\n\n    # Generate all possible next states by applying each action\n    for action in _ALL_ACTIONS:\n      # Apply the action to the current state to get the next state.\n      # CraftState.step returns a new CraftState object, preserving the current_state.\n      reward, next_state = current_state.step(action)\n      next_actions = actions_so_far + [action] # Append the current action to the path\n\n      # Generate a unique key for the next state to check if it has been visited\n      next_state_key = _get_craft_state_key(next_state)\n\n      # If the next state has not been visited yet, process it\n      if next_state_key not in visited:\n        visited.add(next_state_key) # Mark as visited\n\n        # Check if the goal (item crafted) is satisfied in the new state\n        if next_state.satisfies(None, item):\n          return next_actions # Goal reached! Return the sequence of actions\n\n        # If not the goal, add the new state to the queue for further exploration\n        queue.append((next_state, next_actions))\n\n  # If the queue becomes empty and the goal was not found, it means no path\n  # exists within the explored search space (or within max_search_depth).\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-29T21:52:04.174378", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Get action mapping from the environment\n  action_map = env.action_specs()\n  DOWN = action_map['DOWN']\n  UP = action_map['UP']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  class CraftPlanner:\n      def __init__(self, env_instance):\n          self.env = env_instance\n          self.cookbook = env_instance.world.cookbook\n          self.world = env_instance.world\n          \n          # Action constants are local to the function, so pass them or access outer scope\n          self._DOWN = DOWN\n          self._UP = UP\n          self._LEFT = LEFT\n          self._RIGHT = RIGHT\n          self._USE = USE\n\n      def _find_path_to_kind(self, target_kind_idx):\n          \"\"\"\n          Finds a path (list of actions) to be adjacent to a cell containing target_kind_idx.\n          Starts search from the current state of `self.env`.\n          \n          Args:\n              target_kind_idx: The integer index of the kind to find.\n          Returns:\n              A list of actions (integers) or None if no path.\n          \"\"\"\n          initial_craft_state = self.env._current_state\n          \n          q = collections.deque([(initial_craft_state, [])])\n          visited = set([(initial_craft_state.pos, initial_craft_state.dir)])\n\n          MAX_PATH_STEPS = 500 \n\n          while q:\n              current_state, path_actions = q.popleft()\n\n              if current_state.next_to(target_kind_idx):\n                  return path_actions \n              \n              if len(path_actions) >= MAX_PATH_STEPS:\n                  continue\n\n              for action in [self._UP, self._DOWN, self._LEFT, self._RIGHT]:\n                  _, next_state = current_state.step(action)\n\n                  # Check if the agent actually moved or just hit an obstacle\n                  if (next_state.pos, next_state.dir) == (current_state.pos, current_state.dir):\n                      continue\n\n                  state_key = (next_state.pos, next_state.dir)\n                  if state_key not in visited:\n                      visited.add(state_key)\n                      q.append((next_state, path_actions + [action]))\n          \n          return None \n\n      def _execute_plan_on_env(self, actions_to_execute):\n          \"\"\"\n          Executes a sequence of actions on the *actual* environment.\n          Updates self.env._current_state.\n          \"\"\"\n          for action in actions_to_execute:\n              # We don't need reward/done/obs for planning, just state transition.\n              _, _, _ = self.env.step(action) \n\n      def plan_and_execute_item(self, item_idx):\n          \"\"\"\n          Recursively plans actions to craft an item and executes them on the environment.\n          \n          Args:\n              item_idx: The integer index of the item to craft.\n          Returns:\n              A list of actions (integers) that were executed to craft the item,\n              or None if crafting failed.\n          \"\"\"\n          all_actions = []\n\n          # Base case: item is already in inventory\n          if self.env._current_state.inventory[item_idx] > 0:\n              return [] \n\n          # Case 1: Item is a primitive (can be picked up directly)\n          if item_idx in self.cookbook.primitives:\n              path_to_primitive = self._find_path_to_kind(item_idx)\n              if path_to_primitive is None:\n                  return None \n              \n              self._execute_plan_on_env(path_to_primitive)\n              all_actions.extend(path_to_primitive)\n              \n              # After moving to be next to it, use the item (e.g., pick it up)\n              self._execute_plan_on_env([self._USE])\n              all_actions.append(self._USE)\n              \n              # Verify if item was acquired\n              if self.env._current_state.inventory[item_idx] > 0:\n                  return all_actions\n              else:\n                  return None\n\n          # Case 2: Item is a recipe output (requires ingredients and possibly a workshop)\n          elif item_idx in self.cookbook.recipes:\n              recipe = self.cookbook.recipes[item_idx]\n\n              # First, gather all required ingredients\n              for ingredient_idx_or_key, count in recipe.items():\n                  if ingredient_idx_or_key == \"_key\":\n                      continue # This is the workshop key, not an ingredient\n\n                  needed_count = count - self.env._current_state.inventory[ingredient_idx_or_key]\n                  if needed_count <= 0:\n                      continue # Already have enough of this ingredient\n\n                  for _ in range(needed_count):\n                      # Recursively plan and execute for each needed ingredient\n                      ingredient_actions = self.plan_and_execute_item(ingredient_idx_or_key)\n                      if ingredient_actions is None:\n                          return None # Propagate failure if ingredient cannot be acquired\n                      all_actions.extend(ingredient_actions)\n              \n              # After all ingredients are (hopefully) in inventory, move to workshop and use\n              workshop_kind_idx = None\n              if \"_key\" in recipe:\n                  workshop_name = recipe[\"_key\"]\n                  # Get the integer index for the workshop\n                  workshop_kind_idx = self.cookbook.index[workshop_name]\n              \n              if workshop_kind_idx is not None:\n                  path_to_workshop = self._find_path_to_kind(workshop_kind_idx)\n                  if path_to_workshop is None:\n                      return None # Cannot reach the required workshop\n\n                  self._execute_plan_on_env(path_to_workshop)\n                  all_actions.extend(path_to_workshop)\n                  \n                  # Use the workshop to craft the item\n                  self._execute_plan_on_env([self._USE])\n                  all_actions.append(self._USE)\n\n              # Verify if the target item was crafted after all steps\n              if self.env._current_state.inventory[item_idx] > 0:\n                  return all_actions\n              else:\n                  return None \n          \n          # Case 3: Item is unknown or uncraftable (not a primitive and not in recipes)\n          else:\n              return None \n\n  # Initialize the planner and attempt to craft the item\n  planner = CraftPlanner(env)\n  final_actions = planner.plan_and_execute_item(item)\n  \n  # Return the collected actions, or an empty list if planning failed\n  if final_actions is None:\n      return [] \n  else:\n      return final_actions", "island_id": 5, "scores": {"3": -1}}
