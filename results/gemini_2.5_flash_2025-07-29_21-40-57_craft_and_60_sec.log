{"timestamp": "2025-07-29T22:32:54.799956", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants. These are derived from the `action_specs` description.\n  # Hardcoding them ensures they are available without external imports within the function.\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is crucial for storing visited states in a set to avoid redundant computation and loops.\n  def _hashable_state(craft_state):\n      # numpy arrays (grid, inventory) are not directly hashable.\n      # Convert them to bytes for a compact and hashable representation.\n      grid_bytes = craft_state.grid.tobytes()\n      inventory_bytes = craft_state.inventory.tobytes()\n      # Position (tuple) and direction (int) are already hashable.\n      return (grid_bytes, inventory_bytes, craft_state.pos, craft_state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  q = collections.deque()\n  # Initialize a set to store hashable representations of visited states.\n  visited = set()\n\n  # Get the initial state of the CraftLab environment and an empty path.\n  initial_craft_state = env._current_state\n  initial_actions_path = []\n\n  # Add the initial state to the queue and mark it as visited.\n  q.append((initial_craft_state, initial_actions_path))\n  visited.add(_hashable_state(initial_craft_state))\n\n  # Set a safety limit for the number of visited states.\n  # This prevents the search from running indefinitely on very complex or impossible goals,\n  # or consuming excessive memory.\n  _MAX_VISITED_STATES = 100000\n\n  # Pre-cache relevant indices from the CraftWorld instance for faster lookups.\n  # These are used to determine if the USE action is potentially beneficial.\n  grabbable_indices = env.world.grabbable_indices  # Indices of items that can be picked up.\n  workshop_indices = env.world.workshop_indices    # Indices of workshop locations for crafting.\n\n  # Start the BFS loop\n  while q:\n      current_state, actions_path = q.popleft()\n\n      # Check if the goal is satisfied in the current state's inventory.\n      if current_state.satisfies(None, item):\n          return actions_path # Goal reached, return the sequence of actions.\n\n      # Determine action order dynamically to prioritize more likely productive actions.\n      # This heuristic does not affect optimality (BFS still finds shortest path),\n      # but it can speed up finding the solution by exploring promising branches earlier.\n      actions_to_try = []\n\n      # Check if the agent is next to any workshop or any grabbable item.\n      # If so, the USE action might be productive.\n      is_next_to_potential_use_target = False\n      if any(current_state.next_to(w_idx) for w_idx in workshop_indices):\n          is_next_to_potential_use_target = True\n      elif any(current_state.next_to(g_idx) for g_idx in grabbable_indices):\n          is_next_to_potential_use_target = True\n\n      if is_next_to_potential_use_target:\n          actions_to_try.append(_USE) # Prioritize USE action\n\n      # Add all movement actions (DOWN, UP, LEFT, RIGHT).\n      actions_to_try.extend([_DOWN, _UP, _LEFT, _RIGHT])\n\n      # Ensure the USE action is always considered, even if not prioritized.\n      # This handles cases where its benefit isn't immediately obvious from proximity\n      # or if the initial prioritization logic isn't perfectly exhaustive.\n      if _USE not in actions_to_try:\n          actions_to_try.append(_USE)\n\n      # Explore all possible actions from the current state in the determined order.\n      for action in actions_to_try:\n          # Apply the action to get the next state.\n          # The reward is not used for pathfinding in this BFS.\n          _reward, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_hashable_state = _hashable_state(next_state)\n\n          # If this state has not been visited before, add it to the queue and mark it visited.\n          if next_hashable_state not in visited:\n              visited.add(next_hashable_state)\n              q.append((next_state, actions_path + [action]))\n\n              # Check if the search has exceeded the maximum allowed visited states.\n              if len(visited) > _MAX_VISITED_STATES:\n                  # If the limit is reached, it implies the item is either unreachable,\n                  # or requires an impractically long sequence of actions.\n                  # Return an empty list to indicate failure to find a path within limits.\n                  return []\n\n  # If the queue becomes empty and the goal was never satisfied,\n  # it means no path to craft the item was found from the initial state\n  # within the explored search space.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T22:34:19.024702", "function_name": "craft", "function_body": "    # Helper to make CraftState hashable for visited set\n    # This function creates a unique, hashable tuple representation of the CraftState.\n    # It includes grid, inventory, agent position, and agent direction,\n    # as these are the components that define a unique state for planning.\n    def _get_hashable_state(state):\n        return (\n            state.grid.tobytes(),        # Convert numpy grid array to bytes for hashability\n            state.inventory.tobytes(),   # Convert numpy inventory array to bytes for hashability\n            state.pos,                   # Agent's (row, col) tuple\n            state.dir                    # Agent's integer direction\n        )\n\n    # Use collections.deque for efficient BFS queue operations (popleft, append).\n    # Assuming `collections` module is available in the execution environment.\n    import collections\n\n    # Action constants (assuming these are globally defined as per the DMLab CraftWorld API).\n    # DOWN = 0, UP = 1, LEFT = 2, RIGHT = 3, USE = 4\n\n    # Start the BFS from the current state of the environment.\n    # The `env` object is a CraftLab instance, and its current state is held in `_current_state`.\n    initial_craft_state = env._current_state\n\n    # The queue for BFS stores tuples: (CraftState object, list of actions to reach this state).\n    queue = collections.deque([(initial_craft_state, [])])\n\n    # A set to keep track of visited states to prevent redundant computations and cycles.\n    # States are stored in their hashable representation.\n    visited = set([_get_hashable_state(initial_craft_state)])\n\n    # Define limits for the BFS to prevent excessively long searches or out-of-memory errors.\n    # These values are heuristic and might need tuning based on problem complexity.\n    MAX_SEARCH_DEPTH = 150       # Maximum number of actions in a path to explore\n    MAX_VISITED_STATES = 50000   # Maximum number of unique states to store in 'visited' set\n\n    while queue:\n        current_state, actions_so_far = queue.popleft()\n\n        # Check if the goal item is successfully crafted (present in the inventory).\n        if current_state.inventory[item] > 0:\n            return actions_so_far\n\n        # If the current path is too long, prune it to keep the search manageable.\n        if len(actions_so_far) >= MAX_SEARCH_DEPTH:\n            continue\n\n        # Explore all possible actions (UP, DOWN, LEFT, RIGHT, USE).\n        for action in range(5): \n            # Apply the action to the current state to get the next state.\n            # `current_state.step(action)` returns (reward, new_state). Reward is always 0.0 here.\n            # Importantly, `step` returns a *new* CraftState object, so `current_state` is not mutated.\n            _reward, next_state = current_state.step(action)\n\n            # Check if the action actually resulted in a state change.\n            # `step` might return the same state if the action is invalid (e.g., moving into a wall)\n            # or has no effect (e.g., USE on an empty cell).\n            # We skip such non-effective actions to avoid redundant search paths and infinite loops.\n            if _get_hashable_state(next_state) == _get_hashable_state(current_state):\n                continue\n\n            next_state_hash = _get_hashable_state(next_state)\n\n            # If this next state has not been visited before, add it to the queue and visited set.\n            if next_state_hash not in visited:\n                visited.add(next_state_hash)\n                \n                # Check if the total number of visited states exceeds the memory limit.\n                # If so, we might need to stop the search to avoid crashing.\n                if len(visited) > MAX_VISITED_STATES:\n                    # If the limit is reached, it means either the problem is too complex for BFS\n                    # or the limits are too strict. Returning an empty list indicates no path\n                    # found within the practical search constraints.\n                    return [] \n\n                queue.append((next_state, actions_so_far + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means no path\n    # exists within the defined search depth and state limits.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:34:54.143006", "function_name": "craft", "function_body": "  # Import necessary libraries within the function scope if they aren't globally available\n  # based on the prompt's \"only return code that will fit in that function\" constraint.\n  # In a typical setup, collections and numpy would be imported at the top of the file.\n  import collections\n  import numpy as np\n\n  # Get the mapping of action names to their integer values.\n  # The CraftLab's action_specs method provides this.\n  action_specs = env.action_specs()\n  # Extract the integer values for all possible actions.\n  ACTIONS = list(action_specs.values())\n\n  # Reset the environment to its initial state.\n  # This ensures the search starts from a clean and known configuration.\n  # The `_` is used as a placeholder for the returned observation dictionary,\n  # which we don't directly need here, but the call updates `env._current_state`.\n  _ = env.reset()\n  initial_craft_state = env._current_state\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_to_reach_this_state).\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents infinite loops and redundant computation, ensuring the shortest path is found.\n  # A state needs to be hashable. We'll use a tuple of:\n  # (grid_as_bytes, inventory_as_bytes, agent_position_tuple, agent_direction_integer).\n  visited = set()\n\n  # Add the initial state to the visited set.\n  initial_grid_bytes = initial_craft_state.grid.tobytes()\n  initial_inventory_bytes = initial_craft_state.inventory.tobytes()\n  initial_hashable_state = (initial_grid_bytes, initial_inventory_bytes,\n                            initial_craft_state.pos, initial_craft_state.dir)\n  visited.add(initial_hashable_state)\n\n  # Define a maximum search depth. This is a heuristic to prevent the search\n  # from running indefinitely in very complex or unsolvable scenarios.\n  # Crafting usually involves a limited sequence of movements, pickups, and uses.\n  MAX_SEARCH_DEPTH = 100 # This value might need tuning based on recipe complexity\n\n  # Start the BFS loop\n  while queue:\n    current_state, actions_taken = queue.popleft()\n\n    # Check if the current state satisfies the goal (i.e., the item is in the inventory).\n    # CraftState.satisfies expects a goal_name (ignored here) and goal_arg (the item index).\n    if current_state.satisfies(None, item):\n      return actions_taken\n\n    # If the current path exceeds the maximum allowed depth, prune it.\n    if len(actions_taken) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action_value in ACTIONS:\n      # Simulate the action. CraftState.step returns a new CraftState object,\n      # which is crucial for BFS as it allows exploring parallel paths.\n      # The reward is not used for pathfinding in this context.\n      _, next_state = current_state.step(action_value)\n\n      # Create a hashable representation of the next state.\n      next_grid_bytes = next_state.grid.tobytes()\n      next_inventory_bytes = next_state.inventory.tobytes()\n      next_hashable_state = (next_grid_bytes, next_inventory_bytes,\n                             next_state.pos, next_state.dir)\n\n      # If this next state has not been visited before, add it to the visited set\n      # and enqueue it for further exploration.\n      if next_hashable_state not in visited:\n        visited.add(next_hashable_state)\n        queue.append((next_state, actions_taken + [action_value]))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted or reached within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:35:55.328167", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Get the mapping of action names to their integer values.\n  action_specs = env.action_specs()\n  # Extract the integer values for all possible actions.\n  ACTIONS = list(action_specs.values())\n  # Get the specific integer value for the 'USE' action, as it's often the one that requires specific conditions.\n  USE_ACTION = action_specs['USE']\n\n  # Reset the environment to its initial state.\n  _ = env.reset()\n  initial_craft_state = env._current_state\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # A state needs to be hashable. We use a tuple of (grid_as_bytes, inventory_as_bytes, pos, dir).\n  visited = set()\n\n  # Add the initial state to the visited set.\n  initial_grid_bytes = initial_craft_state.grid.tobytes()\n  initial_inventory_bytes = initial_craft_state.inventory.tobytes()\n  initial_hashable_state = (initial_grid_bytes, initial_inventory_bytes,\n                            initial_craft_state.pos, initial_craft_state.dir)\n  visited.add(initial_hashable_state)\n\n  # Define a maximum search depth to prevent excessively long searches.\n  MAX_SEARCH_DEPTH = 100 \n\n  # Get references to cookbook data for smarter action prioritization\n  cookbook = env.world.cookbook\n  workshop_indices = env.world.workshop_indices\n  primitives = cookbook.primitives # Set of indices for primitive items\n\n  # Start the BFS loop\n  while queue:\n    current_state, actions_taken = queue.popleft()\n\n    # Check if the current state satisfies the goal.\n    if current_state.satisfies(None, item):\n      return actions_taken\n\n    # If the current path exceeds the maximum allowed depth, prune it.\n    if len(actions_taken) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Determine the order of actions to explore. This is the \"improvement\":\n    # Prioritize the 'USE' action if it's potentially beneficial given the goal.\n    actions_to_consider = []\n    use_action_is_beneficial = False\n    \n    # Case 1: The goal 'item' is a primitive (can be picked up).\n    # Check if the agent is next to the primitive item.\n    if item in primitives:\n        if current_state.next_to(item):\n            use_action_is_beneficial = True\n    # Case 2: The goal 'item' is a crafted item (has a recipe).\n    # Check if the agent has all required ingredients in inventory AND is next to a workshop.\n    elif item in cookbook.recipes:\n        recipe = cookbook.recipes[item]\n        has_all_ingredients = True\n        for ingredient_idx, count in recipe.items():\n            # Skip special keys like \"_key\" that denote workshop location, not an ingredient.\n            if isinstance(ingredient_idx, str) and ingredient_idx.startswith(\"_\"):\n                continue \n            if current_state.inventory[ingredient_idx] < count:\n                has_all_ingredients = False\n                break\n        \n        is_next_to_workshop = False\n        for workshop_idx in workshop_indices:\n            if current_state.next_to(workshop_idx):\n                is_next_to_workshop = True\n                break\n        \n        if has_all_ingredients and is_next_to_workshop:\n            use_action_is_beneficial = True\n    \n    # If the 'USE' action seems beneficial, add it first to the list of actions to explore.\n    if use_action_is_beneficial:\n        actions_to_consider.append(USE_ACTION)\n    \n    # Add all other movement actions (DOWN, UP, LEFT, RIGHT).\n    # Ensure the USE_ACTION is not added again if it was already prioritized.\n    actions_to_consider.extend([a for a in ACTIONS if a != USE_ACTION])\n\n    # Explore all possible actions from the current state in the prioritized order.\n    for action_value in actions_to_consider:\n      # Simulate the action to get the next state.\n      _, next_state = current_state.step(action_value)\n\n      # Create a hashable representation of the next state for the visited set.\n      next_grid_bytes = next_state.grid.tobytes()\n      next_inventory_bytes = next_state.inventory.tobytes()\n      next_hashable_state = (next_grid_bytes, next_inventory_bytes,\n                             next_state.pos, next_state.dir)\n\n      # If this next state has not been visited before, add it to the visited set\n      # and enqueue it for further exploration.\n      if next_hashable_state not in visited:\n        visited.add(next_hashable_state)\n        queue.append((next_state, actions_taken + [action_value]))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted or reached within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T22:36:31.202983", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Get the mapping of action names to their integer values.\n  # The CraftLab's action_specs method provides this.\n  action_specs = env.action_specs()\n  # Extract the integer values for all possible actions.\n  ACTIONS = list(action_specs.values())\n\n  # Reset the environment to its initial state.\n  # This ensures the search starts from a clean and known configuration.\n  # The `_` is used as a placeholder for the returned observation dictionary,\n  # which we don't directly need here, but the call updates `env._current_state`.\n  _ = env.reset()\n  initial_craft_state = env._current_state\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_to_reach_this_state).\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents infinite loops and redundant computation, ensuring the shortest path is found.\n  # A state needs to be hashable. We'll use a tuple of:\n  # (grid_as_bytes, inventory_as_bytes, agent_position_tuple, agent_direction_integer).\n  visited = set()\n\n  # Add the initial state to the visited set.\n  initial_grid_bytes = initial_craft_state.grid.tobytes()\n  initial_inventory_bytes = initial_craft_state.inventory.tobytes()\n  initial_hashable_state = (initial_grid_bytes, initial_inventory_bytes,\n                            initial_craft_state.pos, initial_craft_state.dir)\n  visited.add(initial_hashable_state)\n\n  # Define the maximum search depth based on the environment's max_steps.\n  # This ensures that generated plans are executable within the environment's limits,\n  # aligning the planning horizon with the environment's episode length.\n  # CraftLab's constructor ensures max_steps is an int.\n  MAX_SEARCH_DEPTH = env.max_steps\n\n  # Start the BFS loop\n  while queue:\n    current_state, actions_taken = queue.popleft()\n\n    # Check if the current state satisfies the goal (i.e., the item is in the inventory).\n    # CraftState.satisfies expects a goal_name (ignored here) and goal_arg (the item index).\n    if current_state.satisfies(None, item):\n      return actions_taken\n\n    # If the current path has reached or exceeded the maximum allowed depth, prune it.\n    # We prune *before* exploring actions from this state to prevent overly long paths.\n    if len(actions_taken) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action_value in ACTIONS:\n      # Simulate the action. CraftState.step returns a new CraftState object,\n      # which is crucial for BFS as it allows exploring parallel paths.\n      # The reward is not used for pathfinding in this context.\n      _, next_state = current_state.step(action_value)\n\n      # Create a hashable representation of the next state.\n      next_grid_bytes = next_state.grid.tobytes()\n      next_inventory_bytes = next_state.inventory.tobytes()\n      next_hashable_state = (next_grid_bytes, next_inventory_bytes,\n                             next_state.pos, next_state.dir)\n\n      # If this next state has not been visited before, add it to the visited set\n      # and enqueue it for further exploration.\n      if next_hashable_state not in visited:\n        visited.add(next_hashable_state)\n        queue.append((next_state, actions_taken + [action_value]))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted or reached within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:38:10.109412", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  # As per the hint in craft_v0's docstring, for v2 we prioritize the 'USE' action\n  # universally to encourage immediate crafting or resource gathering, potentially\n  # finding a solution faster by exploring key state changes earlier.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS_PRIORITIZED = [USE, DOWN, UP, LEFT, RIGHT] # Fixed prioritization: USE first\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops.\n  # Increased from v1 to allow for potentially longer but still reasonable paths,\n  # especially with the aggressive 'USE' prioritization.\n  MAX_SEARCH_DEPTH = 200 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # Explore all possible actions from the current state, using the fixed prioritized order.\n      # This aggressive 'USE' prioritization is the key improvement for v2 as per instructions.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:38:53.972948", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      # Combine grid (as bytes), position, direction, and inventory (as tuple)\n      # to create a unique, hashable representation of the state.\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops\n  # in cases where the goal might be unreachable or require too many steps.\n  # Increased MAX_SEARCH_DEPTH from v1 (100) to allow for longer crafting chains\n  # that might involve more movement or intermediate steps.\n  MAX_SEARCH_DEPTH = 250 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # --- Action Prioritization Logic (similar to v1, as it's a good heuristic) ---\n      # This heuristic aims to explore paths that involve immediate gathering or crafting\n      # before extensive movement, potentially finding solutions faster.\n      actions_to_explore = []\n      \n      # Check if the agent is next to any workshop or grabbable item.\n      # `env.world.workshop_indices` and `env.world.grabbable_indices` provide these lists.\n      is_next_to_useful_entity = False\n      for workshop_idx in env.world.workshop_indices:\n          if current_state.next_to(workshop_idx):\n              is_next_to_useful_entity = True\n              break\n      if not is_next_to_useful_entity: # Only check grabbables if not already next to a workshop\n          for grabbable_idx in env.world.grabbable_indices:\n              if current_state.next_to(grabbable_idx):\n                  is_next_to_useful_entity = True\n                  break\n\n      if is_next_to_useful_entity:\n          # If USE is potentially beneficial, try it first.\n          actions_to_explore.append(USE)\n          # Then add other actions (movement).\n          actions_to_explore.extend([a for a in ALL_ACTIONS if a != USE])\n      else:\n          # Otherwise, prioritize movement actions, then try USE.\n          # This helps in exploring paths to reach useful entities first.\n          actions_to_explore.extend([a for a in ALL_ACTIONS if a != USE])\n          actions_to_explore.append(USE)\n\n      # Explore all possible actions from the current state in the determined order.\n      for action in actions_to_explore:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:40:15.707449", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops.\n  # Retain MAX_SEARCH_DEPTH from v1.\n  MAX_SEARCH_DEPTH = 200 \n\n  # Cache cookbook reference as it's static and frequently accessed.\n  cookbook = env.world.cookbook\n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # --- Intelligent Action Prioritization for v2 ---\n      # This version attempts to be more strategic about when to prioritize 'USE' action:\n      # 1. Highest priority if 'USE' can directly result in the goal item (either by gathering\n      #    a primitive or crafting a complex item with all ingredients ready).\n      # 2. Second highest priority if 'USE' can collect any general grabbable or craft\n      #    any item for which a recipe exists and ingredients are available (intermediate steps).\n      # 3. Otherwise, prioritize movement to explore the grid.\n\n      actions_to_explore = []\n      is_use_highly_prioritized_for_goal = False\n\n      # Check if 'USE' can directly achieve the goal item\n      # Case A: Goal is a primitive and agent is next to it\n      if item in cookbook.primitives:\n          if current_state.next_to(item):\n              is_use_highly_prioritized_for_goal = True\n      # Case B: Goal is a crafted item, all ingredients are in inventory, AND agent is next to a workshop\n      elif item in cookbook.recipes:\n          recipe = cookbook.recipes[item]\n          can_craft_goal_now = True\n          for ingredient_idx, count in recipe.items():\n              if ingredient_idx == \"_key\": # Skip special key in recipe definition\n                  continue\n              if current_state.inventory[ingredient_idx] < count:\n                  can_craft_goal_now = False\n                  break\n          \n          if can_craft_goal_now:\n              # Check if agent is next to any workshop\n              for workshop_idx in current_state.world.workshop_indices:\n                  if current_state.next_to(workshop_idx):\n                      is_use_highly_prioritized_for_goal = True\n                      break\n      \n      # Construct the action order based on the determined priority\n      if is_use_highly_prioritized_for_goal:\n          # If USE can directly help with the goal, try it first\n          actions_to_explore.append(USE)\n          actions_to_explore.extend([a for a in ALL_ACTIONS if a != USE]) # Then movement actions\n      else:\n          # If USE doesn't directly achieve the goal *at this moment*,\n          # check if it's generally useful (i.e., collecting any grabbable or crafting any intermediate).\n          is_next_to_any_useful_entity = False\n          for workshop_idx in current_state.world.workshop_indices:\n              if current_state.next_to(workshop_idx):\n                  is_next_to_any_useful_entity = True\n                  break\n          if not is_next_to_any_useful_entity: # Only check grabbables if not already next to a workshop\n              for grabbable_idx in current_state.world.grabbable_indices:\n                  if current_state.next_to(grabbable_idx):\n                      is_next_to_any_useful_entity = True\n                      break\n          \n          if is_next_to_any_useful_entity:\n              # If next to some general useful entity (grabbable or workshop), prioritize USE\n              actions_to_explore.append(USE)\n              actions_to_explore.extend([a for a in ALL_ACTIONS if a != USE])\n          else:\n              # Otherwise, prioritize movement to find useful entities, then try USE\n              actions_to_explore.extend([a for a in ALL_ACTIONS if a != USE])\n              actions_to_explore.append(USE)\n\n      # Explore all possible actions from the current state in the determined order.\n      for action in actions_to_explore:\n          # Apply the action. CraftState.step returns a new CraftState object.\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": -1}}
