rrent_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # Explore all possible actions from the current state, using the prioritized order.\n      # The fixed 'USE' prioritization is maintained as a consistent strategy across versions.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:43:11.513836", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants. These correspond to the action mapping in CraftLab.action_specs().\n  # The prioritization of 'USE' first is maintained from v1. This aggressive\n  # strategy aims to complete crafting or gathering actions as soon as they\n  # are available, which has proven effective in finding solutions faster\n  # in a crafting context, even if not strictly optimal for all scenarios\n  # in terms of pure step count (though BFS guarantees shortest path overall).\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS_PRIORITIZED = [USE, DOWN, UP, LEFT, RIGHT]\n\n  # Get the initial CraftState from the CraftLab environment.\n  initial_state = env._current_state\n  initial_actions = [] # No actions taken to reach the initial state.\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue stores: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable, so convert them to bytes/tuples for hashing.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Increase the maximum search depth from v1 (300) to allow for even more\n  # complex or longer crafting sequences. This is a common incremental\n  # improvement when previous versions hit depth limits.\n  MAX_SEARCH_DEPTH = 500 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal.\n      if current_state.satisfies(None, item):\n          return current_actions # Goal achieved, return the sequence of actions.\n\n      # Pruning: If the current action sequence exceeds the maximum allowed depth,\n      # abandon this path to control computation time and memory usage.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue.\n\n      # Explore all possible actions from the current state, using the prioritized order.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Apply the action to get the next state. CraftState.step handles game logic.\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue is exhausted and the goal was not found within the depth limit,\n  # return an empty list, indicating the item cannot be crafted (or path too long).\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:44:07.461376", "function_name": "craft", "function_body": "    # Constants for actions\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n    _ACTIONS = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT, _ACTION_USE]\n\n    class _SearchState:\n        \"\"\"Helper class to encapsulate the state for BFS.\n        Nested to comply with 'only return code that will fit in that function'.\"\"\"\n        def __init__(self, craft_state, path_actions):\n            self.craft_state = craft_state\n            self.path_actions = path_actions\n\n        def __hash__(self):\n            # Create a hashable representation of the craft_state\n            # Use .tobytes() for numpy arrays for hashing\n            # Ensure that pos is a tuple and dir is an int\n            return hash((self.craft_state.grid.tobytes(),\n                         self.craft_state.inventory.tobytes(),\n                         self.craft_state.pos,\n                         self.craft_state.dir))\n\n        def __eq__(self, other):\n            if not isinstance(other, _SearchState):\n                return NotImplemented\n            # Compare components for equality using np.array_equal for numpy arrays\n            return (np.array_equal(self.craft_state.grid, other.craft_state.grid) and\n                    np.array_equal(self.craft_state.inventory, other.craft_state.inventory) and\n                    self.craft_state.pos == other.craft_state.pos and\n                    self.craft_state.dir == other.craft_state.dir)\n\n    # The 'env' object is a CraftLab instance.\n    # Its current internal CraftState is accessible via _current_state.\n    initial_craft_state = env._current_state\n\n    # Check if the goal is already satisfied at the start\n    if initial_craft_state.satisfies(None, item):\n        return [] # Goal already achieved, no actions needed\n\n    # Initialize the queue for BFS (using a list due to \"Do not imports\" constraint for collections.deque)\n    queue = [] \n    # Initialize a set to keep track of visited states to avoid cycles and redundant computations\n    visited = set()\n\n    # Create the initial search state\n    initial_search_state = _SearchState(initial_craft_state, [])\n    queue.append(initial_search_state)\n    visited.add(initial_search_state)\n\n    # Safety limit for search steps to prevent excessively long computations in complex scenarios\n    max_search_steps = 10000 \n    states_processed = 0 \n\n    while queue:\n        # Dequeue the current state (simulating deque.popleft() with list.pop(0))\n        current_search_state = queue.pop(0)\n        current_craft_state = current_search_state.craft_state\n        current_path = current_search_state.path_actions\n\n        # If the goal is met, return the sequence of actions that led to this state\n        if current_craft_state.satisfies(None, item):\n            return current_path\n\n        # Check if the maximum number of search steps has been reached\n        if states_processed >= max_search_steps:\n            # print(f\"Warning: Max search steps ({max_search_steps}) reached without finding a path.\")\n            return [] # No path found within the defined limits\n\n        states_processed += 1\n\n        # Explore all possible next actions from the current state\n        for action in _ACTIONS:\n            # CraftState.step returns (reward, new_state) where new_state is a new CraftState object\n            _reward, next_craft_state = current_craft_state.step(action)\n\n            # Create a new search state for the next step\n            next_search_state = _SearchState(next_craft_state, current_path + [action])\n\n            # If this new state has not been visited before, add it to the queue and mark as visited\n            if next_search_state not in visited:\n                visited.add(next_search_state)\n                queue.append(next_search_state)\n\n    # If the queue becomes empty and the goal was never reached, it means no path exists\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:44:43.437923", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  class BFSNode:\n    \"\"\"Helper class to store a state and the actions taken to reach it.\"\"\"\n    def __init__(self, state, actions):\n      self.state = state\n      self.actions = actions\n\n    def get_key(self):\n      \"\"\"Returns a hashable representation of the current state for the visited set.\"\"\"\n      # Use .tobytes() for numpy arrays for efficient and consistent hashing\n      return (self.state.grid.tobytes(), self.state.inventory.tobytes(), self.state.pos, self.state.dir)\n\n  # Get the initial state from the CraftLab environment\n  initial_state = env._current_state\n\n  # Initialize BFS queue and visited set\n  q = deque()\n  start_node = BFSNode(initial_state, [])\n  q.append(start_node)\n\n  visited = set()\n  visited.add(start_node.get_key())\n\n  while q:\n    current_node = q.popleft()\n    current_state = current_node.state\n    current_actions = current_node.actions\n\n    # Check if the goal is satisfied in the current state\n    # The goal is to have at least one of the 'item' in inventory\n    if current_state.inventory[item] > 0:\n      return current_actions\n\n    # Explore all possible actions from the current state\n    # Actions include movement (UP, DOWN, LEFT, RIGHT) and interaction (USE)\n    for action in [UP, DOWN, LEFT, RIGHT, USE]:\n      # Simulate the action to get the next state.\n      # CraftState.step returns a new state object, which is essential for BFS\n      # to explore different paths without modifying the original environment state.\n      _, next_state = current_state.step(action)\n      next_actions = current_actions + [action]\n\n      next_node = BFSNode(next_state, next_actions)\n      next_key = next_node.get_key()\n\n      # If this state has not been visited before, add it to the queue\n      if next_key not in visited:\n        visited.add(next_key)\n        q.append(next_node)\n\n  # If the queue becomes empty and the goal was not reached, it means the item\n  # cannot be crafted from the initial state, or the search space is too large\n  # to find a path within reasonable computational limits.\n  return []", "island_id": 7, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:46:24.702430", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      # Combine grid (as bytes), position, direction, and inventory (as tuple)\n      # to create a unique, hashable representation of the state.\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops\n  # in cases where the goal might be unreachable or require too many steps.\n  # Increased from v1 to allow for potentially longer, more complex paths.\n  MAX_SEARCH_DEPTH = 200 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # Dynamic action prioritization for v2:\n      # Prioritize 'USE' if the agent is next to a primitive or a workshop.\n      # Otherwise, prioritize movement actions to get to such locations.\n      actions_to_explore_this_step = []\n\n      is_next_to_interactive = False\n      # Check if next to any primitive\n      for p_idx in current_state.world.cookbook.primitives:\n          if current_state.next_to(p_idx):\n              is_next_to_interactive = True\n              break\n      \n      # If not next to a primitive, check if next to any workshop\n      if not is_next_to_interactive:\n          for w_idx in current_state.world.workshop_indices:\n              if current_state.next_to(w_idx):\n                  is_next_to_interactive = True\n                  break\n\n      if is_next_to_interactive:\n          # If next to something interactable, try USE first\n          actions_to_explore_this_step.append(USE)\n          actions_to_explore_this_step.extend([DOWN, UP, LEFT, RIGHT])\n      else:\n          # If not next to anything interactable, prioritize movement\n          actions_to_explore_this_step.extend([DOWN, UP, LEFT, RIGHT])\n          # USE is still a valid action (e.g., to drop items if implemented, or if a recipe becomes available)\n          # but lower priority if no immediate interaction seems possible.\n          actions_to_explore_this_step.append(USE) \n\n      # Explore all possible actions from the current state, using the dynamically determined order.\n      for action in actions_to_explore_this_step:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:46:25.701921", "function_name": "craft", "function_body": "  import collections\n  import heapq # Used for the priority queue in A* search\n  import numpy as np\n\n  # Define action constants. These are the same as in CraftLab.action_specs().\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE] # Standard action order for exploration\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  initial_state = env._current_state\n  \n  # Access the cookbook for recipe information, crucial for the heuristic.\n  cookbook = env.world.cookbook \n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is used for the `visited_costs` dictionary to keep track of explored states.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  # Heuristic function for A* search.\n  # It estimates the minimum number of additional actions (cost) required to reach the goal.\n  # This heuristic calculates the sum of *missing primitive resources* needed to synthesize\n  # the target item. It's an admissible heuristic (never overestimates the true cost)\n  # as each primitive acquired usually requires at least one 'USE' action, and movement\n  # costs are not explicitly factored in this part of the estimate.\n  def _heuristic(state, goal_item_id, cookbook_ref):\n      # If the goal item is already in the inventory, the estimated cost is zero.\n      if state.inventory[goal_item_id] > 0:\n          return 0\n\n      # Use the cookbook to get all the base primitive ingredients (and their quantities)\n      # that are ultimately required to craft the goal item. This function handles\n      # recursive dependencies.\n      required_primitives = cookbook_ref.primitives_for(goal_item_id)\n      \n      missing_count = 0\n      # Sum up the quantity of each primitive that is still missing from the inventory.\n      for prim_idx, required_qty in required_primitives.items():\n          missing_count += max(0, required_qty - state.inventory[prim_idx])\n            \n      return missing_count\n\n  # Priority queue for A* search.\n  # Each element is a tuple: (f_cost, g_cost, current_state, list_of_actions_to_reach_it).\n  # f_cost = g_cost + h_cost (estimated total cost)\n  # g_cost = actual cost (number of actions) from start to current state\n  # h_cost = heuristic estimate from current state to goal\n  # The g_cost is included as a tie-breaker when f_costs are equal, prioritizing shorter paths.\n  \n  initial_h_cost = _heuristic(initial_state, item, cookbook)\n  priority_queue = [(initial_h_cost, 0, initial_state, [])] # (f_cost, g_cost, state, actions)\n\n  # Dictionary to store the minimum `g_cost` (actual path length) found so far to reach a specific state.\n  # This prevents re-exploring states via longer paths, crucial for A* efficiency and correctness.\n  # Maps: _get_state_hashable(state) -> minimum_g_cost\n  visited_costs = {_get_state_hashable(initial_state): 0}\n\n  # Set limits to prevent search from running indefinitely in complex or unreachable scenarios.\n  MAX_PATH_LENGTH = 200      # Maximum allowed length of an action sequence.\n  MAX_NODES_EXPANDED = 100000 # Maximum number of states to process (expand).\n  nodes_expanded = 0\n\n  # A* search loop\n  while priority_queue:\n      # Pop the state with the lowest f_cost from the priority queue.\n      f_cost, g_cost, current_state, current_actions = heapq.heappop(priority_queue)\n      nodes_expanded += 1\n\n      # Pruning: If a shorter path to this state has already been found and processed,\n      # or if the current path is worse than the best known path, skip this entry.\n      # This handles cases where a state might be added multiple times to the queue\n      # via different paths before its optimal path is processed.\n      state_hash = _get_state_hashable(current_state)\n      if g_cost > visited_costs.get(state_hash, float('inf')):\n          continue\n\n      # Check if the current state satisfies the goal (item is in inventory).\n      if current_state.satisfies(None, item):\n          return current_actions # Goal achieved, return the sequence of actions.\n\n      # Pruning by maximum path length.\n      if len(current_actions) >= MAX_PATH_LENGTH:\n          continue # Skip to the next path in the queue if it's too long.\n      \n      # Pruning by maximum number of nodes expanded.\n      if nodes_expanded > MAX_NODES_EXPANDED:\n          # If we hit this limit, it means the goal is likely unreachable within\n          # a reasonable search space or requires a very long path.\n          return [] # No solution found within the limits.\n\n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the new state. Each action has a cost of 1.\n          _reward, new_state = current_state.step(action)\n          new_g_cost = g_cost + 1\n\n          new_state_hash = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, or if we found a shorter path to it:\n          if new_g_cost < visited_costs.get(new_state_hash, float('inf')):\n              visited_costs[new_state_hash] = new_g_cost # Update the shortest path cost to this state.\n              new_h_cost = _heuristic(new_state, item, cookbook) # Calculate heuristic for the new state.\n              new_f_cost = new_g_cost + new_h_cost # Calculate f_cost.\n              \n              # Add the new state to the priority queue.\n              heapq.heappush(priority_queue, (new_f_cost, new_g_cost, new_state, current_actions + [action]))\n\n  # If the priority queue becomes empty and the goal was not found, it means\n  # the item cannot be crafted from the initial state within the defined limits.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:47:52.342043", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  # For v2, we continue to prioritize the 'USE' action in exploration.\n  # This strategic prioritization helps in finding solutions more quickly\n  # by focusing on crafting or resource interaction whenever possible,\n  # potentially reducing the search space for goal-oriented tasks.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS_PRIORITIZED = [USE, DOWN, UP, LEFT, RIGHT]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      # Combine grid (as bytes), position, direction, and inventory (as tuple)\n      # to create a unique, hashable representation of the state.\n      # Using .tobytes() for the grid and tuple() for inventory ensures hashability.\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth. Compared to v1 (150), this version increases the depth limit\n  # to allow for more complex and longer crafting sequences to be found.\n  # This makes 'v2' more capable for challenging tasks, balancing completeness with performance.\n  MAX_SEARCH_DEPTH = 300 # Increased from v1's 150 to allow for deeper exploration.\n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # Explore all possible actions from the current state, using the prioritized order.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:48:33.153474", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  # The 'USE' action is prioritized for exploration, as it often leads to\n  # state changes (crafting, gathering) that progress towards the goal.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS_PRIORITIZED = [USE, DOWN, UP, LEFT, RIGHT]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # Planning will commence from this exact state.\n  initial_state = env._current_state\n\n  # Helper function to create a unique, hashable representation of a CraftState.\n  # This is crucial for detecting visited states in the search algorithm.\n  def _get_state_hashable(state):\n      # Combines grid (as bytes), position, direction, and inventory (as tuple)\n      # to ensure all relevant state components are included for uniqueness.\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  initial_state_hash = _get_state_hashable(initial_state)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, current_depth).\n  # Storing depth allows pruning based on MAX_SEARCH_DEPTH.\n  queue = collections.deque([(initial_state, 0)])\n\n  # Dictionary to store path information and also serve as the 'visited' set.\n  # {current_state_hash: (parent_state_hash, action_taken_to_reach_current_state)}\n  # This approach is more memory-efficient than storing full action lists in the queue,\n  # especially for long paths, as it avoids repeated list concatenations.\n  path_info = {initial_state_hash: (None, None)} # Initial state has no parent or action\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops.\n  # Increased from v1 (150) to 300 to allow for discovery of more complex, multi-step crafting sequences.\n  # This value balances the search completeness with computational feasibility.\n  MAX_SEARCH_DEPTH = 300\n\n  # BFS loop continues as long as there are states to explore in the queue.\n  while queue:\n      current_state, current_depth = queue.popleft()\n      current_state_hash = _get_state_hashable(current_state)\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # `goal_name` is ignored by CraftState.satisfies\n          # Goal achieved! Reconstruct the action path by backtracking from the goal state.\n          actions_path = []\n          temp_state_hash = current_state_hash\n          # Loop until the initial state's parent (None) is encountered.\n          while path_info[temp_state_hash][0] is not None:\n              parent_hash, action = path_info[temp_state_hash]\n              actions_path.append(action) # Add action to the path (will be reversed later)\n              temp_state_hash = parent_hash # Move to the parent state\n          return actions_path[::-1] # Reverse the path to get actions from start to goal\n\n      # Pruning: If the current sequence of actions has exceeded the maximum allowed depth,\n      # abandon this path to avoid exploring overly long or intractable solutions.\n      if current_depth >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # Explore all possible actions from the current state, following the prioritized order.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Apply the action using CraftState.step, which handles all game logic.\n          _reward, new_state = current_state.step(action)\n          new_state_hash = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before (i.e., not present in path_info),\n          # record its parent and the action taken to reach it, then add it to the queue.\n          if new_state_hash not in path_info:\n              path_info[new_state_hash] = (current_state_hash, action)\n              queue.append((new_state, current_depth + 1))\n\n  # If the queue becomes empty and the goal was not found within the specified\n  # MAX_SEARCH_DEPTH, it means the item cannot be crafted or a path was not found.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:50:14.960904", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Get the mapping of action names to their integer values.\n  action_specs = env.action_specs()\n  # Extract the integer values for all possible actions.\n  # This version iterates directly over the values view instead of creating a list copy,\n  # offering a minor optimization for memory and speed, especially if the action space\n  # were larger. The order of actions does not matter for BFS.\n  ACTION_VALUES = action_specs.values()\n\n  # Reset the environment to its initial state.\n  # This ensures the search starts from a clean and known configuration.\n  # The `_` is used as a placeholder for the returned observation dictionary,\n  # which we don't directly need here, but the call updates `env._current_state`.\n  _ = env.reset()\n  initial_craft_state = env._current_state\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_to_reach_this_state).\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents infinite loops and redundant computation, ensuring the shortest path is found.\n  # A state needs to be hashable. We'll use a tuple of:\n  # (grid_as_bytes, inventory_as_bytes, agent_position_tuple, agent_direction_integer).\n  visited = set()\n\n  # Add the initial state to the visited set.\n  initial_grid_bytes = initial_craft_state.grid.tobytes()\n  initial_inventory_bytes = initial_craft_state.inventory.tobytes()\n  initial_hashable_state = (initial_grid_bytes, initial_inventory_bytes,\n                            initial_craft_state.pos, initial_craft_state.dir)\n  visited.add(initial_hashable_state)\n\n  # Define the maximum search depth based on the environment's max_steps.\n  # This ensures that generated plans are executable within the environment's limits,\n  # aligning the planning horizon with the environment's episode length.\n  # CraftLab's constructor ensures max_steps is an int.\n  MAX_SEARCH_DEPTH = env.max_steps\n\n  # Start the BFS loop\n  while queue:\n    current_state, actions_taken = queue.popleft()\n\n    # Check if the current state satisfies the goal (i.e., the item is in the inventory).\n    # CraftState.satisfies expects a goal_name (ignored here) and goal_arg (the item index).\n    if current_state.satisfies(None, item):\n      return actions_taken\n\n    # If the current path has reached or exceeded the maximum allowed depth, prune it.\n    # We prune *before* exploring actions from this state to prevent overly long paths.\n    if len(actions_taken) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action_value in ACTION_VALUES:  # Using the direct values view\n      # Simulate the action. CraftState.step returns a new CraftState object,\n      # which is crucial for BFS as it allows exploring parallel paths.\n      # The reward is not used for pathfinding in this context.\n      _, next_state = current_state.step(action_value)\n\n      # Create a hashable representation of the next state.\n      next_grid_bytes = next_state.grid.tobytes()\n      next_inventory_bytes = next_state.inventory.tobytes()\n      next_hashable_state = (next_grid_bytes, next_inventory_bytes,\n                             next_state.pos, next_state.dir)\n\n      # If this next state has not been visited before, add it to the visited set\n      # and enqueue it for further exploration.\n      if next_hashable_state not in visited:\n        visited.add(next_hashable_state)\n        queue.append((next_state, actions_taken + [action_value]))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted or reached within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:50:49.994816", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Get the mapping of action names to their integer values.\n  # The CraftLab's action_specs method provides this.\n  action_specs = env.action_specs()\n  # Extract the integer values for all possible actions.\n  ACTIONS = list(action_specs.values())\n\n  # Reset the environment to its initial state.\n  # This ensures the search starts from a clean and known configuration.\n  # The `_` is used as a placeholder for the returned observation dictionary,\n  # which we don't directly need here, but the call updates `env._current_state`.\n  _ = env.reset()\n  initial_craft_state = env._current_state\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is crucial for storing visited states in a set/dictionary.\n  def get_state_hash(state):\n    return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  initial_hashable_state = get_state_hash(initial_craft_state)\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple:\n  # (current_CraftState_object, hashable_representation_of_current_state, current_depth).\n  # Storing `current_depth` helps in pruning paths that exceed `MAX_SEARCH_DEPTH`.\n  queue = collections.deque([(initial_craft_state, initial_hashable_state, 0)])\n\n  # Initialize a dictionary to keep track of visited states and their parent in the search tree.\n  # This allows reconstructing the path (sequence of actions) once the goal state is found.\n  # `visited_paths[state_hash] = (parent_state_hash, action_taken_to_reach_this_state)`.\n  # For the initial state, parent_hash and action are None.\n  visited_paths = {initial_hashable_state: (None, None)}\n\n  # Define the maximum search depth based on the environment's max_steps.\n  # This aligns the planning horizon with the environment's episode length.\n  MAX_SEARCH_DEPTH = env.max_steps\n\n  # Start the BFS loop\n  while queue:\n    current_state, current_hashable_state, current_depth = queue.popleft()\n\n    # Check if the current state satisfies the goal (i.e., the item is in the inventory).\n    # CraftState.satisfies expects a goal_name (ignored here) and goal_arg (the item index).\n    if current_state.satisfies(None, item):\n      # Goal reached! Reconstruct the path by backtracking from the current state\n      # using the `visited_paths` dictionary.\n      path = []\n      hash_to_reconstruct = current_hashable_state\n      # Backtrack until we reach the initial state (whose parent is None).\n      while visited_paths[hash_to_reconstruct][0] is not None:\n        parent_hash, action = visited_paths[hash_to_reconstruct]\n        path.append(action)\n        hash_to_reconstruct = parent_hash\n      path.reverse()  # The path was built in reverse order, so reverse it.\n      return path\n\n    # If the current path has reached or exceeded the maximum allowed depth, prune it.\n    # We prune *before* exploring actions from this state to prevent overly long paths.\n    if current_depth >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action_value in ACTIONS:\n      # Simulate the action. CraftState.step returns a new CraftState object.\n      # The reward is not used for pathfinding in this context.\n      _, next_state = current_state.step(action_value)\n      next_hashable_state = get_state_hash(next_state)\n\n      # If this next state has not been visited before, add it to the visited set\n      # and enqueue it for further exploration.\n      if next_hashable_state not in visited_paths:\n        # Store the parent state and the action taken to reach this new state.\n        visited_paths[next_hashable_state] = (current_hashable_state, action_value)\n        # Enqueue the new state along with its hash and updated depth.\n        queue.append((next_state, next_hashable_state, current_depth + 1))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted or reached within the defined search limits.\n  return []", "island_id": 2, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:52:56.230241", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops\n  # in cases where the goal might be unreachable or require too many steps.\n  # Increased from v1 (100) to allow for more complex crafting sequences.\n  MAX_SEARCH_DEPTH = 250 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # --- Action Prioritization Strategy for V2 ---\n      # This strategy prioritizes the 'USE' action if it's potentially productive,\n      # aiming to find solutions faster by focusing on crafting/gathering opportunities.\n\n      actions_to_explore_in_order = []\n      \n      # Step 1: Speculatively apply the USE action to evaluate its immediate outcome.\n      # This allows us to decide if 'USE' should be prioritized.\n      _reward_use, state_after_use = current_state.step(USE)\n      hash_after_use = _get_state_hashable(state_after_use)\n\n      # Determine if the USE action resulted in a change to the inventory.\n      use_changes_inventory = not np.array_equal(state_after_use.inventory, current_state.inventory)\n\n      # Determine if the agent is next to a relevant interactive entity (workshop or grabbable).\n      # Being next to such an entity makes 'USE' potentially productive, even if it doesn't\n      # immediately change inventory (e.g., agent needs to move to pick up other ingredients first).\n      is_next_to_relevant_use_location = False\n      for workshop_idx in env.world.workshop_indices:\n          if current_state.next_to(workshop_idx):\n              is_next_to_relevant_use_location = True\n              break\n      if not is_next_to_relevant_use_location: # Only check grabbables if not already next to a workshop\n          for grabbable_idx in env.world.grabbable_indices:\n              if current_state.next_to(grabbable_idx):\n                  is_next_to_relevant_use_location = True\n                  break\n\n      # Condition to prioritize 'USE':\n      # 'USE' is prioritized if it leads to an inventory change (e.g., picking up, crafting),\n      # OR if the agent is positioned at a relevant 'USE' location (workshop, grabbable item),\n      # AND the resulting state from this specific USE action has not been visited yet\n      # (crucial to avoid re-exploring unproductive cycles or less efficient paths).\n      should_prioritize_use = (use_changes_inventory or is_next_to_relevant_use_location) \\\n                              and (hash_after_use not in visited)\n\n      if should_prioritize_use:\n          # If 'USE' is prioritized, add it first to be explored.\n          actions_to_explore_in_order.append(USE)\n          # Then add all other actions.\n          actions_to_explore_in_order.extend([a for a in ALL_ACTIONS if a != USE])\n      else:\n          # Otherwise, prioritize movement actions first.\n          actions_to_explore_in_order.extend([a for a in ALL_ACTIONS if a != USE])\n          # Add 'USE' last if it was not prioritized.\n          actions_to_explore_in_order.append(USE)\n          \n      # Explore all possible actions from the current state in the determined order.\n      for action in actions_to_explore_in_order:\n          new_state = None\n          new_state_hashable = None\n\n          if action == USE:\n              # For the 'USE' action, we use the state and hash pre-computed earlier.\n              new_state = state_after_use\n              new_state_hashable = hash_after_use\n          else:\n              # For movement actions (DOWN, UP, LEFT, RIGHT), step the state normally.\n              _reward, new_state = current_state.step(action)\n              new_state_hashable = _get_state_hashable(new_state)\n          \n          # Only add the new state to the queue if it hasn't been visited before.\n          # This ensures BFS finds the shortest path and prevents re-visiting states\n          # that have already been explored via an equal or shorter sequence of actions.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:53:40.376249", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  initial_state = env._current_state\n  \n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, [])]) # Initial actions list is empty\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops.\n  MAX_SEARCH_DEPTH = 150 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      if current_state.satisfies(None, item):\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long, abandon this path.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue\n\n      # --- Craft v2: Enhanced Action Prioritization Strategy ---\n\n      actions_to_explore_in_order = [] # List of actions in their preferred exploration order\n\n      # Pre-evaluate the USE action, as its outcome determines its priority.\n      _reward_use, state_after_use = current_state.step(USE)\n      hash_after_use = _get_state_hashable(state_after_use)\n\n      # Determine if USE should be prioritized based on productivity and goal relevance.\n      prioritize_use_action = False\n\n      # Condition 1: USE action leads to an immediate change in inventory.\n      # This indicates success in picking up a primitive or crafting an item.\n      if not np.array_equal(state_after_use.inventory, current_state.inventory):\n          prioritize_use_action = True\n      \n      # Condition 2: Agent is next to a primitive resource that is explicitly needed for the goal item.\n      # This provides a goal-oriented heuristic for gathering.\n      if not prioritize_use_action: # Only check if not already productive\n          # Get all primitive ingredients needed for the final goal item.\n          needed_primitives = env.world.cookbook.primitives_for(item)\n          for p_idx in needed_primitives:\n              if current_state.next_to(p_idx):\n                  prioritize_use_action = True\n                  break\n      \n      # If USE is prioritized, check if its resulting state has already been visited.\n      # If so, a shorter path to that state exists, so we don't reprioritize this USE.\n      if prioritize_use_action and hash_after_use in visited:\n          prioritize_use_action = False\n\n      # Construct the action exploration order for the current state.\n      if prioritize_use_action:\n          # If USE is prioritized and leads to a new state, add it first.\n          actions_to_explore_in_order.append(USE)\n          # Then add all movement actions.\n          actions_to_explore_in_order.extend([a for a in ALL_ACTIONS if a != USE])\n      else:\n          # Otherwise, prioritize movement actions.\n          actions_to_explore_in_order.extend([a for a in ALL_ACTIONS if a != USE])\n          # Add USE last, but only if it results in a new, unvisited state.\n          if hash_after_use not in visited:\n              actions_to_explore_in_order.append(USE)\n      \n      # Explore all possible actions from the current state in the determined order.\n      for action in actions_to_explore_in_order:\n          if action == USE:\n              # Use the pre-computed state and hash for the USE action.\n              new_state = state_after_use\n              new_state_hashable = hash_after_use\n          else:\n              # For movement actions, step the state normally.\n              _reward, new_state = current_state.step(action)\n              new_state_hashable = _get_state_hashable(new_state)\n\n          # If the resulting state has not been visited, add it to visited set and queue.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found within MAX_SEARCH_DEPTH,\n  # it means the item cannot be crafted from the current state or requires too many steps.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:55:17.518082", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Get initial state from CraftLab\n    initial_craft_state = env._current_state\n\n    # Get action mapping from CraftLab to know available actions\n    # This ensures compatibility even if action constants change\n    action_map = env.action_specs()\n    possible_actions = list(action_map.values())  # e.g., [0, 1, 2, 3, 4] for DOWN, UP, LEFT, RIGHT, USE\n\n    # Initialize BFS queue: (current_craft_state, path_to_current_state)\n    queue = collections.deque()\n    queue.append((initial_craft_state, []))\n\n    # Initialize visited set to avoid cycles and redundant computations.\n    # A state key is a hashable representation of the CraftState's critical components.\n    # grid and inventory are numpy arrays, so convert to bytes for hashing.\n    # pos is a tuple, dir is an int, both are hashable.\n    def get_state_key(state):\n        return (state.grid.tobytes(), state.pos, state.dir, state.inventory.tobytes())\n\n    visited = set()\n    visited.add(get_state_key(initial_craft_state))\n\n    # BFS Loop\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Check if the goal is satisfied in the current state\n        # The first argument 'goal_name' is ignored by CraftState.satisfies\n        if current_state.satisfies(None, item):\n            return current_path\n\n        # Explore possible next states by applying each action\n        for action in possible_actions:\n            # Apply the action to get the next state.\n            # The reward is not needed for finding the shortest path.\n            _, next_state = current_state.step(action)\n\n            next_state_key = get_state_key(next_state)\n\n            # If this state has not been visited before, add it to the queue\n            # and mark it as visited.\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means\n    # the item cannot be crafted or picked up from the current scenario.\n    return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:55:18.493388", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n  # Assuming env_factory is available in the execution environment for CraftState\n  # from env_factory import CraftState \n\n  # Define constants for actions based on CraftLab.action_specs\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  all_actions = []\n  \n  # Create a deep copy of the initial state to simulate actions without modifying the actual env state.\n  # CraftState does not have a built-in copy method, so we reconstruct it.\n  current_state_simulated = env_factory.CraftState(\n      scenario=env.scenario,\n      grid=np.copy(env._current_state.grid),\n      pos=env._current_state.pos,\n      dir=env._current_state.dir,\n      inventory=np.copy(env._current_state.inventory)\n  )\n  \n  cookbook = env.world.cookbook\n  width, height, _ = current_state_simulated.grid.shape\n\n  # Helper for pathfinding (BFS to a specific cell)\n  # Returns (actions_list, final_pos, final_dir) or (None, None, None)\n  def find_path_to_cell(start_pos, start_dir, target_cell_pos, obstacles_grid):\n      \"\"\"\n      Finds a path of actions from start_pos to target_cell_pos using BFS.\n      Obstacles_grid is a 2D boolean array where True indicates an impassable cell.\n      \"\"\"\n      q = collections.deque([(start_pos, [], start_dir)]) # (pos, path_actions, dir)\n      visited = set([(start_pos, start_dir)]) # (pos, dir) to avoid loops\n\n      # Lambda for checking if a position is an obstacle or out of bounds\n      is_obstacle_cell = lambda p: not (0 <= p[0] < width and 0 <= p[1] < height) or obstacles_grid[p[0], p[1]]\n\n      while q:\n          (cx, cy), path, current_facing_dir = q.popleft()\n\n          if (cx, cy) == target_cell_pos:\n              return path, (cx, cy), current_facing_dir\n\n          # Define movement deltas for each action\n          moves = {\n              UP: (0, -1),\n              DOWN: (0, 1),\n              LEFT: (-1, 0),\n              RIGHT: (1, 0)\n          }\n          \n          for action, (dx, dy) in moves.items():\n              nx, ny = cx + dx, cy + dy\n              new_pos = (nx, ny)\n              new_dir = action # Agent direction becomes the direction of the last move\n\n              if not is_obstacle_cell(new_pos) and ((new_pos, new_dir) not in visited):\n                  visited.add((new_pos, new_dir))\n                  q.append((new_pos, path + [action], new_dir))\n      \n      return None, None, None # No path found\n\n  # Helper: find closest specific item/workshop on grid\n  # Returns (x, y) coordinates of the closest instance of kind_idx or None\n  def find_closest_kind_location(state, kind_idx):\n      \"\"\"\n      Finds the grid coordinates of the closest instance of a given kind_idx to the agent's current position.\n      \"\"\"\n      min_dist = float('inf')\n      closest_loc = None\n      \n      # Get all locations on the grid where the item/workshop of kind_idx exists\n      kind_locations = np.argwhere(state.grid[:, :, kind_idx] > 0)\n      \n      current_pos = state.pos\n      \n      for loc in kind_locations:\n          # Use Manhattan distance for simplicity\n          dist = abs(loc[0] - current_pos[0]) + abs(loc[1] - current_pos[1])\n          if dist < min_dist:\n              min_dist = dist\n              closest_loc = tuple(loc)\n      return closest_loc # (x, y) or None\n\n  # Recursive function to acquire a target item (either primitive or crafted)\n  def acquire_item(target_item_idx, current_sim_state):\n      \"\"\"\n      Attempts to acquire a target item, recursively acquiring ingredients if necessary.\n      Modifies the `all_actions` list with the actions taken.\n      Returns the simulated CraftState after attempting acquisition.\n      \"\"\"\n      nonlocal all_actions # Allows modification of the list defined in the outer scope\n\n      # Base case: If the item is already in inventory, we are done\n      if current_sim_state.inventory[target_item_idx] > 0:\n          return current_sim_state\n\n      recipe = cookbook.recipes.get(target_item_idx)\n\n      if recipe is None: # Item is a primitive (or uncraftable/unknown)\n          if target_item_idx not in cookbook.primitives:\n              # This item cannot be crafted and is not a primitive, so it's unobtainable\n              return current_sim_state \n\n          # Acquire primitive: find, move, use\n          target_obj_location = find_closest_kind_location(current_sim_state, target_item_idx)\n          if target_obj_location is None:\n              # Primitive not found on the grid\n              return current_sim_state\n\n          # Define obstacles for pathfinding: non-grabbable items\n          obstacle_grid = np.zeros((width, height), dtype=bool)\n          for i_kind in cookbook.environment:\n              # Mark cells containing non-grabbable items as obstacles\n              obstacle_grid |= (current_sim_state.grid[:, :, i_kind] > 0)\n\n          # Find a path to an *adjacent* cell from which to USE the target item\n          best_path = None\n          \n          tx, ty = target_obj_location\n          # Consider 4 cardinal neighbors for pathfinding as `next_to` covers 3x3\n          move_deltas = [(0, 1), (0, -1), (1, 0), (-1, 0)] # DOWN, UP, RIGHT, LEFT\n          \n          for dx, dy in move_deltas:\n              adj_x, adj_y = tx + dx, ty + dy\n              adj_cell_pos = (adj_x, adj_y)\n              \n              if 0 <= adj_x < width and 0 <= adj_y < height and not obstacle_grid[adj_x, adj_y]:\n                  path, _, _ = find_path_to_cell(\n                      current_sim_state.pos,\n                      current_sim_state.dir,\n                      adj_cell_pos,\n                      obstacle_grid\n                  )\n                  \n                  if path is not None and (best_path is None or len(path) < len(best_path)):\n                      best_path = path\n          \n          if best_path is None:\n              # No path found to an adjacent cell\n              return current_sim_state\n\n          all_actions.extend(best_path)\n          \n          # Simulate state after movement\n          temp_state = current_sim_state\n          for action in best_path:\n              _, temp_state = temp_state.step(action)\n          current_sim_state = temp_state\n          \n          # Now, USE the item if adjacent. The `next_to` check ensures the agent is positioned correctly.\n          if current_sim_state.next_to(target_item_idx):\n              _, current_sim_state = current_sim_state.step(USE)\n              all_actions.append(USE)\n          # If not next_to, it implies a pathfinding or grid issue; we fail gracefully.\n          return current_sim_state\n\n      else: # Item is crafted\n          ingredients_needed = {}\n          workshop_name = None\n          \n          for key, count in recipe.items():\n              if key == '_key':\n                  workshop_name = count # `count` here is the string name of the workshop\n              else:\n                  ingredients_needed[key] = count\n          \n          # Acquire all ingredients recursively\n          for ing_idx, needed_count in ingredients_needed.items():\n              current_have = current_sim_state.inventory[ing_idx]\n              while current_have < needed_count:\n                  original_inventory_count = current_sim_state.inventory[ing_idx]\n                  current_sim_state = acquire_item(ing_idx, current_sim_state)\n                  \n                  # If no progress was made on this ingredient, then we cannot craft the target item\n                  if current_sim_state.inventory[ing_idx] == original_inventory_count:\n                      return current_sim_state \n                  current_have = current_sim_state.inventory[ing_idx]\n\n          # After attempting to acquire all ingredients, verify we have enough for crafting\n          for ing_idx, needed_count in ingredients_needed.items():\n              if current_sim_state.inventory[ing_idx] < needed_count:\n                  # Still missing ingredients, cannot craft\n                  return current_sim_state \n\n          # Now, craft the item at the workshop (if specified)\n          if workshop_name is not None:\n              workshop_idx = cookbook.index[workshop_name] # Convert workshop name string to its integer ID\n              workshop_location = find_closest_kind_location(current_sim_state, workshop_idx)\n              if workshop_location is None:\n                  # Workshop not found on the grid\n                  return current_sim_state\n\n              obstacle_grid = np.zeros((width, height), dtype=bool)\n              for i_kind in cookbook.environment:\n                  obstacle_grid |= (current_sim_state.grid[:, :, i_kind] > 0)\n\n              # Find path to an adjacent cell of the workshop\n              best_path = None\n              tx, ty = workshop_location\n              move_deltas = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Cardinal neighbors\n              \n              for dx, dy in move_deltas:\n                  adj_x, adj_y = tx + dx, ty + dy\n                  adj_cell_pos = (adj_x, adj_y)\n                  \n                  if 0 <= adj_x < width and 0 <= adj_y < height and not obstacle_grid[adj_x, adj_y]:\n                      path, _, _ = find_path_to_cell(\n                          current_sim_state.pos,\n                          current_sim_state.dir,\n                          adj_cell_pos,\n                          obstacle_grid\n                      )\n                      \n                      if path is not None and (best_path is None or len(path) < len(best_path)):\n                          best_path = path\n\n              if best_path is None:\n                  # No path found to the workshop\n                  return current_sim_state\n\n              all_actions.extend(best_path)\n              \n              # Simulate state after movement to the workshop\n              temp_state = current_sim_state\n              for action in best_path:\n                  _, temp_state = temp_state.step(action)\n              current_sim_state = temp_state\n              \n              # Use the workshop if adjacent\n              if current_sim_state.next_to(workshop_idx):\n                  _, current_sim_state = current_sim_state.step(USE)\n                  all_actions.append(USE)\n              # Else, something went wrong with pathfinding/positioning.\n              return current_sim_state\n\n          else: # No specific workshop specified (agent-based crafting/assembly)\n              # Assume USE action can be called from current position to craft the item,\n              # consuming ingredients from inventory and adding the crafted item.\n              _, current_sim_state = current_sim_state.step(USE)\n              all_actions.append(USE)\n              return current_sim_state\n    \n  # Start the planning process by attempting to acquire the goal item\n  final_state_after_plan = acquire_item(item, current_state_simulated)\n\n  # Check if the goal item was successfully acquired in the simulated state\n  if final_state_after_plan.inventory[item] > 0:\n      return all_actions\n  else:\n      return [] # Return empty list if failed to craft the item", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:56:26.388602", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants, as per CraftLab.action_specs()\n  # DOWN = 0\n  # UP = 1\n  # LEFT = 2\n  # RIGHT = 3\n  # USE = 4\n\n  start_state = env._current_state\n  target_item_idx = item\n\n  # If the item is already in the inventory, no actions are needed.\n  if start_state.satisfies(None, target_item_idx):\n    return []\n\n  # Helper function to create a unique, hashable representation of a state.\n  # This is crucial for the `visited` set to avoid redundant computations and cycles.\n  def _hash_state(state):\n    return (\n        state.grid.tobytes(),  # Convert numpy array to bytes for hashing\n        state.pos,\n        state.dir,\n        state.inventory.tobytes() # Convert numpy array to bytes for hashing\n    )\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_state, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(start_state, [])])\n\n  # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n  # States are stored using their hashable representation.\n  visited = {_hash_state(start_state)}\n\n  # A pragmatic limit on the number of steps to explore in any single path.\n  # This prevents the search from running indefinitely in complex environments\n  # or when a solution is very long/non-existent within reasonable bounds.\n  MAX_EXPLORE_STEPS = 250 # Increased slightly for potentially longer crafting chains\n\n  while queue:\n    current_state, path_actions = queue.popleft()\n\n    # If the current path has exceeded the maximum allowed exploration steps,\n    # do not expand it further to manage computational complexity.\n    if len(path_actions) >= MAX_EXPLORE_STEPS:\n      continue\n\n    # Iterate through all possible actions (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE)\n    for action in range(5):\n      # Simulate taking the action to get the next state.\n      # CraftState.step returns (reward, new_state). Reward is typically 0.0 in this environment.\n      _reward, next_state = current_state.step(action)\n\n      # Check if the goal item is satisfied in the newly reached state.\n      if next_state.satisfies(None, target_item_idx):\n        return path_actions + [action] # Found the goal, return the sequence of actions\n\n      # Get the hashable representation of the next state.\n      next_state_hash = _hash_state(next_state)\n\n      # If this next state has not been visited before, add it to the queue\n      # for further exploration and mark it as visited.\n      if next_state_hash not in visited:\n        visited.add(next_state_hash)\n        queue.append((next_state, path_actions + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no\n  # path was found within the exploration limits.\n  return []", "island_id": 9, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:56:26.457682", "function_name": "craft", "function_body": "    # Action constants, derived from CraftLab.action_specs()\n    _ACTION_DOWN = 0\n    _ACTION_UP = 1\n    _ACTION_LEFT = 2\n    _ACTION_RIGHT = 3\n    _ACTION_USE = 4\n\n    # collections module (e.g., deque) is assumed to be available in the environment.\n    # numpy is explicitly imported in the provided context.\n    import collections\n\n    # Initialize the environment to get the starting state.\n    # env.reset() returns an observation dict; the actual CraftState is stored in _current_state.\n    # Using a fixed seed for reproducibility of the initial state for the search.\n    _ = env.reset(seed=0)\n    initial_state = env._current_state\n\n    # BFS queue: stores tuples of (current_state, list_of_actions_taken_to_reach_this_state)\n    queue = collections.deque([(initial_state, [])])\n\n    # Visited set: stores hashable representations of states to avoid cycles and redundant work.\n    # A state is uniquely defined by its grid, inventory, position, and direction.\n    # NumPy arrays (grid, inventory) are converted to bytes for hashing.\n    visited = set()\n    initial_state_key = (initial_state.grid.tobytes(),\n                         initial_state.inventory.tobytes(),\n                         initial_state.pos,\n                         initial_state.dir)\n    visited.add(initial_state_key)\n\n    # All possible actions an agent can take.\n    actions = [_ACTION_DOWN, _ACTION_UP, _ACTION_LEFT, _ACTION_RIGHT, _ACTION_USE]\n\n    # Perform a Breadth-First Search (BFS) to find the shortest action sequence.\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Check if the current state satisfies the goal (i.e., the item has been crafted).\n        # The `satisfies` method takes `goal_name` (unused here) and `goal_arg` (the item index).\n        if current_state.satisfies(None, item):\n            return current_path\n\n        # Explore all possible next states by applying each action.\n        for action in actions:\n            # Simulate the action. CraftState.step returns (reward, new_state).\n            _, next_state = current_state.step(action)\n\n            # Create a hashable key for the next state to check if it has been visited.\n            next_state_key = (next_state.grid.tobytes(),\n                              next_state.inventory.tobytes(),\n                              next_state.pos,\n                              next_state.dir)\n\n            # If this state has not been visited, add it to the visited set and the queue.\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means no path exists.\n    return []", "island_id": 9, "scores": {"3": -1}}
