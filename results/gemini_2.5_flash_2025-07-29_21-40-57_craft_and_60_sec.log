{"timestamp": "2025-07-29T23:22:36.817433", "function_name": "craft", "function_body": "  import collections\n  import numpy as np # Often used by CraftState for grid/inventory\n\n  # Action constants. Explicitly define them here if not imported directly by the function.\n  # These integer values are derived from the problem's `action_specs` description.\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n  _MOVEMENT_ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT]\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is crucial for storing visited states in a set to avoid redundant computation and loops.\n  def _hashable_state(craft_state):\n      # numpy arrays (grid, inventory) are not directly hashable.\n      # Convert them to bytes for a compact and hashable representation.\n      grid_bytes = craft_state.grid.tobytes()\n      inventory_bytes = craft_state.inventory.tobytes()\n      # Position (tuple) and direction (int) are already hashable.\n      return (grid_bytes, inventory_bytes, craft_state.pos, craft_state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # BFS guarantees finding the shortest path in terms of actions.\n  q = collections.deque()\n  # Initialize a set to store hashable representations of visited states.\n  visited = set()\n\n  # Get the initial state of the CraftLab environment and an empty path.\n  initial_craft_state = env._current_state\n  initial_actions_path = []\n\n  # Add the initial state to the queue and mark it as visited.\n  q.append((initial_craft_state, initial_actions_path))\n  visited.add(_hashable_state(initial_craft_state))\n\n  # Set a safety limit for the number of visited states. Increased from v0 for \"improvement\".\n  # This prevents the search from running indefinitely on very complex or impossible goals,\n  # or consuming excessive memory. The value is a heuristic.\n  _MAX_VISITED_STATES = 200000\n\n  # Pre-fetch cookbook data and workshop indices for efficiency.\n  cookbook = env.world.cookbook\n  workshop_indices = env.world.workshop_indices\n\n  # Calculate the primitive ingredients needed for the target item.\n  # This returns a dict {primitive_idx: count} mapping required primitive kind indices to their counts.\n  # If the target `item` itself is a primitive, this might return `{item: 1}`.\n  needed_primitives_for_goal = cookbook.primitives_for(item)\n\n  # Start the BFS loop\n  while q:\n      current_state, actions_path = q.popleft()\n\n      # Check if the goal is satisfied in the current state's inventory.\n      # CraftState.satisfies checks if inventory[goal_arg] > 0.\n      if current_state.satisfies(None, item): # `goal_name` is ignored here, `item` is `goal_arg`.\n          return actions_path # Goal reached, return the sequence of actions.\n\n      # --- Prioritized action generation for `craft_v2` improvement ---\n      # This heuristic aims to explore more promising actions earlier in the BFS.\n      actions_to_explore_order = []\n\n      # 1. Determine if any missing primitives for the goal are adjacent and can be picked up.\n      missing_primitives_at_current_state = {}\n      for p_idx, p_count_needed in needed_primitives_for_goal.items():\n          if current_state.inventory[p_idx] < p_count_needed:\n              missing_primitives_at_current_state[p_idx] = p_count_needed - current_state.inventory[p_idx]\n      \n      should_prioritize_use_for_pickup = False\n      for missing_p_idx in missing_primitives_at_current_state:\n          if current_state.next_to(missing_p_idx):\n              should_prioritize_use_for_pickup = True\n              break\n      \n      # 2. Determine if all required primitives are collected AND we are next to a workshop.\n      # If all primitives are collected, the next logical step is to craft at a workshop.\n      all_primitives_collected = not bool(missing_primitives_at_current_state)\n      should_prioritize_use_for_crafting = False\n      if all_primitives_collected:\n          if any(current_state.next_to(ws_idx) for ws_idx in workshop_indices):\n              should_prioritize_use_for_crafting = True\n\n      # If USE action is highly relevant based on the above conditions, prioritize it.\n      if should_prioritize_use_for_crafting or should_prioritize_use_for_pickup:\n          actions_to_explore_order.append(_USE)\n      \n      # Add all movement actions.\n      actions_to_explore_order.extend(_MOVEMENT_ACTIONS)\n\n      # Ensure the USE action is always considered, even if it wasn't specifically prioritized.\n      # This handles cases where USE might be needed for non-obvious reasons (e.g., activating something)\n      # or when the primitive/workshop conditions aren't met but crafting is still possible.\n      if _USE not in actions_to_explore_order:\n          actions_to_explore_order.append(_USE)\n      # --- End prioritized action generation ---\n\n      # Explore all possible actions from the current state in the defined order.\n      for action in actions_to_explore_order:\n          # Apply the action to get the next state.\n          # CraftState.step returns a new CraftState object, preserving the current_state.\n          _reward, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_hashable_state = _hashable_state(next_state)\n\n          # If this state has not been visited before, add it to the queue and mark it visited.\n          if next_hashable_state not in visited:\n              visited.add(next_hashable_state)\n              q.append((next_state, actions_path + [action]))\n\n              # Check if the search has exceeded the maximum allowed visited states.\n              if len(visited) > _MAX_VISITED_STATES:\n                  # If limit reached, it implies the item is either unreachable,\n                  # or requires an impractically long sequence of actions that BFS\n                  # cannot find within the given resource budget.\n                  # Return an empty list to indicate failure to find a path within limits.\n                  return []\n\n  # If the queue becomes empty and the goal was never satisfied,\n  # it means no path to craft the item was found from the initial state\n  # within the explored search space.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T23:22:37.831417", "function_name": "craft", "function_body": "  # Action constants (copied from craft_v0's internal definition for self-containment)\n  try:\n      # Attempt to import if they are exposed globally by env_factory\n      from env_factory import DOWN, UP, LEFT, RIGHT, USE\n      _ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n  except ImportError:\n      # Fallback if not directly importable (as assumed in craft_v0)\n      _DOWN = 0\n      _UP = 1\n      _LEFT = 2\n      _RIGHT = 3\n      _USE = 4\n      _ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT, _USE]\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is crucial for storing visited states in a set to avoid redundant computation and loops.\n  # (Copied from craft_v0's internal definition, as it's already an efficient method)\n  def _hashable_state(craft_state):\n      grid_bytes = craft_state.grid.tobytes()\n      inventory_bytes = craft_state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, craft_state.pos, craft_state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  q = collections.deque()\n  # Initialize a set to store hashable representations of visited states.\n  visited = set()\n\n  # Get the initial state of the CraftLab environment and an empty path.\n  initial_craft_state = env._current_state\n  initial_actions_path = []\n\n  # Add the initial state to the queue and mark it as visited.\n  q.append((initial_craft_state, initial_actions_path))\n  visited.add(_hashable_state(initial_craft_state))\n\n  # --- Improvements for v2 ---\n  # 1. Time limit: Prevents excessively long computations in complex or unsolvable scenarios.\n  #    This offers a more robust termination condition than a fixed number of visited states.\n  _TIME_LIMIT_SECONDS = 15.0 # Heuristic value, can be tuned based on expected problem complexity.\n\n  # 2. Maximum path length: Prunes very deep, potentially unproductive search branches.\n  #    While BFS finds the shortest path, if a path becomes excessively long, it often\n  #    indicates that the goal is unreachable or requires too many steps to be practical.\n  _MAX_PATH_LENGTH = 750 # Heuristic value.\n\n  start_time = time.time()\n\n  # Start the BFS loop\n  while q:\n      current_state, actions_path = q.popleft()\n\n      # Check time limit to prevent exceeding computation budget.\n      if time.time() - start_time > _TIME_LIMIT_SECONDS:\n          return [] # Timed out, indicating failure to find path within limits.\n\n      # Check if the current path length has exceeded the maximum allowed.\n      # This prunes extremely long paths that are unlikely to be optimal or reachable.\n      if len(actions_path) > _MAX_PATH_LENGTH:\n          continue # Skip exploring further from this path.\n\n      # Check if the goal is satisfied in the current state's inventory.\n      if current_state.satisfies(None, item): # `goal_name` is ignored here, `item` is `goal_arg`.\n          return actions_path # Goal reached, return the sequence of actions.\n\n      # Explore all possible actions from the current state.\n      for action in _ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns a new CraftState object, preserving the current_state.\n          _reward, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_hashable_state = _hashable_state(next_state)\n\n          # If this state has not been visited before, add it to the queue and mark it visited.\n          if next_hashable_state not in visited:\n              visited.add(next_hashable_state)\n              q.append((next_state, actions_path + [action]))\n\n  # If the queue becomes empty and the goal was never satisfied,\n  # it means no path to craft the item was found from the initial state\n  # within the explored search space and given limits.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-29T23:23:44.026407", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants, as per CraftLab.action_specs()\n  # DOWN = 0\n  # UP = 1\n  # LEFT = 2\n  # RIGHT = 3\n  # USE = 4\n  ACTIONS = [0, 1, 2, 3, 4] # Explicit list of all possible actions\n\n  start_state = env._current_state\n  target_item_idx = item\n\n  # If the item is already in the inventory, no actions are needed.\n  if start_state.satisfies(None, target_item_idx):\n    return []\n\n  # Helper function to create a unique, hashable representation of a state.\n  # This is crucial for the `visited` set to avoid redundant computations and cycles.\n  def _hash_state(state):\n    return (\n        state.grid.tobytes(),  # Convert numpy array to bytes for hashing\n        state.pos,\n        state.dir,\n        state.inventory.tobytes() # Convert numpy array to bytes for hashing\n    )\n\n  # Define a named tuple for items in the queue to store state and its depth.\n  QueueItem = collections.namedtuple(\"QueueItem\", [\"state\", \"depth\"])\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a QueueItem.\n  queue = collections.deque([QueueItem(start_state, 0)])\n\n  # Initialize a dictionary to keep track of visited states and their parent information.\n  # visited[state_hash] = (parent_state_hash, action_taken_to_reach_this_state)\n  # This allows reconstructing the path efficiently without storing the full path in the queue.\n  start_state_hash = _hash_state(start_state)\n  visited = {start_state_hash: (None, None)} # Parent of start state is None\n\n  # A pragmatic limit on the maximum path length to explore.\n  # This prevents the search from running indefinitely in complex environments\n  # or when a solution is very long/non-existent within reasonable bounds.\n  MAX_EXPLORE_STEPS = 250\n\n  while queue:\n    current_q_item = queue.popleft()\n    current_state = current_q_item.state\n    current_depth = current_q_item.depth\n    current_state_hash = _hash_state(current_state)\n\n    # If the current path depth has exceeded the maximum allowed exploration steps,\n    # do not expand it further to manage computational complexity.\n    if current_depth >= MAX_EXPLORE_STEPS:\n      continue\n\n    # Iterate through all possible actions.\n    for action in ACTIONS:\n      # Simulate taking the action to get the next state.\n      # CraftState.step returns (reward, new_state). Reward is typically 0.0 here.\n      _reward, next_state = current_state.step(action)\n\n      # Get the hashable representation of the next state.\n      next_state_hash = _hash_state(next_state)\n\n      # If this next state has not been visited before, process it.\n      if next_state_hash not in visited:\n        # Store the parent state hash and the action that led to this state.\n        visited[next_state_hash] = (current_state_hash, action)\n\n        # Check if the goal item is satisfied in the newly reached state.\n        if next_state.satisfies(None, target_item_idx):\n          # Goal found! Reconstruct the path by backtracking from the goal state.\n          path = []\n          state_tracker_hash = next_state_hash\n          # Loop until we reach the start state (whose parent is None).\n          while visited[state_tracker_hash][0] is not None:\n            parent_hash, action_from_parent = visited[state_tracker_hash]\n            path.append(action_from_parent)\n            state_tracker_hash = parent_hash\n          return path[::-1] # Reverse the path to get actions in chronological order\n\n        # Add the new state to the queue for further exploration.\n        queue.append(QueueItem(next_state, current_depth + 1))\n\n  # If the queue becomes empty and the goal was not reached, it means no\n  # path was found within the exploration limits.\n  return []", "island_id": 9, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:24:06.171228", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants, as per CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  start_state = env._current_state\n  target_item_idx = item\n\n  # If the item is already in the inventory, no actions are needed.\n  if start_state.satisfies(None, target_item_idx):\n    return []\n\n  # Helper function to create a unique, hashable representation of a state.\n  # This is crucial for the `visited` set to avoid redundant computations and cycles.\n  def _hash_state(state):\n    return (\n        state.grid.tobytes(),  # Convert numpy array to bytes for hashing\n        state.pos,\n        state.dir,\n        state.inventory.tobytes() # Convert numpy array to bytes for hashing\n    )\n\n  start_state_hash = _hash_state(start_state)\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_state, current_state_hash)\n  queue = collections.deque([(start_state, start_state_hash)])\n\n  # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n  visited = {start_state_hash}\n\n  # Dictionary to reconstruct the path: maps state_hash -> (parent_state_hash, action_from_parent_to_state)\n  # parent_map[child_hash] = (parent_hash, action_taken_to_reach_child)\n  parent_map = {start_state_hash: (None, None)} # Parent of the start state is None\n\n  # Dictionary to store the depth of each state (number of actions from start)\n  depth_map = {start_state_hash: 0}\n\n  # A pragmatic limit on the number of steps to explore in any single path.\n  # This prevents the search from running indefinitely in complex environments\n  # or when a solution is very long/non-existent within reasonable bounds.\n  MAX_EXPLORE_STEPS = 250\n\n  while queue:\n    current_state, current_state_hash = queue.popleft()\n    current_depth = depth_map[current_state_hash]\n\n    # If the current path has exceeded the maximum allowed exploration steps,\n    # do not expand it further to manage computational complexity.\n    if current_depth >= MAX_EXPLORE_STEPS:\n      continue\n\n    # Iterate through all possible actions (DOWN, UP, LEFT, RIGHT, USE)\n    for action in range(5):\n      # Simulate taking the action to get the next state.\n      # CraftState.step returns (reward, new_state). Reward is typically 0.0 in this environment.\n      _reward, next_state = current_state.step(action)\n\n      # Get the hashable representation of the next state.\n      next_state_hash = _hash_state(next_state)\n\n      # If this next state has not been visited before, add it to the queue\n      # for further exploration and mark it as visited.\n      if next_state_hash not in visited:\n        visited.add(next_state_hash)\n        parent_map[next_state_hash] = (current_state_hash, action)\n        depth_map[next_state_hash] = current_depth + 1\n        queue.append((next_state, next_state_hash))\n\n        # Check if the goal item is satisfied in the newly reached state.\n        if next_state.satisfies(None, target_item_idx):\n          # Goal reached, reconstruct the path by backtracking from the target state\n          path = []\n          trace_hash = next_state_hash\n          # Backtrack until we reach the start state (which has None as its parent_hash)\n          while parent_map[trace_hash][0] is not None:\n            parent_hash, action_taken = parent_map[trace_hash]\n            path.append(action_taken)\n            trace_hash = parent_hash\n          return path[::-1] # Reverse the path to get actions from start to goal\n\n  # If the queue becomes empty and the goal was not reached, it means no\n  # path was found within the exploration limits.\n  return []", "island_id": 9, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:25:51.340641", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Helper class to simulate CraftState behavior\n    class MockCraftState:\n        def __init__(self, initial_state, world):\n            self.grid = np.copy(initial_state.grid)\n            self.inventory = np.copy(initial_state.inventory)\n            self.pos = initial_state.pos\n            self.dir = initial_state.dir\n            self.world = world # Reference to CraftWorld for rules\n\n        def _get_adj_cells(self):\n            r, c = self.pos\n            (GRID_HEIGHT_DIM, GRID_WIDTH_DIM, _) = self.grid.shape\n            adj_cells = []\n            if r > 0: adj_cells.append((r - 1, c))\n            if r < GRID_HEIGHT_DIM - 1: adj_cells.append((r + 1, c))\n            if c > 0: adj_cells.append((r, c - 1))\n            if c < GRID_WIDTH_DIM - 1: adj_cells.append((r, c + 1))\n            return adj_cells\n\n        def step(self, action):\n            new_pos = self.pos\n            new_dir = self.dir\n            \n            # Movement actions\n            if action in [UP, DOWN, LEFT, RIGHT]:\n                dr, dc = 0, 0\n                if action == UP: dr = -1; new_dir = 1\n                elif action == DOWN: dr = 1; new_dir = 0\n                elif action == LEFT: dc = -1; new_dir = 2\n                elif action == RIGHT: dc = 1; new_dir = 3\n                \n                nr, nc = self.pos[0] + dr, self.pos[1] + dc\n                \n                (GRID_HEIGHT_DIM, GRID_WIDTH_DIM, _) = self.grid.shape\n                if 0 <= nr < GRID_HEIGHT_DIM and 0 <= nc < GRID_WIDTH_DIM:\n                    # Assuming all in-bounds cells are traversable for agent movement.\n                    # A more robust simulation would check for blocking environment items.\n                    new_pos = (nr, nc)\n                \n                self.pos = new_pos\n                self.dir = new_dir\n                return 0.0 # Reward is always 0.0 as per problem description\n\n            # Use action\n            elif action == USE:\n                adj_cells = self._get_adj_cells()\n                \n                # 1. Try to pickup primitive items (prioritize items from `grabbable_indices` that are adjacent)\n                pickup_successful = False\n                for r, c in adj_cells:\n                    for k_idx in self.world.grabbable_indices:\n                        if self.grid[r, c, k_idx] > 0:\n                            self.inventory[k_idx] += 1\n                            self.grid[r, c, k_idx] -= 1 # Remove one instance from grid\n                            pickup_successful = True\n                            break # Only pick up one item per USE action\n                    if pickup_successful: break\n                \n                if pickup_successful:\n                    return 0.0\n\n                # 2. If no pickup, try to craft items\n                is_at_workshop = False\n                for r, c in adj_cells:\n                    for workshop_idx in self.world.workshop_indices:\n                        if self.grid[r, c, workshop_idx] > 0:\n                            is_at_workshop = True\n                            break\n                    if is_at_workshop: break\n                \n                crafting_successful = False\n                # Iterate through all recipes. To ensure deterministic behavior if multiple are craftable,\n                # sort by output_idx. `CraftState.step` would have a fixed internal rule.\n                sorted_recipes = sorted(self.world.cookbook.recipes.items(), key=lambda x: x[0])\n\n                for output_idx, recipe_data in sorted_recipes:\n                    requires_workshop = \"_key\" in recipe_data and recipe_data[\"_key\"] == \"workshop\"\n\n                    if requires_workshop and not is_at_workshop:\n                        continue \n\n                    can_craft = True\n                    for ing_idx, ing_count in recipe_data.items():\n                        if ing_idx == \"_key\": continue\n                        if self.inventory[ing_idx] < ing_count:\n                            can_craft = False\n                            break\n                    \n                    if can_craft:\n                        # Craft the item: consume ingredients, produce output\n                        for ing_idx, ing_count in recipe_data.items():\n                            if ing_idx == \"_key\": continue\n                            self.inventory[ing_idx] -= ing_count \n                        self.inventory[output_idx] += 1 \n                        crafting_successful = True\n                        break # Craft only one item per USE action\n                \n                if crafting_successful:\n                    return 0.0\n                \n                # If USE did nothing (no pickup, no craft)\n                return 0.0\n\n            return 0.0 # Should not be reached\n\n    def _get_path_to_any_kind(start_pos, target_kind_indices, current_grid, world, max_path_len=50):\n        \"\"\"\n        Finds a path (list of movement actions) from start_pos to a cell *adjacent* to any target_kind_idx.\n        Returns empty list if no path found within max_path_len.\n        \"\"\"\n        (GRID_HEIGHT_DIM, GRID_WIDTH_DIM, _) = current_grid.shape\n        q = collections.deque([(start_pos, [])]) # (current_pos, actions_taken)\n        visited = {start_pos}\n\n        # Define possible movements and their corresponding actions\n        moves_map = {\n            UP: (-1, 0),\n            DOWN: (1, 0),\n            LEFT: (0, -1),\n            RIGHT: (0, 1),\n        }\n        \n        # Pre-calculate all grid locations containing any of the target kinds for faster lookup\n        all_target_locations_grid = set()\n        for r in range(GRID_HEIGHT_DIM):\n            for c in range(GRID_WIDTH_DIM):\n                for k_idx in target_kind_indices:\n                    if current_grid[r, c, k_idx] > 0:\n                        all_target_locations_grid.add((r, c))\n\n        while q:\n            (r, c), path_actions = q.popleft()\n\n            if len(path_actions) > max_path_len: # Prevent excessively long paths\n                continue\n\n            # Check if current position (r, c) is adjacent to any target kind\n            for dr_adj, dc_adj in moves_map.values():\n                nr_adj, nc_adj = r + dr_adj, c + dc_adj\n                if (nr_adj, nc_adj) in all_target_locations_grid:\n                    return path_actions # Path leads to *current* position, which is adjacent to target\n\n            # Explore neighbors for pathfinding\n            for action, (dr, dc) in moves_map.items():\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < GRID_HEIGHT_DIM and 0 <= nc < GRID_WIDTH_DIM and (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    q.append(((nr, nc), path_actions + [action]))\n                    \n        return [] # No path found\n\n    # Use a MockCraftState to simulate state changes without affecting the actual environment.\n    # We start with a copy of the initial state from env._current_state.\n    cookbook = env.world.cookbook\n    sim_state = MockCraftState(env._current_state, env.world)\n    total_actions = []\n\n    # Agenda for acquiring items: (item_idx, quantity_needed)\n    # Using a deque allows pushing dependencies (ingredients) to the front for a DFS-like resolution.\n    acquisition_agenda = collections.deque([(item, 1)]) # Start with the final goal item\n\n    MAX_TOTAL_PLAN_ACTIONS = 2000 # Safety limit for total actions in the generated plan\n\n    while acquisition_agenda and len(total_actions) < MAX_TOTAL_PLAN_ACTIONS:\n        current_goal_idx, needed_count = acquisition_agenda.popleft()\n\n        # If the simulated inventory already has enough of the current goal item, skip.\n        if sim_state.inventory[current_goal_idx] >= needed_count:\n            continue\n\n        recipe = cookbook.recipes.get(current_goal_idx)\n\n        if recipe is None: # Item is a primitive (or unknown, indicating uncraftable)\n            if current_goal_idx in cookbook.primitives:\n                # This is a primitive item, it needs to be picked up.\n                \n                # Find path to the nearest instance of this primitive item on the grid.\n                path_actions = _get_path_to_any_kind(sim_state.pos, [current_goal_idx], sim_state.grid, env.world)\n                \n                if not path_actions:\n                    # Cannot find the primitive on the grid or no path to it.\n                    # This indicates an unachievable goal given the current grid state.\n                    return [] \n                \n                # Apply movement actions to the simulated state and record them.\n                for action in path_actions:\n                    sim_state.step(action)\n                    total_actions.append(action)\n                \n                # After moving adjacent to it, use the 'USE' action to pick it up.\n                sim_state.step(USE)\n                total_actions.append(USE)\n                \n                # Since 'USE' typically picks up one item, if more are needed, re-add to agenda.\n                if sim_state.inventory[current_goal_idx] < needed_count:\n                    acquisition_agenda.appendleft((current_goal_idx, needed_count))\n            else:\n                # Item is not a primitive and has no recipe: it's uncraftable.\n                return [] \n        \n        else: # Item has a recipe: it needs crafting.\n            # Check if all ingredients are available in the simulated inventory.\n            missing_ingredients = False\n            for ing_idx, ing_count in recipe.items():\n                if ing_idx == \"_key\": continue # Special key for workshop requirement\n                \n                if sim_state.inventory[ing_idx] < ing_count:\n                    missing_ingredients = True\n                    # If ingredients are missing, push the current goal back to the agenda.\n                    # Then push the missing ingredient(s) to the front to prioritize their acquisition.\n                    acquisition_agenda.appendleft((current_goal_idx, needed_count)) \n                    acquisition_agenda.appendleft((ing_idx, ing_count - sim_state.inventory[ing_idx])) \n                    break # Focus on acquiring this missing ingredient first\n            \n            if not missing_ingredients:\n                # All ingredients are available. Now attempt to craft the item.\n                requires_workshop = \"_key\" in recipe and recipe[\"_key\"] == \"workshop\"\n\n                if requires_workshop:\n                    # If a workshop is required, find a path to one.\n                    path_to_workshop = _get_path_to_any_kind(sim_state.pos, env.world.workshop_indices, sim_state.grid, env.world)\n                    if not path_to_workshop:\n                        # Cannot find a workshop on the grid.\n                        return [] \n                    \n                    # Apply movement actions to reach the workshop.\n                    for action in path_to_workshop:\n                        sim_state.step(action)\n                        total_actions.append(action)\n                \n                # After reaching the appropriate location (or being next to it), use the 'USE' action.\n                sim_state.step(USE)\n                total_actions.append(USE)\n\n                # The `MockCraftState.step(USE)` handles consuming ingredients and producing the item.\n                # If the goal isn't fully met (e.g., if multiple units were needed for a larger recipe),\n                # the `needed_count` check at the top of the loop will re-add it to the agenda.\n\n    # After the planning loop, check if the main goal item is in the simulated inventory.\n    if sim_state.inventory[item] > 0:\n        return total_actions\n    else:\n        # If the agenda is empty but the goal is not met, or max actions limit was reached,\n        # it implies the item cannot be crafted with this planning strategy or resources.\n        return []", "island_id": 5, "scores": {"3": -1}}
