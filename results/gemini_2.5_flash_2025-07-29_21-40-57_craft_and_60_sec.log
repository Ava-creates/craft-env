{"timestamp": "2025-07-29T23:05:23.969367", "function_name": "craft", "function_body": "  import collections # Need for deque\n  import numpy as np # Already imported in the example, but explicitly listed for clarity\n\n  \"\"\"Improved version of `craft_v1` using Breadth-First Search (BFS) for planning.\"\"\"\n\n  # Get initial state by resetting the environment.\n  # This ensures we start from a consistent initial configuration.\n  _ = env.reset() # The observation dictionary is not directly needed for planning, only the internal state.\n  initial_craft_state = env._current_state # Access the internal CraftState object managed by CraftLab.\n\n  goal_item_idx = item\n\n  # Retrieve concrete action integer values from the environment's action_specs.\n  # This makes the code robust to changes in action mappings.\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Use a deque for BFS, storing tuples of (current_craft_state, path_taken_to_reach_this_state).\n  # The path is a list of action integers representing the sequence of actions taken.\n  q = collections.deque([(initial_craft_state, [])])\n\n  # Visited set to keep track of states already explored. This prevents cycles and redundant work,\n  # which is crucial for efficiency in state-space search.\n  # A state is uniquely defined by:\n  # - Agent's position (pos)\n  # - Agent's facing direction (dir)\n  # - Current inventory contents (inventory)\n  # - Current grid layout (grid)\n  # numpy arrays (inventory, grid) are converted to bytes using .tobytes() for hashability.\n  def get_state_hash(state: 'CraftState'):\n      return (state.pos,\n              state.dir,\n              state.inventory.tobytes(),\n              state.grid.tobytes())\n\n  visited = set()\n  visited.add(get_state_hash(initial_craft_state))\n\n  # Set a maximum search depth/number of steps to limit computation time and memory usage.\n  # This is important for complex or potentially unreachable goals to prevent infinite loops.\n  MAX_SEARCH_STEPS = 5000\n\n  while q:\n      current_state, current_path = q.popleft()\n\n      # Check if the current state satisfies the goal condition.\n      # The goal is met if the target item is present in the inventory with a count greater than 0.\n      if current_state.inventory[goal_item_idx] > 0:\n          return current_path\n\n      # Pruning: If the current path length exceeds the maximum allowed steps,\n      # stop exploring this branch to prevent overly long and inefficient searches.\n      if len(current_path) >= MAX_SEARCH_STEPS:\n          continue\n\n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step() returns (reward, new_state). `new_state` is a newly created CraftState object,\n          # ensuring the original `current_state` object remains unchanged for other branches in the BFS.\n          _reward, next_state = current_state.step(action)\n\n          next_state_hash = get_state_hash(next_state)\n\n          # If this next state has not been visited yet, add it to the queue for exploration\n          # and mark it as visited to avoid redundant processing.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              q.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means the goal is\n  # unreachable within the defined search limits from the initial state in this scenario.\n  return []", "island_id": 4, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:05:24.045869", "function_name": "craft", "function_body": "    # Define action constants based on CraftLab.action_specs()\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    # Helper function: Simulate a single step on a CraftState\n    # This function creates a new CraftState object, so it doesn't modify the original.\n    def _simulate_state_step(state: 'CraftState', action: int) -> 'CraftState':\n        \"\"\"Simulates a single step without modifying the original state.\"\"\"\n        # CraftState.step returns (reward, new_state)\n        # We only care about the new_state for planning\n        _, new_state = state.step(action)\n        return new_state\n\n    # Helper function: BFS pathfinding to find a sequence of movement actions\n    def _find_path(\n        start_pos: tuple[int, int],\n        target_positions: list[tuple[int, int]],\n        grid: np.ndarray,\n        width: int,\n        height: int,\n        block_indices: set[int]\n    ) -> tuple[list[int], tuple[int, int]] | None:\n        \"\"\"\n        Performs BFS to find the shortest path from start_pos to any target_position.\n        Returns a tuple of (list of actions, final_pos) or None if no path is found.\n        Movement is 4-directional (up, down, left, right).\n        Cells containing items from `block_indices` are treated as impassable.\n        \"\"\"\n        q = collections.deque([(start_pos, [])]) # (current_pos, path_actions)\n        visited = {start_pos}\n\n        # Map movement actions to (dx, dy) deltas\n        move_deltas = {\n            ACTION_DOWN: (0, 1),\n            ACTION_UP: (0, -1),\n            ACTION_LEFT: (-1, 0),\n            ACTION_RIGHT: (1, 0)\n        }\n\n        while q:\n            (curr_x, curr_y), path = q.popleft()\n\n            if (curr_x, curr_y) in target_positions:\n                return path, (curr_x, curr_y)\n\n            for action, (dx, dy) in move_deltas.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n\n                # Check bounds and if already visited\n                if 0 <= next_x < width and 0 <= next_y < height and (next_x, next_y) not in visited:\n                    # Check if the next cell is blocked by any non-grabbable entity\n                    is_blocked = False\n                    for block_idx in block_indices:\n                        if grid[next_x, next_y, block_idx] > 0:\n                            is_blocked = True\n                            break\n                    \n                    if not is_blocked:\n                        visited.add((next_x, next_y))\n                        q.append(((next_x, next_y), path + [action]))\n                        \n        return None # No path found\n\n    # Helper function: Get coordinates of target objects or adjacent cells\n    def _get_target_coords(\n        object_kind_index: int,\n        current_grid: np.ndarray,\n        width: int,\n        height: int,\n        is_adjacent_needed: bool # True for picking up primitives (need to be next to), False for workshops (need to be on)\n    ) -> list[tuple[int, int]]:\n        \"\"\"\n        Finds all coordinates where `object_kind_index` is present.\n        If `is_adjacent_needed` is True, returns coordinates adjacent (4-directional) to the object.\n        Otherwise, returns the exact coordinates of the object.\n        \"\"\"\n        targets = []\n        # The layer for the specific object_kind_index\n        kind_layer = current_grid[:, :, object_kind_index] \n        \n        for x in range(width):\n            for y in range(height):\n                if kind_layer[x, y] > 0: # If this kind is present at (x, y)\n                    if is_adjacent_needed:\n                        # Add all 4-directionally adjacent cells\n                        for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n                            adj_x, adj_y = x + dx, y + dy\n                            if 0 <= adj_x < width and 0 <= adj_y < height:\n                                targets.append((adj_x, adj_y))\n                    else:\n                        targets.append((x, y))\n        return list(set(targets)) # Remove duplicates (important for adjacent targets)\n\n    # --- Main craft_v2 logic ---\n\n    # Get the initial state of the environment for planning\n    current_planning_state = env._current_state\n    total_actions = [] # List to store the sequence of actions for the plan\n\n    # Get grid dimensions\n    grid_width, grid_height, _ = current_planning_state.grid.shape\n\n    # Get necessary information from the world's cookbook\n    cookbook = env.world.cookbook\n    workshop_indices = env.world.workshop_indices\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # 1. Check if the target item is already in the inventory\n    if current_planning_state.inventory[item] > 0:\n        return [] # Goal already satisfied, no actions needed\n\n    # 2. Determine the primitive requirements for crafting the target item\n    # cookbook.primitives_for(item) flattens the recipe tree and returns\n    # a dict of {primitive_index: count} for all base primitives needed.\n    primitives_needed = cookbook.primitives_for(item)\n\n    # 3. Handle the special case where the target `item` itself is a primitive.\n    # If `item` is a primitive, `primitives_for(item)` usually returns an empty dict.\n    # In this case, we just need to pick up the item itself.\n    is_primitive_target = False\n    if item in cookbook.primitives:\n        if not primitives_needed: # If no other primitives are dependencies\n            is_primitive_target = True\n            primitives_needed[item] = 1 # Mark that we need to collect one of the target item\n\n    # If `item` is neither a primitive nor has a defined recipe (i.e., `primitives_needed` is empty\n    # and it's not a primitive target), then it's uncraftable/unacquirable.\n    if not primitives_needed and not is_primitive_target:\n        return [] # Cannot craft/acquire this item\n\n    # 4. Collect all required primitives\n    # Process primitives in a consistent order (e.g., by index)\n    sorted_primitives_needed = sorted(primitives_needed.items())\n\n    for p_idx, required_count in sorted_primitives_needed:\n        while current_planning_state.inventory[p_idx] < required_count:\n            # Find all reachable locations for this primitive.\n            # For picking up, the agent needs to be *adjacent* to the primitive.\n            target_locs = _get_target_coords(p_idx, current_planning_state.grid, grid_width, grid_height, is_adjacent_needed=True)\n\n            if not target_locs:\n                # Primitive not found on the grid, so it's impossible to collect\n                return [] # Impossible plan\n\n            # Find a path from the current agent position to any of the target primitive locations\n            path_result = _find_path(current_planning_state.pos, target_locs, current_planning_state.grid, grid_width, grid_height, block_indices=non_grabbable_indices)\n\n            if path_result is None:\n                # No path exists to any primitive location\n                return [] # Impossible plan\n\n            path_to_primitive, _ = path_result\n            \n            # Add the movement actions to the overall plan\n            total_actions.extend(path_to_primitive)\n            # Simulate these actions to update the planning state\n            for action in path_to_primitive:\n                current_planning_state = _simulate_state_step(current_planning_state, action)\n            \n            # After reaching an adjacent cell, use the 'USE' action to pick up the primitive\n            total_actions.append(ACTION_USE)\n            current_planning_state = _simulate_state_step(current_planning_state, ACTION_USE)\n            # The grid and inventory in `current_planning_state` are automatically updated by `_simulate_state_step`\n\n    # 5. If the target item is not a primitive itself, move to a workshop and craft it.\n    if not is_primitive_target:\n        # Find all workshop locations.\n        # For crafting, the agent needs to be *on* the workshop cell.\n        target_workshop_locs = []\n        for ws_idx in workshop_indices:\n            target_workshop_locs.extend(_get_target_coords(ws_idx, current_planning_state.grid, grid_width, grid_height, is_adjacent_needed=False))\n        \n        if not target_workshop_locs:\n            # No workshop found, so derived items cannot be crafted\n            return [] # Impossible plan\n        \n        # Find a path to the nearest workshop\n        path_to_workshop_result = _find_path(current_planning_state.pos, target_workshop_locs, current_planning_state.grid, grid_width, grid_height, block_indices=non_grabbable_indices)\n        \n        if path_to_workshop_result is None:\n            # No path exists to any workshop\n            return [] # Impossible plan\n        \n        path_to_workshop, _ = path_to_workshop_result\n        \n        # Add workshop movement actions to the plan\n        total_actions.extend(path_to_workshop)\n        # Simulate these actions to update the planning state\n        for action in path_to_workshop:\n            current_planning_state = _simulate_state_step(current_planning_state, action)\n        \n        # After reaching the workshop, use the 'USE' action to attempt crafting\n        total_actions.append(ACTION_USE)\n        current_planning_state = _simulate_state_step(current_planning_state, ACTION_USE)\n    \n    # 6. Final verification: Check if the target item is now in the inventory after the full plan simulation.\n    if current_planning_state.inventory[item] > 0:\n        return total_actions # Plan successful\n    else:\n        # The item was not acquired/crafted, despite the plan.\n        # This could indicate an unhandled complexity or an item that cannot be obtained.\n        return [] # Plan failed or item not obtainable", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-29T23:06:55.368430", "function_name": "craft", "function_body": "  import collections # Required for deque\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The _current_state attribute is used to access the internal CraftState object.\n  initial_state = env._current_state\n\n  # Define a function to generate a hashable representation of a CraftState.\n  # A state is uniquely identified by its grid layout, inventory contents,\n  # agent's position, and agent's facing direction.\n  # numpy arrays are converted to bytes for hashability.\n  def hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents redundant computations and infinite loops in cyclic environments.\n  visited = {hash_craft_state(initial_state)}\n\n  # Dynamically determine the number of possible actions from the environment's action specifications.\n  # This makes the function more robust to changes in the action space.\n  N_ACTIONS = len(env.action_specs()) \n\n  # Set the maximum path length for the BFS. This acts as a computational budget\n  # and also aligns the search horizon with the environment's configured maximum steps,\n  # if available. If `env.max_steps` is not set or None, it defaults to 200.\n  MAX_PATH_LENGTH = getattr(env, 'max_steps', 200)\n\n  # Start the BFS loop.\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the desired item is in inventory).\n      # The `goal_name` argument of `satisfies` is ignored based on its docstring,\n      # so we pass None.\n      if current_state.satisfies(None, item):\n          return current_path # Goal reached, return the sequence of actions.\n\n      # Pruning step: If the current path length exceeds the maximum allowed,\n      # stop exploring this branch to manage computational complexity and stay within\n      # the effective episode horizon.\n      if len(current_path) >= MAX_PATH_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for action in range(N_ACTIONS):\n          # Apply the action to get the next state.\n          # The `reward` returned by `step` is not used in this pathfinding algorithm.\n          _, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_state_hash = hash_craft_state(next_state)\n\n          # If this next state has not been visited before, add it to the queue\n          # and mark it as visited. This prevents cycles and redundant exploration.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              # Append the next state and the updated path (current path + new action) to the queue.\n              queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no valid\n  # path exists to craft the item within the defined constraints (e.g., MAX_PATH_LENGTH).\n  return [] # Return an empty list to indicate that no solution was found.", "island_id": 1, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:07:34.815885", "function_name": "craft", "function_body": "  import collections # Required for deque\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The _current_state attribute is used to access the internal CraftState object.\n  initial_state = env._current_state\n\n  # Define a function to generate a hashable representation of a CraftState.\n  # A state is uniquely identified by its grid layout, inventory contents,\n  # agent's position, and agent's facing direction.\n  # numpy arrays are converted to bytes for hashability.\n  def hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents redundant computations and infinite loops in cyclic environments.\n  visited = {hash_craft_state(initial_state)}\n\n  # Define the total number of possible actions (DOWN, UP, LEFT, RIGHT, USE).\n  N_ACTIONS = 5 \n  ACTION_USE = 4 # The index corresponding to the 'USE' action\n\n  # Set a maximum path length to prevent the search from running indefinitely\n  # in very complex or unsolvable scenarios. This value may need tuning based on\n  # the complexity of the specific CraftWorld recipes and map sizes.\n  MAX_PATH_LENGTH = 200 # A reasonable heuristic for typical crafting tasks.\n\n  # Start the BFS loop.\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the desired item is in inventory).\n      # The `goal_name` argument of `satisfies` is ignored based on its docstring,\n      # so we pass None.\n      if current_state.satisfies(None, item):\n          return current_path # Goal reached, return the sequence of actions.\n\n      # Pruning step: If the current path length exceeds the maximum allowed,\n      # stop exploring this branch to manage computational complexity.\n      if len(current_path) >= MAX_PATH_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      # Actions are typically represented by integers 0 through 4.\n      for action in range(N_ACTIONS):\n          # Improvement: Prune unproductive 'USE' actions.\n          # The 'USE' action is only beneficial if the agent is next to a workshop,\n          # a resource (like stone or water), or a grabbable item.\n          if action == ACTION_USE:\n              is_next_to_useful_entity = False\n              world = current_state.world\n              \n              # Aggregate all indices of entities that are typically interacted with using 'USE'.\n              # This includes workshops, primitive resources (like stone/water), and other grabbable items.\n              potential_use_targets = set()\n              potential_use_targets.update(world.workshop_indices)\n              \n              if world.water_index is not None:\n                  potential_use_targets.add(world.water_index)\n              if world.stone_index is not None:\n                  potential_use_targets.add(world.stone_index)\n              \n              potential_use_targets.update(world.grabbable_indices)\n\n              # Check if the agent is adjacent to any of these potential targets.\n              for target_idx in potential_use_targets:\n                  if current_state.next_to(target_idx):\n                      is_next_to_useful_entity = True\n                      break\n              \n              # If the 'USE' action would not interact with anything useful, skip it.\n              if not is_next_to_useful_entity:\n                  continue\n\n          # Apply the action to get the next state.\n          # The `reward` returned by `step` is not used in this pathfinding algorithm.\n          _, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_state_hash = hash_craft_state(next_state)\n\n          # If this next state has not been visited before, add it to the queue\n          # and mark it as visited.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              # Append the next state and the updated path (current path + new action) to the queue.\n              queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no valid\n  # path exists to craft the item within the defined constraints (e.g., MAX_PATH_LENGTH).\n  return [] # Return an empty list to indicate that no solution was found.", "island_id": 1, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:09:30.412877", "function_name": "craft", "function_body": "    import collections # Assuming collections is available or imported globally\n    # import numpy as np # Already imported globally\n\n    # Action constants (from problem description: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    def _get_path_bfs(initial_state_grid, start_pos, target_pos, world_width, world_height, check_next_to=False):\n        \"\"\"\n        Finds a path from start_pos to target_pos (or a position next to target_pos).\n        Returns a list of movement actions (UP, DOWN, LEFT, RIGHT) or None if no path.\n        Assumes all cells are walkable.\n        \"\"\"\n        q = collections.deque([(start_pos, [])])\n        visited = {start_pos}\n\n        moves = {\n            UP: (0, -1),\n            DOWN: (0, 1),\n            LEFT: (-1, 0),\n            RIGHT: (1, 0)\n        }\n        \n        while q:\n            (curr_x, curr_y), path_actions = q.popleft()\n\n            # Check if current position is target or next to target\n            is_target_reached = False\n            if check_next_to:\n                # Check if current position is adjacent to target_pos (including target_pos itself)\n                if abs(curr_x - target_pos[0]) <= 1 and abs(curr_y - target_pos[1]) <= 1:\n                    is_target_reached = True\n            else:\n                if (curr_x, curr_y) == target_pos:\n                    is_target_reached = True\n            \n            if is_target_reached:\n                return path_actions\n\n            for action, (dx, dy) in moves.items():\n                next_x, next_y = curr_x + dx, curr_y + dy\n                next_pos = (next_x, next_y)\n\n                if 0 <= next_x < world_width and 0 <= next_y < world_height and next_pos not in visited:\n                    # Assuming all cells are walkable for this simplified planner.\n                    visited.add(next_pos)\n                    q.append((next_pos, path_actions + [action]))\n        return None # No path found\n\n    def _can_craft(craft_idx, current_inv, cookbook):\n        \"\"\"\n        Checks if craft_idx can be crafted given current_inv.\n        Returns (True/False, required_workshop_idx or None).\n        \"\"\"\n        recipe = cookbook.recipes.get(craft_idx)\n        if recipe is None:\n            return False, None # Not craftable via a recipe\n        \n        ingredients_met = True\n        required_workshop_idx = None\n        for ing_idx_str, count in recipe.items():\n            if ing_idx_str == \"_key\":\n                required_workshop_idx = cookbook.index[count] # Get actual index from name\n                continue\n            \n            ing_idx = int(ing_idx_str)\n            if current_inv[ing_idx] < count:\n                ingredients_met = False\n                break\n        return ingredients_met, required_workshop_idx\n\n    # --- Main `craft_v2` function body starts here ---\n    all_actions = []\n    \n    # Get the current state from the CraftLab environment.\n    # We will simulate steps on this state to plan.\n    current_craft_state = env._current_state \n    cookbook = env.world.cookbook\n    world_width = current_craft_state.grid.shape[0]\n    world_height = current_craft_state.grid.shape[1]\n    \n    # Safety limit for generated plans to prevent excessively long searches.\n    MAX_PLAN_LENGTH = 1000 \n\n    # Initialize current inventory for planning. Make a copy to avoid modifying the original.\n    current_inv_for_planning = current_craft_state.inventory.copy()\n\n    # Get all base primitives needed for the final item, recursively.\n    # cookbook.primitives_for() handles this by tracing dependencies down to non-craftable items.\n    primitives_needed_for_goal = cookbook.primitives_for(item)\n    \n    # --- Phase 1: Gather all required primitives ---\n    # Loop until all necessary primitives are in the planning inventory.\n    while True:\n        all_primitives_are_met = True\n        missing_primitive_idx = -1\n        \n        # Check if we have all needed primitives.\n        for p_idx, p_count in primitives_needed_for_goal.items():\n            if current_inv_for_planning[p_idx] < p_count:\n                all_primitives_are_met = False\n                missing_primitive_idx = p_idx # Take the first missing one found\n                break # Found a missing one, we'll prioritize finding this.\n\n        if all_primitives_are_met:\n            break # All primitives are in inventory or not needed.\n\n        # Find the closest instance of this missing primitive on the grid.\n        closest_primitive_pos = None\n        min_dist = float('inf')\n        \n        # Scan the grid for the missing primitive.\n        for x in range(world_width):\n            for y in range(world_height):\n                if current_craft_state.grid[x, y, missing_primitive_idx] > 0:\n                    # Calculate path to a position *adjacent* to (x,y) for `USE` action.\n                    path = _get_path_bfs(\n                        current_craft_state.grid, # Grid is passed but not used for obstacles in current _get_path_bfs\n                        current_craft_state.pos, \n                        (x, y), \n                        world_width, \n                        world_height, \n                        check_next_to=True \n                    )\n                    if path is not None:\n                        if len(path) < min_dist:\n                            min_dist = len(path)\n                            closest_primitive_pos = (x, y)\n        \n        if closest_primitive_pos is None:\n            # If a needed primitive cannot be found on the grid or reached, the goal is unreachable.\n            return [] \n\n        # Move to the primitive's location.\n        path_to_primitive = _get_path_bfs(\n            current_craft_state.grid,\n            current_craft_state.pos,\n            closest_primitive_pos,\n            world_width, world_height,\n            check_next_to=True\n        )\n\n        # Execute movement actions.\n        for action in path_to_primitive:\n            if len(all_actions) >= MAX_PLAN_LENGTH: return [] # Safety break\n            _, current_craft_state = current_craft_state.step(action)\n            all_actions.append(action)\n        \n        # Once next to the primitive, perform the USE action to pick it up.\n        if len(all_actions) >= MAX_PLAN_LENGTH: return [] # Safety break\n        _, current_craft_state = current_craft_state.step(USE)\n        all_actions.append(USE)\n        \n        # Update current inventory for planning after pickup.\n        current_inv_for_planning = current_craft_state.inventory.copy()\n\n    # --- Phase 2: Craft Intermediate and Final Items ---\n    # Now that all primitives are gathered, we craft items in their dependency order.\n    # This loop continues until the target `item` is in the inventory.\n    \n    while current_inv_for_planning[item] == 0:\n        # Determine all relevant items that might need crafting to reach the goal.\n        # This is built by traversing the recipe graph backwards from the goal item.\n        relevant_craft_targets = set([item])\n        q_deps = collections.deque([item])\n        while q_deps:\n            curr_target = q_deps.popleft()\n            recipe = cookbook.recipes.get(curr_target)\n            if recipe: # If it's a craftable item\n                for ing_idx_str, count in recipe.items():\n                    if ing_idx_str == \"_key\": continue\n                    ing_idx = int(ing_idx_str)\n                    # Add ingredient to relevant targets if it's craftable itself and not already processed\n                    if cookbook.recipes.get(ing_idx) is not None and ing_idx not in relevant_craft_targets:\n                        relevant_craft_targets.add(ing_idx)\n                        q_deps.append(ing_idx)\n        \n        best_craft_choice = None # (item_to_craft_idx, workshop_idx)\n        \n        # Prioritize crafting the final goal item if possible.\n        ingredients_met_goal, workshop_idx_goal = _can_craft(item, current_inv_for_planning, cookbook)\n        if ingredients_met_goal:\n            best_craft_choice = (item, workshop_idx_goal)\n        else:\n            # If the final goal is not directly craftable, find the first relevant intermediate item\n            # that *can* be crafted. A simple iteration implicitly prioritizes based on cookbook order.\n            # More sophisticated planners would use topological sort or a heuristic.\n            for output_idx in relevant_craft_targets:\n                if current_inv_for_planning[output_idx] == 0: # Only craft if we don't have it yet\n                    ingredients_met, workshop_idx = _can_craft(output_idx, current_inv_for_planning, cookbook)\n                    if ingredients_met:\n                        best_craft_choice = (output_idx, workshop_idx)\n                        break # Found one, let's craft it\n        \n        if best_craft_choice is None:\n            # If no relevant item can be crafted and the goal is not met, the plan is stuck.\n            return []\n\n        chosen_craft_idx, chosen_workshop_idx = best_craft_choice\n        \n        # Move to the required workshop if one is specified for the recipe.\n        if chosen_workshop_idx is not None:\n            closest_workshop_pos = None\n            min_dist = float('inf')\n\n            # Scan the grid for the closest workshop of the required type.\n            for x in range(world_width):\n                for y in range(world_height):\n                    if current_craft_state.grid[x, y, chosen_workshop_idx] > 0:\n                        path = _get_path_bfs(\n                            current_craft_state.grid,\n                            current_craft_state.pos,\n                            (x, y),\n                            world_width, world_height,\n                            check_next_to=True\n                        )\n                        if path is not None:\n                            if len(path) < min_dist:\n                                min_dist = len(path)\n                                closest_workshop_pos = (x, y)\n            \n            if closest_workshop_pos is None:\n                # No path to the workshop. Unreachable.\n                return []\n            \n            path_to_workshop = _get_path_bfs(\n                current_craft_state.grid,\n                current_craft_state.pos,\n                closest_workshop_pos,\n                world_width, world_height,\n                check_next_to=True\n            )\n            \n            # Execute movement actions to the workshop.\n            for action in path_to_workshop:\n                if len(all_actions) >= MAX_PLAN_LENGTH: return []\n                _, current_craft_state = current_craft_state.step(action)\n                all_actions.append(action)\n        \n        # Once next to the workshop (or anywhere if no workshop needed), perform the USE action to craft.\n        if len(all_actions) >= MAX_PLAN_LENGTH: return []\n        _, current_craft_state = current_craft_state.step(USE)\n        all_actions.append(USE)\n        \n        # Update current inventory for planning after crafting.\n        current_inv_for_planning = current_craft_state.inventory.copy()\n\n    return all_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-29T23:09:30.482198", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants as per CraftLab action_specs: DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    # A reasonable maximum number of states for the BFS search to explore.\n    # This limit helps prevent excessively long searches for unachievable goals\n    # or in very large state spaces, acting as a safeguard against timeouts.\n    MAX_BFS_NODES = 200000\n\n    # Define a helper function to create a hashable representation of a CraftState.\n    # This is crucial for the `visited` set, allowing us to efficiently track\n    # and avoid re-exploring states that have already been processed.\n    def _get_state_hash(state):\n        # We combine the agent's position, direction, inventory contents, and\n        # a byte representation of the grid.\n        # - state.pos (tuple) and state.dir (int) are inherently hashable.\n        # - state.inventory (numpy array) is converted to a tuple of its list representation.\n        # - state.grid (numpy array) is converted to bytes for hashing, which is efficient\n        #   for unique identification of grid configurations.\n        return (state.pos, state.dir, tuple(state.inventory.tolist()), state.grid.tobytes())\n\n    # Get the initial state from the CraftLab environment.\n    # The `_current_state` attribute holds the current `CraftState` instance.\n    initial_state = env._current_state\n\n    # Initialize a deque (double-ended queue) for the Breadth-First Search.\n    # Each element in the queue is a tuple: (current_state_object, list_of_actions_taken_to_reach_this_state).\n    q = collections.deque([(initial_state, [])])\n\n    # Initialize a set to store the hashable representations of all visited states.\n    # This prevents infinite loops and redundant computation by not re-exploring states already seen.\n    visited = {_get_state_hash(initial_state)}\n\n    # Counter for the number of nodes (states) explored during the BFS.\n    nodes_explored = 0\n\n    # Perform the Breadth-First Search.\n    while q:\n        current_state, current_path = q.popleft()\n        nodes_explored += 1\n\n        # Check if the exploration limit has been reached.\n        # If so, it means a path could not be found within the allotted search space.\n        if nodes_explored > MAX_BFS_NODES:\n            return []  # Return an empty list to signify no path found\n\n        # Goal check: Determine if the desired item is present in the current state's inventory.\n        # The `item` argument is the integer index of the goal item.\n        if current_state.inventory[item] > 0:\n            return current_path  # Goal achieved, return the sequence of actions that led here\n\n        # Generate successor states by trying all possible actions from the current state.\n        for action in ALL_ACTIONS:\n            # Apply the action to the current state using the `CraftState.step()` method.\n            # This method handles all the game logic, including agent movement,\n            # picking up items, and crafting based on the action and environment.\n            # The returned reward is not used in this unweighted BFS (all actions cost 1).\n            _reward, next_state = current_state.step(action)\n\n            # Get the hashable representation of the resulting next state.\n            next_state_hash = _get_state_hash(next_state)\n\n            # If this `next_state` has not been visited before, add it to the `visited` set\n            # and enqueue it for further exploration.\n            if next_state_hash not in visited:\n                visited.add(next_state_hash)\n                # Enqueue the next state along with the updated path.\n                q.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal was never reached, it implies that\n    # the desired item is unreachable from the initial state within the explored graph.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-29T23:10:54.704159", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  # For v2, the aggressive prioritization of the 'USE' action from previous versions\n  # is retained, as it can accelerate finding solutions where crafting or resource\n  # gathering actions are immediately relevant. This strategy is chosen to prioritize\n  # immediate goal-relevant actions such as picking up items or crafting.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS_PRIORITIZED = [USE, DOWN, UP, LEFT, RIGHT]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will commence from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Utilize a collections.deque for an efficient Breadth-First Search (BFS).\n  # Each element in the queue stores a tuple: (current_CraftState, list_of_actions_taken_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to maintain visited states, preventing redundant computations and cycles.\n  # A state is uniquely defined by its grid configuration, agent's position,\n  # facing direction, and current inventory. Numpy arrays are not hashable by default,\n  # so we convert them to bytes or tuples for use as dictionary/set keys.\n  def _get_state_hashable(state):\n      # Composes a hashable tuple from the state's essential components.\n      # grid.tobytes() provides a compact, hashable representation of the grid array.\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Define the maximum search depth to limit computational complexity and prevent\n  # excessively long plans for potentially unreachable goals. This value balances\n  # the ability to find complex solutions with practical execution time.\n  MAX_SEARCH_DEPTH = 500 # This depth aims to accommodate a reasonable range of crafting sequences.\n\n  # Begin the BFS exploration.\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal condition.\n      # CraftState.satisfies evaluates if the 'item' is present in the inventory.\n      if current_state.satisfies(None, item): # `goal_name` is an unused parameter in `CraftState.satisfies`.\n          return current_actions # Goal achieved, return the sequence of actions that led to this state.\n\n      # Pruning step: If the current action sequence exceeds the maximum allowed depth,\n      # discontinue this path to avoid exploring overly long or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Move to the next path in the queue.\n\n      # Iterate through all possible actions in their prioritized order.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Simulate the action's effect on the environment.\n          # CraftState.step handles all game logic (movement, resource gathering, crafting).\n          _reward, new_state = current_state.step(action)\n\n          # Obtain the hashable representation of the resulting new state.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been encountered previously, add it to the visited set\n          # and enqueue it for subsequent exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the search completes (queue becomes empty) without finding the goal,\n  # it indicates that the item cannot be crafted from the initial state within the defined search limits.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:11:32.674907", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  # For v2, the aggressive prioritization of the 'USE' action from previous versions\n  # is retained, as it can accelerate finding solutions where crafting or resource\n  # gathering actions are immediately relevant.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS_PRIORITIZED = [USE, DOWN, UP, LEFT, RIGHT]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      # Combine grid (as bytes), position, direction, and inventory (as tuple)\n      # to create a unique, hashable representation of the state.\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops\n  # in cases where the goal might be unreachable or require too many steps.\n  # This value (500) allows for significantly longer and potentially more complex\n  # crafting sequences compared to earlier versions (e.g., if a conceptual v1 had 300).\n  MAX_SEARCH_DEPTH = 500\n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # Explore all possible actions from the current state, using the prioritized order.\n      # The fixed 'USE' prioritization is maintained as a consistent strategy across versions.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:12:47.086634", "function_name": "craft", "function_body": "  import collections # Required for deque\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The _current_state attribute is used to access the internal CraftState object.\n  initial_state = env._current_state\n\n  # Define a function to generate a hashable representation of a CraftState.\n  # A state is uniquely identified by its grid layout, inventory contents,\n  # agent's position, and agent's facing direction.\n  # numpy arrays are converted to bytes for hashability.\n  def hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents redundant computations and infinite loops in cyclic environments.\n  visited = {hash_craft_state(initial_state)}\n\n  # Define the total number of possible actions (DOWN, UP, LEFT, RIGHT, USE).\n  N_ACTIONS = 5 \n  ACTION_USE = 4 # The index corresponding to the 'USE' action\n\n  # Set a maximum path length to prevent the search from running indefinitely\n  # in very complex or unsolvable scenarios. This value may need tuning based on\n  # the complexity of the specific CraftWorld recipes and map sizes.\n  MAX_PATH_LENGTH = 200 # A reasonable heuristic for typical crafting tasks.\n\n  # Start the BFS loop.\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the desired item is in inventory).\n      # The `goal_name` argument of `satisfies` is ignored based on its docstring,\n      # so we pass None.\n      if current_state.satisfies(None, item):\n          return current_path # Goal reached, return the sequence of actions.\n\n      # Pruning step: If the current path length exceeds the maximum allowed,\n      # stop exploring this branch to manage computational complexity.\n      if len(current_path) >= MAX_PATH_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      # Actions are typically represented by integers 0 through 4.\n      for action in range(N_ACTIONS):\n          # Improvement over craft_v1: Prune unproductive 'USE' actions early.\n          # The 'USE' action is only beneficial if the agent is next to a workshop,\n          # a resource (like stone or water), or a grabbable item.\n          if action == ACTION_USE:\n              is_next_to_useful_entity = False\n              world = current_state.world\n              \n              # Aggregate all indices of entities that are typically interacted with using 'USE'.\n              # This includes workshops, primitive resources (like stone/water), and other grabbable items.\n              potential_use_targets = set()\n              potential_use_targets.update(world.workshop_indices)\n              \n              if world.water_index is not None:\n                  potential_use_targets.add(world.water_index)\n              if world.stone_index is not None:\n                  potential_use_targets.add(world.stone_index)\n              \n              potential_use_targets.update(world.grabbable_indices)\n\n              # Check if the agent is adjacent to any of these potential targets.\n              for target_idx in potential_use_targets:\n                  if current_state.next_to(target_idx):\n                      is_next_to_useful_entity = True\n                      break\n              \n              # If the 'USE' action would not interact with anything useful, skip it.\n              # This avoids generating and checking a new state if the action is guaranteed to be a no-op\n              # with respect to environmental interaction relevant for crafting.\n              if not is_next_to_useful_entity:\n                  continue\n\n          # Apply the action to get the next state.\n          # The `reward` returned by `step` is not used in this pathfinding algorithm.\n          _, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_state_hash = hash_craft_state(next_state)\n\n          # If this next state has not been visited before, add it to the queue\n          # and mark it as visited.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              # Append the next state and the updated path (current path + new action) to the queue.\n              queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no valid\n  # path exists to craft the item within the defined constraints (e.g., MAX_PATH_LENGTH).\n  return [] # Return an empty list to indicate that no solution was found.", "island_id": 1, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:13:26.429240", "function_name": "craft", "function_body": "  import collections # Required for deque\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The _current_state attribute is used to access the internal CraftState object.\n  initial_state = env._current_state\n\n  # Define a function to generate a hashable representation of a CraftState.\n  # A state is uniquely identified by its grid layout, inventory contents,\n  # agent's position, and agent's facing direction.\n  # numpy arrays are converted to bytes for hashability.\n  def hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents redundant computations and infinite loops in cyclic environments.\n  visited = {hash_craft_state(initial_state)}\n\n  # Define the total number of possible actions (DOWN, UP, LEFT, RIGHT, USE).\n  N_ACTIONS = 5\n  ACTION_USE = 4 # The index corresponding to the 'USE' action\n\n  # Set a maximum path length to prevent the search from running indefinitely\n  # in very complex or unsolvable scenarios. This value may need tuning based on\n  # the complexity of the specific CraftWorld recipes and map sizes.\n  MAX_PATH_LENGTH = 200 # A reasonable heuristic for typical crafting tasks.\n\n  # Pre-calculate the set of entity indices that are generally useful to 'USE' next to.\n  # This optimization avoids redundant calculations inside the BFS loop.\n  world = initial_state.world\n  potential_use_targets = set()\n  potential_use_targets.update(world.workshop_indices)\n  if world.water_index is not None:\n      potential_use_targets.add(world.water_index)\n  if world.stone_index is not None:\n      potential_use_targets.add(world.stone_index)\n  potential_use_targets.update(world.grabbable_indices) # Grabbable items can also be 'used' (picked up)\n\n  # Start the BFS loop.\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the desired item is in inventory).\n      # The `goal_name` argument of `satisfies` is ignored based on its docstring,\n      # so we pass None.\n      if current_state.satisfies(None, item):\n          return current_path # Goal reached, return the sequence of actions.\n\n      # Pruning step: If the current path length exceeds the maximum allowed,\n      # stop exploring this branch to manage computational complexity.\n      if len(current_path) >= MAX_PATH_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      # Actions are typically represented by integers 0 through 4.\n      for action in range(N_ACTIONS):\n          # Improvement: Prune unproductive 'USE' actions.\n          # The 'USE' action is only beneficial if the agent is next to a workshop,\n          # a resource (like stone or water), or a grabbable item.\n          if action == ACTION_USE:\n              is_next_to_useful_entity = False\n              # Check if the agent is adjacent to any of the pre-calculated potential targets.\n              for target_idx in potential_use_targets:\n                  if current_state.next_to(target_idx):\n                      is_next_to_useful_entity = True\n                      break\n              \n              # If the 'USE' action would not interact with anything useful, skip it.\n              if not is_next_to_useful_entity:\n                  continue\n\n          # Apply the action to get the next state.\n          # The `reward` returned by `step` is not used in this pathfinding algorithm.\n          _, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_state_hash = hash_craft_state(next_state)\n\n          # If this next state has not been visited before, add it to the queue\n          # and mark it as visited.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              # Append the next state and the updated path (current path + new action) to the queue.\n              queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no valid\n  # path exists to craft the item within the defined constraints (e.g., MAX_PATH_LENGTH).\n  return [] # Return an empty list to indicate that no solution was found.", "island_id": 1, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:14:53.005069", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Define the order of actions to explore. Prioritize USE action as it often leads to\n  # significant state changes (e.g., picking up items, crafting).\n  ACTION_ORDER = [USE, UP, DOWN, LEFT, RIGHT]\n\n  # Maximum depth for BFS to prevent excessively long searches and manage computational resources.\n  # This value can be tuned based on expected problem complexity and available time.\n  # For many crafting scenarios, a path length of 50-100 steps might be a reasonable heuristic.\n  MAX_DEPTH = 100 \n\n  class BFSNode:\n    \"\"\"Helper class to store a state, the sequence of actions taken to reach it, and its depth.\"\"\"\n    def __init__(self, state, actions, depth):\n      self.state = state\n      self.actions = actions\n      self.depth = depth\n\n    def get_key(self):\n      \"\"\"\n      Returns a hashable representation of the current state.\n      This key is used to track visited states in the BFS to avoid redundant exploration\n      and ensure finding the shortest path (in terms of actions).\n      Numpy array's .tobytes() provides an efficient and hashable representation.\n      \"\"\"\n      return (self.state.grid.tobytes(), self.state.inventory.tobytes(), self.state.pos, self.state.dir)\n\n  # Get the initial state from the CraftLab environment.\n  # env._current_state is the starting point for our search.\n  initial_state = env._current_state\n\n  # Initialize the BFS queue and the set of visited states.\n  # The queue will hold BFSNode objects to be explored.\n  # The visited set will store the unique keys of states already added to the queue\n  # or fully explored, preventing cycles and redundant work.\n  q = deque()\n  start_node = BFSNode(initial_state, [], 0) # Initial state at depth 0 with no actions\n  q.append(start_node)\n\n  visited = set()\n  visited.add(start_node.get_key())\n\n  # Main BFS loop\n  while q:\n    current_node = q.popleft()\n    current_state = current_node.state\n    current_actions = current_node.actions\n    current_depth = current_node.depth\n\n    # Check if the goal condition is met in the current state.\n    # The goal is to have at least one instance of the 'item' in the inventory.\n    if current_state.inventory[item] > 0:\n      return current_actions # Goal achieved, return the sequence of actions\n\n    # Pruning: If the current search depth exceeds the maximum allowed,\n    # stop exploring this path. This limits the search space for practicality.\n    if current_depth >= MAX_DEPTH:\n      continue\n\n    # --- Start of Improvement for craft_v2 ---\n    # Determine if the USE action could be beneficial in the current state.\n    # If the agent is not next to any grabbable item or any workshop,\n    # the USE action is guaranteed to be a no-op (won't change state or inventory).\n    # Pruning such guaranteed no-op USE actions saves computation by avoiding unnecessary\n    # state copies and adding identical states to the queue.\n    is_useful_use_possible = False\n    \n    # Check if agent is next to any grabbable item (can be picked up)\n    for grabbable_idx in current_state.world.grabbable_indices:\n        if current_state.next_to(grabbable_idx):\n            is_useful_use_possible = True\n            break\n    \n    # If not next to a grabbable item, check if next to any workshop (can craft)\n    if not is_useful_use_possible:\n        for workshop_idx in current_state.world.workshop_indices:\n            if current_state.next_to(workshop_idx):\n                is_useful_use_possible = True\n                break\n    # --- End of Improvement for craft_v2 ---\n\n    # Explore all possible actions from the current state according to the defined order.\n    for action in ACTION_ORDER:\n      # --- Apply Improvement for craft_v2 ---\n      # Skip USE action if it's determined to be useless in this state.\n      if action == USE and not is_useful_use_possible:\n          continue\n      # --- End of Improvement for craft_v2 ---\n\n      # Simulate the action to get the next state without modifying the actual environment.\n      # CraftState.step returns a reward (which is 0.0 in this implementation) and the new state.\n      _, next_state = current_state.step(action)\n      \n      # Construct the path to the next state.\n      next_actions = current_actions + [action]\n\n      # Create a new BFSNode for the next state.\n      next_node = BFSNode(next_state, next_actions, current_depth + 1)\n      next_key = next_node.get_key()\n\n      # If this specific state (grid, inventory, position, direction) has not been\n      # visited via a shorter or equal path, add it to the queue for exploration.\n      if next_key not in visited:\n        visited.add(next_key)\n        q.append(next_node)\n\n  # If the queue becomes empty and the goal was not reached, it means:\n  # 1. The item cannot be crafted from the initial state (unreachable goal).\n  # 2. The path to craft the item exceeds the MAX_DEPTH limit.\n  # 3. The search space is too large to explore within reasonable time/memory.\n  return []", "island_id": 7, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:15:29.417383", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Action constants (from CraftLab.action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Define the order of actions to explore. Prioritize USE action as it often leads to\n  # significant state changes (e.g., picking up items, crafting).\n  ACTION_ORDER = [USE, UP, DOWN, LEFT, RIGHT]\n\n  # Maximum depth for BFS to prevent excessively long searches and manage computational resources.\n  # This value can be tuned based on expected problem complexity and available time.\n  # For many crafting scenarios, a path length of 50-100 steps might be a reasonable heuristic.\n  MAX_DEPTH = 100 \n\n  class BFSNode:\n    \"\"\"\n    Helper class to store a state, its parent node, the action taken from the parent\n    to reach this state, and its depth.\n    \n    Improvement in v2: Instead of storing the full list of actions (`self.actions` in v0/v1),\n    this version stores a `parent` reference and the `action_from_parent`. This avoids\n    expensive list concatenations for `next_actions = current_actions + [action]` in\n    each step of the BFS, leading to better memory and time performance, especially\n    for finding longer paths. The full path is reconstructed only when the goal is found.\n    \"\"\"\n    def __init__(self, state, parent=None, action_from_parent=None, depth=0):\n      self.state = state\n      self.parent = parent\n      self.action_from_parent = action_from_parent\n      self.depth = depth\n\n    def get_key(self):\n      \"\"\"\n      Returns a hashable representation of the current state.\n      This key is used to track visited states in the BFS to avoid redundant exploration\n      and ensure finding the shortest path (in terms of actions).\n      Numpy array's .tobytes() provides an efficient and hashable representation.\n      \"\"\"\n      return (self.state.grid.tobytes(), self.state.inventory.tobytes(), self.state.pos, self.state.dir)\n\n    def reconstruct_path(self):\n      \"\"\"\n      Reconstructs the sequence of actions from the initial state to this node\n      by traversing up the parent chain.\n      \"\"\"\n      path = []\n      node = self\n      while node.parent is not None:\n        path.append(node.action_from_parent)\n        node = node.parent\n      return list(reversed(path)) # Path is built backwards, so reverse it for correct order\n\n  # Get the initial state from the CraftLab environment.\n  # env._current_state is the starting point for our search.\n  initial_state = env._current_state\n\n  # Initialize the BFS queue and the set of visited states.\n  # The queue will hold BFSNode objects to be explored.\n  # The visited set will store the unique keys of states already added to the queue\n  # or fully explored, preventing cycles and redundant work.\n  q = deque()\n  start_node = BFSNode(initial_state) # Initial state at depth 0 with no parent/action\n  q.append(start_node)\n\n  visited = set()\n  visited.add(start_node.get_key())\n\n  # Main BFS loop\n  while q:\n    current_node = q.popleft()\n    current_state = current_node.state\n    current_depth = current_node.depth\n\n    # Check if the goal condition is met in the current state.\n    # The goal is to have at least one instance of the 'item' in the inventory.\n    if current_state.inventory[item] > 0:\n      return current_node.reconstruct_path() # Goal achieved, reconstruct and return the sequence of actions\n\n    # Pruning: If the current search depth exceeds the maximum allowed,\n    # stop exploring this path. This limits the search space for practicality.\n    if current_depth >= MAX_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state according to the defined order.\n    for action in ACTION_ORDER:\n      # Simulate the action to get the next state without modifying the actual environment.\n      # CraftState.step returns a reward (which is 0.0 in this implementation) and the new state.\n      _, next_state = current_state.step(action)\n      \n      # Create a new BFSNode for the next state, linking it to its parent (current_node).\n      next_node = BFSNode(next_state, parent=current_node, action_from_parent=action, depth=current_depth + 1)\n      next_key = next_node.get_key()\n\n      # If this specific state (grid, inventory, position, direction) has not been\n      # visited via a shorter or equal path, add it to the queue for exploration.\n      if next_key not in visited:\n        visited.add(next_key)\n        q.append(next_node)\n\n  # If the queue becomes empty and the goal was not reached, it means:\n  # 1. The item cannot be crafted from the initial state (unreachable goal).\n  # 2. The path to craft the item exceeds the MAX_DEPTH limit.\n  # 3. The search space is too large to explore within reasonable time/memory.\n  return []", "island_id": 7, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:16:35.812670", "function_name": "craft", "function_body": "  import collections # Need for deque\n  import numpy as np # Already imported in the example, but explicitly listed for clarity\n\n  \"\"\"Improved version of `craft_v1` using Breadth-First Search (BFS) for planning.\n  This version reinforces the robust BFS approach, ensuring optimal path discovery\n  in terms of action count within the given search limits.\"\"\"\n\n  # Get initial state by resetting the environment.\n  # This ensures we start from a consistent initial configuration for each planning attempt.\n  _ = env.reset() # The observation dictionary is not directly needed for planning, only the internal state.\n  initial_craft_state = env._current_state # Access the internal CraftState object managed by CraftLab.\n\n  goal_item_idx = item\n\n  # Retrieve concrete action integer values from the environment's action_specs.\n  # This makes the code robust to changes in action mappings, making it more portable.\n  action_map = env.action_specs()\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_UP = action_map['UP']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Use a deque for BFS, storing tuples of (current_craft_state, path_taken_to_reach_this_state).\n  # The path is a list of action integers representing the sequence of actions taken\n  # to reach the `current_craft_state` from the initial state.\n  q = collections.deque([(initial_craft_state, [])])\n\n  # Visited set to keep track of states already explored. This is crucial for:\n  # 1. Preventing redundant computations by avoiding re-processing states.\n  # 2. Avoiding infinite loops in cycles within the state space.\n  # A state is uniquely defined by:\n  # - Agent's position (pos)\n  # - Agent's facing direction (dir)\n  # - Current inventory contents (inventory)\n  # - Current grid layout (grid)\n  # Numpy arrays (inventory, grid) are converted to bytes using .tobytes() for hashability\n  # within the set.\n  def get_state_hash(state: 'CraftState'):\n      return (state.pos,\n              state.dir,\n              state.inventory.tobytes(),\n              state.grid.tobytes())\n\n  visited = set()\n  visited.add(get_state_hash(initial_craft_state))\n\n  # Set a maximum search depth/number of steps. This acts as a safeguard to:\n  # - Limit computation time and memory usage for very complex or unreachable goals.\n  # - Prevent the search from running indefinitely in large state spaces.\n  MAX_SEARCH_STEPS = 5000\n\n  while q:\n      current_state, current_path = q.popleft()\n\n      # Check if the current state satisfies the goal condition.\n      # The goal is met if the target item is present in the inventory with a count greater than 0.\n      if current_state.inventory[goal_item_idx] > 0:\n          return current_path\n\n      # Pruning: If the current path length exceeds the maximum allowed steps,\n      # stop exploring this branch. This helps manage the search space effectively.\n      if len(current_path) >= MAX_SEARCH_STEPS:\n          continue\n\n      # Explore all possible actions from the current state.\n      # This constitutes the core expansion step of the BFS.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step() returns (reward, new_state). `new_state` is a newly created CraftState object,\n          # ensuring the original `current_state` object remains unchanged for other branches in the BFS,\n          # which is vital for correct state exploration.\n          _reward, next_state = current_state.step(action)\n\n          next_state_hash = get_state_hash(next_state)\n\n          # If this next state has not been visited yet, add it to the queue for future exploration\n          # and mark it as visited to prevent redundant processing.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              q.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the goal is\n  # unreachable within the defined search limits (MAX_SEARCH_STEPS) from the initial state\n  # in this specific CraftScenario setup.\n  return []", "island_id": 4, "scores": {"3": 1.7}}
