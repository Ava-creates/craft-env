{"timestamp": "2025-07-29T23:28:18.425355", "function_name": "craft", "function_body": "  # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n  # Delta movements for actions/directions.\n  # The direction values 0-3 correspond to UP, DOWN, LEFT, RIGHT actions.\n  # dir 0: UP (y-1), 1: DOWN (y+1), 2: LEFT (x-1), 3: RIGHT (x+1)\n  MOVE_DELTAS = {\n      UP: (0, -1),\n      DOWN: (0, 1),\n      LEFT: (-1, 0),\n      RIGHT: (1, 0)\n  }\n\n  # Reference to world components\n  world = env.world\n  cookbook = world.cookbook\n\n  # Internal state representation for simulation.\n  # This `sim_state` will be passed by reference and modified by the recursive planner.\n  # This implies a greedy depth-first planning approach.\n  sim_state = {\n      'grid': np.copy(env._current_state.grid),  # Current grid layout\n      'inventory': np.copy(env._current_state.inventory),  # Current inventory counts\n      'pos': env._current_state.pos,  # Agent's current position (x, y)\n      'dir': env._current_state.dir  # Agent's current facing direction (0-3)\n  }\n\n  # Global list to accumulate all actions planned\n  total_actions = []\n\n  # Helper function for BFS pathfinding to an adjacent cell, and facing the target item/workshop.\n  def _find_path_to_adjacent_and_face(start_pos, start_dir, target_kind_idx, current_grid):\n      \"\"\"\n      Finds a path (list of actions) that leads the agent from `start_pos`, `start_dir`\n      to a position where it is adjacent to and facing an item of `target_kind_idx`.\n\n      Args:\n          start_pos (tuple): Agent's starting (x, y) position.\n          start_dir (int): Agent's starting direction (0-3).\n          target_kind_idx (int): The index of the item/workshop to find.\n          current_grid (numpy.ndarray): The current grid state for pathfinding.\n\n      Returns:\n          tuple: (list_of_actions, item_pos_on_grid_faced) or (None, None) if no path.\n          `list_of_actions` moves the agent to the adjacent cell and sets its facing direction.\n          `item_pos_on_grid_faced` is the (x,y) of the item/workshop on the grid that is faced.\n      \"\"\"\n      WIDTH, HEIGHT, _ = current_grid.shape\n\n      # BFS Queue: (current_pos, current_dir, path_so_far)\n      q = [(start_pos, start_dir, [])]\n      # Visited set to avoid cycles and redundant computation: (pos_tuple, dir_int)\n      visited = set([(start_pos, start_dir)])\n\n      head = 0\n      while head < len(q):\n          (curr_x, curr_y), curr_d, path = q[head]\n          head += 1\n\n          # Check if current state (pos, dir) allows direct USE on target_kind_idx\n          # The cell directly in front of the agent:\n          face_x, face_y = curr_x + MOVE_DELTAS[curr_d][0], curr_y + MOVE_DELTAS[curr_d][1]\n\n          if 0 <= face_x < WIDTH and 0 <= face_y < HEIGHT:\n              # Check if the target item/workshop is in the cell faced by the agent\n              if current_grid[face_x, face_y, target_kind_idx] > 0:\n                  return path, (face_x, face_y)  # Path found, and the location of the item being faced\n\n          # Explore neighbors by moving\n          for action_move, (dx, dy) in MOVE_DELTAS.items():\n              next_x, next_y = curr_x + dx, curr_y + dy\n              next_d = action_move  # Agent's direction after this move is the move action itself\n\n              if 0 <= next_x < WIDTH and 0 <= next_y < HEIGHT and \\\n                 ((next_x, next_y), next_d) not in visited:\n                  visited.add(((next_x, next_y), next_d))\n                  q.append(((next_x, next_y), next_d, path + [action_move]))\n\n      return None, None  # No path found to an adjacent and facing position\n\n  # Recursive planner function\n  def _plan_item(target_idx):\n      \"\"\"\n      Plans actions to obtain `target_idx` and appends them to `total_actions`,\n      updating the `sim_state` as it goes.\n\n      Args:\n          target_idx (int): The index of the item to obtain.\n\n      Returns:\n          bool: True if planning for `target_idx` was successful, False otherwise.\n      \"\"\"\n      # Base case: Item is already in inventory\n      if sim_state['inventory'][target_idx] > 0:\n          return True\n\n      # Case 1: Target is a primitive item (can be picked up from the grid)\n      if target_idx in cookbook.primitives:\n          path_actions, item_loc = _find_path_to_adjacent_and_face(\n              sim_state['pos'], sim_state['dir'], target_idx, sim_state['grid']\n          )\n\n          if path_actions is None:\n              return False  # Cannot find or reach the primitive item\n\n          # Execute movements in simulated state\n          for action in path_actions:\n              total_actions.append(action)\n              dx, dy = MOVE_DELTAS[action]\n              sim_state['pos'] = (sim_state['pos'][0] + dx, sim_state['pos'][1] + dy)\n              sim_state['dir'] = action\n\n          # After positioning and facing, perform USE action to pick up\n          total_actions.append(USE)\n          sim_state['inventory'][target_idx] += 1  # Add item to inventory\n          sim_state['grid'][item_loc[0], item_loc[1], target_idx] -= 1  # Remove one item from grid\n          \n          return True\n\n      # Case 2: Target is a craftable item (requires a recipe)\n      recipe = cookbook.recipes.get(target_idx)\n      if recipe is None:\n          return False  # Not a primitive and no recipe found, impossible to obtain\n\n      # Gather ingredients recursively\n      ingredients_to_get = {k: v for k, v in recipe.items() if k != '_key'}\n\n      # Greedily attempt to gather each missing ingredient\n      # Loop while any ingredient count is not met\n      while any(sim_state['inventory'][ing_idx] < count for ing_idx, count in ingredients_to_get.items()):\n          found_missing_ingredient_to_plan = False\n          # Iterate through ingredients to find one that is still needed\n          for ing_idx, count_needed in ingredients_to_get.items():\n              if sim_state['inventory'][ing_idx] < count_needed:\n                  # Recursively plan to get one instance of this ingredient\n                  if not _plan_item(ing_idx):\n                      return False  # Failed to get a required ingredient\n                  found_missing_ingredient_to_plan = True\n                  break # Break and re-evaluate all ingredients, as state has changed\n\n          if not found_missing_ingredient_to_plan:\n              # This means `any` was true but we couldn't find an ingredient to plan for.\n              # Could happen if ingredients are not reachable/craftable.\n              return False \n\n      # All ingredients are now in inventory (in simulation).\n      # Now, go to the workshop (if specified) and perform crafting.\n      workshop_name = recipe.get('_key')\n      if workshop_name:\n          workshop_idx = cookbook.index.contents[workshop_name]\n          \n          path_actions, workshop_loc = _find_path_to_adjacent_and_face(\n              sim_state['pos'], sim_state['dir'], workshop_idx, sim_state['grid']\n          )\n          \n          if path_actions is None:\n              return False  # Cannot reach the required workshop\n\n          # Execute movements to workshop in simulated state\n          for action in path_actions:\n              total_actions.append(action)\n              dx, dy = MOVE_DELTAS[action]\n              sim_state['pos'] = (sim_state['pos'][0] + dx, sim_state['pos'][1] + dy)\n              sim_state['dir'] = action\n          \n          # Perform USE action at the workshop\n          total_actions.append(USE)\n          \n          # Simulate consumption of ingredients and production of target item\n          for ing_idx, count in ingredients_to_get.items():\n              sim_state['inventory'][ing_idx] -= count\n          sim_state['inventory'][target_idx] += 1\n          \n          return True\n      else:\n          # A recipe without a '_key' (workshop) implies special crafting or an error\n          # in the recipe definition for this context. For this problem, we assume\n          # all standard crafting requires a workshop.\n          return False # Cannot craft without a specified workshop\n\n\n  # Start the planning process for the top-level item\n  if _plan_item(item):\n      return total_actions\n  else:\n      return []  # Return empty list if planning fails", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-29T23:29:57.577202", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants, as per CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  start_state = env._current_state\n  target_item_idx = item\n\n  # If the item is already in the inventory, no actions are needed.\n  if start_state.satisfies(None, target_item_idx):\n    return []\n\n  # Helper function to create a unique, hashable representation of a state.\n  # This is crucial for the `visited` set to avoid redundant computations and cycles.\n  def _hash_state(state):\n    return (\n        state.grid.tobytes(),  # Convert numpy array to bytes for hashing\n        state.pos,\n        state.dir,\n        state.inventory.tobytes() # Convert numpy array to bytes for hashing\n    )\n\n  def _should_prioritize_use(current_state, target_item_idx, env_world):\n    \"\"\"\n    Determines if the 'USE' action should be prioritized based on the current\n    state and the target item's requirements. This makes the 'USE' action\n    more targeted.\n    \"\"\"\n    # Get the recipe for the target item. If None, it means the target itself is a primitive.\n    target_recipe = env_world.cookbook.recipes.get(target_item_idx)\n\n    # Case 1: The target item is a primitive (not crafted, e.g., 'wood', 'stone').\n    if target_recipe is None:\n      # Prioritize 'USE' only if the agent is directly next to the specific primitive target.\n      return current_state.next_to(target_item_idx)\n    # Case 2: The target item is crafted (has a recipe).\n    else:\n      # Get all base primitive components needed for the final goal (this accounts for nested recipes).\n      required_primitives_for_goal = env_world.cookbook.primitives_for(target_item_idx)\n      \n      all_primitives_collected = True\n      needed_primitives_indices = set() # Keep track of specific primitive indices we still need.\n\n      # Check if all required primitives are already in the current inventory.\n      for prim_idx, count in required_primitives_for_goal.items():\n        if current_state.inventory[prim_idx] < count:\n          all_primitives_collected = False\n          needed_primitives_indices.add(prim_idx) # Add to the set of primitives that are still missing.\n\n      if all_primitives_collected:\n        # If all primitive ingredients are collected, prioritize 'USE' only if next to a workshop.\n        # This implies we are ready to craft the final item or an intermediate component.\n        return any(current_state.next_to(idx) for idx in env_world.workshop_indices)\n      else:\n        # If ingredients are still missing, prioritize 'USE' if next to a needed grabbable primitive.\n        # Iterate through all grabbable items in the world. If we are next to one, and it's\n        # an item we currently need, then 'USE' is a good action.\n        for grabbable_idx in env_world.grabbable_indices:\n          if current_state.next_to(grabbable_idx) and grabbable_idx in needed_primitives_indices:\n            return True # Found a grabbable item we are next to and actively need.\n        return False # Not next to any currently needed grabbable item.\n\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_state, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(start_state, [])])\n\n  # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n  # States are stored using their hashable representation.\n  visited = {_hash_state(start_state)}\n\n  # Maximum exploration steps for the BFS.\n  # This limit helps prevent extremely long searches in complex environments, acting as a safeguard.\n  MAX_EXPLORE_STEPS = 750 # This value can be adjusted based on problem complexity and desired runtime.\n\n  while queue:\n    current_state, path_actions = queue.popleft()\n\n    # If the current path has exceeded the maximum allowed exploration steps,\n    # do not expand it further to manage computational complexity.\n    if len(path_actions) >= MAX_EXPLORE_STEPS:\n      continue\n\n    # Dynamically determine the order of actions based on the refined prioritization logic.\n    actions_to_try = []\n\n    if _should_prioritize_use(current_state, target_item_idx, env.world):\n      actions_to_try.append(USE)\n    \n    # Always add movement actions after checking for a prioritized 'USE' action.\n    actions_to_try.extend([DOWN, UP, LEFT, RIGHT])\n\n    for action in actions_to_try:\n      # Simulate taking the action to get the next state.\n      # CraftState.step returns (reward, new_state). Reward is typically 0.0 in this environment.\n      _reward, next_state = current_state.step(action)\n\n      # Check if the goal item is satisfied in the newly reached state.\n      if next_state.satisfies(None, target_item_idx):\n        return path_actions + [action] # Goal reached! Return the sequence of actions.\n\n      # Get the hashable representation of the next state.\n      next_state_hash = _hash_state(next_state)\n\n      # If this next state has not been visited before, add it to the queue\n      # for further exploration and mark it as visited.\n      # This also implicitly handles \"null\" actions (e.g., trying to walk into a wall,\n      # or a 'USE' action that doesn't change the state) because in such cases,\n      # next_state_hash would be identical to current_state_hash, which is already visited.\n      if next_state_hash not in visited:\n        visited.add(next_state_hash)\n        queue.append((next_state, path_actions + [action]))\n\n  # If the queue becomes empty and the goal was not reached within the exploration limits,\n  # it means no path was found.\n  return []", "island_id": 9, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:30:24.407916", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants, as per CraftLab.action_specs()\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  start_state = env._current_state\n  target_item_idx = item\n\n  # If the item is already in the inventory, no actions are needed.\n  if start_state.satisfies(None, target_item_idx):\n    return []\n\n  # Helper function to create a unique, hashable representation of a state.\n  # This is crucial for the `visited` set to avoid redundant computations and cycles.\n  def _hash_state(state):\n    return (\n        state.grid.tobytes(),  # Convert numpy array to bytes for hashing\n        state.pos,\n        state.dir,\n        state.inventory.tobytes() # Convert numpy array to bytes for hashing\n    )\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_state, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(start_state, [])])\n\n  # Initialize a set to keep track of visited states to prevent cycles and redundant exploration.\n  # States are stored using their hashable representation.\n  visited = {_hash_state(start_state)}\n\n  # Maximum exploration steps for the BFS.\n  # This limit helps prevent extremely long searches in complex environments.\n  # The value is chosen to balance between finding solutions for difficult recipes\n  # and keeping the search computationally tractable.\n  MAX_EXPLORE_STEPS = 750\n\n  # Pre-compute all ultimate primitive requirements for the goal.\n  # This returns a dictionary mapping primitive-kind indices to counts required.\n  # If the target_item_idx itself is a primitive, this dict will be empty.\n  goal_primitive_requirements = env.world.cookbook.primitives_for(target_item_idx)\n\n  # Determine if the target item is a primitive itself and if it's currently needed.\n  # This is a special case as primitives are typically picked up, not crafted via recipes.\n  target_is_primitive_and_needed = False\n  if target_item_idx in env.world.cookbook.primitives and not start_state.satisfies(None, target_item_idx):\n    target_is_primitive_and_needed = True\n    # If the goal is a primitive, we implicitly need 1 of it.\n    # Add it to the requirements so it's considered in missing_primitive_ingredients.\n    if target_item_idx not in goal_primitive_requirements:\n        goal_primitive_requirements[target_item_idx] = 1\n\n\n  while queue:\n    current_state, path_actions = queue.popleft()\n\n    # If the current path has exceeded the maximum allowed exploration steps,\n    # do not expand it further to manage computational complexity.\n    if len(path_actions) >= MAX_EXPLORE_STEPS:\n      continue\n\n    # List to build actions in prioritized order.\n    actions_to_consider = []\n\n    # 1. Determine which primitive ingredients (including the target if it's a primitive goal)\n    #    are still missing from the current inventory for the overall goal.\n    missing_primitive_ingredients = set()\n    for prim_idx, needed_count in goal_primitive_requirements.items():\n        if current_state.inventory[prim_idx] < needed_count:\n            missing_primitive_ingredients.add(prim_idx)\n\n    # 2. Check adjacency to important locations/items.\n    is_next_to_workshop = any(current_state.next_to(idx) for idx in env.world.workshop_indices)\n    \n    # Check if agent is next to a grabbable item that is one of the *missing* primitive ingredients.\n    is_next_to_useful_grabbable_item = False\n    for grabbable_idx in env.world.grabbable_indices:\n        if grabbable_idx in missing_primitive_ingredients and current_state.next_to(grabbable_idx):\n            is_next_to_useful_grabbable_item = True\n            break\n            \n    # Check if next to *any* grabbable item (even if not currently identified as 'missing').\n    is_next_to_any_grabbable_item = any(current_state.next_to(idx) for idx in env.world.grabbable_indices)\n\n\n    # Prioritization for 'USE' action:\n    # Option A: Highest priority - Crafting the final goal if all recursive primitive ingredients\n    #           are met AND agent is next to a workshop. This only applies if the target is NOT a primitive.\n    if not target_is_primitive_and_needed:\n        all_primitives_are_met = all(current_state.inventory[idx] >= count for idx, count in goal_primitive_requirements.items())\n        if is_next_to_workshop and all_primitives_are_met:\n            actions_to_consider.append(USE)\n    \n    # Option B: High priority - Picking up a useful grabbable item (a missing primitive ingredient).\n    # This covers both intermediate primitive collection and picking up the target itself if it's a primitive.\n    if is_next_to_useful_grabbable_item:\n        if USE not in actions_to_consider: # Add if not already added by Option A\n            actions_to_consider.append(USE)\n\n    # Option C: General 'USE' if next to any workshop or any grabbable.\n    # This serves as a broader fallback, allowing for intermediate crafts or picking up\n    # items that might become useful later, even if not immediately marked as 'missing'.\n    if is_next_to_workshop or is_next_to_any_grabbable_item:\n        if USE not in actions_to_consider: # Add if not already added by more specific rules\n            actions_to_consider.append(USE)\n\n    # Always include movement actions.\n    # The order here ensures movement is tried after prioritized USE actions.\n    actions_to_consider.extend([DOWN, UP, LEFT, RIGHT])\n\n    # Ensure uniqueness of actions while preserving the order of first appearance.\n    # This prevents redundant attempts of the same action within a single state exploration.\n    final_actions_to_try = []\n    seen_actions = set()\n    for action in actions_to_consider:\n        if action not in seen_actions:\n            final_actions_to_try.append(action)\n            seen_actions.add(action)\n\n    for action in final_actions_to_try:\n      # Simulate taking the action to get the next state.\n      _reward, next_state = current_state.step(action)\n\n      # Check if the goal item is satisfied in the newly reached state.\n      if next_state.satisfies(None, target_item_idx):\n        return path_actions + [action] # Goal reached! Return the sequence of actions.\n\n      # Get the hashable representation of the next state.\n      next_state_hash = _hash_state(next_state)\n\n      # If this next state has not been visited before, add it to the queue\n      # for further exploration and mark it as visited.\n      if next_state_hash not in visited:\n        visited.add(next_state_hash)\n        queue.append((next_state, path_actions + [action]))\n\n  # If the queue becomes empty and the goal was not reached within the exploration limits,\n  # it means no path was found.\n  return []", "island_id": 9, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:32:42.179607", "function_name": "craft", "function_body": "  import collections # Required for deque\n  import heapq # Required for A* priority queue\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The _current_state attribute is used to access the internal CraftState object.\n  initial_state = env._current_state\n\n  # Access the Cookbook instance from the CraftWorld object, which is part of the CraftState.\n  cookbook = initial_state.world.cookbook\n\n  # Define a function to generate a hashable representation of a CraftState.\n  # A state is uniquely identified by its grid layout, inventory contents,\n  # agent's position, and agent's facing direction.\n  # numpy arrays are converted to bytes for hashability.\n  def hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Heuristic function for A* search: estimates the minimum number of \"primitive acquisition\" actions needed.\n  # It counts the total quantity of missing primitive resources required to craft the goal item.\n  # This heuristic is admissible (never overestimates the true cost) because each missing primitive unit\n  # requires at least one action (either pickup or a crafting step that consumes other primitives).\n  def heuristic(state, goal_idx, cookbook_obj):\n      # If the goal is already satisfied, the estimated cost is 0.\n      if state.satisfies(None, goal_idx):\n          return 0\n\n      # Special case: If the goal itself is a primitive item (e.g., 'water', 'stone'),\n      # `cookbook_obj.primitives_for()` might return an empty dict as it's not \"crafted\" from other primitives.\n      # If the agent doesn't have this primitive, it still needs at least one action (e.g., 'pickup').\n      if goal_idx in cookbook_obj.primitives:\n          if state.inventory[goal_idx] == 0:\n              return 1 # At least one action (like moving to and using/picking up) is needed.\n          else:\n              return 0 # Agent already possesses the primitive, no additional cost for it.\n\n      # For non-primitive goals, calculate the total count of missing primitive ingredients.\n      # `primitives_for` recursively resolves all ingredients down to their base primitives.\n      required_primitives = cookbook_obj.primitives_for(goal_idx)\n      \n      h_score = 0\n      for primitive_idx, required_count in required_primitives.items():\n          current_count = state.inventory[primitive_idx]\n          missing = max(0, required_count - current_count)\n          h_score += missing # Sum of all missing primitive units\n\n      # Fallback: If a non-primitive goal has no primitive requirements (e.g., its recipe is unknown\n      # or leads to unresolvable items) and the goal is not satisfied, it implies it's uncraftable\n      # via this primitive-based path. Return a very large number (infinity) to discourage this path.\n      if not required_primitives and not state.satisfies(None, goal_idx):\n          return float('inf')\n          \n      return h_score\n\n  # A* search data structures:\n  # priority_queue: Stores (f_score, g_score, unique_id, state_hash, state_object) tuples.\n  #                 heapq ensures the lowest f_score is popped first. g_score and unique_id\n  #                 are for tie-breaking.\n  priority_queue = [] \n  \n  # g_scores: A dictionary mapping state_hash to the shortest known cost (g_score) to reach that state.\n  g_scores = {hash_craft_state(initial_state): 0}\n  \n  # path_map: A dictionary mapping state_hash to (action_taken, previous_state_hash).\n  #           This allows reconstructing the path by tracing back from the goal state.\n  path_map = {hash_craft_state(initial_state): []} # Initial state has no preceding action/state.\n\n  # Initialize the priority queue with the start state.\n  initial_h = heuristic(initial_state, item, cookbook)\n  initial_f = initial_h # g_score for start state is 0.\n  \n  # unique_counter: Used for tie-breaking in heapq to ensure consistent ordering for states\n  #                 with identical f_score and g_score.\n  unique_counter = 0 \n  heapq.heappush(priority_queue, (initial_f, 0, unique_counter, hash_craft_state(initial_state), initial_state))\n  unique_counter += 1\n\n  N_ACTIONS = 5 # Total number of possible actions (DOWN, UP, LEFT, RIGHT, USE)\n  ACTION_USE = 4 # Index for the 'USE' action\n  MAX_PATH_LENGTH = 200 # A safety limit to prevent excessively long searches for complex problems.\n\n  # Pre-calculate potential use targets for efficiency in the 'USE' action pruning.\n  # This includes workshops, primitive resources (water, stone), and other grabbable items.\n  world = initial_state.world\n  potential_use_targets = set()\n  potential_use_targets.update(world.workshop_indices)\n  if world.water_index is not None:\n      potential_use_targets.add(world.water_index)\n  if world.stone_index is not None:\n      potential_use_targets.add(world.stone_index)\n  potential_use_targets.update(world.grabbable_indices)\n\n  # A* search loop.\n  while priority_queue:\n      # Pop the state with the lowest f_score from the priority queue.\n      current_f, current_g, _, current_state_hash, current_state = heapq.heappop(priority_queue)\n\n      # Check for stale entries: If we found a shorter path to this state previously,\n      # this entry from the priority queue is outdated; skip it.\n      if current_g > g_scores.get(current_state_hash, float('inf')):\n          continue\n\n      # Goal check: If the current state satisfies the goal (item is crafted),\n      # reconstruct and return the path.\n      if current_state.satisfies(None, item):\n          path = []\n          state_to_reconstruct = current_state_hash\n          # Trace back using path_map until the initial state is reached.\n          while state_to_reconstruct != hash_craft_state(initial_state):\n              action, prev_state_hash = path_map[state_to_reconstruct]\n              path.append(action)\n              state_to_reconstruct = prev_state_hash\n          return path[::-1] # Reverse the path to get it in forward order.\n\n      # Pruning by path length: If the current path is too long, stop exploring this branch.\n      if current_g >= MAX_PATH_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for action in range(N_ACTIONS):\n          # Pruning for the 'USE' action: Only consider 'USE' if the agent is next to a useful entity.\n          if action == ACTION_USE:\n              is_next_to_useful_entity = False\n              for target_idx in potential_use_targets:\n                  if current_state.next_to(target_idx):\n                      is_next_to_useful_entity = True\n                      break\n              if not is_next_to_useful_entity:\n                  continue # Skip this 'USE' action if it's not productive.\n\n          # Apply the action to get the next state.\n          # The reward (first return value) is not used in this pathfinding algorithm.\n          _, next_state = current_state.step(action)\n          next_state_hash = hash_craft_state(next_state)\n          \n          # Calculate the g_score (cost from start) for the next state. Each action costs 1.\n          new_g = current_g + 1\n\n          # If this path to next_state is shorter than any previously found path to it,\n          # or if next_state hasn't been visited yet:\n          if new_g < g_scores.get(next_state_hash, float('inf')):\n              g_scores[next_state_hash] = new_g # Update the shortest g_score.\n              path_map[next_state_hash] = (action, current_state_hash) # Record how to reach this state.\n              \n              # Calculate the heuristic (estimated cost to goal) for the next state.\n              next_h = heuristic(next_state, item, cookbook)\n              # Calculate the f_score (total estimated cost) for the next state.\n              next_f = new_g + next_h\n              \n              # Add the next state to the priority queue.\n              heapq.heappush(priority_queue, (next_f, new_g, unique_counter, next_state_hash, next_state))\n              unique_counter += 1 # Increment unique counter for future tie-breaking.\n                \n  # If the priority queue becomes empty and the goal was not reached, it means no valid\n  # path exists to craft the item within the defined constraints (e.g., MAX_PATH_LENGTH).\n  return [] # Return an empty list to indicate that no solution was found.", "island_id": 1, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:33:23.373160", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The _current_state attribute provides access to the internal CraftState object.\n  initial_state = env._current_state\n\n  def hash_craft_state(state):\n      \"\"\"\n      Generates a hashable representation of a CraftState.\n      A state is uniquely identified by its grid layout, inventory contents,\n      agent's position, and agent's facing direction.\n      Numpy arrays are converted to bytes for hashability.\n      \"\"\"\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple:\n  # (current_CraftState, hash_of_current_state, depth_of_current_state_in_path)\n  initial_hash = hash_craft_state(initial_state)\n  queue = collections.deque([(initial_state, initial_hash, 0)])\n\n  # Initialize a dictionary to keep track of visited states and their parent information.\n  # This enables path reconstruction after the goal is found.\n  # visited: {state_hash: (parent_state_hash, action_from_parent)}\n  # For the initial state, parent_state_hash and action_from_parent are None.\n  visited = {initial_hash: (None, None)}\n\n  # Define the total number of possible actions (DOWN, UP, LEFT, RIGHT, USE).\n  N_ACTIONS = 5 \n  ACTION_USE = 4 # The index corresponding to the 'USE' action\n\n  # Set a maximum path length to prevent the search from running indefinitely\n  # in very complex or unsolvable scenarios. This value may need tuning.\n  MAX_PATH_LENGTH = 200\n\n  # Pre-fetch world and cookbook objects for efficiency.\n  world = env.world\n  cookbook = world.cookbook\n\n  # Pre-calculate the total primitive requirements for the final goal item.\n  # This dict maps primitive item indices to the total count needed.\n  # This helps in smart pruning of 'USE' actions.\n  primitive_requirements_for_goal = cookbook.primitives_for(item)\n\n  # Start the BFS loop.\n  while queue:\n      current_state, current_hash, depth = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the desired item is in inventory).\n      # The `goal_name` argument of `satisfies` is ignored based on its docstring, so we pass None.\n      if current_state.satisfies(None, item):\n          # Goal reached! Reconstruct the path by backtracking from the current_hash\n          # using the parent pointers stored in the `visited` dictionary.\n          path = []\n          node_hash = current_hash\n          # Traverse back until the initial state (whose parent is None)\n          while visited[node_hash][0] is not None:\n              parent_hash, action_to_reach_current = visited[node_hash]\n              path.insert(0, action_to_reach_current) # Prepend action to build path in correct order\n              node_hash = parent_hash # Move to the parent's hash\n          return path # Return the sequence of actions\n\n      # Pruning step: If the current path length (depth) exceeds the maximum allowed,\n      # stop exploring this branch to manage computational complexity.\n      if depth >= MAX_PATH_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      for action in range(N_ACTIONS):\n          if action == ACTION_USE:\n              # --- Improved 'USE' action pruning logic ---\n              # This ensures 'USE' actions are only considered if they are potentially beneficial.\n              is_next_to_useful_entity = False\n              \n              # 1. Check if next to a primitive resource that is *still needed* for the goal.\n              # This is more targeted than just checking any grabbable.\n              current_inventory = current_state.inventory\n              for prim_idx, count_needed in primitive_requirements_for_goal.items():\n                  if current_inventory[prim_idx] < count_needed and current_state.next_to(prim_idx):\n                      is_next_to_useful_entity = True\n                      break\n              \n              # 2. If not useful from primitives, check if next to any workshop.\n              # Workshops are crucial for crafting intermediate or final items.\n              if not is_next_to_useful_entity:\n                  for workshop_idx in world.workshop_indices:\n                      if current_state.next_to(workshop_idx):\n                          is_next_to_useful_entity = True\n                          break\n              \n              # 3. If still not useful, check for water and stone specifically (if they exist and are not covered by primitives).\n              if not is_next_to_useful_entity and world.water_index is not None and current_state.next_to(world.water_index):\n                  is_next_to_useful_entity = True\n              if not is_next_to_useful_entity and world.stone_index is not None and current_state.next_to(world.stone_index):\n                  is_next_to_useful_entity = True\n              \n              # 4. Lastly, check if next to any other grabbable item.\n              # This covers items that might be useful but aren't strictly primitives for the final goal\n              # (e.g., tools, other intermediate products).\n              if not is_next_to_useful_entity:\n                  for grabbable_idx in world.grabbable_indices:\n                      if current_state.next_to(grabbable_idx):\n                          is_next_to_useful_entity = True\n                          break\n\n              # If after all checks, 'USE' is not next to anything considered useful, skip this action.\n              if not is_next_to_useful_entity:\n                  continue\n\n          # Apply the action to get the next state.\n          # The `reward` returned by `step` is not used in this pathfinding algorithm.\n          _, next_state = current_state.step(action)\n          next_state_hash = hash_craft_state(next_state)\n\n          # If this next state has not been visited before, add it to the queue\n          # and record its parent and the action taken to reach it.\n          if next_state_hash not in visited:\n              visited[next_state_hash] = (current_hash, action) # Store parent hash and action\n              queue.append((next_state, next_state_hash, depth + 1)) # Add to queue with incremented depth\n\n  # If the queue becomes empty and the goal was not reached, it means no valid\n  # path exists to craft the item within the defined constraints (e.g., MAX_PATH_LENGTH).\n  return [] # Return an empty list to indicate that no solution was found.", "island_id": 1, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T23:34:46.681515", "function_name": "craft", "function_body": "    # Define action constants (assuming these are the integer values expected by CraftLab.step)\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n\n    world = env.world\n    cookbook = world.cookbook\n    all_actions = []\n\n    # Start with a copy of the environment's current state for simulation\n    # This is crucial as we are planning, not executing steps on the actual environment yet.\n    simulated_state = CraftState(env._current_state.scenario, \n                                 env._current_state.grid.copy(), \n                                 env._current_state.pos, \n                                 env._current_state.dir, \n                                 env._current_state.inventory.copy())\n\n    def _find_path_and_interact(start_sim_state, target_kind_idx):\n        \"\"\"\n        Finds a path to an object/workshop of target_kind_idx and returns actions + new simulated state.\n        This uses a Breadth-First Search (BFS) on (position, direction) states.\n        It simulates `CraftState.step` to determine new states during the search.\n        \"\"\"\n        q = collections.deque([((start_sim_state.pos, start_sim_state.dir), start_sim_state, [])])\n        # Visited set tracks (position, direction) tuples to avoid cycles and redundant exploration\n        visited = set()\n        visited.add((start_sim_state.pos, start_sim_state.dir))\n\n        while q:\n            (current_pos, current_dir), current_sim_state_in_search, current_path = q.popleft()\n\n            # Check if we are at or next to the target_kind_idx\n            # np.argwhere finds all locations (rows, cols) where target_kind_idx is present\n            target_locations = np.argwhere(current_sim_state_in_search.grid[:, :, target_kind_idx] > 0)\n            \n            is_at_or_next_to_target = False\n            for r, c in target_locations:\n                # Check 3x3 neighborhood (Manhattan distance <= 1 for direct adjacency or on cell)\n                if abs(r - current_pos[0]) <= 1 and abs(c - current_pos[1]) <= 1:\n                    is_at_or_next_to_target = True\n                    break\n\n            if is_at_or_next_to_target:\n                # If next to the target, add the USE action and return the path\n                # Simulate the USE action to get the resulting state (e.g., item picked up, item crafted)\n                reward, new_state_after_use = current_sim_state_in_search.step(USE)\n                return current_path + [USE], new_state_after_use\n\n            # Explore neighbors by trying all movement actions\n            for action in [DOWN, UP, LEFT, RIGHT]:\n                # Simulate the move action. `current_sim_state_in_search.step` returns a *new* state object.\n                reward, next_sim_state = current_sim_state_in_search.step(action)\n                next_pos_dir = (next_sim_state.pos, next_sim_state.dir)\n\n                if next_pos_dir not in visited:\n                    visited.add(next_pos_dir)\n                    q.append((next_pos_dir, next_sim_state, current_path + [action]))\n        \n        # No path found to the target kind\n        return [], start_sim_state \n\n    # Recursive helper to plan actions for a single item (or its sub-ingredients)\n    def _craft_recursive(target_item_idx):\n        nonlocal simulated_state, all_actions # These keywords allow modification of outer scope variables\n\n        # Base case 1: If the target item is already in the simulated inventory, we're done with this sub-goal.\n        if simulated_state.inventory[target_item_idx] > 0:\n            return True\n\n        recipe = cookbook.recipes.get(target_item_idx)\n\n        if recipe is None:\n            # If there's no recipe for the item, it must be a primitive resource or an environment object.\n            # Try to acquire it by picking it up, if it's a grabbable primitive.\n            if target_item_idx in cookbook.primitives and target_item_idx in world.grabbable_indices:\n                path_actions, new_sim_state = _find_path_and_interact(simulated_state, target_item_idx)\n                if path_actions:\n                    all_actions.extend(path_actions) # Add planned actions to the overall list\n                    simulated_state = new_sim_state # Update the simulated state with the result of these actions\n                    return simulated_state.inventory[target_item_idx] > 0 # Confirm successful pickup\n                else:\n                    return False # Cannot reach/pick up the primitive\n            else:\n                return False # Cannot craft or acquire this item (e.g., non-grabbable environment or unknown item)\n\n        # If the item has a recipe, it needs to be crafted.\n        # First, collect all required ingredients.\n        required_ingredients = recipe.copy()\n        if \"_key\" in required_ingredients: # Remove special keys from recipe if present\n            del required_ingredients[\"_key\"]\n\n        # Iterate through required ingredients and recursively collect them\n        for ingredient_idx, count in required_ingredients.items():\n            needed = count - simulated_state.inventory[ingredient_idx]\n            for _ in range(needed): # For each unit of the ingredient needed\n                if not _craft_recursive(ingredient_idx):\n                    return False # Failed to obtain a required ingredient, so cannot craft the target item\n\n        # All ingredients are now collected (in the simulated state).\n        # Now, perform the crafting step for the target_item_idx.\n        # This typically involves moving to a workshop and using it.\n        if not world.workshop_indices:\n            return False # No workshops available in the world to craft this item\n\n        # For simplicity, use the first workshop encountered in the world's list.\n        # A more advanced planner might find the closest workshop.\n        target_workshop_idx = world.workshop_indices[0] \n        \n        path_actions, new_sim_state = _find_path_and_interact(simulated_state, target_workshop_idx)\n        if path_actions:\n            all_actions.extend(path_actions) # Add actions to reach and use the workshop\n            simulated_state = new_sim_state # Update simulated state after crafting\n            # Check if crafting was successful (inventory of target_item_idx increased).\n            # The `USE` action at a workshop, when all ingredients are present,\n            # should result in the crafted item appearing in the inventory.\n            return simulated_state.inventory[target_item_idx] > 0\n        else:\n            return False # Cannot reach the workshop\n\n    # Initiate the recursive crafting process for the ultimate goal item\n    if _craft_recursive(item):\n        return all_actions # Return the full list of planned actions\n    else:\n        return [] # Return empty list if crafting the item was not possible", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-29T23:34:46.750925", "function_name": "craft", "function_body": "    # Retrieve the initial state from the CraftLab environment\n    start_state = env._current_state\n    target_item_idx = item  # The index of the item we want to craft\n\n    # Maximum search depth to prevent infinite loops and limit computation time.\n    # Using a multiple of the environment's max_steps as a heuristic if available,\n    # otherwise a fixed large number.\n    MAX_SEARCH_DEPTH = env.max_steps * 2 if hasattr(env, 'max_steps') else 200\n\n    # BFS queue: stores tuples of (current_CraftState, list_of_actions_to_reach_here)\n    queue = collections.deque()\n    # Set to keep track of visited states to avoid cycles and redundant work.\n    # A state is defined by its grid, inventory, position, and direction.\n    visited = set()\n\n    # Helper function to get a hashable representation of a CraftState\n    def get_hashable_state(craft_state):\n        # Convert numpy arrays to bytes objects for efficient hashing.\n        grid_bytes = craft_state.grid.tobytes()\n        inventory_bytes = craft_state.inventory.tobytes()\n        # Combine grid, inventory, position, and direction into a hashable tuple.\n        return (grid_bytes, inventory_bytes, craft_state.pos, craft_state.dir)\n\n    # Add the initial state to the queue and visited set\n    queue.append((start_state, []))\n    visited.add(get_hashable_state(start_state))\n\n    # Breadth-First Search loop\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # If the current path exceeds the maximum search depth, prune this branch.\n        if len(current_path) >= MAX_SEARCH_DEPTH:\n            continue\n\n        # Check if the goal (target item in inventory) is satisfied in the current state\n        if current_state.inventory[target_item_idx] > 0:\n            return current_path  # Goal reached, return the sequence of actions\n\n        # Explore possible next states by trying all available actions (0-4)\n        # These correspond to DOWN, UP, LEFT, RIGHT, USE as per CraftLab action_specs.\n        for action in range(5):\n            # Simulate the action using the CraftState's step method.\n            # The reward is always 0.0 in this specific CraftState implementation, so it's ignored.\n            _reward, next_state = current_state.step(action)\n            next_hashable_state = get_hashable_state(next_state)\n\n            # If this next state has not been visited before, add it to the queue and visited set\n            if next_hashable_state not in visited:\n                visited.add(next_hashable_state)\n                new_path = current_path + [action]\n                queue.append((next_state, new_path))\n\n    # If the queue becomes empty and the goal was never reached, it means the item\n    # cannot be crafted from the current state within the defined search limits.\n    return []", "island_id": 5, "scores": {"3": -1}}
