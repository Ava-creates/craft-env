{"timestamp": "2025-07-29T22:11:34.212240", "function_name": "craft", "function_body": "  import collections # Required for deque\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The _current_state attribute is used to access the internal CraftState object.\n  initial_state = env._current_state\n\n  # Define a function to generate a hashable representation of a CraftState.\n  # A state is uniquely identified by its grid layout, inventory contents,\n  # agent's position, and agent's facing direction.\n  # numpy arrays are converted to bytes for hashability.\n  def hash_craft_state(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents redundant computations and infinite loops in cyclic environments.\n  visited = {hash_craft_state(initial_state)}\n\n  # Define the total number of possible actions (DOWN, UP, LEFT, RIGHT, USE).\n  N_ACTIONS = 5 \n\n  # Set a maximum path length to prevent the search from running indefinitely\n  # in very complex or unsolvable scenarios. This value may need tuning based on\n  # the complexity of the specific CraftWorld recipes and map sizes.\n  MAX_PATH_LENGTH = 200 # A reasonable heuristic for typical crafting tasks.\n\n  # Start the BFS loop.\n  while queue:\n      current_state, current_path = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the desired item is in inventory).\n      # The `goal_name` argument of `satisfies` is ignored based on its docstring,\n      # so we pass None.\n      if current_state.satisfies(None, item):\n          return current_path # Goal reached, return the sequence of actions.\n\n      # Pruning step: If the current path length exceeds the maximum allowed,\n      # stop exploring this branch to manage computational complexity.\n      if len(current_path) >= MAX_PATH_LENGTH:\n          continue\n\n      # Explore all possible actions from the current state.\n      # Actions are typically represented by integers 0 through 4.\n      for action in range(N_ACTIONS):\n          # Apply the action to get the next state.\n          # The `reward` returned by `step` is not used in this pathfinding algorithm.\n          _, next_state = current_state.step(action)\n\n          # Get the hashable representation of the next state.\n          next_state_hash = hash_craft_state(next_state)\n\n          # If this next state has not been visited before, add it to the queue\n          # and mark it as visited.\n          if next_state_hash not in visited:\n              visited.add(next_state_hash)\n              # Append the next state and the updated path (current path + new action) to the queue.\n              queue.append((next_state, current_path + [action]))\n\n  # If the queue becomes empty and the goal was not reached, it means no valid\n  # path exists to craft the item within the defined constraints (e.g., MAX_PATH_LENGTH).\n  return [] # Return an empty list to indicate that no solution was found.", "island_id": 1, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:14:13.780990", "function_name": "craft", "function_body": "  # Constants for actions (assuming these integer values from action_specs)\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTIONS_MOVE = [DOWN, UP, LEFT, RIGHT]\n\n  # Limits to prevent infinite loops and control search depth\n  MAX_PATH_LENGTH = 15  # Max number of moves for pathfinding to an item/workshop\n  MAX_TOTAL_STEPS = 200 # Max total actions to attempt before giving up\n\n  def _get_path_to_nearest_target(state, target_kind_indices, max_len):\n    \"\"\"\n    Performs a limited BFS to find a sequence of movement actions to reach\n    a state where the agent is next to any of the target_kind_indices.\n    Returns a list of actions (moves) or None if no path found within max_len.\n    Simulates state transitions to account for direction and movement.\n    \"\"\"\n    queue = [(state, [])] # (current_CraftState, list_of_actions_so_far)\n    visited = {(state.pos, state.dir)} # Track (position, direction) to avoid cycles\n\n    head = 0 # Manual queue management for a list\n    while head < len(queue):\n      current_s, current_path = queue[head]\n      head += 1\n\n      # Check if current_s is already next to a target\n      for target_idx in target_kind_indices:\n        if current_s.next_to(target_idx):\n          return current_path # Path found!\n\n      # Prune paths that are too long\n      if len(current_path) >= max_len:\n        continue\n\n      # Explore possible next states by trying all movement actions\n      for action in ACTIONS_MOVE:\n        # Simulate the step to get the next state\n        # CraftState.step handles turning/moving logic automatically\n        _reward, next_s = current_s.step(action)\n\n        if (next_s.pos, next_s.dir) not in visited:\n          visited.add((next_s.pos, next_s.dir))\n          queue.append((next_s, current_path + [action]))\n    return None # No path found within max_len\n\n  # --- Main craft_v2 logic begins here ---\n  actions = []\n  current_state = env._current_state # Start from the actual current state of the environment\n  cookbook = env.world.cookbook\n  goal_idx = item\n\n  # 1. Initial check: Is the goal already satisfied?\n  if current_state.satisfies(None, goal_idx):\n    return []\n\n  # 2. Determine what needs to be collected/crafted\n  is_goal_primitive = (goal_idx in env.world.primitives)\n  required_items_to_get = {} # Stores items that need to be in the inventory (primitive or ingredient)\n  needs_crafting = False\n\n  if is_goal_primitive:\n    # If the goal itself is a primitive, we just need to pick it up once.\n    required_items_to_get[goal_idx] = 1\n  else:\n    # If it's not a primitive, it must be a craftable item. Get its ingredients.\n    # The cookbook's primitives_for will break down sub-recipes into base primitives.\n    required_items_to_get = cookbook.primitives_for(goal_idx)\n    needs_crafting = True\n\n    # If it's not a primitive but has no required_items_to_get (e.g., uncraftable or environment item)\n    if not required_items_to_get:\n      return [] # Cannot craft if no ingredients are specified/available\n\n  # 3. Collect all required items (primitives/ingredients)\n  total_steps_taken = 0\n  while True:\n    # Check for timeout for the entire crafting process\n    if total_steps_taken >= MAX_TOTAL_STEPS:\n      return [] # Failed to achieve goal within max allowed steps\n\n    all_items_collected = True\n    # Iterate over needed items (copy keys to avoid issues if dict changes during iteration, though not expected here)\n    for item_idx, count_needed in list(required_items_to_get.items()):\n      if current_state.inventory[item_idx] < count_needed:\n        all_items_collected = False # Still missing some items\n\n        # Try to acquire this missing item\n        if current_state.next_to(item_idx):\n          # Agent is next to the item, so use it to pick it up\n          actions.append(USE)\n          _reward, current_state = current_state.step(USE)\n          total_steps_taken += 1\n          # After using, re-evaluate all needs from the start of the collection loop\n          # (as inventory might have changed and might now satisfy this or other needs)\n          break\n        else:\n          # Not next to the item, try to find a path to it\n          path_actions = _get_path_to_nearest_target(current_state, [item_idx], MAX_PATH_LENGTH)\n          if path_actions:\n            # If a path is found, add its actions and simulate the state changes\n            for action_move in path_actions:\n              actions.append(action_move)\n              _reward, current_state = current_state.step(action_move)\n              total_steps_taken += 1\n              if total_steps_taken >= MAX_TOTAL_STEPS: return [] # Check timeout during path execution\n            # After executing path, the agent should now be next to the item.\n            # Break to re-evaluate needs; the next iteration will call `next_to` and `USE`.\n            break\n          else:\n            # No path found to this item within MAX_PATH_LENGTH.\n            # Take a random move to explore and potentially find a path later.\n            random_action = np.random.choice(ACTIONS_MOVE)\n            actions.append(random_action)\n            _reward, current_state = current_state.step(random_action)\n            total_steps_taken += 1\n            # After random move, re-evaluate all needs.\n            break # Break from inner loop to re-check needs from start of collection loop\n    \n    if all_items_collected:\n      break # All required primitives/ingredients have been collected\n\n  # 4. Craft the goal item if it's not a primitive and needs crafting\n  if needs_crafting:\n    workshop_indices = env.world.workshop_indices\n    if not workshop_indices:\n      return [] # Cannot craft if there are no workshops defined in the world\n\n    while not current_state.satisfies(None, goal_idx):\n      if total_steps_taken >= MAX_TOTAL_STEPS:\n        return [] # Timeout for crafting phase\n\n      # Check if agent is next to any workshop\n      found_workshop_next_to = False\n      for ws_idx in workshop_indices:\n        if current_state.next_to(ws_idx):\n          actions.append(USE)\n          _reward, current_state = current_state.step(USE)\n          total_steps_taken += 1\n          found_workshop_next_to = True\n          break # Used a workshop, break from inner loop\n      \n      if found_workshop_next_to:\n        # After using a workshop, the goal might be satisfied. The outer while loop\n        # condition `not current_state.satisfies(None, goal_idx)` will check this.\n        pass\n      else:\n        # Not next to a workshop, try to find a path to one\n        path_actions = _get_path_to_nearest_target(current_state, workshop_indices, MAX_PATH_LENGTH)\n        if path_actions:\n          # Execute the path to the workshop\n          for action_move in path_actions:\n            actions.append(action_move)\n            _reward, current_state = current_state.step(action_move)\n            total_steps_taken += 1\n            if total_steps_taken >= MAX_TOTAL_STEPS: return [] # Check timeout during path execution\n          # After executing path, next iteration of the while loop will find and USE the workshop.\n        else:\n          # No path found to any workshop within MAX_PATH_LENGTH.\n          # Take a random move to explore.\n          random_action = np.random.choice(ACTIONS_MOVE)\n          actions.append(random_action)\n          _reward, current_state = current_state.step(random_action)\n          total_steps_taken += 1\n\n  # 5. Final check and return the sequence of actions\n  if current_state.satisfies(None, goal_idx):\n    return actions\n  else:\n    return [] # Failed to craft the item within the limits", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:14:14.764372", "function_name": "craft", "function_body": "  import collections\n\n  # Action mappings (internal to CraftWorld/CraftState, but used by CraftLab.step)\n  # These are based on typical DMLab-style relative actions:\n  # UP: move forward\n  # DOWN: move backward\n  # LEFT: turn left\n  # RIGHT: turn right\n  # USE: interact with object in front/nearby\n  _UP, _DOWN, _LEFT, _RIGHT, _USE = 1, 0, 2, 3, 4\n\n  # Map directions (0:N, 1:E, 2:S, 3:W) to (dr, dc) delta relative to grid\n  # (dr, dc) for (row_change, col_change) or (x_change, y_change) depending on convention\n  # Assuming (row, col) as (x, y) where x is row index and y is col index\n  # And 0:North (+y), 1:East (+x), 2:South (-y), 3:West (-x)\n  _DIRECTIONS_VECTORS = {\n      0: (0, 1),   # North (dy=1, dx=0 -> (row, col+1))\n      1: (1, 0),   # East (dx=1, dy=0 -> (row+1, col))\n      2: (0, -1),  # South (dy=-1, dx=0 -> (row, col-1))\n      3: (-1, 0)   # West (dx=-1, dy=0 -> (row-1, col))\n  }\n  _TURN_LEFT_MAP = {0: 3, 1: 0, 2: 1, 3: 2}  # N->W, E->N, S->E, W->S\n  _TURN_RIGHT_MAP = {0: 1, 1: 2, 2: 3, 3: 0} # N->E, E->S, S->W, W->N\n\n  def _get_3x3_neighbor_positions(pos):\n      r, c = pos\n      # Returns all 8 neighbors plus the center cell itself.\n      # CraftState.next_to typically checks this area.\n      return [(r + dr, c + dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]]\n\n  def _is_walkable(pos, grid, world):\n      \"\"\"Checks if a given grid position is walkable.\"\"\"\n      r, c = pos\n      grid_width, grid_height, _ = grid.shape\n      if not (0 <= r < grid_width and 0 <= c < grid_height):\n          return False  # Out of bounds\n\n      # Check for specific un-walkable terrain like water or stone (if not a target)\n      # Assuming water_index and stone_index are always obstacles for movement.\n      if grid[r, c, world.water_index] > 0:\n          return False\n      if grid[r, c, world.stone_index] > 0 and world.stone_index in world.non_grabbable_indices: # Stone can be walked on if not target\n          # Stone is typically grabbable, so if it's in non_grabbable_indices, it's an obstacle.\n          return False\n      return True\n\n  def _bfs_find_path_to_kind(start_pos, start_dir, target_kind_idx, grid, world):\n      \"\"\"\n      Finds a path of actions (UP, DOWN, LEFT, RIGHT) from start_pos/dir\n      to a position where the agent is adjacent to the target_kind_idx.\n      Returns (list_of_actions, final_pos, final_dir) or None if no path.\n      \"\"\"\n      q = collections.deque([((start_pos, start_dir), [])]) # (pos, dir), path_actions\n      visited = set([(start_pos, start_dir)])\n\n      grid_width, grid_height, _ = grid.shape\n\n      while q:\n          (current_pos, current_dir), path_so_far = q.popleft()\n\n          # Check if target_kind_idx is in the 3x3 neighborhood of current_pos\n          found_target_adjacent = False\n          for r_n, c_n in _get_3x3_neighbor_positions(current_pos):\n              if (0 <= r_n < grid_width and 0 <= c_n < grid_height and\n                  grid[r_n, c_n, target_kind_idx] > 0):\n                  found_target_adjacent = True\n                  break\n\n          if found_target_adjacent:\n              # We found a path to be adjacent.\n              return (path_so_far, current_pos, current_dir)\n\n          # Explore possible actions (move or turn)\n          for action in [_UP, _DOWN, _LEFT, _RIGHT]:\n              new_pos, new_dir = current_pos, current_dir\n\n              if action == _UP:\n                  dr, dc = _DIRECTIONS_VECTORS[current_dir]\n                  new_pos = (current_pos[0] + dr, current_pos[1] + dc)\n              elif action == _DOWN:\n                  dr, dc = _DIRECTIONS_VECTORS[current_dir]\n                  new_pos = (current_pos[0] - dr, current_pos[1] - dc)\n              elif action == _LEFT:\n                  new_dir = _TURN_LEFT_MAP[current_dir]\n              elif action == _RIGHT:\n                  new_dir = _TURN_RIGHT_MAP[current_dir]\n              \n              # Check walkability only for movement actions\n              if action in [_UP, _DOWN] and not _is_walkable(new_pos, grid, world):\n                   continue\n\n              if (new_pos, new_dir) not in visited:\n                  visited.add((new_pos, new_dir))\n                  q.append(((new_pos, new_dir), path_so_far + [action]))\n      return None # No path found\n\n  # --- Main craft_v2 function logic ---\n\n  total_actions = []\n  \n  # Reset the environment to get initial state and ensure consistency\n  _ = env.reset() \n  current_state = env._current_state # Access the internal CraftState object\n\n  cookbook = env.world.cookbook\n  \n  # Recursive function to determine all primitive ingredients and workshops needed\n  # for a given item, considering current inventory.\n  # This doesn't consider *how* many times we need to make an intermediate,\n  # but rather what base components (primitives) and workshops are ultimately required.\n  required_primitives_for_goal = collections.defaultdict(int)\n  required_workshops_for_goal = set()\n  \n  # Queue for DFS/BFS-like traversal of the recipe tree\n  recipe_queue = collections.deque([(item, 1)]) # (item_idx, quantity_needed)\n  \n  # Keep track of items whose sub-recipes we've processed to avoid cycles/redundancy\n  processed_recipe_goals = set()\n\n  while recipe_queue:\n      current_target_idx, num_needed = recipe_queue.popleft()\n\n      if current_target_idx in processed_recipe_goals:\n          continue\n      processed_recipe_goals.add(current_target_idx)\n\n      # If it's a primitive, just add to required list\n      if current_target_idx in cookbook.primitives:\n          required_primitives_for_goal[current_target_idx] += num_needed\n      else:\n          # It's a craftable item, get its recipe\n          recipe = cookbook.recipes.get(current_target_idx)\n          if recipe is None:\n              # Item is not primitive and has no recipe - likely an uncraftable environment object\n              # print(f\"Warning: Item {cookbook.index.get(current_target_idx)} is not primitive and has no recipe. Skipping.\")\n              continue\n\n          temp_recipe = recipe.copy()\n          if '_key' in temp_recipe:\n              workshop_name = temp_recipe['_key']\n              workshop_idx = cookbook.index.index(workshop_name)\n              required_workshops_for_goal.add(workshop_idx)\n              del temp_recipe['_key'] # Remove workshop key to iterate ingredients\n\n          # Add all ingredients to the queue for processing\n          for ing_name, ing_count in temp_recipe.items():\n              ing_idx = cookbook.index.index(ing_name)\n              recipe_queue.append((ing_idx, ing_count * num_needed))\n\n  # Main loop for planning and executing actions\n  MAX_STEPS_PER_ITEM_CYCLE = 500 # Prevent infinite loops if stuck\n  current_cycle_steps = 0\n\n  while current_state.inventory[item] < 1:\n      current_cycle_steps += 1\n      if current_cycle_steps > MAX_STEPS_PER_ITEM_CYCLE:\n          # print(f\"Timeout trying to craft {cookbook.index.get(item)}.\")\n          return [] # Could not find a path or got stuck\n\n      action_taken_in_cycle = False\n\n      # 1. Prioritize Crafting: Check if any item can be crafted with current inventory\n      # and by going to an available workshop.\n      craftable_options = [] # (path_len, output_idx, workshop_idx, path_info)\n      for output_idx, recipe_dict in cookbook.recipes.items():\n          # If we already have this output, no need to craft it again\n          if current_state.inventory[output_idx] >= 1:\n              continue\n\n          can_make = True\n          workshop_idx = None\n          temp_recipe = recipe_dict.copy()\n\n          if '_key' in temp_recipe:\n              workshop_idx = cookbook.index.index(temp_recipe['_key'])\n              del temp_recipe['_key']\n\n          for ing_name, ing_count in temp_recipe.items():\n              ing_idx = cookbook.index.index(ing_name)\n              if current_state.inventory[ing_idx] < ing_count:\n                  can_make = False\n                  break\n          \n          if can_make:\n              if workshop_idx is not None:\n                  # If a workshop is needed, find a path to it\n                  path_info = _bfs_find_path_to_kind(current_state.pos, current_state.dir, workshop_idx, current_state.grid, env.world)\n                  if path_info:\n                      craftable_options.append((len(path_info[0]), output_idx, workshop_idx, path_info))\n              else:\n                  # Item can be crafted anywhere (e.g., 'compress' or 'axe' if tools are craftable without explicit workshop)\n                  # This path has 0 length as no movement is needed to a workshop\n                  craftable_options.append((0, output_idx, None, ([], current_state.pos, current_state.dir)))\n\n      if craftable_options:\n          craftable_options.sort(key=lambda x: x[0]) # Sort by shortest path\n          \n          path_actions, _, _ = craftable_options[0][3] # Get actions to reach workshop or just empty\n          \n          for action in path_actions:\n              _, new_state = env.step(action)\n              total_actions.append(action)\n              current_state = new_state\n          \n          # Perform the USE action to craft\n          _, new_state = env.step(_USE)\n          total_actions.append(_USE)\n          current_state = new_state\n          \n          action_taken_in_cycle = True\n          continue # Re-evaluate needs after crafting\n\n      # 2. Gather Primitives: If no crafting is immediately possible, gather missing primitives.\n      gatherable_options = [] # (path_len, item_idx, path_info)\n      for prim_idx, count_needed in required_primitives_for_goal.items():\n          # If we already have enough of this primitive, skip\n          if current_state.inventory[prim_idx] >= count_needed:\n              continue\n          \n          # Only consider truly grabbable items on the grid\n          if prim_idx in env.world.grabbable_indices:\n              path_info = _bfs_find_path_to_kind(current_state.pos, current_state.dir, prim_idx, current_state.grid, env.world)\n              if path_info:\n                  gatherable_options.append((len(path_info[0]), prim_idx, path_info))\n      \n      if gatherable_options:\n          gatherable_options.sort(key=lambda x: x[0]) # Sort by shortest path\n          \n          path_actions, _, _ = gatherable_options[0][2] # Get actions to reach primitive\n          \n          for action in path_actions:\n              _, new_state = env.step(action)\n              total_actions.append(action)\n              current_state = new_state\n          \n          # Perform the USE action to pick up\n          _, new_state = env.step(_USE)\n          total_actions.append(_USE)\n          current_state = new_state\n          \n          action_taken_in_cycle = True\n          continue # Re-evaluate needs after gathering\n\n      # If no action was taken in this cycle, it means we are stuck\n      if not action_taken_in_cycle:\n          # print(f\"Failed to find a way to craft {cookbook.index.get(item)}: No craftable or gatherable options.\")\n          return [] # Cannot make progress\n\n  return total_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:15:32.031689", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  # For v2, we prioritize the 'USE' action in exploration. While standard BFS\n  # guarantees the shortest path with unit costs, prioritizing 'USE' can\n  # lead to finding *a* solution faster if crafting or resource gathering\n  # actions are critical and immediately available, potentially reducing\n  # the number of states explored before reaching the goal.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS_PRIORITIZED = [USE, DOWN, UP, LEFT, RIGHT]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      # Combine grid (as bytes), position, direction, and inventory (as tuple)\n      # to create a unique, hashable representation of the state.\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops\n  # in cases where the goal might be unreachable or require too many steps.\n  # Increased slightly from v1 to allow for potentially longer but still reasonable paths.\n  MAX_SEARCH_DEPTH = 150 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # Explore all possible actions from the current state, using the prioritized order.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:16:15.758061", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Define action constants locally within the function scope.\n  # These correspond to the action mapping in CraftLab.action_specs().\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Get the initial CraftState from the CraftLab environment wrapper.\n  # The planning will start from this exact state.\n  initial_state = env._current_state\n  initial_actions = [] # The list of actions taken to reach the initial state (empty for start)\n\n  # Use a collections.deque for efficient Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_it).\n  queue = collections.deque([(initial_state, initial_actions)])\n\n  # A set to store visited states to prevent cycles and redundant computations.\n  # A state is defined by its grid layout, agent's position, direction, and inventory.\n  # Numpy arrays are not hashable by default, so we convert them to bytes/tuples.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  visited = {_get_state_hashable(initial_state)}\n\n  # Set a maximum search depth to prevent excessively long plans or infinite loops\n  # in cases where the goal might be unreachable or require too many steps.\n  # This is a heuristic value; adjust based on expected plan complexity.\n  MAX_SEARCH_DEPTH = 100 \n\n  # BFS loop\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the current state satisfies the goal (i.e., the item is in inventory).\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item): # goal_name is ignored by CraftState.satisfies\n          return current_actions # Goal achieved, return the sequence of actions\n\n      # Pruning: If the current sequence of actions is too long,\n      # abandon this path to avoid exploring overly complex or inefficient solutions.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue # Skip to the next path in the queue\n\n      # --- IMPROVEMENT FOR v2: Prioritize USE action if it's potentially useful ---\n      # This heuristic aims to explore paths that involve immediate gathering or crafting\n      # before extensive movement, potentially finding solutions faster.\n      actions_to_explore = []\n      \n      # Check if the agent is next to any workshop or grabbable item\n      is_next_to_useful_entity = False\n      for workshop_idx in env.world.workshop_indices:\n          if current_state.next_to(workshop_idx):\n              is_next_to_useful_entity = True\n              break\n      if not is_next_to_useful_entity: # Only check grabbables if not already next to a workshop\n          for grabbable_idx in env.world.grabbable_indices:\n              if current_state.next_to(grabbable_idx):\n                  is_next_to_useful_entity = True\n                  break\n\n      if is_next_to_useful_entity:\n          # If USE is potentially beneficial, try it first\n          actions_to_explore.append(USE)\n          actions_to_explore.extend([a for a in ALL_ACTIONS if a != USE]) # Then movement actions\n      else:\n          # Otherwise, prioritize movement actions, then try USE\n          actions_to_explore.extend([a for a in ALL_ACTIONS if a != USE])\n          actions_to_explore.append(USE)\n\n      # Explore all possible actions from the current state in the determined order.\n      for action in actions_to_explore:\n          # Apply the action. CraftState.step returns a new CraftState object,\n          # encapsulating all game logic (movement, gathering, crafting, etc.).\n          _reward, new_state = current_state.step(action)\n\n          # Get the hashable representation of the new state to check if it has been visited.\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # If this new state has not been visited before, add it to the visited set\n          # and enqueue it for further exploration.\n          if new_state_hashable not in visited:\n              visited.add(new_state_hashable)\n              queue.append((new_state, current_actions + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted from the current state within the `MAX_SEARCH_DEPTH`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-29T22:19:16.956132", "function_name": "craft", "function_body": "  import collections\n\n  # Constants for actions\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  ACTION_TO_DELTAS = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  # Helper function for BFS pathfinding\n  def _bfs_path(start_pos, target_condition_func, current_state):\n      \"\"\"\n      Performs a Breadth-First Search to find the shortest path from start_pos\n      to any position that satisfies target_condition_func.\n      Returns a list of actions (moves) to reach an adjacent cell to the target,\n      or None if no path is found.\n      \"\"\"\n      queue = collections.deque([(start_pos, [])])  # (position, actions_taken_to_reach_pos)\n      visited = {start_pos}\n\n      grid_shape = current_state.grid.shape\n      WIDTH, HEIGHT, _ = grid_shape\n\n      # Identify impassable kinds based on CraftWorld attributes\n      impassable_kinds = set()\n      if hasattr(current_state.world, 'water_index') and current_state.world.water_index is not None:\n          impassable_kinds.add(current_state.world.water_index)\n      if hasattr(current_state.world, 'stone_index') and current_state.world.stone_index is not None:\n          impassable_kinds.add(current_state.world.stone_index)\n      # Assuming only water/stone are obstacles. Other non_grabbable_indices (like workshops) are\n      # typically locations one can move *to* and interact with, but not necessarily \"through\" if solid.\n      # For simplicity, we assume the agent cannot move onto a cell explicitly occupied by an impassable kind.\n\n      while queue:\n          current_pos, current_actions = queue.popleft()\n\n          # Check if the current position meets the target condition\n          # (e.g., being adjacent to the target item or workshop)\n          if target_condition_func(current_pos, current_state):\n              return current_actions\n\n          r, c = current_pos\n          for action, (dr, dc) in ACTION_TO_DELTAS.items():\n              nr, nc = r + dr, c + dc\n              next_pos = (nr, nc)\n\n              # Check bounds and if the position has already been visited\n              if 0 <= nr < WIDTH and 0 <= nc < HEIGHT and next_pos not in visited:\n                  is_traversable = True\n                  # Check if the next_pos is occupied by an impassable kind\n                  for k_idx in impassable_kinds:\n                      if current_state.grid[nr, nc, k_idx] == 1:\n                          is_traversable = False\n                          break\n                  \n                  if is_traversable:\n                      visited.add(next_pos)\n                      queue.append((next_pos, current_actions + [action]))\n      return None # No path found\n\n  # Helper function: Checks if 'check_pos' is adjacent to an 'item_kind_idx'\n  def _is_adjacent_to_item(check_pos, state, item_kind_idx):\n      \"\"\"Returns True if any cell cardinal to `check_pos` contains `item_kind_idx`.\"\"\"\n      r, c = check_pos\n      grid = state.grid\n      WIDTH, HEIGHT, _ = grid.shape\n      for dr, dc in ACTION_TO_DELTAS.values(): # Iterate over cardinal direction deltas\n          nr, nc = r + dr, c + dc\n          if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n              if grid[nr, nc, item_kind_idx] == 1:\n                  return True\n      return False\n\n  # Helper function: Checks if 'check_pos' is adjacent to any workshop\n  def _is_adjacent_to_workshop(check_pos, state):\n      \"\"\"Returns True if any cell cardinal to `check_pos` contains a workshop.\"\"\"\n      r, c = check_pos\n      grid = state.grid\n      WIDTH, HEIGHT, _ = grid.shape\n      workshop_indices = state.world.workshop_indices\n      for dr, dc in ACTION_TO_DELTAS.values():\n          nr, nc = r + dr, c + dc\n          if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n              for workshop_idx in workshop_indices:\n                  if grid[nr, nc, workshop_idx] == 1:\n                      return True\n      return False\n\n  all_actions = []\n  current_state = env._current_state # Get the current CraftState instance from the CraftLab environment\n\n  # 1. Check if the goal item is already in the inventory\n  if current_state.inventory[item] > 0:\n      return all_actions # Goal already satisfied, no actions needed\n\n  # 2. Determine all primitive ingredients needed for the target item\n  # The cookbook's primitives_for method recursively resolves all sub-recipes to their base primitives.\n  primitives_needed = current_state.world.cookbook.primitives_for(item)\n\n  # 3. Collect each required primitive ingredient\n  for p_idx, count_needed in primitives_needed.items():\n      while current_state.inventory[p_idx] < count_needed:\n          # Find a path to a cell adjacent to an instance of the current primitive\n          path_to_primitive_actions = _bfs_path(\n              current_state.pos,\n              lambda pos, state: _is_adjacent_to_item(pos, state, p_idx),\n              current_state\n          )\n\n          if path_to_primitive_actions is None:\n              # If a primitive is needed but cannot be reached on the grid,\n              # the goal is uncraftable in this scenario. Return an empty list indicating failure.\n              return []\n\n          # Execute actions to move adjacent to the primitive\n          for action in path_to_primitive_actions:\n              _, _, _ = env.step(action) # Step the environment, reward and done status ignored for planning\n              current_state = env._current_state # Update the local state reference after each step\n              all_actions.append(action)\n\n          # Once adjacent, USE the primitive to collect it.\n          # The environment's step function will update the inventory and grid.\n          _, _, _ = env.step(USE)\n          current_state = env._current_state # Update state after USE action\n          all_actions.append(USE)\n\n  # 4. Craft the final item at a workshop once all necessary primitives are collected\n  # Re-check if item is already present. This might happen if the 'item' itself was a primitive,\n  # or if an earlier crafting step somehow produced it (though not expected for `primitives_for` logic).\n  if current_state.inventory[item] > 0:\n      return all_actions\n\n  # Find a path to a cell adjacent to a workshop\n  path_to_workshop_actions = _bfs_path(\n      current_state.pos,\n      _is_adjacent_to_workshop,\n      current_state\n  )\n\n  if path_to_workshop_actions is None:\n      # If no workshop can be reached, the goal is uncraftable.\n      return []\n\n  # Execute actions to move adjacent to the workshop\n  for action in path_to_workshop_actions:\n      _, _, _ = env.step(action)\n      current_state = env._current_state\n      all_actions.append(action)\n\n  # Once adjacent, USE the workshop to craft the item\n  _, _, _ = env.step(USE)\n  current_state = env._current_state\n  all_actions.append(USE)\n\n  # 5. Final verification: Confirm the item was successfully crafted\n  if current_state.inventory[item] > 0:\n      return all_actions\n  else:\n      # If crafting failed despite having all primitives and reaching a workshop,\n      # it implies a more complex crafting rule not covered by this simple planner\n      # or an impossible scenario in the given world state.\n      return [] # Indicate failure to craft.", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:19:17.932196", "function_name": "craft", "function_body": "  # Action constants (standard for this environment)\n  _DOWN = 0\n  _UP = 1\n  _LEFT = 2\n  _RIGHT = 3\n  _USE = 4\n\n  def _get_adjacent_cell(pos, direction):\n      \"\"\"Calculates the coordinates of the cell directly in front of the agent.\"\"\"\n      r, c = pos\n      if direction == _UP: return (r - 1, c)\n      if direction == _DOWN: return (r + 1, c)\n      if direction == _LEFT: return (r, c - 1)\n      if direction == _RIGHT: return (r, c + 1)\n      return None\n\n  def _get_target_from_recipe_key(cookbook_obj, workshop_name_key):\n      \"\"\"Looks up the integer index for a workshop name from the cookbook's index.\"\"\"\n      return cookbook_obj.index[workshop_name_key]\n\n  # Initialize the planner's state from the environment's current state\n  # env._current_state holds the CraftState object\n  current_state = env._current_state\n  all_actions = []\n\n  # Get references to key data structures from the cookbook\n  cookbook = env.world.cookbook\n  recipes = cookbook.recipes\n  primitives_set = cookbook.primitives\n  \n  # Helper function to execute actions and update the internal planner's state\n  # This simulates the environment steps without actually interacting with the DMLab `env`\n  # until the final action list is returned.\n  def _execute_actions(actions_to_add):\n      nonlocal current_state\n      nonlocal all_actions\n      for action in actions_to_add:\n          all_actions.append(action)\n          # CraftState.step returns (reward, new_state)\n          _, current_state = current_state.step(action)\n\n  # Recursive helper function to gather or craft a target item\n  # Returns True if the item is successfully acquired (now in inventory), False otherwise.\n  def _gather_item(target_item_idx):\n      nonlocal current_state\n      \n      # Base case: If the item is already in inventory, we're done.\n      if current_state.inventory[target_item_idx] > 0:\n          return True\n\n      rows, cols, _ = current_state.grid.shape\n      \n      # Case 1: The target item is a primitive (can be picked up directly from the grid)\n      if target_item_idx in primitives_set:\n          # Use BFS to find a path to an adjacent cell, then face the item, then USE\n          # BFS state: (current_pos, current_dir, path_actions_to_reach_this_state)\n          q_bfs = [(current_state.pos, current_state.dir, [])] \n          visited_bfs = {(current_state.pos, current_state.dir)} # Track visited (pos, dir) pairs\n          \n          best_actions_to_use_item = None\n          \n          while q_bfs and best_actions_to_use_item is None:\n              (r, c), d, path = q_bfs.pop(0)\n              \n              # Check the cell directly in front of the agent for the target item\n              front_r, front_c = _get_adjacent_cell((r, c), d)\n              \n              # Ensure the front cell is within grid bounds\n              if 0 <= front_r < rows and 0 <= front_c < cols:\n                  # If the target primitive is found in the cell in front\n                  if current_state.grid[front_r, front_c, target_item_idx] > 0:\n                      # This state allows us to use the item. Append _USE action.\n                      best_actions_to_use_item = path + [_USE]\n                      break # Found the shortest path to use the item\n              \n              # Explore possible movements (UP, DOWN, LEFT, RIGHT)\n              for move_action in [_DOWN, _UP, _LEFT, _RIGHT]:\n                  new_r, new_c = r, c\n                  new_d = d # Direction before applying the move action (will be updated by move)\n                  \n                  # Calculate new position and effective new direction after move\n                  if move_action == _UP: new_r -= 1; new_d = _UP\n                  elif move_action == _DOWN: new_r += 1; new_d = _DOWN\n                  elif move_action == _LEFT: new_c -= 1; new_d = _LEFT\n                  elif move_action == _RIGHT: new_c += 1; new_d = _RIGHT\n                  \n                  # Check for boundary conditions and obstacles (non-grabbable environment items)\n                  is_obstacle = False\n                  if not (0 <= new_r < rows and 0 <= new_c < cols):\n                      is_obstacle = True # Out of bounds is an obstacle\n                  else:\n                      # Check if the new cell contains any non-grabbable environment items\n                      for obs_idx in cookbook.environment: \n                          if current_state.grid[new_r, new_c, obs_idx] > 0:\n                              is_obstacle = True\n                              break\n                                  \n                  # If the new state is valid and not visited, add to BFS queue\n                  if not is_obstacle and ((new_r, new_c), new_d) not in visited_bfs:\n                      visited_bfs.add(((new_r, new_c), new_d))\n                      q_bfs.append(((new_r, new_c), new_d, path + [move_action]))\n          \n          if best_actions_to_use_item:\n              _execute_actions(best_actions_to_use_item)\n              # Verify if the item was successfully added to inventory after USE\n              return current_state.inventory[target_item_idx] > 0\n          else:\n              return False # Failed to find or gather the primitive\n                                  \n      # Case 2: The target item is craftable (requires ingredients and possibly a workshop)\n      else:\n          recipe_info = recipes.get(target_item_idx)\n          if not recipe_info:\n              return False # No recipe found for this item, cannot craft\n\n          required_ingredients = {}\n          workshop_needed_idx = None\n          \n          # Parse recipe for ingredients and workshop key\n          for ing_idx_or_key, count in recipe_info.items():\n              if ing_idx_or_key == \"_key\":\n                  workshop_name = count\n                  workshop_needed_idx = _get_target_from_recipe_key(cookbook, workshop_name)\n              else:\n                  required_ingredients[ing_idx_or_key] = count\n          \n          # First, recursively gather all required ingredients\n          for ing_idx, needed_count in required_ingredients.items():\n              current_count = current_state.inventory[ing_idx]\n              times_to_gather = needed_count - current_count\n              \n              for _ in range(times_to_gather):\n                  if not _gather_item(ing_idx): # Recursive call to get each instance of ingredient\n                      return False # Failed to gather an ingredient, so cannot craft\n          \n          # All ingredients are now in inventory (or assumed to be). Proceed to craft.\n          if workshop_needed_idx is not None:\n              # If a workshop is needed, find and use it\n              q_bfs = [(current_state.pos, current_state.dir, [])]\n              visited_bfs = {(current_state.pos, current_state.dir)}\n              \n              best_actions_to_use_workshop = None\n              \n              while q_bfs and best_actions_to_use_workshop is None:\n                  (r, c), d, path = q_bfs.pop(0)\n                  \n                  # Check the cell in front of the agent for the required workshop\n                  front_r, front_c = _get_adjacent_cell((r, c), d)\n                  \n                  if 0 <= front_r < rows and 0 <= front_c < cols:\n                      if current_state.grid[front_r, front_c, workshop_needed_idx] > 0:\n                          best_actions_to_use_workshop = path + [_USE] # Use the workshop\n                          break\n                  \n                  # Explore movements (same logic as primitive collection)\n                  for move_action in [_DOWN, _UP, _LEFT, _RIGHT]:\n                      new_r, new_c = r, c\n                      new_d = d\n                      \n                      if move_action == _UP: new_r -= 1; new_d = _UP\n                      elif move_action == _DOWN: new_r += 1; new_d = _DOWN\n                      elif move_action == _LEFT: new_c -= 1; new_d = _LEFT\n                      elif move_action == _RIGHT: new_c += 1; new_d = _RIGHT\n                      \n                      is_obstacle = False\n                      if not (0 <= new_r < rows and 0 <= new_c < cols):\n                          is_obstacle = True\n                      else:\n                          for obs_idx in cookbook.environment:\n                              if current_state.grid[new_r, new_c, obs_idx] > 0:\n                                  is_obstacle = True\n                                  break\n                                  \n                      if not is_obstacle and ((new_r, new_c), new_d) not in visited_bfs:\n                          visited_bfs.add(((new_r, new_c), new_d))\n                          q_bfs.append(((new_r, new_c), new_d, path + [move_action]))\n              \n              if best_actions_to_use_workshop:\n                  _execute_actions(best_actions_to_use_workshop)\n                  # Verify if the item was successfully crafted after using workshop\n                  return current_state.inventory[target_item_idx] > 0\n              else:\n                  return False # Cannot find or use the required workshop\n          else:\n              # No workshop is needed (handcrafting). The item is considered crafted\n              # as soon as all its ingredients are successfully gathered. No additional action is required.\n              return True # Item considered crafted\n\n  # Start the crafting process by attempting to gather the target item\n  _gather_item(item)\n  \n  return all_actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:20:16.632239", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n  import heapq # Used for the A* priority queue\n\n  # Define action constants, matching CraftLab.action_specs().\n  # Prioritizing 'USE' can help in finding crafting/gathering solutions faster.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS_PRIORITIZED = [USE, DOWN, UP, LEFT, RIGHT]\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This allows states to be stored in sets (for 'visited') and used as dictionary keys.\n  def _get_state_hashable(state):\n      return (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n\n  # Heuristic function for A* search.\n  # Estimates the minimum additional steps needed to reach the goal.\n  # This heuristic is admissible (never overestimates) and is based on the deficit\n  # of primitive resources required to craft the target item.\n  def calculate_heuristic(state, target_item_idx, cookbook):\n      # If the item is already in the inventory, no more steps are needed for it.\n      if state.satisfies(None, target_item_idx):\n          return 0\n\n      # Get the total primitive requirements for the target item.\n      # cookbook.primitives_for recursively finds all base ingredients needed.\n      needed_primitives = cookbook.primitives_for(target_item_idx)\n      \n      missing_count = 0\n      for primitive_idx, required_amount in needed_primitives.items():\n          # Sum up the quantity of each primitive item that is still missing from the inventory.\n          missing_count += max(0, required_amount - state.inventory[primitive_idx])\n      \n      # The heuristic value is the total sum of missing primitive quantities.\n      # Each unit of a missing primitive is assumed to require at least one action\n      # (e.g., picking it up or performing a crafting step that produces it).\n      return missing_count\n\n  # Get the initial CraftState from the CraftLab environment.\n  initial_state = env._current_state\n  \n  # Priority queue for A* search. Stores tuples: (f_cost, g_cost, CraftState object).\n  # f_cost = g_cost + h_cost (estimated total cost from start to goal through this state)\n  # g_cost = actual cost (number of steps) from the initial state to the current state.\n  open_set = [] \n  \n  # Dictionary to store the minimum g_cost found so far for each state.\n  # This is essential for A* to correctly handle re-visiting states via cheaper paths.\n  # Key: hashable state representation, Value: g_cost.\n  g_costs = {_get_state_hashable(initial_state): 0}\n  \n  # Dictionary to reconstruct the path after the goal is found.\n  # Key: hashable current_state, Value: (hashable previous_state, action_taken_to_reach_current).\n  came_from = {}\n  \n  # Calculate initial heuristic cost for the starting state.\n  initial_h_cost = calculate_heuristic(initial_state, item, env.world.cookbook)\n  # The initial state's f_cost is just its h_cost, as g_cost is 0.\n  initial_f_cost = initial_h_cost \n  \n  # Push the initial state into the priority queue.\n  # The g_cost is included in the tuple for tie-breaking: if f_costs are equal,\n  # states with lower actual costs (g_cost) are preferred.\n  heapq.heappush(open_set, (initial_f_cost, 0, initial_state)) \n\n  # Maximum number of steps (g_cost) to explore. This acts as a practical limit\n  # to prevent excessively long searches or infinite loops in unreachable scenarios.\n  MAX_SEARCH_STEPS = 200 \n\n  # A* search loop: continues as long as there are states to explore.\n  while open_set:\n      # Pop the state with the lowest f_cost from the priority queue.\n      # If f_costs are equal, the state with the lower g_cost is chosen.\n      current_f_cost, current_g_cost, current_state = heapq.heappop(open_set)\n\n      # Optimization: If we found a cheaper path to this state after it was already\n      # added to the open_set, this popped entry is outdated. Skip it.\n      if current_g_cost > g_costs.get(_get_state_hashable(current_state), float('inf')):\n          continue\n\n      # Check if the current state satisfies the goal condition.\n      # CraftState.satisfies checks if inventory[item] > 0.\n      if current_state.satisfies(None, item):\n          # Goal reached! Reconstruct the action path by backtracking from the goal state.\n          path = []\n          temp_state_hash = _get_state_hashable(current_state)\n          while temp_state_hash in came_from:\n              prev_state_hash, action = came_from[temp_state_hash]\n              path.append(action)\n              temp_state_hash = prev_state_hash\n          return path[::-1] # Reverse the path to get actions from start to goal.\n\n      # Pruning: If the current path's actual cost (g_cost) exceeds the maximum allowed steps,\n      # abandon this path to avoid exploring excessively long solutions.\n      if current_g_cost >= MAX_SEARCH_STEPS:\n          continue\n      \n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS_PRIORITIZED:\n          # Simulate taking the action to get the next state.\n          # CraftState.step returns a reward (ignored here) and the new state object.\n          _reward, new_state = current_state.step(action)\n          new_state_hashable = _get_state_hashable(new_state)\n\n          # Calculate the cost to reach this new_state from the initial state\n          # via the current_state. Each action has a uniform cost of 1.\n          tentative_g_cost = current_g_cost + 1 \n\n          # If this new path to `new_state` is cheaper than any previously found path,\n          # or if `new_state` has not been visited yet:\n          if new_state_hashable not in g_costs or tentative_g_cost < g_costs[new_state_hashable]:\n              # Update the minimum g_cost for `new_state`.\n              g_costs[new_state_hashable] = tentative_g_cost\n              \n              # Record how we reached `new_state` for path reconstruction.\n              came_from[new_state_hashable] = (_get_state_hashable(current_state), action)\n              \n              # Calculate the heuristic cost for `new_state`.\n              new_h_cost = calculate_heuristic(new_state, item, env.world.cookbook)\n              \n              # Calculate the estimated total cost (f_cost) for `new_state`.\n              new_f_cost = tentative_g_cost + new_h_cost\n              \n              # Push `new_state` onto the priority queue for future exploration.\n              heapq.heappush(open_set, (new_f_cost, tentative_g_cost, new_state))\n\n  # If the open_set becomes empty and the goal was not found,\n  # it means the item cannot be crafted/acquired from the current state within the\n  # defined search limits or at all.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:20:17.605398", "function_name": "craft", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:22:07.749922", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Action constants (assuming these are available in the context, e.g., from env_factory)\n    ACT_DOWN, ACT_UP, ACT_LEFT, ACT_RIGHT, ACT_USE = 0, 1, 2, 3, 4\n\n    def _find_path_to_goal_condition(start_state, goal_test_func, max_depth=50):\n        \"\"\"\n        Performs a BFS to find a sequence of movement actions from start_state to a state\n        satisfying goal_test_func.\n        Returns (path_actions, end_state) or (None, None) if no path found.\n        The visited set tracks (position, direction, grid_hash) because grid changes\n        (e.g., items being picked up) affect subsequent pathfinding.\n        \"\"\"\n        q = collections.deque([(start_state, [])])\n        visited = set([(start_state.pos, start_state.dir, start_state.grid.tobytes())])\n\n        while q:\n            current_state, path = q.popleft()\n\n            if goal_test_func(current_state):\n                return path, current_state\n\n            if len(path) >= max_depth:\n                continue\n\n            # Only consider movement actions for pathfinding to a location\n            for action in [ACT_DOWN, ACT_UP, ACT_LEFT, ACT_RIGHT]:\n                # Simulate the action to get the next state\n                _, next_state = current_state.step(action)\n                next_state_key = (next_state.pos, next_state.dir, next_state.grid.tobytes())\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((next_state, path + [action]))\n        return None, None\n\n\n    current_state = env._current_state\n    cookbook = env.world.cookbook\n    total_actions = []\n\n    MAX_OVERALL_STEPS = 500  # Safety limit for the entire crafting process\n    MAX_SUBGOAL_STEPS = 50   # Limit for a single pathfinding attempt (e.g., move to item)\n\n    steps_taken = 0\n\n    # Main planning loop\n    while not current_state.satisfies(None, item) and steps_taken < MAX_OVERALL_STEPS:\n        # 1. Check if we can craft anything immediately (prioritize crafting)\n        craftable_recipes = []\n        for output_idx, recipe in cookbook.recipes.items():\n            can_craft = True\n            needs_workshop = False\n            for ingredient_idx, count in recipe.items():\n                if ingredient_idx == \"_key\":  # Workshop requirement\n                    needs_workshop = True\n                    # Assuming there's at least one workshop type and it's workshop_indices[0]\n                    if not env.world.workshop_indices or not current_state.next_to(env.world.workshop_indices[0]):\n                        can_craft = False\n                        break\n                else:  # Regular ingredient\n                    if current_state.inventory[ingredient_idx] < count:\n                        can_craft = False\n                        break\n            if can_craft:\n                craftable_recipes.append(output_idx)\n        \n        chosen_craft_output = None\n        if item in craftable_recipes:\n            # If the goal item itself is craftable, prioritize crafting it\n            chosen_craft_output = item\n        elif craftable_recipes:\n            # Otherwise, pick the first craftable recipe found that produces something useful.\n            # A more sophisticated planner would prioritize ingredients for the goal.\n            # For v2, a simple heuristic is just to craft anything available.\n            # Let's try to pick a craftable item that is an ingredient for 'item'\n            # This requires knowing intermediate dependencies, which is complex.\n            # For simplicity, pick the first craftable if the goal isn't directly craftable.\n            chosen_craft_output = craftable_recipes[0]\n\n\n        if chosen_craft_output is not None:\n            recipe_to_craft = cookbook.recipes[chosen_craft_output]\n            \n            # If workshop is needed and not currently next to one, plan path to workshop\n            if \"_key\" in recipe_to_craft and not current_state.next_to(env.world.workshop_indices[0]):\n                workshop_idx = env.world.workshop_indices[0]\n                path_to_workshop, _ = _find_path_to_goal_condition(current_state,\n                    lambda s: s.next_to(workshop_idx), max_depth=MAX_SUBGOAL_STEPS)\n                \n                if path_to_workshop:\n                    total_actions.extend(path_to_workshop)\n                    for action in path_to_workshop:\n                        _, current_state = current_state.step(action)\n                        steps_taken += 1\n                    if steps_taken >= MAX_OVERALL_STEPS: break\n                else:\n                    # Cannot reach workshop, cannot craft this item right now.\n                    # Continue to the next part of the loop (gathering)\n                    continue\n            \n            # Perform USE action to craft\n            _, new_state_after_craft = current_state.step(ACT_USE)\n            total_actions.append(ACT_USE)\n            current_state = new_state_after_craft\n            steps_taken += 1\n            if steps_taken >= MAX_OVERALL_STEPS: break\n            continue  # Successfully crafted, re-evaluate loop condition from top\n\n        # 2. If no crafting possible, check for missing primitives and gather\n        # Use cookbook.primitives_for to get the full primitive requirements for the final item\n        full_primitive_requirements = cookbook.primitives_for(item)\n        \n        needed_to_gather = {}\n        for prim_idx, needed_count in full_primitive_requirements.items():\n            if current_state.inventory[prim_idx] < needed_count:\n                needed_to_gather[prim_idx] = needed_count - current_state.inventory[prim_idx]\n\n        if needed_to_gather:\n            # Pick a primitive to gather. Simple heuristic: pick the first one needed.\n            target_primitive_idx = next(iter(needed_to_gather))\n\n            # Find path to be next to this primitive on the grid\n            path_to_item, _ = _find_path_to_goal_condition(current_state,\n                lambda s: s.next_to(target_primitive_idx), max_depth=MAX_SUBGOAL_STEPS)\n            \n            if path_to_item:\n                total_actions.extend(path_to_item)\n                for action in path_to_item:\n                    _, current_state = current_state.step(action)\n                    steps_taken += 1\n                if steps_taken >= MAX_OVERALL_STEPS: break\n\n                # Now that we are next to the item, USE it to pick it up\n                _, new_state_after_pickup = current_state.step(ACT_USE)\n                total_actions.append(ACT_USE)\n                current_state = new_state_after_pickup\n                steps_taken += 1\n                if steps_taken >= MAX_OVERALL_STEPS: break\n                continue  # Successfully gathered, re-evaluate loop condition from top\n\n        # 3. If no crafting and no needed primitives can be gathered immediately,\n        # we might be stuck or need to explore.\n        # As a fallback, try a random movement if no other progress.\n        # This is a simple exploration, not a full-fledged search.\n        if steps_taken < MAX_OVERALL_STEPS - 1:\n            # Check if current action is doing nothing, to avoid infinite loops\n            # If nothing specific to do, try a USE action first, then random movement.\n            action_to_try = ACT_USE\n            # If the last action was USE and it didn't change anything useful, try movement.\n            if total_actions and total_actions[-1] == ACT_USE:\n                # Pick a random movement action\n                action_to_try = np.random.choice([ACT_DOWN, ACT_UP, ACT_LEFT, ACT_RIGHT])\n\n            _, next_state = current_state.step(action_to_try)\n            \n            # Check if this action made any meaningful change\n            if (next_state.pos != current_state.pos or\n                next_state.dir != current_state.dir or\n                not np.array_equal(next_state.inventory, current_state.inventory) or\n                not np.array_equal(next_state.grid, current_state.grid)):\n\n                total_actions.append(action_to_try)\n                current_state = next_state\n                steps_taken += 1\n                if current_state.satisfies(None, item):\n                    return total_actions\n            else:\n                # Action did nothing useful, we are likely truly stuck. Break.\n                break\n        else:\n            # Reached max_overall_steps without satisfying the goal.\n            break\n            \n    # Return actions if goal achieved, else an empty list (indicating failure or no path found)\n    return total_actions if current_state.satisfies(None, item) else []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:22:07.819669", "function_name": "craft", "function_body": "        goal_item_idx = item\n\n        # Get the initial CraftState from the CraftLab environment\n        # The env.reset() method returns observations; we need the internal state.\n        # Assuming `_current_state` is the way to access the current CraftState.\n        initial_craft_state = env._current_state\n\n        # BFS Queue: (current_craft_state_instance, list_of_actions_to_reach_this_state)\n        # Using collections.deque for efficient append and popleft operations.\n        q = collections.deque([(initial_craft_state, [])])\n\n        # Visited set: Stores a hashable representation of each visited state to avoid cycles.\n        # A state is uniquely defined by (position, direction, inventory, grid_layout).\n        # inventory and grid_layout (numpy arrays) need to be converted to hashable types.\n        visited = set()\n\n        def get_hashable_state_key(state):\n            \"\"\"Generates a hashable tuple representation of a CraftState.\"\"\"\n            # Convert numpy array inventory to a list, then to a tuple for hashability.\n            # Convert grid (numpy array) to bytes for efficient hashing.\n            return (state.pos, state.dir, tuple(state.inventory.tolist()), state.grid.tobytes())\n\n        # Add the initial state to the visited set\n        visited.add(get_hashable_state_key(initial_craft_state))\n\n        # Use max_steps from the environment as a practical limit for path length.\n        # This helps prevent infinite loops in unsolvable scenarios and limits search depth.\n        # If `max_steps` is very large, the search might still be computationally intensive.\n        max_path_length = env.max_steps\n\n        # Define the possible actions (DOWN, UP, LEFT, RIGHT, USE)\n        # These typically map to integers 0 through 4.\n        ACTIONS = [0, 1, 2, 3, 4]\n\n        while q:\n            current_state, current_actions = q.popleft()\n\n            # Check if the goal item is in the current inventory (goal satisfied)\n            if current_state.satisfies(None, goal_item_idx):\n                return current_actions  # Goal reached, return the sequence of actions\n\n            # Pruning: If the current path exceeds the maximum allowed length,\n            # stop exploring this path to avoid excessive computation.\n            if len(current_actions) >= max_path_length:\n                continue\n\n            # Explore possible next states by trying all available actions\n            for action in ACTIONS:\n                # CraftState.step returns a *new* CraftState instance, as per its docstring.\n                # This means we don't need to deepcopy `current_state` before calling `step`.\n                reward, next_state = current_state.step(action)\n                next_actions = current_actions + [action]\n\n                # Get the hashable key for the next state to check if it has been visited\n                next_state_key = get_hashable_state_key(next_state)\n\n                if next_state_key not in visited:\n                    visited.add(next_state_key)\n                    q.append((next_state, next_actions))\n\n        # If the queue becomes empty and the goal was not reached, it means no path\n        # was found within the defined limits (e.g., max_path_length or state space exhaustion).\n        return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:24:01.990206", "function_name": "craft", "function_body": "    # Constants (these would typically be global or imported, but are placed here\n    # to adhere strictly to the \"only return code that will fit in that function\" rule)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    DIR_NORTH = 0\n    DIR_EAST = 1\n    DIR_SOUTH = 2\n    DIR_WEST = 3\n\n    MOVE_OFFSETS = {\n        ACTION_UP: (-1, 0),\n        ACTION_DOWN: (1, 0),\n        ACTION_LEFT: (0, -1),\n        ACTION_RIGHT: (0, 1),\n    }\n\n    FACING_OFFSETS = {\n        DIR_NORTH: (-1, 0),\n        DIR_EAST: (0, 1),\n        DIR_SOUTH: (1, 0),\n        DIR_WEST: (0, -1),\n    }\n\n    # collections module for deque, must be imported within the function if nested\n    import collections\n\n    def _get_path_and_face(start_state, target_kind_idx=None, is_workshop=False):\n        \"\"\"\n        Finds a path of actions for the agent to move to a cell from which it can\n        interact (e.g., pick up or craft) with the target.\n        This means moving to an adjacent cell and facing the target.\n\n        Args:\n            start_state (CraftState): The initial state of the agent.\n            target_kind_idx (int, optional): The index of the item to target.\n            is_workshop (bool, optional): True if targeting a workshop.\n\n        Returns:\n            tuple[list[int], CraftState]: (actions_to_reach_pos, state_after_moves)\n                                         Returns (None, None) if no path found.\n        \"\"\"\n        world = start_state.world\n        grid = start_state.grid\n        WIDTH, HEIGHT, _ = grid.shape\n\n        # BFS state: (current_CraftState_object, list_of_actions_taken_to_reach_this_state)\n        queue = collections.deque([(start_state, [])])\n        # Visited states: tuple (pos_r, pos_c, dir_int) to avoid cycles\n        visited = {(start_state.pos[0], start_state.pos[1], start_state.dir)}\n\n        def _is_target_at_cell(r_cell, c_cell):\n            if not (0 <= r_cell < WIDTH and 0 <= c_cell < HEIGHT):\n                return False\n            if target_kind_idx is not None:\n                return grid[r_cell, c_cell, target_kind_idx] > 0\n            elif is_workshop:\n                for ws_idx in world.workshop_indices:\n                    if grid[r_cell, c_cell, ws_idx] > 0:\n                        return True\n                return False\n            return False\n\n        while queue:\n            current_state_bfs, actions_so_far = queue.popleft()\n            r, c = current_state_bfs.pos\n            current_dir = current_state_bfs.dir\n\n            # Check if the current position and direction allow interaction with a target\n            target_dr, target_dc = FACING_OFFSETS[current_dir]\n            target_r, target_c = r + target_dr, c + target_dc\n\n            if _is_target_at_cell(target_r, target_c):\n                # Agent is at (r,c), facing current_dir, and target is directly in front.\n                return actions_so_far, current_state_bfs\n\n            # Explore possible next states by taking a move action\n            for action_move, (dr, dc) in MOVE_OFFSETS.items():\n                # Simulate the step to get the new state\n                # Note: `step` returns reward and new_state\n                _, next_state_after_move = current_state_bfs.step(action_move)\n                new_r, new_c = next_state_after_move.pos\n                new_dir = next_state_after_move.dir # Direction is updated by step\n\n                state_key = (new_r, new_c, new_dir)\n                if state_key not in visited:\n                    visited.add(state_key)\n                    queue.append((next_state_after_move, actions_so_far + [action_move]))\n\n        return None, None # No path found\n\n    def _get_item_actions(current_state, target_item_idx, world, depth=0, max_depth=10):\n        \"\"\"\n        Recursively determines actions to obtain a target item and the resulting state.\n\n        Args:\n            current_state (CraftState): The current state of the environment.\n            target_item_idx (int): The index of the item to obtain.\n            world (CraftWorld): Reference to the CraftWorld instance.\n            depth (int): Current recursion depth (for preventing infinite loops).\n            max_depth (int): Maximum allowed recursion depth.\n\n        Returns:\n            tuple[list[int], CraftState or None]: (actions_list, resulting_state)\n                                                  Returns ([], None) if not possible.\n        \"\"\"\n        if depth > max_depth:\n            # print(f\"Recursion depth limit reached for item {world.cookbook.index.get(target_item_idx)}\")\n            return [], None\n\n        # Base Case 1: Item already in inventory\n        if current_state.inventory[target_item_idx] > 0:\n            return [], current_state\n\n        all_actions_for_item = []\n        temp_state = current_state # Use a mutable state for simulation within this branch\n\n        # Base Case 2: Primitive item\n        if target_item_idx in world.cookbook.primitives:\n            move_actions, state_at_pos = _get_path_and_face(temp_state, target_kind_idx=target_item_idx)\n            if move_actions is None:\n                # print(f\"Cannot find path to primitive: {world.cookbook.index.get(target_item_idx)}\")\n                return [], None\n            \n            all_actions_for_item.extend(move_actions)\n            _, temp_state = state_at_pos.step(ACTION_USE) # Simulate USE\n            all_actions_for_item.append(ACTION_USE)\n\n            if temp_state.inventory[target_item_idx] == 0:\n                 # print(f\"Failed to pick up primitive: {world.cookbook.index.get(target_item_idx)}\")\n                 return [], None\n            return all_actions_for_item, temp_state\n\n        # Recursive Case: Crafted item\n        if target_item_idx in world.cookbook.recipes:\n            recipe = world.cookbook.recipes[target_item_idx]\n            \n            for ingredient_idx, count in recipe.items():\n                if ingredient_idx == \"_key\": # Special key for workshop type, not an ingredient\n                    continue \n                \n                # Obtain the required count of this ingredient\n                needed_count = count - temp_state.inventory[ingredient_idx]\n                for _ in range(needed_count):\n                    ingredient_actions, next_state_after_ingredient = _get_item_actions(\n                        temp_state, ingredient_idx, world, depth + 1, max_depth)\n                    \n                    if next_state_after_ingredient is None or next_state_after_ingredient.inventory[ingredient_idx] < (temp_state.inventory[ingredient_idx] + 1):\n                        # If we couldn't get one instance of the ingredient, or it's not present after sub-plan\n                        # print(f\"Cannot obtain ingredient {world.cookbook.index.get(ingredient_idx)} for {world.cookbook.index.get(target_item_idx)}\")\n                        return [], None\n                    \n                    all_actions_for_item.extend(ingredient_actions)\n                    temp_state = next_state_after_ingredient # Update the state for subsequent steps\n\n            # After obtaining all ingredients, move to a workshop and USE\n            move_actions, state_at_pos = _get_path_and_face(temp_state, is_workshop=True)\n            if move_actions is None:\n                # print(f\"Cannot find path to a workshop for {world.cookbook.index.get(target_item_idx)}\")\n                return [], None\n\n            all_actions_for_item.extend(move_actions)\n            _, temp_state = state_at_pos.step(ACTION_USE) # Simulate USE at workshop\n            all_actions_for_item.append(ACTION_USE)\n\n            if temp_state.inventory[target_item_idx] == 0:\n                # print(f\"Failed to craft {world.cookbook.index.get(target_item_idx)}.\")\n                return [], None\n            \n            return all_actions_for_item, temp_state\n\n        # print(f\"Item {world.cookbook.index.get(target_item_idx)} is neither primitive nor craftable.\")\n        return [], None # Item is not a primitive and has no recipe\n\n    # Main logic of craft_v2 starts here\n    current_state = env._current_state \n    world = env.world \n\n    # Check if we already have the item at the very beginning\n    if current_state.inventory[item] > 0:\n        return []\n\n    # Get the required actions and the final state after the plan\n    actions_to_craft, final_planned_state = _get_item_actions(current_state, item, world)\n    \n    # Verify if the item was successfully obtained in the simulated final state\n    if final_planned_state is not None and final_planned_state.inventory[item] > 0:\n        return actions_to_craft\n    else:\n        return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-29T22:24:04.712094", "function_name": "craft", "function_body": "  import collections\n\n  # Get current state from the CraftLab environment\n  initial_state = env._current_state\n  goal_item_idx = item\n\n  # Get action mapping from the environment\n  ACTION_MAP = env.action_specs()\n  DOWN, UP, LEFT, RIGHT, USE = ACTION_MAP['DOWN'], ACTION_MAP['UP'], ACTION_MAP['LEFT'], ACTION_MAP['RIGHT'], ACTION_MAP['USE']\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is crucial for effectively using a 'visited' set in BFS to avoid\n  # cycles and redundant exploration of identical states.\n  def _hashable_state(state):\n      # Agent's position (tuple) and direction (int) are directly hashable.\n      # Inventory is a numpy array; convert to a tuple of integers for hashing.\n      inventory_tuple = tuple(state.inventory.astype(np.int32))\n      # Grid is a numpy array; convert to a bytes object for hashing.\n      # `tobytes()` creates a compact and hashable representation of the grid data.\n      grid_bytes = state.grid.tobytes()\n      return (state.pos, state.dir, inventory_tuple, grid_bytes)\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each item in the queue is a tuple: (current_CraftState, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_state, [])])\n\n  # Initialize the set of visited states to prevent revisiting and loops.\n  # States are stored in their hashable representation.\n  visited = {_hashable_state(initial_state)}\n\n  # Set a maximum limit on the number of states to explore.\n  # This prevents the search from running indefinitely in very large or unreachable scenarios.\n  MAX_EXPLORED_STATES = 10000 \n  explored_count = 0\n\n  while queue:\n      current_state, path_actions = queue.popleft()\n      explored_count += 1\n\n      # If the exploration limit is reached, return an empty list,\n      # indicating that a path to the goal wasn't found within the allowed search depth/breadth.\n      if explored_count > MAX_EXPLORED_STATES:\n          return [] \n\n      # Check if the goal item is present in the current state's inventory.\n      # If yes, we've found the shortest sequence of actions, so return it.\n      if current_state.satisfies(None, goal_item_idx):\n          return path_actions\n\n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS:\n          # Simulate taking the action to get the next state.\n          # The reward is always 0.0 for CraftState.step, so it's ignored for pathfinding.\n          _, next_state = current_state.step(action)\n          \n          # Get the hashable representation of the next state.\n          hashable_next_state = _hashable_state(next_state)\n\n          # If this next state has not been visited before, add it to the queue\n          # and mark it as visited.\n          if hashable_next_state not in visited:\n              visited.add(hashable_next_state)\n              new_path_actions = path_actions + [action] # Append the current action to the path.\n              queue.append((next_state, new_path_actions))\n\n  # If the queue becomes empty and the goal was never reached,\n  # it means the goal is unreachable from the initial state (within the given limits).\n  return []", "island_id": 9, "scores": {"3": 0.0}}
