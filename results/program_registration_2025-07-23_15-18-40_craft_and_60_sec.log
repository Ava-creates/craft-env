{"timestamp": "2025-07-23T15:27:26.132182", "function_name": "craft", "function_body": "    total_reward = 0.0\n\n    # Define action mappings for readability\n    ACTIONS = {\n        'DOWN': 0,\n        'UP': 1,\n        'LEFT': 2,\n        'RIGHT': 3,\n        'USE': 4,\n    }\n\n    cookbook = env.world.cookbook\n\n    # Helper function to execute an action and check if episode is done\n    def execute_action(action_name):\n        nonlocal total_reward\n        reward, done, _ = env.step(ACTIONS[action_name])\n        total_reward += reward\n        return done # Return True if episode is done, False otherwise\n\n    # Get IDs for 'wood' and 'workshop1' from the cookbook's index.\n    # These are specific to the `CraftWorld.sample_scenario_simple` setup.\n    try:\n        wood_id = cookbook.index[\"wood\"]\n        workshop1_id = cookbook.index[\"workshop1\"]\n    except KeyError:\n        # If 'wood' or 'workshop1' are not in the cookbook's index,\n        # this particular crafting strategy (tailored for sample_scenario_simple)\n        # cannot be applied.\n        return total_reward\n\n    # Get the recipe for the target 'item' (which is passed as an integer ID).\n    # This will raise a KeyError if 'item' is a primitive (not a craftable output).\n    # We assume 'item' is always an ID of a craftable output.\n    try:\n        recipe = cookbook.recipes[item]\n    except KeyError:\n        # The provided 'item' is not a craftable recipe output.\n        return total_reward\n\n    # Stage 1: Collect Primitive Ingredients.\n    # For the `sample_scenario_simple`, the only immediately available primitive\n    # required for simple crafts (like 'plank') is 'wood' at (5,6).\n    # The agent starts at (5,5).\n\n    # `primitives_for` calculates all base ingredients needed for the target item,\n    # even if it involves intermediate crafts.\n    primitives_needed_counts = cookbook.primitives_for(item)\n\n    # Check if 'wood' is a required primitive and if we don't have enough in inventory.\n    if wood_id in primitives_needed_counts and \\\n       env._current_state.inventory[wood_id] < primitives_needed_counts[wood_id]:\n        \n        # Agent starts at (5,5), wood is at (5,6).\n        # To pick up wood, the agent needs to be at (5,5) and facing UP towards (5,6).\n\n        # Action 1: Turn agent to face UP.\n        # By attempting to move 'UP' into the occupied cell (5,6) (which contains wood),\n        # the agent stays at (5,5) but changes its direction to UP.\n        if execute_action('UP'):\n            return total_reward\n\n        # Action 2: USE action to pick up wood.\n        # The agent is at (5,5), facing UP. The neighbor (5,6) has wood.\n        # The USE action will pick up the wood from (5,6) and add it to inventory.\n        if execute_action('USE'):\n            return total_reward\n        \n        # After picking up the wood, the cell (5,6) becomes empty.\n        # The agent remains at (5,5), still facing UP.\n\n    # Stage 2: Craft the item at the required workshop.\n    # For the `sample_scenario_simple`, 'workshop1' is located at (5,7).\n\n    craft_station_name = recipe.get('_at') # This gets the string name of the workshop, e.g., 'workshop1'\n    \n    if craft_station_name:\n        craft_station_id = cookbook.index[craft_station_name]\n\n        # Assuming the crafting recipe requires 'workshop1' based on the simple scenario.\n        if craft_station_id == workshop1_id:\n            # To craft at workshop1 (at 5,7), the agent needs to be adjacent to it,\n            # e.g., at (5,6), and facing UP towards it.\n            # Current agent position is (5,5). We need to move to (5,6).\n            # Since (5,6) is now empty (wood was picked up), a direct 'UP' move will succeed.\n\n            # Action 3: Move agent to (5,6).\n            # This action moves the agent to (5,6) and keeps its direction as UP.\n            if execute_action('UP'):\n                return total_reward\n\n            # Action 4: USE action to craft the item at workshop1.\n            # The agent is now at (5,6), facing UP. Its neighbor (5,7) has workshop1.\n            # The USE action will perform the craft if all ingredients are in inventory.\n            if execute_action('USE'):\n                return total_reward\n            \n            # After crafting, the agent's inventory should contain the target item.\n\n    return total_reward", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-23T15:27:27.662022", "function_name": "craft", "function_body": "  total_reward = 0.0\n\n  # Define constants used in the Craft environment for actions and dimensions\n  # These are typically global in the Craft environment's codebase.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  \n  # Get environment dimensions from the current grid state for boundary checks\n  # WIDTH and HEIGHT are defined as global constants in craft_env.py\n  # We access them as attributes of env.world or from the grid shape.\n  # The grid has shape (WIDTH, HEIGHT, num_kinds)\n  grid_width, grid_height, _ = env._current_state.grid.shape\n\n\n  # 1. Map item string to its index using the cookbook's index\n  item_idx = env.world.cookbook.index[item]\n\n  # 2. Get the recipe for the desired item\n  if item_idx not in env.world.cookbook.recipes:\n      # If the item doesn't have a recipe, it cannot be crafted.\n      return total_reward\n\n  recipe = env.world.cookbook.recipes[item_idx]\n\n  # 3. Identify the required workshop for this recipe\n  if \"_at\" not in recipe:\n      # Recipes without a \"_at\" key typically aren't crafted at a workshop.\n      # This function assumes workshop-based crafting.\n      return total_reward\n\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n\n  # 4. Find the exact location (x, y) of the workshop on the grid\n  workshop_pos = None\n  current_grid = env._current_state.grid\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if current_grid[x, y, workshop_idx] == 1:\n              workshop_pos = (x, y)\n              break\n      if workshop_pos:\n          break\n\n  if workshop_pos is None:\n      # Workshop not found in the current environment state.\n      return total_reward\n\n  # 5. Determine a target adjacent position for the agent to move to.\n  # The agent needs to be in an empty cell next to the workshop to use it.\n  target_adj_pos = None\n  wx, wy = workshop_pos\n  current_agent_x, current_agent_y = env._current_state.pos\n\n  # Potential adjacent cells around the workshop\n  potential_adj_positions = [\n      (wx, wy - 1), (wx, wy + 1), (wx - 1, wy), (wx + 1, wy)\n  ]\n\n  valid_adj_positions = []\n  for px, py in potential_adj_positions:\n      # Check if the potential position is within grid boundaries\n      if 0 <= px < grid_width and 0 <= py < grid_height:\n          # Check if the cell is currently empty (agent can only move to empty cells)\n          if not current_grid[px, py, :].any():\n               valid_adj_positions.append((px, py))\n\n  if not valid_adj_positions:\n      # No empty cell found next to the workshop, meaning all adjacent cells are blocked.\n      return total_reward\n\n  # Select the closest valid adjacent position to the agent's current position\n  # using Manhattan distance.\n  min_dist = float('inf')\n  for px, py in valid_adj_positions:\n      dist = abs(px - current_agent_x) + abs(py - current_agent_y)\n      if dist < min_dist:\n          min_dist = dist\n          target_adj_pos = (px, py)\n  \n  if target_adj_pos is None:\n      # This case should logically not be reached if valid_adj_positions is not empty.\n      return total_reward\n\n  # 6. Move the agent to the selected target adjacent cell\n  target_x, target_y = target_adj_pos\n  \n  # Limit the number of moves to prevent infinite loops in complex scenarios\n  # (though for simple cases, this is usually not hit).\n  max_move_attempts = grid_width * grid_height * 2 \n  moves_taken = 0\n  \n  while env._current_state.pos != (target_x, target_y) and moves_taken < max_move_attempts:\n      cx, cy = env._current_state.pos\n      action_to_take = -1 # Default to an invalid action\n\n      # Simple greedy movement: try to align X, then Y.\n      if cx < target_x:\n          action_to_take = RIGHT\n      elif cx > target_x:\n          action_to_take = LEFT\n      elif cy < target_y: # Only attempt Y-movement if X is already aligned\n          action_to_take = UP\n      elif cy > target_y: # Only attempt Y-movement if X is already aligned\n          action_to_take = DOWN\n      \n      if action_to_take != -1:\n          reward, done, _ = env.step(action_to_take)\n          total_reward += reward\n          moves_taken += 1\n          if done:\n              # If the environment signals 'done' (e.g., task completed, max steps reached),\n              # terminate early and return accumulated reward.\n              return total_reward\n      else:\n          # If no action was determined, it means the agent is already at the target\n          # coordinate, or is stuck (e.g., path unexpectedly blocked after calculation).\n          break # Exit loop\n\n  # Verify if the agent successfully reached the target adjacent position\n  if env._current_state.pos != (target_x, target_y):\n      # If the agent could not reach the required position, crafting cannot proceed.\n      return total_reward\n\n  # 7. Execute the USE action to perform crafting at the workshop\n  # The agent's direction is automatically updated by movement actions,\n  # ensuring USE checks the correct adjacent cell (the workshop).\n  reward, done, _ = env.step(USE)\n  total_reward += reward\n  \n  # Return the total reward accumulated during this crafting operation.\n  return total_reward", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T15:34:23.840886", "function_name": "craft", "function_body": "  total_reward = 0.0\n  action_map = env.action_specs()\n  cookbook = env.world.cookbook\n\n  # Helper function to move agent adjacent to target and face it\n  def _move_to_adjacent_and_face(env, target_object_index):\n      current_total_reward = 0.0\n\n      # Loop until agent is adjacent to target and facing it, or task is done\n      # Adding a safeguard iteration limit to prevent infinite loops for unreachable targets.\n      # The environment's own `max_steps` is the ultimate limit for the entire task.\n      for _ in range(env.max_steps + 1):\n          current_state = env._current_state\n          current_pos = current_state.pos\n          current_dir = current_state.dir\n          grid = current_state.grid\n\n          # Find all locations of the target object on the grid\n          target_locs = np.argwhere(grid[:, :, target_object_index] == 1)\n\n          if len(target_locs) == 0:\n              # Target is no longer on the grid (e.g., was picked up by a previous action)\n              return current_total_reward\n\n          # Pick the closest target location to move towards\n          if len(target_locs) > 1:\n              # Using Euclidean distance to find the closest instance\n              distances = [np.linalg.norm(np.array(loc) - np.array(current_pos)) for loc in target_locs]\n              target_pos = target_locs[np.argmin(distances)]\n          else:\n              target_pos = target_locs[0]\n\n          dx_to_target = target_pos[0] - current_pos[0]\n          dy_to_target = target_pos[1] - current_pos[1]\n\n          # Determine if we are adjacent to the target\n          is_adjacent = (abs(dx_to_target) == 1 and dy_to_target == 0) or \\\n                        (dx_to_target == 0 and abs(dy_to_target) == 1)\n\n          # Determine the direction the agent *should* face to interact with target_pos\n          desired_dir = -1 # Initialize with an invalid direction\n          if dx_to_target == 1: desired_dir = action_map['RIGHT']\n          elif dx_to_target == -1: desired_dir = action_map['LEFT']\n          elif dy_to_target == 1: desired_dir = action_map['UP']\n          elif dy_to_target == -1: desired_dir = action_map['DOWN']\n\n          # If already in the correct position (adjacent) and facing the target, we are done moving\n          if is_adjacent and current_dir == desired_dir:\n              break\n\n          action_to_take = -1 # Initialize with an invalid action\n\n          if not is_adjacent:\n              # Need to move closer. Prioritize movement along the axis with larger distance.\n              if abs(dx_to_target) >= abs(dy_to_target):\n                  if dx_to_target > 0: action_to_take = action_map['RIGHT']\n                  else: action_to_take = action_map['LEFT']\n              else:\n                  if dy_to_target > 0: action_to_take = action_map['UP']\n                  else: action_to_take = action_map['DOWN']\n          else: # is_adjacent is True, but not facing correctly\n              action_to_take = desired_dir # Just change direction to face the target\n\n          # If no valid action could be determined (e.g., a logic error or truly stuck), break\n          if action_to_take == -1:\n              break\n\n          # Take the determined action\n          reward, done, _ = env.step(action_to_take)\n          current_total_reward += reward\n          if done:\n              return current_total_reward # Task terminated prematurely\n\n      return current_total_reward\n\n  item_idx = cookbook.index[item]\n\n  # Get the recipe for the item\n  recipe = cookbook.recipes.get(item_idx)\n  if not recipe:\n      # If the item is not found in recipes, it means it's not craftable.\n      # Return 0.0 reward as the task cannot be completed.\n      return total_reward\n\n  # Extract ingredients and crafting station information from the recipe\n  ingredients = {k: v for k, v in recipe.items() if isinstance(k, int)}\n  station_name = recipe.get(\"_at\")\n  station_idx = None\n  if station_name:\n      station_idx = cookbook.index[station_name]\n  else:\n      # If a craftable item does not specify a crafting station, it implies an invalid recipe\n      # for the Craft environment which typically requires a workshop for crafting.\n      return total_reward\n\n  # Check if the item is already in the agent's inventory\n  if env._current_state.inventory[item_idx] > 0:\n      return total_reward # Already have the item, no need to craft.\n\n  # --- Phase 1: Collect Ingredients ---\n  for ingredient_idx, needed_count in ingredients.items():\n      while env._current_state.inventory[ingredient_idx] < needed_count:\n          # Attempt to move to the ingredient and face it\n          reward_from_move = _move_to_adjacent_and_face(env, ingredient_idx)\n          total_reward += reward_from_move\n          if env._is_done():\n              return total_reward\n\n          # After attempting to move, check if the ingredient is still on the grid.\n          # If not, and we still need it, it implies all instances are gone or unreachable.\n          if not np.any(env._current_state.grid[:, :, ingredient_idx]):\n              # This can happen if the ingredient was just picked up, or if there were not enough\n              # instances on the map to satisfy `needed_count`. If inventory is still low, break.\n              break # Break from collecting this specific ingredient, as it's no longer available.\n\n          # If we are adjacent and facing, attempt to USE it (pick it up)\n          reward, done, _ = env.step(action_map['USE'])\n          total_reward += reward\n          if done:\n              return total_reward\n      \n      # After the loop for this ingredient, check if we successfully collected enough.\n      # If not, the crafting task cannot be completed.\n      if env._current_state.inventory[ingredient_idx] < needed_count:\n          return total_reward # Failed to collect enough of an ingredient.\n\n  # --- Phase 2: Craft at Station ---\n  if station_idx is not None:\n      # Move to the crafting station and face it\n      reward_from_move = _move_to_adjacent_and_face(env, station_idx)\n      total_reward += reward_from_move\n      if env._is_done():\n          return total_reward\n\n      # If the item is still not in inventory after collecting ingredients and moving to station,\n      # attempt to USE the station to craft it.\n      if env._current_state.inventory[item_idx] == 0:\n          reward, done, _ = env.step(action_map['USE'])\n          total_reward += reward\n          if done:\n              return total_reward\n  \n  return total_reward", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-23T15:34:23.859280", "function_name": "craft", "function_body": "    WIDTH = 12\n    HEIGHT = 12\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    total_reward = 0.0\n    item_idx = env.world.cookbook.index.index(item)\n\n    recipe = env.world.cookbook.recipes.get(item_idx)\n    if not recipe:\n        # If the item is not found in recipes, it might be a primitive or an invalid item.\n        # This function is intended for crafting, so return 0.0 if not craftable.\n        return total_reward\n\n    # Helper function to move and collect a single primitive item\n    def collect_single_primitive(target_primitive_idx):\n        nonlocal total_reward # Allows modifying total_reward from outer scope\n        rewards_from_collection = 0.0\n        max_attempts = 50 # Safety limit for movements and actions\n\n        # Store initial count to check if collection was successful\n        initial_count_before_attempt = env._current_state.inventory[target_primitive_idx]\n\n        for _ in range(max_attempts):\n            current_state = env._current_state\n            current_pos = current_state.pos\n            current_grid = current_state.grid\n            \n            target_item_pos = None\n            # Find the first instance of the primitive on the grid\n            for x_grid in range(WIDTH):\n                for y_grid in range(HEIGHT):\n                    if current_grid[x_grid, y_grid, target_primitive_idx] == 1:\n                        target_item_pos = (x_grid, y_grid)\n                        break\n                if target_item_pos: break\n\n            if not target_item_pos:\n                # Item no longer on grid (e.g., already collected by a previous action)\n                # If we successfully collected one during this attempt, return its reward\n                if env._current_state.inventory[target_primitive_idx] > initial_count_before_attempt:\n                    return rewards_from_collection\n                break # Item completely gone or not found, cannot collect\n\n            target_x, target_y = target_item_pos\n\n            # Determine if agent is adjacent to the target\n            is_adjacent = False\n            for dx_check, dy_check in [(0,1), (0,-1), (1,0), (-1,0)]: # UP, DOWN, RIGHT, LEFT relative to agent\n                if current_pos[0]+dx_check == target_x and current_pos[1]+dy_check == target_y:\n                    is_adjacent = True\n                    break\n            \n            # Determine the required direction to face the target for a USE action\n            required_facing_dir = -1\n            if target_x == current_pos[0] + 1 and target_y == current_pos[1]: required_facing_dir = RIGHT\n            elif target_x == current_pos[0] - 1 and target_y == current_pos[1]: required_facing_dir = LEFT\n            elif target_y == current_pos[1] + 1 and target_x == current_pos[0]: required_facing_dir = UP\n            elif target_y == current_pos[1] - 1 and target_x == current_pos[0]: required_facing_dir = DOWN\n\n            # If adjacent AND facing the correct direction, attempt to USE\n            if is_adjacent and current_state.dir == required_facing_dir:\n                r, d, _ = env.step(USE)\n                rewards_from_collection += r\n                if d: return rewards_from_collection # Environment terminated\n                \n                # Check if item was successfully collected\n                if env._current_state.inventory[target_primitive_idx] > initial_count_before_attempt:\n                    return rewards_from_collection # Successfully collected one item, mission accomplished for this call\n            else:\n                # Not adjacent OR not facing correctly. Need to move or turn.\n                action_to_take = -1\n                if not is_adjacent:\n                    # Move towards the target to become adjacent\n                    dx_dist = target_x - current_pos[0]\n                    dy_dist = target_y - current_pos[1]\n                    if abs(dx_dist) > abs(dy_dist): # Prefer horizontal movement\n                        action_to_take = RIGHT if dx_dist > 0 else LEFT\n                    else: # Prefer vertical movement\n                        action_to_take = UP if dy_dist > 0 else DOWN\n                elif current_state.dir != required_facing_dir:\n                    # Already adjacent but facing wrong. Attempt to change direction by \"moving\" towards the target.\n                    # If target is an obstacle, this will change direction without changing position.\n                    action_to_take = required_facing_dir\n\n                if action_to_take != -1:\n                    r, d, _ = env.step(action_to_take)\n                    rewards_from_collection += r\n                    if d: return rewards_from_collection # Environment terminated\n                else:\n                    break # No valid action to take, stuck or target unreachable.\n        return rewards_from_collection\n\n    # Helper function to move to be adjacent and facing a workshop\n    def move_to_adjacent_and_face_workshop(target_workshop_idx):\n        nonlocal total_reward\n        rewards_from_movement = 0.0\n        max_attempts = 50 # Safety limit for movements\n\n        for _ in range(max_attempts):\n            current_state = env._current_state\n            current_pos = current_state.pos\n            current_grid = current_state.grid\n            \n            workshop_pos = None\n            # Find the workshop on the grid\n            for x_grid in range(WIDTH):\n                for y_grid in range(HEIGHT):\n                    if current_grid[x_grid, y_grid, target_workshop_idx] == 1:\n                        workshop_pos = (x_grid, y_grid)\n                        break\n                if workshop_pos: break\n\n            if not workshop_pos:\n                # Workshop not found, this is an error condition for crafting\n                break \n\n            target_x, target_y = workshop_pos\n\n            # Determine if agent is adjacent to the workshop\n            is_adjacent = False\n            for dx_check, dy_check in [(0,1), (0,-1), (1,0), (-1,0)]:\n                if current_pos[0]+dx_check == target_x and current_pos[1]+dy_check == target_y:\n                    is_adjacent = True\n                    break\n            \n            # Determine the required direction to face the workshop for a USE action\n            required_facing_dir = -1\n            if target_x == current_pos[0] + 1 and target_y == current_pos[1]: required_facing_dir = RIGHT\n            elif target_x == current_pos[0] - 1 and target_y == current_pos[1]: required_facing_dir = LEFT\n            elif target_y == current_pos[1] + 1 and target_x == current_pos[0]: required_facing_dir = UP\n            elif target_y == current_pos[1] - 1 and target_x == current_pos[0]: required_facing_dir = DOWN\n\n            # If adjacent AND facing the correct direction, the goal state for movement is achieved\n            if is_adjacent and current_state.dir == required_facing_dir:\n                return rewards_from_movement\n\n            else:\n                # Not adjacent OR not facing correctly. Need to move or turn.\n                action_to_take = -1\n                if not is_adjacent:\n                    # Move towards the workshop to become adjacent\n                    dx_dist = target_x - current_pos[0]\n                    dy_dist = target_y - current_pos[1]\n                    if abs(dx_dist) > abs(dy_dist):\n                        action_to_take = RIGHT if dx_dist > 0 else LEFT\n                    else:\n                        action_to_take = UP if dy_dist > 0 else DOWN\n                elif current_state.dir != required_facing_dir:\n                    # Already adjacent but facing wrong. Attempt to change direction by \"moving\" towards the workshop.\n                    action_to_take = required_facing_dir\n\n                if action_to_take != -1:\n                    r, d, _ = env.step(action_to_take)\n                    rewards_from_movement += r\n                    if d: return rewards_from_movement # Environment terminated\n                else:\n                    break # No valid action to take, stuck or target unreachable.\n        return rewards_from_movement\n\n    # --- Main crafting logic ---\n\n    # 1. Gather all required ingredients (recursively if needed)\n    for ingredient_idx, count in recipe.items():\n        # Skip special keys like '_at', '_yield' that are not ingredients\n        if not isinstance(ingredient_idx, int):\n            continue\n\n        ingredient_name = env.world.cookbook.index.get(ingredient_idx)\n        \n        current_has = env._current_state.inventory[ingredient_idx]\n        needed = count\n        num_to_get = needed - current_has\n\n        if num_to_get > 0:\n            if ingredient_idx in env.world.cookbook.primitives:\n                # This is a primitive item, call the helper to collect it\n                for _ in range(num_to_get):\n                    reward_from_step = collect_single_primitive(ingredient_idx)\n                    total_reward += reward_from_step\n                    # After attempt, re-check if obtained. If not, stop trying for this item.\n                    if env._current_state.inventory[ingredient_idx] < current_has + 1:\n                         break \n                    current_has += 1 # Update count for next iteration (if more needed)\n            else:\n                # This is a craftable intermediate item, recursively call craft_v1 for it\n                for _ in range(num_to_get):\n                    reward_from_step = craft_v1(env, ingredient_name) # Recursive call\n                    total_reward += reward_from_step\n                    # After attempt, re-check if obtained. If not, stop trying for this item.\n                    if env._current_state.inventory[ingredient_idx] < current_has + 1:\n                        break \n                    current_has += 1 # Update count for next iteration (if more needed)\n\n    # 2. Go to the correct workshop (if specified in the recipe)\n    workshop_idx = None\n    if '_at' in recipe:\n        workshop_name = recipe['_at']\n        workshop_idx = env.world.cookbook.index.index(workshop_name)\n        \n        # Move agent to be adjacent to the workshop and facing it\n        reward_from_step = move_to_adjacent_and_face_workshop(workshop_idx)\n        total_reward += reward_from_step\n\n    # 3. Perform the USE action to craft the final item\n    # This action consumes ingredients and produces the item if conditions are met.\n    r, d, _ = env.step(USE)\n    total_reward += r\n    # The environment's reward mechanism already accounts for success/failure.\n    # We don't need to explicitly check inventory change here as reward indicates outcome.\n\n    return total_reward", "island_id": 4, "scores": {"3": -1}}
