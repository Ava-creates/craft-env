{"timestamp": "2025-08-25T20:59:05.443355", "function_name": "craft", "function_body": "  def move_to_position(x_target, y_target):\n      x, y = env._current_state.pos\n      while (x, y) != (x_target, y_target):\n          dx = x_target - x\n          dy = y_target - y\n\n          # Choose the direction with the largest difference\n          if abs(dx) > abs(dy):\n              actions.append(3 if dx > 0 else 2)  # RIGHT or LEFT based on x difference\n          elif abs(dy) > abs(dx):\n              actions.append(1 if dy > 0 else 0)  # UP or DOWN based on y difference\n          else:\n              # Choose any direction, here we choose to move vertically first\n              actions.append(1 if dy > 0 else 0)\n\n          # Update the current position based on the chosen action\n          if abs(dx) > abs(dy):\n              x += 1 if dx > 0 else -1\n          elif abs(dy) > abs(dx):\n              y += 1 if dy > 0 else -1\n\n      return (x, y)\n\n  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index in env.world.cookbook.recipes:\n      recipe = env.world.cookbook.recipes[item_index]\n      \n      # Determine the kind of workshop required based on the recipe key\n      if \"_key\" in recipe:\n          key_workshop = recipe[\"_key\"]\n          workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) if env.world.index.get(name) == key_workshop]\n\n          if workshop_indices:\n              workshop_index = workshop_indices[0]\n              workshop_name = env.world.workshop_indices[workshop_index]\n\n              # Find the position of the workshop on the grid\n              workshop_position = None\n              for y in range(env._current_state.grid.shape[1]):\n                  for x in range(env._current_state.grid.shape[0]):\n                      if np.any(env._current_state.grid[x, y] == env.world.index.get(workshop_name)):\n                          workshop_position = (x, y)\n                          break\n                  if workshop_position:\n                      break\n\n              if workshop_position:\n                  # Move towards the workshop position\n                  move_to_position(workshop_position[0], workshop_position[1])\n\n                  # Use the workshop to craft the item\n                  actions.append(4)  # USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-25T20:59:06.584483", "function_name": "craft", "function_body": "  def move_towards(pos_target):\n      actions = []\n      current_pos = env._current_state.pos\n      while current_pos != pos_target:\n          dx = pos_target[0] - current_pos[0]\n          dy = pos_target[1] - current_pos[1]\n\n          if abs(dx) > abs(dy):\n              actions.append(2 if dx < 0 else 3)  # LEFT or RIGHT based on x difference\n          else:\n              actions.append(0 if dy < 0 else 1)  # DOWN or UP based on y difference\n\n          current_pos = (current_pos[0] + (-1 if dx < 0 else 1 if dx > 0 else 0),\n                         current_pos[1] + (-1 if dy < 0 else 1 if dy > 0 else 0))\n      return actions\n\n  def find_workshop_position(workshop_name):\n      for y in range(env._current_state.grid.shape[1]):\n          for x in range(env._current_state.grid.shape[0]):\n              if np.any(env._current_state.grid[x, y] == workshop_name):\n                  return (x, y)\n      return None\n\n  actions = []\n\n  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the item has a recipe\n  if item_index in env.world.cookbook.recipes:\n      recipe = env.world.cookbook.recipes[item_index]\n      \n      # Determine the kind of workshop required based on the recipe key\n      if \"_key\" in recipe:\n          key_workshop = recipe[\"_key\"]\n          workshop_indices = [idx for idx, name in enumerate(env.world.workshop_indices) if name == key_workshop]\n\n          if workshop_indices:\n              workshop_index = workshop_indices[0]\n              workshop_name = env.world.workshop_indices[workshop_index]\n\n              # Find the position of the workshop on the grid\n              workshop_position = find_workshop_position(workshop_name)\n\n              if workshop_position:\n                  # Move towards the workshop position\n                  actions.extend(move_towards(workshop_position