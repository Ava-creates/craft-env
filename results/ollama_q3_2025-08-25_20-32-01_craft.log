{"timestamp": "2025-08-25T21:06:20.940319", "function_name": "craft", "function_body": "  def find_workshop(item_index):\n      workshop_required = None\n      for output, ingredients in env.world.cookbook.recipes.items():\n          if output == item_index:\n              workshop_required = int(ingredients.get(\"workshop\", -1))\n              break\n      return workshop_required\n\n  def get_workshop_position(workshop_required):\n      workshop_position = None\n      for x in range(env.world.WIDTH):\n          for y in range(env.world.HEIGHT):\n              if env._current_state.grid[x, y, workshop_required] == 1:\n                  workshop_position = (x, y)\n                  break\n          if workshop_position is not None:\n              break\n      return workshop_position\n\n  def calculate_actions(current_pos, target_pos):\n      actions = []\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dy > 0:\n          actions.extend([env.world.UP for _ in range(dy)])\n      elif dy < 0:\n          actions.extend([env.world.DOWN for _ in range(-dy)])\n\n      if dx > 0:\n          actions.extend([env.world.RIGHT for _ in range(dx)])\n      elif dx < 0:\n          actions.extend([env.world.LEFT for _ in range(-dx)])\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_required = find_workshop(item_index)\n\n  if workshop_required is None:\n      return []\n\n  workshop_position = get_workshop_position(workshop_required)\n  \n  if workshop_position is None:\n      return []\n\n  current_pos = env._current_state.pos\n  actions_to_workshop = calculate_actions(current_pos, workshop_position)\n\n  # Add the USE action to craft the item at the workshop\n  actions_to_workshop.append(env.world.USE)\n\n  return actions_to_workshop", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-25T21:07:06.506284", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    actions = []\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dx > 0:\n      actions.extend([3] * abs(dx))  # Move RIGHT\n    elif dx < 0:\n      actions.extend([2] * abs(dx))  # Move LEFT\n\n    if dy > 0:\n      actions.extend([0] * abs(dy))  # Move DOWN\n    elif dy < 0:\n      actions.extend([1] * abs(dy))  # Move UP\n\n    return actions\n\n  def get_workshop_position(workshop_type):\n    for i, idx in enumerate(env._current_state.workshop_indices):\n        if idx == workshop_type:\n            return np.unravel_index(i, env._current_state.grid.shape[:2])\n    return None\n\n  item_index = env.world.cookbook.index[item]\n  actions = []\n\n  # Find the recipe for the desired item\n  for recipe in env.world.cookbook.recipes.values():\n    if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n      workshop_type = int(recipe[\"recipe_type\"])\n      \n      # Get position of the workshop\n      workshop_pos = get_workshop_position(workshop_type)\n      if workshop_pos is None:\n        raise ValueError(f\"No available workshop for {item}\")\n\n      actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n\n      # Once at the workshop, perform the USE action to craft the item\n      actions.append(4)  # Assuming USE is represented by 4\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-25T21:07:07.581536", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    actions = []\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dx > 0:\n      actions.extend([3] * abs(dx))  # Move RIGHT\n    elif dx < 0:\n      actions.extend([2] * abs(dx))  # Move LEFT\n\n    if dy > 0:\n      actions.extend([0] * abs(dy))  # Move DOWN\n    elif dy < 0:\n      actions.extend([1] * abs(dy))  # Move UP\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  actions = []\n\n  # Find the recipe for the desired item\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe available for {item}\")\n\n  recipe = env.world.cookbook.recipes[item_index]\n\n  workshop_type = int(recipe.get(\"recipe_type\", -1))\n  \n  if workshop_type == -1:\n    raise ValueError(f\"Recipe for {item} does not specify a valid workshop type.\")\n\n  # Find all workshops of the required type in the grid\n  workshops = [i for i, idx in enumerate(env._current_state.workshop_indices) if idx == workshop_type]\n  if not workshops:\n    raise ValueError(f\"No available workshop for {item}\")\n\n  # Choose the closest workshop to move to\n  closest_workshop_index = min(workshops, key=lambda x: np.linalg.norm(np.unravel_index(x, env._current_state.grid.shape[:2]) - np.array(env._current_state.pos)))\n  \n  # Calculate the position to move towards the closest workshop\n  workshop_pos = np.unravel_index(closest_workshop_index, env._current_state.grid.shape[:2])\n  actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n\n  # Once at the workshop, perform the USE action to craft the item\n  actions.append(4)  # Assuming USE is represented by 4\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-25T21:08:09.009189", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the workshop that can be used to craft the item\n  workshop_index = None\n  \n  # Check if the required ingredients are in the inventory\n  for recipe, ingredients in env.world.cookbook.recipes.items():\n    if recipe == item_index:\n      # Assuming one of the workshops can be used to craft any item\n      workshop_index = env.world.workshop_indices[0]\n      break\n  \n  # If no suitable workshop is found, raise an error\n  if workshop_index is None:\n    raise ValueError(f\"No suitable workshop found for crafting {item}\")\n  \n  # Find the position of the nearest workshop in the grid\n  pos = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  if len(pos) == 0:\n    raise ValueError(\"No workshop found on the grid\")\n  \n  target_pos = tuple(pos[0])\n  \n  # Calculate the actions needed to reach the nearest workshop\n  actions_to_reach_workshop = []\n  current_pos = env._current_state.pos\n  \n  while current_pos != target_pos:\n    delta_x = target_pos[0] - current_pos[0]\n    delta_y = target_pos[1] - current_pos[1]\n    \n    if delta_x < 0:\n      actions_to_reach_workshop.append(env.world.N_ACTIONS.DOWN)\n    elif delta_x > 0:\n      actions_to_reach_workshop.append(env.world.N_ACTIONS.UP)\n      \n    if delta_y < 0:\n      actions_to_reach_workshop.append(env.world.N_ACTIONS.LEFT)\n    elif delta_y > 0:\n      actions_to_reach_workshop.append(env.world.N_ACTIONS.RIGHT)\n      \n    # Update current position based on the action taken\n    if delta_x != 0:\n      current_pos = (current_pos[0] + (-1 if delta_x < 0 else 1), current_pos[1])\n    elif delta_y != 0:\n      current_pos = (current_pos[0], current_pos[1] + (-1 if delta_y < 0 else 1))\n  \n  # Add the USE action to craft the item\n  actions_to_reach_workshop.append(env.world.N_ACTIONS.USE)\n  \n  return actions_to_reach_workshop", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-25T21:08:10.181909", "function_name": "craft", "function_body": "  # Get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n  \n  # Retrieve the workshop needed for crafting the item from the recipes.\n  recipe = env.world.cookbook.recipes[item_index]\n  if \"_key\" in recipe:\n    key_index = recipe[\"_key\"]\n    workshop_indices = [index for index, value in env.world.cookbook.recipes.items() if key_index in value and \"_key\" not in value]\n    workshop_index = workshop_indices[0]  # Assuming there is only one such workshop\n  else:\n    workshop_index = None\n\n  actions = []\n\n  # If the item doesn't require a workshop, return an empty list.\n  if workshop_index is None:\n    return actions\n\n  # Get the position of the nearest workshop for crafting.\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  direction = env._current_state.dir\n  \n  # Assuming we have a function to find the nearest location of an item in the grid, let's call it `find_nearest_location`.\n  def find_nearest_location(grid, target_index):\n    height, width, _ = grid.shape\n    min_distance = float('inf')\n    nearest_pos = None\n    for y in range(height):\n      for x in range(width):\n        if grid[y, x, target_index] > 0:\n          distance = abs(y - pos[0]) + abs(x - pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            nearest_pos = (y, x)\n    return nearest_pos\n\n  workshop_position = find_nearest_location(grid, workshop_index)\n\n  # Calculate the direction to move to reach the workshop.\n  def calculate_direction(current_pos, target_pos):\n    dy = target_pos[0] - current_pos[0]\n    dx = target_pos[1] - current_pos[1]\n    \n    if abs(dy) > abs(dx):  # Move vertically\n        return craft.DOWN if dy > 0 else craft.UP\n    else:  # Move horizontally\n        return craft.RIGHT if dx > 0 else craft.LEFT\n\n  direction_to_workshop = calculate_direction(pos, workshop_position)\n\n  # Add actions to move towards the workshop.\n  while pos != workshop_position:\n      actions.append(direction_to_workshop)\n      new_state = env._current_state.step(direction_to_workshop)[1]\n      pos = new_state.pos\n      direction_to_workshop = calculate_direction(pos, workshop_position)  # Recalculate direction in case of obstacles\n\n  # Add the USE action to start crafting.\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
