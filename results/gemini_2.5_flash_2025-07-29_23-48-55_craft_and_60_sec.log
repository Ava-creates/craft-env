{"timestamp": "2025-07-30T01:19:35.233183", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment. This ensures the planning starts\n  # from the current state of the CraftLab environment, without resetting it.\n  initial_craft_state = env._current_state\n  initial_state_hash = _hash_state(initial_craft_state)\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, current_path_length).\n  # `current_path_length` keeps track of the number of actions taken to reach `current_CraftState_object`.\n  queue = deque()\n  queue.append((initial_craft_state, 0)) # Start with initial state and path length 0\n\n  # `parent_map` stores the path information for reconstruction.\n  # Key: hash of the current state, Value: (hash of the parent state, action taken from parent to current)\n  # This is a memory-efficient way to store paths compared to storing full action lists in the queue,\n  # which was a potential inefficiency in `craft_v1`.\n  parent_map = {initial_state_hash: (None, None)} # Initial state has no parent\n\n  # `visited_hashes` is a set to keep track of state hashes that have already been\n  # explored, preventing redundant processing and infinite loops in cycles.\n  visited_hashes = {initial_state_hash}\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This serves as the upper bound for the path length in the BFS. If `max_steps`\n  # is not found, a default of 500 is used for robustness.\n  max_path_length = getattr(env, 'max_steps', 500)\n\n  # Define all possible actions as integer IDs. These correspond to the actions\n  # defined in CraftLab (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  goal_found_state_hash = None # Will store the hash of the state where the goal was achieved\n\n  # BFS main loop\n  while queue:\n      current_state, current_path_length = queue.popleft()\n\n      # Pruning condition: If the current path length already equals or exceeds the maximum allowed steps,\n      # any further actions from this state would exceed the episode limit.\n      # A path of `max_path_length` actions is considered valid, but no more actions can be taken from it.\n      if current_path_length >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only need the new state.\n          _, new_state = current_state.step(action)\n          new_state_hash = _hash_state(new_state)\n          new_path_length = current_path_length + 1\n\n          # If the resulting path length (after taking this action) exceeds the maximum allowed,\n          # this particular sequence of actions is invalid, so we skip it.\n          if new_path_length > max_path_length:\n              continue\n\n          # If this new state has not been visited before, process it.\n          if new_state_hash not in visited_hashes:\n              visited_hashes.add(new_state_hash)\n              # Store the parent state and the action taken to reach this new state in the `parent_map`.\n              parent_map[new_state_hash] = (_hash_state(current_state), action)\n\n              # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n              if new_state.satisfies(None, item):\n                  goal_found_state_hash = new_state_hash\n                  break # Goal found, exit the inner loop (actions exploration for current state)\n              else:\n                  # If not the goal, add it to the queue to explore its future possibilities.\n                  queue.append((new_state, new_path_length))\n      \n      # If the goal was found in the inner loop, break the outer loop (BFS) as well.\n      if goal_found_state_hash is not None:\n          break\n\n  # If `goal_found_state_hash` is still None after the BFS completes, it means the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  if goal_found_state_hash is None:\n      return []\n\n  # Reconstruct the path by backtracking from the `goal_found_state_hash` using the `parent_map`.\n  path = []\n  current_hash = goal_found_state_hash\n  # Backtrack until we reach the initial state (which is the root in our `parent_map`).\n  while current_hash != initial_state_hash:\n      parent_hash, action = parent_map[current_hash]\n      path.append(action)\n      current_hash = parent_hash\n  \n  # The path is built in reverse order (from goal to start), so reverse it to get\n  # the correct sequence of actions from start to goal.\n  path.reverse()\n  return path", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T01:21:04.794191", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      # This provides a unique and hashable representation of the state.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment.\n  # This function operates on the *current* state of the `env` object.\n  initial_craft_state = env._current_state\n  initial_state_hash = _hash_state(initial_craft_state)\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, current_state_hash, current_depth).\n  # Storing the hash along with the state avoids recomputing it multiple times.\n  queue = deque()\n  queue.append((initial_craft_state, initial_state_hash, 0))\n\n  # Initialize the set of visited states to prevent cycles and redundant computations.\n  # Stores only the hashable representation of states.\n  visited = {initial_state_hash}\n\n  # `parent_map` stores the path information. It maps a state's hash to a tuple\n  # (parent_state_hash, action_taken_from_parent_to_reach_this_state).\n  # This allows reconstructing the shortest path by backtracking once the goal is found,\n  # avoiding costly list concatenations in the main loop.\n  parent_map = {} # The initial state has no parent in the search graph, so it's not in this map.\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This acts as a maximum path length for the BFS.\n  max_path_length = env.max_steps\n\n  # Define all possible actions as integer IDs.\n  ALL_ACTIONS = [0, 1, 2, 3, 4] # DOWN, UP, LEFT, RIGHT, USE\n\n  # BFS main loop\n  while queue:\n      current_state, current_state_hash, current_depth = queue.popleft()\n\n      # Pruning condition: If the current path depth already equals or exceeds the maximum allowed steps,\n      # there's no need to explore further from this branch, as any deeper path would be too long.\n      # This also handles the case where `current_depth == max_path_length` and it's not a goal state:\n      # such a path cannot be extended further to reach a goal within the allowed steps.\n      if current_depth >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only need the new state.\n          _, new_state = current_state.step(action)\n          new_state_hash = _hash_state(new_state)\n          new_depth = current_depth + 1\n\n          # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n          if new_state.satisfies(None, item):\n              # Goal reached! Reconstruct the path using the parent map.\n              # First, record the final transition to the goal state.\n              parent_map[new_state_hash] = (current_state_hash, action)\n              \n              path = []\n              trace_hash = new_state_hash\n              # Backtrack from the goal state to the initial state.\n              # The loop continues until the initial state's hash is reached,\n              # as the initial state is the root and not present in `parent_map`'s keys.\n              while trace_hash != initial_state_hash:\n                  parent_hash, act = parent_map[trace_hash]\n                  path.append(act)\n                  trace_hash = parent_hash\n              return path[::-1] # Reverse the path to get actions in the correct chronological order.\n\n          # If this new state has not been visited before AND its depth is within the limit,\n          # add it to the visited set and the queue for future exploration.\n          # The `new_depth <= max_path_length` check here prevents adding paths that would\n          # immediately be pruned upon popping from the queue or would exceed the maximum depth.\n          if new_state_hash not in visited and new_depth <= max_path_length:\n              visited.add(new_state_hash)\n              # Store the parent information: how we reached this new state.\n              parent_map[new_state_hash] = (current_state_hash, action)\n              queue.append((new_state, new_state_hash, new_depth))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T01:21:27.271950", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function to create a hashable representation of a CraftState.\n  # This is crucial for using states in a `set` to track visited states,\n  # preventing redundant explorations and infinite loops in the BFS.\n  def _hash_state(state):\n      \"\"\"\n      Hashes the essential components of a CraftState: grid, inventory, position, and direction.\n      Numpy arrays are converted to bytes for hashability as they are not directly hashable.\n      \"\"\"\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial CraftState from the current environment.\n  # This allows the planner to operate from the environment's current internal state\n  # without needing to reset it, making it flexible for intermediate planning.\n  initial_craft_state = env._current_state\n\n  # Early exit: If the target item is already present in the initial inventory,\n  # no actions are needed to craft it.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple:\n  # (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = deque()\n  queue.append((initial_craft_state, []))\n\n  # Initialize the set of visited states.\n  # This set stores the hashable representation of states to avoid re-visiting\n  # and re-exploring paths from already processed states. This is vital for\n  # efficiency, preventing cycles, and ensuring the shortest path is found by BFS.\n  visited = set()\n  visited.add(_hash_state(initial_craft_state))\n\n  # Retrieve the maximum allowed path length (number of actions) from the environment.\n  # This serves as a hard limit for the search depth, pruning paths that exceed it.\n  # Solutions will not exceed this length.\n  max_path_length = env.max_steps\n\n  # Define all possible actions. These correspond to the integer action IDs\n  # as defined in CraftLab (e.g., 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  # BFS main loop: continues as long as there are states to explore in the queue.\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Pruning condition: If the path to the `current_state` already equals or\n      # exceeds the `max_path_length`, we cannot take any further steps from this\n      # state and still remain within the allowed limit. So, we skip this branch.\n      if len(actions_taken) >= max_path_length:\n          continue\n\n      # Explore each possible action from the `current_state`.\n      for action in ALL_ACTIONS:\n          # Simulate taking the `action` to transition to a `new_state`.\n          # The `CraftState.step` method returns (reward, new_CraftState_object).\n          # We are primarily interested in the `new_state`.\n          _, new_state = current_state.step(action)\n          # Construct the path of actions taken to reach the `new_state`.\n          new_actions_taken = actions_taken + [action]\n\n          # Check if the `new_state` satisfies the crafting goal.\n          if new_state.satisfies(None, item):\n              # If the goal is satisfied, BFS guarantees that this is the shortest sequence\n              # of actions from the initial state. The length of this path will be\n              # within the `max_path_length` limit due to the pruning logic.\n              return new_actions_taken\n\n          # Generate a hashable representation for the `new_state` for efficient lookup in the `visited` set.\n          new_state_hash = _hash_state(new_state)\n\n          # Add the `new_state` to the queue for future exploration only if:\n          # 1. It has not been visited before (to prevent cycles and redundant work).\n          # 2. The path length to it (`len(new_actions_taken)`) does not exceed the `max_path_length`.\n          #    This proactive pruning step reduces the size of the queue and visited set\n          #    by preventing the addition of paths that would immediately be discarded later.\n          if new_state_hash not in visited and len(new_actions_taken) <= max_path_length:\n              visited.add(new_state_hash)\n              queue.append((new_state, new_actions_taken))\n\n  # If the BFS queue becomes empty and the goal was never reached, it implies that\n  # the target item cannot be crafted from the initial state within the given\n  # `max_path_length` limit.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
