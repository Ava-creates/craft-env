{"timestamp": "2025-07-30T00:31:02.939262", "function_name": "craft", "function_body": "  import collections\n  import copy\n  import numpy as np\n\n  # Action constants (assuming these are globally defined or accessible from env.action_specs())\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Max search depth for item collection/crafting recursion\n  MAX_PLAN_DEPTH = 50 \n  # Max movement steps for pathfinding (BFS for grid navigation)\n  MAX_MOVEMENT_STEPS = 100 \n\n  def _get_hashable_state(state):\n      \"\"\"Returns a hashable representation of a CraftState for visited set.\"\"\"\n      # Hashing only mutable parts of the state: position, direction, and inventory.\n      # The grid is implicitly handled by the CraftState.step() which returns a new state.\n      return (state.pos, state.dir, tuple(state.inventory))\n\n  def _find_path_to_adj(start_state, target_kind_idx, max_steps=MAX_MOVEMENT_STEPS):\n      \"\"\"\n      Finds a path (sequence of move actions) from start_state to a state where\n      the agent is adjacent to `target_kind_idx`.\n      Returns (list_of_actions, final_state) or (None, None) if no path found.\n      \"\"\"\n      q = collections.deque([(copy.deepcopy(start_state), [])])\n      visited = {_get_hashable_state(start_state)}\n\n      while q:\n          current_state, actions_so_far = q.popleft()\n\n          if len(actions_so_far) > max_steps:\n              continue # Pruning: path too long\n\n          # Check if the agent is next to the target kind\n          if current_state.next_to(target_kind_idx):\n              return actions_so_far, current_state # Path found to adjacency\n\n          # Explore valid neighboring states\n          for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n              _, new_state = current_state.step(action)\n              new_hash = _get_hashable_state(new_state)\n              if new_hash not in visited:\n                  visited.add(new_hash)\n                  q.append((new_state, actions_so_far + [action]))\n\n      return None, None # No path found to target_kind_idx adjacency\n\n  def _plan_for_item_recursive(current_state, target_item_idx, max_depth, path_cache):\n      \"\"\"\n      Recursive helper function to find a plan (list of actions) to acquire `target_item_idx`.\n      It explores two main ways: picking up the item or crafting it.\n      \n      Args:\n          current_state: A CraftState instance representing the current environment state.\n          target_item_idx: The integer index of the item to acquire.\n          max_depth: Maximum recursion depth to prevent infinite loops in recipes.\n          path_cache: A dictionary for memoization: (state_hash, item_idx) -> (actions, final_state).\n                      Stores results of previously computed sub-plans.\n\n      Returns:\n          A tuple (list_of_actions, final_state) if a plan is found, \n          otherwise (None, None).\n      \"\"\"\n\n      # Base case: Item is already in inventory\n      if current_state.inventory[target_item_idx] > 0:\n          return [], current_state\n\n      state_hash = _get_hashable_state(current_state)\n      cache_key = (state_hash, target_item_idx)\n\n      # Check memoization cache\n      if cache_key in path_cache:\n          return path_cache[cache_key]\n\n      # Pruning: Too deep recursion\n      if max_depth <= 0:\n          path_cache[cache_key] = (None, None)\n          return None, None\n\n      cookbook = current_state.world.cookbook\n      recipes = cookbook.recipes\n      index = cookbook.index\n\n      # --- Strategy 1: Attempt to acquire by picking up (if it's a grabbable item) ---\n      # Check if target_item_idx is in the list of grabbable indices.\n      if target_item_idx in current_state.world.grabbable_indices:\n          actions_to_adj, state_adj = _find_path_to_adj(current_state, target_item_idx)\n          \n          if actions_to_adj is not None:\n              # We are adjacent to the item, now try to USE it\n              _, state_after_pickup = state_adj.step(ACTION_USE)\n              \n              # Verify if the item was successfully picked up (inventory count increased)\n              if state_after_pickup.inventory[target_item_idx] > state_adj.inventory[target_item_idx]:\n                  final_actions = actions_to_adj + [ACTION_USE]\n                  path_cache[cache_key] = (final_actions, state_after_pickup)\n                  return final_actions, state_after_pickup\n\n      # --- Strategy 2: Attempt to acquire by crafting (if a recipe exists) ---\n      if target_item_idx in recipes:\n          recipe = recipes[target_item_idx]\n          total_actions = []\n          state_after_ingredients_collected = copy.deepcopy(current_state) # Work with a copy for planning\n\n          # Collect all necessary ingredients first\n          for ingredient_idx_str, count_needed in recipe.items():\n              if ingredient_idx_str == '_key':\n                  continue # This is the workshop key, handled separately\n\n              ingredient_idx = int(ingredient_idx_str)\n              \n              # Determine how many units of this ingredient are still needed\n              current_has_count = state_after_ingredients_collected.inventory[ingredient_idx]\n              to_get_count = count_needed - current_has_count\n              \n              # Recursively plan to get each needed unit of the ingredient\n              for _ in range(to_get_count):\n                  ingr_actions, ingr_final_state = _plan_for_item_recursive(\n                      state_after_ingredients_collected, ingredient_idx, max_depth - 1, path_cache\n                  )\n\n                  if ingr_actions is None:\n                      # Cannot acquire this ingredient, so cannot craft the target item\n                      path_cache[cache_key] = (None, None)\n                      return None, None\n                  \n                  total_actions.extend(ingr_actions)\n                  state_after_ingredients_collected = ingr_final_state # Update state for next ingredient planning\n\n          # All ingredients are (theoretically) collected. Now, proceed to craft.\n          # Crafting typically requires a workshop.\n          workshop_key = recipe.get('_key')\n          if workshop_key:\n              workshop_idx = index.index(workshop_key) # Get numerical index of the workshop\n\n              # Find path to the workshop\n              actions_to_workshop_adj, state_at_workshop_adj = _find_path_to_adj(\n                  state_after_ingredients_collected, workshop_idx\n              )\n              if actions_to_workshop_adj is None:\n                  path_cache[cache_key] = (None, None)\n                  return None, None # Cannot reach the required workshop\n\n              # Try to USE at the workshop\n              _, final_state_after_craft = state_at_workshop_adj.step(ACTION_USE)\n\n              # Verify if crafting was successful (target item count increased)\n              if final_state_after_craft.inventory[target_item_idx] > state_at_workshop_adj.inventory[target_item_idx]:\n                  final_actions = total_actions + actions_to_workshop_adj + [ACTION_USE]\n                  path_cache[cache_key] = (final_actions, final_state_after_craft)\n                  return final_actions, final_state_after_craft\n              else:\n                  # Crafting failed (e.g., perhaps not all ingredients truly available at the time of USE,\n                  # or wrong workshop, or other environmental constraints not modeled here).\n                  path_cache[cache_key] = (None, None)\n                  return None, None\n          else:\n              # No workshop specified for this recipe.\n              # In CraftWorld, most crafting needs a workshop. If no key, it might be an implicit\n              # recipe or an unhandled special case. We assume it's not craftable without a workshop.\n              path_cache[cache_key] = (None, None)\n              return None, None\n\n      # If neither picking up nor crafting was successful for this item\n      path_cache[cache_key] = (None, None)\n      return None, None\n\n  # Get the initial state from the CraftLab environment.\n  # It's crucial to deepcopy env._current_state to ensure the planner operates\n  # on a hypothetical state and does not modify the actual environment.\n  initial_state_for_planning = copy.deepcopy(env._current_state)\n\n  # Validate the target item index\n  if item < 0 or item >= initial_state_for_planning.world.cookbook.n_kinds:\n      print(f\"Warning: Target item index {item} is out of bounds for the current cookbook.\")\n      return []\n\n  # Initialize the cache for memoization across recursive calls\n  plan_cache = {}\n\n  # Start the recursive planning process for the target item\n  actions, final_state = _plan_for_item_recursive(initial_state_for_planning, item, MAX_PLAN_DEPTH, plan_cache)\n\n  # Check if a plan was found and if the goal item is actually in the final inventory\n  if actions is not None and final_state is not None and final_state.inventory[item] > 0:\n      return actions\n  else:\n      # If no plan found, or the item was not acquired, return an empty list.\n      return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:32:26.080401", "function_name": "craft", "function_body": "  import collections # Required for collections.deque\n\n  # Define action constants based on the problem description mapping.\n  # CraftLab.action_specs() specifies: DOWN\u21920, UP\u21921, LEFT\u21922, RIGHT\u21923, USE\u21924\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ACTIONS_LIST = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  def _state_to_hashable(state):\n      \"\"\"\n      Converts a CraftState object into a hashable tuple for use in a set.\n      Numpy arrays (grid, inventory) are converted to bytes for efficient hashing\n      and comparison. Position (pos) and direction (dir) are already hashable.\n      \"\"\"\n      return (state.grid.tobytes(), state.pos, state.dir, state.inventory.tobytes())\n\n  # Start with the current state of the environment provided by CraftLab\n  initial_craft_state = env._current_state\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_craft_state_object, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(initial_craft_state, [])])\n\n  # Initialize a set to keep track of visited states. This prevents infinite loops\n  # and redundant computation by not re-exploring states already seen.\n  # States are stored in their hashable representation.\n  visited = {_state_to_hashable(initial_craft_state)}\n\n  # Set a maximum number of steps for the search. This is a safety measure\n  # to prevent the search from running indefinitely in very large or unsolvable environments.\n  MAX_SEARCH_STEPS = 500000 \n  num_steps_explored = 0\n\n  # Perform BFS\n  while queue:\n      current_state, actions_taken = queue.popleft()\n      num_steps_explored += 1\n\n      # Check if the search limit has been reached.\n      if num_steps_explored > MAX_SEARCH_STEPS:\n          # If the limit is exceeded, no path was found within the allowed computation.\n          return []\n\n      # Check if the goal (crafting the specified 'item') is satisfied in the current state.\n      # The `satisfies` method expects `(goal_name, goal_arg)`. Here, `goal_name` is\n      # ignored (passed as None), and `goal_arg` is the integer index of the desired item.\n      if current_state.satisfies(None, item):\n          # Goal achieved! Return the sequence of actions that led to this state.\n          return actions_taken\n\n      # Explore all possible actions from the current state.\n      for action in ACTIONS_LIST:\n          # Simulate the chosen action using the `step` method of CraftState.\n          # `step` returns a reward (which is always 0.0 in this implementation) and the new state.\n          _, next_state = current_state.step(action)\n\n          # Get the hashable representation of the resulting state.\n          next_state_hashable = _state_to_hashable(next_state)\n\n          # If this new state has not been visited before, add it to the queue\n          # for future exploration and mark it as visited.\n          if next_state_hashable not in visited:\n              visited.add(next_state_hashable)\n              queue.append((next_state, actions_taken + [action]))\n\n  # If the queue becomes empty and the goal was never reached, it means the item\n  # cannot be crafted from the initial state within the search limits.\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:32:26.155511", "function_name": "craft", "function_body": "    # Action constants (standard for CraftWorld/CraftLab mapping)\n    # These are commonly defined as global constants or within an enum in the actual project.\n    # For this completion, we'll define them here to ensure they are available within the function scope.\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Get the initial state from the CraftLab environment\n    initial_state = env._current_state\n    goal_item_idx = item  # 'item' is already the integer index of the desired item\n\n    # Queue for Breadth-First Search (BFS): stores tuples of (CraftState, list_of_actions)\n    # Using collections.deque for efficient appends and pops from both ends.\n    q = collections.deque()\n    q.append((initial_state, []))\n\n    # Set to store visited states to avoid cycles and redundant computation.\n    # A state is represented by a hashable tuple:\n    # (flattened_grid_tuple, inventory_tuple, position_tuple, direction_int)\n    visited = set()\n\n    def get_state_key(state):\n        \"\"\"Generates a hashable key for a CraftState to be used in the 'visited' set.\"\"\"\n        # Convert numpy arrays to tuples for hashing, as arrays are not hashable by default.\n        grid_key = tuple(state.grid.flatten())\n        inventory_key = tuple(state.inventory)\n        return (grid_key, inventory_key, state.pos, state.dir)\n\n    # Add the initial state to the visited set\n    initial_key = get_state_key(initial_state)\n    visited.add(initial_key)\n\n    # All possible actions in CraftWorld\n    actions_list = [DOWN, UP, LEFT, RIGHT, USE]\n\n    # BFS loop\n    while q:\n        current_state, current_actions = q.popleft()\n\n        # Check if the goal item is in the current state's inventory.\n        # The `satisfies` method checks if inventory[goal_arg] > 0.\n        if current_state.satisfies(None, goal_item_idx):\n            return current_actions  # Goal reached, return the sequence of actions\n\n        # Explore all possible next actions from the current state\n        for action in actions_list:\n            # Simulate the action to get the next state.\n            # The reward is always 0.0 in this implementation, so we ignore it.\n            _reward, next_state = current_state.step(action)\n\n            # Get the hashable key for the next state\n            next_key = get_state_key(next_state)\n\n            # If this state has not been visited before, add it to the queue and visited set.\n            # This ensures we find the shortest path in terms of actions and avoid infinite loops.\n            if next_key not in visited:\n                visited.add(next_key)\n                q.append((next_state, current_actions + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means\n    # the item cannot be crafted or reached from the initial state given the current environment.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:34:25.512100", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction deltas (dx, dy) for each direction (North, East, South, West)\n  # Used to determine the coordinates of the cell directly in front of the agent.\n  DIR_TO_DELTAS = {\n      0: (0, -1),  # North: agent moves/looks in negative Y direction\n      1: (1, 0),   # East: agent moves/looks in positive X direction\n      2: (0, 1),   # South: agent moves/looks in positive Y direction\n      3: (-1, 0)   # West: agent moves/looks in negative X direction\n  }\n\n  # Cache for memoization in the recursive planner.\n  # Maps (simplified_state_tuple, target_item_idx) -> (success_bool, actions_list)\n  # This cache is cleared at the beginning of each call to craft_vX.\n  _PLANNER_CACHE = {}\n\n  # A hard limit on the total number of actions in a plan.\n  # Prevents infinite loops in complex or impossible scenarios.\n  _MAX_PLANNER_ACTIONS = 200\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    \"\"\"\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  def _simulate_actions(initial_state, actions):\n    \"\"\"\n    Applies a sequence of actions to an initial CraftState and returns the\n    final CraftState after all actions are performed.\n    \"\"\"\n    current_s = initial_state\n    for action in actions:\n      _, current_s = current_s.step(action)\n    return current_s\n\n  def _bfs_move_to_kind(start_state, target_kind_idx, max_steps_for_move):\n    \"\"\"\n    Performs a Breadth-First Search (BFS) to find a path (sequence of move actions)\n    that leads the agent to a position where `target_kind_idx` is on a\n    *cardinally adjacent* cell.\n    \n    Args:\n      start_state: The initial CraftState for the BFS.\n      target_kind_idx: The integer index of the item/entity to move towards.\n      max_steps_for_move: Maximum number of movement steps allowed for this BFS.\n      \n    Returns:\n      (final_state, actions_list) if a path is found and successful,\n      else (None, None). The final_state will be next to the target,\n      but not necessarily facing it.\n    \"\"\"\n    q = collections.deque([(start_state, [])])\n    visited = {_get_simplified_state_tuple(start_state)}\n\n    steps_taken_in_bfs = 0\n    WIDTH, HEIGHT, _ = start_state.grid.shape # Get grid dimensions once\n\n    while q and steps_taken_in_bfs < max_steps_for_move:\n      current_s, current_actions = q.popleft()\n\n      # Check if current_s is already positioned such that `target_kind_idx`\n      # is on a cardinal neighbor.\n      for dx_check, dy_check in DIR_TO_DELTAS.values(): # Iterate over cardinal directions\n        nx, ny = current_s.pos[0] + dx_check, current_s.pos[1] + dy_check\n        \n        if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n          if current_s.grid[nx, ny, target_kind_idx] > 0:\n            # Found a cardinal adjacent cell with the target kind. This is our goal.\n            return current_s, current_actions\n\n      # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n      for action in [DOWN, UP, LEFT, RIGHT]:\n        # Prune paths that would exceed the individual BFS step limit\n        if len(current_actions) + 1 > max_steps_for_move:\n          continue \n\n        # Simulate the step to get the next state\n        _, next_s = current_s.step(action)\n        next_state_tuple = _get_simplified_state_tuple(next_s)\n\n        if next_state_tuple not in visited:\n          visited.add(next_state_tuple)\n          q.append((next_s, current_actions + [action]))\n          steps_taken_in_bfs += 1 # Increment step count for BFS overall limit\n\n    return None, None # Path not found within limits\n\n  def _get_turn_and_use_actions(current_state, target_kind_idx):\n    \"\"\"\n    Calculates the actions needed to turn towards a *cardinal neighbor*\n    containing `target_kind_idx` and then perform the USE action.\n    Assumes `current_state` is already positioned such that `target_kind_idx`\n    is present on a cardinal neighbor cell.\n    \n    Args:\n      current_state: The CraftState from which to perform turns and USE.\n      target_kind_idx: The integer index of the item/entity to use.\n      \n    Returns:\n      A list of actions (e.g., [RIGHT, USE] or [USE]), or an empty list\n      if no valid cardinal target is found.\n    \"\"\"\n    actions = []\n    WIDTH, HEIGHT, _ = current_state.grid.shape\n\n    # Find the specific cardinal adjacent cell containing `target_kind_idx`\n    target_cell_to_face = None\n    \n    # Iterate only over cardinal directions to find the target\n    for dx_rel, dy_rel in DIR_TO_DELTAS.items():\n      check_x, check_y = current_state.pos[0] + dx_rel, current_state.pos[1] + dy_rel\n\n      if 0 <= check_x < WIDTH and 0 <= check_y < HEIGHT:\n        if current_state.grid[check_x, check_y, target_kind_idx] > 0:\n          target_cell_to_face = (check_x, check_y)\n          break # Found a cardinal neighbor, prioritize this one\n\n    if target_cell_to_face is None:\n      # This case implies the agent is positioned next to an item/workshop,\n      # but it's only diagonally adjacent, or on the agent's current cell.\n      # For `USE` action to be meaningful (acting on the cell in front),\n      # a cardinal neighbor is required.\n      return [] \n\n    # Calculate the relative position of the target cell from the agent's position\n    px, py = current_state.pos\n    tx, ty = target_cell_to_face\n    \n    dx_target = tx - px\n    dy_target = ty - py\n\n    # Determine the required direction index (0=N, 1=E, 2=S, 3=W) to face the target\n    required_dir = None\n    for direction_idx, (ddx, ddy) in DIR_TO_DELTAS.items():\n      if ddx == dx_target and ddy == dy_target:\n        required_dir = direction_idx\n        break\n    \n    if required_dir is None:\n      # Should not happen if `target_cell_to_face` was found using `DIR_TO_DELTAS.values()`\n      return [] \n            \n    # Calculate the minimum turns needed to face the `required_dir` from `current_state.dir`\n    turn_diff = (required_dir - current_state.dir + 4) % 4\n    if turn_diff == 1:       actions.append(RIGHT)         # 1 turn right\n    elif turn_diff == 2:     actions.extend([RIGHT, RIGHT])  # 2 turns (can be 2xRIGHT or 2xLEFT)\n    elif turn_diff == 3:     actions.append(LEFT)          # 1 turn left\n    # If turn_diff is 0, no turn action is needed (already facing correctly)\n\n    actions.append(USE) # Finally, add the USE action\n    return actions\n\n  def _recursive_craft_helper(current_state, target_item_idx, current_planner_steps, cookbook):\n    \"\"\"\n    Recursive helper function that finds a sequence of actions to craft\n    the `target_item_idx`. It uses a depth-first search like approach with\n    memoization and a global step limit to manage complexity.\n    \n    Args:\n      current_state: The current CraftState of the agent.\n      target_item_idx: The integer index of the item to be crafted/obtained.\n      current_planner_steps: The cumulative number of actions taken so far\n                             in the overall crafting plan.\n      cookbook: Reference to the CraftWorld's Cookbook instance for recipes.\n      \n    Returns:\n      (success_bool, list_of_actions): True and a list of actions if the item\n      can be crafted, False and an empty list otherwise.\n    \"\"\"\n    # --- Memoization / Base cases ---\n    state_tuple = _get_simplified_state_tuple(current_state)\n    memo_key = (state_tuple, target_item_idx)\n\n    if memo_key in _PLANNER_CACHE:\n      return _PLANNER_CACHE[memo_key]\n\n    # Stop if total plan actions exceed the limit, preventing infinite recursion/long plans\n    if current_planner_steps >= _MAX_PLANNER_ACTIONS:\n      _PLANNER_CACHE[memo_key] = (False, [])\n      return False, []\n\n    # If the target item is already in the inventory, no actions are needed for this sub-goal\n    if current_state.inventory[target_item_idx] > 0:\n      _PLANNER_CACHE[memo_key] = (True, [])\n      return True, []\n\n    current_path_actions = [] # Actions accumulated in this specific recursive call\n\n    # --- Case 1: Target is a primitive (collect from the grid) ---\n    if target_item_idx in cookbook.primitives:\n      # First, find a path to be adjacent to the primitive item on the grid\n      moved_state, move_actions = _bfs_move_to_kind(\n          current_state, target_item_idx,\n          _MAX_PLANNER_ACTIONS - current_planner_steps  # Limit steps for this movement sub-plan\n      )\n      if moved_state is None:\n        _PLANNER_CACHE[memo_key] = (False, [])\n        return False, [] # Cannot reach the primitive\n\n      # Then, determine actions to turn towards it and USE it\n      face_and_use_actions = _get_turn_and_use_actions(moved_state, target_item_idx)\n      if not face_and_use_actions:\n        _PLANNER_CACHE[memo_key] = (False, [])\n        return False, [] # Cannot face/use the primitive even if next to it or if it's not a grabbable item\n\n      # Simulate these actions to get the state after attempting collection\n      state_after_attempt = _simulate_actions(moved_state, face_and_use_actions)\n      \n      # Check if collection was successful (inventory count of the item increased)\n      if state_after_attempt.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n        current_path_actions.extend(move_actions)\n        current_path_actions.extend(face_and_use_actions)\n        _PLANNER_CACHE[memo_key] = (True, current_path_actions)\n        return True, current_path_actions\n      else:\n        # Failed to collect, e.g., item was non-grabbable or already gone\n        _PLANNER_CACHE[memo_key] = (False, [])\n        return False, []\n\n    # --- Case 2: Target has a recipe (craft using ingredients and a workshop) ---\n    if target_item_idx in cookbook.recipes:\n      recipe = cookbook.recipes[target_item_idx]\n      \n      ingredients_needed = {}\n      workshop_kind_idx = None\n      requires_workshop = False # Flag to easily check if workshop was part of the recipe\n\n      # Parse ingredients and workshop from the recipe\n      for ing_idx_or_key, count_or_name in recipe.items():\n        if ing_idx_or_key == \"_key\":\n          requires_workshop = True\n          # The workshop is identified by a name string in the YAML, look up its index\n          workshop_kind_idx = cookbook.index[count_or_name]\n          \n          # IMPROVEMENT: If a workshop is required but its index is not found (returns None)\n          # then this recipe is effectively uncraftable.\n          if workshop_kind_idx is None:\n              _PLANNER_CACHE[memo_key] = (False, [])\n              return False, []\n        else:\n          ingredients_needed[ing_idx_or_key] = count_or_name # Actual count (int)\n\n      current_working_state = current_state # State evolves as ingredients are gathered\n      \n      # Collect all required ingredients recursively\n      for ing_idx, required_count in ingredients_needed.items():\n        while current_working_state.inventory[ing_idx] < required_count:\n          # Recursively call to get each required ingredient\n          success, ing_actions = _recursive_craft_helper(\n              current_working_state, ing_idx,\n              current_planner_steps + len(current_path_actions), cookbook\n          )\n          if not success:\n            _PLANNER_CACHE[memo_key] = (False, [])\n            return False, [] # If an ingredient cannot be obtained, crafting fails\n\n          # Apply the actions for obtaining the ingredient and update state/actions\n          current_working_state = _simulate_actions(current_working_state, ing_actions)\n          current_path_actions.extend(ing_actions)\n          \n          # Check total actions against limit after adding ingredient actions\n          if current_planner_steps + len(current_path_actions) >= _MAX_PLANNER_ACTIONS:\n            _PLANNER_CACHE[memo_key] = (False, [])\n            return False, []\n\n      # If a workshop is required, move to it and use it\n      if requires_workshop:\n        # Move to be adjacent to the workshop\n        moved_state_to_workshop, move_actions_to_workshop = _bfs_move_to_kind(\n            current_working_state, workshop_kind_idx,\n            _MAX_PLANNER_ACTIONS - (current_planner_steps + len(current_path_actions))\n        )\n        if moved_state_to_workshop is None:\n          _PLANNER_CACHE[memo_key] = (False, [])\n          return False, [] # Cannot reach the workshop\n\n        current_working_state = moved_state_to_workshop\n        current_path_actions.extend(move_actions_to_workshop)\n\n        if current_planner_steps + len(current_path_actions) >= _MAX_PLANNER_ACTIONS:\n          _PLANNER_CACHE[memo_key] = (False, [])\n          return False, []\n\n        # Turn to face and USE the workshop\n        face_and_use_actions = _get_turn_and_use_actions(current_working_state, workshop_kind_idx)\n        if not face_and_use_actions:\n          _PLANNER_CACHE[memo_key] = (False, [])\n          return False, [] # Cannot face/use the workshop\n\n        current_working_state = _simulate_actions(current_working_state, face_and_use_actions)\n        current_path_actions.extend(face_and_use_actions)\n\n        if current_planner_steps + len(current_path_actions) >= _MAX_PLANNER_ACTIONS:\n          _PLANNER_CACHE[memo_key] = (False, [])\n          return False, []\n\n      # After gathering ingredients and using the workshop (if any),\n      # check if the target item is now successfully in the inventory.\n      # The 'USE' action on a workshop typically consumes ingredients and produces the item.\n      if current_working_state.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n        _PLANNER_CACHE[memo_key] = (True, current_path_actions)\n        return True, current_path_actions\n      else:\n        # Crafting failed (e.g., not enough ingredients despite planning, wrong workshop, etc.)\n        _PLANNER_CACHE[memo_key] = (False, [])\n        return False, []\n\n    # If the item is neither a primitive nor has a known recipe, it cannot be crafted\n    _PLANNER_CACHE[memo_key] = (False, [])\n    return False, []\n\n  # --- Main logic for craft_v2 function ---\n\n  # Clear the planner cache for a fresh start with each new `craft_v2` call.\n  _PLANNER_CACHE.clear()\n\n  # Get the initial state of the environment and the cookbook for recipes\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Initiate the recursive crafting process\n  success, actions = _recursive_craft_helper(initial_state, item, 0, cookbook)\n\n  if success:\n    return actions\n  else:\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:34:26.646202", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction deltas (dx, dy) for each direction (North, East, South, West)\n  # Used to determine the coordinates of the cell directly in front of the agent.\n  DIR_TO_DELTAS = {\n      0: (0, -1),  # North: agent moves/looks in negative Y direction\n      1: (1, 0),   # East: agent moves/looks in positive X direction\n      2: (0, 1),   # South: agent moves/looks in positive Y direction\n      3: (-1, 0)   # West: agent moves/looks in negative X direction\n  }\n\n  # A hard limit on the total number of actions in a plan.\n  # This acts as the maximum depth for the Iterative Deepening search.\n  _MAX_TOTAL_PLANNER_ACTIONS_GLOBAL_HARD_LIMIT = 200\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    \"\"\"\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  def _simulate_actions(initial_state, actions):\n    \"\"\"\n    Applies a sequence of actions to an initial CraftState and returns the\n    final CraftState after all actions are performed.\n    \"\"\"\n    current_s = initial_state\n    for action in actions:\n      _, current_s = current_s.step(action)\n    return current_s\n\n  def _bfs_move_to_kind(start_state, target_kind_idx, max_steps_for_move):\n    \"\"\"\n    Performs a Breadth-First Search (BFS) to find a path (sequence of move actions)\n    that leads the agent to a position where `target_kind_idx` is on a\n    *cardinally adjacent* cell.\n    \n    Args:\n      start_state: The initial CraftState for the BFS.\n      target_kind_idx: The integer index of the item/entity to move towards.\n      max_steps_for_move: Maximum number of movement steps allowed for this BFS.\n      \n    Returns:\n      (final_state, actions_list) if a path is found and successful,\n      else (None, None). The final_state will be next to the target,\n      but not necessarily facing it.\n    \"\"\"\n    q = collections.deque([(start_state, [])])\n    visited = {_get_simplified_state_tuple(start_state)}\n\n    # steps_taken_in_bfs here limits the BFS length to prevent it from\n    # finding paths that are too long for the current overall depth limit.\n    steps_taken_in_bfs = 0 \n    while q and steps_taken_in_bfs < max_steps_for_move:\n      current_s, current_actions = q.popleft()\n\n      # Check if current_s is already positioned such that `target_kind_idx`\n      # is on a cardinal neighbor.\n      for dx_check, dy_check in DIR_TO_DELTAS.values(): # Iterate over cardinal directions\n        nx, ny = current_s.pos[0] + dx_check, current_s.pos[1] + dy_check\n        WIDTH, HEIGHT, _ = current_s.grid.shape\n        \n        if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n          if current_s.grid[nx, ny, target_kind_idx] > 0:\n            # Found a cardinal adjacent cell with the target kind. This is our goal.\n            return current_s, current_actions\n\n      # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n      for action in [DOWN, UP, LEFT, RIGHT]:\n        # Prune paths that would exceed the individual BFS step limit\n        if len(current_actions) + 1 > max_steps_for_move:\n          continue \n\n        # Simulate the step to get the next state\n        _, next_s = current_s.step(action)\n        next_state_tuple = _get_simplified_state_tuple(next_s)\n\n        if next_state_tuple not in visited:\n          visited.add(next_state_tuple)\n          q.append((next_s, current_actions + [action]))\n          steps_taken_in_bfs += 1 # Increment step count for BFS overall limit\n\n    return None, None # Path not found within limits\n\n  def _get_turn_and_use_actions(current_state, target_kind_idx):\n    \"\"\"\n    Calculates the actions needed to turn towards a *cardinal neighbor*\n    containing `target_kind_idx` and then perform the USE action.\n    Assumes `current_state` is already positioned such that `target_kind_idx`\n    is present on a cardinal neighbor cell.\n    \n    Args:\n      current_state: The CraftState from which to perform turns and USE.\n      target_kind_idx: The integer index of the item/entity to use.\n      \n    Returns:\n      A list of actions (e.g., [RIGHT, USE] or [USE]), or an empty list\n      if no valid cardinal target is found.\n    \"\"\"\n    actions = []\n    WIDTH, HEIGHT, _ = current_state.grid.shape\n\n    # Find the specific cardinal adjacent cell containing `target_kind_idx`\n    target_cell_to_face = None\n    \n    # Iterate only over cardinal directions to find the target\n    for dx_rel, dy_rel in DIR_TO_DELTAS.values():\n      check_x, check_y = current_state.pos[0] + dx_rel, current_state.pos[1] + dy_rel\n\n      if 0 <= check_x < WIDTH and 0 <= check_y < HEIGHT:\n        if current_state.grid[check_x, check_y, target_kind_idx] > 0:\n          target_cell_to_face = (check_x, check_y)\n          break # Found a cardinal neighbor, prioritize this one\n\n    if target_cell_to_face is None:\n      # This case implies the agent is positioned next to an item/workshop,\n      # but it's only diagonally adjacent, or on the agent's current cell.\n      # For `USE` action to be meaningful (acting on the cell in front),\n      # a cardinal neighbor is required.\n      return [] \n\n    # Calculate the relative position of the target cell from the agent's position\n    px, py = current_state.pos\n    tx, ty = target_cell_to_face\n    \n    dx_target = tx - px\n    dy_target = ty - py\n\n    # Determine the required direction index (0=N, 1=E, 2=S, 3=W) to face the target\n    required_dir = None\n    for direction_idx, (ddx, ddy) in DIR_TO_DELTAS.items():\n      if ddx == dx_target and ddy == dy_target:\n        required_dir = direction_idx\n        break\n    \n    if required_dir is None:\n      # Should not happen if `target_cell_to_face` was found using `DIR_TO_DELTAS.values()`\n      return [] \n            \n    # Calculate the minimum turns needed to face the `required_dir` from `current_state.dir`\n    turn_diff = (required_dir - current_state.dir + 4) % 4\n    if turn_diff == 1:       actions.append(RIGHT)         # 1 turn right\n    elif turn_diff == 2:     actions.extend([RIGHT, RIGHT])  # 2 turns (can be 2xRIGHT or 2xLEFT)\n    elif turn_diff == 3:     actions.append(LEFT)          # 1 turn left\n    # If turn_diff is 0, no turn action is needed (already facing correctly)\n\n    actions.append(USE) # Finally, add the USE action\n    return actions\n\n  def _recursive_craft_helper_iddfs(current_state, target_item_idx, current_planner_steps, max_depth_limit, cookbook, planner_cache_for_this_depth):\n    \"\"\"\n    Recursive helper function that finds a sequence of actions to craft\n    the `target_item_idx`. This function is designed to be used with Iterative Deepening.\n    \n    Args:\n      current_state: The current CraftState of the agent.\n      target_item_idx: The integer index of the item to be crafted/obtained.\n      current_planner_steps: The cumulative number of actions taken so far\n                             in the overall crafting plan (for current depth).\n      max_depth_limit: The maximum number of actions allowed for the current IDDFS iteration.\n      cookbook: Reference to the CraftWorld's Cookbook instance for recipes.\n      planner_cache_for_this_depth: A dictionary for memoization specific to the current depth limit.\n      \n    Returns:\n      (success_bool, list_of_actions): True and a list of actions if the item\n      can be crafted within `max_depth_limit`, False and an empty list otherwise.\n    \"\"\"\n    # --- Memoization for the current depth limit ---\n    state_tuple = _get_simplified_state_tuple(current_state)\n    memo_key = (state_tuple, target_item_idx)\n\n    if memo_key in planner_cache_for_this_depth:\n      return planner_cache_for_this_depth[memo_key]\n\n    # --- Pruning based on current depth limit ---\n    if current_planner_steps >= max_depth_limit:\n      planner_cache_for_this_depth[memo_key] = (False, []) # Memoize failure at this depth\n      return False, []\n\n    # --- Base case: Target item already in inventory ---\n    if current_state.inventory[target_item_idx] > 0:\n      planner_cache_for_this_depth[memo_key] = (True, [])\n      return True, []\n\n    current_path_actions = [] # Actions accumulated in this specific recursive call\n\n    # --- Case 1: Target is a primitive (collect from the grid) ---\n    if target_item_idx in cookbook.primitives:\n      # Limit steps for the BFS movement sub-plan based on remaining depth\n      remaining_depth_for_move = max_depth_limit - current_planner_steps\n      moved_state, move_actions = _bfs_move_to_kind(\n          current_state, target_item_idx, remaining_depth_for_move\n      )\n      \n      if moved_state is None:\n        planner_cache_for_this_depth[memo_key] = (False, [])\n        return False, [] # Cannot reach the primitive\n\n      # Determine actions to turn towards it and USE it\n      face_and_use_actions = _get_turn_and_use_actions(moved_state, target_item_idx)\n      if not face_and_use_actions:\n        planner_cache_for_this_depth[memo_key] = (False, [])\n        return False, [] # Cannot face/use the primitive even if next to it\n\n      # Check if adding these actions would exceed the current depth limit\n      if current_planner_steps + len(move_actions) + len(face_and_use_actions) > max_depth_limit:\n          planner_cache_for_this_depth[memo_key] = (False, [])\n          return False, []\n\n      # Simulate these actions to get the state after attempting collection\n      state_after_attempt = _simulate_actions(moved_state, face_and_use_actions)\n      \n      # Check if collection was successful (inventory count of the item increased)\n      if state_after_attempt.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n        current_path_actions.extend(move_actions)\n        current_path_actions.extend(face_and_use_actions)\n        planner_cache_for_this_depth[memo_key] = (True, current_path_actions)\n        return True, current_path_actions\n      else:\n        # Failed to collect, e.g., item was non-grabbable or already gone\n        planner_cache_for_this_depth[memo_key] = (False, [])\n        return False, []\n\n    # --- Case 2: Target has a recipe (craft using ingredients and a workshop) ---\n    if target_item_idx in cookbook.recipes:\n      recipe = cookbook.recipes[target_item_idx]\n      \n      ingredients_needed = {}\n      workshop_kind_idx = None\n\n      # Parse ingredients and workshop from the recipe\n      for ing_idx_or_key, count_or_name in recipe.items():\n        if ing_idx_or_key == \"_key\":\n          # The workshop is identified by a name string in the YAML, look up its index\n          workshop_kind_idx = cookbook.index[count_or_name]\n        else:\n          ingredients_needed[ing_idx_or_key] = count_or_name # Actual count (int)\n\n      current_working_state = current_state # State evolves as ingredients are gathered\n      \n      # Collect all required ingredients recursively\n      for ing_idx, required_count in ingredients_needed.items():\n        while current_working_state.inventory[ing_idx] < required_count:\n          # Recursively call to get each required ingredient, passing the current depth limit\n          success, ing_actions = _recursive_craft_helper_iddfs(\n              current_working_state, ing_idx,\n              current_planner_steps + len(current_path_actions), # Actions accumulated so far\n              max_depth_limit, cookbook, planner_cache_for_this_depth\n          )\n          if not success:\n            planner_cache_for_this_depth[memo_key] = (False, [])\n            return False, [] # If an ingredient cannot be obtained, crafting fails\n\n          # Apply the actions for obtaining the ingredient and update state/actions\n          current_working_state = _simulate_actions(current_working_state, ing_actions)\n          current_path_actions.extend(ing_actions)\n          \n          # Check total actions against limit after adding ingredient actions\n          if current_planner_steps + len(current_path_actions) >= max_depth_limit:\n            planner_cache_for_this_depth[memo_key] = (False, [])\n            return False, []\n\n      # If a workshop is required, move to it and use it\n      if workshop_kind_idx is not None:\n        # Move to be adjacent to the workshop\n        remaining_depth_for_move = max_depth_limit - (current_planner_steps + len(current_path_actions))\n        moved_state_to_workshop, move_actions_to_workshop = _bfs_move_to_kind(\n            current_working_state, workshop_kind_idx, remaining_depth_for_move\n        )\n        if moved_state_to_workshop is None:\n          planner_cache_for_this_depth[memo_key] = (False, [])\n          return False, [] # Cannot reach the workshop\n\n        current_working_state = moved_state_to_workshop\n        current_path_actions.extend(move_actions_to_workshop)\n\n        if current_planner_steps + len(current_path_actions) >= max_depth_limit:\n          planner_cache_for_this_depth[memo_key] = (False, [])\n          return False, []\n\n        # Turn to face and USE the workshop\n        face_and_use_actions = _get_turn_and_use_actions(current_working_state, workshop_kind_idx)\n        if not face_and_use_actions:\n          planner_cache_for_this_depth[memo_key] = (False, [])\n          return False, [] # Cannot face/use the workshop\n\n        if current_planner_steps + len(current_path_actions) + len(face_and_use_actions) > max_depth_limit:\n            planner_cache_for_this_depth[memo_key] = (False, [])\n            return False, []\n\n        current_working_state = _simulate_actions(current_working_state, face_and_use_actions)\n        current_path_actions.extend(face_and_use_actions)\n\n        if current_planner_steps + len(current_path_actions) >= max_depth_limit:\n          planner_cache_for_this_depth[memo_key] = (False, [])\n          return False, []\n\n      # After gathering ingredients and using the workshop (if any),\n      # check if the target item is now successfully in the inventory.\n      # The 'USE' action on a workshop typically consumes ingredients and produces the item.\n      if current_working_state.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n        planner_cache_for_this_depth[memo_key] = (True, current_path_actions)\n        return True, current_path_actions\n      else:\n        # Crafting failed (e.g., not enough ingredients despite planning, wrong workshop, etc.)\n        planner_cache_for_this_depth[memo_key] = (False, [])\n        return False, []\n\n    # If the item is neither a primitive nor has a known recipe, it cannot be crafted\n    planner_cache_for_this_depth[memo_key] = (False, [])\n    return False, []\n\n  # --- Main logic for craft_v2 function using Iterative Deepening Search (IDDFS) ---\n\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Iterative Deepening Loop: Search for solutions with increasing depth limits\n  for max_depth in range(1, _MAX_TOTAL_PLANNER_ACTIONS_GLOBAL_HARD_LIMIT + 1):\n      # A new memoization cache is used for each depth limit.\n      # This is crucial because a state that might be unreachable within a lower\n      # depth limit could be reachable at a higher one.\n      current_depth_planner_cache = {} \n      success, actions = _recursive_craft_helper_iddfs(\n          initial_state, item, 0, max_depth, cookbook, current_depth_planner_cache\n      )\n      if success:\n          return actions # Return the first (shortest) plan found\n\n  # If no plan is found within the global maximum depth limit\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T00:35:31.585387", "function_name": "craft", "function_body": "    # Get the initial state of the environment.\n    # The CraftLab environment exposes _current_state after reset.\n    # We reset it to ensure a consistent starting point and get the initial CraftState.\n    # Using a fixed seed for reset for reproducibility, though not strictly required by the prompt.\n    _ = env.reset(seed=0) # _ stores the observation dict, we need env._current_state\n    initial_state = env._current_state # CraftLab stores the current state here\n\n    # Goal check: if the desired item is already in inventory at the start, no actions are needed.\n    if initial_state.inventory[item] > 0:\n        return []\n\n    # BFS queue: Stores tuples of (CraftState object, list of actions taken to reach this state).\n    # collections.deque is used for efficient popleft operations.\n    # (Assuming 'collections' module is imported at the top level as per standard Python practice)\n    queue = collections.deque([(initial_state, [])])\n\n    # Visited set: Stores hashable representations of states to avoid redundant exploration and cycles.\n    # A state is defined by (grid_bytes, agent_position_tuple, agent_direction_int, inventory_tuple).\n    visited = set()\n\n    # Maximum number of actions to explore in a path. This serves as a safeguard\n    # against extremely long searches in complex environments or if no solution exists.\n    # This value might need tuning depending on the complexity of the crafting recipes.\n    MAX_ACTIONS = 150\n\n    # Define the set of possible actions.\n    # (Assuming env_factory.Action enum is available from the 'env_factory' module).\n    ACTIONS = [env_factory.Action.DOWN, env_factory.Action.UP,\n               env_factory.Action.LEFT, env_factory.Action.RIGHT,\n               env_factory.Action.USE]\n\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        # Prune paths that exceed the maximum allowed actions to limit search depth.\n        if len(actions_taken) >= MAX_ACTIONS:\n            continue\n\n        # Create a hashable representation of the current state.\n        # numpy arrays (grid, inventory) are converted to bytes/tuples for hashing.\n        grid_hash = current_state.grid.tobytes()\n        inventory_hash = tuple(current_state.inventory)\n        state_hash = (grid_hash, current_state.pos, current_state.dir, inventory_hash)\n\n        # If this state has already been visited, skip it as BFS guarantees\n        # the first path to a state is the shortest.\n        if state_hash in visited:\n            continue\n        \n        # Mark the current state as visited.\n        visited.add(state_hash)\n\n        # Explore all possible actions from the current state.\n        for action in ACTIONS:\n            # Simulate applying the action to get the next state.\n            # CraftState.step() returns (reward, new_state). Reward is not used in BFS.\n            _reward, next_state = current_state.step(action)\n            next_actions_taken = actions_taken + [action]\n\n            # Check if the goal (desired item in inventory) is achieved in the next state.\n            if next_state.inventory[item] > 0:\n                return next_actions_taken # Goal achieved, return the sequence of actions.\n\n            # Prepare the hash for the next state to check if it has been visited.\n            next_grid_hash = next_state.grid.tobytes()\n            next_inventory_hash = tuple(next_state.inventory)\n            next_state_hash = (next_grid_hash, next_state.pos, next_state.dir, next_inventory_hash)\n\n            # If the next state has not been visited, add it to the queue for further exploration.\n            if next_state_hash not in visited:\n                queue.append((next_state, next_actions_taken))\n\n    # If the queue is exhausted and the goal was not found within the action limit,\n    # it means the item is uncraftable under current conditions or within the search limits.\n    return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:35:47.936366", "function_name": "craft", "function_body": "  # Action constants (integers mapping to movement/use)\n  # These are part of the environment's action space definition.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  # Get the current state of the environment.\n  # We plan actions starting from the agent's current situation.\n  initial_state = env._current_state\n\n  # Check if the desired item is already present in the inventory.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state).\n  # Using a standard Python list as a queue, where `pop(0)` simulates `popleft()`.\n  # Note: `list.pop(0)` has O(N) complexity, `collections.deque.popleft()` is O(1).\n  # Assuming `collections.deque` is not pre-imported globally and cannot be imported locally per instructions.\n  queue = []\n  queue.append((initial_state, []))\n\n  # Initialize a set to keep track of visited states.\n  # This prevents infinite loops and redundant exploration.\n  # A state is defined by its grid layout, inventory, agent position, and direction.\n  # Numpy arrays are converted to bytes for hashability in the set.\n  visited = set()\n  visited.add((initial_state.grid.tobytes(), initial_state.inventory.tobytes(), initial_state.pos, initial_state.dir))\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  MAX_PLAN_STEPS = 200        # Maximum length of action sequence to consider.\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  explored_nodes_count = 0\n\n  # Perform BFS\n  while queue and explored_nodes_count < MAX_EXPLORED_NODES:\n    current_state, path = queue.pop(0) # Get the next state to explore from the front of the queue.\n    explored_nodes_count += 1\n\n    # If the current path is too long, skip further exploration from this path.\n    if len(path) >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # `current_state.step(action)` returns (reward, new_state).\n      # The reward is always 0.0 in this environment implementation.\n      _, next_state = current_state.step(action)\n\n      # Create a hashable representation of the next state for the `visited` set.\n      next_state_hashable = (next_state.grid.tobytes(), next_state.inventory.tobytes(), next_state.pos, next_state.dir)\n\n      # If this state has not been visited before:\n      if next_state_hashable not in visited:\n        visited.add(next_state_hashable) # Mark as visited.\n        new_path = path + [action]     # Extend the path with the current action.\n\n        # Check if the goal is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          return new_path # Goal reached, return the sequence of actions.\n\n        # Add the new state and its path to the queue for future exploration.\n        queue.append((next_state, new_path))\n\n  # If the loop finishes without finding a path (queue empty or limits reached),\n  # it means the item cannot be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T00:36:53.547380", "function_name": "craft", "function_body": "    # Dynamically get action mapping from the environment\n    action_map = env.action_specs()\n    # Ensure a consistent order for iterating actions, as defined in CraftLab\n    ACTIONS_TO_EXPLORE = [\n        action_map['DOWN'],\n        action_map['UP'],\n        action_map['LEFT'],\n        action_map['RIGHT'],\n        action_map['USE']\n    ]\n\n    # Get the initial state from the environment's current state.\n    # env._current_state holds the active CraftState instance.\n    initial_state = env._current_state\n\n    # Check immediately if the item is already in the inventory\n    if initial_state.satisfies(None, item):\n        return [] # No actions needed if goal is already met\n\n    # Initialize a queue for Breadth-First Search (BFS).\n    # Each item in the queue is a tuple: (current_CraftState_instance, list_of_actions_taken_to_reach_this_state).\n    queue = collections.deque([(initial_state, [])])\n\n    # Initialize a set to keep track of visited states to prevent cycles and redundant computations.\n    # A state is uniquely identified by its grid layout, inventory contents, agent's position, and direction.\n    # numpy arrays are converted to bytes for hashability in the set.\n    visited = set()\n    initial_state_tuple = (\n        initial_state.grid.tobytes(),\n        initial_state.inventory.tobytes(),\n        initial_state.pos,\n        initial_state.dir\n    )\n    visited.add(initial_state_tuple)\n\n    # Define a maximum search depth to limit computational complexity and prevent very long searches\n    # for potentially unsolvable or very complex goals. This value can be tuned.\n    MAX_SEARCH_DEPTH = 100 \n\n    # BFS loop: continue as long as there are states to explore in the queue\n    while queue:\n        current_state, actions_taken = queue.popleft()\n\n        # If the current path exceeds the maximum allowed search depth, stop exploring it.\n        if len(actions_taken) >= MAX_SEARCH_DEPTH:\n            continue\n\n        # Explore all possible actions from the current state\n        for action in ACTIONS_TO_EXPLORE:\n            # Simulate the action: CraftState.step() returns a *new* CraftState instance\n            # and the reward (which is 0.0 in this environment).\n            _reward, next_state = current_state.step(action)\n            \n            # Append the current action to the sequence of actions taken\n            new_actions_taken = actions_taken + [action]\n\n            # Check if the goal (item in inventory) is satisfied in the new state\n            if next_state.satisfies(None, item):\n                return new_actions_taken # Goal reached, return the sequence of actions\n\n            # Create a hashable representation of the next state for the visited set\n            next_state_tuple = (\n                next_state.grid.tobytes(),\n                next_state.inventory.tobytes(),\n                next_state.pos,\n                next_state.dir\n            )\n\n            # If this new state has not been visited before, add it to the queue\n            # and mark it as visited to avoid re-processing.\n            if next_state_tuple not in visited:\n                visited.add(next_state_tuple)\n                queue.append((next_state, new_actions_taken))\n\n    # If the queue becomes empty and the goal has not been reached,\n    # it means no valid sequence of actions was found within the specified search depth.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:36:53.630296", "function_name": "craft", "function_body": "    # Define action constants (assuming they are 0-4 as per action_specs)\n    # These are typically global, but for strict adherence to \"only return code within function\",\n    # they are defined here.\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n\n    # Max steps for the BFS search to prevent excessively long planning times\n    # and memory exhaustion. This value might need tuning based on problem complexity.\n    _MAX_PLANNING_STEPS = 200\n\n    # Nested class to represent a state in the BFS search.\n    # It encapsulates a CraftState instance and the sequence of actions taken to reach it.\n    # It must be hashable and comparable for use in the 'visited' set.\n    class _PlannerState:\n        \"\"\"Helper class for BFS state representation.\"\"\"\n        def __init__(self, craft_state, actions):\n            self.craft_state = craft_state\n            self.actions = actions\n\n        def __hash__(self):\n            # Create a hashable representation of the CraftState.\n            # Numpy arrays are converted to bytes for hashing.\n            grid_hash = self.craft_state.grid.tobytes()\n            inventory_hash = self.craft_state.inventory.tobytes()\n            return hash((grid_hash, inventory_hash, self.craft_state.pos, self.craft_state.dir))\n\n        def __eq__(self, other):\n            if not isinstance(other, _PlannerState):\n                return NotImplemented\n            # Compare the underlying CraftState attributes for equality.\n            return (np.array_equal(self.craft_state.grid, other.craft_state.grid) and\n                    np.array_equal(self.craft_state.inventory, other.craft_state.inventory) and\n                    self.craft_state.pos == other.craft_state.pos and\n                    self.craft_state.dir == other.craft_state.dir)\n\n    # Get the initial CraftState from the CraftLab environment.\n    initial_craft_state = env._current_state \n\n    # Check if the goal item is already in the inventory.\n    # If so, no actions are needed.\n    if initial_craft_state.inventory[item] > 0:\n        return []\n\n    # Initialize a deque for BFS and a set for visited states.\n    # `collections.deque` and `numpy` are assumed to be imported at the module level.\n    queue = collections.deque()\n    visited = set()\n\n    # Create the initial planner state and add it to the queue and visited set.\n    initial_planner_state = _PlannerState(initial_craft_state, [])\n    queue.append(initial_planner_state)\n    visited.add(initial_planner_state)\n\n    # Perform Breadth-First Search\n    while queue:\n        current_planner_state = queue.popleft()\n        current_craft_state = current_planner_state.craft_state\n        current_actions = current_planner_state.actions\n\n        # Pruning: If the current path exceeds the maximum allowed planning steps,\n        # abandon this path to prevent excessively long or infinite searches.\n        if len(current_actions) >= _MAX_PLANNING_STEPS:\n            continue\n\n        # Check if the goal item is now in the inventory of the current state.\n        # If the goal is satisfied, return the sequence of actions that led to this state.\n        if current_craft_state.inventory[item] > 0:\n            return current_actions\n\n        # Explore all possible actions from the current state.\n        # env.n_actions typically corresponds to the number of fundamental actions (e.g., 5: Move N/S/E/W, Use).\n        for action in range(env.n_actions):\n            # Apply the action to the current CraftState to get the next state.\n            # The reward is always 0.0 for CraftState.step, actual goal satisfaction is checked here.\n            reward, next_craft_state = current_craft_state.step(action)\n            next_actions = current_actions + [action]\n\n            # Create a new planner state for the successor state.\n            next_planner_state = _PlannerState(next_craft_state, next_actions)\n\n            # If this state has not been visited before (or visited with a longer path,\n            # which BFS naturally avoids by finding shortest paths first), add it to\n            # the visited set and the queue for further exploration.\n            if next_planner_state not in visited:\n                visited.add(next_planner_state)\n                queue.append(next_planner_state)\n\n    # If the queue becomes empty and the goal was not reached, it means no plan\n    # was found within the specified MAX_PLANNING_STEPS or the state space explored.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:38:16.931836", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  n_actions = env.world.n_actions # Typically 5: DOWN, UP, LEFT, RIGHT, USE\n\n  goal_item_idx = item\n\n  # Function to create a hashable key for a CraftState.\n  # This key must uniquely identify a state relevant for the search,\n  # considering position, direction, inventory, and the grid's configuration\n  # (especially for resources that can be picked up or workshops).\n  def get_state_key(state):\n      # Flatten the inventory array and convert to a tuple for hashing.\n      # Using .tolist() ensures Python native types for consistent hashing.\n      inventory_tuple = tuple(state.inventory.flatten().tolist())\n      # Convert the grid to bytes for hashing. This is a robust way to capture\n      # grid state changes (e.g., when resources are picked up).\n      # For typical CraftWorld grid sizes, this should be performant enough.\n      grid_bytes = state.grid.tobytes()\n      return (state.pos, state.dir, inventory_tuple, grid_bytes)\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The `env` object holds the current state internally.\n  initial_craft_state = env._current_state\n  \n  # Queue for Breadth-First Search (BFS):\n  # Stores tuples of (CraftState object, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(initial_craft_state, [])])\n  \n  # Set to keep track of visited state keys to avoid redundant computations and cycles.\n  visited = {get_state_key(initial_craft_state)}\n\n  # Maximum number of steps/actions to search. This prevents infinite loops\n  # for unreachable goals and limits computation time.\n  # The value might need tuning depending on recipe complexity and grid size.\n  MAX_SEARCH_DEPTH = 500 \n\n  while queue:\n      current_state, current_actions = queue.popleft()\n\n      # Check if the goal (having the item in inventory) is satisfied in the current state.\n      if current_state.satisfies(None, goal_item_idx):\n          return current_actions # Goal reached, return the path of actions.\n\n      # Pruning: If the current path length exceeds the maximum search depth,\n      # do not expand this node further to prevent excessive computation.\n      if len(current_actions) >= MAX_SEARCH_DEPTH:\n          continue\n      \n      # Iterate through all possible actions (move actions and USE action).\n      for action in range(n_actions): # n_actions is typically 5 (0:DOWN, 1:UP, 2:LEFT, 3:RIGHT, 4:USE)\n          # Simulate the action using the CraftState's step method.\n          # CraftState's step returns (reward, new_state). Reward is typically 0.0 for intermediate steps.\n          _, new_state = current_state.step(action)\n\n          new_state_key = get_state_key(new_state)\n\n          # If this new state has not been visited before, add it to the queue.\n          if new_state_key not in visited:\n              visited.add(new_state_key)\n              # Append the current action to the path leading to the new state.\n              new_actions_path = current_actions + [action]\n              queue.append((new_state, new_actions_path))\n  \n  # If the queue becomes empty and the goal was not reached, it means the goal is\n  # unreachable within the specified MAX_SEARCH_DEPTH from the initial state.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:38:17.001127", "function_name": "craft", "function_body": "    all_actions = []\n\n    # Action constants (internal for clarity)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Get the initial state from the environment without modifying it.\n    # CraftState.step() returns a new CraftState object, which is perfect for simulation.\n    current_simulated_state = env._current_state\n\n    # If the item is already in inventory, no actions are needed.\n    if current_simulated_state.inventory[item] > 0:\n        return []\n\n    # Helper function: Finds an entity on the grid, generates actions to reach it,\n    # and then performs 'USE' actions a specified number of times.\n    # It returns the list of actions and the resulting simulated state.\n    def _reach_and_use(sim_state: 'CraftState', target_kind_idx: int, num_uses: int) -> (list[int], 'CraftState'):\n        actions = []\n        state_after_move = sim_state\n\n        target_pos = None\n        WIDTH, HEIGHT, _ = state_after_move.grid.shape\n\n        # Search for the target kind (primitive or workshop) on the grid\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                # The grid stores counts; if > 0, the entity is present.\n                if state_after_move.grid[x, y, target_kind_idx] > 0:\n                    target_pos = (x, y)\n                    break\n            if target_pos: break\n        \n        if target_pos is None:\n            # Target entity not found on the grid; cannot collect/use.\n            # Return no actions and the original state (planning fails for this path).\n            return [], sim_state\n\n        current_x, current_y = state_after_move.pos\n        target_x, target_y = target_pos\n\n        # Simple greedy pathfinding (ignoring obstacles for simplicity).\n        # Move horizontally first.\n        while current_x != target_x:\n            action = RIGHT if current_x < target_x else LEFT\n            actions.append(action)\n            # Simulate the step to update agent's position and internal state.\n            _, state_after_move = state_after_move.step(action)\n            current_x, current_y = state_after_move.pos\n\n        # Then move vertically.\n        while current_y != target_y:\n            action = DOWN if current_y < target_y else UP\n            actions.append(action)\n            # Simulate the step.\n            _, state_after_move = state_after_move.step(action)\n            current_x, current_y = state_after_move.pos\n\n        # Perform 'USE' actions at the target location.\n        for _ in range(num_uses):\n            actions.append(USE)\n            # Simulate the 'USE' step, which handles picking up primitives or crafting.\n            _, state_after_move = state_after_move.step(USE)\n\n        return actions, state_after_move\n\n    # Recursive planning function: Determines actions to obtain a single instance of `target_item_idx`.\n    # It returns the list of actions and the resulting simulated state.\n    def _plan_item(sim_state: 'CraftState', target_item_idx: int) -> (list[int], 'CraftState'):\n        current_actions = []\n        current_s = sim_state # This state object will be updated by simulated steps.\n\n        # Base case: If the item is already in the simulated inventory, no actions needed.\n        if current_s.inventory[target_item_idx] > 0:\n            return [], current_s\n\n        # Case 1: Item is a primitive resource.\n        if target_item_idx in env.world.cookbook.primitives:\n            # Plan to collect one unit of this primitive.\n            collected_actions, new_sim_state = _reach_and_use(current_s, target_item_idx, 1)\n            current_actions.extend(collected_actions)\n            current_s = new_sim_state\n            return current_actions, current_s\n\n        # Case 2: Item is a crafted item. Look up its recipe.\n        recipe = env.world.cookbook.recipes.get(target_item_idx)\n        if recipe is None:\n            # Item is neither a primitive nor has a recipe; it cannot be obtained.\n            # Return no actions and the original state (represents a planning failure).\n            return [], current_s\n\n        # Process ingredients required for crafting.\n        for ing_idx_str, count_needed in recipe.items():\n            if ing_idx_str == \"_key\":\n                continue # The \"_key\" entry indicates workshop requirement, handled later.\n\n            ing_idx = int(ing_idx_str) # Convert string key from recipe to integer index.\n\n            # Determine how many more units of this ingredient are still needed.\n            currently_have = current_s.inventory[ing_idx]\n            needed_amount = count_needed - currently_have\n\n            # Recursively plan to obtain each needed unit of the ingredient.\n            for _ in range(needed_amount):\n                ing_actions, updated_sim_state = _plan_item(current_s, ing_idx)\n                current_actions.extend(ing_actions)\n                current_s = updated_sim_state # Update the state for subsequent ingredient planning.\n\n        # After all ingredients are (simulated to be) collected, craft the target item.\n        if \"_key\" in recipe: # A workshop is required for this recipe.\n            # Get a workshop index (assuming there's at least one workshop type defined).\n            workshop_idx = env.world.workshop_indices[0] \n\n            # Plan to reach and use the workshop once to craft the item.\n            # The `_reach_and_use` function will include the 'USE' action.\n            workshop_actions, new_sim_state = _reach_and_use(current_s, workshop_idx, 1)\n            current_actions.extend(workshop_actions)\n            current_s = new_sim_state\n            \n        return current_actions, current_s\n\n    # Kick off the recursive planning process for the desired `item`.\n    # The returned actions will form the complete plan.\n    final_actions_list, _ = _plan_item(current_simulated_state, item)\n    \n    return final_actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:39:15.317504", "function_name": "craft", "function_body": "    import collections\n\n    # Action mappings from CraftLab.action_specs (0-indexed)\n    # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n    ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n    # Access the initial state from the CraftLab environment.\n    # The `_current_state` attribute holds the current CraftState object.\n    # If the environment has not been reset yet, `_current_state` will be None.\n    # In that case, we perform a reset to initialize the scenario and state.\n    initial_craft_state = env._current_state\n    if initial_craft_state is None:\n        # Calling env.reset() sets up the initial scenario and populates _current_state.\n        # Using a fixed seed (e.g., 0) for the reset if it's forced here can aid reproducibility.\n        _ = env.reset(seed=0)\n        initial_craft_state = env._current_state\n\n    # Check if the desired item is already present in the initial inventory.\n    # If so, no actions are needed, and an empty path is returned.\n    # CraftState.satisfies ignores the 'goal_name' argument.\n    if initial_craft_state.satisfies(None, item):\n        return []\n\n    # Initialize a deque for Breadth-First Search (BFS).\n    # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_to_reach_this_state).\n    queue = collections.deque()\n    queue.append((initial_craft_state, []))\n\n    # Initialize a set to store visited states. This prevents redundant exploration and infinite loops.\n    # A state is represented by a hashable tuple:\n    # (grid_data_bytes, agent_position_tuple, agent_direction_int, inventory_data_bytes).\n    # numpy arrays are converted to bytes for hashing.\n    visited = set()\n    initial_state_hashable = (initial_craft_state.grid.tobytes(),\n                              initial_craft_state.pos,\n                              initial_craft_state.dir,\n                              initial_craft_state.inventory.tobytes())\n    visited.add(initial_state_hashable)\n\n    # Get the maximum number of steps allowed for an episode from the CraftLab environment.\n    # Paths exceeding this length are considered invalid and are pruned.\n    max_steps_per_episode = env.max_steps\n\n    # Begin the BFS traversal.\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Prune paths that have exceeded the maximum allowed steps.\n        if len(current_path) >= max_steps_per_episode:\n            continue\n\n        # Explore all possible actions from the current state.\n        for action in ALL_ACTIONS:\n            # Simulate the application of the action to the current state.\n            # CraftState.step returns (reward, new_state). We only need the new_state.\n            _, next_state = current_state.step(action)\n\n            # Construct the path that leads to this next state.\n            new_path = current_path + [action]\n\n            # Check if the desired item has been successfully crafted in the new state.\n            if next_state.satisfies(None, item):\n                return new_path # Goal reached, return the sequence of actions.\n\n            # Create a hashable representation of the next state to check against the visited set.\n            next_state_hashable = (next_state.grid.tobytes(),\n                                   next_state.pos,\n                                   next_state.dir,\n                                   next_state.inventory.tobytes())\n\n            # If this next state has not been visited before, add it to the queue for\n            # further exploration and mark it as visited.\n            if next_state_hashable not in visited:\n                visited.add(next_state_hashable)\n                queue.append((next_state, new_path))\n\n    # If the queue becomes empty and the goal was not reached, it means the item\n    # cannot be crafted or found within the reachable state space under the given constraints.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:39:45.732566", "function_name": "craft", "function_body": "  import collections # Required for deque\n\n  # Action constants are typically global, but for self-containment in the function body,\n  # defining them here. In a full system, these would likely come from env_factory.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Maximum number of steps to explore in the BFS. Prevents infinite loops and\n  # limits computational expense for very complex or unsolvable tasks.\n  MAX_SEARCH_DEPTH = 200 # This value is arbitrary and may need tuning.\n\n  # Get the initial CraftState from the CraftLab environment.\n  # The CraftLab instance (`env`) holds the current game state in its `_current_state` attribute.\n  initial_craft_state = env._current_state\n\n  # BFS Queue: Each element is a tuple (current_CraftState, list_of_actions_taken_to_reach_this_state)\n  q = collections.deque([(initial_craft_state, [])])\n\n  # Visited set: Stores hashable representations of states to avoid revisiting.\n  # A state is uniquely identified by (agent_position, agent_direction, inventory_contents, grid_contents).\n  # Numpy arrays (inventory, grid) are converted to hashable types (tuple for list, bytes for grid).\n  visited = set()\n  \n  # Add the initial state to the visited set.\n  initial_state_hashable = (initial_craft_state.pos,\n                            initial_craft_state.dir,\n                            tuple(initial_craft_state.inventory.tolist()),\n                            initial_craft_state.grid.tobytes())\n  visited.add(initial_state_hashable)\n\n  while q:\n    current_state, path_actions = q.popleft()\n\n    # Check if the goal is satisfied in the current state's inventory.\n    # CraftState.satisfies expects `goal_name` (unused here, can be None) and `goal_arg` (item index).\n    if current_state.satisfies(None, item):\n      return path_actions # Goal achieved, return the sequence of actions that led to it.\n\n    # Pruning: If the current path exceeds the maximum allowed search depth, stop exploring it.\n    if len(path_actions) >= MAX_SEARCH_DEPTH:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in ACTIONS:\n      # Simulate the action. CraftState.step creates and returns a NEW CraftState object,\n      # representing the state after the action. The reward is not used for planning here.\n      _, next_craft_state = current_state.step(action)\n\n      # Create a hashable representation of the next state for the `visited` set.\n      next_state_hashable = (next_craft_state.pos,\n                             next_craft_state.dir,\n                             tuple(next_craft_state.inventory.tolist()),\n                             next_craft_state.grid.tobytes())\n\n      # If this next state has not been visited before, add it to the queue for exploration\n      # and mark it as visited.\n      if next_state_hashable not in visited:\n        visited.add(next_state_hashable)\n        q.append((next_craft_state, path_actions + [action]))\n\n  # If the queue becomes empty and the goal was never satisfied, it means no path\n  # was found within the specified search limits.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:42:02.154188", "function_name": "craft", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:42:02.223803", "function_name": "craft", "function_body": "    # Constants for actions (retrieved from env.action_specs() for robustness)\n    ACTION_MAP = env.action_specs()\n    _DOWN = ACTION_MAP['DOWN']\n    _UP = ACTION_MAP['UP']\n    _LEFT = ACTION_MAP['LEFT']\n    _RIGHT = ACTION_MAP['RIGHT']\n    _USE = ACTION_MAP['USE']\n\n    # Mapping actions to changes in (row, col)\n    _ACTION_DELTAS = {\n        _UP: (-1, 0),\n        _DOWN: (1, 0),\n        _LEFT: (0, -1),\n        _RIGHT: (0, 1)\n    }\n\n    initial_state = env._current_state\n    current_grid = initial_state.grid\n    cookbook = env.world.cookbook\n    grid_height, grid_width, num_kinds = current_grid.shape\n\n    # Initialize simulated state for planning\n    # Position as a mutable list [r, c] for easy updates within recursion\n    current_pos_mutable = list(initial_state.pos) \n    simulated_inventory = np.copy(initial_state.inventory)\n    total_actions = []\n\n    # Get non-grabbable items that act as obstacles on the grid\n    obstacles_kinds = env.world.non_grabbable_indices\n\n    def _find_path_to_proximity(start_pos_tuple, target_kind_idx, grid_snapshot, max_dist=20):\n        \"\"\"\n        Performs a BFS to find a path from start_pos_tuple to any cell\n        that is within the 3x3 neighborhood of an item of target_kind_idx.\n        Returns a list of actions (integers) to reach that proximity.\n        Returns None if no path is found within max_dist.\n        \"\"\"\n        # Find all locations of target_kind_idx on the grid\n        target_locations = []\n        rows, cols = np.where(grid_snapshot[:, :, target_kind_idx] > 0)\n        for r, c in zip(rows, cols):\n            target_locations.append((r, c))\n\n        if not target_locations:\n            return None # Target not found on grid\n\n        q = [(start_pos_tuple, [])] # (current_position (r,c), actions_taken_so_far)\n        visited = {start_pos_tuple}\n\n        while q:\n            (r, c), actions = q.pop(0)\n\n            if len(actions) > max_dist: # Prevent excessively long searches\n                continue\n\n            # Check if current position (r, c) is in the 3x3 neighborhood of any target location\n            # A 3x3 neighborhood includes the cell itself.\n            for tr, tc in target_locations:\n                if abs(r - tr) <= 1 and abs(c - tc) <= 1:\n                    return actions # Path to a cell from which target is reachable by USE\n\n            # Explore neighbors\n            for action, (dr, dc) in _ACTION_DELTAS.items():\n                nr, nc = r + dr, c + dc # New row, new column\n                \n                # Check grid boundaries\n                if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                    continue\n                \n                # Check if cell already visited in this path\n                if (nr, nc) in visited:\n                    continue\n\n                # Check if the new cell (nr, nc) is an obstacle\n                is_obstacle = False\n                for k in obstacles_kinds:\n                    if grid_snapshot[nr, nc, k] > 0: # If the cell contains an obstacle kind\n                        is_obstacle = True\n                        break\n                \n                if not is_obstacle:\n                    visited.add((nr, nc))\n                    q.append(((nr, nc), actions + [action]))\n        return None # No path found\n\n    def _acquire_item_actions_recursive(target_idx):\n        \"\"\"\n        Recursively plans actions to acquire target_idx.\n        Modifies `total_actions`, `simulated_inventory`, and `current_pos_mutable` in the outer scope.\n        Returns True if the item is successfully acquired (or already present), False otherwise.\n        \"\"\"\n        nonlocal total_actions\n        nonlocal simulated_inventory\n        nonlocal current_pos_mutable\n\n        # If item is already in simulated inventory, no actions needed\n        if simulated_inventory[target_idx] > 0:\n            return True\n\n        # Case 1: Item is a primitive (can be picked up from the environment)\n        if target_idx in cookbook.primitives:\n            # Find path to a cell adjacent or on the primitive item\n            path_actions = _find_path_to_proximity(tuple(current_pos_mutable), target_idx, current_grid)\n            if path_actions is None:\n                # Primitive is not found or reachable on the current grid\n                return False \n\n            total_actions.extend(path_actions)\n            # Update current_pos_mutable after simulating movement\n            for action in path_actions:\n                dr, dc = _ACTION_DELTAS[action]\n                current_pos_mutable[0] += dr\n                current_pos_mutable[1] += dc\n            \n            total_actions.append(_USE) # Use action to pick up the primitive\n            simulated_inventory[target_idx] += 1\n            return True\n\n        # Case 2: Item is craftable (requires a recipe)\n        if target_idx in cookbook.recipes:\n            recipe = cookbook.recipes[target_idx]\n            ingredients_needed = {}\n            workshop_key_idx = None # Store index of workshop if needed\n\n            for key_or_idx, count in recipe.items():\n                if key_or_idx == \"_key\":\n                    # The value associated with \"_key\" is the index of the required workshop\n                    workshop_key_idx = count \n                else:\n                    ingredients_needed[key_or_idx] = count\n\n            # First, acquire all necessary ingredients recursively\n            for ing_idx, req_count in ingredients_needed.items():\n                while simulated_inventory[ing_idx] < req_count:\n                    # Attempt to acquire the ingredient\n                    if not _acquire_item_actions_recursive(ing_idx):\n                        # If a dependency (ingredient) cannot be acquired,\n                        # then this craftable item cannot be made.\n                        return False \n            \n            # All ingredients are now (simulated to be) in inventory.\n            # Now, move to the workshop (if required) and craft.\n            if workshop_key_idx is not None:\n                path_to_workshop_proximity = _find_path_to_proximity(\n                    tuple(current_pos_mutable), workshop_key_idx, current_grid)\n                if path_to_workshop_proximity is None:\n                    # Cannot reach the required workshop, so cannot craft\n                    return False \n\n                total_actions.extend(path_to_workshop_proximity)\n                # Update current_pos_mutable after simulating movement\n                for action in path_to_workshop_proximity:\n                    dr, dc = _ACTION_DELTAS[action]\n                    current_pos_mutable[0] += dr\n                    current_pos_mutable[1] += dc\n            \n            total_actions.append(_USE) # Use action to craft the item\n            simulated_inventory[target_idx] += 1 # Assume one item is crafted per USE, which is typical\n            \n            # Consume ingredients from simulated inventory\n            for ing_idx, req_count in ingredients_needed.items():\n                simulated_inventory[ing_idx] -= req_count\n            return True\n\n        # If the item is neither a primitive nor a craftable item (e.g., an invalid index),\n        # it cannot be acquired.\n        return False\n\n    # Start the planning process by attempting to acquire the target item\n    _acquire_item_actions_recursive(item)\n    \n    return total_actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:43:09.475507", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  initial_state = env._current_state\n\n  # Check if the desired item is already present in the inventory.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Use collections.deque for efficient popleft() operation.\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state).\n  queue = collections.deque()\n  queue.append((initial_state, []))\n\n  # Initialize a set to keep track of visited states.\n  # A state is defined by its grid layout, inventory, agent position, and direction.\n  # Numpy arrays are converted to bytes for hashability in the set.\n  # This correctly captures changes to the grid (e.g., items being picked up or crafted).\n  visited = set()\n  visited.add((initial_state.grid.tobytes(), initial_state.inventory.tobytes(), initial_state.pos, initial_state.dir))\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  # These limits are kept consistent with craft_v1 for a fair comparison of improvements.\n  MAX_PLAN_STEPS = 200        # Maximum length of action sequence to consider.\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  explored_nodes_count = 0\n\n  # Perform Breadth-First Search (BFS)\n  while queue and explored_nodes_count < MAX_EXPLORED_NODES:\n    current_state, path = queue.popleft() # Efficiently get the next state to explore from the front of the queue.\n    explored_nodes_count += 1\n\n    # If the current path is too long, skip further exploration from this path\n    # to adhere to the maximum plan steps limit.\n    if len(path) >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # The `step` method returns (reward, new_state); we only need the new state.\n      _, next_state = current_state.step(action)\n\n      # Create a hashable representation of the next state for the `visited` set.\n      # This is crucial for detecting cycles and avoiding redundant computations.\n      next_state_hashable = (next_state.grid.tobytes(), next_state.inventory.tobytes(), next_state.pos, next_state.dir)\n\n      # If this state has not been visited before at the current depth:\n      if next_state_hashable not in visited:\n        visited.add(next_state_hashable) # Mark the new state as visited.\n        new_path = path + [action]     # Extend the action path.\n\n        # Check if the goal (desired item in inventory) is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          return new_path # Goal reached! Return the sequence of actions.\n\n        # Add the new state and its corresponding path to the queue for further exploration.\n        queue.append((next_state, new_path))\n\n  # If the loop finishes without finding a path (either the queue is empty or\n  # the maximum number of explored nodes is reached), it means the item cannot\n  # be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T00:43:11.735393", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    This is adopted from craft_v0's approach to state representation.\n    \"\"\"\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  # Get the initial state of the environment.\n  initial_state = env._current_state\n\n  # Check if the desired item is already present in the inventory.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Using `collections.deque` for O(1) `popleft()` operations,\n  # which is more efficient than `list.pop(0)`.\n  # Each element in the queue is a tuple: (current_CraftState, list_of_actions_to_reach_this_state).\n  q = collections.deque()\n  q.append((initial_state, []))\n\n  # Initialize a set to keep track of visited states.\n  # We use the simplified state tuple for memoization, which significantly\n  # reduces the size of the `visited` set and speeds up lookups, as it\n  # ignores grid details not directly relevant to agent's immediate inventory\n  # or position/direction.\n  visited = set()\n  visited.add(_get_simplified_state_tuple(initial_state))\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  MAX_PLAN_STEPS = 200        # Maximum length of action sequence to consider.\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  explored_nodes_count = 0\n\n  # Perform BFS\n  while q and explored_nodes_count < MAX_EXPLORED_NODES:\n    current_state, path = q.popleft() # Get the next state to explore efficiently.\n    explored_nodes_count += 1\n\n    # If the current path is too long, skip further exploration from this path.\n    # This acts as an explicit depth limit for the BFS.\n    if len(path) >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # `current_state.step(action)` returns (reward, new_state).\n      # The reward is always 0.0 in this environment implementation.\n      _, next_state = current_state.step(action)\n\n      # Get the simplified hashable representation of the next state.\n      next_state_simplified = _get_simplified_state_tuple(next_state)\n\n      # If this simplified state has not been visited before:\n      if next_state_simplified not in visited:\n        visited.add(next_state_simplified) # Mark as visited.\n        new_path = path + [action]     # Extend the path with the current action.\n\n        # Check if the goal is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          return new_path # Goal reached, return the sequence of actions.\n\n        # Add the new state and its path to the queue for future exploration.\n        q.append((next_state, new_path))\n\n  # If the loop finishes without finding a path (queue empty or limits reached),\n  # it means the item cannot be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:44:10.012529", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment.\n  # Unlike `craft_v1`, this version uses the environment's current state directly\n  # without calling `env.reset()`. This makes it suitable for planning from\n  # an arbitrary intermediate state of the environment.\n  initial_craft_state = env._current_state\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = deque()\n  queue.append((initial_craft_state, []))\n\n  # Initialize the set of visited states to prevent cycles and redundant computations.\n  # States are hashed using the _hash_state helper function for efficient lookup.\n  visited = set()\n  visited.add(_hash_state(initial_craft_state))\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This acts as a maximum path length for the BFS, pruning branches that exceed it.\n  # If `env.max_steps` is not available or appropriate, consider using a default or another limit.\n  max_path_length = env.max_steps\n\n  # Define all possible actions. These correspond to the integer IDs for actions\n  # as described in CraftLab's action_specs (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  # BFS main loop\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Pruning condition: If the current path length already exceeds the maximum allowed steps,\n      # there's no need to explore further from this branch, as it won't lead to a valid solution.\n      if len(actions_taken) >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only care about the new state.\n          _, new_state = current_state.step(action)\n          # Create a new list of actions by appending the current action.\n          new_actions_taken = actions_taken + [action]\n\n          # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n          if new_state.satisfies(None, item):\n              # If the goal is satisfied, we've found the shortest sequence of actions.\n              return new_actions_taken\n\n          # Generate the hashable representation of the new state.\n          new_state_hash = _hash_state(new_state)\n\n          # If this new state has not been visited before, add it to the visited set and the queue\n          # to explore its future possibilities.\n          if new_state_hash not in visited:\n              visited.add(new_state_hash)\n              queue.append((new_state, new_actions_taken))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:44:10.991783", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment's current internal state.\n  # This function works from the *current* state of `env`, not necessarily a reset one.\n  initial_craft_state = env._current_state\n  initial_state_hash = _hash_state(initial_craft_state)\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, current_path_length)\n  # The actual sequence of actions is reconstructed using the `path_tracker`.\n  queue = deque()\n  queue.append((initial_craft_state, 0)) # Start with 0 actions taken\n\n  # `path_tracker` maps: state_hash -> (parent_state_hash, action_from_parent)\n  # This dictionary allows us to reconstruct the path by backtracking from the goal state.\n  path_tracker = {initial_state_hash: (None, None)} # Initial state has no parent or action\n\n  # Retrieve the maximum number of steps allowed for an episode.\n  # Use getattr for robustness in case 'max_steps' is not directly an attribute or is None.\n  # A default value (e.g., 1000) is provided if `max_steps` is not found,\n  # though CraftLab typically provides this.\n  max_path_length = getattr(env, 'max_steps', 1000)\n\n  # Define all possible actions. These correspond to the integer IDs for actions\n  # as described in CraftLab's action_specs (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  # BFS main loop\n  while queue:\n      current_state, current_path_length = queue.popleft()\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only care about the new state.\n          _, new_state = current_state.step(action)\n          new_state_hash = _hash_state(new_state)\n\n          # Calculate the path length to the new state.\n          new_path_length = current_path_length + 1\n\n          # If this new path length exceeds the maximum allowed, do not explore this branch.\n          if new_path_length > max_path_length:\n              continue\n\n          # If this new state has not been visited before (or found via a shorter path),\n          # add it to the path_tracker and queue.\n          # For BFS, the first time we reach a state is always the shortest path.\n          if new_state_hash not in path_tracker:\n              path_tracker[new_state_hash] = (current_state_hash, action)\n\n              # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n              if new_state.satisfies(None, item):\n                  # If the goal is satisfied, we've found the shortest sequence of actions.\n                  # Reconstruct the path by backtracking from the goal state.\n                  path = []\n                  trace_hash = new_state_hash\n                  while path_tracker[trace_hash][0] is not None: # While not at the initial state\n                      parent_hash, action_from_parent = path_tracker[trace_hash]\n                      path.append(action_from_parent)\n                      trace_hash = parent_hash\n                  path.reverse() # Actions were added in reverse order, so reverse to get chronological\n                  return path\n\n              # Add the new state to the queue for further exploration.\n              queue.append((new_state, new_path_length))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:46:14.557023", "function_name": "craft", "function_body": "    # Action mappings as per typical DMLab-style environments.\n    # Assuming these integer values based on the problem description.\n    # These would typically be global constants or part of an enum in a larger project.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n    ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n    start_state = env._current_state\n    goal_item_idx = item\n\n    # Queue for Breadth-First Search (BFS):\n    # Stores tuples of (current_craft_state, path_to_current_state).\n    # `current_craft_state` is a CraftState object representing the current environment state.\n    # `path_to_current_state` is a list of integers (actions) taken to reach this state.\n    q = collections.deque()\n    q.append((start_state, []))\n\n    # Visited set:\n    # Stores hashable representations of states to avoid redundant exploration and cycles.\n    # A state is uniquely defined by (grid, inventory, agent_position, agent_direction).\n    # numpy.ndarray objects (grid, inventory) are not directly hashable, so convert them to bytes.\n    # Agent position (tuple) and direction (int) are hashable.\n    visited = set()\n\n    # Add the initial state to the visited set.\n    initial_state_tuple = (\n        start_state.grid.tobytes(),\n        start_state.inventory.tobytes(),\n        start_state.pos,\n        start_state.dir\n    )\n    visited.add(initial_state_tuple)\n\n    # Maximum search depth:\n    # This limit prevents infinite loops in complex state spaces and controls computational resources.\n    # Adjust this value based on the expected complexity of crafting recipes and grid size.\n    MAX_SEARCH_DEPTH = 500 \n\n    while q:\n        current_state, path = q.popleft()\n\n        # Check if the goal item is present in the current state's inventory.\n        # CraftState.satisfies(goal_name, goal_arg) checks if inventory[goal_arg] > 0.\n        if current_state.satisfies(None, goal_item_idx):\n            return path\n\n        # Pruning: If the current path exceeds the maximum allowed search depth,\n        # stop exploring this branch to prevent excessive computation.\n        if len(path) >= MAX_SEARCH_DEPTH:\n            continue\n\n        # Explore all possible next actions from the current state.\n        for action in ALL_ACTIONS:\n            # Simulate the action using CraftState.step().\n            # This method returns (reward, new_state).\n            # In this CraftState implementation, the reward is typically 0.0 for steps,\n            # so we are primarily interested in the `new_state`.\n            _, new_state = current_state.step(action)\n\n            # Generate a hashable representation of the new state for the visited set.\n            new_state_tuple = (\n                new_state.grid.tobytes(),\n                new_state.inventory.tobytes(),\n                new_state.pos,\n                new_state.dir\n            )\n\n            # If this new state has not been visited before, add it to the queue\n            # for future exploration and mark it as visited.\n            if new_state_tuple not in visited:\n                visited.add(new_state_tuple)\n                q.append((new_state, path + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means no path\n    # was found within the defined search limits or the reachable state space.\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:46:14.632425", "function_name": "craft", "function_body": "    import numpy as np\n    from collections import deque\n\n    # Define action constants based on CraftLab.action_specs()\n    # These are used for generating action sequences.\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    _MOVE_ACTION_TO_DELTXY = {\n        ACTION_DOWN: (0, 1),\n        ACTION_UP: (0, -1),\n        ACTION_LEFT: (-1, 0),\n        ACTION_RIGHT: (1, 0),\n    }\n\n    def find_path_multiple_targets(start_state, target_goals):\n        \"\"\"\n        Performs a BFS to find the shortest path from start_state.pos to any of the target_goals.\n\n        Args:\n            start_state: The initial CraftState object.\n            target_goals: A list of (path_target_pos, original_entity_loc) tuples.\n                          path_target_pos is the cell the agent needs to move to.\n                          original_entity_loc is the actual item/station location this path_target_pos refers to.\n\n        Returns:\n            (list_of_actions, end_state_at_target_pos, original_entity_loc_reached) if a path is found,\n            or (None, None, None) if no path exists.\n        \"\"\"\n        queue = deque([(start_state, [])])  # (current_CraftState, actions_taken_so_far)\n\n        # Visited states: (pos_x, pos_y). We only care about position for pathfinding to a target cell.\n        # Inventory and direction changes are handled by `current_state.step` which creates new state objects.\n        visited = set([(start_state.pos)])\n\n        # Create a set of just the path target positions for quick lookup\n        path_targets_set = {tg[0] for tg in target_goals}\n\n        # Map path_target_pos to its original_entity_loc for the result. Assumes unique path_target_pos.\n        path_target_to_entity_map = {tg[0]: tg[1] for tg in target_goals}\n\n        while queue:\n            current_state, actions_taken = queue.popleft()\n\n            # Check if current position is one of our target positions\n            if current_state.pos in path_targets_set:\n                original_entity_loc = path_target_to_entity_map[current_state.pos]\n                return actions_taken, current_state, original_entity_loc\n\n            # Explore movement actions (DOWN, UP, LEFT, RIGHT)\n            for action_id in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n                # Simulate the step to get the next state. CraftState.step creates a new state object.\n                _reward, next_state = current_state.step(action_id)\n\n                # Check if agent successfully moved to a different position (i.e., not blocked by obstacle)\n                if next_state.pos != current_state.pos:\n                    if next_state.pos not in visited:\n                        visited.add(next_state.pos)\n                        queue.append((next_state, actions_taken + [action_id]))\n\n        return None, None, None  # No path found\n\n    current_state = env._current_state\n    cookbook = env.world.cookbook\n    world = env.world  # Reference to CraftWorld for specific indices like primitives, workshops\n    all_actions = []  # List to accumulate the sequence of actions\n\n    # Determine all primitive items needed for the goal item\n    # cookbook.primitives_for(item) returns a dict {primitive_idx: count}\n    # This function resolves nested recipes into their base primitive components.\n    required_primitives_for_crafting = cookbook.primitives_for(item)\n\n    # If the goal `item` itself is a primitive and not implicitly part of a larger recipe, add it.\n    if item in world.primitives and not required_primitives_for_crafting:\n        required_primitives_for_crafting[item] = 1\n\n    # Sort primitives for consistent processing order (e.g., by index)\n    sorted_primitives = sorted(required_primitives_for_crafting.items(), key=lambda x: x[0])\n\n    # 1. Collect all required primitive items\n    for p_idx, p_count in sorted_primitives:\n        # Loop until enough of this primitive is in inventory\n        while current_state.inventory[p_idx] < p_count:\n            # Find all locations of this primitive on the grid\n            p_locations = []\n            WIDTH, HEIGHT, _ = current_state.grid.shape\n            for x in range(WIDTH):\n                for y in range(HEIGHT):\n                    if current_state.grid[x, y, p_idx] > 0:\n                        p_locations.append((x, y))\n\n            if not p_locations:\n                # If a primitive required for crafting is not on the map, we cannot complete the goal.\n                print(f\"Error: Required primitive {cookbook.index.get(p_idx)} not found on grid.\")\n                return []\n\n            # For grabbable items, the agent typically walks ONTO the item's location to pick it up.\n            # `target_goals` format: (path_target_pos, original_entity_loc)\n            target_path_goals = [(loc, loc) for loc in p_locations]\n\n            path_actions, end_state_at_target_pos, _ = find_path_multiple_targets(\n                current_state,\n                target_path_goals\n            )\n\n            if path_actions is None:\n                print(f\"Error: No path found to collect primitive {cookbook.index.get(p_idx)}.\")\n                return []\n\n            all_actions.extend(path_actions)\n            current_state = end_state_at_target_pos\n\n            # Perform USE action to pick up the item.\n            # The `CraftState.step(ACTION_USE)` method will handle the actual pickup.\n            initial_p_count = current_state.inventory[p_idx]\n            _reward, next_state_after_use = current_state.step(ACTION_USE)\n            all_actions.append(ACTION_USE)\n            current_state = next_state_after_use\n\n            # Verify that the item was picked up (inventory count increased)\n            if current_state.inventory[p_idx] <= initial_p_count:\n                print(f\"Warning: USE action did not increase inventory for {cookbook.index.get(p_idx)} at {current_state.pos}.\")\n                # This could indicate the item was not grabbable at this location or some other issue.\n                return []  # Failed to pick up, cannot proceed.\n\n    # 2. After collecting all primitives, perform final crafting if the goal item requires a station.\n    # A recipe usually has a \"_key\" entry if it needs a specific crafting station.\n    item_recipe_key = None\n    recipe_info = cookbook.recipes.get(item)\n    if recipe_info and \"_key\" in recipe_info:\n        item_recipe_key = recipe_info[\"_key\"]\n\n    if item_recipe_key is not None:\n        # Find all locations of the crafting station on the grid\n        station_locations = []\n        WIDTH, HEIGHT, _ = current_state.grid.shape\n        for x in range(WIDTH):\n            for y in range(HEIGHT):\n                if current_state.grid[x, y, item_recipe_key] > 0:\n                    station_locations.append((x, y))\n\n        if not station_locations:\n            print(f\"Error: Crafting station {cookbook.index.get(item_recipe_key)} not found on grid.\")\n            return []\n\n        # For crafting stations, the agent typically walks ADJACENT to the station to use it.\n        target_path_goals_for_station = []\n        for station_loc in station_locations:\n            # Check 4 adjacent cardinal directions\n            for dx, dy in [(0, 1), (0, -1), (-1, 0), (1, 0)]:\n                adj_pos = (station_loc[0] + dx, station_loc[1] + dy)\n                # Ensure the adjacent position is within grid boundaries\n                if 0 <= adj_pos[0] < WIDTH and 0 <= adj_pos[1] < HEIGHT:\n                    # `adj_pos` is where the agent needs to move, `station_loc` is the actual target entity.\n                    target_path_goals_for_station.append((adj_pos, station_loc))\n\n        if not target_path_goals_for_station:\n            print(f\"Error: No walkable adjacent positions found for crafting station {cookbook.index.get(item_recipe_key)}.\")\n            return []\n\n        path_actions_to_station, end_state_at_station_adj_pos, _ = find_path_multiple_targets(\n            current_state,\n            target_path_goals_for_station\n        )\n\n        if path_actions_to_station is None:\n            print(f\"Error: No path found to crafting station {cookbook.index.get(item_recipe_key)}.\")\n            return []\n\n        all_actions.extend(path_actions_to_station)\n        current_state = end_state_at_station_adj_pos\n\n        # Perform USE action at the station. This should trigger the crafting.\n        initial_item_count = current_state.inventory[item]\n        _reward, final_state = current_state.step(ACTION_USE)\n        all_actions.append(ACTION_USE)\n        current_state = final_state\n\n        # Verify that the goal item was successfully crafted (inventory count increased)\n        if current_state.inventory[item] <= initial_item_count:\n            print(f\"Warning: USE action at station did not craft {cookbook.index.get(item)}. Missing ingredients or wrong station?\")\n            return []  # Failed to craft.\n\n    # 3. Final verification: Check if the goal item is now in the inventory.\n    if current_state.inventory[item] > 0:\n        return all_actions\n    else:\n        # This case should ideally not be reached if all previous steps succeeded.\n        # It handles scenarios where the item is a primitive and was collected,\n        # or a crafted item where crafting somehow failed without explicit warnings.\n        print(f\"Error: Goal item {cookbook.index.get(item)} (idx: {item}) not in inventory after all planning steps.\")\n        return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:47:13.834634", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment.\n  # IMPROVEMENT over craft_v1: Start from the *current* state of the environment\n  # (`env._current_state`) instead of always resetting it. This allows planning\n  # from an arbitrary point in an ongoing episode, which is more flexible.\n  initial_craft_state = env._current_state\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = deque()\n  queue.append((initial_craft_state, []))\n\n  # Initialize the set of visited states to prevent cycles and redundant computations.\n  # States are hashed using the _hash_state helper function for efficient lookup.\n  visited = set()\n  visited.add(_hash_state(initial_craft_state))\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This acts as a maximum path length for the BFS, pruning branches that exceed it.\n  # IMPROVEMENT: Use getattr with a default value to make it robust if max_steps is not explicitly set.\n  max_path_length = getattr(env, 'max_steps', 500) # A reasonable default if env.max_steps is missing\n\n  # Define all possible actions. These correspond to the integer IDs for actions\n  # as described in CraftLab's action_specs (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  # BFS main loop\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Pruning condition: If the current path length already exceeds the maximum allowed steps,\n      # there's no need to explore further from this branch, as it won't lead to a valid solution.\n      if len(actions_taken) >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only care about the new state.\n          _, new_state = current_state.step(action)\n          # Create a new list of actions by appending the current action.\n          # For typical path lengths in CraftWorld, list concatenation is acceptable and readable.\n          new_actions_taken = actions_taken + [action]\n\n          # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n          if new_state.satisfies(None, item):\n              # If the goal is satisfied, we've found the shortest sequence of actions.\n              return new_actions_taken\n\n          # Generate the hashable representation of the new state.\n          new_state_hash = _hash_state(new_state)\n\n          # If this new state has not been visited before, add it to the visited set and the queue\n          # to explore its future possibilities.\n          if new_state_hash not in visited:\n              visited.add(new_state_hash)\n              queue.append((new_state, new_actions_taken))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:47:35.912414", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment.\n  # This version operates on the *current* state of the `env` object without resetting it,\n  # making it applicable to any state the environment is currently in. This addresses\n  # the potential limitation of `craft_v1` which always resets the environment.\n  initial_craft_state = env._current_state\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = deque()\n  queue.append((initial_craft_state, []))\n\n  # Initialize the set of visited states to prevent cycles and redundant computations.\n  # States are hashed using the _hash_state helper function for efficient lookup.\n  visited = set()\n  visited.add(_hash_state(initial_craft_state))\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This acts as a maximum path length for the BFS, pruning branches that exceed it.\n  max_path_length = env.max_steps\n\n  # Define all possible actions. These correspond to the integer IDs for actions\n  # as described in CraftLab's action_specs (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  # BFS main loop\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Pruning condition: If the current path length already equals or exceeds the maximum allowed steps,\n      # there's no need to explore further from this branch. This ensures that the returned path\n      # will not exceed `max_path_length`. A path of `max_path_length` actions is considered valid.\n      if len(actions_taken) >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only care about the new state.\n          _, new_state = current_state.step(action)\n          # Create a new list of actions by appending the current action.\n          new_actions_taken = actions_taken + [action]\n\n          # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n          if new_state.satisfies(None, item):\n              # If the goal is satisfied, and the path length is within limits,\n              # we've found the shortest sequence of actions.\n              if len(new_actions_taken) <= max_path_length:\n                  return new_actions_taken\n              # If the goal is satisfied but the path length exceeds `max_path_length`,\n              # this solution is invalid, so we continue to explore other paths.\n              continue # This case should ideally not be hit if the `len(actions_taken) >= max_path_length` check is correct.\n\n          # Generate the hashable representation of the new state.\n          new_state_hash = _hash_state(new_state)\n\n          # If this new state has not been visited before, add it to the visited set and the queue\n          # to explore its future possibilities. Only add if the resulting path length\n          # (after taking this action) does not exceed `max_path_length`.\n          # This explicit check here might be redundant due to the check at the top of the loop,\n          # but provides an additional safeguard.\n          if new_state_hash not in visited and len(new_actions_taken) <= max_path_length:\n              visited.add(new_state_hash)\n              queue.append((new_state, new_actions_taken))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:48:53.388766", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Constants for actions\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  world = env.world\n  # Get the initial CraftState object from the CraftLab environment\n  # The \"state\" key in \"features_dict\" holds the CraftState instance.\n  initial_state = env.reset(seed=0)[\"features_dict\"][\"state\"]\n\n  # Memoization dictionary to store results for (state_key, target_item_idx)\n  # A state_key includes position, direction, and inventory for unique identification.\n  memo = {} # ( (pos_x, pos_y), dir, tuple(inventory_array) ) -> List[int] or None\n\n  def _plan_item_actions(current_sim_state, target_item_idx):\n      \"\"\"\n      Recursively plans the actions required to obtain a target item from a given state.\n      \"\"\"\n      # Create a hashable key for memoization\n      state_key = (\n          current_sim_state.pos,\n          current_sim_state.dir,\n          tuple(current_sim_state.inventory.tolist()) # Convert np array to list then tuple\n      )\n      memo_key = (state_key, target_item_idx)\n\n      if memo_key in memo:\n          return memo[memo_key]\n\n      # Base Case 1: Target item is already in the inventory\n      if current_sim_state.inventory[target_item_idx] > 0:\n          memo[memo_key] = []\n          return []\n\n      actions_to_take = []\n      simulated_state = current_sim_state # Current state for simulation within this call\n\n      # Case 1: Target item is a primitive (can be picked up directly)\n      if target_item_idx in world.cookbook.primitives:\n          # Use BFS to find a path to the primitive item on the grid\n          q_bfs = collections.deque([(simulated_state, [])])\n          visited_bfs_states = set() # Store (pos_x, pos_y, dir) to prevent loops\n\n          while q_bfs:\n              s_bfs, acts_bfs = q_bfs.popleft()\n              \n              bfs_state_key = (s_bfs.pos[0], s_bfs.pos[1], s_bfs.dir)\n              if bfs_state_key in visited_bfs_states:\n                  continue\n              visited_bfs_states.add(bfs_state_key)\n\n              # Check if the current position contains the primitive\n              if s_bfs.grid[s_bfs.pos[0], s_bfs.pos[1], target_item_idx] > 0:\n                  result = acts_bfs + [USE] # Path to item + USE action\n                  memo[memo_key] = result\n                  return result\n\n              # Explore neighbors by trying all movement actions\n              for action_val in [DOWN, UP, LEFT, RIGHT]:\n                  _, next_s_bfs = s_bfs.step(action_val)\n                  if (next_s_bfs.pos[0], next_s_bfs.pos[1], next_s_bfs.dir) not in visited_bfs_states:\n                      q_bfs.append((next_s_bfs, acts_bfs + [action_val]))\n          \n          # If primitive not found or unreachable\n          memo[memo_key] = None\n          return None\n\n      # Case 2: Target item is craftable (has a recipe)\n      if target_item_idx in world.cookbook.recipes:\n          recipe = world.cookbook.recipes[target_item_idx]\n\n          # 1. Gather all required non-key ingredients\n          ingredients_to_gather = []\n          for ingredient_idx, count in recipe.items():\n              if isinstance(ingredient_idx, str): # Skip string keys (e.g., '_tool', '_in_water')\n                  continue\n              # Calculate how many more of this ingredient are needed\n              needed_count = max(0, count - simulated_state.inventory[ingredient_idx])\n              ingredients_to_gather.append((ingredient_idx, needed_count))\n          \n          # Process ingredients. Order might matter for efficiency but not correctness.\n          for ingredient_idx, needed_count in ingredients_to_gather:\n              for _ in range(needed_count):\n                  # Recursively plan actions for each needed ingredient\n                  ingredient_plan = _plan_item_actions(simulated_state, ingredient_idx)\n                  if ingredient_plan is None:\n                      memo[memo_key] = None\n                      return None # Cannot obtain a required ingredient\n\n                  actions_to_take.extend(ingredient_plan)\n                  # Simulate the effect of these actions on our current state\n                  for action in ingredient_plan:\n                      _, simulated_state = simulated_state.step(action)\n          \n          # 2. Pathfind to the correct crafting location if a _key condition requires it\n          target_location_kind = None\n          if '_in_water' in recipe:\n              target_location_kind = world.water_index\n          elif '_in_stone' in recipe:\n              target_location_kind = world.stone_index\n          elif '_in_workshop' in recipe:\n              # CraftWorld might have multiple workshop types; pick the first one\n              if world.workshop_indices:\n                  target_location_kind = world.workshop_indices[0] \n\n          if target_location_kind is not None:\n              q_loc_bfs = collections.deque([(simulated_state, [])])\n              visited_loc_bfs = set() # Store (pos_x, pos_y, dir)\n              path_to_location = None\n\n              while q_loc_bfs:\n                  s_loc_bfs, acts_loc_bfs = q_loc_bfs.popleft()\n                  \n                  bfs_loc_state_key = (s_loc_bfs.pos[0], s_loc_bfs.pos[1], s_loc_bfs.dir)\n                  if bfs_loc_state_key in visited_loc_bfs:\n                      continue\n                  visited_loc_bfs.add(bfs_loc_state_key)\n\n                  # Check if agent is next to the target location\n                  if s_loc_bfs.next_to(target_location_kind):\n                      path_to_location = acts_loc_bfs\n                      break # Found path to location\n                  \n                  # Explore neighbors\n                  for action_val in [DOWN, UP, LEFT, RIGHT]:\n                      _, next_s_loc_bfs = s_loc_bfs.step(action_val)\n                      if (next_s_loc_bfs.pos[0], next_s_loc_bfs.pos[1], next_s_loc_bfs.dir) not in visited_loc_bfs:\n                          q_loc_bfs.append((next_s_loc_bfs, acts_loc_bfs + [action_val]))\n              \n              if path_to_location is None:\n                  memo[memo_key] = None\n                  return None # Cannot reach the required crafting location\n\n              actions_to_take.extend(path_to_location)\n              # Simulate moving to the location\n              for action in path_to_location:\n                  _, simulated_state = simulated_state.step(action)\n\n          # 3. Handle '_tool' requirement (tool must be in inventory)\n          if '_tool' in recipe:\n              tool_idx = world.cookbook.index.index(\"tool\")\n              if simulated_state.inventory[tool_idx] == 0: # If tool is needed but not present\n                  tool_plan = _plan_item_actions(simulated_state, tool_idx)\n                  if tool_plan is None:\n                      memo[memo_key] = None\n                      return None # Cannot obtain the tool\n\n                  actions_to_take.extend(tool_plan)\n                  # Simulate obtaining the tool\n                  for action in tool_plan:\n                      _, simulated_state = simulated_state.step(action)\n\n          # 4. Perform the final USE action to craft the item\n          # Save inventory before USE to verify success\n          pre_use_inventory = np.copy(simulated_state.inventory)\n\n          actions_to_take.append(USE)\n          # Apply the USE action\n          _, final_simulated_state = simulated_state.step(USE)\n          \n          # Verify the craft was successful by checking if item count increased\n          if final_simulated_state.inventory[target_item_idx] > pre_use_inventory[target_item_idx]:\n              memo[memo_key] = actions_to_take\n              return actions_to_take\n          else:\n              # Crafting failed (e.g., conditions not met, or a bug)\n              memo[memo_key] = None\n              return None\n      \n      # If item is neither primitive nor craftable (or unhandled type)\n      memo[memo_key] = None\n      return None\n\n  # Start the planning process from the initial environment state\n  final_actions = _plan_item_actions(initial_state, item)\n  \n  # Return an empty list if crafting is impossible, as per implicit convention of v0/v1\n  if final_actions is None:\n      return []\n  else:\n      return final_actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:48:53.457850", "function_name": "craft", "function_body": "    # Helper function to generate a hashable representation of a CraftState.\n    # This function is nested inside craft_v2 to adhere to the instruction\n    # \"Return only code that will fit in that function.\"\n    def _hash_state(state):\n        \"\"\"Generates a hashable representation of a CraftState.\"\"\"\n        # Convert numpy arrays (grid, inventory) to bytes or tuples for hashing.\n        # Pos (tuple) and dir (int) are already hashable.\n        return (state.grid.tobytes(), tuple(state.inventory), state.pos, state.dir)\n\n    # We assume 'collections.deque' is available because 'collections' is\n    # typically imported at the top level of the file, similar to numpy.\n    # We also assume 'env_factory' constants (DOWN, UP, LEFT, RIGHT, USE)\n    # are accessible, as 'env_factory' is listed as an import source.\n    # Define the list of all possible actions.\n    ALL_ACTIONS = [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT, env_factory.USE]\n\n    # Get the initial state from the CraftLab environment.\n    initial_state = env._current_state\n\n    # Initialize a deque for Breadth-First Search (BFS).\n    # Each element in the queue is a tuple: (current_state, path_to_current_state).\n    q = collections.deque([(initial_state, [])])\n\n    # Initialize a set to store visited states to prevent cycles and redundant computations.\n    # We use the hashable representation of the state for efficient lookup.\n    visited = {_hash_state(initial_state)}\n\n    # A safety limit for the number of states to explore to prevent infinite loops\n    # or excessive memory consumption in very large state spaces.\n    # This value might need tuning depending on the complexity of the crafting tasks.\n    MAX_SEARCH_STEPS = 50000\n    steps_processed = 0\n\n    # Perform BFS until the queue is empty or the maximum search steps are reached.\n    while q and steps_processed < MAX_SEARCH_STEPS:\n        current_state, current_path = q.popleft()\n        steps_processed += 1\n\n        # Check if the current state satisfies the goal (i.e., the item is in inventory).\n        # CraftState.satisfies expects a goal_name (which is ignored here) and the item index.\n        if current_state.satisfies(None, item):\n            return current_path\n\n        # Explore all possible actions from the current state.\n        for action in ALL_ACTIONS:\n            # Apply the action to get the next state.\n            # The `step` method returns a new CraftState instance, which is crucial for BFS.\n            # The reward value returned by `step` is not used for pathfinding here.\n            _reward, next_state = current_state.step(action)\n\n            # Get the hashable representation of the next state.\n            next_state_hash = _hash_state(next_state)\n\n            # If this next state has not been visited before, add it to the visited set\n            # and enqueue it along with the path leading to it.\n            if next_state_hash not in visited:\n                visited.add(next_state_hash)\n                q.append((next_state, current_path + [action]))\n\n    # If the BFS completes (queue exhausted) and the goal item was not found,\n    # or if the maximum search steps were exceeded, return an empty list.\n    return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:49:49.649376", "function_name": "craft", "function_body": "    # Define action constants based on CraftLab.action_specs\n    # These are typically globally defined, but for clarity and self-containment\n    # within this function, we'll define them. It's assumed these align with\n    # how the CraftWorld environment expects actions (0-4).\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    \n    actions = [DOWN, UP, LEFT, RIGHT, USE]\n\n    # Reset the environment to get the initial state for planning.\n    # This ensures the internal `_current_state` of `env` is fresh and\n    # corresponds to the start of a new episode. A fixed seed is used for\n    # deterministic behavior during the planning search.\n    _ = env.reset(seed=0) \n    initial_state = env._current_state # Get the initial CraftState object for planning\n\n    # BFS Queue: stores tuples of (CraftState_object, list_of_actions_to_reach_this_state).\n    # We use a deque for efficient appends and pops from both ends.\n    q = collections.deque([(initial_state, [])])\n\n    # Visited set: stores canonical representations of states to avoid revisiting\n    # the same state, which prevents infinite loops and redundant computation.\n    # A canonical state is a tuple of immutable representations of its core components:\n    # (grid_bytes, pos_tuple, dir_int, inventory_bytes).\n    # NumPy arrays (grid, inventory) are converted to bytes for hashing in the set.\n    visited = set()\n    initial_state_canonical = (\n        initial_state.grid.tobytes(),\n        initial_state.pos,\n        initial_state.dir,\n        initial_state.inventory.tobytes()\n    )\n    visited.add(initial_state_canonical)\n\n    # Maximum number of steps to search. This acts as a safeguard against\n    # excessively long searches in complex or unsolvable scenarios.\n    # It tries to use `env.max_steps` from the `CraftLab` instance if available,\n    # otherwise, it defaults to 200 steps.\n    max_search_steps = getattr(env, 'max_steps', 200)\n\n    # Perform Breadth-First Search (BFS)\n    while q:\n        current_state, current_path = q.popleft()\n\n        # Check if the goal (the desired `item`) is satisfied in the current state's inventory.\n        # The `goal_name` argument for `CraftState.satisfies` is ignored in this implementation.\n        if current_state.satisfies(None, item):\n            return current_path # Goal reached, return the sequence of actions\n\n        # If the current path length exceeds the maximum allowed search steps,\n        # prune this branch to avoid exploring paths that are too long.\n        if len(current_path) >= max_search_steps:\n            continue\n\n        # Explore all possible actions from the current state.\n        for action in actions:\n            # `CraftState.step()` returns a *new* `CraftState` object,\n            # so we do not need to deepcopy `current_state` before stepping.\n            # The reward is always 0.0 in this environment, so it's ignored for pathfinding.\n            _, new_state = current_state.step(action)\n\n            # Create a canonical representation of the new state for the `visited` set.\n            new_state_canonical = (\n                new_state.grid.tobytes(),\n                new_state.pos,\n                new_state.dir,\n                new_state.inventory.tobytes()\n            )\n\n            # If this new state has not been visited before, add it to the queue\n            # and mark it as visited.\n            if new_state_canonical not in visited:\n                visited.add(new_state_canonical)\n                q.append((new_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal was not reached, it means no path\n    # was found within the search limits. Return an empty list to indicate failure.\n    return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:50:20.084600", "function_name": "craft", "function_body": "  # Action constants derived from CraftLab.action_specs():\n  # DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTIONS = [0, 1, 2, 3, 4] \n\n  initial_state = env._current_state\n  \n  # Queue for BFS: stores tuples of (CraftState, list_of_actions_taken_to_reach_this_state)\n  # We use a standard Python list and a 'head' pointer to simulate a deque efficiently,\n  # as collections.deque might not be available in the given environment context.\n  queue = [(initial_state, [])]\n  \n  # Set to store visited states to avoid redundant computation and cycles.\n  # A state is uniquely identified by (grid_content, inventory_content, position, direction).\n  # grid_content (numpy array) is converted to bytes for hashing.\n  # inventory_content (numpy array) is converted to a tuple of its list for hashing.\n  visited = set()\n  \n  # Helper function to create a hashable key for a CraftState object.\n  # This is crucial for efficient lookup in the 'visited' set.\n  def get_state_key(state):\n      return (state.grid.tobytes(), tuple(state.inventory.tolist()), state.pos, state.dir)\n\n  # Add the initial state to the visited set\n  initial_state_key = get_state_key(initial_state)\n  visited.add(initial_state_key)\n\n  head = 0  # Pointer to the front of the queue\n  while head < len(queue):\n      current_state, current_path = queue[head]\n      head += 1  # Move the head pointer to the next element\n\n      # Check if the current state satisfies the crafting goal.\n      # The `satisfies` method takes an ignored goal_name and the item index as goal_arg.\n      if current_state.satisfies(None, item):\n          return current_path  # Goal reached, return the sequence of actions\n\n      # Explore all possible next states by trying each action.\n      for action in ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns a new CraftState object, not modifying the current_state.\n          _reward, next_state = current_state.step(action)\n          next_state_key = get_state_key(next_state)\n\n          # If this next state has not been visited before, add it to the queue and visited set.\n          if next_state_key not in visited:\n              visited.add(next_state_key)\n              queue.append((next_state, current_path + [action]))\n  \n  # If the queue becomes empty and the goal was never reached,\n  # it means the item cannot be crafted from the initial state.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:52:26.823828", "function_name": "craft", "function_body": "  # Action constants (assuming these are globally defined or otherwise accessible)\n  # _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4\n  # _ACTION_VECTORS = {\n  #     _UP: (0, -1),\n  #     _DOWN: (0, 1),\n  #     _LEFT: (-1, 0),\n  #     _RIGHT: (1, 0)\n  # }\n  # Note: The problem description implies these might be globally defined or part of an imported module.\n  # Assuming they are accessible as per typical library structure.\n  \n  # For the purpose of providing only the function body, we would normally put\n  # helper functions outside if they are not closures. However, if the intent is\n  # \"everything necessary within this text block\", then they would be nested.\n  # Given the prompt, and common competitive programming/interview setups,\n  # these helpers are assumed to be defined at the module level.\n\n  # Initialize action constants (re-declared for clarity within this scope, assuming global constants _DOWN etc. exist)\n  _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4\n  _ACTION_VECTORS = {\n      _UP: (0, -1),\n      _DOWN: (0, 1),\n      _LEFT: (-1, 0),\n      _RIGHT: (1, 0)\n  }\n\n  # Helper function for BFS pathfinding\n  def _bfs_path_to_interact(\n      start_grid, start_pos, target_kind_idx, world_ref,\n      target_type=\"primitive\" # \"primitive\", \"environment\", \"workshop\"\n  ):\n      \"\"\"\n      Finds a sequence of movement actions to reach a position where agent can interact with target_kind_idx.\n      Returns: (list of actions, interaction_pos_of_agent_where_use_is_possible) or (None, None).\n      \"\"\"\n      import collections # Local import for strict adherence to \"no imports\" at the top-level returned code.\n      \n      width, height, _ = start_grid.shape\n      \n      # Impassable kinds for movement: typically all non-grabbable items.\n      impassable_kinds_for_movement = set(world_ref.non_grabbable_indices)\n      \n      q = collections.deque([(start_pos, [])]) # (agent_pos, actions_taken_to_reach_agent_pos)\n      visited = {start_pos}\n      \n      while q:\n          current_agent_pos, current_actions = q.popleft()\n          cx, cy = current_agent_pos\n          \n          # Check if the current agent position allows interaction with the target\n          can_interact = False\n          if target_type == \"primitive\":\n              # Agent needs to be ON the primitive\n              if start_grid[cx, cy, target_kind_idx] > 0:\n                  can_interact = True\n          elif target_type in [\"environment\", \"workshop\"]:\n              # Agent needs to be ADJACENT to the environment item or workshop\n              for dx_check in [-1, 0, 1]:\n                  for dy_check in [-1, 0, 1]:\n                      nx_check, ny_check = cx + dx_check, cy + dy_check\n                      if 0 <= nx_check < width and 0 <= ny_check < height:\n                          if start_grid[nx_check, ny_check, target_kind_idx] > 0:\n                              can_interact = True\n                              break\n                  if can_interact:\n                      break\n          \n          if can_interact:\n              return current_actions, current_agent_pos\n          \n          # Explore neighbors\n          for action, (dx, dy) in _ACTION_VECTORS.items():\n              nx, ny = cx + dx, cy + dy\n              new_agent_pos = (nx, ny)\n              \n              if 0 <= nx < width and 0 <= ny < height and new_agent_pos not in visited:\n                  # Check if the new cell is passable for the agent\n                  is_passable = True\n                  for ik in impassable_kinds_for_movement:\n                      # If the cell contains an impassable item, and it's not the target primitive itself\n                      # (which an agent needs to step on to pick up), then it's impassable.\n                      # Primitives are generally not in non_grabbable_indices, so this check is mostly defensive.\n                      if start_grid[nx, ny, ik] > 0 and not (target_type == \"primitive\" and ik == target_kind_idx):\n                          is_passable = False\n                          break\n                  \n                  if is_passable:\n                      visited.add(new_agent_pos)\n                      q.append((new_agent_pos, current_actions + [action]))\n                      \n      return None, None # Path not found\n\n\n  # Recursive helper function for crafting\n  def _recursive_craft(current_state, target_item_idx, world_ref, visited_goals):\n      \"\"\"\n      Recursively finds actions to craft target_item_idx from current_state.\n      Returns (list_of_actions, final_state) or (None, None) if not craftable.\n      visited_goals: frozenset of item_idx currently in the dependency stack to prevent cycles.\n      \"\"\"\n\n      # Base case: item already in inventory\n      if current_state.inventory[target_item_idx] > 0:\n          return [], current_state\n\n      # Check for immediate cycles in dependency graph (e.g., A needs B, B needs A)\n      if target_item_idx in visited_goals:\n          return None, None # Already trying to craft this in the current dependency chain\n\n      all_actions = []\n      \n      # 1. Is it a primitive (can be directly picked up from the grid)?\n      if target_item_idx in world_ref.cookbook.primitives:\n          path_actions, _ = _bfs_path_to_interact(\n              current_state.grid, current_state.pos, target_item_idx, world_ref, target_type=\"primitive\"\n          )\n          if path_actions is None:\n              return None, None # Cannot reach primitive\n\n          all_actions.extend(path_actions)\n          \n          # Simulate movement\n          temp_state = current_state\n          for action in path_actions:\n              _, temp_state = temp_state.step(action)\n          \n          # Perform USE action\n          _, final_state = temp_state.step(_USE)\n          all_actions.append(_USE)\n          \n          return all_actions, final_state\n\n      # 2. It's a craftable item (requires ingredients or special environmental interaction)\n      recipe = world_ref.cookbook.recipes.get(target_item_idx)\n      if recipe:\n          # Check for _key indicating environmental interaction (like \"use_water\", \"use_stone\")\n          if \"_key\" in recipe:\n              key_action = recipe[\"_key\"]\n              env_kind_idx = None\n              if key_action == \"use_water\":\n                  env_kind_idx = world_ref.water_index\n              elif key_action == \"use_stone\":\n                  env_kind_idx = world_ref.stone_index\n              # \"craft_at_workshop\" will be handled after gathering other ingredients\n              \n              if env_kind_idx is not None:\n                  path_actions, _ = _bfs_path_to_interact(\n                      current_state.grid, current_state.pos, env_kind_idx, world_ref, target_type=\"environment\"\n                  )\n                  if path_actions is None:\n                      return None, None # Cannot reach environment item\n\n                  all_actions.extend(path_actions)\n                  temp_state = current_state\n                  for action in path_actions:\n                      _, temp_state = temp_state.step(action)\n\n                  # Perform USE action\n                  _, final_state = temp_state.step(_USE)\n                  all_actions.append(_USE)\n                  return all_actions, final_state\n          \n          # Handle collecting ingredients for crafting\n          required_ingredients_actions = []\n          temp_current_state = current_state\n          \n          for ingredient_idx, count in recipe.items():\n              if ingredient_idx == \"_key\": continue # Skip _key, handled above or after ingredients\n\n              # Check if we already have enough of this ingredient\n              if temp_current_state.inventory[ingredient_idx] >= count:\n                  continue # Already satisfied\n              \n              # How many more do we need?\n              needed_count = count - temp_current_state.inventory[ingredient_idx]\n\n              # Recursively craft the ingredient `needed_count` times\n              for _ in range(needed_count):\n                  # Add current target_item_idx to visited goals for the recursive call\n                  new_visited_goals = visited_goals.union({target_item_idx}) \n                  \n                  ingredient_actions, state_after_ingredient = _recursive_craft(\n                      temp_current_state, ingredient_idx, world_ref, new_visited_goals\n                  )\n\n                  if ingredient_actions is None:\n                      # Cannot craft this ingredient, so cannot craft the target item\n                      return None, None\n                  \n                  required_ingredients_actions.extend(ingredient_actions)\n                  temp_current_state = state_after_ingredient\n\n          # After collecting all ingredients, if a workshop is needed\n          if recipe.get(\"_key\") == \"craft_at_workshop\":\n              workshop_index = world_ref.cookbook.index.get(\"workshop\") # Assuming \"workshop\" is available by name\n              if workshop_index is None:\n                  return None, None # Workshop not defined in cookbook index\n              \n              path_actions, _ = _bfs_path_to_interact(\n                  temp_current_state.grid, temp_current_state.pos, workshop_index, world_ref, target_type=\"workshop\"\n              )\n              if path_actions is None:\n                  return None, None # Cannot reach workshop\n\n              required_ingredients_actions.extend(path_actions)\n              for action in path_actions:\n                  _, temp_current_state = temp_current_state.step(action)\n              \n          # Finally, perform the USE action to craft the item itself (at workshop or just in place)\n          _, final_state = temp_current_state.step(_USE)\n          required_ingredients_actions.append(_USE)\n          \n          all_actions.extend(required_ingredients_actions)\n          return all_actions, final_state\n\n      # If no recipe, not a primitive, not an environment-crafted item -> uncraftable or invalid\n      return None, None\n\n  # Get initial state from the environment\n  initial_state = env._current_state\n  \n  # Check if item is already crafted in the initial state\n  if initial_state.inventory[item] > 0:\n    return []\n\n  # Start the recursive crafting process\n  # `visited_goals` is used to track items currently in the dependency stack to prevent infinite recursion\n  actions, _ = _recursive_craft(initial_state, item, env.world, frozenset())\n\n  if actions is None:\n    return [] # Return empty list if not craftable, as per previous versions\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:52:26.892432", "function_name": "craft", "function_body": "    import collections\n\n    # Helper function to generate a hashable key for a CraftState\n    # This function needs to be defined within craft_v2 scope to adhere to the prompt.\n    def _get_state_key(state):\n        \"\"\"\n        Generates a hashable tuple representation of a CraftState.\n        This is used for the 'visited' set in BFS.\n        \"\"\"\n        # grid and inventory are numpy arrays. Convert them to bytes for hashing.\n        # tobytes() creates a bytes object from the raw data, which is hashable.\n        grid_bytes = state.grid.tobytes()\n        inventory_bytes = state.inventory.tobytes()\n\n        # pos is already a tuple, dir is an int.\n        return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n    # Constants for actions based on CraftLab.action_specs\n    N_ACTIONS = 5  # DOWN, UP, LEFT, RIGHT, USE\n\n    # Get the initial state from the CraftLab environment\n    initial_state = env._current_state\n\n    # Initialize BFS queue: (current_state_object, list_of_actions_to_reach_this_state)\n    queue = collections.deque([(initial_state, [])])\n\n    # Initialize visited set using the hashable state key\n    visited = {_get_state_key(initial_state)}\n\n    # BFS loop\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Check if the current state satisfies the goal\n        # CraftState.satisfies expects goal_name (ignored here) and goal_arg (the item index)\n        if current_state.satisfies(None, item):\n            return current_path\n\n        # Explore all possible next actions\n        for action in range(N_ACTIONS):\n            # Simulate the action to get the new state\n            # CraftState.step returns (reward, new_state)\n            # The reward is always 0.0 in this implementation, so we discard it.\n            _, new_state = current_state.step(action)\n\n            # Get the hashable key for the new state\n            new_state_key = _get_state_key(new_state)\n\n            # If this new state has not been visited, add it to the queue\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                queue.append((new_state, current_path + [action]))\n\n    # If the queue is exhausted and the goal was not found, the item is unreachable\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:54:23.802116", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Reset the environment to a consistent starting state.\n  # This populates `env._current_state` with the initial `CraftState`.\n  env.reset(seed=0)\n  initial_craft_state = env._current_state\n\n  # Helper function to generate a hashable key for a CraftState.\n  # This key uniquely identifies the state by its grid, inventory, position, and direction.\n  def _get_state_key(state):\n    return (state.grid.tobytes(), tuple(state.inventory), state.pos, state.dir)\n\n  initial_craft_state_key = _get_state_key(initial_craft_state)\n\n  # Queue for Breadth-First Search (BFS).\n  # Each element is a tuple: (current_CraftState, current_state_key, current_depth).\n  # We track `current_depth` explicitly to efficiently check against `max_search_depth`\n  # without re-calculating path length, and `current_state_key` to avoid re-hashing.\n  queue = collections.deque([(initial_craft_state, initial_craft_state_key, 0)])\n\n  # Dictionary to store the path taken to reach each state.\n  # path_map[state_key] = (parent_state_key, action_from_parent_to_current)\n  # This allows reconstructing the sequence of actions efficiently by backtracking\n  # from the goal state, avoiding repeated list concatenations during BFS exploration.\n  path_map = {initial_craft_state_key: (None, None)} # The initial state has no parent or incoming action\n\n  # Set to store visited state keys.\n  # This prevents revisiting states, which is crucial for preventing infinite loops\n  # in cyclic state spaces and finding the shortest path in BFS.\n  visited = {initial_craft_state_key}\n\n  # Maximum depth to search. This limits the number of actions in a potential solution path.\n  # It prevents excessively long runtimes for complex or potentially unsolvable goals.\n  max_search_depth = 75\n\n  while queue:\n    current_state, current_state_key, current_depth = queue.popleft()\n\n    # Check if the goal item is present in the current state's inventory.\n    if current_state.satisfies(None, item):\n      # Goal reached! Reconstruct the path by backtracking through `path_map`.\n      actions = []\n      temp_key = current_state_key\n      # Traverse back from the current state to the initial state (where parent_key is None)\n      while path_map[temp_key][0] is not None:\n        parent_key, action_taken = path_map[temp_key]\n        actions.append(action_taken)\n        temp_key = parent_key\n      # The actions are collected in reverse order, so reverse them to get the correct sequence.\n      return actions[::-1]\n\n    # If the current path length exceeds the maximum allowed search depth,\n    # prune this branch to limit computational cost.\n    if current_depth >= max_search_depth:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in ACTIONS:\n      # `current_state.step(action)` returns a new `CraftState` instance,\n      # representing the state after applying the action.\n      reward, next_state = current_state.step(action)\n      next_state_key = _get_state_key(next_state)\n\n      # If this new state has not been visited yet, add it to the queue and mark as visited.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        # Store how we reached this `next_state` from the `current_state`.\n        path_map[next_state_key] = (current_state_key, action)\n        # Add the new state, its key, and its depth to the queue for further exploration.\n        queue.append((next_state, next_state_key, current_depth + 1))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted within the specified search depth or is fundamentally impossible.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:54:54.157690", "function_name": "craft", "function_body": "  import collections\n  import heapq\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Reset the environment to a consistent starting state.\n  env.reset(seed=0)\n  initial_craft_state = env._current_state\n\n  # Priority queue for A* search: (f_score, g_score, tie_breaker, current_CraftState, actions_so_far)\n  # f_score = g_score + h_score\n  # g_score = len(actions_so_far)\n  open_set = []\n  tie_breaker_counter = 0 # Used to break ties for states with the same f_score, ensuring stable sort\n\n  # Store the shortest path cost found so far to a state: {state_key: g_score}\n  # This is crucial for A* to re-evaluate paths if a shorter one is found to an already visited state.\n  g_scores = {}\n\n  # Precompute necessary info from world/cookbook for heuristic calculation\n  cookbook = env.world.cookbook\n  # Get the ultimate primitive requirements for the target item ONCE.\n  # This avoids recalculating it for every state in the heuristic and provides domain knowledge.\n  # `primitives_for` returns a dict {primitive_idx: count}.\n  ultimate_primitive_requirements_for_goal = cookbook.primitives_for(item)\n\n  # Define the heuristic function locally within craft_v2 to encapsulate its dependencies.\n  def calculate_heuristic(state, target_item_idx):\n    \"\"\"\n    Calculates an admissible heuristic for the A* search.\n    This heuristic estimates the minimum number of *interactions* (USE/pickup actions) needed\n    to reach the goal, based on missing ultimate primitive ingredients.\n    It does NOT account for movement steps, which ensures admissibility (never overestimates).\n    \"\"\"\n    # If the goal is already satisfied in the current state, estimated cost is 0.\n    if state.inventory[target_item_idx] > 0:\n      return 0\n\n    h_score = 0\n    \n    missing_ultimate_primitives_count = 0\n    all_ultimate_primitives_present_in_inventory = True\n    \n    # Iterate through the ultimate primitive requirements for the final goal.\n    for p_idx, p_count_needed in ultimate_primitive_requirements_for_goal.items():\n      if state.inventory[p_idx] < p_count_needed:\n        # Each missing unit of an ultimate primitive requires at least one interaction\n        # (e.g., USE on a tree for wood, or picking up a loose item).\n        missing_ultimate_primitives_count += (p_count_needed - state.inventory[p_idx])\n        all_ultimate_primitives_present_in_inventory = False\n            \n    h_score += missing_ultimate_primitives_count\n    \n    # If `ultimate_primitive_requirements_for_goal` is empty AND the goal is not met,\n    # it implies the goal item itself is a primitive that needs direct acquisition\n    # (i.e., not crafted from other primitives specified in the cookbook).\n    # Example: 'stick' might not have any inputs in `primitives_for` if it's simply found.\n    is_direct_primitive_goal = not ultimate_primitive_requirements_for_goal and not state.inventory[target_item_idx] > 0\n\n    if is_direct_primitive_goal:\n      # If the goal is a direct primitive, and we don't have it, it needs at least one step (pickup/USE).\n      h_score += 1 \n    elif all_ultimate_primitives_present_in_inventory:\n      # If all ultimate primitives are gathered, we still need at least one more step for the final crafting.\n      # This covers cases where the item is crafted from multiple ingredients.\n      h_score += 1 \n        \n    return h_score\n\n  # Initial state setup for A*\n  initial_g_score = 0 # Cost from start to initial state is 0\n  # Calculate initial f_score using the heuristic\n  initial_h_score = calculate_heuristic(initial_craft_state, item)\n  initial_f_score = initial_g_score + initial_h_score\n\n  # Create a hashable key for the initial state for tracking visited states and their costs.\n  initial_state_key = (initial_craft_state.grid.tobytes(), tuple(initial_craft_state.inventory),\n                       initial_craft_state.pos, initial_craft_state.dir)\n\n  # Push initial state to the priority queue\n  heapq.heappush(open_set, (initial_f_score, initial_g_score, tie_breaker_counter, initial_craft_state, []))\n  g_scores[initial_state_key] = initial_g_score # Record the cost to reach this state\n  tie_breaker_counter += 1 # Increment for unique tie-breaking\n\n  max_search_depth = 75 # Maximum depth to search, to prevent excessively long runtimes\n\n  while open_set:\n    # Pop the state with the lowest f_score (estimated total cost) from the priority queue.\n    current_f_score, current_g_score, _, current_state, actions_so_far = heapq.heappop(open_set)\n\n    # If the goal is satisfied in the current state, we've found the shortest path\n    # because A* with an admissible heuristic guarantees optimality.\n    if current_state.satisfies(None, item):\n      return actions_so_far\n\n    # If the current path length exceeds the maximum allowed search depth, prune this branch.\n    if current_g_score >= max_search_depth:\n      continue\n\n    # Retrieve current state key to check against g_scores.\n    current_state_key = (current_state.grid.tobytes(), tuple(current_state.inventory),\n                         current_state.pos, current_state.dir)\n    \n    # If we have found a shorter path to this state previously and already processed it, skip this one.\n    # This check is vital for A* correctness and efficiency, preventing redundant work.\n    if current_state_key in g_scores and current_g_score > g_scores[current_state_key]:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in ACTIONS:\n      # Calculate tentative g_score for the next state (each action costs 1 step).\n      tentative_g_score = current_g_score + 1 \n\n      # Get the next state. `CraftState.step` always returns a new `CraftState` instance,\n      # which is crucial for search algorithms to explore distinct states.\n      reward, next_state = current_state.step(action)\n      \n      # Create a hashable key for the next state.\n      next_state_key = (next_state.grid.tobytes(), tuple(next_state.inventory),\n                        next_state.pos, next_state.dir)\n\n      # If this path to `next_state` is better (shorter) than any previously found path to `next_state`\n      if next_state_key not in g_scores or tentative_g_score < g_scores[next_state_key]:\n        g_scores[next_state_key] = tentative_g_score # Record the new shortest g_score to this state\n        h_score = calculate_heuristic(next_state, item) # Calculate heuristic for the next state\n        f_score = tentative_g_score + h_score # Calculate f_score (estimated total cost)\n            \n        tie_breaker_counter += 1 # Increment for unique tie-breaking in heapq\n        # Push the next state into the priority queue.\n        heapq.heappush(open_set, (f_score, tentative_g_score, tie_breaker_counter, next_state, actions_so_far + [action]))\n\n  # If the open_set becomes empty and the goal was not found, it means the item\n  # cannot be crafted within the specified search depth or is fundamentally impossible.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:55:45.347665", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    \"\"\"\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  # Get the initial state of the environment.\n  initial_state = env._current_state\n\n  # Check if the desired item is already present in the inventory.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple:\n  # (current_CraftState, current_path_length, simplified_parent_state_tuple, action_from_parent)\n  # Storing path length here allows for easy application of MAX_PLAN_STEPS.\n  # Storing parent pointers and actions allows for efficient path reconstruction at the end,\n  # avoiding costly list concatenations in the main BFS loop.\n  q = collections.deque()\n  q.append((initial_state, 0, None, None))\n\n  # `visited_paths` acts as both the visited set and the path reconstruction map.\n  # It maps `simplified_state_tuple` -> (path_length_to_this_state, simplified_parent_state_tuple, action_from_parent)\n  initial_simplified = _get_simplified_state_tuple(initial_state)\n  visited_paths = { initial_simplified: (0, None, None) }\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  MAX_PLAN_STEPS = 200        # Maximum length of action sequence to consider.\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  explored_nodes_count = 0\n  goal_simplified_state = None # To store the simplified state of the goal when found\n\n  # Perform BFS\n  while q and explored_nodes_count < MAX_EXPLORED_NODES:\n    current_state, current_path_length, parent_simplified, action_to_current = q.popleft()\n    current_simplified = _get_simplified_state_tuple(current_state)\n    explored_nodes_count += 1\n\n    # If the path to the current state is already at or beyond the maximum allowed length,\n    # do not explore its children. This prunes overly long paths.\n    if current_path_length >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # `current_state.step(action)` returns (reward, new_state).\n      # The reward is always 0.0 in this environment implementation.\n      _, next_state = current_state.step(action)\n\n      # Get the simplified hashable representation of the next state.\n      next_simplified = _get_simplified_state_tuple(next_state)\n      new_path_length = current_path_length + 1\n\n      # If this simplified state has not been visited before:\n      if next_simplified not in visited_paths:\n        # Mark as visited and store the information needed to reconstruct the path:\n        # the path length to this state, its parent, and the action taken to reach it.\n        visited_paths[next_simplified] = (new_path_length, current_simplified, action)\n        q.append((next_state, new_path_length, current_simplified, action))\n\n        # Check if the goal is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          goal_simplified_state = next_simplified # Store the goal state for path reconstruction\n          break # Goal reached, break from inner loop (action exploration)\n\n    if goal_simplified_state is not None:\n      break # Goal found, break from outer loop (BFS)\n\n  # If the goal was found, reconstruct the path.\n  if goal_simplified_state is not None:\n    path = []\n    current_trace_state = goal_simplified_state\n    # Reconstruct path by following parent pointers backwards from the goal state\n    # until the initial state (which has None as its parent action).\n    while visited_paths[current_trace_state][2] is not None: # Check if `action_from_parent` is not None\n      # Get (path_length, parent_state, action_from_parent) for current_trace_state\n      _, parent_state, action_from_parent = visited_paths[current_trace_state]\n      path.append(action_from_parent)\n      current_trace_state = parent_state\n    \n    return list(reversed(path)) # Path was built backwards, so reverse it to get the correct order.\n  \n  # If the loop finishes without finding a path (queue empty or limits reached),\n  # it means the item cannot be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:55:47.596848", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    \"\"\"\n    # Convert numpy array inventory to a tuple for hashability.\n    return (state.pos, state.dir, tuple(state.inventory.tolist()))\n\n  def _reconstruct_path(target_state_tuple, initial_state_tuple, parent_map):\n    \"\"\"\n    Reconstructs the path of actions from the initial state to the target state\n    using the parent_map.\n    \"\"\"\n    path = []\n    current_tuple = target_state_tuple\n    while current_tuple != initial_state_tuple:\n      parent_tuple, action = parent_map[current_tuple]\n      path.append(action)\n      current_tuple = parent_tuple\n    path.reverse() # Path was built backwards, so reverse it.\n    return path\n\n  # Get the initial state of the environment.\n  initial_state = env._current_state\n  initial_state_simplified = _get_simplified_state_tuple(initial_state)\n\n  # Check if the desired item is already present in the inventory.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, current_state_simplified_tuple).\n  q = collections.deque()\n  q.append((initial_state, initial_state_simplified))\n\n  # Initialize a dictionary to keep track of visited states and their parent.\n  # `parent_map[state_tuple]` stores `(parent_state_tuple, action_taken_to_reach_state)`.\n  parent_map = {initial_state_simplified: (None, None)} # Initial state has no parent.\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  MAX_PLAN_STEPS = 200        # Maximum length of action sequence to consider.\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  explored_nodes_count = 0\n\n  # Perform BFS\n  while q and explored_nodes_count < MAX_EXPLORED_NODES:\n    current_state, current_state_simplified = q.popleft()\n    explored_nodes_count += 1\n\n    # Check if the current path (implicitly derived from parent_map) exceeds max steps.\n    # This is an approximation and might be slightly off if path reconstruction is expensive,\n    # but it prevents exploring excessively deep paths.\n    if len(_reconstruct_path(current_state_simplified, initial_state_simplified, parent_map)) >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # `current_state.step(action)` returns (reward, new_state).\n      # The reward is always 0.0 in this environment implementation.\n      _, next_state = current_state.step(action)\n\n      # Get the simplified hashable representation of the next state.\n      next_state_simplified = _get_simplified_state_tuple(next_state)\n\n      # If this simplified state has not been visited before:\n      if next_state_simplified not in parent_map:\n        parent_map[next_state_simplified] = (current_state_simplified, action) # Store parent and action.\n\n        # Check if the goal is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          return _reconstruct_path(next_state_simplified, initial_state_simplified, parent_map) # Goal reached.\n\n        # Add the new state to the queue for future exploration.\n        q.append((next_state, next_state_simplified))\n\n  # If the loop finishes without finding a path (queue empty or limits reached),\n  # it means the item cannot be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:57:03.702694", "function_name": "craft", "function_body": "  import collections\n  import numpy as np # Ensure numpy is available for array operations\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    This version includes agent's position, direction, inventory, and\n    a hashable representation of the egocentric grid view.\n    Including the egocentric grid view is crucial for correctness in grid worlds\n    where local environment changes (e.g., resources depleting, workshops becoming active)\n    affect available actions or their outcomes.\n    \"\"\"\n    # Get the egocentric grid view. This will use the CraftState's internal\n    # cache if features have already been computed for this state.\n    features_dict = state.features_dict()\n    features_ego = features_dict['features_ego'] # This is a numpy.ndarray\n\n    # Convert the numpy array egocentric view to a hashable tuple.\n    # It's assumed features_ego is a view of the grid, potentially 3D (H, W, Kinds).\n    # Flattening it and converting to a tuple makes it hashable for set/dict keys.\n    ego_grid_tuple = tuple(features_ego.flatten())\n\n    # Combine all relevant state components into a single hashable tuple.\n    # The order of elements in the tuple matters for consistency.\n    return (state.pos, state.dir, tuple(state.inventory), ego_grid_tuple)\n\n  # Get the initial state of the environment.\n  initial_state = env._current_state\n\n  # Check if the desired item is already present in the inventory.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple:\n  # (current_CraftState, current_path_length, simplified_parent_state_tuple, action_from_parent)\n  q = collections.deque()\n  q.append((initial_state, 0, None, None))\n\n  # `visited_paths` acts as both the visited set and the path reconstruction map.\n  # It maps `simplified_state_tuple` -> (path_length_to_this_state, simplified_parent_state_tuple, action_from_parent)\n  initial_simplified = _get_simplified_state_tuple(initial_state)\n  visited_paths = { initial_simplified: (0, None, None) }\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  MAX_PLAN_STEPS = 200        # Maximum length of action sequence to consider.\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  explored_nodes_count = 0\n  goal_simplified_state = None # To store the simplified state of the goal when found\n\n  # Perform BFS\n  while q and explored_nodes_count < MAX_EXPLORED_NODES:\n    current_state, current_path_length, parent_simplified, action_to_current = q.popleft()\n    current_simplified = _get_simplified_state_tuple(current_state) # Re-get simplified for safety/consistency, though should be current_simplified in q\n    explored_nodes_count += 1\n\n    # If the path to the current state is already at or beyond the maximum allowed length,\n    # do not explore its children. This prunes overly long paths.\n    if current_path_length >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # `current_state.step(action)` returns (reward, new_state).\n      # The reward is always 0.0 in this environment implementation.\n      _, next_state = current_state.step(action)\n\n      # Get the simplified hashable representation of the next state.\n      next_simplified = _get_simplified_state_tuple(next_state)\n      new_path_length = current_path_length + 1\n\n      # If this simplified state has not been visited before (or found a shorter path):\n      # The visited_paths logic ensures we always store the shortest path found to a state.\n      if next_simplified not in visited_paths or new_path_length < visited_paths[next_simplified][0]:\n        # Mark as visited and store the information needed to reconstruct the path:\n        # the path length to this state, its parent, and the action taken to reach it.\n        visited_paths[next_simplified] = (new_path_length, current_simplified, action)\n        \n        # Add to queue only if it's a new state or a shorter path to an existing state.\n        # If it's a shorter path, it means we might revisit states, but it guarantees optimality\n        # in unweighted graphs if path length is the primary metric.\n        # For BFS, just checking `not in visited_paths` is sufficient for optimality,\n        # but re-adding with a shorter path could be useful in algorithms like Dijkstra.\n        # For pure BFS, we only add if not already visited.\n        if next_simplified not in visited_paths: # Check again after potentially updating in the previous line\n          q.append((next_state, new_path_length, current_simplified, action))\n        else: # If it's a shorter path to an already visited node, re-add to queue to explore from there\n              # This part is more typical for Dijkstra's, not strict BFS for unweighted graphs.\n              # For unweighted BFS, `if next_simplified not in visited_paths` is sufficient.\n              # Let's stick to strict BFS logic where we only add if not previously encountered.\n              pass # No action needed if already visited, as BFS guarantees first path found is shortest.\n\n\n        # Check if the goal is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          goal_simplified_state = next_simplified # Store the goal state for path reconstruction\n          break # Goal reached, break from inner loop (action exploration)\n\n    if goal_simplified_state is not None:\n      break # Goal found, break from outer loop (BFS)\n\n  # If the goal was found, reconstruct the path.\n  if goal_simplified_state is not None:\n    path = []\n    current_trace_state = goal_simplified_state\n    # Reconstruct path by following parent pointers backwards from the goal state\n    # until the initial state (which has None as its parent action).\n    # The parent_action is at index 2 of the tuple stored in visited_paths.\n    while visited_paths[current_trace_state][2] is not None:\n      # Get (path_length, parent_state, action_from_parent) for current_trace_state\n      _, parent_state, action_from_parent = visited_paths[current_trace_state]\n      path.append(action_from_parent)\n      current_trace_state = parent_state\n    \n    return list(reversed(path)) # Path was built backwards, so reverse it to get the correct order.\n  \n  # If the loop finishes without finding a path (queue empty or limits reached),\n  # it means the item cannot be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T00:57:06.120596", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    \"\"\"\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  # Get the initial state of the environment.\n  initial_state = env._current_state\n\n  # Check if the desired item is already present in the inventory.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple:\n  # (current_CraftState, current_path_length, simplified_parent_state_tuple, action_from_parent)\n  # Storing path length here allows for easy application of MAX_PLAN_STEPS.\n  # Storing parent pointers and actions allows for efficient path reconstruction at the end,\n  # avoiding costly list concatenations in the main BFS loop.\n  q = collections.deque()\n  q.append((initial_state, 0, None, None))\n\n  # `visited_paths` acts as both the visited set and the path reconstruction map.\n  # It maps `simplified_state_tuple` -> (path_length_to_this_state, simplified_parent_state_tuple, action_from_parent)\n  initial_simplified = _get_simplified_state_tuple(initial_state)\n  visited_paths = { initial_simplified: (0, None, None) }\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  # For craft_v2, the maximum plan steps are capped by the environment's own max_steps,\n  # ensuring that the generated plan does not exceed the episode limit.\n  # A default value is provided if env.max_steps is not available or non-positive.\n  MAX_PLAN_STEPS = getattr(env, 'max_steps', 200)\n  if MAX_PLAN_STEPS <= 0: # Ensure MAX_PLAN_STEPS is positive\n      MAX_PLAN_STEPS = 200\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  explored_nodes_count = 0\n  goal_simplified_state = None # To store the simplified state of the goal when found\n\n  # Perform BFS\n  while q and explored_nodes_count < MAX_EXPLORED_NODES:\n    current_state, current_path_length, parent_simplified, action_to_current = q.popleft()\n    current_simplified = _get_simplified_state_tuple(current_state)\n    explored_nodes_count += 1\n\n    # If the path to the current state is already at or beyond the maximum allowed length,\n    # do not explore its children. This prunes overly long paths.\n    if current_path_length >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # `current_state.step(action)` returns (reward, new_state).\n      # The reward is always 0.0 in this environment implementation.\n      _, next_state = current_state.step(action)\n\n      # Get the simplified hashable representation of the next state.\n      next_simplified = _get_simplified_state_tuple(next_state)\n      new_path_length = current_path_length + 1\n\n      # If this simplified state has not been visited before:\n      if next_simplified not in visited_paths:\n        # Mark as visited and store the information needed to reconstruct the path:\n        # the path length to this state, its parent, and the action taken to reach it.\n        visited_paths[next_simplified] = (new_path_length, current_simplified, action)\n        q.append((next_state, new_path_length, current_simplified, action))\n\n        # Check if the goal is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          goal_simplified_state = next_simplified # Store the goal state for path reconstruction\n          break # Goal reached, break from inner loop (action exploration)\n\n    if goal_simplified_state is not None:\n      break # Goal found, break from outer loop (BFS)\n\n  # If the goal was found, reconstruct the path.\n  if goal_simplified_state is not None:\n    path = []\n    current_trace_state = goal_simplified_state\n    # Reconstruct path by following parent pointers backwards from the goal state\n    # until the initial state (which has None as its parent action).\n    while visited_paths[current_trace_state][2] is not None: # Check if `action_from_parent` is not None\n      # Get (path_length, parent_state, action_from_parent) for current_trace_state\n      _, parent_state, action_from_parent = visited_paths[current_trace_state]\n      path.append(action_from_parent)\n      current_trace_state = parent_state\n    \n    return list(reversed(path)) # Path was built backwards, so reverse it to get the correct order.\n  \n  # If the loop finishes without finding a path (queue empty or limits reached),\n  # it means the item cannot be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:58:11.948161", "function_name": "craft", "function_body": "  # Ensure collections is imported at the top level, alongside numpy.\n  import collections\n\n  start_state = env._current_state\n  \n  # Check if the goal is already satisfied in the initial state.\n  if start_state.satisfies(None, item):\n      return []\n\n  # Define all possible actions. Assuming standard integer mapping.\n  # CraftLab.action_specs() provides: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTIONS = [0, 1, 2, 3, 4] \n\n  # Helper function to create a hashable key for a CraftState.\n  # This is crucial for storing states in a set to detect visited states.\n  def _get_state_key(state):\n      # numpy arrays are not hashable, convert to bytes or tuple.\n      # grid.tobytes() provides a compact representation.\n      # inventory (numpy array) converted to tuple.\n      return (state.grid.tobytes(), tuple(state.inventory), state.pos, state.dir)\n\n  # Initialize the queue for Breadth-First Search (BFS).\n  # Each element in the queue is (current_craft_state, state_key).\n  queue = collections.deque()\n  \n  start_key = _get_state_key(start_state)\n  queue.append((start_state, start_key))\n\n  # 'visited' set stores state keys to prevent redundant exploration and cycles.\n  visited = {start_key}\n  \n  # 'parent_map' stores information to reconstruct the path once the goal is found.\n  # It maps state_key -> (parent_state_key, action_taken_from_parent_to_reach_this_state).\n  parent_map = {start_key: (None, None)} # Start state has no parent.\n\n  # Perform BFS.\n  while queue:\n      current_state, current_key = queue.popleft()\n\n      # Try all possible actions from the current state.\n      for action in ACTIONS:\n          # Simulate taking the action.\n          # CraftState.step returns (reward, new_state). Reward is always 0.0 here.\n          _reward, new_state = current_state.step(action)\n          \n          new_key = _get_state_key(new_state)\n\n          # If this new state has already been visited, skip it.\n          if new_key in visited:\n              continue\n\n          # Mark the new state as visited and record its parent and the action taken.\n          visited.add(new_key)\n          parent_map[new_key] = (current_key, action)\n\n          # Check if the goal is satisfied in the new state.\n          if new_state.satisfies(None, item):\n              # Goal reached! Reconstruct the path by backtracking from the new_key.\n              path = []\n              trace_key = new_key\n              while parent_map[trace_key][0] is not None: # Backtrack until the start state.\n                  parent_key, action_taken = parent_map[trace_key]\n                  path.append(action_taken)\n                  trace_key = parent_key\n              return path[::-1] # Reverse the path to get actions from start to goal.\n\n          # Add the new state to the queue for further exploration.\n          queue.append((new_state, new_key))\n\n  # If the queue becomes empty and the goal was not found, it means the item cannot be crafted.\n  return []", "island_id": 8, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:58:12.951630", "function_name": "craft", "function_body": "  import collections # Assuming collections is available, usually imported at module level\n  \n  # Start with the current state of the environment.\n  # The CraftLab's current state is stored in _current_state.\n  start_state = env._current_state\n\n  # Check if the item is already present in the initial state.\n  if start_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Queue for Breadth-First Search (BFS): stores (CraftState_object, list_of_actions_to_reach_this_state)\n  # collections.deque provides efficient appends and pops from both ends.\n  q = collections.deque([(start_state, [])])\n\n  # Visited set to keep track of states already explored.\n  # This prevents cycles and redundant computations, ensuring the shortest path is found.\n  # A state is defined by its grid layout, inventory, agent position, and direction.\n  # Since numpy arrays (grid, inventory) are not hashable, we convert them to bytes.\n  visited = set()\n  \n  def _get_state_key(state):\n    \"\"\"Generates a hashable tuple representing the unique identity of a CraftState.\"\"\"\n    return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  visited.add(_get_state_key(start_state))\n\n  # Define the set of all possible actions.\n  # Assuming env_factory.Action is an enum or class accessible from the module scope\n  # with attributes like DOWN, UP, LEFT, RIGHT, USE and an iterable 'ALL'.\n  actions = env_factory.Action.ALL \n\n  # BFS loop\n  while q:\n    current_state, current_path = q.popleft()\n\n    # Explore all possible actions from the current state\n    for action in actions:\n      # Apply the action to get the next state.\n      # CraftState.step returns (reward, new_state), but reward is always 0.0 for this class.\n      _, next_state = current_state.step(action)\n      next_path = current_path + [action]\n\n      # Check if the goal (desired item) is satisfied in the new state\n      if next_state.satisfies(None, item):\n        return next_path # Goal reached! Return the sequence of actions.\n\n      # Get the hashable key for the next state\n      next_state_key = _get_state_key(next_state)\n\n      # If this new state has not been visited before, add it to the queue and visited set\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        q.append((next_state, next_path))\n\n  # If the queue becomes empty and the goal was never reached, it means the item\n  # cannot be crafted from the current state within the reachable state space.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:00:59.760593", "function_name": "craft", "function_body": "    actions = []\n\n    # Define action constants, as direct import of env_factory is restricted.\n    _ACTIONS_DOWN = 0\n    _ACTIONS_UP = 1\n    _ACTIONS_LEFT = 2\n    _ACTIONS_RIGHT = 3\n    _ACTIONS_USE = 4\n\n    # Helper function for simple Manhattan pathfinding.\n    # Assumes no obstacles. Moves horizontally then vertically.\n    def _get_path_actions_simple(start_pos, target_pos):\n        path = []\n        curr_r, curr_c = start_pos\n        target_r, target_c = target_pos\n\n        # Move horizontally\n        while curr_c < target_c:\n            path.append(_ACTIONS_RIGHT)\n            curr_c += 1\n        while curr_c > target_c:\n            path.append(_ACTIONS_LEFT)\n            curr_c -= 1\n\n        # Move vertically\n        while curr_r < target_r:\n            path.append(_ACTIONS_DOWN)\n            curr_r += 1\n        while curr_r > target_r:\n            path.append(_ACTIONS_UP)\n            curr_r -= 1\n        return path\n\n    # Helper function to find path to an adjacent cell for 'USE' action.\n    def _get_path_to_adjacent_actions(start_pos, target_item_pos, grid_shape):\n        curr_r, curr_c = start_pos\n        target_r, target_c = target_item_pos\n\n        # Find valid adjacent cells\n        adj_candidates = []\n        # Up\n        if target_r > 0: adj_candidates.append((target_r - 1, target_c))\n        # Down\n        if target_r < grid_shape[0] - 1: adj_candidates.append((target_r + 1, target_c))\n        # Left\n        if target_c > 0: adj_candidates.append((target_r, target_c - 1))\n        # Right\n        if target_c < grid_shape[1] - 1: adj_candidates.append((target_r, target_c + 1))\n\n        best_adj_pos = None\n        min_dist = float('inf')\n\n        # Choose the closest valid adjacent cell\n        for adj_r, adj_c in adj_candidates:\n            dist = abs(curr_r - adj_r) + abs(curr_c - adj_c)\n            if dist < min_dist:\n                min_dist = dist\n                best_adj_pos = (adj_r, adj_c)\n\n        if best_adj_pos:\n            return _get_path_actions_simple(start_pos, best_adj_pos)\n        return [] # No adjacent position found (e.g., single-cell map or surrounded)\n\n\n    # Start with a deep copy of the current environment state for simulation\n    initial_state = env._current_state\n    # Manually copy CraftState attributes as it might not have a .copy() method\n    current_state_sim = type(initial_state)(\n        scenario=initial_state.scenario,\n        grid=np.copy(initial_state.grid),\n        pos=initial_state.pos,\n        dir=initial_state.dir,\n        inventory=np.copy(initial_state.inventory)\n    )\n\n    # 1. Check if the item is already in the simulated inventory\n    if current_state_sim.inventory[item] > 0:\n        return actions # Already have it, no actions needed.\n\n    # 2. Get the recipe for the item\n    recipe = env.world.cookbook.recipes.get(item)\n\n    if not recipe:\n        # If no recipe, it must be a primitive (can be picked up) or uncraftable.\n        if item in env.world.cookbook.primitives:\n            # It's a primitive. Need to find it on the grid and pick it up.\n            target_kind_index = item\n            found_pos = None\n            # Iterate through the grid to find the primitive's location\n            for r in range(current_state_sim.grid.shape[0]):\n                for c in range(current_state_sim.grid.shape[1]):\n                    if current_state_sim.grid[r, c, target_kind_index] > 0:\n                        found_pos = (r, c)\n                        break\n                if found_pos:\n                    break\n\n            if found_pos:\n                # Pathfind to an adjacent cell of the primitive\n                path_to_primitive_actions = _get_path_to_adjacent_actions(\n                    current_state_sim.pos, found_pos, current_state_sim.grid.shape)\n                actions.extend(path_to_primitive_actions)\n\n                # Simulate these movement actions\n                for action in path_to_primitive_actions:\n                    _, current_state_sim = current_state_sim.step(action)\n\n                # Check if agent is now next to the primitive\n                if current_state_sim.next_to(target_kind_index):\n                    actions.append(_ACTIONS_USE)\n                    _, current_state_sim = current_state_sim.step(_ACTIONS_USE)\n                    if current_state_sim.inventory[item] > 0: # Verify pickup\n                        return actions\n                return [] # Failed to pick up primitive (not next to it or USE failed)\n            else:\n                return [] # Primitive not found on the grid\n        else:\n            return [] # Not a primitive and no recipe, thus uncraftable by this method.\n\n    # 3. Item has a recipe. Process ingredients and workshop.\n    ingredients_needed = {}\n    workshop_key = None\n    for key, count in recipe.items():\n        if isinstance(key, int): # It's an ingredient's index\n            ingredients_needed[key] = count\n        elif key.startswith(\"_\"): # It's a workshop key (e.g., \"_workbench\")\n            workshop_key = key\n\n    # Recursively gather all required ingredients\n    for ingredient_idx, required_count in ingredients_needed.items():\n        current_count = current_state_sim.inventory[ingredient_idx]\n        # Only craft if we don't have enough\n        for _ in range(required_count - current_count):\n            # Recursive call to craft the ingredient\n            ingredient_plan = craft_v2(env, ingredient_idx)\n            if not ingredient_plan:\n                return [] # Failed to plan for an ingredient\n\n            actions.extend(ingredient_plan)\n            # Simulate the ingredient's crafting actions on our current_state_sim\n            # This is crucial so that subsequent ingredient checks/crafting use the updated inventory/position.\n            for action in ingredient_plan:\n                _, current_state_sim = current_state_sim.step(action)\n\n        # After attempting to get the ingredient, check if we have enough\n        if current_state_sim.inventory[ingredient_idx] < required_count:\n            return [] # Failed to acquire required amount of ingredient\n\n    # All ingredients are gathered. Now, handle the workshop if required.\n    if workshop_key:\n        workshop_idx = env.world.cookbook.index.contents.get(workshop_key)\n        if workshop_idx is None:\n            return [] # Workshop key not found in cookbook index. Indicates an issue with recipes or data.\n\n        # Find the workshop's location on the grid\n        workshop_pos = None\n        for r in range(current_state_sim.grid.shape[0]):\n            for c in range(current_state_sim.grid.shape[1]):\n                if current_state_sim.grid[r, c, workshop_idx] > 0:\n                    workshop_pos = (r, c)\n                    break\n            if workshop_pos:\n                break\n\n        if workshop_pos:\n            # Pathfind to an adjacent cell of the workshop\n            path_to_workshop_actions = _get_path_to_adjacent_actions(\n                current_state_sim.pos, workshop_pos, current_state_sim.grid.shape)\n            actions.extend(path_to_workshop_actions)\n\n            # Simulate movement to the workshop\n            for action in path_to_workshop_actions:\n                _, current_state_sim = current_state_sim.step(action)\n\n            # Check if agent is now next to the workshop and use it\n            if current_state_sim.next_to(workshop_idx):\n                actions.append(_ACTIONS_USE)\n                _, current_state_sim = current_state_sim.step(_ACTIONS_USE)\n                if current_state_sim.inventory[item] > 0: # Verify final craft\n                    return actions\n            return [] # Failed to use workshop or craft the item\n        else:\n            return [] # Workshop not found on the grid\n    else:\n        # No specific workshop key in the recipe.\n        # Assume item is implicitly crafted once all ingredients are gathered\n        # (i.e., no additional USE action or movement to a specific workshop is needed).\n        if current_state_sim.inventory[item] > 0:\n            return actions\n        else:\n            # This case implies an unhandled scenario where the item has ingredients but\n            # no explicit workshop, and it did not appear in inventory after gathering ingredients.\n            return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:01:00.774873", "function_name": "craft", "function_body": "", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:02:38.021542", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # A heuristic maximum plan length to prevent extremely long or infinite searches.\n    # This value might need tuning based on typical problem complexity and grid size.\n    MAX_PLAN_LENGTH = 1000 \n\n    def _find_path_to_kind(start_state, target_kind_index, current_total_plan_len_so_far, max_allowed_path_len):\n        \"\"\"\n        Finds a path (sequence of movement actions) from `start_state` to a cell \n        *next to* `target_kind_index` or containing it.\n        Returns (path_actions, end_state) or (None, None).\n        \n        Args:\n            start_state (CraftState): The state from which to start the search.\n            target_kind_index (int): The index of the entity kind to find.\n            current_total_plan_len_so_far (int): Length of actions already accumulated in the higher-level plan.\n            max_allowed_path_len (int): Maximum steps allowed for this specific pathfinding sub-problem.\n        \"\"\"\n        queue = collections.deque([(start_state, [])]) # (CraftState, list_of_actions_to_reach_this_state)\n        # Visited set to avoid infinite loops: (position, direction, inventory_tuple).\n        # Inventory changes can open/close paths, so including it in the state hash is crucial.\n        visited = set([(start_state.pos, start_state.dir, tuple(start_state.inventory))])\n\n        while queue:\n            current_s, actions_to_current_s = queue.popleft()\n\n            # Check if this sub-path itself is too long\n            if len(actions_to_current_s) > max_allowed_path_len:\n                continue \n            # Check if this path combined with existing plan would exceed the global max\n            if current_total_plan_len_so_far + len(actions_to_current_s) > MAX_PLAN_LENGTH:\n                continue \n\n            # Check if `current_s` is next to the target kind\n            if current_s.next_to(target_kind_index):\n                return actions_to_current_s, current_s\n\n            # Explore possible next states (movement actions)\n            for action in [env_factory.DOWN, env_factory.UP, env_factory.LEFT, env_factory.RIGHT]:\n                # Simulate the step without modifying the original environment\n                _reward, next_s = current_s.step(action)\n                \n                # Create a hashable representation of the next state for visited set\n                next_state_tuple = (next_s.pos, next_s.dir, tuple(next_s.inventory))\n\n                if next_state_tuple not in visited:\n                    visited.add(next_state_tuple)\n                    queue.append((next_s, actions_to_current_s + [action]))\n        return None, None # Path not found within limits\n\n    def _plan_craft_recursive(current_state_in_plan, goal_item_index, current_plan_actions_list):\n        \"\"\"\n        Recursively plans actions to craft `goal_item_index`.\n        \n        Args:\n            current_state_in_plan (CraftState): The current state of the world (grid, inventory, etc.) \n                                               after applying `current_plan_actions_list`.\n            goal_item_index (int): The integer ID of the item to craft.\n            current_plan_actions_list (list[int]): List of actions accumulated so far to reach `current_state_in_plan`.\n                                                  Used for total plan length checking.\n                                                  \n        Returns:\n            (list[int], CraftState) or (None, None): A tuple of (actions, final_state) if successful,\n                                                     otherwise (None, None).\n        \"\"\"\n        \n        # Base case 1: Already have the item in inventory\n        if current_state_in_plan.inventory[goal_item_index] > 0:\n            return [], current_state_in_plan # No actions needed for this item at this point\n\n        # Check total plan length to prevent excessive recursion or extremely long plans\n        if len(current_plan_actions_list) > MAX_PLAN_LENGTH:\n            return None, None\n\n        recipe = cookbook.recipes.get(goal_item_index)\n\n        # Base case 2: No recipe for this item. It must be a primitive to be collected.\n        if not recipe:\n            # Check if it's a grabbable primitive (can be picked up)\n            if goal_item_index in world.grabbable_indices:\n                # Find path to the item's location and collect it\n                path_to_item_actions, state_after_move = _find_path_to_kind(\n                    current_state_in_plan, \n                    goal_item_index, \n                    len(current_plan_actions_list), \n                    MAX_PLAN_LENGTH - len(current_plan_actions_list) # Max steps for this specific path\n                )\n                \n                if path_to_item_actions is None:\n                    return None, None # Cannot reach the item\n\n                # Simulate the USE action after reaching the item\n                _reward, state_after_pickup = state_after_move.step(env_factory.USE)\n                \n                # Verify if the item was actually picked up\n                if state_after_pickup.inventory[goal_item_index] > state_after_move.inventory[goal_item_index]:\n                    return path_to_item_actions + [env_factory.USE], state_after_pickup\n                else:\n                    return None, None # USE action did not result in pickup (e.g., already picked up, or not pickable this way)\n            else:\n                # Item is not craftable and not grabbable (e.g., 'water' which is next_to but not in inventory).\n                # If a recipe requires \"being next to\" such an item, it's typically handled via the \"_key\" in the recipe,\n                # not by trying to put it into inventory.\n                return None, None \n\n        # Recursive step: Collect ingredients for the recipe\n        actions_for_ingredients = []\n        # Create a working copy of the state for simulating ingredient collection\n        current_state_for_recipe = current_state_in_plan \n        \n        # Prepare ingredients for processing. Prioritize items already in inventory, then grabbables, then craftables.\n        ingredient_items_to_process = []\n        for ing_idx, count in recipe.items():\n            if ing_idx == \"_key\":\n                continue # Workshop key handled separately\n            ingredient_items_to_process.append((ing_idx, count))\n        \n        # Sort ingredients:\n        # 0: Already have enough of this ingredient\n        # 1: Grabbable primitive (can be picked up)\n        # 2: Craftable item (requires further recursive crafting)\n        ingredient_items_to_process.sort(key=lambda x: (\n            0 if current_state_for_recipe.inventory[x[0]] >= x[1] else (\n            1 if x[0] in world.grabbable_indices else 2\n        )))\n\n        for ingredient_idx, required_count in ingredient_items_to_process:\n            needed_count = required_count - current_state_for_recipe.inventory[ingredient_idx]\n            while needed_count > 0:\n                # Recursively plan actions to get one unit of this ingredient\n                actions_to_get_one_ing, state_after_get_one_ing = _plan_craft_recursive(\n                    current_state_for_recipe, \n                    ingredient_idx, \n                    current_plan_actions_list + actions_for_ingredients # Pass updated plan length\n                )\n                \n                if actions_to_get_one_ing is None:\n                    return None, None # Cannot obtain this ingredient\n\n                # Apply these actions to our temporary working state for this recipe\n                for action in actions_to_get_one_ing:\n                    _reward, next_s = current_state_for_recipe.step(action)\n                    current_state_for_recipe = next_s\n                    actions_for_ingredients.append(action)\n                    \n                    # Check overall plan length during accumulation\n                    if len(current_plan_actions_list) + len(actions_for_ingredients) > MAX_PLAN_LENGTH:\n                        return None, None # Total plan too long\n\n                # Re-evaluate how much more is needed after getting one unit\n                needed_count = required_count - current_state_for_recipe.inventory[ingredient_idx]\n                \n                # Safety break: If we got no actions to get one, but still need more, something is wrong\n                if needed_count > 0 and not actions_to_get_one_ing:\n                    return None, None\n\n        # After collecting all ingredients, handle workshop requirement if any\n        workshop_required = False\n        workshop_kind_index = None\n        if \"_key\" in recipe:\n            # Assumes the \"_key\" value is a string name that can be looked up in the index\n            workshop_kind_name = recipe[\"_key\"]\n            workshop_kind_index = cookbook.index.get(workshop_kind_name)\n            \n            # Verify if this indeed refers to a workshop that agent can interact with (e.g., 'crafting_table')\n            if workshop_kind_index is not None and workshop_kind_index in world.workshop_indices:\n                workshop_required = True\n            else:\n                # If a _key exists but isn't a known workshop, the recipe might be invalid or unusual.\n                # For this problem, we assume _key means workshop.\n                return None, None\n\n        actions_for_crafting_step = []\n        if workshop_required:\n            # If not already next to the required workshop, find a path to it\n            if not current_state_for_recipe.next_to(workshop_kind_index):\n                path_to_workshop_actions, state_at_workshop = _find_path_to_kind(\n                    current_state_for_recipe, \n                    workshop_kind_index, \n                    len(current_plan_actions_list) + len(actions_for_ingredients), \n                    MAX_PLAN_LENGTH - (len(current_plan_actions_list) + len(actions_for_ingredients))\n                )\n                \n                if path_to_workshop_actions is None:\n                    return None, None # Cannot reach the workshop\n                \n                actions_for_crafting_step.extend(path_to_workshop_actions)\n                for action in path_to_workshop_actions:\n                    _reward, next_s = current_state_for_recipe.step(action)\n                    current_state_for_recipe = next_s\n                    \n                    if len(current_plan_actions_list) + len(actions_for_ingredients) + len(actions_for_crafting_step) > MAX_PLAN_LENGTH:\n                        return None, None # Total plan too long\n\n        # Perform the USE action to attempt crafting\n        _reward, state_after_craft = current_state_for_recipe.step(env_factory.USE)\n        actions_for_crafting_step.append(env_factory.USE)\n\n        # Check if crafting was successful (inventory count of goal item increased)\n        if state_after_craft.inventory[goal_item_index] > current_state_for_recipe.inventory[goal_item_index]:\n            final_actions_for_this_goal = actions_for_ingredients + actions_for_crafting_step\n            return final_actions_for_this_goal, state_after_craft\n        else:\n            # Crafting failed (e.g., still missing ingredients, not next to correct station, etc.)\n            return None, None\n\n    # --- Main execution of craft_v2 function ---\n    \n    # Get initial state and world/cookbook references from the environment\n    initial_state = env._current_state\n    cookbook = env.world.cookbook\n    world = env.world \n    \n    # Start the recursive planning process from the initial state with an empty initial plan list\n    total_actions_plan, final_state_after_plan = _plan_craft_recursive(initial_state, item, [])\n    \n    # Validate the generated plan by executing it on a fresh copy of the initial state\n    if total_actions_plan is not None:\n        temp_validation_state = initial_state\n        for action in total_actions_plan:\n            _reward, temp_validation_state = temp_validation_state.step(action)\n            \n        # If the item is in the inventory of the validated state, the plan is good\n        if temp_validation_state.inventory[item] > 0:\n            return total_actions_plan\n        else:\n            # This indicates a discrepancy between simulation during planning and the final result,\n            # or a subtle logical error in the planning. For this problem, return empty in such case.\n            return [] \n    \n    return [] # Return empty list if no valid plan was found", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:02:38.091328", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # Constants for actions based on CraftLab.action_specs()\n    _DOWN = 0\n    _UP = 1\n    _LEFT = 2\n    _RIGHT = 3\n    _USE = 4\n    _ACTIONS = [_DOWN, _UP, _LEFT, _RIGHT, _USE]\n\n    # Helper function defined inside to adhere to \"only return code that will fit in that function\"\n    def _get_state_key(state):\n        \"\"\"Generates a hashable key for a CraftState object.\"\"\"\n        # Using pos, dir, inventory, and a hash of the grid to ensure uniqueness\n        # Hash of grid.tobytes() is standard for numpy arrays\n        return (state.pos, state.dir, tuple(state.inventory), hash(state.grid.tobytes()))\n\n    # Search limits to prevent excessively long computations or memory issues\n    _MAX_SEARCH_STEPS = 200000  # Maximum number of states to explore\n    _MAX_PATH_LENGTH = 75      # Maximum length of action sequence\n\n    initial_state = env._current_state  # Get the initial CraftState object from the environment\n\n    # Queue for Breadth-First Search (BFS): stores (current_state, actions_taken_to_reach_here)\n    queue = collections.deque([(initial_state, [])])\n\n    # Set to store visited states to avoid cycles and redundant computation.\n    # Stores hashable representations of CraftState objects.\n    visited = {_get_state_key(initial_state)}\n\n    nodes_explored = 0\n\n    while queue:\n        current_state, actions_path = queue.popleft()\n        nodes_explored += 1\n\n        # Check if the search has exceeded the maximum allowed exploration steps\n        if nodes_explored > _MAX_SEARCH_STEPS:\n            # print(f\"BFS reached max exploration limit ({_MAX_SEARCH_STEPS}). Goal not found.\")\n            return []  # No path found within limits\n\n        # Check if the current path length has exceeded the maximum allowed\n        if len(actions_path) >= _MAX_PATH_LENGTH:\n            continue  # Skip exploring further from this path\n\n        # Check if the current state satisfies the goal\n        if current_state.satisfies(None, item):\n            # print(f\"Goal reached in {len(actions_path)} steps, explored {nodes_explored} states.\")\n            return actions_path  # Goal found, return the sequence of actions\n\n        # Explore possible next actions\n        for action in _ACTIONS:\n            # Simulate the action to get the next state.\n            # CraftState.step returns (reward, new_state). We only need new_state.\n            _, next_state = current_state.step(action)\n            next_state_key = _get_state_key(next_state)\n\n            # If this next state has not been visited, add it to the queue\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_state, actions_path + [action]))\n\n    # If the queue becomes empty and the goal was not found after exploring all reachable states\n    # print(f\"BFS finished without finding a path to craft item {item}. Explored {nodes_explored} states.\")\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:04:29.595105", "function_name": "craft", "function_body": "  # Reset the environment to get a clean initial state for planning.\n  # This ensures that the planning starts from a known, initial configuration.\n  env.reset() \n  initial_state = env._current_state\n\n  # If the item is already present in the initial inventory, no actions are needed.\n  if initial_state.satisfies(None, item):\n    return []\n\n  # Get all possible actions from the environment's action specifications.\n  # This makes the solution more robust to changes in the action mapping.\n  # Assumes CraftLab.action_specs() returns a dictionary whose values are the action IDs.\n  ALL_ACTIONS = list(env.action_specs().values())\n\n  # Initialize a queue for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_state, list_of_actions_taken_to_reach_this_state).\n  # `collections.deque` is used for efficient append and pop operations.\n  # (Assumes 'collections' module is imported at the top level of the file.)\n  queue = collections.deque([(initial_state, [])])\n\n  # Initialize a set to keep track of visited states.\n  # This prevents infinite loops and redundant exploration of the same state.\n  # Since numpy arrays (grid, inventory) are not hashable, they are converted to bytes.\n  visited = set()\n  \n  # Helper function to create a hashable key for a CraftState.\n  # A state is defined by its grid, inventory, agent's position, and direction.\n  def get_state_key(state):\n      return (state.grid.tobytes(), state.inventory.tobytes(), state.pos, state.dir)\n\n  # Add the initial state to the visited set.\n  visited.add(get_state_key(initial_state))\n\n  # BFS loop: continues as long as there are states to explore in the queue.\n  while queue:\n    current_state, current_actions = queue.popleft() # Get the next state to explore and its path.\n\n    # Iterate over all possible actions from the current state.\n    for action in ALL_ACTIONS:\n      # Apply the action to the current state to get the next state.\n      # CraftState.step returns (reward, new_state). For BFS, we primarily care about the new_state.\n      reward, next_state = current_state.step(action)\n\n      next_state_key = get_state_key(next_state)\n\n      # If this next state has not been visited before, process it.\n      if next_state_key not in visited:\n        visited.add(next_state_key) # Mark it as visited.\n        new_actions_sequence = current_actions + [action] # Extend the path to this new state.\n\n        # Check if the goal item is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          return new_actions_sequence # If goal reached, return the sequence of actions.\n        \n        # If the goal is not yet reached, enqueue the new state for future exploration.\n        queue.append((next_state, new_actions_sequence))\n\n  # If the queue becomes empty and the goal was never found,\n  # it means the item cannot be crafted from the initial state\n  # within the reachable state space.\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:04:29.665675", "function_name": "craft", "function_body": "    # Action constants (from problem description's `action_specs`)\n    ACTION_DOWN = 0\n    ACTION_UP = 1\n    ACTION_LEFT = 2\n    ACTION_RIGHT = 3\n    ACTION_USE = 4\n\n    def _get_path_to_target(start_state, target_item_kind_idx, is_workshop, max_steps_allowed=200):\n        \"\"\"\n        Performs a BFS to find a path from start_state to a cell containing or adjacent to target_item_kind_idx.\n        Returns (list_of_actions, final_state) or (None, None) if no path found.\n        Assumes start_state.grid does not change during movement actions.\n        \"\"\"\n        # Using list as a queue for BFS (less efficient than collections.deque but adheres to \"no imports\")\n        q = [(start_state, [])] # (current_state, actions_taken)\n        \n        # Visited set: (position_tuple, direction_int)\n        # We only need to memoize (pos, dir) for movement BFS, as the grid and inventory\n        # are assumed static for the duration of this specific pathfinding sub-problem.\n        visited = set([(start_state.pos, start_state.dir)])\n\n        head = 0 # Manual queue head\n        while head < len(q):\n            current_state, actions_taken = q[head]\n            head += 1\n\n            # Check if goal is met (i.e., we are next to the target)\n            if current_state.next_to(target_item_kind_idx):\n                # If it's a workshop, we are ready to USE it. The path is found.\n                if is_workshop:\n                    return actions_taken, current_state\n                # If it's a grabbable item, we are next to it.\n                # We need to simulate the USE action and return the result.\n                # This USE action will attempt to pick up the item.\n                _reward, state_after_use = current_state.step(ACTION_USE)\n                return actions_taken + [ACTION_USE], state_after_use\n\n            if len(actions_taken) >= max_steps_allowed:\n                continue # Prune paths that are too long\n\n            # Explore neighbors (movement actions only)\n            for action in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n                # Simulate the move to get the next state\n                _reward, next_state_after_move = current_state.step(action)\n                next_pos = next_state_after_move.pos\n                next_dir = next_state_after_move.dir\n\n                if (next_pos, next_dir) not in visited:\n                    visited.add((next_pos, next_dir))\n                    q.append((next_state_after_move, actions_taken + [action]))\n\n        return None, None # No path found\n\n    def _craft_recursive(current_state, goal_item_idx, cookbook):\n        \"\"\"\n        Recursively plans actions to obtain `goal_item_idx` starting from `current_state`.\n        Returns (list_of_actions, final_state_after_actions) or (None, None) if impossible.\n        \"\"\"\n        # 1. Goal Check: If already have the item, we're done.\n        if current_state.inventory[goal_item_idx] > 0:\n            return [], current_state\n\n        # 2. If it's a primitive item (in cookbook.primitives)\n        if goal_item_idx in cookbook.primitives:\n            # Find it on the grid and pick it up.\n            path_actions, final_state_after_pickup = _get_path_to_target(current_state, goal_item_kind_idx=goal_item_idx, is_workshop=False)\n            if path_actions is not None:\n                # Verify that the item was actually picked up (inventory increased)\n                if final_state_after_pickup.inventory[goal_item_idx] > current_state.inventory[goal_item_idx]:\n                    return path_actions, final_state_after_pickup\n            return None, None # Cannot find or pick up primitive\n\n        # 3. If it has a recipe:\n        if goal_item_idx in cookbook.recipes:\n            recipe = cookbook.recipes[goal_item_idx]\n            accumulated_actions = []\n            \n            # Use this state to simulate actions and pass around.\n            # It starts as the initial state for this recursive call and gets updated.\n            current_simulated_state = current_state \n\n            # Determine which ingredients are needed and how many more units.\n            ingredients_to_obtain_counts = {}\n            for ing_idx, count_needed in recipe.items():\n                if ing_idx == \"_key\":\n                    continue # Special key for workshop type\n                needed_now = count_needed - current_simulated_state.inventory[ing_idx]\n                if needed_now > 0:\n                    ingredients_to_obtain_counts[ing_idx] = needed_now\n\n            # Iterate through ingredients to obtain them\n            for ing_idx, num_to_get in ingredients_to_obtain_counts.items():\n                for _ in range(num_to_get): # Get each required unit\n                    # IMPORTANT: Pass a *copy* of the current_simulated_state for the recursive call.\n                    # The recursive call might explore multiple paths, and we don't want it to\n                    # modify the `current_simulated_state` that this loop depends on.\n                    # `CraftState` constructor takes scenario, grid, pos, dir, inventory.\n                    state_for_sub_craft = env_factory.CraftState(\n                        current_simulated_state.scenario,\n                        current_simulated_state.grid.copy(),\n                        current_simulated_state.pos,\n                        current_simulated_state.dir,\n                        current_simulated_state.inventory.copy()\n                    )\n                    \n                    sub_actions, final_sub_state = _craft_recursive(state_for_sub_craft, ing_idx, cookbook)\n\n                    if sub_actions is None:\n                        return None, None # Cannot get this required ingredient\n\n                    accumulated_actions.extend(sub_actions)\n                    # After the sub-craft, `current_simulated_state` is updated to reflect the result.\n                    current_simulated_state = final_sub_state\n\n            # After all ingredients are (simulated to be) collected, perform crafting at the workshop.\n            if \"_key\" in recipe:\n                workshop_name = recipe[\"_key\"]\n                if workshop_name not in cookbook.index:\n                    return None, None # Workshop not found in index.\n                workshop_idx = cookbook.index[workshop_name] # Get index of workshop entity\n\n                # Find path to workshop (from the state *after* collecting ingredients)\n                path_to_workshop_actions, final_workshop_state = _get_path_to_target(\n                    current_simulated_state, workshop_idx, is_workshop=True)\n\n                if path_to_workshop_actions is None:\n                    return None, None # Cannot reach workshop\n\n                accumulated_actions.extend(path_to_workshop_actions)\n                current_simulated_state = final_workshop_state # Update state to be at workshop\n\n                # Store inventory before the craft attempt\n                inventory_before_craft_use = current_simulated_state.inventory[goal_item_idx]\n\n                # Perform USE action at workshop (this is the actual crafting step)\n                _reward, next_s_after_craft = current_simulated_state.step(ACTION_USE)\n                accumulated_actions.append(ACTION_USE)\n                current_simulated_state = next_s_after_craft\n\n                # Check if goal item was produced (inventory increased for the goal item)\n                if current_simulated_state.inventory[goal_item_idx] > inventory_before_craft_use:\n                    return accumulated_actions, current_simulated_state\n                else:\n                    # Crafting failed for some reason (e.g., not enough ingredients despite planning, or wrong workshop).\n                    return None, None\n            else:\n                # A recipe without a \"_key\" is an unexpected case for CraftWorld's definition of recipes.\n                # All recipes requiring crafting typically need a workshop.\n                return None, None # Invalid recipe structure or uncraftable without workshop\n\n        return None, None # Item is not a primitive and has no recipe. Uncraftable.\n\n    # Start of the main function `craft_v2` logic\n    # Get the initial state from the `CraftLab` environment.\n    # `env.reset()` returns an observation dict and also updates `env._current_state`.\n    initial_obs = env.reset() \n    initial_craft_state = env._current_state # Get the initial CraftState object\n\n    # Get the cookbook from the world object within the environment\n    cookbook = env.world.cookbook \n\n    # Call the recursive planning function to find actions to craft the target item\n    actions_to_craft, final_state_after_craft = _craft_recursive(initial_craft_state, item, cookbook)\n\n    if actions_to_craft is None:\n        return [] # Could not craft the item\n    else:\n        return actions_to_craft", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:05:52.663072", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment. This ensures the planning starts\n  # from the current state of the CraftLab environment, without resetting it.\n  initial_craft_state = env._current_state\n  initial_state_hash = _hash_state(initial_craft_state)\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, current_path_length).\n  # `current_path_length` keeps track of the number of actions taken to reach `current_CraftState_object`.\n  queue = deque()\n  queue.append((initial_craft_state, 0)) # Start with initial state and path length 0\n\n  # `parent_map` stores the path information for reconstruction.\n  # Key: hash of the current state, Value: (hash of the parent state, action taken from parent to current)\n  # This is a memory-efficient way to store paths compared to storing full action lists in the queue.\n  parent_map = {initial_state_hash: (None, None)} # Initial state has no parent\n\n  # `visited_hashes` is a set to keep track of state hashes that have already been\n  # explored, preventing redundant processing and infinite loops in cycles.\n  visited_hashes = {initial_state_hash}\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This serves as the upper bound for the path length in the BFS. If `max_steps`\n  # is not found, a default of 500 is used for robustness.\n  max_path_length = getattr(env, 'max_steps', 500)\n\n  # Define all possible actions as integer IDs. These correspond to the actions\n  # defined in CraftLab (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  goal_found_state_hash = None # Will store the hash of the state where the goal was achieved\n\n  # BFS main loop\n  while queue:\n      current_state, current_path_length = queue.popleft()\n      # No need to recompute current_state_hash if it was already stored in parent_map.\n      # But for consistency, we recompute it here, or could pass it in the queue tuple.\n\n      # Pruning condition: If the current path length already equals or exceeds the maximum allowed steps,\n      # any further actions from this state would exceed the episode limit.\n      # A path of `max_path_length` actions is considered valid, but no more actions can be taken from it.\n      if current_path_length >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only need the new state.\n          _, new_state = current_state.step(action)\n          new_state_hash = _hash_state(new_state)\n          new_path_length = current_path_length + 1\n\n          # If the resulting path length (after taking this action) exceeds the maximum allowed,\n          # this particular sequence of actions is invalid, so we skip it.\n          if new_path_length > max_path_length:\n              continue\n\n          # If this new state has not been visited before, process it.\n          if new_state_hash not in visited_hashes:\n              visited_hashes.add(new_state_hash)\n              # Store the parent state and the action taken to reach this new state in the `parent_map`.\n              parent_map[new_state_hash] = (_hash_state(current_state), action)\n\n              # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n              if new_state.satisfies(None, item):\n                  goal_found_state_hash = new_state_hash\n                  break # Goal found, exit the inner loop (actions exploration for current state)\n              else:\n                  # If not the goal, add it to the queue to explore its future possibilities.\n                  queue.append((new_state, new_path_length))\n      \n      # If the goal was found in the inner loop, break the outer loop (BFS) as well.\n      if goal_found_state_hash is not None:\n          break\n\n  # If `goal_found_state_hash` is still None after the BFS completes, it means the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  if goal_found_state_hash is None:\n      return []\n\n  # Reconstruct the path by backtracking from the `goal_found_state_hash` using the `parent_map`.\n  path = []\n  current_hash = goal_found_state_hash\n  # Backtrack until we reach the initial state (which is the root in our `parent_map`).\n  while current_hash != initial_state_hash:\n      parent_hash, action = parent_map[current_hash]\n      path.append(action)\n      current_hash = parent_hash\n  \n  # The path is built in reverse order (from goal to start), so reverse it to get\n  # the correct sequence of actions from start to goal.\n  path.reverse()\n  return path", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T01:05:53.670453", "function_name": "craft", "function_body": "", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:07:11.795892", "function_name": "craft", "function_body": "  import collections\n  import heapq # For priority queue in A* search\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    This approach is carried over from craft_v0/v1's design.\n    \"\"\"\n    # Converting numpy array to tuple for hashability in sets/dicts\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  initial_state = env._current_state\n\n  # Check if the desired item is already present in the inventory at the start.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  cookbook = env.world.cookbook\n  \n  # Pre-calculate the ultimate primitive ingredients needed for the goal item.\n  # This relies on the `primitives_for` method to recursively break down\n  # recipe requirements into their most basic, non-craftable components.\n  # This dictionary maps primitive item indices to the total count needed.\n  required_primitive_counts = cookbook.primitives_for(item)\n\n  def heuristic(state) -> float:\n    \"\"\"\n    Estimates the cost from the current state to the goal state (h_score).\n    This heuristic is the sum of deficits for all required primitive ingredients.\n    A deficit is how many more of a primitive item are needed than currently possessed.\n    It is an admissible heuristic (never overestimates the cost) for this domain,\n    as each action (pickup or craft) can at best reduce the deficit of one or more\n    primitive items. It ignores movement costs, which makes it admissible for a\n    uniform action cost search (each step costs 1).\n    \"\"\"\n    h_score = 0\n    for p_idx, p_needed_count in required_primitive_counts.items():\n        current_count = state.inventory[p_idx]\n        h_score += max(0, p_needed_count - current_count)\n    \n    # If the goal item itself is not a primitive (i.e., it's a crafted product)\n    # and it's not yet in the inventory, add a small cost. This helps guide\n    # the search to perform the final crafting step once ingredients are gathered.\n    # We assume needing at least 1 of the goal item if it's a product.\n    if item not in cookbook.primitives and state.inventory[item] == 0:\n        h_score += 1 # A small penalty to encourage crafting the final product\n\n    return h_score\n\n  # Initialize the A* open set (priority queue).\n  # Each element is a tuple: (f_score, g_score, current_CraftState, path_to_current_state)\n  # f_score = g_score + h_score (estimated total cost from start to goal via current_state)\n  # g_score = actual cost from start to current_state (length of path so far)\n  open_set = []\n  # Push the initial state into the priority queue.\n  # Initial g_score is 0, initial f_score is just the heuristic from the start.\n  heapq.heappush(open_set, (0 + heuristic(initial_state), 0, initial_state, []))\n\n  # Dictionary to store the g_score (cost of the shortest path found so far)\n  # for each visited simplified state. This is crucial for A* to avoid\n  # re-exploring paths that are already known to be longer to a particular state.\n  g_scores = {}\n  g_scores[_get_simplified_state_tuple(initial_state)] = 0\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  MAX_PLAN_STEPS = 200        # Maximum length of action sequence to consider.\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  explored_nodes_count = 0\n\n  # Perform A* search\n  while open_set and explored_nodes_count < MAX_EXPLORED_NODES:\n    # Pop the state with the lowest f_score from the priority queue.\n    f_score, current_g_score, current_state, path = heapq.heappop(open_set)\n    explored_nodes_count += 1\n\n    # Get the hashable representation of the current state.\n    current_simplified_state = _get_simplified_state_tuple(current_state)\n\n    # If we have already found a shorter path to this state, skip processing it.\n    # This happens if a state is added to the open_set multiple times via different paths,\n    # and we later pop an older, longer path to the same state.\n    if current_g_score > g_scores.get(current_simplified_state, float('inf')):\n        continue\n\n    # Check if the goal is satisfied in the current state.\n    # In A*, when a node is popped from the open set, it represents the shortest\n    # path found to that node so far. If this node is the goal, then we've found\n    # the shortest path to the goal.\n    if current_state.satisfies(None, item):\n      return path\n\n    # If the current path already exceeds the maximum allowed steps, prune this branch.\n    if len(path) >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # `current_state.step(action)` returns (reward, new_state).\n      # The reward is always 0.0 in this environment implementation.\n      _, next_state = current_state.step(action)\n      \n      # The cost to move from current_state to next_state is 1 (uniform action cost).\n      next_g_score = current_g_score + 1 \n\n      # Get the hashable representation of the next state.\n      next_simplified_state = _get_simplified_state_tuple(next_state)\n\n      # If this path to `next_state` is shorter than any previously found path\n      # to `next_state` (or if `next_state` hasn't been visited before).\n      if next_g_score < g_scores.get(next_simplified_state, float('inf')):\n        g_scores[next_simplified_state] = next_g_score # Update the shortest g_score found to this state.\n        next_f_score = next_g_score + heuristic(next_state) # Calculate f_score for A*.\n        new_path = path + [action]                       # Extend the path.\n        heapq.heappush(open_set, (next_f_score, next_g_score, next_state, new_path)) # Add to priority queue.\n\n  # If the loop finishes without finding a path (open_set becomes empty or search limits are reached),\n  # it means the item cannot be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:07:14.130579", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  N_ACTIONS = 5 # Total number of distinct actions\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    This is adopted from craft_v0's approach to state representation.\n    \"\"\"\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  # Get the initial state of the environment.\n  initial_state = env._current_state\n\n  # Check if the desired item is already present in the inventory.\n  if initial_state.satisfies(None, item):\n    return [] # Item already crafted, no actions needed.\n\n  # Initialize a deque for Breadth-First Search (BFS).\n  # Each element in the queue is a tuple: (current_CraftState, simplified_state_tuple, depth).\n  q = collections.deque()\n\n  # Initialize a set to keep track of visited states, using the simplified tuple.\n  visited = set()\n\n  # Initialize a dictionary to reconstruct the path.\n  # It maps `simplified_child_state_tuple` to `(simplified_parent_state_tuple, action_taken_to_reach_child)`.\n  path_tracker = {}\n\n  # Define limits for the search to prevent excessively long computations\n  # or out-of-memory errors for very complex or unreachable goals.\n  MAX_PLAN_STEPS = 200        # Maximum length of action sequence to consider.\n  MAX_EXPLORED_NODES = 100000 # Maximum number of unique states to explore.\n\n  # Add the initial state to the queue.\n  initial_simplified = _get_simplified_state_tuple(initial_state)\n  q.append((initial_state, initial_simplified, 0)) # (state, simplified_state, depth)\n  visited.add(initial_simplified)\n  path_tracker[initial_simplified] = (None, None) # Sentinel for the starting node\n\n  explored_nodes_count = 0\n\n  # Perform BFS\n  while q and explored_nodes_count < MAX_EXPLORED_NODES:\n    current_state, current_simplified, current_depth = q.popleft()\n    explored_nodes_count += 1\n\n    # If the current path is too long, skip further exploration from this path.\n    if current_depth >= MAX_PLAN_STEPS:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in range(N_ACTIONS):\n      # Apply the action to get the next state.\n      # `current_state.step(action)` returns (reward, new_state).\n      # The reward is always 0.0 in this environment implementation.\n      _, next_state = current_state.step(action)\n\n      # Get the simplified hashable representation of the next state.\n      next_simplified = _get_simplified_state_tuple(next_state)\n\n      # If this simplified state has not been visited before:\n      if next_simplified not in visited:\n        visited.add(next_simplified) # Mark as visited.\n        path_tracker[next_simplified] = (current_simplified, action) # Store path information\n        new_depth = current_depth + 1\n\n        # Check if the goal is satisfied in this new state.\n        if next_state.satisfies(None, item):\n          # Goal reached, reconstruct the path by backtracking from the goal state.\n          path = []\n          node = next_simplified\n          while path_tracker[node][0] is not None: # Backtrack until the initial state (parent is None)\n            parent, action_to_node = path_tracker[node]\n            path.append(action_to_node)\n            node = parent\n          return path[::-1] # The path is built in reverse, so reverse it back.\n\n        # Add the new state, its simplified representation, and its depth to the queue.\n        q.append((next_state, next_simplified, new_depth))\n\n  # If the loop finishes without finding a path (queue empty or limits reached),\n  # it means the item cannot be crafted under the given constraints or within the search limits.\n  return []", "island_id": 0, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T01:08:41.757021", "function_name": "craft", "function_body": "  # Action constants (standard for CraftWorld)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ALL_ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Helper function to create a hashable key for a CraftState object.\n  # This is crucial for efficient BFS to avoid re-exploring states and detecting cycles.\n  def _get_craft_state_key(state):\n      \"\"\"\n      Generates a hashable key for a CraftState instance.\n      The key is a tuple containing byte representations of numpy arrays and direct values for others.\n      \"\"\"\n      # Convert numpy arrays (grid, inventory) to bytes for efficient hashing.\n      # .tobytes() is generally preferred over converting to tuple of tuples for large arrays.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      \n      # pos is already a tuple, dir is an int.\n      return (grid_bytes, state.pos, state.dir, inventory_bytes)\n\n  goal_item_index = item\n\n  # Get the starting CraftState from the CraftLab environment.\n  initial_craft_state = env._current_state \n  \n  # Queue for BFS: stores (current_state, path_to_current_state).\n  # The state object itself is passed, and its attributes are used to form a hashable key for the visited set.\n  q = deque([(initial_craft_state, [])])\n  \n  # Visited set: stores hashable representations of states to avoid cycles and redundant computation.\n  # A state key is (grid_bytes, pos_tuple, dir_int, inventory_bytes).\n  visited_state_keys = set()\n  \n  # Add the initial state to the visited set.\n  visited_state_keys.add(_get_craft_state_key(initial_craft_state))\n\n  # BFS loop\n  while q:\n      current_state, current_path = q.popleft()\n\n      # Check if the goal is satisfied in the current state.\n      # CraftState.satisfies expects goal_name (which is ignored in this implementation) and goal_arg (item index).\n      if current_state.satisfies(None, goal_item_index):\n          return current_path # Goal reached, return the path.\n\n      # Explore all possible actions from the current state.\n      for action in ALL_ACTIONS:\n          # Simulate the action: CraftState.step returns a new CraftState object.\n          # The reward is not used for pathfinding in this context (assuming uniform cost per action).\n          _reward, next_state = current_state.step(action)\n          \n          # Create a hashable key for the next state.\n          next_state_key = _get_craft_state_key(next_state)\n\n          # If this state has not been visited before, add it to the queue and visited set.\n          if next_state_key not in visited_state_keys:\n              visited_state_keys.add(next_state_key)\n              new_path = current_path + [action] # Extend the path.\n              q.append((next_state, new_path))\n              \n  # If the queue becomes empty and the goal was not reached, it means the item cannot be crafted\n  # or is unreachable from the initial state within the explored graph.\n  return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:08:41.827072", "function_name": "craft", "function_body": "    # Action constants (re-declared inside for self-containment as per instruction)\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    # Max depth for recursive planning (number of recipe layers)\n    MAX_PLAN_RECURSION_DEPTH = 5\n    # Max total actions for any path found (safety limit for BFS/DFS sub-problems)\n    MAX_PATH_LENGTH = 150 \n\n    cookbook = env.world.cookbook\n    recipes = cookbook.recipes\n    primitives = cookbook.primitives\n    # Convert workshop_indices to a set for faster lookup\n    workshop_indices = set(env.world.workshop_indices)\n\n    initial_state = env._current_state\n    \n    # Check if item is already in inventory\n    if initial_state.satisfies(None, item):\n        return []\n\n    # Helper function for BFS pathfinding to a target location or item\n    # Returns (final_state, actions_list) or (None, None) if path not found\n    def find_path_to_target(start_state, target_kind_idx=None, target_pos=None, allow_pickup=False, workshop_target=False):\n        q_path = collections.deque()\n        # Queue stores (current_state, actions_taken_for_path)\n        q_path.append((start_state, []))\n\n        # Visited set for pathfinding to avoid cycles and re-exploring same states\n        # State representation: (grid_hashable, pos, dir, inventory_tuple)\n        start_state_tuple_hash = (start_state.grid.tobytes(), start_state.pos, start_state.dir, tuple(start_state.inventory))\n        visited_path = {start_state_tuple_hash}\n\n        while q_path:\n            current_p_state, current_p_actions = q_path.popleft()\n\n            if len(current_p_actions) > MAX_PATH_LENGTH:\n                continue # Path too long for this sub-problem\n\n            # Check if target condition is met\n            target_reached = False\n            if target_pos: # Target position reached (next to it)\n                # Check if current_p_state.pos is adjacent to target_pos\n                dx = abs(current_p_state.pos[0] - target_pos[0])\n                dy = abs(current_p_state.pos[1] - target_pos[1])\n                if (dx <= 1 and dy <= 1) and not (dx == 0 and dy == 0): # Adjacent, not on top of\n                    target_reached = True\n            elif target_kind_idx is not None:\n                if current_p_state.next_to(target_kind_idx):\n                    target_reached = True\n            \n            if target_reached:\n                # If target is reached, we might need to perform a USE action.\n                if allow_pickup or workshop_target:\n                    # Simulate USE action\n                    _, post_use_state = current_p_state.step(USE)\n                    return post_use_state, current_p_actions + [USE]\n                else: # Just reaching a position/kind without a USE action\n                    return current_p_state, current_p_actions\n            \n            # Explore movement actions\n            for action in [DOWN, UP, LEFT, RIGHT]:\n                _, next_p_state = current_p_state.step(action)\n\n                # Generate hashable state representation for visited set\n                next_p_state_tuple_hash = (next_p_state.grid.tobytes(), next_p_state.pos, next_p_state.dir, tuple(next_p_state.inventory))\n\n                if next_p_state_tuple_hash not in visited_path:\n                    visited_path.add(next_p_state_tuple_hash)\n                    q_path.append((next_p_state, current_p_actions + [action]))\n        \n        return None, None # Path not found\n\n    # Memoization for _plan_recursive results to avoid redundant sub-goal planning\n    # Key: (state_hash, target_item_idx)\n    # Value: (achieved_state, actions_to_achieve_from_state)\n    memo = {}\n\n    def _plan_recursive(state, target_item_idx, current_recursion_depth):\n        if current_recursion_depth > MAX_PLAN_RECURSION_DEPTH:\n            return None, None # Exceeded planning depth for recipe chains\n\n        state_hash = (state.grid.tobytes(), state.pos, state.dir, tuple(state.inventory))\n        if (state_hash, target_item_idx) in memo:\n            return memo[(state_hash, target_item_idx)] # Return cached result\n\n        # 1. Base case: Item already in inventory\n        if state.satisfies(None, target_item_idx):\n            memo[(state_hash, target_item_idx)] = (state, []) # Cache this base case\n            return state, []\n\n        # Result of current planning attempt (initialized to None)\n        # This will store the *first* successful plan for this state-goal, potentially not shortest\n        current_best_plan_state, current_best_plan_actions = None, None\n\n        # 2. Try to get item if it's a primitive (found on grid and pickable)\n        if target_item_idx in primitives:\n            # Find the primitive on the grid\n            item_pos = None\n            width, height, _ = state.grid.shape\n            for x in range(width):\n                for y in range(height):\n                    if state.grid[x, y, target_item_idx] > 0: # Check if item is at this location\n                        item_pos = (x, y)\n                        break\n                if item_pos:\n                    break\n            \n            if item_pos:\n                # Plan movement to the item and pick it up\n                path_state, path_actions = find_path_to_target(state, target_kind_idx=target_item_idx, allow_pickup=True)\n                \n                if path_state and path_state.inventory[target_item_idx] > state.inventory[target_item_idx]:\n                    # Successfully picked up the item\n                    current_best_plan_state, current_best_plan_actions = path_state, path_actions\n                    # If this is a top-level primitive goal, this is the solution.\n                    # If it's an ingredient, it's a step towards the solution.\n                    # Cache and return this plan fragment for primitives\n                    memo[(state_hash, target_item_idx)] = (current_best_plan_state, current_best_plan_actions)\n                    return current_best_plan_state, current_best_plan_actions\n        \n        # 3. Try to get item via a recipe\n        if target_item_idx in recipes:\n            recipe = recipes[target_item_idx]\n            required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n            \n            current_state_for_recipe_chain = state\n            actions_for_ingredients_chain = []\n\n            # Recursively plan for each ingredient until enough are collected\n            all_ingredients_obtained = True\n            for ing_idx, ing_count in required_ingredients.items():\n                while current_state_for_recipe_chain.inventory[ing_idx] < ing_count:\n                    # Need to craft/get this ingredient\n                    new_ing_state, ing_actions = _plan_recursive(current_state_for_recipe_chain, ing_idx, current_recursion_depth + 1)\n                    if new_ing_state is None: # Failed to get ingredient\n                        all_ingredients_obtained = False\n                        break\n                    current_state_for_recipe_chain = new_ing_state\n                    actions_for_ingredients_chain.extend(ing_actions)\n                if not all_ingredients_obtained:\n                    break\n            \n            if all_ingredients_obtained:\n                # All ingredients obtained, now go to workshop and craft\n                if workshop_indices:\n                    # Find a path to any workshop and use it\n                    first_workshop_idx = next(iter(workshop_indices)) # Get any workshop index\n                    path_to_workshop_state, path_to_workshop_actions = find_path_to_target(\n                        current_state_for_recipe_chain, target_kind_idx=first_workshop_idx, workshop_target=True)\n                    \n                    if path_to_workshop_state:\n                        # After using workshop, check if target_item_idx is now in inventory\n                        if path_to_workshop_state.satisfies(None, target_item_idx):\n                            combined_actions = actions_for_ingredients_chain + path_to_workshop_actions\n                            \n                            # Update best plan for this state-goal if found or is better\n                            # (rudimentary length comparison for 'better' - a proper shortest path requires A* or full BFS)\n                            if current_best_plan_state is None or len(combined_actions) < len(current_best_plan_actions):\n                                current_best_plan_state, current_best_plan_actions = path_to_workshop_state, combined_actions\n        \n        # Store the best plan found for this state-goal pair before returning\n        memo[(state_hash, target_item_idx)] = (current_best_plan_state, current_best_plan_actions)\n        return current_best_plan_state, current_best_plan_actions\n\n    # Start the planning process from the initial state\n    final_state, actions_list = _plan_recursive(initial_state, item, 0)\n\n    if final_state is not None and final_state.satisfies(None, item):\n        return actions_list\n    else:\n        return []", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-30T01:10:02.506728", "function_name": "craft", "function_body": "  from collections import deque\n\n  # Helper function for hashing state, defined locally for clarity and encapsulation.\n  # This makes the CraftState object hashable for use in the 'visited' set.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes to make them hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      # Return a tuple of bytes, position tuple, and direction integer.\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state directly from the environment's current state.\n  # This allows planning from an arbitrary intermediate state of the environment,\n  # rather than always starting from a reset state.\n  initial_craft_state = env._current_state\n\n  # Optimization: If the target item is already in the inventory at the start,\n  # no actions are needed, so return an empty list immediately.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple:\n  # (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = deque()\n  queue.append((initial_craft_state, []))\n\n  # Initialize the set of visited states to prevent cycles and redundant computations.\n  # States are hashed using the local _hash_state helper function for efficient lookup.\n  visited = set()\n  visited.add(_hash_state(initial_craft_state))\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This serves as the maximum path length for the BFS, pruning branches that exceed it.\n  max_path_length = env.max_steps\n\n  # Define all possible actions. These correspond to the integer IDs for actions\n  # as described in the CraftLab's action_specs (e.g., DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  # Main BFS loop: Continues as long as there are states to explore in the queue.\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Pruning condition: If the current path length has reached the maximum allowed steps,\n      # we cannot take any further actions from this state without exceeding the limit.\n      # We allow paths *up to and including* `max_path_length` steps.\n      # If `len(actions_taken)` is already `max_path_length`, we cannot extend this path.\n      if len(actions_taken) == max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only need the new state.\n          _, new_state = current_state.step(action)\n          # Create a new list of actions by appending the current action.\n          new_actions_taken = actions_taken + [action]\n\n          # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n          # If satisfied, we've found the shortest sequence of actions, as BFS guarantees this.\n          # The path length `len(new_actions_taken)` will be at most `max_path_length`\n          # due to the pruning check at the beginning of the `while` loop.\n          if new_state.satisfies(None, item):\n              return new_actions_taken\n\n          # Generate the hashable representation of the new state.\n          new_state_hash = _hash_state(new_state)\n\n          # If this new state has not been visited before, add it to the visited set and the queue\n          # to explore its future possibilities.\n          # The path length check for `new_actions_taken` is implicitly handled by the `len(actions_taken) == max_path_length`\n          # check at the top of the loop, which prevents enqueueing paths that would immediately\n          # exceed the limit in the next iteration.\n          if new_state_hash not in visited:\n              visited.add(new_state_hash)\n              queue.append((new_state, new_actions_taken))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length` limit.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T01:10:25.046809", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment.\n  # This version operates on the *current* state of the `env` object without resetting it,\n  # making it applicable to any state the environment is currently in.\n  initial_craft_state = env._current_state\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = deque()\n  queue.append((initial_craft_state, []))\n\n  # Initialize the set of visited states to prevent cycles and redundant computations.\n  # States are hashed using the _hash_state helper function for efficient lookup.\n  visited = set()\n  visited.add(_hash_state(initial_craft_state))\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This acts as a maximum path length for the BFS, pruning branches that exceed it.\n  # A path of `max_path_length` actions is considered valid.\n  max_path_length = env.max_steps\n\n  # Define all possible actions. These correspond to the integer IDs for actions\n  # as described in CraftLab's action_specs (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  # BFS main loop\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Pruning condition: If the current path length is already at or beyond the maximum allowed steps,\n      # do not explore further from this branch. This ensures that any path returned\n      # will not exceed `max_path_length`.\n      if len(actions_taken) >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only care about the new state.\n          _, new_state = current_state.step(action)\n          # Create a new list of actions by appending the current action.\n          new_actions_taken = actions_taken + [action]\n\n          # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n          if new_state.satisfies(None, item):\n              # If the goal is satisfied, this is the shortest path found by BFS.\n              # Due to the `len(actions_taken) >= max_path_length` prune at the top of the loop,\n              # `new_actions_taken` is guaranteed to be within the `max_path_length` limit\n              # (i.e., `len(new_actions_taken) <= max_path_length`).\n              return new_actions_taken\n\n          # Generate the hashable representation of the new state.\n          new_state_hash = _hash_state(new_state)\n\n          # If this new state has not been visited before, add it to the visited set and the queue.\n          # We explicitly check `len(new_actions_taken) <= max_path_length` here to prevent\n          # adding paths that would immediately be pruned upon popping from the queue anyway.\n          if new_state_hash not in visited and len(new_actions_taken) <= max_path_length:\n              visited.add(new_state_hash)\n              queue.append((new_state, new_actions_taken))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
