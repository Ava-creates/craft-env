{"timestamp": "2025-07-30T00:24:15.100434", "function_name": "craft", "function_body": "  import collections\n\n  # Action constants (from action_specs)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n  ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n  # Reset the environment to a consistent starting state.\n  # This populates `env._current_state` with the initial `CraftState`.\n  env.reset(seed=0)\n  initial_craft_state = env._current_state\n\n  # Queue for Breadth-First Search (BFS).\n  # Each element is a tuple: (current_CraftState, list_of_actions_to_reach_this_state).\n  queue = collections.deque()\n\n  # Set to store visited states to avoid redundant computations and cycles.\n  # A state is uniquely identified by its grid layout, inventory, agent position, and direction.\n  # `grid.tobytes()` is used for efficient hashing of the numpy grid array.\n  # Inventory (numpy array) and position (tuple) are converted to tuples for hashing.\n  visited = set()\n\n  # Add the initial state to the queue and mark it as visited.\n  # This ensures that the first time a state is encountered, it's via the shortest path.\n  initial_state_key = (initial_craft_state.grid.tobytes(), tuple(initial_craft_state.inventory),\n                       initial_craft_state.pos, initial_craft_state.dir)\n  visited.add(initial_state_key)\n  queue.append((initial_craft_state, []))\n\n  # Maximum depth to search. This limits the number of actions in a potential solution path.\n  # It prevents excessively long runtimes for complex or potentially unsolvable goals.\n  max_search_depth = 75\n\n  while queue:\n    current_state, actions_so_far = queue.popleft()\n\n    # Check if the goal item is present in the current state's inventory.\n    if current_state.satisfies(None, item):\n      return actions_so_far\n\n    # If the current path length exceeds the maximum allowed search depth,\n    # prune this branch to limit computational cost.\n    if len(actions_so_far) >= max_search_depth:\n      continue\n\n    # Explore all possible actions from the current state.\n    for action in ACTIONS:\n      # `current_state.step(action)` returns a new `CraftState` instance,\n      # which is essential for BFS to explore distinct states without modifying previous ones.\n      reward, next_state = current_state.step(action)\n\n      # Create a hashable representation of the next state.\n      next_state_key = (next_state.grid.tobytes(), tuple(next_state.inventory),\n                        next_state.pos, next_state.dir)\n\n      # Only add the next_state to the queue if it has not been visited before.\n      # This is the primary improvement: it prevents redundant states from being\n      # added to the queue, making the search more efficient.\n      if next_state_key not in visited:\n        visited.add(next_state_key)  # Mark as visited (i.e., added to queue)\n        queue.append((next_state, actions_so_far + [action]))\n\n  # If the queue becomes empty and the goal was not found, it means the item\n  # cannot be crafted within the specified search depth or is fundamentally impossible.\n  return []", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:25:28.077863", "function_name": "craft", "function_body": "  # A queue for Breadth-First Search (BFS)\n  # Stores tuples of (CraftState_object, list_of_actions_to_reach_this_state)\n  q = collections.deque()\n  \n  # A set to keep track of visited states to prevent cycles and redundant computation.\n  # States are represented by a hashable tuple: (position, direction, inventory_tuple, grid_bytes)\n  visited = set()\n\n  # Get the initial CraftState from the CraftLab environment\n  initial_craft_state = env._current_state\n  initial_actions_path = [] # No actions taken yet\n\n  # Add the initial state to the queue\n  q.append((initial_craft_state, initial_actions_path))\n\n  # Define a helper function to create a hashable representation of a CraftState\n  def get_hashable_state_representation(craft_state):\n      \"\"\"Converts a CraftState object into a hashable tuple for the 'visited' set.\"\"\"\n      return (\n          craft_state.pos,                               # Agent's (row, col) tuple\n          craft_state.dir,                               # Agent's direction integer\n          tuple(craft_state.inventory.tolist()),         # Convert numpy inventory to a hashable tuple\n          craft_state.grid.tobytes()                     # Convert numpy grid to a byte string\n      )\n\n  # Add the initial state's representation to the visited set\n  visited.add(get_hashable_state_representation(initial_craft_state))\n\n  # Action constants (assuming these are globally defined or discoverable)\n  # Based on CraftLab's action_specs: DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n  ALL_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT, ACTION_USE]\n\n  # Define a maximum search depth to prevent excessively long searches\n  # and to handle cases where the goal might be unreachable within reasonable steps.\n  MAX_SEARCH_DEPTH = 100 # This value can be tuned based on expected problem complexity.\n\n  while q:\n      current_craft_state, current_actions_path = q.popleft()\n\n      # Check if the current state satisfies the goal\n      # The `satisfies` method checks if the inventory contains the `item`.\n      if current_craft_state.satisfies(None, item): # `goal_name` is ignored, `goal_arg` is `item` index\n          return current_actions_path # Goal reached, return the sequence of actions\n\n      # Pruning: If the current path is too long, stop exploring this branch\n      if len(current_actions_path) >= MAX_SEARCH_DEPTH:\n          continue\n\n      # Explore all possible actions from the current state\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step() returns (reward, new_state). We only need new_state.\n          _, next_craft_state = current_craft_state.step(action)\n\n          # Get the hashable representation of the next state\n          next_hashable_state_rep = get_hashable_state_representation(next_craft_state)\n\n          # If this next state has not been visited before, add it to the queue and visited set\n          if next_hashable_state_rep not in visited:\n              visited.add(next_hashable_state_rep)\n              q.append((next_craft_state, current_actions_path + [action]))\n\n  # If the queue becomes empty and the goal has not been reached,\n  # it means the item is not craftable or reachable within the defined search limits.\n  # Return an empty list indicating no path found.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:25:29.055557", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Define action constants within the function scope\n  # These are assumed to be the standard action mappings based on N_ACTIONS=5.\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  MAX_BFS_STEPS = 100  # Max steps for a single pathfinding (movement) BFS to prevent infinite loops\n  MAX_PLANNING_RECURSION_DEPTH = 50  # Max depth for recursive crafting plan to prevent infinite recursion\n\n  initial_craft_state = env._current_state\n  world = env.world  # The CraftWorld instance\n\n  # Helper function: BFS to find path to a specific kind (item on grid or workshop).\n  # Returns (list of actions, final_state) or (None, None) if not found.\n  # The final_state will be the state *after* moving to be adjacent to the target.\n  def _find_path_to_kind(start_state: 'CraftState', target_kind_idx: int):\n      q = deque([(start_state, [])])  # (current_state, actions_taken_to_reach_current_state)\n      \n      # Visited set for BFS: (position, direction). Inventory changes are not relevant for movement.\n      visited = set([(start_state.pos, start_state.dir)])\n\n      while q:\n          current_state, current_actions = q.popleft()\n\n          if len(current_actions) >= MAX_BFS_STEPS:\n              continue  # Exceeded max steps for this pathfinding attempt\n\n          # Check if the agent is next to the target kind\n          if current_state.next_to(target_kind_idx):\n              return current_actions, current_state\n\n          # Explore all possible movement actions\n          for action in [DOWN, UP, LEFT, RIGHT]:\n              _reward, new_state = current_state.step(action)\n              new_pos_dir = (new_state.pos, new_state.dir)\n              if new_pos_dir not in visited:\n                  visited.add(new_pos_dir)\n                  q.append((new_state, current_actions + [action]))\n      \n      return None, None  # Path not found\n\n  # Main recursive planner function for crafting.\n  # Returns (list of actions, final_state) or (None, None) if crafting fails.\n  # `depth` is used to limit recursion depth.\n  # `visited_recursion_states` tracks (state_key, target_item) to prevent infinite loops within a single planning branch.\n  def _plan_craft_recursive(current_planning_state: 'CraftState', target_item_idx: int, depth: int, visited_recursion_states: set):\n      if depth > MAX_PLANNING_RECURSION_DEPTH:\n          return None, None  # Too deep, likely a circular dependency or extremely long chain\n\n      # Base case: if the item is already in inventory\n      if current_planning_state.inventory[target_item_idx] > 0:\n          return [], current_planning_state\n\n      # Create a hashable key for the current planning state\n      # inventory.nonzero()[0] gives indices of non-zero elements, which is good for inventory state.\n      current_state_key = (current_planning_state.pos, current_planning_state.dir, frozenset(current_planning_state.inventory.nonzero()[0]))\n      \n      # Check for circular planning: if we're trying to get this item from this state again in this branch\n      if (current_state_key, target_item_idx) in visited_recursion_states:\n          return None, None  # Detected a loop or redundancy\n\n      # Add current goal to the set of visited states for this planning branch\n      visited_recursion_states.add((current_state_key, target_item_idx))\n\n      recipe = world.cookbook.recipes.get(target_item_idx)\n\n      # Case 1: Target item is a primitive (no recipe)\n      if recipe is None:\n          path_actions, state_next_to_primitive = _find_path_to_kind(current_planning_state, target_item_idx)\n          \n          if path_actions is None:  # Cannot find or reach the primitive\n              visited_recursion_states.discard((current_state_key, target_item_idx)) # Remove before returning None\n              return None, None\n          \n          # Simulate picking up the item using the USE action\n          _r, final_state_after_pickup = state_next_to_primitive.step(USE)\n          \n          if final_state_after_pickup.inventory[target_item_idx] > 0:\n              visited_recursion_states.discard((current_state_key, target_item_idx))\n              return path_actions + [USE], final_state_after_pickup\n          else:  # Pickup failed (e.g., item not grabbable, or something else blocked)\n              visited_recursion_states.discard((current_state_key, target_item_idx))\n              return None, None\n\n      # Case 2: Target item is craftable (has a recipe)\n      total_actions = []\n      state_after_ingredients_gathered = current_planning_state\n      \n      required_ingredients = {ing: count for ing, count in recipe.items() if ing != '_key'}\n      workshop_needed = '_key' in recipe\n\n      # Iterate through required ingredients and recursively gather them\n      for ing_idx, required_count in required_ingredients.items():\n          current_inv_count = state_after_ingredients_gathered.inventory[ing_idx]\n          to_get = max(0, required_count - current_inv_count)\n\n          for _ in range(to_get):\n              # Recursively plan to get the ingredient\n              ing_actions, state_after_ing = _plan_craft_recursive(\n                  state_after_ingredients_gathered, ing_idx, depth + 1, visited_recursion_states\n              )\n              \n              if ing_actions is None:  # Failed to get an ingredient\n                  visited_recursion_states.discard((current_state_key, target_item_idx))\n                  return None, None\n              \n              total_actions.extend(ing_actions)\n              state_after_ingredients_gathered = state_after_ing\n\n      # All ingredients are now (simulated to be) in `state_after_ingredients_gathered.inventory`.\n\n      # If a workshop is needed, move to one\n      state_before_craft_use = state_after_ingredients_gathered\n      if workshop_needed:\n          # Check if there are any workshops defined in this world\n          if not world.workshop_indices:\n              visited_recursion_states.discard((current_state_key, target_item_idx))\n              return None, None  # No workshops available to craft\n\n          # Select the first workshop (simplification for v2)\n          workshop_idx = world.workshop_indices[0] \n          path_to_workshop_actions, state_next_to_workshop = _find_path_to_kind(state_after_ingredients_gathered, workshop_idx)\n          \n          if path_to_workshop_actions is None:  # Cannot reach a workshop\n              visited_recursion_states.discard((current_state_key, target_item_idx))\n              return None, None\n          \n          total_actions.extend(path_to_workshop_actions)\n          state_before_craft_use = state_next_to_workshop\n\n      # Perform the USE action to craft the item\n      _r, final_state_after_craft = state_before_craft_use.step(USE)\n\n      # Verify if crafting was successful by checking inventory change\n      if final_state_after_craft.inventory[target_item_idx] > current_planning_state.inventory[target_item_idx]:\n          visited_recursion_states.discard((current_state_key, target_item_idx))\n          return total_actions + [USE], final_state_after_craft\n      else:  # Crafting failed (e.g., wrong location, insufficient ingredients, etc.)\n          visited_recursion_states.discard((current_state_key, target_item_idx))\n          return None, None\n            \n  # Initial call to the recursive planner.\n  # An empty set is used to track visited states to prevent loops in this planning attempt.\n  actions_plan, final_state_after_plan = _plan_craft_recursive(initial_craft_state, item, 0, set())\n  \n  if actions_plan is None:\n      return []  # Return an empty list if no valid plan is found\n  else:\n      return actions_plan", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:26:47.072645", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment.\n  # IMPROVEMENT: Instead of always resetting the environment (as in craft_v0/v1),\n  # use the *current* state of the `env` object. This makes the function\n  # applicable to any state the environment is currently in, not just newly reset ones.\n  initial_craft_state = env._current_state\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  queue = deque()\n  queue.append((initial_craft_state, []))\n\n  # Initialize the set of visited states to prevent cycles and redundant computations.\n  # States are hashed using the _hash_state helper function for efficient lookup.\n  visited = set()\n  visited.add(_hash_state(initial_craft_state))\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This acts as a maximum path length for the BFS, pruning branches that exceed it.\n  max_path_length = env.max_steps\n\n  # Define all possible actions. These correspond to the integer IDs for actions\n  # as described in CraftLab's action_specs (DOWN=0, UP=1, LEFT=2, RIGHT=3, USE=4).\n  ALL_ACTIONS = [0, 1, 2, 3, 4]\n\n  # BFS main loop\n  while queue:\n      current_state, actions_taken = queue.popleft()\n\n      # Pruning condition: If the current path length already exceeds the maximum allowed steps,\n      # there's no need to explore further from this branch, as it won't lead to a valid solution.\n      if len(actions_taken) >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          # CraftState.step returns (reward, new_CraftState_object). We only care about the new state.\n          _, new_state = current_state.step(action)\n          # Create a new list of actions by appending the current action.\n          new_actions_taken = actions_taken + [action]\n\n          # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n          if new_state.satisfies(None, item):\n              # If the goal is satisfied, we've found the shortest sequence of actions.\n              return new_actions_taken\n\n          # Generate the hashable representation of the new state.\n          new_state_hash = _hash_state(new_state)\n\n          # If this new state has not been visited before, add it to the visited set and the queue\n          # to explore its future possibilities.\n          if new_state_hash not in visited:\n              visited.add(new_state_hash)\n              queue.append((new_state, new_actions_taken))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  return []", "island_id": 6, "scores": {"3": 1.7}}
{"timestamp": "2025-07-30T00:27:10.673275", "function_name": "craft", "function_body": "  from collections import deque\n  import numpy as np\n\n  # Helper function for hashing state. Placed inside to be self-contained within the function.\n  def _hash_state(state):\n      \"\"\"\n      Creates a hashable representation of the CraftState for the visited set.\n      Includes grid, inventory, position, and direction.\n      \"\"\"\n      # Convert numpy arrays to bytes for hashing, as arrays are not directly hashable.\n      grid_bytes = state.grid.tobytes()\n      inventory_bytes = state.inventory.tobytes()\n      return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n  # Get the initial state from the environment.\n  # Resetting ensures a consistent starting point.\n  _ = env.reset(seed=0)\n  initial_craft_state = env._current_state\n  initial_state_hash = _hash_state(initial_craft_state)\n\n  # If the target item is already in the inventory at the start, no actions are needed.\n  if initial_craft_state.satisfies(None, item):\n      return []\n\n  # Initialize the Breadth-First Search (BFS) queue.\n  # Each element in the queue is a tuple: (current_CraftState_object, current_depth).\n  # Storing depth allows for path length pruning without explicit path lists.\n  queue = deque()\n  queue.append((initial_craft_state, 0)) # (state, depth)\n\n  # Initialize the set of visited states to prevent cycles and redundant computations.\n  visited = set()\n  visited.add(initial_state_hash)\n\n  # Parent map for path reconstruction:\n  # Maps child_state_hash -> (parent_state_hash, action_taken_to_reach_child)\n  # This avoids storing full action lists in the queue, saving memory for long paths.\n  parent_map = {initial_state_hash: (None, None)} # Initial state has no parent\n\n  # Retrieve the maximum number of steps allowed for an episode from the environment.\n  # This acts as a maximum path length for the BFS.\n  max_path_length = env.max_steps\n\n  # Define all possible actions.\n  ALL_ACTIONS = [0, 1, 2, 3, 4] # DOWN, UP, LEFT, RIGHT, USE\n\n  # BFS main loop\n  while queue:\n      current_state, current_depth = queue.popleft()\n      current_state_hash = _hash_state(current_state)\n\n      # Pruning condition: If the current path length already equals or exceeds the maximum allowed steps,\n      # there's no need to explore further from this branch.\n      # Children generated from this state would exceed max_path_length.\n      if current_depth >= max_path_length:\n          continue\n\n      # Explore each possible action from the current state.\n      for action in ALL_ACTIONS:\n          # Apply the action to get the next state.\n          _, new_state = current_state.step(action)\n          new_state_hash = _hash_state(new_state)\n          new_depth = current_depth + 1\n\n          # If this new state has already been visited, skip it.\n          # In BFS, the first time we reach a state is via the shortest path,\n          # so we don't need to re-explore it.\n          if new_state_hash in visited:\n              continue\n\n          # Check if the goal (having the 'item' in inventory) is satisfied in the new state.\n          if new_state.satisfies(None, item):\n              # If the goal is satisfied, we've found the shortest sequence of actions.\n              # Now, reconstruct the path using the parent_map.\n              path = []\n              reconstruct_state_hash = new_state_hash\n              # Backtrack from the goal state to the initial state\n              while parent_map[reconstruct_state_hash][0] is not None:\n                  parent_hash, action_from_parent = parent_map[reconstruct_state_hash]\n                  path.append(action_from_parent)\n                  reconstruct_state_hash = parent_hash\n              path.reverse() # Reverse the path to get actions from start to goal\n              return path\n\n          # If the new state is not the goal and not visited, add it to the visited set,\n          # record its parent for reconstruction, and add it to the queue.\n          visited.add(new_state_hash)\n          parent_map[new_state_hash] = (current_state_hash, action)\n          queue.append((new_state, new_depth))\n\n  # If the queue becomes empty and the goal was not reached, it implies that the target item\n  # cannot be crafted from the initial state within the given `max_path_length`.\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:29:29.746334", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (assuming these are consistent with the DMLab-style environment)\n  # DOWN = 0\n  # UP = 1\n  # LEFT = 2\n  # RIGHT = 3\n  # USE = 4\n\n  def _find_path_to_adjacent(start_state, target_kind_indices, max_dist=50):\n    \"\"\"\n    Finds a sequence of actions (movements) to get the agent adjacent to any of the\n    specified target_kind_indices.\n\n    Args:\n      start_state: The initial CraftState from which to start pathfinding.\n      target_kind_indices: A list or set of integer indices of entities the agent\n                           needs to be adjacent to.\n      max_dist: Maximum number of steps to search for a path.\n\n    Returns:\n      A tuple (actions_list, final_state) if a path is found, where actions_list is\n      a list of integer actions and final_state is the CraftState reached.\n      Returns (None, None) if no path is found within max_dist.\n\n    This BFS considers the full state (grid, inventory, pos, dir) for its visited set\n    because moving can alter the inventory (e.g., by picking up grabbable items on the path).\n    \"\"\"\n    queue = collections.deque([(start_state, [])])\n    \n    # Visited set for this BFS: (grid_hash, inventory_tuple, pos_tuple, dir_int)\n    # Using grid.tobytes() for numpy array hashing, tuple for inventory.\n    visited = set()\n    initial_state_key = (\n        start_state.grid.tobytes(),\n        tuple(start_state.inventory),\n        start_state.pos,\n        start_state.dir\n    )\n    visited.add(initial_state_key)\n\n    while queue:\n        current_s, current_path = queue.popleft()\n\n        # Check if we are next to any target kind in the current state\n        for kind_idx in target_kind_indices:\n            if current_s.next_to(kind_idx):\n                return current_path, current_s # Found path to adjacency\n\n        if len(current_path) >= max_dist:\n            continue # Prune paths that are too long to limit search time\n\n        # Explore movement actions (0, 1, 2, 3 correspond to DOWN, UP, LEFT, RIGHT)\n        for action in range(4): # Iterate through actions 0 to 3\n            _, next_s = current_s.step(action) # reward is ignored\n            next_state_key = (\n                next_s.grid.tobytes(),\n                tuple(next_s.inventory),\n                next_s.pos,\n                next_s.dir\n            )\n\n            if next_state_key not in visited:\n                visited.add(next_state_key)\n                queue.append((next_s, current_path + [action]))\n    \n    return None, None # No path found within max_dist\n\n\n  def _recursive_craft(current_state, target_item_idx, cookbook,\n                       global_visited_states, max_recursion_depth=10, current_depth=0):\n    \"\"\"\n    Recursively finds actions to craft the target_item_idx.\n\n    Args:\n      current_state: The current CraftState of the agent.\n      target_item_idx: The integer index of the item to craft.\n      cookbook: The Cookbook instance from CraftWorld, containing recipes and primitives.\n      global_visited_states: A set of state keys (grid_hash, inv_tuple, pos, dir)\n                             to prevent re-exploring the *same* CraftState across\n                             all recursive calls.\n      max_recursion_depth: Maximum allowed recursion depth to prevent infinite loops\n                           for complex or impossible recipes.\n      current_depth: The current recursion depth (for internal tracking).\n\n    Returns:\n      A tuple (actions_list, final_state) if the item can be crafted, where\n      actions_list is a list of integer actions and final_state is the CraftState\n      after crafting the item.\n      Returns (None, None) if the item cannot be crafted.\n    \"\"\"\n    if current_depth > max_recursion_depth:\n        # Prevent excessively deep recursion\n        return None, None\n\n    # Base case: If the item is already in inventory, no actions needed.\n    if current_state.inventory[target_item_idx] > 0:\n        return [], current_state\n\n    # Case 1: Target item is a primitive resource (can be picked up from the grid)\n    if target_item_idx in cookbook.primitives:\n        # Pathfind to be adjacent to the primitive item on the grid\n        path_to_item, state_at_item = _find_path_to_adjacent(\n            current_state, [target_item_idx]\n        )\n\n        if path_to_item is not None:\n            # Once adjacent, apply the 'USE' action (action 4) to pick up the item.\n            _, final_state_after_pickup = state_at_item.step(4) # 4 is USE action\n            \n            # Verify if the item was successfully picked up\n            if final_state_after_pickup.inventory[target_item_idx] > 0:\n                # Add the new state to the global visited set\n                final_state_key = (\n                    final_state_after_pickup.grid.tobytes(),\n                    tuple(final_state_after_pickup.inventory),\n                    final_state_after_pickup.pos,\n                    final_state_after_pickup.dir\n                )\n                global_visited_states.add(final_state_key)\n                return path_to_item + [4], final_state_after_pickup\n        return None, None # Cannot acquire primitive\n\n    # Case 2: Target item is a crafted item (requires a recipe)\n    if target_item_idx not in cookbook.recipes:\n        # If not a primitive and no recipe, it cannot be acquired.\n        return None, None\n\n    recipe = cookbook.recipes[target_item_idx]\n    \n    ingredients_needed = {}\n    workshop_idx = -1 # Sentinel value, assumes no workshop if not explicitly in recipe\n    for k, v in recipe.items():\n        if k == \"_key\":\n            workshop_idx = v # \"_key\" specifies the required workshop (e.g., workbench index)\n        else:\n            ingredients_needed[k] = v # k is ingredient_index, v is count\n\n    total_actions = []\n    current_working_state = current_state\n\n    # Step 1: Recursively gather all required ingredients\n    for ingredient_idx, count_needed in ingredients_needed.items():\n        # Keep getting the ingredient until the required count is met\n        while current_working_state.inventory[ingredient_idx] < count_needed:\n            actions_to_get_one, state_after_get = _recursive_craft(\n                current_working_state, ingredient_idx, cookbook,\n                global_visited_states, max_recursion_depth, current_depth + 1\n            )\n            \n            if actions_to_get_one is None:\n                return None, None # Failed to get this ingredient\n            \n            total_actions.extend(actions_to_get_one)\n            current_working_state = state_after_get\n            \n            # Mark the new intermediate state as globally visited\n            state_key = (\n                current_working_state.grid.tobytes(),\n                tuple(current_working_state.inventory),\n                current_working_state.pos,\n                current_working_state.dir\n            )\n            global_visited_states.add(state_key)\n\n    # Step 2: All ingredients gathered. Now, move to the workshop (if required) and USE it.\n    if workshop_idx != -1: # If a specific workshop is part of the recipe\n        path_to_workshop, state_at_workshop = _find_path_to_adjacent(\n            current_working_state, [workshop_idx]\n        )\n        if path_to_workshop is None:\n            return None, None # Cannot reach the required workshop\n\n        total_actions.extend(path_to_workshop)\n        current_working_state = state_at_workshop\n\n    # Step 3: Try to USE (craft)\n    # The `CraftState.step(4)` (USE action) handles the crafting logic:\n    # it checks if the agent has ingredients and is next to the correct workshop (if applicable).\n    # It will consume ingredients and add the crafted item to inventory if successful.\n    _, final_state_after_craft = current_working_state.step(4) # 4 is USE action\n    \n    # Verify if crafting was successful by checking inventory\n    if final_state_after_craft.inventory[target_item_idx] > 0:\n        total_actions.append(4) # Add USE action to the plan\n        \n        # Add the final state to global visited before returning\n        final_state_key = (\n            final_state_after_craft.grid.tobytes(),\n            tuple(final_state_after_craft.inventory),\n            final_state_after_craft.pos,\n            final_state_after_craft.dir\n        )\n        global_visited_states.add(final_state_key)\n\n        return total_actions, final_state_after_craft\n    else:\n        # Crafting failed (e.g., implicit conditions not met, or environmental factors)\n        return None, None\n\n\n  start_state = env._current_state\n  cookbook = env.world.cookbook\n  target_item_idx = item\n\n  # Check if item is already in the initial inventory\n  if start_state.inventory[target_item_idx] > 0:\n      return []\n\n  # Initialize a set to keep track of globally visited states.\n  # This prevents redundant computations and infinite loops in the search.\n  # A state is defined by (grid_content, inventory_content, agent_position, agent_direction).\n  # We use grid.tobytes() for numpy array hashing, tuple(inventory) for inventory hashing.\n  global_visited_states = set()\n  initial_state_key = (\n      start_state.grid.tobytes(),\n      tuple(start_state.inventory),\n      start_state.pos,\n      start_state.dir\n  )\n  global_visited_states.add(initial_state_key)\n\n  # Start the recursive crafting search\n  actions, _ = _recursive_craft(\n      start_state, target_item_idx, cookbook, global_visited_states\n  )\n  \n  return actions if actions is not None else []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T00:29:30.749314", "function_name": "craft", "function_body": "  # Get action constants from env_factory\n  ACTIONS = env_factory.ACTIONS\n\n  # Access CraftWorld and Cookbook instances\n  cookbook = env.world.cookbook\n  world = env.world # CraftWorld instance\n\n  # Helper 1: BFS to find a path for the agent to land ON a target position.\n  # Returns a list of actions (UP, DOWN, LEFT, RIGHT) to reach target_pos.\n  # Assumes the grid is static for pathfinding; `step` handles blocked cells.\n  def _bfs_find_path_to_target_pos(start_state, target_pos):\n      q = deque([(start_state, [])]) # (current_state, path_so_far)\n      # Visited states: (pos_x, pos_y) to prevent redundant exploration and loops.\n      visited = set([(start_state.pos[0], start_state.pos[1])]) \n\n      # Define possible movement directions and their corresponding actions.\n      moves = {\n          ACTIONS.UP:    (0, -1),\n          ACTIONS.DOWN:  (0, 1),\n          ACTIONS.LEFT:  (-1, 0),\n          ACTIONS.RIGHT: (1, 0),\n      }\n\n      grid_shape = start_state.grid.shape\n      width, height = grid_shape[0], grid_shape[1]\n\n      # Helper to check if a coordinate is within grid boundaries.\n      def _is_valid_grid_coord(x, y):\n          return 0 <= x < width and 0 <= y < height\n\n      while q:\n          current_state_bfs, path_bfs = q.popleft()\n          current_pos_bfs = current_state_bfs.pos\n\n          # If the current position is the target, we've found a path.\n          if current_pos_bfs == target_pos:\n              return path_bfs\n\n          # Explore neighboring cells.\n          for action_val, (dx, dy) in moves.items():\n              new_x, new_y = current_pos_bfs[0] + dx, current_pos_bfs[1] + dy\n\n              # Skip if outside grid boundaries.\n              if not _is_valid_grid_coord(new_x, new_y):\n                  continue\n              \n              next_pos_tuple = (new_x, new_y)\n              # Skip if this position has already been visited in this BFS.\n              if next_pos_tuple in visited:\n                  continue\n              \n              # Simulate taking the action to get the next state.\n              # CraftState.step handles collisions; if a move is blocked,\n              # next_state_bfs.pos will be the same as current_pos_bfs.\n              _reward, next_state_bfs = current_state_bfs.step(action_val)\n              \n              # If the agent didn't actually move (e.g., hit a wall), skip this path.\n              if next_state_bfs.pos == current_pos_bfs:\n                  continue\n\n              # Mark the new position as visited and add to queue.\n              visited.add((next_state_bfs.pos[0], next_state_bfs.pos[1]))\n              new_path = path_bfs + [action_val]\n              q.append((next_state_bfs, new_path))\n      \n      return [] # No path found to the target position.\n\n  # Helper 2: BFS to find a path for the agent to land ADJACENT to a target position.\n  # Returns a list of actions to reach a cell in the 3x3 neighborhood (excluding target_pos itself).\n  def _bfs_find_path_to_adjacent_to_target(start_state, target_pos):\n      q = deque([(start_state, [])]) # (current_state, path_so_far)\n      visited = set([(start_state.pos[0], start_state.pos[1])]) \n\n      moves = {\n          ACTIONS.UP:    (0, -1),\n          ACTIONS.DOWN:  (0, 1),\n          ACTIONS.LEFT:  (-1, 0),\n          ACTIONS.RIGHT: (1, 0),\n      }\n\n      grid_shape = start_state.grid.shape\n      width, height = grid_shape[0], grid_shape[1]\n\n      def _is_valid_grid_coord(x, y):\n          return 0 <= x < width and 0 <= y < height\n\n      while q:\n          current_state_bfs, path_bfs = q.popleft()\n          current_pos_bfs = current_state_bfs.pos\n\n          tx, ty = target_pos\n          # Check if the current position is in the 3x3 neighborhood of target_pos (excluding target_pos itself).\n          if (abs(current_pos_bfs[0] - tx) <= 1 and abs(current_pos_bfs[1] - ty) <= 1) and \\\n             (current_pos_bfs[0] != tx or current_pos_bfs[1] != ty):\n              return path_bfs # Agent is adjacent!\n          \n          for action_val, (dx, dy) in moves.items():\n              new_x, new_y = current_pos_bfs[0] + dx, current_pos_bfs[1] + dy\n\n              if not _is_valid_grid_coord(new_x, new_y):\n                  continue\n              \n              next_pos_tuple = (new_x, new_y)\n              if next_pos_tuple in visited:\n                  continue\n              \n              _reward, next_state_bfs = current_state_bfs.step(action_val)\n              \n              if next_state_bfs.pos == current_pos_bfs:\n                  continue\n\n              visited.add((next_state_bfs.pos[0], next_state_bfs.pos[1]))\n              new_path = path_bfs + [action_val]\n              q.append((next_state_bfs, new_path))\n      \n      return [] # No path found to be adjacent to the target position.\n\n  # Helper 3: Recursive function to collect a specific item (either primitive or crafted).\n  # Returns a tuple: (list of actions taken, final CraftState after actions) or ([], None) if failed.\n  def _collect_item(current_state, goal_idx, max_depth=20): # Limiting recursion depth to prevent infinite loops/stack overflow\n      if max_depth <= 0:\n          return [], None # Max recursion depth reached, cannot collect.\n\n      actions_taken = []\n      state = current_state\n\n      # Base case: If the item is already in inventory, no actions needed.\n      if state.inventory[goal_idx] > 0:\n          return [], state\n\n      # Case 1: The goal item is a primitive resource.\n      if goal_idx in cookbook.primitives:\n          # Check if this primitive is grabbable.\n          if goal_idx in world.non_grabbable_indices:\n              return [], None # Cannot grab this primitive (e.g., a fixed rock or environment feature).\n\n          target_pos = None\n          grid = state.grid\n          width, height, _ = grid.shape\n          \n          # Search the grid for the location of the primitive item.\n          for x in range(width):\n              for y in range(height):\n                  if grid[x, y, goal_idx] > 0:\n                      target_pos = (x, y)\n                      break\n              if target_pos: # Found the item.\n                  break\n          \n          if not target_pos:\n              return [], None # Primitive item not found on grid.\n\n          # Plan a path to move the agent ONTO the target_pos.\n          path_actions = _bfs_find_path_to_target_pos(state, target_pos)\n          \n          # Simulate the path actions.\n          current_state_after_path = state\n          for action_step in path_actions:\n              actions_taken.append(action_step)\n              _reward, current_state_after_path = current_state_after_path.step(action_step)\n          \n          # Agent is now at target_pos. Perform the USE action to pick up the item.\n          actions_taken.append(ACTIONS.USE)\n          _reward, final_state = current_state_after_path.step(ACTIONS.USE)\n          \n          # Check if the item was successfully collected.\n          if final_state.inventory[goal_idx] > 0:\n              return actions_taken, final_state\n          else:\n              return [], None # Failed to pick up the item after USE.\n\n      # Case 2: The goal item is a crafted item (has a recipe).\n      if goal_idx in cookbook.recipes:\n          recipe = cookbook.recipes[goal_idx]\n          # Extract ingredient indices and their counts, ignoring the \"_key\".\n          ingredients_needed = {idx: count for idx, count in recipe.items() if isinstance(idx, int)}\n          crafting_key = recipe.get(\"_key\") # E.g., \"workshop\", \"water\", \"stone\".\n\n          current_state_for_ingredients = state\n          total_actions_for_ingredients = []\n\n          # Recursively collect all necessary ingredients.\n          for ingredient_idx, needed_count in ingredients_needed.items():\n              # Calculate how many of this ingredient are actually still needed (not already in inventory).\n              actual_needed = max(0, needed_count - current_state_for_ingredients.inventory[ingredient_idx])\n              \n              for _ in range(actual_needed):\n                  # Recursive call to collect each missing ingredient.\n                  ingredient_actions, state_after_ingredient = _collect_item(\n                      current_state_for_ingredients, ingredient_idx, max_depth - 1 # Decrement depth for recursion.\n                  )\n                  if state_after_ingredient is None:\n                      return [], None # Failed to get an ingredient, so cannot craft the main item.\n                  total_actions_for_ingredients.extend(ingredient_actions)\n                  current_state_for_ingredients = state_after_ingredient\n\n          # All ingredients have been collected. Now, move to the crafting location (if required) and craft.\n          crafting_target_kind_idx = None\n          if crafting_key == \"workshop\":\n              # Assuming `workshop_indices` is a list and we pick the first available workshop.\n              crafting_target_kind_idx = world.workshop_indices[0] if world.workshop_indices else None\n          elif crafting_key == \"water\":\n              crafting_target_kind_idx = world.water_index\n          elif crafting_key == \"stone\":\n              crafting_target_kind_idx = world.stone_index\n          # Extend this with other `_key` types like \"lava\", \"tree\", \"plant\" if they are valid crafting stations.\n          \n          if crafting_target_kind_idx is not None:\n              crafting_pos_on_grid = None\n              grid = current_state_for_ingredients.grid\n              width, height, _ = grid.shape\n              # Search for an instance of the required crafting location on the grid.\n              for x in range(width):\n                  for y in range(height):\n                      if grid[x, y, crafting_target_kind_idx] > 0:\n                          crafting_pos_on_grid = (x, y)\n                          break\n                  if crafting_pos_on_grid:\n                      break\n              \n              if not crafting_pos_on_grid:\n                  return [], None # Required crafting location not found on the map.\n\n              # Agent needs to be *adjacent* to the crafting location to perform USE for crafting.\n              path_to_crafting_location = _bfs_find_path_to_adjacent_to_target(\n                  current_state_for_ingredients, crafting_pos_on_grid\n              )\n              if not path_to_crafting_location:\n                  return [], None # Cannot reach the crafting location.\n\n              # Simulate the path to the crafting location.\n              for action_step in path_to_crafting_location:\n                  total_actions_for_ingredients.append(action_step)\n                  _reward, current_state_for_ingredients = current_state_for_ingredients.step(action_step)\n          \n          # Agent is now in the correct position (adjacent to crafting station or at primitive).\n          # Perform the USE action to attempt crafting.\n          total_actions_for_ingredients.append(ACTIONS.USE)\n          _reward, final_state = current_state_for_ingredients.step(ACTIONS.USE)\n\n          # Check if crafting was successful (item appeared in inventory).\n          if final_state.inventory[goal_idx] > 0:\n              return total_actions_for_ingredients, final_state\n          else:\n              return [], None # Crafting failed (e.g., incorrect location, insufficient ingredients, or other unmodeled complexities).\n      \n      # If the item is neither a primitive nor has a defined recipe, it cannot be crafted or collected.\n      return [], None\n\n  # --- Main execution logic for craft_v2 ---\n  # Get the initial state of the environment.\n  initial_state = env._current_state\n  \n  # Attempt to collect the target item using the recursive planner.\n  final_actions, final_state = _collect_item(initial_state, item)\n\n  # Verify if the goal item was successfully acquired in the final simulated state.\n  if final_state is not None and final_state.inventory[item] > 0:\n      return final_actions # Return the sequence of actions.\n  else:\n      return [] # If the goal was not achieved, return an empty list of actions.", "island_id": 7, "scores": {"3": -1}}
