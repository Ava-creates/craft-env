{"timestamp": "2025-07-30T00:10:09.824437", "function_name": "craft", "function_body": "    import collections\n    import numpy as np # Assuming numpy is available from the environment\n\n    # Actions constants\n    DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n    MOVE_ACTIONS = [DOWN, UP, LEFT, RIGHT]\n\n    # Directions to delta_row, delta_col\n    # 0: North, 1: East, 2: South, 3: West\n    DIR_TO_VEC = {\n        0: (-1, 0),  # N (row decreases)\n        1: (0, 1),   # E (col increases)\n        2: (1, 0),   # S (row increases)\n        3: (0, -1),  # W (col decreases)\n    }\n\n    # Helper to calculate position in front of agent\n    def get_adjacent_cell_in_front(pos, direction):\n        r, c = pos\n        dr, dc = DIR_TO_VEC[direction]\n        return (r + dr, c + dc)\n\n    # Helper for BFS pathfinding\n    def find_path_to_interaction_target(start_state, world, target_kind_idx):\n        \"\"\"\n        Finds a path (movement actions only) to a cell containing target_kind_idx,\n        such that the agent is adjacent to it and facing it.\n        Returns (path_actions, end_state_after_path).\n        Returns None, None if no path found.\n        \"\"\"\n        queue = collections.deque([(start_state, [])]) # (CraftState, path_actions)\n        \n        # Visited states: (pos, dir) for movement BFS.\n        # We assume the grid and inventory are static during pathfinding for simplicity,\n        # and that the target item won't be removed until we USE it.\n        visited = set([(start_state.pos, start_state.dir)])\n        \n        grid_h, grid_w, _ = start_state.grid.shape\n        \n        while queue:\n            current_pathfinding_state, path = queue.popleft()\n\n            # Check if current_pathfinding_state meets the criteria for interaction\n            # We need to be adjacent to a cell with target_kind_idx AND facing it.\n            adj_r, adj_c = get_adjacent_cell_in_front(current_pathfinding_state.pos, current_pathfinding_state.dir)\n            \n            # Ensure adj_r, adj_c is within grid bounds\n            if 0 <= adj_r < grid_h and 0 <= adj_c < grid_w:\n                # Check if the target kind is actually at the adjacent cell\n                if current_pathfinding_state.grid[adj_r, adj_c, target_kind_idx] > 0:\n                    return path, current_pathfinding_state # Path found!\n\n            # Explore neighbors (movement actions only)\n            for action in MOVE_ACTIONS:\n                _, next_pathfinding_state = current_pathfinding_state.step(action)\n                state_key = (next_pathfinding_state.pos, next_pathfinding_state.dir)\n                if state_key not in visited:\n                    visited.add(state_key)\n                    queue.append((next_pathfinding_state, path + [action]))\n                    \n        return None, None # No path found\n\n    # A global limit for total actions to prevent excessively long plans\n    MAX_TOTAL_ACTIONS = 200 \n\n    def plan_to_get_item(current_state_in_plan, world, target_item_idx, current_actions_in_plan):\n        \"\"\"\n        Recursively plans actions to obtain `target_item_idx`.\n        Modifies `current_actions_in_plan` and returns the new `current_state_in_plan`.\n        Returns None, None if plan is impossible or exceeds max actions.\n        \"\"\"\n        cookbook = world.cookbook\n\n        # Base case: if item is already in inventory\n        if current_state_in_plan.inventory[target_item_idx] > 0:\n            return current_actions_in_plan, current_state_in_plan\n\n        # Primitives: find, go, use (pick up)\n        if target_item_idx in cookbook.primitives:\n            # Need to pick up one instance of this primitive\n            path_actions, _ = find_path_to_interaction_target(current_state_in_plan, world, target_item_idx)\n            \n            if path_actions is None:\n                return None, None # Cannot find or reach the primitive\n\n            # Apply path actions\n            for action in path_actions:\n                _, current_state_in_plan = current_state_in_plan.step(action)\n                current_actions_in_plan.append(action)\n                if len(current_actions_in_plan) > MAX_TOTAL_ACTIONS: return None, None # Exceeded limit\n            \n            # Perform USE action to pick up the item\n            prev_inv_count = current_state_in_plan.inventory[target_item_idx]\n            _, current_state_in_plan = current_state_in_plan.step(USE)\n            current_actions_in_plan.append(USE)\n            if len(current_actions_in_plan) > MAX_TOTAL_ACTIONS: return None, None # Exceeded limit\n\n            if current_state_in_plan.inventory[target_item_idx] > prev_inv_count:\n                return current_actions_in_plan, current_state_in_plan # Successfully picked up\n            else:\n                # Failed to pick up after reaching (e.g. item was transient, not grabbable).\n                # For this problem, we assume it's grabbable if it's a primitive and present.\n                return None, None \n        \n        # Crafted items: get ingredients, then craft\n        elif target_item_idx in cookbook.recipes:\n            recipe = cookbook.recipes[target_item_idx]\n            \n            # Determine required ingredients for this recipe (for one instance of target_item_idx)\n            required_ingredients_for_recipe = {}\n            for ing_idx, ing_count in recipe.items():\n                if ing_idx == \"_key\":\n                    continue\n                \n                # For crafting one target_item_idx, we need `ing_count` of `ing_idx`.\n                current_inv_count = current_state_in_plan.inventory[ing_idx]\n                if ing_count > current_inv_count:\n                    required_ingredients_for_recipe[ing_idx] = ing_count - current_inv_count\n\n            # Recursively plan to get each missing ingredient\n            for ing_idx_needed, count_needed in required_ingredients_for_recipe.items():\n                for _ in range(count_needed): # Ensure we get `count_needed` instances of this ingredient\n                    current_actions_in_plan, current_state_in_plan = plan_to_get_item(\n                        current_state_in_plan, world, ing_idx_needed, current_actions_in_plan\n                    )\n                    if current_actions_in_plan is None:\n                        return None, None # Failed to get an ingredient\n\n            # After ingredients are satisfied, craft the item\n            workshop_key = recipe.get(\"_key\")\n            workshop_idx = None\n            if workshop_key:\n                workshop_idx = cookbook.index[workshop_key]\n                if workshop_idx is None:\n                    # This implies a malformed recipe or unknown workshop\n                    return None, None \n            \n            # Go to workshop (if needed) and USE\n            if workshop_idx is not None:\n                path_actions, _ = find_path_to_interaction_target(current_state_in_plan, world, workshop_idx)\n                if path_actions is None:\n                    return None, None # Cannot reach workshop\n\n                for action in path_actions:\n                    _, current_state_in_plan = current_state_in_plan.step(action)\n                    current_actions_in_plan.append(action)\n                    if len(current_actions_in_plan) > MAX_TOTAL_ACTIONS: return None, None # Exceeded limit\n\n                # Perform USE action at workshop\n                prev_inv_count = current_state_in_plan.inventory[target_item_idx]\n                _, current_state_in_plan = current_state_in_plan.step(USE)\n                current_actions_in_plan.append(USE)\n                if len(current_actions_in_plan) > MAX_TOTAL_ACTIONS: return None, None # Exceeded limit\n\n                if current_state_in_plan.inventory[target_item_idx] > prev_inv_count:\n                    return current_actions_in_plan, current_state_in_plan # Successfully crafted\n                else:\n                    return None, None # Failed to craft at workshop\n            else: # No workshop needed (e.g., \"in-place\" crafting)\n                # Perform USE action in current location, assuming it triggers crafting\n                prev_inv_count = current_state_in_plan.inventory[target_item_idx]\n                _, current_state_in_plan = current_state_in_plan.step(USE)\n                current_actions_in_plan.append(USE)\n                if len(current_actions_in_plan) > MAX_TOTAL_ACTIONS: return None, None # Exceeded limit\n\n                if current_state_in_plan.inventory[target_item_idx] > prev_inv_count:\n                    return current_actions_in_plan, current_state_in_plan # Successfully crafted\n                else:\n                    return None, None # Failed to craft without specific workshop\n                \n        return None, None # Item type not recognized or uncraftable\n\n    # Get the initial state from the environment\n    initial_state = env._current_state\n    world = env.world\n\n    # Start the recursive planning process for the target item\n    final_plan_actions, final_state = plan_to_get_item(initial_state, world, item, [])\n\n    if final_plan_actions is None:\n        # If the planning process failed for any reason, return an empty list\n        return [] \n\n    return final_plan_actions", "island_id": 9, "scores": {"3": -1}}
