{"timestamp": "2025-07-30T00:12:28.996136", "function_name": "craft", "function_body": "  import collections\n  import numpy as np\n\n  # Action constants (from CraftLab.action_specs)\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to delta (row, col)\n  MOVE_DELTAS = {\n      ACTION_DOWN: (1, 0),\n      ACTION_UP: (-1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1),\n  }\n\n  # Map (dr, dc) (vector from agent to target) to the action index\n  # representing the direction the agent must face.\n  DELTAS_TO_FACE_ACTIONS = {\n      (1, 0): ACTION_DOWN,    # Target is (r+1, c), agent needs to face DOWN\n      (-1, 0): ACTION_UP,     # Target is (r-1, c), agent needs to face UP\n      (0, -1): ACTION_LEFT,   # Target is (r, c-1), agent needs to face LEFT\n      (0, 1): ACTION_RIGHT,   # Target is (r, c+1), agent needs to face RIGHT\n  }\n\n  def _get_abs_pos_of_item(grid, item_idx):\n    \"\"\"\n    Finds the absolute (row, col) coordinates of the first occurrence of item_idx on the grid.\n    Returns (row, col) tuple or None if not found.\n    \"\"\"\n    grid_rows, grid_cols, _ = grid.shape\n    for r in range(grid_rows):\n      for c in range(grid_cols):\n        # Check if the item kind is present in this cell\n        if grid[r, c, item_idx] > 0:\n          return (r, c)\n    return None\n\n  def _get_path_and_face_target(start_pos, start_dir, target_pos, grid_shape):\n    \"\"\"\n    Finds a path (sequence of movement actions) from start_pos to a cell\n    adjacent to target_pos, such that the agent ends up facing target_pos.\n\n    Args:\n      start_pos (tuple): (row, col) of the agent's starting position.\n      start_dir (int): Agent's starting direction (0-3).\n      target_pos (tuple): (row, col) of the target item/workshop.\n      grid_shape (tuple): Shape of the grid (rows, cols, kinds).\n\n    Returns:\n      tuple: (list_of_actions, final_pos, final_dir) if a path is found.\n             Returns None if no path exists.\n    \"\"\"\n    rows, cols, _ = grid_shape\n\n    # BFS state: ((current_row, current_col), current_direction, list_of_actions_taken_to_reach_this_state)\n    q = collections.deque([(start_pos, start_dir, [])])\n    # Visited set to prevent cycles and redundant exploration: ((row, col), direction)\n    visited = set([(start_pos, start_dir)])\n\n    while q:\n      (curr_r, curr_c), curr_dir, path_actions = q.popleft()\n\n      # Check if the current position is adjacent to the target_pos\n      # and if the agent is facing the target_pos. This is our goal condition.\n      face_dr, face_dc = (target_pos[0] - curr_r, target_pos[1] - curr_c)\n\n      is_adjacent = abs(face_dr) + abs(face_dc) == 1  # Manhattan distance of 1\n      required_face_action = DELTAS_TO_FACE_ACTIONS.get((face_dr, face_dc))\n\n      if is_adjacent and required_face_action is not None and curr_dir == required_face_action:\n        # Goal reached: agent is adjacent to target and facing it.\n        return (path_actions, (curr_r, curr_c), curr_dir)\n\n      # Explore possible next states by taking a movement action (UP, DOWN, LEFT, RIGHT)\n      for action_to_take in [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]:\n        dr, dc = MOVE_DELTAS[action_to_take]\n        next_r, next_c = curr_r + dr, curr_c + dc\n\n        # Check if the next position is within grid boundaries\n        if not (0 <= next_r < rows and 0 <= next_c < cols):\n          continue\n\n        # The agent's new direction will be the direction of the movement action itself\n        next_dir = action_to_take\n        next_state_key = ((next_r, next_c), next_dir)\n\n        if next_state_key not in visited:\n          visited.add(next_state_key)\n          q.append(((next_r, next_c), next_dir, path_actions + [action_to_take]))\n\n    return None  # No path found to be adjacent and facing the target\n\n  def _simulate_actions_on_state(initial_state, actions):\n    \"\"\"\n    Applies a list of actions to a copy of the initial state.\n    Returns the resulting state.\n    Assumes CraftState.step creates a new state object.\n    \"\"\"\n    current_sim_state = initial_state\n    for action in actions:\n      _, current_sim_state = current_sim_state.step(action)\n    return current_sim_state\n\n  def _navigate_to_and_use_target(sim_state, target_idx):\n    \"\"\"\n    Generates actions to find a target (item or workshop) on the grid, move to it,\n    face it, and then apply the USE action.\n\n    Args:\n      sim_state (CraftState): The current simulated state. This object will be\n                               updated to reflect the actions taken.\n      target_idx (int): The index of the item or workshop to target.\n\n    Returns:\n      tuple: A tuple containing (list of actions, updated_sim_state).\n             Returns ([], original_sim_state) if the target cannot be found or reached.\n    \"\"\"\n    actions_generated = []\n\n    # 1. Find the absolute position of the target on the grid\n    target_pos = _get_abs_pos_of_item(sim_state.grid, target_idx)\n\n    if target_pos is None:\n      # Target not found on grid, cannot collect/use.\n      return [], sim_state\n\n    # 2. Get the path to be adjacent to the target and face it\n    path_result = _get_path_and_face_target(sim_state.pos, sim_state.dir, target_pos, sim_state.grid.shape)\n\n    if path_result is None:\n      # Cannot reach the target\n      return [], sim_state\n\n    path_actions, _, _ = path_result  # We only need the actions from the path result\n\n    # 3. Simulate movement actions and append them to the list of generated actions\n    sim_state_after_move = _simulate_actions_on_state(sim_state, path_actions)\n    actions_generated.extend(path_actions)\n\n    # 4. Apply the USE action\n    _, sim_state_after_use = sim_state_after_move.step(ACTION_USE)\n    actions_generated.append(ACTION_USE)\n\n    return actions_generated, sim_state_after_use\n\n  all_actions = []\n\n  # Get initial state and world/cookbook references\n  # CraftState.step creates new objects, so we just need to keep track of the current simulated state.\n  simulated_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Check if the item is already crafted in the initial state\n  if simulated_state.inventory[item] > 0:\n    return []\n\n  # Identify all primitive components needed for the target item.\n  # The `primitives_for` method is assumed to recursively find all base ingredients.\n  required_primitives = cookbook.primitives_for(item)\n\n  # Phase 1: Collect all required primitive items from the grid\n  for primitive_idx, count_needed in required_primitives.items():\n    while simulated_state.inventory[primitive_idx] < count_needed:\n      # Attempt to find and collect one instance of the primitive\n      collection_actions, new_sim_state = _navigate_to_and_use_target(\n          simulated_state, primitive_idx\n      )\n      if not collection_actions:\n        # Could not collect the required primitive. This means it's not on the grid\n        # or unreachable given the current state.\n        # Return actions collected so far, indicating a partial or failed plan.\n        return all_actions\n\n      all_actions.extend(collection_actions)\n      simulated_state = new_sim_state  # Update the current simulated state\n\n  # Phase 2: Craft the item if it has a recipe\n  # Check if the item itself is in the cookbook's recipes (i.e., it's craftable, not a primitive)\n  if item in cookbook.recipes:\n    recipe = cookbook.recipes[item]\n\n    workshop_needed_idx = None\n    # Iterate through the recipe ingredients to find if a workshop is required.\n    for ingredient_key, _ in recipe.items():\n      # If an ingredient key is an integer and is a known workshop index, use that specific workshop.\n      if isinstance(ingredient_key, int) and ingredient_key in env.world.workshop_indices:\n        workshop_needed_idx = ingredient_key\n        break\n      # If the literal string \"_key\" is present as a key, it implies a generic workshop.\n      # Use the first workshop index from `env.world.workshop_indices` available in the world.\n      elif isinstance(ingredient_key, str) and ingredient_key == \"_key\":\n        if env.world.workshop_indices:\n          workshop_needed_idx = env.world.workshop_indices[0]\n          break\n\n    if workshop_needed_idx is not None:\n      # Navigate to the required workshop and use it to craft.\n      craft_actions, new_sim_state = _navigate_to_and_use_target(\n          simulated_state, workshop_needed_idx\n      )\n      if not craft_actions:\n        # Could not reach/use the workshop.\n        return all_actions\n\n      all_actions.extend(craft_actions)\n      simulated_state = new_sim_state  # Update current simulated state\n    else:\n      # If the item is craftable (in recipes) but no workshop was explicitly found\n      # in its recipe ingredients, or no workshop is present in the world.\n      # In CraftWorld, crafting typically requires a workshop.\n      # For now, we assume if no workshop_needed_idx, it means it cannot be crafted this way.\n      pass # No additional actions for crafting if no workshop is involved/identified\n\n  # Final check: If the goal item is now in the simulated inventory, the plan succeeded.\n  if simulated_state.inventory[item] > 0:\n    return all_actions\n  else:\n    # If we reached here but the item is not crafted, it means the plan failed partially\n    # (e.g., could not collect all primitives, or could not use workshop).\n    # Return the actions generated so far.\n    return all_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:12:29.962422", "function_name": "craft", "function_body": "  def _get_hashable_state(state):\n    \"\"\"Returns a hashable representation of a CraftState.\n    This is crucial for the visited set in BFS to avoid cycles and redundant work.\n    \"\"\"\n    # numpy arrays are not directly hashable. Convert them to bytes for efficiency.\n    grid_hash = state.grid.tobytes()\n    inventory_hash = state.inventory.tobytes()\n    # pos (tuple) and dir (int) are already hashable.\n    return (grid_hash, inventory_hash, state.pos, state.dir)\n\n  start_state = env._current_state\n  goal_item_idx = item\n\n  # Queue for BFS: stores (current_state, list_of_actions_taken_to_reach_this_state)\n  frontier = collections.deque([(start_state, [])])\n\n  # Set to keep track of visited states to avoid cycles and redundant computation.\n  # Stores hashable representations of states using the helper function.\n  visited = {_get_hashable_state(start_state)}\n\n  while frontier:\n    current_state, actions_path = frontier.popleft()\n\n    # Check if the current state satisfies the goal.\n    # The goal_name argument for satisfies() is ignored by CraftState, so any string is fine.\n    if current_state.satisfies(\"goal\", goal_item_idx):\n      return actions_path\n\n    # Explore possible next states.\n    # The actions are 0=DOWN, 1=UP, 2=LEFT, 3=RIGHT, 4=USE. Total 5 actions.\n    for action in range(5):\n      # CraftState.step returns a new state object without modifying the current_state.\n      _, next_state = current_state.step(action)\n\n      next_state_hash = _get_hashable_state(next_state)\n\n      if next_state_hash not in visited:\n        visited.add(next_state_hash)\n        frontier.append((next_state, actions_path + [action]))\n\n  # If the frontier becomes empty and the goal was not reached, it means\n  # the item cannot be crafted from the initial state within the explored search space.\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:15:00.013220", "function_name": "craft", "function_body": "  import collections\n\n  # Action Constants (assuming these are standard for CraftLab)\n  DOWN = 0\n  UP = 1\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  # Direction deltas (dx, dy) for each direction (North, East, South, West)\n  # Used to determine the coordinates of the cell directly in front of the agent.\n  DIR_TO_DELTAS = {\n      0: (0, -1),  # North: agent moves/looks in negative Y direction\n      1: (1, 0),   # East: agent moves/looks in positive X direction\n      2: (0, 1),   # South: agent moves/looks in positive Y direction\n      3: (-1, 0)   # West: agent moves/looks in negative X direction\n  }\n\n  # Cache for memoization in the recursive planner.\n  # Maps (simplified_state_tuple, target_item_idx) -> (success_bool, actions_list)\n  # This cache is cleared at the beginning of each call to craft_v1.\n  _PLANNER_CACHE = {}\n\n  # A hard limit on the total number of actions in a plan.\n  # Prevents infinite loops in complex or impossible scenarios.\n  _MAX_PLANNER_ACTIONS = 200\n\n  def _get_simplified_state_tuple(state):\n    \"\"\"\n    Returns a simplified tuple representing the CraftState for memoization.\n    It considers agent's position, direction, and inventory. Grid state is not\n    part of this tuple to simplify memoization, assuming grid changes (like\n    items disappearing after pickup) are reflected in inventory changes.\n    \"\"\"\n    return (state.pos, state.dir, tuple(state.inventory))\n\n  def _simulate_actions(initial_state, actions):\n    \"\"\"\n    Applies a sequence of actions to an initial CraftState and returns the\n    final CraftState after all actions are performed.\n    \"\"\"\n    current_s = initial_state\n    for action in actions:\n      _, current_s = current_s.step(action)\n    return current_s\n\n  def _bfs_move_to_kind(start_state, target_kind_idx, max_steps_for_move):\n    \"\"\"\n    Performs a Breadth-First Search (BFS) to find a path (sequence of move actions)\n    that leads the agent to a position where `target_kind_idx` is on a\n    *cardinally adjacent* cell.\n    \n    Args:\n      start_state: The initial CraftState for the BFS.\n      target_kind_idx: The integer index of the item/entity to move towards.\n      max_steps_for_move: Maximum number of movement steps allowed for this BFS.\n      \n    Returns:\n      (final_state, actions_list) if a path is found and successful,\n      else (None, None). The final_state will be next to the target,\n      but not necessarily facing it.\n    \"\"\"\n    q = collections.deque([(start_state, [])])\n    visited = {_get_simplified_state_tuple(start_state)}\n\n    steps_taken_in_bfs = 0\n    while q and steps_taken_in_bfs < max_steps_for_move:\n      current_s, current_actions = q.popleft()\n\n      # Check if current_s is already positioned such that `target_kind_idx`\n      # is on a cardinal neighbor.\n      for dx_check, dy_check in DIR_TO_DELTAS.values(): # Iterate over cardinal directions\n        nx, ny = current_s.pos[0] + dx_check, current_s.pos[1] + dy_check\n        WIDTH, HEIGHT, _ = current_s.grid.shape\n        \n        if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n          if current_s.grid[nx, ny, target_kind_idx] > 0:\n            # Found a cardinal adjacent cell with the target kind. This is our goal.\n            return current_s, current_actions\n\n      # Explore movement actions (UP, DOWN, LEFT, RIGHT)\n      for action in [DOWN, UP, LEFT, RIGHT]:\n        # Prune paths that would exceed the individual BFS step limit\n        if len(current_actions) + 1 > max_steps_for_move:\n          continue \n\n        # Simulate the step to get the next state\n        _, next_s = current_s.step(action)\n        next_state_tuple = _get_simplified_state_tuple(next_s)\n\n        if next_state_tuple not in visited:\n          visited.add(next_state_tuple)\n          q.append((next_s, current_actions + [action]))\n          steps_taken_in_bfs += 1 # Increment step count for BFS overall limit\n\n    return None, None # Path not found within limits\n\n  def _get_turn_and_use_actions(current_state, target_kind_idx):\n    \"\"\"\n    Calculates the actions needed to turn towards a *cardinal neighbor*\n    containing `target_kind_idx` and then perform the USE action.\n    Assumes `current_state` is already positioned such that `target_kind_idx`\n    is present on a cardinal neighbor cell.\n    \n    Args:\n      current_state: The CraftState from which to perform turns and USE.\n      target_kind_idx: The integer index of the item/entity to use.\n      \n    Returns:\n      A list of actions (e.g., [RIGHT, USE] or [USE]), or an empty list\n      if no valid cardinal target is found.\n    \"\"\"\n    actions = []\n    WIDTH, HEIGHT, _ = current_state.grid.shape\n\n    # Find the specific cardinal adjacent cell containing `target_kind_idx`\n    target_cell_to_face = None\n    \n    # Iterate only over cardinal directions to find the target\n    for dx_rel, dy_rel in DIR_TO_DELTAS.values():\n      check_x, check_y = current_state.pos[0] + dx_rel, current_state.pos[1] + dy_rel\n\n      if 0 <= check_x < WIDTH and 0 <= check_y < HEIGHT:\n        if current_state.grid[check_x, check_y, target_kind_idx] > 0:\n          target_cell_to_face = (check_x, check_y)\n          break # Found a cardinal neighbor, prioritize this one\n\n    if target_cell_to_face is None:\n      # This case implies the agent is positioned next to an item/workshop,\n      # but it's only diagonally adjacent, or on the agent's current cell.\n      # For `USE` action to be meaningful (acting on the cell in front),\n      # a cardinal neighbor is required.\n      return [] \n\n    # Calculate the relative position of the target cell from the agent's position\n    px, py = current_state.pos\n    tx, ty = target_cell_to_face\n    \n    dx_target = tx - px\n    dy_target = ty - py\n\n    # Determine the required direction index (0=N, 1=E, 2=S, 3=W) to face the target\n    required_dir = None\n    for direction_idx, (ddx, ddy) in DIR_TO_DELTAS.items():\n      if ddx == dx_target and ddy == dy_target:\n        required_dir = direction_idx\n        break\n    \n    if required_dir is None:\n      # Should not happen if `target_cell_to_face` was found using `DIR_TO_DELTAS.values()`\n      return [] \n            \n    # Calculate the minimum turns needed to face the `required_dir` from `current_state.dir`\n    turn_diff = (required_dir - current_state.dir + 4) % 4\n    if turn_diff == 1:       actions.append(RIGHT)         # 1 turn right\n    elif turn_diff == 2:     actions.extend([RIGHT, RIGHT])  # 2 turns (can be 2xRIGHT or 2xLEFT)\n    elif turn_diff == 3:     actions.append(LEFT)          # 1 turn left\n    # If turn_diff is 0, no turn action is needed (already facing correctly)\n\n    actions.append(USE) # Finally, add the USE action\n    return actions\n\n  def _recursive_craft_helper(current_state, target_item_idx, current_planner_steps, cookbook):\n    \"\"\"\n    Recursive helper function that finds a sequence of actions to craft\n    the `target_item_idx`. It uses a depth-first search like approach with\n    memoization and a global step limit to manage complexity.\n    \n    Args:\n      current_state: The current CraftState of the agent.\n      target_item_idx: The integer index of the item to be crafted/obtained.\n      current_planner_steps: The cumulative number of actions taken so far\n                             in the overall crafting plan.\n      cookbook: Reference to the CraftWorld's Cookbook instance for recipes.\n      \n    Returns:\n      (success_bool, list_of_actions): True and a list of actions if the item\n      can be crafted, False and an empty list otherwise.\n    \"\"\"\n    # --- Memoization / Base cases ---\n    state_tuple = _get_simplified_state_tuple(current_state)\n    memo_key = (state_tuple, target_item_idx)\n\n    if memo_key in _PLANNER_CACHE:\n      return _PLANNER_CACHE[memo_key]\n\n    # Stop if total plan actions exceed the limit, preventing infinite recursion/long plans\n    if current_planner_steps >= _MAX_PLANNER_ACTIONS:\n      _PLANNER_CACHE[memo_key] = (False, [])\n      return False, []\n\n    # If the target item is already in the inventory, no actions are needed for this sub-goal\n    if current_state.inventory[target_item_idx] > 0:\n      _PLANNER_CACHE[memo_key] = (True, [])\n      return True, []\n\n    current_path_actions = [] # Actions accumulated in this specific recursive call\n\n    # --- Case 1: Target is a primitive (collect from the grid) ---\n    if target_item_idx in cookbook.primitives:\n      # First, find a path to be adjacent to the primitive item on the grid\n      moved_state, move_actions = _bfs_move_to_kind(\n          current_state, target_item_idx,\n          _MAX_PLANNER_ACTIONS - current_planner_steps  # Limit steps for this movement sub-plan\n      )\n      if moved_state is None:\n        _PLANNER_CACHE[memo_key] = (False, [])\n        return False, [] # Cannot reach the primitive\n\n      # Then, determine actions to turn towards it and USE it\n      face_and_use_actions = _get_turn_and_use_actions(moved_state, target_item_idx)\n      if not face_and_use_actions:\n        _PLANNER_CACHE[memo_key] = (False, [])\n        return False, [] # Cannot face/use the primitive even if next to it\n\n      # Simulate these actions to get the state after attempting collection\n      state_after_attempt = _simulate_actions(moved_state, face_and_use_actions)\n      \n      # Check if collection was successful (inventory count of the item increased)\n      if state_after_attempt.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n        current_path_actions.extend(move_actions)\n        current_path_actions.extend(face_and_use_actions)\n        _PLANNER_CACHE[memo_key] = (True, current_path_actions)\n        return True, current_path_actions\n      else:\n        # Failed to collect, e.g., item was non-grabbable or already gone\n        _PLANNER_CACHE[memo_key] = (False, [])\n        return False, []\n\n    # --- Case 2: Target has a recipe (craft using ingredients and a workshop) ---\n    if target_item_idx in cookbook.recipes:\n      recipe = cookbook.recipes[target_item_idx]\n      \n      ingredients_needed = {}\n      workshop_kind_idx = None\n\n      # Parse ingredients and workshop from the recipe\n      for ing_idx_or_key, count_or_name in recipe.items():\n        if ing_idx_or_key == \"_key\":\n          # The workshop is identified by a name string in the YAML, look up its index\n          workshop_kind_idx = cookbook.index[count_or_name]\n        else:\n          ingredients_needed[ing_idx_or_key] = count_or_name # Actual count (int)\n\n      current_working_state = current_state # State evolves as ingredients are gathered\n      \n      # Collect all required ingredients recursively\n      for ing_idx, required_count in ingredients_needed.items():\n        while current_working_state.inventory[ing_idx] < required_count:\n          # Recursively call to get each required ingredient\n          success, ing_actions = _recursive_craft_helper(\n              current_working_state, ing_idx,\n              current_planner_steps + len(current_path_actions), cookbook\n          )\n          if not success:\n            _PLANNER_CACHE[memo_key] = (False, [])\n            return False, [] # If an ingredient cannot be obtained, crafting fails\n\n          # Apply the actions for obtaining the ingredient and update state/actions\n          current_working_state = _simulate_actions(current_working_state, ing_actions)\n          current_path_actions.extend(ing_actions)\n          \n          # Check total actions against limit after adding ingredient actions\n          if current_planner_steps + len(current_path_actions) >= _MAX_PLANNER_ACTIONS:\n            _PLANNER_CACHE[memo_key] = (False, [])\n            return False, []\n\n      # If a workshop is required, move to it and use it\n      if workshop_kind_idx is not None:\n        # Move to be adjacent to the workshop\n        moved_state_to_workshop, move_actions_to_workshop = _bfs_move_to_kind(\n            current_working_state, workshop_kind_idx,\n            _MAX_PLANNER_ACTIONS - (current_planner_steps + len(current_path_actions))\n        )\n        if moved_state_to_workshop is None:\n          _PLANNER_CACHE[memo_key] = (False, [])\n          return False, [] # Cannot reach the workshop\n\n        current_working_state = moved_state_to_workshop\n        current_path_actions.extend(move_actions_to_workshop)\n\n        if current_planner_steps + len(current_path_actions) >= _MAX_PLANNER_ACTIONS:\n          _PLANNER_CACHE[memo_key] = (False, [])\n          return False, []\n\n        # Turn to face and USE the workshop\n        face_and_use_actions = _get_turn_and_use_actions(current_working_state, workshop_kind_idx)\n        if not face_and_use_actions:\n          _PLANNER_CACHE[memo_key] = (False, [])\n          return False, [] # Cannot face/use the workshop\n\n        current_working_state = _simulate_actions(current_working_state, face_and_use_actions)\n        current_path_actions.extend(face_and_use_actions)\n\n        if current_planner_steps + len(current_path_actions) >= _MAX_PLANNER_ACTIONS:\n          _PLANNER_CACHE[memo_key] = (False, [])\n          return False, []\n\n      # After gathering ingredients and using the workshop (if any),\n      # check if the target item is now successfully in the inventory.\n      # The 'USE' action on a workshop typically consumes ingredients and produces the item.\n      if current_working_state.inventory[target_item_idx] > current_state.inventory[target_item_idx]:\n        _PLANNER_CACHE[memo_key] = (True, current_path_actions)\n        return True, current_path_actions\n      else:\n        # Crafting failed (e.g., not enough ingredients despite planning, wrong workshop, etc.)\n        _PLANNER_CACHE[memo_key] = (False, [])\n        return False, []\n\n    # If the item is neither a primitive nor has a known recipe, it cannot be crafted\n    _PLANNER_CACHE[memo_key] = (False, [])\n    return False, []\n\n  # --- Main logic for craft_v1 function ---\n\n  # Clear the planner cache for a fresh start with each new `craft_v1` call.\n  _PLANNER_CACHE.clear()\n\n  # Get the initial state of the environment and the cookbook for recipes\n  initial_state = env._current_state\n  cookbook = env.world.cookbook\n\n  # Initiate the recursive crafting process\n  success, actions = _recursive_craft_helper(initial_state, item, 0, cookbook)\n\n  if success:\n    return actions\n  else:\n    return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-30T00:15:00.083046", "function_name": "craft", "function_body": "    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n\n    all_actions = []\n    current_state = env._current_state\n\n    # Helper function to find a path and update state/actions\n    def _find_path_to_adjacent(start_state, target_kind_idx, max_path_len=50):\n        \"\"\"\n        Performs a Breadth-First Search (BFS) to find a sequence of movement actions\n        that leads the agent to a position adjacent to the `target_kind_idx`.\n\n        Args:\n            start_state: The initial CraftState from which to start the search.\n            target_kind_idx: The integer index of the entity kind to get next to.\n            max_path_len: Maximum length of the path to search, to prevent infinite loops.\n\n        Returns:\n            A tuple (path_actions, final_state_after_path) where:\n            - path_actions: A list of movement actions (int) to reach the adjacent position.\n            - final_state_after_path: The CraftState after executing `path_actions`.\n            If no path is found, returns ([], start_state).\n        \"\"\"\n        # Using a list as a rudimentary queue for BFS. For larger graphs, collections.deque is more efficient.\n        q = [(start_state, [])] # (current_state, actions_taken_to_reach_this_state)\n        \n        # Set to keep track of visited agent positions to avoid cycles and redundant exploration.\n        # This simplifies the BFS but assumes that other state components (inventory, direction)\n        # don't significantly affect pathfinding *to a location*.\n        visited_positions = {start_state.pos} \n\n        head = 0 # Pointer for manual queue management\n        while head < len(q):\n            state, path = q[head]\n            head += 1\n            \n            # If the current state is already adjacent to the target, we found a path.\n            if state.next_to(target_kind_idx):\n                return path, state\n\n            # Limit path length to prevent excessively long searches or infinite loops in complex layouts.\n            if len(path) >= max_path_len:\n                continue \n\n            # Explore possible moves (UP, DOWN, LEFT, RIGHT)\n            for action_move in [UP, DOWN, LEFT, RIGHT]:\n                # Simulate the action to get the next state without modifying the current state.\n                # CraftState.step returns (reward, new_state). We only care about new_state here.\n                _, next_state = state.step(action_move)\n                \n                # Check if the move actually changed position (e.g., not hitting a wall)\n                # and if the new position has not been visited yet.\n                if next_state.pos != state.pos and next_state.pos not in visited_positions:\n                    visited_positions.add(next_state.pos)\n                    new_path = path + [action_move]\n                    q.append((next_state, new_path))\n        \n        # No path found within the given limits\n        return [], start_state\n\n    # Main recursive function to obtain a specific item (either by picking up or crafting)\n    def _obtain_item(target_item_idx, state_so_far):\n        \"\"\"\n        Recursively attempts to obtain a `target_item_idx`.\n        It tries to pick up if primitive, or craft if a recipe exists.\n\n        Args:\n            target_item_idx: The integer index of the item to obtain.\n            state_so_far: The current CraftState of the agent, which will be updated\n                          as actions are simulated.\n\n        Returns:\n            A tuple (success_bool, updated_state) where:\n            - success_bool: True if the item was successfully obtained, False otherwise.\n            - updated_state: The CraftState after attempting to obtain the item.\n        \"\"\"\n        nonlocal all_actions # Allows appending actions to the `all_actions` list in the outer scope.\n\n        # Base Case 1: Item already in inventory\n        if state_so_far.inventory[target_item_idx] > 0:\n            return True, state_so_far\n\n        # Base Case 2: Item is a primitive (can be picked up from the environment)\n        if target_item_idx in env.world.cookbook.primitives:\n            # Find a path to a cell adjacent to the primitive resource.\n            path_actions, state_after_move = _find_path_to_adjacent(state_so_far, target_item_idx)\n            \n            # If pathfinding failed or the agent is not adjacent after trying to move, cannot obtain.\n            if not state_after_move.next_to(target_item_idx):\n                return False, state_so_far # Return original state as no progress was made.\n\n            # Append movement actions to the global list and update the current state.\n            all_actions.extend(path_actions)\n            state_so_far = state_after_move\n            \n            # Execute the USE action to pick up the primitive.\n            _, state_so_far = state_so_far.step(USE)\n            all_actions.append(USE)\n            \n            # Verify if the primitive was successfully added to inventory.\n            if state_so_far.inventory[target_item_idx] > 0:\n                return True, state_so_far\n            else:\n                # If inventory didn't increase, picking up failed for some reason.\n                return False, state_so_far\n\n        # Recursive Case: Item is craftable (has a recipe defined in the cookbook)\n        if target_item_idx in env.world.cookbook.recipes:\n            recipe = env.world.cookbook.recipes[target_item_idx]\n            \n            # Step 1: Obtain all required ingredients for the recipe.\n            ingredients_obtained_successfully = True\n            for ing_idx, count in recipe.items():\n                if ing_idx == \"_key\": continue # Skip metadata key in recipe (e.g., description).\n\n                # Calculate how many of this ingredient are still needed.\n                needed_count = count - state_so_far.inventory[ing_idx]\n                \n                # Recursively call _obtain_item for each needed instance of the ingredient.\n                for _ in range(max(0, needed_count)): \n                    success, state_so_far = _obtain_item(ing_idx, state_so_far)\n                    if not success:\n                        ingredients_obtained_successfully = False\n                        break # Failed to get an ingredient, so crafting this item is impossible.\n                if not ingredients_obtained_successfully:\n                    break # Break outer loop if any ingredient failed.\n            \n            if not ingredients_obtained_successfully:\n                return False, state_so_far # Cannot proceed if ingredients are missing.\n\n            # Step 2: Find a workshop and craft the item.\n            workshop_indices = env.world.workshop_indices\n            if not workshop_indices:\n                # No workshops are defined in the world, assuming crafting cannot happen.\n                return False, state_so_far\n\n            # Try to get to any available workshop.\n            workshop_reached = False\n            for ws_idx in workshop_indices:\n                path_actions, state_after_move = _find_path_to_adjacent(state_so_far, ws_idx)\n                # If a path was found or already adjacent to a workshop.\n                if state_after_move.next_to(ws_idx): \n                    all_actions.extend(path_actions)\n                    state_so_far = state_after_move\n                    workshop_reached = True\n                    break # Found and moved to a workshop, no need to check others.\n            \n            if not workshop_reached:\n                return False, state_so_far # Failed to reach any workshop.\n\n            # Execute the USE action at the workshop to craft the item.\n            # Double check adjacency, as agent's position might have changed slightly during ingredient collection.\n            if state_so_far.next_to(ws_idx): \n                _, state_so_far = state_so_far.step(USE)\n                all_actions.append(USE)\n                \n                # Verify if the item was successfully crafted (inventory increased).\n                if state_so_far.inventory[target_item_idx] > 0:\n                    return True, state_so_far\n                else:\n                    return False, state_so_far # Crafting failed despite having ingredients and workshop.\n            else:\n                # Lost adjacency to workshop, unexpected but means crafting can't proceed.\n                return False, state_so_far\n        \n        # If the item is neither primitive nor craftable, and not in inventory, it's unobtainable.\n        return False, state_so_far\n\n    # Begin the process of crafting the requested `item`.\n    success, final_state_after_crafting = _obtain_item(item, current_state)\n    \n    if not success:\n        # If the goal item could not be crafted, return an empty list of actions.\n        return []\n\n    return all_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:17:31.599855", "function_name": "craft", "function_body": "  # Define a helper class for the planning logic\n  class Planner:\n      def __init__(self, initial_state, world):\n          self.initial_state = initial_state\n          self.world = world\n          self.move_actions = [\n              env_factory.ACTION_DOWN, env_factory.ACTION_UP,\n              env_factory.ACTION_LEFT, env_factory.ACTION_RIGHT\n          ]\n          # Memoization for recursive crafting: (state_key, target_item_idx) -> (actions, final_state)\n          self.craft_memo = {}\n          # Memoization for pathfinding: (start_state_key, target_entity_idx) -> (actions, final_state)\n          self.path_memo = {}\n\n      def _get_entity_coords(self, state, entity_idx):\n          \"\"\"Returns a list of (x, y) coordinates where entity_idx is found on the grid.\"\"\"\n          coords = []\n          # Ensure entity_idx is valid for the grid's n_kinds dimension\n          if entity_idx < 0 or entity_idx >= state.grid.shape[2]:\n              return [] \n              \n          entity_layer = state.grid[:, :, entity_idx]\n          y_coords, x_coords = np.where(entity_layer > 0)\n          for i in range(len(x_coords)):\n              coords.append((x_coords[i], y_coords[i])) # (x, y)\n          return coords\n\n      def _get_path_to_adjacent(self, start_state, target_entity_idx):\n          \"\"\"\n          Finds a path from start_state to a cell adjacent to target_entity_idx, facing it.\n          Returns (list_of_actions, final_state) or (None, None).\n          A BFS is used here. State for BFS includes (pos, dir).\n          The grid is considered static for the duration of a single pathfinding call,\n          as movement actions do not alter the grid.\n          \"\"\"\n          # State key for memoization and visited set: (pos_x, pos_y, dir_idx)\n          start_pos_dir_key = (start_state.pos[0], start_state.pos[1], start_state.dir)\n          path_memo_key = (start_pos_dir_key, target_entity_idx)\n          if path_memo_key in self.path_memo:\n              return self.path_memo[path_memo_key]\n\n          queue = collections.deque([(start_state, [])]) # (current_state_in_bfs, actions_taken_in_bfs)\n          visited = set() # (pos_x, pos_y, dir_idx)\n\n          while queue:\n              current_state_in_bfs, actions_taken_in_bfs = queue.popleft()\n              current_pos = current_state_in_bfs.pos\n              current_dir = current_state_in_bfs.dir\n\n              state_key_in_bfs = (current_pos[0], current_pos[1], current_dir)\n              if state_key_in_bfs in visited:\n                  continue\n              visited.add(state_key_in_bfs)\n\n              # Check if we are adjacent to a target entity and facing it\n              # _get_entity_coords uses current_state_in_bfs.grid. This is safe as grid is constant during movement.\n              target_coords = self._get_entity_coords(current_state_in_bfs, target_entity_idx)\n              \n              for tx, ty in target_coords:\n                  for d_face in range(4): # 0:N, 1:E, 2:S, 3:W\n                      dx, dy = env_factory.DIRECTIONS[d_face]\n                      adj_x, adj_y = tx - dx, ty - dy # Cell *from which* agent would face (tx,ty)\n                      \n                      if (current_pos[0], current_pos[1]) == (adj_x, adj_y) and current_dir == d_face:\n                          result = (actions_taken_in_bfs, current_state_in_bfs)\n                          self.path_memo[path_memo_key] = result\n                          return result\n\n              # Explore movement actions\n              for action in self.move_actions:\n                  new_state_from_action = current_state_in_bfs.step(action)[1]\n                  new_state_key_in_bfs = (new_state_from_action.pos[0], new_state_from_action.pos[1], new_state_from_action.dir)\n                  \n                  # Check bounds to avoid planning into walls/out of grid if step() doesn't completely block\n                  if not (0 <= new_state_from_action.pos[0] < env_factory.WIDTH and\n                          0 <= new_state_from_action.pos[1] < env_factory.HEIGHT):\n                      continue\n\n                  if new_state_key_in_bfs not in visited:\n                      queue.append((new_state_from_action, actions_taken_in_bfs + [action]))\n\n          self.path_memo[path_memo_key] = (None, None) # No path found\n          return None, None\n\n      def _recursive_craft(self, current_state, target_item_idx, current_depth=0, max_depth=20):\n          \"\"\"\n          Recursively find actions to craft target_item_idx.\n          Returns (list_of_actions, final_state) or (None, None).\n          Memoization key includes (pos, dir, tuple(inventory)). Grid state is implicitly\n          managed by passing `current_state` which reflects previous changes.\n          \"\"\"\n          # Base case: Already have the item\n          if current_state.inventory[target_item_idx] > 0:\n              return [], current_state\n\n          # Depth limit to prevent infinite recursion or too long plans\n          if current_depth > max_depth:\n              return None, None\n\n          # State key for memoization\n          inventory_tuple = tuple(current_state.inventory.tolist())\n          state_key = (current_state.pos[0], current_state.pos[1], current_state.dir, inventory_tuple)\n\n          craft_memo_key = (state_key, target_item_idx)\n          if craft_memo_key in self.craft_memo:\n              return self.craft_memo[craft_memo_key]\n\n          # --- Try to obtain directly from the world (if it's a primitive or has a known source block) ---\n          source_block_idx = None\n          target_name = self.world.cookbook.index.get(target_item_idx)\n\n          # Heuristic mapping: map product item name to its common source block index\n          if target_name == \"wood\":\n              source_block_idx = self.world.cookbook.index.index(\"tree\")\n          elif target_name == \"stone\":\n              source_block_idx = self.world.stone_index \n          elif target_name == \"water\":\n              source_block_idx = self.world.water_index \n          # Add more explicit mappings here if necessary\n\n          # Check if the target item is a \"primitive\" in the cookbook definition\n          is_cookbook_primitive = target_item_idx in self.world.cookbook.primitives\n          \n          # If it's a primitive according to cookbook OR we identified a specific source block\n          if is_cookbook_primitive or source_block_idx is not None:\n              # Prefer the explicit source_block_idx if determined, otherwise assume item_idx is also the block_idx\n              block_to_find = source_block_idx if source_block_idx is not None else target_item_idx\n              \n              # Before pathfinding, verify the block exists on the current grid\n              if self._get_entity_coords(current_state, block_to_find):\n                  path_actions, final_movement_state = self._get_path_to_adjacent(current_state, block_to_find)\n                  if path_actions is not None:\n                      # Agent is now adjacent and facing the block. Perform USE action.\n                      state_after_use = final_movement_state.step(env_factory.ACTION_USE)[1]\n                      # Check if the item was successfully acquired after USE\n                      if state_after_use.inventory[target_item_idx] > 0:\n                          result = (path_actions + [env_factory.ACTION_USE], state_after_use)\n                          self.craft_memo[craft_memo_key] = result\n                          return result\n              # If direct acquisition failed or target block not found, proceed to check recipes\n          \n          # --- Try crafting via recipe if direct acquisition is not possible or failed ---\n          recipe = self.world.cookbook.recipes.get(target_item_idx)\n          if recipe is None:\n              # Not directly acquireable and no recipe found. Cannot obtain this item.\n              self.craft_memo[craft_memo_key] = (None, None)\n              return None, None\n\n          actions_to_gather = []\n          current_planning_state = current_state # This state will be updated as ingredients are acquired\n\n          ingredients_info = recipe.copy()\n          crafting_key_str = ingredients_info.pop('_key', None) # Get workshop key (string name)\n\n          # Sort ingredients for consistent planning order (helps memoization and debugging)\n          sorted_ingredients = sorted(ingredients_info.items(), key=lambda x: x[0])\n\n          for ingredient_idx, count_needed in sorted_ingredients:\n              current_count = current_planning_state.inventory[ingredient_idx]\n              num_to_acquire = count_needed - current_count\n              if num_to_acquire < 0: # Already have enough of this ingredient\n                  num_to_acquire = 0\n\n              for _ in range(num_to_acquire):\n                  # Recursively call _recursive_craft to obtain each needed unit of ingredient\n                  ingredient_actions, new_state_after_ingredient = self._recursive_craft(\n                      current_planning_state, ingredient_idx, current_depth + 1, max_depth\n                  )\n                  if ingredient_actions is None:\n                      # Failed to obtain a required ingredient, so this craft path is impossible\n                      self.craft_memo[craft_memo_key] = (None, None)\n                      return None, None\n                  \n                  actions_to_gather.extend(ingredient_actions)\n                  current_planning_state = new_state_after_ingredient # Update state for next ingredient/craft\n\n          # All ingredients gathered. Now, move to the correct workshop if required, and perform craft.\n          if crafting_key_str is not None:\n              # Convert workshop name (string) to its integer index\n              workshop_idx = self.world.cookbook.index.index(crafting_key_str)\n              \n              path_actions_to_workshop, final_movement_state = self._get_path_to_adjacent(current_planning_state, workshop_idx)\n              if path_actions_to_workshop is None:\n                  # Cannot reach the required workshop\n                  self.craft_memo[craft_memo_key] = (None, None)\n                  return None, None\n              \n              actions_to_gather.extend(path_actions_to_workshop)\n              current_planning_state = final_movement_state # Agent is now at workshop, facing it\n\n          # Perform the USE action to craft the target item\n          state_after_craft = current_planning_state.step(env_factory.ACTION_USE)[1]\n          \n          # Verify that the crafting was successful (target item is now in inventory)\n          if state_after_craft.inventory[target_item_idx] > 0:\n              total_actions = actions_to_gather + [env_factory.ACTION_USE]\n              result = (total_actions, state_after_craft)\n              self.craft_memo[craft_memo_key] = result\n              return result\n          else:\n              # Crafting failed, even with ingredients and at correct location.\n              # This might happen if ingredients were implicitly consumed by other actions,\n              # or if the crafting rule itself is complex/buggy.\n              self.craft_memo[craft_memo_key] = (None, None)\n              return None, None\n\n      def plan(self, target_item_idx):\n          \"\"\"Main entry point for the planner.\"\"\"\n          # Clear memoization caches for a fresh planning run\n          self.craft_memo = {} \n          self.path_memo = {}\n          actions, _ = self._recursive_craft(self.initial_state, target_item_idx)\n          return actions\n\n  # Initialize the planner with the current environment state and world configuration\n  planner = Planner(env._current_state, env.world)\n  \n  # Execute the planning process\n  result_actions = planner.plan(item)\n\n  # Return the list of actions, or an empty list if no plan was found\n  if result_actions is None:\n      return []\n  else:\n      return result_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:17:32.571922", "function_name": "craft", "function_body": "  import collections\n  import copy\n  import numpy as np\n\n  # Action constants (assuming they are 0-4 as per DMLab convention)\n  _DOWN, _UP, _LEFT, _RIGHT, _USE = 0, 1, 2, 3, 4\n\n  cookbook = env.world.cookbook\n  initial_state = copy.deepcopy(env._current_state)\n\n  # If the target item is already in the initial inventory, no actions are needed.\n  if initial_state.inventory[item] > 0:\n    return []\n\n  # Memoization table to store results of `_plan_single_item` calls.\n  # Key: (hashable_state_tuple, target_item_index)\n  # Value: (list_of_actions, final_simulated_state) or (None, None) if impossible.\n  # A hashable_state_tuple consists of (tuple(inventory), position_tuple, direction_int).\n  memo = {}\n\n  def _plan_single_item(state: 'CraftState', target_idx: int, path_history: list):\n    \"\"\"\n    Recursively plans actions to obtain one unit of `target_idx`.\n\n    Args:\n      state: The current `CraftState` instance (simulated state).\n      target_idx: The integer index of the item to obtain.\n      path_history: A list of item indices currently in the recursive call stack,\n                    used to detect and prevent circular dependencies.\n\n    Returns:\n      A tuple (list_of_actions, new_state_after_plan) if a plan is found,\n      otherwise (None, None) if the item cannot be obtained from this state.\n    \"\"\"\n    # Create a hashable representation of the current state for memoization.\n    # We include inventory, position, and direction as these define the agent's current situation.\n    state_tuple = (tuple(state.inventory), state.pos, state.dir)\n    memo_key = (state_tuple, target_idx)\n\n    # Check the memoization cache to avoid redundant computations.\n    if memo_key in memo:\n      return memo[memo_key]\n\n    # Check for circular dependencies in the current planning path.\n    # If the target item is already in the `path_history`, it means we're in a loop.\n    if target_idx in path_history:\n      return None, None # Circular dependency detected\n\n    # Base case: If the item is already present in the current simulated state's inventory.\n    if state.inventory[target_idx] > 0:\n      return [], state\n\n    # Add the current target item to the path history before making recursive calls.\n    path_history.append(target_idx)\n\n    current_actions = []\n    # Create a deep copy of the state to simulate actions without modifying the original.\n    sim_state = copy.deepcopy(state)\n\n    recipe = cookbook.recipes.get(target_idx)\n\n    if recipe is None:\n      # If there's no recipe, the item must be a primitive resource or an environment entity\n      # that needs to be collected directly from the grid.\n      if target_idx in cookbook.primitives or target_idx in cookbook.environment:\n        # Perform a Breadth-First Search (BFS) to find a path to the item on the grid\n        # and then use the `_USE` action to collect it.\n        q = collections.deque([(sim_state, [])]) # (state_node, actions_to_reach_node)\n        # Keep track of visited (position, direction) pairs to avoid loops in movement search.\n        visited_positions_and_dirs = set([(sim_state.pos, sim_state.dir)])\n        \n        path_found = False\n        temp_actions_for_collect = []\n        final_collect_state = None\n\n        # Set a maximum number of movement steps to prevent extremely long or infinite searches.\n        max_movement_steps = 100 \n\n        while q and len(q[0][1]) < max_movement_steps:\n          s_node, a_node = q.popleft()\n\n          # Check if the agent is next to the target item.\n          if s_node.next_to(target_idx):\n            temp_actions_for_collect = a_node\n            # Simulate the _USE action to collect the item.\n            _, collected_state = s_node.step(_USE)\n            # Verify that the item was actually collected (inventory increased).\n            if collected_state.inventory[target_idx] > state.inventory[target_idx]:\n              final_collect_state = collected_state\n              path_found = True\n              break\n        \n          # Explore neighboring states by trying movement actions.\n          for action in [_DOWN, _UP, _LEFT, _RIGHT]:\n            # Simulate the action to get the next state.\n            _r, next_s = s_node.step(action)\n            next_pos_dir = (next_s.pos, next_s.dir)\n            \n            # If this (position, direction) combination hasn't been visited, add it to the queue.\n            if next_pos_dir not in visited_positions_and_dirs:\n              visited_positions_and_dirs.add(next_pos_dir)\n              q.append((next_s, a_node + [action]))\n        \n        # Remove the current target from path_history as we're backtracking from this call.\n        path_history.pop() \n\n        if path_found:\n          result = (temp_actions_for_collect + [_USE], final_collect_state)\n          memo[memo_key] = result\n          return result\n        else:\n          # Item not found on the grid, or path too long/blocked.\n          result = (None, None)\n          memo[memo_key] = result\n          return result\n      else:\n        # Item is not a recipe, not a primitive, and not an environment item. Cannot be obtained.\n        path_history.pop()\n        result = (None, None)\n        memo[memo_key] = result\n        return result\n\n    # If it is a recipe, we need to gather its ingredients first.\n    all_ingredients_collected = True\n    for ing_idx, ing_count in recipe.items():\n      if ing_idx == '_key':\n        continue # '_key' specifies a workshop, handled after ingredients are gathered.\n\n      current_inv_count = sim_state.inventory[ing_idx]\n      needed_count = ing_count - current_inv_count\n\n      # For each quantity of the ingredient needed, recursively plan to obtain it.\n      for _ in range(needed_count):\n        ing_actions, new_sim_state = _plan_single_item(sim_state, ing_idx, path_history)\n        if ing_actions is None:\n          all_ingredients_collected = False\n          break # Cannot obtain this ingredient, so cannot craft the target item.\n        current_actions.extend(ing_actions)\n        sim_state = new_sim_state # Update the simulated state with the collected ingredient.\n\n      if not all_ingredients_collected:\n        break\n    \n    if not all_ingredients_collected:\n      path_history.pop()\n      result = (None, None)\n      memo[memo_key] = result\n      return result\n\n    # All ingredients are now gathered in `sim_state.inventory`. Proceed to crafting.\n    workshop_key = recipe.get('_key')\n    \n    if workshop_key is not None:\n      workshop_idx = cookbook.index[workshop_key]\n      \n      # If a workshop is required and the agent is not already adjacent to it, plan movement.\n      if not sim_state.next_to(workshop_idx):\n        # Pathfind to the workshop using BFS.\n        q_workshop = collections.deque([(sim_state, [])])\n        visited_workshop_positions_and_dirs = set([(sim_state.pos, sim_state.dir)])\n        \n        workshop_path_found = False\n        temp_actions_to_workshop = []\n        state_at_workshop = None\n\n        max_movement_steps = 100 # Limit for workshop pathfinding as well.\n\n        while q_workshop and len(q_workshop[0][1]) < max_movement_steps:\n          s_node, a_node = q_workshop.popleft()\n\n          if s_node.next_to(workshop_idx):\n            temp_actions_to_workshop = a_node\n            state_at_workshop = s_node\n            workshop_path_found = True\n            break\n          \n          for action in [_DOWN, _UP, _LEFT, _RIGHT]:\n            _r, next_s = s_node.step(action)\n            next_pos_dir = (next_s.pos, next_s.dir)\n            if next_pos_dir not in visited_workshop_positions_and_dirs:\n              visited_workshop_positions_and_dirs.add(next_pos_dir)\n              q_workshop.append((next_s, a_node + [action]))\n        \n        if not workshop_path_found:\n          path_history.pop()\n          result = (None, None)\n          memo[memo_key] = result\n          return result\n        \n        current_actions.extend(temp_actions_to_workshop)\n        sim_state = state_at_workshop # Update state: agent is now at the workshop.\n    \n    # Perform the _USE action to craft the item.\n    current_actions.append(_USE)\n    _r, final_crafted_state = sim_state.step(_USE)\n\n    # Verify if crafting was successful (inventory count of target_idx increased).\n    if final_crafted_state.inventory[target_idx] > state.inventory[target_idx]:\n      path_history.pop() # Backtrack from path_history.\n      result = (current_actions, final_crafted_state)\n      memo[memo_key] = result\n      return result\n    else:\n      # Crafting failed (e.g., recipe requirements not met, or internal game logic denied it).\n      path_history.pop()\n      result = (None, None)\n      memo[memo_key] = result\n      return result\n\n  # Initiate the planning process for the target item from the initial environment state.\n  # An empty list is passed for `path_history` for the top-level call.\n  final_plan_actions, _ = _plan_single_item(initial_state, item, [])\n\n  # Return the found actions or an empty list if no plan could be determined.\n  if final_plan_actions is None:\n    return [] \n  else:\n    return final_plan_actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:19:23.878802", "function_name": "craft", "function_body": "    world = env.world\n    cookbook = world.cookbook\n    initial_state = env._current_state # Do not modify this state directly\n\n    # Action mappings for clarity\n    DOWN, UP, LEFT, RIGHT, USE = range(5)\n    _DIRECTIONS = [\n        (0, 1),  # DOWN (change in x, change in y)\n        (0, -1), # UP\n        (-1, 0), # LEFT\n        (1, 0),  # RIGHT\n    ]\n\n    # Max recursion depth to prevent infinite loops for very complex or cyclic recipes\n    MAX_PLAN_DEPTH = 10\n\n    def _simulate_actions_on_state(initial_state: 'CraftState', actions: list[int]) -> 'CraftState':\n        \"\"\"\n        Simulates a sequence of actions on a CraftState instance and returns the final state.\n        This function uses CraftState.step(), which returns a new state object, making it\n        suitable for dry-run simulations.\n        \"\"\"\n        current_s = initial_state\n        for action in actions:\n            # current_s.step() returns (reward, new_state). We only need the new_state.\n            current_s = current_s.step(action)[1]\n        return current_s\n\n    def _bfs_path_to_kind(current_sim_state: 'CraftState', target_kind_idx: int) -> list[int]:\n        \"\"\"\n        Performs a BFS on positions and directions to find a path (sequence of move actions)\n        from current_sim_state.pos to a position that is either adjacent to or on the target_kind_idx.\n        Returns a list of actions (UP/DOWN/LEFT/RIGHT) to reach that position.\n        The BFS explicitly checks for successful moves using `CraftState.step`.\n        \"\"\"\n        # Queue stores tuples of (current_state, path_actions_to_reach_this_state)\n        q = collections.deque([(current_sim_state, [])])\n        # Visited set stores (position, direction) tuples to prevent redundant exploration\n        visited_states_hash = {(current_sim_state.pos, current_sim_state.dir)}\n\n        while q:\n            curr_s, path_a = q.popleft()\n\n            # Check if agent is currently next to the target_kind\n            if curr_s.next_to(target_kind_idx):\n                return path_a # Found a path to be adjacent\n\n            # Explore neighbors by simulating moves (UP, DOWN, LEFT, RIGHT)\n            for action_val in [DOWN, UP, LEFT, RIGHT]:\n                next_s = curr_s.step(action_val)[1] # Simulate the move\n                \n                # Check if the agent actually moved (pos changed) and hasn't visited this (pos, dir) state\n                new_state_hash = (next_s.pos, next_s.dir)\n                if new_state_hash not in visited_states_hash:\n                    q.append((next_s, path_a + [action_val]))\n                    visited_states_hash.add(new_state_hash)\n        \n        # If no path found to be adjacent, try to path to be *on* the item.\n        # This is useful for collecting items that the agent can stand on.\n        # Re-initialize BFS for this alternative target (being on the item's cell).\n        q = collections.deque([(current_sim_state, [])])\n        visited_states_hash = {(current_sim_state.pos, current_sim_state.dir)}\n\n        while q:\n            curr_s, path_a = q.popleft()\n\n            # Check if agent is on the target_kind's cell\n            if curr_s.grid[curr_s.pos[0], curr_s.pos[1], target_kind_idx] == 1:\n                return path_a # Found a path to be on the item\n\n            for action_val in [DOWN, UP, LEFT, RIGHT]:\n                next_s = curr_s.step(action_val)[1]\n                new_state_hash = (next_s.pos, next_s.dir)\n                if new_state_hash not in visited_states_hash:\n                    q.append((next_s, path_a + [action_val]))\n                    visited_states_hash.add(new_state_hash)\n        \n        return [] # No path found to be adjacent to or on the target kind\n\n    def _plan_item(current_sim_state: 'CraftState', target_item_idx: int, target_count: int, depth: int) -> tuple[list[int], 'CraftState']:\n        \"\"\"\n        Recursively plans actions to get target_item_idx until target_count is met.\n        Returns a tuple: (list of actions, final_sim_state after applying actions)\n        \"\"\"\n        if depth > MAX_PLAN_DEPTH:\n            return [], current_sim_state # Max depth reached, terminate planning for this branch\n\n        actions_for_item = []\n        sim_state = current_sim_state # Current state in this planning branch\n\n        # If we already have enough of the item, no actions needed for this goal\n        if sim_state.inventory[target_item_idx] >= target_count:\n            return [], current_sim_state\n\n        # Loop to acquire one unit at a time until target_count is met\n        while sim_state.inventory[target_item_idx] < target_count:\n            recipe = cookbook.recipes.get(target_item_idx)\n\n            # Temporary state and actions for acquiring one more unit of the target item\n            current_unit_actions = []\n            current_unit_sim_state = sim_state \n\n            if recipe is None:\n                # Target is a primitive (not craftable via a recipe). It must be collected from the environment.\n                \n                # Plan movement to be next to or on the primitive\n                path_to_primitive = _bfs_path_to_kind(current_unit_sim_state, target_item_idx)\n                if not path_to_primitive:\n                    # Primitive not found or unreachable, cannot proceed\n                    return [], current_sim_state # Propagate failure\n\n                # Simulate moves to reach the primitive\n                current_unit_sim_state = _simulate_actions_on_state(current_unit_sim_state, path_to_primitive)\n                current_unit_actions.extend(path_to_primitive)\n\n                # Now, perform the USE action to collect the primitive.\n                prev_inventory_count = current_unit_sim_state.inventory[target_item_idx]\n                next_sim_state_after_use = current_unit_sim_state.step(USE)[1]\n                current_unit_actions.append(USE)\n                current_unit_sim_state = next_sim_state_after_use\n\n                # Check if collection was successful (inventory increased)\n                if current_unit_sim_state.inventory[target_item_idx] <= prev_inventory_count:\n                    # Collection failed for this primitive (e.g., resource depleted, not collectible via USE)\n                    return [], current_sim_state # Propagate failure up\n            else:\n                # Target is craftable using a recipe.\n                required_ingredients = {k: v for k, v in recipe.items() if k != \"_key\"}\n                required_workshop_idx = recipe.get(\"_key\") # _key specifies the workshop, if any\n\n                # 1. Collect all ingredients required for one unit of the target item\n                for ingredient_idx, required_ingredient_count in required_ingredients.items():\n                    # Account for ingredients already in current inventory\n                    needed_for_this_craft = max(0, required_ingredient_count - current_unit_sim_state.inventory[ingredient_idx])\n                    if needed_for_this_craft > 0:\n                        # Recursively plan to get the missing amount of this ingredient\n                        sub_actions, updated_sim_state = _plan_item(current_unit_sim_state, ingredient_idx, needed_for_this_craft, depth + 1)\n                        if not sub_actions and updated_sim_state.inventory[ingredient_idx] < required_ingredient_count:\n                            # Failed to get required ingredient, cannot craft this item\n                            return [], current_sim_state # Propagate failure\n                        current_unit_actions.extend(sub_actions)\n                        current_unit_sim_state = updated_sim_state # Update sim_state with collected ingredients\n\n                # Verify that all ingredients are now available\n                ingredients_ready = True\n                for ingredient_idx, required_ingredient_count in required_ingredients.items():\n                    if current_unit_sim_state.inventory[ingredient_idx] < required_ingredient_count:\n                        ingredients_ready = False\n                        break\n                \n                if not ingredients_ready:\n                    # This indicates a logical failure in sub-planning or an unfulfillable recipe\n                    return [], current_sim_state \n\n                # 2. Move to workshop (if required) and then USE to craft\n                if required_workshop_idx is not None:\n                    # Plan movement to be next to the workshop\n                    path_to_workshop_actions = _bfs_path_to_kind(current_unit_sim_state, required_workshop_idx)\n                    if not path_to_workshop_actions:\n                        # Workshop not found or unreachable\n                        return [], current_sim_state # Cannot craft if workshop unreachable\n                    current_unit_actions.extend(path_to_workshop_actions)\n                    current_unit_sim_state = _simulate_actions_on_state(current_unit_sim_state, path_to_workshop_actions)\n                \n                # Simulate the USE action for crafting. This will consume ingredients and produce the target item.\n                prev_inventory_count = current_unit_sim_state.inventory[target_item_idx]\n                next_sim_state_after_use = current_unit_sim_state.step(USE)[1]\n                current_unit_actions.append(USE)\n                current_unit_sim_state = next_sim_state_after_use\n                \n                # Check if crafting was successful (inventory increased)\n                if current_unit_sim_state.inventory[target_item_idx] <= prev_inventory_count:\n                    # Crafting failed (e.g., incorrect position, missing prerequisites not captured by recipe keys)\n                    return [], current_sim_state # Indicate failure to craft one unit\n\n            # If execution reaches here, one unit of target_item_idx was successfully acquired/crafted.\n            # Add actions for this unit to the overall plan and update the main simulation state.\n            actions_for_item.extend(current_unit_actions)\n            sim_state = current_unit_sim_state # Update the overall sim_state for the while loop\n\n        return actions_for_item, sim_state\n\n    # Start the planning process for at least 1 unit of the target item\n    final_actions, final_sim_state = _plan_item(initial_state, item, 1, depth=0)\n\n    # Final validation: check if the item was successfully acquired in the simulated state\n    if final_sim_state.inventory[item] > 0:\n        return final_actions\n    else:\n        # Planning failed to acquire the item\n        return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:19:23.955421", "function_name": "craft", "function_body": "    import collections\n    import numpy as np\n\n    # The Craft environment typically uses integer actions 0-4.\n    # 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT, 4: USE.\n    N_ACTIONS = 5\n\n    # Helper function to create a hashable representation of a CraftState.\n    # This is crucial for storing visited states in a set to prevent cycles and redundant computation.\n    # Numpy arrays (grid and inventory) are not directly hashable, so they are converted to bytes.\n    # Position (tuple) and direction (int) are already hashable.\n    def _get_hashable_state(craft_state):\n        return (craft_state.grid.tobytes(), craft_state.pos, craft_state.dir, craft_state.inventory.tobytes())\n\n    # Get the initial state from the CraftLab environment.\n    initial_state = env._current_state\n    # The index of the item we want to craft or obtain.\n    goal_item_idx = item\n\n    # Initialize a Breadth-First Search (BFS) queue.\n    # Each item in the queue is a tuple: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n    queue = collections.deque([(initial_state, [])])\n\n    # Initialize a set to keep track of visited states.\n    # This prevents the search from getting stuck in loops and re-exploring paths to already seen states.\n    visited = set()\n    visited.add(_get_hashable_state(initial_state))\n\n    # Define a maximum search depth to prevent excessively long searches for very complex or impossible goals.\n    # This is a heuristic and might need adjustment based on typical task complexity.\n    MAX_SEARCH_DEPTH = 150 # A reasonable limit for many Craft tasks.\n\n    # Start the BFS loop.\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Pruning: If the current path length exceeds the maximum allowed depth,\n        # we stop exploring this path to control search complexity.\n        if len(current_path) > MAX_SEARCH_DEPTH:\n            continue\n\n        # Check if the current state satisfies the goal condition.\n        # The `satisfies` method checks if the goal_item_idx is present in the inventory.\n        # `goal_name` is ignored as per the method's documentation.\n        if current_state.satisfies(None, goal_item_idx):\n            return current_path # Goal reached, return the sequence of actions.\n\n        # Explore all possible actions from the current state.\n        # Actions include movement (DOWN, UP, LEFT, RIGHT) and interaction (USE).\n        for action in range(N_ACTIONS): # Iterate through actions 0, 1, 2, 3, 4\n            # Apply the action to the current state to get the next state.\n            # The `step` method handles all environment logic: agent movement,\n            # picking up items, and crafting at workshops if ingredients are present.\n            # The reward is consistently 0.0 in this environment, so we discard it.\n            _, next_state = current_state.step(action)\n\n            # Get the hashable representation of the new state to check if it has been visited.\n            hashable_next_state = _get_hashable_state(next_state)\n\n            # If the new state has not been visited before, add it to the visited set\n            # and enqueue it for further exploration.\n            if hashable_next_state not in visited:\n                visited.add(hashable_next_state)\n                # Append the new state and the updated path to the queue.\n                queue.append((next_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal was not found, it means the item\n    # cannot be crafted or obtained within the defined search limits.\n    return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-30T00:20:19.029941", "function_name": "craft", "function_body": "    # Define action constants based on typical CraftWorld setup\n    # These are usually 0-4 as per DMLab-style environments\n    DOWN = 0\n    UP = 1\n    LEFT = 2\n    RIGHT = 3\n    USE = 4\n    ACTIONS = [DOWN, UP, LEFT, RIGHT, USE]\n\n    def get_state_key(state):\n        \"\"\"\n        Creates a hashable representation of a CraftState for use in a `visited` set.\n        Converts mutable numpy arrays (grid, inventory) to bytes for hashing.\n        \"\"\"\n        grid_bytes = state.grid.tobytes()\n        inventory_bytes = state.inventory.tobytes()\n        return (grid_bytes, inventory_bytes, state.pos, state.dir)\n\n    # Get the initial state from the CraftLab environment.\n    # CraftLab holds the current simulation state in `_current_state`.\n    initial_state = env._current_state\n\n    # Initialize a queue for Breadth-First Search (BFS).\n    # Each element in the queue is a tuple: (current_state_object, list_of_actions_taken_to_reach_this_state).\n    # from collections import deque is assumed to be available from module imports.\n    from collections import deque\n    queue = deque([(initial_state, [])])\n\n    # Initialize a set to keep track of visited states.\n    # This prevents cycles and redundant computations, ensuring the shortest path is found.\n    # States are stored as their hashable keys generated by `get_state_key`.\n    visited = set()\n    visited.add(get_state_key(initial_state))\n\n    # Define a maximum path length to prevent the search from running indefinitely\n    # in cases where the goal is unreachable or the state space is very large.\n    # This acts as a practical limit for complex crafting sequences.\n    max_path_length = 200\n\n    while queue:\n        current_state, current_path = queue.popleft()\n\n        # Check if the current state satisfies the goal condition.\n        # The `satisfies` method of CraftState takes `goal_name` (ignored here) and `goal_arg` (item index).\n        if current_state.satisfies(goal_name=None, goal_arg=item):\n            return current_path\n\n        # If the current path has exceeded the maximum allowed length,\n        # prune this branch to avoid excessively long or computationally expensive searches.\n        if len(current_path) >= max_path_length:\n            continue\n\n        # Explore all possible actions from the current state.\n        for action in ACTIONS:\n            # Simulate the action to get the next state.\n            # `current_state.step(action)` returns a (reward, new_state) tuple.\n            # We are primarily interested in the `new_state` for pathfinding.\n            _, new_state = current_state.step(action)\n\n            # Get the hashable key for the newly generated state.\n            new_state_key = get_state_key(new_state)\n\n            # If this new state has not been visited before, add it to the queue\n            # and mark it as visited.\n            if new_state_key not in visited:\n                visited.add(new_state_key)\n                # Append the new state and the extended path to the queue.\n                queue.append((new_state, current_path + [action]))\n\n    # If the queue becomes empty and the goal state has not been found,\n    # it means the specified item is unreachable from the current environment state\n    # within the defined search limits.\n    return []", "island_id": 1, "scores": {"3": -1}}
