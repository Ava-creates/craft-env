{"timestamp": "2025-07-29T19:16:51.434147", "function_name": "collect", "function_body": "    actions_to_take = []\n\n    # Get the current CraftState object from the CraftLab environment.\n    # We must access internal state via `_current_state` as this function\n    # is meant for planning actions without executing them in the live environment.\n    state = env._current_state\n    \n    # Get grid dimensions for boundary checks\n    WIDTH, HEIGHT, N_KINDS = state.grid.shape\n\n    # Determine if the primitive is a 'grabbable' item (can be picked up with USE)\n    is_grabbable = primitive in state.world.grabbable_indices\n\n    # Define action mapping from names to integer IDs\n    # This assumes a consistent mapping across all CraftLab instances\n    _ACTION_MAP = {\n        'DOWN': 0,\n        'UP': 1,\n        'LEFT': 2,\n        'RIGHT': 3,\n        'USE': 4\n    }\n\n    # Use Breadth-First Search (BFS) to find the shortest path to a cell containing the primitive.\n    # The queue stores tuples of (current_position, path_taken_to_reach_current_position).\n    q = collections.deque([(state.pos, [])]) \n    visited = {state.pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n    target_path = None # Stores the path to the primitive once found\n\n    while q:\n        current_pos, path_so_far = q.popleft()\n\n        # Check if the current position contains the primitive\n        # If the primitive is found, this is the shortest path due to BFS property.\n        if state.grid[current_pos[0], current_pos[1], primitive] > 0:\n            target_path = path_so_far\n            break # Primitive found, exit BFS\n\n        # Explore possible moves to neighbors (UP, DOWN, LEFT, RIGHT)\n        moves = [\n            ('UP', (0, -1)),  # (action_name, (dx, dy))\n            ('DOWN', (0, 1)),\n            ('LEFT', (-1, 0)),\n            ('RIGHT', (1, 0))\n        ]\n\n        for action_name, (dx, dy) in moves:\n            new_x, new_y = current_pos[0] + dx, current_pos[1] + dy\n            new_pos = (new_x, new_y)\n\n            # 1. Check if the new position is within grid boundaries\n            if not (0 <= new_x < WIDTH and 0 <= new_y < HEIGHT):\n                continue\n\n            # 2. Check if the new position is blocked by an unpassable environment item.\n            # An item is considered an obstacle if it's in the world's 'environment' set\n            # (which contains non-grabbable features like BOUNDARY, WATER) AND\n            # it is NOT the target primitive itself (as we want to move onto the primitive\n            # if it's a non-grabbable like a WORKSHOP).\n            is_blocked = False\n            for k_idx in range(N_KINDS):\n                # If there's an item at the new_pos that is part of the environment (non-grabbable)\n                # and it's not the target primitive we're trying to reach, then it's an obstacle.\n                if state.grid[new_x, new_y, k_idx] > 0 and \\\n                   k_idx in state.world.environment and \\\n                   k_idx != primitive: \n                    is_blocked = True\n                    break\n            \n            if is_blocked:\n                continue # Cannot move to this position, skip\n\n            # 3. If the new position is valid and not blocked, and hasn't been visited yet\n            if new_pos not in visited:\n                visited.add(new_pos)\n                q.append((new_pos, path_so_far + [_ACTION_MAP[action_name]]))\n    \n    # If a path to the primitive was found\n    if target_path is not None:\n        actions_to_take = target_path\n        \n        # If the primitive is grabbable (e.g., WOOD, STONE), append a 'USE' action\n        # after reaching its location to collect it.\n        # If it's a non-grabbable primitive like a WORKSHOP, reaching its location is\n        # considered \"collecting\" it for the purpose of interaction in the DSL.\n        if is_grabbable:\n            actions_to_take.append(_ACTION_MAP['USE'])\n    \n    return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-29T19:16:52.439132", "function_name": "collect", "function_body": "  current_state = env._current_state\n  current_grid = current_state.grid\n  start_pos = current_state.pos\n  \n  # Get action mapping from the environment\n  ACTIONS = env.action_specs()\n  UP_ACTION = ACTIONS[\"UP\"]\n  DOWN_ACTION = ACTIONS[\"DOWN\"]\n  LEFT_ACTION = ACTIONS[\"LEFT\"]\n  RIGHT_ACTION = ACTIONS[\"RIGHT\"]\n  USE_ACTION = ACTIONS[\"USE\"]\n\n  # Get integer IDs for the primitive and boundary (to avoid moving into them)\n  primitive_id = env.world.cookbook.index.index(primitive)\n  boundary_id = env.world.cookbook.index.index(\"BOUNDARY\")\n\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  grid_width, grid_height, _ = current_grid.shape\n\n  # BFS queue: stores tuples of (current_position, list_of_actions_to_reach_this_position)\n  queue = collections.deque([(start_pos, [])]) \n  # Set of visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n\n  target_path_actions = []\n  target_found = False\n\n  # Define movement deltas for BFS exploration corresponding to actions\n  move_deltas = {\n      UP_ACTION: (0, -1),\n      DOWN_ACTION: (0, 1),\n      LEFT_ACTION: (-1, 0),\n      RIGHT_ACTION: (1, 0),\n  }\n\n  while queue:\n      current_bfs_pos, current_bfs_actions = queue.popleft()\n\n      # Check if the target primitive is at or adjacent to the current BFS position\n      if is_grabbable:\n          # If the primitive is grabbable, the agent needs to move onto its cell\n          if current_grid[current_bfs_pos[0], current_bfs_pos[1], primitive_id] > 0:\n              target_path_actions = current_bfs_actions\n              target_found = True\n              break\n      else: \n          # If the primitive is not grabbable (e.g., a workshop or resource like water/stone),\n          # the agent needs to be adjacent to it and then USE it.\n          \n          # Check 3x3 neighborhood around current_bfs_pos for the primitive\n          for dx in [-1, 0, 1]:\n              for dy in [-1, 0, 1]:\n                  # Skip the current cell itself when checking for adjacency\n                  if dx == 0 and dy == 0: \n                      continue \n                  \n                  nx, ny = current_bfs_pos[0] + dx, current_bfs_pos[1] + dy\n                  \n                  # Check boundary conditions for the neighbor cell\n                  if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                      # Check if the primitive is at this neighboring cell\n                      if current_grid[nx, ny, primitive_id] > 0:\n                          target_path_actions = current_bfs_actions + [USE_ACTION]\n                          target_found = True\n                          break # Found an adjacent primitive, this path is valid\n              if target_found: \n                  break # Exit outer dx loop if target found\n\n      if target_found: \n          break # Exit main while loop if target found\n\n      # If the target was not found at the current_bfs_pos or its neighborhood,\n      # explore unvisited, traversable neighbors\n      for action, (dx, dy) in move_deltas.items():\n          next_pos = (current_bfs_pos[0] + dx, current_bfs_pos[1] + dy)\n          \n          # Check bounds and if the next position has already been visited\n          if 0 <= next_pos[0] < grid_width and 0 <= next_pos[1] < grid_height and next_pos not in visited:\n              # Ensure the agent does not move onto a \"BOUNDARY\" cell, as these are typically not traversable\n              if current_grid[next_pos[0], next_pos[1], boundary_id] == 0: # Check if not a boundary\n                  visited.add(next_pos)\n                  queue.append((next_pos, current_bfs_actions + [action]))\n\n  return target_path_actions", "island_id": 3, "scores": {"3": -1}}
