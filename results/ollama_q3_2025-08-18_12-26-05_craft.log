{"timestamp": "2025-08-19T02:39:44.330403", "function_name": "craft", "function_body": "  # Get index of the target item\n  item_index = env.world.cookbook.index[item]\n\n  # Check if the target item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Find the type of workshop needed (if any)\n  workshop_type_needed = None\n  for ingredient, _ in env.world.cookbook.recipes[item_index].items():\n      if isinstance(ingredient, str) and \"workshop\" in ingredient:\n          workshop_type_needed = ingredient\n          break\n\n  actions = []\n\n  # If a specific workshop is required, navigate to it\n  if workshop_type_needed:\n      workshop_index = env.world.cookbook.index[workshop_type_needed]\n      for index in range(len(env.world.workshop_indices)):\n          if workshop_index == env.world.workshop_indices[index]:\n              workshop_pos = find_nearest_workshop_position(env.current_state.grid, workshop_index)\n              actions.extend(navigate_to_position(env.current_state.pos, workshop_pos))\n              break\n\n  # Use the workshop to craft the item\n  actions.append(4)  # Assuming USE action is represented by 4\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T02:39:46.259330", "function_name": "craft", "function_body": "  actions = []\n  \n  # Check if the goal is in the cookbook\n  index = env.world.cookbook.index[item]\n  if index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe for {item} in the cookbook.\")\n  \n  # Determine the workshop required to craft the item (assuming a single workshop type)\n  # For simplicity, we assume all workshops are of type WORKSHOP0\n  workshop_index = env.world.workshop_indices[0]\n  \n  # Navigate to the workshop\n  actions.extend(navigate_to_workshop(env, workshop_index))\n  \n  # Use the USE action to craft the item\n  actions.append(craft.USE)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-19T02:40:24.122412", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted\n  item_index = env.world.cookbook.index[item]\n  \n  # Find out the workshop required for crafting this item\n  recipe = env.world.cookbook.recipes[item_index]\n  if \"_key\" not in recipe:\n    raise ValueError(\"No specific key found in recipe, unknown how to craft.\")\n  workshop_type = recipe[\"_key\"]\n  workshop_indices = [index for index in env.world.workshop_indices if env.world.cookbook.index.get(env.world.cookbook.get(workshop_type)) == index]\n\n  # Find the nearest workshop\n  closest_workshop_index = None\n  closest_distance = float('inf')\n  current_pos = env._current_state.pos\n\n  for workshop_index in workshop_indices:\n    workshop_position = np.unravel_index(workshop_index, env.world.scenario.init_grid.shape[:2])\n    distance = abs(current_pos[0] - workshop_position[0]) + abs(current_pos[1] - workshop_position[1])\n\n    if distance < closest_distance:\n      closest_workshop_index = workshop_index\n      closest_distance = distance\n\n  # Generate the path to the nearest workshop and move there\n  path_to_workshop = a_star(env.world.scenario.init_grid, current_pos, np.unravel_index(closest_workshop_index, env.world.scenario.init_grid.shape[:2]))\n  actions_to_move = []\n  for next_pos in path_to_workshop[1:]:  # Skip the starting position\n    direction = determine_direction(current_pos, next_pos)\n    actions_to_move.append(direction)\n    current_pos = next_pos\n\n  # Add the action to use the workshop for crafting\n  actions_to_move.append(4)  # Assuming USE is action index 4\n  \n  return actions_to_move", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-19T02:40:26.091324", "function_name": "craft", "function_body": "  # Find the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  \n  # Iterate over each ingredient in the recipe\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\": continue\n    \n    # Find the index of the ingredient\n    ingredient_index = int(ingredient)\n    \n    # Check if we have enough of this ingredient in our inventory\n    while env._current_state.inventory[ingredient_index] < count:\n      actions.extend(collect_v1(env, ingredient_index))\n    \n    # Move to a workshop and use it to craft the item\n    workshop_index = env.world.workshop_indices[0]\n    actions.append(move_to_workshop(env, workshop_index))\n    actions.append(4)  # Use action\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-19T02:40:54.017165", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Fetch the recipe for the desired item (assuming it exists)\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}.\")\n  \n  # Determine the type of workshop required based on the item\n  workshop_type = None\n  if 'WORKSHOP0' in recipe.values():\n      workshop_type = 'WORKSHOP0'\n  elif 'WORKSHOP1' in recipe.values():\n      workshop_type = 'WORKSHOP1'\n  elif 'WORKSHOP2' in recipe.values():\n      workshop_type = 'WORKSHOP2'\n\n  # Get the index for the required workshop\n  workshop_index = env.world.cookbook.index[workshop_type]\n\n  actions = []\n  \n  # Move to a cell next to the required workshop (if not already there)\n  if not env._current_state.next_to(workshop_index):\n      actions.extend(find_path_to_workshop(env, workshop_index))\n\n  # Use the workshop to craft the item\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T02:40:55.955873", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find the required workshop type for crafting this item (stub)\n  workshop_type = find_required_workshop(item_index, env.world)\n\n  # List to hold actions\n  actions = []\n  \n  # Step 1: Move to the nearest workshop of the required type\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.pos, workshop_type, env.world.workshop_indices)\n  move_actions = move_to_position(nearest_workshop_pos, env._current_state)\n  actions.extend(move_actions)\n\n  # Step 2: Craft the item at the workshop (stub - assuming USE action to craft)\n  actions.append(craft.ACTIONS['USE'])\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T02:41:59.370191", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n    if len(workshop_locations) > 0: # Check if there is any location for the workshop\n      for loc in workshop_locations:\n        distance = np.linalg.norm(pos - loc, ord=2)\n        if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]).mean(axis=0)\n\n  while not np.array_equal(pos, target_pos):\n    dx, dy = target_pos - pos\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n    else: # Move in the y-direction next\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n    \n    pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T02:42:01.421472", "function_name": "craft", "function_body": "  def move_to_target(target_pos: np.ndarray):\n    nonlocal pos, actions\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy): # Move in the x-direction first\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else: # Move in the y-direction next\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n      pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in workshop_indices:\n    workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_pos) > 0: # Check if there is any location for the workshop\n      mean_workshop_pos = workshop_pos.mean(axis=0)\n      distance = np.linalg.norm(pos - mean_workshop_pos, ord=2)\n      \n      if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]).mean(axis=0)\n  \n  move_to_target(target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T02:43:01.599031", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_workshop_idx = None\n\n  for workshop_idx in workshop_indices:\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_positions) > 0:  # Ensure there are positions available for the workshop\n          distances = np.linalg.norm(workshop_positions - pos, axis=1)\n          min_distance = distances.min()\n          \n          if target_workshop_idx is None or min_distance < min_distance:\n              target_workshop_idx = workshop_idx\n\n  if target_workshop_idx is None:\n      raise ValueError(\"No available workshop found\")\n\n  # Determine the closest position to move towards for the selected workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, target_workshop_idx])\n  target_pos = min(workshop_positions, key=lambda p: np.linalg.norm(pos - p))\n\n  # Move towards the target position\n  while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      \n      if abs(dx) > abs(dy):  # Move in the x-direction first\n          actions.append(3 if dx > 0 else 2)\n      else:  # Move in the y-direction next\n          actions.append(1 if dy > 0 else 0)\n\n      pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T02:43:03.645386", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n    if len(workshop_positions) > 0: # Check if there is any location for the workshop\n      distances = np.linalg.norm(workshop_positions - pos, axis=1)\n      min_workshop_distance = distances.min()\n\n      if min_workshop_distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, min_workshop_distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n\n  # Calculate and follow a path to the nearest target position\n  for target_pos in target_positions:\n    actions.extend(navigate_to_target(pos, target_pos))\n  \n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-19T02:44:30.926751", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n  \n  # Retrieve all primitive ingredients required to make the item\n  primitives_needed = env.world.cookbook.primitives_for(i_item)\n\n  # Initialize a list to hold actions\n  actions = []\n\n  def find_closest_workshop(kind_index):\n    \"\"\"Finds the closest workshop that can produce an item of kind_index.\"\"\"\n    distances = []\n    for w in env.world.workshop_indices:\n      if w == kind_index:\n        workshop_pos = np.argwhere(env._current_state.grid[:, :, w] > 0)\n        if len(workshop_pos) > 0: # Check if there are any workshops\n          closest_workshop = min(workshop_pos, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n          distances.append((w, closest_workshop))\n    return min(distances, key=lambda x: np.linalg.norm(np.array(x[1]) - np.array(env._current_state.pos)), default=None)\n\n  def go_to_workshop(workshop_pos):\n    \"\"\"Navigate to the specified workshop position.\"\"\"\n    actions = []\n    target_x, target_y = workshop_pos\n    current_x, current_y = env._current_state.pos\n\n    while (current_x, current_y) != (target_x, target_y):\n      dx, dy = target_x - current_x, target_y - current_y\n      \n      # Determine the direction with the largest absolute difference\n      if abs(dx) > abs(dy):\n        actions.append(craft.RIGHT if dx > 0 else craft.LEFT)\n        current_x += 1 if dx > 0 else -1\n      else:\n        actions.append(craft.DOWN if dy > 0 else craft.UP)\n        current_y += 1 if dy > 0 else -1\n\n    return actions\n  \n  def navigate_to_and_use_workshop(kind_index):\n    \"\"\"Navigate to the specified workshop and use it.\"\"\"\n    closest_workshop = find_closest_workshop(kind_index)\n    \n    if closest_workshop:\n      workshop_kind, workshop_pos = closest_workshop\n      actions.extend(go_to_workshop(workshop_pos))\n      actions.append(craft.USE)\n\n  # Collect all required primitives\n  for primitive, count in primitives_needed.items():\n    i_primitive = env.world.cookbook.index[primitive]\n    \n    # Navigate to the correct workshop and collect the required amount of primitives\n    for _ in range(count):\n        navigate_to_and_use_workshop(i_primitive)\n  \n  # Craft the final item at its workshop\n  navigate_to_and_use_workshop(i_item)\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T02:44:32.999568", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n\n  # Retrieve all primitive ingredients required to make the item\n  primitives_needed = env.world.cookbook.primitives_for(i_item)\n\n  actions = []\n\n  def find_closest_workshop(kind_index):\n    \"\"\"Finds the closest workshop that can produce an item of kind_index.\"\"\"\n    distances = []\n    for w in env.world.workshop_indices:\n      if w == kind_index:\n        workshop_pos = np.argwhere(env._current_state.grid[:, :, w] > 0)\n        if len(workshop_pos) > 0: # Check if there are any workshops\n          closest_workshop = min(workshop_pos, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n          distances.append((w, closest_workshop))\n    return min(distances, key=lambda x: np.linalg.norm(np.array(x[1]) - np.array(env._current_state.pos)), default=None)\n\n  def go_to_workshop(workshop_pos):\n    \"\"\"Navigate to the specified workshop position.\"\"\"\n    actions = []\n    target_x, target_y = workshop_pos\n    current_x, current_y = env._current_state.pos\n\n    while (current_x, current_y) != (target_x, target_y):\n      dx, dy = target_x - current_x, target_y - current_y\n      \n      # Determine the direction with the largest absolute difference\n      if abs(dx) > abs(dy):\n        actions.append(craft.RIGHT if dx > 0 else craft.LEFT)\n        current_x += 1 if dx > 0 else -1\n      else:\n        actions.append(craft.DOWN if dy > 0 else craft.UP)\n        current_y += 1 if dy > 0 else -1\n\n    return actions\n  \n  def craft_item_at_workshop(kind_index):\n    \"\"\"Craft the item at the correct workshop.\"\"\"\n    return [craft.USE]\n\n  # Find all required workshops and collect necessary primitives\n  for primitive, count in primitives_needed.items():\n      i_primitive = env.world.cookbook.index[primitive]\n      closest_workshop = find_closest_workshop(i_primitive)\n      \n      if closest_workshop:\n          workshop_kind, workshop_pos = closest_workshop\n          actions.extend(go_to_workshop(workshop_pos))\n          \n          # Collect the required amount of primitives\n          for _ in range(count):\n              actions.append(craft.USE)\n\n  # Now craft the final item at its workshop\n  closest_workshop = find_closest_workshop(i_item)\n  if closest_workshop:\n      workshop_kind, workshop_pos = closest_workshop\n      actions.extend(go_to_workshop(workshop_pos))\n      actions.extend(craft_item_at_workshop(workshop_kind))\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T02:45:28.906365", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) > 0: # Check if there is any location for the workshop\n      for workshop_pos in workshop_positions:\n        distance = np.linalg.norm(pos - workshop_pos, ord=2)\n        if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n\n  for target_pos in target_positions:\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy): # Move in the x-direction first\n              actions.append(3 if dx > 0 else 2)\n          else: # Move in the y-direction next\n              actions.append(1 if dy > 0 else 0)\n\n          pos += np.array([np.sign(dx), np.sign(dy)])\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n      # Check if the crafting is done by checking if the inventory has the crafted item\n      if env._current_state.inventory[goal_index] > 0:\n          break\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T02:45:30.991200", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n\n  min_distance, target_workshop_pos = float('inf'), None\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) > 0: # Check if there is any location for the workshop\n      distances = np.linalg.norm(workshop_positions - pos, axis=1)\n      closest_workshop_pos = workshop_positions[np.argmin(distances)]\n      distance = np.linalg.norm(closest_workshop_pos - pos)\n\n      if distance < min_distance:\n        min_distance = distance\n        target_workshop_pos = closest_workshop_pos\n\n  if target_workshop_pos is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  while not np.array_equal(pos, target_workshop_pos):\n    dx, dy = target_workshop_pos - pos\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      actions.append(3 if dx > 0 else 2)\n    else: # Move in the y-direction next\n      actions.append(1 if dy > 0 else 0)\n\n    pos += np.array([np.sign(dx), np.sign(dy)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T02:46:22.817319", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy):\n        actions.append(3 if dx > 0 else 2)\n      elif dy != 0:\n        actions.append(1 if dy > 0 else 0)\n      pos += np.array([np.sign(dx), np.sign(dy)])\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  closest_workshop_idx, target_pos = None, None\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n      for workshop_pos in workshop_positions:\n        distance = np.linalg.norm(pos - workshop_pos, ord=2)\n        if distance < min_distance:\n          closest_workshop_idx, target_pos, min_distance = workshop_idx, workshop_pos, distance\n\n  if closest_workshop_idx is None or target_pos is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  actions.extend(move_towards(pos, target_pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T02:46:25.294038", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    dx, dy = target_pos - pos\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif dy != 0:\n      return 1 if dy > 0 else 0\n    return None\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  closest_workshop_idx, target_pos = None, None\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n      for workshop_pos in workshop_positions:\n        distance = np.linalg.norm(pos - workshop_pos, ord=2)\n        if distance < min_distance:\n          closest_workshop_idx, target_pos, min_distance = workshop_idx, workshop_pos, distance\n\n  if closest_workshop_idx is None or target_pos is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  while not np.array_equal(pos, target_pos):\n    direction = move_towards(pos, target_pos)\n    actions.append(direction)\n\n    # Update position based on the action taken\n    if direction == 3:  # RIGHT\n      pos += np.array([1, 0])\n    elif direction == 2:  # LEFT\n      pos += np.array([-1, 0])\n    elif direction == 1:  # UP\n      pos += np.array([0, 1])\n    elif direction == 0:  # DOWN\n      pos += np.array([0, -1])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 3.7}}
