{"timestamp": "2025-08-19T00:38:38.004978", "function_name": "craft", "function_body": "  # Step 1: Determine the required workshop for crafting\n  cookbook = env.world.cookbook.recipes\n  item_index = env.world.cookbook.index[item]\n  recipe = cookbook.get(item_index)\n  \n  if not recipe:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Assuming there's only one workshop type that can craft the item (for simplicity)\n  workshop_types = [k for k in env.world.workshop_indices if recipe.get(k, 0) > 0]\n  \n  if len(workshop_types) == 0:\n    raise ValueError(f\"No suitable workshop found for crafting {item}\")\n\n  # Choose the first available workshop type\n  workshop_index = workshop_types[0]\n\n  # Step 2: Move to a cell next to the chosen workshop\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  # Find positions of all workshops in the grid\n  workshop_positions = np.argwhere(grid[:, :, workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop of type {workshop_index} found on the grid\")\n\n  # Choose the nearest workshop to the current position\n  min_distance = float('inf')\n  nearest_workshop_pos = None\n\n  for wp in workshop_positions:\n    distance = np.linalg.norm(np.array(pos) - np.array(wp))\n    if distance < min_distance:\n      min_distance = distance\n      nearest_workshop_pos = tuple(wp)\n\n  # Calculate the direction to move towards the nearest workshop\n  actions = []\n  while pos != nearest_workshop_pos:\n    dx, dy = nearest_workshop_pos[0] - pos[0], nearest_workshop_pos[1] - pos[1]\n    \n    if abs(dx) > abs(dy):\n      if dx < 0:\n        actions.append(2)  # LEFT\n      else:\n        actions.append(3)  # RIGHT\n    else:\n      if dy < 0:\n        actions.append(0)  # DOWN\n      else:\n        actions.append(1)  # UP\n    \n    pos = (pos[0] + (dx != 0), pos[1] + (dy != 0))\n\n  # Step 3: Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
