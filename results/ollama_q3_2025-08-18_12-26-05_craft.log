{"timestamp": "2025-08-18T14:34:19.198552", "function_name": "craft", "function_body": "  def go_to_workshop(workshop_idx):\n    # Function to generate actions to move the agent to a workshop\n    current_pos = env._current_state.pos\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx] > 0)\n    \n    if not workshop_positions.size:\n      raise ValueError(f\"No workshops for type {workshop_idx} found in the grid.\")\n      \n    target_pos = tuple(workshop_positions[0])  # Choosing the first available workshop\n    path_actions = a_star_search(current_pos, target_pos, env._current_state.grid)\n    \n    return path_actions\n  \n  def use_workshop():\n    # Function to generate action to use the workshop\n    return [craft.CRAFT_FUNC(craft.USE)]\n  \n  item_idx = env.world.cookbook.index[item]\n  workshop_idx = get_workshop_for_item(item_idx, env.world)\n  workshop_actions = go_to_workshop(workshop_idx)\n  use_action = use_workshop()\n  \n  return workshop_actions + use_action", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-18T15:07:07.148922", "function_name": "craft", "function_body": "  def move_to(workshop_index):\n    current_pos = env._current_state.pos\n    grid = env._current_state.grid\n    target_pos = find_closest_workshop(current_pos, grid, workshop_index)\n    path = find_path(grid, current_pos, target_pos)\n    actions = convert_path_to_actions(path)\n    return actions\n\n  def find_closest_workshop(start_pos, grid, workshop_index):\n    min_distance = float('inf')\n    closest_position = None\n    for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n        if grid[x, y, workshop_index] > 0:\n          distance = abs(x - start_pos[0]) + abs(y - start_pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_position = (x, y)\n    return closest_position\n\n  def find_path(grid, start, end):\n    queue = collections.deque([start])\n    visited = set()\n    parent = {start: None}\n\n    while queue:\n      current = queue.popleft()\n      if current == end:\n        break\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1] and grid[neighbor] == 0 and neighbor not in visited:\n          queue.append(neighbor)\n          visited.add(neighbor)\n          parent[neighbor] = current\n\n    path = []\n    while end:\n      path.append(end)\n      end = parent[end]\n    return path[::-1]\n\n  def convert_path_to_actions(path):\n    actions = []\n    current_pos = env._current_state.pos\n    for target in path[1:]:\n      dx, dy = target[0] - current_pos[0], target[1] - current_pos[1]\n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n      current_pos = target\n    return actions\n\n  item_idx = env.world.cookbook.index[item]\n\n  # Retrieve the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_idx, {})\n\n  if not recipe:\n    return []\n\n  # Initialize a list to hold actions\n  actions = []\n\n  # Move to the workshop if required (simplified logic)\n  if \"_key\" in recipe:\n    key = recipe[\"_key\"]\n    if key == \"workshop0\":\n      actions.extend(move_to(env.world.workshop_indices[0]))\n    elif key == \"workshop1\":\n      actions.extend(move_to(env.world.workshop_indices[1]))\n    elif key == \"workshop2\":\n      actions.extend(move_to(env.world.workshop_indices[2]))\n\n  # Craft the item\n  actions.append(4)  # Assuming 4 corresponds to USE action\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
