{"timestamp": "2025-08-19T03:36:38.561168", "function_name": "craft", "function_body": "  UP = 1\n  DOWN = 0\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions = []\n\n  # Get the index of the item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n\n  # Find the workshop needed for crafting this item (more complex logic)\n  # This is a placeholder function to find the workshop position dynamically\n  def find_workshop_position(env, item_idx):\n      # Placeholder logic: assume each item has a corresponding workshop index\n      # For simplicity, let's assume workshops are indexed from 10 onwards and we map them directly\n      workshop_index = item_idx + 10  # This is just an example; in reality, you might need to look it up dynamically\n\n      # Placeholder logic: assume each workshop has a fixed position based on its index\n      # For simplicity, let's assume the positions are calculated as follows:\n      workshop_positions = {\n          20: (10, 10),  # Example position for workshop_index 20\n          21: (15, 15),  # Example position for workshop_index 21\n          # Add more mappings as needed\n      }\n      return workshop_positions.get(workshop_index, (10, 10))  # Default to (10, 10) if not found\n\n  workshop_pos = find_workshop_position(env, item_idx)\n\n  # Calculate the direction to move towards the workshop\n  agent_pos = env._current_state.pos\n  dx = workshop_pos[0] - agent_pos[0]\n  dy = workshop_pos[1] - agent_pos[1]\n\n  if dy > 0:\n      actions.extend([UP] * abs(dy))\n  elif dy < 0:\n      actions.extend([DOWN] * abs(dy))\n\n  if dx > 0:\n      actions.extend([RIGHT] * abs(dx))\n  elif dx < 0:\n      actions.extend([LEFT] * abs(dx))\n\n  # Use the workshop to craft the item\n  actions.append(USE)\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T03:37:42.862109", "function_name": "craft", "function_body": "  # First, get the index of the item to craft\n  item_index = env.world.cookbook.index[item]\n\n  # Determine which workshop is needed for crafting this item\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      required_workshop = int(recipe[\"_key\"])\n  else:\n      # If no specific workshop is specified, just use the first available workshop\n      required_workshop = env.world.workshop_indices[0]\n\n  actions_to_take = []\n\n  # Find a position near the required workshop\n  workshop_index = env.world.index.get(required_workshop)\n  grid_size = (env.world.cookbook.n_kinds, env.world.scenario.init_grid.shape[0], env.world.scenario.init_grid.shape[1])\n  found_workshop_position = False\n\n  for x in range(grid_size[1]):\n      for y in range(grid_size[2]):\n          if env._current_state.grid[x, y, required_workshop] > 0:\n              workshop_pos = (x, y)\n              found_workshop_position = True\n              break\n      if found_workshop_position:\n          break\n\n  if not found_workshop_position:\n      raise ValueError(f\"No position found for the required workshop {required_workshop}\")\n\n  # Move to the workshop position\n  current_x, current_y = env._current_state.pos\n  direction = env._current_state.dir\n\n  while (current_x, current_y) != workshop_pos:\n      delta_x = workshop_pos[0] - current_x\n      delta_y = workshop_pos[1] - current_y\n\n      if abs(delta_x) > abs(delta_y):\n          # Prioritize moving horizontally\n          target_direction = 2 if delta_x < 0 else 3\n      else:\n          # Prioritize moving vertically\n          target_direction = 0 if delta_y < 0 else 1\n\n      if direction == target_direction:\n          actions_to_take.append(4)  # USE action to move in the current direction\n      elif (direction + 1) % 4 == target_direction:\n          actions_to_take.append(3)  # RIGHT turn\n      elif (direction - 1) % 4 == target_direction:\n          actions_to_take.append(2)  # LEFT turn\n      else:\n          actions_to_take.extend([2, 2])  # Make a U-turn\n\n      current_x += (-1 if direction == 0 else 1 if direction == 1 else 0)\n      current_y += (-1 if direction == 3 else 1 if direction == 2 else 0)\n\n      direction = target_direction\n      actions_to_take.append(4)  # USE action to move in the current direction\n\n  # Craft the item using the workshop\n  actions_to_take.extend([4])  # USE action to craft at the workshop\n\n  return actions_to_take", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:37:44.730134", "function_name": "craft", "function_body": "  # Get the index for the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  if item_index not in env.world.cookbook.recipes:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  # Find the workshop that can produce the desired item\n  possible_workshops = []\n  for workshop_index in env.world.workshop_indices:\n    workshop_name = env.world.cookbook.index.get(workshop_index, None)\n    if not workshop_name:\n        continue\n    # Check if any recipe using this workshop has the goal item as output\n    for output_item, ingredients in env.world.cookbook.recipes.items():\n      if output_item == item_index and \"_key\" in ingredients and ingredients[\"_key\"] == workshop_name:\n          possible_workshops.append(workshop_index)\n  \n  if not possible_workshops:\n      raise ValueError(f\"No suitable workshop found to craft {item}\")\n\n  # Choose the nearest workshop\n  current_position = env._current_state.pos\n  nearest_workshop = min(possible_workshops, key=lambda ws: np.linalg.norm(np.array(env.world.workshop_indices) - np.array(current_position)))\n  \n  # Generate actions to move towards the nearest workshop\n  target_pos = env.world.workshop_indices[nearest_workshop]\n  grid = env._current_state.grid\n  path_to_workshop = astar(grid, current_position, target_pos)\n\n  actions = []\n  for next_pos in path_to_workshop:\n      direction = get_direction(current_position, next_pos)\n      move_action = direction_to_action(direction)\n      actions.append(move_action)\n      current_position = next_pos\n\n  # Add the USE action to use the workshop\n  actions.append(env.world.N_ACTIONS - 1)  # Assuming USE is the last action\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:38:58.904072", "function_name": "craft", "function_body": "  def find_nearest_workshop(kind_indices, current_pos=None):\n    \"\"\"Finds the nearest workshop among given indices.\"\"\"\n    if current_pos is None:\n      current_pos = env._current_state.pos\n    \n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for kind_index in kind_indices:\n      for x in range(env._current_state.grid.shape[0]):\n        for y in range(env._current_state.grid.shape[1]):\n          if np.any(env._current_state.grid[x, y] == kind_index):\n            distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n            if distance < min_distance:\n              min_distance = distance\n              closest_workshop_pos = (x, y)\n    \n    return closest_workshop_pos\n\n  def navigate_grid(target_pos, current_pos=None, direction=None):\n    \"\"\"Navigates from current position to target position.\"\"\"\n    if current_pos is None:\n      current_pos = env._current_state.pos\n    \n    if direction is None:\n      direction = env._current_state.dir\n    \n    actions = []\n    target_x, target_y = target_pos\n    \n    # Calculate the difference in x and y coordinates\n    delta_x = target_x - current_pos[0]\n    delta_y = target_y - current_pos[1]\n\n    # Determine the direction to move based on the differences\n    if delta_x > 0:\n      actions.extend([craft.RIGHT] * abs(delta_x))\n    elif delta_x < 0:\n      actions.extend([craft.LEFT] * abs(delta_x))\n    \n    if delta_y > 0:\n      actions.extend([craft.DOWN] * abs(delta_y))\n    elif delta_y < 0:\n      actions.extend([craft.UP] * abs(delta_y))\n\n    return actions\n\n  def go_to_workshop(kind_indices):\n    \"\"\"Navigates to the nearest workshop among given indices.\"\"\"\n    closest_workshop_pos = find_nearest_workshop(kind_indices)\n    if closest_workshop_pos:\n      current_pos = env._current_state.pos\n      direction = env._current_state.dir\n      return navigate_grid(closest_workshop_pos, current_pos, direction)\n    else:\n      return []\n\n  def craft_item_at_workshop():\n    \"\"\"Uses the USE action at the correct workshop to craft the item.\"\"\"\n    return [craft.USE]\n\n  i_item = env.world.cookbook.index[item]\n  primitives_needed = env.world.cookbook.primitives_for(i_item)\n  workshop_kind_indices = env.world.workshop_indices\n  \n  actions = []\n  actions.extend(go_to_workshop(workshop_kind_indices))\n  actions.extend(craft_item_at_workshop())\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:39:00.922001", "function_name": "craft", "function_body": "  def find_nearest_workshop(kind_index):\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if np.any(env._current_state.grid[x, y] == kind_index):\n          distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (x, y)\n    \n    return closest_workshop_pos\n\n  def navigate_grid(target_pos):\n    actions = []\n    target_x, target_y = target_pos\n    current_x, current_y = env._current_state.pos\n    \n    # Calculate the difference in x and y coordinates\n    delta_x = target_x - current_x\n    delta_y = target_y - current_y\n\n    # Determine the direction to move based on the differences\n    if delta_x > 0:\n      actions.extend([craft.RIGHT] * abs(delta_x))\n    elif delta_x < 0:\n      actions.extend([craft.LEFT] * abs(delta_x))\n    \n    if delta_y > 0:\n      actions.extend([craft.DOWN] * abs(delta_y))\n    elif delta_y < 0:\n      actions.extend([craft.UP] * abs(delta_y))\n\n    return actions\n\n  def go_to_workshop(kind_index):\n    workshop_position = find_nearest_workshop(kind_index)\n    if workshop_position:\n      current_pos = env._current_state.pos\n      direction = env._current_state.dir\n      actions = navigate_grid(workshop_position, current_pos, direction)\n      actions.append(craft.USE)\n      return actions\n    else:\n      return []\n\n  def craft_item_at_workshop(kind_index):\n    # Logic to use the USE action at the correct workshop to craft the item\n    return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = env.world.workshop_indices\n  actions = []\n  \n  for workshop_index in workshop_kind_indices:\n    if go_to_workshop(workshop_index):\n      actions.extend(craft_item_at_workshop(item_index))\n      break\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T03:40:37.421253", "function_name": "craft", "function_body": "  def move_to_workshop(env, workshop_index):\n    # Implement logic to determine and generate actions to move to the specified workshop.\n    current_pos = env._current_state.pos\n    grid = env._current_state.grid\n    \n    path = find_path(grid, current_pos, workshop_index)\n    \n    if not path:\n        raise ValueError(\"No valid path found to reach the workshop.\")\n    \n    actions = []\n    for next_pos in path[1:]:  # Skip starting position\n        direction = get_direction(current_pos, next_pos)\n        actions.append(direction)\n        current_pos = next_pos\n    \n    return actions\n\n  def find_path(grid, start_pos, target_index):\n      # Implement A* or BFS to find a path from start_pos to any cell containing the target_index in the grid.\n      width, height, _ = grid.shape\n      queue = collections.deque([start_pos])\n      visited = set()\n      parent = {start_pos: None}\n      \n      while queue:\n          pos = queue.popleft()\n          \n          if pos in visited:\n              continue\n          visited.add(pos)\n          \n          x, y = pos\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              \n              if 0 <= nx < width and 0 <= ny < height and grid[nx][ny][target_index] == 1:\n                  return reconstruct_path(parent, start_pos, (nx, ny))\n              \n              if 0 <= nx < width and 0 <= ny < height and grid[nx][ny].sum() > 0:  # Walkable cell\n                  new_pos = (nx, ny)\n                  if new_pos not in visited:\n                      parent[new_pos] = pos\n                      queue.append(new_pos)\n      \n      return None\n\n  def reconstruct_path(parent, start, goal):\n      path = [goal]\n      while path[-1] != start:\n          path.append(parent[path[-1]])\n      return list(reversed(path))\n\n  def get_direction(current_pos, next_pos):\n      x1, y1 = current_pos\n      x2, y2 = next_pos\n      \n      if x2 < x1:\n          return 0  # DOWN\n      elif x2 > x1:\n          return 1  # UP\n      elif y2 < y1:\n          return 2  # LEFT\n      elif y2 > y1:\n          return 3  # RIGHT", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:40:39.433488", "function_name": "craft", "function_body": "  def move_to_workshop(env, workshop_index):\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    actions = []\n\n    # Simple A* algorithm for pathfinding to the workshop\n\n    def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n    def neighbors(pos):\n      x, y = pos\n      moves = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      return [move for move in moves if 0 <= move[0] < grid.shape[0] and 0 <= move[1] < grid.shape[1]]\n\n    open_set = collections.PriorityQueue()\n    open_set.put((0, pos))\n    came_from = {}\n    g_score = {pos: 0}\n    \n    while not open_set.empty():\n      _, current_pos = open_set.get()\n      \n      if grid[current_pos][workshop_index] == 1:\n        path = []\n        while current_pos in came_from:\n          path.append(current_pos)\n          current_pos = came_from[current_pos]\n        path.reverse()\n        break\n      \n      for neighbor in neighbors(current_pos):\n        tentative_g_score = g_score[current_pos] + 1\n        \n        if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n          came_from[neighbor] = current_pos\n          g_score[neighbor] = tentative_g_score\n          f_score = tentative_g_score + heuristic(neighbor, pos)\n          open_set.put((f_score, neighbor))\n    \n    for i in range(len(path) - 1):\n      dx = path[i+1][0] - path[i][0]\n      dy = path[i+1][1] - path[i][1]\n      \n      if dx == 1:\n        actions.append(3)  # RIGHT\n      elif dx == -1:\n        actions.append(2)  # LEFT\n      elif dy == 1:\n        actions.append(1)  # UP\n      elif dy == -1:\n        actions.append(0)  # DOWN\n    \n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n      raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Determine if a specific workshop is needed\n  key_workshop = recipe.get(\"_key\")\n  if key_workshop:\n    workshop_name = f\"WORKSHOP{int(key_workshop)}\"\n    workshop_index = env.world.cookbook.index[workshop_name]\n    \n    if workshop_index not in env.world.workshop_indices:\n        raise ValueError(f\"Workshop {key_workshop} not found in the list of workshops.\")\n    \n    # Move to the specific workshop\n    actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item\n  actions.append(4)  # USE action\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T03:41:15.266771", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  if item_index is None:\n    raise ValueError(f\"Item '{item}' not found in the cookbook.\")\n  \n  # Check if we have a recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  actions = []\n  \n  # Determine if a specific workshop is needed\n  key_workshop = recipe.get(\"_key\")\n  if key_workshop:\n      workshop_name = f\"WORKSHOP{int(key_workshop)}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      if workshop_index not in env.world.workshop_indices:\n          raise ValueError(f\"Workshop {key_workshop} not found in the list of workshops.\")\n      \n      # Move to the specific workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item\n  actions.append(4)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T03:41:17.246197", "function_name": "craft", "function_body": "  def move_to_workshop(env, workshop_index):\n    # This function should navigate to the given workshop\n    # Here we assume that the environment provides a method to find the path to a specific index\n    return env.world.find_path_to(workshop_index)\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  actions = []\n  \n  # Determine if a specific workshop is needed\n  key_workshop = recipe.get(\"_key\")\n  if key_workshop:\n      workshop_name = f\"WORKSHOP{int(key_workshop)}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      if workshop_index not in env.world.workshop_indices:\n          raise ValueError(f\"Workshop {key_workshop} not found in the list of workshops.\")\n      \n      # Move to the specific workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item\n  actions.append(4)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T03:42:23.388298", "function_name": "craft", "function_body": "  def move_to_target(target_pos: np.ndarray):\n    nonlocal pos, actions\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n\n      # Determine the direction to move\n      if abs(dx) > abs(dy): \n        direction = 3 if dx > 0 else 2\n      else: \n        direction = 1 if dy > 0 else 0\n\n      actions.append(direction)\n      pos += np.array([direction == 3, direction == 1]) - np.array([direction == 2, direction == 0])\n\n  def find_closest_workshop(workshop_indices):\n    nonlocal pos\n    min_distance = float('inf')\n    closest_workshop_idx = None\n\n    for workshop_idx in workshop_indices:\n      workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      if len(workshop_pos) > 0: \n        mean_workshop_pos = workshop_pos.mean(axis=0)\n        distance = np.linalg.norm(pos - mean_workshop_pos, ord=2)\n\n        if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n    return closest_workshop_idx, min_distance\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = find_closest_workshop(workshop_indices)\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]).mean(axis=0)\n  \n  move_to_target(target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:42:25.370726", "function_name": "craft", "function_body": "  def find_closest_workshop(pos: np.ndarray):\n    closest_workshop_idx = None\n    min_distance = float('inf')\n\n    for workshop_idx in env.world.workshop_indices:\n      workshop_locations = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n\n      if len(workshop_locations) > 0: # Check if there is any location for the workshop\n        mean_workshop_pos = workshop_locations.mean(axis=0)\n        distance = np.linalg.norm(pos - mean_workshop_pos, ord=2)\n\n        if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n    return closest_workshop_idx\n\n  def move_to_target(target_pos: np.ndarray):\n    nonlocal pos, actions\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy): # Move in the x-direction first\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else: # Move in the y-direction next\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n    \n      pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx = find_closest_workshop(pos)\n  \n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]).mean(axis=0)\n\n  move_to_target(target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T03:48:32.120430", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    dx, dy = target_pos - pos\n    directions = []\n    while not np.array_equal(pos, target_pos):\n      if abs(dx) > abs(dy):\n        direction = 3 if dx > 0 else 2\n        pos += np.array([1 if dx > 0 else -1, 0])\n      elif dy != 0:\n        direction = 1 if dy > 0 else 0\n        pos += np.array([0, 1 if dy > 0 else -1])\n      directions.append(direction)\n    return directions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n  actions_list = []\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n      min_distance = float('inf')\n      closest_workshop_actions = None\n\n      for workshop_pos in workshop_positions:\n        current_pos = np.array(env._current_state.pos)\n        actions = move_towards(current_pos, workshop_pos)\n\n        # Use the workshop to craft the item\n        actions.append(4)  # USE\n\n        distance = np.linalg.norm(np.array(env._current_state.pos) - workshop_pos)\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_actions = actions\n\n      if closest_workshop_actions is not None:\n        actions_list.append(closest_workshop_actions)\n\n  if not actions_list:\n    raise ValueError(\"No available workshop found\")\n\n  # Choose the shortest path to a workshop\n  return min(actions_list, key=len)", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:48:34.389736", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    dx, dy = target_pos - pos\n    directions = []\n    if dx > 0:\n      directions.append(3)  # RIGHT\n    elif dx < 0:\n      directions.append(2)  # LEFT\n    if dy > 0:\n      directions.append(1)  # UP\n    elif dy < 0:\n      directions.append(0)  # DOWN\n    return directions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n  actions_list = []\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n      for workshop_pos in workshop_positions:\n        pos = np.array(env._current_state.pos)\n        min_distance = float('inf')\n        actions = []\n\n        # Move to the closest workshop\n        while not np.array_equal(pos, workshop_pos):\n          directions = move_towards(pos, workshop_pos)\n\n          if len(directions) == 1:\n            direction = directions[0]\n          elif env._current_state.dir in directions:\n            direction = env._current_state.dir\n          else:\n            direction = directions[0]\n\n          actions.append(direction)\n\n          # Update position based on the action taken\n          if direction == 3:  # RIGHT\n            pos += np.array([1, 0])\n          elif direction == 2:  # LEFT\n            pos += np.array([-1, 0])\n          elif direction == 1:  # UP\n            pos += np.array([0, 1])\n          elif direction == 0:  # DOWN\n            pos += np.array([0, -1])\n\n        # Use the workshop to craft the item\n        actions.append(4)  # USE\n\n        distance = np.linalg.norm(np.array(env._current_state.pos) - workshop_pos)\n        if distance < min_distance:\n        