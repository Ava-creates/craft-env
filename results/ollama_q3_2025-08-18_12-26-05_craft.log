y > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 3.7}}
{"timestamp": "2025-08-19T03:27:07.810772", "function_name": "craft", "function_body": "  def move_to_target(target_pos: np.ndarray):\n    nonlocal pos, actions\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy): # Move in the x-direction first\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else: # Move in the y-direction next\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n      pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  def find_closest_workshop(item_index):\n    workshop_indices = env.world.workshop_indices\n    min_distance = float('inf')\n    closest_workshop_idx = None\n    \n    for workshop_idx in workshop_indices:\n        workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n        \n        if len(workshop_pos) == 0: # No workshop of this type on the grid\n            continue\n        \n        mean_workshop_pos = workshop_pos.mean(axis=0)\n        distance = np.linalg.norm(pos - mean_workshop_pos, ord=2)\n        \n        if distance < min_distance:\n            closest_workshop_idx, min_distance = workshop_idx, distance\n    \n    return closest_workshop_idx\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n\n  # Determine which workshops can craft the desired item\n  recipe = cookbook.recipes[goal_index]\n  valid_workshop_indices = set()\n  \n  for ingredient, amount in recipe.items():\n      if ingredient not in env.world.workshop_capabilities:\n          continue\n      \n      for workshop_idx in env.world.workshop_capabilities[ingredient]:\n          valid_workshop_indices.add(workshop_idx)\n\n  # If no valid workshops found\n  if not valid_workshop_indices:\n    raise ValueError(\"No available workshop can craft the desired item\")\n\n  # Find the closest valid workshop\n  closest_workshop_idx = find_closest_workshop(goal_index)\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest valid workshop\n  target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]).mean(axis=0)\n  \n  move_to_target(target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:27:09.711104", "function_name": "craft", "function_body": "  def move_to_target(target_pos: np.ndarray):\n    nonlocal pos, actions\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      # Prioritize moving in the direction with larger distance to minimize steps\n      if abs(dx) >= abs(dy): \n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else: \n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n      pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  # Find the closest workshop that can craft the desired item\n  # This requires checking which workshops have the necessary recipes to produce the goal item.\n  workshop_indices = env.world.workshop_indices\n  available_workshops = []\n\n  for workshop_idx in workshop_indices:\n      if any(goal_index in recipe for recipe in cookbook.recipes.values()):\n          available_workshops.append(workshop_idx)\n\n  if not available_workshops:\n    raise ValueError(\"No workshop found that can craft the desired item\")\n\n  actions = []\n  pos = np.array(env._current_state.pos)\n  \n  # Find the closest available workshop\n  closest_workshop_idx, min_distance = None, float('inf')\n  \n  for workshop_idx in available_workshops:\n      workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n      \n      if len(workshop_pos) > 0: \n          mean_workshop_pos = workshop_pos.mean(axis=0)\n          distance = np.linalg.norm(pos - mean_workshop_pos, ord=2)\n          \n          if distance < min_distance:\n              closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]).mean(axis=0)\n  \n  move_to_target(target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
