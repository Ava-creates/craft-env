{"timestamp": "2025-08-18T18:02:09.492938", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_index):\n    # Find the nearest workshop that can produce the desired item\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if np.any(env._current_state.grid[x, y] == kind_index):\n          distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (x, y)\n    \n    return closest_workshop_pos\n\n  def go_to_workshop(workshop_pos):\n    # Navigate to the specified workshop position using BFS\n    actions = []\n    target_x, target_y = workshop_pos\n    \n    queue = collections.deque([(env._current_state.pos[0], env._current_state.pos[1], [])])\n    visited = set()\n    \n    while queue:\n      current_x, current_y, path = queue.popleft()\n      \n      if (current_x, current_y) == (target_x, target_y):\n        actions.extend(path)\n        break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x, new_y = current_x + dx, current_y + dy\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1] and (new_x, new_y) not in visited:\n          visited.add((new_x, new_y))\n          queue.append((new_x, new_y, path + [get_move_action(dx, dy)]))\n    \n    return actions\n\n  def get_move_action(dx, dy):\n    # Determine the move action based on the difference in coordinates\n    if dx > 0:\n      return craft.RIGHT\n    elif dx < 0:\n      return craft.LEFT\n    elif dy > 0:\n      return craft.DOWN\n    elif dy < 0:\n      return craft.UP\n\n  def find_workshop_for_item(item_index):\n    # Determine which workshop can produce the desired item\n    for workshop_kind in env.world.workshop_indices:\n      if workshop_kind in env.world.cookbook.primitives_for(item_index).keys():\n        return workshop_kind\n    return None\n\n  def craft_item_at_workshop(kind_index):\n    # Logic to use the USE action at the correct workshop to craft the item\n    return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = find_workshop_for_item(item_index)\n  \n  if not workshop_kind_indices:\n    raise ValueError(f\"No suitable workshop found for crafting {item}\")\n\n  closest_workshop_pos = find_closest_workshop(workshop_kind_indices)\n  \n  if closest_workshop_pos:\n    actions = go_to_workshop(closest_workshop_pos)\n    actions.extend(craft_item_at_workshop(item_index))\n  else:\n    raise ValueError(f\"No workshops found in the environment\")\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-18T18:02:11.560614", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_index):\n    # Find the nearest workshop that can produce the desired item\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if np.any(env._current_state.grid[x, y] == kind_index):\n          distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (x, y)\n    \n    return closest_workshop_pos\n\n  def go_to_workshop(workshop_pos):\n    # Navigate to the specified workshop position using BFS\n    actions = []\n    target_x, target_y = workshop_pos\n    \n    queue = collections.deque([(env._current_state.pos[0], env._current_state.pos[1], [])])\n    visited = set()\n    \n    while queue:\n      current_x, current_y, path = queue.popleft()\n      \n      if (current_x, current_y) == (target_x, target_y):\n        actions.extend(path)\n        break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x, new_y = current_x + dx, current_y + dy\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1] and (new_x, new_y) not in visited and env._current_state.next_to_workshop(new_x, new_y):\n          visited.add((new_x, new_y))\n          queue.append((new_x, new_y, path + [get_move_action(dx, dy)]))\n    \n    return actions\n\n  def get_move_action(dx, dy):\n    # Determine the move action based on the difference in coordinates\n    if dx > 0:\n      return craft.RIGHT\n    elif dx < 0:\n      return craft.LEFT\n    elif dy > 0:\n      return craft.DOWN\n    elif dy < 0:\n      return craft.UP\n\n  def find_workshop_for_item(kind_index):\n    # Find the workshop that can produce the desired item\n    for workshop_index in env.world.workshop_indices:\n      if workshop_index in env.world.cookbook.primitives_for(kind_index).keys():\n        return workshop_index\n    return None\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_index = find_workshop_for_item(item_index)\n  \n  if workshop_kind_index is not None:\n    closest_workshop_pos = find_closest_workshop(workshop_kind_index)\n    \n    if closest_workshop_pos:\n      actions = go_to_workshop(closest_workshop_pos)\n      actions.append(craft.USE)\n      return actions\n\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:03:38.278561", "function_name": "craft", "function_body": "  # Define the map of item to workshop index based on the ingredients required\n  def get_workshop_for_item(world, item_index):\n      workshops = world.workshop_indices\n      recipes = world.cookbook.recipes\n\n      for workshop in workshops:\n          if any(ingredient == workshop for ingredient in recipes[item_index].values()):\n              return workshop\n      return None\n\n  # BFS to find the shortest path to a specified index\n  def bfs_to_target(grid, start_pos, target_index):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = collections.deque([start_pos])\n      visited = set([start_pos])\n      parent = {start_pos: None}\n      \n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          \n          # Check if we have reached the target\n          if grid[x, y, target_index] > 0:\n              path = []\n              while pos != start_pos:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]  # Return reversed path\n          \n          # Explore neighbors\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n      \n      return None\n\n  # Convert position change to corresponding action\n  def actions_from_path(current_pos, path):\n      directions_map = {(-1, 0): 0, (1, 0): 1, (0, -1): 2, (0, 1): 3}\n      actions = []\n      \n      for next_pos in path:\n          dx = next_pos[0] - current_pos[0]\n          dy = next_pos[1] - current_pos[1]\n          direction = directions_map.get((dx, dy))\n          if direction is not None:\n              actions.append(direction)\n          current_pos = next_pos\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_index = get_workshop_for_item(env.world, item_index)\n\n  if workshop_index is not None:\n      scenario = env.scenario\n      start_pos = scenario.init_pos\n      grid = scenario.grid.copy()\n      \n      path_to_workshop = bfs_to_target(grid, start_pos, workshop_index)\n      actions = []\n      \n      if path_to_workshop:\n          actions.extend(actions_from_path(start_pos, path_to_workshop))\n          actions.append(4)  # Append USE action to use the workshop\n          return actions\n      \n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:03:40.380617", "function_name": "craft", "function_body": "  def navigate_to_workshop(scenario, target_workshop_index):\n      world = scenario.world\n      grid = scenario.grid.copy()\n      init_pos = scenario.init_pos\n\n      # BFS to find the shortest path to a workshop\n      queue = collections.deque([init_pos])\n      visited = set([init_pos])\n      parent = {init_pos: None}\n      found_workshop = False\n\n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          if grid[x, y, target_workshop_index] > 0:\n              found_workshop = True\n              break\n          \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      # If workshop is found, reconstruct the path\n      if found_workshop:\n          path = []\n          while pos != init_pos:\n              path.append(pos)\n              pos = parent[pos]\n          path.reverse()\n          return path\n      else:\n          return None\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dy < 0: return [0] * abs(dy)  # UP\n      elif dy > 0: return [1] * abs(dy)  # DOWN\n      elif dx < 0: return [2] * abs(dx)  # LEFT\n      elif dx > 0: return [3] * abs(dx)  # RIGHT\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      scenario = env.scenario\n      path = navigate_to_workshop(scenario, target_workshop_index)\n      actions = []\n      current_pos = scenario.init_pos\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_pos, next_pos))\n          current_pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:04:46.711881", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  current_pos = np.array(env._current_state.pos)\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) == 0: # Check if there is any location for the workshop\n      continue\n    \n    workshop_mean_pos = workshop_positions.mean(axis=0)\n    distance = np.linalg.norm(current_pos - workshop_mean_pos, ord=2)\n    if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n\n  target_pos = min(target_positions, key=lambda t: np.linalg.norm(current_pos - t))\n\n  while not np.array_equal(current_pos, target_pos):\n    dx, dy = target_pos - current_pos\n    direction = None\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n    else: # Move in the y-direction next\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n\n    current_pos = np.array([current_pos[0] + (dx > 0) - (dx < 0), current_pos[1] + (dy > 0) - (dy < 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-18T18:09:46.757255", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  current_state = env._current_state\n  pos = np.array(current_state.pos)\n\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) > 0: # Check if there is any location for the workshop\n      mean_workshop_pos = workshop_positions.mean(axis=0)\n      distance = np.linalg.norm(pos - mean_workshop_pos, ord=2)\n\n      if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, mean_workshop_pos\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_mean_pos = closest_workshop_idx\n\n  while not np.array_equal(pos, target_mean_pos):\n    dx, dy = target_mean_pos - pos\n    direction = None\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n    else: # Move in the y-direction next\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n    \n    pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-18T18:10:37.812040", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) > 0: # Check if there is any location for the workshop\n      for workshop_pos in workshop_positions:\n        distance = np.linalg.norm(pos - workshop_pos, ord=2)\n        if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n\n  for target_pos in target_positions:\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy): # Move in the x-direction first\n              actions.append(3 if dx > 0 else 2)\n          else: # Move in the y-direction next\n              actions.append(1 if dy > 0 else 0)\n\n          pos += np.array([np.sign(dx), np.sign(dy)])\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
