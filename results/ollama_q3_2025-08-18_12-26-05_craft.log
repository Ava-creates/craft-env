{"timestamp": "2025-08-18T22:37:23.767926", "function_name": "craft", "function_body": "  # Get index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Fetch recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Check if a specific workshop is required\n  key_workshop = recipe.get(\"_key\")\n  if key_workshop:\n      workshop_name = f\"WORKSHOP{int(key_workshop)}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      if workshop_index not in env.world.workshop_indices:\n          raise ValueError(f\"Workshop {key_workshop} not found in the list of workshops.\")\n      \n      # Move to the specific workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item using the 'USE' action (index 4)\n  actions.append(4)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T22:39:18.741657", "function_name": "craft", "function_body": "  def navigate_to_workshop(scenario, target_workshop_index):\n      world = scenario.world\n      grid = scenario.grid.copy()\n      init_pos = scenario.init_pos\n\n      # BFS to find the shortest path to a workshop\n      queue = collections.deque([init_pos])\n      visited = set([init_pos])\n      parent = {init_pos: None}\n      found_workshop = False\n\n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          if grid[x, y, target_workshop_index] > 0:\n              found_workshop = True\n              break\n          \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      # If workshop is found, reconstruct the path\n      if found_workshop:\n          path = []\n          while pos != init_pos:\n              path.append(pos)\n              pos = parent[pos]\n          path.reverse()\n          return path\n      else:\n          return None\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      actions = []\n      \n      if dy < 0: \n          actions.extend([0] * abs(dy))  # UP\n      elif dy > 0: \n          actions.extend([1] * abs(dy))  # DOWN\n      \n      if dx < 0: \n          actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0: \n          actions.extend([3] * abs(dx))  # RIGHT\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item's ingredients\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      scenario = CraftScenario(\n          grid=env.scenario.grid,\n          init_pos=env.scenario.init_pos,\n          world=env.world\n      )\n      path = navigate_to_workshop(scenario, target_workshop_index)\n      actions = []\n      current_pos = env.scenario.init_pos\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_pos, next_pos))\n          current_pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T22:39:20.768323", "function_name": "craft", "function_body": "  def navigate_to_workshop(scenario, target_workshop_index):\n    world = scenario.world\n    grid = scenario.grid.copy()\n    init_pos = scenario.init_pos\n\n    # BFS to find the shortest path to a workshop\n    queue = collections.deque([init_pos])\n    visited = set([init_pos])\n    parent = {init_pos: None}\n    found_workshop = False\n\n    while queue:\n        pos = queue.popleft()\n        x, y = pos\n        \n        # Check if the target workshop is in the current cell\n        if grid[x, y, target_workshop_index] > 0:\n            found_workshop = True\n            break\n        \n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            \n            # Ensure the next position is within bounds and not visited\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = pos\n\n    # If workshop is found, reconstruct the path\n    if found_workshop:\n        path = []\n        while pos != init_pos:\n            path.append(pos)\n            pos = parent[pos]\n        path.reverse()\n        return path\n    else:\n        return None\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      actions = []\n      \n      if dy < 0: \n          actions.extend([0] * abs(dy))  # UP\n      elif dy > 0: \n          actions.extend([1] * abs(dy))  # DOWN\n      \n      if dx < 0: \n          actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0: \n          actions.extend([3] * abs(dx))  # RIGHT\n      \n      return actions\n\n  def collect_primitives(env, primitives):\n    \"\"\"Collect the required primitives for crafting.\"\"\"\n    world = env.world\n    scenario = env.scenario\n    grid = scenario.grid.copy()\n    init_pos = scenario.init_pos\n    current_state = env._current_state\n    \n    actions = []\n    # Collect each primitive one by one\n    for primitive in primitives:\n        primitive_index = world.cookbook.index[primitive]\n        \n        # Find positions of the primitive in the grid\n        primitive_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n        if primitive_positions.size == 0:\n            continue\n        \n        # Use BFS to find the shortest path to the nearest primitive\n        queue = collections.deque([init_pos])\n        visited = set([init_pos])\n        parent = {init_pos: None}\n        found_primitive = False\n\n        while queue:\n            pos = queue.popleft()\n            x, y = pos\n            \n            # Check if the target primitive is in the current cell\n            if grid[x, y, primitive_index] > 0:\n                found_primitive = True\n                break\n            \n            # Explore neighbors\n            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n                nx, ny = x + dx, y + dy\n                \n                # Ensure the next position is within bounds and not visited\n                if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                    queue.append((nx, ny))\n                    visited.add((nx, ny))\n                    parent[(nx, ny)] = pos\n\n        # If primitive is found, reconstruct the path\n        if found_primitive:\n            path = []\n            while pos != init_pos:\n                path.append(pos)\n                pos = parent[pos]\n            path.reverse()\n            \n            for next_pos in path:\n                actions.extend(actions_to_move(current_state.pos, next_pos))\n                current_state.pos = next_pos\n\n            # Collect the primitive\n            actions.append(4)  # USE action index is 4\n        \n    return actions\n\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Determine which workshop to use based on the item's ingredients\n  target_workshop_index = None\n  for idx in env.world.workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      # Collect required primitives\n      item_recipe = env.world.cookbook.recipes[item_index]\n      required_primitives = [env.world.cookbook.index.reverse[ingredient] for ingredient in item_recipe.keys()]\n      actions = collect_primitives(env, required_primitives)\n\n      scenario = env.scenario\n      path = navigate_to_workshop(scenario, target_workshop_index)\n      if path:\n          current_pos = scenario.init_pos\n          for next_pos in path:\n              actions.extend(actions_to_move(current_state.pos, next_pos))\n              current_state.pos = next_pos\n\n          # Use the workshop\n          actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
