{"timestamp": "2025-08-18T14:03:05.091263", "function_name": "craft", "function_body": "  def get_next_move(agent_x, agent_y, target_x, target_y):\n    dx = target_x - agent_x\n    dy = target_y - agent_y\n\n    moves = []\n    if dy < 0:\n        moves.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    elif dy > 0:\n        moves.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n\n    if dx < 0:\n        moves.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    elif dx > 0:\n        moves.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n    \n    return moves\n\n  def is_workshop_nearby(agent_x, agent_y, workshop_pos):\n    workshop_x, workshop_y = workshop_pos\n    return abs(workshop_x - agent_x) <= 1 and abs(workshop_y - agent_y) <= 1\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed to craft this item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  required_workshops = [k for k, v in recipe.items() if isinstance(v, str) and v.startswith(\"_key\")]\n\n  # Assume we have all the primitives needed, move to a workshop\n  actions_to_take = []\n\n  if required_workshops:\n      workshop_index_str = required_workshops[0]\n      workshop_type = int(workshop_index_str.replace(\"_key\", \"\"))\n      workshop_pos = env.world.workshop_indices[workshop_type]\n\n      agent_x, agent_y = env._current_state.pos\n\n      # Generate actions to move towards the workshop\n      if not is_workshop_nearby(agent_x, agent_y, workshop_pos):\n          actions_to_take.extend(get_next_move(agent_x, agent_y, workshop_x, workshop_y))\n\n      # Orient the agent correctly before using the workshop\n      target_orientation = get_correct_orientation(agent_x, agent_y, workshop_pos)\n      current_orientation = env._current_state.dir\n\n      if target_orientation != current_orientation:\n          actions_to_take.extend(orientate_agent(current_orientation, target_orientation))\n      \n      # Use the workshop to craft the item\n      actions_to_take.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T14:03:07.203140", "function_name": "craft", "function_body": "  def get_next_move(agent_x, agent_y, target_x, target_y):\n    dx = target_x - agent_x\n    dy = target_y - agent_y\n\n    moves = []\n    if dy < 0:\n        moves.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    elif dy > 0:\n        moves.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n\n    if dx < 0:\n        moves.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    elif dx > 0:\n        moves.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n    \n    return moves\n\n  def is_workshop_nearby(agent_x, agent_y, workshop_pos):\n    workshop_x, workshop_y = workshop_pos\n    return abs(workshop_x - agent_x) <= 1 and abs(workshop_y - agent_y) <= 1\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed to craft this item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  required_workshops = [k for k, v in recipe.items() if isinstance(v, str) and v.startswith(\"_key\")]\n\n  # Assume we have all the primitives needed, move to a workshop\n  actions_to_take = []\n\n  # Move to the first available workshop (assuming there is at least one)\n  if required_workshops:\n      workshop_index_str = required_workshops[0]\n      workshop_type = int(workshop_index_str.replace(\"_key\", \"\"))\n      workshop_pos = env.world.workshop_indices[workshop_type]\n\n      agent_x, agent_y = env._current_state.pos\n\n      # Generate actions to move towards the workshop\n      if not is_workshop_nearby(agent_x, agent_y, workshop_pos):\n          actions_to_take.extend(get_next_move(agent_x, agent_y, workshop_x, workshop_y))\n\n      # Check if we are already at the workshop or nearby\n      if not is_workshop_nearby(agent_x, agent_y, workshop_pos):\n          raise RuntimeError(\"Failed to move near the workshop\")\n\n      # Use the workshop to craft the item\n      actions_to_take.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T14:04:10.025577", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  output_index = cookbook.index[item]\n  recipe = cookbook.recipes[output_index]\n\n  actions = []\n\n  # Check if we have all the ingredients in our inventory\n  required_ingredients = {ingredient: count for ingredient, count in recipe.items() if ingredient != \"_key\"}\n  current_inventory = env._current_state.inventory\n\n  for ingredient, count in required_ingredients.items():\n      if current_inventory[ingredient] < count:\n          # If we don't have enough of an ingredient, collect it\n          ingredient_name = cookbook.index.get(ingredient)\n          actions.extend(collect(env, ingredient_name))\n\n  # Find a suitable workshop that can craft this item\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n          continue  # Skip the key which is just metadata\n\n      # Assuming _key is something like \"WORKSHOPx\"\n      workshop_name = cookbook.index.get(count)\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Find a position of the workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          continue  # No available workshop, try another one\n\n      # Choose the closest workshop (simple heuristic)\n      pos = env._current_state.pos\n      distances = np.linalg.norm(workshop_positions - pos, axis=1)\n      nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n      # Add actions to move to the workshop\n      actions.extend(move_to(env, nearest_workshop_pos))\n\n      # Face the correct direction towards the workshop (optional but useful for USE action)\n      actions.append(face_towards_workshop(env, nearest_workshop_pos))\n\n      # Add action to use the workshop (assuming USE is the action for crafting)\n      actions.append(env.action_specs()[\"USE\"])\n\n      break  # Assuming one workshop is enough\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-18T14:04:11.920986", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  output_index = cookbook.index[item]\n  recipe = cookbook.recipes[output_index]\n\n  actions = []\n\n  # Determine the type of workshop needed based on the recipe key (e.g., \"_key\": \"WORKSHOP0\")\n  workshop_key = recipe.get(\"_key\", None)\n  if not workshop_key:\n      raise ValueError(f\"No workshop specified in recipe for {item}\")\n\n  workshop_name = cookbook.index.get(workshop_key)\n  if not workshop_name:\n      raise ValueError(f\"Workshop key '{workshop_key}' does not correspond to any known workshop\")\n\n  workshop_index = env.world.cookbook.index[workshop_name]\n  \n  # Find positions of the workshop in the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n  if len(workshop_positions) == 0:\n      raise ValueError(f\"No available {workshop_name} found on the map\")\n\n  # Choose the closest workshop (simple heuristic)\n  pos = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - pos, axis=1)\n  nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n  # Add actions to move to the workshop\n  actions.extend(move_to(env, nearest_workshop_pos))\n\n  # Face the correct direction towards the workshop (optional but useful for USE action)\n  actions.append(face_towards_workshop(env, nearest_workshop_pos))\n\n  # Add action to use the workshop (assuming USE is the action for crafting)\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-08-18T14:05:57.597202", "function_name": "craft", "function_body": "  def navigate_to_workshop(scenario, target_workshop_index):\n      world = scenario.world\n      grid = scenario.grid.copy()\n      init_pos = scenario.init_pos\n\n      # BFS to find the shortest path to a workshop\n      queue = collections.deque([init_pos])\n      visited = set([init_pos])\n      parent = {init_pos: None}\n      found_workshop = False\n\n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          if grid[x, y, target_workshop_index] > 0:\n              found_workshop = True\n              break\n          \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      # If workshop is found, reconstruct the path\n      if found_workshop:\n          path = []\n          while pos != init_pos:\n              path.append(pos)\n              pos = parent[pos]\n          path.reverse()\n          return path\n      else:\n          return None\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dy < 0: return [0] * abs(dy)  # UP\n      elif dy > 0: return [1] * abs(dy)  # DOWN\n      elif dx < 0: return [2] * abs(dx)  # LEFT\n      elif dx > 0: return [3] * abs(dx)  # RIGHT\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes.get(item_index, {}).values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      scenario = env.scenario\n      path = navigate_to_workshop(scenario, target_workshop_index)\n      actions = []\n      current_pos = scenario.init_pos\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_pos, next_pos))\n          current_pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
