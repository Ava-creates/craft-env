{"timestamp": "2025-08-18T13:58:40.400576", "function_name": "craft", "function_body": "  def calculate_move_actions(env, target_pos):\n      # Simple example: move directly to the target position\n      current_pos = env._current_state.pos\n      actions = []\n\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if dx > 0:\n          actions.extend([craft.MOVE_FUNC(craft.RIGHT)] * abs(dx))\n      elif dx < 0:\n          actions.extend([craft.MOVE_FUNC(craft.LEFT)] * abs(dx))\n\n      if dy > 0:\n          actions.extend([craft.MOVE_FUNC(craft.UP)] * abs(dy))\n      elif dy < 0:\n          actions.extend([craft.MOVE_FUNC(craft.DOWN)] * abs(dy))\n\n      return actions\n\n  def calculate_distance(env, workshop_index):\n      # Placeholder for distance calculation logic\n      current_pos = env._current_state.pos\n      target_pos = get_workshop_position(env.world.grid, workshop_index)\n      return np.linalg.norm(np.array(current_pos) - np.array(target_pos))\n\n  def get_workshop_position(grid, workshop_index):\n      # Find the position of the workshop with the given index in the grid\n      for i in range(grid.shape[0]):\n          for j in range(grid.shape[1]):\n              if grid[i, j, workshop_index] > 0:\n                  return (i, j)\n      return None\n\n  item_index = env.world.cookbook.index[item]\n\n  # Get the workshop needed for crafting the item (if any)\n  # Assuming that recipes have a \"_key\" entry indicating the type of workshop required\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n\n  if recipe and \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      workshop_indices = [idx for idx in env.world.workshop_indices \n                          if env.world.cookbook.index.get(env.world.cookbook.reverse_contents[idx]) == workshop_type]\n      # We should prioritize the workshops that have the required resources nearby\n      closest_workshop_index = None\n      min_distance = float('inf')\n      \n      for workshop_index in workshop_indices:\n          # Placeholder function to calculate distance from current position to workshop\n          distance = calculate_distance(env, workshop_index)\n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop_index = workshop_index\n\n  else:\n      # If no workshop is required, assume we can craft anywhere\n      closest_workshop_index = None\n\n  actions = []\n\n  # Move to the nearest workshop if one is needed\n  if closest_workshop_index is not None:\n      # Placeholder for pathfinding logic; assumes agent can move directly to the workshop\n      # Replace with actual pathfinding code in practice\n      workshop_pos = get_workshop_position(env.world.grid, closest_workshop_index)\n      move_actions = calculate_move_actions(env, workshop_pos)\n      actions.extend(move_actions)\n\n  actions.append(craft.CRAFT_FUNC(closest_workshop_index))\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
