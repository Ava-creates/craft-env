{"timestamp": "2025-08-18T22:42:59.180860", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_pos_list) > 0: # Check if there is any location for the workshop\n      workshop_distances = [np.linalg.norm(pos - pos, ord=2) for pos in workshop_pos_list]\n      closest_workshop_pos = workshop_pos_list[np.argmin(workshop_distances)]\n      \n      distance = np.linalg.norm(pos - closest_workshop_pos, ord=2)\n      if distance < min_distance:\n        closest_workshop_idx, min_distance, target_pos = workshop_idx, distance, closest_workshop_pos\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = np.array(target_pos)\n\n  while not np.array_equal(pos, target_pos):\n    dx, dy = target_pos - pos\n    direction = None\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n    else: # Move in the y-direction next\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n    \n    pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-18T22:43:33.647988", "function_name": "craft", "function_body": "  # Step 1: Determine the required workshop for the item.\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n  \n  # Step 2: Find the nearest workshop that can craft the item.\n  workshop_indices = [i for i, v in enumerate(env.world.workshop_indices) if v is not None]\n  closest_workshop_index = min(workshop_indices, key=lambda x: np.linalg.norm(np.array(env._current_state.pos) - np.array(x)))\n  \n  # Step 3: Move the agent to the nearest workshop.\n  actions_to_move = move_to_position(env._current_state.grid, env._current_state.pos, closest_workshop_index)\n  \n  # Step 4: Craft the item at the workshop.\n  craft_action_index = env.world.cookbook.index[\"USE\"]\n  actions_to_craft = [craft_action_index]\n  \n  return actions_to_move + actions_to_craft", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-18T22:43:35.547909", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n\n  # Get the recipe for the desired item\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  # Find the required workshop based on the recipe ingredients\n  workshop_indices = []\n  for ingredient, _ in recipe.items():\n      if ingredient != \"_key\":  # Skip the special key ingredient\n          ingredient_index = int(ingredient)\n          ingredient_name = env.world.cookbook.index.get(ingredient_index)\n\n          if \"workshop\" in ingredient_name:\n              workshop_indices.append(env.world.workshop_indices[ingredient_name])\n\n  if not workshop_indices:\n      raise ValueError(f\"No suitable workshop found for item: {item}\")\n\n  # Find the closest workshop to the current position\n  current_pos = env._current_state.pos\n  closest_workshop_index = None\n  min_distance = float('inf')\n  for workshop_idx in workshop_indices:\n    pos_x, pos_y = divmod(workshop_idx, env.world.grid.shape[1])\n    distance = abs(pos_x - current_pos[0]) + abs(pos_y - current_pos[1])\n    if distance < min_distance:\n        min_distance = distance\n        closest_workshop_index = workshop_idx\n\n  # Calculate the path to the closest workshop\n  path_to_workshop = calculate_path(env, current_pos, (closest_workshop_index // env.world.grid.shape[1], closest_workshop_index % env.world.grid.shape[1]))\n  \n  # Craft action\n  craft_action = [4]  # USE action\n\n  return path_to_workshop + craft_action", "island_id": 2, "scores": {"3": -1}}
