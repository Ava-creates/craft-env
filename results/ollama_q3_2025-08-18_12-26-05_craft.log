{"timestamp": "2025-08-18T13:26:32.926406", "function_name": "craft", "function_body": "  # Fetch the cookbook and index for the given item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n\n  # Find out which workshop is required to craft the item\n  recipe = cookbook.recipes.get(item_index, {})\n  if \"_key\" in recipe:\n      workshop_type = recipe[\"_key\"]\n      target_workshop_index = None\n\n      for workshop_index in env.world.workshop_indices:\n          workshop_name = cookbook.index.get(workshop_index)\n          if workshop_name == workshop_type:\n              target_workshop_index = workshop_index\n              break\n\n  else:\n      # If no specific workshop is needed, we can assume any will work (for simplicity)\n      target_workshop_index = env.world.workshop_indices[0]\n\n  actions_to_take = []\n\n  # Move to the nearest workshop\n  if target_workshop_index is not None:\n      actions_to_take.extend(move_to_nearest_entity(env, target_workshop_index))\n\n  # Use the workshop to craft the item (action index for USE is typically 4)\n  actions_to_take.append(4)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-18T13:26:34.308573", "function_name": "craft", "function_body": "  # Initialize action list\n  actions = []\n  \n  # Get the index of the item to craft from the cookbook index\n  target_item_index = env.world.cookbook.index[item]\n  \n  # Determine the workshop needed for crafting this item. \n  # For simplicity, assume that the recipe specifies \"_key\" to indicate the required workshop type.\n  recipe = env.world.cookbook.recipes[target_item_index]\n\n  # Extract the workshop index from the recipe\n  workshop_key = \"_key\"\n  if workshop_key in recipe:\n      workshop_index = recipe[workshop_key]\n      \n      # Move to the specified workshop location. \n      # Assume that `move_to_workshop` function is available to move the agent to the nearest workshop of the required type.\n      actions.extend(move_to_workshop(env, workshop_index))\n      \n      # Perform the crafting action\n      actions.append(craft.ACTIONS[\"USE\"])\n  else:\n      raise ValueError(\"Workshop information missing in recipe for item: {}\".format(item))\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-18T13:28:27.507036", "function_name": "craft", "function_body": "  def calculate_shortest_path(start_pos, end_pos):\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n      pos = queue.popleft()\n      if pos == end_pos:\n        break\n\n      x, y = pos\n      neighbors = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      for nx, ny in neighbors:\n        if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny, env.world.non_grabbable_indices] == 0:\n            queue.append((nx, ny))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = pos\n\n    path = []\n    current_pos = end_pos\n    while current_pos != start_pos:\n      path.append(current_pos)\n      current_pos = parent[current_pos]\n    path.reverse()\n    return path\n\n  actions = []\n\n  # Get index of the desired item\n  goal_index = env.world.cookbook.index.index(item)\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  if '_key' in recipe:\n    workshop_key = recipe['_key']\n    workshop_index = env.world.cookbook.index.get(workshop_key)\n\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    for i, idx in enumerate(env.world.workshop_indices):\n      if idx == workshop_index:\n        x = i // env.world.scenario.init_grid.shape[0]\n        y = i % env.world.scenario.init_grid.shape[1]\n        distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = (x, y)\n\n    path_to_workshop = calculate_shortest_path(env._current_state.pos, closest_workshop_pos)\n    for x, y in path_to_workshop:\n      dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n      if dx == 1: actions.append(3)  # RIGHT\n      elif dx == -1: actions.append(2)  # LEFT\n      elif dy == 1: actions.append(0)  # DOWN\n      elif dy == -1: actions.append(1)  # UP\n      env._current_state.pos = (x, y)\n\n    actions.append(4)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T13:28:28.873365", "function_name": "craft", "function_body": "  def calculate_shortest_path(start_pos, end_pos):\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n      pos = queue.popleft()\n      if pos == end_pos:\n        break\n\n      x, y = pos\n      neighbors = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      for nx, ny in neighbors:\n        if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny, env.world.non_grabbable_indices] == 0:\n            queue.append((nx, ny))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = pos\n\n    path = []\n    current_pos = end_pos\n    while current_pos != start_pos:\n      path.append(current_pos)\n      current_pos = parent[current_pos]\n    path.reverse()\n    return path\n\n  actions = []\n\n  # Get index of the desired item\n  goal_index = env.world.cookbook.index.index(item)\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  if '_key' in recipe:\n    workshop_key = recipe['_key']\n    workshop_index = env.world.cookbook.index.get(workshop_key)\n\n    # Find nearest workshop from current position\n    min_distance = float('inf')\n    closest_workshop_pos = None\n    for i, idx in enumerate(env.world.workshop_indices):\n      if idx == workshop_index:\n        x = i // env.world.scenario.init_grid.shape[0]\n        y = i % env.world.scenario.init_grid.shape[1]\n        distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_pos = (x, y)\n\n    path_to_workshop = calculate_shortest_path(env._current_state.pos, closest_workshop_pos)\n    for x, y in path_to_workshop:\n      dx, dy = x - env._current_state.pos[0], y - env._current_state.pos[1]\n      if dx == 1: actions.append(3)  # RIGHT\n      elif dx == -1: actions.append(2)  # LEFT\n      elif dy == 1: actions.append(0)  # DOWN\n      elif dy == -1: actions.append(1)  # UP\n      env._current_state.pos = (x, y)\n\n    actions.append(4)  # Use the workshop to craft the item\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T13:30:19.696169", "function_name": "craft", "function_body": "  def navigate_to_workshop(scenario, target_workshop_index):\n    world = scenario.world\n    grid = scenario.grid.copy()\n    init_pos = scenario.init_pos\n\n    # BFS to find the shortest path to a workshop\n    queue = collections.deque([init_pos])\n    visited = set([init_pos])\n    parent = {init_pos: None}\n    found_workshop = False\n\n    while queue:\n        pos = queue.popleft()\n        x, y = pos\n        if grid[x, y, target_workshop_index] > 0:\n            found_workshop = True\n            break\n        \n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited and grid[nx, ny, world.cookbook.index['BOUNDARY']] == 0:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = pos\n\n    # If workshop is found, reconstruct the path\n    if found_workshop:\n        path = []\n        while pos != init_pos:\n            path.append(pos)\n            pos = parent[pos]\n        path.reverse()\n        return path\n    else:\n        return None\n\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dy < 0: return [0] * abs(dy)  # UP\n      elif dy > 0: return [1] * abs(dy)  # DOWN\n      elif dx < 0: return [2] * abs(dx)  # LEFT\n      elif dx > 0: return [3] * abs(dx)  # RIGHT\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index]):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      scenario = env.scenario\n      path = navigate_to_workshop(scenario, target_workshop_index)\n      actions = []\n      current_pos = scenario.init_pos\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_pos, next_pos))\n          current_pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
