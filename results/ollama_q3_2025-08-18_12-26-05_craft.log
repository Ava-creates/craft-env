{"timestamp": "2025-08-19T03:53:02.868860", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Find a workshop that can craft the item (if any)\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    return []  # No recipe for the item\n  \n  # Determine which workshop to use\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue  # Skip the _key entry\n      workshop_type = env.world.cookbook.index.get(env.world.cookbook.reverse_contents[ingredient].split('_')[0])\n      if workshop_type is not None:\n          break\n  \n  # Get a list of all workshops in the environment\n  workshop_indices = [i for i, kind in enumerate(env.world.workshop_indices) if kind == workshop_type]\n  \n  # Find the nearest workshop to the agent's current position\n  nearest_workshop_pos = min(workshop_indices, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n  \n  # Calculate actions to move towards the nearest workshop\n  path_actions = []\n  while env._current_state.pos != nearest_workshop_pos:\n      direction_to_move = get_direction_to_move(env._current_state.pos, nearest_workshop_pos)\n      path_actions.append(direction_to_move)\n  \n  # Use the workshop to craft the item\n  path_actions.append(4)  # Assuming USE is represented by action index 4\n  \n  return path_actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:53:04.760575", "function_name": "craft", "function_body": "  # Extract the index of the item to be crafted from the cookbook.\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed for crafting this item.\n  # For simplicity, we assume that each recipe specifies a \"_key\" entry indicating the required workshop.\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  workshop_key = recipe.get(\"_key\", None)\n  \n  if not workshop_key:\n    raise ValueError(f\"No workshop specified for crafting {item}.\")\n  \n  # Get the index of the required workshop.\n  workshop_index = env.world.cookbook.index[workshop_key]\n\n  # Find the position of the workshop in the grid.\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)\n  if not workshop_positions.size:\n    raise ValueError(f\"No workshop found for crafting {item}.\")\n\n  # Choose the closest workshop to move towards.\n  current_position = env._current_state.pos\n  distances = np.linalg.norm(workshop_positions - current_position, axis=1)\n  nearest_workshop_position = tuple(workshop_positions[np.argmin(distances)])\n\n  # Calculate actions needed to reach the nearest workshop.\n  actions_to_workshop = calculate_actions_to_target(env, nearest_workshop_position)\n\n  # Add action to use the workshop for crafting.\n  USE_ACTION_INDEX = 4\n  actions_to_craft = actions_to_workshop + [USE_ACTION_INDEX]\n\n  return actions_to_craft", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:54:00.130858", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Find the output index for the desired item\n  if item not in index:\n    raise ValueError(f\"Unknown item: {item}\")\n  item_index = index[item]\n\n  # Determine which workshop is needed for this item\n  recipe = cookbook.recipes.get(item_index, {})\n  required_workshop = None\n  if \"_key\" in recipe:\n    required_workshop_key = recipe[\"_key\"]\n    for i, workshop_name in enumerate([\"WORKSHOP0\", \"WORKSHOP1\", \"WORKSHOP2\"]):\n      if workshop_name.lower() in required_workshop_key:\n        required_workshop = getattr(env.world, f\"{workshop_name.lower()}_index\")\n        break\n\n  # Navigate to the required workshop\n  actions_to_take = []\n  if required_workshop is not None:\n    workshop_pos = np.argwhere(env._current_state.grid[:, :, required_workshop]).flatten()\n    if workshop_pos.size > 0:\n      target_pos = (workshop_pos[1], workshop_pos[0])  # Convert to (x, y) format\n      actions_to_take.extend(navigate_to_target(env._current_state, target_pos))\n\n  # Use the workshop to craft the item\n  actions_to_take.append(env.world.n_actions - 1)  # Assuming USE action is the last one\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T03:54:02.022422", "function_name": "craft", "function_body": "  def navigate_to_target(state: craft.CraftState, target_pos: tuple[int, int]) -> list[int]:\n    \"\"\"Helper function to navigate to a target position on the grid.\"\"\"\n    actions = []\n    current_pos = state.pos\n    while current_pos != target_pos:\n      delta_x = target_pos[0] - current_pos[0]\n      delta_y = target_pos[1] - current_pos[1]\n\n      if delta_x < 0:\n        actions.append(env.world.n_actions - 5)  # LEFT action is assumed to be the second last one\n      elif delta_x > 0:\n        actions.append(env.world.n_actions - 4)  # RIGHT action is assumed to be the third last one\n\n      if delta_y < 0:\n        actions.append(env.world.n_actions - 6)  # DOWN action is assumed to be the fourth last one\n      elif delta_y > 0:\n        actions.append(env.world.n_actions - 7)  # UP action is assumed to be the fifth last one\n\n      state = state.step(actions[-1])[1]  # Update state after each move\n      current_pos = state.pos\n\n    return actions\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Find the output index for the desired item\n  if item not in index:\n    raise ValueError(f\"Unknown item: {item}\")\n  item_index = index[item]\n\n  # Determine which workshop is needed for this item\n  recipe = cookbook.recipes.get(item_index, {})\n  required_workshop = None\n  if \"_key\" in recipe:\n    required_workshop_key = recipe[\"_key\"]\n    for i, workshop_name in enumerate([\"WORKSHOP0\", \"WORKSHOP1\", \"WORKSHOP2\"]):\n      if workshop_name.lower() in required_workshop_key:\n        required_workshop = getattr(env.world, f\"{workshop_name.lower()}_index\")\n        break\n\n  # Navigate to the required workshop\n  actions_to_take = []\n  if required_workshop is not None:\n    workshop_pos = np.argwhere(env._current_state.grid[:, :, required_workshop]).flatten()\n    if workshop_pos.size > 0:\n      target_pos = (workshop_pos[1], workshop_pos[0])  # Convert to (x, y) format\n      actions_to_take.extend(navigate_to_target(env._current_state, target_pos))\n\n  # Use the workshop to craft the item\n  actions_to_take.append(env.world.n_actions - 1)  # Assuming USE action is the last one\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:55:26.012310", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_indices):\n    # Find the nearest workshop that can produce the desired item using BFS\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if np.any([env._current_state.grid[x, y] == kind_index for kind_index in kind_indices]):\n          distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (x, y)\n    \n    return closest_workshop_pos\n\n  def go_to_workshop(workshop_pos):\n    # Navigate to the specified workshop position using BFS\n    actions = []\n    target_x, target_y = workshop_pos\n    \n    queue = collections.deque([(env._current_state.pos[0], env._current_state.pos[1], [])])\n    visited = set()\n    \n    while queue:\n      current_x, current_y, path = queue.popleft()\n      \n      if (current_x, current_y) == (target_x, target_y):\n        actions.extend(path)\n        break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x, new_y = current_x + dx, current_y + dy\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1] and (new_x, new_y) not in visited:\n          visited.add((new_x, new_y))\n          queue.append((new_x, new_y, path + [get_move_action(dx, dy)]))\n    \n    return actions\n\n  def get_move_action(dx, dy):\n    # Determine the move action based on the difference in coordinates\n    if dx > 0:\n      return craft.RIGHT\n    elif dx < 0:\n      return craft.LEFT\n    elif dy > 0:\n      return craft.DOWN\n    elif dy < 0:\n      return craft.UP\n\n  def craft_item_at_workshop():\n    # Logic to use the USE action at the correct workshop to craft the item\n    return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = env.world.workshop_indices\n  actions = []\n  \n  closest_workshop_pos = find_closest_workshop(workshop_kind_indices)\n  if closest_workshop_pos:\n    actions.extend(go_to_workshop(closest_workshop_pos))\n    actions.extend(craft_item_at_workshop())\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T03:55:27.898270", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_indices):\n    # Find the nearest workshop that can produce the desired item\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if any(env._current_state.grid[x, y][kind_index] == 1 for kind_index in kind_indices):\n          distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (x, y)\n    \n    return closest_workshop_pos\n\n  def go_to_workshop(workshop_pos):\n    # Navigate to the specified workshop position using BFS\n    actions = []\n    target_x, target_y = workshop_pos\n    \n    queue = collections.deque([(env._current_state.pos[0], env._current_state.pos[1], [])])\n    visited = set()\n    \n    while queue:\n      current_x, current_y, path = queue.popleft()\n      \n      if (current_x, current_y) == (target_x, target_y):\n        actions.extend(path)\n        break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x, new_y = current_x + dx, current_y + dy\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1] and (new_x, new_y) not in visited:\n          visited.add((new_x, new_y))\n          queue.append((new_x, new_y, path + [get_move_action(dx, dy)]))\n    \n    return actions\n\n  def get_move_action(dx, dy):\n    # Determine the move action based on the difference in coordinates\n    if dx > 0:\n      return craft.RIGHT\n    elif dx < 0:\n      return craft.LEFT\n    elif dy > 0:\n      return craft.DOWN\n    elif dy < 0:\n      return craft.UP\n\n  def craft_item_at_workshop():\n    # Logic to use the USE action at the correct workshop to craft the item\n    return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = env.world.workshop_indices\n  \n  closest_workshop_pos = find_closest_workshop(workshop_kind_indices)\n  \n  actions = []\n  if closest_workshop_pos:\n    actions.extend(go_to_workshop(closest_workshop_pos))\n    actions.extend(craft_item_at_workshop())\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:56:08.463060", "function_name": "craft", "function_body": "  # Convert item name to index\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No crafting recipe for {item}\")\n  \n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n  \n  # Determine which workshop is needed based on the recipe ingredients\n  required_workshop = None\n  for ingredient, count in recipe.items():\n    if ingredient == \"_key\":\n      continue\n    if env.world.cookbook.index.get(env.world.cookbook.reverse_contents[ingredient]) in env.world.workshop_indices:\n      required_workshop = env.world.cookbook.reverse_contents[ingredient]\n      break\n  \n  # If no specific workshop is required, use the default workshop index (assuming it's the first one)\n  if not required_workshop:\n    required_workshop_index = env.world.workshop_indices[0]\n  else:\n    required_workshop_index = env.world.cookbook.index[required_workshop]\n\n  # Move to the required workshop\n  actions.extend(move_to_workshop(env, required_workshop_index))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T03:56:10.342890", "function_name": "craft", "function_body": "  # Determine the workshop needed for crafting the item\n  cookbook = env.world.cookbook\n  index = cookbook.index\n  recipes = cookbook.recipes\n  goal_index = index[item]\n  \n  if goal_index not in recipes:\n    raise ValueError(f\"No recipe found for {item}\")\n    \n  recipe = recipes[goal_index]\n\n  # Find a workshop that can craft the item\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          key_workshop = int(count) - 1\n          break\n  \n  workshop_indices = env.world.workshop_indices\n\n  # If we found a key workshop index, use it; otherwise, choose the first workshop available\n  workshop_index = workshop_indices[key_workshop] if 'key_workshop' in locals() else workshop_indices[0]\n  \n  # Actions to move to the workshop (assuming position and direction are reset each time)\n  actions_to_workshop = move_to_workshop(env.world.grid, env._current_state.pos, env._current_state.dir, workshop_index)\n\n  # Action to use the workshop\n  action_use_workshop = [craft.USE]\n  \n  return actions_to_workshop + action_use_workshop", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T04:02:06.794164", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  pos = np.array(env._current_state.pos)\n  target_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_pos_list) > 0:\n        # Calculate the closest position to move towards\n        nearest_target_pos = min(\n            workshop_pos_list,\n            key=lambda target_pos: np.linalg.norm(pos - target_pos, ord=2)\n        )\n        \n        distance = np.linalg.norm(pos - nearest_target_pos, ord=2)\n        if distance < min_distance:\n            target_workshop_idx, min_distance = workshop_idx, nearest_target_pos\n\n  if target_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop position\n  nearest_target_pos = np.array(target_workshop_idx)\n\n  while not np.array_equal(pos, nearest_target_pos):\n    dx, dy = nearest_target_pos - pos\n    \n    # Determine direction to move in\n    if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n        actions.append(3 if dx > 0 else 2)\n        pos[0] += 1 if dx > 0 else -1\n    elif dy != 0:  # Move in y-direction only if necessary\n        actions.append(1 if dy > 0 else 0)\n        pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-19T04:02:09.311932", "function_name": "craft", "function_body": "  def move_to(target_pos):\n    pos = np.array(env._current_state.pos)\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n        actions.append(3 if dx > 0 else 2)\n        pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:  # Move in y-direction only if necessary\n        actions.append(1 if dy > 0 else 0)\n        pos[1] += 1 if dy > 0 else -1\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    # Calculate the mean position of all workshops of this type\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n        workshop_pos_mean = workshop_pos_list.mean(axis=0)\n        distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n        if distance < min_distance:\n            closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions = move_to(nearest_target_pos)\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 1, "scores": {"3": 3.7}}
{"timestamp": "2025-08-19T04:03:14.493484", "function_name": "craft", "function_body": "  UP = 1\n  DOWN = 0\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions = []\n  \n  # Map string direction to action constants\n  dir_to_action = {\"UP\": UP, \"DOWN\": DOWN, \"LEFT\": LEFT, \"RIGHT\": RIGHT}\n  \n  # Get the index of the item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Find the workshop needed for crafting this item (simplified assumption)\n  # Assuming there are multiple types of workshops and we need to find the correct one\n  workshop_idx = None\n  for workshop in env.world.workshop_indices:\n      if item_idx in env.world.cookbook.recipes[workshop].get(\"_key\", []):\n          workshop_idx = workshop\n          break\n  \n  if workshop_idx is None:\n      raise ValueError(f\"No workshop found to craft {item}\")\n\n  # Find the position of the workshop (this should be part of the environment state)\n  workshop_pos = env.world.cookbook.index.get(workshop_idx, None)\n\n  if workshop_pos is None:\n      raise ValueError(f\"Workshop position not found for {workshop_idx}\")\n\n  # Calculate the direction to move towards the workshop\n  agent_pos = env._current_state.pos\n  dx = workshop_pos[0] - agent_pos[0]\n  dy = workshop_pos[1] - agent_pos[1]\n\n  if dy > 0:\n      actions.extend([UP] * abs(dy))\n  elif dy < 0:\n      actions.extend([DOWN] * abs(dy))\n\n  if dx > 0:\n      actions.extend([RIGHT] * abs(dx))\n  elif dx < 0:\n      actions.extend([LEFT] * abs(dx))\n\n  # Use the workshop to craft the item\n  actions.append(USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-19T04:03:16.372497", "function_name": "craft", "function_body": "  UP = 1\n  DOWN = 0\n  LEFT = 2\n  RIGHT = 3\n  USE = 4\n\n  actions = []\n  \n  # Map string direction to action constants\n  dir_to_action = {\"UP\": UP, \"DOWN\": DOWN, \"LEFT\": LEFT, \"RIGHT\": RIGHT}\n  \n  # Get the index of the item from the cookbook\n  item_idx = env.world.cookbook.index[item]\n  \n  # Find the workshop needed for crafting this item (simplified assumption)\n  # Assuming there is only one type of workshop and it's always at position (10, 10)\n  workshop_pos = None\n  for idx in env.world.workshop_indices:\n      if env._current_state.next_to(idx):\n          workshop_pos = env._current_state.pos\n          break\n\n  if not workshop_pos:\n      # If the agent is not next to any workshop, find the nearest one\n      min_distance = float('inf')\n      closest_workshop = None\n      for idx in env.world.workshop_indices:\n          for x in range(env.world.grid.shape[0]):\n              for y in range(env.world.grid.shape[1]):\n                  if env._current_state.grid[x, y, idx] > 0:\n                      distance = abs(x - env._current_state.pos[0]) + abs(y - env._current_state.pos[1])\n                      if distance < min_distance:\n                          min_distance = distance\n                          closest_workshop = (x, y)\n      workshop_pos = closest_workshop\n\n  # Calculate the direction to move towards the workshop\n  agent_pos = env._current_state.pos\n  dx = workshop_pos[0] - agent_pos[0]\n  dy = workshop_pos[1] - agent_pos[1]\n\n  if dy > 0:\n      actions.extend([UP] * abs(dy))\n  elif dy < 0:\n      actions.extend([DOWN] * abs(dy))\n\n  if dx > 0:\n      actions.extend([RIGHT] * abs(dx))\n  elif dx < 0:\n      actions.extend([LEFT] * abs(dx))\n\n  # Use the workshop to craft the item\n  actions.append(USE)\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-19T04:04:17.283707", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_indices):\n      current_x, current_y = env._current_state.pos\n      min_distance = float('inf')\n      closest_workshop_pos = None\n      \n      for workshop_index in kind_indices:\n          # Find all positions on the grid that match the workshop index\n          positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n          \n          for pos in positions:\n              distance = abs(pos[0] - current_x) + abs(pos[1] - current_y)\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_pos = (pos[0], pos[1])\n      \n      return closest_workshop_pos\n\n  def navigate_to_position(target_pos):\n      actions = []\n      target_x, target_y = target_pos\n      \n      while env._current_state.pos != target_pos:\n          current_x, current_y = env._current_state.pos\n          dx, dy = target_x - current_x, target_y - current_y\n          \n          if dx > 0:\n              actions.append(craft.RIGHT)\n          elif dx < 0:\n              actions.append(craft.LEFT)\n          elif dy > 0:\n              actions.append(craft.DOWN)\n          elif dy < 0:\n              actions.append(craft.UP)\n          \n          # Move one step in the determined direction\n          env.step(actions[-1])\n      \n      return actions\n\n  def use_workshop():\n      return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = [workshop for workshop in env.world.workshop_indices if item_index in env.world.cookbook.recipes.get(workshop, {})]\n\n  closest_workshop_pos = find_closest_workshop(workshop_kind_indices)\n\n  actions = []\n  if closest_workshop_pos:\n      actions.extend(navigate_to_position(closest_workshop_pos))\n      actions.extend(use_workshop())\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T04:04:19.705131", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_indices):\n      current_pos = env._current_state.pos\n      min_distance = float('inf')\n      closest_workshop_idx = None\n      \n      for workshop_index in kind_indices:\n          # Find all positions on the grid that match the workshop index\n          positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n          \n          for pos in positions:\n              distance = abs(pos[0] - current_pos[0]) + abs(pos[1] - current_pos[1])\n              if distance < min_distance:\n                  min_distance = distance\n                  closest_workshop_idx = workshop_index\n      \n      return closest_workshop_idx\n\n  def go_to_workshop(kind_index):\n      # Navigate to the specified workshop index\n      actions = []\n      target_indices = np.argwhere(env._current_state.grid[:, :, kind_index] > 0)\n      \n      for target_pos in target_indices:\n          actions.extend(navigate_to_position(target_pos))\n          if env._current_state.next_to(kind_index):\n              break\n      \n      return actions\n\n  def navigate_to_position(target_pos):\n      actions = []\n      target_x, target_y = target_pos\n      \n      while env._current_state.pos != (target_x, target_y):\n          current_x, current_y = env._current_state.pos\n          dx, dy = target_x - current_x, target_y - current_y\n          \n          # Determine the direction to move based on the difference in coordinates\n          if dx > 0:\n              actions.append(craft.RIGHT)\n          elif dx < 0:\n              actions.append(craft.LEFT)\n          elif dy > 0:\n              actions.append(craft.DOWN)\n          elif dy < 0:\n              actions.append(craft.UP)\n          \n          # Move one step in the determined direction\n          env.step(actions[-1])\n      \n      return actions\n\n  def craft_item_at_workshop():\n      # Use the USE action at the correct workshop to craft the item\n      return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = [workshop for workshop in env.world.workshop_indices if item_index in env.world.cookbook.recipes.get(workshop, {})]\n\n  closest_workshop_idx = find_closest_workshop(workshop_kind_indices)\n\n  actions = []\n  if closest_workshop_idx:\n      actions.extend(go_to_workshop(closest_workshop_idx))\n      actions.extend(craft_item_at_workshop())\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T04:10:47.128632", "function_name": "craft", "function_body": "  def move_to_target(target_pos, current_pos):\n    \"\"\"Move agent from current position to target position.\"\"\"\n    actions = []\n    while not np.array_equal(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      \n      # Prioritize moving in the direction of larger difference first\n      if abs(dx) > abs(dy):  # Move horizontally first\n        actions.append(3 if dx > 0 else 2)\n        current_pos[0] += 1 if dx > 0 else -1\n      elif dy != 0:\n        actions.append(1 if dy > 0 else 0)\n        current_pos[1] += 1 if dy > 0 else -1\n      \n      # If horizontal move is not required, check vertical move\n      if abs(dy) >= abs(dx):  # Move vertically first\n        actions.append(1 if dy > 0 else 0)\n        current_pos[1] += 1 if dy > 0 else -1\n      elif dx != 0:\n        actions.append(3 if dx > 0 else 2)\n        current_pos[0] += 1 if dx > 0 else -1\n    \n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) > 0:  # Check if there are any positions\n        workshop_pos_mean = workshop_positions.mean(axis=0)\n        distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n        \n        if distance < min_distance:\n            closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Find the nearest specific position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      \n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(nearest_target_pos, pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-19T04:10:49.380424", "function_name": "craft", "function_body": "  def move_to_target(target_pos, current_pos):\n    \"\"\"Move agent from current position to target position.\"\"\"\n    actions = []\n    while not np.array_equal(current_pos, target_pos):\n      dx, dy = target_pos - current_pos\n      \n      # Prioritize moving in the direction with larger absolute difference first\n      if abs(dx) > abs(dy):  # Move horizontally first\n        actions.append(3 if dx > 0 else 2)\n        current_pos[0] += 1 if dx > 0 else -1\n      elif abs(dx) < abs(dy):  # Then move vertically\n        actions.append(1 if dy > 0 else 0)\n        current_pos[1] += 1 if dy > 0 else -1\n      else:  # If they are equal, choose one direction (e.g., horizontal first)\n        actions.append(3 if dx > 0 else 2)  # Arbitrary choice of horizontal\n        current_pos[0] += 1 if dx > 0 else -1\n    \n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) > 0:  # Check if there are any positions\n        workshop_pos_mean = workshop_positions.mean(axis=0)\n        distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n        \n        if distance < min_distance:\n            closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Find the nearest specific position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      \n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  actions.extend(move_to_target(nearest_target_pos, pos))\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 3.7}}
{"timestamp": "2025-08-19T04:12:11.686844", "function_name": "craft", "function_body": "  def move_to_workshop(env, workshop_index):\n    current_pos = env._current_state.pos\n    target_pos = find_closest_workshop(env, workshop_index)\n    \n    if target_pos is None:\n      raise ValueError(f\"No valid path to workshop {workshop_index} found.\")\n      \n    actions = []\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      # Determine the direction of movement\n      if abs(dx) > abs(dy):\n        move_dir = 3 if dx > 0 else 2\n      else:\n        move_dir = 0 if dy > 0 else 1\n      \n      actions.append(move_dir)\n\n      # Update current position based on the direction moved\n      if move_dir == 0:  # DOWN\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif move_dir == 1:  # UP\n          current_pos = (current_pos[0], current_pos[1] - 1)\n      elif move_dir == 2:  # LEFT\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      else:  # RIGHT\n          current_pos = (current_pos[0] + 1, current_pos[1])\n\n    return actions\n\n\n  def find_closest_workshop(env, workshop_index):\n    grid = env._current_state.grid\n    workshops = np.argwhere(grid[:, :, workshop_index] == 1)\n    \n    if len(workshops) == 0:\n      return None\n    \n    current_pos = np.array(env._current_state.pos)\n    distances = np.linalg.norm(workshops - current_pos, axis=1)\n    closest_workshop_idx = np.argmin(distances)\n    \n    return tuple(workshops[closest_workshop_idx])\n\n  item_index = env.world.cookbook.index[item]\n  if item_index is None:\n    raise ValueError(f\"Item '{item}' not found in the cookbook.\")\n  \n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Determine if a specific workshop is needed\n  key_workshop = recipe.get(\"_key\")\n  if key_workshop:\n      workshop_name = f\"WORKSHOP{int(key_workshop)}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      if workshop_index not in env.world.workshop_indices:\n          raise ValueError(f\"Workshop {key_workshop} not found in the list of workshops.\")\n      \n      # Move to the specific workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item\n  actions.append(4)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T04:12:13.689172", "function_name": "craft", "function_body": "  def move_to_position(env, target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    while current_pos != target_pos:\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      if abs(dx) > abs(dy):\n        action = 3 if dx > 0 else 2\n      else:\n        action = 0 if dy > 0 else 1\n\n      actions.append(action)\n      current_pos = (current_pos[0] + (1 if dx > 0 else -1 if dx < 0 else 0),\n                     current_pos[1] + (1 if dy > 0 else -1 if dy < 0 else 0))\n\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  if item_index is None:\n    raise ValueError(f\"Item '{item}' not found in the cookbook.\")\n  \n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Determine if a specific workshop is needed\n  key_workshop = recipe.get(\"_key\")\n  if key_workshop:\n      workshop_name = f\"WORKSHOP{int(key_workshop)}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      if workshop_index not in env.world.workshop_indices:\n          raise ValueError(f\"Workshop {key_workshop} not found in the list of workshops.\")\n      \n      # Find closest workshop and move there\n      target_pos = find_closest_workshop(env, workshop_index)\n      if target_pos is None:\n          raise ValueError(f\"No valid path to workshop {workshop_name} found.\")\n\n      actions.extend(move_to_position(env, target_pos))\n  \n  # Craft the item\n  actions.append(4)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T04:13:30.581638", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    dx, dy = target_pos - pos\n    directions = []\n    if dx > 0:\n      directions.append(3)  # RIGHT\n    elif dx < 0:\n      directions.append(2)  # LEFT\n    if dy > 0:\n      directions.append(1)  # UP\n    elif dy < 0:\n      directions.append(0)  # DOWN\n    return directions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n  actions_list = []\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n      for workshop_pos in workshop_positions:\n        pos = np.array(env._current_state.pos)\n        min_distance = float('inf')\n        actions = []\n\n        # Move to the closest workshop\n        while not np.array_equal(pos, workshop_pos):\n          directions = move_towards(pos, workshop_pos)\n\n          if len(directions) == 1:\n            direction = directions[0]\n          elif env._current_state.dir in directions:\n            direction = env._current_state.dir\n          else:\n            direction = directions[0]\n\n          actions.append(direction)\n\n          # Update position based on the action taken\n          if direction == 3:  # RIGHT\n            pos += np.array([1, 0])\n          elif direction == 2:  # LEFT\n            pos += np.array([-1, 0])\n          elif direction == 1:  # UP\n            pos += np.array([0, 1])\n          elif direction == 0:  # DOWN\n            pos += np.array([0, -1])\n\n        # Use the workshop to craft the item\n        actions.append(4)  # USE\n\n        distance = np.linalg.norm(np.array(env._current_state.pos) - workshop_pos)\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_actions = actions\n\n      actions_list.append(closest_workshop_actions)\n\n  if not actions_list:\n    raise ValueError(\"No available workshop found\")\n\n  # Choose the shortest path to a workshop\n  return min(actions_list, key=len)", "island_id": 5, "scores": {"3": 3.7}}
{"timestamp": "2025-08-19T04:13:32.564345", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    dx, dy = target_pos - pos\n    directions = []\n    if dx > 0:\n      directions.append(3)  # RIGHT\n    elif dx < 0:\n      directions.append(2)  # LEFT\n    if dy > 0:\n      directions.append(1)  # UP\n    elif dy < 0:\n      directions.append(0)  # DOWN\n    return directions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n  actions_list = []\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n      min_distance = float('inf')\n      closest_workshop_actions = None\n\n      for workshop_pos in workshop_positions:\n        pos = np.array(env._current_state.pos)\n        actions = []\n\n        # Move to the closest workshop\n        while not np.array_equal(pos, workshop_pos):\n          directions = move_towards(pos, workshop_pos)\n\n          if len(directions) == 1:\n            direction = directions[0]\n          elif env._current_state.dir in directions:\n            direction = env._current_state.dir\n          else:\n            direction = directions[0]\n\n          actions.append(direction)\n\n          # Update position based on the action taken\n          if direction == 3:  # RIGHT\n            pos += np.array([1, 0])\n          elif direction == 2:  # LEFT\n            pos += np.array([-1, 0])\n          elif direction == 1:  # UP\n            pos += np.array([0, 1])\n          elif direction == 0:  # DOWN\n            pos += np.array([0, -1])\n\n        # Use the workshop to craft the item\n        actions.append(4)  # USE\n\n        distance = np.linalg.norm(np.array(env._current_state.pos) - workshop_pos)\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_actions = actions\n\n      if closest_workshop_actions is not None:\n        actions_list.append(closest_workshop_actions)\n\n  if not actions_list:\n    raise ValueError(\"No available workshop found\")\n\n  # Choose the shortest path to a workshop\n  return min(actions_list, key=len)", "island_id": 5, "scores": {"3": 3.7}}
{"timestamp": "2025-08-19T04:14:40.820646", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    dx, dy = target_pos - pos\n    if abs(dx) > abs(dy):\n      return 3 if dx > 0 else 2\n    elif dy != 0:\n      return 1 if dy > 0 else 0\n    return None\n\n  def find_closest_workshop(workshops, current_pos):\n    closest_workshop = None\n    min_distance = float('inf')\n    for workshop in workshops:\n        distance = np.linalg.norm(current_pos - workshop, ord=2)\n        if distance < min_distance:\n            min_distance = distance\n            closest_workshop = workshop\n    return closest_workshop\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n      raise ValueError(\"Unknown item\")\n\n  # Identify workshops that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n  available_workshops = []\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n        available_workshops.extend(workshop_positions)\n\n  if not available_workshops:\n      raise ValueError(\"No available workshops found\")\n\n  # Find the closest workshop\n  current_pos = np.array(env._current_state.pos)\n  closest_workshop = find_closest_workshop(available_workshops, current_pos)\n\n  # Move to and use the closest workshop\n  actions = []\n  while not np.array_equal(current_pos, closest_workshop):\n      direction = move_towards(current_pos, closest_workshop)\n      if direction is None:\n          break\n      actions.append(direction)\n      if direction == 3:  # RIGHT\n          current_pos += np.array([1, 0])\n      elif direction == 2:  # LEFT\n          current_pos += np.array([-1, 0])\n      elif direction == 1:  # UP\n          current_pos += np.array([0, 1])\n      elif direction == 0:  # DOWN\n          current_pos += np.array([0, -1])\n\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 3.7}}
{"timestamp": "2025-08-19T04:19:40.892032", "function_name": "craft", "function_body": "  def move_towards(pos, target_pos):\n    dx, dy = target_pos - pos\n    actions = []\n    while not np.array_equal(pos, target_pos):\n      if abs(dx) > abs(dy):\n        direction = 3 if dx > 0 else 2\n        dx += -1 if direction == 3 else 1\n      elif dy != 0:\n        direction = 1 if dy > 0 else 0\n        dy += -1 if direction == 1 else 1\n      actions.append(direction)\n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  # Find all workshops that can craft the desired item\n  workshop_indices = env.world.workshop_indices\n  actions_list = []\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    if len(workshop_positions) > 0:\n      for workshop_pos in workshop_positions:\n        pos = np.array(env._current_state.pos)\n        min_distance = float('inf')\n        actions = move_towards(pos, workshop_pos)\n\n        # Use the workshop to craft the item\n        actions.append(4)  # USE\n\n        distance = np.linalg.norm(np.array(env._current_state.pos) - workshop_pos)\n        if distance < min_distance:\n          min_distance = distance\n          closest_workshop_actions = actions\n\n      actions_list.append(closest_workshop_actions)\n\n  if not actions_list:\n    raise ValueError(\"No available workshop found\")\n\n  # Choose the shortest path to a workshop\n  return min(actions_list, key=len)", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-19T04:21:36.077198", "function_name": "craft", "function_body": "  def get_workshop_index_from_key(workshop_key):\n    for i, workshop_name in enumerate([\"WORKSHOP0\", \"WORKSHOP1\", \"WORKSHOP2\"]):\n      if workshop_name.lower() in workshop_key:\n        return getattr(env.world, f\"{workshop_name.lower()}_index\")\n    return None\n\n  def navigate_to_target(current_state, target_pos):\n    # Simple navigation logic using BFS to find the shortest path\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(current_state.pos, [])])\n    visited = set()\n    while queue:\n      current_pos, path = queue.popleft()\n      if current_pos == target_pos:\n        return path\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n      for d in directions:\n        new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n        if 0 <= new_pos[0] < env._current_state.grid.shape[1] and 0 <= new_pos[1] < env._current_state.grid.shape[0]:\n          queue.append((new_pos, path + [d]))\n    return []\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Find the output index for the desired item\n  item_index = index[item]\n\n  # Determine which workshop is needed for this item\n  recipe = cookbook.recipes.get(item_index, {})\n  required_workshop = None\n  if \"_key\" in recipe:\n    required_workshop_key = recipe[\"_key\"]\n    required_workshop = get_workshop_index_from_key(required_workshop_key)\n\n  # Navigate to the required workshop\n  actions_to_take = []\n  if required_workshop is not None:\n    workshop_pos = np.argwhere(env._current_state.grid[:, :, required_workshop]).flatten()\n    if workshop_pos.size > 0:\n      target_pos = (workshop_pos[1], workshop_pos[0])  # Convert to (x, y) format\n      path_to_target = navigate_to_target(env._current_state, target_pos)\n      for d in path_to_target:\n        if d == (0, 1):\n          actions_to_take.append(0)  # RIGHT\n        elif d == (1, 0):\n          actions_to_take.append(2)  # DOWN\n        elif d == (0, -1):\n          actions_to_take.append(3)  # LEFT\n        elif d == (-1, 0):\n          actions_to_take.append(1)  # UP\n\n      # Orient the agent towards the workshop if necessary\n      current_dir = env._current_state.dir\n      target_dir = (target_pos[0] - current_state.pos[0], target_pos[1] - current_state.pos[1])\n      if target_dir == (0, 1) and current_dir != 0:\n          actions_to_take.append(0)  # RIGHT\n      elif target_dir == (1, 0) and current_dir != 2:\n          actions_to_take.append(2)  # DOWN\n      elif target_dir == (0, -1) and current_dir != 3:\n          actions_to_take.append(3)  # LEFT\n      elif target_dir == (-1, 0) and current_dir != 1:\n          actions_to_take.append(1)  # UP\n\n  # Use the workshop to craft the item\n  actions_to_take.append(env.world.n_actions - 1)  # Assuming USE action is the last one\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T04:21:38.075406", "function_name": "craft", "function_body": "  def get_workshop_index_from_key(workshop_key):\n    for i, workshop_name in enumerate([\"WORKSHOP0\", \"WORKSHOP1\", \"WORKSHOP2\"]):\n      if workshop_name.lower() in workshop_key:\n        return getattr(env.world, f\"{workshop_name.lower()}_index\")\n    return None\n\n  def navigate_to_target(current_state, target_pos):\n    # Simple navigation logic using BFS to find the shortest path\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = collections.deque([(current_state.pos, [])])\n    visited = set()\n    while queue:\n      current_pos, path = queue.popleft()\n      if current_pos == target_pos:\n        return path\n      if current_pos in visited:\n        continue\n      visited.add(current_pos)\n      for d in directions:\n        new_pos = (current_pos[0] + d[0], current_pos[1] + d[1])\n        if 0 <= new_pos[0] < env._current_state.grid.shape[1] and 0 <= new_pos[1] < env._current_state.grid.shape[0]:\n          queue.append((new_pos, path + [d]))\n    return []\n\n  def get_relative_direction(current_dir, target_dir):\n    # Determine the relative direction to move based on current direction\n    directions = ['RIGHT', 'DOWN', 'LEFT', 'UP']\n    current_index = directions.index(current_dir)\n    target_index = directions.index(target_dir)\n\n    if (target_index - current_index) % 4 == 1:\n      return 'RIGHT'\n    elif (target_index - current_index) % 4 == 2:\n      return 'DOWN'\n    elif (target_index - current_index) % 4 == 3:\n      return 'LEFT'\n    else:\n      return 'UP'\n\n  def convert_direction_to_action(direction):\n      if direction == 'RIGHT':\n          return 0\n      elif direction == 'DOWN':\n          return 2\n      elif direction == 'LEFT':\n          return 3\n      elif direction == 'UP':\n          return 1\n\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Find the output index for the desired item\n  item_index = index[item]\n\n  # Determine which workshop is needed for this item\n  recipe = cookbook.recipes.get(item_index, {})\n  required_workshop = None\n  if \"_key\" in recipe:\n    required_workshop_key = recipe[\"_key\"]\n    required_workshop = get_workshop_index_from_key(required_workshop_key)\n\n  # Navigate to the required workshop\n  actions_to_take = []\n  if required_workshop is not None:\n    workshop_pos = np.argwhere(env._current_state.grid[:, :, required_workshop]).flatten()\n    if workshop_pos.size > 0:\n      target_pos = (workshop_pos[1], workshop_pos[0])  # Convert to (x, y) format\n      path_to_target = navigate_to_target(env._current_state, target_pos)\n      \n      current_dir = 'RIGHT'  # Assuming the agent starts facing RIGHT\n      for d in path_to_target:\n        relative_direction = get_relative_direction(current_dir, directions.index(d))\n        action = convert_direction_to_action(relative_direction)\n        actions_to_take.append(action)\n        current_dir = relative_direction\n\n  # Use the workshop to craft the item\n  actions_to_take.append(env.world.n_actions - 1)  # Assuming USE action is the last one\n\n  return actions_to_take", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T04:22:50.146185", "function_name": "craft", "function_body": "  def find_nearest_workshop(kind_indices):\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n    \n    for x in range(env._current_state.grid.shape[0]):\n      for y in range(env._current_state.grid.shape[1]):\n        if any(index in kind_indices for index in env._current_state.grid[x, y]):\n          distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n          if distance < min_distance:\n            min_distance = distance\n            closest_workshop_pos = (x, y)\n    \n    return closest_workshop_pos\n\n  def navigate_grid(target_pos):\n    actions = []\n    target_x, target_y = target_pos\n    \n    # Calculate the difference in x and y coordinates\n    delta_x = target_x - env._current_state.pos[0]\n    delta_y = target_y - env._current_state.pos[1]\n\n    # Determine the direction to move based on the differences\n    if delta_x > 0:\n      actions.extend([craft.RIGHT] * abs(delta_x))\n    elif delta_x < 0:\n      actions.extend([craft.LEFT] * abs(delta_x))\n    \n    if delta_y > 0:\n      actions.extend([craft.DOWN] * abs(delta_y))\n    elif delta_y < 0:\n      actions.extend([craft.UP] * abs(delta_y))\n\n    return actions\n\n  def craft_item_at_workshop():\n    return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n  kind_indices = [item_index] + list(workshop_indices)\n  \n  closest_workshop_pos = find_nearest_workshop(kind_indices)\n  \n  actions = []\n  if closest_workshop_pos:\n    actions.extend(navigate_grid(closest_workshop_pos))\n    actions.extend(craft_item_at_workshop())\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T04:22:52.146457", "function_name": "craft", "function_body": "  def navigate_grid(target_pos):\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target_pos\n\n    actions = []\n    \n    # Calculate the differences in x and y coordinates\n    delta_x = target_x - current_x\n    delta_y = target_y - current_y\n    \n    # Determine the direction to move based on the differences\n    if delta_x > 0:\n        actions.extend([craft.RIGHT] * abs(delta_x))\n    elif delta_x < 0:\n        actions.extend([craft.LEFT] * abs(delta_x))\n\n    if delta_y > 0:\n        actions.extend([craft.DOWN] * abs(delta_y))\n    elif delta_y < 0:\n        actions.extend([craft.UP] * abs(delta_y))\n\n    return actions\n\n  def find_nearest_workshop(kind_indices):\n    current_pos = env._current_state.pos\n    closest_workshop_pos = None\n    min_distance = float('inf')\n\n    # Iterate over each cell in the grid to find the nearest workshop\n    for x in range(env._current_state.grid.shape[0]):\n        for y in range(env._current_state.grid.shape[1]):\n            if any(index in kind_indices for index in env._current_state.grid[x, y]):\n                distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n                if distance < min_distance:\n                    min_distance = distance\n                    closest_workshop_pos = (x, y)\n\n    return closest_workshop_pos\n\n  def go_to_workshop(kind_index):\n    workshop_position = find_nearest_workshop([kind_index])\n    if workshop_position:\n        actions = navigate_grid(workshop_position)\n        actions.append(craft.USE)  # Use the action to craft at the workshop\n        return actions\n    else:\n        return []\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Find the nearest workshop for any kind of workshop (assuming they are all capable)\n  closest_workshop_position = find_nearest_workshop(workshop_indices)\n\n  if closest_workshop_position:\n      actions = navigate_grid(closest_workshop_position)\n      actions.append(craft.USE)  # Use the action to craft at the workshop\n      return actions\n\n  return []", "island_id": 6, "scores": {"3": 0.0}}
