{"timestamp": "2025-08-18T16:59:22.140051", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_idx = env.world.cookbook.index[item]\n  \n  # Check if the item has a recipe in the cookbook\n  if item_idx not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item} in the cookbook.\")\n  \n  # Get the workshop index from the recipes dictionary (assuming \"_key\" is used)\n  workshop_index = env.world.cookbook.recipes[item_idx][\"_key\"]\n  \n  # Find the position of the workshop in the grid\n  workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_index] == 1)[0]\n  \n  # Get actions to move to the workshop\n  move_actions = get_move_to_position_actions(env, workshop_pos)\n  \n  # Action for using the workshop (assuming USE action is 4)\n  use_action = [env.action_specs()[\"USE\"]]\n  \n  return move_actions + use_action", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-18T16:59:24.018185", "function_name": "craft", "function_body": "  # Determine the workshop type required for crafting the given item.\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  if not item_index:\n    raise ValueError(f\"Unknown item: {item}\")\n\n  # Get the recipe for the item to determine which workshop is needed.\n  recipe = cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No crafting recipe found for item: {item}\")\n  \n  # Find the index of the workshop required based on the recipe.\n  required_workshop = None\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n          kind = cookbook.index.get(cookbook.kinds[ingredient])\n          if kind and \"workshop\" in cookbook.index.get(kind):\n              required_workshop = kind\n              break\n  \n  if not required_workshop:\n    raise ValueError(\"No workshop found that can craft the item.\")\n\n  # Find the position of the nearest required workshop.\n  def find_nearest_workshop(grid, target_kind_index):\n      positions = np.argwhere(grid[:, :, target_kind_index] > 0)\n      agent_pos = env._current_state.pos\n      min_distance = float('inf')\n      nearest_position = None\n      \n      for pos in positions:\n          distance = np.linalg.norm(np.array(pos) - np.array(agent_pos))\n          if distance < min_distance:\n              min_distance = distance\n              nearest_position = tuple(pos)\n      \n      return nearest_position\n\n  workshop_index = cookbook.index.get(required_workshop)\n  nearest_workshop_pos = find_nearest_workshop(env._current_state.grid, workshop_index)\n\n  # Calculate the path to the nearest workshop.\n  def calculate_path_to_workshop(agent_pos, target_pos):\n      path = []\n      while agent_pos != target_pos:\n          dx = target_pos[0] - agent_pos[0]\n          dy = target_pos[1] - agent_pos[1]\n          \n          if abs(dx) > abs(dy):\n              if dx > 0:\n                  path.append(env.world.N_RIGHT)\n              else:\n                  path.append(env.world.N_LEFT)\n          else:\n              if dy > 0:\n                  path.append(env.world.N_UP)\n              else:\n                  path.append(env.world.N_DOWN)\n          \n          agent_pos = (agent_pos[0] + (1 if dx > 0 else -1 if dx < 0 else 0),\n                       agent_pos[1] + (1 if dy > 0 else -1 if dy < 0 else 0))\n      \n      return path\n\n  path_to_workshop = calculate_path_to_workshop(env._current_state.pos, nearest_workshop_pos)\n  \n  # Add the action to use the workshop.\n  path_to_workshop.append(env.world.N_USE)\n\n  return path_to_workshop", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-08-18T17:00:33.913445", "function_name": "craft", "function_body": "  # Get the index of the goal item\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  # Get the list of workshop indices from the CraftWorld instance\n  workshop_indices = env.world.workshop_indices\n  \n  # Select a suitable workshop to craft the item. For simplicity, we'll choose the first one.\n  target_workshop_index = workshop_indices[0]\n  \n  # Get the current state\n  current_state = env._current_state\n  \n  # Define actions for moving directions and using an object\n  DOWN, UP, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  \n  # Initialize a list to store actions\n  actions = []\n  \n  # Find the position of the target workshop in the grid\n  grid = current_state.grid\n  workshop_positions = np.argwhere(grid[:, :, target_workshop_index] == 1)\n  \n  if len(workshop_positions) == 0:\n    raise ValueError(f\"No workshop with index {target_workshop_index} found in the grid.\")\n  \n  # Select the first available workshop position as the target location\n  target_pos = tuple(workshop_positions[0])\n  \n  # Calculate the path to the target position\n  current_pos = current_state.pos\n  \n  # Move to the target position\n  while current_pos != target_pos:\n    dx, dy = target_pos[0] - current_pos[0], target_pos[1] - current_pos[1]\n    \n    if dx > 0 and current_state.dir == DOWN:\n      actions.append(DOWN)\n    elif dx < 0 and current_state.dir == UP:\n      actions.append(UP)\n    elif dy > 0 and current_state.dir == RIGHT:\n      actions.append(RIGHT)\n    elif dy < 0 and current_state.dir == LEFT:\n      actions.append(LEFT)\n    \n    # Adjust direction if necessary\n    if dx > 0 and current_state.dir != DOWN:\n      actions.append(DOWN)\n    elif dx < 0 and current_state.dir != UP:\n      actions.append(UP)\n    elif dy > 0 and current_state.dir != RIGHT:\n      actions.append(RIGHT)\n    elif dy < 0 and current_state.dir != LEFT:\n      actions.append(LEFT)\n    \n    # Move one step\n    if dx > 0:\n      actions.append(DOWN)\n      current_pos = (current_pos[0] + 1, current_pos[1])\n    elif dx < 0:\n      actions.append(UP)\n      current_pos = (current_pos[0] - 1, current_pos[1])\n    elif dy > 0:\n      actions.append(RIGHT)\n      current_pos = (current_pos[0], current_pos[1] + 1)\n    elif dy < 0:\n      actions.append(LEFT)\n      current_pos = (current_pos[0], current_pos[1] - 1)\n  \n  # Use the workshop to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-18T17:00:35.788971", "function_name": "craft", "function_body": "  # Find index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get primitives required for crafting the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  actions = []\n  \n  # Collect all required primitives\n  for primitive, count in primitives_needed.items():\n    # Find the name of the primitive using its index\n    primitive_name = env.world.cookbook.index.get(primitive, None)\n    \n    if not primitive_name:\n      continue\n    \n    # Collect the required amount of primitive\n    actions.extend(collect(env, primitive_name))\n  \n  # Craft the item at a suitable workshop\n  actions.extend(craft_at_workshop(env, item_index))\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-18T17:02:38.648585", "function_name": "craft", "function_body": "  def navigate_to_workshop(scenario, target_workshop_index):\n      world = scenario.world\n      grid = scenario.grid.copy()\n      init_pos = scenario.init_pos\n\n      # BFS to find the shortest path to a workshop\n      queue = collections.deque([init_pos])\n      visited = set([init_pos])\n      parent = {init_pos: None}\n      found_workshop = False\n\n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          if grid[x, y, target_workshop_index] > 0:\n              found_workshop = True\n              break\n          \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      # If workshop is found, reconstruct the path\n      if found_workshop:\n          path = []\n          while pos != init_pos:\n              path.append(pos)\n              pos = parent[pos]\n          path.reverse()\n          return path\n      else:\n          return None\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dy < 0: return [0] * abs(dy)  # UP\n      elif dy > 0: return [1] * abs(dy)  # DOWN\n      elif dx < 0: return [2] * abs(dx)  # LEFT\n      elif dx > 0: return [3] * abs(dx)  # RIGHT\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      scenario = env.scenario\n      path = navigate_to_workshop(scenario, target_workshop_index)\n      actions = []\n      current_pos = scenario.init_pos\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_pos, next_pos))\n          current_pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T17:02:40.637612", "function_name": "craft", "function_body": "  def navigate_to_workshop(scenario, target_workshop_index):\n      world = scenario.world\n      grid = scenario.grid.copy()\n      init_pos = scenario.init_pos\n\n      # BFS to find the shortest path to a workshop\n      queue = collections.deque([init_pos])\n      visited = set([init_pos])\n      parent = {init_pos: None}\n      found_workshop = False\n\n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          if grid[x, y, target_workshop_index] > 0:\n              found_workshop = True\n              break\n          \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n\n      # If workshop is found, reconstruct the path\n      if found_workshop:\n          path = []\n          while pos != init_pos:\n              path.append(pos)\n              pos = parent[pos]\n          path.reverse()\n          return path\n      else:\n          return None\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      if dy < 0: return [0] * abs(dy)  # UP\n      elif dy > 0: return [1] * abs(dy)  # DOWN\n      elif dx < 0: return [2] * abs(dx)  # LEFT\n      elif dx > 0: return [3] * abs(dx)  # RIGHT\n      return []\n\n  def find_workshop_position(scenario, target_workshop_index):\n      world = scenario.world\n      grid = scenario.grid.copy()\n\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, target_workshop_index] > 0:\n                  return (x, y)\n      return None\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      scenario = env.scenario\n      path = navigate_to_workshop(scenario, target_workshop_index)\n      actions = []\n      current_pos = scenario.init_pos\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_pos, next_pos))\n          current_pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T17:05:27.386271", "function_name": "craft", "function_body": "  def navigate_to_workshop(state, target_workshop_index):\n    grid = state.grid.copy()\n    init_pos = state.pos\n    direction = state.dir\n\n    # BFS to find the shortest path to a workshop\n    queue = collections.deque([(init_pos, direction)])\n    visited = set([init_pos])\n    parent = {init_pos: None}\n    found_workshop = False\n\n    while queue:\n      (pos, dir), _ = queue.popleft()\n      x, y = pos\n\n      # Check if the workshop is at the current position\n      if grid[x, y, target_workshop_index] > 0:\n        found_workshop = True\n        break\n      \n      # Explore neighbors\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if (nx, ny) not in visited:\n            queue.append(((nx, ny), dir))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = ((x, y), dir)\n\n    # If workshop is found, reconstruct the path\n    if found_workshop:\n      path = []\n      while pos != init_pos:\n        path.append(pos)\n        pos, _ = parent[pos]\n      path.reverse()\n      return path\n    else:\n      return None\n\n  def actions_to_move(current_pos, current_dir, next_pos):\n    dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n\n    # Determine direction to move in\n    if dx < 0 and (current_dir != 2): return [2] + actions_to_move((current_pos[0]-1, current_pos[1]), 2, next_pos)  # LEFT\n    elif dx > 0 and (current_dir != 3): return [3] + actions_to_move((current_pos[0]+1, current_pos[1]), 3, next_pos)  # RIGHT\n    elif dy < 0 and (current_dir != 0): return [0] + actions_to_move((current_pos[0], current_pos[1]-1), 0, next_pos)  # UP\n    elif dy > 0 and (current_dir != 1): return [1] + actions_to_move((current_pos[0], current_pos[1]+1), 1, next_pos)  # DOWN\n\n    # If the direction is correct, move in that direction\n    if dx < 0: return [2]\n    elif dx > 0: return [3]\n    elif dy < 0: return [0]\n    elif dy > 0: return [1]\n\n    return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Ensure the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n      raise ValueError(f\"No recipe for {item}\")\n\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item's ingredients\n  target_workshop_index = None\n  for idx in workshop_indices:\n    if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n      target_workshop_index = idx\n      break\n\n  if target_workshop_index is not None:\n    state = env._current_state\n    path = navigate_to_workshop(state, target_workshop_index)\n    actions = []\n    current_pos = state.pos\n    current_dir = state.dir\n\n    if path is not None:\n      for next_pos in path:\n        actions.extend(actions_to_move(current_pos, current_dir, next_pos))\n        current_pos = next_pos  # Update position after moving\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n    else:\n      raise ValueError(\"No path to workshop found\")\n  else:\n    raise ValueError(f\"No suitable workshop for crafting {item}\")", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-18T17:05:29.263911", "function_name": "craft", "function_body": "  def navigate(env, target_pos):\n    \"\"\"Navigate to a target position using BFS.\"\"\"\n    start_pos = env._current_state.pos\n    grid = env._current_state.grid.copy()\n    queue = collections.deque([(start_pos, [])])\n    visited = set([start_pos])\n\n    while queue:\n      (x, y), path = queue.popleft()\n\n      # Check if the target position is reached\n      if (x, y) == target_pos:\n        return path\n\n      # Explore neighbors\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if (nx, ny) not in visited:\n            queue.append(((nx, ny), path + actions_to_move((x, y), env._current_state.dir, (nx, ny))))\n            visited.add((nx, ny))\n\n    return None\n\n  def actions_to_move(current_pos, current_dir, next_pos):\n    dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n\n    # Determine direction to move in\n    if dx < 0 and (current_dir != 2): return [2] + actions_to_move((current_pos[0]-1, current_pos[1]), 2, next_pos)  # LEFT\n    elif dx > 0 and (current_dir != 3): return [3] + actions_to_move((current_pos[0]+1, current_pos[1]), 3, next_pos)  # RIGHT\n    elif dy < 0 and (current_dir != 0): return [0] + actions_to_move((current_pos[0], current_pos[1]-1), 0, next_pos)  # UP\n    elif dy > 0 and (current_dir != 1): return [1] + actions_to_move((current_pos[0], current_pos[1]+1), 1, next_pos)  # DOWN\n\n    # If the direction is correct, move in that direction\n    if dx < 0: return [2]\n    elif dx > 0: return [3]\n    elif dy < 0: return [0]\n    elif dy > 0: return [1]\n\n    return []\n\n  item_index = env.world.cookbook.index[item]\n\n  # Ensure the item has a recipe\n  if item_index not in env.world.cookbook.recipes:\n      raise ValueError(f\"No recipe for {item}\")\n\n  # Determine which workshop to use based on the item's ingredients\n  workshop_indices = env.world.workshop_indices\n\n  closest_workshop_position = None\n  min_distance = float('inf')\n  \n  current_pos = env._current_state.pos\n  \n  for i, idx in enumerate(workshop_indices):\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          # Calculate distance to the workshop\n          workshop_grid_index = np.where(env._current_state.grid[:, :, idx] > 0)\n          if len(workshop_grid_index[0]) == 0:\n              continue\n\n          workshop_pos = (workshop_grid_index[0][0], workshop_grid_index[1][0])\n          distance = abs(current_pos[0] - workshop_pos[0]) + abs(current_pos[1] - workshop_pos[1])\n          \n          if distance < min_distance:\n              closest_workshop_position = workshop_pos\n              min_distance = distance\n\n  if closest_workshop_position is not None:\n      # Navigate to the closest workshop using BFS\n      actions.extend(navigate(env, closest_workshop_position))\n      \n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-18T17:06:26.967694", "function_name": "craft", "function_body": "  actions = []\n  \n  # Determine the index of the item we want to craft\n  target_index = env.world.cookbook.index[item]\n  \n  # Find out which workshop is required for crafting this item\n  recipe = env.world.cookbook.recipes[target_index]\n  workshop_needed = None\n\n  # Check if there's a \"_key\" in the recipe, which specifies a workshop requirement.\n  if \"_key\" in recipe:\n      workshop_needed = int(recipe[\"_key\"])\n  else:\n      raise ValueError(f\"No workshop key found for item {item}.\")\n\n  # Find the position of the required workshop\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_needed] == 1)\n  \n  if not workshop_positions.size:\n      raise ValueError(f\"Workshop with index {workshop_needed} not found in the grid.\")\n\n  # Choose a random position for the workshop (as there might be multiple)\n  target_pos = tuple(workshop_positions[0])\n\n  # Move to the chosen workshop position\n  actions.extend(move_to(env, target_pos))\n\n  # Once at the workshop, use it to craft the item\n  actions.append(craft.CRAFT_FUNC)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-18T17:06:28.962389", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item from the cookbook\n  item_index = env.world.cookbook.index[item]\n\n  actions = []\n\n  # Determine the workshop needed to craft the item (if any)\n  if item_index in env.world.workshop_indices:\n    workshop_index = env.world.workshop_indices[item_index]\n    \n    # Find all positions of the required workshops in the grid\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n    if len(workshop_positions) == 0:\n      raise ValueError(f\"No available workshops found for crafting {item}.\")\n\n    # Choose the closest workshop to move towards (could be improved with pathfinding)\n    target_pos = workshop_positions[0]\n    current_pos = env._current_state.pos\n\n    # Calculate the direction needed to move towards the workshop\n    delta_x, delta_y = target_pos - np.array(current_pos)\n\n    if delta_x > 0:\n        actions.append(env.world.N_ACTIONS + craft.MOVE_RIGHT)\n    elif delta_x < 0:\n        actions.append(env.world.N_ACTIONS + craft.MOVE_LEFT)\n    \n    if delta_y > 0:\n        actions.append(env.world.N_ACTIONS + craft.MOVE_DOWN)\n    elif delta_y < 0:\n        actions.append(env.world.N_ACTIONS + craft.MOVE_UP)\n\n    # Add action to use the workshop\n    actions.append(craft.USE)\n\n  return actions", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T17:07:38.532516", "function_name": "craft", "function_body": "  # Parse the input item to get its index\n  item_index = env.world.cookbook.index[item]\n\n  # Determine the required ingredients for the item from the recipes\n  recipe = env.world.cookbook.recipes.get(item_index, {})\n  \n  # Identify the workshop needed for crafting this item (this is a placeholder and should be determined based on the recipe details)\n  workshop_needed = -1\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          continue\n      ingredient_name = env.world.cookbook.index.get(ingredient)\n      # Placeholder: Assume workshops are named \"WORKSHOP0\", \"WORKSHOP1\", etc.\n      if \"workshop\" in ingredient_name.lower():\n          workshop_needed = ingredient\n          break\n\n  if workshop_needed == -1:\n      raise ValueError(f\"No workshop found for crafting {item}\")\n\n  # Find the position of the needed workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_needed] > 0)\n  \n  if not workshop_positions.size:\n      raise ValueError(\"Workshop not found on the grid\")\n\n  # Choose a random position from the available workshops (this can be improved)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Calculate the actions needed to move to the workshop\n  current_position = env._current_state.pos\n  delta_x = target_workshop_pos[1] - current_position[1]\n  delta_y = target_workshop_pos[0] - current_position[0]\n\n  actions = []\n  \n  if delta_y > 0:\n      actions.extend([env.world.N_DOWN] * delta_y)\n  elif delta_y < 0:\n      actions.extend([env.world.N_UP] * abs(delta_y))\n      \n  if delta_x > 0:\n      actions.extend([env.world.N_RIGHT] * delta_x)\n  elif delta_x < 0:\n      actions.extend([env.world.N_LEFT] * abs(delta_x))\n\n  # Action to use the workshop (placeholder action, replace with actual USE action index)\n  actions.append(env.world.N_USE)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-08-18T17:07:40.968942", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = env._current_state.pos\n\n  for workshop_idx in workshop_indices:\n    workshop_pos = np.argwhere(env._current_state.grid[:, :, workshop_idx]).mean(axis=0)\n    \n    if len(workshop_pos) > 0: # Check if there is any location for the workshop\n      distance = np.linalg.norm(pos - workshop_pos, ord=2)\n      if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx]).mean(axis=0)\n  \n  while not np.array_equal(pos, target_pos):\n    dx, dy = target_pos - pos\n    direction = None\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n    else: # Move in the y-direction next\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n    \n    pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-18T17:09:48.373800", "function_name": "craft", "function_body": "  def navigate_to_workshop(current_state, target_workshop_index):\n      grid = current_state.grid.copy()\n      pos = current_state.pos\n      dir = current_state.dir\n\n      # BFS to find the shortest path to a workshop\n      queue = collections.deque([(pos[0], pos[1])])\n      visited = set([(pos[0], pos[1])])\n      parent = {(pos[0], pos[1]): None}\n      found_workshop = False\n\n      while queue:\n          x, y = queue.popleft()\n          if grid[x, y, target_workshop_index] > 0:\n              found_workshop = True\n              break\n          \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      queue.append((nx, ny))\n                      visited.add((nx, ny))\n                      parent[(nx, ny)] = (x, y)\n                  \n      # If workshop is found, reconstruct the path\n      if found_workshop:\n          path = []\n          while (x, y) != current_state.pos:\n              path.append((x, y))\n              x, y = parent[(x, y)]\n          path.reverse()\n          return path\n      else:\n          return None\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      \n      # Determine the direction to move\n      actions = []\n      if dy < 0: actions.extend([0] * abs(dy))  # UP\n      elif dy > 0: actions.extend([1] * abs(dy))  # DOWN\n      elif dx < 0: actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0: actions.extend([3] * abs(dx))  # RIGHT\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      current_state = env._current_state\n      path = navigate_to_workshop(current_state, target_workshop_index)\n      actions = []\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_state.pos, next_pos))\n          current_state.pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T17:09:50.421969", "function_name": "craft", "function_body": "  def navigate_to_workshop(current_state, target_workshop_index):\n    grid = current_state.grid.copy()\n    pos = current_state.pos\n    dir = current_state.dir\n\n    # BFS to find the shortest path to a workshop\n    queue = collections.deque([(pos[0], pos[1], dir)])\n    visited = set([(pos[0], pos[1])])\n    parent = {(pos[0], pos[1]): None}\n    found_workshop = False\n\n    while queue:\n        x, y, d = queue.popleft()\n        if grid[x, y, target_workshop_index] > 0:\n            found_workshop = True\n            break\n        \n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                if (nx, ny) not in visited:\n                    queue.append((nx, ny))\n                    visited.add((nx, ny))\n                    parent[(nx, ny)] = (x, y)\n                    \n    # If workshop is found, reconstruct the path\n    if found_workshop:\n        path = []\n        while pos != scenario.init_pos:\n            path.append(pos)\n            pos = parent[pos]\n        path.reverse()\n        return path\n    else:\n        return None\n\n  def actions_to_move(current_state, next_pos):\n      x1, y1 = current_state.pos\n      x2, y2 = next_pos\n      dx, dy = x2 - x1, y2 - y1\n      \n      # Determine the direction to move\n      actions = []\n      \n      if dy < 0:\n          while current_state.dir != 0:\n              actions.append(0)  # Turn UP\n              current_state.dir = (current_state.dir - 1) % 4\n          actions.extend([0] * abs(dy))  # Move UP\n      \n      elif dy > 0:\n          while current_state.dir != 1:\n              actions.append(1)  # Turn DOWN\n              current_state.dir = (current_state.dir + 1) % 4\n          actions.extend([1] * abs(dy))  # Move DOWN\n      \n      elif dx < 0:\n          while current_state.dir != 2:\n              actions.append(2)  # Turn LEFT\n              current_state.dir = (current_state.dir - 1) % 4\n          actions.extend([2] * abs(dx))  # Move LEFT\n      \n      elif dx > 0:\n          while current_state.dir != 3:\n              actions.append(3)  # Turn RIGHT\n              current_state.dir = (current_state.dir + 1) % 4\n          actions.extend([3] * abs(dx))  # Move RIGHT\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      current_state = env._current_state\n      path = navigate_to_workshop(current_state, target_workshop_index)\n      actions = []\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_state, next_pos))\n          current_state.pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T17:10:24.827922", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for the item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n  \n  actions = []\n  \n  # Determine if specific workshops are needed and move to them\n  key_workshops = set(recipe.get(\"_key\", []))  # Assuming _key can be a list of workshops\n  for key_workshop in key_workshops:\n      workshop_name = f\"WORKSHOP{int(key_workshop)}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      if workshop_index not in env.world.workshop_indices:\n          raise ValueError(f\"Workshop {key_workshop} not found in the list of workshops.\")\n      \n      # Move to the specific workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item\n  actions.append(4)\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T17:10:26.897636", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes.get(item_index)\n\n  if not recipe:\n    raise ValueError(f\"No recipe found for item: {item}\")\n\n  actions = []\n\n  # Determine if a specific workshop is needed\n  key_workshop = recipe.get(\"_key\")\n  if key_workshop:\n      workshop_name = f\"WORKSHOP{int(key_workshop)}\"\n      workshop_index = env.world.cookbook.index[workshop_name]\n      \n      if workshop_index not in env.world.workshop_indices:\n          raise ValueError(f\"Workshop {key_workshop} not found in the list of workshops.\")\n      \n      # Move to the specific workshop\n      actions.extend(move_to_workshop(env, workshop_index))\n  \n  # Craft the item\n  actions.append(4)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T17:12:17.674537", "function_name": "craft", "function_body": "  # Get the index of the item to be crafted.\n  i_item = env.world.cookbook.index[item]\n\n  # Retrieve all primitive ingredients required to make the item.\n  primitives_needed = env.world.cookbook.primitives_for(i_item)\n\n  # Initialize a list to hold actions.\n  actions = []\n\n  def find_closest_workshop(kind_index):\n    \"\"\"Finds the closest workshop that can produce an item of kind_index.\"\"\"\n    distances = []\n    for w in env.world.workshop_indices:\n      if w == kind_index or env._current_state.grid[:, :, w].sum() > 0: # Check if there are any workshops\n        workshop_pos = np.argwhere(env._current_state.grid[:, :, w] > 0)\n        if len(workshop_pos) > 0:\n          closest_workshop = min(workshop_pos, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n          distances.append((w, closest_workshop))\n    return min(distances, key=lambda x: np.linalg.norm(np.array(x[1]) - np.array(env._current_state.pos)), default=None)\n\n  def go_to_workshop(workshop_pos):\n    \"\"\"Navigate to the specified workshop position using BFS.\"\"\"\n    actions = []\n    target_x, target_y = workshop_pos\n    start_x, start_y = env._current_state.pos\n\n    queue = collections.deque([(start_x, start_y, [])])\n    visited = set((start_x, start_y))\n    \n    while queue:\n      current_x, current_y, path = queue.popleft()\n      \n      if (current_x, current_y) == (target_x, target_y):\n        actions.extend(path)\n        break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x, new_y = current_x + dx, current_y + dy\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          if env._current_state.grid[new_x, new_y].sum() > 0: # Ensure we only move to cells with objects\n            if (new_x, new_y) not in visited:\n              visited.add((new_x, new_y))\n              queue.append((new_x, new_y, path + [get_move_action(dx, dy)]))\n\n    return actions\n\n  def get_move_action(dx, dy):\n      \"\"\"Determine the move action based on the difference in coordinates.\"\"\"\n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      elif dy < 0:\n          return craft.UP\n\n  def craft_item_at_workshop(kind_index):\n    \"\"\"Craft the item at the correct workshop.\"\"\"\n    return [craft.USE]\n\n  closest_workshop = find_closest_workshop(i_item)\n  if closest_workshop:\n    workshop_kind, workshop_pos = closest_workshop\n    actions.extend(go_to_workshop(workshop_pos))\n    actions.extend(craft_item_at_workshop(workshop_kind))\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
