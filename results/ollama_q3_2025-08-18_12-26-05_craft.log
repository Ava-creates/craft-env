{"timestamp": "2025-08-18T18:12:37.228289", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  output_index = cookbook.index[item]\n  recipe = cookbook.recipes[output_index]\n\n  actions = []\n\n  # Find a suitable workshop that can craft this item\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n          continue  # Skip the key which is just metadata\n\n      # Assuming _key is something like \"WORKSHOPx\"\n      workshop_name = cookbook.index.get(count)\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Find a position of the workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          continue  # No available workshop, try another one\n\n      # Choose the closest workshop (simple heuristic)\n      pos = env._current_state.pos\n      distances = np.linalg.norm(workshop_positions - pos, axis=1)\n      nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n      # Add actions to move to the workshop\n      actions.extend(move_to(env, nearest_workshop_pos))\n\n      # Face the correct direction towards the workshop (optional but useful for USE action)\n      actions.append(face_towards_workshop(env, nearest_workshop_pos))\n\n      # Use the workshop until the item is crafted\n      while not env._current_state.inventory[output_index]:\n          actions.append(env.action_specs()[\"USE\"])\n          time.sleep(0.1)  # Sleep to simulate time taken for crafting\n\n      break  # Assuming one workshop is enough\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:12:39.414613", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  output_index = cookbook.index[item]\n  recipe = cookbook.recipes[output_index]\n\n  actions = []\n\n  # Find a suitable workshop that can craft this item\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\":\n          continue  # Skip the key which is just metadata\n\n      # Assuming _key is something like \"WORKSHOPx\"\n      workshop_name = cookbook.index.get(count)\n      workshop_index = env.world.cookbook.index[workshop_name]\n\n      # Find a position of the workshop in the grid\n      workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n\n      if len(workshop_positions) == 0:\n          continue  # No available workshop, try another one\n\n      # Choose the closest workshop (simple heuristic)\n      pos = env._current_state.pos\n      distances = np.linalg.norm(workshop_positions - pos, axis=1)\n      nearest_workshop_pos = tuple(workshop_positions[np.argmin(distances)])\n\n      # Add actions to move to the workshop\n      actions.extend(move_to(env, nearest_workshop_pos))\n\n      # Face the correct direction towards the workshop (optional but useful for USE action)\n      actions.append(face_towards_workshop(env, nearest_workshop_pos))\n\n      # Add action to use the workshop (assuming USE is the action for crafting)\n      actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:14:37.327273", "function_name": "craft", "function_body": "  def navigate_to_workshop(state, target_workshop_index):\n    grid = state.grid.copy()\n    init_pos = state.pos\n    direction = state.dir\n\n    # BFS to find the shortest path to a workshop\n    queue = collections.deque([(init_pos, direction)])\n    visited = set([init_pos])\n    parent = {init_pos: None}\n    found_workshop = False\n\n    while queue:\n      pos, dir_ = queue.popleft()\n      x, y = pos\n\n      # Check if the workshop is at the current position\n      if grid[x, y, target_workshop_index] > 0:\n        found_workshop = True\n        break\n      \n      # Explore neighbors\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if (nx, ny) not in visited:\n            queue.append(((nx, ny), dir_))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = pos\n\n    # If workshop is found, reconstruct the path\n    if found_workshop:\n      path = []\n      while pos != init_pos:\n        path.append(pos)\n        pos = parent[pos]\n      path.reverse()\n      return path\n    else:\n      return None\n\n  def actions_to_move(current_state, next_pos):\n    x1, y1 = current_state.pos\n    x2, y2 = next_pos\n    dx, dy = x2 - x1, y2 - y1\n    \n    # Determine the direction to move\n    actions = []\n    if dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    elif dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n    if dy < 0:\n      actions.extend([0] * abs(dy))  # UP\n    elif dy > 0:\n      actions.extend([1] * abs(dy))  # DOWN\n    return actions\n\n  def turn_to_direction(current_dir, target_dir):\n    \"\"\"Returns the actions needed to turn from current_dir to target_dir.\"\"\"\n    if (current_dir == 0 and target_dir == 2) or\\\n       (current_dir == 1 and target_dir == 3) or\\\n       (current_dir == 2 and target_dir == 1) or\\\n       (current_dir == 3 and target_dir == 0):\n        return [5]  # Turn right\n    elif (current_dir == 0 and target_dir == 3) or\\\n         (current_dir == 1 and target_dir == 2) or\\\n         (current_dir == 2 and target_dir == 0) or\\\n         (current_dir == 3 and target_dir == 1):\n        return [6]  # Turn left\n    elif current_dir != target_dir:\n        return [7]  # Turn around\n    return []\n\n  def get_direction_from_difference(dx, dy):\n    \"\"\"Returns the direction based on dx and dy.\"\"\"\n    if dy < 0: return 0  # UP\n    elif dy > 0: return 1  # DOWN\n    elif dx < 0: return 2  # LEFT\n    elif dx > 0: return 3  # RIGHT\n    return None\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      state = env._current_state\n      path = navigate_to_workshop(state, target_workshop_index)\n      actions = []\n      current_pos = state.pos\n      current_dir = state.dir\n\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n          target_dir = get_direction_from_difference(dx, dy)\n          \n          if target_dir is not None and target_dir != current_dir:\n              actions.extend(turn_to_direction(current_dir, target_dir))\n              current_dir = target_dir\n\n          actions.extend(actions_to_move(state, next_pos))\n          state.pos = next_pos  # Update position after moving\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:14:39.546743", "function_name": "craft", "function_body": "  def navigate_to_workshop(state, target_workshop_index):\n    grid = state.grid.copy()\n    init_pos = state.pos\n    direction = state.dir\n\n    # BFS to find the shortest path to a workshop\n    queue = collections.deque([(init_pos, direction)])\n    visited = set([init_pos])\n    parent = {init_pos: None}\n    found_workshop = False\n\n    while queue:\n      pos, dir_ = queue.popleft()\n      x, y = pos\n\n      # Check if the workshop is at the current position\n      if grid[x, y, target_workshop_index] > 0:\n        found_workshop = True\n        break\n      \n      # Explore neighbors\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if (nx, ny) not in visited:\n            queue.append(((nx, ny), dir_))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = ((x, y), dir_)\n\n    # If workshop is found, reconstruct the path\n    if found_workshop:\n      path = []\n      while pos != init_pos:\n        path.append(pos)\n        pos, _ = parent[pos]\n      path.reverse()\n      return path\n    else:\n      return None\n\n  def actions_to_move(current_state, next_pos):\n    x1, y1 = current_state.pos\n    x2, y2 = next_pos\n    dx, dy = x2 - x1, y2 - y1\n    \n    # Determine the direction to move\n    if dy < 0: return [0] * abs(dy)  # UP\n    elif dy > 0: return [1] * abs(dy)  # DOWN\n    elif dx < 0: return [2] * abs(dx)  # LEFT\n    elif dx > 0: return [3] * abs(dx)  # RIGHT\n    return []\n\n  def turn_to_direction(current_dir, target_dir):\n    \"\"\"Returns the actions needed to turn from current_dir to target_dir.\"\"\"\n    if (current_dir == 0 and target_dir == 2) or\\\n       (current_dir == 1 and target_dir == 3) or\\\n       (current_dir == 2 and target_dir == 1) or\\\n       (current_dir == 3 and target_dir == 0):\n        return [5]  # Turn right\n    elif (current_dir == 0 and target_dir == 3) or\\\n         (current_dir == 1 and target_dir == 2) or\\\n         (current_dir == 2 and target_dir == 0) or\\\n         (current_dir == 3 and target_dir == 1):\n        return [6]  # Turn left\n    return []\n\n  def get_direction_from_difference(dx, dy):\n    \"\"\"Returns the direction based on dx and dy.\"\"\"\n    if dy < 0: return 0  # UP\n    elif dy > 0: return 1  # DOWN\n    elif dx < 0: return 2  # LEFT\n    elif dx > 0: return 3  # RIGHT\n    return None\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      state = env._current_state\n      path = navigate_to_workshop(state, target_workshop_index)\n      actions = []\n      current_pos = state.pos\n      current_dir = state.dir\n\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n          target_dir = get_direction_from_difference(dx, dy)\n          \n          if target_dir is not None and target_dir != current_dir:\n              actions.extend(turn_to_direction(current_dir, target_dir))\n              current_dir = target_dir\n\n          actions.extend(actions_to_move(state, next_pos))\n          state.pos = next_pos  # Update position after moving\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:15:27.629411", "function_name": "craft", "function_body": "  # Step 1: Extract index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Step 2: Find the required workshop type for the item (if any)\n  recipe = env.world.cookbook.recipes.get(item_index, None)\n  \n  if not recipe:\n    return []\n  \n  _key = \"_key\"\n  workshop_type = recipe.get(_key, None)\n  \n  if not workshop_type:\n    return []\n    \n  # Step 3: Find the index of the required workshop type\n  workshop_index = env.world.cookbook.index[workshop_type]\n  \n  # Get list of all workshops matching the required type\n  workshops = [i for i in range(len(env.world.workshop_indices)) if env.world.workshop_indices[i] == workshop_index]\n  \n  if not workshops:\n    return []\n\n  # Step 4: Calculate shortest distance to the nearest workshop\n  closest_workshop_idx = None\n  min_distance = float('inf')\n  current_pos = env._current_state.pos\n  \n  for workshop in workshops:\n    workshop_position = tuple(workshop)  # Assuming each workshop is a position\n    distance = np.linalg.norm(np.array(current_pos) - np.array(workshop_position))\n    \n    if distance < min_distance:\n      min_distance = distance\n      closest_workshop_idx = workshop\n\n  # Step 5: Navigate to the nearest workshop and perform crafting action\n  actions_to_take = navigate(env, current_pos, closest_workshop_idx)\n  \n  # Crafting action is represented by a specific action index (e.g., USE)\n  use_action_index = 4  # Assuming 4 represents the USE action\n  \n  actions_to_take.append(use_action_index)\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:15:29.727682", "function_name": "craft", "function_body": "  # Step 1: Determine the required workshop for crafting the item\n  index = env.world.cookbook.index\n  item_index = index[item]\n  \n  # Find which recipe involves this output\n  recipe = None\n  for output, ingredients in env.world.cookbook.recipes.items():\n      if output == item_index:\n          recipe = ingredients\n          break\n\n  if not recipe:\n      raise ValueError(f\"No crafting recipe found for {item}\")\n\n  workshop_type = None\n  # Determine the type of workshop required based on the recipe ingredients\n  for ingredient, count in recipe.items():\n      if ingredient != \"_key\" and ingredient >= len(env.world.cookbook.kinds):\n          continue\n\n      kind_name = index.get(ingredient)\n      if \"workshop\" in kind_name:\n          workshop_type = int(kind_name[-1])\n          break\n\n  # Step 2: Navigate to the required workshop\n  actions_to_take = []\n  workshop_index = env.world.workshop_indices[workshop_type]\n  pos = np.argwhere(env._current_state.grid[:, :, workshop_index])[0]\n\n  target_x, target_y = pos\n  current_x, current_y = env._current_state.pos\n\n  # Move to the x position of the workshop\n  while current_x < target_x:\n      actions_to_take.append(craft.ACTIONS['RIGHT'])\n      current_x += 1\n  while current_x > target_x:\n      actions_to_take.append(craft.ACTIONS['LEFT'])\n      current_x -= 1\n\n  # Move to the y position of the workshop\n  while current_y < target_y:\n      actions_to_take.append(craft.ACTIONS['DOWN'])\n      current_y += 1\n  while current_y > target_y:\n      actions_to_take.append(craft.ACTIONS['UP'])\n      current_y -= 1\n\n  # Step 3: Use the workshop to craft the item\n  actions_to_take.append(craft.ACTIONS['USE'])\n\n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-08-18T18:16:47.642384", "function_name": "craft", "function_body": "  def get_workshop_for_item(world, item_index):\n      workshops = world.workshop_indices\n      recipes = world.cookbook.recipes\n\n      for workshop in workshops:\n          if any(ingredient == workshop for ingredient in recipes[item_index].values()):\n              return workshop\n      return None\n\n  # BFS to find the shortest path to a specified index\n  def bfs_to_target(grid, start_pos, target_index):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = collections.deque([start_pos])\n      visited = set([start_pos])\n      parent = {start_pos: None}\n      \n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          \n          # Check if we have reached the target\n          if grid[x, y, target_index] > 0:\n              path = []\n              while pos != start_pos:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]  # Return reversed path\n          \n          # Explore neighbors\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if (0 <= nx < grid.shape[0] and \n                  0 <= ny < grid.shape[1] and \n                  (nx, ny) not in visited):\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n      \n      return None\n\n  # Convert position change to corresponding action\n  def actions_from_path(current_pos, path):\n      directions_map = {(-1, 0): 0, (1, 0): 1, (0, -1): 2, (0, 1): 3}\n      actions = []\n      \n      for next_pos in path:\n          dx = next_pos[0] - current_pos[0]\n          dy = next_pos[1] - current_pos[1]\n          direction = directions_map.get((dx, dy))\n          if direction is not None:\n              actions.append(direction)\n          current_pos = next_pos\n      \n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_index = get_workshop_for_item(env.world, item_index)\n\n  # Check if we have all the ingredients required for crafting\n  def has_required_primitives(world, item_index):\n      primitives = world.cookbook.recipes.get(item_index, {}).values()\n      current_inventory = world.scenario.grid[world._current_state.pos]\n      \n      return all(current_inventory[p] >= count for p, count in collections.Counter(primitives).items())\n\n  if workshop_index is not None and has_required_primitives(env.world, item_index):\n      scenario = env.scenario\n      start_pos = scenario.init_pos\n      grid = scenario.grid.copy()\n      \n      path_to_workshop = bfs_to_target(grid, start_pos, workshop_index)\n      actions = []\n      \n      if path_to_workshop:\n          actions.extend(actions_from_path(start_pos, path_to_workshop))\n          actions.append(4)  # Append USE action to use the workshop\n          return actions\n      \n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:16:49.867150", "function_name": "craft", "function_body": "  def get_workshop_for_item(world, item_index):\n      workshops = world.workshop_indices\n      recipes = world.cookbook.recipes\n\n      for workshop in workshops:\n          if any(ingredient == workshop for ingredient in recipes[item_index].values()):\n              return workshop\n      return None\n\n  # BFS to find the shortest path to a specified index\n  def bfs_to_target(grid, start_pos, target_index):\n      directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n      queue = collections.deque([start_pos])\n      visited = set([start_pos])\n      parent = {start_pos: None}\n      \n      while queue:\n          pos = queue.popleft()\n          x, y = pos\n          \n          # Check if we have reached the target\n          if grid[x, y, target_index] > 0:\n              path = []\n              while pos != start_pos:\n                  path.append(pos)\n                  pos = parent[pos]\n              return path[::-1]  # Return reversed path\n          \n          # Explore neighbors\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                  queue.append((nx, ny))\n                  visited.add((nx, ny))\n                  parent[(nx, ny)] = pos\n      \n      return None\n\n  # Convert position change to corresponding action\n  def actions_from_path(current_pos, path):\n      directions_map = {(-1, 0): 0, (1, 0): 1, (0, -1): 2, (0, 1): 3}\n      actions = []\n      \n      for next_pos in path:\n          dx = next_pos[0] - current_pos[0]\n          dy = next_pos[1] - current_pos[1]\n          direction = directions_map.get((dx, dy))\n          if direction is not None:\n              actions.append(direction)\n          current_pos = next_pos\n      \n      return actions\n\n  # Find the position of a workshop in the grid\n  def find_workshop_position(grid, workshop_index):\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, workshop_index] > 0:\n                  return (x, y)\n      return None\n\n  item_index = env.world.cookbook.index[item]\n  workshop_index = get_workshop_for_item(env.world, item_index)\n\n  if workshop_index is not None:\n      scenario = env.scenario\n      start_pos = scenario.init_pos\n      grid = scenario.grid.copy()\n      \n      path_to_workshop = bfs_to_target(grid, start_pos, workshop_index)\n      actions = []\n      \n      if path_to_workshop:\n          actions.extend(actions_from_path(start_pos, path_to_workshop))\n          actions.append(4)  # Append USE action to use the workshop\n          return actions\n      \n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T18:17:23.113983", "function_name": "craft", "function_body": "  # Determine the workshop needed for the item\n  def find_workshop_for_item(item_index):\n    cookbook = env.world.cookbook.recipes\n    for output, recipe in cookbook.items():\n      if '_key' not in recipe:\n        continue\n      if recipe['_key'] == item_index:\n        return output\n    raise ValueError(f\"No workshop found for item {item}\")\n\n  # Determine the steps to move towards a workshop\n  def move_to_workshop(workshop_index):\n    workshop_indices = env.world.workshop_indices\n    workshop_pos = np.array([i for i, idx in enumerate(workshop_indices) if idx == workshop_index][0])\n    current_pos = np.array(env._current_state.pos)\n    # Simple pathfinding logic to get from current position to the workshop\n    delta = workshop_pos - current_pos\n    actions = []\n    while not (delta == 0).all():\n      if delta[0] > 0:\n        actions.append(3)  # RIGHT\n        delta[0] -= 1\n      elif delta[0] < 0:\n        actions.append(2)  # LEFT\n        delta[0] += 1\n      if delta[1] > 0:\n        actions.append(1)  # UP\n        delta[1] -= 1\n      elif delta[1] < 0:\n        actions.append(0)  # DOWN\n        delta[1] += 1\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  workshop_index = find_workshop_for_item(item_index)\n  actions_to_workshop = move_to_workshop(workshop_index)\n\n  # Craft the item once at the workshop\n  use_action = 4  # USE\n  actions_to_craft = [use_action]\n\n  return actions_to_workshop + actions_to_craft", "island_id": 1, "scores": {"3": -1}}
