{"timestamp": "2025-08-19T01:16:32.588249", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_pos_list) > 0: # Check if there is any location for the workshop\n      closest_workshop_pos = min(workshop_pos_list, key=lambda pos: np.linalg.norm(pos - pos, ord=2))\n      \n      distance = np.linalg.norm(pos - closest_workshop_pos, ord=2)\n      if distance < min_distance:\n        closest_workshop_idx, min_distance, target_pos = workshop_idx, distance, closest_workshop_pos\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = np.array(target_pos)\n\n  while not np.array_equal(pos, target_pos):\n    dx, dy = target_pos - pos\n    direction = None\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n    else: # Move in the y-direction next\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n    \n    pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T01:17:31.252896", "function_name": "craft", "function_body": "  def find_workshop_position(env, item_index):\n      \"\"\"Finds a position in the grid that contains an entity matching the target index.\"\"\"\n      for workshop_index in env.world.workshop_indices:\n          if any(ingredient == workshop_index for ingredient in env.world.cookbook.recipes[item_index].values()):\n              for y in range(env.scenario.init_grid.shape[0]):\n                  for x in range(env.scenario.init_grid.shape[1]):\n                      if env.scenario.init_grid[y, x, workshop_index] > 0:\n                          return (x, y), workshop_index\n      return None, None\n\n  def navigate_to(env, target_pos):\n      \"\"\"Navigates the agent to a target position on the grid.\"\"\"\n      actions = []\n      current_x, current_y = env._current_state.pos\n\n      while current_x != target_pos[0] or current_y != target_pos[1]:\n          if current_x < target_pos[0]:\n              actions.append(3)  # RIGHT\n              current_x += 1\n          elif current_x > target_pos[0]:\n              actions.append(2)  # LEFT\n              current_x -= 1\n          elif current_y < target_pos[1]:\n              actions.append(1)  # DOWN\n              current_y += 1\n          elif current_y > target_pos[1]:\n              actions.append(0)  # UP\n              current_y -= 1\n\n      return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  target_position, workshop_index = find_workshop_position(env, item_index)\n\n  if target_position is not None:\n      actions = navigate_to(env, target_position)\n      actions.append(4)  # USE action index is 4\n  else:\n      raise ValueError(f\"No suitable workshop found for crafting {item}.\")\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-08-19T01:17:33.525742", "function_name": "craft", "function_body": "  def find_workshop_position(env, target_index):\n      \"\"\"Finds a position in the grid that contains an entity matching the target index.\"\"\"\n      for y in range(env.scenario.init_grid.shape[0]):\n          for x in range(env.scenario.init_grid.shape[1]):\n              if env.scenario.init_grid[y, x, target_index] > 0:\n                  return (x, y)\n      return None\n\n  def navigate_to(env, target_pos):\n      \"\"\"Navigates the agent to a target position using BFS.\"\"\"\n      start_pos = env._current_state.pos\n      directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]  # UP, DOWN, LEFT, RIGHT\n\n      queue = collections.deque([(start_pos, [])])\n      visited = set([start_pos])\n\n      while queue:\n          pos, path = queue.popleft()\n          x, y = pos\n\n          if pos == target_pos:\n              return path\n\n          for dx, dy in directions:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < env.scenario.init_grid.shape[1] and 0 <= ny < env.scenario.init_grid.shape[0]:\n                  if (nx, ny) not in visited:\n                      queue.append(((nx, ny), path + [4 - directions.index((dx, dy))]))\n                      visited.add((nx, ny))\n\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n  found_workshop = False\n\n  # Find a suitable workshop for crafting the item\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes[item_index].values()):\n          target_pos = find_workshop_position(env, idx)\n\n          if target_pos is not None:\n              found_workshop = True\n              break\n\n  if found_workshop:\n      actions.extend(navigate_to(env, target_pos))\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T01:19:47.951980", "function_name": "craft", "function_body": "  def navigate_to_workshop(scenario, target_workshop_index):\n    world = scenario.world\n    grid = scenario.grid.copy()\n    init_pos = scenario.init_pos\n\n    # BFS to find the shortest path to a workshop\n    queue = collections.deque([init_pos])\n    visited = set([init_pos])\n    parent = {init_pos: None}\n    found_workshop = False\n\n    while queue:\n        pos = queue.popleft()\n        x, y = pos\n        if grid[x, y, target_workshop_index] > 0:\n            found_workshop = True\n            break\n        \n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited and grid[nx, ny, world.cookbook.index['BOUNDARY']] == 0:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = pos\n\n    # If workshop is found, reconstruct the path\n    if found_workshop:\n        path = []\n        while pos != init_pos:\n            path.append(pos)\n            pos = parent[pos]\n        path.reverse()\n        return path\n    else:\n        return None\n\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      actions = []\n      if dy < 0: actions.extend([0] * abs(dy))  # UP\n      elif dy > 0: actions.extend([1] * abs(dy))  # DOWN\n      elif dx < 0: actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0: actions.extend([3] * abs(dx))  # RIGHT\n      return actions\n\n  def get_direction_from_difference(dx, dy):\n    \"\"\"Returns the direction based on dx and dy.\"\"\"\n    if dy < 0: return 0  # UP\n    elif dy > 0: return 1  # DOWN\n    elif dx < 0: return 2  # LEFT\n    elif dx > 0: return 3  # RIGHT\n    return None\n\n  def turn_to_direction(current_dir, target_dir):\n      \"\"\"Returns the actions needed to turn from current_dir to target_dir.\"\"\"\n      if (current_dir == 0 and target_dir == 1) or\\\n         (current_dir == 2 and target_dir == 3):\n          return [5]  # Turn right\n      elif (current_dir == 1 and target_dir == 0) or\\\n           (current_dir == 3 and target_dir == 2):\n          return [6]  # Turn left\n      elif current_dir != target_dir:\n          return [7, 7]  # U-turn to turn around if needed\n      return []\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = None\n  for idx in workshop_indices:\n      if any(ingredient == idx for ingredient in env.world.cookbook.recipes.get(item_index, [])):\n          target_workshop_index = idx\n          break\n\n  if target_workshop_index is not None:\n      scenario = env.scenario\n      path = navigate_to_workshop(scenario, target_workshop_index)\n      actions = []\n      current_pos = scenario.init_pos\n      current_dir = 0  # Assuming initial direction is UP (index 0)\n\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n          target_dir = get_direction_from_difference(dx, dy)\n          \n          if target_dir != current_dir:\n              actions.extend(turn_to_direction(current_dir, target_dir))\n              current_dir = target_dir\n\n          actions.extend(actions_to_move(current_pos, next_pos))\n          current_pos = next_pos  # Update position after moving\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T01:19:50.094446", "function_name": "craft", "function_body": "  def navigate_to_workshop(state, target_workshop_index):\n    grid = state.grid.copy()\n    init_pos = state.pos\n    direction = state.dir\n\n    # BFS to find the shortest path to a workshop\n    queue = collections.deque([(init_pos, direction)])\n    visited = set([init_pos])\n    parent = {init_pos: None}\n    found_workshop = False\n\n    while queue:\n      (pos, dir), _ = queue.popleft()\n      x, y = pos\n\n      # Check if the workshop is at the current position\n      if grid[x, y, target_workshop_index] > 0:\n        found_workshop = True\n        break\n      \n      # Explore neighbors\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          if (nx, ny) not in visited:\n            queue.append(((nx, ny), dir))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = ((x, y), dir)\n\n    # If workshop is found, reconstruct the path\n    if found_workshop:\n      path = []\n      while pos != init_pos:\n        path.append(pos)\n        pos, _ = parent[pos]\n      path.reverse()\n      return path\n    else:\n      return None\n\n  def actions_to_move(current_state, next_pos):\n    x1, y1 = current_state.pos\n    x2, y2 = next_pos\n    dx, dy = x2 - x1, y2 - y1\n    \n    # Determine the direction to move\n    if dy < 0: return [0] * abs(dy)  # UP\n    elif dy > 0: return [1] * abs(dy)  # DOWN\n    elif dx < 0: return [2] * abs(dx)  # LEFT\n    elif dx > 0: return [3] * abs(dx)  # RIGHT\n    return []\n\n  def turn_to_direction(current_dir, target_dir):\n    \"\"\"Returns the actions needed to turn from current_dir to target_dir.\"\"\"\n    if (current_dir == 0 and target_dir == 2) or\\\n       (current_dir == 1 and target_dir == 3) or\\\n       (current_dir == 2 and target_dir == 1) or\\\n       (current_dir == 3 and target_dir == 0):\n        return [5]  # Turn right\n    elif (current_dir == 0 and target_dir == 3) or\\\n         (current_dir == 1 and target_dir == 2) or\\\n         (current_dir == 2 and target_dir == 0) or\\\n         (current_dir == 3 and target_dir == 1):\n        return [6]  # Turn left\n    return []\n\n  def get_direction_from_difference(dx, dy):\n    \"\"\"Returns the direction based on dx and dy.\"\"\"\n    if dy < 0: return 0  # UP\n    elif dy > 0: return 1  # DOWN\n    elif dx < 0: return 2  # LEFT\n    elif dx > 0: return 3  # RIGHT\n    return None\n\n  def get_target_workshop_index(item_index, workshop_indices):\n      for idx in workshop_indices:\n          if any(ingredient == idx for ingredient in env.world.cookbook.recipes.get(item_index, {}).values()):\n              return idx\n      return None\n  \n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n\n  # Determine which workshop to use based on the item\n  target_workshop_index = get_target_workshop_index(item_index, workshop_indices)\n\n  if target_workshop_index is not None:\n      state = env._current_state\n      path = navigate_to_workshop(state, target_workshop_index)\n      actions = []\n      current_pos = state.pos\n      current_dir = state.dir\n\n      for next_pos in path:\n          dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n          target_dir = get_direction_from_difference(dx, dy)\n          \n          if target_dir is not None and target_dir != current_dir:\n              actions.extend(turn_to_direction(current_dir, target_dir))\n              current_dir = target_dir\n\n          actions.extend(actions_to_move(state, next_pos))\n          state.pos = next_pos  # Update position after moving\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n      return actions\n  else:\n      return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T01:20:23.351381", "function_name": "craft", "function_body": "  # Get the index of the desired item from the cookbook's index\n  item_index = env.world.cookbook.index.index(item)\n\n  # Check if the item has a recipe in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No crafting recipe for {item}\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[item_index]\n\n  actions = []\n\n  # Determine which workshop is required based on the recipe\n  if \"_key\" in recipe and \"workshop\" in recipe[\"_key\"]:\n    workshop_index_str = recipe[\"_key\"].split(\"_\")[1]\n    workshop_index = int(workshop_index_str)\n    workshop_pos = env.world.workshop_indices[workshop_index]\n\n    # Move to the workshop position\n    actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # 4 corresponds to the USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T01:20:25.608168", "function_name": "craft", "function_body": "  index = env.world.cookbook.index.index(item)\n\n  # Check if the item has a recipe in the cookbook\n  if index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No crafting recipe for {item}\")\n\n  # Get the recipe for the item\n  recipe = env.world.cookbook.recipes[index]\n\n  actions = []\n\n  # Determine which workshop is required based on the recipe\n  if \"_key\" in recipe and \"workshop\" in recipe[\"_key\"]:\n    workshop_index_str = recipe[\"_key\"].split(\"_\")[1]\n    workshop_index = int(workshop_index_str)\n    workshop_pos = env.world.workshop_indices[workshop_index]\n\n    # Move to the workshop position\n    actions.extend(move_to_position(env._current_state.pos, workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(4)  # 4 corresponds to the USE action\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-08-19T01:21:33.157426", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    # Calculate the mean position of all workshops of this type\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_pos_list) > 0:  # Check if there is any location for the workshop\n        workshop_pos_mean = workshop_pos_list.mean(axis=0)\n        distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n        if distance < min_distance:\n            closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Calculate the closest position to move towards\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  nearest_target_pos = None\n  min_nearest_distance = float('inf')\n\n  for target_pos in target_positions:\n      distance = np.linalg.norm(pos - target_pos, ord=2)\n      if distance < min_nearest_distance:\n          nearest_target_pos = target_pos\n          min_nearest_distance = distance\n\n  # Move to the closest workshop position\n  while not np.array_equal(pos, nearest_target_pos):\n    dx, dy = nearest_target_pos - pos\n    \n    # Determine direction to move in\n    if abs(dx) > abs(dy):  # Prioritize moving in x-direction first\n        actions.append(3 if dx > 0 else 2)\n        pos[0] += 1 if dx > 0 else -1\n    else:  # Then move in y-direction\n        actions.append(1 if dy > 0 else 0)\n        pos[1] += 1 if dy > 0 else -1\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 3.7}}
{"timestamp": "2025-08-19T01:21:35.360428", "function_name": "craft", "function_body": "  def move_to_target(target_pos):\n    pos = np.array(env._current_state.pos)\n    actions = []\n\n    while not np.array_equal(pos, target_pos):\n      dx, dy = target_pos - pos\n      direction = None\n\n      if abs(dx) > abs(dy): # Move in the x-direction first\n        if dx > 0:\n          actions.append(3)  # RIGHT\n        else:\n          actions.append(2)  # LEFT\n      else: # Move in the y-direction next\n        if dy > 0:\n          actions.append(1)  # UP\n        else:\n          actions.append(0)  # DOWN\n      \n      pos = np.array([pos[0] + (dx > 0) - (dx < 0), pos[1] + (dy > 0) - (dy < 0)])\n    \n    return actions\n\n  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_pos_list = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_pos_list) > 0: # Check if there is any location for the workshop\n      workshop_pos_mean = workshop_pos_list.mean(axis=0)\n      distance = np.linalg.norm(pos - workshop_pos_mean, ord=2)\n      if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos_list = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n\n  for target_pos in target_pos_list:\n    actions.extend(move_to_target(target_pos))\n    \n    # Use the workshop to craft the item\n    actions.append(4)  # USE\n\n  return actions", "island_id": 8, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T01:22:37.581371", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  current_pos = np.array(env._current_state.pos)\n  closest_workshop_idx, min_distance = None, float('inf')\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) == 0: # Check if there is any location for the workshop\n      continue\n    \n    distances = np.linalg.norm(workshop_positions - current_pos, axis=1)\n    closest_workshop_position = workshop_positions[np.argmin(distances)]\n    distance_to_closest = distances.min()\n    \n    if distance_to_closest < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance_to_closest\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_pos = closest_workshop_position\n\n  while not np.array_equal(current_pos, target_pos):\n    dx, dy = target_pos - current_pos\n    direction = None\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      if dx > 0:\n        actions.append(3)  # RIGHT\n      else:\n        actions.append(2)  # LEFT\n    else: # Move in the y-direction next\n      if dy > 0:\n        actions.append(1)  # UP\n      else:\n        actions.append(0)  # DOWN\n\n    current_pos = np.array([current_pos[0] + (dx > 0) - (dx < 0), current_pos[1] + (dy > 0) - (dy < 0)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
{"timestamp": "2025-08-19T01:22:39.638668", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  current_pos = np.array(env._current_state.pos)\n  min_distance = float('inf')\n  closest_workshop_idx = None\n  \n  for workshop_idx in workshop_indices:\n    positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(positions) == 0: # Check if there are any locations for the workshop\n      continue\n    \n    mean_position = positions.mean(axis=0)\n    distance = np.linalg.norm(current_pos - mean_position, ord=2)\n    \n    if distance < min_distance:\n        closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n  \n  # Calculate the nearest target position from current position\n  target_pos = min(target_positions, key=lambda pos: np.linalg.norm(current_pos - pos))\n\n  while not np.array_equal(current_pos, target_pos):\n    dx, dy = target_pos - current_pos\n\n    if abs(dx) > abs(dy): # Move in the x-direction first\n      actions.append(3 if dx > 0 else 2)\n    else: # Move in the y-direction next\n      actions.append(1 if dy > 0 else 0)\n\n    current_pos += np.array([np.sign(dx), np.sign(dy)])\n\n  # Use the workshop to craft the item\n  actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
