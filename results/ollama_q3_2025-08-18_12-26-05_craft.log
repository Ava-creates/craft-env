{"timestamp": "2025-08-19T00:43:44.327404", "function_name": "craft", "function_body": "  # Assume that item is an index and not the name.\n  cookbook = env.world.cookbook\n  primitives = cookbook.primitives_for(item)\n\n  # List to store actions\n  actions = []\n\n  # Move to the appropriate workshop if necessary\n  for i in range(len(cookbook.workshop_indices)):\n      workshop_index = cookbook.workshop_indices[i]\n      recipe = cookbook.recipes.get(workshop_index)\n      if recipe and item in recipe.values():\n          # If we have a recipe at this workshop that produces the desired item, go to it.\n          actions.extend(move_to_workshop(env, workshop_index))\n          break\n\n  # Craft the item\n  craft_action_index = env.world.cookbook.index[item]\n  actions.append(craft_v0.CRAFT_FUNC(craft_action_index))\n\n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-19T00:43:46.287822", "function_name": "craft", "function_body": "  # Determine if there is a recipe for the given item.\n  index = env.world.cookbook.index[item]\n  if index not in env.world.cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  # Find the required workshop type from the recipe.\n  recipe = env.world.cookbook.recipes[index]\n  workshop_type = None\n  for ingredient, count in recipe.items():\n      if ingredient.startswith(\"_\"):\n          workshop_type = ingredient[1:]\n          break\n\n  if workshop_type is None:\n    raise ValueError(f\"Recipe for {item} does not specify a workshop type.\")\n\n  # Find the nearest workshop of the required type.\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  closest_workshop = find_nearest(grid, pos, getattr(env.world, f\"{workshop_type}_indices\"))\n\n  if closest_workshop is None:\n    raise ValueError(f\"No {workshop_type} workshop found nearby.\")\n\n  # Generate actions to move the agent to the nearest workshop.\n  actions_to_reach_workshop = plan_path(env._current_state.grid, env._current_state.pos, closest_workshop)\n\n  # Append the USE action to craft the item at the workshop.\n  actions_to_craft_item = actions_to_reach_workshop + [craft.USE]\n\n  return actions_to_craft_item", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-19T00:44:44.731478", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_indices):\n    # Logic to find the nearest workshop on the grid from a list of possible workshops\n    min_distance = float('inf')\n    closest_position = None\n    \n    for i_kind in kind_indices:\n      positions = np.argwhere(env._current_state.grid[:, :, i_kind] > 0)\n      if len(positions) == 0:\n        continue\n      \n      # Calculate the Manhattan distance from the agent's current position to each of these positions\n      distances = np.sum(np.abs(positions - env._current_state.pos), axis=1)\n      closest_distance = np.min(distances)\n      \n      if closest_distance < min_distance:\n        min_distance = closest_distance\n        closest_position = tuple(positions[np.argmin(distances)])\n    \n    return closest_position\n\n  def navigate_to_position(target_pos):\n    actions = []\n    target_x, target_y = target_pos\n    \n    while env._current_state.pos != (target_x, target_y):\n      current_x, current_y = env._current_state.pos\n      dx, dy = target_x - current_x, target_y - current_y\n      \n      # Determine the direction to move based on the difference in coordinates\n      if dx > 0:\n        actions.append(craft.RIGHT)\n      elif dx < 0:\n        actions.append(craft.LEFT)\n      elif dy > 0:\n        actions.append(craft.DOWN)\n      elif dy < 0:\n        actions.append(craft.UP)\n      \n      # Move one step in the determined direction\n      env.step(actions[-1])\n    \n    return actions\n\n  def craft_item_at_workshop():\n    return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = env.world.workshop_indices\n  \n  closest_workshop_pos = find_closest_workshop(workshop_kind_indices)\n  \n  actions = []\n  if closest_workshop_pos:\n    actions.extend(navigate_to_position(closest_workshop_pos))\n    actions.extend(craft_item_at_workshop())\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-19T00:44:46.872671", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_indices):\n    # We can use the grid to find the nearest workshop.\n    grid = env._current_state.grid\n    current_pos = env._current_state.pos\n    \n    distances = {}\n    for index in kind_indices:\n      positions = np.argwhere(grid[:, :, index] > 0)\n      if len(positions) == 0:\n        continue\n      # Find the nearest position to the current agent position using Manhattan distance.\n      min_distance = float('inf')\n      closest_position = None\n      for pos in positions:\n        x, y = pos\n        distance = abs(x - current_pos[0]) + abs(y - current_pos[1])\n        if distance < min_distance:\n          min_distance = distance\n          closest_position = (x, y)\n      distances[index] = (closest_position, min_distance)\n    \n    # Return the position of the closest workshop.\n    return min(distances.values(), key=lambda x: x[1])[0] if distances else None\n\n  def navigate_to_position(target_pos):\n    actions = []\n    target_x, target_y = target_pos\n    \n    while env._current_state.pos != (target_x, target_y):\n      current_x, current_y = env._current_state.pos\n      dx, dy = target_x - current_x, target_y - current_y\n      \n      # Determine the direction to move based on the difference in coordinates\n      if abs(dx) > abs(dy):\n        if dx > 0:\n          actions.append(craft.RIGHT)\n        else:\n          actions.append(craft.LEFT)\n      else:\n        if dy > 0:\n          actions.append(craft.DOWN)\n        else:\n          actions.append(craft.UP)\n      \n      # Move one step in the determined direction\n      env.step(actions[-1])\n    \n    return actions\n\n  def craft_item_at_workshop():\n    return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = env.world.workshop_indices\n  \n  closest_workshop_pos = find_closest_workshop(workshop_kind_indices)\n  \n  actions = []\n  if closest_workshop_pos:\n    actions.extend(navigate_to_position(closest_workshop_pos))\n    actions.extend(craft_item_at_workshop())\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-19T00:45:34.251019", "function_name": "craft", "function_body": "  cookbook = env.world.cookbook\n  goal_index = cookbook.index[item]\n\n  if goal_index is None:\n    raise ValueError(\"Unknown item\")\n\n  workshop_indices = env.world.workshop_indices\n\n  actions = []\n\n  # Find the closest workshop that can craft the desired item\n  closest_workshop_idx, min_distance = None, float('inf')\n  pos = np.array(env._current_state.pos)\n\n  for workshop_idx in workshop_indices:\n    workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_idx])\n    \n    if len(workshop_positions) > 0: # Check if there is any location for the workshop\n      for workshop_pos in workshop_positions:\n        distance = np.linalg.norm(pos - workshop_pos, ord=2)\n        if distance < min_distance:\n          closest_workshop_idx, min_distance = workshop_idx, distance\n\n  if closest_workshop_idx is None:\n    raise ValueError(\"No available workshop found\")\n\n  # Move to the closest workshop\n  target_positions = np.argwhere(env._current_state.grid[:, :, closest_workshop_idx])\n\n  for target_pos in target_positions:\n      while not np.array_equal(pos, target_pos):\n          dx, dy = target_pos - pos\n\n          if abs(dx) > abs(dy): # Move in the x-direction first\n              actions.append(3 if dx > 0 else 2)\n          else: # Move in the y-direction next\n              actions.append(1 if dy > 0 else 0)\n\n          pos += np.array([np.sign(dx), np.sign(dy)])\n\n      # Use the workshop to craft the item\n      actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.8999999999999999}}
