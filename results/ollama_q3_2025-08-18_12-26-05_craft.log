{"timestamp": "2025-08-19T02:14:18.908275", "function_name": "craft", "function_body": "  def navigate_to_workshop(current_state, target_workshop_index):\n      grid = current_state.grid.copy()\n      pos = current_state.pos\n      dir = current_state.dir\n\n      # BFS to find the shortest path to a workshop\n      queue = collections.deque([(pos[0], pos[1])])\n      visited = set([(pos[0], pos[1])])\n      parent = {(pos[0], pos[1]): None}\n      found_workshop = False\n\n      while queue:\n          x, y = queue.popleft()\n          if grid[x, y, target_workshop_index] > 0:\n              found_workshop = True\n              break\n          \n          # Explore neighbors\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      queue.append((nx, ny))\n                      visited.add((nx, ny))\n                      parent[(nx, ny)] = (x, y)\n                  \n      # If workshop is found, reconstruct the path\n      if found_workshop:\n          path = []\n          while (x, y) != current_state.pos:\n              path.append((x, y))\n              x, y = parent[(x, y)]\n          path.reverse()\n          return path\n      else:\n          return None\n\n  def actions_to_move(current_pos, next_pos):\n      dx, dy = next_pos[0] - current_pos[0], next_pos[1] - current_pos[1]\n      \n      # Determine the direction to move\n      actions = []\n      if dy < 0: actions.extend([0] * abs(dy))  # UP\n      elif dy > 0: actions.extend([1] * abs(dy))  # DOWN\n      elif dx < 0: actions.extend([2] * abs(dx))  # LEFT\n      elif dx > 0: actions.extend([3] * abs(dx))  # RIGHT\n      return actions\n\n  def get_required_primitives(item_index):\n      cookbook = env.world.cookbook.recipes[item_index]\n      primitives_needed = [ingredient for ingredient in cookbook.values() if ingredient in env.world.workshop_indices]\n      return primitives_needed\n\n  item_index = env.world.cookbook.index[item]\n  workshop_indices = env.world.workshop_indices\n  required_primitives = get_required_primitives(item_index)\n\n  # Determine which workshops to use based on the required primitives\n  target_workshops = [idx for idx in workshop_indices if any(ingredient == idx for ingredient in required_primitives)]\n\n  actions = []\n  for target_workshop_index in target_workshops:\n      current_state = env._current_state\n      path = navigate_to_workshop(current_state, target_workshop_index)\n      if not path:\n          continue\n\n      for next_pos in path:\n          actions.extend(actions_to_move(current_state.pos, next_pos))\n          current_state.pos = next_pos\n\n      # Use the workshop\n      actions.append(4)  # USE action index is 4\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
