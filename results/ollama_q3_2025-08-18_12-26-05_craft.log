{"timestamp": "2025-08-18T14:13:43.826500", "function_name": "craft", "function_body": "  def get_next_move(agent_x, agent_y, target_x, target_y):\n    dx = target_x - agent_x\n    dy = target_y - agent_y\n\n    moves = []\n    if dy < 0:\n        moves.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    elif dy > 0:\n        moves.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n\n    if dx < 0:\n        moves.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    elif dx > 0:\n        moves.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n    \n    return moves\n\n  def is_workshop_nearby(agent_x, agent_y, workshop_pos):\n    workshop_x, workshop_y = workshop_pos\n    return abs(workshop_x - agent_x) <= 1 and abs(workshop_y - agent_y) <= 1\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed to craft this item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  required_workshops = [k for k, v in recipe.items() if isinstance(v, str) and v.startswith(\"_key\")]\n\n  # Assume we have all the primitives needed, move to a workshop\n  actions_to_take = []\n\n  # Move to the first available workshop (assuming there is at least one)\n  if required_workshops:\n      workshop_index_str = required_workshops[0]\n      workshop_type = int(workshop_index_str.replace(\"_key\", \"\"))\n      workshop_pos = env.world.workshop_indices[workshop_type]\n\n      agent_x, agent_y = env._current_state.pos\n\n      # Generate actions to move towards the workshop\n      while not is_workshop_nearby(agent_x, agent_y, workshop_pos):\n          moves = get_next_move(agent_x, agent_y, workshop_pos[0], workshop_pos[1])\n          actions_to_take.extend(moves)\n\n          # Execute the moves and update the agent's position\n          for action in moves:\n              _, done, _ = env.step(action)\n              if done:\n                  return []\n\n          agent_x, agent_y = env._current_state.pos\n\n      # Use the workshop to craft the item\n      actions_to_take.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T14:13:46.184638", "function_name": "craft", "function_body": "  def get_next_move(agent_x, agent_y, target_x, target_y):\n    # Determine the direction to move based on relative position\n    dx = target_x - agent_x\n    dy = target_y - agent_y\n\n    moves = []\n    if dy < 0:\n        moves.extend([env.world.cookbook.index[\"UP\"]] * abs(dy))\n    elif dy > 0:\n        moves.extend([env.world.cookbook.index[\"DOWN\"]] * abs(dy))\n\n    if dx < 0:\n        moves.extend([env.world.cookbook.index[\"LEFT\"]] * abs(dx))\n    elif dx > 0:\n        moves.extend([env.world.cookbook.index[\"RIGHT\"]] * abs(dx))\n    \n    return moves\n\n  def is_workshop_nearby(agent_x, agent_y, workshop_pos):\n    # Check if the workshop is within a 1x1 grid from the agent's position\n    workshop_x, workshop_y = workshop_pos\n    return abs(workshop_x - agent_x) <= 1 and abs(workshop_y - agent_y) <= 1\n\n  def find_workshops(env):\n      # Return positions of all workshops in the world\n      return [env.world.workshop_indices[i] for i in range(len(env.world.workshop_indices))]\n\n  item_index = env.world.cookbook.index[item]\n\n  # Find out which workshop is needed to craft this item\n  recipe = env.world.cookbook.recipes.get(item_index)\n  if not recipe:\n      raise ValueError(f\"No recipe found for {item}\")\n\n  required_workshops = [k for k, v in recipe.items() if isinstance(v, str) and v.startswith(\"_key\")]\n\n  # Assume we have all the primitives needed, move to a workshop\n  actions_to_take = []\n\n  # Find positions of all workshops in the environment\n  all_workshops = find_workshops(env)\n\n  # Move to the first available workshop (assuming there is at least one)\n  if required_workshops:\n      workshop_index_str = required_workshops[0]\n      workshop_type = int(workshop_index_str.replace(\"_key\", \"\"))\n      workshop_pos = env.world.workshop_indices[workshop_type]\n\n      agent_x, agent_y = env._current_state.pos\n\n      # Generate actions to move towards the workshop\n      if not is_workshop_nearby(agent_x, agent_y, workshop_pos):\n          actions_to_take.extend(get_next_move(agent_x, agent_y, workshop_pos[0], workshop_pos[1]))\n\n      # Check if we are already at the workshop or nearby\n      if not is_workshop_nearby(agent_x, agent_y, workshop_pos):\n          raise RuntimeError(\"Failed to move near the workshop\")\n\n      # Use the workshop to craft the item\n      actions_to_take.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T14:14:58.670513", "function_name": "craft", "function_body": "  def go_to_pos(x, y):\n    pos = env._current_state.pos\n    dx, dy = x - pos[0], y - pos[1]\n    \n    actions = []\n    if dy < 0:\n        actions.extend([craft.UP] * abs(dy))\n    elif dy > 0:\n        actions.extend([craft.DOWN] * abs(dy))\n    \n    if dx < 0:\n        actions.extend([craft.LEFT] * abs(dx))\n    elif dx > 0:\n        actions.extend([craft.RIGHT] * abs(dx))\n\n    return actions\n\n  def go_to_workshop(kind_index):\n    # Find the position of the nearest workshop\n    pos = env._current_state.pos\n    grid = env._current_state.grid\n    \n    # Simple BFS to find the nearest workshop\n    queue = collections.deque([(pos[0], pos[1], [])])\n    visited = set()\n    \n    while queue:\n        x, y, path = queue.popleft()\n        \n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n        \n        # Check if this cell contains the workshop we're looking for\n        if grid[x, y, kind_index] > 0:\n            return go_to_pos(x, y) + path\n        \n        # Explore neighbors\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                queue.append((nx, ny, path + [craft.MOVE_FUNC(nx, ny)]))\n    \n    return None\n\n  def craft_item_at_workshop(kind_index):\n      return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = env.world.workshop_indices\n  actions = []\n  \n  for workshop_index in workshop_kind_indices:\n    path_to_workshop = go_to_workshop(workshop_index)\n    if path_to_workshop is not None:\n      actions.extend(path_to_workshop)\n      actions.extend(craft_item_at_workshop(item_index))\n      break\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-08-18T14:15:00.670514", "function_name": "craft", "function_body": "  def find_closest_workshop(kind_index):\n    # Logic to find the nearest workshop on the grid\n    pass\n\n  def go_to_workshop(workshop_pos):\n    # Navigate to the specified workshop position\n    actions = []\n    target_x, target_y = workshop_pos\n    \n    while env._current_state.pos != (target_x, target_y):\n      current_x, current_y = env._current_state.pos\n      dx, dy = target_x - current_x, target_y - current_y\n      \n      # Determine the direction to move based on the difference in coordinates\n      if dx > 0:\n        actions.append(craft.RIGHT)\n      elif dx < 0:\n        actions.append(craft.LEFT)\n      elif dy > 0:\n        actions.append(craft.DOWN)\n      elif dy < 0:\n        actions.append(craft.UP)\n      \n      # Move one step in the determined direction\n      env.step(actions[-1])\n    \n    return actions\n\n  def craft_item_at_workshop(kind_index):\n    # Logic to use the USE action at the correct workshop to craft the item\n    return [craft.USE]\n\n  item_index = env.world.cookbook.index[item]\n  workshop_kind_indices = env.world.workshop_indices\n  \n  closest_workshop_pos = None\n  for workshop_index in workshop_kind_indices:\n    if not closest_workshop_pos or env._current_state.next_to(workshop_index):\n      closest_workshop_pos = find_closest_workshop(workshop_index)\n  \n  actions = []\n  if closest_workshop_pos:\n    actions.extend(go_to_workshop(closest_workshop_pos))\n    actions.extend(craft_item_at_workshop(item_index))\n  \n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T14:16:55.622158", "function_name": "craft", "function_body": "  def calculate_shortest_path(start_pos, end_pos):\n    # Simple BFS to find the shortest path in a grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n      pos = queue.popleft()\n      if pos == end_pos:\n        break\n\n      x, y = pos\n      neighbors = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      for nx, ny in neighbors:\n        if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny, env.world.non_grabbable_indices] == 0:\n            queue.append((nx, ny))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = pos\n\n    # Reconstruct the path\n    path = []\n    current_pos = end_pos\n    while current_pos != start_pos:\n      path.append(current_pos)\n      current_pos = parent[current_pos]\n    path.reverse()\n    return path\n  \n  actions = []\n\n  # Get index of the desired item\n  goal_index = env.world.cookbook.index.get(item)\n  if goal_index is None:\n    raise ValueError(f\"Item '{item}' not found in cookbook.\")\n\n  # Retrieve recipe for the goal item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Check if any workshop is required to craft this item\n  if '_key' in recipe:\n    workshop_key = recipe['_key']\n    workshop_index = env.world.cookbook.index.get(workshop_key)\n    if workshop_index is None:\n      raise ValueError(f\"Workshop '{workshop_key}' not found in cookbook.\")\n\n    # Find the closest workshop that matches the required index\n    closest_workshop_pos = find_closest_workshop(env, workshop_index)\n    \n    if closest_workshop_pos is not None:\n      start_pos = env._current_state.pos\n      path_to_workshop = calculate_shortest_path(start_pos, closest_workshop_pos)\n      \n      # Convert grid positions to actions\n      for x, y in path_to_workshop:\n        dx, dy = x - start_pos[0], y - start_pos[1]\n        if dx == 1: actions.append(3)  # RIGHT\n        elif dx == -1: actions.append(2)  # LEFT\n        elif dy == 1: actions.append(0)  # DOWN\n        elif dy == -1: actions.append(1)  # UP\n        start_pos = (x, y)\n\n      # Use the workshop to craft the item (action index for USE is 4)\n      actions.append(4)\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-18T14:16:57.504025", "function_name": "craft", "function_body": "  def calculate_shortest_path(start_pos, end_pos):\n    # Simple BFS to find the shortest path in a grid\n    queue = collections.deque([start_pos])\n    visited = set()\n    parent = {start_pos: None}\n\n    while queue:\n      pos = queue.popleft()\n      if pos == end_pos:\n        break\n\n      x, y = pos\n      neighbors = [(x+1, y), (x-1, y), (x, y+1), (x, y-1)]\n      for nx, ny in neighbors:\n        if 0 <= nx < env.world.scenario.init_grid.shape[0] and 0 <= ny < env.world.scenario.init_grid.shape[1]:\n          if (nx, ny) not in visited and env._current_state.grid[nx, ny, env.world.non_grabbable_indices] == 0:\n            queue.append((nx, ny))\n            visited.add((nx, ny))\n            parent[(nx, ny)] = pos\n\n    # Reconstruct the path\n    path = []\n    current_pos = end_pos\n    while current_pos != start_pos:\n      path.append(current_pos)\n      current_pos = parent[current_pos]\n    path.reverse()\n    return path\n\n  def move_to_position(start_pos, target_pos):\n    actions = []\n    path = calculate_shortest_path(start_pos, target_pos)\n\n    for x, y in path:\n      dx, dy = x - start_pos[0], y - start_pos[1]\n      if dx == 1: actions.append(3)  # RIGHT\n      elif dx == -1: actions.append(2)  # LEFT\n      elif dy == 1: actions.append(0)  # DOWN\n      elif dy == -1: actions.append(1)  # UP\n      start_pos = (x, y)\n    \n    return actions\n\n  def get_workshop_position(workshop_idx):\n    grid_width = env.world.scenario.init_grid.shape[0]\n    x = workshop_idx // grid_width\n    y = workshop_idx % grid_width\n    return (x, y)\n\n  actions = []\n\n  # Get index of the desired item\n  goal_index = env.world.cookbook.index.get(item)\n  if goal_index is None:\n      print(f\"Item {item} not found in cookbook.\")\n      return actions\n\n  # Retrieve recipe for the goal item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Check if any workshop is required to craft this item\n  if '_key' in recipe:\n    workshop_key = recipe['_key']\n    workshop_index = env.world.cookbook.index.get(workshop_key)\n    if workshop_index is None:\n        print(f\"Workshop {workshop_key} not found in index.\")\n        return actions\n\n    # Get the list of indices for the workshops\n    workshop_indices = [i for i, idx in enumerate(env.world.workshop_indices) if idx == workshop_index]\n    \n    if not workshop_indices:\n        print(f\"No workshops found with index {workshop_index}.\")\n        return actions\n\n  else:\n      print(\"No workshop required to craft this item.\")\n      return actions\n  \n  # Move to a nearby workshop and use it to craft the item\n  for workshop_idx in workshop_indices:\n    start_pos = env._current_state.pos\n    workshop_pos = get_workshop_position(workshop_idx)\n    \n    # Calculate the shortest path to the workshop\n    actions.extend(move_to_position(start_pos, workshop_pos))\n\n    # Use the workshop to craft the item (action index for USE is 4)\n    actions.append(4) \n    break\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-08-18T14:18:56.833247", "function_name": "craft", "function_body": "  def calculate_shortest_path(start, end):\n      # Use BFS to find the shortest path\n      queue = collections.deque([start])\n      visited = set()\n      parent = {start: None}\n\n      while queue:\n          current = queue.popleft()\n          if current == end:\n              break\n          for neighbor in get_neighbors(current):\n              if neighbor not in visited and is_move_valid(neighbor, env._current_state.pos):\n                  visited.add(neighbor)\n                  queue.append(neighbor)\n                  parent[neighbor] = current\n\n      path = []\n      while current is not None:\n          path.append(current)\n          current = parent[current]\n      return path[::-1]\n\n  def get_neighbors(pos):\n      # Get all possible neighbors (up, down, left, right)\n      x, y = pos\n      neighbors = [(x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)]\n      return neighbors\n\n  def is_move_valid(pos, current_pos):\n      # Check if the move to a new position is valid (within bounds and not a boundary)\n      x, y = pos\n      width, height = env._current_state.grid.shape[:2]\n      if x < 0 or x >= width or y < 0 or y >= height:\n          return False\n      # Check for boundaries\n      boundary_index = env.world.cookbook.index.get('BOUNDARY')\n      if env._current_state.grid[x, y, boundary_index] > 0:\n          return False\n      # Optionally check if the move is to a different cell\n      return pos != current_pos\n\n  def directions_from_path(path):\n      # Convert path to list of actions (UP, DOWN, LEFT, RIGHT)\n      dirs = []\n      for i in range(len(path) - 1):\n          start, end = path[i], path[i + 1]\n          dx, dy = end[0] - start[0], end[1] - start[1]\n          if dx == -1:\n              dirs.append('UP')\n          elif dx == 1:\n              dirs.append('DOWN')\n          elif dy == -1:\n              dirs.append('LEFT')\n          elif dy == 1:\n              dirs.append('RIGHT')\n      return dirs\n\n  actions = []\n\n  # Get index of the desired item\n  goal_index = env.world.cookbook.index.index(item)\n\n  # Retrieve recipe for the goal item\n  recipe = env.world.cookbook.recipes[goal_index]\n\n  # Check if any workshop is required to craft this item\n  if '_key' in recipe:\n      workshop_key = recipe['_key']\n      workshop_index = env.world.cookbook.index.get(workshop_key)\n      # Get the list of indices for the workshops\n      workshop_indices = [i for i, idx in enumerate(env.world.workshop_indices) if idx == workshop_index]\n\n  def find_nearest_workshop(current_pos):\n      min_distance = float('inf')\n      closest_workshop = None\n\n      for workshop_idx in workshop_indices:\n          workshop_pos = (env.world.workshop_indices[workshop_idx] // env.world.scenario.init_grid.shape[0], \n                          env.world.workshop_indices[workshop_idx] % env.world.scenario.init_grid.shape[1])\n          distance = np.linalg.norm(np.array(current_pos) - np.array(workshop_pos))\n          \n          if distance < min_distance:\n              min_distance = distance\n              closest_workshop = workshop_pos\n      \n      return closest_workshop\n\n  # Move to the nearest workshop and use it to craft the item\n  if '_key' in recipe:\n    nearest_workshop = find_nearest_workshop(env._current_state.pos)\n    path_to_workshop = calculate_shortest_path(env._current_state.pos, nearest_workshop)\n    actions.extend([env.action_spec()[d] for d in directions_from_path(path_to_workshop)])\n\n    # Use the workshop to craft the item (action index for USE is 4)\n    actions.append(4)\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
