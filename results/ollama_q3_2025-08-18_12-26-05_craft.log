{"timestamp": "2025-08-18T14:01:37.911662", "function_name": "craft", "function_body": "  # Get the index of the desired item\n  item_index = env.world.cookbook.index[item]\n  \n  # Get the primitives required to make the item\n  primitives_needed = env.world.cookbook.primitives_for(item_index)\n  \n  # Initialize actions list\n  actions = []\n  \n  # Define a mapping from kind indices to their corresponding primitive names for easier access\n  index_to_primitive = {v: k for k, v in env.world.cookbook.index.contents.items() if v in primitives_needed}\n\n  # Collect all the required primitives if not already in inventory\n  for prim_index in primitives_needed:\n      # If the primitive is already in inventory, skip to the next one\n      if env._current_state.inventory[prim_index] > 0:\n          continue\n\n      # Find the closest primitive on the grid\n      positions = np.argwhere(env._current_state.grid[:, :, prim_index])\n      \n      if len(positions) == 0:\n          raise ValueError(f\"No {index_to_primitive[prim_index]} found in the environment.\")\n\n      # Choose the first occurrence for simplicity (could be optimized)\n      target_pos = tuple(positions[0])\n\n      # Move to the position of the primitive\n      actions.extend(move_to(env, target_pos))\n\n      # Collect the primitive\n      actions.append(env.action_specs()[env.world.COLLECT_FUNC])\n  \n  # Determine which workshop is needed for crafting\n  if item_index in env.world.workshop_indices:\n      workshop_index = env.world.workshop_indices[0]  # For simplicity, choose the first workshop available\n  else:\n      raise ValueError(f\"No workshop found to craft {item}.\")\n\n  # Move to the nearest workshop and use it\n  positions = np.argwhere(env._current_state.grid[:, :, workshop_index])\n  \n  if len(positions) == 0:\n      raise ValueError(\"No workshop found in the environment.\")\n      \n  target_pos = tuple(positions[0])\n\n  actions.extend(move_to(env, target_pos))\n  actions.append