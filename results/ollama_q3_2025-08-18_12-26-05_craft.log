os[1])\n      elif direction_to_move == \"LEFT\":\n        current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction_to_move == \"DOWN\":\n        current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction_to_move == \"UP\":\n        current_pos = (current_pos[0], current_pos[1] - 1)\n\n    # Use the workshop to craft the item\n    actions.append(env.world.cookbook.index[\"USE\"])\n\n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T16:11:31.072732", "function_name": "craft", "function_body": "  def move_to_position(current_pos, target_pos):\n    actions = []\n    while current_pos != target_pos:\n      direction_to_move = None\n      if current_pos[0] < target_pos[0]:\n          actions.append(env.world.cookbook.index[\"RIGHT\"])\n          direction_to_move = \"RIGHT\"\n      elif current_pos[0] > target_pos[0]:\n          actions.append(env.world.cookbook.index[\"LEFT\"])\n          direction_to_move = \"LEFT\"\n      \n      if current_pos[1] < target_pos[1]:\n          actions.append(env.world.cookbook.index[\"DOWN\"])\n          direction_to_move = \"DOWN\"\n      elif current_pos[1] > target_pos[1]:\n          actions.append(env.world.cookbook.index[\"UP\"])\n          direction_to_move = \"UP\"\n      \n      # Update the current position based on the movement action\n      if direction_to_move == \"RIGHT\":\n          current_pos = (current_pos[0] + 1, current_pos[1])\n      elif direction_to_move == \"LEFT\":\n          current_pos = (current_pos[0] - 1, current_pos[1])\n      elif direction_to_move == \"DOWN\":\n          current_pos = (current_pos[0], current_pos[1] + 1)\n      elif direction_to_move == \"UP\":\n          current_pos = (current_pos[0], current_pos[1] - 1)\n    return actions\n\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if the item can be crafted (i.e., has a recipe)\n  if item_index in env.world.cookbook.recipes:\n    workshop_indices = env.world.workshop_indices\n    \n    # Assume that any workshop can handle crafting for simplicity\n    # In practice, you would need to match workshops with their capabilities\n    workshop_pos = (0, 0)  # Placeholder position for the workshop\n    \n    actions = move_to_position(env._current_state.pos, workshop_pos)\n    \n    # Use the workshop to craft the item\n    actions.append(env.world.cookbook.index[\"USE\"])\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-08-18T16:13:34.796158", "function_name": "craft", "function_body": "  i_item = env.world.cookbook.index[item]\n\n  # Retrieve all primitive ingredients required to make the item\n  primitives_needed = env.world.cookbook.primitives_for(i_item)\n\n  # Initialize a list to hold actions\n  actions = []\n\n  def find_closest_workshop(kind_index):\n    \"\"\"Finds the closest workshop that can produce an item of kind_index.\"\"\"\n    distances = []\n    for w in env.world.workshop_indices:\n      if w == kind_index:\n        workshop_pos = np.argwhere(env._current_state.grid[:, :, w] > 0)\n        if len(workshop_pos) > 0: # Check if there are any workshops\n          closest_workshop = min(workshop_pos, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n          distances.append((w, closest_workshop))\n    return min(distances, key=lambda x: np.linalg.norm(np.array(x[1]) - np.array(env._current_state.pos)), default=None)\n\n  def go_to_workshop(workshop_pos):\n    \"\"\"Navigate to the specified workshop position using BFS.\"\"\"\n    actions = []\n    target_x, target_y = workshop_pos\n    start_x, start_y = env._current_state.pos\n\n    queue = collections.deque([(start_x, start_y, [])])\n    visited = set((start_x, start_y))\n    \n    while queue:\n      current_x, current_y, path = queue.popleft()\n      \n      if (current_x, current_y) == (target_x, target_y):\n        actions.extend(path)\n        break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        new_x, new_y = current_x + dx, current_y + dy\n        if 0 <= new_x < env._current_state.grid.shape[0] and 0 <= new_y < env._current_state.grid.shape[1]:\n          if (new_x, new_y) not in visited:\n            visited.add((new_x, new_y))\n            queue.append((new_x, new_y, path + [get_move_action(dx, dy)]))\n\n    return actions\n\n  def get_move_action(dx, dy):\n      \"\"\"Determine the move action based on the difference in coordinates.\"\"\"\n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      elif dy < 0:\n          return craft.UP\n\n  def craft_item_at_workshop(kind_index):\n    \"\"\"Craft the item at the correct workshop.\"\"\"\n    return [craft.USE]\n\n  closest_workshop = find_closest_workshop(i_item)\n  if closest_workshop:\n    workshop_kind, workshop_pos = closest_workshop\n    actions.extend(go_to_workshop(workshop_pos))\n    actions.extend(craft_item_at_workshop(workshop_kind))\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T16:13:36.846128", "function_name": "craft", "function_body": "  # Retrieve the index of the desired item and its primitives.\n  i_item = env.world.cookbook.index[item]\n  primitives_needed = env.world.cookbook.primitives_for(i_item)\n\n  # Initialize a list to hold actions\n  actions = []\n\n  def find_closest_workshop(kind_index):\n    \"\"\"Finds the closest workshop that can produce an item of kind_index.\"\"\"\n    distances = []\n    for w in env.world.workshop_indices:\n      if w == kind_index:\n        workshop_pos = np.argwhere(env._current_state.grid[:, :, w] > 0)\n        if len(workshop_pos) > 0: # Check if there are any workshops\n          closest_workshop = min(workshop_pos, key=lambda pos: np.linalg.norm(np.array(pos) - np.array(env._current_state.pos)))\n          distances.append((w, closest_workshop))\n    return min(distances, key=lambda x: np.linalg.norm(np.array(x[1]) - np.array(env._current_state.pos)), default=None)\n\n  def go_to_workshop(workshop_pos):\n    \"\"\"Navigate to the specified workshop position.\"\"\"\n    actions = []\n    target_x, target_y = workshop_pos\n    current_x, current_y = env._current_state.pos\n\n    # Use BFS to find the shortest path to the workshop.\n    queue = collections.deque([(current_x, current_y, [])])\n    visited = set()\n    \n    while queue:\n      x, y, path = queue.popleft()\n      \n      if (x, y) == (target_x, target_y):\n        actions.extend(path)\n        break\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < env._current_state.grid.shape[0] and 0 <= ny < env._current_state.grid.shape[1] and (nx, ny) not in visited:\n          visited.add((nx, ny))\n          queue.append((nx, ny, path + [get_move_action(dx, dy)]))\n    \n    return actions\n\n  def get_move_action(dx, dy):\n      \"\"\"Determine the move action based on the difference in coordinates.\"\"\"\n      if dx > 0:\n          return craft.RIGHT\n      elif dx < 0:\n          return craft.LEFT\n      elif dy > 0:\n          return craft.DOWN\n      elif dy < 0:\n          return craft.UP\n\n  def craft_item_at_workshop(kind_index):\n    \"\"\"Craft the item at the correct workshop.\"\"\"\n    return [craft.USE]\n\n  closest_workshop = find_closest_workshop(i_item)\n  if closest_workshop:\n    workshop_kind, workshop_pos = closest_workshop\n    actions.extend(go_to_workshop(workshop_pos))\n    actions.extend(craft_item_at_workshop(workshop_kind))\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T16:14:47.819537", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Find all workshops that can be used to create this item\n  workshop_indices = []\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_indices.extend([i for i in env.world.workshop_indices if i in recipe.keys()])\n  \n  # If no suitable workshops are found, return an empty list\n  if not workshop_indices:\n      return []\n  \n  # Find the nearest workshop based on Manhattan distance\n  current_pos = np.array(env._current_state.pos)\n  nearest_workshop_index = min(workshop_indices, key=lambda i: abs(i[0] - current_pos[0]) + abs(i[1] - current_pos[1]))\n  \n  # Calculate the direction to move towards the nearest workshop\n  target_workshop_pos = nearest_workshop_index\n  dir_x, dir_y = target_workshop_pos[0] - current_pos[0], target_workshop_pos[1] - current_pos[1]\n  \n  # Define actions based on calculated directions\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 2, 3, 4\n  actions = []\n  \n  if dir_y > 0:\n      actions.extend([DOWN] * abs(dir_y))\n  elif dir_y < 0:\n      actions.extend([UP] * abs(dir_y))\n      \n  if dir_x > 0:\n      actions.extend([RIGHT] * abs(dir_x))\n  elif dir_x < 0:\n      actions.extend([LEFT] * abs(dir_x))\n      \n  # Add the USE action to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T16:14:49.799121", "function_name": "craft", "function_body": "  item_index = env.world.cookbook.index[item]\n  \n  # Find all workshops that can be used to create this item\n  workshop_indices = []\n  for output_index, recipe in env.world.cookbook.recipes.items():\n      if \"_key\" in recipe and recipe[\"_key\"] == item_index:\n          workshop_indices.extend([i for i in env.world.workshop_indices if i in recipe.keys()])\n  \n  # If no suitable workshops are found, return an empty list\n  if not workshop_indices:\n      return []\n  \n  # Find the nearest workshop based on Manhattan distance\n  current_pos = np.array(env._current_state.pos)\n  nearest_workshop_index = min(workshop_indices, key=lambda i: abs(i[0] - current_pos[0]) + abs(i[1] - current_pos[1]))\n  \n  # Calculate the direction to move towards the nearest workshop\n  target_workshop_pos = np.array(nearest_workshop_index)\n  dir_x, dir_y = target_workshop_pos[0] - current_pos[0], target_workshop_pos[1] - current_pos[1]\n  \n  # Define actions based on calculated directions\n  UP, DOWN, LEFT, RIGHT, USE = 1, 0, 2, 3, 4\n  actions = []\n  \n  while dir_y > 0:\n      actions.append(DOWN)\n      dir_y -= 1\n  while dir_y < 0:\n      actions.append(UP)\n      dir_y += 1\n      \n  while dir_x > 0:\n      actions.append(RIGHT)\n      dir_x -= 1\n  while dir_x < 0:\n      actions.append(LEFT)\n      dir_x += 1\n      \n  # Add the USE action to craft the item\n  actions.append(USE)\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-08-18T16:15:50.142472", "function_name": "craft", "function_body": "  # Determine the index of the desired item from the name\n  item_index = env.world.cookbook.index[item]\n  \n  # Check if we have a recipe for this item in the cookbook\n  if item_index not in env.world.cookbook.recipes:\n    raise ValueError(\"No recipe found for item: {}\".format(item))\n  \n  # Get the workshop index required to craft this item\n  workshop_index = None\n  recipe = env.world.cookbook.recipes[item_index]\n  for ingredient, count in recipe.items():\n      if ingredient == \"_key\":\n          workshop_index = int(count)\n          break\n  \n  if workshop_index is None:\n    raise ValueError(\"No workshop found for crafting item: {}\".format(item))\n  \n  # Determine the position of the workshop\n  workshops = env.world.workshop_indices\n  if workshop_index >= len(workshops):\n      raise ValueError(\"Invalid workshop index: {}\".format(workshop_index))\n  \n  target_workshop_pos = None\n  grid = env._current_state.grid\n  for i in range(grid.shape[0]):\n      for j in range(grid.shape[1]):\n          if grid[i, j, workshops[workshop_index]] > 0:\n              target_workshop_pos = (i, j)\n              break\n      if target_workshop_pos is not None:\n          break\n  \n  if target_workshop_pos is None:\n      raise ValueError(\"Workshop position not found in the current grid.\")\n  \n  # Determine the direction to face the workshop from the agent's initial position\n  agent_pos = env._current_state.pos\n  dx = target_workshop_pos[0] - agent_pos[0]\n  dy = target_workshop_pos[1] - agent_pos[1]\n  \n  actions = []\n  \n  if dx > 0:\n      actions.extend([craft.CraftLab.UP for _ in range(abs(dx))])\n  elif dx < 0:\n      actions.extend([craft.CraftLab.DOWN for _ in range(abs(dx))])\n      \n  if dy > 0:\n      actions.extend([craft.CraftLab.LEFT for _ in range(abs(dy))])\n  elif dy < 0:\n      actions.extend([craft.CraftLab.RIGHT for _ in range(abs(dy))])\n\n  # Add the USE action to use the workshop\n  actions.append(craft.CraftLab.USE)\n  \n  return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-08-18T16:15:52.562538", "function_name": "craft", "function_body": "  # The index of the goal item in the cookbook\n  goal_index = env.world.cookbook.index[item]\n  \n  # Get a mapping of primitives to counts required to craft one goal\n  primitives_needed = env.world.cookbook.primitives_for(goal_index)\n  \n  actions = []\n  \n  # Collect all needed primitives if not already collected\n  for primitive, count in primitives_needed.items():\n    primitive_name = env.world.cookbook.index.get(primitive)\n    \n    # Actions to collect the required primitives\n    actions.extend(collect(env, primitive_name))\n    \n  # Move to a workshop and craft the item\n  # Assuming there's at least one workshop available (workshop_indices[0])\n  if env.world.workshop_indices:\n      workshop_index = env.world.workshop_indices[0]\n      \n      # Actions to move to the workshop\n      actions.extend(move_to(env, workshop_index))\n      \n      # Action to craft the item\n      actions.append(env.world.cookbook.index[item])  # Assuming USE action is used for crafting\n      \n  return actions", "island_id": 8, "scores": {"3": -1}}
