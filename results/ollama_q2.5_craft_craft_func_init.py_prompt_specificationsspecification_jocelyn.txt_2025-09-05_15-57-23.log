{"timestamp": "2025-09-05T15:58:15.084554", "function_name": "craft", "function_body": "  actions = []\n  cookbook = env.world.cookbook\n  index = cookbook.index\n\n  # Get the index for the desired item\n  item_index = index[item]\n\n  # Find the recipe for the item\n  if item_index not in cookbook.recipes:\n    raise ValueError(f\"No recipe found for {item}\")\n\n  recipe = cookbook.recipes[item_index]\n  workshop_key = \"_key\"  # The key used in recipes to specify the workshop\n\n  # Get the workshop index from the recipe\n  workshop_index = None\n  if workshop_key in recipe:\n      workshop_index = recipe[workshop_key]\n\n  if not workshop_index:\n    raise ValueError(f\"No workshop specified for crafting {item}\")\n\n  # Find the position of the workshop on the grid\n  workshop_positions = np.argwhere(env._current_state.grid[:, :, workshop_index] > 0)\n  if len(workshop_positions) == 0:\n    raise ValueError(f\"Workshop for crafting {item} not found on the grid\")\n\n  # Choose one workshop (first one in this case)\n  target_workshop_pos = tuple(workshop_positions[0])\n\n  # Move to the workshop\n  actions.extend(move_to_position(env, target_workshop_pos))\n\n  # Use the USE action to craft the item at the workshop\n  actions.append(craft.USE)\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-09-05T15:58:16.433752", "function_name": "craft", "function_body": "  actions = []\n  \n  # Get the cookbook and the index for the item\n  cookbook = env.world.cookbook\n  item_index = cookbook.index[item]\n  \n  # Check if we have all required primitives in inventory\n  primitives_needed = cookbook.primitives_for(item_index)\n  current_inventory = env._current_state.inventory\n  \n  # If any primitive is missing, raise an exception or handle accordingly\n  for prim, count in primitives_needed.items():\n    if current_inventory[prim] < count:\n      raise ValueError(f\"Not enough {cookbook.index.get(prim)} to craft {item}.\")\n  \n  # Find the appropriate workshop index for crafting (assuming the recipe specifies \"_key\" as the workshop)\n  workshop_index = cookbook.recipes[item_index][\"_key\"]\n  workshop_indices = env.world.workshop_indices\n  \n  if workshop_index not in workshop_indices:\n    raise ValueError(f\"No suitable workshop found to craft {item}.\")\n  \n  # Find a position next to the workshop\n  grid = env._current_state.grid\n  workshop_pos = None\n  for x in range(grid.shape[0]):\n      for y in range(grid.shape[1]):\n          if np.any(grid[x, y] == workshop_index):\n              workshop_pos = (x, y)\n              break\n      if workshop_pos is not None:\n          break\n  \n  if workshop_pos is None:\n    raise ValueError(f\"No position found next to the workshop for crafting {item}.\")\n  \n  # Move agent to a position next to the workshop\n  current_pos = env._current_state.pos\n  actions.extend(move_to(env, workshop_pos))\n  \n  # Use action to craft the item at the workshop\n  actions.append(env.world.n_actions - 1)  # Assuming USE is the last action\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
