{"timestamp": "2025-07-28T12:39:36.373745", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n\n  # 1. Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  start_state = env._current_state\n  \n  # 2. Find all locations of the primitive on the initial grid\n  # The grid configuration remains static for movement actions.\n  raw_primitive_locations = np.argwhere(start_state.grid[:, :, primitive_id] > 0)\n\n  if len(raw_primitive_locations) == 0:\n    # Primitive does not exist in the environment\n    return []\n\n  # Calculate all \"target neighborhood\" cells. These are the cells from which the\n  # agent can successfully use (collect) the primitive, i.e., cells within a 3x3\n  # neighborhood of any primitive instance.\n  target_neighborhood_cells = set()\n  WIDTH, HEIGHT, _ = start_state.grid.shape\n  for px, py in raw_primitive_locations:\n    for dx in [-1, 0, 1]:\n      for dy in [-1, 0, 1]:\n        nx, ny = px + dx, py + dy\n        # Ensure the cell is within grid boundaries\n        if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n          target_neighborhood_cells.add((nx, ny))\n\n  if len(target_neighborhood_cells) == 0:\n    # This scenario should generally not happen if raw_primitive_locations is not empty,\n    # unless grid dimensions are unusually small.\n    return []\n\n  # Define heuristic function for A* search.\n  # This heuristic estimates the minimum number of moves (Manhattan distance)\n  # from the current agent position to any cell in the `target_neighborhood_cells`.\n  # This heuristic is admissible because it never overestimates the actual cost\n  # (each move reduces Manhattan distance by at most 1).\n  def _heuristic(pos, targets):\n    if not targets:\n      return float('inf') \n\n    min_dist = float('inf')\n    for tx, ty in targets:\n      dist = abs(pos[0] - tx) + abs(pos[1] - ty)\n      min_dist = min(min_dist, dist)\n    return min_dist\n\n  # A* Data Structures\n  # open_set: Priority queue (min-heap) storing tuples of (f_score, state_identifier, craft_state_object).\n  # f_score is g_score + h_score, and is used for prioritization.\n  open_set = [] \n  \n  # g_scores: Dictionary mapping state_identifier (agent_pos, agent_dir) to the\n  # lowest cost (number of moves) found so far to reach that state from the start.\n  g_scores = {} \n  \n  # came_from: Dictionary mapping state_identifier to (previous_state_identifier, action_taken_to_reach_current).\n  # Used for reconstructing the path once the goal is reached.\n  came_from = {} \n\n  # Initialize A* with the start state\n  start_identifier = (start_state.pos, start_state.dir)\n  g_scores[start_identifier] = 0\n  \n  initial_h_score = _heuristic(start_state.pos, target_neighborhood_cells)\n  initial_f_score = g_scores[start_identifier] + initial_h_score\n\n  heapq.heappush(open_set, (initial_f_score, start_identifier, start_state))\n\n  # A* search loop\n  while open_set:\n    # Pop the state with the lowest f_score from the priority queue\n    current_f_score, current_identifier, current_state = heapq.heappop(open_set)\n    current_pos, current_dir = current_identifier\n\n    # If we have already found a shorter path to this state, skip this older entry.\n    # This handles cases where a state is pushed multiple times to the heap before being processed.\n    if current_f_score > g_scores.get(current_identifier, float('inf')) + _heuristic(current_pos, target_neighborhood_cells):\n        continue\n\n    # Check if the goal is met: is the primitive in the agent's 3x3 neighborhood?\n    # This uses the specific `next_to` method of CraftState, which defines the goal condition.\n    if current_state.next_to(primitive_id):\n      # Goal reached! Reconstruct the path from `came_from`.\n      path = []\n      node = current_identifier\n      while node in came_from:\n        prev_node, action = came_from[node]\n        path.append(action)\n        node = prev_node\n      \n      path.reverse() # Path is built in reverse, so reverse it to get correct order.\n      \n      # Append the USE action, as the agent is now adjacent to the primitive.\n      return path + [USE]\n\n    # Explore valid movement actions from the current state\n    for action in MOVE_ACTIONS:\n      # Simulate the step to get the next state. CraftState.step creates a new state object.\n      _reward, neighbor_state = current_state.step(action) \n      \n      neighbor_identifier = (neighbor_state.pos, neighbor_state.dir)\n      \n      # Calculate the cost to reach this neighbor state from the start\n      tentative_g_score = g_scores[current_identifier] + 1 # Each move costs 1\n\n      # If this new path to the neighbor is shorter than any previously found path, or if it's new\n      if neighbor_identifier not in g_scores or tentative_g_score < g_scores[neighbor_identifier]:\n        came_from[neighbor_identifier] = (current_identifier, action)\n        g_scores[neighbor_identifier] = tentative_g_score\n        \n        # Calculate f_score for the neighbor\n        h_score = _heuristic(neighbor_state.pos, target_neighborhood_cells)\n        f_score = tentative_g_score + h_score\n        \n        # Push the neighbor to the priority queue\n        heapq.heappush(open_set, (f_score, neighbor_identifier, neighbor_state))\n\n  # If the open_set becomes empty and the goal was never reached, it means the primitive is unreachable.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:40:24.597314", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Map action IDs to (dr, dc) for pathfinding\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Retrieve primitive ID; assumes primitive is a valid name that exists in the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get relevant indices from the world configuration\n  non_grabbable_indices = env.world.non_grabbable_indices # This is already a set\n  workshop_indices = set(env.world.workshop_indices) # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to determine if a given cell is blocked for movement.\n  # A cell is blocked if it contains *any* non-grabbable item (e.g., water, stone, workshops).\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if out of bounds\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Get IDs of all items present at the current cell\n      cell_contents = np.where(grid[r, c, :] > 0)[0] \n      \n      # A cell is blocked for movement if it contains any non-grabbable item.\n      # This ensures the agent does not path onto workshops, water, or stone.\n      for k_idx in cell_contents:\n          if k_idx in non_grabbable_indices:\n              return True\n      return False\n      \n  # --- Define Target Positions for BFS ---\n  # These are the cells the agent needs to reach to interact with the primitive.\n  potential_target_positions = set()\n  \n  # Find all locations on the grid where the target primitive exists.\n  # np.argwhere returns (row, col) pairs where the condition is true.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n\n  if is_workshop_primitive:\n      # If the primitive is a workshop, the agent needs to move to a cell *adjacent* to it.\n      for wr, wc in primitive_locations_on_grid:\n          for dr, dc in action_deltas.values(): # Iterate over (dr, dc) for cardinal neighbors\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      for r, c in primitive_locations_on_grid:\n          current_cell_pos = (r, c)\n          # Only consider it a target if the cell itself is not blocked for movement.\n          # This filters out resources that might be in impassable terrain (e.g., wood on water).\n          if not is_blocked_for_movement(current_cell_pos):\n              potential_target_positions.add(current_cell_pos)\n\n  if not potential_target_positions:\n      # The primitive (or a valid adjacent spot for a workshop) was not found on the map,\n      # or all instances are in blocked locations.\n      return []\n\n  # --- BFS to find the shortest path to any target position ---\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to store visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in potential_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not visited and not blocked), add it to the queue\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path was found, append the 'USE' action to collect/interact with the primitive.\n      # The 'USE' action (ID 4) is applied after reaching the target position.\n      actions = best_path + [4] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:40:26.685328", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"\n  Returns a list of actions to find and collect/interact with the primitive\n  passed in the function in the passed env.\n  This version distinguishes between grabbable resources (move onto) and\n  workshops (move next to), ensuring appropriate pathfinding for each.\n  It also uses a more direct and often more efficient check for blocked cells for movement.\n  \"\"\"\n  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Map action IDs to (dr, dc) for pathfinding\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Retrieve primitive ID; assumes primitive is a valid name that exists in the cookbook index.\n  # The DSL ensures 'primitive' comes from a predefined list, so this lookup should be safe.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get relevant indices from the world configuration\n  non_grabbable_indices = env.world.non_grabbable_indices # This is already a set\n  workshop_indices = set(env.world.workshop_indices) # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop (requires being adjacent to use)\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to determine if a given cell is blocked for movement.\n  # A cell is blocked if it is out of bounds or contains *any* non-grabbable item\n  # (e.g., water, stone, workshops).\n  # This implementation iterates directly over known non-grabbable indices, which can be\n  # more efficient than `v1`'s `np.where` for sparse grid contents or when `non_grabbable_indices`\n  # is much smaller than `n_kinds`.\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # 1. Check if the position is out of grid bounds.\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # 2. Check if the cell contains any non-grabbable entity.\n      # Iterate through the *known* non-grabbable kind IDs.\n      for k_idx in non_grabbable_indices:\n          # If this specific non-grabbable kind is present at the position (count > 0),\n          # then the cell is blocked for agent movement.\n          if grid[r, c, k_idx] > 0:\n              return True\n      return False\n      \n  # --- Define Target Positions for BFS ---\n  # These are the cells the agent needs to reach to interact with the primitive.\n  potential_target_positions = set()\n  \n  if is_workshop_primitive:\n      # If the primitive is a workshop, the agent needs to move to a cell *adjacent* to it.\n      # First, find all grid locations where this specific workshop type exists.\n      workshop_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      # For each workshop location, identify its valid, unblocked neighbors.\n      for wr, wc in workshop_locations_on_grid:\n          for dr, dc in action_deltas.values(): # Iterate over (dr, dc) for cardinal neighbors\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              # (i.e., it doesn't contain water, stone, or another workshop).\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      # Iterate through the entire grid to find instances of the primitive.\n      for r in range(rows):\n          for c in range(cols):\n              if grid[r, c, primitive_id] > 0: # If the primitive is present at (r, c)\n                  current_cell_pos = (r, c)\n                  # Only consider it a target if the cell itself is not blocked for movement\n                  # by other non-grabbable items (e.g., wood on water is not reachable).\n                  # The resource itself (e.g., WOOD) is grabbable, so it won't block movement onto it.\n                  if not is_blocked_for_movement(current_cell_pos):\n                      potential_target_positions.add(current_cell_pos)\n\n  # If no reachable target positions are found, return an empty action list.\n  if not potential_target_positions:\n      return []\n\n  # --- BFS to find the shortest path to any target position ---\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to store visited positions to avoid cycles and redundant exploration, ensuring shortest path.\n  visited = {start_pos}\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in potential_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (within bounds, not previously visited, and not blocked),\n          # add it to the queue for further exploration.\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path was found, append the 'USE' action to collect/interact with the primitive.\n      # The 'USE' action (ID 4) is applied after reaching the target position.\n      actions = best_path + [4] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:41:22.690855", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:41:24.724651", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive.upper()]\n  if i_primitive is None:\n      # Primitive name not found in the cookbook index\n      return [] \n\n  # Ensure the primitive is grabbable. 'collect' implies adding to inventory.\n  # Non-grabbable entities (like workshops, water, boundaries) cannot be collected.\n  if i_primitive in env.world.non_grabbable_indices:\n      return []\n\n  # Get action integer mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  MOVE_ACTIONS = [\n      ACTION_UP,\n      ACTION_DOWN,\n      ACTION_LEFT,\n      ACTION_RIGHT\n  ]\n\n  # Delta Row/Col based on agent's direction:\n  # CraftState.dir maps to (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT)\n  DR_FOR_DIR = [-1, 0, 1, 0] # Delta row for agent facing UP, RIGHT, DOWN, LEFT respectively\n  DC_FOR_DIR = [0, 1, 0, -1] # Delta col for agent facing UP, RIGHT, DOWN, LEFT respectively\n\n  # Initialize BFS\n  start_state = env._current_state\n  # The queue stores CraftState objects, allowing full state transitions via .step()\n  queue = collections.deque([start_state])\n  \n  # The 'visited' dictionary maps (row, col, direction) tuples to \n  # (parent_row, parent_col, parent_direction, action_taken_from_parent)\n  # This enables efficient path reconstruction by backtracking.\n  start_key = (start_state.pos[0], start_state.pos[1], start_state.dir)\n  visited = {start_key: None} # None indicates the start node has no parent\n\n  # Variable to store the key of the state from which the 'USE' action can be performed.\n  # This is the target state we are searching for in the BFS.\n  target_state_key = None \n\n  # Get grid dimensions for boundary checks when calculating the 'front' cell.\n  HEIGHT, WIDTH, _ = start_state.grid.shape\n\n  # Perform Breadth-First Search\n  while queue:\n    current_state = queue.popleft()\n    current_key = (current_state.pos[0], current_state.pos[1], current_state.dir)\n    \n    # --- Goal Check: Can we collect the primitive from the current_state? ---\n    # Calculate the coordinates of the cell directly in front of the agent.\n    facing_dir = current_state.dir\n    front_r = current_state.pos[0] + DR_FOR_DIR[facing_dir]\n    front_c = current_state.pos[1] + DC_FOR_DIR[facing_dir]\n\n    # Check if the calculated 'front' cell is within grid boundaries\n    # and if it contains the desired primitive (grid value > 0 for that kind).\n    if (0 <= front_r < HEIGHT and 0 <= front_c < WIDTH and\n        current_state.grid[front_r, front_c, i_primitive] > 0):\n        # Found the shortest sequence of movements to reach a state\n        # where the primitive is directly in front.\n        target_state_key = current_key\n        break # Exit BFS loop as the shortest path to the goal state is found\n\n    # --- Explore Possible Next States (Movement Actions) ---\n    # For each possible movement action (UP, DOWN, LEFT, RIGHT)\n    for action in MOVE_ACTIONS:\n      # Simulate the action using the CraftState's step method.\n      # This method returns a *new* CraftState instance, which correctly reflects\n      # updated grid, position, direction, and handles environment physics (e.g., obstacles).\n      _, new_state = current_state.step(action) \n      \n      # The key for the 'visited' set must include position and direction,\n      # as different directions at the same position can lead to different outcomes for 'USE'\n      # or subsequent movements.\n      new_state_key = (new_state.pos[0], new_state.pos[1], new_state.dir)\n      \n      # Only add to queue if this new state (position + direction) has not been visited before.\n      # This prevents redundant computations and infinite loops.\n      if new_state_key not in visited:\n        # Store the parent key and the action taken to reach this new state.\n        visited[new_state_key] = (current_key, action) \n        queue.append(new_state)\n            \n  # --- Path Reconstruction ---\n  if target_state_key is None:\n      # If the queue became empty and no path to collect the primitive was found,\n      # it means the primitive is unreachable or not present.\n      return []\n  else:\n      # Reconstruct the path by backtracking from the target_state_key to the start_key.\n      path = []\n      current_reconstruct_key = target_state_key\n      while visited[current_reconstruct_key] is not None:\n          # Get the parent key and the action that led from parent to current_reconstruct_key.\n          parent_key, action_taken = visited[current_reconstruct_key]\n          path.append(action_taken)\n          current_reconstruct_key = parent_key\n      \n      # The path is built in reverse order (from goal to start), so reverse it.\n      path.reverse()\n      \n      # Append the final 'USE' action to the sequence of movement actions.\n      path.append(ACTION_USE)\n      return path", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:42:22.719510", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['RIGHT']\n  RIGHT = action_map['LEFT'] # Corrected from `LEFT` to `RIGHT` (typo in original example, assuming standard direction mapping)\n  USE = action_map['USE']\n\n  # Note: Correcting the LEFT/RIGHT mapping for standard convention if it was a typo in the original\n  # Assuming standard mapping:\n  # UP = 1 (North)\n  # DOWN = 0 (South)\n  # LEFT = 3 (West)\n  # RIGHT = 2 (East)\n  # The problem statement for `action_specs` indicates a dict mapping DOWN->0, UP->1, LEFT->2, RIGHT->3, USE->4\n  # Let's use the explicit values from `action_map` to be safe.\n  # So, `LEFT = action_map['LEFT']` and `RIGHT = action_map['RIGHT']` are correct as given.\n  \n  MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  # Determine if the primitive is grabbable (can be collected with USE action)\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # Find all locations of the primitive on the initial grid for the heuristic\n  start_state = env._current_state\n  initial_grid = start_state.grid\n  grid_width, grid_height, _ = initial_grid.shape\n  primitive_locations = []\n  for x in range(grid_width):\n    for y in range(grid_height):\n      if initial_grid[x, y, primitive_id] == 1:\n        primitive_locations.append((x, y))\n\n  # If the primitive is not found on the grid, it's unreachable for collection.\n  if not primitive_locations:\n      return []\n\n  # Heuristic function: Manhattan distance from current position to the closest primitive location\n  def heuristic(pos):\n      return min(abs(pos[0] - px) + abs(pos[1] - py) for px, py in primitive_locations)\n\n  # A* search setup\n  # g_scores: dictionary mapping (position_tuple, direction_int) -> min_cost_to_reach_that_state\n  g_scores = {(start_state.pos, start_state.dir): 0}\n  \n  # Priority queue: (f_score, g_score, current_pos_tuple, current_dir_int, path_so_far_list)\n  # f_score = g_score + h_score\n  pq = [(heuristic(start_state.pos), 0, start_state.pos, start_state.dir, [])]\n\n  # References to unchanging components of the state to avoid repeated lookups or deep copies\n  scenario_ref = start_state.scenario \n  grid_ref = start_state.grid\n  n_kinds = env.world.n_kinds # Needed for initializing dummy inventory\n\n  while pq:\n    f_score, g_score, current_pos, current_dir, path_so_far = heapq.heappop(pq)\n\n    # If we have already found a shorter path to this state (pos, dir), skip this one\n    if g_score > g_scores.get((current_pos, current_dir), float('inf')):\n        continue\n    \n    # Create a temporary CraftState object for the current (pos, dir) to utilize CraftState methods\n    # The inventory is set to zeros as it's not relevant for pathfinding through movement.\n    # The grid and scenario are referenced, not copied, assuming CraftState.step handles this efficiently for movement.\n    temp_craft_state = CraftState(scenario=scenario_ref, \n                                  grid=grid_ref, \n                                  pos=current_pos, \n                                  dir=current_dir, \n                                  inventory=np.zeros(n_kinds, dtype=int))\n\n    # Check if the current position is adjacent to the primitive\n    if temp_craft_state.next_to(primitive_id):\n        final_actions = path_so_far\n        if is_grabbable:\n            final_actions.append(USE) # Add USE action if the primitive can be collected\n        return final_actions\n\n    # Explore valid movement actions from the current state\n    for action in MOVE_ACTIONS:\n      # Simulate the action to get the next state (pos and dir)\n      # CraftState.step returns a new CraftState instance.\n      _reward, next_craft_state = temp_craft_state.step(action)\n      \n      next_pos = next_craft_state.pos\n      next_dir = next_craft_state.dir\n      new_g_score = g_score + 1 # Each movement action costs 1\n\n      # If this new path to (next_pos, next_dir) is shorter, or this is the first time reaching it\n      if new_g_score < g_scores.get((next_pos, next_dir), float('inf')):\n        g_scores[(next_pos, next_dir)] = new_g_score\n        new_f_score = new_g_score + heuristic(next_pos)\n        heapq.heappush(pq, (new_f_score, new_g_score, next_pos, next_dir, path_so_far + [action]))\n\n  # If the priority queue is exhausted and no path was found (primitive is unreachable)\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:42:24.722672", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  start_state = env._current_state\n\n  # Improvement for collect_v2:\n  # If the primitive is already in the agent's inventory,\n  # it has already been 'collected', so no actions are needed.\n  if start_state.inventory[primitive_id] > 0:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  # Initialize BFS\n  # The queue stores tuples of (current_craft_state, list_of_actions_taken_to_reach_this_state)\n  # The visited set stores (agent_position, agent_direction) to avoid cycles and redundant exploration.\n  # We use (pos, dir) as the unique state identifier for the agent, as the grid remains static for movement actions.\n  queue = collections.deque([(start_state, [])])\n  visited = {(start_state.pos, start_state.dir)}\n\n  # BFS loop\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # Check if the current state satisfies the goal: is the primitive in the agent's 3x3 neighborhood?\n    if current_state.next_to(primitive_id):\n      # If yes, we have found a path to a position adjacent to the primitive.\n      # Append the USE action to interact with and potentially collect the primitive.\n      return path_so_far + [USE]\n\n    # If not, explore possible movement actions from the current state\n    for action in MOVE_ACTIONS:\n      # Simulate the step using the CraftState's step method.\n      # CraftState.step returns a *new* CraftState object, which is crucial for BFS.\n      # The reward is not relevant for pathfinding here.\n      _reward, next_state_candidate = current_state.step(action)\n\n      next_pos = next_state_candidate.pos\n      next_dir = next_state_candidate.dir\n      next_state_identifier = (next_pos, next_dir)\n\n      # If this next state (position and direction) has not been visited before, add it to the queue\n      if next_state_identifier not in visited:\n        visited.add(next_state_identifier)\n        queue.append((next_state_candidate, path_so_far + [action]))\n\n  # If the queue becomes empty and no path was found (i.e., the primitive is unreachable), return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:43:13.860650", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:43:15.798269", "function_name": "collect", "function_body": "  import collections # Required for deque for BFS\n\n  # 1. Initialize action IDs from environment's action_specs for robustness.\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  actions = [] # List to store the sequence of actions to be returned\n\n  # 2. Get the integer ID for the primitive from the cookbook's index.\n  # The DSL uses uppercase names (e.g., 'WOOD'), but the cookbook index\n  # might store them as lowercase (e.g., 'wood'). We follow the convention\n  # set by collect_v0 and assume lowercase lookup.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n\n  # 3. Early exit: If the primitive is a grabbable item and already in inventory, no actions are needed.\n  if primitive_id in env.world.grabbable_indices:\n      current_obs = env.observations()\n      inventory = current_obs['features_dict']['inventory']\n      if inventory[primitive_id] > 0: # Check if count in inventory is greater than 0\n          return [] # Already collected, return an empty list of actions\n\n  # 4. Get current state information required for pathfinding.\n  current_obs = env.observations()\n  # Agent's current (x, y) position. Convert numpy array to tuple for hashability (needed for 'visited' set).\n  current_pos = tuple(current_obs['features_dict']['pos'])\n  grid = current_obs['features_dict']['features_global'] # Full grid layout for pathfinding\n\n  # Determine grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Map movement differentials (dx, dy) to corresponding action IDs.\n  move_deltas_to_action_id = {\n      (0, -1): ACTION_UP,    # Moving up means y-coordinate decreases\n      (0, 1): ACTION_DOWN,   # Moving down means y-coordinate increases\n      (-1, 0): ACTION_LEFT,  # Moving left means x-coordinate decreases\n      (1, 0): ACTION_RIGHT,  # Moving right means x-coordinate increases\n  }\n\n  # Identify impassable terrain types based on common game conventions.\n  # We assume 'boundary', 'water', and 'stone' are generally obstacles.\n  # Workshops are typically traversable locations.\n  impassable_kind_ids = set()\n  cookbook_index = env.world.cookbook.index\n  for kind_name in [\"boundary\", \"water\", \"stone\"]:\n      try:\n          impassable_kind_ids.add(cookbook_index[kind_name])\n      except KeyError:\n          # If a specific kind name is not in the cookbook index, it's not present in this environment,\n          # so we don't need to consider it as an obstacle.\n          pass\n\n  # 5. Initialize BFS components.\n  # Queue stores tuples of (current_agent_position, path_taken_to_reach_here).\n  queue = collections.deque([(current_pos, [current_pos])])\n\n  # Set to keep track of visited coordinates to prevent infinite loops and redundant exploration.\n  visited = {current_pos}\n\n  found_path_to_primitive_area = None # This will store the optimal path of agent positions\n\n  # 6. BFS Loop: Find the shortest path to a cell from which the primitive can be 'used'.\n  while queue:\n      (current_x, current_y), path_so_far = queue.popleft() # Dequeue current position and its path\n\n      # Check the 3x3 neighborhood around the current agent position (current_x, current_y).\n      # The 'USE' action operates on this neighborhood, so we need to reach a cell adjacent to the primitive.\n      primitive_reachable_from_current_pos = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n\n              # Ensure the neighbor cell is within grid boundaries.\n              if not (0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT):\n                  continue\n\n              # Check if the target primitive is present in this neighbor cell.\n              if grid[neighbor_x, neighbor_y, primitive_id] > 0:\n                  primitive_reachable_from_current_pos = True\n                  break # Primitive found nearby, no need to check other cells in this neighborhood\n          if primitive_reachable_from_current_pos:\n              break # Found it, exit outer offset loop to process this path\n\n      # If the primitive is found in the 3x3 neighborhood of the current agent position,\n      # then this path_so_far leads to a valid 'USE' location. This is the shortest such path due to BFS.\n      if primitive_reachable_from_current_pos:\n          found_path_to_primitive_area = path_so_far\n          break # Path found, exit the main BFS loop\n\n      # If the primitive is not yet found nearby, explore valid adjacent cells for agent movement.\n      # Consider all four cardinal directions (UP, DOWN, LEFT, RIGHT).\n      for dx, dy in move_deltas_to_action_id.keys():\n          next_agent_x, next_agent_y = current_x + dx, current_y + dy\n          next_pos_tuple = (next_agent_x, next_agent_y)\n\n          # Check if the next agent position is within grid boundaries.\n          if not (0 <= next_agent_x < WIDTH and 0 <= next_agent_y < HEIGHT):\n              continue\n\n          # Check for impassable obstacles in the next cell.\n          is_impassable_cell = False\n          for kind_id in impassable_kind_ids:\n              if grid[next_agent_x, next_agent_y, kind_id] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n               continue # This cell is blocked for movement, so skip it.\n\n          # If the next cell is traversable and has not been visited yet, add it to the queue.\n          if next_pos_tuple not in visited:\n              visited.add(next_pos_tuple)\n              queue.append((next_pos_tuple, path_so_far + [next_pos_tuple]))\n\n  # 7. Convert the found path (sequence of coordinates) into a list of agent actions.\n  if found_path_to_primitive_area:\n      # Iterate through the path, reconstructing movement actions.\n      # We iterate up to the second-to-last element, as each action connects two points.\n      for i in range(len(found_path_to_primitive_area) - 1):\n          # Current and next agent positions in the path\n          from_x, from_y = found_path_to_primitive_area[i]\n          to_x, to_y = found_path_to_primitive_area[i+1]\n\n          # Calculate the relative movement (change in x, change in y)\n          delta_x = to_x - from_x\n          delta_y = to_y - from_y\n\n          # Append the corresponding action ID using the pre-defined map.\n          actions.append(move_deltas_to_action_id[(delta_x, delta_y)])\n\n      # After all movements are completed, the agent is in the optimal position to 'USE' the primitive.\n      actions.append(ACTION_USE)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:44:02.975605", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Dynamically retrieve action IDs from the environment's action_specs\n  action_map = env.action_specs()\n  action_deltas = {\n      action_map[\"UP\"]: (-1, 0),\n      action_map[\"DOWN\"]: (1, 0),\n      action_map[\"LEFT\"]: (0, -1),\n      action_map[\"RIGHT\"]: (0, 1)\n  }\n  USE_ACTION_ID = action_map[\"USE\"]\n  \n  rows, cols, _ = grid.shape\n\n  # Get the ID for the primitive we are trying to collect.\n  # This ID refers to the *name* of the item we want to obtain (e.g., \"WOOD\", \"STONE\").\n  primitive_item_id = env.world.cookbook.index[primitive]\n\n  # Determine the actual entity ID on the grid that needs to be interacted with\n  # and the type of interaction (on-tile or adjacent).\n  target_entity_id_on_grid = None\n  interact_adjacent = False\n\n  # Identify special entities from CraftWorld (sources/obstacles)\n  water_id = env.world.water_index\n  stone_source_id = env.world.stone_index # This is the ID for the 'stone' entity that acts as a source/obstacle\n  boundary_id = env.world.cookbook.index[\"BOUNDARY\"] # Get boundary ID for explicit blocking\n\n  # Logic to map DSL primitive to grid entity and interaction type:\n  # 1. If the primitive is a workshop, interact by moving onto it.\n  if primitive_item_id in env.world.workshop_indices:\n      target_entity_id_on_grid = primitive_item_id\n      interact_adjacent = False \n  # 2. If the primitive is \"STONE\", assume its source is the special 'stone_index' entity,\n  #    and collection happens from an adjacent tile.\n  elif primitive == \"STONE\":\n      target_entity_id_on_grid = stone_source_id\n      interact_adjacent = True \n  # 3. For other primitives (WOOD, IRON, GRASS, etc.), assume the primitive name\n  #    directly corresponds to an interactable entity on the grid, and it's collected\n  #    by moving onto its tile.\n  else:\n      target_entity_id_on_grid = primitive_item_id\n      interact_adjacent = False\n\n  if target_entity_id_on_grid is None:\n      # This case should ideally not be reached if `primitive` is always valid.\n      return []\n\n  # Find all grid positions containing the target entity\n  entity_positions_on_grid = []\n  for r in range(rows):\n      for c in range(cols):\n          if grid[r, c, target_entity_id_on_grid] > 0:\n              entity_positions_on_grid.append((r, c))\n\n  if not entity_positions_on_grid:\n      # Target entity not found on the map\n      return []\n\n  # Define what constitutes a \"target position\" for BFS based on interaction type\n  bfs_target_positions = set()\n  if interact_adjacent:\n      # For adjacent interaction, target positions are cells *next to* the entity\n      for er, ec in entity_positions_on_grid:\n          for dr, dc in action_deltas.values(): # Iterate over all 4 adjacent cells\n              nr, nc = er + dr, ec + dc\n              # Ensure the adjacent cell is within bounds\n              if 0 <= nr < rows and 0 <= nc < cols:\n                  bfs_target_positions.add((nr, nc))\n  else:\n      # For on-tile interaction, target positions are the entity's own cells\n      bfs_target_positions.update(entity_positions_on_grid)\n\n  # Helper function to determine if a given cell is blocked for movement\n  def is_blocked(pos):\n      r, c = pos\n      # Check if out of bounds\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      cell_contents = np.where(grid[r, c, :] > 0)[0] \n      \n      # Water always blocks movement\n      if water_id in cell_contents:\n           return True\n      \n      # Boundary always blocks movement\n      if boundary_id in cell_contents:\n          return True\n\n      # Handle other non-grabbable entities (like workshops, stone sources)\n      for k_idx in cell_contents:\n          if k_idx in env.world.non_grabbable_indices:\n              # If this non-grabbable is the actual target entity we need to interact with *on* this tile\n              # (e.g., a workshop), then it's not blocked for movement onto it.\n              if k_idx == target_entity_id_on_grid and not interact_adjacent:\n                  continue # This specific target non-grabbable allows movement onto it.\n              # Otherwise, any other non-grabbable blocks movement.\n              return True\n      return False\n\n  # BFS to find the shortest path\n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_to_reach_here)\n  visited = {start_pos} # Set to keep track of visited positions to avoid redundant paths and cycles\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the BFS target positions, we've found the shortest path\n      if (r, c) in bfs_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          if new_pos not in visited and not is_blocked(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # Append the 'USE' action to interact with the target\n      actions = best_path + [USE_ACTION_ID]\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:44:05.003185", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Action IDs to (dr, dc) for movement (row, column changes)\n  # Based on CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Get the integer ID for the primitive name from the cookbook's index.\n  # This `primitive_item_id` is the ID of the *item* we want to acquire (e.g., \"WOOD\", \"STONE\").\n  primitive_item_id = env.world.cookbook.index[primitive]\n\n  # Determine the actual entity ID on the grid that needs to be interacted with\n  # (which might be different from `primitive_item_id` for source blocks like stone)\n  # and the type of interaction (on-tile or adjacent).\n  target_entity_id_on_grid = None\n  interact_adjacent = False # True if agent needs to be adjacent, False if on the same tile\n\n  # Retrieve specific entity IDs from the world for robust logic\n  water_id = env.world.water_index\n  stone_source_id = env.world.stone_index # This is the ID of the stone *block* on the map\n\n  # Logic for mapping DSL primitive to grid entity and interaction type:\n  # 1. Workshops: require moving onto their tile.\n  if primitive_item_id in env.world.workshop_indices:\n      target_entity_id_on_grid = primitive_item_id\n      interact_adjacent = False \n  # 2. \"STONE\" primitive: acquired by using a `stone_source_id` block from an adjacent tile.\n  elif primitive == \"STONE\":\n      target_entity_id_on_grid = stone_source_id\n      interact_adjacent = True \n  # 3. Other primitives (e.g., \"WOOD\", \"IRON\", \"GRASS\", \"GOLD\", \"GEM\", \"ROCK\", \"BOUNDARY\"):\n  #    Assume their name directly corresponds to an entity on the grid, and they are collected\n  #    by moving onto their tile.\n  else:\n      target_entity_id_on_grid = primitive_item_id\n      interact_adjacent = False\n\n  # If for some reason the target entity ID couldn't be determined, return empty actions.\n  if target_entity_id_on_grid is None:\n      return []\n\n  # Find all grid positions that contain the determined target entity.\n  entity_positions_on_grid = []\n  for r in range(rows):\n      for c in range(cols):\n          if grid[r, c, target_entity_id_on_grid] > 0:\n              entity_positions_on_grid.append((r, c))\n\n  # If the target entity is not present on the map, no collection is possible.\n  if not entity_positions_on_grid:\n      return []\n\n  # Determine the set of \"target positions\" for the BFS. These are the cells the agent needs to reach\n  # to be able to perform the 'USE' action.\n  bfs_target_positions = set()\n  if interact_adjacent:\n      # If interaction requires being adjacent (e.g., for \"STONE\" from a source block),\n      # the BFS target positions are the cells neighboring the entity.\n      for er, ec in entity_positions_on_grid:\n          for dr, dc in action_deltas.values(): # Iterate over all 4 adjacent directions (UP, DOWN, LEFT, RIGHT)\n              nr, nc = er + dr, ec + dc\n              # Ensure the adjacent cell is within grid boundaries.\n              if 0 <= nr < rows and 0 <= nc < cols:\n                  bfs_target_positions.add((nr, nc))\n  else:\n      # If interaction requires being on the same tile (e.g., picking up \"WOOD\", using a \"WORKSHOP\"),\n      # the BFS target positions are the entity's own cells.\n      bfs_target_positions.update(entity_positions_on_grid)\n\n  # Helper function to determine if a given grid cell is blocked for agent movement.\n  # This function uses information about the current target entity and interaction type\n  # to correctly identify traversable cells.\n  def is_blocked(pos):\n      r, c = pos\n      # Cells outside the grid boundaries are blocked.\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Get all entity IDs present at the current cell.\n      cell_contents = np.where(grid[r, c, :] > 0)[0] \n      \n      # Water tiles are always impassable obstacles.\n      if water_id in cell_contents:\n           return True\n\n      # Check for other non-grabbable entities (like workshop blocks, stone sources)\n      # Non-grabbable entities include workshops, stone sources, water, boundaries.\n      for k_idx in cell_contents:\n          if k_idx in env.world.non_grabbable_indices:\n              # A non-grabbable entity at `pos` blocks movement if:\n              # 1. It is NOT the specific `target_entity_id_on_grid` we are trying to reach/interact with.\n              #    (e.g., trying to walk through a workshop when collecting wood).\n              # OR\n              # 2. It IS the `target_entity_id_on_grid`, but our interaction rule requires being\n              #    adjacent (not directly on) this entity (e.g., a stone source block).\n              if k_idx != target_entity_id_on_grid or interact_adjacent:\n                  return True\n      return False\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path.\n  # The queue stores tuples of (current_position, path_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to avoid redundant paths and cycles.\n  visited = {start_pos} \n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of our BFS target positions, we've found the shortest path.\n      if (r, c) in bfs_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break # Exit BFS as the shortest path is found\n\n      # Explore all four cardinal neighbors (Up, Down, Left, Right).\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position hasn't been visited and is not blocked, add it to the queue.\n          if new_pos not in visited and not is_blocked(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path to a target position was found, append the 'USE' action.\n      # The 'USE' action (ID 4) interacts with the entity at the final position.\n      actions = best_path + [4] # 4 is the ID for the USE action\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:45:41.248755", "function_name": "collect", "function_body": "  # Helper function to check 3x3 neighborhood for a kind using (x,y) coordinates\n  def _is_next_to_coord(cx, cy, i_kind, grid, GRID_WIDTH, GRID_HEIGHT):\n      # Iterate through a 3x3 neighborhood centered at (cx,cy)\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              nx, ny = cx + dx_offset, cy + dy_offset\n\n              # Check bounds\n              # grid shape is (WIDTH, HEIGHT, n_kinds)\n              if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n                  continue\n              \n              # Check if the specified kind is at (nx, ny)\n              if grid[nx, ny, i_kind] == 1:\n                  return True\n      return False\n\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  grid = current_state.grid\n  start_pos_x, start_pos_y = current_state.pos # (x, y) where x is col, y is row\n  \n  GRID_WIDTH, GRID_HEIGHT, N_KINDS = grid.shape # grid[x_coord, y_coord, kind_idx]\n\n  # Get primitive index\n  try:\n      primitive_idx = cookbook.index.index(primitive)\n  except KeyError:\n      # Primitive not found in cookbook, cannot collect\n      return []\n\n  # Get action mappings\n  action_specs = env.action_specs()\n  UP = action_specs['UP']    # Corresponds to dy = -1\n  DOWN = action_specs['DOWN'] # Corresponds to dy = 1\n  LEFT = action_specs['LEFT'] # Corresponds to dx = -1\n  RIGHT = action_specs['RIGHT'] # Corresponds to dx = 1\n  USE = action_specs['USE']\n\n  # Define possible movements (dx, dy) and corresponding actions\n  moves = [\n      (UP, (0, -1)),    # UP: (dx=0, dy=-1)\n      (DOWN, (0, 1)),   # DOWN: (dx=0, dy=1)\n      (LEFT, (-1, 0)),  # LEFT: (dx=-1, dy=0)\n      (RIGHT, (1, 0)),  # RIGHT: (dx=1, dy=0)\n  ]\n\n  # Queue for BFS: stores (x, y, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_pos_x, start_pos_y, [])]) \n  visited = {(start_pos_x, start_pos_y)}\n\n  non_grabbable_indices = world.non_grabbable_indices\n\n  # Special handling for agent's initial position: check if primitive is already next to it\n  if _is_next_to_coord(start_pos_x, start_pos_y, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n      return [USE]\n\n  while queue:\n      cx, cy, path_actions = queue.popleft()\n\n      # Check if the primitive is in the 3x3 neighborhood of the current cell (cx, cy)\n      # If so, we have found a path to a location from which we can USE the primitive.\n      if _is_next_to_coord(cx, cy, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n          return path_actions + [USE]\n\n      # Explore possible moves\n      for action, (dx, dy) in moves:\n          nx, ny = cx + dx, cy + dy\n\n          # Check if the new position is within grid bounds\n          if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n              continue\n\n          # Check if the new position has already been visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check traversability: A cell is traversable if it does not contain any non-grabbable items\n          is_traversable = True\n          for non_grab_idx in non_grabbable_indices:\n              if grid[nx, ny, non_grab_idx] == 1: # If a non-grabbable item is present\n                  is_traversable = False\n                  break\n          \n          if is_traversable:\n              visited.add((nx, ny))\n              queue.append((nx, ny, path_actions + [action]))\n  \n  # If the queue becomes empty and no path to the primitive is found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:45:43.167012", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map[\"UP\"], action_map[\"DOWN\"], action_map[\"LEFT\"], action_map[\"RIGHT\"], action_map[\"USE\"]\n\n  primitive_idx = env.world.cookbook.index(primitive)\n  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos  # (row, col)\n  rows, cols = grid.shape[0], grid.shape[1]\n\n  # 1. Identify all locations of the primitive in the grid\n  primitive_locations = []\n  for r in range(rows):\n    for c in range(cols):\n      if grid[r, c, primitive_idx] > 0:\n        primitive_locations.append((r, c))\n\n  if not primitive_locations:\n    return []  # Primitive not found in the current grid\n\n  # 2. Determine the set of valid target cells for movement (cells the agent needs to reach)\n  # and any final action (like USE) after reaching the target cell.\n  target_cells_for_movement = set()\n  final_actions = []\n\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n\n  if is_grabbable:\n    # If the primitive is grabbable (e.g., WOOD, IRON), the agent needs to move to\n    # the cell where the item is located and then USE it to pick it up.\n    target_cells_for_movement.update(primitive_locations)\n    final_actions = [USE]\n  else:\n    # If the primitive is a workshop, WATER, BOUNDARY, or other non-grabbable,\n    # the agent typically needs to move to a cell *adjacent* to it. No USE action is generally required for \"collecting\" these.\n    adj_moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Relative moves for UP, DOWN, LEFT, RIGHT\n    for pr, pc in primitive_locations:\n      for dr, dc in adj_moves:\n        ar, ac = pr + dr, pc + dc\n        if 0 <= ar < rows and 0 <= ac < cols:\n          # Check if the adjacent cell is walkable. An adjacent cell is walkable\n          # if it's not water or a boundary. It can contain grabbable items or be empty.\n          is_walkable_adj = True\n          # Check if the adjacent cell contains any known impassable obstacle (Water, Boundary)\n          if grid[ar, ac, env.world.water_index] > 0 or \\\n             grid[ar, ac, env.world.cookbook.index(\"boundary\")] > 0:\n            is_walkable_adj = False\n          \n          # Additionally, if the adjacent cell contains any *other* non-grabbable item\n          # that is not the target primitive itself (in cases where target is workshop, water, boundary)\n          # then it might also be an obstacle for movement.\n          # For v2, we assume only water and boundary are strict movement blockers.\n          # Workshops are considered permeable for movement *around* them, but not *onto* them.\n          # This is implicitly handled by the target_cells_for_movement not including workshop cells themselves.\n\n          if is_walkable_adj:\n            target_cells_for_movement.add((ar, ac))\n    # No final_actions for non-grabbable primitives like workshops, water, boundary, as they are not \"collected\" via USE.\n\n  if not target_cells_for_movement:\n    return []  # No reachable target cells found\n\n  # 3. Perform a Breadth-First Search (BFS) to find the shortest path to any target cell.\n  q = collections.deque([(agent_pos, [])])  # (current_position, path_of_actions_so_far)\n  visited = {agent_pos}\n\n  move_deltas = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n\n  best_path = None\n\n  while q:\n    (r, c), path = q.popleft()\n\n    if (r, c) in target_cells_for_movement:\n      best_path = path\n      break  # Found the shortest path to a valid target cell\n\n    for action, (dr, dc) in move_deltas.items():\n      nr, nc = r + dr, c + dc\n      next_pos = (nr, nc)\n\n      # Check bounds\n      if not (0 <= nr < rows and 0 <= nc < cols):\n        continue\n\n      # Check if already visited\n      if next_pos in visited:\n        continue\n\n      # Check if the next cell (nr, nc) is traversable.\n      # A cell is considered blocked if it contains water or a boundary.\n      # Also, if it contains any other non-grabbable item that is not the target primitive\n      # (e.g., if we're collecting wood, we can't path through a workshop).\n      is_blocked_by_obstacle = False\n      for k_idx in range(grid.shape[2]): # Iterate through all possible kinds\n        if grid[nr, nc, k_idx] > 0: # If this kind is present at (nr, nc)\n          if k_idx in env.world.non_grabbable_indices:\n            # If it's a non-grabbable item.\n            # It's an obstacle unless it's the grabbable primitive itself that we intend to step on.\n            if k_idx == primitive_idx and is_grabbable:\n              # This is the grabbable primitive we want to pick up by stepping on it. Not an obstacle.\n              pass\n            else:\n              # It's another non-grabbable, or it's the primitive but not grabbable (like a workshop). Blocked.\n              is_blocked_by_obstacle = True\n              break\n      \n      if is_blocked_by_obstacle:\n        continue\n\n      visited.add(next_pos)\n      q.append((next_pos, path + [action]))\n\n  if best_path is None:\n    return []  # No path found to any target cell\n\n  return best_path + final_actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:46:34.344716", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n\n  # 1. Resolve the primitive name to its integer index using the environment's cookbook.\n  # The cookbook stores mappings from string names to integer IDs.\n  i_primitive = env.world.cookbook.index[primitive.upper()]\n  \n  # Handle cases where the primitive name is not recognized or the item is not grabbable.\n  if i_primitive is None:\n      # The provided primitive name does not exist in the game's item index.\n      return []\n\n  # 'Collect' implies adding an item to inventory, which is only possible for 'grabbable' items.\n  # Non-grabbable items (like workshops, water, boundaries) cannot be picked up using 'USE'.\n  if i_primitive in env.world.non_grabbable_indices:\n      return []\n\n  # 2. Map symbolic action names to their corresponding integer values.\n  # These are needed to construct the output action sequence.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define the set of actions that represent movement (changing position or direction).\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Pre-calculate delta row (DR) and delta column (DC) values based on agent's direction.\n  # Direction mapping: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT.\n  DR = [-1, 0, 1, 0] # Change in Row for each direction\n  DC = [0, 1, 0, -1] # Change in Column for each direction\n\n  # Get the initial state of the environment for the BFS starting point.\n  start_state = env._current_state\n  # Extract grid dimensions for boundary checks.\n  HEIGHT, WIDTH, _ = start_state.grid.shape\n\n  # 3. Initialize Breadth-First Search (BFS).\n  # The queue will store tuples of (current_craft_state, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(start_state, [])])\n  \n  # The 'visited' set keeps track of states already explored to prevent cycles and redundant work.\n  # A state is defined by the agent's (row, column, direction), as all three influence\n  # possible future actions and interactions (e.g., 'USE' depends on direction).\n  visited = set([(start_state.pos[0], start_state.pos[1], start_state.dir)]) \n\n  # 4. Perform BFS to find the shortest path to the primitive.\n  while queue:\n    current_state, path_to_current = queue.popleft() # Dequeue the next state to explore.\n    \n    # --- Goal Check: Determine if the primitive can be collected from `current_state`. ---\n    # The 'USE' action operates on the cell directly in front of the agent.\n    \n    # Calculate the coordinates of the cell the agent is currently facing.\n    facing_dir = current_state.dir\n    target_r = current_state.pos[0] + DR[facing_dir]\n    target_c = current_state.pos[1] + DC[facing_dir]\n\n    # Check if the target cell is within the grid boundaries.\n    if 0 <= target_r < HEIGHT and 0 <= target_c < WIDTH:\n        # Check if the target cell contains the desired primitive (count > 0).\n        if current_state.grid[target_r, target_c, i_primitive] > 0:\n            # If the primitive is found, we have reached a state where it can be collected.\n            # Since BFS finds the shortest path in unweighted graphs, this is the optimal path.\n            # Append the 'USE' action to the current path and return it.\n            return path_to_current + [ACTION_USE]\n\n    # --- Explore Next States: Simulate all possible movement actions. ---\n    for action in MOVE_ACTIONS:\n      # Simulate applying the action to the current state to get the next state.\n      # `current_state.step(action)` returns (reward, new_state). Reward is ignored.\n      _, new_state = current_state.step(action) \n      \n      # Create a unique key for the `new_state` to check against the visited set.\n      # This key captures the agent's complete relevant state: position and direction.\n      new_state_key = (new_state.pos[0], new_state.pos[1], new_state.dir)\n      \n      # If this new state has not been visited before, add it to the queue\n      # for future exploration and mark it as visited.\n      if new_state_key not in visited:\n        visited.add(new_state_key)\n        queue.append((new_state, path_to_current + [action]))\n            \n  # 5. If the BFS loop completes and the queue becomes empty without finding the primitive,\n  # it means the primitive is either unreachable from the starting position or not present\n  # in the current environment configuration.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:46:36.422401", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive.upper()]\n  \n  # 1. Validate inputs and perform pre-checks.\n  # If the primitive name is not found in the cookbook index, it's an invalid target.\n  if i_primitive is None:\n      return []\n\n  # 'Collect' implies adding an item to inventory. Non-grabbable entities (like workshops,\n  # water, or boundaries) cannot be picked up using the 'USE' action.\n  if i_primitive in env.world.non_grabbable_indices:\n      return []\n\n  # Get the current state of the environment.\n  start_state = env._current_state\n  \n  # Optimization/Pre-condition check: If the primitive is already in the agent's inventory,\n  # no collection actions are needed. The task is effectively already completed.\n  if start_state.inventory[i_primitive] > 0:\n      return []\n\n  # 2. Retrieve integer mappings for actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define the set of movement actions for BFS exploration.\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Delta Row/Col based on agent's direction (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT)\n  # These are used to calculate the coordinates of the cell directly in front of the agent.\n  DR = [-1, 0, 1, 0] # Delta Row for (UP, RIGHT, DOWN, LEFT)\n  DC = [0, 1, 0, -1] # Delta Col for (UP, RIGHT, DOWN, LEFT)\n\n  # Get grid dimensions for boundary checks.\n  HEIGHT, WIDTH, _ = start_state.grid.shape\n\n  # 3. Initialize Breadth-First Search (BFS) structures.\n  # The queue will store tuples of (current_CraftState_instance, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(start_state, [])])\n  \n  # The 'visited' set keeps track of (agent_row, agent_col, agent_direction) tuples.\n  # This prevents redundant exploration of the same state and avoids infinite loops.\n  visited = set([(start_state.pos[0], start_state.pos[1], start_state.dir)]) \n\n  # 4. Perform BFS to find the shortest action sequence.\n  while queue:\n    current_state, path_to_current = queue.popleft()\n    \n    # --- Goal Check: Can the primitive be collected from the `current_state`? ---\n    # The 'USE' action interacts with the grid cell directly in front of the agent.\n    \n    # Calculate the coordinates of the cell the agent is currently facing.\n    facing_dir = current_state.dir\n    target_r = current_state.pos[0] + DR[facing_dir]\n    target_c = current_state.pos[1] + DC[facing_dir]\n\n    # Check if the target cell is within grid boundaries.\n    if 0 <= target_r < HEIGHT and 0 <= target_c < WIDTH:\n        # Check if the target cell contains the desired primitive.\n        # `grid[r, c, kind_idx] > 0` indicates presence.\n        if current_state.grid[target_r, target_c, i_primitive] > 0:\n            # If the primitive is found in front, we've found the shortest path.\n            # Append the 'USE' action and return the complete action sequence.\n            return path_to_current + [ACTION_USE]\n\n    # --- Explore Next States: Simulate Movement Actions ---\n    # Iterate through all possible movement actions from the `current_state`.\n    for action in MOVE_ACTIONS:\n      # Simulate the action using `current_state.step()`. This function\n      # returns a tuple: (reward, new_CraftState). We only need the `new_state`.\n      _, new_state = current_state.step(action) \n      \n      # Create a unique key for the `new_state` to check against the `visited` set.\n      # A state is uniquely defined by the agent's position and direction.\n      new_state_key = (new_state.pos[0], new_state.pos[1], new_state.dir)\n      \n      # If this new state has not been visited, add it to the `visited` set\n      # and enqueue it along with the sequence of actions taken to reach it.\n      if new_state_key not in visited:\n        visited.add(new_state_key)\n        queue.append((new_state, path_to_current + [action]))\n            \n  # 5. If the BFS completes (queue becomes empty) and no path to collect\n  # the primitive was found, it implies the primitive is either unreachable\n  # or not present on the map under the current conditions. Return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:47:10.346453", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n\n  # Ensure the primitive is actually a grabbable item that can be added to inventory.\n  # Non-grabbable items (like workshops, water, boundaries) cannot be \"collected\" in this sense.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  # Initialize BFS\n  # The queue stores tuples of (current_craft_state, list_of_actions_taken_to_reach_this_state)\n  # The visited set stores (agent_position, agent_direction) to avoid cycles and redundant exploration.\n  start_state = env._current_state\n  queue = collections.deque([(start_state, [])])\n  visited = {(start_state.pos, start_state.dir)}\n\n  # BFS loop to find the shortest path to a cell adjacent to the primitive\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # Check if the current state satisfies the goal: is the agent next to the primitive?\n    if current_state.next_to(primitive_id):\n      # If yes, we have found a path to a position adjacent to the primitive.\n      # Append the USE action, which will collect the grabbable item into the inventory.\n      return path_so_far + [USE]\n\n    # If not, explore possible movement actions from the current state\n    for action in MOVE_ACTIONS:\n      # Simulate the step using the CraftState's step method.\n      # CraftState.step returns a *new* CraftState object, which is perfect for BFS.\n      _reward, next_state_candidate = current_state.step(action)\n\n      next_pos = next_state_candidate.pos\n      next_dir = next_state_candidate.dir\n      next_state_identifier = (next_pos, next_dir)\n\n      # If this next state (position and direction) has not been visited before, add it to the queue.\n      if next_state_identifier not in visited:\n        visited.add(next_state_identifier)\n        queue.append((next_state_candidate, path_so_far + [action]))\n\n  # If the queue becomes empty and no path was found (i.e., the primitive is unreachable),\n  # return an empty list.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:47:12.289088", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index.get(primitive)\n\n  # 1. Ensure the primitive is valid and can be collected.\n  # If the primitive name does not map to an ID, or if its ID is not in the set of grabbable items,\n  # then it cannot be collected into the agent's inventory.\n  if primitive_id is None or primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 2. Get action mappings from the environment's action space.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  # 3. Initialize Breadth-First Search (BFS) for pathfinding.\n  # The queue will store tuples of (current_craft_state, list_of_actions_taken_to_reach_this_state).\n  # The 'visited' set will store (agent_position, agent_direction) tuples to prevent re-visiting\n  # the same agent configuration, which avoids cycles and redundant computation in a static grid.\n  start_state = env._current_state\n  queue = collections.deque([(start_state, [])])\n  visited = {(start_state.pos, start_state.dir)}\n\n  # 4. BFS Loop: Explore states layer by layer until the primitive is found or all reachable states are exhausted.\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # Check if the current state satisfies the goal: is the agent next to the primitive?\n    if current_state.next_to(primitive_id):\n      # If yes, we have found the shortest sequence of movement actions to reach a cell\n      # adjacent to the primitive. Append the 'USE' action to collect it.\n      return path_so_far + [USE]\n\n    # If the goal is not yet met, explore all possible movement actions from the current state.\n    for action in MOVE_ACTIONS:\n      # Simulate taking the action. CraftState.step returns a *new* CraftState instance,\n      # which is crucial for BFS to explore different paths without modifying the original state.\n      _reward, next_state_candidate = current_state.step(action)\n\n      next_pos = next_state_candidate.pos\n      next_dir = next_state_candidate.dir\n      next_state_identifier = (next_pos, next_dir)\n\n      # If this next state (position and direction) has not been visited before, add it to the queue.\n      if next_state_identifier not in visited:\n        visited.add(next_state_identifier) # Mark the state as visited.\n        queue.append((next_state_candidate, path_so_far + [action])) # Add to queue for future exploration.\n\n  # If the BFS queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:48:19.634308", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  start_dir = current_state.dir # Get initial direction\n  grid = current_state.grid\n  \n  # Map action IDs to (dr, dc) for pathfinding\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  # Map movement action IDs to the corresponding agent direction IDs\n  # CraftState.dir: 0: DOWN, 1: UP, 2: LEFT, 3: RIGHT\n  action_to_dir_mapping = {\n      0: 0, # Action DOWN (0) leads to agent facing DOWN (0)\n      1: 1, # Action UP (1) leads to agent facing UP (1)\n      2: 2, # Action LEFT (2) leads to agent facing LEFT (2)\n      3: 3  # Action RIGHT (3) leads to agent facing RIGHT (3)\n  }\n\n  rows, cols, _ = grid.shape\n\n  # Retrieve primitive ID; assumes primitive is a valid name that exists in the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get relevant indices from the world configuration\n  non_grabbable_indices = env.world.non_grabbable_indices # This is already a set\n  workshop_indices = set(env.world.workshop_indices) # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to determine if a given cell is blocked for movement.\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if out of bounds\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0:\n              return True\n      return False\n      \n  # --- Define Target Positions for BFS ---\n  # target_positions_map: Maps (r, c) of the cell the agent should land on\n  #                       -> (r, c) of the actual item/workshop to interact with (or None if item is on the agent's cell)\n  target_positions_map = {}\n  \n  if is_workshop_primitive:\n      workshop_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      for wr, wc in workshop_locations_on_grid:\n          workshop_pos = (wr, wc)\n          # For a workshop, the agent needs to move to an adjacent, unblocked cell.\n          # Iterate over cardinal neighbors.\n          for dr, dc in action_deltas.values():\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              if not is_blocked_for_movement(neighbor_pos): \n                  target_positions_map[neighbor_pos] = workshop_pos\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      for r in range(rows):\n          for c in range(cols):\n              if grid[r, c, primitive_id] > 0:\n                  current_cell_pos = (r, c)\n                  # Only consider it a target if the cell itself is not blocked for movement.\n                  if not is_blocked_for_movement(current_cell_pos):\n                      target_positions_map[current_cell_pos] = None # No specific item to face, it's on the cell\n\n  if not target_positions_map:\n      # The primitive (or a valid adjacent spot for a workshop) was not found on the map,\n      # or all instances are in blocked locations.\n      return []\n\n  # --- BFS to find the shortest path to any target position ---\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to store visited positions to avoid cycles and redundant exploration during pathfinding.\n  # We only need to store position because we're finding the shortest path in terms of movement steps first.\n  visited = {start_pos}\n  \n  best_path = []\n  final_pos_reached = None\n  associated_item_pos = None # Will store the workshop's actual (r,c) or None for grabbables\n\n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in target_positions_map:\n          best_path = path_so_far\n          final_pos_reached = (r, c)\n          associated_item_pos = target_positions_map[(r, c)]\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not visited and not blocked), add it to the queue\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if final_pos_reached is None: # No path found to any target position\n      return []\n\n  # --- Assemble final actions including turns and USE ---\n  final_actions = list(best_path) # Start with the movement path\n\n  # Helper function to get the sequence of turns needed to face the target direction\n  # Action IDs for turning: LEFT=2, RIGHT=3\n  def _get_turn_actions(current_dir, target_dir):\n      turn_actions = []\n      # Calculate turns needed (clockwise distance)\n      clockwise_turns = (target_dir - current_dir + 4) % 4\n      \n      if clockwise_turns == 1:\n          turn_actions.append(3) # RIGHT\n      elif clockwise_turns == 2:\n          turn_actions.extend([3, 3]) # RIGHT, RIGHT (or LEFT, LEFT)\n      elif clockwise_turns == 3:\n          turn_actions.append(2) # LEFT (shorter than three RIGHTs)\n      return turn_actions\n\n  # Determine the agent's final direction after all movements in best_path\n  current_agent_dir = start_dir \n  for action_id in best_path:\n      if action_id in action_to_dir_mapping: # Only movement actions change direction\n          current_agent_dir = action_to_dir_mapping[action_id]\n\n  if is_workshop_primitive:\n      # If it's a workshop, the agent needs to turn to face it from final_pos_reached.\n      wr, wc = associated_item_pos # The actual workshop position\n      tr, tc = final_pos_reached # The position the agent is standing on\n      \n      delta_r = wr - tr\n      delta_c = wc - tc\n\n      # Determine the required direction for the agent to face the workshop\n      required_dir = -1 # Sentinel\n      if (delta_r, delta_c) == (-1, 0): # Workshop is UP from agent\n          required_dir = 1 # Agent needs to face UP (dir 1)\n      elif (delta_r, delta_c) == (1, 0): # Workshop is DOWN from agent\n          required_dir = 0 # Agent needs to face DOWN (dir 0)\n      elif (delta_r, delta_c) == (0, -1): # Workshop is LEFT from agent\n          required_dir = 2 # Agent needs to face LEFT (dir 2)\n      elif (delta_r, delta_c) == (0, 1): # Workshop is RIGHT from agent\n          required_dir = 3 # Agent needs to face RIGHT (dir 3)\n      \n      if required_dir != -1: # This should always be true if target_positions_map was set up correctly\n          final_actions.extend(_get_turn_actions(current_agent_dir, required_dir))\n  \n  final_actions.append(4) # Append the USE action after all movements and turns\n\n  return final_actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:48:21.647273", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Map action IDs to (dr, dc) for pathfinding\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Retrieve primitive ID; assumes primitive is a valid name that exists in the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get relevant indices from the world configuration\n  # Convert non_grabbable_indices to a NumPy array once for efficient indexing\n  non_grabbable_indices_arr = np.array(list(env.world.non_grabbable_indices), dtype=int)\n  workshop_indices = set(env.world.workshop_indices) # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop (requires agent to be adjacent)\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to determine if a given cell is blocked for movement.\n  # A cell is blocked if it contains *any* non-grabbable item (e.g., water, stone, workshops).\n  # Improvement: Use NumPy fancy indexing for faster check of non-grabbable items.\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if out of bounds\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Check if any non-grabbable item is present at (r, c) using NumPy array.\n      # This is more efficient than iterating through a Python set/list of indices,\n      # especially if non_grabbable_indices_arr is used repeatedly.\n      if non_grabbable_indices_arr.size > 0 and \\\n         np.any(grid[r, c, non_grabbable_indices_arr] > 0):\n          return True\n      return False\n      \n  # --- Define Target Positions for BFS ---\n  # These are the cells the agent needs to reach to interact with the primitive.\n  potential_target_positions = set()\n  \n  if is_workshop_primitive:\n      # If the primitive is a workshop, the agent needs to move to a cell *adjacent* to it.\n      # Find all locations on the grid where this specific workshop type exists using NumPy.\n      workshop_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      # For each workshop location, identify its valid, unblocked neighbors.\n      for wr, wc in workshop_locations_on_grid:\n          for dr, dc in action_deltas.values(): # Iterate over (dr, dc) for cardinal neighbors\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      # Improvement: Use np.argwhere to find all locations of the primitive directly.\n      # This is generally more efficient than nested Python loops for large grids.\n      primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      for r, c in primitive_locations_on_grid:\n          current_cell_pos = (r, c)\n          # Only consider it a target if the cell itself is not blocked for movement.\n          # This filters out resources that might be in impassable terrain (e.g., wood on water).\n          if not is_blocked_for_movement(current_cell_pos):\n              potential_target_positions.add(current_cell_pos)\n\n  if not potential_target_positions:\n      # The primitive (or a valid adjacent spot for a workshop) was not found on the map,\n      # or all instances are in blocked locations.\n      return []\n\n  # --- BFS to find the shortest path to any target position ---\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to store visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in potential_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not visited and not blocked), add it to the queue\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path was found, append the 'USE' action to collect/interact with the primitive.\n      # The 'USE' action (ID 4) is applied after reaching the target position.\n      actions = best_path + [4] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:49:55.910881", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current position (x, y)\n  \n  # Grid shape is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, n_kinds = grid.shape \n\n  # Get the integer ID for the primitive (e.g., \"WOOD\" from DSL becomes \"wood\" for index)\n  # Using .index() ensures the primitive is registered and returns its ID.\n  primitive_id = env.world.cookbook.index.index(primitive.lower()) \n\n  # Get action mappings from the environment (e.g., {\"UP\": 1, \"DOWN\": 0, ...})\n  ACTION_MAP = env.action_specs()\n\n  # Define movement deltas (dx, dy) corresponding to actions for grid[x, y, k]\n  # UP: decreases Y coordinate (moves North)\n  # DOWN: increases Y coordinate (moves South)\n  # LEFT: decreases X coordinate (moves West)\n  # RIGHT: increases X coordinate (moves East)\n  DELTAS = {\n      ACTION_MAP[\"UP\"]: (0, -1),    \n      ACTION_MAP[\"DOWN\"]: (0, 1),   \n      ACTION_MAP[\"LEFT\"]: (-1, 0),  \n      ACTION_MAP[\"RIGHT\"]: (1, 0),  \n  }\n  \n  # Identify non-walkable indices for BFS pathfinding.\n  # Common obstacles include \"boundary\" and \"water\".\n  unwalkable_indices = set()\n  for name in [\"boundary\", \"water\"]:\n      try:\n          # Use .index() to get ID, or pass if not present in cookbook\n          unwalkable_indices.add(env.world.cookbook.index.index(name))\n      except KeyError:\n          pass \n\n  # Determine if the target primitive requires a 'USE' action to be collected.\n  # Grabbable items are explicitly listed in env.world.grabbable_indices.\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # BFS setup:\n  # Queue stores tuples of (current_position_tuple, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(initial_pos, [])]) \n  visited = {initial_pos} # Set to keep track of visited (x, y) positions to avoid cycles\n\n  # Helper function to check if a position (x, y) is valid (within grid bounds) and walkable\n  def is_valid_and_walkable(x, y):\n      # Check grid boundaries\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # Check if the cell contains any unwalkable entity\n      for unwalkable_idx in unwalkable_indices:\n          # If the unwalkable item is present at this cell (count > 0), it's not walkable\n          if grid[x, y, unwalkable_idx] > 0: \n              return False\n      return True\n\n  # Helper function to check if a position (current_x, current_y) is \"next_to\" the target primitive.\n  # This mimics the CraftState.next_to method, checking the 3x3 neighborhood.\n  def check_next_to_primitive(current_x, current_y, target_id):\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n              # Ensure neighbor is within grid bounds\n              if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n                  # Check if the primitive is present in the neighbor cell (count > 0)\n                  if grid[neighbor_x, neighbor_y, target_id] > 0:\n                      return True\n      return False\n\n  # Perform Breadth-First Search\n  while queue:\n      (curr_x, curr_y), path = queue.popleft()\n\n      # Check if the current position is adjacent to the target primitive\n      if check_next_to_primitive(curr_x, curr_y, primitive_id):\n          # If found, this 'path' leads to a position adjacent to the primitive.\n          # If the primitive is grabbable, append the 'USE' action.\n          if is_grabbable:\n              return path + [ACTION_MAP[\"USE\"]]\n          else:\n              # If not grabbable (e.g., a workshop or boundary),\n              # we just need to reach an adjacent position.\n              return path\n\n      # Explore all possible movement actions from the current position\n      for action_id, (dx, dy) in DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position is valid, walkable, and hasn't been visited yet\n          if is_valid_and_walkable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited\n              # Add to queue with the updated path\n              queue.append((next_pos, path + [action_id]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
