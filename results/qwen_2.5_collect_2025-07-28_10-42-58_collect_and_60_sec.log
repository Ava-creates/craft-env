{"timestamp": "2025-07-28T13:21:46.904807", "function_name": "collect", "function_body": "  actions_list = []\n\n  # 1. Get the integer ID of the primitive.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get action mappings for clarity.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get current state details.\n  current_state = env._current_state\n  start_pos = current_state.pos  # (y, x) tuple\n  start_dir = current_state.dir # Agent's initial facing direction (0:N, 1:E, 2:S, 3:W)\n  current_grid = current_state.grid # The full grid (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Determine if the primitive is grabbable (requires USE) or non-grabbable (proximity is enough).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Helper function to determine the required facing direction from a 'from' cell to a 'to' cell.\n  # Assuming 0:North, 1:East, 2:South, 3:West for direction integers.\n  def get_required_dir(from_coords, to_coords):\n      fy, fx = from_coords\n      ty, tx = to_coords\n      if ty < fy: return 0  # North (UP)\n      if ty > fy: return 2  # South (DOWN)\n      if tx < fx: return 3  # West (LEFT)\n      if tx > fx: return 1  # East (RIGHT)\n      return -1 # Should not happen for adjacent cells\n\n  # Helper mapping movement actions to the final facing direction after the move.\n  # This assumes moving in a cardinal direction makes the agent face that direction.\n  action_to_final_dir = {\n      UP: 0,    # Moving UP makes agent face North (0)\n      RIGHT: 1, # Moving RIGHT makes agent face East (1)\n      DOWN: 2,  # Moving DOWN makes agent face South (2)\n      LEFT: 3   # Moving LEFT makes agent face West (3)\n  }\n\n  # 2. Find all occurrences of the primitive on the grid.\n  primitive_locations_arr = np.argwhere(current_grid[:, :, primitive_idx] == 1)\n  primitive_locations = [tuple(loc) for loc in primitive_locations_arr]\n\n  # If the primitive is not found, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 3. Early exit: Check if the agent is already adjacent and correctly oriented to the desired primitive.\n  # Iterate through all primitive locations to find if any is directly adjacent.\n  for p_y, p_x in primitive_locations:\n      if abs(start_pos[0] - p_y) + abs(start_pos[1] - p_x) == 1: # If adjacent\n          required_dir_for_use = get_required_dir(start_pos, (p_y, p_x))\n          if start_dir == required_dir_for_use:\n              # Agent is adjacent and facing the primitive.\n              if is_grabbable:\n                  return [USE]\n              else:\n                  return [] # For non-grabbable, proximity and orientation are enough.\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path to an adjacent cell\n  # that allows for correct orientation for collection.\n  # The queue stores tuples: ((current_y, current_x), current_facing_dir, path_taken_to_reach_here).\n  q = collections.deque([((start_pos[0], start_pos[1]), start_dir, [])])\n\n  # The visited set keeps track of ((y, x), dir) tuples to prevent cycles and redundant exploration.\n  visited = {((start_pos[0], start_pos[1]), start_dir)}\n\n  # Define possible cardinal moves (dy, dx) and their corresponding actions.\n  moves_options = {\n      (-1, 0): UP,    # Move Up (decrement row index)\n      (1, 0): DOWN,   # Move Down (increment row index)\n      (0, -1): LEFT,  # Move Left (decrement column index)\n      (0, 1): RIGHT, # Move Right (increment column index)\n  }\n\n  # Identify the index for water, which is explicitly defined as an impassable terrain.\n  water_idx = env.world.water_index\n\n  while q:\n      (curr_y, curr_x), curr_facing_dir, path = q.popleft()\n\n      # Check if the current BFS node's position (curr_y, curr_x) is adjacent to any primitive\n      # AND if the agent's current facing direction (curr_facing_dir) is correct for that primitive.\n      for p_y, p_x in primitive_locations:\n          if abs(curr_y - p_y) + abs(curr_x - p_x) == 1: # If adjacent to a primitive\n              required_dir_for_use = get_required_dir((curr_y, curr_x), (p_y, p_x))\n              if curr_facing_dir == required_dir_for_use:\n                  # Found a path where the agent is in an adjacent cell and correctly oriented.\n                  if is_grabbable:\n                      return path + [USE]\n                  else:\n                      return path # For non-grabbable, just reaching this state is sufficient.\n\n      # Explore all valid neighboring cells from the current position.\n      for (dy, dx), move_action in moves_options.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_pos = (next_y, next_x)\n\n          # Calculate the agent's new facing direction after taking this move action.\n          next_facing_dir = action_to_final_dir[move_action]\n\n          # Ensure the next coordinates are within grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Ensure the next cell is not an impassable terrain (like water).\n          if current_grid[next_y, next_x, water_idx] == 1:\n              continue\n\n          # The state in BFS now includes position AND facing direction.\n          next_state_tuple = (next_pos, next_facing_dir)\n\n          # If this (position, direction) state has not been visited yet, add it to the queue.\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append((next_pos, next_facing_dir, path + [move_action]))\n\n  # If the queue becomes empty and no path was found to an adjacent and correctly oriented cell,\n  # return an empty list, indicating the primitive is unreachable or cannot be collected.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:21:49.429379", "function_name": "collect", "function_body": "  def get_required_facing_direction(agent_y, agent_x, item_y, item_x, action_map):\n    \"\"\"\n    Determines the required facing direction (as an action ID from action_map) for an agent\n    at (agent_y, agent_x) to face an item at (item_y, item_x).\n    Assumes (agent_y, agent_x) and (item_y, item_x) are strictly adjacent (Manhattan distance 1).\n    \"\"\"\n    if item_y == agent_y - 1 and item_x == agent_x:  # Item is North of agent\n      return action_map['UP']\n    if item_y == agent_y + 1 and item_x == agent_x:  # Item is South of agent\n      return action_map['DOWN']\n    if item_x == agent_x - 1 and item_y == agent_y:  # Item is West of agent\n      return action_map['LEFT']\n    if item_x == agent_x + 1 and item_y == agent_y:  # Item is East of agent\n      return action_map['RIGHT']\n    return None # Should not happen if caller ensures strict adjacency\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Map move action IDs to their corresponding (dy, dx) deltas\n  action_id_to_delta = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n  move_actions = [UP, DOWN, LEFT, RIGHT] # List of possible move actions\n\n  current_state = env._current_state\n  start_pos = current_state.pos  # (y, x) tuple\n  start_dir = current_state.dir  # Integer direction (0:UP, 1:DOWN, 2:LEFT, 3:RIGHT)\n  grid_height, grid_width, _ = current_state.grid.shape\n  current_grid = current_state.grid\n\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  water_idx = env.world.water_index\n\n  # Find all locations of the primitive on the grid.\n  # np.argwhere returns (y, x) for each occurrence.\n  primitive_locations = [tuple(loc) for loc in np.argwhere(current_grid[:, :, primitive_idx] == 1)]\n\n  if not primitive_locations:\n    return []  # Primitive not found on the grid\n\n  # BFS Queue: stores (current_y, current_x, current_direction_id, path_to_here_list)\n  # The direction_id is the direction the agent is currently facing.\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n\n  # Visited set: stores (y, x, direction_id) to prevent cycles and redundant exploration.\n  # A cell can be revisited if the agent arrives from a different direction.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    curr_y, curr_x, curr_dir, path = q.popleft()\n\n    # Check for goal condition at the current position\n    # We iterate through all potential primitive locations to find if one satisfies the goal.\n    for p_y, p_x in primitive_locations:\n      if is_grabbable:\n        # For grabbable items, the goal is to be adjacent to the item AND facing it.\n        # Manhattan distance of 1 means strict adjacency (not on the same cell).\n        if abs(curr_y - p_y) + abs(curr_x - p_x) == 1:\n          required_dir = get_required_facing_direction(curr_y, curr_x, p_y, p_x, action_map)\n          if curr_dir == required_dir:\n            # Found a path to an adjacent cell, facing the item.\n            return path + [USE]\n      else:\n        # For non-grabbable items (e.g., workshops), the goal is to be on the same cell.\n        if curr_y == p_y and curr_x == p_x:\n          # Found a path to the item's cell. No USE action is needed.\n          return path\n\n    # Explore valid neighboring cells from the current position\n    for action in move_actions:\n      dy, dx = action_id_to_delta[action]\n      next_y, next_x = curr_y + dy, curr_x + dx\n      next_dir = action  # After a move action, the agent's direction updates to that action's direction.\n\n      # Check grid boundaries\n      if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n        continue\n\n      # Check for impassable terrain (e.g., water)\n      if current_grid[next_y, next_x, water_idx] == 1:\n        continue\n\n      # If this specific (position, direction) state has not been visited, add to queue\n      if (next_y, next_x, next_dir) not in visited:\n        visited.add((next_y, next_x, next_dir))\n        q.append((next_y, next_x, next_dir, path + [action]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:22:38.330190", "function_name": "collect", "function_body": "  def _is_next_to_coord(cx, cy, i_kind, grid, GRID_WIDTH, GRID_HEIGHT):\n      # Iterate through a 3x3 neighborhood centered at (cx,cy)\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              nx, ny = cx + dx_offset, cy + dy_offset\n\n              # Check bounds\n              # grid shape is (WIDTH, HEIGHT, n_kinds)\n              if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n                  continue\n              \n              # Check if the specified kind is at (nx, ny)\n              # grid values are 0 or 1 for presence\n              if grid[nx, ny, i_kind] == 1: \n                  return True\n      return False\n\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  grid = current_state.grid\n  start_pos_x, start_pos_y = current_state.pos # (x, y) where x is col, y is row\n  \n  GRID_WIDTH, GRID_HEIGHT, N_KINDS = grid.shape # grid[x_coord, y_coord, kind_idx]\n\n  # Get primitive index, ensuring robustness to casing by converting to lowercase\n  try:\n      primitive_idx = cookbook.index.index(primitive.lower()) \n  except KeyError:\n      # Primitive not found in cookbook, cannot collect\n      return []\n\n  # The 'collect' action implies adding the item to inventory.\n  # If the primitive is a non-grabbable environment entity (like a workshop or boundary),\n  # it cannot be collected into the inventory. In such cases, return an empty action list.\n  if primitive_idx in world.non_grabbable_indices:\n      return []\n\n  # Get action mappings\n  action_specs = env.action_specs()\n  UP = action_specs['UP']\n  DOWN = action_specs['DOWN']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  # Define possible movements (dx, dy) and corresponding actions\n  moves = [\n      (UP, (0, -1)),    # UP: (dx=0, dy=-1)\n      (DOWN, (0, 1)),   # DOWN: (dx=0, dy=1)\n      (LEFT, (-1, 0)),  # LEFT: (dx=-1, dy=0)\n      (RIGHT, (1, 0)),  # RIGHT: (dx=1, dy=0)\n  ]\n\n  # Queue for BFS: stores (x, y, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_pos_x, start_pos_y, [])]) \n  visited = {(start_pos_x, start_pos_y)}\n\n  non_grabbable_indices = world.non_grabbable_indices\n\n  # Special handling for agent's initial position: check if primitive is already next to it\n  if _is_next_to_coord(start_pos_x, start_pos_y, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n      return [USE]\n\n  while queue:\n      cx, cy, path_actions = queue.popleft()\n\n      # Check if the primitive is in the 3x3 neighborhood of the current cell (cx, cy)\n      # If so, we have found a path to a location from which we can USE the primitive.\n      if _is_next_to_coord(cx, cy, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n          return path_actions + [USE]\n\n      # Explore possible moves\n      for action, (dx, dy) in moves:\n          nx, ny = cx + dx, cy + dy\n\n          # Check if the new position is within grid bounds\n          if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n              continue\n\n          # Check if the new position has already been visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check traversability: A cell is traversable if it does not contain any non-grabbable items\n          is_traversable = True\n          for non_grab_idx in non_grabbable_indices:\n              if grid[nx, ny, non_grab_idx] == 1: # If a non-grabbable item is present at (nx, ny)\n                  is_traversable = False\n                  break\n          \n          if is_traversable:\n              visited.add((nx, ny))\n              queue.append((nx, ny, path_actions + [action]))\n  \n  # If the queue becomes empty and no path to the primitive is found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:22:40.420064", "function_name": "collect", "function_body": "  # Helper function to check if a specific kind is in the 3x3 neighborhood of (cx, cy)\n  def _is_next_to_coord(cx, cy, i_kind, grid, GRID_WIDTH, GRID_HEIGHT):\n      # Iterate through a 3x3 neighborhood centered at (cx,cy)\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              nx, ny = cx + dx_offset, cy + dy_offset\n\n              # Check bounds (ensure neighbor is within grid boundaries)\n              if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n                  continue\n              \n              # Check if the specified kind is at (nx, ny) and its count is greater than 0\n              if grid[nx, ny, i_kind] > 0: \n                  return True\n      return False\n\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  grid = current_state.grid\n  start_pos_x, start_pos_y = current_state.pos # Agent's current position (x, y)\n  \n  GRID_WIDTH, GRID_HEIGHT, N_KINDS = grid.shape # grid has shape (WIDTH, HEIGHT, n_kinds)\n\n  # Get the integer ID for the primitive.\n  # The DSL uses uppercase (e.g., WOOD), but the cookbook's index expects lowercase (e.g., wood).\n  try:\n      primitive_idx = cookbook.index.index(primitive.lower())\n  except KeyError:\n      # If the primitive name is not found in the cookbook's index, it cannot be collected.\n      return []\n\n  # A 'collect' action implies adding the item to the agent's inventory.\n  # If the primitive is a non-grabbable environment entity (e.g., a workshop, water, or boundary),\n  # it cannot be picked up and added to inventory. In such cases, return an empty action list.\n  # The `world.non_grabbable_indices` set contains IDs of all non-collectible items.\n  if primitive_idx in world.non_grabbable_indices:\n      return []\n\n  # Get numeric action mappings from the environment (e.g., {\"UP\": 1, \"DOWN\": 0, \"USE\": 4, ...})\n  action_specs = env.action_specs()\n  UP = action_specs['UP']\n  DOWN = action_specs['DOWN']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  # Define possible movement actions and their corresponding (dx, dy) coordinate changes.\n  # dx represents change in x (horizontal), dy represents change in y (vertical).\n  moves = [\n      (UP, (0, -1)),    # UP: moves along y-axis in negative direction\n      (DOWN, (0, 1)),   # DOWN: moves along y-axis in positive direction\n      (LEFT, (-1, 0)),  # LEFT: moves along x-axis in negative direction\n      (RIGHT, (1, 0)),  # RIGHT: moves along x-axis in positive direction\n  ]\n\n  # BFS (Breadth-First Search) setup for pathfinding:\n  # The queue stores tuples: (current_x, current_y, list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(start_pos_x, start_pos_y, [])]) \n  # The 'visited' set keeps track of (x, y) positions already explored to prevent cycles\n  # and redundant computation in the BFS.\n  visited = {(start_pos_x, start_pos_y)}\n\n  # Define indices of entities that block movement (non-traversable terrain).\n  # For CraftWorld, non-grabbable items often also function as non-traversable terrain.\n  non_traversable_indices = world.non_grabbable_indices \n\n  # Optimization: Check if the primitive is already next to the agent's initial position.\n  # If so, we can immediately 'USE' it.\n  if _is_next_to_coord(start_pos_x, start_pos_y, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n      return [USE]\n\n  # Perform Breadth-First Search to find the shortest path to a location adjacent to the primitive.\n  while queue:\n      cx, cy, path_actions = queue.popleft() # Get the current position and path from the queue\n\n      # After moving to (cx, cy), check if the target primitive is now in the 3x3 neighborhood.\n      # If it is, we have found a path to a location from which we can 'USE' the primitive.\n      if _is_next_to_coord(cx, cy, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n          return path_actions + [USE] # Append the USE action and return the full action list\n\n      # Explore all possible movement actions from the current position (cx, cy)\n      for action, (dx, dy) in moves:\n          nx, ny = cx + dx, cy + dy # Calculate the next potential position\n          next_pos = (nx, ny)\n\n          # 1. Check if the next position is within the grid boundaries.\n          if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n              continue # Skip if out of bounds\n\n          # 2. Check if the next position has already been visited during the BFS.\n          if next_pos in visited:\n              continue # Skip if already visited\n\n          # 3. Check traversability: A cell is considered traversable if it does not contain\n          #    any non-traversable (blocking) items.\n          is_traversable = True\n          for block_idx in non_traversable_indices:\n              if grid[nx, ny, block_idx] > 0: # If a blocking item (count > 0) is present at (nx, ny)\n                  is_traversable = False\n                  break # This cell is not traversable, no need to check other blocking items\n          \n          # If the next position is valid, unvisited, and traversable, add it to the queue.\n          if is_traversable:\n              visited.add(next_pos) # Mark the new position as visited\n              # Add the new position and the updated path (current path + the action taken) to the queue\n              queue.append((nx, ny, path_actions + [action]))\n  \n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable. Return an empty list of actions.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:23:17.915115", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n\n  # Check if the primitive name is valid and mapped to an ID.\n  # If primitive_id is None, it means the given 'primitive' string is not\n  # a recognized item in the game's cookbook index. In this case, it cannot\n  # be collected, so we return an empty list of actions.\n  if primitive_id is None:\n      return []\n\n  # Ensure the primitive is a 'grabbable' item. Non-grabbable items (like water,\n  # workshops, or boundaries) cannot be collected into the agent's inventory.\n  # If it's not grabbable, return an empty list of actions as it's impossible to collect.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve action mappings from the environment for clarity and robustness.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Group movement actions for easier iteration during BFS.\n  MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  # Initialize Breadth-First Search (BFS) components.\n  # The queue will store tuples of (current_craft_state, list_of_actions_taken_to_reach_this_state).\n  # `CraftState` objects are suitable as nodes for BFS as they represent the full environment state\n  # relevant for agent's position and interaction.\n  start_state = env._current_state\n  queue = collections.deque([(start_state, [])])\n\n  # The 'visited' set keeps track of states already explored to prevent cycles and redundant work.\n  # A state is uniquely identified by the agent's position and direction. The grid state\n  # does not change during pure movement actions or when looking for a primitive to 'USE'.\n  visited = {(start_state.pos, start_state.dir)}\n\n  # Perform BFS to find the shortest path to a cell adjacent to the primitive.\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # Check if the agent is currently next to the desired primitive.\n    # `current_state.next_to(primitive_id)` efficiently checks the 3x3 neighborhood.\n    if current_state.next_to(primitive_id):\n      # If adjacent, we've found a path. The final action will be 'USE' to collect the item.\n      return path_so_far + [USE]\n\n    # If not adjacent, explore all possible movement actions from the current state.\n    for action in MOVE_ACTIONS:\n      # Simulate taking the action. `CraftState.step` returns a new state object,\n      # which is crucial for BFS as it avoids modifying the state of previously explored paths.\n      _reward, next_state_candidate = current_state.step(action)\n\n      # Extract the identifying components of the next state: position and direction.\n      next_pos = next_state_candidate.pos\n      next_dir = next_state_candidate.dir\n      next_state_identifier = (next_pos, next_dir)\n\n      # If this specific (position, direction) state has not been visited yet, add it to the queue.\n      if next_state_identifier not in visited:\n        visited.add(next_state_identifier)\n        # Enqueue the new state along with the accumulated path to reach it.\n        queue.append((next_state_candidate, path_so_far + [action]))\n\n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:23:19.961206", "function_name": "collect", "function_body": "  # 1. Map the primitive string name to its numerical ID using the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # 2. Early exit check: Determine if the target primitive is a grabbable item.\n  # Non-grabbable entities (e.g., \"WATER\", \"WORKSHOP\", \"BOUNDARY\") cannot be\n  # collected into the agent's inventory. If the primitive is not grabbable,\n  # it's impossible to \"collect\" it, so we return an empty action list.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 3. Retrieve the integer mappings for all possible actions from the environment.\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Group movement actions for convenient iteration during the search.\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # 4. Initialize the Breadth-First Search (BFS) components.\n  # BFS is used because it guarantees finding the shortest path (minimum number of steps)\n  # on an unweighted graph, which applies to this movement scenario.\n\n  # The starting point for the search is the agent's current state.\n  initial_craft_state = env._current_state\n\n  # The BFS queue stores tuples: (CraftState object, list of actions taken to reach this state).\n  # CraftState objects encapsulate all necessary information (position, direction, grid).\n  bfs_queue = collections.deque([(initial_craft_state, [])])\n\n  # The `visited_states` set prevents infinite loops and redundant exploration.\n  # A state is uniquely identified by the agent's (position, direction). The grid\n  # itself remains static for pure movement actions, so we don't need to track\n  # the full grid state in `visited_states`.\n  visited_states = {(initial_craft_state.pos, initial_craft_state.dir)}\n\n  # 5. Execute the BFS algorithm.\n  while bfs_queue:\n    current_state, current_path = bfs_queue.popleft()\n\n    # Check if the agent in the `current_state` is positioned next to the target primitive.\n    # `current_state.next_to()` checks the 3x3 neighborhood around the agent.\n    if current_state.next_to(primitive_id):\n      # If the primitive is adjacent, we have found the shortest path to reach it.\n      # The final action required is 'USE' to pick up the primitive.\n      return current_path + [ACTION_USE]\n\n    # If the primitive is not yet adjacent, explore all possible movement actions\n    # from the `current_state`.\n    for action in MOVE_ACTIONS:\n      # Simulate taking the action. `CraftState.step()` returns a *new* CraftState object,\n      # which is crucial for BFS to avoid modifying previously explored states.\n      # The `_reward` is always 0.0 in this environment, so it's ignored for pathfinding.\n      _reward, next_state = current_state.step(action)\n\n      # Formulate a unique identifier for the `next_state` for the `visited_states` set.\n      next_state_identifier = (next_state.pos, next_state.dir)\n\n      # If this specific (position, direction) combination has not been visited before,\n      # add it to the `visited_states` set and enqueue it for further exploration.\n      if next_state_identifier not in visited_states:\n        visited_states.add(next_state_identifier)\n        bfs_queue.append((next_state, current_path + [action]))\n\n  # 6. If the BFS queue becomes empty, it means all reachable states have been explored,\n  # and the primitive was not found to be adjacent in any of them. Therefore,\n  # the primitive is unreachable from the current agent position.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:24:43.501541", "function_name": "collect", "function_body": "  # Helper function from collect_v0, essential for directional USE action\n  def get_required_facing_direction(agent_y, agent_x, item_y, item_x, action_to_state_dir_map):\n    \"\"\"\n    Determines the required facing direction (as an integer dir from CraftState.dir:\n    0:UP, 1:DOWN, 2:LEFT, 3:RIGHT) for an agent at (agent_y, agent_x) to face\n    an item at (item_y, item_x).\n    Assumes (agent_y, agent_x) and (item_y, item_x) are strictly adjacent (Manhattan distance 1).\n    \"\"\"\n    # Note: CraftState.dir mapping is 0:UP, 1:DOWN, 2:LEFT, 3:RIGHT\n    if item_y == agent_y - 1 and item_x == agent_x:  # Item is North of agent\n      return action_to_state_dir_map['UP']\n    if item_y == agent_y + 1 and item_x == agent_x:  # Item is South of agent\n      return action_to_state_dir_map['DOWN']\n    if item_x == agent_x - 1 and item_y == agent_y:  # Item is West of agent\n      return action_to_state_dir_map['LEFT']\n    if item_x == agent_x + 1 and item_y == agent_y:  # Item is East of agent\n      return action_to_state_dir_map['RIGHT']\n    return None # Should not happen if caller ensures strict adjacency\n\n  # Helper function similar to CraftState.next_to, checks 3x3 neighborhood\n  def _is_next_to_target_kind(check_pos, grid, target_kind_idx):\n    \"\"\"\n    Checks if `check_pos` (y, x) is adjacent to or on a cell containing `target_kind_idx`.\n    This mimics the logic of CraftState.next_to, checking the 3x3 neighborhood.\n    \"\"\"\n    grid_height, grid_width, _ = grid.shape\n    cy, cx = check_pos\n    # Iterate through the 3x3 neighborhood around check_pos (including check_pos itself)\n    for dy_nb in [-1, 0, 1]:\n      for dx_nb in [-1, 0, 1]:\n        nb_y, nb_x = cy + dy_nb, cx + dx_nb\n        # Ensure neighbor coordinates are within grid boundaries\n        if 0 <= nb_y < grid_height and 0 <= nb_x < grid_width:\n          # Check if the neighbor cell contains the target primitive\n          if grid[nb_y, nb_x, target_kind_idx] == 1:\n            return True\n    return False\n\n  # 1. Get environment details and primitive ID\n  # The DSL ensures 'primitive' is a valid string (e.g., 'WOOD', 'STONE').\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings for clarity and direct use\n  action_map = env.action_specs()\n  # Standardized action IDs from env.action_specs()\n  DOWN_ACTION = action_map['DOWN']\n  UP_ACTION = action_map['UP']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  start_pos = current_state.pos  # Agent's current position (y, x) tuple\n  start_dir = current_state.dir  # Agent's current facing direction (0:UP, 1:DOWN, 2:LEFT, 3:RIGHT)\n  current_grid = current_state.grid # The full grid as a numpy array (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Determine if the primitive requires a 'USE' action after reaching proximity\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Identify indices of entities that block movement (e.g., water, boundaries, non-movable workshops)\n  non_walkable_indices = env.world.non_grabbable_indices\n\n  # Map move action IDs to their corresponding (dy, dx) deltas\n  action_id_to_delta = {\n      UP_ACTION: (-1, 0),\n      DOWN_ACTION: (1, 0),\n      LEFT_ACTION: (0, -1),\n      RIGHT_ACTION: (0, 1),\n  }\n  move_actions = [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]\n\n  # Map action ID to CraftState.dir integer (0:UP, 1:DOWN, 2:LEFT, 3:RIGHT)\n  # This is crucial because CraftState.dir values are different from action_map's integer IDs.\n  action_to_state_dir = {\n      UP_ACTION: 0, # CraftState.dir for UP\n      DOWN_ACTION: 1, # CraftState.dir for DOWN\n      LEFT_ACTION: 2, # CraftState.dir for LEFT\n      RIGHT_ACTION: 3, # CraftState.dir for RIGHT\n  }\n\n  # 2. BFS Setup: Queue stores (current_y, current_x, current_direction_int, path_to_here_list)\n  # The direction_int is the value from CraftState.dir (0-3).\n  q = collections.deque([(start_pos[0], start_pos[1], start_dir, [])])\n  \n  # Visited set: stores (y, x, direction_int) to prevent cycles and redundant exploration.\n  # A cell can be revisited if the agent arrives facing a different direction.\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    curr_y, curr_x, curr_dir, path = q.popleft()\n\n    # 3. Goal Check at current state (curr_y, curr_x, curr_dir)\n    if is_grabbable:\n      # For grabbable items, the goal is to be adjacent to the item AND facing it.\n      # Check all 4 cardinal neighbors of the current position.\n      for action in move_actions: # Iterate using action IDs to get relevant deltas and target directions\n        dy, dx = action_id_to_delta[action]\n        nb_y, nb_x = curr_y + dy, curr_x + dx\n        \n        # Check if the neighbor is within grid bounds and contains the primitive.\n        if (0 <= nb_y < grid_height and 0 <= nb_x < grid_width and\n            current_grid[nb_y, nb_x, primitive_idx] == 1):\n          \n          # If found, check if the agent's current direction is facing this specific neighbor.\n          # We need to map the \"action\" that would move to this neighbor to the CraftState.dir value.\n          required_dir = action_to_state_dir[action]\n          if curr_dir == required_dir:\n            # Found a path to (curr_y, curr_x) where the agent is correctly oriented\n            # to USE the grabbable item at (nb_y, nb_x).\n            return path + [USE_ACTION]\n    else:\n      # For non-grabbable items (e.g., workshops, water), reaching proximity is enough.\n      # No specific facing direction required beyond being adjacent (or on the same cell).\n      if _is_next_to_target_kind((curr_y, curr_x), current_grid, primitive_idx):\n        return path # \"Collecting\" implies reaching the interaction range for non-grabbables.\n\n    # 4. Explore valid neighboring cells by simulating moves\n    for action in move_actions:\n      dy, dx = action_id_to_delta[action]\n      next_y, next_x = curr_y + dy, curr_x + dx\n      next_dir_state = action_to_state_dir[action] # Agent's new direction after this move\n\n      # Check grid boundaries\n      if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n        continue\n\n      # Check for impassable terrain: agent cannot move onto cells containing non-walkable entities.\n      is_blocked = False\n      for k_blocked in non_walkable_indices:\n        if current_grid[next_y, next_x, k_blocked] == 1:\n          is_blocked = True\n          break\n      if is_blocked:\n        continue\n\n      # If this specific (position, direction) state has not been visited, add to queue\n      if (next_y, next_x, next_dir_state) not in visited:\n        visited.add((next_y, next_x, next_dir_state))\n        q.append((next_y, next_x, next_dir_state, path + [action]))\n\n  # 5. If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:24:45.559605", "function_name": "collect", "function_body": "  # Helper function to determine if a target kind is in the 3x3 neighborhood around a given position\n  def _is_target_in_neighborhood(check_y, check_x, target_kind_idx, grid):\n    grid_height, grid_width, _ = grid.shape\n    for dy_nb in [-1, 0, 1]:\n      for dx_nb in [-1, 0, 1]:\n        nb_y, nb_x = check_y + dy_nb, check_x + dx_nb\n        # Ensure neighbor coordinates are within grid boundaries\n        if 0 <= nb_y < grid_height and 0 <= nb_x < grid_width:\n          # Check if the neighbor cell contains the target primitive\n          if grid[nb_y, nb_x, target_kind_idx] == 1:\n            return True\n    return False\n\n  # Helper function to get the required action ID (UP, DOWN, LEFT, RIGHT)\n  # for an agent at (agent_y, agent_x) to face an item at (item_y, item_x).\n  # Assumes (agent_y, agent_x) and (item_y, item_x) are strictly adjacent.\n  def _get_facing_direction_action_id(agent_y, agent_x, item_y, item_x, action_map):\n    if item_y == agent_y - 1 and item_x == agent_x:  # Item is North of agent\n      return action_map['UP']\n    if item_y == agent_y + 1 and item_x == agent_x:  # Item is South of agent\n      return action_map['DOWN']\n    if item_x == agent_x - 1 and item_y == agent_y:  # Item is West of agent\n      return action_map['LEFT']\n    if item_x == agent_x + 1 and item_y == agent_y:  # Item is East of agent\n      return action_map['RIGHT']\n    return None # Should not happen if caller ensures strict adjacency\n\n  # 1. Get environment details and primitive ID\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings for clarity and direct use\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Map move action IDs to their corresponding (dy, dx) deltas\n  action_id_to_delta = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1),\n  }\n  move_actions = [UP, DOWN, LEFT, RIGHT] # List of possible move actions\n\n  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  start_y, start_x = current_state.pos # Agent's current position (y, x) tuple\n  \n  # CraftState.dir is an int (0:UP, 1:DOWN, 2:LEFT, 3:RIGHT).\n  # We need to map this to the corresponding action_map ID for consistency in BFS state.\n  craftstate_dir_to_action_id = {\n      0: UP,   # CraftState's 0 (UP) maps to action_map['UP']\n      1: DOWN, # CraftState's 1 (DOWN) maps to action_map['DOWN']\n      2: LEFT, # CraftState's 2 (LEFT) maps to action_map['LEFT']\n      3: RIGHT # CraftState's 3 (RIGHT) maps to action_map['RIGHT']\n  }\n  initial_facing_action_id = craftstate_dir_to_action_id[current_state.dir]\n\n  current_grid = current_state.grid # The full grid as a numpy array (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Determine if the primitive requires a 'USE' action after reaching proximity\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Identify indices of entities that block movement (e.g., water, boundary)\n  non_walkable_indices = env.world.non_grabbable_indices\n\n  # 2. BFS Setup: Queue stores (current_y, current_x, current_facing_action_id, path_to_here_list)\n  q = collections.deque([(start_y, start_x, initial_facing_action_id, [])])\n  # Visited set: stores (y, x, current_facing_action_id) to prevent cycles and redundant exploration.\n  visited = {(start_y, start_x, initial_facing_action_id)}\n\n  # Find all actual locations of the primitive on the grid.\n  primitive_actual_locations = [tuple(loc) for loc in np.argwhere(current_grid[:, :, primitive_idx] == 1)]\n  if not primitive_actual_locations:\n      return [] # Primitive not present on the grid\n\n  # 3. BFS Loop: Explore the grid to find the target\n  while q:\n    curr_y, curr_x, curr_dir_action_id, path = q.popleft()\n\n    # Check goal condition at the current position and facing direction\n    # We iterate through all potential primitive locations to find if one satisfies the goal.\n    for p_y, p_x in primitive_actual_locations:\n        # Check if the agent is at or adjacent to the primitive location\n        # Manhattan distance: 0 means on the same cell, 1 means strictly adjacent (N,S,E,W)\n        manhattan_dist = abs(curr_y - p_y) + abs(curr_x - p_x)\n\n        if is_grabbable:\n            # For grabbable items, the goal is to be adjacent to the item AND facing it.\n            if manhattan_dist == 1:\n                required_dir = _get_facing_direction_action_id(curr_y, curr_x, p_y, p_x, action_map)\n                if required_dir is not None and curr_dir_action_id == required_dir:\n                    # Found a path to an adjacent cell, facing the item.\n                    return path + [USE] # Append USE action to collect it.\n        else:\n            # For non-grabbable items (e.g., workshops, water, stone), the goal is to be:\n            #   - On the same cell (for workshops, etc.)\n            #   - Adjacent (for water, stone, etc., which you might interact with from a distance)\n            # Both cases imply being within the 3x3 neighborhood.\n            if manhattan_dist <= 1: # On the same cell or adjacent\n                # Found a path to a cell from which the non-grabbable item can be interacted with.\n                # No USE action is generally needed for 'collecting' non-grabbables;\n                # simply reaching the location is the 'collection' goal.\n                return path\n\n    # Explore valid neighboring cells for movement from the current position\n    for action in move_actions:\n      dy, dx = action_id_to_delta[action]\n      next_y, next_x = curr_y + dy, curr_x + dx\n      next_dir_action_id = action  # After a move action, the agent's direction updates to that action's direction.\n\n      # Check grid boundaries\n      if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n        continue\n\n      # Check for impassable terrain: if the next cell contains any non-walkable index\n      is_blocked = False\n      for k_blocked in non_walkable_indices:\n        if current_grid[next_y, next_x, k_blocked] == 1:\n          is_blocked = True\n          break\n      if is_blocked:\n        continue # Cannot move to this cell, skip to next neighbor\n\n      # If this specific (position, direction) state has not been visited, add to queue\n      if (next_y, next_x, next_dir_action_id) not in visited:\n        visited.add((next_y, next_x, next_dir_action_id))\n        q.append((next_y, next_x, next_dir_action_id, path + [action]))\n\n  # 4. If the BFS loop completes and no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:25:39.662743", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook_index = env.world.cookbook.index\n\n  # 1. Get Primitive Index: Map the string name to its integer ID.\n  primitive_idx = cookbook_index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized or has no ID, it cannot be collected.\n      return []\n\n  # 2. Define action mappings for clarity.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 3. Determine \"uncollectable_non_interactable_indices\".\n  # These are entities that are non-grabbable AND cannot be meaningfully interacted with\n  # via 'USE' in the context of 'collect' (e.g., water, stone, boundary).\n  # Workshops ARE non-grabbable but ARE interactable via 'USE' for crafting, so they are excluded here.\n  uncollectable_non_interactable_indices = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  if primitive_idx in uncollectable_non_interactable_indices:\n      # If the primitive is something like WATER, STONE, or BOUNDARY,\n      # it cannot be collected into inventory or otherwise \"used\" for acquisition.\n      return []\n\n  # 4. Check Inventory: If the primitive is a grabbable item and already in inventory, no actions are needed.\n  # This check applies only to grabbable items, as workshops are not stored in inventory.\n  if primitive_idx in env.world.grabbable_indices and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 5. Early Exit - Check if the primitive is already in the agent's 3x3 neighborhood.\n  # If so, a single USE_ACTION is sufficient from the current position to collect/interact.\n  # This leverages the CraftState.next_to method.\n  if current_state.next_to(primitive_idx):\n      return [USE_ACTION]\n\n  # 6. Initialize BFS for pathfinding.\n  start_pos = current_state.pos # Agent's current position (y, x)\n  grid = current_state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Queue stores tuples: (current_y, current_x, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos[0], start_pos[1], [])])\n  # Set to keep track of visited grid cells to avoid cycles and redundant paths.\n  visited = {(start_pos[0], start_pos[1])}\n\n  # Define possible movements (dy, dx) and their corresponding action IDs.\n  # (dy, dx, action_id) where (dy, dx) is change in (row, column).\n  move_deltas = [\n      (-1, 0, UP_ACTION),    # Move Up (decrease y)\n      (1, 0, DOWN_ACTION),   # Move Down (increase y)\n      (0, -1, LEFT_ACTION),  # Move Left (decrease x)\n      (0, 1, RIGHT_ACTION)   # Move Right (increase x)\n  ]\n\n  # Define impassable terrain for agent movement.\n  # Agent cannot move onto cells containing these kinds.\n  # This set correctly includes water, stone, and boundary, but excludes workshops,\n  # allowing the agent to move onto workshop locations.\n  impassable_for_movement_indices = uncollectable_non_interactable_indices\n\n  while q:\n      curr_y, curr_x, path_so_far = q.popleft()\n\n      # Check if the current agent position (curr_y, curr_x) is adjacent to the target primitive.\n      # The 'USE' action operates on items in the 3x3 neighborhood around the agent.\n      is_adjacent_to_primitive = False\n      for dy_adj in [-1, 0, 1]:\n          for dx_adj in [-1, 0, 1]:\n              check_y, check_x = curr_y + dy_adj, curr_x + dx_adj\n              # Ensure the checked coordinates are within grid bounds.\n              if 0 <= check_y < HEIGHT and 0 <= check_x < WIDTH:\n                  # Check if the primitive kind exists at this neighboring location.\n                  # The grid stores 1 if the kind is present, 0 otherwise.\n                  if grid[check_y, check_x, primitive_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break # Found the primitive in the neighborhood.\n          if is_adjacent_to_primitive:\n              break\n\n      if is_adjacent_to_primitive:\n          # We have found the shortest path to a position from which\n          # the primitive can be 'used' (collected or interacted with).\n          return path_so_far + [USE_ACTION]\n\n      # Explore adjacent cells for movement.\n      for dy_move, dx_move, action_to_take in move_deltas:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check if the next cell is within grid bounds.\n          if not (0 <= next_y < HEIGHT and 0 <= next_x < WIDTH):\n              continue\n\n          # Check if the cell has already been visited during this BFS.\n          if (next_y, next_x) in visited:\n              continue\n\n          # Check if the next cell is traversable.\n          # A cell is traversable if it does not contain any 'impassable' kind.\n          is_traversable = True\n          for kind_idx in impassable_for_movement_indices:\n              if grid[next_y, next_x, kind_idx] == 1: # If this impassable kind is present at the target cell\n                  is_traversable = False\n                  break\n          \n          if is_traversable:\n              visited.add((next_y, next_x))\n              q.append((next_y, next_x, path_so_far + [action_to_take]))\n\n  # If the BFS completes and no path to an adjacent primitive was found,\n  # it means the primitive is either not on the map or unreachable given current capabilities.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:25:41.743768", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook_index = env.world.cookbook.index\n\n  # 1. Map the string primitive name to its integer ID using the cookbook index.\n  primitive_idx = cookbook_index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized or does not have an ID,\n      # it cannot be collected, so return an empty action list.\n      return []\n\n  # 2. Determine if the primitive is 'grabbable' (can be collected into inventory).\n  # Non-grabbable items (like WATER, STONE, WORKSHOPS, BOUNDARY) cannot be collected\n  # into inventory using the 'USE' action in the same way as resources.\n  # The 'collect' DSL action implies putting an item into inventory.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return []\n\n  # 3. Retrieve action mappings from the environment's action_specs.\n  # This ensures compatibility with different action ID assignments.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 4. Check if the primitive is already in the agent's inventory.\n  # If so, no actions are needed to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 5. Early Exit: Check if the primitive is immediately accessible (in the 3x3 neighborhood).\n  # If the agent is already next to the primitive, only a single USE_ACTION is required.\n  # This avoids initiating a BFS if the goal is already within reach.\n  if current_state.next_to(primitive_idx):\n      return [USE_ACTION]\n\n  # 6. Initialize Breadth-First Search (BFS) for pathfinding to the primitive.\n  # BFS guarantees the shortest path in terms of number of moves on an unweighted grid.\n  start_pos = current_state.pos  # Agent's current position (row, column)\n  grid = current_state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Queue stores tuples: (current_y, current_x, list_of_actions_to_reach_here)\n  # The path_so_far list records the sequence of movement actions.\n  q = collections.deque([(start_pos[0], start_pos[1], [])])\n  # Set to keep track of visited grid cells to prevent cycles and redundant exploration.\n  visited = {(start_pos[0], start_pos[1])}\n\n  # Define possible movements (dy, dx) and their corresponding action IDs.\n  # (dy, dx) represents the change in (row, column) for each movement.\n  move_deltas = [\n      (-1, 0, UP_ACTION),    # Move Up (decrease row index)\n      (1, 0, DOWN_ACTION),   # Move Down (increase row index)\n      (0, -1, LEFT_ACTION),  # Move Left (decrease column index)\n      (0, 1, RIGHT_ACTION)   # Move Right (increase column index)\n  ]\n\n  # Identify entity kinds that block agent movement.\n  # These are typically non-grabbable entities like BOUNDARY, WATER, STONE.\n  # Workshops (WORKSHOP0/1/2) are non-grabbable but are traversable by the agent,\n  # so they are excluded from the impassable set.\n  impassable_indices_for_movement = set(env.world.non_grabbable_indices) - set(env.world.workshop_indices)\n\n  while q:\n      curr_y, curr_x, path_so_far = q.popleft()\n\n      # Check if the current agent position (curr_y, curr_x) is adjacent to the primitive.\n      # The 'USE' action affects the 3x3 neighborhood around the agent's current position.\n      is_adjacent_to_primitive = False\n      for dy_adj in [-1, 0, 1]:\n          for dx_adj in [-1, 0, 1]:\n              check_y, check_x = curr_y + dy_adj, curr_x + dx_adj\n              # Ensure the checked coordinates are within grid bounds.\n              if 0 <= check_y < HEIGHT and 0 <= check_x < WIDTH:\n                  # Check if the primitive kind is present at this neighboring location.\n                  # The grid stores 1 if the kind is present, 0 otherwise.\n                  if grid[check_y, check_x, primitive_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break  # Found the primitive in the neighborhood.\n          if is_adjacent_to_primitive:\n              break\n\n      if is_adjacent_to_primitive:\n          # If the current position is adjacent to the primitive,\n          # we have found the shortest path to a valid collection point.\n          # Append the USE_ACTION to the path and return it.\n          return path_so_far + [USE_ACTION]\n\n      # Explore adjacent cells for potential movement.\n      for dy_move, dx_move, action_to_take in move_deltas:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check if the next cell is within grid boundaries.\n          if not (0 <= next_y < HEIGHT and 0 <= next_x < WIDTH):\n              continue\n\n          # Check if the cell has already been visited during this BFS traversal.\n          if (next_y, next_x) in visited:\n              continue\n\n          # Determine if the next cell is traversable.\n          # A cell is traversable if it does not contain any of the identified impassable kinds.\n          is_traversable = True\n          for kind_idx in impassable_indices_for_movement:\n              if grid[next_y, next_x, kind_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if is_traversable:\n              # Mark the cell as visited and add it to the queue for further exploration,\n              # along with the path taken to reach it.\n              visited.add((next_y, next_x))\n              q.append((next_y, next_x, path_so_far + [action_to_take]))\n\n  # If the BFS completes and no path to an adjacent primitive was found,\n  # it means the primitive is either not on the map, is completely surrounded\n  # by impassable terrain, or is otherwise unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:26:26.925362", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Dynamically retrieve action IDs from the environment's action_specs\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Map movement action IDs to (dr, dc) for pathfinding\n  action_deltas = {\n      UP: (-1, 0),\n      DOWN: (1, 0),\n      LEFT: (0, -1),\n      RIGHT: (0, 1)\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Retrieve primitive ID; assumes primitive is a valid name that exists in the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get relevant indices from the world configuration\n  non_grabbable_indices = env.world.non_grabbable_indices # This is already a set\n  workshop_indices = set(env.world.workshop_indices) # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop (requires being adjacent)\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to determine if a given cell is blocked for movement.\n  # A cell is blocked if it contains *any* non-grabbable item (e.g., water, stone, workshops).\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if out of bounds\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Iterate through the non-grabbable indices and check if any are present at (r, c).\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0: \n              return True\n      return False\n      \n  # Define Target Positions for BFS\n  # These are the cells the agent needs to reach to interact with the primitive.\n  potential_target_positions = set()\n  \n  if is_workshop_primitive:\n      # If the primitive is a workshop, the agent needs to move to a cell *adjacent* to it.\n      # First, find all locations on the grid where this specific workshop type exists.\n      workshop_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      # For each workshop location, identify its valid, unblocked neighbors.\n      for wr, wc in workshop_locations_on_grid:\n          for action_move_id, (dr, dc) in action_deltas.items(): # Iterate over (dr, dc) for cardinal neighbors\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      for r in range(rows):\n          for c in range(cols):\n              if grid[r, c, primitive_id] > 0:\n                  current_cell_pos = (r, c)\n                  # Only consider it a target if the cell itself is not blocked for movement.\n                  # This filters out resources that might be in impassable terrain (e.g., wood on water).\n                  if not is_blocked_for_movement(current_cell_pos):\n                      potential_target_positions.add(current_cell_pos)\n\n  if not potential_target_positions:\n      # The primitive (or a valid adjacent spot for a workshop) was not found on the map,\n      # or all instances are in blocked locations.\n      return []\n\n  # BFS to find the shortest path to any target position\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to store visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n  \n  best_path = [] # This will store the shortest path found\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in potential_target_positions:\n          best_path = path_so_far\n          break # Exit BFS, as the first path found is guaranteed to be the shortest.\n\n      # Explore neighbors\n      for action_move_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not visited and not blocked), add it to the queue\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_move_id]))\n              \n  if best_path: # If a path was found (best_path is not empty)\n      # Append the 'USE' action to collect/interact with the primitive after reaching the target.\n      actions = best_path + [USE] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:26:28.944659", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Map action IDs to (dr, dc) for pathfinding\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Retrieve primitive ID; assumes primitive is a valid name that exists in the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get relevant indices from the world configuration\n  non_grabbable_indices = env.world.non_grabbable_indices # This is already a set\n  workshop_indices = set(env.world.workshop_indices) # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to determine if a given cell is blocked for movement.\n  # A cell is blocked if it contains *any* non-grabbable item (e.g., water, stone, workshops).\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if out of bounds\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Iterate through the *known* non-grabbable indices and check if any are present at (r, c).\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0: # If this specific non-grabbable kind is present and has a count > 0\n              return True\n      return False\n      \n  # --- Define Target Positions for BFS ---\n  # These are the cells the agent needs to reach to interact with the primitive.\n  potential_target_positions = set()\n  \n  if is_workshop_primitive:\n      # If the primitive is a workshop, the agent needs to move to a cell *adjacent* to it.\n      # First, find all locations on the grid where this specific workshop type exists.\n      workshop_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      # For each workshop location, identify its valid, unblocked neighbors.\n      for wr, wc in workshop_locations_on_grid:\n          for dr, dc in action_deltas.values(): # Iterate over (dr, dc) for cardinal neighbors\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      for r in range(rows):\n          for c in range(cols):\n              if grid[r, c, primitive_id] > 0:\n                  current_cell_pos = (r, c)\n                  # Only consider it a target if the cell itself is not blocked for movement.\n                  # This filters out resources that might be in impassable terrain (e.g., wood on water).\n                  if not is_blocked_for_movement(current_cell_pos):\n                      potential_target_positions.add(current_cell_pos)\n\n  if not potential_target_positions:\n      # The primitive (or a valid adjacent spot for a workshop) was not found on the map,\n      # or all instances are in blocked locations.\n      return []\n\n  # --- BFS to find the shortest path to any target position ---\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to store visited positions to avoid cycles and redundant exploration\n  visited = {start_pos}\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in potential_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not visited and not blocked), add it to the queue\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path was found, append the 'USE' action to collect/interact with the primitive.\n      # The 'USE' action (ID 4) is applied after reaching the target position.\n      actions = best_path + [4] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:27:07.627931", "function_name": "collect", "function_body": "  initial_state = env._current_state\n  world = initial_state.world\n  cookbook = world.cookbook\n\n  # Get numeric action mappings from the environment (e.g., {\"UP\": 1, \"DOWN\": 0, \"USE\": 4, ...})\n  action_specs = env.action_specs()\n  UP = action_specs['UP']\n  DOWN = action_specs['DOWN']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE']\n\n  # Define the set of movement actions for BFS exploration.\n  moves = [UP, DOWN, LEFT, RIGHT] \n\n  # Get the integer ID for the primitive.\n  # The DSL uses uppercase (e.g., WOOD), but the cookbook's index typically uses lowercase (e.g., wood).\n  try:\n      primitive_idx = cookbook.index.index(primitive.lower())\n  except KeyError:\n      # If the primitive name is not found in the cookbook's index, it cannot be collected.\n      return []\n\n  # A 'collect' action implies adding the item to the agent's inventory.\n  # If the primitive is a non-grabbable environment entity (e.g., a workshop, water, or boundary),\n  # it cannot be picked up and added to inventory. In such cases, return an empty action list.\n  # The `world.non_grabbable_indices` set contains IDs of all non-collectible items.\n  if primitive_idx in world.non_grabbable_indices:\n      return []\n\n  # BFS (Breadth-First Search) setup for pathfinding:\n  # The queue stores tuples: (current_CraftState_object, list_of_actions_taken_to_reach_this_state).\n  # CraftState.step() returns a *new* CraftState object, which is ideal for simulating paths\n  # without modifying the actual environment state.\n  queue = collections.deque([(initial_state, [])]) \n  \n  # The 'visited' set keeps track of (x, y) positions already explored to prevent cycles\n  # and redundant computation in the BFS. For `collect`, only position is usually sufficient\n  # to track visited states, as inventory and other attributes are not relevant for pathfinding\n  # to the item's location.\n  visited = {(initial_state.pos[0], initial_state.pos[1])}\n\n  # Optimization: Check if the primitive is already next to the agent's initial position.\n  # If so, we can immediately perform the 'USE' action.\n  if initial_state.next_to(primitive_idx):\n      return [USE]\n\n  # Perform Breadth-First Search to find the shortest path to a location adjacent to the primitive.\n  while queue:\n      current_sim_state, path_actions = queue.popleft() # Dequeue the current simulated state and its path\n\n      # Explore all possible movement actions from the current simulated state\n      for action in moves:\n          # Simulate taking this action. CraftState.step returns (reward, new_state).\n          # The reward is not relevant for pathfinding in this context.\n          _, next_sim_state = current_sim_state.step(action)\n          \n          # Get the position of the next simulated state.\n          nx, ny = next_sim_state.pos \n          next_pos_tuple = (nx, ny)\n\n          # Check if the next position has already been visited during the BFS.\n          # This also implicitly handles cases where the agent tried to move into an obstacle\n          # (as the position would not change, `nx, ny` would be `current_sim_state.pos`,\n          # which would already be in `visited`).\n          if next_pos_tuple in visited:\n              continue\n\n          # Mark the new position as visited.\n          visited.add(next_pos_tuple)\n          \n          # Check if the target primitive is now in the 3x3 neighborhood of `next_sim_state`.\n          # `CraftState.next_to(i_kind)` conveniently checks this.\n          if next_sim_state.next_to(primitive_idx):\n              # If it is, we have found a path to a location from which we can 'USE' the primitive.\n              # Append the 'USE' action and return the full action list.\n              return path_actions + [action, USE] \n          \n          # If the primitive is not next to `next_sim_state`, but the position is new and valid,\n          # add this `next_sim_state` to the queue for further exploration.\n          queue.append((next_sim_state, path_actions + [action]))\n  \n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable. Return an empty list of actions.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:27:09.677110", "function_name": "collect", "function_body": "  def _is_next_to_coord(cx, cy, i_kind, grid, GRID_WIDTH, GRID_HEIGHT):\n      \"\"\"\n      Helper function to check if a specific item kind (i_kind) is present\n      in the 3x3 neighborhood (including the center cell) around coordinates (cx, cy).\n      \n      Args:\n          cx (int): The current x-coordinate (column).\n          cy (int): The current y-coordinate (row).\n          i_kind (int): The integer index of the item kind to search for.\n          grid (numpy.ndarray): The current grid state, shape (WIDTH, HEIGHT, n_kinds).\n          GRID_WIDTH (int): Width of the grid.\n          GRID_HEIGHT (int): Height of the grid.\n          \n      Returns:\n          bool: True if the item kind is found in the 3x3 neighborhood, False otherwise.\n      \"\"\"\n      # Iterate through a 3x3 neighborhood around (cx, cy), including (cx, cy) itself.\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              nx, ny = cx + dx_offset, cy + dy_offset\n\n              # Check bounds: Ensure the neighbor coordinates are within the grid.\n              if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n                  continue # Skip if out of bounds.\n              \n              # Check if the specified item kind is present at the neighbor location.\n              # grid[x, y, kind_idx] > 0 indicates presence of the item.\n              if grid[nx, ny, i_kind] > 0: \n                  return True # Found the item in the neighborhood.\n      return False # Item not found in the neighborhood.\n\n  # Get the current state information from the environment.\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  grid = current_state.grid\n  start_pos_x, start_pos_y = current_state.pos # Agent's current position (x, y)\n  \n  # Get grid dimensions and total number of kinds.\n  GRID_WIDTH, GRID_HEIGHT, N_KINDS = grid.shape # grid has shape (WIDTH, HEIGHT, n_kinds)\n\n  # Convert the DSL primitive name (e.g., \"WOOD\") to its integer index.\n  # The cookbook's index typically stores names in lowercase (e.g., \"wood\").\n  try:\n      primitive_idx = cookbook.index.index(primitive.lower())\n  except KeyError:\n      # If the primitive name is not recognized by the cookbook, it cannot be collected.\n      return []\n\n  # A 'collect' action implies picking up an item and adding it to inventory.\n  # Check if the target primitive is actually something that can be picked up.\n  # Items in `world.non_grabbable_indices` cannot be collected (e.g., workshops, water, boundaries).\n  if primitive_idx in world.non_grabbable_indices:\n      return [] # Return empty list if the item is not grabbable.\n\n  # Get numeric action mappings from the environment's action_specs.\n  # These are integers representing actions (e.g., 0 for DOWN, 1 for UP, etc.).\n  action_specs = env.action_specs()\n  UP = action_specs['UP']\n  DOWN = action_specs['DOWN']\n  LEFT = action_specs['LEFT']\n  RIGHT = action_specs['RIGHT']\n  USE = action_specs['USE'] # Action to interact with an adjacent item.\n\n  # Define possible movement actions and their corresponding (dx, dy) coordinate changes.\n  # dx: change in x-coordinate (column), dy: change in y-coordinate (row).\n  moves = [\n      (UP, (0, -1)),    # UP: moves one step in negative y-direction.\n      (DOWN, (0, 1)),   # DOWN: moves one step in positive y-direction.\n      (LEFT, (-1, 0)),  # LEFT: moves one step in negative x-direction.\n      (RIGHT, (1, 0)),  # RIGHT: moves one step in positive x-direction.\n  ]\n\n  # BFS (Breadth-First Search) initialization for pathfinding:\n  # The queue stores tuples: (current_x, current_y, list_of_actions_taken_to_reach_here).\n  queue = collections.deque([(start_pos_x, start_pos_y, [])]) \n  \n  # The 'visited' set keeps track of (x, y) positions already explored during BFS.\n  # This prevents redundant computations and infinite loops in cyclic paths.\n  visited = {(start_pos_x, start_pos_y)}\n\n  # Define indices of entities that block agent movement (non-traversable terrain).\n  # In CraftWorld, non-grabbable items often also function as non-traversable terrain.\n  non_traversable_indices = world.non_grabbable_indices \n\n  # Optimization: Check if the primitive is already in the agent's immediate vicinity\n  # (3x3 neighborhood) at the starting position. If so, only a 'USE' action is needed.\n  if _is_next_to_coord(start_pos_x, start_pos_y, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n      return [USE]\n\n  # Perform Breadth-First Search to find the shortest path to a location\n  # from which the primitive can be collected (i.e., a cell adjacent to it).\n  while queue:\n      cx, cy, path_actions = queue.popleft() # Dequeue the current position and its path.\n\n      # After moving to (cx, cy), check if the target primitive is now in the 3x3 neighborhood.\n      # If it is, we've found a path to a suitable position.\n      if _is_next_to_coord(cx, cy, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n          # Append the 'USE' action to the path and return the complete action list.\n          return path_actions + [USE]\n\n      # Explore all possible movement actions from the current position (cx, cy).\n      for action, (dx, dy) in moves:\n          nx, ny = cx + dx, cy + dy # Calculate the next potential position.\n          next_pos = (nx, ny)\n\n          # 1. Check if the next position is within the grid boundaries.\n          if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n              continue # Skip if the move goes out of bounds.\n\n          # 2. Check if the next position has already been visited by BFS.\n          if next_pos in visited:\n              continue # Skip if already processed.\n\n          # 3. Check traversability: A cell is considered traversable if it does not contain\n          #    any blocking (non-traversable) items.\n          is_traversable = True\n          for block_idx in non_traversable_indices:\n              if grid[nx, ny, block_idx] > 0: # If a blocking item is present at (nx, ny).\n                  is_traversable = False\n                  break # This cell is not traversable; stop checking other blockers.\n          \n          # If the next position is valid (in-bounds, unvisited, and traversable), add it to the queue.\n          if is_traversable:\n              visited.add(next_pos) # Mark the new position as visited.\n              # Enqueue the new position along with the updated path (current path + the taken action).\n              queue.append((nx, ny, path_actions + [action]))\n  \n  # If the BFS queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable on the current grid.\n  return [] # Return an empty list, indicating no actions can collect the primitive.", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:28:32.027315", "function_name": "collect", "function_body": "  state = env._current_state\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in index, cannot collect\n    return []\n\n  # Determine properties of the primitive\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n\n  # Get action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define movement actions and their effects on (dr, dc, new_dir_value)\n  # new_dir_value corresponds to agent's internal state.dir (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  action_moves = {\n      ACTION_UP:    (-1, 0, 0), # Action UP moves to (r-1, c) and agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),  # Action DOWN moves to (r+1, c) and agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3), # Action LEFT moves to (r, c-1) and agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),  # Action RIGHT moves to (r, c+1) and agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell based on agent's direction (for ACTION_USE or facing workshop)\n  dir_to_target_delta = {\n      0: (-1, 0),  # Agent facing UP (dir 0) targets cell above (r-1, c)\n      1: (0, 1),   # Agent facing RIGHT (dir 1) targets cell to the right (r, c+1)\n      2: (1, 0),   # Agent facing DOWN (dir 2) targets cell below (r+1, c)\n      3: (0, -1),  # Agent facing LEFT (dir 3) targets cell to the left (r, c-1)\n  }\n\n  start_pos = state.pos  # Agent's current position (row, col)\n  start_dir = state.dir  # Agent's current facing direction (int: 0-3)\n  grid = state.grid      # Current grid layout (WIDTH, HEIGHT, n_kinds)\n  \n  grid_rows, grid_cols, _ = grid.shape # Dimensions of the grid\n\n  # --- Handle immediate collection if agent is already in a state to collect ---\n  # Check if agent is already holding a grabbable item\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n      return [] # Already collected\n\n  # Calculate the cell directly in front of the agent from the start position\n  current_target_dr, current_target_dc = dir_to_target_delta[start_dir]\n  current_target_r, current_target_c = start_pos[0] + current_target_dr, start_pos[1] + current_target_dc\n\n  # Check if current_target_cell is within bounds\n  is_current_target_valid = (0 <= current_target_r < grid_rows and 0 <= current_target_c < grid_cols)\n\n  if is_grabbable:\n      # If grabbable, needs to be adjacent and USE it\n      if is_current_target_valid and grid[current_target_r, current_target_c, primitive_idx] == 1:\n          return [ACTION_USE]\n  elif is_workshop:\n      # If workshop, needs to be adjacent and facing it.\n      if is_current_target_valid and grid[current_target_r, current_target_c, primitive_idx] == 1:\n          return [] # Already in position to interact with workshop\n  else:\n      # For other non-grabbable items (e.g., WATER, STONE, if they are meant to be 'collected' by stepping on them)\n      # Check if agent is already standing on the primitive\n      if grid[start_pos[0], start_pos[1], primitive_idx] == 1:\n          return [] # Already on the primitive\n\n  # --- BFS Pathfinding Setup ---\n  # Using collections.deque for efficient queue operations.\n  q = collections.deque() \n  # Queue stores tuples: (current_pos_r, current_pos_c, current_dir, list_of_actions_to_reach_here)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n\n  # Visited set: (pos_r, pos_c, current_dir) to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Get the set of indices for non-grabbable items that act as general obstacles\n  general_obstacles = env.world.non_grabbable_indices \n\n  # --- BFS Pathfinding Loop ---\n  while q:\n    r, c, current_dir, path = q.popleft() # Current position, direction, and path to reach it\n\n    # Explore neighbors by taking movement actions\n    for action_id, (dr, dc, new_dir) in action_moves.items():\n      next_r, next_c = r + dr, c + dc\n      next_state_dir = new_dir # Agent's direction after this movement\n\n      # 1. Check bounds: ensure the new agent position is within the grid\n      if not (0 <= next_r < grid_rows and 0 <= next_c < grid_cols):\n        continue\n\n      # 2. Check if this (position, direction) state has already been visited\n      if (next_r, next_c, next_state_dir) in visited:\n        continue\n      \n      # 3. Check for obstacles at the next position (next_r, next_c)\n      is_impassable_obstacle = False\n      for k_idx in general_obstacles:\n          if grid[next_r, next_c, k_idx] > 0: # If this cell contains a non-grabbable item\n              # Special condition: if the non-grabbable item is the target primitive, AND\n              # the collection method for this primitive is to step onto it (not grabbable, not workshop),\n              # then this specific k_idx is NOT an obstacle for this move.\n              if k_idx == primitive_idx and (not is_grabbable and not is_workshop):\n                  continue # This non-grabbable item is what we want to step on, so it's not an obstacle\n              else:\n                  # Otherwise, it's an impassable obstacle\n                  is_impassable_obstacle = True\n                  break # No need to check other kinds in this cell\n      \n      if is_impassable_obstacle:\n          continue # Cannot move to this cell because it contains an impassable obstacle\n\n      # If reached here, the move is valid and the cell is traversable\n      new_path = path + [action_id]\n      visited.add((next_r, next_c, next_state_dir)) # Mark new state as visited\n\n      # 4. Check if the primitive is collectable from this new state based on its type\n      # Calculate the cell directly in front of the agent at its new position and direction\n      target_dr, target_dc = dir_to_target_delta[next_state_dir]\n      target_r, target_c = next_r + target_dr, next_c + target_dc\n\n      is_target_valid = (0 <= target_r < grid_rows and 0 <= target_c < grid_cols)\n\n      if is_grabbable:\n          # For grabbable items, the agent must move to an adjacent cell and then USE it.\n          if is_target_valid and grid[target_r, target_c, primitive_idx] == 1:\n              return new_path + [ACTION_USE]\n      elif is_workshop:\n          # For workshops, agent must move to an adjacent cell and face it.\n          # The \"collection\" is reaching this position; no USE action is returned as part of \"collect\".\n          if is_target_valid and grid[target_r, target_c, primitive_idx] == 1:\n              return new_path\n      else:\n          # For other non-grabbable, non-workshop items, the primitive is 'collected' by reaching its cell.\n          # We already ensured `next_r, next_c` is traversable *if* it's the target primitive.\n          if grid[next_r, next_c, primitive_idx] == 1:\n              return new_path\n      \n      # If not yet collected, add this new state to the queue for further exploration\n      q.append((next_r, next_c, next_state_dir, new_path))\n\n  # If the queue becomes empty and no path was found to collect the primitive\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:28:34.013918", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:29:37.930742", "function_name": "collect", "function_body": "  import collections\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # 0. Check if the primitive is grabbable.\n  # Only grabbable items can be collected using the USE action.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  actions_map = env.action_specs()\n  UP_ACTION = actions_map['UP']\n  DOWN_ACTION = actions_map['DOWN']\n  LEFT_ACTION = actions_map['LEFT']\n  RIGHT_ACTION = actions_map['RIGHT']\n  USE_ACTION = actions_map['USE']\n\n  state = env._current_state\n  current_pos = state.pos\n  grid = state.grid\n  width, height, _ = grid.shape\n  \n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Movement deltas for BFS (4-connectivity: North, South, West, East)\n  MOVEMENT_DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  DELTA_TO_ACTION_MAP = {\n      (0, -1): UP_ACTION,  # Move North (Up)\n      (0, 1): DOWN_ACTION, # Move South (Down)\n      (-1, 0): LEFT_ACTION, # Move West (Left)\n      (1, 0): RIGHT_ACTION  # Move East (Right)\n  }\n\n  # Helper function to check if a given grid position is walkable by the agent.\n  # An agent cannot walk onto cells occupied by non-grabbable items.\n  def _is_walkable(px, py):\n      # Check if position is within grid boundaries\n      if not (0 <= px < width and 0 <= py < height):\n          return False \n      \n      # Check if the cell is occupied by any non-grabbable item\n      for k_idx in non_grabbable_indices:\n          if grid[px, py, k_idx] == 1: # If the non-grabbable item is present\n              return False # Not walkable\n      return True\n\n  # 1. First, find all grid cells that contain the target primitive.\n  primitive_locations_on_grid = []\n  for x in range(width):\n      for y in range(height):\n          if grid[x, y, primitive_idx] == 1:\n              primitive_locations_on_grid.append((x, y))\n\n  if not primitive_locations_on_grid:\n      return [] # Primitive not found anywhere on the grid\n\n  # 2. Identify all valid \"interaction positions\" for the agent.\n  # An interaction position (agent_x, agent_y) is a walkable cell where the agent can stand\n  # and from which the primitive is within the 3x3 neighborhood (Moore neighborhood).\n  # This aligns with the `CraftState.next_to()` logic.\n  valid_interaction_positions = set()\n  for px, py in primitive_locations_on_grid:\n      # For each primitive location, consider its 3x3 neighborhood.\n      # Any walkable cell in this neighborhood is a valid interaction position.\n      for dx_nb in [-1, 0, 1]:\n          for dy_nb in [-1, 0, 1]:\n              agent_x, agent_y = px + dx_nb, py + dy_nb\n              if _is_walkable(agent_x, agent_y):\n                  valid_interaction_positions.add((agent_x, agent_y))\n                  \n  if not valid_interaction_positions:\n      return [] # No walkable positions from which to interact with the primitive\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any valid interaction position.\n  queue = collections.deque([(current_pos, [])]) # Queue stores (position_tuple, list_of_actions_taken)\n  visited = {current_pos} # Set of visited (x, y) positions to prevent cycles and redundant work\n\n  best_path_to_target = []\n  found_path = False\n\n  while queue:\n      (cx, cy), current_path = queue.popleft()\n\n      # If the current position is one of the valid interaction positions,\n      # we've found the shortest path.\n      if (cx, cy) in valid_interaction_positions:\n          best_path_to_target = current_path\n          found_path = True\n          break\n\n      # Explore neighboring cells (using 4-connectivity for agent movement)\n      for dx, dy in MOVEMENT_DELTAS:\n          action_to_reach_neighbor = DELTA_TO_ACTION_MAP[(dx, dy)]\n          nx, ny = cx + dx, cy + dy\n\n          # Check if the neighbor is within grid bounds, hasn't been visited, and is walkable\n          if _is_walkable(nx, ny) and (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), current_path + [action_to_reach_neighbor]))\n\n  # 4. Construct the complete action sequence.\n  if found_path:\n      # After moving to the interaction position, perform the USE action.\n      # The USE action itself does not require specific facing direction, only proximity.\n      return best_path_to_target + [USE_ACTION]\n  else:\n      # No path found to any valid interaction position.\n      return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:29:39.902425", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:30:28.420943", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # If the primitive is already in the agent's 3x3 neighborhood (including current cell),\n  # we can collect it immediately with USE. This avoids unnecessary pathfinding.\n  if current_state.next_to(primitive_idx):\n      return [action_map['USE']]\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Pre-compute a set of all grid locations that contain the target primitive.\n  # This allows for efficient O(1) average time lookup during the BFS for checking target cells.\n  primitive_locations_set = set()\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if grid[r, c, primitive_idx] > 0:\n              primitive_locations_set.add((r, c))\n\n  # If there are no instances of the primitive on the entire grid, it's unreachable.\n  if not primitive_locations_set:\n      return []\n\n  # Define possible cardinal moves and their corresponding actions.\n  # This maps (delta_row, delta_column) to the action integer.\n  moves = {\n      (0, 1): action_map['RIGHT'],\n      (0, -1): action_map['LEFT'],\n      (1, 0): action_map['DOWN'],\n      (-1, 0): action_map['UP'],\n  }\n\n  # Define the 3x3 neighborhood offsets (including the center).\n  # This is used to check if a cell is \"next to\" (within 3x3 of) a primitive.\n  neighborhood_offsets = [\n      (-1, -1), (-1, 0), (-1, 1),\n      (0, -1),  (0, 0),  (0, 1),\n      (1, -1),  (1, 0),  (1, 1)\n  ]\n\n  # Get indices for impassable terrain (water and stone) to avoid pathfinding through them.\n  # These are defined in the CraftWorld instance.\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # Initialize a Breadth-First Search (BFS) queue.\n  # Each item in the queue is a tuple: ((row, col), [list_of_actions_to_reach_here]).\n  queue = collections.deque([((agent_r, agent_c), [])])\n  # Keep track of visited positions to prevent cycles and redundant exploration,\n  # ensuring the shortest path is found.\n  visited = {(agent_r, agent_c)}\n\n  while queue:\n      # Dequeue the current position and the path taken to reach it.\n      (r, c), path = queue.popleft()\n\n      # Check if the current position (r,c) is a valid \"collection point\".\n      # A collection point is any cell from which the agent can perform a 'USE' action\n      # to collect the primitive. This means the primitive must be in the 3x3 neighborhood\n      # of the current cell.\n      is_collection_point = False\n      for dr_adj, dc_adj in neighborhood_offsets:\n          check_r, check_c = r + dr_adj, c + dc_adj\n          # Check if this adjacent cell (check_r, check_c) contains the target primitive.\n          if (check_r, check_c) in primitive_locations_set:\n              is_collection_point = True\n              break # Found a primitive in the neighborhood, this is a collection point.\n      \n      # If we found a collection point, we have found the shortest path to it using BFS.\n      # Append the 'USE' action to the path and return the complete action sequence.\n      if is_collection_point:\n          return path + [action_map['USE']]\n\n      # Explore all four cardinal neighbors from the current position.\n      for (dr, dc), action in moves.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # 1. Check if the next position is within grid boundaries.\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # 2. Check if the next position has already been visited in this BFS.\n          if next_pos in visited:\n              continue\n\n          # 3. Check if the next position contains any impassable terrain.\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              # If the cell contains an impassable kind, mark it as impassable.\n              if grid[next_r, next_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # If the next position is valid (within bounds, unvisited, and not impassable),\n          # add it to the queue with the updated path, and mark it as visited.\n          visited.add(next_pos)\n          new_path = path + [action]\n          queue.append((next_pos, new_path))\n  \n  # If the queue becomes empty and no path to a collection point was found,\n  # the primitive is deemed unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:30:30.480792", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook index, it's an invalid primitive.\n    return []\n\n  current_state = env._current_state\n\n  # Check if the primitive is immediately collectable (within 3x3 neighborhood).\n  # If so, a single 'USE' action is sufficient.\n  if current_state.next_to(primitive_idx):\n      return [action_map['USE']]\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Pre-scan the grid to find all locations where the target primitive exists.\n  # This set allows for efficient O(1) average-time lookup during pathfinding.\n  primitive_locations_on_grid = set()\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if grid[r, c, primitive_idx] > 0:\n              primitive_locations_on_grid.add((r, c))\n\n  # If the primitive does not exist anywhere on the grid, it's unreachable.\n  if not primitive_locations_on_grid:\n      return []\n\n  # Define cardinal movements and their corresponding actions.\n  # These are used for BFS exploration.\n  cardinal_moves = {\n      (0, 1): action_map['RIGHT'],\n      (0, -1): action_map['LEFT'],\n      (1, 0): action_map['DOWN'],\n      (-1, 0): action_map['UP'],\n  }\n\n  # Define the 3x3 neighborhood offsets relative to an agent's position.\n  # This is used to determine if the agent is \"next to\" a primitive.\n  neighborhood_offsets = [\n      (-1, -1), (-1, 0), (-1, 1),\n      (0, -1),  (0, 0),  (0, 1),\n      (1, -1),  (1, 0),  (1, 1)\n  ]\n\n  # Identify impassable terrain indices to avoid pathfinding through them.\n  impassable_terrain_indices = {env.world.water_index, env.world.stone_index}\n\n  # Initialize a Breadth-First Search (BFS) queue.\n  # Each item in the queue is a tuple: ((row, col), [list_of_actions_to_reach_here]).\n  queue = collections.deque([((agent_r, agent_c), [])])\n  # Keep track of visited grid positions to prevent cycles and redundant exploration.\n  visited_positions = {(agent_r, agent_c)}\n\n  while queue:\n      (current_r, current_c), path_to_current = queue.popleft()\n\n      # Check if the current position is a valid \"collection point\".\n      # A collection point is any cell from which the agent can interact (USE)\n      # with the primitive, meaning the primitive is in its 3x3 neighborhood.\n      is_collection_point = False\n      for dr_adj, dc_adj in neighborhood_offsets:\n          primitive_check_r, primitive_check_c = current_r + dr_adj, current_c + dc_adj\n          \n          # Ensure the check coordinates are within grid bounds before checking primitive location.\n          if (0 <= primitive_check_r < grid_height and 0 <= primitive_check_c < grid_width) and \\\n             (primitive_check_r, primitive_check_c) in primitive_locations_on_grid:\n              is_collection_point = True\n              break\n      \n      # If a collection point is found, we have found the shortest path.\n      # Append the 'USE' action and return the complete sequence of actions.\n      if is_collection_point:\n          return path_to_current + [action_map['USE']]\n\n      # Explore all valid cardinal neighbors from the current position.\n      for (dr, dc), action_move in cardinal_moves.items():\n          next_r, next_c = current_r + dr, current_c + dc\n          next_pos = (next_r, next_c)\n\n          # Skip if the next position is out of grid bounds.\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Skip if the next position has already been visited in the BFS.\n          if next_pos in visited_positions:\n              continue\n\n          # Check if the next position contains any impassable terrain.\n          is_impassable = False\n          for idx in impassable_terrain_indices:\n              if grid[next_r, next_c, idx] > 0:\n                  is_impassable = True\n                  break\n          if is_impassable:\n              continue\n\n          # If the next position is valid and unvisited, add it to the queue\n          # with the updated path, and mark it as visited.\n          visited_positions.add(next_pos)\n          new_path = path_to_current + [action_move]\n          queue.append((next_pos, new_path))\n  \n  # If the BFS queue becomes empty and no path to a collection point was found,\n  # the primitive is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
