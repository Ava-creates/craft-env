{"timestamp": "2025-07-28T14:29:03.380156", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  # 0. Initial check: If the primitive is not a grabbable item (e.g., water, stone, workshops),\n  # it cannot be \"collected\" into inventory. In this case, no actions are possible for collection.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Retrieve action mappings for movement and interaction\n  actions_map = env.action_specs()\n  USE_ACTION = actions_map['USE']\n\n  # Map of (dx, dy) movement deltas to their corresponding action IDs.\n  # This makes it easy to add movement actions to the path during BFS.\n  MOVE_ACTIONS_MAP = {\n      (0, -1): actions_map['UP'],    # Move North (Up)\n      (0, 1): actions_map['DOWN'],   # Move South (Down)\n      (-1, 0): actions_map['LEFT'],  # Move West (Left)\n      (1, 0): actions_map['RIGHT']   # Move East (Right)\n  }\n  \n  # Get current state information from the environment\n  state = env._current_state\n  current_pos = state.pos # Agent's current (x, y) position\n  grid = state.grid       # Current grid layout\n  width, height, _ = grid.shape # Grid dimensions\n  \n  # Indices of items that block movement (e.g., boundaries, water, workshops)\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a grid cell is traversable by the agent.\n  # An agent cannot walk onto a cell that contains any non-grabbable item.\n  def is_walkable(px, py):\n      # Check if the position is within grid boundaries\n      if not (0 <= px < width and 0 <= py < height):\n          return False \n      \n      # Check if the cell is occupied by any non-grabbable item that blocks movement\n      for k_idx in non_grabbable_indices:\n          if grid[px, py, k_idx] == 1:\n              return False\n      return True\n\n  # 1. Identify all valid \"collection positions\" for the agent.\n  # A collection position is any walkable cell (ax, ay) from which the agent,\n  # by performing a USE action, can acquire the target primitive.\n  # According to CraftState.next_to(), USE is effective if the item is in the 3x3\n  # neighborhood (including the agent's own cell if applicable, though typically items are picked up from adjacent cells).\n  \n  collectable_from_positions = set()\n  \n  # Find all cells on the grid where the target primitive is present.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  # For each location (px, py) where the primitive is found, determine all\n  # walkable 3x3 neighboring cells from which the agent could collect it.\n  for px, py in primitive_locations:\n      # Iterate through the 3x3 neighborhood around the primitive location\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              agent_x, agent_y = px + dx_offset, py + dy_offset # Potential agent position\n              \n              # If this potential agent position is within bounds and walkable,\n              # it's a valid position from which to collect the primitive.\n              if is_walkable(agent_x, agent_y):\n                  collectable_from_positions.add((agent_x, agent_y))\n\n  # If there are no accessible positions from which the primitive can be collected,\n  # return an empty list of actions.\n  if not collectable_from_positions:\n      return []\n\n  # 2. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current location to any of the identified `collectable_from_positions`.\n  \n  # Queue for BFS: stores tuples of ((current_x, current_y), list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  \n  # Set to keep track of visited positions to prevent cycles and redundant paths.\n  visited = {current_pos}\n\n  shortest_movement_path = []\n  path_found = False\n\n  while queue:\n      (cx, cy), path_so_far = queue.popleft()\n\n      # If the current position is one from which the primitive can be collected,\n      # we've found the shortest path in terms of movement actions.\n      if (cx, cy) in collectable_from_positions:\n          shortest_movement_path = path_so_far\n          path_found = True\n          break # Terminate BFS as the shortest path is found\n\n      # Explore all four cardinal movement directions from the current cell.\n      for (dx, dy), action_id in MOVE_ACTIONS_MAP.items():\n          nx, ny = cx + dx, cy + dy # Calculate the new potential position\n\n          # If the new position is walkable and has not been visited yet:\n          if is_walkable(nx, ny) and (nx, ny) not in visited:\n              visited.add((nx, ny)) # Mark the new position as visited\n              # Add the new state (position and updated path) to the queue\n              queue.append(((nx, ny), path_so_far + [action_id]))\n\n  # 3. Construct the complete action sequence.\n  if path_found:\n      # The full sequence is the movement path to the collection position,\n      # followed by the USE action to collect the primitive.\n      return shortest_movement_path + [USE_ACTION]\n  else:\n      # If no path could be found to any collectable position, return an empty list.\n      return []", "island_id": 2, "scores": {"3": 0.0}}
