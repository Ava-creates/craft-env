{"timestamp": "2025-07-28T14:08:14.589884", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook_index = env.world.cookbook.index\n\n  # 1. Get Primitive Index: Translate the string primitive name to its integer ID.\n  primitive_idx = cookbook_index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not found in the cookbook, it cannot be collected.\n      return []\n\n  # 2. Check Grabbability: 'collect' implies adding to inventory. Non-grabbable items\n  # (like workshops, water, stone which are environmental features) cannot be collected.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return []\n\n  # 3. Get Action Mappings: Retrieve numerical IDs for actions from the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 4. Inventory Check: If the primitive is already in the agent's inventory,\n  # no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 5. Initialize BFS for pathfinding.\n  start_y, start_x = current_state.pos  # Agent's current position (row, column)\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape  # Grid dimensions (height, width)\n\n  # 6. Define Impassable Terrain: Cells containing these kinds cannot be traversed.\n  impassable_kinds = {env.world.water_index, env.world.stone_index}\n  \n  # Queue for BFS: Stores (y, x) coordinates of cells to visit.\n  q = collections.deque([(start_y, start_x)])\n  \n  # Parent dictionary for path reconstruction: Maps (child_y, child_x) to\n  # (parent_y, parent_x, action_taken_to_reach_child). Also serves as visited set.\n  parent = {(start_y, start_x): (None, None, None)}\n\n  # Possible movements (dy, dx) and their corresponding actions.\n  move_deltas = [\n      (-1, 0, UP_ACTION),    # Move Up (decrease row index)\n      (1, 0, DOWN_ACTION),   # Move Down (increase row index)\n      (0, -1, LEFT_ACTION),  # Move Left (decrease column index)\n      (0, 1, RIGHT_ACTION)   # Move Right (increase column index)\n  ]\n\n  while q:\n      curr_y, curr_x = q.popleft()\n\n      # Check 3x3 neighborhood for the primitive: The 'USE' action works on any\n      # item in the cells directly surrounding or underneath the agent.\n      for dy_adj in [-1, 0, 1]:\n          for dx_adj in [-1, 0, 1]:\n              check_y, check_x = curr_y + dy_adj, curr_x + dx_adj\n\n              # Ensure checked coordinates are within grid bounds.\n              if 0 <= check_y < grid_height and 0 <= check_x < grid_width:\n                  # If the primitive is found at this neighboring location:\n                  if grid[check_y, check_x, primitive_idx] == 1:\n                      # A path to a collectible position has been found. Reconstruct it.\n                      path_actions = []\n                      current_node = (curr_y, curr_x)\n                      while current_node != (start_y, start_x):\n                          # Trace back from the goal cell to the start cell.\n                          prev_y, prev_x, action_to_curr = parent[current_node]\n                          path_actions.append(action_to_curr)\n                          current_node = (prev_y, prev_x)\n                      \n                      path_actions.reverse() # Reverse to get actions in chronological order.\n                      \n                      # Append the 'USE' action to actually collect the item.\n                      return path_actions + [USE_ACTION]\n\n      # Explore adjacent cells for movement if the primitive has not been found yet.\n      for dy_move, dx_move, action_to_take in move_deltas:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check if the next cell is within bounds and has not been visited.\n          if 0 <= next_y < grid_height and 0 <= next_x < grid_width and (next_y, next_x) not in parent:\n              # Check if the next cell is traversable (does not contain impassable terrain).\n              is_traversable = True\n              for i_kind in impassable_kinds:\n                  if grid[next_y, next_x, i_kind] == 1:\n                      is_traversable = False\n                      break # Not traversable, stop checking kinds for this cell\n              \n              if is_traversable:\n                  # Add the traversable cell to the queue and record its parent.\n                  parent[(next_y, next_x)] = (curr_y, curr_x, action_to_take)\n                  q.append((next_y, next_x))\n\n  # If the BFS completes and no path to an adjacent primitive was found,\n  # the primitive is either not on the map or is unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:08:16.619358", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook_index = env.world.cookbook.index\n\n  # 1. Get Primitive Index\n  primitive_idx = cookbook_index[primitive]\n  if primitive_idx is None:\n      # This primitive doesn't exist in the cookbook or is an invalid name.\n      # It cannot be collected.\n      return []\n\n  # 2. Check if the primitive is actually grabbable.\n  # The 'collect' function is intended for gathering items into inventory.\n  # If an item is non-grabbable (e.g., WORKSHOP0, WATER, STONE), it cannot be 'collected'.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return []\n\n  # 3. Get Action Mappings dynamically from the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 4. Check Inventory: If the primitive is already collected, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # --- Improvement for collect_v2 ---\n  # 5. Immediate check: If the agent is already in a position to collect the primitive\n  #    (i.e., it's in the 3x3 neighborhood of the agent's current position),\n  #    just perform the USE action without running a full BFS.\n  if current_state.next_to(primitive_idx):\n      return [USE_ACTION]\n  # -----------------------------------\n\n  # If not immediately collectible, proceed with BFS pathfinding to find it.\n\n  # 6. Initialize BFS for pathfinding.\n  start_y, start_x = current_state.pos # Agent's current position (y, x)\n  grid = current_state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # 7. Define truly impassable terrain types for pathfinding.\n  # Agents cannot move onto cells containing water or stone.\n  impassable_kinds = {env.world.water_index, env.world.stone_index}\n  \n  # Queue for BFS: stores (current_y, current_x) tuples of cells to visit.\n  q = collections.deque([(start_y, start_x)])\n  \n  # Dictionary to reconstruct path: (current_y, current_x) -> (parent_y, parent_x, action_taken_to_reach_current_node).\n  # This also implicitly serves as the 'visited' set to prevent cycles and redundant exploration.\n  parent = {(start_y, start_x): (None, None, None)}\n\n  # Define possible movements (dy, dx) and their corresponding action IDs.\n  move_deltas = [\n      (-1, 0, UP_ACTION),    # Move Up (decrease y)\n      (1, 0, DOWN_ACTION),   # Move Down (increase y)\n      (0, -1, LEFT_ACTION),  # Move Left (decrease x)\n      (0, 1, RIGHT_ACTION)   # Move Right (increase x)\n  ]\n\n  while q:\n      curr_y, curr_x = q.popleft()\n\n      # Check if the current position `(curr_y, curr_x)` is a valid location\n      # from which the primitive can be collected using the 'USE' action.\n      # The 'USE' action affects items in the 3x3 neighborhood around the agent.\n      \n      # We need to manually check the 3x3 neighborhood of (curr_y, curr_x)\n      # to see if the primitive is present. This is similar to what\n      # CraftState.next_to() does, but we do it directly on the grid\n      # to avoid creating new CraftState objects in the loop (which would be slow).\n      found_primitive_adjacent = False\n      for dy_adj in [-1, 0, 1]:\n          for dx_adj in [-1, 0, 1]:\n              check_y, check_x = curr_y + dy_adj, curr_x + dx_adj\n              # Ensure the checked coordinates are within grid bounds.\n              if 0 <= check_y < HEIGHT and 0 <= check_x < WIDTH:\n                  # Check if the primitive exists at this neighboring location on the grid.\n                  if grid[check_y, check_x, primitive_idx] == 1:\n                      found_primitive_adjacent = True\n                      break # Found the primitive in the 3x3 neighborhood\n          if found_primitive_adjacent:\n              break # Break from outer loop too\n\n      if found_primitive_adjacent:\n          # We found the shortest path to a position (curr_y, curr_x) from which\n          # the primitive can be 'used'. Now, reconstruct this path.\n          \n          path_actions = []\n          current_node = (curr_y, curr_x)\n          # Traverse back through the parent dictionary until the start node is reached.\n          while current_node != (start_y, start_x):\n              prev_y, prev_x, action_to_curr = parent[current_node]\n              path_actions.append(action_to_curr)\n              current_node = (prev_y, prev_x)\n          \n          path_actions.reverse() # Path was built in reverse order, so reverse it.\n          \n          return path_actions + [USE_ACTION] # Append USE_ACTION to perform the collection.\n\n      # If the primitive is not adjacent to the current position, explore adjacent cells for movement.\n      for dy_move, dx_move, action_to_take in move_deltas:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check if the next cell is within grid bounds and has not been visited yet.\n          if 0 <= next_y < HEIGHT and 0 <= next_x < WIDTH and (next_y, next_x) not in parent:\n              # Check if the next cell is traversable (i.e., does not contain impassable terrain).\n              is_traversable = True\n              for i_kind in impassable_kinds:\n                  if grid[next_y, next_x, i_kind] == 1: # If this impassable kind is present at the cell.\n                      is_traversable = False\n                      break\n              \n              if is_traversable:\n                  # Add the next cell to the queue and record its parent for path reconstruction.\n                  parent[(next_y, next_x)] = (curr_y, curr_x, action_to_take)\n                  q.append((next_y, next_x))\n\n  # If the BFS completes and no path to an adjacent primitive was found,\n  # it means the primitive is either not on the map or unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:09:32.203777", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos # (x, y) coordinates\n  WIDTH, HEIGHT, n_kinds = grid.shape\n\n  # Get the integer index for the primitive.\n  # Convert primitive name to lowercase as cookbook.index likely stores them as such.\n  try:\n      i_primitive = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n      # The primitive name is not recognized in the game's index.\n      # This means we cannot collect it, so return an empty path.\n      return []\n\n  # Get action mappings from the environment\n  ACTIONS = env.action_specs()\n  ACTION_USE = ACTIONS['USE']\n\n  # Define movement deltas and their corresponding actions.\n  # Assumes grid[x, y] where x is column index, y is row index.\n  # UP: decreases y (row)\n  # DOWN: increases y (row)\n  # LEFT: decreases x (column)\n  # RIGHT: increases x (column)\n  DELTAS_AND_ACTIONS = [\n      ((0, -1), ACTIONS['UP']),\n      ((0, 1), ACTIONS['DOWN']),\n      ((-1, 0), ACTIONS['LEFT']),\n      ((1, 0), ACTIONS['RIGHT']),\n  ]\n\n  # Get boundary index. Boundary cells are always impassable.\n  i_boundary = env.world.cookbook.index.index(\"boundary\")\n\n  # Determine if the primitive is grabbable. This dictates whether the agent needs\n  # to move ONTO the primitive's square or to a square ADJACENT to it.\n  # Items in `grabbable_indices` can be picked up by moving onto their cell and using USE.\n  # Items not in `grabbable_indices` (and that exist in the grid as a resource)\n  # typically need to be mined/chopped from an adjacent cell.\n  is_grabbable = i_primitive in env.world.grabbable_indices\n\n  # Helper function to check if a position (x, y) is valid and traversable by the agent.\n  def is_traversable(x, y):\n      # Check grid boundaries.\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False\n\n      # Check for boundary (always an obstacle).\n      if grid[x, y, i_boundary] > 0:\n          return False\n\n      # Check for other non-grabbable items that act as obstacles.\n      # This covers entities like 'STONE' blocks, 'WATER', 'WORKSHOP's if they block movement.\n      # The important distinction is if the primitive itself is a non-grabbable obstacle\n      # that you cannot walk onto (e.g., a rock formation to be mined).\n      for k_idx in env.world.non_grabbable_indices:\n          # If the current cell contains a non-grabbable item.\n          if grid[x, y, k_idx] > 0:\n              # Special case: If this non-grabbable item is our target primitive AND\n              # our target primitive IS grabbable (meaning we should walk onto it to pick it up).\n              # This allows walking onto a grabbable item even if it's listed as non-grabbable for other purposes.\n              if k_idx == i_primitive and is_grabbable:\n                  continue # This cell is traversable because it's the grabbable target.\n              else:\n                  # Otherwise (it's a different non-grabbable obstacle, or our\n                  # target is non-grabbable and thus impassable), it is an obstacle.\n                  return False \n      return True\n\n  # BFS (Breadth-First Search) to find the shortest path.\n  # The queue stores tuples of (current_position_tuple, list_of_actions_taken_to_reach_current_position).\n  q = collections.deque([(current_pos, [])]) \n  # Set to keep track of visited positions to avoid cycles and redundant paths.\n  visited = {current_pos} \n\n  while q:\n      (curr_x, curr_y), curr_path = q.popleft()\n\n      # Check if the target collection condition is met at the current position (curr_x, curr_y).\n      # This means we are at a position from which we can immediately perform the 'USE' action.\n      \n      # Condition for grabbable items: agent must be ON the cell containing the primitive.\n      if is_grabbable:\n          if grid[curr_x, curr_y, i_primitive] > 0:\n              return curr_path + [ACTION_USE]\n      # Condition for non-grabbable items: agent must be ADJACENT to the cell containing the primitive.\n      else:\n          # Check all 4 cardinal neighbors of the current position for the primitive.\n          for dx, dy in [d_a[0] for d_a in DELTAS_AND_ACTIONS]: # Iterate only through deltas\n              neighbor_x, neighbor_y = curr_x + dx, curr_y + dy\n              \n              # Ensure neighbor is within grid bounds.\n              if 0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT:\n                  # If this neighbor cell contains the non-grabbable primitive.\n                  if grid[neighbor_x, neighbor_y, i_primitive] > 0:\n                      # The current position (curr_x, curr_y) is adjacent to the primitive.\n                      # Perform USE action.\n                      return curr_path + [ACTION_USE]\n      \n      # If the target is not found at the current position, explore traversable neighbors.\n      for (dx, dy), action_id in DELTAS_AND_ACTIONS:\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position has not been visited and is traversable.\n          if next_pos not in visited and is_traversable(next_x, next_y):\n              visited.add(next_pos) # Mark as visited.\n              # Add to queue with the updated path.\n              q.append((next_pos, curr_path + [action_id]))\n\n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:09:34.301357", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos # (x, y) coordinates\n  WIDTH, HEIGHT, n_kinds = grid.shape\n\n  # Get the integer index for the primitive.\n  # The DSL uses uppercase names (e.g., STONE, WOOD), so use `primitive` directly.\n  try:\n      i_primitive = env.world.cookbook.index.index(primitive)\n  except KeyError:\n      # If the primitive name is not recognized in the game's index, it cannot be collected.\n      return []\n  \n  # Get action mappings from the environment\n  ACTIONS = env.action_specs()\n  ACTION_USE = ACTIONS['USE']\n\n  # Define movement deltas and their corresponding actions.\n  # This mapping is crucial for BFS path reconstruction.\n  DELTAS_AND_ACTIONS = [\n      ((0, -1), ACTIONS['UP']),    # Moving Up (decreasing Y coordinate)\n      ((0, 1), ACTIONS['DOWN']),   # Moving Down (increasing Y coordinate)\n      ((-1, 0), ACTIONS['LEFT']),  # Moving Left (decreasing X coordinate)\n      ((1, 0), ACTIONS['RIGHT']),  # Moving Right (increasing X coordinate)\n  ]\n\n  # Get boundary index. Boundary cells are always impassable.\n  i_boundary = env.world.cookbook.index.index(\"boundary\")\n\n  # Determine if the primitive is grabbable (e.g., 'WOOD', 'ROCK' which you walk onto and pick up)\n  # or non-grabbable (e.g., 'STONE', 'WORKSHOP' which you interact with from an adjacent tile).\n  is_grabbable = i_primitive in env.world.grabbable_indices\n\n  # Helper function to check if a cell (x, y) is traversable by the agent.\n  # A cell is traversable if it's within bounds, doesn't contain a boundary,\n  # and doesn't contain any other non-grabbable obstacle.\n  def is_traversable(x, y):\n      # Check grid boundaries.\n      if not (0 <= x < WIDTH and 0 <= y < HEIGHT):\n          return False\n\n      # Check for boundary (always an obstacle).\n      if grid[x, y, i_boundary] > 0: # Grid values are counts; > 0 means present.\n          return False\n\n      # Check for other non-grabbable items that act as obstacles.\n      # The agent cannot move onto any non-grabbable entity, even if it's the target primitive.\n      # If the target is non-grabbable, it's interacted with from an adjacent square.\n      for k_idx in env.world.non_grabbable_indices:\n          if grid[x, y, k_idx] > 0:\n              return False \n      return True\n\n  # Helper function to check if the target primitive can be collected while standing at (px, py).\n  def is_collectable_from_position(px, py):\n      if is_grabbable:\n          # If the primitive is grabbable, the agent must be standing directly on its cell.\n          return grid[px, py, i_primitive] > 0\n      else:\n          # If the primitive is non-grabbable, the agent must be adjacent to its cell.\n          for dx, dy in [d_a[0] for d_a in DELTAS_AND_ACTIONS]: # Iterate only through deltas\n              neighbor_x, neighbor_y = px + dx, py + dy\n              # Ensure neighbor is within grid bounds before checking its content.\n              if 0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT:\n                  # If the neighbor cell contains the non-grabbable primitive.\n                  if grid[neighbor_x, neighbor_y, i_primitive] > 0:\n                      return True # Agent is at (px, py), adjacent to the primitive.\n      return False\n\n  # BFS (Breadth-First Search) to find the shortest path.\n  # The queue stores tuples of (current_position_tuple, list_of_actions_taken_to_reach_current_position).\n  q = collections.deque([(current_pos, [])]) \n  # Set to keep track of visited positions to avoid redundant paths and infinite loops.\n  visited = {current_pos} \n\n  # Optimization: If the primitive can be collected from the initial position, perform USE immediately.\n  if is_collectable_from_position(current_pos[0], current_pos[1]):\n      return [ACTION_USE]\n\n  while q:\n      (curr_x, curr_y), curr_path = q.popleft()\n      \n      # Explore all four cardinal neighbors.\n      for (dx, dy), action_id in DELTAS_AND_ACTIONS:\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position has not been visited and is traversable.\n          if next_pos not in visited and is_traversable(next_x, next_y):\n              visited.add(next_pos) # Mark this new position as visited.\n              new_path = curr_path + [action_id] # Extend the path to include the move to next_pos.\n              \n              # Check if the target primitive can be collected from this new position.\n              if is_collectable_from_position(next_x, next_y):\n                  # If yes, we found the shortest path to a collection spot. Append ACTION_USE.\n                  return new_path + [ACTION_USE]\n              \n              # If not yet collectable, but traversable, enqueue this new position and its path\n              # to continue the BFS exploration.\n              q.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:10:17.542567", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement action IDs to their corresponding (row_change, col_change) deltas\n  ACTION_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n  \n  # Get the current state, grid, and agent's starting position from the environment\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  rows, cols, _ = grid.shape\n\n  # Convert the primitive string name (e.g., \"WOOD\", \"WORKSHOP0\") to its integer ID\n  # Assumes the primitive name exists in the cookbook's index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get pre-defined sets of non-grabbable and workshop item indices from the world.\n  # These are crucial for pathfinding logic: agent cannot move onto non-grabbable items,\n  # and interacts with workshops by being adjacent.\n  non_grabbable_indices = env.world.non_grabbable_indices # This is already a set\n  workshop_indices = set(env.world.workshop_indices)      # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop, which requires adjacent interaction (USE action).\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # --- Helper function: Checks if a given grid cell is blocked for agent movement ---\n  # A cell is blocked if it's out of bounds or contains any item classified as non-grabbable.\n  def _is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if the position is out of grid bounds\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Check if the cell contains any non-grabbable entity.\n      # If any non-grabbable item is present at `pos` (count > 0), the cell is blocked.\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0:\n              return True\n      return False\n      \n  # --- Determine the set of reachable target positions for BFS ---\n  # These are the cells the agent needs to reach *before* applying the USE action.\n  potential_target_positions = set()\n  \n  # Find all grid locations where the primitive (or workshop) is present using NumPy.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n\n  if is_workshop_primitive:\n      # For workshops, the agent needs to move to a cell *adjacent* to the workshop.\n      # For each found workshop location, check its 4 cardinal neighbors.\n      for wr, wc in primitive_locations_on_grid:\n          for action_id, (dr, dc) in ACTION_DELTAS.items(): # Iterate over (dr, dc) for UP, DOWN, LEFT, RIGHT\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              if not _is_blocked_for_movement(neighbor_pos):\n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # For grabbable resources (e.g., WOOD, IRON), the agent needs to move *onto* the cell\n      # containing the item. For uncollectable features like WATER/STONE that are non-grabbable,\n      # `_is_blocked_for_movement` will typically mark those cells as blocked, preventing them from\n      # being targetable.\n      for r, c in primitive_locations_on_grid:\n          current_cell_pos = (r, c)\n          # Only consider this cell as a target if the agent can actually move onto it.\n          if not _is_blocked_for_movement(current_cell_pos):\n              potential_target_positions.add(current_cell_pos)\n\n  # If no reachable target positions are found, the primitive cannot be collected/interacted with.\n  if not potential_target_positions:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest path ---\n  # Queue stores tuples of (current_position, list_of_actions_taken_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to keep track of visited positions to prevent cycles and redundant exploration,\n  # ensuring the shortest path is found.\n  visited = {start_pos}\n  \n  best_path_to_target = []\n  path_found = False\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the valid target positions, we've found the shortest path.\n      if (r, c) in potential_target_positions:\n          path_found = True\n          best_path_to_target = path_so_far\n          break \n\n      # Explore all 4 cardinal neighbors from the current position\n      for action_id, (dr, dc) in ACTION_DELTAS.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is within bounds, hasn't been visited, and is not blocked for movement,\n          # add it to the queue for further exploration.\n          if new_pos not in visited and not _is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  # If a path to a target position was found, append the 'USE' action.\n  # The 'USE' action (ID 4) is performed after the agent reaches the target cell.\n  if path_found:\n      return best_path_to_target + [ACTION_USE] \n  else:\n      # If no path could be found to any target position\n      return []", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:10:19.841100", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map movement action IDs to their corresponding (row_change, col_change) deltas\n  # This mapping is used for navigating the grid in the BFS.\n  MOVEMENT_DELTAS = {\n      ACTION_UP: (-1, 0),\n      ACTION_DOWN: (1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n  \n  # Get the current state, grid, and agent's starting position from the environment\n  # `env` is a CraftLab instance, which wraps a CraftState instance.\n  current_state = env._current_state\n  agent_start_pos = current_state.pos\n  current_grid = current_state.grid\n  \n  grid_rows, grid_cols, _ = current_grid.shape\n\n  # Convert the primitive string name (e.g., \"WOOD\", \"WORKSHOP0\") to its integer ID.\n  # This ID is used to locate the primitive on the grid.\n  primitive_kind_id = env.world.cookbook.index[primitive]\n  \n  # Retrieve sets of non-grabbable and workshop item indices from the world configuration.\n  # These are crucial for pathfinding logic:\n  # - Agent cannot move onto non-grabbable items.\n  # - Agent interacts with workshops by being adjacent, not by moving onto them.\n  non_traversable_kind_ids = env.world.non_grabbable_indices # Already a set for O(1) lookup\n  workshop_kind_ids = set(env.world.workshop_indices)        # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop type.\n  # This affects whether the agent needs to path to the primitive's cell or an adjacent cell.\n  is_target_a_workshop = primitive_kind_id in workshop_kind_ids\n\n  # --- Helper function: Checks if a given grid cell is blocked for agent movement ---\n  def is_cell_blocked(pos_tuple):\n      r, c = pos_tuple\n      # 1. Check if the position is out of grid bounds.\n      if not (0 <= r < grid_rows and 0 <= c < grid_cols):\n          return True \n      \n      # 2. Check if the cell contains any non-traversable entity.\n      # Iterate through the known non-traversable kind IDs.\n      for kind_id in non_traversable_kind_ids:\n          # If this specific non-traversable kind is present at the position (count > 0),\n          # then the cell is blocked for agent movement.\n          if current_grid[r, c, kind_id] > 0:\n              return True\n      return False\n      \n  # --- Determine the set of reachable target positions for BFS ---\n  # These are the cells the agent needs to reach *before* applying the USE action.\n  valid_target_positions = set()\n  \n  # Find all grid locations where the primitive (or workshop) is present using NumPy's argwhere.\n  # This efficiently returns (row, col) pairs where the primitive_kind_id layer is > 0.\n  primitive_locations_on_grid = np.argwhere(current_grid[:, :, primitive_kind_id] > 0)\n\n  if is_target_a_workshop:\n      # If the primitive is a workshop, the agent needs to move to a cell *adjacent* to it.\n      # For each found workshop location, check its 4 cardinal neighbors.\n      for workshop_r, workshop_c in primitive_locations_on_grid:\n          for dr, dc in MOVEMENT_DELTAS.values(): # Iterate over (dr, dc) for UP, DOWN, LEFT, RIGHT\n              neighbor_r, neighbor_c = workshop_r + dr, workshop_c + dc\n              neighbor_pos = (neighbor_r, neighbor_c)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              if not is_cell_blocked(neighbor_pos):\n                  valid_target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      # Iterate over the found locations of the primitive.\n      for resource_r, resource_c in primitive_locations_on_grid:\n          resource_cell_pos = (resource_r, resource_c)\n          # Only consider this cell as a target if the agent can actually move onto it.\n          # (e.g., wood on water is not directly reachable by stepping on water).\n          if not is_cell_blocked(resource_cell_pos):\n              valid_target_positions.add(resource_cell_pos)\n\n  # If no reachable target positions are found, the primitive cannot be collected/interacted with.\n  if not valid_target_positions:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest path ---\n  # The queue stores tuples of (current_position, list_of_actions_taken_to_reach_here).\n  bfs_queue = collections.deque([(agent_start_pos, [])]) \n  \n  # The `visited` set keeps track of explored positions to prevent cycles and redundant exploration,\n  # ensuring that the first path found is the shortest.\n  visited_positions = {agent_start_pos}\n  \n  shortest_path_actions = []\n  path_found = False\n  \n  while bfs_queue:\n      (current_r, current_c), path_so_far = bfs_queue.popleft()\n\n      # If the current position is one of the valid target positions, we've found the shortest path.\n      if (current_r, current_c) in valid_target_positions:\n          path_found = True\n          shortest_path_actions = path_so_far\n          break \n\n      # Explore all 4 cardinal neighbors from the current position\n      for action_id, (dr, dc) in MOVEMENT_DELTAS.items():\n          next_r, next_c = current_r + dr, current_c + dc\n          next_pos = (next_r, next_c)\n\n          # If the new position is valid (within bounds, hasn't been visited, and is not blocked),\n          # add it to the queue for further exploration.\n          if next_pos not in visited_positions and not is_cell_blocked(next_pos):\n              visited_positions.add(next_pos)\n              bfs_queue.append((next_pos, path_so_far + [action_id]))\n              \n  # If a path to a target position was found, append the 'USE' action.\n  # The 'USE' action (ID 4) is performed after the agent reaches the target cell.\n  if path_found:\n      return shortest_path_actions + [ACTION_USE] \n  else:\n      # If no path could be found to any target position, return an empty list.\n      return []", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:11:30.809720", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Dynamically retrieve action IDs from the environment's action_specs for clarity and robustness\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Map movement action IDs to (dr, dc) for pathfinding (row_change, col_change)\n  action_deltas = {\n      UP: (-1, 0),  # Up corresponds to decreasing row index\n      DOWN: (1, 0), # Down corresponds to increasing row index\n      LEFT: (0, -1), # Left corresponds to decreasing column index\n      RIGHT: (0, 1)  # Right corresponds to increasing column index\n  }\n  \n  rows, cols, _ = grid.shape # Get grid dimensions\n\n  # Retrieve the integer ID for the target primitive from the cookbook's index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get sets of indices for different types of entities from the CraftWorld\n  non_grabbable_indices = env.world.non_grabbable_indices # Entities agent cannot pick up or move onto (e.g., water, stone)\n  workshop_indices = set(env.world.workshop_indices) # Special non-grabbable entities that allow crafting (e.g., BENCH)\n  \n  # Pre-convert non_grabbable_indices to a list/array for efficient NumPy indexing inside `is_blocked_for_movement`.\n  _non_grabbable_indices_list = list(non_grabbable_indices)\n  \n  # Determine if the target primitive is a workshop, which requires adjacency for interaction\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to check if a given grid cell is blocked for agent movement.\n  # A cell is blocked if it's out of bounds or contains any non-grabbable entity.\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if the position is outside the grid boundaries\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Check if any non-grabbable item is present at this cell using NumPy's any.\n      # This is more efficient than a Python loop over non_grabbable_indices for larger sets.\n      if _non_grabbable_indices_list and np.any(grid[r, c, _non_grabbable_indices_list] > 0):\n          return True\n      return False\n      \n  # Determine the set of potential target positions for the BFS.\n  # These are the cells the agent needs to reach before executing the USE action.\n  potential_target_positions = set()\n  \n  if is_workshop_primitive:\n      # If the target is a workshop (non-grabbable but interactable),\n      # the agent must move to a cell *adjacent* to it.\n      \n      # Find all locations on the grid where this specific workshop type exists.\n      workshop_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      # For each found workshop location, iterate through its cardinal neighbors.\n      for wr, wc in workshop_locations_on_grid:\n          for action_move_id, (dr, dc) in action_deltas.items(): # Iterate over (dr, dc) for UP, DOWN, LEFT, RIGHT\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked by impassable terrain.\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the target is a grabbable resource (e.g., WOOD, IRON),\n      # the agent must move *onto* the cell containing the resource.\n      \n      # Find all locations where the primitive exists on the grid using np.argwhere.\n      # This is more idiomatic NumPy than nested for-loops.\n      primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      # For each found primitive location, add it as a target if it's not blocked for movement.\n      for r, c in primitive_locations_on_grid:\n          current_cell_pos = (r, c)\n          if not is_blocked_for_movement(current_cell_pos):\n              potential_target_positions.add(current_cell_pos)\n\n  # If no valid target positions are found, return an empty list.\n  if not potential_target_positions:\n      return []\n\n  # --- BFS (Breadth-First Search) to find the shortest path ---\n  # The queue stores tuples: (current_position, path_of_actions_taken_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # 'visited' set keeps track of positions already explored to prevent cycles and redundant work.\n  visited = {start_pos}\n  \n  best_path = [] # This will store the shortest sequence of movement actions found.\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of our determined target positions,\n      # we have found the shortest path.\n      if (r, c) in potential_target_positions:\n          best_path = path_so_far\n          break # Exit BFS, as the first path found by BFS is guaranteed to be the shortest.\n\n      # Explore all cardinal neighbors (UP, DOWN, LEFT, RIGHT)\n      for action_move_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not yet visited and not blocked for movement),\n          # add it to the queue for further exploration.\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_move_id]))\n              \n  # If a path was found (i.e., best_path is not empty after BFS)\n  if best_path: \n      # After reaching the target location, the agent needs to perform a 'USE' action\n      # to collect the item or interact with the workshop.\n      actions = best_path + [USE] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:11:32.894556", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  \"\"\"Refined version of `collect_v1` that correctly handles all types of primitives.\n  It differentiates between grabbable items (agent moves onto the cell) and\n  non-grabbable items (agent moves to an adjacent cell to use/interact),\n  which includes workshops, water, and stone. Pathfinding is done via BFS.\n  \"\"\"\n  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Dynamically retrieve action IDs from the environment's action_specs for robustness.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE'] \n\n  # Map movement action IDs to their corresponding (dr, dc) coordinate changes.\n  action_deltas = {\n      UP: (-1, 0),  # Move Up: decrease row, no change in column\n      DOWN: (1, 0),  # Move Down: increase row, no change in column\n      LEFT: (0, -1), # Move Left: no change in row, decrease column\n      RIGHT: (0, 1)  # Move Right: no change in row, increase column\n  }\n  \n  rows, cols, _ = grid.shape # Get grid dimensions for boundary checks.\n\n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get the set of indices for entities that are non-grabbable (cannot be picked up).\n  # This set includes workshops, water, stone, and boundaries.\n  non_grabbable_indices = env.world.non_grabbable_indices\n  \n  # A primitive is considered \"interactable from adjacent\" if it is in the\n  # non_grabbable_indices set. This covers workshops, water, and stone,\n  # for which the agent needs to be next to them to \"USE\".\n  # Grabbable items (e.g., WOOD, IRON) are not in this set, so they require moving onto.\n  is_interactable_from_adjacent = primitive_id in non_grabbable_indices\n\n  # Helper function to check if a given grid position is blocked for agent movement.\n  # A position is blocked if it's out of grid bounds or contains any non-grabbable item.\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if the position is outside the grid boundaries.\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Check if any non-grabbable item occupies this cell.\n      # If grid[r, c, k_idx] > 0, it means an item of kind `k_idx` is present at (r, c).\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0: \n              return True # Cell is blocked if a non-grabbable item is there.\n      return False\n      \n  # Identify all potential target positions for the BFS.\n  # These are the cells the agent needs to reach to interact with the primitive.\n  potential_target_positions = set()\n  \n  if is_interactable_from_adjacent:\n      # If the target is a non-grabbable item (e.g., workshop, water, stone),\n      # the agent must move to a cell *adjacent* to it.\n      \n      # First, find all locations on the grid where this primitive type exists.\n      target_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      # For each found target location, iterate through its cardinal neighbors.\n      for tr, tc in target_locations_on_grid:\n          for dr, dc in action_deltas.values(): \n              nr, nc = tr + dr, tc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked by impassable terrain.\n              # This ensures the agent moves to a walkable spot next to the target.\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the target is a grabbable resource (e.g., WOOD, IRON),\n      # the agent must move *onto* the cell containing the resource.\n      \n      # Iterate through the entire grid to find cells containing the primitive.\n      for r in range(rows):\n          for c in range(cols):\n              if grid[r, c, primitive_id] > 0: \n                  current_cell_pos = (r, c)\n                  \n                  # A cell containing the primitive is a valid target only if the cell itself\n                  # is not blocked for movement (e.g., wood growing on solid ground, not in water).\n                  if not is_blocked_for_movement(current_cell_pos):\n                      potential_target_positions.add(current_cell_pos)\n\n  # If no valid target positions are found (e.g., primitive not on the map, or all instances\n  # are in unreachable/blocked locations), return an empty list of actions.\n  if not potential_target_positions:\n      return []\n\n  # Breadth-First Search (BFS) to find the shortest path from the agent's start_pos\n  # to any of the potential_target_positions.\n  \n  # The queue stores tuples of (current_position, path_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set keeps track of positions already explored to avoid cycles and redundant work.\n  visited = {start_pos}\n  \n  path_found = False\n  best_path = [] # This list will store the shortest sequence of movement actions.\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      # BFS guarantees the first path found to a target is the shortest.\n      if (r, c) in potential_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break # Exit the BFS loop.\n\n      # Explore neighbors: iterate through all possible cardinal movement actions.\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not yet visited and not blocked), add it to the queue.\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              # Append the action_id that leads to this new position to the path.\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  # If a path was successfully found, append the 'USE' action as the final step.\n  if path_found:\n      actions = best_path + [USE] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:12:16.335060", "function_name": "collect", "function_body": "  import collections\n\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # 0. Pre-check: Only grabbable items can be \"collected\" into inventory.\n  # If the primitive is not grabbable (e.g., a workbench, water, or stone), \n  # it cannot be collected. Return an empty list of actions.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  # Define action mappings for clarity\n  actions_map = env.action_specs()\n  UP_ACTION = actions_map['UP']\n  DOWN_ACTION = actions_map['DOWN']\n  LEFT_ACTION = actions_map['LEFT']\n  RIGHT_ACTION = actions_map['RIGHT']\n  USE_ACTION = actions_map['USE']\n\n  # Get current state details\n  state = env._current_state\n  current_pos = state.pos\n  grid = state.grid\n  width, height, _ = grid.shape\n  \n  # Retrieve non-grabbable indices for determining walkable cells\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Define movement deltas and their corresponding actions for BFS\n  # The agent can move North, South, West, East (4-connectivity).\n  MOVEMENT_DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  DELTA_TO_ACTION_MAP = {\n      (0, -1): UP_ACTION,    # Move North\n      (0, 1): DOWN_ACTION,   # Move South\n      (-1, 0): LEFT_ACTION,  # Move West\n      (1, 0): RIGHT_ACTION   # Move East\n  }\n\n  # Helper function to check if a given grid position is walkable.\n  # A cell is walkable if it's within bounds and does not contain any non-grabbable item.\n  def _is_walkable(px, py):\n      # Check grid boundaries\n      if not (0 <= px < width and 0 <= py < height):\n          return False \n      \n      # Check for presence of non-grabbable items that block movement\n      for k_idx in non_grabbable_indices:\n          if grid[px, py, k_idx] == 1: \n              return False # Cell is blocked\n      return True\n\n  # 1. Identify all grid cells that contain the target primitive.\n  primitive_locations_on_grid = []\n  for x in range(width):\n      for y in range(height):\n          if grid[x, y, primitive_idx] == 1:\n              primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations_on_grid:\n      return [] \n\n  # 2. Determine all valid \"interaction positions\" for the agent.\n  # An interaction position is any walkable cell from which the agent can \"use\" the primitive.\n  # According to CraftState.next_to(), this means any cell within the 3x3 Moore neighborhood\n  # of a primitive location.\n  valid_interaction_positions = set()\n  for px, py in primitive_locations_on_grid:\n      # Iterate through the 3x3 neighborhood around each primitive instance\n      for dx_nb in [-1, 0, 1]:\n          for dy_nb in [-1, 0, 1]:\n              agent_x, agent_y = px + dx_nb, py + dy_nb\n              # Only consider positions the agent can actually walk onto\n              if _is_walkable(agent_x, agent_y):\n                  valid_interaction_positions.add((agent_x, agent_y))\n                  \n  # If no walkable positions exist from which to interact with the primitive, return empty.\n  if not valid_interaction_positions:\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the identified valid interaction positions.\n  \n  # BFS queue: Stores (current_position_tuple, list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])]) \n  # Visited set: Stores (x, y) positions to prevent revisiting and cycles, ensuring shortest path.\n  visited = {current_pos} \n\n  best_path_to_target = []\n  found_path = False\n\n  while queue:\n      (cx, cy), current_path = queue.popleft()\n\n      # If the current position is one of the valid interaction positions, \n      # we've found the shortest path to an interaction point.\n      if (cx, cy) in valid_interaction_positions:\n          best_path_to_target = current_path\n          found_path = True\n          break # Terminate BFS as shortest path is found\n\n      # Explore all valid neighboring cells\n      for dx, dy in MOVEMENT_DELTAS:\n          action_to_reach_neighbor = DELTA_TO_ACTION_MAP[(dx, dy)]\n          nx, ny = cx + dx, cy + dy\n\n          # If the neighbor is walkable and hasn't been visited yet, add it to the queue.\n          if _is_walkable(nx, ny) and (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), current_path + [action_to_reach_neighbor]))\n\n  # 4. Construct the complete action sequence.\n  if found_path:\n      # After moving to the interaction position, perform the USE action to collect the primitive.\n      return best_path_to_target + [USE_ACTION]\n  else:\n      # If no path was found to any valid interaction position, return an empty list.\n      return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:12:18.394278", "function_name": "collect", "function_body": "  import collections\n\n  # Retrieve the integer index for the primitive from the cookbook's index.\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # 1. Check if the primitive is grabbable.\n  # Only grabbable items (like resources) can be picked up into inventory using the USE action.\n  # Non-grabbable items (like workshops, water, stone) cannot be collected.\n  if primitive_idx not in env.world.grabbable_indices:\n      return [] # Cannot collect non-grabbable items.\n\n  # Map action names to their integer IDs from the environment's action specifications.\n  actions_map = env.action_specs()\n  UP_ACTION = actions_map['UP']\n  DOWN_ACTION = actions_map['DOWN']\n  LEFT_ACTION = actions_map['LEFT']\n  RIGHT_ACTION = actions_map['RIGHT']\n  USE_ACTION = actions_map['USE']\n\n  # Get the current state information from the environment.\n  state = env._current_state\n  current_pos = state.pos  # Agent's current (x, y) position\n  grid = state.grid        # The current grid layout (occupancy of cells)\n  width, height, _ = grid.shape # Grid dimensions\n  \n  # Get the set of indices for items that the agent cannot walk over or pick up.\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Define possible movement deltas (dx, dy) and their corresponding actions.\n  # This corresponds to 4-connectivity (North, South, West, East).\n  MOVEMENT_DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  DELTA_TO_ACTION_MAP = {\n      (0, -1): UP_ACTION,    # Move North (Up)\n      (0, 1): DOWN_ACTION,   # Move South (Down)\n      (-1, 0): LEFT_ACTION,  # Move West (Left)\n      (1, 0): RIGHT_ACTION   # Move East (Right)\n  }\n\n  # Helper function to check if a given grid position (px, py) is walkable.\n  # A position is walkable if it's within grid boundaries and does not contain\n  # any non-grabbable items.\n  def _is_walkable(px, py):\n      # Check if the position is within the grid boundaries.\n      if not (0 <= px < width and 0 <= py < height):\n          return False \n      \n      # Check if the cell at (px, py) is occupied by any non-grabbable item.\n      for k_idx in non_grabbable_indices:\n          if grid[px, py, k_idx] == 1: # If the non-grabbable item is present at this cell\n              return False # The cell is not walkable.\n      return True\n\n  # 2. Find all grid cells that contain the target primitive.\n  # This creates a list of all (x, y) coordinates where the primitive can be found.\n  primitive_locations_on_grid = []\n  for x in range(width):\n      for y in range(height):\n          if grid[x, y, primitive_idx] == 1: # Check if the primitive is present at (x, y)\n              primitive_locations_on_grid.append((x, y))\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations_on_grid:\n      return []\n\n  # 3. Identify all valid \"interaction positions\" for the agent.\n  # An interaction position is a walkable cell where the agent can stand\n  # and from which the primitive is within the 3x3 neighborhood (Moore neighborhood).\n  # The `CraftState.next_to()` method, used by the `USE` action for collection,\n  # checks this 3x3 neighborhood.\n  valid_interaction_positions = set()\n  for px, py in primitive_locations_on_grid:\n      # For each location of the primitive, iterate through its 3x3 neighborhood.\n      for dx_nb in [-1, 0, 1]:\n          for dy_nb in [-1, 0, 1]:\n              agent_x, agent_y = px + dx_nb, py + dy_nb # Calculate potential agent position\n              # If this potential agent position is walkable, it's a valid interaction spot.\n              if _is_walkable(agent_x, agent_y):\n                  valid_interaction_positions.add((agent_x, agent_y))\n                  \n  # If there are no walkable positions from which to interact with the primitive,\n  # it's unreachable.\n  if not valid_interaction_positions:\n      return []\n\n  # 4. Perform Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any of the valid interaction positions.\n  \n  # The queue stores tuples: ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])]) \n  \n  # The visited set stores (x, y) positions to prevent revisiting cells and loops,\n  # ensuring the shortest path is found.\n  visited = {current_pos} \n\n  best_path_to_target = []\n  found_path = False\n\n  while queue:\n      (cx, cy), current_path = queue.popleft() # Get current position and path to it\n\n      # If the current position is one of the valid interaction positions,\n      # we've found the shortest path to a spot from which to collect the primitive.\n      if (cx, cy) in valid_interaction_positions:\n          best_path_to_target = current_path\n          found_path = True\n          break # Shortest path found, terminate BFS.\n\n      # Explore neighboring cells (using 4-connectivity for agent movement).\n      for dx, dy in MOVEMENT_DELTAS:\n          action_to_reach_neighbor = DELTA_TO_ACTION_MAP[(dx, dy)] # Action for this move\n          nx, ny = cx + dx, cy + dy # Calculate the neighbor's position\n\n          # Check if the neighbor is:\n          # 1. Walkable (within bounds and not blocked by non-grabbables)\n          # 2. Has not been visited yet (to ensure shortest path and avoid cycles)\n          if _is_walkable(nx, ny) and (nx, ny) not in visited:\n              visited.add((nx, ny)) # Mark as visited\n              # Add the new state to the queue: neighbor's position and updated path\n              queue.append(((nx, ny), current_path + [action_to_reach_neighbor]))\n\n  # 5. Construct the complete action sequence.\n  if found_path:\n      # If a path was found, append the USE_ACTION to collect the primitive.\n      # The USE action itself doesn't require a specific facing direction, only proximity.\n      return best_path_to_target + [USE_ACTION]\n  else:\n      # No path found to any valid interaction position, meaning the primitive is unreachable.\n      return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:13:31.658600", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  start_state = env._current_state\n\n  # Optimization 1: If the primitive is already in the agent's inventory,\n  # it has already been 'collected', so no actions are needed.\n  if start_state.inventory[primitive_id] > 0:\n    return []\n\n  # Optimization 2: Ensure the primitive is actually a grabbable item.\n  # Non-grabbable items (like workshops, water, boundaries) cannot be \"collected\".\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  MOVE_ACTIONS = [UP_ACTION, DOWN_ACTION, LEFT_ACTION, RIGHT_ACTION]\n\n  # Assuming CraftState.dir maps to these common integer values (0:UP, 1:DOWN, 2:LEFT, 3:RIGHT)\n  # based on typical DMLab-style environment conventions.\n  UP_DIR = 0\n  DOWN_DIR = 1\n  LEFT_DIR = 2\n  RIGHT_DIR = 3\n\n  # Initialize BFS\n  # The queue stores tuples of (current_craft_state, list_of_actions_taken_to_reach_this_state)\n  # The visited set stores (agent_position, agent_direction) to avoid cycles and redundant exploration.\n  # For finding a path to an item, the grid itself does not change due to movement,\n  # only the agent's position and direction.\n  queue = collections.deque([(start_state, [])])\n  visited = {(start_state.pos, start_state.dir)}\n\n  # BFS loop to find the shortest path to a cell adjacent to the primitive, and facing it correctly\n  while queue:\n    current_state, path_so_far = queue.popleft()\n    agent_x, agent_y = current_state.pos\n    agent_dir = current_state.dir\n\n    # IMPROVEMENT for collect_v2:\n    # Instead of just checking if the primitive is in the 3x3 neighborhood (as `next_to` does),\n    # explicitly check if the agent is in a position AND facing the primitive correctly\n    # to successfully perform a `USE` action on it. The `USE` action targets the cell directly\n    # in front of the agent.\n    \n    # Iterate through the grid to find all occurrences of the primitive.\n    # We use current_state.grid, which represents the initial static layout for pathfinding.\n    primitive_locations = np.argwhere(current_state.grid[:, :, primitive_id] == 1)\n\n    for px, py in primitive_locations:\n        # Check if the agent is at a position (agent_x, agent_y) from which\n        # it can USE the primitive at (px, py) by facing in a specific direction (agent_dir).\n        \n        # Agent at (px, py+1), facing UP (to target (px, py))\n        if agent_x == px and agent_y == py + 1 and agent_dir == UP_DIR:\n            return path_so_far + [USE_ACTION]\n        \n        # Agent at (px, py-1), facing DOWN (to target (px, py))\n        if agent_x == px and agent_y == py - 1 and agent_dir == DOWN_DIR:\n            return path_so_far + [USE_ACTION]\n            \n        # Agent at (px+1, py), facing LEFT (to target (px, py))\n        if agent_x == px + 1 and agent_y == py and agent_dir == LEFT_DIR:\n            return path_so_far + [USE_ACTION]\n            \n        # Agent at (px-1, py), facing RIGHT (to target (px, py))\n        if agent_x == px - 1 and agent_y == py and agent_dir == RIGHT_DIR:\n            return path_so_far + [USE_ACTION]\n            \n    # If the goal (being adjacent and facing a primitive) is not met from the current state,\n    # explore possible movement actions from this state.\n    for action in MOVE_ACTIONS:\n      # Simulate the step using the CraftState's step method.\n      # CraftState.step returns a *new* CraftState object, which is perfect for BFS.\n      _reward, next_state_candidate = current_state.step(action)\n\n      next_pos = next_state_candidate.pos\n      next_dir = next_state_candidate.dir\n      next_state_identifier = (next_pos, next_dir)\n\n      # If this next state (position and direction) has not been visited before, add it to the queue.\n      if next_state_identifier not in visited:\n        visited.add(next_state_identifier)\n        queue.append((next_state_candidate, path_so_far + [action]))\n\n  # If the queue becomes empty and no path was found (i.e., the primitive is unreachable),\n  # return an empty list.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T14:13:34.743769", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n  start_state = env._current_state\n\n  # Improvement carried over from collect_v1:\n  # If the primitive is already in the agent's inventory,\n  # it has already been 'collected', so no actions are needed.\n  if start_state.inventory[primitive_id] > 0:\n    return []\n\n  # Improvement carried over from collect_v1:\n  # Ensure the primitive is actually a grabbable item that can be added to inventory.\n  # Non-grabbable items (like workshops, water, boundaries) cannot be \"collected\" in this sense.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # BFS initialization\n  # The queue stores tuples of (current_craft_state, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(start_state, [])])\n  \n  # The visited set stores (agent_position, agent_direction) to avoid cycles and redundant exploration.\n  # This is crucial because movement actions update both position and direction.\n  visited = {(start_state.pos, start_state.dir)}\n\n  # Helper function to get coordinates of the cell directly in front of the agent.\n  # Assumes agent_dir follows the action_map integer values (0=DOWN, 1=UP, 2=LEFT, 3=RIGHT).\n  def get_coords_in_front(pos, agent_dir):\n      x, y = pos\n      if agent_dir == UP:     # Facing Up\n          return x, y - 1\n      elif agent_dir == RIGHT: # Facing Right\n          return x + 1, y\n      elif agent_dir == DOWN:   # Facing Down\n          return x, y + 1\n      elif agent_dir == LEFT:   # Facing Left\n          return x - 1, y\n      return None # Should not be reached with valid directions\n\n  # Get grid dimensions for boundary checks\n  WIDTH, HEIGHT, _ = start_state.grid.shape\n\n  # BFS loop to find the shortest path to a state where the agent can collect the primitive\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # --- IMPROVEMENT for v2: Check if the agent is FACING the primitive ---\n    # The 'USE' action typically acts on the cell directly in front of the agent.\n    # Therefore, the goal state for collection is to be facing the primitive.\n    fx, fy = get_coords_in_front(current_state.pos, current_state.dir)\n\n    # Check if the coordinates in front are within grid boundaries\n    if 0 <= fx < WIDTH and 0 <= fy < HEIGHT:\n        # Check if the cell directly in front of the agent contains the primitive\n        if current_state.grid[fx, fy, primitive_id] > 0:\n            # If so, we have found a path to a position and direction from which\n            # the 'USE' action can collect the item.\n            return path_so_far + [USE]\n    # --- END IMPROVEMENT ---\n\n    # Explore possible movement actions from the current state\n    # Iterate over all 4 possible movement directions (UP, DOWN, LEFT, RIGHT).\n    # Performing a movement action also updates the agent's direction to match the movement.\n    for action in [UP, DOWN, LEFT, RIGHT]:\n      # Simulate the step using the CraftState's step method.\n      # CraftState.step returns a *new* CraftState object, perfect for BFS.\n      _reward, next_state_candidate = current_state.step(action)\n\n      next_pos = next_state_candidate.pos\n      next_dir = next_state_candidate.dir # This will be the direction corresponding to 'action'\n\n      # Form a unique identifier for the next state (position and direction)\n      next_state_identifier = (next_pos, next_dir)\n\n      # If this next state (position and direction) has not been visited before, add it to the queue.\n      # Note: Even if a movement action is blocked (agent stays at next_pos == current_pos),\n      # the direction might still change, making it a new, valid state to explore.\n      if next_state_identifier not in visited:\n        visited.add(next_state_identifier)\n        queue.append((next_state_candidate, path_so_far + [action]))\n\n  # If the queue becomes empty and no path was found (i.e., the primitive is unreachable),\n  # return an empty list.\n  return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T14:14:24.904821", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-28T14:14:27.289924", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # Optimization 1: If the primitive is already in the agent's 3x3 neighborhood,\n  # it can be collected immediately with the 'USE' action.\n  if current_state.next_to(primitive_idx):\n      return [action_map['USE']]\n\n  # Optimization 2: Check if the primitive is actually grabbable.\n  # Non-grabbable items (like water, stone, workshops) cannot be \"collected\" into inventory.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return []\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Define indices of entities that block agent movement.\n  # This set includes workshops, water, stone, etc., essentially anything the agent cannot walk through.\n  impassable_for_movement_indices = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell (r, c) is traversable by the agent.\n  def is_traversable(r, c):\n      # 1. Check grid boundaries.\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False\n      # 2. Check if the cell contains any impassable entity.\n      # A cell is considered impassable for movement if *any* of its layers\n      # contains an item from `impassable_for_movement_indices`.\n      for idx in impassable_for_movement_indices:\n          if grid[r, c, idx] > 0:\n              return False\n      return True\n\n  # Find all locations on the grid where the target primitive exists.\n  # np.argwhere returns an array of [row, col] pairs; convert to a set of tuples for efficient lookups.\n  primitive_locations = set(map(tuple, np.argwhere(grid[:, :, primitive_idx] > 0)))\n\n  # If there are no instances of the primitive on the map, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # Define possible cardinal movements (dr, dc) and their corresponding action IDs.\n  # These are the actions the agent can take to move on the grid.\n  moves = {\n      (0, 1): action_map['RIGHT'],  # (dr, dc) for moving Right\n      (0, -1): action_map['LEFT'],   # (dr, dc) for moving Left\n      (1, 0): action_map['DOWN'],   # (dr, dc) for moving Down\n      (-1, 0): action_map['UP'],    # (dr, dc) for moving Up\n  }\n\n  # Precompute all valid \"target\" cells for the BFS.\n  # A target cell is a traversable grid cell from which the agent can successfully\n  # collect the primitive using the 'USE' action. This means the target cell must be\n  # within the 3x3 neighborhood of at least one primitive location, as per `CraftState.next_to`.\n  bfs_target_cells = set()\n  # Define all 9 offsets for a 3x3 neighborhood (including the center, i.e., (0,0)).\n  neighborhood_offsets = [\n      (-1, -1), (-1, 0), (-1, 1),\n      (0, -1),  (0, 0),  (0, 1),\n      (1, -1),  (1, 0),  (1, 1)\n  ]\n\n  # For each location where the primitive is found:\n  for pr, pc in primitive_locations:\n      # Iterate through its 3x3 neighborhood.\n      for dr_offset, dc_offset in neighborhood_offsets:\n          # Calculate a candidate target cell (a cell where the agent could stand).\n          tr, tc = pr + dr_offset, pc + dc_offset\n          # If this candidate cell is within bounds and traversable by the agent,\n          # it's a valid BFS target because from here the agent can 'USE' to collect the primitive.\n          if is_traversable(tr, tc):\n              bfs_target_cells.add((tr, tc))\n  \n  # If no traversable cells are within reach of any primitive location,\n  # then the primitive is effectively unreachable for collection.\n  if not bfs_target_cells:\n      return []\n\n  # Initialize Breadth-First Search (BFS) queue.\n  # Each element in the queue is `((row, col), [list_of_actions_to_reach_here])`.\n  queue = collections.deque([((agent_r, agent_c), [])])\n  # Keep track of visited positions to avoid cycles and redundant exploration,\n  # ensuring the shortest path is found.\n  visited = {(agent_r, agent_c)}\n\n  while queue:\n      (r, c), path = queue.popleft() # Dequeue the current position and its path\n\n      # If the current position is one of our precomputed BFS target cells,\n      # we have found the shortest path to a collection point.\n      if (r, c) in bfs_target_cells:\n          # Append the 'USE' action to the path and return the complete sequence.\n          return path + [action_map['USE']]\n\n      # Explore all four cardinal neighbors from the current position.\n      for (dr, dc), action in moves.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is traversable and has not been visited yet.\n          if is_traversable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos)              # Mark the position as visited\n              queue.append((next_pos, path + [action])) # Enqueue with the updated path\n  \n  # If the BFS queue becomes empty and no path to a target cell was found,\n  # it means the primitive is unreachable from the agent's current position.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:15:13.089521", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  actions = []\n\n  # 1. Resolve the integer ID for the primitive\n  primitive_name = primitive.lower()\n  try:\n    primitive_id = env.world.cookbook.index[primitive_name]\n  except KeyError:\n    # If the primitive name is not found in the cookbook index, it's invalid.\n    return []\n\n  # 2. Check if the primitive is collectable (i.e., grabbable).\n  # Items that are not grabbable cannot be picked up using the 'USE' action.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 3. Get current state information from the environment observations.\n  obs = env.observations()\n  # Agent's current position (x, y) - convert normalized float to integer tuple.\n  current_pos = tuple(map(int, obs['features_dict']['pos']))\n  grid = obs['features_dict']['features_global']  # The full grid occupancy state\n  inventory = obs['features_dict']['inventory']    # Agent's current inventory counts\n\n  # 4. Check if the primitive is already in the agent's inventory.\n  # If so, no collection actions are needed.\n  if inventory[primitive_id] > 0:\n      return []\n\n  # Get grid dimensions (WIDTH, HEIGHT) from the grid's shape.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define mappings from movement offsets (dx, dy) to corresponding action IDs.\n  move_action_map = {\n      (0, -1): ACTION_UP,    # Move up (decrease y)\n      (0, 1): ACTION_DOWN,   # Move down (increase y)\n      (-1, 0): ACTION_LEFT,  # Move left (decrease x)\n      (1, 0): ACTION_RIGHT,  # Move right (increase x)\n  }\n\n  # Identify entity IDs that represent impassable obstacles for the agent.\n  # These are grid cells the agent cannot move into.\n  impassable_ids = set()\n  # 'boundary' is typically always an impassable wall.\n  impassable_ids.add(env.world.cookbook.index[\"boundary\"])\n  # 'water' is also generally impassable unless a bridge is used.\n  # Add it if \"water\" is a known kind in the world.\n  if \"water\" in env.world.cookbook.index.contents:\n    impassable_ids.add(env.world.water_index)\n  # Improvement for collect_v2: Add 'stone' as an impassable obstacle if it exists.\n  if \"stone\" in env.world.cookbook.index.contents:\n    impassable_ids.add(env.world.stone_index)\n\n\n  # Use Breadth-First Search (BFS) to find the shortest path to a location\n  # from which the primitive can be collected (i.e., it is in the 3x3 neighborhood).\n  queue = collections.deque()\n  # The queue stores tuples: (current_agent_coords, path_list_of_agent_coords).\n  # path_list_of_agent_coords records the sequence of (x,y) positions the agent takes.\n  queue.append((current_pos, [current_pos]))\n\n  # 'visited' set keeps track of (x,y) positions that have been added to the queue,\n  # preventing cycles and redundant exploration.\n  visited = {current_pos}\n\n  target_agent_path = None # This will store the optimal path of agent positions.\n\n  while queue:\n      (agent_x, agent_y), path = queue.popleft()\n\n      # Check if the desired primitive is present in the 3x3 neighborhood\n      # around the current agent's position (agent_x, agent_y).\n      # If so, this is a valid location to perform ACTION_USE.\n      found_primitive_nearby = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              # Calculate the coordinates of a cell in the 3x3 neighborhood.\n              neighbor_x, neighbor_y = agent_x + dx_offset, agent_y + dy_offset\n\n              # Ensure the neighborhood cell is within grid boundaries.\n              if not (0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT):\n                  continue\n\n              # Check if the primitive_id is present at this specific neighborhood cell.\n              if grid[neighbor_x, neighbor_y, primitive_id] > 0:\n                  found_primitive_nearby = True\n                  break # Primitive found, no need to check other offsets in 3x3.\n          if found_primitive_nearby:\n              break # Primitive found, no need to check other rows in 3x3.\n\n      if found_primitive_nearby:\n          # A path to a collection-ready location has been found.\n          target_agent_path = path\n          break # Exit the BFS loop, as we found the shortest path.\n\n      # If the primitive is not nearby, explore adjacent, traversable cells for the agent's next move.\n      # Only consider cardinal directions (North, South, East, West) for movement.\n      for (dx, dy), _ in move_action_map.items():\n          next_x, next_y = agent_x + dx, agent_y + dy\n\n          # Check if the potential next position is within the grid boundaries.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the potential next position is an impassable obstacle.\n          is_impassable_cell = False\n          for obstacle_id in impassable_ids:\n              if grid[next_x, next_y, obstacle_id] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n               continue # The agent cannot move into this cell.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if (next_x, next_y) not in visited:\n              visited.add((next_x, next_y))\n              queue.append(((next_x, next_y), path + [(next_x, next_y)]))\n\n  # If a path to a collection location was successfully found by BFS:\n  if target_agent_path:\n      # Convert the sequence of (x,y) coordinates in the path into a list of movement actions.\n      # The first coordinate in `target_agent_path` is the starting point.\n      for i in range(len(target_agent_path) - 1):\n          curr_x, curr_y = target_agent_path[i]\n          next_x, next_y = target_agent_path[i+1]\n\n          # Calculate the directional change required for this step.\n          dx = next_x - curr_x\n          dy = next_y - curr_y\n\n          # Append the corresponding movement action to the list.\n          actions.append(move_action_map[(dx, dy)])\n\n      # After moving to the final position in the path, perform the 'USE' action\n      # to collect the primitive which is now in the 3x3 neighborhood.\n      actions.append(ACTION_USE)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:15:15.530071", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  actions = []\n\n  # 1. Resolve the integer ID for the primitive\n  primitive_name = primitive.lower()\n  try:\n    primitive_id = env.world.cookbook.index[primitive_name]\n  except KeyError:\n    # If the primitive name is not found, it's an invalid primitive.\n    return []\n\n  # 2. Check if the primitive is collectable (i.e., grabbable).\n  # Non-grabbable items cannot be picked up using the 'USE' action.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 3. Get current state information from the environment observations.\n  obs = env.observations()\n  # Agent's current position (x, y) - normalized floats need to be converted to integers.\n  current_pos = tuple(map(int, obs['features_dict']['pos']))\n  grid = obs['features_dict']['features_global']  # The full grid occupancy state\n  inventory = obs['features_dict']['inventory']    # Agent's current inventory counts\n\n  # 4. Check if the primitive is already in the agent's inventory.\n  # If so, no collection actions are needed.\n  if inventory[primitive_id] > 0:\n      return []\n\n  # Get grid dimensions (WIDTH, HEIGHT) from the grid's shape.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define mappings from movement offsets (dx, dy) to corresponding action IDs.\n  move_action_map = {\n      (0, -1): ACTION_UP,    # Move up (decrease y)\n      (0, 1): ACTION_DOWN,   # Move down (increase y)\n      (-1, 0): ACTION_LEFT,  # Move left (decrease x)\n      (1, 0): ACTION_RIGHT,  # Move right (increase x)\n  }\n\n  # Identify entity IDs that represent impassable obstacles for the agent.\n  impassable_ids = set()\n  # \"boundary\" is always impassable.\n  impassable_ids.add(env.world.cookbook.index[\"boundary\"])\n  # \"water\" is usually impassable unless a bridge is used, which is not handled by simple 'collect'.\n  if \"water\" in env.world.cookbook.index.contents:\n    impassable_ids.add(env.world.water_index)\n\n\n  # Use Breadth-First Search (BFS) to find the shortest path to a location\n  # from which the primitive can be collected (i.e., it is in the 3x3 neighborhood).\n  queue = collections.deque()\n  # The queue stores tuples: (current_agent_coords, path_list_of_agent_coords).\n  queue.append((current_pos, [current_pos]))\n\n  # 'visited' set keeps track of (x,y) positions that have been added to the queue,\n  # preventing cycles and redundant exploration.\n  visited = {current_pos}\n\n  target_agent_path = None # This will store the optimal path of agent positions.\n\n  while queue:\n      (agent_x, agent_y), path = queue.popleft()\n\n      # Check if the desired primitive is present in the 3x3 neighborhood\n      # around the current agent's position (agent_x, agent_y).\n      # If so, this is a valid location to perform ACTION_USE.\n      found_primitive_nearby = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              # Calculate the coordinates of a cell in the 3x3 neighborhood.\n              neighbor_x, neighbor_y = agent_x + dx_offset, agent_y + dy_offset\n\n              # Ensure the neighborhood cell is within grid boundaries.\n              if not (0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT):\n                  continue\n\n              # Check if the primitive_id is present at this specific neighborhood cell.\n              if grid[neighbor_x, neighbor_y, primitive_id] > 0:\n                  found_primitive_nearby = True\n                  break # Primitive found in 3x3, no need to check other offsets.\n          if found_primitive_nearby:\n              break # Primitive found, no need to check other rows.\n\n      if found_primitive_nearby:\n          # A path to a collection-ready location has been found.\n          target_agent_path = path\n          break # Exit the BFS loop, as we found the shortest path.\n\n      # If the primitive is not nearby, explore adjacent, traversable cells.\n      # Only consider cardinal directions for agent movement.\n      for (dx, dy), _ in move_action_map.items():\n          next_x, next_y = agent_x + dx, agent_y + dy\n\n          # Check if the potential next position is within the grid boundaries.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the potential next position is an impassable obstacle.\n          is_impassable_cell = False\n          for obstacle_id in impassable_ids:\n              if grid[next_x, next_y, obstacle_id] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n               continue # The agent cannot move into this cell.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if (next_x, next_y) not in visited:\n              visited.add((next_x, next_y))\n              queue.append(((next_x, next_y), path + [(next_x, next_y)]))\n\n  # If a path to a collection location was successfully found by BFS:\n  if target_agent_path:\n      # Convert the sequence of (x,y) coordinates in the path into a list of movement actions.\n      # The first coordinate in `target_agent_path` is the starting point.\n      for i in range(len(target_agent_path) - 1):\n          curr_x, curr_y = target_agent_path[i]\n          next_x, next_y = target_agent_path[i+1]\n\n          # Calculate the directional change required for this step.\n          dx = next_x - curr_x\n          dy = next_y - curr_y\n\n          # Append the corresponding movement action to the list.\n          actions.append(move_action_map[(dx, dy)])\n\n      # After moving to the final position in the path, perform the 'USE' action\n      # to collect the primitive which is now in the 3x3 neighborhood.\n      actions.append(ACTION_USE)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:16:11.369557", "function_name": "collect", "function_body": "  \"\"\"\n  Calculates the shortest sequence of actions required to find and collect a specified primitive.\n  The agent must navigate to a position from which the primitive is within its 3x3 neighborhood\n  (Moore neighborhood), and then execute the 'USE' action. This function employs\n  Breadth-First Search (BFS) to determine the optimal movement path.\n  \"\"\"\n  import collections # Used for deque in BFS\n\n  # --- 0. Setup and Pre-conditions ---\n  # Translate the primitive's string name into its integer ID using the cookbook's index.\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # Critical check: Ensure the primitive is actually grabbable.\n  # Only grabbable items can be collected by the 'USE' action. If not, return an empty plan.\n  if primitive_id not in env.world.grabbable_indices:\n      return [] \n\n  # Retrieve the integer mappings for all possible actions from the environment.\n  action_mappings = env.action_specs()\n  ACTION_UP = action_mappings['UP']\n  ACTION_DOWN = action_mappings['DOWN']\n  ACTION_LEFT = action_mappings['LEFT']\n  ACTION_RIGHT = action_mappings['RIGHT']\n  ACTION_USE = action_mappings['USE']\n\n  # Access the current state of the environment.\n  current_env_state = env._current_state\n  agent_current_position = current_env_state.pos # Agent's (x, y) coordinates\n  grid_layout = current_env_state.grid # The full grid data (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid_layout.shape\n  \n  # Identify the integer IDs of objects that block agent movement (non-grabbable terrain/features).\n  impassable_object_ids = env.world.non_grabbable_indices\n\n  # Define the 4 cardinal movement deltas (dx, dy) and their corresponding actions for BFS.\n  movement_deltas_to_actions = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT\n  }\n\n  # --- Helper Function: Determines if a grid cell is walkable ---\n  def is_cell_walkable(x, y):\n      \"\"\"\n      Checks if the given grid coordinates (x, y) represent a valid and accessible cell\n      for the agent to occupy.\n      Returns True if within bounds and not blocked by an impassable object, False otherwise.\n      \"\"\"\n      # First, check if the coordinates are within the grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # Next, check if the cell contains any object that blocks agent movement.\n      for object_id in impassable_object_ids:\n          if grid_layout[x, y, object_id] == 1:\n              return False # This cell is occupied by an impassable object.\n      return True # The cell is within bounds and clear for movement.\n\n  # --- 1. Locate all instances of the target primitive on the grid ---\n  # This step identifies every physical location where the primitive currently exists.\n  locations_of_primitive = []\n  for x_coord in range(grid_width):\n      for y_coord in range(grid_height):\n          if grid_layout[x_coord, y_coord, primitive_id] == 1:\n              locations_of_primitive.append((x_coord, y_coord))\n\n  # If the primitive isn't present anywhere, it cannot be collected.\n  if not locations_of_primitive:\n      return [] \n\n  # --- 2. Determine all valid \"agent interaction positions\" ---\n  # An interaction position is a walkable cell where the agent can stand and\n  # be within a 3x3 neighborhood of the primitive. This is based on `CraftState.next_to()` logic.\n  valid_agent_interaction_positions = set()\n  for prim_x, prim_y in locations_of_primitive:\n      # Iterate through the 3x3 grid area surrounding each primitive instance.\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              # Calculate the potential (x, y) coordinates for the agent.\n              potential_agent_x, potential_agent_y = prim_x + dx_offset, prim_y + dy_offset\n              \n              # If this potential agent position is walkable, add it to our set of targets.\n              if is_cell_walkable(potential_agent_x, potential_agent_y):\n                  valid_agent_interaction_positions.add((potential_agent_x, potential_agent_y))\n                  \n  # If no walkable positions are found from which to interact, collection is impossible.\n  if not valid_agent_interaction_positions:\n      return []\n\n  # --- 3. Perform Breadth-First Search (BFS) for the shortest movement path ---\n  # BFS is used to find the minimum number of steps from the agent's current position\n  # to any of the `valid_agent_interaction_positions`.\n  # The BFS queue stores tuples: ((current_x, current_y), [list_of_actions_taken_to_reach_here]).\n  bfs_queue = collections.deque([(agent_current_position, [])]) \n  # A set to keep track of visited grid cells, preventing cycles and redundant exploration.\n  visited_cells = {agent_current_position} \n\n  shortest_movement_path = []\n  target_reached = False\n\n  while bfs_queue:\n    (current_x, current_y), path_accumulator = bfs_queue.popleft()\n\n    # If the current cell is one of our designated interaction positions,\n    # we've found the shortest path to a valid collection spot.\n    if (current_x, current_y) in valid_agent_interaction_positions:\n        shortest_movement_path = path_accumulator\n        target_reached = True\n        break # Exit BFS as the first path found is guaranteed to be the shortest.\n\n    # Explore all 4 cardinal neighbors from the current cell.\n    for (dx, dy), action_to_perform in movement_deltas_to_actions.items():\n        next_x, next_y = current_x + dx, current_y + dy\n\n        # If the neighbor cell is walkable and has not been visited yet, add it to the queue.\n        if is_cell_walkable(next_x, next_y) and (next_x, next_y) not in visited_cells:\n            visited_cells.add((next_x, next_y)) # Mark this cell as visited\n            # Enqueue the neighbor with the updated path (current path + action to reach neighbor).\n            bfs_queue.append(((next_x, next_y), path_accumulator + [action_to_perform]))\n\n  # --- 4. Construct the complete action sequence ---\n  if target_reached:\n      # After moving to an interaction position, the final step is to execute the 'USE' action.\n      return shortest_movement_path + [ACTION_USE]\n  else:\n      # If no path could be found to any valid interaction position, return an empty list.\n      return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:16:13.858109", "function_name": "collect", "function_body": "  \"\"\"\n  Finds the shortest path to a position from which a grabbable primitive can be collected\n  and returns the sequence of actions, including the final USE action.\n  This version aims for clarity and robustness, building upon collect_v1 by using\n  more explicit naming and detailed comments.\n  \"\"\"\n  # --- 0. Initial Setup and Pre-conditions ---\n  # Get the integer ID for the target primitive from the cookbook's index.\n  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Ensure the primitive is actually something the agent can 'grab' using the USE action.\n  # If it's a non-grabbable environment item (e.g., a wall, water), it cannot be collected this way.\n  if primitive_idx not in env.world.grabbable_indices:\n      return [] # Cannot collect non-grabbable items directly.\n\n  # Map action names to their integer IDs for clarity and robust usage.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Retrieve current state information from the environment.\n  current_state = env._current_state\n  agent_current_pos = current_state.pos # Agent's (x, y) coordinates\n  grid = current_state.grid # The full grid representation (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape\n  \n  # Get indices of items that block agent movement (e.g., walls, certain obstacles).\n  # The agent cannot move into cells occupied by these items.\n  movement_blocking_indices = env.world.non_grabbable_indices\n\n  # Define possible movement deltas (changes in x, y) and their corresponding actions.\n  # This corresponds to 4-directional movement (North, South, West, East).\n  MOVE_DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)] # (dx, dy)\n  DELTA_TO_ACTION = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT\n  }\n\n  # Define the neighborhood size for the USE action. CraftState.next_to uses a 3x3 area.\n  USE_NEIGHBORHOOD_DELTAS = [\n      (dx, dy) for dx in [-1, 0, 1] for dy in [-1, 0, 1]\n  ]\n\n  # --- 1. Helper Function for Walkability Check ---\n  def is_walkable(x, y):\n      \"\"\"\n      Checks if a given grid position (x, y) is within bounds and free of\n      movement-blocking entities, making it a valid cell for the agent to occupy.\n      \"\"\"\n      # Check if position is within grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False \n      \n      # Check if any movement-blocking item is present at this position.\n      # If grid[x, y, k_idx] == 1 for any blocking kind, the cell is not walkable.\n      for k_idx in movement_blocking_indices:\n          if grid[x, y, k_idx] == 1:\n              return False \n      return True\n\n  # --- 2. Identify Locations of the Primitive on the Grid ---\n  # Find all specific cells where the target primitive exists.\n  primitive_exact_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_idx] == 1:\n              primitive_exact_locations.append((x, y))\n\n  if not primitive_exact_locations:\n      # If the primitive is not found anywhere, it cannot be collected.\n      return []\n\n  # --- 3. Determine Valid Agent Interaction Positions ---\n  # These are walkable grid cells where the agent can stand and successfully\n  # apply the USE action to collect the primitive (i.e., the primitive is in its 3x3 neighborhood).\n  valid_agent_interaction_positions = set()\n  \n  # Iterate through each discovered location of the primitive.\n  for prim_x, prim_y in primitive_exact_locations:\n      # For each primitive, check its 3x3 neighborhood. Any walkable cell in this\n      # neighborhood is a valid position for the agent to stand to collect this primitive.\n      for dx_nb, dy_nb in USE_NEIGHBORHOOD_DELTAS:\n          potential_agent_x, potential_agent_y = prim_x + dx_nb, prim_y + dy_nb\n          \n          # Only add to the set if the agent can actually move to and stand on this cell.\n          if is_walkable(potential_agent_x, potential_agent_y):\n              valid_agent_interaction_positions.add((potential_agent_x, potential_agent_y))\n                  \n  if not valid_agent_interaction_positions:\n      # If there are no walkable cells from which the primitive can be reached, return empty.\n      return []\n\n  # --- 4. Perform Breadth-First Search (BFS) for the Shortest Path ---\n  # The BFS aims to find the shortest sequence of movement actions from the\n  # agent's current position to any of the `valid_agent_interaction_positions`.\n  \n  # BFS queue: stores (current_position, list_of_actions_to_reach_here)\n  bfs_queue = collections.deque([(agent_current_pos, [])]) \n  # Visited set: tracks (x, y) coordinates to prevent redundant visits and infinite loops.\n  visited_cells = {agent_current_pos} \n\n  shortest_path_found = []\n  path_was_found = False\n\n  while bfs_queue:\n    (current_x, current_y), current_action_sequence = bfs_queue.popleft()\n\n    # If the current cell is one of our target interaction positions,\n    # we've found the shortest path.\n    if (current_x, current_y) in valid_agent_interaction_positions:\n        shortest_path_found = current_action_sequence\n        path_was_found = True\n        break # BFS guarantees the first path found is the shortest.\n\n    # Explore all 4 cardinal neighbors of the current cell.\n    for dx, dy in MOVE_DELTAS:\n        action_for_move = DELTA_TO_ACTION[(dx, dy)]\n        next_x, next_y = current_x + dx, current_y + dy\n\n        # If the neighbor is walkable and has not been visited yet:\n        if is_walkable(next_x, next_y) and (next_x, next_y) not in visited_cells:\n            visited_cells.add((next_x, next_y)) # Mark as visited\n            # Add the neighbor to the queue with its accumulated action sequence.\n            bfs_queue.append(((next_x, next_y), current_action_sequence + [action_for_move]))\n\n  # --- 5. Construct Final Action Sequence ---\n  if path_was_found:\n      # If a path to an interaction position was found, append the USE action\n      # to perform the collection.\n      return shortest_path_found + [ACTION_USE]\n  else:\n      # No path could be found to any valid interaction position.\n      return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:16:58.168567", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Dynamically retrieve action IDs from the environment's action_specs for robustness.\n  # This ensures the function adapts if action mappings change in the future.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE'] # Get the USE action ID dynamically.\n\n  # Map movement action IDs to their corresponding (dr, dc) coordinate changes.\n  # This dictionary is crucial for the Breadth-First Search (BFS) to simulate moves.\n  action_deltas = {\n      UP: (-1, 0),  # Move Up: decrease row, no change in column\n      DOWN: (1, 0),  # Move Down: increase row, no change in column\n      LEFT: (0, -1), # Move Left: no change in row, decrease column\n      RIGHT: (0, 1)  # Move Right: no change in row, increase column\n  }\n  \n  rows, cols, _ = grid.shape # Get grid dimensions for boundary checks.\n\n  # Retrieve the integer ID for the target primitive from the world's cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get sets of non-grabbable and workshop indices from the world configuration.\n  non_grabbable_indices = env.world.non_grabbable_indices \n  workshop_indices = set(env.world.workshop_indices)      \n  \n  # Determine if the primitive is a workshop. Workshops typically require the agent\n  # to be *adjacent* to them to use them.\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to check if a given grid position is blocked for agent movement.\n  # A position is blocked if it's out of grid bounds or contains any non-grabbable item.\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # Check if the position is outside the grid boundaries.\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Check if any non-grabbable item occupies this cell.\n      for k_idx in non_grabbable_indices:\n          if grid[r, c, k_idx] > 0: \n              return True # Cell is blocked if a non-grabbable item is there.\n      return False\n      \n  # Identify all potential target positions for the BFS.\n  # These are the cells the agent needs to reach to interact with the primitive.\n  target_positions = set()\n  \n  if is_workshop_primitive:\n      # If the primitive is a workshop, find all its locations on the grid.\n      workshop_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n      \n      # For each found workshop location, add its valid, unblocked neighbors as targets.\n      for wr, wc in workshop_locations_on_grid:\n          for dr, dc in action_deltas.values():\n              neighbor_pos = (wr + dr, wc + dc)\n              \n              if not is_blocked_for_movement(neighbor_pos): \n                  target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource, find its locations on the grid.\n      for r in range(rows):\n          for c in range(cols):\n              if grid[r, c, primitive_id] > 0: \n                  current_cell_pos = (r, c)\n                  # Add the cell itself as a target, but only if it's not blocked.\n                  if not is_blocked_for_movement(current_cell_pos):\n                      target_positions.add(current_cell_pos)\n\n  # If no valid target positions are found, return an empty list of actions.\n  if not target_positions:\n      return []\n\n  # Breadth-First Search (BFS) to find the shortest path from start_pos\n  # to any of the potential target_positions.\n  \n  # The queue stores tuples of (current_position, path_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_pos, [])]) \n  # The `visited` set keeps track of positions already explored to avoid cycles and redundant work.\n  visited = {start_pos}\n  \n  path_to_target = [] # This list will store the shortest sequence of movement actions.\n  \n  while q:\n      (r, c), current_path = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in target_positions:\n          path_to_target = current_path\n          break # Exit the BFS loop.\n\n      # Explore neighbors: iterate through all possible cardinal movement actions.\n      for action_id, (dr, dc) in action_deltas.items(): \n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not yet visited and not blocked), add it to the queue.\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              # Append the action_id that leads to this new position to the path.\n              q.append((new_pos, current_path + [action_id]))\n              \n  # If a path was successfully found, append the 'USE' action as the final step.\n  if path_to_target:\n      actions = path_to_target + [USE] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
