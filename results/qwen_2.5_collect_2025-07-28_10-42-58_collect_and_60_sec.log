{"timestamp": "2025-07-28T15:13:48.571672", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  MOVE_UP = action_map['UP']\n  MOVE_DOWN = action_map['DOWN']\n  MOVE_LEFT = action_map['LEFT']\n  MOVE_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n\n  # Get the integer index for the target primitive\n  primitive_idx = cookbook.index.index(primitive)\n\n  start_pos = current_state.pos\n  grid = current_state.grid\n  width, height, n_kinds = grid.shape\n\n  # Define unwalkable entities by their indices.\n  # These are entities the agent cannot move into.\n  # This set includes all non-grabbable items that are not workshops,\n  # as workshops are typically traversable.\n  unwalkable_entities_indices = set(world.non_grabbable_indices) - set(world.workshop_indices)\n  \n  # BFS setup\n  queue = collections.deque([(start_pos[0], start_pos[1])])\n  # parent maps (x, y) -> ((parent_x, parent_y), action_to_reach_x_y_from_parent)\n  parent = {start_pos: (None, None)}\n  visited = {start_pos}\n\n  final_path_actions = []\n  found_primitive_adj = False\n\n  # Define possible movements (dx, dy, action_id) for the agent\n  # (dx, dy) represents the change in coordinates from current_pos to neighbor_pos\n  move_options = [\n      (0, -1, MOVE_UP),    # Move Up\n      (0, 1, MOVE_DOWN),   # Move Down\n      (-1, 0, MOVE_LEFT),  # Move Left\n      (1, 0, MOVE_RIGHT)   # Move Right\n  ]\n\n  while queue:\n    cx, cy = queue.popleft() # Current cell coordinates, representing the agent's potential position\n\n    # Check if the primitive is in the 3x3 neighborhood around (cx, cy).\n    # The agent needs to move to (cx, cy) to be adjacent, then perform USE.\n    # This aligns with CraftState.next_to which checks a 3x3 neighborhood.\n    for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n            # Skip the current cell itself (where the agent would be)\n            if dx_adj == 0 and dy_adj == 0:\n                continue\n\n            px, py = cx + dx_adj, cy + dy_adj # (px, py) is a potential location of the primitive\n\n            # Ensure (px, py) is within grid bounds\n            if 0 <= px < width and 0 <= py < height:\n                # Check if this neighbor cell (px, py) contains the target primitive\n                if grid[px, py, primitive_idx] == 1:\n                    found_primitive_adj = True\n                    \n                    # Reconstruct the path from start_pos to (cx, cy).\n                    # (cx, cy) is the final position for the agent before using the primitive.\n                    current_node = (cx, cy)\n                    path_segment = []\n                    while current_node != start_pos:\n                        prev_node, action = parent[current_node]\n                        path_segment.append(action)\n                        current_node = prev_node\n                    \n                    final_path_actions = path_segment[::-1] # Reverse to get actions in correct order\n                    break # Found the closest primitive, no need to check other neighbors of (cx, cy)\n        if found_primitive_adj:\n            break # Exit the inner loop if found\n\n    if found_primitive_adj:\n        break # Exit the main BFS loop as the target has been found and path is reconstructed\n\n    # If the primitive is not adjacent to the current cell (cx, cy),\n    # explore its walkable neighbors for further movement.\n    for dx_move, dy_move, action_id in move_options:\n        nx, ny = cx + dx_move, cy + dy_move # (nx, ny) is the cell we are considering moving into\n        \n        # Check if the new position is within bounds and has not been visited yet\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n            is_walkable = True\n            # Check if the target cell (nx, ny) contains any unwalkable entity\n            # Iterate through all kinds present in cell (nx, ny)\n            for k_idx in range(n_kinds):\n                # If a kind is present at (nx, ny) AND that kind is in our unwalkable set\n                if grid[nx, ny, k_idx] == 1 and k_idx in unwalkable_entities_indices:\n                    is_walkable = False\n                    break # This cell is unwalkable, stop checking its contents\n            \n            if is_walkable:\n                visited.add((nx, ny))\n                parent[(nx, ny)] = ((cx, cy), action_id) # Store how we got to (nx, ny)\n                queue.append((nx, ny))\n\n  if found_primitive_adj:\n    # If a path was found, append the USE action at the end to collect the primitive\n    final_path_actions.append(USE_ACTION)\n    return final_path_actions\n  else:\n    # If no path to any primitive was found (e.g., unreachable or not present)\n    return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:14:48.974461", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  state = env._current_state\n  \n  # Improvement: If the primitive is already in the inventory, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  current_grid = state.grid\n  current_pos = state.pos\n  \n  width, height, _ = current_grid.shape\n\n  # Define \"impassable\" items. These are entities the agent likely cannot move onto or through.\n  # We use `env.world.non_grabbable_indices` as the set of items that make a cell impassable.\n  impassable_set = env.world.non_grabbable_indices\n  \n  def is_valid_and_traversable(x, y):\n      \"\"\"Checks if a cell (x, y) is within grid boundaries and does not contain impassable items.\"\"\"\n      # Check boundaries\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      \n      # Get indices of all item kinds present at (x, y)\n      present_kinds_at_cell = np.where(current_grid[x, y] == 1.0)[0]\n      \n      # Check if any of these present kinds are in the impassable set.\n      # This assumes any non_grabbable item (like a wall, not water if water is traversable) makes a cell impassable.\n      for k_idx in present_kinds_at_cell:\n          if k_idx in impassable_set:\n              return False # This cell contains an impassable item, so it's not traversable\n              \n      return True # Cell is valid and traversable\n\n  # 1. Find all locations on the grid where the target primitive exists\n  target_primitive_locations = []\n  for x in range(width):\n    for y in range(height):\n      if current_grid[x, y, primitive_idx] == 1.0:\n        target_primitive_locations.append((x, y))\n\n  if not target_primitive_locations: # If primitive is not found anywhere\n    return []\n\n  # 2. Determine all potential goal cells for BFS (cells that are valid and traversable, and adjacent to any primitive instance)\n  goal_cells = set()\n  # Directions to check for adjacent cells (relative offsets)\n  # Assuming pos = (x, y) where x is horizontal (column) and y is vertical (row).\n  # The agent needs to be adjacent to the primitive to 'USE' it.\n  adj_offsets = [(-1,0), (1,0), (0,-1), (0,1)] # Corresponds to LEFT, RIGHT, UP, DOWN relative movements\n  \n  for px, py in target_primitive_locations:\n    for dx_offset, dy_offset in adj_offsets:\n      adj_x, adj_y = px + dx_offset, py + dy_offset\n      # An adjacent cell is a potential goal if it's valid and traversable\n      if is_valid_and_traversable(adj_x, adj_y):\n        goal_cells.add((adj_x, adj_y))\n\n  if not goal_cells: # If no reachable adjacent cells to any primitive\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  q = collections.deque([(current_pos, [])]) # Queue stores tuples of (position, path_actions_taken)\n  visited = {current_pos} # Set of visited positions to avoid cycles\n\n  found_path = None # To store the shortest path found\n\n  # Possible moves and their corresponding actions.\n  # Improvement: Corrected mapping of (dx, dy) offsets to action constants.\n  # Based on (x, y) where x is column index, y is row index:\n  # UP: (x, y-1) -> offset (0, -1)\n  # DOWN: (x, y+1) -> offset (0, 1)\n  # LEFT: (x-1, y) -> offset (-1, 0)\n  # RIGHT: (x+1, y) -> offset (1, 0)\n  \n  moves = [\n      ((0, -1), UP_ACTION),    # Move UP (decrease Y)\n      ((0, 1), DOWN_ACTION),   # Move DOWN (increase Y)\n      ((-1, 0), LEFT_ACTION),  # Move LEFT (decrease X)\n      ((1, 0), RIGHT_ACTION)   # Move RIGHT (increase X)\n  ]\n\n  while q:\n    curr_pos, path_actions = q.popleft()\n\n    # If the current position is one of the goal cells, we've found the shortest path\n    if curr_pos in goal_cells:\n      found_path = path_actions\n      break\n\n    # Explore neighbors\n    for (dx, dy), action in moves:\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      if is_valid_and_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action]))\n\n  if found_path is None: # No path found to any adjacent cell\n    return []\n\n  # 4. If the primitive is grabbable, append the USE action to the path\n  if primitive_idx in env.world.grabbable_indices:\n    found_path.append(USE_ACTION)\n\n  return found_path", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:14:51.079078", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos\n  \n  width, height, _ = current_grid.shape\n\n  # Define \"impassable\" items. These are entities the agent likely cannot move onto or through.\n  impassable_set = env.world.non_grabbable_indices\n  \n  def is_valid_and_traversable(x, y):\n      \"\"\"Checks if a cell (x, y) is within grid boundaries and does not contain impassable items.\"\"\"\n      # Check boundaries\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      \n      # Get indices of all item kinds present at (x, y)\n      present_kinds_at_cell = np.where(current_grid[x, y] == 1.0)[0]\n      \n      # Check if any of these present kinds are in the impassable set\n      for k_idx in present_kinds_at_cell:\n          if k_idx in impassable_set:\n              return False # This cell contains an impassable item, so it's not traversable\n              \n      return True # Cell is valid and traversable\n\n  # 1. Find all locations on the grid where the target primitive exists\n  target_primitive_locations = []\n  for x in range(width):\n    for y in range(height):\n      if current_grid[x, y, primitive_idx] == 1.0:\n        target_primitive_locations.append((x, y))\n\n  if not target_primitive_locations: # If primitive is not found anywhere\n    return []\n\n  # 2. Determine all potential goal cells for BFS (cells that are valid and traversable, and adjacent to any primitive instance)\n  goal_cells = set()\n  # Directions to check for adjacent cells (relative offsets)\n  adj_offsets = [(-1,0), (1,0), (0,-1), (0,1)] # Corresponds to UP, DOWN, LEFT, RIGHT moves based on collect_v0's mapping\n\n  for px, py in target_primitive_locations:\n    for dx_offset, dy_offset in adj_offsets:\n      adj_x, adj_y = px + dx_offset, py + dy_offset\n      # An adjacent cell is a potential goal if it's valid and traversable\n      if is_valid_and_traversable(adj_x, adj_y):\n        goal_cells.add((adj_x, adj_y))\n\n  if not goal_cells: # If no reachable adjacent cells to any primitive\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  q = collections.deque([(current_pos, [])]) # Queue stores tuples of (position, path_actions_taken)\n  visited = {current_pos} # Set of visited positions to avoid cycles\n\n  found_path = None # To store the shortest path found\n\n  # Possible moves and their corresponding actions, based on collect_v0's mapping\n  moves = [\n      ((-1, 0), UP_ACTION),    # Move North (decreasing Y if Y is UP), assuming (X,Y) and Y is vertical\n      ((1, 0), DOWN_ACTION),   # Move South (increasing Y if Y is DOWN)\n      ((0, -1), LEFT_ACTION),  # Move West (decreasing X)\n      ((0, 1), RIGHT_ACTION)   # Move East (increasing X)\n  ]\n\n  while q:\n    curr_pos, path_actions = q.popleft()\n\n    # If the current position is one of the goal cells, we've found the shortest path\n    if curr_pos in goal_cells:\n      found_path = path_actions\n      break\n\n    # Explore neighbors\n    for (dx, dy), action in moves:\n      next_x, next_y = curr_pos[0] + dx, curr_pos[1] + dy\n      next_pos = (next_x, next_y)\n\n      if is_valid_and_traversable(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action]))\n\n  if found_path is None: # No path found to any adjacent cell\n    return []\n\n  # 4. Append the USE action if the primitive is grabbable, a workshop, or water.\n  # This makes the 'collect' function more versatile for interacting with environmental elements.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_water = primitive_idx == env.world.water_index\n\n  if is_grabbable or is_workshop or is_water:\n    found_path.append(USE_ACTION)\n\n  return found_path", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:15:47.755789", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos\n  \n  width, height, n_kinds = current_grid.shape\n\n  # Get indices for known non-traversable terrain (obstacles for agent movement)\n  boundary_idx = env.world.cookbook.index['BOUNDARY'] if 'BOUNDARY' in env.world.cookbook.index.contents else -1\n  water_idx = env.world.cookbook.index['WATER'] if 'WATER' in env.world.cookbook.index.contents else -1\n  \n  def is_traversable_for_agent(x, y):\n      \"\"\"Checks if cell (x, y) is within grid bounds and traversable by the agent.\"\"\"\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      # Check if any obstacle is present at (x,y)\n      if boundary_idx != -1 and current_grid[x, y, boundary_idx] == 1.0:\n          return False\n      if water_idx != -1 and current_grid[x, y, water_idx] == 1.0:\n          return False\n      return True\n\n  # 1. Identify all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(width):\n      for y in range(height):\n          if current_grid[x, y, primitive_idx] == 1.0:\n              primitive_locations.append((x, y))\n  \n  if not primitive_locations:\n      return [] # Primitive not found anywhere\n\n  # 2. Determine the set of target cells for BFS.\n  # These are all traversable cells (x, y) such that if the agent moves to (x, y),\n  # then state.next_to(primitive_idx) would be True.\n  # The next_to function checks the 3x3 neighborhood around the agent's position,\n  # including the agent's current cell.\n  target_cells = set()\n  \n  # Define relative movements for neighbors (to check adjacency)\n  neighbor_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations:\n      # Add the primitive's own cell if it's traversable by the agent\n      if is_traversable_for_agent(px, py):\n          target_cells.add((px, py))\n      # Add all traversable neighbors of the primitive's cell\n      for dx, dy in neighbor_offsets:\n          adj_x, adj_y = px + dx, py + dy\n          if is_traversable_for_agent(adj_x, adj_y):\n              target_cells.add((adj_x, adj_y))\n  \n  if not target_cells: # No reachable target cells (either on or adjacent to primitive)\n      return []\n\n  # Handle immediate case: if agent is already at a target_cell\n  if current_pos in target_cells:\n      if primitive_idx in env.world.grabbable_indices:\n          return [USE_ACTION]\n      else:\n          # Cannot \"collect\" a non-grabbable item (e.g., WORKSHOP) by just being next to it\n          # if \"collect\" implies picking up.\n          return [] \n\n  # 3. BFS to find the shortest path from current_pos to any target_cell\n  queue = collections.deque([(current_pos, [])]) # (position_tuple, actions_list_to_reach_here)\n  visited = {current_pos}\n\n  # Mapping of (dx, dy) to action constant for agent movement\n  action_deltas = {\n      (0, -1): UP_ACTION,\n      (0, 1): DOWN_ACTION,\n      (-1, 0): LEFT_ACTION,\n      (1, 0): RIGHT_ACTION\n  }\n  \n  best_path_actions = [] # This will store the shortest path found by BFS\n\n  while queue:\n      (r, c), path_actions = queue.popleft()\n\n      # Explore neighbors\n      for dr, dc in neighbor_offsets: # Using neighbor_offsets for exploring potential agent moves\n          nr, nc = r + dr, c + dc\n          \n          if is_traversable_for_agent(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              action_to_take = action_deltas[(dr, dc)]\n              new_path_actions = path_actions + [action_to_take]\n              \n              if (nr, nc) in target_cells:\n                  # Found a shortest path to a target cell (BFS guarantees shortest)\n                  best_path_actions = new_path_actions\n                  queue.clear() # Clear queue to stop further exploration\n                  break # Exit inner loop for neighbors, as we found the shortest path\n              else:\n                  queue.append(((nr, nc), new_path_actions))\n  \n  # 4. If a path was found, append the USE action if the primitive is grabbable\n  if best_path_actions: # Check if best_path_actions is not empty (i.e., a path was found)\n      if primitive_idx in env.world.grabbable_indices:\n          best_path_actions.append(USE_ACTION)\n      return best_path_actions\n  else:\n      return [] # No path found to any target cell", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:15:49.798818", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index.get(primitive)\n  if primitive_idx is None:\n      # If the primitive name is not recognized, we cannot collect it.\n      return []\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos\n  \n  width, height, n_kinds = current_grid.shape\n\n  # Get indices for known non-traversable terrain (obstacles for agent movement)\n  # Using .get for robustness, default to -1 if not found.\n  # These are generally the fixed, untraversable elements.\n  boundary_idx = env.world.cookbook.index.get('BOUNDARY', -1)\n  water_idx = env.world.cookbook.index.get('WATER', -1)\n  \n  def is_traversable_for_agent(x, y):\n      \"\"\"Checks if cell (x, y) is within grid bounds and traversable by the agent.\"\"\"\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      if boundary_idx != -1 and current_grid[x, y, boundary_idx] == 1.0:\n          return False\n      if water_idx != -1 and current_grid[x, y, water_idx] == 1.0:\n          return False\n      return True\n\n  # 1. Identify all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(width):\n      for y in range(height):\n          if current_grid[x, y, primitive_idx] == 1.0:\n              primitive_locations.append((x, y))\n  \n  if not primitive_locations:\n      return [] # Primitive not found anywhere on the grid\n\n  # 2. Determine the set of target cells for BFS: any traversable cell adjacent to a primitive location.\n  target_adj_cells = set()\n  \n  # Define relative movements for neighbors (to check adjacency)\n  neighbor_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n\n  for px, py in primitive_locations:\n      for dx, dy in neighbor_offsets:\n          adj_x, adj_y = px + dx, py + dy\n          if is_traversable_for_agent(adj_x, adj_y):\n              target_adj_cells.add((adj_x, adj_y))\n  \n  if not target_adj_cells: # No reachable adjacent traversable cells to any primitive\n      return []\n\n  # Handle immediate case: if agent is already at a target_adj_cell\n  if current_pos in target_adj_cells:\n      if primitive_idx in env.world.grabbable_indices:\n          return [USE_ACTION]\n      else:\n          # Cannot \"collect\" a non-grabbable item (e.g., WORKSHOP, BENCH).\n          # This function is specifically for \"collecting\" grabbable primitives.\n          return [] \n\n  # 3. BFS to find the shortest path from current_pos to any target_adj_cell\n  queue = collections.deque([(current_pos, [])]) # (position_tuple, actions_list_to_reach_here)\n  visited = {current_pos}\n\n  # Mapping of (dx, dy) to action constant for agent movement\n  action_deltas = {\n      (0, -1): UP_ACTION,\n      (0, 1): DOWN_ACTION,\n      (-1, 0): LEFT_ACTION,\n      (1, 0): RIGHT_ACTION\n  }\n  \n  best_path_actions = [] # This will store the shortest path found by BFS\n\n  while queue:\n      (r, c), path_actions = queue.popleft()\n\n      # Explore neighbors\n      for dr, dc in neighbor_offsets:\n          nr, nc = r + dr, c + dc\n          \n          if is_traversable_for_agent(nr, nc) and (nr, nc) not in visited:\n              visited.add((nr, nc))\n              action_to_take = action_deltas[(dr, dc)]\n              new_path_actions = path_actions + [action_to_take]\n              \n              if (nr, nc) in target_adj_cells:\n                  # Found a shortest path to a target adjacent cell (BFS guarantees shortest)\n                  best_path_actions = new_path_actions\n                  queue.clear() # Clear queue and break all loops to stop further exploration\n                  break \n              else:\n                  queue.append(((nr, nc), new_path_actions))\n      # If queue was cleared by inner break, also break outer loop\n      if not queue and best_path_actions:\n          break\n  \n  # 4. If a path was found, append the USE action if the primitive is grabbable\n  if best_path_actions: # Check if best_path_actions is not empty (i.e., a path was found)\n      if primitive_idx in env.world.grabbable_indices:\n          best_path_actions.append(USE_ACTION)\n      return best_path_actions\n  else:\n      return [] # No path found to any adjacent traversable cell", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:17:13.132263", "function_name": "collect", "function_body": "  def _check_next_to_at_pos(grid, current_x, current_y, kind_idx, grid_width, grid_height):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around (current_x, current_y) contains `kind_idx`.\n      `grid` shape is (WIDTH, HEIGHT, n_kinds), so (x, y) indexing is used for grid cells.\n      \"\"\"\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = current_x + dx, current_y + dy\n              # Check if the neighbor cell is within grid boundaries\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  # Check if the target kind is present at the neighbor cell (count > 0)\n                  if grid[nx, ny, kind_idx] > 0:\n                      return True\n      return False\n\n  # Retrieve action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get current environment state and world configuration\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get the integer index for the primitive from the cookbook's index\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Determine properties of the primitive\n  is_grabbable = primitive_idx in world.grabbable_indices\n  is_workshop = primitive_idx in world.workshop_indices\n  is_boundary = primitive_idx == cookbook.index['BOUNDARY']\n  is_water = primitive_idx == world.water_index\n  is_stone = primitive_idx == world.stone_index\n\n  # Optimization: If it's a grabbable item and already in the agent's inventory,\n  # no actions are needed as the collection goal is already satisfied.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n      return []\n\n  # Current agent's position (x, y) and direction, and the grid layout\n  start_x, start_y = state.pos\n  start_dir = state.dir  # Agent's initial facing direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  grid = state.grid      # Current grid layout (numpy.ndarray: WIDTH x HEIGHT x n_kinds)\n  \n  grid_width, grid_height, _ = grid.shape # Dimensions of the grid (WIDTH, HEIGHT)\n\n  # Define possible movement actions and their effects on (dx, dy, new_direction_value)\n  # dx, dy correspond to changes in x (column) and y (row) coordinates.\n  # The new_direction_value corresponds to the agent's internal state.dir after the move.\n  action_moves = {\n      ACTION_UP:    (0, -1, 0),  # Move UP: y decreases by 1, agent faces UP (dir 0)\n      ACTION_DOWN:  (0, 1, 2),   # Move DOWN: y increases by 1, agent faces DOWN (dir 2)\n      ACTION_LEFT:  (-1, 0, 3),  # Move LEFT: x decreases by 1, agent faces LEFT (dir 3)\n      ACTION_RIGHT: (1, 0, 1),   # Move RIGHT: x increases by 1, agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell for an ACTION_USE, relative to the agent's position\n  # based on its current facing direction.\n  # Values are (dx, dy) to add to agent's (x, y) to get the cell in front.\n  dir_to_target_delta = {\n      0: (0, -1),  # Agent facing UP (dir 0) targets the cell above (x, y-1)\n      1: (1, 0),   # Agent facing RIGHT (dir 1) targets the cell to the right (x+1, y)\n      2: (0, 1),   # Agent facing DOWN (dir 2) targets the cell below (x, y+1)\n      3: (-1, 0),  # Agent facing LEFT (dir 3) targets the cell to the left (x-1, y)\n  }\n\n  # Define which kinds are generally impassable to step ONTO.\n  # Boundary and Workshops are typically impassable to step onto.\n  # Water/Stone are typically passable if they are the target primitive.\n  impassable_for_movement = set()\n  for k_idx in world.non_grabbable_indices:\n      # If k_idx is the primitive we are looking for, it's only impassable if it's a workshop or boundary.\n      # Water/Stone are non-grabbable, but agent can step on them if they are the target.\n      if k_idx == primitive_idx:\n          if is_workshop or is_boundary:\n              impassable_for_movement.add(k_idx)\n      else:\n          # Any other non-grabbable kind is always an obstacle.\n          impassable_for_movement.add(k_idx)\n  \n  # --- Initial check: Is the primitive collectable from the agent's starting state? ---\n  # This part checks if the goal is already satisfied without any moves.\n  if is_grabbable:\n      # Agent needs to be facing the item to USE it.\n      target_dx, target_dy = dir_to_target_delta[start_dir]\n      target_x, target_y = start_x + target_dx, start_y + target_dy\n      if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n          grid[target_x, target_y, primitive_idx] > 0): \n          return [ACTION_USE]\n  elif is_workshop:\n      # Agent needs to be adjacent to the workshop.\n      if _check_next_to_at_pos(grid, start_x, start_y, primitive_idx, grid_width, grid_height):\n          return [] # Already adjacent, no actions needed.\n  elif is_water or is_stone:\n      # Agent needs to be on the water/stone tile.\n      if grid[start_x, start_y, primitive_idx] > 0:\n          return [] # Already on the tile, no actions needed.\n\n  # --- Breadth-First Search (BFS) for the shortest path ---\n  q = collections.deque()\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_to_reach_here)\n  q.append((start_x, start_y, start_dir, []))\n\n  # Visited set to prevent revisiting states and cycles.\n  # A state is defined by the agent's (x, y, direction).\n  visited = {(start_x, start_y, start_dir)}\n\n  while q:\n    x, y, current_dir, path = q.popleft() # Dequeue the current state and path\n\n    # Explore all possible movement actions from the current state\n    for action_id, (dx_move, dy_move, new_facing_dir) in action_moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_dir = new_facing_dir # Agent's direction after performing this movement action\n\n      # 1. Boundary Check: Ensure the new position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Obstacle Check: Determine if the new position is blocked by any impassable kind.\n      is_blocked = False\n      for k_idx in impassable_for_movement:\n          if grid[next_x, next_y, k_idx] > 0:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue # Cannot move onto an obstacle.\n\n      # 3. Visited Check: Ensure this (position, direction) state has not been visited before.\n      if (next_x, next_y, next_dir) in visited:\n        continue\n\n      # If all checks pass, this is a valid new state.\n      new_path = path + [action_id]\n      visited.add((next_x, next_y, next_dir)) # Mark the new state as visited\n\n      # --- Check if the primitive is collectable from this new state (next_x, next_y, next_dir) ---\n      if is_grabbable:\n          # For grabbable items, the agent must be in a position to face and 'USE' the item.\n          target_dx, target_dy = dir_to_target_delta[next_dir]\n          target_x, target_y = next_x + target_dx, next_y + target_dy\n\n          # Check if the target cell is valid and contains the primitive.\n          if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n              grid[target_x, target_y, primitive_idx] > 0): \n              # Found a path to reach a position where the primitive can be used.\n              return new_path + [ACTION_USE] # Append the 'USE' action to complete collection.\n      elif is_workshop:\n          # For workshops, being adjacent to the workshop at the new position is sufficient.\n          if _check_next_to_at_pos(grid, next_x, next_y, primitive_idx, grid_width, grid_height):\n              # Found a path to be adjacent to the workshop.\n              return new_path # No additional 'USE' action is needed for workshops.\n      elif is_water or is_stone:\n          # For water or stone, being on the tile is sufficient.\n          if grid[next_x, next_y, primitive_idx] > 0:\n              # Found a path to be on the water/stone.\n              return new_path\n\n      # If the goal is not yet achieved from this new state, add it to the queue for further exploration.\n      q.append((next_x, next_y, next_dir, new_path))\n\n  # If the BFS queue becomes empty and no path was found to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:17:15.125893", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitve passed int he function in the passed env. \"\"\"\n\n  # Helper function to check if a specific kind is in the 3x3 neighborhood around a position.\n  def _check_next_to_at_pos(grid, current_x, current_y, kind_idx, grid_width, grid_height):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around (current_x, current_y) contains `kind_idx`.\n      `grid` shape is (WIDTH, HEIGHT, n_kinds), so (x, y) indexing is used for grid cells.\n      \"\"\"\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = current_x + dx, current_y + dy\n              # Check if the neighbor cell is within grid boundaries\n              if 0 <= nx < grid_width and 0 <= ny < grid_height:\n                  # Check if the target kind is present at the neighbor cell (count > 0)\n                  if grid[nx, ny, kind_idx] > 0:\n                      return True\n      return False\n\n  # Retrieve action mappings from the environment\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Get current environment state and world configuration\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get the integer index for the primitive from the cookbook's index\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    return []\n\n  # Determine properties of the primitive for collection logic\n  is_grabbable = primitive_idx in world.grabbable_indices\n  is_workshop = primitive_idx in world.workshop_indices\n  # Use specific checks for WATER/STONE for obstacle logic\n  # Assuming world.water_index and world.stone_index might be available, otherwise check name\n  is_water = (primitive == \"WATER\") or (hasattr(world, 'water_index') and primitive_idx == world.water_index)\n  is_stone = (primitive == \"STONE\") or (hasattr(world, 'stone_index') and primitive_idx == world.stone_index)\n\n\n  # Optimization: If it's a grabbable item and already in the agent's inventory,\n  # no actions are needed as the collection goal is already satisfied.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n      return []\n\n  # Current agent's position (x, y) and direction, and the grid layout\n  start_x, start_y = state.pos\n  start_dir = state.dir  # Agent's initial facing direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  grid = state.grid      # Current grid layout (numpy.ndarray: WIDTH x HEIGHT x n_kinds)\n  \n  grid_width, grid_height, _ = grid.shape # Dimensions of the grid (WIDTH, HEIGHT)\n\n  # Define possible movement actions and their effects on (dx, dy, new_direction_value)\n  # dx, dy correspond to changes in x (column) and y (row) coordinates.\n  # The new_direction_value corresponds to the agent's internal state.dir after the move.\n  action_moves = {\n      ACTION_UP:    (0, -1, 0),  # Move UP: y decreases by 1, agent faces UP (dir 0)\n      ACTION_DOWN:  (0, 1, 2),   # Move DOWN: y increases by 1, agent faces DOWN (dir 2)\n      ACTION_LEFT:  (-1, 0, 3),  # Move LEFT: x decreases by 1, agent faces LEFT (dir 3)\n      ACTION_RIGHT: (1, 0, 1),   # Move RIGHT: x increases by 1, agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell for an ACTION_USE, relative to the agent's position\n  # based on its current facing direction.\n  # Values are (dx, dy) to add to agent's (x, y) to get the cell in front.\n  dir_to_target_delta = {\n      0: (0, -1),  # Agent facing UP (dir 0) targets the cell above (x, y-1)\n      1: (1, 0),   # Agent facing RIGHT (dir 1) targets the cell to the right (x+1, y)\n      2: (0, 1),   # Agent facing DOWN (dir 2) targets the cell below (x, y+1)\n      3: (-1, 0),  # Agent facing LEFT (dir 3) targets the cell to the left (x-1, y)\n  }\n\n  # Define obstacles: These are non-grabbable entities that the agent cannot typically move onto.\n  # Critically, some non-grabbables (like WATER, STONE) might be traversable if they are the target,\n  # while others (like WORKSHOP structures, BOUNDARY walls) are generally impassable.\n  impassable_kinds_indices = set()\n  for idx in world.non_grabbable_indices:\n      # If the current non-grabbable 'idx' is the target primitive,\n      # and it's one of the types we are allowed to walk *onto* (like WATER or STONE),\n      # then it should not be considered an obstacle for itself.\n      if idx == primitive_idx and (is_water or is_stone):\n          continue # Do not add the target WATER/STONE as an obstacle, as we might walk onto it.\n      \n      # For all other non-grabbables, including workshops (which are impassable terrain),\n      # add them to the set of impassable kinds.\n      impassable_kinds_indices.add(idx)\n\n  # --- Initial check: Is the primitive collectable from the agent's starting state? ---\n  if is_grabbable:\n      # If grabbable, check if agent is already in position to 'USE' it.\n      # Calculate the cell directly in front of the agent at start_x, start_y and start_dir.\n      target_dx, target_dy = dir_to_target_delta[start_dir]\n      target_x, target_y = start_x + target_dx, start_y + target_dy\n\n      # Check if this target cell is within grid bounds and contains the primitive.\n      if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n          grid[target_x, target_y, primitive_idx] > 0): \n          # Agent is already facing the grabbable item. Only the 'USE' action is needed.\n          return [ACTION_USE]\n  elif is_workshop:\n      # If workshop, check if agent is already adjacent to it.\n      if _check_next_to_at_pos(grid, start_x, start_y, primitive_idx, grid_width, grid_height):\n          # Agent is already adjacent to the workshop. No further actions needed to \"collect\".\n          return []\n  else: # Other non-grabbables (e.g., WATER, STONE, BOUNDARY). Assume collection means being on the tile.\n      if grid[start_x, start_y, primitive_idx] > 0:\n          # Agent is already on the non-grabbable item.\n          return []\n\n  # --- Breadth-First Search (BFS) for the shortest path ---\n  q = collections.deque()\n  # Queue stores tuples: (current_x, current_y, current_direction, list_of_actions_to_reach_here)\n  q.append((start_x, start_y, start_dir, []))\n\n  # Visited set to prevent revisiting states and cycles.\n  # A state is defined by the agent's (x, y, direction).\n  visited = {(start_x, start_y, start_dir)}\n\n  while q:\n    x, y, current_dir, path = q.popleft() # Dequeue the current state and path\n\n    # Explore all possible movement actions from the current state\n    for action_id, (dx_move, dy_move, new_facing_dir) in action_moves.items():\n      next_x, next_y = x + dx_move, y + dy_move\n      next_dir = new_facing_dir # Agent's direction after performing this movement action\n\n      # 1. Boundary Check: Ensure the new position is within the grid boundaries.\n      if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n        continue\n\n      # 2. Obstacle Check: Determine if the new position is blocked by any impassable obstacle.\n      is_blocked = False\n      for k_idx in impassable_kinds_indices:\n          # If any kind marked as an impassable obstacle is present at the next cell, it's blocked.\n          if grid[next_x, next_y, k_idx] > 0:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue # Cannot move onto an obstacle.\n\n      # 3. Visited Check: Ensure this (position, direction) state has not been visited before.\n      if (next_x, next_y, next_dir) in visited:\n        continue\n\n      # If all checks pass, this is a valid new state.\n      new_path = path + [action_id]\n      visited.add((next_x, next_y, next_dir)) # Mark the new state as visited\n\n      # --- Check if the primitive is collectable from this new state (next_x, next_y, next_dir) ---\n      if is_grabbable:\n          # For grabbable items, the agent must be in a position to face and 'USE' the item.\n          target_dx, target_dy = dir_to_target_delta[next_dir]\n          target_x, target_y = next_x + target_dx, next_y + target_dy\n\n          # Check if the target cell is valid and contains the primitive.\n          if (0 <= target_x < grid_width and 0 <= target_y < grid_height and\n              grid[target_x, target_y, primitive_idx] > 0): \n              # Found a path to reach a position where the primitive can be used.\n              return new_path + [ACTION_USE] # Append the 'USE' action to complete collection.\n      elif is_workshop:\n          # For workshops, being adjacent to the primitive at the new position is sufficient.\n          if _check_next_to_at_pos(grid, next_x, next_y, primitive_idx, grid_width, grid_height):\n              # Found a path to be adjacent to the primitive.\n              return new_path \n      else: # Other non-grabbables (e.g., WATER, STONE, BOUNDARY). Assume standing on it means collection.\n          if grid[next_x, next_y, primitive_idx] > 0:\n              # Found a path to be on the primitive.\n              return new_path \n      \n      # If the goal is not yet achieved from this new state, add it to the queue for further exploration.\n      q.append((next_x, next_y, next_dir, new_path))\n\n  # If the BFS queue becomes empty and no path was found to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:18:31.577129", "function_name": "collect", "function_body": "  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Helper map for converting movement deltas (change in x, change in y) to action IDs.\n  MOVE_DELTAS_TO_ACTION = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  actions_sequence = []\n\n  # Convert the primitive string (DSL name) to its integer ID used by the simulation.\n  primitive_name_lower = primitive.lower()\n  try:\n      primitive_id = env.world.cookbook.index[primitive_name_lower]\n  except KeyError:\n      # If the primitive name is not recognized, it's an invalid target.\n      return []\n\n  # Early Exit Conditions:\n  # 1. If the primitive is not grabbable, it cannot be collected using this function.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 2. Check if the primitive is already in the agent's inventory. If so, no actions are needed.\n  current_observations = env.observations()\n  current_inventory = current_observations['features_dict']['inventory']\n  if current_inventory[primitive_id] > 0:\n      return []\n\n  # Retrieve current state information necessary for pathfinding.\n  agent_current_pos = tuple(map(int, current_observations['features_dict']['pos']))\n  grid_layout = current_observations['features_dict']['features_global']\n\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_layout.shape\n\n  # Define truly impassable entities for agent movement.\n  # IMPROVEMENT: In many grid-world games, 'non_grabbable' items like workshops\n  # are meant to be traversable, even if they cannot be picked up.\n  # `collect_v1` might have incorrectly considered all `non_grabbable_indices` as impassable\n  # for movement. This version refines `impassable_movement_ids` to exclude workshops,\n  # assuming they are traversable. Boundary and Water are typically always impassable.\n  impassable_movement_ids = set(env.world.non_grabbable_indices)\n\n  # Remove workshop indices from the set of impassable movement IDs,\n  # assuming the agent can walk onto workshop locations.\n  for workshop_id in env.world.workshop_indices:\n      if workshop_id in impassable_movement_ids:\n          impassable_movement_ids.remove(workshop_id)\n  \n  # Ensure 'boundary' and 'water' are included as truly impassable if they exist.\n  # (These are typically already in non_grabbable_indices, but explicit ensures.)\n  try:\n      impassable_movement_ids.add(env.world.cookbook.index['boundary'])\n  except KeyError:\n      pass\n  try:\n      impassable_movement_ids.add(env.world.cookbook.index['water'])\n  except KeyError:\n      pass\n\n\n  # Helper function to check if a given cell (x, y) is traversable by the agent.\n  def is_cell_traversable(x, y):\n      # First, check if the coordinates are within the grid boundaries.\n      if not (0 <= x < GRID_WIDTH and 0 <= y < GRID_HEIGHT):\n          return False\n      # Second, check if the cell contains any impassable obstacles.\n      for obstacle_id in impassable_movement_ids:\n          if grid_layout[x, y, obstacle_id] > 0:\n              return False\n      return True\n\n  # Breadth-First Search (BFS) Implementation for Pathfinding.\n  # The BFS queue stores tuples: (current_agent_coordinates, path_of_coordinates_taken_to_reach_here).\n  bfs_queue = collections.deque([(agent_current_pos, [agent_current_pos])])\n  \n  # The `visited_positions` set prevents cycles and ensures we find the shortest path.\n  visited_positions = {agent_current_pos}\n\n  path_to_use_location = None # Stores the sequence of coordinates leading to the 'USE' spot.\n\n  while bfs_queue:\n      (current_agent_x, current_agent_y), current_path = bfs_queue.popleft()\n\n      # Check if the target primitive is within the 3x3 neighborhood of the current agent's position.\n      # The 'USE' action in CraftWorld typically collects items from this surrounding area.\n      primitive_found_nearby = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_agent_x + dx_offset, current_agent_y + dy_offset\n\n              # Ensure the neighbor cell is within the grid boundaries.\n              if not (0 <= neighbor_x < GRID_WIDTH and 0 <= neighbor_y < GRID_HEIGHT):\n                  continue\n\n              # Check if the target primitive is present in this neighbor cell.\n              if grid_layout[neighbor_x, neighbor_y, primitive_id] > 0:\n                  primitive_found_nearby = True\n                  break\n          if primitive_found_nearby:\n              break\n\n      # If the primitive is found in the neighborhood, we have found the path to collect it.\n      if primitive_found_nearby:\n          path_to_use_location = current_path\n          break # Path found, terminate the BFS.\n\n      # If the primitive is not found nearby, explore valid adjacent cells for agent movement.\n      for dx, dy in MOVE_DELTAS_TO_ACTION.keys():\n          next_agent_x, next_agent_y = current_agent_x + dx, current_agent_y + dy\n          next_agent_pos_tuple = (next_agent_x, next_agent_y)\n\n          # Check if the next potential agent position is traversable and has not been visited.\n          if is_cell_traversable(next_agent_x, next_agent_y) and \\\n             next_agent_pos_tuple not in visited_positions:\n              visited_positions.add(next_agent_pos_tuple)\n              # Add the new position to the current path and enqueue it for further exploration.\n              bfs_queue.append((next_agent_pos_tuple, current_path + [next_agent_pos_tuple]))\n\n  # Convert the found coordinate path into a sequence of actionable agent movements.\n  if path_to_use_location:\n      # Iterate through the path, reconstructing each movement action.\n      # The loop goes up to the second-to-last position as each action connects two points.\n      for i in range(len(path_to_use_location) - 1):\n          from_x, from_y = path_to_use_location[i]\n          to_x, to_y = path_to_use_location[i+1]\n\n          # Calculate the relative movement (change in x and y coordinates).\n          delta_x = to_x - from_x\n          delta_y = to_y - from_y\n\n          # Append the corresponding action ID (UP, DOWN, LEFT, RIGHT) to the sequence.\n          actions_sequence.append(MOVE_DELTAS_TO_ACTION[(delta_x, delta_y)])\n\n      # After all movements, the agent is at the optimal position to collect the primitive.\n      # Append the 'USE' action to finalize the collection process.\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:18:33.612847", "function_name": "collect", "function_body": "  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Helper map for converting movement deltas (change in x, change in y) to action IDs.\n  MOVE_DELTAS_TO_ACTION = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  actions_sequence = []\n\n  # 1. Convert the primitive string (DSL name) to its integer ID.\n  primitive_name_lower = primitive.lower()\n  try:\n      primitive_id = env.world.cookbook.index[primitive_name_lower]\n  except KeyError:\n      # If the primitive name is not recognized, return an empty list.\n      return []\n\n  # 2. Early Exit Conditions:\n  #    a. If the primitive is not grabbable, it cannot be collected this way.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  #    b. Check if the primitive is already in the agent's inventory.\n  current_observations = env.observations()\n  current_inventory = current_observations['features_dict']['inventory']\n  if current_inventory[primitive_id] > 0:\n      return []\n\n  # 3. Retrieve current state information.\n  agent_current_pos = tuple(map(int, current_observations['features_dict']['pos']))\n  grid_layout = current_observations['features_dict']['features_global']\n\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_layout.shape\n  impassable_movement_ids = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is within bounds and traversable.\n  def is_cell_traversable(x, y):\n      if not (0 <= x < GRID_WIDTH and 0 <= y < GRID_HEIGHT):\n          return False\n      for obstacle_id in impassable_movement_ids:\n          if grid_layout[x, y, obstacle_id] > 0:\n              return False\n      return True\n\n  # --- Improvement for V2: Pre-compute all valid agent positions from which 'USE' can collect the primitive ---\n  # This makes the BFS goal explicit and slightly optimizes the goal check within the BFS loop.\n  target_use_positions = set()\n  for x_grid in range(GRID_WIDTH):\n      for y_grid in range(GRID_HEIGHT):\n          # If the primitive exists at (x_grid, y_grid)...\n          if grid_layout[x_grid, y_grid, primitive_id] > 0:\n              # ...then any traversable cell in its 3x3 neighborhood is a valid 'use' location for the agent.\n              for dy_offset in [-1, 0, 1]:\n                  for dx_offset in [-1, 0, 1]:\n                      potential_use_x, potential_use_y = x_grid + dx_offset, y_grid + dy_offset\n                      # Only add traversable cells as potential agent positions.\n                      if is_cell_traversable(potential_use_x, potential_use_y):\n                          target_use_positions.add((potential_use_x, potential_use_y))\n\n  # If no possible 'use' positions are found (e.g., primitive is entirely enclosed by impassable terrain),\n  # then it's unreachable.\n  if not target_use_positions:\n      return []\n  # --- End of V2 Improvement ---\n\n  # 4. Breadth-First Search (BFS) for pathfinding.\n  bfs_queue = collections.deque([(agent_current_pos, [agent_current_pos])])\n  visited_positions = {agent_current_pos}\n  path_to_use_location = None\n\n  while bfs_queue:\n      (current_agent_x, current_agent_y), current_path = bfs_queue.popleft()\n\n      # Check if the current agent position is one of the pre-computed target 'use' positions.\n      if (current_agent_x, current_agent_y) in target_use_positions:\n          path_to_use_location = current_path\n          break # Path found, terminate BFS.\n\n      # Explore valid adjacent cells.\n      for dx, dy in MOVE_DELTAS_TO_ACTION.keys():\n          next_agent_x, next_agent_y = current_agent_x + dx, current_agent_y + dy\n          next_agent_pos_tuple = (next_agent_x, next_agent_y)\n\n          if is_cell_traversable(next_agent_x, next_agent_y) and \\\n             next_agent_pos_tuple not in visited_positions:\n              visited_positions.add(next_agent_pos_tuple)\n              bfs_queue.append((next_agent_pos_tuple, current_path + [next_agent_pos_tuple]))\n\n  # 5. Convert the found coordinate path into a sequence of agent movements and the 'USE' action.\n  if path_to_use_location:\n      # Reconstruct movement actions.\n      for i in range(len(path_to_use_location) - 1):\n          from_x, from_y = path_to_use_location[i]\n          to_x, to_y = path_to_use_location[i+1]\n          delta_x = to_x - from_x\n          delta_y = to_y - from_y\n          actions_sequence.append(MOVE_DELTAS_TO_ACTION[(delta_x, delta_y)])\n\n      # After moving to the optimal position, perform the 'USE' action.\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:19:47.637945", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  agent_r, agent_c = current_state.pos\n  initial_dir = current_state.dir # Agent's starting direction\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Define mappings for movement actions and their resulting agent directions.\n  # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  # (dr, dc) delta for movement -> (action_id, resulting_agent_direction)\n  MOVE_ACTIONS_AND_DIRECTIONS = {\n      (-1, 0): (action_map['UP'], 0),    # Move UP, agent faces UP\n      (0, 1): (action_map['RIGHT'], 1),  # Move RIGHT, agent faces RIGHT\n      (1, 0): (action_map['DOWN'], 2),   # Move DOWN, agent faces DOWN\n      (0, -1): (action_map['LEFT'], 3),  # Move LEFT, agent faces LEFT\n  }\n\n  # Define the required agent facing direction relative to the primitive for a successful 'USE' action.\n  # (relative_dr, relative_dc) of primitive from agent -> required_agent_direction\n  # This mapping is crucial if 'USE' actions interact with objects *in front* of the agent.\n  RELATIVE_PRIMITIVE_TO_AGENT_DIR = {\n      (-1, 0): 0, # Primitive is one cell UP from agent, agent must face UP\n      (0, 1): 1,  # Primitive is one cell RIGHT from agent, agent must face RIGHT\n      (1, 0): 2,  # Primitive is one cell DOWN from agent, agent must face DOWN\n      (0, -1): 3  # Primitive is one cell LEFT from agent, agent must face LEFT\n  }\n\n  # Identify indices of entities that block agent movement (e.g., water, stone).\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # Find all grid locations where the target primitive exists (quantity > 0).\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If there are no instances of the primitive in the world, it's impossible to collect.\n  if len(primitive_locations) == 0:\n      return []\n\n  # --- Precompute all \"goal states\" for the BFS ---\n  # A goal state is defined as a tuple ((row, col), required_direction_to_face) from which\n  # the agent can immediately 'USE' the primitive successfully.\n  goal_states = set()\n  for pr, pc in primitive_locations: # Iterate through each primitive's location\n      # Explore the four cardinal cells around the primitive. These are potential positions\n      # where the agent could stand to 'USE' the primitive.\n      for (dr_adj, dc_adj) in MOVE_ACTIONS_AND_DIRECTIONS.keys():\n          adj_r, adj_c = pr + dr_adj, pc + dc_adj # Candidate agent position (adjacent to primitive)\n\n          # Ensure the candidate agent position is within grid boundaries.\n          if not (0 <= adj_r < grid_height and 0 <= adj_c < grid_width):\n              continue\n\n          # Check if the candidate agent position is traversable (does not contain impassable terrain).\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[adj_r, adj_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Calculate the relative position of the primitive *from* this candidate agent position.\n          # This tells us where the primitive is in relation to the agent.\n          rel_r, rel_c = pr - adj_r, pc - adj_c\n          \n          # Determine the direction the agent needs to face from (adj_r, adj_c) to 'USE' this primitive.\n          required_face_dir = RELATIVE_PRIMITIVE_TO_AGENT_DIR.get((rel_r, rel_c))\n          \n          # If a valid facing direction is found (i.e., the primitive is one cardinal step away),\n          # add this (position, required direction) pair to our set of goal states.\n          if required_face_dir is not None:\n             goal_states.add(((adj_r, adj_c), required_face_dir))\n\n  # If no valid and traversable goal states can be identified, the primitive is unreachable.\n  if not goal_states:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest path to any goal state ---\n  # The BFS queue stores tuples: (current_position (r, c), current_direction, path_taken_so_far)\n  queue = collections.deque([((agent_r, agent_c), initial_dir, [])])\n  \n  # The visited set stores (position (r, c), direction) to prevent cycles and redundant exploration.\n  # This ensures we find the shortest path while accounting for agent's orientation.\n  visited = {(agent_r, agent_c, initial_dir)}\n\n  while queue:\n      (r, c), current_dir, path = queue.popleft() # Dequeue the current state\n\n      # Check if the current state (agent's position AND its current facing direction)\n      # matches any of our precomputed goal states.\n      if ((r, c), current_dir) in goal_states:\n          # If it matches, we have found the shortest path to a location where the primitive\n          # can be used, and the agent is already correctly oriented.\n          return path + [action_map['USE']]\n\n      # Explore all four cardinal movement options from the current position.\n      for (dr_move, dc_move), (move_action, next_agent_dir) in MOVE_ACTIONS_AND_DIRECTIONS.items():\n          next_r, next_c = r + dr_move, c + dc_move\n          next_pos = (next_r, next_c)\n          \n          # Check if the next cell is within grid boundaries.\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next cell contains impassable terrain.\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[next_r, next_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Check if this specific state (next position AND next direction) has already been visited.\n          if (next_r, next_c, next_agent_dir) in visited:\n              continue\n\n          # If the next state is valid and unvisited, add it to the queue and mark as visited.\n          new_path = path + [move_action]\n          visited.add((next_r, next_c, next_agent_dir))\n          queue.append((next_pos, next_agent_dir, new_path))\n  \n  # If the BFS queue becomes empty and no path to a goal state was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:19:49.623660", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  agent_r, agent_c = current_state.pos\n  initial_dir = current_state.dir # Agent's starting direction\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Define the mapping from a movement delta (dr, dc) to the resulting agent direction.\n  # In CraftWorld, movement actions typically set the agent's facing direction.\n  # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  # The keys are (dr, dc) movement vectors, and values are the corresponding agent direction constants.\n  # This implies that after moving, the agent faces the direction of the move.\n  DRDC_TO_DIR = {\n      (-1, 0): 0, # Moving UP (-1, 0) sets direction to UP (0)\n      (0, 1): 1,  # Moving RIGHT (0, 1) sets direction to RIGHT (1)\n      (1, 0): 2,  # Moving DOWN (1, 0) sets direction to DOWN (2)\n      (0, -1): 3, # Moving LEFT (0, -1) sets direction to LEFT (3)\n  }\n\n  # Define the mapping from the relative position of a primitive (from the agent's perspective)\n  # to the required direction the agent must be facing to 'USE' that primitive.\n  # e.g., if the primitive is at (agent_r-1, agent_c), its relative position is (-1, 0).\n  # The agent must then face UP (direction 0) to use it.\n  REL_TO_DIR = {\n      (-1, 0): 0, # Primitive is one cell UP, agent must face UP\n      (0, 1): 1,  # Primitive is one cell RIGHT, agent must face RIGHT\n      (1, 0): 2,  # Primitive is one cell DOWN, agent must face DOWN\n      (0, -1): 3  # Primitive is one cell LEFT, agent must face LEFT\n  }\n\n  # Find all grid locations where the primitive exists (quantity > 0)\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If there are no instances of the primitive in the world, nothing to collect.\n  if len(primitive_locations) == 0:\n      return []\n\n  # Identify indices of entities that block movement (e.g., water, stone).\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # --- Precompute all \"goal states\" for the BFS ---\n  # A goal state for BFS is a tuple ((row, col), required_direction_to_face) from which\n  # the agent can immediately 'USE' the primitive.\n  goal_states = set()\n  for pr, pc in primitive_locations: # Iterate through each primitive location\n      # Consider the four cardinal cells adjacent to the primitive. These are potential spots\n      # where the agent could stand to 'USE' the primitive.\n      # `dr_adj, dc_adj` represents the movement delta from a candidate agent position to the primitive.\n      # For example, if (dr_adj, dc_adj) is (-1, 0), it means the primitive is one cell UP from the agent.\n      for dr_prim_rel, dc_prim_rel in REL_TO_DIR.keys():\n          # Calculate the candidate agent position (adj_r, adj_c)\n          # This position is such that the primitive at (pr, pc) is at (dr_prim_rel, dc_prim_rel) relative to the agent.\n          adj_r, adj_c = pr - dr_prim_rel, pc - dc_prim_rel\n\n          # Ensure the candidate agent position is within grid boundaries.\n          if not (0 <= adj_r < grid_height and 0 <= adj_c < grid_width):\n              continue\n\n          # Check if the candidate agent position is traversable (not an impassable entity).\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[adj_r, adj_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Determine the direction the agent needs to face from (adj_r, adj_c) to 'USE' this primitive.\n          required_face_dir = REL_TO_DIR[(dr_prim_rel, dc_prim_rel)]\n          \n          # Add this (position, required direction) pair to our set of goal states.\n          goal_states.add(((adj_r, adj_c), required_face_dir))\n\n  # If there are no traversable cells from which a primitive can be collected, it's unreachable.\n  if not goal_states:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest path to any goal state ---\n  # The queue stores tuples: (current_position (r, c), current_direction, path_taken_so_far)\n  queue = collections.deque([((agent_r, agent_c), initial_dir, [])])\n  \n  # The visited set stores (position (r, c), direction) to avoid cycles and redundant exploration,\n  # ensuring we find the shortest path.\n  visited = {(agent_r, agent_c, initial_dir)}\n\n  while queue:\n      (r, c), current_dir, path = queue.popleft() # Dequeue the current state\n\n      # Check if the current state (position AND direction) is one of our precomputed goal states.\n      if ((r, c), current_dir) in goal_states:\n          # If it is, we have found the shortest path to a position where the primitive can be used.\n          # The agent is already facing the correct direction to use it.\n          return path + [action_map['USE']]\n\n      # Explore all four cardinal movement options from the current position.\n      # Each movement action also sets the agent's facing direction.\n      for (dr_move, dc_move), move_action_val in {\n          (-1, 0): action_map['UP'],\n          (0, 1): action_map['RIGHT'],\n          (1, 0): action_map['DOWN'],\n          (0, -1): action_map['LEFT'],\n      }.items():\n          next_r, next_c = r + dr_move, c + dc_move\n          next_pos = (next_r, next_c)\n          \n          # Determine the agent's new facing direction *after* this movement action.\n          next_agent_dir = DRDC_TO_DIR[(dr_move, dc_move)]\n\n          # Check if the next cell is within grid boundaries.\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next cell contains impassable terrain.\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[next_r, next_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Check if this specific state (next position AND next direction) has already been visited.\n          if (next_r, next_c, next_agent_dir) in visited:\n              continue\n\n          # If the next state is valid and unvisited, add it to the queue and mark as visited.\n          new_path = path + [move_action_val]\n          visited.add((next_r, next_c, next_agent_dir))\n          queue.append((next_pos, next_agent_dir, new_path))\n  \n  # If the BFS queue becomes empty and no path to a goal state was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:21:21.105283", "function_name": "collect", "function_body": "  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  MOVE_DELTAS_TO_ACTION = {\n      (0, -1): ACTION_UP,\n      (0, 1): ACTION_DOWN,\n      (-1, 0): ACTION_LEFT,\n      (1, 0): ACTION_RIGHT,\n  }\n\n  # 1. Convert the primitive string (DSL name) to its integer ID.\n  primitive_name_lower = primitive.lower()\n  try:\n      primitive_id = env.world.cookbook.index[primitive_name_lower]\n  except KeyError:\n      # If the primitive name is not recognized, return an empty list.\n      return []\n\n  # 2. Early Exit Conditions:\n  #    a. If the primitive is not grabbable, it cannot be collected this way.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  #    b. Check if the primitive is already in the agent's inventory.\n  current_observations = env.observations()\n  current_inventory = current_observations['features_dict']['inventory']\n  if current_inventory[primitive_id] > 0:\n      return []\n\n  # 3. Retrieve current state information.\n  agent_current_pos = tuple(map(int, current_observations['features_dict']['pos']))\n  grid_layout = current_observations['features_dict']['features_global']\n\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_layout.shape\n  impassable_movement_ids = env.world.non_grabbable_indices\n\n  # Helper function to check if a cell is within bounds and traversable.\n  def is_cell_traversable(x, y):\n      if not (0 <= x < GRID_WIDTH and 0 <= y < GRID_HEIGHT):\n          return False\n      for obstacle_id in impassable_movement_ids:\n          if grid_layout[x, y, obstacle_id] > 0:\n              return False\n      return True\n\n  # 4. Pre-compute all valid agent positions from which 'USE' can collect the primitive.\n  # These are the target positions for the BFS.\n  target_use_positions = set()\n  for x_grid in range(GRID_WIDTH):\n      for y_grid in range(GRID_HEIGHT):\n          # If the primitive exists at (x_grid, y_grid)...\n          if grid_layout[x_grid, y_grid, primitive_id] > 0:\n              # ...then any traversable cell in its 3x3 neighborhood is a valid 'use' location for the agent.\n              for dy_offset in [-1, 0, 1]:\n                  for dx_offset in [-1, 0, 1]:\n                      potential_use_x, potential_use_y = x_grid + dx_offset, y_grid + dy_offset\n                      # Only add traversable cells as potential agent positions.\n                      if is_cell_traversable(potential_use_x, potential_use_y):\n                          target_use_positions.add((potential_use_x, potential_use_y))\n\n  # If no possible 'use' positions are found (e.g., primitive is entirely enclosed by impassable terrain),\n  # then it's unreachable.\n  if not target_use_positions:\n      return []\n\n  # 5. Breadth-First Search (BFS) for pathfinding using parent tracking.\n  bfs_queue = collections.deque([agent_current_pos])\n  visited_positions = {agent_current_pos}\n  # Dictionary to reconstruct the path: maps (child_pos) -> (parent_pos, action_from_parent_to_child)\n  came_from = {agent_current_pos: (None, None)} \n  \n  found_target_pos = None\n\n  while bfs_queue:\n      current_agent_pos = bfs_queue.popleft()\n\n      # If the current agent position is one of the pre-computed target 'use' positions.\n      if current_agent_pos in target_use_positions:\n          found_target_pos = current_agent_pos\n          break # Path found, terminate BFS.\n\n      # Explore valid adjacent cells.\n      for dx, dy in MOVE_DELTAS_TO_ACTION.keys():\n          next_agent_x, next_agent_y = current_agent_pos[0] + dx, current_agent_pos[1] + dy\n          next_agent_pos_tuple = (next_agent_x, next_agent_y)\n          action_to_reach_next_pos = MOVE_DELTAS_TO_ACTION[(dx, dy)]\n\n          if is_cell_traversable(next_agent_x, next_agent_y) and \\\n             next_agent_pos_tuple not in visited_positions:\n              \n              visited_positions.add(next_agent_pos_tuple)\n              # Store how we got to next_agent_pos_tuple: from current_agent_pos via action_to_reach_next_pos\n              came_from[next_agent_pos_tuple] = (current_agent_pos, action_to_reach_next_pos)\n              bfs_queue.append(next_agent_pos_tuple)\n\n  # 6. Convert the found coordinate path into a sequence of agent movements and the 'USE' action.\n  actions_sequence = []\n  if found_target_pos:\n      current_path_node = found_target_pos\n      # Reconstruct path by backtracking from the found target position to the start position\n      while current_path_node != agent_current_pos:\n          parent_node, action_to_get_here = came_from[current_path_node]\n          actions_sequence.append(action_to_get_here)\n          current_path_node = parent_node\n      \n      actions_sequence.reverse() # Path was built in reverse order, so reverse it to get correct sequence\n      actions_sequence.append(ACTION_USE) # Add the final USE action required to collect the primitive\n\n  return actions_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:21:21.133005", "function_name": "collect", "function_body": "    action_specs = env.action_specs()\n    ACTION_UP = action_specs['UP']\n    ACTION_DOWN = action_specs['DOWN']\n    ACTION_LEFT = action_specs['LEFT']\n    ACTION_RIGHT = action_specs['RIGHT']\n    ACTION_USE = action_specs['USE']\n\n    MOVE_DELTAS_TO_ACTION = {\n        (0, -1): ACTION_UP,\n        (0, 1): ACTION_DOWN,\n        (-1, 0): ACTION_LEFT,\n        (1, 0): ACTION_RIGHT,\n    }\n\n    actions_sequence = []\n\n    # Helper to get ID from cookbook index, handling None if name not found\n    get_id = env.world.cookbook.index.get\n\n    # Mapping from primitive resource ID (what we want to collect)\n    # to its primary producing entity ID (what we 'USE' on the grid).\n    # This covers cases where the primitive is obtained from another entity\n    # (e.g., 'wood' from 'tree', 'stone' from 'rock').\n    resource_to_producer_entity_map = {\n        get_id('wood'): get_id('tree'),\n        get_id('stone'): get_id('rock'), # 'rock' is the entity, 'stone' is the resource\n        get_id('iron'): get_id('iron_ore'),\n        get_id('grass'): get_id('grass'), # Grass entity typically yields grass resource\n        get_id('gold'): get_id('gold_ore'),\n        get_id('gem'): get_id('gem_ore'),\n        get_id('water'): get_id('water'), # Water entity yields water resource (with bucket)\n    }\n    # Filter out any mappings where either the resource or producer ID was not found\n    resource_to_producer_entity_map = {k: v for k, v in resource_to_producer_entity_map.items() if k is not None and v is not None}\n\n    # 1. Convert the primitive string (from DSL) to its integer ID.\n    primitive_name_lower = primitive.lower()\n    primitive_id = get_id(primitive_name_lower)\n\n    if primitive_id is None:\n        # If the primitive name is not recognized in the cookbook, return an empty list.\n        return []\n\n    # 2. Early Exit Conditions:\n\n    # Check if the primitive is already in the agent's inventory.\n    current_observations = env.observations()\n    current_inventory = current_observations['features_dict']['inventory']\n    if current_inventory[primitive_id] > 0:\n        return [] # Already collected, no actions needed.\n\n    # Determine if the primitive itself is a grabbable item that can be picked up directly\n    # (e.g., loose 'wood' blocks).\n    is_grabbable_item = primitive_id in env.world.grabbable_indices\n    # Determine if the primitive has a known source entity from which it can be obtained\n    # (e.g., 'wood' from a 'tree').\n    has_producer_entity = primitive_id in resource_to_producer_entity_map\n\n    # If the primitive is neither a grabbable item nor has a known producer entity,\n    # it cannot be collected by this function (e.g., 'workshop', 'boundary').\n    if not is_grabbable_item and not has_producer_entity:\n        return []\n\n    # 3. Retrieve current state information.\n    # Agent position is (x, y) where x is column and y is row.\n    agent_current_pos = tuple(map(int, current_observations['features_dict']['pos']))\n    # Global grid layout, typically (HEIGHT, WIDTH, N_KINDS) in numpy,\n    # but based on problem description (WIDTH, HEIGHT, n_kinds).\n    grid_layout = current_observations['features_dict']['features_global']\n\n    # Grid dimensions (assume grid_layout is (WIDTH, HEIGHT, n_kinds) as per Struct)\n    GRID_WIDTH, GRID_HEIGHT, _ = grid_layout.shape\n    \n    # IDs of entities that block agent movement (e.g., water, stone walls, workshops)\n    impassable_movement_ids = env.world.non_grabbable_indices\n\n    # Helper function to check if a cell is within bounds and traversable.\n    def is_cell_traversable(x, y):\n        if not (0 <= x < GRID_WIDTH and 0 <= y < GRID_HEIGHT):\n            return False\n        # Check if any impassable entity occupies the cell\n        for obstacle_id in impassable_movement_ids:\n            if grid_layout[x, y, obstacle_id] > 0:\n                return False\n        return True\n\n    # 4. Determine which entity types to search for on the grid.\n    # This is a key improvement for collect_v2. We search for all possible sources.\n    target_entity_ids_on_grid = set()\n\n    # Case A: If the primitive itself can be picked up directly from the grid (e.g., loose resources).\n    if is_grabbable_item:\n        target_entity_ids_on_grid.add(primitive_id)\n    \n    # Case B: If the primitive is produced by a specific entity (e.g., 'wood' from 'tree').\n    if has_producer_entity:\n        producer_id = resource_to_producer_entity_map[primitive_id]\n        target_entity_ids_on_grid.add(producer_id)\n\n    # If no valid target entities were identified, the primitive cannot be found on the map.\n    if not target_entity_ids_on_grid:\n        return []\n\n    # 5. Pre-compute all valid agent positions from which the 'USE' action can\n    # successfully interact with any of the identified target entities.\n    target_use_positions = set()\n    for x_grid in range(GRID_WIDTH):\n        for y_grid in range(GRID_HEIGHT):\n            for entity_id_to_find in target_entity_ids_on_grid:\n                # If the target entity exists at (x_grid, y_grid)...\n                if grid_layout[x_grid, y_grid, entity_id_to_find] > 0:\n                    # ...then any traversable cell in its 3x3 neighborhood is a valid 'use' location for the agent.\n                    for dy_offset in [-1, 0, 1]:\n                        for dx_offset in [-1, 0, 1]:\n                            potential_use_x, potential_use_y = x_grid + dx_offset, y_grid + dy_offset\n                            # Only add traversable cells as potential agent positions for interaction.\n                            if is_cell_traversable(potential_use_x, potential_use_y):\n                                target_use_positions.add((potential_use_x, potential_use_y))\n\n    # If no possible 'use' positions are found, the primitive source is unreachable.\n    if not target_use_positions:\n        return []\n\n    # 6. Breadth-First Search (BFS) for the shortest path from the agent's current\n    # position to any of the `target_use_positions`.\n    bfs_queue = collections.deque([(agent_current_pos, [agent_current_pos])]) # (current_pos, path_of_positions_to_here)\n    visited_positions = {agent_current_pos}\n    path_to_optimal_use_location = None\n\n    while bfs_queue:\n        (current_agent_x, current_agent_y), current_path = bfs_queue.popleft()\n\n        # If the current agent position is one of the desired 'use' locations, we found our path.\n        if (current_agent_x, current_agent_y) in target_use_positions:\n            path_to_optimal_use_location = current_path\n            break # Path found, terminate BFS.\n\n        # Explore valid adjacent cells (UP, DOWN, LEFT, RIGHT).\n        for dx, dy in MOVE_DELTAS_TO_ACTION.keys():\n            next_agent_x, next_agent_y = current_agent_x + dx, current_agent_y + dy\n            next_agent_pos_tuple = (next_agent_x, next_agent_y)\n\n            # Check if the new position is within bounds, traversable, and not yet visited.\n            if is_cell_traversable(next_agent_x, next_agent_y) and \\\n               next_agent_pos_tuple not in visited_positions:\n                visited_positions.add(next_agent_pos_tuple)\n                bfs_queue.append((next_agent_pos_tuple, current_path + [next_agent_pos_tuple]))\n\n    # 7. Convert the found coordinate path into a sequence of agent movement actions\n    # and the final 'USE' action.\n    if path_to_optimal_use_location:\n        # Reconstruct movement actions from the sequence of positions.\n        for i in range(len(path_to_optimal_use_location) - 1):\n            from_x, from_y = path_to_optimal_use_location[i]\n            to_x, to_y = path_to_optimal_use_location[i+1]\n            delta_x = to_x - from_x\n            delta_y = to_y - from_y\n            actions_sequence.append(MOVE_DELTAS_TO_ACTION[(delta_x, delta_y)])\n\n        # After moving to the optimal position, perform the 'USE' action to collect the primitive.\n        actions_sequence.append(ACTION_USE)\n\n    return actions_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:22:15.033395", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos # (row, col)\n  \n  width, height, _ = current_grid.shape # width corresponds to rows, height to columns\n\n  # Define \"impassable\" items. These are entities the agent likely cannot move onto or through.\n  impassable_set = env.world.non_grabbable_indices\n  \n  def is_valid_and_traversable(r, c):\n      \"\"\"Checks if a cell (r, c) is within grid boundaries and does not contain impassable items.\"\"\"\n      # Check boundaries\n      if not (0 <= r < width and 0 <= c < height):\n          return False\n      \n      # Get indices of all item kinds present at (r, c)\n      present_kinds_at_cell = np.where(current_grid[r, c] == 1.0)[0]\n      \n      # Check if any of these present kinds are in the impassable set\n      for k_idx in present_kinds_at_cell:\n          if k_idx in impassable_set:\n              return False # This cell contains an impassable item, so it's not traversable\n              \n      return True # Cell is valid and traversable\n\n  # 1. Find all locations on the grid where the target primitive exists\n  target_primitive_locations = []\n  for r_idx in range(width):\n    for c_idx in range(height):\n      if current_grid[r_idx, c_idx, primitive_idx] == 1.0:\n        target_primitive_locations.append((r_idx, c_idx))\n\n  if not target_primitive_locations: # If primitive is not found anywhere\n    return []\n\n  # 2. Determine all potential goal cells for BFS (cells that are valid and traversable, and adjacent to any primitive instance)\n  goal_cells = set()\n  # Directions to check for adjacent cells (relative offsets for (row, col))\n  # (-1,0) = UP, (1,0) = DOWN, (0,-1) = LEFT, (0,1) = RIGHT\n  adj_offsets = [(-1,0), (1,0), (0,-1), (0,1)] \n\n  for pr, pc in target_primitive_locations:\n    for dr_offset, dc_offset in adj_offsets:\n      adj_r, adj_c = pr + dr_offset, pc + dc_offset\n      # An adjacent cell is a potential goal if it's valid and traversable\n      if is_valid_and_traversable(adj_r, adj_c):\n        goal_cells.add((adj_r, adj_c))\n\n  if not goal_cells: # If no reachable adjacent cells to any primitive\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path\n  q = collections.deque([(current_pos, [])]) # Queue stores tuples of (position, path_actions_taken)\n  visited = {current_pos} # Set of visited positions to avoid cycles\n\n  found_path = None # To store the shortest path found\n\n  # Possible moves and their corresponding actions relative to (row, col)\n  moves = [\n      ((-1, 0), UP_ACTION),    # Move UP (decrease row index)\n      ((1, 0), DOWN_ACTION),   # Move DOWN (increase row index)\n      ((0, -1), LEFT_ACTION),  # Move LEFT (decrease column index)\n      ((0, 1), RIGHT_ACTION)   # Move RIGHT (increase column index)\n  ]\n\n  while q:\n    curr_pos, path_actions = q.popleft() # curr_pos is (r, c)\n\n    # If the current position is one of the goal cells, we've found the shortest path\n    if curr_pos in goal_cells:\n      found_path = path_actions\n      break\n\n    # Explore neighbors\n    for (dr, dc), action in moves:\n      next_r, next_c = curr_pos[0] + dr, curr_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      if is_valid_and_traversable(next_r, next_c) and next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action]))\n\n  if found_path is None: # No path found to any adjacent cell\n    return []\n\n  # 4. Append the USE action if the primitive is grabbable, a workshop, or water.\n  # This makes the 'collect' function more versatile for interacting with environmental elements\n  # that require a 'USE' action, not just grabbable items.\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  is_workshop = primitive_idx in env.world.workshop_indices\n  is_water = primitive_idx == env.world.water_index\n\n  if is_grabbable or is_workshop or is_water:\n    found_path.append(USE_ACTION)\n\n  return found_path", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:22:17.322995", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos # Assumed to be (row_index, col_index) or (y, x)\n  \n  # Grid dimensions: (height, width, n_kinds) assuming (row, col) indexing for grid[row, col, kind]\n  height, width, _ = current_grid.shape \n\n  # Define \"impassable\" items. These are entities the agent cannot move onto or through.\n  # Based on CraftWorld's definition, non-grabbable items are typically obstacles.\n  impassable_set = env.world.non_grabbable_indices\n  \n  def is_valid_and_traversable(r, c):\n      \"\"\"Checks if a cell (r, c) is within grid boundaries and does not contain impassable items.\n      Args:\n          r (int): Row index.\n          c (int): Column index.\n      Returns:\n          bool: True if the cell is valid and traversable, False otherwise.\n      \"\"\"\n      # Check boundaries\n      if not (0 <= r < height and 0 <= c < width):\n          return False\n      \n      # Get indices of all item kinds present at (r, c)\n      present_kinds_at_cell = np.where(current_grid[r, c] == 1.0)[0]\n      \n      # Check if any of these present kinds are in the impassable set\n      for k_idx in present_kinds_at_cell:\n          if k_idx in impassable_set:\n              return False # This cell contains an impassable item, so it's not traversable\n              \n      return True # Cell is valid and traversable\n\n  # 1. Find all locations on the grid where the target primitive exists\n  target_primitive_locations = []\n  for r in range(height):\n    for c in range(width):\n      if current_grid[r, c, primitive_idx] == 1.0:\n        target_primitive_locations.append((r, c))\n\n  if not target_primitive_locations: # If primitive is not found anywhere on the grid\n    return []\n\n  # 2. Determine all potential goal cells for BFS. These are cells that are valid and traversable,\n  # and are directly adjacent (4-way) to any instance of the primitive.\n  goal_cells = set()\n  # Relative offsets for adjacent cells: (delta_row, delta_col)\n  adj_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n  for pr, pc in target_primitive_locations:\n    for dr_offset, dc_offset in adj_offsets:\n      adj_r, adj_c = pr + dr_offset, pc + dc_offset\n      # An adjacent cell is a potential goal if it's valid and traversable\n      if is_valid_and_traversable(adj_r, adj_c):\n        goal_cells.add((adj_r, adj_c))\n\n  if not goal_cells: # If no reachable adjacent cells to any primitive instance\n      return []\n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path from current_pos to any goal_cell.\n  q = collections.deque([(current_pos, [])]) # Queue stores tuples of (position, path_actions_taken)\n  visited = {current_pos} # Set of visited positions to avoid cycles and redundant processing\n\n  found_path = None # To store the shortest path found (list of actions)\n\n  # Possible moves and their corresponding actions, assuming pos is (row_index, col_index)\n  # where row_index increases downwards and col_index increases rightwards.\n  moves = [\n      ((-1, 0), UP_ACTION),    # Move Up (decreases row_index)\n      ((1, 0), DOWN_ACTION),   # Move Down (increases row_index)\n      ((0, -1), LEFT_ACTION),  # Move Left (decreases col_index)\n      ((0, 1), RIGHT_ACTION)   # Move Right (increases col_index)\n  ]\n\n  while q:\n    curr_pos, path_actions = q.popleft()\n\n    # If the current position is one of the goal cells, we've found the shortest path\n    if curr_pos in goal_cells:\n      found_path = path_actions\n      break\n\n    # Explore neighbors\n    for (dr, dc), action in moves:\n      next_r, next_c = curr_pos[0] + dr, curr_pos[1] + dc\n      next_pos = (next_r, next_c)\n\n      if is_valid_and_traversable(next_r, next_c) and next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, path_actions + [action]))\n\n  if found_path is None: # No path found to any adjacent cell\n    return []\n\n  # 4. If the primitive is grabbable, append the USE action to the path.\n  # This implies that \"collecting\" means picking up a grabbable item once adjacent to it.\n  if primitive_idx in env.world.grabbable_indices:\n    found_path.append(USE_ACTION)\n\n  return found_path", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:23:14.156335", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # Optimization 1: If the primitive is already in the agent's 3x3 neighborhood,\n  # it can be collected immediately with the 'USE' action. This check relies\n  # on CraftState.next_to, which looks within the 3x3 area.\n  if current_state.next_to(primitive_idx):\n      return [action_map['USE']]\n\n  # Optimization 2: Check if the primitive is actually grabbable.\n  # Non-grabbable items (like water, stone, workshops) cannot be \"collected\" into inventory.\n  # If the goal is to 'collect' something that cannot be put in inventory, it's an invalid request.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return []\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Define indices of entities that block agent movement. These are typically\n  # non-grabbable items that the agent cannot walk through.\n  impassable_for_movement_indices = env.world.non_grabbable_indices\n\n  # Helper function to determine if a given grid cell is traversable by the agent.\n  # A cell is traversable if it's within bounds and does not contain any impassable entities.\n  def is_traversable(r, c):\n      # 1. Check grid boundaries.\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False\n      # 2. Check if the cell contains any impassable entity.\n      # If any layer at (r, c) contains an item from `impassable_for_movement_indices`,\n      # then the cell is blocked for movement.\n      for idx in impassable_for_movement_indices:\n          if grid[r, c, idx] > 0:\n              return False\n      return True\n\n  # Find all actual locations on the grid where the target primitive exists.\n  # np.argwhere returns an array of [row, col] pairs; convert to a set of tuples for efficient lookups.\n  primitive_locations = set(map(tuple, np.argwhere(grid[:, :, primitive_idx] > 0)))\n\n  # If there are no instances of the primitive on the map, it's impossible to collect.\n  if not primitive_locations:\n      return []\n\n  # Define possible cardinal movements (dr, dc) and their corresponding action IDs.\n  # These are the actions the agent can take to move on the grid.\n  moves = {\n      (0, 1): action_map['RIGHT'],  # Move Right\n      (0, -1): action_map['LEFT'],   # Move Left\n      (1, 0): action_map['DOWN'],   # Move Down\n      (-1, 0): action_map['UP'],    # Move Up\n  }\n\n  # Precompute all valid \"target\" cells for the BFS.\n  # A target cell (tr, tc) is a traversable grid cell from which the agent, when standing there,\n  # can successfully collect the primitive using the 'USE' action. This means (tr, tc) must be\n  # within the 3x3 neighborhood of at least one primitive location, consistent with `CraftState.next_to`.\n  bfs_target_cells = set()\n  # Define all 9 relative offsets for a 3x3 neighborhood (including the center (0,0)).\n  neighborhood_offsets = [\n      (-1, -1), (-1, 0), (-1, 1),\n      (0, -1),  (0, 0),  (0, 1),\n      (1, -1),  (1, 0),  (1, 1)\n  ]\n\n  # For each location where the primitive is found:\n  for pr, pc in primitive_locations:\n      # Iterate through its 3x3 neighborhood.\n      for dr_offset, dc_offset in neighborhood_offsets:\n          # Calculate a candidate target cell (a cell where the agent could stand to use).\n          tr, tc = pr + dr_offset, pc + dc_offset\n          # If this candidate cell is within bounds and traversable by the agent,\n          # it's a valid BFS target because from here the agent can 'USE' to collect the primitive.\n          if is_traversable(tr, tc):\n              bfs_target_cells.add((tr, tc))\n  \n  # If, after checking all primitive locations, no traversable cells are found within\n  # reach (3x3 neighborhood) of any primitive, then the primitive is effectively unreachable for collection.\n  if not bfs_target_cells:\n      return []\n\n  # Initialize Breadth-First Search (BFS) queue.\n  # Each element in the queue is `((row, col), [list_of_actions_to_reach_here])`.\n  queue = collections.deque([((agent_r, agent_c), [])])\n  # Keep track of visited positions to avoid cycles and redundant exploration,\n  # ensuring the shortest path is found.\n  visited = {(agent_r, agent_c)}\n\n  while queue:\n      (r, c), path = queue.popleft() # Dequeue the current position and its path\n\n      # If the current position is one of our precomputed BFS target cells,\n      # we have found the shortest path to a collection point.\n      if (r, c) in bfs_target_cells:\n          # Append the 'USE' action to the path and return the complete sequence of actions.\n          return path + [action_map['USE']]\n\n      # Explore all four cardinal neighbors from the current position.\n      for (dr, dc), action in moves.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is traversable and has not been visited yet.\n          if is_traversable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos)              # Mark the position as visited\n              queue.append((next_pos, path + [action])) # Enqueue with the updated path\n\n  # If the BFS queue becomes empty and no path to a target cell was found,\n  # it means the primitive is unreachable from the agent's current position,\n  # or cannot be collected (e.g., surrounded by impassable terrain).\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:23:16.056034", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:24:32.901761", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # Helper function to get turn actions\n  def _get_turn_actions(current_dir, target_dir):\n      actions = []\n      if current_dir == target_dir:\n          return actions\n      \n      # Directions are typically mapped as: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n      # Calculate the shortest turn direction (clockwise or counter-clockwise)\n      # The modulo 4 ensures we stay within 0-3 range for directions.\n      diff = (target_dir - current_dir + 4) % 4 \n      if diff == 1: # 90 degrees clockwise turn\n          actions.append(action_map['RIGHT'])\n      elif diff == 2: # 180 degrees turn (two 90-degree turns in either direction)\n          actions.append(action_map['RIGHT'])\n          actions.append(action_map['RIGHT'])\n      elif diff == 3: # 90 degrees counter-clockwise turn\n          actions.append(action_map['LEFT'])\n      return actions\n\n  # Mapping of (dr, dc) movement vector to the agent's new facing direction.\n  # This helps determine the agent's orientation after a move.\n  # agent_direction: 0=UP (-row), 1=RIGHT (+col), 2=DOWN (+row), 3=LEFT (-col)\n  DRDC_TO_DIR = {\n      (-1, 0): 0, # Moving UP (row decreases) means agent faces UP\n      (0, 1): 1,  # Moving RIGHT (col increases) means agent faces RIGHT\n      (1, 0): 2,  # Moving DOWN (row increases) means agent faces DOWN\n      (0, -1): 3, # Moving LEFT (col decreases) means agent faces LEFT\n  }\n\n  # Mapping of (relative_r, relative_c) of a target item from agent's position\n  # to the direction the agent needs to face to 'USE' that item.\n  REL_TO_DIR = {\n      (-1, 0): 0, # Primitive is one cell UP, agent must face UP to USE it\n      (0, 1): 1,  # Primitive is one cell RIGHT, agent must face RIGHT to USE it\n      (1, 0): 2,  # Primitive is one cell DOWN, agent must face DOWN to USE it\n      (0, -1): 3  # Primitive is one cell LEFT, agent must face LEFT to USE it\n  }\n\n  agent_r, agent_c = current_state.pos\n  initial_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Impassable terrain indices: entities that block agent movement.\n  impassable_indices = env.world.non_grabbable_indices\n\n  # Find all grid locations where the primitive exists (quantity > 0)\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If there are no instances of the primitive in the world, nothing to collect\n  if len(primitive_locations) == 0:\n      return []\n\n  # --- Pre-compute all (agent_r, agent_c, agent_dir) states from which 'USE' is productive ---\n  # A 'goal state' is a (position, direction) tuple where, if the agent is at that position\n  # and facing that direction, a 'USE' action will successfully collect the primitive.\n  goal_states = set() \n  for pr, pc in primitive_locations:\n      # For each primitive location, consider all 4 adjacent cells from which it could be 'USED'.\n      for (rel_dr, rel_dc), target_face_dir in REL_TO_DIR.items():\n          # Calculate the potential agent position (r, c) relative to the primitive (pr, pc)\n          # agent_r = pr - rel_dr, agent_c = pc - rel_dc ensures (pr - agent_r, pc - agent_c) == (rel_dr, rel_dc)\n          agent_r_candidate = pr - rel_dr\n          agent_c_candidate = pc - rel_dc\n\n          # Check if this potential agent position is within grid boundaries\n          if not (0 <= agent_r_candidate < grid_height and 0 <= agent_c_candidate < grid_width):\n              continue\n          \n          # Check if this potential agent position contains any impassable entities.\n          # An agent cannot stand on an impassable object to use a primitive.\n          is_impassable_for_agent = False\n          for idx in impassable_indices:\n              if grid[agent_r_candidate, agent_c_candidate, idx] > 0:\n                  is_impassable_for_agent = True\n                  break\n          if is_impassable_for_agent:\n              continue\n\n          # If the position is valid and accessible, add this (position, required_direction) \n          # as a goal state for our pathfinding.\n          goal_states.add((agent_r_candidate, agent_c_candidate, target_face_dir))\n\n  # --- Initial check: Is the primitive already accessible from the current position? ---\n  # Case 1: Agent is already at a goal position AND facing the correct direction\n  if (agent_r, agent_c, initial_dir) in goal_states:\n      return [action_map['USE']]\n  \n  # Case 2: Agent is at a goal position, but facing the wrong direction. Needs to turn.\n  # Iterate through all possible facing directions to see if any of them, combined with the\n  # current position, constitute a goal state.\n  for target_dir_for_use in range(4): # Directions 0, 1, 2, 3\n      if (agent_r, agent_c, target_dir_for_use) in goal_states:\n          # If we found a direction such that our current position + that direction is a goal state,\n          # calculate the turns needed to face that direction.\n          turn_actions = _get_turn_actions(initial_dir, target_dir_for_use)\n          # Since the first 'if' handled the case where initial_dir == target_dir_for_use,\n          # if we reach here, turn_actions will not be empty.\n          return turn_actions + [action_map['USE']]\n\n  # --- BFS (Breadth-First Search) for pathfinding to a goal state ---\n  # The queue for BFS stores tuples: (current_position (r, c), current_direction, path_taken_so_far)\n  queue = collections.deque([((agent_r, agent_c), initial_dir, [])])\n  # The visited set stores (position (r, c), direction) to prevent revisiting the same state\n  # and finding non-optimal paths or getting stuck in cycles.\n  visited = {(agent_r, agent_c, initial_dir)}\n\n  # Possible movement deltas and their corresponding actions\n  moves_deltas = {\n      (-1, 0): action_map['UP'],\n      (0, 1): action_map['RIGHT'],\n      (1, 0): action_map['DOWN'],\n      (0, -1): action_map['LEFT'],\n  }\n\n  while queue:\n      (r, c), current_path_dir, path = queue.popleft()\n\n      # Explore all possible direct moves from the current position\n      for (dr_move, dc_move), move_action in moves_deltas.items():\n          next_r, next_c = r + dr_move, c + dc_move\n          next_pos = (next_r, next_c)\n          \n          # Determine the agent's new facing direction after executing this move action.\n          next_agent_dir = DRDC_TO_DIR[(dr_move, dc_move)]\n\n          # Check if the next cell is within the grid boundaries\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next cell contains any impassable entities that block agent movement.\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[next_r, next_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Form the unique state key (position and direction) for visited set and goal check.\n          new_state_key = (next_r, next_c, next_agent_dir)\n\n          # Check if this specific state has already been visited.\n          if new_state_key in visited:\n              continue\n\n          # Construct the path to this new state by appending the move action.\n          new_path_to_next_state = path + [move_action]\n          \n          # Check if this new state (position AND direction) is one of our pre-computed goal states.\n          # This is the \"improvement\" over v0, using a fast set lookup instead of iterating all primitives.\n          if new_state_key in goal_states:\n              # If it's a goal state, we found the shortest path (in terms of actions)\n              # to a position and orientation from which the primitive can be 'USED'.\n              return new_path_to_next_state + [action_map['USE']]\n          \n          # If not a goal state, add this new state to the queue for further exploration\n          # and mark it as visited.\n          visited.add(new_state_key)\n          queue.append((next_pos, next_agent_dir, new_path_to_next_state))\n  \n  # If the BFS completes and no path to a usable primitive is found, return an empty list.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:24:34.789532", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:25:49.132088", "function_name": "collect", "function_body": "  # Define action constants for clarity and maintainability.\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # This list will store the sequence of actions to be returned.\n  actions_sequence = []\n\n  # --- Step 1: Validate and Resolve Primitive ID ---\n  # Convert the primitive name (e.g., \"WOOD\") to its integer ID\n  # as understood by the CraftWorld's internal index.\n  primitive_name_lower = primitive.lower()\n  try:\n    primitive_id = env.world.cookbook.index[primitive_name_lower]\n  except KeyError:\n    # If the primitive name is not recognized, it cannot be collected.\n    # Return an empty list of actions.\n    return []\n\n  # --- Step 2: Check if the Primitive is Grabbable ---\n  # Only items listed in `env.world.grabbable_indices` can be picked up\n  # using the 'USE' action. Workshops, boundaries, etc., are typically not grabbable.\n  if primitive_id not in env.world.grabbable_indices:\n      # If the item is not grabbable, no collection action is possible.\n      return []\n\n  # --- Step 3: Get Current Environment State ---\n  # Retrieve the agent's current observations to understand the world state.\n  current_obs = env.observations()\n\n  # Agent's position: `pos` is normalized, so convert to integer grid coordinates.\n  agent_current_pos = tuple(map(int, current_obs['features_dict']['pos']))\n  # The full grid representation, showing what is at each (x, y) cell for each kind.\n  grid_state = current_obs['features_dict']['features_global']\n  # Agent's current inventory, an array where index `k` holds the count of item `k`.\n  agent_inventory = current_obs['features_dict']['inventory']\n\n  # --- Step 4: Check if Primitive is Already in Inventory ---\n  # If the agent already possesses the primitive, no action is needed to collect it.\n  if agent_inventory[primitive_id] > 0:\n      return []\n\n  # Determine grid dimensions (WIDTH, HEIGHT) from the shape of the grid_state.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_state.shape\n\n  # Define cardinal movement directions and their corresponding action IDs.\n  # This mapping simplifies converting (dx, dy) offsets to actions.\n  cardinal_movements = {\n      (0, -1): ACTION_UP,    # Moving up means decreasing the Y coordinate.\n      (0, 1): ACTION_DOWN,   # Moving down means increasing the Y coordinate.\n      (-1, 0): ACTION_LEFT,  # Moving left means decreasing the X coordinate.\n      (1, 0): ACTION_RIGHT,  # Moving right means increasing the X coordinate.\n  }\n\n  # --- Step 5: Identify Impassable Terrain IDs ---\n  # These are entity kinds that the agent cannot traverse or move onto.\n  # Based on common CraftWorld mechanics, 'boundary' and 'water' are typically impassable.\n  impassable_terrain_ids = set()\n  # Add the boundary ID.\n  impassable_terrain_ids.add(env.world.cookbook.index[\"boundary\"])\n  # Add the water ID, if it exists in the cookbook's index.\n  if \"water\" in env.world.cookbook.index.contents:\n    impassable_terrain_ids.add(env.world.water_index)\n\n\n  # --- Step 6: Perform Breadth-First Search (BFS) for Pathfinding ---\n  # BFS is used to find the shortest sequence of moves to reach a location\n  # from where the target primitive can be collected.\n  # Queue stores tuples of (current_position, path_taken_to_reach_current_position).\n  bfs_queue = collections.deque()\n  bfs_queue.append((agent_current_pos, [agent_current_pos]))\n\n  # Set to keep track of visited grid positions to prevent loops and redundant exploration.\n  visited_positions = {agent_current_pos}\n\n  # Variable to store the path (sequence of agent positions) if found.\n  shortest_path_to_target = None\n\n  while bfs_queue:\n      (current_x, current_y), path_so_far = bfs_queue.popleft()\n\n      # Check if the primitive is in the 3x3 neighborhood (including the agent's current cell)\n      # of the `(current_x, current_y)` position.\n      # The `ACTION_USE` typically applies to adjacent (3x3) cells in CraftWorld.\n      is_primitive_nearby = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n\n              # Ensure the neighbor cell is within the grid boundaries.\n              if not (0 <= neighbor_x < GRID_WIDTH and 0 <= neighbor_y < GRID_HEIGHT):\n                  continue\n\n              # Check if the target primitive is present at this neighbor cell.\n              if grid_state[neighbor_x, neighbor_y, primitive_id] > 0:\n                  is_primitive_nearby = True\n                  break # Primitive found in 3x3 neighborhood, no need to check further offsets.\n          if is_primitive_nearby:\n              break # Found in this row/column, stop checking this neighborhood.\n\n      if is_primitive_nearby:\n          # A position from which the primitive can be collected has been found.\n          shortest_path_to_target = path_so_far\n          break # Exit BFS, as we found the shortest path to a collection point.\n\n      # If the primitive is not nearby, explore adjacent traversable cells to continue searching.\n      # Iterate over possible cardinal movements from the current cell.\n      for (dx, dy), _ in cardinal_movements.items():\n          next_x, next_y = current_x + dx, current_y + dy\n\n          # Check if the next potential position is within the grid boundaries.\n          if not (0 <= next_x < GRID_WIDTH and 0 <= next_y < GRID_HEIGHT):\n              continue\n\n          # Check if the next potential position is occupied by an impassable obstacle.\n          is_obstacle_at_next_cell = False\n          for obstacle_id in impassable_terrain_ids:\n              if grid_state[next_x, next_y, obstacle_id] > 0:\n                  is_obstacle_at_next_cell = True\n                  break\n          if is_obstacle_at_next_cell:\n               continue # This cell is blocked; the agent cannot move here.\n\n          # If the cell is traversable and has not been visited in this BFS, add it to the queue.\n          if (next_x, next_y) not in visited_positions:\n              visited_positions.add((next_x, next_y))\n              bfs_queue.append(((next_x, next_y), path_so_far + [(next_x, next_y)]))\n\n  # --- Step 7: Construct Action Sequence from Found Path ---\n  if shortest_path_to_target:\n      # Convert the sequence of (x,y) coordinates in the path into movement actions.\n      # The first coordinate in `shortest_path_to_target` is the starting point,\n      # so we iterate from the second point to determine moves.\n      for i in range(len(shortest_path_to_target) - 1):\n          curr_path_x, curr_path_y = shortest_path_to_target[i]\n          next_path_x, next_path_y = shortest_path_to_target[i+1]\n\n          # Calculate the required displacement (change in x, change in y).\n          delta_x = next_path_x - curr_path_x\n          delta_y = next_path_y - curr_path_y\n\n          # Append the corresponding movement action using the defined mapping.\n          actions_sequence.append(cardinal_movements[(delta_x, delta_y)])\n\n      # After reaching the final position in the path, perform the 'USE' action.\n      # This action is expected to collect the primitive, as it's now in the 3x3 neighborhood.\n      actions_sequence.append(ACTION_USE)\n\n  # Return the generated list of actions. If no path was found, this will be empty.\n  return actions_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:25:51.048628", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  actions = []\n\n  # 1. Resolve the integer ID for the primitive\n  primitive_name = primitive.lower()\n  try:\n    primitive_id = env.world.cookbook.index[primitive_name]\n  except KeyError:\n    # If the primitive name is not found, it's an invalid primitive.\n    return []\n\n  # 2. Check if the primitive is collectable (i.e., grabbable).\n  # Non-grabbable items cannot be picked up using the 'USE' action.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # 3. Get current state information from the environment observations.\n  obs = env.observations()\n  # Agent's current position (x, y) - normalized floats need to be converted to integers.\n  current_pos = tuple(map(int, obs['features_dict']['pos']))\n  grid = obs['features_dict']['features_global']  # The full grid occupancy state\n  inventory = obs['features_dict']['inventory']    # Agent's current inventory counts\n\n  # 4. Check if the primitive is already in the agent's inventory.\n  # If so, no collection actions are needed.\n  if inventory[primitive_id] > 0:\n      return []\n\n  # Get grid dimensions (WIDTH, HEIGHT) from the grid's shape.\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Define mappings from movement offsets (dx, dy) to corresponding action IDs.\n  move_action_map = {\n      (0, -1): ACTION_UP,    # Move up (decrease y)\n      (0, 1): ACTION_DOWN,   # Move down (increase y)\n      (-1, 0): ACTION_LEFT,  # Move left (decrease x)\n      (1, 0): ACTION_RIGHT,  # Move right (increase x)\n  }\n\n  # Identify entity IDs that represent impassable obstacles for the agent.\n  # In `v1`, this was hardcoded for \"boundary\" and \"water\".\n  # For `v2`, we use the more general `env.world.non_grabbable_indices`,\n  # assuming all non-grabbable items can block movement.\n  impassable_ids = set(env.world.non_grabbable_indices)\n\n  # Use Breadth-First Search (BFS) to find the shortest path to a location\n  # from which the primitive can be collected (i.e., it is in the 3x3 neighborhood).\n  queue = collections.deque()\n  # The queue stores tuples: (current_agent_coords, path_list_of_agent_coords).\n  queue.append((current_pos, [current_pos]))\n\n  # 'visited' set keeps track of (x,y) positions that have been added to the queue,\n  # preventing cycles and redundant exploration.\n  visited = {current_pos}\n\n  target_agent_path = None # This will store the optimal path of agent positions.\n\n  while queue:\n      (agent_x, agent_y), path = queue.popleft()\n\n      # Check if the desired primitive is present in the 3x3 neighborhood\n      # around the current agent's position (agent_x, agent_y).\n      # If so, this is a valid location to perform ACTION_USE.\n      found_primitive_nearby = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              # Calculate the coordinates of a cell in the 3x3 neighborhood.\n              neighbor_x, neighbor_y = agent_x + dx_offset, agent_y + dy_offset\n\n              # Ensure the neighborhood cell is within grid boundaries.\n              if not (0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT):\n                  continue\n\n              # Check if the primitive_id is present at this specific neighborhood cell.\n              if grid[neighbor_x, neighbor_y, primitive_id] > 0:\n                  found_primitive_nearby = True\n                  break # Primitive found in 3x3, no need to check other offsets.\n          if found_primitive_nearby:\n              break # Primitive found, no need to check other rows.\n\n      if found_primitive_nearby:\n          # A path to a collection-ready location has been found.\n          target_agent_path = path\n          break # Exit the BFS loop, as we found the shortest path.\n\n      # If the primitive is not nearby, explore adjacent, traversable cells.\n      # Only consider cardinal directions for agent movement.\n      for (dx, dy), _ in move_action_map.items():\n          next_x, next_y = agent_x + dx, agent_y + dy\n\n          # Check if the potential next position is within the grid boundaries.\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the potential next position is an impassable obstacle.\n          is_impassable_cell = False\n          for obstacle_id in impassable_ids:\n              if grid[next_x, next_y, obstacle_id] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n               continue # The agent cannot move into this cell.\n\n          # If the cell is traversable and has not been visited yet, add it to the queue.\n          if (next_x, next_y) not in visited:\n              visited.add((next_x, next_y))\n              queue.append(((next_x, next_y), path + [(next_x, next_y)]))\n\n  # If a path to a collection location was successfully found by BFS:\n  if target_agent_path:\n      # Convert the sequence of (x,y) coordinates in the path into a list of movement actions.\n      # The first coordinate in `target_agent_path` is the starting point.\n      for i in range(len(target_agent_path) - 1):\n          curr_x, curr_y = target_agent_path[i]\n          next_x, next_y = target_agent_path[i+1]\n\n          # Calculate the directional change required for this step.\n          dx = next_x - curr_x\n          dy = next_y - curr_y\n\n          # Append the corresponding movement action to the list.\n          actions.append(move_action_map[(dx, dy)])\n\n      # After moving to the final position in the path, perform the 'USE' action\n      # to collect the primitive which is now in the 3x3 neighborhood.\n      actions.append(ACTION_USE)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:26:36.508806", "function_name": "collect", "function_body": "  import collections # Required for deque for BFS\n\n  # 1. Retrieve essential action IDs from the environment's action specifications.\n  # This makes the code more robust to changes in action mapping.\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  actions_sequence = [] # This list will store the final sequence of actions to be returned.\n\n  # 2. Get the integer ID for the target primitive from the cookbook's index.\n  # Convert the primitive name to lowercase to ensure consistent lookup.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n  # Also get the ID for impassable \"boundary\" cells, which are obstacles for movement.\n  boundary_id = env.world.cookbook.index[\"boundary\"]\n\n  # 3. Early Exit Condition: If the primitive is a 'grabbable' item and already in inventory,\n  # no collection actions are needed.\n  if primitive_id in env.world.grabbable_indices:\n      current_observations = env.observations()\n      inventory = current_observations['features_dict']['inventory']\n      if inventory[primitive_id] > 0: # Check if the agent possesses at least one unit of the item.\n          return [] # Already collected, return an empty action list.\n\n  # 4. Gather current state information necessary for pathfinding (BFS).\n  current_observations = env.observations()\n  # Agent's current (x, y) position. Convert numpy array to tuple for hashability (for 'visited' set).\n  agent_current_position = tuple(current_observations['features_dict']['pos']) \n  # The full grid layout, essential for identifying primitive locations and obstacles.\n  full_grid_state = current_observations['features_dict']['features_global'] \n\n  # Determine grid dimensions from the full grid array's shape.\n  GRID_WIDTH, GRID_HEIGHT, _ = full_grid_state.shape\n\n  # Map relative movement deltas (dx, dy) to their corresponding action IDs.\n  # This mapping is crucial for converting a path of coordinates into a sequence of actions.\n  move_deltas_to_action_map = {\n      (0, -1): ACTION_UP,    # Moving up means decreasing y-coordinate.\n      (0, 1): ACTION_DOWN,   # Moving down means increasing y-coordinate.\n      (-1, 0): ACTION_LEFT,  # Moving left means decreasing x-coordinate.\n      (1, 0): ACTION_RIGHT,  # Moving right means increasing x-coordinate.\n  }\n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  # The queue stores tuples: (agent_current_coordinates, path_taken_to_reach_here).\n  # 'path_taken_to_reach_here' is a list of (x,y) coordinates.\n  bfs_queue = collections.deque([(agent_current_position, [agent_current_position])])\n  \n  # A set to keep track of all agent positions already visited during the BFS.\n  # This prevents cycles and ensures that the shortest path is found.\n  visited_positions = {agent_current_position}\n\n  # This variable will store the shortest path (as a list of coordinates)\n  # to a position from which the primitive can be successfully 'used'.\n  path_to_primitive_use_location = None \n\n  # 6. BFS Loop: Search for the shortest path to a cell adjacent to the primitive.\n  while bfs_queue:\n      (current_x, current_y), current_path = bfs_queue.popleft() # Dequeue the current state for exploration.\n\n      # Check the 3x3 neighborhood (including the current cell) around the agent's current position.\n      # The 'USE' action in CraftWorld applies to any item in this neighborhood.\n      is_primitive_in_neighborhood = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n\n              # Ensure the neighbor cell being checked is within the grid boundaries.\n              if not (0 <= neighbor_x < GRID_WIDTH and 0 <= neighbor_y < GRID_HEIGHT):\n                  continue\n\n              # Check if the target primitive exists at this specific neighbor cell.\n              # `full_grid_state[x, y, kind_id]` indicates presence (count > 0).\n              if full_grid_state[neighbor_x, neighbor_y, primitive_id] > 0:\n                  is_primitive_in_neighborhood = True\n                  break # Primitive found nearby, no need to check further cells in this neighborhood.\n          if is_primitive_in_neighborhood:\n              break # Exit outer offset loop too, we found a path to a 'USE' location.\n\n      # If the primitive is found in the 3x3 neighborhood of `(current_x, current_y)`,\n      # then `current_path` is the shortest path to a valid 'USE' location.\n      if is_primitive_in_neighborhood:\n          path_to_primitive_use_location = current_path\n          break # Path found, terminate the BFS as the shortest path is guaranteed.\n\n      # If the primitive is not yet found nearby, continue exploring valid adjacent cells for movement.\n      # Iterate over all four cardinal directions (UP, DOWN, LEFT, RIGHT).\n      for dx, dy in move_deltas_to_action_map.keys():\n          next_agent_x, next_agent_y = current_x + dx, current_y + dy\n\n          # Verify that the potential next agent position is within the grid boundaries.\n          if not (0 <= next_agent_x < GRID_WIDTH and 0 <= next_agent_y < GRID_HEIGHT):\n              continue\n\n          # Check if the next cell is traversable. Cells containing the 'boundary_id' are impassable.\n          if full_grid_state[next_agent_x, next_agent_y, boundary_id] > 0:\n               continue # This cell is an obstacle; skip it.\n\n          # If the next cell is traversable and has not been visited by the agent yet, add it to the queue.\n          if (next_agent_x, next_agent_y) not in visited_positions:\n              visited_positions.add((next_agent_x, next_agent_y))\n              # Enqueue the new position along with the updated path taken to reach it.\n              bfs_queue.append(((next_agent_x, next_agent_y), current_path + [(next_agent_x, next_agent_y)]))\n\n  # 7. Convert the found coordinate path into a sequence of agent actions.\n  if path_to_primitive_use_location:\n      # Iterate through the path of agent positions, reconstructing movement actions.\n      # We iterate up to the second-to-last element, as each action connects two consecutive points.\n      for i in range(len(path_to_primitive_use_location) - 1):\n          # Get the current and next agent positions from the path.\n          from_x, from_y = path_to_primitive_use_location[i]\n          to_x, to_y = path_to_primitive_use_location[i+1]\n\n          # Calculate the relative movement (change in x, change in y).\n          delta_x = to_x - from_x\n          delta_y = to_y - from_y\n\n          # Append the corresponding movement action ID to the actions sequence.\n          actions_sequence.append(move_deltas_to_action_map[(delta_x, delta_y)])\n\n      # After all movements are completed, the agent is in the optimal position to 'USE' the primitive.\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:26:36.534985", "function_name": "collect", "function_body": "    import collections # Required for deque for BFS\n\n    # 1. Initialize action IDs from environment's action_specs for robustness.\n    action_specs = env.action_specs()\n    ACTION_DOWN = action_specs['DOWN']\n    ACTION_UP = action_specs['UP']\n    ACTION_LEFT = action_specs['LEFT']\n    ACTION_RIGHT = action_specs['RIGHT']\n    ACTION_USE = action_specs['USE']\n\n    actions_sequence = [] # List to store the sequence of actions to be returned\n\n    # 2. Get the integer IDs for the primitive and boundary (impassable cells).\n    # Ensure the primitive string is lowercase for consistent lookup.\n    primitive_id = env.world.cookbook.index[primitive.lower()]\n    boundary_id = env.world.cookbook.index[\"boundary\"]\n\n    # Access current state directly from CraftLab's internal _current_state object.\n    # This avoids an intermediate call to observations() and feature dict parsing.\n    current_state = env._current_state\n    agent_current_position = current_state.pos # Agent's current (x, y) position (tuple)\n    full_grid_state = current_state.grid # Full grid layout (numpy.ndarray)\n\n    # 3. Early exit: If the primitive is a grabbable item and already in inventory, no actions are needed.\n    if primitive_id in env.world.grabbable_indices:\n        inventory = current_state.inventory # Access inventory directly from CraftState\n        if inventory[primitive_id] > 0: # Check if the agent already possesses the item\n            return [] # Already collected, return an empty list of actions\n\n    # Determine grid dimensions from the grid array's shape.\n    GRID_WIDTH, GRID_HEIGHT, _ = full_grid_state.shape\n\n    # Map movement differentials (dx, dy) to corresponding action IDs.\n    # This facilitates converting a path of coordinates into a sequence of actions.\n    move_deltas_to_action_map = {\n        (0, -1): ACTION_UP,    # Moving up (decrease y)\n        (0, 1): ACTION_DOWN,   # Moving down (increase y)\n        (-1, 0): ACTION_LEFT,  # Moving left (decrease x)\n        (1, 0): ACTION_RIGHT,  # Moving right (increase x)\n    }\n\n    # 4. Initialize BFS components.\n    # The queue stores tuples of (agent_position_tuple, path_to_this_position_list).\n    # `path_to_this_position` is a list of (x,y) coordinates the agent traverses.\n    bfs_queue = collections.deque([(agent_current_position, [agent_current_position])])\n    \n    # A set to keep track of visited agent positions to prevent cycles and redundant exploration.\n    visited_positions = {agent_current_position}\n\n    # This variable will store the shortest path (list of coordinates) to a location\n    # from which the primitive can be 'used'.\n    path_to_primitive_use_location = None \n\n    # 5. BFS Loop: Search for the shortest path to a cell from which the primitive can be 'used'.\n    while bfs_queue:\n        (current_x, current_y), current_path = bfs_queue.popleft() # Dequeue the current state\n\n        # Check the 3x3 neighborhood around the current agent position (current_x, current_y).\n        # The 'USE' action operates on this neighborhood.\n        is_primitive_in_neighborhood = False\n        for dy_offset in [-1, 0, 1]:\n            for dx_offset in [-1, 0, 1]:\n                # Calculate the coordinates of the cell in the neighborhood being examined.\n                neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n\n                # Ensure the neighbor cell is within the grid boundaries.\n                if not (0 <= neighbor_x < GRID_WIDTH and 0 <= neighbor_y < GRID_HEIGHT):\n                    continue\n\n                # Check if the target primitive is present at the current neighbor cell.\n                # `full_grid_state[x, y, kind_id]` indicates presence/count.\n                if full_grid_state[neighbor_x, neighbor_y, primitive_id] > 0:\n                    is_primitive_in_neighborhood = True\n                    break # Primitive found nearby, no need to check other cells in this neighborhood\n            if is_primitive_in_neighborhood:\n                break # Found it, exit outer offset loop to process this path\n\n        # If the primitive is found in the 3x3 neighborhood of the current agent position,\n        # then `current_path` leads to a valid 'USE' location. BFS guarantees this is the shortest path.\n        if is_primitive_in_neighborhood:\n            path_to_primitive_use_location = current_path\n            break # Path found, exit the main BFS loop\n\n        # If the primitive is not yet found nearby, explore valid adjacent cells for agent movement.\n        # Consider all four cardinal directions (UP, DOWN, LEFT, RIGHT) for agent movement.\n        for dx, dy in move_deltas_to_action_map.keys():\n            next_agent_x, next_agent_y = current_x + dx, current_y + dy\n            next_pos_tuple = (next_agent_x, next_agent_y) # Convert to tuple for hashability\n\n            # Check if the potential next agent position is within grid boundaries.\n            if not (0 <= next_agent_x < GRID_WIDTH and 0 <= next_agent_y < GRID_HEIGHT):\n                continue\n\n            # Check for impassable obstacles. Cells containing the 'boundary_id' are considered blocked for movement.\n            if full_grid_state[next_agent_x, next_agent_y, boundary_id] > 0:\n                 continue # This cell is blocked for movement, so skip it.\n\n            # If the next cell is traversable and has not been visited by the agent yet, add it to the queue.\n            if next_pos_tuple not in visited_positions:\n                visited_positions.add(next_pos_tuple)\n                # Enqueue the new position along with the path taken to reach it.\n                bfs_queue.append((next_pos_tuple, current_path + [next_pos_tuple]))\n\n    # 6. Convert the found coordinate path into a list of agent actions.\n    if path_to_primitive_use_location:\n        # Iterate through the path of agent positions, reconstructing movement actions.\n        # We iterate up to the second-to-last element, as each action connects two consecutive points.\n        for i in range(len(path_to_primitive_use_location) - 1):\n            # Get the current and next agent positions from the path.\n            from_x, from_y = path_to_primitive_use_location[i]\n            to_x, to_y = path_to_primitive_use_location[i+1]\n\n            # Calculate the relative movement (change in x, change in y).\n            delta_x = to_x - from_x\n            delta_y = to_y - from_y\n\n            # Append the corresponding action ID to the actions sequence.\n            actions_sequence.append(move_deltas_to_action_map[(delta_x, delta_y)])\n\n        # After all movements are completed, the agent is in the optimal position to 'USE' the primitive.\n        actions_sequence.append(ACTION_USE)\n\n    return actions_sequence", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:27:40.059337", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos\n  \n  width, height, _ = current_grid.shape\n\n  # Define movements and corresponding actions for BFS\n  # (dr, dc): action -> (delta_row, delta_col): action_ID\n  movements = {\n      (-1, 0): UP_ACTION,    # Move up (decrease row)\n      (1, 0): DOWN_ACTION,   # Move down (increase row)\n      (0, -1): LEFT_ACTION,  # Move left (decrease col)\n      (0, 1): RIGHT_ACTION   # Move right (increase col)\n  }\n\n  # Function to check if a cell is traversable (not an impassable obstacle)\n  def is_walkable(r, c):\n    # Check bounds\n    if not (0 <= r < width and 0 <= c < height):\n      return False \n    \n    # A cell is walkable if it does not contain any non-grabbable item.\n    # Non-grabbable items (e.g., water, stone, workshops) act as impassable obstacles for movement.\n    for non_grabbable_kind_idx in env.world.non_grabbable_indices:\n        if current_grid[r, c, non_grabbable_kind_idx] == 1.0:\n            return False # Contains an impassable obstacle\n    return True # Cell is empty or contains only grabbable items\n\n  # BFS initialization\n  # Queue stores tuples: (row, col, path_actions_list)\n  queue = collections.deque([(current_pos[0], current_pos[1], [])]) \n  # Visited set stores (row, col) to avoid cycles and redundant processing\n  visited = set([(current_pos[0], current_pos[1])])\n\n  while queue:\n    r, c, path = queue.popleft()\n\n    # Check if the current cell (r, c) is adjacent to the target primitive.\n    # We are looking for a walkable cell that is 4-directionally adjacent to an instance of `primitive_idx`.\n    found_adjacent_primitive = False\n    for dr, dc in movements.keys(): # Iterate through 4 possible directions\n        nr_adj_check, nc_adj_check = r + dr, c + dc\n        # Check if the neighbor cell is within bounds and contains the primitive\n        if 0 <= nr_adj_check < width and 0 <= nc_adj_check < height:\n            if current_grid[nr_adj_check, nc_adj_check, primitive_idx] == 1.0:\n                found_adjacent_primitive = True\n                break # Found a primitive instance adjacent to (r,c)\n    \n    if found_adjacent_primitive:\n      # If we found a cell adjacent to the primitive, this `path` is the shortest sequence of moves to get there.\n      final_actions = list(path) # Create a copy of the path\n      \n      # If the primitive is something that can be picked up, append the USE action\n      if primitive_idx in env.world.grabbable_indices:\n        final_actions.append(USE_ACTION)\n      return final_actions\n\n    # Explore neighbors from the current cell (r, c)\n    for (dr, dc), action in movements.items():\n      nr, nc = r + dr, c + dc # Calculate new row and column\n      \n      # Check if the new cell is walkable and has not been visited yet\n      if (nr, nc) not in visited and is_walkable(nr, nc):\n        visited.add((nr, nc)) # Mark as visited\n        new_path = path + [action] # Extend the path\n        queue.append((nr, nc, new_path)) # Add to queue for further exploration\n  \n  # If the queue becomes empty and no path to an adjacent primitive was found\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:27:41.990607", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos # (x, y)\n  \n  width, height, _ = current_grid.shape\n\n  # Identify movement obstacles. Assuming water is the primary movement-blocking obstacle.\n  # Other non-grabbable items like workshops are generally traversable.\n  obstacle_indices = {env.world.water_index}\n\n  def is_traversable(x, y):\n    \"\"\"Checks if a cell (x,y) is within grid bounds and does not contain any movement-blocking obstacles.\"\"\"\n    if not (0 <= x < width and 0 <= y < height):\n      return False\n    # Check if the cell contains any known obstacle\n    for obs_idx in obstacle_indices:\n      if current_grid[x, y, obs_idx] == 1.0:\n        return False\n    return True\n\n  # BFS initialization\n  # Queue stores tuples: ((current_x, current_y), list_of_actions_to_reach_here)\n  queue = collections.deque([(current_pos, [])])\n  # Visited set stores (x, y) tuples to avoid cycles and redundant processing\n  visited = {current_pos}\n\n  best_path_to_adjacent = None\n\n  # BFS search\n  while queue:\n    (cx, cy), path_so_far = queue.popleft()\n\n    # Check if the current cell (cx, cy) is adjacent to the primitive\n    # We consider the 4 direct neighbors (Up, Down, Left, Right) relative to (cx, cy)\n    for dx_adj, dy_adj in [(-1, 0), (1, 0), (0, -1), (0, 1)]: \n      px, py = cx + dx_adj, cy + dy_adj\n      \n      # Check if the potential primitive location is within bounds\n      if 0 <= px < width and 0 <= py < height:\n        if current_grid[px, py, primitive_idx] == 1.0:\n          # Found a primitive adjacent to (cx, cy). \n          # This path_so_far is the shortest path to an adjacent traversable cell.\n          best_path_to_adjacent = path_so_far\n          break # Exit inner loop, we found a target adjacent cell\n\n    if best_path_to_adjacent is not None:\n      break # Exit BFS if a path to an adjacent cell was found\n\n    # If not adjacent to primitive yet, explore neighbors of (cx, cy)\n    # Define possible moves and their corresponding actions\n    moves_and_actions = [\n        ((0, -1), UP_ACTION),    # Move Up\n        ((0, 1), DOWN_ACTION),   # Move Down\n        ((-1, 0), LEFT_ACTION),  # Move Left\n        ((1, 0), RIGHT_ACTION)   # Move Right\n    ]\n\n    for (dx, dy), action in moves_and_actions:\n      nx, ny = cx + dx, cy + dy\n      n_pos_tuple = (nx, ny)\n\n      # Only explore if the neighbor is traversable and has not been visited yet\n      if is_traversable(nx, ny) and n_pos_tuple not in visited:\n        visited.add(n_pos_tuple)\n        queue.append((n_pos_tuple, path_so_far + [action]))\n\n  # Construct the final list of actions\n  result_actions = []\n  if best_path_to_adjacent is not None:\n    result_actions.extend(best_path_to_adjacent)\n    # If the primitive is grabbable, append the USE action after reaching the adjacent cell\n    if primitive_idx in env.world.grabbable_indices:\n      result_actions.append(USE_ACTION)\n\n  return result_actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:28:46.876128", "function_name": "collect", "function_body": "  action_specs = env.action_specs()\n  action_map = {\n      \"UP\": action_specs[\"UP\"],\n      \"DOWN\": action_specs[\"DOWN\"],\n      \"LEFT\": action_specs[\"LEFT\"],\n      \"RIGHT\": action_specs[\"RIGHT\"],\n      \"USE\": action_specs[\"USE\"]\n  }\n  \n  # Get the integer ID of the primitive.\n  # The DSL ensures 'primitive' is a valid string (e.g., 'WOOD', 'WORKSHOP0').\n  # `cookbook.index.index` returns the integer ID for the given name.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # If the primitive name does not correspond to a valid index (e.g., 0 for \"invalid\" or not found),\n  # then it cannot be collected. This should ideally not happen with valid DSL inputs.\n  if primitive_idx == 0:\n      return []\n\n  current_state = env._current_state\n  current_grid = current_state.grid\n  grid_height, grid_width, n_kinds = current_grid.shape\n  current_pos_y, current_pos_x = current_state.pos\n\n  # Determine if the primitive is a grabbable item (e.g., WOOD, STONE) or non-grabbable (e.g., WORKSHOP0, WATER).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Early Exit 1: If the primitive is grabbable and already in inventory.\n  # Ensure primitive_idx is within bounds of inventory array before accessing.\n  if is_grabbable and primitive_idx < len(current_state.inventory) and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Early Exit 2: If the agent is already adjacent to the desired primitive.\n  # CraftState.next_to checks the 3x3 neighborhood around the agent's current position.\n  if current_state.next_to(primitive_idx):\n      if is_grabbable:\n          # If it's a grabbable item and we are next to it, perform the USE action to collect.\n          return [action_map[\"USE\"]]\n      else:\n          # If it's a non-grabbable item (like a WORKSHOP), being adjacent is sufficient for \"collection\"\n          # (i.e., no further actions are needed to be in its vicinity).\n          return []\n\n  # Define movement deltas for (dy, dx) corresponding to each action\n  # (dy, dx) -> (change in row/y, change in col/x)\n  move_deltas = {\n      action_map[\"UP\"]: (-1, 0),    # Move up: decrement row (y)\n      action_map[\"DOWN\"]: (1, 0),   # Move down: increment row (y)\n      action_map[\"LEFT\"]: (0, -1),  # Move left: decrement col (x)\n      action_map[\"RIGHT\"]: (0, 1)   # Move right: increment col (x)\n  }\n  \n  # Identify indices of entities that block movement.\n  # `non_grabbable_indices` typically includes water, workshops, etc., which agents cannot walk onto.\n  impassable_kinds = env.world.non_grabbable_indices\n\n  # BFS queue stores tuples: ((current_y, current_x), path_actions_to_reach_here)\n  queue = collections.deque([((current_pos_y, current_pos_x), [])]) \n  # Set to keep track of visited grid cells (y, x) to prevent cycles in BFS\n  visited = {(current_pos_y, current_pos_x)} \n\n  while queue:\n      (curr_y, curr_x), path_so_far = queue.popleft()\n\n      # Explore all four cardinal neighbors (UP, DOWN, LEFT, RIGHT) from the current cell\n      for action_id, (dy, dx) in move_deltas.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_pos = (next_y, next_x)\n\n          # Check 1: Ensure the next position is within grid boundaries\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check 2: Ensure the next position has not been visited yet in the BFS\n          if next_pos in visited:\n              continue\n            \n          # Check 3: Ensure the next position is not blocked by an impassable entity.\n          # A cell is considered blocked if it contains any entity from the `impassable_kinds` set.\n          is_blocked = False\n          for k_blocked in impassable_kinds:\n              # Ensure k_blocked is a valid index for the grid's kind dimension\n              if k_blocked < n_kinds and current_grid[next_y, next_x, k_blocked] == 1:\n                  is_blocked = True\n                  break\n          if is_blocked:\n              # This cell is impassable for movement, so skip it.\n              continue\n            \n          # If the cell is within bounds, unvisited, and walkable, add it to the visited set\n          visited.add(next_pos) \n          # Extend the path to this new, reachable cell\n          new_path = path_so_far + [action_id] \n\n          # Goal Check: Determine if this newly reached traversable cell (next_y, next_x)\n          # is *adjacent* to the desired primitive. This mimics `CraftState.next_to`'s 3x3 check.\n          found_primitive_in_neighborhood = False\n          # Iterate over the 3x3 neighborhood around `next_pos` (including `next_pos` itself)\n          for dy_nb in [-1, 0, 1]:\n              for dx_nb in [-1, 0, 1]:\n                  nb_y, nb_x = next_y + dy_nb, next_x + dx_nb\n                  \n                  # Ensure neighbor position is within grid boundaries\n                  if 0 <= nb_y < grid_height and 0 <= nb_x < grid_width:\n                      # Check if this neighbor cell contains the target primitive\n                      # Ensure primitive_idx is a valid index for the grid's kind dimension\n                      if primitive_idx < n_kinds and current_grid[nb_y, nb_x, primitive_idx] == 1:\n                          found_primitive_in_neighborhood = True\n                          break # Primitive found in this neighborhood, no need to check further neighbors for current `next_pos`\n              if found_primitive_in_neighborhood:\n                  break # Found it, no need to check other neighbor rows/cols for current `next_pos`\n\n          if found_primitive_in_neighborhood:\n              # A path has been found to a traversable cell from which the primitive can be \"collected\"!\n              final_actions = new_path\n              # If the primitive is grabbable, a `USE` action is required after reaching adjacency.\n              if is_grabbable:\n                  final_actions.append(action_map[\"USE\"])\n              return final_actions # Return the complete sequence of actions\n\n          # If the primitive was not found in the neighborhood of `next_pos`,\n          # add `next_pos` to the queue for further exploration.\n          queue.append((next_pos, new_path))\n    \n  # If the BFS completes (queue becomes empty) and no path to the primitive (or a cell adjacent to it) was found,\n  # it means the primitive is either unreachable or not present on the grid.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:28:48.805173", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  UP, DOWN, LEFT, RIGHT, USE = action_map['UP'], action_map['DOWN'], action_map['LEFT'], action_map['RIGHT'], action_map['USE']\n\n  # Get the integer ID of the primitive.\n  # The DSL ensures 'primitive' is a valid string (e.g., 'WOOD', 'WORKSHOP0').\n  # The `cookbook.index.index` method will return a positive integer ID (>= 1) for\n  # all defined primitive types, potentially adding it to the index if not present.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # If primitive_idx is 0, it means the primitive name wasn't recognized or is invalid.\n  # For valid primitives in the DSL, this should always return a positive ID.\n  if primitive_idx == 0:\n      return []\n\n  current_state = env._current_state\n  current_pos = current_state.pos  # Agent's current (row, col) position (y, x)\n  current_grid = current_state.grid  # The full grid (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, n_kinds = current_grid.shape\n\n  # 1. Check if the primitive is already in the agent's inventory.\n  # If it is, no collection actions are needed, as \"collect\" often implies acquiring at least one.\n  # This aligns with `CraftState.satisfies` checking `inventory[goal_arg] > 0`.\n  if primitive_idx < n_kinds and current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # Determine if the primitive is grabbable (e.g., 'WOOD', 'STONE') or non-grabbable (e.g., 'WORKSHOP0', 'WATER').\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # 2. Check if the agent is already adjacent to the desired primitive.\n  # CraftState.next_to checks the 3x3 neighborhood around the agent's current position.\n  if current_state.next_to(primitive_idx):\n      if is_grabbable:\n          # If next to a grabbable item, we need to perform the USE action to collect it.\n          return [USE]\n      else:\n          # If next to a non-grabbable item (like a workshop), being adjacent is sufficient for \"collection\".\n          # No further action is needed.\n          return []\n\n  # 3. Scan the entire grid to find all occurrences of the primitive.\n  primitive_locations = []\n  for y in range(grid_height):\n      for x in range(grid_width):\n          # Ensure primitive_idx is within bounds of the grid's kind dimension\n          if primitive_idx < n_kinds and current_grid[y, x, primitive_idx] == 1:\n              primitive_locations.append((y, x))\n\n  # If the primitive is not found anywhere on the grid, there's nothing to collect.\n  if not primitive_locations:\n      return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  # to a cell that is adjacent to any of the found primitive locations.\n  # The queue stores tuples of (current_coordinates, path_taken_to_reach_here).\n  q = collections.deque([(current_pos, [])])\n  # The visited set keeps track of (y, x) coordinates already explored to prevent cycles.\n  visited = {current_pos}\n\n  # Define possible cardinal moves and their corresponding actions.\n  # (dy, dx) represents the change in (y, x) coordinates for (row, col).\n  move_deltas = {\n      (-1, 0): UP,    # Move Up (decrement y)\n      (1, 0): DOWN,   # Move Down (increment y)\n      (0, -1): LEFT,  # Move Left (decrement x)\n      (0, 1): RIGHT,  # Move Right (increment x)\n  }\n\n  # Identify indices of entities that block movement.\n  # The `non_grabbable_indices` set includes entities like water, workshops, boundaries,\n  # which usually cannot be walked onto.\n  impassable_indices = env.world.non_grabbable_indices\n\n  while q:\n      (curr_y, curr_x), path = q.popleft()\n\n      # For each found primitive location, check if the current BFS node (curr_y, curr_x)\n      # is directly adjacent (Manhattan distance of 1). If so, we've found a path\n      # to a position from which the primitive can be interacted with.\n      for p_y, p_x in primitive_locations:\n          # Check for direct adjacency (Manhattan distance of 1)\n          if abs(curr_y - p_y) + abs(curr_x - p_x) == 1:\n              # A path has been found to a traversable cell adjacent to the primitive!\n              final_actions = list(path) # Create a copy of the path\n              if is_grabbable:\n                  # If the item is grabbable, a `USE` action is required after reaching adjacency.\n                  final_actions.append(USE)\n              return final_actions # Return the complete sequence of actions\n\n      # Explore all valid neighboring cells from the current position.\n      for (dy, dx), action in move_deltas.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_coords = (next_y, next_x)\n\n          # Ensure the next coordinates are within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Check if the next position is blocked by an impassable entity.\n          # A cell is considered blocked if it contains any entity from the `impassable_indices`.\n          is_impassable = False\n          for k_impassable in impassable_indices:\n              # Ensure k_impassable is a valid index for the grid's kind dimension\n              if k_impassable < n_kinds and current_grid[next_y, next_x, k_impassable] == 1:\n                  is_impassable = True\n                  break # This cell is impassable, no need to check further kinds for this cell\n          if is_impassable:\n              continue\n\n          # If the next cell has not been visited yet, add it to the queue\n          # with the updated path.\n          if next_coords not in visited:\n              visited.add(next_coords)\n              q.append((next_coords, path + [action]))\n\n  # If the BFS completes and no path to the primitive (or a cell adjacent to it) was found,\n  # it means the primitive is either unreachable or not present on the grid.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:30:31.469929", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:30:33.627304", "function_name": "collect", "function_body": "  current_state = env._current_state\n  start_x, start_y = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Action constants (from CraftLab.action_specs())\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map action to (dx, dy) delta on grid (assuming (x, y) where x is horizontal, y is vertical, y increases upwards)\n  _move_action_to_delta = {\n      ACTION_DOWN: (0, -1),\n      ACTION_UP: (0, 1),\n      ACTION_LEFT: (-1, 0),\n      ACTION_RIGHT: (1, 0),\n  }\n\n  # Determine target cells based on primitive type and if it's collectible/interactible\n  is_grabbable_item = primitive in env.world.grabbable_indices\n  is_workshop_facility = primitive in env.world.workshop_indices\n  is_natural_resource_feature = (primitive == env.world.water_index or \n                                primitive == env.world.stone_index)\n\n  # If the primitive is a boundary or not a known collectable/interactable type, do not proceed.\n  # The DSL's `primitive` includes `BOUNDARY`. `BOUNDARY` is not collectible via `USE`.\n  if not (is_grabbable_item or is_workshop_facility or is_natural_resource_feature):\n      return []\n\n  target_cells_for_bfs = set()\n  \n  # Find all locations of the primitive on the grid\n  primitive_locations_on_grid = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          if grid[x, y, primitive] == 1:\n              primitive_locations_on_grid.append((x, y))\n    \n  if not primitive_locations_on_grid:\n      return [] # Primitive not found on grid\n\n  # Populate target_cells_for_bfs based on primitive type\n  for px, py in primitive_locations_on_grid:\n      if is_grabbable_item:\n          # For grabbable items (e.g., WOOD), agent typically moves onto the cell to pick up\n          target_cells_for_bfs.add((px, py))\n      elif is_workshop_facility or is_natural_resource_feature:\n          # For workshops, water, stone, agent typically moves adjacent to the cell to interact\n          # Add 4-directional neighbors of the primitive's location as targets\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = px + dx, py + dy\n              # Ensure neighbor is within grid bounds\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  target_cells_for_bfs.add((nx, ny))\n      # No 'else' case for 'target_cells_for_bfs' population because non-collectible primitives are filtered above.\n\n  if not target_cells_for_bfs: \n      # This case should ideally not be reached if primitive_locations_on_grid is not empty and conditions are met,\n      # but it adds robustness if, for example, a workshop exists but has no valid adjacent empty cells.\n      return []\n\n  # Use a Breadth-First Search (BFS) to find the shortest path to any of the target cells.\n  q = collections.deque([((start_x, start_y), [])]) # Queue stores tuples of (current_position, path_taken_so_far)\n  visited = { (start_x, start_y) } # Set of visited positions to avoid cycles and redundant exploration\n  \n  path_to_interaction_point = None\n\n  while q:\n      (cx, cy), path_so_far = q.popleft()\n\n      # Check if the current cell (cx, cy) is one of our designated target cells for interaction\n      if (cx, cy) in target_cells_for_bfs:\n          path_to_interaction_point = path_so_far\n          break # Found the shortest path to a suitable interaction point\n      \n      # Explore neighbors in all four cardinal directions\n      for action_val, (dx, dy) in _move_action_to_delta.items():\n          nx, ny = cx + dx, cy + dy\n          next_pos = (nx, ny)\n\n          # Check if the next position is within grid boundaries and has not been visited yet\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and next_pos not in visited:\n              visited.add(next_pos)\n              # Add the next position and the updated path to the queue\n              q.append((next_pos, path_so_far + [action_val]))\n\n  if path_to_interaction_point is not None:\n      # If a path was found, append a 'USE' action to interact with the primitive\n      return path_to_interaction_point + [ACTION_USE]\n  else:\n      # If no path was found (e.g., the target is unreachable from the current position), \n      # return an empty list of actions.\n      return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:31:50.788359", "function_name": "collect", "function_body": "  current_state = env._current_state\n  agent_pos = current_state.pos\n  grid = current_state.grid\n  world = env.world\n  cookbook = world.cookbook\n\n  primitive_idx = cookbook.index[primitive]\n\n  grabbable_indices = world.grabbable_indices\n  non_grabbable_indices = world.non_grabbable_indices\n  workshop_indices = world.workshop_indices\n\n  WIDTH, HEIGHT, _ = grid.shape # Grid dimensions are (height, width, n_kinds) in numpy, so grid.shape[0] is HEIGHT\n\n  # Action constants (from CraftLab.action_specs())\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Map (dy, dx) to action_id for movement\n  # dy is change in row (y-coordinate), dx is change in column (x-coordinate)\n  MOVEMENT_ACTIONS = {\n      (-1, 0): ACTION_UP,    # Move up: decrease row index\n      (1, 0): ACTION_DOWN,   # Move down: increase row index\n      (0, -1): ACTION_LEFT,  # Move left: decrease column index\n      (0, 1): ACTION_RIGHT,  # Move right: increase column index\n  }\n\n  is_target_grabbable = primitive_idx in grabbable_indices\n  is_target_workshop = primitive_idx in workshop_indices\n\n  # BFS setup\n  # Queue stores tuples of (current_position, path_actions_to_reach_here)\n  queue = collections.deque([(agent_pos, [])]) \n  visited = {agent_pos} # Set of visited positions to avoid cycles and redundant checks\n  target_path = None # Stores the found path of actions\n\n  while queue:\n      current_pos, path_actions = queue.popleft() # Get the next position to explore\n\n      # Check if current_pos contains the target primitive\n      # grid[y, x, kind_idx] == 1 means that kind is present at (y, x)\n      if grid[current_pos[0], current_pos[1], primitive_idx] == 1:\n          # Found the primitive's location\n          if is_target_grabbable:\n              # If it's a grabbable item (e.g., WOOD, IRON), we move to it and then USE it.\n              target_path = path_actions + [ACTION_USE]\n          elif is_target_workshop:\n              # If it's a workshop (e.g., WORKSHOP0), we just move to its location; no USE action needed for \"collection\".\n              target_path = path_actions\n          else:\n              # This covers cases where the primitive is neither grabbable nor a workshop,\n              # but exists on the grid and is reachable (e.g., some environmental features\n              # not explicitly in workshops/grabbables but defined as DSL primitives).\n              # \"Collecting\" in this context implies simply reaching the location.\n              target_path = path_actions\n          break # Path found, exit the BFS loop\n\n      # Explore neighbors\n      for dy, dx in MOVEMENT_ACTIONS:\n          ny, nx = current_pos[0] + dy, current_pos[1] + dx # Calculate new position\n          next_pos = (ny, nx)\n\n          # Check grid boundaries\n          if not (0 <= ny < HEIGHT and 0 <= nx < WIDTH):\n              continue # Out of bounds\n\n          # Check if already visited\n          if next_pos in visited:\n              continue\n\n          # Check if the next_pos is blocked by any non-grabbable entity\n          # If the cell at (ny, nx) contains any kind k_idx that is in non_grabbable_indices,\n          # then it is an impassable obstacle (e.g., WATER, STONE, BOUNDARY).\n          is_blocked = False\n          for k_idx in non_grabbable_indices:\n              if grid[ny, nx, k_idx] == 1:\n                  is_blocked = True\n                  break\n          if is_blocked:\n              continue # Cannot move onto this cell\n\n          # If reachable and not visited, add to queue\n          visited.add(next_pos)\n          action_to_take = MOVEMENT_ACTIONS[(dy, dx)]\n          queue.append((next_pos, path_actions + [action_to_take]))\n\n  if target_path:\n      return target_path\n  else:\n      # No path found to the primitive (e.g., it's not on the map, or all paths are blocked)\n      return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:31:52.683509", "function_name": "collect", "function_body": "  actions_to_take = []\n\n  # 1. Get Primitive ID\n  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If primitive is not found in the index, it cannot be collected.\n    return []\n\n  # Ensure the primitive is actually grabbable.\n  # The 'collect' action implies adding to inventory, which only works for grabbable items.\n  # Primitives like 'WATER' or 'WORKSHOP0' are not grabbable and thus cannot be collected.\n  if primitive_id not in env.world.grabbable_indices:\n    return []\n\n  # 2. Get current state information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get action mappings dynamically from the environment\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Define possible movements (dr, dc) and corresponding actions\n  # Used to reconstruct the path of actions from parent pointers in BFS.\n  move_deltas = {\n      (-1, 0): ACTION_UP,\n      (1, 0): ACTION_DOWN,\n      (0, -1): ACTION_LEFT,\n      (0, 1): ACTION_RIGHT,\n  }\n\n  # BFS for pathfinding to the *exact location* of the primitive on the grid.\n  # The queue stores tuples of (current_position, list_of_actions_to_reach_current_position)\n  queue = collections.deque([(start_pos, [])])\n  visited = {start_pos}\n\n  target_primitive_cell = None\n  path_to_primitive_cell = []\n\n  while queue:\n    (r, c), path = queue.popleft()\n\n    # Check if the current cell (r, c) contains the primitive.\n    # If it does, this is our target cell.\n    if grid[r, c, primitive_id] > 0:\n      target_primitive_cell = (r, c)\n      path_to_primitive_cell = path\n      break # Found the target, exit BFS\n\n    # Explore valid neighboring cells\n    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]: # Up, Down, Left, Right relative moves\n      nr, nc = r + dr, c + dc\n      new_pos = (nr, nc)\n\n      # Check if the new position is within grid boundaries.\n      if not (0 <= nr < WIDTH and 0 <= nc < HEIGHT):\n        continue\n\n      # Check if the new position contains an impassable obstacle (e.g., water).\n      # Water is typically an impassable terrain. Workshops are usually walkable.\n      is_water = False\n      if env.world.water_index in env.world.kinds: # Check if water exists in this world configuration\n          if grid[nr, nc, env.world.water_index] > 0:\n              is_water = True\n      \n      if is_water:\n        continue # Cannot move onto water\n\n      # If the new position has not been visited, add it to the queue.\n      if new_pos not in visited:\n        visited.add(new_pos)\n        action_to_take = move_deltas[(dr, dc)] # Determine the action required to move to new_pos\n        queue.append((new_pos, path + [action_to_take]))\n\n  # If no primitive was found or it's unreachable, return an empty list of actions.\n  if target_primitive_cell is None:\n    return []\n\n  # If a path was found, add all movement actions to the list.\n  actions_to_take.extend(path_to_primitive_cell)\n\n  # After reaching the cell containing the primitive, perform the USE action to collect it.\n  actions_to_take.append(ACTION_USE)\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:33:07.909742", "function_name": "collect", "function_body": "  import collections\n\n  actions = env.action_specs()\n  UP_A = actions['UP']\n  DOWN_A = actions['DOWN']\n  LEFT_A = actions['LEFT']\n  RIGHT_A = actions['RIGHT']\n  USE_A = actions['USE']\n\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  primitive_idx = env.world.cookbook.index[primitive]\n  boundary_idx = env.world.cookbook.index['BOUNDARY']\n  # water_index is a specific attribute of CraftWorld\n  water_idx = env.world.water_index \n\n  # Find all locations of the primitive on the grid\n  primitive_locations = []\n  for x in range(WIDTH):\n      for y in range(HEIGHT):\n          # Check if the primitive kind exists at this grid cell\n          if grid[x, y, primitive_idx] > 0:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # Primitive not found anywhere on the map\n      return []\n\n  q = collections.deque([(start_pos, [])]) # Queue stores (current_x, current_y), path_so_far\n  visited = {start_pos} # Set of (x, y) coordinates already visited\n\n  # BFS loop to find the shortest path\n  while q:\n      (curr_x, curr_y), path = q.popleft()\n\n      # Check if any primitive is adjacent to the current agent's position (curr_x, curr_y)\n      # The CraftState.next_to function checks the 3x3 neighborhood, meaning\n      # if the primitive is at (px, py), it's considered \"next to\" if abs(curr_x - px) <= 1\n      # and abs(curr_y - py) <= 1.\n      is_adjacent_to_primitive = False\n      for px, py in primitive_locations:\n          if abs(curr_x - px) <= 1 and abs(curr_y - py) <= 1:\n              is_adjacent_to_primitive = True\n              break # Found an adjacent primitive location\n\n      if is_adjacent_to_primitive:\n          # Path found! Append the USE action and return the full sequence.\n          return path + [USE_A]\n\n      # Explore neighboring cells (UP, DOWN, LEFT, RIGHT)\n      # These tuples are ( (next_x, next_y), action_to_reach_there )\n      neighbors = [\n          ((curr_x, curr_y - 1), UP_A),    # UP\n          ((curr_x, curr_y + 1), DOWN_A),  # DOWN\n          ((curr_x - 1, curr_y), LEFT_A),  # LEFT\n          ((curr_x + 1, curr_y), RIGHT_A)  # RIGHT\n      ]\n\n      for (next_x, next_y), action in neighbors:\n          # Check if the next cell is within grid boundaries and has not been visited\n          if (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT) and (next_x, next_y) not in visited:\n              # Check if the next cell is an obstacle.\n              # Boundary is always an obstacle.\n              # Water is an obstacle unless the primitive itself is water.\n              is_cell_obstacle = False\n              if grid[next_x, next_y, boundary_idx] > 0:\n                  is_cell_obstacle = True\n              elif grid[next_x, next_y, water_idx] > 0 and primitive_idx != water_idx:\n                  is_cell_obstacle = True\n              \n              # Add more sophisticated obstacle checks if needed for complex environments,\n              # e.g., checking CraftWorld.non_grabbable_indices that are impassable.\n              # For this environment, Boundary and Water (unless water is the target) are typical obstacles.\n\n              if not is_cell_obstacle:\n                  visited.add((next_x, next_y))\n                  q.append(((next_x, next_y), path + [action]))\n\n  # If the queue becomes empty and no path was found, the primitive is unreachable\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:33:09.936932", "function_name": "collect", "function_body": "  ACTIONS = env.action_specs()\n  MOVE_ACTIONS = [ACTIONS['UP'], ACTIONS['DOWN'], ACTIONS['LEFT'], ACTIONS['RIGHT']]\n  USE_ACTION = ACTIONS['USE']\n\n  primitive_idx = env.world.cookbook.index(primitive)\n  if primitive_idx is None:\n    # Primitive name not found in the cookbook.\n    return []\n\n  # Check if the primitive is actually grabbable (can be picked up with USE action).\n  # If it's a non-grabbable item (e.g., a workshop, water, or unmineable stone),\n  # this function, which aims to 'collect' (i.e., add to inventory), should return an empty list.\n  if primitive_idx not in env.world.grabbable_indices:\n    return []\n\n  initial_state = env._current_state\n\n  # BFS queue: stores tuples of (current_CraftState, list_of_actions_to_reach_this_state)\n  q = collections.deque([(initial_state, [])])\n  \n  # Visited set: stores (pos_x, pos_y, dir) tuples to avoid redundant exploration\n  # and infinite loops. The agent's direction is crucial because it affects the\n  # outcome of the 'USE' action and subsequent moves.\n  visited = set([(initial_state.pos[0], initial_state.pos[1], initial_state.dir)])\n\n  # Define a maximum search depth to prevent excessive computation in very large environments\n  # or if a path doesn't exist. This is an arbitrary but practical limit.\n  MAX_SEARCH_DEPTH = 100 \n\n  while q:\n    current_state, actions_path = q.popleft()\n\n    # Prune paths that exceed the maximum search depth\n    if len(actions_path) > MAX_SEARCH_DEPTH:\n      continue \n\n    # Check if the current state is adjacent to the primitive and facing it correctly\n    grid = current_state.grid\n    pos_x, pos_y = current_state.pos\n    width, height, _ = grid.shape\n\n    # Map of relative coordinates to the required agent direction to face that cell\n    # (dx, dy) -> dir (0:UP/North, 1:DOWN/South, 2:LEFT/West, 3:RIGHT/East)\n    cardinal_neighbors = {\n        (0, -1): 0, # North (Y-1)\n        (0, 1): 1,  # South (Y+1)\n        (-1, 0): 2, # West (X-1)\n        (1, 0): 3,  # East (X+1)\n    }\n\n    for (dx, dy), required_dir in cardinal_neighbors.items():\n      nx, ny = pos_x + dx, pos_y + dy\n\n      # Check if the neighbor cell is within grid boundaries\n      if 0 <= nx < width and 0 <= ny < height:\n        # Check if the primitive is located at this neighbor cell\n        if grid[nx, ny, primitive_idx] > 0:\n          # If the primitive is at the neighbor, check if the agent is currently facing it\n          if current_state.dir == required_dir:\n            # If so, we have found a valid path to collect the primitive\n            return actions_path + [USE_ACTION]\n\n    # If not yet at a collection point, explore possible next moves\n    for action in MOVE_ACTIONS:\n      # Simulate the action using the CraftState's step method to get the next state\n      # The reward is typically 0.0 for basic moves in this implementation, so we discard it.\n      _, next_state = current_state.step(action)\n\n      # Get the new position and direction after the simulated move\n      next_pos_x, next_pos_y = next_state.pos\n      next_dir = next_state.dir\n\n      # If this new state (position and direction) has not been visited before, add it to the queue\n      if (next_pos_x, next_pos_y, next_dir) not in visited:\n        visited.add((next_pos_x, next_pos_y, next_dir))\n        q.append((next_state, actions_path + [action]))\n\n  # If the BFS completes without finding a path to collect the primitive, return an empty list.\n  return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:34:27.659875", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos # Agent's current position (x, y)\n  \n  # Grid dimensions: (WIDTH, HEIGHT, n_kinds)\n  width, height, _ = current_grid.shape\n\n  # Items that block agent movement (e.g., walls, water).\n  # These are generally the non-grabbable items that act as terrain obstacles.\n  impassable_kinds = env.world.non_grabbable_indices\n  \n  def is_traversable_for_agent(x, y):\n      \"\"\"\n      Checks if a cell (x, y) is within grid boundaries and is traversable by the agent.\n      A cell is not traversable if it contains any 'impassable_kind'.\n      \"\"\"\n      # Check boundaries\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      \n      # Check if any kind at this cell is impassable\n      # current_grid[x, y] returns a 1D array of kind presence\n      present_kinds_at_cell = np.where(current_grid[x, y] == 1.0)[0]\n      for k_idx in present_kinds_at_cell:\n          if k_idx in impassable_kinds:\n              return False # This cell contains an impassable item\n      return True\n\n  # 1. Find all grid locations where the target primitive exists\n  primitive_locations = []\n  for x in range(width):\n    for y in range(height):\n      if current_grid[x, y, primitive_idx] == 1.0:\n        primitive_locations.append((x, y))\n\n  if not primitive_locations:\n    return [] # Primitive not found anywhere on the grid\n\n  # 2. Determine all potential goal cells for BFS. These are traversable cells\n  # directly adjacent (4-way) to any instance of the primitive.\n  target_adjacent_cells = set()\n  # Relative offsets for adjacent cells: (dx, dy)\n  # Assuming (x, y) where x is horizontal, y is vertical, and y increases downwards\n  adj_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Left, Right, Up, Down\n\n  for px, py in primitive_locations:\n    for dx, dy in adj_offsets:\n      adj_x, adj_y = px + dx, py + dy\n      # An adjacent cell is a potential goal if it's traversable by the agent\n      if is_traversable_for_agent(adj_x, adj_y):\n        target_adjacent_cells.add((adj_x, adj_y))\n\n  if not target_adjacent_cells:\n      return [] # No reachable adjacent cells to any primitive instance\n\n  # If the agent is already at a target_adjacent_cell, no movement is needed,\n  # just the USE action if the item is grabbable.\n  if current_pos in target_adjacent_cells:\n      if primitive_idx in env.world.grabbable_indices:\n          return [USE_ACTION]\n      else:\n          # If not grabbable, being next to it is \"collecting\" it. No actions needed.\n          return [] \n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path from current_pos\n  # to any cell in target_adjacent_cells.\n  # Queue stores tuples of (position_tuple, path_actions_taken_so_far)\n  queue = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set of visited positions to avoid cycles\n\n  # Mapping of (dx, dy) to action constant for agent movement\n  action_deltas = {\n      (-1, 0): LEFT_ACTION,\n      (1, 0): RIGHT_ACTION,\n      (0, -1): UP_ACTION,\n      (0, 1): DOWN_ACTION\n  }\n  \n  shortest_path_actions = [] # Stores the actions for the shortest path found\n\n  while queue:\n    curr_x, curr_y = queue.popleft()\n    path_actions = queue.popleft() # Pop the associated path\n\n    # Explore neighbors\n    for dx, dy in adj_offsets:\n      next_x, next_y = curr_x + dx, curr_y + dy\n      next_pos = (next_x, next_y)\n\n      if is_traversable_for_agent(next_x, next_y) and next_pos not in visited:\n        visited.add(next_pos)\n        action_to_take = action_deltas[(dx, dy)]\n        new_path_actions = path_actions + [action_to_take]\n        \n        if next_pos in target_adjacent_cells:\n            # Found a shortest path (BFS guarantees shortest upon first discovery)\n            shortest_path_actions = new_path_actions\n            queue.clear() # Clear queue to stop further exploration\n            break # Exit inner loop for neighbors\n        else:\n            queue.append((next_pos, new_path_actions))\n    \n    if shortest_path_actions: # If path was found, stop outer loop as well\n        break\n\n  # 4. If a path was found, append the USE action if the primitive is grabbable.\n  if shortest_path_actions:\n      if primitive_idx in env.world.grabbable_indices:\n          shortest_path_actions.append(USE_ACTION)\n      return shortest_path_actions\n  else:\n      return [] # No path found to any adjacent traversable cell", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:34:29.647094", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  state = env._current_state\n  current_grid = state.grid\n  current_pos = state.pos # (x, y) coordinates for agent's position\n\n  # Grid dimensions are (WIDTH, HEIGHT, n_kinds) where WIDTH is x-dimension, HEIGHT is y-dimension\n  width, height, _ = current_grid.shape\n\n  # Define explicit obstacle indices using world attributes and cookbook index\n  # These are generally things you cannot move through.\n  water_idx = env.world.water_index\n  stone_idx = env.world.stone_index\n  # 'BOUNDARY' might not always be present, check before accessing\n  boundary_idx = env.world.cookbook.index['BOUNDARY'] if 'BOUNDARY' in env.world.cookbook.index.contents else -1\n\n  # Workshops are explicitly defined as non-grabbable but are locations the agent can move onto\n  # to \"use\" them for crafting. They should not be treated as movement obstacles.\n  workshop_indices = set(env.world.workshop_indices)\n\n  def is_traversable_for_agent(x, y):\n      \"\"\"\n      Checks if cell (x, y) is within grid bounds and traversable by the agent.\n      A cell is non-traversable if it contains specific obstacles (water, stone, boundary)\n      or any other non-grabbable item that is NOT a workshop.\n      \"\"\"\n      if not (0 <= x < width and 0 <= y < height):\n          return False\n      \n      # Check for known explicit obstacles that block movement\n      if water_idx != -1 and current_grid[x, y, water_idx] == 1.0:\n          return False\n      if stone_idx != -1 and current_grid[x, y, stone_idx] == 1.0:\n          return False\n      if boundary_idx != -1 and current_grid[x, y, boundary_idx] == 1.0:\n          return False\n          \n      # Check for any other non-grabbable items that are not workshops.\n      # We assume these are also obstacles to movement.\n      present_kinds_at_cell = np.where(current_grid[x, y] == 1.0)[0]\n      for k_idx in present_kinds_at_cell:\n          if k_idx in env.world.non_grabbable_indices and k_idx not in workshop_indices:\n              return False # This is a non-grabbable obstacle (e.g., wall, unmovable rock)\n              \n      return True\n\n  # 1. Identify all locations on the grid where the target primitive exists\n  primitive_locations = []\n  for x in range(width):\n      for y in range(height):\n          if current_grid[x, y, primitive_idx] == 1.0:\n              primitive_locations.append((x, y))\n  \n  if not primitive_locations:\n      return [] # Primitive not found anywhere on the grid\n\n  # 2. Determine all potential goal cells for BFS. These are cells that are valid, traversable,\n  # and are directly adjacent (4-way) to any instance of the primitive.\n  target_adj_cells = set()\n  \n  # Relative offsets for adjacent cells: (dx, dy)\n  neighbor_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Left, Right, Up, Down (in x,y terms)\n\n  for px, py in primitive_locations:\n      for dx, dy in neighbor_offsets:\n          adj_x, adj_y = px + dx, py + dy\n          if is_traversable_for_agent(adj_x, adj_y):\n              target_adj_cells.add((adj_x, adj_y))\n  \n  if not target_adj_cells: # If no reachable adjacent cells to any primitive instance\n      return []\n\n  # Handle immediate case: if agent is already at a target_adj_cell\n  if current_pos in target_adj_cells:\n      if primitive_idx in env.world.grabbable_indices:\n          return [USE_ACTION] # If grabbable, use it\n      else:\n          # If not grabbable (e.g., WORKSHOP), being next to it implies \"collected\"\n          # for the purpose of the DSL (no further action needed to \"collect\" it).\n          return [] \n\n  # 3. Perform Breadth-First Search (BFS) to find the shortest path from current_pos to any target_adj_cell.\n  queue = collections.deque([(current_pos, [])]) # Queue stores tuples of (position, path_actions_taken)\n  visited = {current_pos} # Set of visited positions to avoid cycles and redundant processing\n\n  # Mapping of (dx, dy) to action constant for agent movement\n  action_deltas = {\n      (0, -1): UP_ACTION,   # Move Up (y decreases)\n      (0, 1): DOWN_ACTION,  # Move Down (y increases)\n      (-1, 0): LEFT_ACTION, # Move Left (x decreases)\n      (1, 0): RIGHT_ACTION  # Move Right (x increases)\n  }\n  \n  best_path_actions = [] # This will store the shortest path found by BFS\n\n  while queue:\n      (cx, cy), path_actions = queue.popleft()\n\n      # Explore neighbors\n      for dx, dy in neighbor_offsets: \n          nx, ny = cx + dx, cy + dy\n          next_pos = (nx, ny)\n          \n          if is_traversable_for_agent(nx, ny) and next_pos not in visited:\n              visited.add(next_pos)\n              action_to_take = action_deltas[(dx, dy)]\n              new_path_actions = path_actions + [action_to_take]\n              \n              if next_pos in target_adj_cells:\n                  # Found a shortest path to a target adjacent cell (BFS guarantees shortest)\n                  best_path_actions = new_path_actions\n                  queue.clear() # Clear queue to stop further exploration\n                  break # Exit inner loop for neighbors, as we found the shortest path\n              else:\n                  queue.append((next_pos, new_path_actions))\n      \n      if best_path_actions: # If a path was found and assigned in the current outer loop iteration, stop BFS\n          break\n  \n  # 4. If a path was found, append the USE action if the primitive is grabbable\n  if best_path_actions: # Check if best_path_actions is not empty (i.e., a path was found)\n      if primitive_idx in env.world.grabbable_indices:\n          best_path_actions.append(USE_ACTION)\n      return best_path_actions\n  else:\n      return [] # No path found to any adjacent traversable cell (or primitive)", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:35:49.158683", "function_name": "collect", "function_body": "  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos  # (r, c) tuple\n\n  # Get grid dimensions\n  # Assuming grid shape is (WIDTH, HEIGHT, n_kinds)\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Get the integer ID for the target primitive\n  try:\n      # Convert primitive name to uppercase for consistency with cookbook index\n      primitive_id = env.world.cookbook.index.index(primitive.upper())\n  except KeyError:\n      # Primitive name not found in the cookbook, cannot collect it.\n      return []\n\n  # Get action mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Determine if the primitive is a grabbable item (requires a 'USE' action after reaching)\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # Helper function to check if coordinates are within grid bounds\n  def is_valid_coord(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  # Check if the primitive is already at or next to the agent's current position\n  # If yes, and it's grabbable, just return USE. Otherwise, no actions needed.\n  # This directly uses CraftState's `next_to` check for convenience and accuracy.\n  if current_state.next_to(primitive_id):\n      if is_grabbable:\n          return [USE]\n      else:\n          # If it's a non-grabbable primitive (e.g., workshop), and we are next to it,\n          # then \"collecting\" it means we are already there. No actions needed.\n          return []\n\n  # BFS setup for pathfinding\n  q = collections.deque()\n  # Queue stores tuples of ((r, c), list_of_actions_to_reach_here)\n  q.append((current_pos, []))\n\n  # Set to keep track of visited grid cells to avoid cycles and redundant checks\n  visited = {current_pos}\n\n  # Define possible movements and their corresponding actions\n  # (dr, dc): (delta_row, delta_column) mapping to action ID\n  moves_deltas = {\n      (-1, 0): UP,    # Move North (row decreases)\n      (1, 0): DOWN,   # Move South (row increases)\n      (0, -1): LEFT,  # Move West (column decreases)\n      (0, 1): RIGHT,  # Move East (column increases)\n  }\n\n  while q:\n      (r, c), path = q.popleft()\n\n      # Explore possible next moves\n      for (dr, dc), action in moves_deltas.items():\n          nr, nc = r + dr, c + dc # Calculate new coordinates\n\n          # Check if the new coordinates are valid and haven't been visited yet\n          if is_valid_coord(nr, nc) and (nr, nc) not in visited:\n              # Add the new cell to visited\n              visited.add((nr, nc))\n\n              # Check if the primitive is located at the new cell (nr, nc)\n              # grid[nr, nc, primitive_id] > 0 means there's at least one instance of it there\n              if grid[nr, nc, primitive_id] > 0:\n                  # Found the primitive! Construct the full path.\n                  actions_to_take = path + [action]\n                  if is_grabbable:\n                      # If it's a grabbable item (e.g., wood, stone), a 'USE' action is needed\n                      # after moving to its location.\n                      actions_to_take.append(USE)\n                  return actions_to_take # Return the first (shortest) path found\n\n              # If the primitive is not directly at (nr, nc), but (nr, nc) is a valid, unvisited cell,\n              # add it to the queue to continue searching from there.\n              q.append(((nr, nc), path + [action]))\n\n  # If the queue is exhausted and no path to the primitive was found\n  return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:35:51.192211", "function_name": "collect", "function_body": "  # 1. Get primitive ID\n  primitive_id = env.world.cookbook.index[primitive]\n\n  # 2. Get current state and grid information\n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  height, width, _ = grid.shape\n\n  # 3. Get action mappings\n  action_map = env.action_specs()\n  \n  # Map movement actions to their (dr, dc) deltas (row, column changes)\n  move_actions_with_deltas = {\n      action_map['UP']: (-1, 0),\n      action_map['DOWN']: (1, 0),\n      action_map['LEFT']: (0, -1),\n      action_map['RIGHT']: (0, 1)\n  }\n  \n  # 4. Precompute `collectable_cells`\n  # A cell (r, c) is considered \"collectable\" if being at (r, c) allows the agent to\n  # collect the `primitive` using the 'USE' action. This is true if any cell\n  # within the 3x3 neighborhood (including itself) contains the primitive.\n  collectable_cells = set()\n  for r in range(height):\n      for c in range(width):\n          is_collectable_here = False\n          # Check the 3x3 neighborhood around (r, c)\n          for dr in [-1, 0, 1]:\n              for dc in [-1, 0, 1]:\n                  check_r, check_c = r + dr, c + dc\n                  # Ensure the checked cell is within grid boundaries\n                  if 0 <= check_r < height and 0 <= check_c < width:\n                      # Check if the primitive is present at (check_r, check_c)\n                      if grid[check_r, check_c, primitive_id] > 0:\n                          collectable_cells.add((r, c))\n                          is_collectable_here = True\n                          break # Found primitive in neighborhood, no need to check more dr, dc for this (r,c)\n              if is_collectable_here:\n                  break # Break outer dr loop if (r, c) is already marked collectable\n  \n  # If no primitive is found anywhere on the map, it's unreachable.\n  if not collectable_cells:\n      return []\n\n  # 5. BFS Initialization\n  # The queue stores tuples of (current_position, path_to_current_position).\n  # `path_to_current_position` is a list of actions (integers) to reach `current_position`.\n  queue = collections.deque([(start_pos, [])])\n  # The visited set stores positions already added to the queue to avoid redundant work and cycles.\n  visited = {start_pos}\n\n  # 6. BFS Loop to find the shortest path to a collectable cell\n  while queue:\n      curr_pos, path_so_far = queue.popleft()\n      curr_r, curr_c = curr_pos\n\n      # Check if the current position is one of the target collectable cells\n      if curr_pos in collectable_cells:\n          # If so, we found the shortest path. Append the 'USE' action to collect the primitive.\n          return path_so_far + [action_map['USE']]\n\n      # Explore neighboring cells by trying all possible movement actions\n      for action, (dr, dc) in move_actions_with_deltas.items():\n          next_r, next_c = curr_r + dr, curr_c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries and has not been visited yet\n          if 0 <= next_r < height and 0 <= next_c < width and next_pos not in visited:\n              # Assuming all in-bounds cells are traversable for pathfinding purposes.\n              # The game environment's `step` method will handle actual movement rules (e.g., impassable terrain).\n              visited.add(next_pos)\n              queue.append((next_pos, path_so_far + [action]))\n\n  # 7. If the queue becomes empty and no path to a collectable cell was found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:37:10.877404", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  MOVE_UP = action_map['UP']\n  MOVE_DOWN = action_map['DOWN']\n  MOVE_LEFT = action_map['LEFT']\n  MOVE_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n\n  primitive_idx = cookbook.index.index(primitive)\n\n  # Improvement for collect_v2:\n  # First, check if the primitive can be collected from the current agent position.\n  # The `CraftState.next_to()` method checks if the item is present in the 3x3 neighborhood\n  # around the agent's current position (including the agent's cell itself).\n  # If it is, no movement is needed, just perform the USE action.\n  if current_state.next_to(primitive_idx):\n      return [USE_ACTION]\n\n  start_pos = current_state.pos\n  grid = current_state.grid\n  width, height, n_kinds = grid.shape\n\n  # Define unwalkable entities by their indices.\n  # These are entities the agent cannot move into.\n  unwalkable_entities_indices = set()\n  unwalkable_entities_indices.add(world.water_index)\n  unwalkable_entities_indices.add(world.stone_index)\n  # Add other non-grabbable items, excluding workshops which are often enterable.\n  for k_idx in world.non_grabbable_indices:\n      if k_idx not in world.workshop_indices:\n          unwalkable_entities_indices.add(k_idx)\n\n  # BFS setup to find the shortest path to a cell from which the primitive can be used.\n  queue = collections.deque([(start_pos[0], start_pos[1])])\n  # parent maps (x, y) -> ((parent_x, parent_y), action_to_reach_x_y_from_parent)\n  parent = {start_pos: (None, None)}\n  visited = {start_pos}\n\n  final_path_actions = []\n  # Flag to indicate if a suitable \"use spot\" cell has been found\n  found_use_spot_cell = False \n\n  # Define possible movements (dx, dy, action_id)\n  move_options = [\n      (0, -1, MOVE_UP),    # Move Up\n      (0, 1, MOVE_DOWN),   # Move Down\n      (-1, 0, MOVE_LEFT),  # Move Left\n      (1, 0, MOVE_RIGHT)   # Move Right\n  ]\n\n  while queue:\n    cx, cy = queue.popleft() # Current cell coordinates (the cell the agent moves into)\n\n    # Check if this current cell (cx, cy) is a valid \"use spot\".\n    # A valid \"use spot\" is any cell from which the primitive is in the 3x3 neighborhood.\n    # This check is equivalent to what `CraftState.next_to()` would do if the agent were at (cx, cy).\n    is_use_spot = False\n    for dx_nb in [-1, 0, 1]:\n        for dy_nb in [-1, 0, 1]:\n            nx_nb, ny_nb = cx + dx_nb, cy + dy_nb\n            # Ensure neighborhood cell is within grid bounds\n            if 0 <= nx_nb < width and 0 <= ny_nb < height:\n                # Check if the target primitive is at this neighborhood cell\n                if grid[nx_nb, ny_nb, primitive_idx] == 1:\n                    is_use_spot = True\n                    break # Primitive found in neighborhood\n        if is_use_spot:\n            break # Break from outer neighborhood loop too\n    \n    if is_use_spot:\n        found_use_spot_cell = True\n        \n        # Reconstruct the path from start_pos to (cx, cy)\n        current_node = (cx, cy)\n        path_segment = []\n        while current_node != start_pos:\n            prev_node, action = parent[current_node]\n            path_segment.append(action)\n            current_node = prev_node\n        \n        final_path_actions = path_segment[::-1] # Reverse to get actions in correct order\n        break # Exit the main BFS loop as the target use spot has been found\n\n    # If (cx,cy) is not yet a use spot, explore its walkable neighbors for further movement\n    for dx_move, dy_move, action_id in move_options:\n        nx, ny = cx + dx_move, cy + dy_move # (nx, ny) is the cell to potentially move into\n        \n        # Check if the new position is within bounds and has not been visited yet\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n            is_walkable = True\n            # Check if the target cell (nx, ny) contains any unwalkable entity\n            for k_idx in range(n_kinds):\n                if grid[nx, ny, k_idx] == 1 and k_idx in unwalkable_entities_indices:\n                    is_walkable = False\n                    break # This cell is unwalkable, cannot move here\n            \n            if is_walkable:\n                visited.add((nx, ny))\n                parent[(nx, ny)] = ((cx, cy), action_id) # Store how we got to (nx, ny)\n                queue.append((nx, ny))\n\n  if found_use_spot_cell:\n    # If a path was found to a valid use spot, append the USE action at the end\n    final_path_actions.append(USE_ACTION)\n    return final_path_actions\n  else:\n    # If no path to any collectable primitive was found\n    return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:37:13.016689", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  MOVE_UP = action_map['UP']\n  MOVE_DOWN = action_map['DOWN']\n  MOVE_LEFT = action_map['LEFT']\n  MOVE_RIGHT = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n\n  # Get the integer index for the target primitive\n  primitive_idx = cookbook.index.index(primitive)\n\n  start_pos = current_state.pos\n  grid = current_state.grid\n  width, height, n_kinds = grid.shape\n\n  # Define unwalkable entities by their indices.\n  # These are entities the agent cannot move onto.\n  unwalkable_entities_indices = set()\n  \n  # Add universally unwalkable terrain types like water and stone.\n  unwalkable_entities_indices.add(world.water_index)\n  unwalkable_entities_indices.add(world.stone_index)\n  \n  # Add other non-grabbable items that are not workshops.\n  # Workshops are typically non-grabbable but are traversable/enterable.\n  for k_idx in world.non_grabbable_indices:\n      if k_idx not in world.workshop_indices:\n          unwalkable_entities_indices.add(k_idx)\n  \n  # BFS setup\n  # queue stores (x, y) coordinates of cells to visit\n  queue = collections.deque([(start_pos[0], start_pos[1])])\n  # parent maps (x, y) -> ((parent_x, parent_y), action_to_reach_x_y_from_parent)\n  parent = {start_pos: (None, None)}\n  # visited set tracks cells already processed to prevent cycles and redundant work\n  visited = {start_pos}\n\n  final_path_actions = []\n  found_primitive_adj = False # Flag to indicate if a path to an adjacent primitive was found\n\n  # Define possible movements (dx, dy, action_id) for pathfinding\n  # These are relative changes in coordinates and the corresponding action ID.\n  move_options = [\n      (0, -1, MOVE_UP),    # Move Up (decreases y-coordinate)\n      (0, 1, MOVE_DOWN),   # Move Down (increases y-coordinate)\n      (-1, 0, MOVE_LEFT),  # Move Left (decreases x-coordinate)\n      (1, 0, MOVE_RIGHT)   # Move Right (increases x-coordinate)\n  ]\n\n  # Main BFS loop\n  while queue:\n    cx, cy = queue.popleft() # Current cell coordinates being examined\n\n    # Check if this current cell (cx, cy) is a valid position from which to USE the primitive.\n    # This means checking the 3x3 neighborhood around (cx, cy) for the primitive.\n    # This aligns with the `CraftState.next_to` function's behavior, where the agent\n    # can interact with items in its 3x3 vicinity.\n    for dx_adj in [-1, 0, 1]:\n        for dy_adj in [-1, 0, 1]:\n            px, py = cx + dx_adj, cy + dy_adj # (px, py) is a cell in the 3x3 neighborhood of (cx, cy)\n\n            # Ensure (px, py) is within grid bounds\n            if 0 <= px < width and 0 <= py < height:\n                # If the target primitive is found at (px, py)\n                if grid[px, py, primitive_idx] == 1:\n                    found_primitive_adj = True\n                    \n                    # Reconstruct the path from the start_pos to the current cell (cx, cy)\n                    current_node = (cx, cy)\n                    path_segment = []\n                    while current_node != start_pos:\n                        prev_node, action = parent[current_node]\n                        path_segment.append(action)\n                        current_node = prev_node\n                    \n                    final_path_actions = path_segment[::-1] # Reverse the path to get actions in correct order\n                    break # Primitive found, exit dy_adj loop\n        if found_primitive_adj:\n            break # Primitive found, exit dx_adj loop\n    \n    if found_primitive_adj:\n        break # Path to an adjacent primitive found, exit main BFS loop\n\n    # If the primitive was not found in the 3x3 neighborhood of (cx, cy),\n    # then explore walkable neighbors to continue the search.\n    for dx_move, dy_move, action_id in move_options:\n        nx, ny = cx + dx_move, cy + dy_move # (nx, ny) is a potential next cell to move into\n        \n        # Check if the next position is within grid bounds and has not been visited yet\n        if 0 <= nx < width and 0 <= ny < height and (nx, ny) not in visited:\n            is_walkable = True\n            # Check if the proposed cell (nx, ny) contains any unwalkable entity\n            # Iterate through all object kinds that might be present at (nx, ny)\n            for k_idx in range(n_kinds):\n                # If a kind is present at (nx, ny) AND that kind is in our unwalkable set\n                if grid[nx, ny, k_idx] == 1 and k_idx in unwalkable_entities_indices:\n                    is_walkable = False\n                    break # This cell contains an unwalkable obstacle, so it's not a valid move target\n            \n            if is_walkable:\n                visited.add((nx, ny))\n                # Store how we reached (nx, ny): from (cx, cy) using action_id\n                parent[(nx, ny)] = ((cx, cy), action_id) \n                queue.append((nx, ny)) # Add the walkable neighbor to the queue for further exploration\n\n  # After BFS completes:\n  if found_primitive_adj:\n    # If a path was found to a cell adjacent to the primitive, append the USE action\n    final_path_actions.append(USE_ACTION)\n    return final_path_actions\n  else:\n    # If no path to any primitive (e.g., unreachable or not present on grid), return empty list\n    return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:38:20.146712", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n  def _is_adjacent_to_kind_at_pos(grid_data, agent_r, agent_c, target_kind_idx, grid_rows, grid_cols):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around (agent_r, agent_c) contains target_kind_idx.\n      This helper is used to determine if a non-grabbable primitive is \"collected\" by proximity.\n      \"\"\"\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              adj_r, adj_c = agent_r + dr_adj, agent_c + dc_adj\n              # Check if the adjacent cell is within grid boundaries\n              if (0 <= adj_r < grid_rows and 0 <= adj_c < grid_cols):\n                  # Check if the target kind is present at the adjacent cell (count > 0)\n                  if grid_data[adj_r, adj_c, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # Retrieve current environment state and world configuration\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Get the integer index for the primitive from the cookbook's index\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized in the cookbook, it cannot be collected.\n    return []\n\n  # Determine if the primitive is a 'grabbable' item (requires 'USE' action to pick up)\n  is_grabbable = primitive_idx in world.grabbable_indices\n\n  # --- IMPROVEMENT: Check if the primitive is already in the agent's inventory. ---\n  # If the agent already possesses the primitive, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n      return []\n\n  # Current agent's position, direction, and the grid layout of the world\n  start_pos_r, start_pos_c = state.pos\n  start_dir = state.dir # Agent's initial facing direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  grid = state.grid      # The current grid layout (numpy.ndarray: HEIGHT x WIDTH x n_kinds)\n  \n  grid_rows, grid_cols, _ = grid.shape # Dimensions of the grid\n\n  # Define possible movement actions and their effects on (row_change, col_change, new_direction_value)\n  # The new_direction_value corresponds to the agent's internal state.dir after the move.\n  move_actions = {\n      ACTION_UP:    (-1, 0, 0),  # Move UP: row decreases by 1, agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),   # Move DOWN: row increases by 1, agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3),  # Move LEFT: col decreases by 1, agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),   # Move RIGHT: col increases by 1, agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell for an ACTION_USE, relative to the agent's position\n  # based on its current facing direction.\n  direction_to_target_delta = {\n      0: (-1, 0),  # Agent facing UP (dir 0) targets the cell above (r-1, c)\n      1: (0, 1),   # Agent facing RIGHT (dir 1) targets the cell to the right (r, c+1)\n      2: (1, 0),   # Agent facing DOWN (dir 2) targets the cell below (r+1, c)\n      3: (0, -1),  # Agent facing LEFT (dir 3) targets the cell to the left (r, c-1)\n  }\n\n  # Define obstacles: These are non-grabbable entities that the agent cannot typically move onto.\n  # This set includes any non-grabbable entity, including the primitive itself if it's non-grabbable\n  # (e.g., \"WATER\", \"WORKSHOP0\"). The agent's goal for such items is to be adjacent, not on top of them.\n  obstacle_kinds = set(world.non_grabbable_indices)\n\n  # --- Initial check: Is the primitive collectable from the agent's starting state? ---\n  if is_grabbable:\n      # If the item is grabbable, check if the agent is already in position to 'USE' it.\n      # Calculate the cell directly in front of the agent.\n      target_dr, target_dc = direction_to_target_delta[start_dir]\n      target_r, target_c = start_pos_r + target_dr, start_pos_c + target_dc\n\n      # Check if this target cell is within grid bounds and contains the primitive.\n      if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n          grid[target_r, target_c, primitive_idx] > 0): \n          # Agent is already facing the grabbable item. Only the 'USE' action is needed.\n          return [ACTION_USE]\n  else:\n      # If the item is non-grabbable, check if the agent is already adjacent to it.\n      if _is_adjacent_to_kind_at_pos(grid, start_pos_r, start_pos_c, primitive_idx, grid_rows, grid_cols):\n          # Agent is already adjacent to the non-grabbable item. No further actions needed for collection.\n          return []\n\n  # --- Breadth-First Search (BFS) for the shortest path ---\n  q = collections.deque()\n  # Queue stores tuples: (current_row, current_col, current_direction, list_of_actions_to_reach_here)\n  q.append((start_pos_r, start_pos_c, start_dir, []))\n\n  # Visited set to prevent revisiting states and cycles.\n  # A state is defined by the agent's (row, col, direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  while q:\n    r, c, current_dir, path = q.popleft() # Dequeue the current state and path to reach it\n\n    # Explore all possible movement actions from the current state\n    for action_id, (dr_move, dc_move, new_facing_dir) in move_actions.items():\n      next_r, next_c = r + dr_move, c + dc_move\n      next_dir = new_facing_dir # Agent's direction after performing this movement action\n\n      # 1. Boundary Check: Ensure the new position is within the grid boundaries.\n      if not (0 <= next_r < grid_rows and 0 <= next_c < grid_cols):\n        continue\n\n      # 2. Obstacle Check: Determine if the new position is blocked by any obstacle.\n      is_blocked = False\n      for k_idx in obstacle_kinds:\n          # If any kind marked as an obstacle is present at the next cell, it's blocked.\n          # This correctly handles cases where the primitive itself is a non-grabbable obstacle.\n          if grid[next_r, next_c, k_idx] > 0:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue # Cannot move onto an obstacle.\n\n      # 3. Visited Check: Ensure this (position, direction) state has not been visited before.\n      if (next_r, next_c, next_dir) in visited:\n        continue\n\n      # If all checks pass, this is a valid new state.\n      new_path = path + [action_id]\n      visited.add((next_r, next_c, next_dir)) # Mark the new state as visited\n\n      # --- Check if the primitive is collectable from this new state (next_r, next_c, next_dir) ---\n      if is_grabbable:\n          # For grabbable items, the agent must be in a position to face and 'USE' the item.\n          target_dr, target_dc = direction_to_target_delta[next_dir]\n          target_r, target_c = next_r + target_dr, next_c + target_dc\n\n          # Check if the target cell is valid and contains the primitive.\n          if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n              grid[target_r, target_c, primitive_idx] > 0): \n              # Found a path to reach a position where the primitive can be used.\n              return new_path + [ACTION_USE] # Append the 'USE' action to complete collection.\n      else:\n          # For non-grabbable items, being adjacent to the primitive at the new position is sufficient.\n          if _is_adjacent_to_kind_at_pos(grid, next_r, next_c, primitive_idx, grid_rows, grid_cols):\n              # Found a path to be adjacent to the primitive.\n              return new_path # No additional 'USE' action is typically needed for non-grabbables.\n      \n      # If the goal is not yet achieved from this new state, add it to the queue for further exploration.\n      q.append((next_r, next_c, next_dir, new_path))\n\n  # If the BFS queue becomes empty and no path was found to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:38:22.273787", "function_name": "collect", "function_body": "  def _is_adjacent_to_kind_at_pos(grid_data, agent_r, agent_c, target_kind_idx, grid_rows, grid_cols):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around (agent_r, agent_c) contains target_kind_idx.\n      This helper is used to determine if a non-grabbable primitive is \"collected\" by proximity.\n      \"\"\"\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              adj_r, adj_c = agent_r + dr_adj, agent_c + dc_adj\n              # Check if the adjacent cell is within grid boundaries\n              if (0 <= adj_r < grid_rows and 0 <= adj_c < grid_cols):\n                  # Check if the target kind is present at the adjacent cell (count > 0)\n                  if grid_data[adj_r, adj_c, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # Retrieve current environment state and world configuration\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Get the integer index for the primitive from the cookbook's index\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized in the cookbook, it cannot be collected.\n    return []\n\n  # Determine if the primitive is a 'grabbable' item (requires 'USE' action to pick up)\n  is_grabbable = primitive_idx in world.grabbable_indices\n\n  # Optimization: If it's a grabbable item and already in the agent's inventory,\n  # no actions are needed as the collection goal is already satisfied.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n      return []\n\n  # Current agent's position, direction, and the grid layout of the world\n  start_pos_r, start_pos_c = state.pos\n  start_dir = state.dir # Agent's initial facing direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  grid = state.grid      # The current grid layout (numpy.ndarray: HEIGHT x WIDTH x n_kinds)\n  \n  grid_rows, grid_cols, _ = grid.shape # Dimensions of the grid\n\n  # Define possible movement actions and their effects on (row_change, col_change, new_direction_value)\n  # The new_direction_value corresponds to the agent's internal state.dir after the move.\n  move_actions = {\n      ACTION_UP:    (-1, 0, 0),  # Move UP: row decreases by 1, agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),   # Move DOWN: row increases by 1, agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3),  # Move LEFT: col decreases by 1, agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),   # Move RIGHT: col increases by 1, agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell for an ACTION_USE, relative to the agent's position\n  # based on its current facing direction.\n  direction_to_target_delta = {\n      0: (-1, 0),  # Agent facing UP (dir 0) targets the cell above (r-1, c)\n      1: (0, 1),   # Agent facing RIGHT (dir 1) targets the cell to the right (r, c+1)\n      2: (1, 0),   # Agent facing DOWN (dir 2) targets the cell below (r+1, c)\n      3: (0, -1),  # Agent facing LEFT (dir 3) targets the cell to the left (r, c-1)\n  }\n\n  # Define obstacles: These are non-grabbable entities that the agent cannot typically move onto.\n  # This set includes any non-grabbable entity, including the primitive itself if it's non-grabbable\n  # (e.g., \"WATER\", \"WORKSHOP0\"). The agent's goal for such items is to be adjacent, not on top of them.\n  obstacle_kinds = set(world.non_grabbable_indices)\n\n  # --- Initial check: Is the primitive collectable from the agent's starting state? ---\n  if is_grabbable:\n      # If the item is grabbable, check if the agent is already in position to 'USE' it.\n      # Calculate the cell directly in front of the agent.\n      target_dr, target_dc = direction_to_target_delta[start_dir]\n      target_r, target_c = start_pos_r + target_dr, start_pos_c + target_dc\n\n      # Check if this target cell is within grid bounds and contains the primitive.\n      if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n          grid[target_r, target_c, primitive_idx] > 0): \n          # Agent is already facing the grabbable item. Only the 'USE' action is needed.\n          return [ACTION_USE]\n  else:\n      # If the item is non-grabbable, check if the agent is already adjacent to it.\n      if _is_adjacent_to_kind_at_pos(grid, start_pos_r, start_pos_c, primitive_idx, grid_rows, grid_cols):\n          # Agent is already adjacent to the non-grabbable item. No further actions needed for collection.\n          return []\n\n  # --- Breadth-First Search (BFS) for the shortest path ---\n  q = collections.deque()\n  # Queue stores tuples: (current_row, current_col, current_direction, list_of_actions_to_reach_here)\n  q.append((start_pos_r, start_pos_c, start_dir, []))\n\n  # Visited set to prevent revisiting states and cycles.\n  # A state is defined by the agent's (row, col, direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  while q:\n    r, c, current_dir, path = q.popleft() # Dequeue the current state and path to reach it\n\n    # Explore all possible movement actions from the current state\n    for action_id, (dr_move, dc_move, new_facing_dir) in move_actions.items():\n      next_r, next_c = r + dr_move, c + dc_move\n      next_dir = new_facing_dir # Agent's direction after performing this movement action\n\n      # 1. Boundary Check: Ensure the new position is within the grid boundaries.\n      if not (0 <= next_r < grid_rows and 0 <= next_c < grid_cols):\n        continue\n\n      # 2. Obstacle Check: Determine if the new position is blocked by any obstacle.\n      is_blocked = False\n      for k_idx in obstacle_kinds:\n          # If any kind marked as an obstacle is present at the next cell, it's blocked.\n          # This correctly handles cases where the primitive itself is a non-grabbable obstacle.\n          if grid[next_r, next_c, k_idx] > 0:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue # Cannot move onto an obstacle.\n\n      # 3. Visited Check: Ensure this (position, direction) state has not been visited before.\n      if (next_r, next_c, next_dir) in visited:\n        continue\n\n      # If all checks pass, this is a valid new state.\n      new_path = path + [action_id]\n      visited.add((next_r, next_c, next_dir)) # Mark the new state as visited\n\n      # --- Check if the primitive is collectable from this new state (next_r, next_c, next_dir) ---\n      if is_grabbable:\n          # For grabbable items, the agent must be in a position to face and 'USE' the item.\n          target_dr, target_dc = direction_to_target_delta[next_dir]\n          target_r, target_c = next_r + target_dr, next_c + target_dc\n\n          # Check if the target cell is valid and contains the primitive.\n          if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n              grid[target_r, target_c, primitive_idx] > 0): \n              # Found a path to reach a position where the primitive can be used.\n              return new_path + [ACTION_USE] # Append the 'USE' action to complete collection.\n      else:\n          # For non-grabbable items, being adjacent to the primitive at the new position is sufficient.\n          if _is_adjacent_to_kind_at_pos(grid, next_r, next_c, primitive_idx, grid_rows, grid_cols):\n              # Found a path to be adjacent to the primitive.\n              return new_path # No additional 'USE' action is typically needed for non-grabbables.\n      \n      # If the goal is not yet achieved from this new state, add it to the queue for further exploration.\n      q.append((next_r, next_c, next_dir, new_path))\n\n  # If the BFS queue becomes empty and no path was found to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T15:39:47.519595", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # Map primitive string name to its integer index\n    # Using .index() ensures it gets an ID if not already present, though for primitives it should be\n    i_primitive = env.world.cookbook.index(primitive) \n\n    # 1. Pre-check: If primitive is already in inventory or next to agent\n    if current_state.inventory[i_primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    if current_state.next_to(i_primitive):\n        # Already adjacent, just need to use the item\n        return [env.action_specs()['USE']]\n\n    # 2. Setup BFS\n    grid = current_state.grid\n    # grid shape is (WIDTH, HEIGHT, n_kinds) according to problem description\n    grid_width, grid_height, _ = grid.shape \n\n    # Agent's current position is (col, row)\n    agent_col, agent_row = current_state.pos\n\n    # Queue stores (current_position_tuple, path_actions_so_far_list)\n    # Using (row, col) convention for internal BFS to align with typical numpy array indexing for dr, dc\n    queue = collections.deque([((agent_row, agent_col), [])])\n    \n    # Set of visited (row, col) tuples to avoid cycles and redundant checks\n    visited = {(agent_row, agent_col)} \n\n    # Define possible movements: ((delta_row, delta_col), action_id)\n    # Mapping to CraftLab actions: DOWN=0, UP=1, LEFT=2, RIGHT=3\n    # These (dr, dc) values are for (row, col) coordinates\n    move_actions = [\n        ((1, 0), env.action_specs()['DOWN']),  # Move Down: row + 1, col\n        ((-1, 0), env.action_specs()['UP']),   # Move Up: row - 1, col\n        ((0, -1), env.action_specs()['LEFT']), # Move Left: row, col - 1\n        ((0, 1), env.action_specs()['RIGHT'])  # Move Right: row, col + 1\n    ]\n\n    # Get indices of non-grabbable items that act as obstacles\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    # BFS loop to find the shortest path to a cell adjacent to the primitive\n    while queue:\n        (r, c), path_so_far = queue.popleft() # Current cell (row, col)\n\n        # Explore all four possible movements from the current cell (r, c)\n        for (dr, dc), action_id in move_actions:\n            nr, nc = r + dr, c + dc  # Calculate new (row, col) coordinates\n\n            # Boundary check: Ensure new position is within grid limits\n            # nr (new row) must be < grid_height, nc (new col) must be < grid_width\n            if not (0 <= nr < grid_height and 0 <= nc < grid_width):\n                continue\n\n            # Obstacle check: Check if the new cell (nc, nr) contains any non-grabbable item\n            # Grid is indexed as [col, row, kind] based on (WIDTH, HEIGHT) shape and (col, row) pos\n            is_obstacle = False\n            for k_idx in non_grabbable_indices:\n                if grid[nc, nr, k_idx] == 1: # Access grid using (col_idx, row_idx, kind_idx)\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # Visited check: Avoid revisiting already processed cells\n            new_pos_tuple = (nr, nc)\n            if new_pos_tuple in visited:\n                continue\n\n            visited.add(new_pos_tuple)\n            new_path_actions = path_so_far + [action_id]\n\n            # Check if the new_pos is now adjacent to the desired primitive\n            # This is equivalent to checking if `current_state.next_to(i_primitive)` would be true\n            # if the agent were at `new_pos_tuple`\n            found_primitive_adjacent = False\n            # Check the 3x3 neighborhood around (nr, nc)\n            for neighbor_r in range(max(0, nr - 1), min(grid_height, nr + 2)):\n                for neighbor_c in range(max(0, nc - 1), min(grid_width, nc + 2)):\n                    # Don't check the current cell itself, only its neighbors\n                    if (neighbor_r, neighbor_c) == (nr, nc):\n                        continue\n                    \n                    # Access grid using (col_idx, row_idx, kind_idx)\n                    if grid[neighbor_c, neighbor_r, i_primitive] == 1:\n                        found_primitive_adjacent = True\n                        break\n                if found_primitive_adjacent:\n                    break\n            \n            if found_primitive_adjacent:\n                # Path found! The agent will move to (nr, nc), then use the item\n                return new_path_actions + [env.action_specs()['USE']]\n            else:\n                # Not adjacent to the primitive yet, add to queue to continue searching\n                queue.append((new_pos_tuple, new_path_actions))\n\n    # If the BFS completes and no path to the primitive was found\n    return []", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:39:49.854464", "function_name": "collect", "function_body": "  # 1. Get current state information\n  current_state = env._current_state\n  grid = current_state.grid\n  start_x, start_y = current_state.pos\n  width, height, _ = grid.shape # We only need width and height\n\n  # 2. Get primitive index from its string name\n  # env.world.cookbook is a Cookbook instance\n  # cookbook.index(item) returns the integer ID for the item.\n  primitive_idx = env.world.cookbook.index(primitive)\n  if primitive_idx is None:\n      # This case should ideally not happen if DSL guarantees valid primitives,\n      # but it's a safety check.\n      return []\n\n  # 3. Get action mappings from the environment\n  action_specs = env.action_specs()\n  DOWN_ACTION = action_specs['DOWN']\n  UP_ACTION = action_specs['UP']\n  LEFT_ACTION = action_specs['LEFT']\n  RIGHT_ACTION = action_specs['RIGHT']\n  USE_ACTION = action_specs['USE']\n\n  # 4. Define movement actions and their corresponding (dx, dy) changes\n  # (dx, dy, action_value)\n  possible_moves = [\n      (0, 1, DOWN_ACTION),  # Move Down: (x, y+1)\n      (0, -1, UP_ACTION),   # Move Up:   (x, y-1)\n      (-1, 0, LEFT_ACTION), # Move Left: (x-1, y)\n      (1, 0, RIGHT_ACTION)  # Move Right: (x+1, y)\n  ]\n\n  # 5. Get indices of non-grabbable items to identify obstacles for pathfinding\n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # 6. BFS Setup for pathfinding\n  # queue stores (x, y) coordinates to visit\n  queue = collections.deque([(start_x, start_y)])\n  # visited set tracks already processed coordinates to avoid cycles and redundant work\n  visited = {(start_x, start_y)}\n  # parent map stores (child_x, child_y) -> (parent_x, parent_y, action_from_parent_to_child)\n  parent = {}\n  # target_found_pos will store the (x, y) coordinate where the agent should stand\n  # to be adjacent to the primitive and USE it.\n  target_found_pos = None\n\n  while queue:\n      curr_x, curr_y = queue.popleft()\n\n      # Check if the current position is adjacent to the target primitive\n      # We look for a primitive in the 4 direct neighbors of (curr_x, curr_y)\n      for dx_adj, dy_adj, _ in possible_moves: # Use _ for action as we only need dx, dy for adjacency check\n          nx_adj, ny_adj = curr_x + dx_adj, curr_y + dy_adj\n          # Ensure neighbor is within grid bounds\n          if 0 <= nx_adj < width and 0 <= ny_adj < height:\n              # If the primitive is found in an adjacent cell, then (curr_x, curr_y) is our target standing spot\n              if grid[nx_adj, ny_adj, primitive_idx] == 1:\n                  target_found_pos = (curr_x, curr_y)\n                  break # Found a valid target, exit this inner loop\n      \n      if target_found_pos:\n          break # Path found to a cell adjacent to the primitive, exit BFS\n\n      # If not yet at a target_found_pos, explore neighbors\n      for dx_move, dy_move, action_value in possible_moves:\n          next_x, next_y = curr_x + dx_move, curr_y + dy_move\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_x < width and 0 <= next_y < height):\n              continue\n\n          # Check if the next position has already been visited\n          if (next_x, next_y) in visited:\n              continue\n\n          # Check traversability: Can the agent move to (next_x, next_y)?\n          # An agent can only move to a cell if it contains no non-grabbable items.\n          # (This is based on the CraftState._is_clear logic internally)\n          is_clear = True\n          for k_idx in non_grabbable_indices:\n              if grid[next_x, next_y, k_idx] == 1:\n                  is_clear = False\n                  break\n          \n          if not is_clear:\n              continue # This cell is blocked by a non-grabbable item\n\n          # If the cell is clear and not visited, add it to the queue\n          visited.add((next_x, next_y))\n          parent[(next_x, next_y)] = (curr_x, curr_y, action_value)\n          queue.append((next_x, next_y))\n\n  # 7. Reconstruct the path if a target position was found\n  if not target_found_pos:\n      return [] # No path could be found to any cell adjacent to the primitive\n\n  path_actions = []\n  curr = target_found_pos\n  # Reconstruct path by backtracking from the target to the start position\n  while curr != (start_x, start_y):\n      if curr not in parent:\n          # This indicates an issue in path reconstruction,\n          # perhaps an unreachable target or logic error.\n          return [] \n      px, py, action = parent[curr]\n      path_actions.append(action)\n      curr = (px, py)\n\n  path_actions.reverse() # Actions were collected in reverse order, so reverse them\n\n  # Finally, add the USE action to interact with the primitive once adjacent\n  path_actions.append(USE_ACTION)\n\n  return path_actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:41:12.302505", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  world = current_state.world # This is a CraftWorld instance\n\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n\n  action_map = env.action_specs()\n\n  # Helper to check if a position is next to the target_kind_index\n  # This simulates CraftState.next_to's 3x3 neighborhood check.\n  def _is_next_to_kind(check_pos, target_kind_idx):\n      cx, cy = check_pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = cx + dx, cy + dy\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  if grid[nx, ny, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # BFS to find path to a cell from which the target primitive can be collected (used)\n  # (current_pos, path_to_current_pos)\n  q = collections.deque([(start_pos, [])]) \n  visited = {start_pos}\n\n  # Identify blocking entities. These are items on the grid we cannot step on.\n  # These are generally `non_grabbable_indices`.\n  blocking_indices = set(world.non_grabbable_indices)\n\n  # If the target primitive is something we can step on (e.g., WOOD, STONE),\n  # it should not be considered a blocking obstacle for movement.\n  if primitive in world.grabbable_indices:\n      blocking_indices.discard(primitive)\n\n  target_reached_path = None # Stores the path to the position where 'USE' can be performed\n\n  while q:\n      (cx, cy), path = q.popleft()\n\n      # Goal check: Is the current position (cx, cy) a suitable spot to 'USE' the primitive?\n      if _is_next_to_kind((cx, cy), primitive):\n          target_reached_path = path\n          break # Exit BFS\n\n      # Explore neighbors (4-directional movement: UP, DOWN, LEFT, RIGHT)\n      for dx, dy in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n          nx, ny = cx + dx, cy + dy\n\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and (nx, ny) not in visited:\n              is_blocked = False\n              # Check if the next cell (nx, ny) contains any blocking item.\n              for blocking_idx in blocking_indices:\n                  if grid[nx, ny, blocking_idx] > 0:\n                      is_blocked = True\n                      break\n              \n              if not is_blocked:\n                  visited.add((nx, ny))\n                  q.append(((nx, ny), path + [(nx, ny)]))\n\n  if target_reached_path is None:\n      return [] # No path found to the primitive\n\n  # Convert the path of positions into a list of actions\n  move_actions = []\n  current_x, current_y = start_pos\n  for next_x, next_y in target_reached_path:\n      if next_x > current_x:\n          move_actions.append(action_map['RIGHT'])\n      elif next_x < current_x:\n          move_actions.append(action_map['LEFT'])\n      elif next_y > current_y:\n          move_actions.append(action_map['DOWN'])\n      elif next_y < current_y:\n          move_actions.append(action_map['UP'])\n      current_x, current_y = next_x, next_y\n\n  # After moving to the target_reached_pos, perform the 'USE' action\n  move_actions.append(action_map['USE'])\n\n  return move_actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T15:41:14.466624", "function_name": "collect", "function_body": "  import collections\n\n  current_state = env._current_state\n  world = env.world\n  cookbook = world.cookbook\n\n  # 1. Get the integer ID of the primitive\n  primitive_id = cookbook.index.index(primitive)\n  if primitive_id is None:\n      # This primitive name is not recognized by the cookbook.\n      return []\n\n  # Check if primitive is already in inventory.\n  # If so, consider it collected and no actions are needed.\n  if current_state.inventory[primitive_id] > 0:\n      return []\n\n  # Get action mappings from the environment for clarity and robustness.\n  ACTION_MAP = env.action_specs()\n  USE = ACTION_MAP['USE']\n  # Define movement actions based on the mapping\n  UP_ACTION = ACTION_MAP['UP']\n  DOWN_ACTION = ACTION_MAP['DOWN']\n  LEFT_ACTION = ACTION_MAP['LEFT']\n  RIGHT_ACTION = ACTION_MAP['RIGHT']\n\n  # Define movement deltas for (x, y) coordinates based on action.\n  # Assuming (x, y) corresponds to (column, row).\n  # UP: decreases y\n  # DOWN: increases y\n  # LEFT: decreases x\n  # RIGHT: increases x\n  move_actions_with_deltas = [\n      (UP_ACTION, (0, -1)),\n      (DOWN_ACTION, (0, 1)),\n      (LEFT_ACTION, (-1, 0)),\n      (RIGHT_ACTION, (1, 0))\n  ]\n\n  # 2. Check if the agent is already adjacent to the primitive and can immediately USE it.\n  # CraftState.next_to checks the 3x3 neighborhood around the agent's position,\n  # including the agent's current cell.\n  if current_state.next_to(primitive_id):\n      return [USE]\n\n  # 3. Find all locations of the primitive on the grid.\n  grid = current_state.grid\n  grid_width, grid_height, _ = grid.shape\n  primitive_locations = []\n  for x in range(grid_width):\n      for y in range(grid_height):\n          if grid[x, y, primitive_id] == 1:\n              primitive_locations.append((x, y))\n\n  if not primitive_locations:\n      # The primitive is not found anywhere on the map.\n      return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  #    to a cell adjacent to any of the primitive locations.\n  start_pos = current_state.pos\n\n  # BFS queue: stores tuples of (current_position, path_taken_to_reach_this_position)\n  q = collections.deque()\n  q.append((start_pos, []))\n\n  # Visited set: stores positions already explored to avoid cycles and redundant work.\n  visited = {start_pos}\n\n  # Identify impassable entity kinds. These are cells the agent cannot move into.\n  # cookbook.environment contains entities that are part of the static environment and often non-grabbable/impassable.\n  impassable_kinds = set(cookbook.environment)\n  # Explicitly add water to impassable kinds, as it's a common movement blocker.\n  impassable_kinds.add(world.water_index)\n\n  while q:\n      curr_pos, curr_path = q.popleft()\n\n      # Check if the current position is adjacent to any primitive location.\n      # We iterate through all known primitive locations.\n      for p_loc in primitive_locations:\n          # Manhattan distance of 1 implies direct adjacency (up, down, left, or right).\n          if abs(curr_pos[0] - p_loc[0]) + abs(curr_pos[1] - p_loc[1]) == 1:\n              # Found a position from which the primitive can be 'USE'd.\n              # This path is the shortest because BFS guarantees it.\n              return curr_path + [USE]\n\n      # Explore all valid neighboring cells (up, down, left, right).\n      for action_id, delta in move_actions_with_deltas:\n          next_x, next_y = curr_pos[0] + delta[0], curr_pos[1] + delta[1]\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within grid boundaries.\n          if not (0 <= next_x < grid_width and 0 <= next_y < grid_height):\n              continue\n\n          # Check if the next position has already been visited.\n          if next_pos in visited:\n              continue\n\n          # Check if the next position is traversable (does not contain any impassable entity).\n          is_traversable = True\n          for kind_idx in impassable_kinds:\n              if grid[next_x, next_y, kind_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if is_traversable:\n              visited.add(next_pos)\n              q.append((next_pos, curr_path + [action_id]))\n\n  # If the BFS completes and no path to an adjacent primitive cell is found,\n  # it means the primitive is unreachable or not present.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
