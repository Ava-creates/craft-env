{"timestamp": "2025-07-28T11:04:25.262190", "function_name": "collect", "function_body": "    actions_to_take = []\n\n    # Get action integer mappings (e.g., {'DOWN': 0, 'UP': 1, 'LEFT': 2, 'RIGHT': 3, 'USE': 4})\n    action_map = env.action_specs()\n\n    # Get current state observations\n    current_obs = env.observations()\n    \n    # Check if the primitive is already in inventory\n    inventory = current_obs['features_dict']['inventory']\n    if inventory[primitive] > 0:\n        return [] # Already collected, no actions needed\n\n    # Get current grid state and agent position\n    grid = current_obs['features_dict']['features_global'] # Full allocentric grid\n    current_pos_np = current_obs['features_dict']['pos']   # Agent's (row, col) as numpy array\n\n    # Convert current_pos to integers\n    current_row, current_col = int(current_pos_np[0]), int(current_pos_np[1])\n\n    # Locate all instances of the primitive on the grid\n    # np.argwhere returns an array of (row, col) coordinates where the value is 1\n    primitive_coords = np.argwhere(grid[:, :, primitive] == 1)\n\n    if len(primitive_coords) == 0:\n        # Primitive not found anywhere on the grid\n        return []\n\n    # Find the closest primitive instance using Manhattan distance\n    min_distance = float('inf')\n    target_pos = None\n\n    for r, c in primitive_coords:\n        # Calculate Manhattan distance from current position to this primitive instance\n        dist = abs(r - current_row) + abs(c - current_col)\n        if dist < min_distance:\n            min_distance = dist\n            target_pos = (r, c)\n\n    # This check is a safeguard; target_pos should be found if primitive_coords is not empty\n    if target_pos is None:\n        return []\n\n    target_row, target_col = target_pos\n\n    # Generate movement actions to reach the target position\n    # This strategy moves along one axis completely, then the other.\n    # It assumes no obstacles or that obstacles do not block direct cardinal paths.\n\n    # Vertical movement (adjust rows)\n    if current_row < target_row:\n        # Target is below current position, move DOWN\n        for _ in range(target_row - current_row):\n            actions_to_take.append(action_map['DOWN'])\n    elif current_row > target_row:\n        # Target is above current position, move UP\n        for _ in range(current_row - target_row):\n            actions_to_take.append(action_map['UP'])\n\n    # Horizontal movement (adjust columns)\n    if current_col < target_col:\n        # Target is to the right of current position, move RIGHT\n        for _ in range(target_col - current_col):\n            actions_to_take.append(action_map['RIGHT'])\n    elif current_col > target_col:\n        # Target is to the left of current position, move LEFT\n        for _ in range(current_col - target_col):\n            actions_to_take.append(action_map['LEFT'])\n\n    # Add the 'USE' action to collect the primitive once at its location\n    # This assumes 'USE' is the action to pick up or interact with the primitive.\n    actions_to_take.append(action_map['USE'])\n\n    return actions_to_take", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:05:31.471837", "function_name": "collect", "function_body": "  # 1. Get the integer ID for the primitive\n  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # 2. Get current state information\n  state = env._current_state\n  start_pos = state.pos  # (row, col)\n  grid = state.grid\n  height, width, _ = grid.shape\n\n  # 3. Define action to delta mappings\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  MOVE_ACTIONS = [ACTION_DOWN, ACTION_UP, ACTION_LEFT, ACTION_RIGHT]\n  MOVE_DELTAS = {\n      ACTION_DOWN: (1, 0),  # (dr, dc) for (row, col)\n      ACTION_UP: (-1, 0),\n      ACTION_LEFT: (0, -1),\n      ACTION_RIGHT: (0, 1)\n  }\n\n  # 4. Check if the primitive is grabbable\n  is_grabbable = i_primitive in env.world.grabbable_indices\n\n  # 5. BFS for pathfinding\n  q = collections.deque([(start_pos, [])])  # Queue of (current_position, path_actions)\n  visited = {start_pos}\n\n  # Get boundary index to avoid pathing through boundaries\n  i_boundary = env.world.cookbook.index.index(\"BOUNDARY\")\n\n  while q:\n    current_pos, current_path = q.popleft()\n    current_row, current_col = current_pos\n\n    # Check if current_pos is next to the primitive\n    # This simulates CraftState.next_to(i_primitive) using the grid directly.\n    # The agent is \"next to\" an item if any cell in its 3x3 neighborhood contains the item.\n    is_next_to_primitive = False\n    for dr_offset in [-1, 0, 1]:\n      for dc_offset in [-1, 0, 1]:\n        check_r, check_c = current_row + dr_offset, current_col + dc_offset\n        \n        # Check bounds for the cell being examined (the one potentially containing the primitive)\n        if 0 <= check_r < height and 0 <= check_c < width:\n          # If the target primitive is at this nearby cell\n          if grid[check_r, check_c, i_primitive] > 0:\n            is_next_to_primitive = True\n            break\n      if is_next_to_primitive:\n        break\n\n    if is_next_to_primitive:\n      # Found a position from which the primitive is accessible\n      final_actions = list(current_path) # Make a copy to avoid modifying the path in the queue\n      if is_grabbable:\n        final_actions.append(ACTION_USE) # If grabbable, add USE action to collect\n      return final_actions\n\n    # Explore neighbors\n    for action in MOVE_ACTIONS:\n      dr, dc = MOVE_DELTAS[action]\n      next_row, next_col = current_row + dr, current_col + dc\n      next_pos = (next_row, next_col)\n\n      # Check bounds for the next potential agent position\n      if not (0 <= next_row < height and 0 <= next_col < width):\n        continue\n\n      # Check if the next position is occupied by a boundary.\n      # Boundary cells are generally unwalkable.\n      if grid[next_row, next_col, i_boundary] > 0:\n          continue # Cannot move into a boundary cell\n\n      if next_pos not in visited:\n        visited.add(next_pos)\n        q.append((next_pos, current_path + [action]))\n\n  # If no path to the primitive (or a cell adjacent to it) is found\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:05:33.426148", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the integer index for the primitive\n  primitive_idx = env.world.cookbook.index(primitive)\n  \n  # Get action mappings\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get current state details\n  current_state = env._current_state\n  grid = current_state.grid\n  start_pos = current_state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Helper function to check if a cell is adjacent to the primitive\n  # A cell (r, c) is considered a target if the primitive is located at (r, c)\n  # or in any of its 8 surrounding cells (including diagonals).\n  def is_target_cell(r, c):\n      # Check if the cell itself contains the primitive\n      if grid[r, c, primitive_idx] == 1:\n          return True\n      \n      # Check 8 neighbors (including diagonals)\n      for dr in [-1, 0, 1]:\n          for dc in [-1, 0, 1]:\n              if dr == 0 and dc == 0:\n                  continue # Skip the current cell itself\n              nr, nc = r + dr, c + dc\n              # Check bounds for neighbor\n              if 0 <= nr < WIDTH and 0 <= nc < HEIGHT:\n                  if grid[nr, nc, primitive_idx] == 1:\n                      return True\n      return False\n\n  # BFS to find the shortest path to a cell from which the primitive can be collected\n  queue = collections.deque([(start_pos, [])]) # (position_tuple, list_of_actions_to_reach_here)\n  visited = {start_pos} # Set of visited position_tuples to avoid cycles and redundant computation\n\n  path_to_target_cell = [] # Stores the actions to reach the target cell\n\n  # Define movement directions and corresponding actions\n  # (delta_row, delta_col, action_integer_value)\n  move_options = [\n      (-1, 0, UP),    # Move Up\n      (1, 0, DOWN),   # Move Down\n      (0, -1, LEFT),  # Move Left\n      (0, 1, RIGHT)   # Move Right\n  ]\n  \n  # Limit search depth to prevent excessive computation for very long or non-existent paths\n  MAX_SEARCH_STEPS = WIDTH * HEIGHT * 2 # A generous limit\n\n  while queue:\n      current_pos, current_path = queue.popleft()\n      r, c = current_pos\n\n      # If the current position is a target cell, we found the shortest path\n      if is_target_cell(r, c):\n          path_to_target_cell = current_path\n          break # Path found, exit BFS\n\n      # If the current path is too long, don't explore further from this branch\n      if len(current_path) >= MAX_SEARCH_STEPS:\n          continue\n\n      # Explore neighbors\n      for dr, dc, action_int in move_options:\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid bounds and has not been visited\n          if 0 <= next_r < WIDTH and 0 <= next_c < HEIGHT and next_pos not in visited:\n              visited.add(next_pos)\n              new_path = current_path + [action_int]\n              queue.append((next_pos, new_path))\n  \n  # If a path was found, add the USE action at the end to collect the primitive\n  if path_to_target_cell:\n      actions.extend(path_to_target_cell)\n      actions.append(USE)\n  elif current_state.next_to(primitive_idx):\n      # If no movement actions were needed because the agent is already next to the primitive,\n      # just perform the USE action.\n      actions.append(USE)\n  \n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:06:46.249152", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:06:46.275582", "function_name": "collect", "function_body": "    current_state = env._current_state\n    \n    # Get the integer ID for the primitive from the cookbook index\n    # Use a try-except block in case the primitive name is not valid\n    try:\n        i_primitive = current_state.world.cookbook.index(primitive)\n    except KeyError:\n        # If the primitive name is not recognized, it cannot be collected.\n        return []\n\n    # Get action mappings from the environment's action specifications\n    ACTION_MAP = env.action_specs()\n    UP_ACTION = ACTION_MAP['UP']\n    DOWN_ACTION = ACTION_MAP['DOWN']\n    LEFT_ACTION = ACTION_MAP['LEFT']\n    RIGHT_ACTION = ACTION_MAP['RIGHT']\n    USE_ACTION = ACTION_MAP['USE']\n\n    # BFS Queue: stores (current_position, list_of_actions_to_reach_here)\n    # Position is a tuple (row, col)\n    q = collections.deque([(current_state.pos, [])])\n    \n    # Visited set: stores positions already explored to avoid cycles and redundant work\n    visited = {current_state.pos}\n\n    while q:\n        curr_pos, actions_taken = q.popleft()\n\n        # Create a temporary CraftState instance at the current BFS position.\n        # This allows us to use CraftState's `next_to` method to check proximity to the primitive.\n        # We use the original grid and inventory for this simulation, assuming they are static for pathfinding.\n        temp_sim_state = CraftState(\n            current_state.scenario,\n            current_state.grid,\n            curr_pos,\n            current_state.dir, # Agent's facing direction; not critical for `next_to` check\n            current_state.inventory.copy() # Inventory not critical for `next_to` check\n        )\n\n        # Check if the current position is adjacent to the target primitive\n        if temp_sim_state.next_to(i_primitive):\n            # If so, we found a path. Append the USE action and return the sequence.\n            return actions_taken + [USE_ACTION]\n\n        # Explore possible movement actions (UP, DOWN, LEFT, RIGHT)\n        # These are absolute movements on the grid.\n        move_directions = [\n            (UP_ACTION, (-1, 0)),  # Move Up: row decreases\n            (DOWN_ACTION, (1, 0)), # Move Down: row increases\n            (LEFT_ACTION, (0, -1)), # Move Left: column decreases\n            (RIGHT_ACTION, (0, 1)) # Move Right: column increases\n        ]\n\n        for move_action, (dr, dc) in move_directions:\n            # Simulate the step using a new temporary state to determine the actual next position.\n            # This accounts for collisions or boundaries handled by the environment's `step` method.\n            # We don't need the reward for pathfinding.\n            _, result_state = temp_sim_state.step(move_action)\n            actual_next_pos = result_state.pos\n\n            # If the agent's position did not change after the step, it means the move was blocked\n            if actual_next_pos == curr_pos:\n                continue # Skip this blocked path\n\n            # If the actual next position has not been visited yet\n            if actual_next_pos not in visited:\n                visited.add(actual_next_pos)\n                # Add the new state (position and path) to the queue\n                q.append((actual_next_pos, actions_taken + [move_action]))\n\n    # If the BFS completes and no path to the primitive is found\n    return []", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:08:40.723007", "function_name": "collect", "function_body": "  import collections\n  import numpy as np\n\n  # Map agent's internal direction (integer ID) to (dx, dy) for the cell in front.\n  # These direction IDs correspond to the action IDs returned by env.action_specs()\n  # for movement actions (DOWN, UP, LEFT, RIGHT).\n  # If agent's dir is 0 (DOWN), then the forward cell is (pos_x, pos_y + 1).\n  # If agent's dir is 1 (UP), then the forward cell is (pos_x, pos_y - 1).\n  # If agent's dir is 2 (LEFT), then the forward cell is (pos_x - 1, pos_y).\n  # If agent's dir is 3 (RIGHT), then the forward cell is (pos_x + 1, pos_y).\n  _DIR_TO_DELTA = {\n      0: (0, 1),   # DOWN\n      1: (0, -1),  # UP\n      2: (-1, 0),  # LEFT\n      3: (1, 0)    # RIGHT\n  }\n\n  initial_craft_state = env._current_state\n  \n  # 1. Get the integer ID of the primitive from the cookbook\n  try:\n      primitive_id = initial_craft_state.world.cookbook.index[primitive]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n\n  # 2. Get action integer IDs from the environment's action_specs\n  action_specs = env.action_specs()\n  UP_ACT = action_specs['UP']\n  DOWN_ACT = action_specs['DOWN']\n  LEFT_ACT = action_specs['LEFT']\n  RIGHT_ACT = action_specs['RIGHT']\n  USE_ACT = action_specs['USE']\n  \n  movement_actions_ids = [UP_ACT, DOWN_ACT, LEFT_ACT, RIGHT_ACT]\n\n  # 3. Precompute all possible \"goal states\" for the BFS.\n  # A goal state is defined as ((agent_x, agent_y), agent_dir) from which\n  # performing a USE action would collect the primitive.\n  target_collect_states = set()\n  grid_width, grid_height, _ = initial_craft_state.grid.shape\n\n  # Iterate through every cell on the grid\n  for px in range(grid_width):\n      for py in range(grid_height):\n          # Check if the current cell (px, py) contains the target primitive\n          if initial_craft_state.grid[px, py, primitive_id] > 0:\n              # If a primitive is found at (px, py), determine all adjacent\n              # agent positions (ax, ay) and directions (agent_dir) from which\n              # the agent can face and USE this primitive.\n              for agent_dir, (dx, dy) in _DIR_TO_DELTA.items():\n                  # If the agent is at (ax, ay) and facing (dx, dy),\n                  # the primitive must be at (ax + dx, ay + dy).\n                  # Therefore, to find (ax, ay) for a primitive at (px, py):\n                  ax, ay = px - dx, py - dy \n                  \n                  # Check if this calculated agent position (ax, ay) is within grid bounds\n                  if 0 <= ax < grid_width and 0 <= ay < grid_height:\n                      # Add this ((agent_pos), agent_dir) tuple as a goal state for our BFS.\n                      target_collect_states.add(((ax, ay), agent_dir))\n  \n  if not target_collect_states:\n      # If no instances of the primitive are found on the map, or the map is empty,\n      # there's no path to collect it.\n      return []\n\n  # 4. Initialize BFS queue and visited set\n  # The queue stores (simulated_craft_state_object, list_of_actions_to_reach_this_state).\n  q = collections.deque([(initial_craft_state, [])])\n  \n  # The visited set stores ((pos_x, pos_y), dir) tuples to prevent redundant exploration\n  # and cycles in the search.\n  visited = set([(initial_craft_state.pos, initial_craft_state.dir)])\n  \n  # A safety limit to prevent excessively long searches for unachievable goals\n  max_search_states_to_explore = 5000 \n  search_count = 0\n\n  # 5. BFS loop\n  while q and search_count < max_search_states_to_explore:\n      current_sim_state, current_path = q.popleft()\n      search_count += 1\n\n      # Check if the current simulated state is one of our target_collect_states.\n      if (current_sim_state.pos, current_sim_state.dir) in target_collect_states:\n          # If yes, the agent is in a position and facing a direction from which\n          # it can USE the primitive. Append the USE action and return the path.\n          return current_path + [USE_ACT]\n\n      # Explore possible next states by trying all movement actions\n      for action_id in movement_actions_ids:\n          # Simulate the step using the CraftState's own step method.\n          # This correctly handles movement, collisions, and updates the agent's direction.\n          _, next_sim_state = current_sim_state.step(action_id)\n          \n          # Create a unique identifier for the next state (position and direction)\n          next_pos_dir_tuple = (next_sim_state.pos, next_sim_state.dir)\n          \n          # If this (pos, dir) state has not been visited before, add it to the queue\n          # for further exploration. This correctly handles cases where a move might\n          # be blocked (pos doesn't change) but direction still updates, creating a new state.\n          if next_pos_dir_tuple not in visited:\n              visited.add(next_pos_dir_tuple)\n              q.append((next_sim_state, current_path + [action_id]))\n  \n  # If the queue becomes empty or the maximum search states are explored\n  # without finding a goal, it means the primitive is unreachable.\n  return []", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:08:42.628288", "function_name": "collect", "function_body": "  actions_list = []\n  \n  # 1. Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Define possible movement deltas and their corresponding actions\n  # (dr, dc): action_id\n  move_deltas = {\n      (-1, 0): UP,    # Move North (row decreases)\n      (1, 0): DOWN,   # Move South (row increases)\n      (0, -1): LEFT,  # Move West (column decreases)\n      (0, 1): RIGHT,  # Move East (column increases)\n  }\n  \n  # 2. Get the integer ID for the target primitive\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # 3. Get the current state details from the environment\n  current_state = env._current_state\n  grid = current_state.grid  # The full global grid occupancy\n  agent_pos = current_state.pos # Agent's current (row, col) position\n\n  # 4. Find all locations of the primitive on the grid\n  # np.argwhere returns a list of (row, col) tuples where grid cell contains the primitive\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  if len(primitive_locations) == 0:\n      # Primitive not found anywhere on the map\n      return []\n\n  # 5. Find the closest target primitive location using Manhattan distance\n  target_pos = None\n  min_dist = float('inf')\n  \n  for loc_arr in primitive_locations:\n      loc = tuple(loc_arr) # Convert numpy array [r, c] to tuple (r, c) for hashing in set/dict\n      \n      # If the primitive is already at the agent's current position\n      if loc == agent_pos:\n          target_pos = loc\n          min_dist = 0\n          break\n      \n      dist = abs(loc[0] - agent_pos[0]) + abs(loc[1] - agent_pos[1])\n      if dist < min_dist:\n          min_dist = dist\n          target_pos = loc\n\n  if target_pos is None:\n      # This case should not be reached if primitive_locations was not empty,\n      # but as a safeguard.\n      return []\n\n  # 6. Use Breadth-First Search (BFS) to find the shortest path to target_pos\n  # Queue stores tuples: (row, col, list_of_actions_to_reach_this_cell)\n  queue = collections.deque()\n  queue.append((agent_pos[0], agent_pos[1], []))\n  \n  # Visited set to prevent cycles and re-exploring cells\n  visited = set()\n  visited.add(agent_pos)\n\n  path_found = False\n  final_move_actions = []\n\n  # Get grid dimensions for boundary checks\n  GRID_HEIGHT, GRID_WIDTH, _ = grid.shape\n\n  # Identify potential obstacles. 'BOUNDARY' is explicitly listed as a primitive,\n  # and typically represents an impassable area.\n  boundary_idx = env.world.cookbook.index.get('BOUNDARY')\n\n  while queue:\n      r, c, current_path = queue.popleft()\n\n      # If we reached the target position\n      if r == target_pos[0] and c == target_pos[1]:\n          final_move_actions = current_path\n          path_found = True\n          break\n\n      # Explore all four cardinal neighbors\n      for (dr, dc), action_to_take in move_deltas.items():\n          next_r, next_c = r + dr, c + dc\n          \n          # Check grid boundaries\n          if not (0 <= next_r < GRID_HEIGHT and 0 <= next_c < GRID_WIDTH):\n              continue\n\n          # Check if the next cell contains an impassable boundary (if boundary_idx exists)\n          if boundary_idx is not None and grid[next_r, next_c, boundary_idx] == 1:\n              continue # Cannot move into a boundary cell\n\n          # If the cell has not been visited, add it to the queue\n          if (next_r, next_c) not in visited:\n              visited.add((next_r, next_c))\n              new_path = current_path + [action_to_take]\n              queue.append((next_r, next_c, new_path))\n  \n  if path_found:\n      actions_list.extend(final_move_actions)\n      \n      # 7. Add the 'USE' action if the primitive is grabbable\n      # The agent is now conceptually at target_pos (where the primitive is).\n      is_grabbable = primitive_idx in env.world.grabbable_indices\n      if is_grabbable:\n          # If the primitive can be picked up, we should try to pick it up.\n          # Assuming the USE action works on the item at the agent's current location.\n          actions_list.append(USE)\n  \n  return actions_list", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:10:25.778186", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  DIR_UP = 0\n  DIR_RIGHT = 1\n  DIR_DOWN = 2\n  DIR_LEFT = 3\n\n  def get_action_for_move(current_pos, next_pos):\n    \"\"\"Calculates the action needed to move from current_pos to next_pos.\"\"\"\n    r0, c0 = current_pos\n    r1, c1 = next_pos\n    if r1 == r0 - 1 and c1 == c0: return ACTION_UP\n    if r1 == r0 + 1 and c1 == c0: return ACTION_DOWN\n    if r1 == r0 and c1 == c0 - 1: return ACTION_LEFT\n    if r1 == r0 and c1 == c0 + 1: return ACTION_RIGHT\n    return -1 # Should not happen for valid adjacent moves\n\n  def get_actions_to_turn(current_dir, target_dir):\n    \"\"\"Calculates actions (ACTION_LEFT/ACTION_RIGHT) to turn from current_dir to target_dir.\"\"\"\n    actions = []\n    # Relative turns: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT\n    # CW: UP(0)->RIGHT(1)->DOWN(2)->LEFT(3)->UP(0)\n    # CCW: UP(0)->LEFT(3)->DOWN(2)->RIGHT(1)->UP(0)\n    \n    diff = (target_dir - current_dir + 4) % 4\n    if diff == 1: # Turn Right (e.g., 0->1, 1->2, 2->3, 3->0)\n        actions.append(ACTION_RIGHT)\n    elif diff == 2: # Turn 180 degrees\n        actions.append(ACTION_RIGHT)\n        actions.append(ACTION_RIGHT)\n    elif diff == 3: # Turn Left (e.g., 0->3, 3->2, 2->1, 1->0)\n        actions.append(ACTION_LEFT)\n    return actions\n\n  def get_target_dir_from_relative_pos(agent_pos, target_pos):\n    \"\"\"Determines the required facing direction to face target_pos from agent_pos.\"\"\"\n    r_agent, c_agent = agent_pos\n    r_target, c_target = target_pos\n\n    if r_target == r_agent - 1 and c_target == c_agent: # Target is North of agent\n        return DIR_UP\n    elif r_target == r_agent + 1 and c_target == c_agent: # Target is South of agent\n        return DIR_DOWN\n    elif c_target == c_agent - 1 and r_target == r_agent: # Target is West of agent\n        return DIR_LEFT\n    elif c_target == c_agent + 1 and r_target == r_agent: # Target is East of agent\n        return DIR_RIGHT\n    return -1 # Not adjacent or same position\n\n  actions_to_take = []\n\n  # Get primitive ID (case-insensitive conversion)\n  i_primitive = env.world.cookbook.index[primitive.upper()]\n  if i_primitive is None:\n      return [] # Primitive name not found in the cookbook index\n\n  current_state = env._current_state\n  grid = current_state.grid\n  # grid.shape is (HEIGHT, WIDTH, n_kinds)\n  HEIGHT, WIDTH, _ = grid.shape \n  agent_r, agent_c = current_state.pos\n\n  # Define possible (dr, dc) moves for BFS\n  DRDC = [\n      (-1, 0), # North (row-1, col)\n      (1, 0),  # South (row+1, col)\n      (0, -1), # West (row, col-1)\n      (0, 1)   # East (row, col+1)\n  ]\n\n  # BFS to find the shortest path to a cell *adjacent* to the primitive.\n  # q: stores (current_r, current_c, path_coords_list)\n  q = collections.deque([(agent_r, agent_c, [(agent_r, agent_c)])])\n  visited = set([(agent_r, agent_c)])\n\n  best_path_to_adj_cell = None\n  best_primitive_location = None\n\n  while q:\n      curr_r, curr_c, path_coords = q.popleft()\n\n      # Check all 4 neighbors of current cell (curr_r, curr_c)\n      # to see if any contain the target primitive.\n      for dr_adj, dc_adj in DRDC:\n          nr_adj, nc_adj = curr_r + dr_adj, curr_c + dc_adj\n\n          # Check boundary conditions for the potential primitive location\n          if not (0 <= nr_adj < HEIGHT and 0 <= nc_adj < WIDTH):\n              continue\n\n          # If this neighbor contains the primitive, then (curr_r, curr_c) is an adjacent cell.\n          if grid[nr_adj, nc_adj, i_primitive] > 0:\n              # We found the shortest path to an adjacent cell because BFS guarantees it.\n              best_path_to_adj_cell = path_coords\n              best_primitive_location = (nr_adj, nc_adj)\n              q.clear() # Clear queue to stop BFS\n              break # Break from inner loop, proceed to process the found path\n      \n      # If queue was cleared (i.e., primitive found), break from outer loop as well\n      if not q and best_path_to_adj_cell is not None:\n           break\n\n      # If primitive not found yet, continue exploring neighbors\n      for dr, dc in DRDC:\n          nr, nc = curr_r + dr, curr_c + dc\n\n          # Check boundary conditions for the next agent position\n          if not (0 <= nr < HEIGHT and 0 <= nc < WIDTH):\n              continue\n\n          if (nr, nc) in visited:\n              continue\n\n          # Check if the cell is an obstacle (cannot walk on)\n          is_obstacle = False\n          for kind_idx in env.world.non_grabbable_indices:\n              if grid[nr, nc, kind_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue\n\n          visited.add((nr, nc))\n          q.append((nr, nc, path_coords + [(nr, nc)]))\n\n  if best_path_to_adj_cell is None:\n      return [] # Primitive not found or not reachable\n\n  # Convert coordinate path to actions\n  # path_coords includes the starting position, so iterate from the second element.\n  for i in range(len(best_path_to_adj_cell) - 1):\n      curr_pos = best_path_to_adj_cell[i]\n      next_pos = best_path_to_adj_cell[i+1]\n      actions_to_take.append(get_action_for_move(curr_pos, next_pos))\n\n  # After all moves, the agent is at `agent_final_pos`\n  agent_final_pos = best_path_to_adj_cell[-1]\n  \n  # Determine the direction the agent needs to face to 'use' the primitive\n  target_facing_dir = get_target_dir_from_relative_pos(agent_final_pos, best_primitive_location)\n  \n  # Calculate turn actions. Agent's direction does not change during movement actions.\n  # It only changes by explicit turn actions (LEFT/RIGHT).\n  # So, the agent's current facing direction is still `current_state.dir`.\n  if target_facing_dir != -1: # Ensure the primitive was actually adjacent to the final position\n      turns = get_actions_to_turn(current_state.dir, target_facing_dir)\n      actions_to_take.extend(turns)\n\n  # Finally, add the USE action to interact with/collect the primitive\n  actions_to_take.append(ACTION_USE)\n\n  return actions_to_take", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T11:10:27.745083", "function_name": "collect", "function_body": "  # Get action IDs dynamically from the environment\n  _action_specs = env.action_specs()\n  DOWN = _action_specs['DOWN']\n  UP = _action_specs['UP']\n  LEFT = _action_specs['LEFT']\n  RIGHT = _action_specs['RIGHT']\n  USE = _action_specs['USE']\n\n  # Map movement action IDs to (dr, dc) deltas for grid traversal\n  action_deltas = {\n      DOWN: (1, 0),  # Down: row increases\n      UP: (-1, 0),   # Up: row decreases\n      LEFT: (0, -1), # Left: col decreases\n      RIGHT: (0, 1)  # Right: col increases\n  }\n\n  def is_blocked_internal(grid, y, x, world):\n      \"\"\"\n      Checks if a cell (y, x) on the grid is blocked (unwalkable) for the agent.\n      A cell is blocked if it's out of grid bounds or contains specific non-walkable items\n      like water or stone. Workshops are considered walkable in this environment.\n      \"\"\"\n      height, width, _ = grid.shape\n      if not (0 <= y < height and 0 <= x < width):\n          return True # Out of bounds means blocked\n      \n      # Check for specific non-walkable terrain types (e.g., water, stone).\n      # CraftWorld rules typically define water and stone as impassable obstacles.\n      # Workshops (e.g., BENCH) are usually traversable, even if \"non-grabbable\".\n      if world.water_index is not None and grid[y, x, world.water_index] == 1.0:\n          return True\n      if world.stone_index is not None and grid[y, x, world.stone_index] == 1.0:\n          return True\n      \n      return False\n\n  # Get the current state of the environment from the CraftLab wrapper\n  state = env.observations()['_current_state']\n  grid = state.grid\n  world = state.world # Reference to the CraftWorld instance\n\n  # The 'primitive' argument is assumed to be the integer ID of the item to collect.\n  primitive_idx = primitive \n\n  # Step 1: Find all locations on the grid where the target primitive exists\n  primitive_locations = []\n  grid_height, grid_width, _ = grid.shape\n  for r in range(grid_height):\n      for c in range(grid_width):\n          # Check if the current cell (r, c) contains the primitive_idx\n          if grid[r, c, primitive_idx] == 1.0:\n              primitive_locations.append((r, c))\n\n  if not primitive_locations:\n      # If the primitive is not found anywhere on the grid, it cannot be collected.\n      return []\n\n  # Step 2: Identify all reachable cells that are immediately adjacent to any primitive location.\n  # The agent must reach one of these cells before executing the 'USE' action.\n  target_neighbor_cells = set()\n  for pr, pc in primitive_locations:\n      # Check the four cardinal neighbors of the primitive's location\n      for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n          nr, nc = pr + dr, pc + dc\n          # Only add the neighbor cell if it's within grid bounds and is not blocked\n          if not is_blocked_internal(grid, nr, nc, world):\n              target_neighbor_cells.add((nr, nc))\n\n  if not target_neighbor_cells:\n      # If the primitive exists but is entirely surrounded by un-walkable terrain,\n      # or if all adjacent cells are blocked, it's unreachable.\n      return []\n\n  # Step 3: Perform a Breadth-First Search (BFS) to find the shortest sequence of actions\n  # from the agent's current position to any of the identified target neighbor cells.\n  q = collections.deque([(state.pos, [])]) # Queue stores (current_position, list_of_actions_to_reach_here)\n  visited = {state.pos} # Set to keep track of visited positions to avoid redundant paths and cycles\n  path_found = None\n\n  while q:\n      (curr_y, curr_x), current_path = q.popleft()\n\n      # If the current position is one of our target neighbor cells, we've found a path.\n      # Since it's BFS, this is guaranteed to be the shortest path.\n      if (curr_y, curr_x) in target_neighbor_cells:\n          path_found = current_path\n          break \n\n      # Explore all possible movement actions from the current position\n      for action_id, (dr, dc) in action_deltas.items():\n          next_y, next_x = curr_y + dr, curr_x + dc\n          next_pos = (next_y, next_x)\n\n          # If the next position has not been visited and is not blocked, add it to the queue\n          if next_pos not in visited and not is_blocked_internal(grid, next_y, next_x, world):\n              visited.add(next_pos)\n              q.append((next_pos, current_path + [action_id]))\n\n  if path_found is None:\n      # No path could be found from the agent's current position to any adjacent cell of the primitive.\n      return []\n  else:\n      # A path was found. Append the 'USE' action to the end of the movement path\n      # to simulate collecting the primitive once adjacent.\n      return path_found + [USE]", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:11:35.768841", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:11:37.721381", "function_name": "collect", "function_body": "  action_specs = env.action_specs()\n  action_map = {\n      \"UP\": action_specs[\"UP\"],\n      \"DOWN\": action_specs[\"DOWN\"],\n      \"LEFT\": action_specs[\"LEFT\"],\n      \"RIGHT\": action_specs[\"RIGHT\"],\n      \"USE\": action_specs[\"USE\"]\n  }\n  \n  # 1. Get the integer ID of the primitive\n  try:\n      # primitive is expected to be a string (e.g., \"WOOD\", \"WORKSHOP0\")\n      primitive_idx = env.world.cookbook.index.index(primitive) \n  except KeyError:\n      # Primitive name not found in the cookbook index.\n      return []\n\n  current_state = env._current_state\n  \n  # Check if the agent is already next to the primitive\n  # This covers cases where primitive is grabbable and agent is on it or adjacent.\n  # Or non-grabbable and agent is adjacent.\n  if current_state.next_to(primitive_idx):\n      if primitive_idx in env.world.grabbable_indices:\n          # If it's a grabbable item and we are next to it, use it.\n          return [action_map[\"USE\"]]\n      else:\n          # If it's a non-grabbable item (e.g., WORKSHOP), being next to it is sufficient.\n          # No further \"collection\" action (like USE) is needed.\n          return []\n\n  # 2. If not next to it, find the shortest path using Breadth-First Search (BFS)\n  grid = current_state.grid\n  current_pos = current_state.pos\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Queue stores (position, path_actions_to_reach_position)\n  queue = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited grid cells\n\n  # Define movement deltas for (x, y) coordinates for each action\n  # (dx, dy) where x is column index (horizontal), y is row index (vertical)\n  move_deltas = {\n      action_map[\"UP\"]: (0, -1),    # Move up: decrement y\n      action_map[\"DOWN\"]: (0, 1),   # Move down: increment y\n      action_map[\"LEFT\"]: (-1, 0),  # Move left: decrement x\n      action_map[\"RIGHT\"]: (1, 0)   # Move right: increment x\n  }\n  \n  # Get indices of entities that block movement.\n  # The problem states \"collision with non-grabbable entities is prevented\" for CraftState.step.\n  # This implies cells with non-grabbable entities cannot be stepped onto.\n  non_walkable_indices = env.world.non_grabbable_indices\n\n  while queue:\n      (curr_x, curr_y), path_so_far = queue.popleft()\n\n      # Explore neighbors\n      for action_id, (dx, dy) in move_deltas.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_x < WIDTH and 0 <= next_y < HEIGHT):\n              continue\n\n          # Check if the next position has already been visited\n          if next_pos in visited:\n              continue\n            \n          # Check if the next position is blocked by a non-walkable entity\n          # A cell is blocked if it contains any non-grabbable entity.\n          is_blocked = False\n          for k_blocked in non_walkable_indices:\n              if grid[next_x, next_y, k_blocked] == 1:\n                  is_blocked = True\n                  break\n          if is_blocked:\n              # This cell is blocked (e.g., water, boundary, workshop itself), cannot move onto it.\n              continue\n            \n          visited.add(next_pos) # Mark as visited\n          new_path = path_so_far + [action_id] # Extend the path\n\n          # At this point, new_path leads to next_pos, which is a traversable cell.\n          # Now, check if this traversable cell is *next to* the primitive.\n          # This simulates the logic of CraftState.next_to(primitive_idx) for the next_pos.\n          found_primitive_in_neighborhood = False\n          for dx_nb in [-1, 0, 1]:\n              for dy_nb in [-1, 0, 1]:\n                  nb_x, nb_y = next_x + dx_nb, next_y + dy_nb\n                  # Check if neighbor position is within grid boundaries\n                  if 0 <= nb_x < WIDTH and 0 <= nb_y < HEIGHT:\n                      # Check if this neighbor cell contains the primitive\n                      if grid[nb_x, nb_y, primitive_idx] == 1:\n                          found_primitive_in_neighborhood = True\n                          break\n              if found_primitive_in_neighborhood:\n                  break\n          \n          if found_primitive_in_neighborhood:\n              # Found a path to a traversable cell that is next to the primitive!\n              final_actions = new_path\n              # If the primitive is grabbable, append a USE action after reaching the adjacent cell.\n              if primitive_idx in env.world.grabbable_indices:\n                  final_actions.append(action_map[\"USE\"])\n              return final_actions\n          \n          # If primitive not found in neighborhood of next_pos, add next_pos to the queue\n          queue.append((next_pos, new_path))\n    \n  # If BFS completes and no path to the primitive was found (e.g., unreachable or not present)\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T11:13:21.773034", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  agent_pos = current_state.pos\n  agent_dir = current_state.dir \n\n  # Get integer mappings for actions from the environment's specifications\n  ACTION_MAP = env.action_specs()\n  UP_ACTION = ACTION_MAP['UP']\n  DOWN_ACTION = ACTION_MAP['DOWN']\n  LEFT_ACTION = ACTION_MAP['LEFT']\n  RIGHT_ACTION = ACTION_MAP['RIGHT']\n  USE_ACTION = ACTION_MAP['USE']\n\n  # Grid dimensions (WIDTH and HEIGHT are typically the first two dimensions)\n  WIDTH, HEIGHT, _ = grid.shape \n\n  # Define movement deltas (row_change, col_change) for each movement action\n  # These deltas determine how the agent's position changes.\n  # The action value directly sets the new facing direction in CraftWorld.\n  move_deltas = {\n      UP_ACTION: (-1, 0),    # Moving UP decreases row, col stays same\n      DOWN_ACTION: (1, 0),   # Moving DOWN increases row, col stays same\n      LEFT_ACTION: (0, -1),  # Moving LEFT decreases col, row stays same\n      RIGHT_ACTION: (0, 1),  # Moving RIGHT increases col, row stays same\n  }\n\n  # Mapping from action value to the resulting agent direction index (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  # Based on how `CraftState.step` updates `self.dir` after a movement action.\n  action_to_resulting_dir_map = {\n      UP_ACTION: 0,      # If action is UP (1), new_dir is 0 (UP/North)\n      RIGHT_ACTION: 1,   # If action is RIGHT (2), new_dir is 1 (RIGHT/East)\n      DOWN_ACTION: 2,    # If action is DOWN (0), new_dir is 2 (DOWN/South)\n      LEFT_ACTION: 3     # If action is LEFT (3), new_dir is 3 (LEFT/West)\n  }\n\n  # Vector representation of agent's facing directions (used to determine cell \"in front\")\n  # dir_idx: (dr, dc)\n  dir_to_vec = {\n      0: (-1, 0),  # UP (North)\n      1: (0, 1),   # RIGHT (East)\n      2: (1, 0),   # DOWN (South)\n      3: (0, -1)   # LEFT (West)\n  }\n  \n  # Initialize a queue for Breadth-First Search (BFS)\n  # Each item in the queue is: (current_row, current_col, current_agent_direction_index, list_of_actions_so_far)\n  q = collections.deque()\n  q.append((agent_pos[0], agent_pos[1], agent_dir, []))\n\n  # Keep track of visited states to avoid redundant computations and cycles\n  # A state is defined by (row, col, agent_direction_index)\n  visited = set()\n  visited.add((agent_pos[0], agent_pos[1], agent_dir))\n\n  # Pre-calculate all locations where the primitive exists on the grid for fast lookup\n  all_primitive_locs = set()\n  for r_idx in range(WIDTH):\n      for c_idx in range(HEIGHT):\n          # Check if the primitive's kind index has a count > 0 at this grid cell\n          if grid[r_idx, c_idx, primitive] > 0:\n              all_primitive_locs.add((r_idx, c_idx))\n\n  # Helper function to check if a position (r, c) is within the grid bounds\n  def is_valid_pos(r, c):\n      return 0 <= r < WIDTH and 0 <= c < HEIGHT\n\n  # Start BFS traversal\n  while q:\n      r, c, d, path = q.popleft()\n\n      # Step 1: Check if the current state (agent's position and direction) allows for 'USE' action\n      # Calculate the coordinates of the cell directly in front of the agent.\n      front_dr, front_dc = dir_to_vec[d]\n      front_r, front_c = r + front_dr, c + front_dc\n\n      # If the cell in front is valid and contains the primitive, we found a solution.\n      if is_valid_pos(front_r, front_c):\n          if (front_r, front_c) in all_primitive_locs:\n              # Return the path of actions to reach this state, plus the USE action\n              return path + [USE_ACTION]\n\n      # Step 2: Explore possible next states by taking movement actions\n      # For each possible movement action (UP, DOWN, LEFT, RIGHT)\n      for action_val, (dr, dc) in move_deltas.items():\n          # Calculate the new position after taking this movement action\n          nr, nc = r + dr, c + dc\n          \n          # Determine the agent's new facing direction after this movement.\n          # The agent's direction updates to match the last movement action's direction.\n          new_dir = action_to_resulting_dir_map[action_val] \n\n          # If the new position is valid and this (position, direction) state has not been visited\n          if is_valid_pos(nr, nc):\n              if (nr, nc, new_dir) not in visited:\n                  # Mark the new state as visited\n                  visited.add((nr, nc, new_dir))\n                  # Add the new state to the queue with the extended path\n                  q.append((nr, nc, new_dir, path + [action_val]))\n  \n  # If the BFS completes and no path to collect the primitive is found (e.g., primitive is unreachable)\n  return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:13:21.803366", "function_name": "collect", "function_body": "    current_state = env._current_state\n    i_primitive = env.world.cookbook.index(primitive) # Get integer ID for the primitive\n    ACTIONS = env.action_specs() # Map action names (str) to integer IDs (int)\n\n    # Helper function to check if a position (x, y) is adjacent to the primitive\n    # This covers the 3x3 neighborhood, including the position itself.\n    def _is_adjacent_to_primitive_helper(grid, pos, i_kind):\n        curr_x, curr_y = pos\n        grid_width, grid_height, _ = grid.shape # grid is (WIDTH, HEIGHT, n_kinds)\n\n        for dx_adj in [-1, 0, 1]:\n            for dy_adj in [-1, 0, 1]:\n                check_x, check_y = curr_x + dx_adj, curr_y + dy_adj\n                # Boundary check\n                if 0 <= check_x < grid_width and 0 <= check_y < grid_height:\n                    # Check if the primitive kind exists at this adjacent cell\n                    if grid[check_x, check_y, i_kind] > 0:\n                        return True\n        return False\n\n    # 1. Check if the primitive is already next to the agent's current position\n    # The CraftState.next_to method already performs this check.\n    if current_state.next_to(i_primitive):\n        return [ACTIONS['USE']]\n\n    # 2. Perform BFS to find a path to a position from which the primitive can be 'USE'd.\n    grid = current_state.grid # The static initial grid\n    GRID_WIDTH, GRID_HEIGHT, _ = grid.shape # Dimensions of the grid\n    start_pos = current_state.pos # Agent's starting position (x, y)\n\n    # BFS queue: stores tuples of (current_position, list_of_actions_to_reach_here)\n    queue = collections.deque([(start_pos, [])])\n    # Set to keep track of visited positions to avoid cycles and redundant paths\n    visited = {start_pos}\n\n    # Define movement offsets for (dx, dy) corresponding to actions\n    # CraftWorld uses (x, y) coordinates where x is column and y is row.\n    move_offsets = {\n        ACTIONS['UP']: (0, -1),   # Y-coordinate decreases\n        ACTIONS['DOWN']: (0, 1),  # Y-coordinate increases\n        ACTIONS['LEFT']: (-1, 0), # X-coordinate decreases\n        ACTIONS['RIGHT']: (1, 0), # X-coordinate increases\n    }\n\n    # Identify obstacle kinds: these are non-grabbable items that block movement.\n    # Assumes any cell containing a non-grabbable item cannot be entered.\n    non_grabbable_indices = env.world.non_grabbable_indices\n\n    while queue:\n        current_pos, path_actions = queue.popleft() # Get current position and path\n        current_x, current_y = current_pos\n\n        # Check if the current_pos is a goal state: can we 'USE' the primitive from here?\n        # We use the helper function with the static grid and current position in the BFS.\n        if _is_adjacent_to_primitive_helper(grid, current_pos, i_primitive):\n            return path_actions + [ACTIONS['USE']]\n\n        # Explore possible moves from the current position\n        for action_int, (dx, dy) in move_offsets.items():\n            next_x, next_y = current_x + dx, current_y + dy\n            next_pos = (next_x, next_y)\n\n            # Check boundary conditions\n            if not (0 <= next_x < GRID_WIDTH and 0 <= next_y < GRID_HEIGHT):\n                continue\n\n            # Check if this position has already been visited\n            if next_pos in visited:\n                continue\n\n            # Check for obstacles: if the next cell contains any non-grabbable item, it's an obstacle.\n            is_obstacle = False\n            for kind_idx in non_grabbable_indices:\n                if grid[next_x, next_y, kind_idx] > 0: # If this kind is present in the cell\n                    is_obstacle = True\n                    break\n            if is_obstacle:\n                continue\n\n            # If the move is valid and the cell is traversable, add it to the queue\n            visited.add(next_pos) # Mark as visited\n            queue.append((next_pos, path_actions + [action_int]))\n\n    # If the queue becomes empty and no path to the primitive was found\n    return []", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:14:40.755924", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  \n  action_map = env.action_specs()\n  MOVE_ACTIONS = [\n      action_map['UP'],\n      action_map['DOWN'],\n      action_map['LEFT'],\n      action_map['RIGHT']\n  ]\n  USE_ACTION = action_map['USE']\n\n  start_state = env._current_state\n  start_pos = start_state.pos\n  \n  # Initialize a Breadth-First Search (BFS) queue.\n  # The queue will store CraftState objects to explore.\n  queue = collections.deque([start_state])\n  \n  # The 'parent_map' will store the information needed to reconstruct the path.\n  # Its keys are (x, y) tuples representing visited positions.\n  # Its values are (action_taken_to_reach_this_pos, parent_pos) tuples.\n  # This map also implicitly serves as the 'visited' set to avoid redundant computations.\n  parent_map = {start_pos: (None, None)} # Start position has no parent.\n  \n  goal_reached_pos = None # To store the (x,y) position from which the primitive can be collected.\n\n  # Perform BFS\n  while queue:\n    current_state = queue.popleft()\n    current_pos = current_state.pos\n    \n    # Check if the agent is currently next to the desired primitive.\n    if current_state.next_to(primitive_idx):\n      goal_reached_pos = current_pos\n      break # Found the target location, exit BFS.\n\n    # Explore possible next states by trying all valid movement actions.\n    for action in MOVE_ACTIONS:\n      # Simulate the action to get the new state.\n      # CraftState.step creates a new state object, which is important for BFS.\n      _, new_state = current_state.step(action) \n      new_pos = new_state.pos\n      \n      # Only add to the queue if the agent actually moved to a new position\n      # (i.e., the move was not blocked) AND this new position has not been visited yet.\n      if new_pos != current_pos and new_pos not in parent_map:\n        parent_map[new_pos] = (action, current_pos) # Store how we got to new_pos from current_pos.\n        queue.append(new_state)\n\n  # Reconstruct the path from the 'parent_map' if the goal was found.\n  if goal_reached_pos:\n    path = []\n    current_path_pos = goal_reached_pos\n    \n    # Backtrack from the goal position to the start position using the parent_map.\n    while current_path_pos != start_pos:\n      action_from_parent, parent_pos = parent_map[current_path_pos]\n      path.append(action_from_parent)\n      current_path_pos = parent_pos\n    \n    # The path is constructed in reverse order (from goal to start), so reverse it.\n    path.reverse()\n    \n    # The final action is always 'USE' once the primitive is in proximity.\n    return path + [USE_ACTION]\n  \n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T11:14:45.704360", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n  \n  action_map = env.action_specs()\n  MOVE_ACTIONS = [\n      action_map['UP'],\n      action_map['DOWN'],\n      action_map['LEFT'],\n      action_map['RIGHT']\n  ]\n  USE_ACTION = action_map['USE']\n\n  start_state = env._current_state\n  start_pos = start_state.pos\n\n  # Pre-find all locations of the primitive on the grid for heuristic calculation.\n  # This uses the initial grid because the grid content (primitive locations)\n  # doesn't change during movement actions; it only changes after a 'USE' action.\n  # np.argwhere returns (x, y) coordinates if grid is (WIDTH, HEIGHT) for CraftWorld.\n  primitive_grid_slice = start_state.grid[:, :, primitive_idx]\n  primitive_locations = np.argwhere(primitive_grid_slice > 0)\n  \n  if len(primitive_locations) == 0:\n    # If no instance of the primitive exists on the map, it cannot be collected.\n    return []\n\n  def manhattan_distance(pos1, pos2):\n    \"\"\"Calculates the Manhattan distance between two (x, y) positions.\"\"\"\n    return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  def heuristic(current_pos):\n    \"\"\"\n    Calculates an admissible heuristic (estimated minimum steps) from current_pos\n    to a position where the agent would be \"next to\" any instance of the primitive.\n    'Next to' means the target primitive is within the 3x3 neighborhood of the agent.\n    For Manhattan distance, this means reaching a cell whose Manhattan distance\n    to the primitive is 0 or 1.\n    \"\"\"\n    min_estimated_steps = float('inf')\n    for p_loc in primitive_locations:\n      dist_to_primitive = manhattan_distance(current_pos, p_loc)\n      # If dist_to_primitive is 0 (on the primitive) or 1 (cardinal neighbor),\n      # the agent is already \"next to\" it (within 3x3). So 0 more steps are needed\n      # to satisfy the 'next_to' condition for pathfinding purposes.\n      # If dist_to_primitive > 1, then (dist_to_primitive - 1) more steps are needed\n      # to reach a cell adjacent to the primitive.\n      estimated_steps = max(0, dist_to_primitive - 1)\n      min_estimated_steps = min(min_estimated_steps, estimated_steps)\n    return min_estimated_steps\n\n  # A* search data structures\n  # open_set: Priority queue storing (f_score, g_score, current_state_object, path_list)\n  # f_score is the priority key, g_score is used for tie-breaking and tracking path cost.\n  open_set = []\n  \n  # g_scores: Dictionary to store the cost of the cheapest path found so far\n  # from the start_state to a given (x, y) position.\n  # Key: (pos_x, pos_y), Value: g_score (number of steps)\n  g_scores = {start_pos: 0}\n\n  # Add the start state to the open set.\n  # f_score = g_score (0) + h_score (heuristic from start_pos)\n  # The path starts empty.\n  import heapq # Used for the priority queue\n  heapq.heappush(open_set, (heuristic(start_pos), 0, start_state, []))\n\n  while open_set:\n    # Pop the state with the lowest f_score (estimated total cost)\n    f_score, current_g_score, current_state, path_to_current = heapq.heappop(open_set)\n    current_pos = current_state.pos\n\n    # If we have already found and processed a shorter path to this position,\n    # this entry from the heap is stale; skip it.\n    if current_g_score > g_scores.get(current_pos, float('inf')):\n      continue\n\n    # Check if the current state satisfies the goal condition: agent is next to the primitive.\n    if current_state.next_to(primitive_idx):\n      # If goal achieved, append the USE action and return the complete sequence of actions.\n      return path_to_current + [USE_ACTION]\n\n    # Explore possible next states by trying all valid movement actions\n    for action in MOVE_ACTIONS:\n      # Simulate the action to get the next state.\n      # CraftState.step returns a *new* CraftState object, which is essential for BFS/A*.\n      _, neighbor_state = current_state.step(action)\n      neighbor_pos = neighbor_state.pos\n\n      # If the agent didn't move (e.g., hit a wall or invalid move), skip this action.\n      if neighbor_pos == current_pos:\n          continue\n\n      # Calculate the tentative g_score (cost from start) for the neighbor.\n      # Each movement action has a cost of 1.\n      tentative_g_score = current_g_score + 1\n\n      # If this path to the neighbor is shorter than any previously found path to it,\n      # or if this neighbor hasn't been visited yet (g_scores doesn't contain it).\n      if tentative_g_score < g_scores.get(neighbor_pos, float('inf')):\n        g_scores[neighbor_pos] = tentative_g_score # Update the g_score\n        h_score = heuristic(neighbor_pos)          # Calculate heuristic for the neighbor\n        neighbor_f_score = tentative_g_score + h_score # Calculate f_score\n        \n        # Add the neighbor state to the open set for further exploration.\n        # Store the new CraftState object and the path taken to reach it.\n        heapq.heappush(open_set, (neighbor_f_score, tentative_g_score, neighbor_state, path_to_current + [action]))\n\n  # If the open_set becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:15:46.612173", "function_name": "collect", "function_body": "  # Get the current state of the environment\n  current_state = env._current_state\n  grid = current_state.grid\n  current_pos = current_state.pos\n  WIDTH, HEIGHT, n_kinds = grid.shape\n\n  # Get the integer index for the primitive\n  i_primitive = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings from the environment\n  ACTIONS = env.action_specs()\n  ACTION_UP = ACTIONS['UP']\n  ACTION_DOWN = ACTIONS['DOWN']\n  ACTION_LEFT = ACTIONS['LEFT']\n  ACTION_RIGHT = ACTIONS['RIGHT']\n  ACTION_USE = ACTIONS['USE']\n\n  # Mapping from (dx, dy) deltas to actions\n  DIR_TO_ACTION = {\n      (0, -1): ACTION_UP,    # Moving Up (decreasing Y)\n      (0, 1): ACTION_DOWN,   # Moving Down (increasing Y)\n      (-1, 0): ACTION_LEFT,  # Moving Left (decreasing X)\n      (1, 0): ACTION_RIGHT,  # Moving Right (increasing X)\n  }\n  # Possible movements (dx, dy)\n  DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)] # Corresponds to UP, DOWN, LEFT, RIGHT\n\n  # Get boundary index for pathfinding, as boundaries are typically impassable\n  i_boundary = env.world.cookbook.index.index(\"boundary\")\n\n  # Check if the primitive is grabbable (requires a 'USE' action)\n  is_grabbable = i_primitive in env.world.grabbable_indices\n\n  # BFS (Breadth-First Search) to find the shortest path to a cell adjacent to the primitive\n  # The queue stores tuples of (current_position, list_of_actions_to_reach_current_position)\n  q = collections.deque([(current_pos, [])]) \n  visited = {current_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n  target_primitive_pos = None # Stores the (x, y) coordinates of the actual primitive found\n  path_to_adjacent_cell = []  # Stores the sequence of actions to reach a cell next to the primitive\n\n  while q:\n      curr_pos, curr_path = q.popleft()\n      cx, cy = curr_pos\n\n      # Check if any immediate neighbor of the current position contains the primitive\n      # If so, curr_pos is an \"adjacent cell\" to the primitive, and we've found our target\n      for dx, dy in DELTAS:\n          nx_prime, ny_prime = cx + dx, cy + dy\n          # Ensure neighbor is within grid bounds\n          if 0 <= nx_prime < WIDTH and 0 <= ny_prime < HEIGHT:\n              # Check if this neighbor cell contains the primitive (grid value of 1)\n              if grid[nx_prime, ny_prime, i_primitive] == 1:\n                  target_primitive_pos = (nx_prime, ny_prime) # Found the primitive itself\n                  path_to_adjacent_cell = curr_path # The path to curr_pos leads to adjacency\n                  break # Found the closest primitive, no need to explore further in this branch\n      \n      if target_primitive_pos:\n          break # Found a path to a cell adjacent to the primitive, exit BFS\n\n      # If not adjacent to the primitive yet, explore traversable neighbors\n      for dx, dy in DELTAS:\n          next_pos = (cx + dx, cy + dy)\n          nx, ny = next_pos\n\n          # Ensure next position is within grid bounds and has not been visited\n          if 0 <= nx < WIDTH and 0 <= ny < HEIGHT and next_pos not in visited:\n              # Ensure the next cell is traversable (not a boundary)\n              if grid[nx, ny, i_boundary] == 0: # Assuming 0 means not a boundary\n                  visited.add(next_pos)\n                  action_to_reach_next = DIR_TO_ACTION[(dx, dy)]\n                  q.append((next_pos, curr_path + [action_to_reach_next]))\n\n  # If no primitive was found or it's unreachable (queue exhausted)\n  if not target_primitive_pos:\n      return [] # Return an empty list of actions\n\n  # If the primitive is grabbable, append the 'USE' action after reaching the adjacent cell\n  if is_grabbable:\n      path_to_adjacent_cell.append(ACTION_USE)\n\n  return path_to_adjacent_cell", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T11:15:48.493385", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  grid_height, grid_width, n_kinds = grid.shape\n\n  # Get the integer ID for the primitive (e.g., \"WOOD\" -> \"wood\")\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n\n  # Get action mappings from the environment\n  ACTION_MAP = env.action_specs()\n\n  # Define movement deltas corresponding to action IDs\n  # This mapping needs to align with the action IDs provided by env.action_specs()\n  DELTAS = {\n      ACTION_MAP[\"UP\"]: (-1, 0),\n      ACTION_MAP[\"DOWN\"]: (1, 0),\n      ACTION_MAP[\"LEFT\"]: (0, -1),\n      ACTION_MAP[\"RIGHT\"]: (0, 1),\n  }\n  \n  # Identify non-walkable indices for BFS pathfinding\n  # Based on the environment description, 'boundary' and 'water' are common obstacles.\n  unwalkable_indices = set()\n  try:\n      unwalkable_indices.add(env.world.cookbook.index[\"boundary\"])\n  except KeyError:\n      pass # 'boundary' might not exist in all cookbooks/environments\n  try:\n      unwalkable_indices.add(env.world.cookbook.index[\"water\"])\n  except KeyError:\n      pass # 'water' might not exist in all cookbooks/environments\n\n\n  # BFS setup\n  queue = collections.deque([(initial_pos, [])]) # (current_position_tuple, list_of_actions_taken)\n  visited = {initial_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n  # Helper function to check if a position is valid (within grid bounds) and walkable\n  def is_valid_and_walkable(r, c):\n      # Check grid boundaries\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False\n      \n      # Check if the cell contains any unwalkable entity\n      for unwalkable_idx in unwalkable_indices:\n          # If the unwalkable item is present at this cell (count > 0)\n          if grid[r, c, unwalkable_idx] > 0: \n              return False\n      return True\n\n  # Helper function to check if a position is \"next_to\" the target primitive\n  # This mimics the CraftState.next_to method, checking the 3x3 neighborhood\n  def check_next_to_primitive(r, c, target_id):\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              neighbor_r, neighbor_c = r + dr_offset, c + dc_offset\n              # Ensure neighbor is within grid bounds\n              if 0 <= neighbor_r < grid_height and 0 <= neighbor_c < grid_width:\n                  # Check if the primitive is present in the neighbor cell\n                  if grid[neighbor_r, neighbor_c, target_id] > 0:\n                      return True\n      return False\n\n  # Perform BFS\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # Check if the current position is adjacent to (or on) the target primitive\n      if check_next_to_primitive(r, c, primitive_id):\n          # If so, we've found a path to get adjacent. The next action is 'USE'.\n          return path + [ACTION_MAP[\"USE\"]]\n\n      # Explore all possible movement actions from the current position\n      for action_id, (dr, dc) in DELTAS.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # If the next position is valid, walkable, and hasn't been visited yet\n          if is_valid_and_walkable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited\n              # Add to queue with the updated path\n              queue.append((next_pos, path + [action_id]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
