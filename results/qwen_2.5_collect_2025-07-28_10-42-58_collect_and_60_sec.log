_is_walkable(x, y):\n      # Check if position is within grid boundaries\n      if not (0 <= x < width and 0 <= y < height):\n          return False \n      \n      # Check if the cell is occupied by any non-grabbable item\n      for k_idx in env.world.non_grabbable_indices:\n          if grid[x, y, k_idx] == 1: # If this non-grabbable kind is present at (x,y)\n              return False # Not walkable\n      return True\n\n  # BFS state: ((x, y), facing_direction, list_of_actions_to_reach_this_state)\n  # The `facing_direction` here is the direction the agent will be facing upon arriving at (x, y)\n  # after executing the `path_actions`. This is crucial because the 'USE' action is assumed\n  # to target the cell directly in front of the agent.\n  queue = collections.deque([((current_pos[0], current_pos[1]), initial_dir, [])])\n  \n  # Visited set: Stores states as ((x, y), facing_direction) to avoid redundant exploration\n  # and ensure finding the shortest path for each unique (position, direction) state.\n  visited = set([((current_pos[0], current_pos[1]), initial_dir)])\n  \n  shortest_path_actions = []\n  found_solution = False\n\n  while queue:\n    (cx, cy), c_dir, current_actions = queue.popleft()\n\n    # 1. Check if the primitive can be collected from the current position (cx, cy)\n    # given the current facing direction (c_dir).\n    # The cell to be \"used\" is the one directly in front of the agent.\n    dx_forward, dy_forward = DIR_TO_DELTA[c_dir]\n    tx, ty = cx + dx_forward, cy + dy_forward # Target cell for USE action\n\n    # Check if the target cell (tx, ty) is within grid bounds AND contains the primitive.\n    # The target cell (tx, ty) itself does not need to be walkable by the agent.\n    if (0 <= tx < width and 0 <= ty < height and grid[tx, ty, primitive_idx] == 1):\n      # Found a state where the agent is at (cx,cy), facing c_dir, and the primitive\n      # is immediately in front. This is a valid pre-USE position and direction.\n      shortest_path_actions = current_actions + [USE_ACTION]\n      found_solution = True\n      break # Found the shortest path, so terminate BFS.\n\n    # 2. Explore movement actions from the current position (cx, cy).\n    # Moving will update the agent's position and its facing direction.\n    for move_dx, move_dy in MOVEMENT_DELTAS:\n      nx, ny = cx + move_dx, cy + move_dy # Calculate new position\n\n      # Determine the action that corresponds to this movement delta and \n      # the new direction the agent will face after performing this action.\n      move_action = DELTA_TO_ACTION[(move_dx, move_dy)]\n      n_dir = ACTION_TO_DIR[move_action] \n\n      # Check if this new state (position, direction) has not been visited before,\n      # and if the new position is walkable.\n      if ((nx, ny), n_dir) not in visited:\n          if _is_walkable(nx, ny):\n              visited.add(((nx, ny), n_dir))\n              queue.append(((nx, ny), n_dir, current_actions + [move_action]))\n\n  return shortest_path_actions", "island_id": 2, "scores": {"3": 0.0}}
