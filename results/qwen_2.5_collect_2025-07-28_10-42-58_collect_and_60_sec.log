{"timestamp": "2025-07-28T12:29:00.318821", "function_name": "collect", "function_body": "  def _is_next_to_target_kind(check_pos, grid, target_kind_idx):\n    \"\"\"\n    Checks if `check_pos` (y, x) is adjacent to or on a cell containing `target_kind_idx`.\n    This mimics the logic of CraftState.next_to, checking the 3x3 neighborhood.\n    \"\"\"\n    grid_height, grid_width, _ = grid.shape\n    cy, cx = check_pos\n    # Iterate through the 3x3 neighborhood around check_pos (including check_pos itself)\n    for dy_nb in [-1, 0, 1]:\n      for dx_nb in [-1, 0, 1]:\n        nb_y, nb_x = cy + dy_nb, cx + dx_nb\n        # Ensure neighbor coordinates are within grid boundaries\n        if 0 <= nb_y < grid_height and 0 <= nb_x < grid_width:\n          # Check if the neighbor cell contains the target primitive\n          if grid[nb_y, nb_x, target_kind_idx] == 1:\n            return True\n    return False\n\n  # 1. Get environment details and primitive ID\n  # The DSL ensures 'primitive' is a valid string (e.g., 'WOOD', 'STONE').\n  # The `cookbook.index.index` method will return a positive integer ID (>= 1).\n  primitive_idx = env.world.cookbook.index.index(primitive)\n  \n  # Get action mappings for clarity and direct use\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get current state information from the environment's internal state\n  current_state = env._current_state\n  current_pos = current_state.pos # Agent's current position (y, x) tuple\n  current_grid = current_state.grid # The full grid as a numpy array (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Determine if the primitive requires a 'USE' action after reaching proximity\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n  \n  # Identify indices of entities that block movement (non-grabbable items like water, workshops, boundaries)\n  non_walkable_indices = env.world.non_grabbable_indices\n\n  # 2. Early exit: Check if the agent is already in a position to collect the primitive\n  # (i.e., adjacent to or on the same cell as a grabbable item, or adjacent to a non-grabbable item).\n  if current_state.next_to(primitive_idx):\n    if is_grabbable:\n      # If it's a grabbable item and we are already next to it, just use it.\n      return [USE]\n    else:\n      # If it's a non-grabbable item (e.g., a workshop), being next to it is sufficient.\n      # No further 'collection' action (like USE) is needed in this context.\n      return []\n\n  # 3. BFS Setup: Find the shortest path to a cell from which the primitive can be collected.\n  # The queue stores tuples of (current_position_tuple (y, x), list_of_actions_taken_to_reach_here).\n  q = collections.deque([(current_pos, [])])\n  # The visited set keeps track of (y, x) coordinates already explored to prevent cycles\n  visited = {current_pos}\n\n  # Define possible cardinal moves: (dy, dx) -> action_id\n  moves = {\n      (-1, 0): UP,    # Move Up (decrement row index)\n      (1, 0): DOWN,   # Move Down (increment row index)\n      (0, -1): LEFT,  # Move Left (decrement column index)\n      (0, 1): RIGHT,  # Move Right (increment column index)\n  }\n\n  # 4. BFS Loop: Explore the grid to find the target\n  while q:\n    (curr_y, curr_x), path_so_far = q.popleft()\n\n    # Explore all four cardinal neighbors from the current cell\n    for (dy, dx), action in moves.items():\n      next_y, next_x = curr_y + dy, curr_x + dx\n      next_pos = (next_y, next_x)\n\n      # Check boundary conditions: ensure next_pos is within the grid\n      if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n        continue\n\n      # Check if this cell has already been visited during BFS\n      if next_pos in visited:\n        continue\n\n      # Check if the next_pos cell is blocked/impassable.\n      # Agent cannot move onto cells containing non-grabbable items.\n      is_blocked = False\n      for k_blocked in non_walkable_indices:\n        if current_grid[next_y, next_x, k_blocked] == 1:\n          is_blocked = True\n          break\n      if is_blocked:\n        continue # Cannot move to this cell, skip to next neighbor\n\n      # If we reach this point, `next_pos` is a valid, unvisited, and walkable cell.\n      # Now, check if being at `next_pos` allows the agent to collect the primitive.\n      if _is_next_to_target_kind(next_pos, current_grid, primitive_idx):\n        # A path has been found to a cell (`next_pos`) from which the primitive can be collected.\n        final_actions = path_so_far + [action] # Path to reach next_pos\n        if is_grabbable:\n          final_actions.append(USE) # If it's grabbable, append USE action to collect it\n        return final_actions # Return the shortest sequence of actions\n\n      # If `next_pos` is not a collectible position, add it to the queue for further exploration\n      visited.add(next_pos)\n      q.append((next_pos, path_so_far + [action]))\n\n  # 5. If the BFS loop completes and no path to a collectible position was found,\n  # it means the primitive is unreachable or not present on the grid.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:31:59.288978", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Action IDs to (dr, dc) for movement\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Get the integer ID for the primitive name (e.g., \"WOOD\" -> 5).\n  primitive_item_id = env.world.cookbook.index[primitive]\n\n  # Determine the actual entity ID on the grid that needs to be interacted with\n  # and the type of interaction (on-tile or adjacent).\n  # This mapping is crucial as the DSL 'primitive' might refer to an item (e.g., \"STONE\")\n  # but the actual interaction might be with a different source entity (e.g., `env.world.stone_index`).\n  target_entity_id_on_grid = None\n  interact_adjacent = False\n\n  # Explicitly handle specific primitive types based on how they are acquired in CraftWorld.\n  # 1. \"STONE\" primitive is collected from a specific `stone_index` entity, requiring adjacent interaction.\n  if primitive == \"STONE\":\n      target_entity_id_on_grid = env.world.stone_index\n      interact_adjacent = True\n  # 2. Workshop primitives (e.g., \"WORKSHOP0\") are non-grabbable entities that require moving onto their tile.\n  elif primitive_item_id in env.world.workshop_indices:\n      target_entity_id_on_grid = primitive_item_id\n      interact_adjacent = False\n  # 3. For all other primitives (e.g., \"WOOD\", \"IRON\", \"GRASS\", \"GOLD\", \"GEM\", \"ROCK\", \"BOUNDARY\", \"WATER\"),\n  #    assume they correspond directly to an entity on the grid and are collected by moving onto its tile.\n  #    Note: If 'WATER' is passed as a primitive, it falls here, but `is_blocked` will correctly prevent movement.\n  else:\n      target_entity_id_on_grid = primitive_item_id\n      interact_adjacent = False\n\n  if target_entity_id_on_grid is None:\n      # This should ideally not happen if all DSL primitives are mapped, but acts as a safeguard.\n      return []\n\n  # Find all grid positions that contain the determined target entity.\n  entity_positions_on_grid = []\n  for r in range(rows):\n      for c in range(cols):\n          if grid[r, c, target_entity_id_on_grid] > 0:\n              entity_positions_on_grid.append((r, c))\n\n  if not entity_positions_on_grid:\n      # If the target entity is not present on the map, no collection is possible.\n      return []\n\n  # Determine the set of \"target positions\" for the BFS. These are the cells the agent needs to reach\n  # to be able to perform the 'USE' action.\n  bfs_target_positions = set()\n  if interact_adjacent:\n      # If interaction requires being adjacent (e.g., for \"STONE\" from a source block),\n      # the BFS target positions are the cells neighboring the entity.\n      for er, ec in entity_positions_on_grid:\n          for dr, dc in action_deltas.values(): # Iterate over all 4 adjacent directions\n              nr, nc = er + dr, ec + dc\n              # Ensure the adjacent cell is within grid boundaries.\n              if 0 <= nr < rows and 0 <= nc < cols:\n                  bfs_target_positions.add((nr, nc))\n  else:\n      # If interaction requires being on the same tile (e.g., picking up \"WOOD\", using a \"WORKSHOP\"),\n      # the BFS target positions are the entity's own cells.\n      bfs_target_positions.update(entity_positions_on_grid)\n\n  # Helper function to determine if a given grid cell is blocked for agent movement.\n  # It leverages the `target_entity_id_on_grid` and `interact_adjacent` from the outer scope (closure).\n  def is_blocked(pos):\n      r, c = pos\n      # Cells outside the grid boundaries are blocked.\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Get all entity IDs present at the current cell.\n      cell_contents = np.where(grid[r, c, :] > 0)[0] \n      \n      # Water tiles are always impassable obstacles.\n      if env.world.water_index in cell_contents:\n           return True\n\n      # Check for other non-grabbable entities (like workshop blocks, stone sources)\n      # which may act as obstacles or specific interaction points.\n      for k_idx in cell_contents:\n          if k_idx in env.world.non_grabbable_indices:\n              # A non-grabbable entity at `pos` blocks movement if:\n              # 1. It is NOT the specific `target_entity_id_on_grid` we are trying to reach.\n              # OR\n              # 2. It IS the `target_entity_id_on_grid`, but our interaction rule requires being\n              #    adjacent (not directly on) this entity (e.g., `stone_index` for \"STONE\").\n              if k_idx != target_entity_id_on_grid or interact_adjacent:\n                  return True\n      return False\n\n  # Perform a Breadth-First Search (BFS) to find the shortest path.\n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_taken_to_reach_here)\n  visited = {start_pos} # Set to keep track of visited positions to avoid redundant paths and cycles\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of our BFS target positions, we've found the shortest path.\n      if (r, c) in bfs_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break # Exit BFS as the shortest path is found\n\n      # Explore all four cardinal neighbors (Up, Down, Left, Right).\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position hasn't been visited and is not blocked, add it to the queue.\n          if new_pos not in visited and not is_blocked(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path to a target position was found, append the 'USE' action.\n      # The 'USE' action (ID 4) interacts with the entity at the final position.\n      actions = best_path + [4]\n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:32:01.213958", "function_name": "collect", "function_body": "  import numpy as np\n  import collections\n\n  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Action IDs to (dr, dc) for movement\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  # Mapping from action ID to the (dr, dc) delta that it produces\n  # This also defines the agent's facing direction after taking the action.\n  action_id_to_facing_delta = {\n      0: (1, 0),   # DOWN\n      1: (-1, 0),  # UP\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n\n  rows, cols, _ = grid.shape\n\n  primitive_item_id = env.world.cookbook.index[primitive]\n\n  # --- Determine target entities on grid and their interaction type ---\n  # `use_on_tile = True` means agent needs to be on the same tile as the target entity (e.g., workshops).\n  # `use_on_tile = False` means agent needs to be adjacent to the target entity and facing it (e.g., resources like tree, rock).\n  \n  target_entity_ids_on_grid = set()\n  use_on_tile = False # Default: assume adjacent interaction (facing)\n\n  # Special handling for \"STONE\" primitive (can come from 'rock' or 'stone_index')\n  if primitive == \"STONE\":\n      if \"rock\" in env.world.cookbook.index.contents:\n          target_entity_ids_on_grid.add(env.world.cookbook.index[\"rock\"])\n      target_entity_ids_on_grid.add(env.world.stone_index) # This refers to the 'stone' block entity\n  # Workshop interaction: agent moves ONTO the tile\n  elif primitive_item_id in env.world.workshop_indices:\n      target_entity_ids_on_grid.add(primitive_item_id)\n      use_on_tile = True\n  # Other sources for primitives (WOOD, GRASS, IRON, GOLD, GEM)\n  else:\n      # Map primitive name to its source entity name (e.g., \"WOOD\" -> \"tree\")\n      source_name_map = {\n          \"WOOD\": \"tree\",\n          \"GRASS\": \"grass\",\n          \"IRON\": \"iron\",\n          \"GOLD\": \"rock\", # Gold and Gem typically come from rock\n          \"GEM\": \"rock\",\n          \"WATER\": \"water\", # If water can be 'collected' by using a block\n          \"BOUNDARY\": \"boundary\", # If boundary can be 'collected' by using a block\n      }\n      source_entity_name = source_name_map.get(primitive)\n      if source_entity_name and source_entity_name in env.world.cookbook.index.contents:\n          target_entity_ids_on_grid.add(env.world.cookbook.index[source_entity_name])\n      # Fallback: If no specific source mapping, assume the primitive ID itself is the entity to interact with.\n      # This covers cases like pre-placed 'PLANK' or 'STICK' that might be interactable.\n      # In CraftWorld, `_use_action` primarily uses the entity in `_fwd_pos()`.\n      if not target_entity_ids_on_grid and primitive_item_id in env.world.cookbook.kinds:\n          target_entity_ids_on_grid.add(primitive_item_id)\n          use_on_tile = False # Even if it's a direct item, assume it requires facing for USE.\n\n\n  if not target_entity_ids_on_grid:\n      return []\n\n  # Get all positions for all relevant target entities\n  entity_positions_on_grid_by_id = collections.defaultdict(list)\n  for r in range(rows):\n      for c in range(cols):\n          for ent_id in target_entity_ids_on_grid:\n              if grid[r, c, ent_id] > 0:\n                  entity_positions_on_grid_by_id[ent_id].append((r, c))\n\n  if not entity_positions_on_grid_by_id:\n      return []\n\n  water_id = env.world.water_index\n  boundary_id = env.world.cookbook.index.get(\"boundary\") # Get boundary ID if exists\n\n  # Helper function to determine if a given cell is blocked for movement\n  def is_blocked(pos, current_target_ent_ids_on_grid):\n      r, c = pos\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      cell_contents = np.where(grid[r, c, :] > 0)[0] \n      \n      if water_id in cell_contents:\n           return True\n      if boundary_id is not None and boundary_id in cell_contents:\n           return True\n\n      for k_idx in cell_contents:\n          if k_idx in env.world.non_grabbable_indices:\n              # Agent can move onto a workshop if it is one of the target entities.\n              # All other non-grabbable items (like tree, rock, stone block, non-target workshops) block movement.\n              if k_idx in env.world.workshop_indices and k_idx in current_target_ent_ids_on_grid:\n                  continue # It's a target workshop and passable, so not blocked\n              return True # All other non-grabbable items block movement\n      return False\n\n  # BFS state: (r, c, path_so_far_list)\n  # The 'visited' set only needs to track (r, c) for shortest path in terms of steps.\n  q = collections.deque([(start_pos[0], start_pos[1], [])])\n  visited = {start_pos} \n  \n  best_path = []\n  path_found = False\n\n  while q:\n      r, c, path_so_far = q.popleft()\n\n      # Check if current position (r, c) allows interaction\n      for ent_id, ent_positions in entity_positions_on_grid_by_id.items():\n          # Check if this specific target entity is a workshop (for `use_on_tile` logic)\n          is_current_target_workshop_type = (ent_id in env.world.workshop_indices)\n          \n          for er, ec in ent_positions:\n              if is_current_target_workshop_type: # For workshops (agent moves onto tile and uses)\n                  if (r, c) == (er, ec):\n                      # Agent is on the workshop tile. Facing direction for workshops is implicitly handled.\n                      path_found = True\n                      best_path = path_so_far\n                      break # Found optimal path\n              else: # For sources that require adjacent interaction and facing\n                  # Agent's current position (r,c) is where it will stand.\n                  # It needs to be adjacent to (er,ec) and facing it.\n                  target_delta_from_agent = (er - r, ec - c)\n                  \n                  if target_delta_from_agent in action_id_to_facing_delta.values(): # Check if (er,ec) is directly adjacent\n                      required_action_to_face = next(k for k, v in action_id_to_facing_delta.items() if v == target_delta_from_agent)\n                      \n                      # Case 1: Path is not empty, last action sets direction\n                      if path_so_far and path_so_far[-1] == required_action_to_face:\n                          path_found = True\n                          best_path = path_so_far\n                          break \n                      # Case 2: Path is empty (agent is at start_pos). Check initial direction.\n                      elif not path_so_far: # Agent is at start_pos, no moves yet\n                          initial_dir = current_state.dir # Get agent's actual initial direction\n                          if initial_dir == required_action_to_face:\n                              path_found = True\n                              best_path = [] # No movement actions needed\n                              break\n          if path_found:\n              break \n      if path_found:\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n          \n          if new_pos not in visited and not is_blocked(new_pos, target_entity_ids_on_grid):\n              visited.add(new_pos)\n              q.append((nr, nc, path_so_far + [action_id]))\n              \n  if path_found:\n      actions = best_path + [4] # 4 is the USE action ID\n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:32:49.307024", "function_name": "collect", "function_body": "  import collections # Required for deque for BFS\n\n  # 1. Initialize action IDs from environment's action_specs for robustness.\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  actions = [] # List to store the sequence of actions to be returned\n\n  # 2. Get the integer ID for the primitive from the cookbook's index.\n  # Ensure the primitive string is lowercase for consistent lookup with the cookbook's internal mapping.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n\n  # 3. Early exit: If the primitive is a grabbable item and already in inventory, no actions are needed.\n  if primitive_id in env.world.grabbable_indices:\n      current_obs = env.observations()\n      inventory = current_obs['features_dict']['inventory']\n      if inventory[primitive_id] > 0: # Check if count in inventory is greater than 0\n          return [] # Already collected, return an empty list of actions\n\n  # 4. Get current state information required for pathfinding.\n  current_obs = env.observations()\n  # Agent's current (x, y) position. Convert numpy array to tuple for hashability (needed for 'visited' set).\n  current_pos = tuple(current_obs['features_dict']['pos']) \n  grid = current_obs['features_dict']['features_global'] # Full grid layout for pathfinding\n\n  # Determine grid dimensions\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # Map movement differentials (dx, dy) to corresponding action IDs.\n  # This makes the BFS path reconstruction more straightforward.\n  move_deltas_to_action_id = {\n      (0, -1): ACTION_UP,    # Moving up means y-coordinate decreases\n      (0, 1): ACTION_DOWN,   # Moving down means y-coordinate increases\n      (-1, 0): ACTION_LEFT,  # Moving left means x-coordinate decreases\n      (1, 0): ACTION_RIGHT,  # Moving right means x-coordinate increases\n  }\n\n  # 5. Initialize BFS components.\n  # Queue stores tuples of (current_agent_position, path_taken_to_reach_here).\n  # Path_taken_to_reach_here is a list of (x,y) coordinates.\n  queue = collections.deque([(current_pos, [current_pos])])\n  \n  # Set to keep track of visited coordinates to prevent infinite loops and redundant exploration.\n  visited = {current_pos}\n\n  found_path_to_primitive_area = None # This will store the optimal path of agent positions\n\n  # 6. BFS Loop: Find the shortest path to a cell from which the primitive can be 'used'.\n  while queue:\n      (current_x, current_y), path_so_far = queue.popleft() # Dequeue current position and its path\n\n      # Check the 3x3 neighborhood around the current agent position (current_x, current_y).\n      # The 'USE' action operates on this neighborhood, so we need to reach a cell adjacent to the primitive.\n      primitive_reachable_from_current_pos = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n\n              # Ensure the neighbor cell is within grid boundaries.\n              if not (0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT):\n                  continue\n\n              # Check if the target primitive is present in this neighbor cell.\n              # grid[x_coord, y_coord, kind_id] gives the count/presence.\n              if grid[neighbor_x, neighbor_y, primitive_id] > 0:\n                  primitive_reachable_from_current_pos = True\n                  break # Primitive found nearby, no need to check other cells in this neighborhood\n          if primitive_reachable_from_current_pos:\n              break # Found it, exit outer offset loop to process this path\n\n      # If the primitive is found in the 3x3 neighborhood of the current agent position,\n      # then this path_so_far leads to a valid 'USE' location. This is the shortest such path due to BFS.\n      if primitive_reachable_from_current_pos:\n          found_path_to_primitive_area = path_so_far\n          break # Path found, exit the main BFS loop\n\n      # If the primitive is not yet found nearby, explore valid adjacent cells for agent movement.\n      # Consider all four cardinal directions (UP, DOWN, LEFT, RIGHT).\n      for dx, dy in move_deltas_to_action_id.keys():\n          next_agent_x, next_agent_y = current_x + dx, current_y + dy\n\n          # Check if the next agent position is within grid boundaries.\n          if not (0 <= next_agent_x < WIDTH and 0 <= next_agent_y < HEIGHT):\n              continue\n\n          # Check for impassable obstacles. The \"boundary\" kind is assumed to be impassable for movement.\n          boundary_id = env.world.cookbook.index[\"boundary\"]\n          if grid[next_agent_x, next_agent_y, boundary_id] > 0:\n               continue # This cell is blocked for movement, so skip it.\n\n          # If the next cell is traversable and has not been visited yet, add it to the queue.\n          if (next_agent_x, next_agent_y) not in visited:\n              visited.add((next_agent_x, next_agent_y))\n              queue.append(((next_agent_x, next_agent_y), path_so_far + [(next_agent_x, next_agent_y)]))\n\n  # 7. Convert the found path (sequence of coordinates) into a list of agent actions.\n  if found_path_to_primitive_area:\n      # Iterate through the path, reconstructing movement actions.\n      # We iterate up to the second-to-last element, as each action connects two points.\n      for i in range(len(found_path_to_primitive_area) - 1):\n          # Current and next agent positions in the path\n          from_x, from_y = found_path_to_primitive_area[i]\n          to_x, to_y = found_path_to_primitive_area[i+1]\n\n          # Calculate the relative movement (change in x, change in y)\n          delta_x = to_x - from_x\n          delta_y = to_y - from_y\n\n          # Append the corresponding action ID using the pre-defined map.\n          actions.append(move_deltas_to_action_id[(delta_x, delta_y)])\n\n      # After all movements are completed, the agent is in the optimal position to 'USE' the primitive.\n      actions.append(ACTION_USE)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:32:51.214071", "function_name": "collect", "function_body": "", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:33:49.049989", "function_name": "collect", "function_body": "  current_state = env._current_state\n  cookbook_index = env.world.cookbook.index\n\n  # 1. Get Primitive Index\n  primitive_idx = cookbook_index[primitive]\n  if primitive_idx is None:\n      # This primitive doesn't exist in the cookbook or is an invalid name.\n      # It cannot be collected.\n      return []\n\n  # 2. Check if the primitive is actually grabbable.\n  # If it's in the non_grabbable_indices set, it cannot be collected.\n  if primitive_idx in env.world.non_grabbable_indices:\n      # Example: You can't 'collect' WATER or a WORKSHOP via this method,\n      # as they are non-grabbable and require different interaction.\n      return []\n\n  # 3. Get Action Mappings dynamically from the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 4. Check Inventory: If the primitive is already collected, no actions are needed.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 5. Initialize BFS for pathfinding.\n  start_pos = current_state.pos # Agent's current position (y, x)\n  grid = current_state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Queue stores tuples: (current_y, current_x, list_of_actions_to_reach_here)\n  # Using collections.deque for efficient popleft operations.\n  q = collections.deque([(start_pos[0], start_pos[1], [])])\n  # Set to keep track of visited grid cells to avoid cycles and redundant paths.\n  visited = {(start_pos[0], start_pos[1])}\n\n  # Define possible movements (dy, dx) and their corresponding action IDs.\n  # Assuming (y, x) corresponds to (row, column) in a 2D grid.\n  # (dy, dx, action_id)\n  move_deltas = [\n      (-1, 0, UP_ACTION),    # Move Up (decrease y)\n      (1, 0, DOWN_ACTION),   # Move Down (increase y)\n      (0, -1, LEFT_ACTION),  # Move Left (decrease x)\n      (0, 1, RIGHT_ACTION)   # Move Right (increase x)\n  ]\n\n  # Get indices of entities that block movement. These are typically all non-grabbable items.\n  # The target primitive itself is already confirmed to be grabbable, so it won't be in this set,\n  # allowing the agent to move into its cell if necessary to reach an adjacent cell for 'USE'.\n  impassable_for_movement_indices = env.world.non_grabbable_indices\n\n  while q:\n      curr_y, curr_x, path_so_far = q.popleft()\n\n      # Check if the current position is adjacent to (or on the same cell as) the primitive.\n      # The 'USE' action typically operates on items in the 3x3 neighborhood\n      # around the agent's current position, as implied by CraftState.next_to.\n      is_adjacent_to_primitive = False\n      for dy_adj in [-1, 0, 1]:\n          for dx_adj in [-1, 0, 1]:\n              check_y, check_x = curr_y + dy_adj, curr_x + dx_adj\n              # Ensure the checked coordinates are within grid bounds.\n              if 0 <= check_y < HEIGHT and 0 <= check_x < WIDTH:\n                  # Check if the primitive exists at this neighboring location.\n                  # The grid stores 1 if the kind is present, 0 otherwise.\n                  if grid[check_y, check_x, primitive_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break # Found the primitive in the neighborhood.\n          if is_adjacent_to_primitive:\n              break\n\n      if is_adjacent_to_primitive:\n          # We have found the shortest path to a position from which\n          # the primitive can be 'used' (collected).\n          return path_so_far + [USE_ACTION]\n\n      # Explore adjacent cells for movement.\n      for dy_move, dx_move, action_to_take in move_deltas:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check if the next cell is within bounds and has not been visited yet.\n          if 0 <= next_y < HEIGHT and 0 <= next_x < WIDTH and (next_y, next_x) not in visited:\n              \n              # Check if the next cell is traversable.\n              # A cell is traversable if it does not contain any impassable kind.\n              is_traversable = True\n              for i_kind in impassable_for_movement_indices:\n                  if grid[next_y, next_x, i_kind] == 1: # If this kind is present at the cell\n                      is_traversable = False\n                      break\n              \n              if is_traversable:\n                  visited.add((next_y, next_x))\n                  q.append((next_y, next_x, path_so_far + [action_to_take]))\n\n  # If the BFS completes and no path to an adjacent primitive was found,\n  # it means the primitive is either not on the map or unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:33:50.979822", "function_name": "collect", "function_body": "  \"\"\"Returns a list of actions to find and collect the primitive passed in the function in the passed env.\n  This version includes an early exit if the primitive is already adjacent to the agent,\n  and uses a Breadth-First Search (BFS) for efficient pathfinding.\n  \"\"\"\n  current_state = env._current_state\n  cookbook_index = env.world.cookbook.index\n\n  # 1. Get Primitive Index: Map the string name to its integer ID.\n  primitive_idx = cookbook_index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not recognized or has no ID, it cannot be collected.\n      return []\n\n  # 2. Check Grabbability: If the primitive is non-grabbable (e.g., WATER, WORKSHOP),\n  # it cannot be 'collected' into inventory via a 'USE' action in this context.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return []\n\n  # 3. Get Action Mappings: Dynamically retrieve action IDs from the environment.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 4. Check Inventory: If the primitive is already in the agent's inventory,\n  # no actions are needed to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 5. Early Exit - Check if the primitive is already in the agent's 3x3 neighborhood.\n  # If so, a single USE_ACTION is sufficient from the current position.\n  # This leverages the CraftState.next_to method for initial check.\n  if current_state.next_to(primitive_idx):\n      return [USE_ACTION]\n\n  # 6. Initialize BFS for pathfinding to the primitive.\n  start_pos = current_state.pos # Agent's current position (y, x)\n  grid = current_state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # Queue stores tuples: (current_y, current_x, list_of_actions_to_reach_here)\n  q = collections.deque([(start_pos[0], start_pos[1], [])])\n  # Set to keep track of visited grid cells to avoid cycles and redundant paths.\n  visited = {(start_pos[0], start_pos[1])}\n\n  # Define possible movements (dy, dx) and their corresponding action IDs.\n  # (dy, dx, action_id) where (dy, dx) is change in (row, column).\n  move_deltas = [\n      (-1, 0, UP_ACTION),    # Move Up (decrease y)\n      (1, 0, DOWN_ACTION),   # Move Down (increase y)\n      (0, -1, LEFT_ACTION),  # Move Left (decrease x)\n      (0, 1, RIGHT_ACTION)   # Move Right (increase x)\n  ]\n\n  # Identify entity kinds that block agent movement.\n  # These are typically all non-grabbable items like water, workshops, boundaries, etc.\n  impassable_for_movement_indices = env.world.non_grabbable_indices\n\n  while q:\n      curr_y, curr_x, path_so_far = q.popleft()\n\n      # Check if the current agent position (curr_y, curr_x) allows performing\n      # the USE action to collect the primitive. This means the primitive must be\n      # in the 3x3 neighborhood of (curr_y, curr_x).\n      is_adjacent_to_primitive = False\n      for dy_adj in [-1, 0, 1]:\n          for dx_adj in [-1, 0, 1]:\n              check_y, check_x = curr_y + dy_adj, curr_x + dx_adj\n              # Ensure the checked coordinates are within grid bounds.\n              if 0 <= check_y < HEIGHT and 0 <= check_x < WIDTH:\n                  # Check if the primitive exists at this neighboring location.\n                  # The grid stores 1 if the kind is present, 0 otherwise.\n                  if grid[check_y, check_x, primitive_idx] == 1:\n                      is_adjacent_to_primitive = True\n                      break # Found the primitive in the neighborhood.\n          if is_adjacent_to_primitive:\n              break\n\n      if is_adjacent_to_primitive:\n          # We have found the shortest path to a position from which\n          # the primitive can be 'used' (collected).\n          return path_so_far + [USE_ACTION]\n\n      # Explore adjacent cells for movement.\n      for dy_move, dx_move, action_to_take in move_deltas:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check if the next cell is within bounds and has not been visited yet.\n          if 0 <= next_y < HEIGHT and 0 <= next_x < WIDTH and (next_y, next_x) not in visited:\n              \n              # Check if the next cell is traversable.\n              # A cell is traversable if it does not contain any impassable kind.\n              is_traversable = True\n              for i_kind in impassable_for_movement_indices:\n                  if grid[next_y, next_x, i_kind] == 1: # If this impassable kind is present at the cell\n                      is_traversable = False\n                      break\n              \n              if is_traversable:\n                  visited.add((next_y, next_x))\n                  q.append((next_y, next_x, path_so_far + [action_to_take]))\n\n  # If the BFS completes and no path to an adjacent primitive was found,\n  # it means the primitive is either not on the map or unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:35:02.507278", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:35:04.484780", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\"\"\"\n\n  # Helper function to get actions to turn from current_dir to target_dir\n  def _get_turn_actions(current_dir, target_dir, action_map):\n      actions = []\n      if current_dir == target_dir:\n          return actions\n      \n      # Directions are typically mapped as: 0=N (UP), 1=E (RIGHT), 2=S (DOWN), 3=W (LEFT)\n      # Calculate the shortest turn direction (clockwise or counter-clockwise)\n      # The modulo 4 ensures we stay within 0-3 range\n      diff = (target_dir - current_dir + 4) % 4 \n      if diff == 1: # 90 degrees clockwise turn\n          actions.append(action_map['RIGHT'])\n      elif diff == 2: # 180 degrees turn (two 90-degree turns in either direction)\n          actions.append(action_map['RIGHT'])\n          actions.append(action_map['RIGHT'])\n      elif diff == 3: # 90 degrees counter-clockwise turn\n          actions.append(action_map['LEFT'])\n      return actions\n\n  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # Mapping of (dr, dc) movement vector to the agent's new facing direction\n  # dr: row change, dc: col change\n  # agent_direction: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  DRDC_TO_DIR = {\n      (-1, 0): 0, # Moving UP (row decreases) means agent faces UP\n      (0, 1): 1,  # Moving RIGHT (col increases) means agent faces RIGHT\n      (1, 0): 2,  # Moving DOWN (row increases) means agent faces DOWN\n      (0, -1): 3, # Moving LEFT (col decreases) means agent faces LEFT\n  }\n\n  # Mapping of (rel_r, rel_c) from agent's position to primitive's position\n  # to the required agent facing direction to use the primitive.\n  REL_TO_DIR = {\n      (-1, 0): 0, # Primitive is one cell UP, agent must face UP\n      (0, 1): 1,  # Primitive is one cell RIGHT, agent must face RIGHT\n      (1, 0): 2,  # Primitive is one cell DOWN, agent must face DOWN\n      (0, -1): 3  # Primitive is one cell LEFT, agent must face LEFT\n  }\n\n  agent_r, agent_c = current_state.pos\n  initial_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all grid locations where the primitive exists (quantity > 0)\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If there are no instances of the primitive in the world, nothing to collect\n  if len(primitive_locations) == 0:\n      return []\n\n  # --- Initial check: Is the primitive already adjacent and usable from the current position? ---\n  # Check all four direct (cardinal) neighbors of the agent's current position\n  for (dr_adj, dc_adj) in DRDC_TO_DIR.keys():\n      adj_r, adj_c = agent_r + dr_adj, agent_c + dc_adj\n      \n      # Ensure the adjacent cell is within grid boundaries\n      if not (0 <= adj_r < grid_height and 0 <= adj_c < grid_width):\n          continue\n      \n      # Check if the adjacent cell actually contains the target primitive\n      if grid[adj_r, adj_c, primitive_idx] > 0:\n          # If it does, calculate the direction the agent needs to face to use it\n          target_face_dir = REL_TO_DIR[(dr_adj, dc_adj)]\n          \n          # Get the sequence of actions (turns) required to face the primitive\n          turn_actions = _get_turn_actions(initial_dir, target_face_dir, action_map)\n          \n          # If the agent can turn and then USE the primitive, return these actions immediately\n          return turn_actions + [action_map['USE']]\n\n  # --- BFS (Breadth-First Search) for pathfinding to a primitive ---\n  # Define the possible movement deltas and their corresponding actions\n  moves_deltas = {\n      (-1, 0): action_map['UP'],\n      (0, 1): action_map['RIGHT'],\n      (1, 0): action_map['DOWN'],\n      (0, -1): action_map['LEFT'],\n  }\n\n  # Identify entity indices that represent impassable terrain\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # The queue for BFS stores tuples: (current_position (r, c), current_direction, path_taken_so_far)\n  queue = collections.deque([((agent_r, agent_c), initial_dir, [])])\n  # The visited set stores (position (r, c), direction) to prevent revisiting the same state\n  # and finding non-optimal paths or getting stuck in cycles.\n  visited = {(agent_r, agent_c, initial_dir)}\n\n  while queue:\n      (r, c), current_path_dir, path = queue.popleft()\n\n      # Explore all possible direct moves from the current position\n      for (dr_move, dc_move), move_action in moves_deltas.items():\n          next_r, next_c = r + dr_move, c + dc_move\n          next_pos = (next_r, next_c)\n          \n          # Determine the agent's new facing direction after executing this move\n          next_agent_dir = DRDC_TO_DIR[(dr_move, dc_move)]\n\n          # Check if the next cell is within the grid boundaries\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next cell is impassable terrain\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[next_r, next_c, idx] > 0: # If the cell contains an impassable item\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Check if this specific state (position AND direction) has already been visited\n          if (next_r, next_c, next_agent_dir) in visited:\n              continue\n\n          # Construct the path to this new cell\n          new_path_to_next_cell = path + [move_action]\n          \n          # After moving to (next_r, next_c) and now facing next_agent_dir,\n          # check if any primitive instance is now directly adjacent and can be used\n          for pr, pc in primitive_locations:\n              # Check if the primitive is directly adjacent (Manhattan distance of 1)\n              if abs(next_r - pr) + abs(next_c - pc) == 1:\n                  # Calculate the relative position of the primitive from the agent's new position\n                  rel_r, rel_c = pr - next_r, pc - next_c\n                  # Determine the direction the agent needs to face from next_pos to use this specific primitive\n                  target_face_dir = REL_TO_DIR[(rel_r, rel_c)]\n                  \n                  # Calculate the turn actions needed from the agent's current direction (next_agent_dir)\n                  # to the target facing direction\n                  turn_actions = _get_turn_actions(next_agent_dir, target_face_dir, action_map)\n                  \n                  # This sequence of actions leads to collecting the primitive.\n                  # Since BFS guarantees the shortest path (in terms of moves), this is an optimal solution.\n                  return new_path_to_next_cell + turn_actions + [action_map['USE']]\n\n          # If no usable primitive was found adjacent to next_pos,\n          # add this new state to the queue for further exploration and mark it as visited.\n          visited.add((next_r, next_c, next_agent_dir))\n          queue.append(((next_r, next_c), next_agent_dir, new_path_to_next_cell))\n  \n  # If the BFS completes and no path to a usable primitive is found, return an empty list.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:35:54.285563", "function_name": "collect", "function_body": "", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:35:56.957589", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  # 0. Check if the primitive is grabbable.\n  # Only grabbable items can be collected using the USE action.\n  if primitive_idx not in env.world.grabbable_indices:\n      return []\n\n  actions_map = env.action_specs()\n  UP_ACTION = actions_map['UP']\n  DOWN_ACTION = actions_map['DOWN']\n  LEFT_ACTION = actions_map['LEFT']\n  RIGHT_ACTION = actions_map['RIGHT']\n  USE_ACTION = actions_map['USE']\n\n  state = env._current_state\n  current_pos = state.pos\n  grid = state.grid\n  width, height, _ = grid.shape\n  \n  non_grabbable_indices = env.world.non_grabbable_indices\n\n  # Movement deltas for BFS (4-connectivity: North, South, West, East)\n  MOVEMENT_DELTAS = [(0, -1), (0, 1), (-1, 0), (1, 0)]\n  DELTA_TO_ACTION_MAP = {\n      (0, -1): UP_ACTION,  # Move North (Up)\n      (0, 1): DOWN_ACTION, # Move South (Down)\n      (-1, 0): LEFT_ACTION, # Move West (Left)\n      (1, 0): RIGHT_ACTION  # Move East (Right)\n  }\n\n  # Helper function to check if a given grid position is walkable by the agent.\n  # An agent cannot walk onto cells occupied by non-grabbable items.\n  def is_walkable(px, py):\n      # Check if position is within grid boundaries\n      if not (0 <= px < width and 0 <= py < height):\n          return False \n      \n      # Check if the cell is occupied by any non-grabbable item\n      for k_idx in non_grabbable_indices:\n          if grid[px, py, k_idx] == 1: # If the non-grabbable item is present\n              return False # Not walkable\n      return True\n\n  # 1. Identify all valid \"interaction positions\" for the agent.\n  # An interaction position (x, y) is a cell where the agent can stand\n  # and successfully apply the USE action to collect the primitive.\n  # According to CraftState.next_to(), USE works if the item is in the 3x3\n  # neighborhood (Moore neighborhood) around the agent's position.\n  #\n  # Improvement for collect_v2: Instead of iterating all grid cells and\n  # checking their neighborhood, we find all primitive locations first,\n  # and then determine their valid interaction positions. This can be\n  # more efficient if the primitive is sparse on the grid.\n  \n  valid_interaction_positions = set()\n  \n  # Find all cells where the primitive is located.\n  # np.argwhere returns coordinates (row, col) which correspond to (y, x) if grid is (H, W, K)\n  # but our grid is (WIDTH, HEIGHT, n_kinds), so it's (x, y, kind).\n  # np.argwhere(grid[:, :, primitive_idx] == 1) returns (x, y) coordinates where primitive is present.\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] == 1)\n\n  for px, py in primitive_locations:\n      # For each primitive location (px, py), consider its 3x3 neighborhood\n      # as potential agent positions for interaction.\n      for dx_agent in [-1, 0, 1]:\n          for dy_agent in [-1, 0, 1]:\n              ax, ay = px + dx_agent, py + dy_agent # Agent's potential position\n              # Check if this potential agent position is walkable\n              if is_walkable(ax, ay):\n                  valid_interaction_positions.add((ax, ay))\n\n  # If no valid positions from which to interact with the primitive are found, return empty.\n  if not valid_interaction_positions:\n      return []\n\n  # 2. Perform Breadth-First Search (BFS) to find the shortest path\n  #    from the agent's current position to any valid interaction position.\n  queue = collections.deque([(current_pos, [])]) # Queue stores (position_tuple, list_of_actions_taken)\n  visited = {current_pos} # Set of visited (x, y) positions to prevent cycles and redundant work\n\n  best_path_to_target = []\n  found_path = False\n\n  while queue:\n      (cx, cy), current_path = queue.popleft()\n\n      # If the current position is one of the valid interaction positions,\n      # we've found the shortest path.\n      if (cx, cy) in valid_interaction_positions:\n          best_path_to_target = current_path\n          found_path = True\n          break\n\n      # Explore neighboring cells (using 4-connectivity for agent movement)\n      for dx, dy in MOVEMENT_DELTAS:\n          action_to_reach_neighbor = DELTA_TO_ACTION_MAP[(dx, dy)]\n          nx, ny = cx + dx, cy + dy\n\n          # Check if the neighbor is within grid bounds, hasn't been visited, and is walkable\n          if is_walkable(nx, ny) and (nx, ny) not in visited:\n              visited.add((nx, ny))\n              queue.append(((nx, ny), current_path + [action_to_reach_neighbor]))\n\n  # 3. Construct the complete action sequence.\n  if found_path:\n      # After moving to the interaction position, perform the USE action.\n      # The USE action itself does not require specific facing direction, only proximity.\n      return best_path_to_target + [USE_ACTION]\n  else:\n      # No path found to any valid interaction position.\n      return []", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:37:09.339058", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive.upper()]\n  # 1. Handle cases where the primitive name is invalid or the item cannot be collected.\n  if i_primitive is None:\n      # The primitive name provided does not exist in the cookbook's index.\n      return []\n\n  # The 'collect' action specifically implies picking up an item into inventory.\n  # Items that are part of `non_grabbable_indices` (like workshops, water, boundaries)\n  # cannot be \"collected\" in this manner by the agent's 'USE' action.\n  if i_primitive in env.world.non_grabbable_indices:\n      return []\n\n  # 2. Retrieve action integer mappings from the environment's `action_specs`.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define the list of movement actions for BFS exploration.\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Direction deltas corresponding to the agent's facing direction (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT).\n  # These are used to calculate the coordinates of the grid cell directly in front of the agent.\n  DR = [-1, 0, 1, 0] # Delta Row for (UP, RIGHT, DOWN, LEFT)\n  DC = [0, 1, 0, -1] # Delta Col for (UP, RIGHT, DOWN, LEFT)\n\n  start_state = env._current_state\n  HEIGHT, WIDTH, _ = start_state.grid.shape\n\n  # 3. Initialize Breadth-First Search (BFS).\n  # The queue stores tuples of (current_CraftState_instance, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(start_state, [])])\n  \n  # The 'visited' set keeps track of (agent_row, agent_col, agent_direction) tuples.\n  # This is crucial for avoiding redundant state explorations and infinite loops,\n  # as the agent's current direction influences the outcome of the 'USE' action.\n  visited = set([(start_state.pos[0], start_state.pos[1], start_state.dir)]) \n\n  # 4. Perform BFS to find the shortest sequence of actions.\n  while queue:\n    current_state, path_to_current = queue.popleft()\n    \n    # --- Goal Check: Can the primitive be collected from this `current_state`? ---\n    # The 'USE' action interacts with the grid cell directly in front of the agent.\n    \n    # Calculate the coordinates of the cell the agent is currently facing.\n    facing_dir = current_state.dir\n    target_r = current_state.pos[0] + DR[facing_dir]\n    target_c = current_state.pos[1] + DC[facing_dir]\n\n    # Check if the calculated target cell is within the grid boundaries.\n    if 0 <= target_r < HEIGHT and 0 <= target_c < WIDTH:\n        # Check if the target cell actually contains the desired primitive.\n        # `grid[r, c, kind_idx]` gives the count of `kind_idx` at `(r, c)`.\n        if current_state.grid[target_r, target_c, i_primitive] > 0:\n            # If the primitive is found in front of the agent, we have reached a state\n            # where it can be collected. Since BFS guarantees the shortest path,\n            # this is the optimal solution. Append the ACTION_USE and return.\n            return path_to_current + [ACTION_USE]\n\n    # --- Explore Next States: Simulate Movement Actions ---\n    # Try all valid movement actions (UP, DOWN, LEFT, RIGHT) from the current state.\n    for action in MOVE_ACTIONS:\n      # Simulate the action to get the next state. The `step` method returns a\n      # *new* `CraftState` instance, which reflects updates to position,\n      # direction, and potentially the grid/inventory (though for movement,\n      # grid/inventory usually don't change). The reward (always 0.0 here) is ignored.\n      _, new_state = current_state.step(action) \n      \n      # Create a unique key for the `new_state` to check if it has been visited before.\n      # The key includes position and direction, as both define a unique state for future actions.\n      new_state_key = (new_state.pos[0], new_state.pos[1], new_state.dir)\n      \n      # If this new state (position + direction) has not been visited, add it to the queue\n      # along with the path taken to reach it.\n      if new_state_key not in visited:\n        visited.add(new_state_key)\n        queue.append((new_state, path_to_current + [action]))\n            \n  # 5. If the BFS completes (queue becomes empty) and no path to collect\n  # the primitive was found, it means the primitive is either unreachable or\n  # not present on the map under current conditions. Return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:37:11.542338", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive.upper()]\n  if i_primitive is None:\n      return [] # Primitive name not found in the cookbook index\n\n  # Ensure the primitive is grabbable. The 'collect' action implies\n  # adding an item to inventory, which is not possible for non-grabbable entities\n  # (like workshops, water, boundaries, etc.).\n  if i_primitive in env.world.non_grabbable_indices:\n      return []\n\n  # Get action integer mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']     # Assume this is MOVE_FORWARD (relative to agent's direction)\n  ACTION_DOWN = action_map['DOWN'] # Assume this is MOVE_BACKWARD (relative to agent's direction)\n  ACTION_LEFT = action_map['LEFT'] # Assume this is TURN_LEFT (changes direction, keeps position)\n  ACTION_RIGHT = action_map['RIGHT'] # Assume this is TURN_RIGHT (changes direction, keeps position)\n  ACTION_USE = action_map['USE']   # Use item in front\n\n  # Delta Row/Col based on agent's direction:\n  # DIR_UP (0), DIR_RIGHT (1), DIR_DOWN (2), DIR_LEFT (3)\n  DR_FOR_DIR = [-1, 0, 1, 0] # Delta row for agent facing UP, RIGHT, DOWN, LEFT respectively\n  DC_FOR_DIR = [0, 1, 0, -1] # Delta col for agent facing UP, RIGHT, DOWN, LEFT respectively\n\n  start_state = env._current_state\n  start_r, start_c = start_state.pos\n  start_dir = start_state.dir\n\n  # BFS queue stores (row, col, direction, list_of_actions_taken)\n  queue = collections.deque([(start_r, start_c, start_dir, [])])\n  \n  # Visited set stores (row, col, direction) tuples to avoid cycles and redundant exploration\n  visited = set([(start_r, start_c, start_dir)])\n\n  HEIGHT, WIDTH, _ = start_state.grid.shape\n  \n  # Obstacle indices (non-grabbable items that cannot be walked through)\n  obstacle_indices = env.world.non_grabbable_indices\n\n  while queue:\n      r, c, d, path = queue.popleft()\n      \n      # --- Goal Check: Can we collect the primitive from the current state (r, c, d)? ---\n      # Calculate the coordinates of the cell directly in front of the agent\n      front_r, front_c = r + DR_FOR_DIR[d], c + DC_FOR_DIR[d]\n\n      # Check if the cell in front is within bounds and contains the desired primitive\n      if (0 <= front_r < HEIGHT and 0 <= front_c < WIDTH and\n          start_state.grid[front_r, front_c, i_primitive] > 0):\n          # We found the shortest sequence of actions to be in a state\n          # where the primitive is directly in front. Add the USE action.\n          return path + [ACTION_USE]\n\n      # --- Explore Possible Next States (actions from current state) ---\n\n      # 1. Try moving forward (ACTION_UP)\n      next_r_fwd, next_c_fwd = r + DR_FOR_DIR[d], c + DC_FOR_DIR[d]\n      if (0 <= next_r_fwd < HEIGHT and 0 <= next_c_fwd < WIDTH and\n          (next_r_fwd, next_c_fwd, d) not in visited):\n          \n          is_obstacle_fwd = False\n          for kind_idx in obstacle_indices:\n              if start_state.grid[next_r_fwd, next_c_fwd, kind_idx] > 0:\n                  is_obstacle_fwd = True\n                  break\n          \n          if not is_obstacle_fwd:\n              visited.add((next_r_fwd, next_c_fwd, d))\n              queue.append((next_r_fwd, next_c_fwd, d, path + [ACTION_UP]))\n\n      # 2. Try moving backward (ACTION_DOWN)\n      next_r_bwd, next_c_bwd = r - DR_FOR_DIR[d], c - DC_FOR_DIR[d] # Reverse direction of DR/DC\n      if (0 <= next_r_bwd < HEIGHT and 0 <= next_c_bwd < WIDTH and\n          (next_r_bwd, next_c_bwd, d) not in visited):\n          \n          is_obstacle_bwd = False\n          for kind_idx in obstacle_indices:\n              if start_state.grid[next_r_bwd, next_c_bwd, kind_idx] > 0:\n                  is_obstacle_bwd = True\n                  break\n          \n          if not is_obstacle_bwd:\n              visited.add((next_r_bwd, next_c_bwd, d))\n              queue.append((next_r_bwd, next_c_bwd, d, path + [ACTION_DOWN]))\n\n      # 3. Try turning left (ACTION_LEFT)\n      next_d_left = (d - 1 + 4) % 4 # Cycle through 0,1,2,3 for directions\n      if (r, c, next_d_left) not in visited:\n          visited.add((r, c, next_d_left))\n          queue.append((r, c, next_d_left, path + [ACTION_LEFT]))\n\n      # 4. Try turning right (ACTION_RIGHT)\n      next_d_right = (d + 1) % 4 # Cycle through 0,1,2,3 for directions\n      if (r, c, next_d_right) not in visited:\n          visited.add((r, c, next_d_right))\n          queue.append((r, c, next_d_right, path + [ACTION_RIGHT]))\n\n  # If the queue becomes empty and no path to collect the primitive was found,\n  # it means the primitive is unreachable or not present.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:38:27.701136", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Map action IDs to (dr, dc) for movement (UP, DOWN, LEFT, RIGHT)\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Get the integer ID for the primitive string (e.g., \"WOOD\" -> 10)\n  primitive_item_id = env.world.cookbook.index[primitive]\n\n  # Pre-convert relevant lists to sets for efficient O(1) lookups\n  non_grabbable_indices_set = env.world.non_grabbable_indices # This is already a set\n  workshop_indices_set = set(env.world.workshop_indices)\n  grabbable_indices_set = set(env.world.grabbable_indices)\n  \n  water_id = env.world.water_index\n  stone_source_id = env.world.stone_index # ID for the block that produces stone\n\n  # Determine the actual entity ID on the grid to interact with,\n  # and whether interaction requires being adjacent or on the same tile.\n  target_grid_entity_id = None\n  interact_adjacent = False\n\n  if primitive == \"STONE\":\n      # When collecting \"STONE\", we need to interact with the stone_source_id entity\n      # (a stone block) from an adjacent tile.\n      target_grid_entity_id = stone_source_id\n      interact_adjacent = True \n  elif primitive_item_id in workshop_indices_set:\n      # Workshops (e.g., BENCH) are used by standing directly on their tile.\n      target_grid_entity_id = primitive_item_id\n      interact_adjacent = False\n  elif primitive_item_id in grabbable_indices_set:\n      # Grabbable items (e.g., WOOD, IRON, GRASS) are collected by standing on their tile.\n      target_grid_entity_id = primitive_item_id\n      interact_adjacent = False\n  else:\n      # This 'else' covers primitives like \"WATER\", \"BOUNDARY\" which are not\n      # collectable. We set the target to the item itself, and `is_blocked`\n      # will handle preventing movement onto them, leading to no path found.\n      target_grid_entity_id = primitive_item_id\n      interact_adjacent = False\n\n  if target_grid_entity_id is None:\n      # This case should ideally not be reached with valid DSL primitives.\n      return []\n\n  # Find all grid positions where the target entity is located.\n  # np.argwhere returns an array of coordinates, .tolist() converts to a list of (r,c) tuples.\n  entity_positions_on_grid = np.argwhere(grid[:, :, target_grid_entity_id] > 0).tolist()\n\n  if not entity_positions_on_grid:\n      # The target entity was not found on the map.\n      return []\n\n  # Determine the set of reachable target positions for BFS.\n  # These are the actual cells the agent needs to move to.\n  bfs_target_positions = set()\n  if interact_adjacent:\n      # If interaction requires adjacency, target positions are cells neighboring the entity.\n      for er, ec in entity_positions_on_grid:\n          for dr, dc in action_deltas.values(): # Check all 4 cardinal neighbors\n              nr, nc = er + dr, ec + dc\n              if 0 <= nr < rows and 0 <= nc < cols: # Ensure neighbor is within grid bounds\n                  bfs_target_positions.add((nr, nc))\n  else:\n      # If interaction is on-tile, target positions are the entity's own cells.\n      bfs_target_positions.update(entity_positions_on_grid)\n\n  # Helper function to determine if a given cell is blocked for movement.\n  # A cell is blocked if it's out of bounds, contains water, or contains\n  # a non-grabbable entity that prevents passage.\n  def is_blocked(pos):\n      r, c = pos\n      # Check if position is out of grid bounds\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # Get all kind IDs of entities present at the current cell.\n      cell_contents_kind_ids = np.where(grid[r, c, :] > 0)[0] \n      \n      # Water always blocks movement.\n      if water_id in cell_contents_kind_ids:\n           return True\n\n      # Check for other non-grabbable entities.\n      for k_idx in cell_contents_kind_ids:\n          if k_idx in non_grabbable_indices_set:\n              # A non-grabbable entity at this position blocks movement IF:\n              # 1. It is NOT the specific target entity we are trying to reach (e.g., trying to walk through a random workshop).\n              # OR\n              # 2. It IS the target entity, but our intended interaction is ADJACENT, meaning we should not move onto its tile.\n              if k_idx != target_grid_entity_id or interact_adjacent:\n                  return True\n      return False\n\n  # Breadth-First Search (BFS) to find the shortest path from start_pos to any target_position.\n  q = collections.deque([(start_pos, [])]) # Queue stores (current_position, path_of_actions_so_far)\n  visited = {start_pos} # Set to keep track of visited positions to avoid cycles and redundant exploration\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in bfs_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break \n\n      # Explore neighboring cells\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (not visited and not blocked), add it to the queue.\n          if new_pos not in visited and not is_blocked(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path was found, append the 'USE' action (ID 4) at the end.\n      # This action is performed once the agent reaches the target position.\n      actions = best_path + [4] \n  \n  return actions", "island_id": 3, "scores": {"3": -1}}
