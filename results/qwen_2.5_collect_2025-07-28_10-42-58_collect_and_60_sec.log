{"timestamp": "2025-07-28T14:19:32.362288", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # Check if already next to the primitive (using the agent's 3x3 next_to method)\n  if current_state.next_to(primitive_idx):\n      return [action_map['USE']]\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If no primitive found anywhere on the grid, return empty path\n  if len(primitive_locations) == 0:\n      return []\n\n  # --- Improvement 1: Pre-calculate cells within 3x3 range of any primitive ---\n  # These are the target cells for our pathfinding, as 'USE' acts within a 3x3 neighborhood.\n  adj_to_primitive_map_3x3 = np.full((grid_height, grid_width), False, dtype=bool)\n\n  # Define relative neighborhood offsets for the 3x3 range (including the center (0,0))\n  neighborhood_offsets_3x3 = [\n      (dr, dc) for dr in [-1, 0, 1] for dc in [-1, 0, 1]\n  ]\n\n  for pr, pc in primitive_locations:\n      for dr, dc in neighborhood_offsets_3x3:\n          adj_r, adj_c = pr + dr, pc + dc\n          # Check bounds for the calculated adjacent cell\n          if 0 <= adj_r < grid_height and 0 <= adj_c < grid_width:\n              adj_to_primitive_map_3x3[adj_r, adj_c] = True\n\n  # --- Improvement 2: Pre-compute impassable cells grid ---\n  # Identify impassable terrain indices using the world's non-grabbable entities.\n  impassable_indices = env.world.non_grabbable_indices\n  impassable_grid = np.full((grid_height, grid_width), False, dtype=bool)\n\n  for r in range(grid_height):\n      for c in range(grid_width):\n          for kind_idx in impassable_indices:\n              if grid[r, c, kind_idx] > 0:\n                  impassable_grid[r, c] = True\n                  break # This cell is impassable, no need to check other kinds\n\n  # Define possible moves and their corresponding actions\n  moves = {\n      (0, 1): action_map['RIGHT'],\n      (0, -1): action_map['LEFT'],\n      (1, 0): action_map['DOWN'],\n      (-1, 0): action_map['UP'],\n  }\n\n  # BFS (Breadth-First Search) initialization\n  queue = collections.deque([((agent_r, agent_c), [])])\n  visited = {(agent_r, agent_c)} # Keep track of visited (r, c) tuples to avoid cycles and redundant paths\n\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # If the current cell (r, c) is within 3x3 range of a primitive,\n      # we have found the shortest path to a \"collectible\" position.\n      if adj_to_primitive_map_3x3[r, c]:\n          # Return the path to this cell followed by the 'USE' action.\n          return path + [action_map['USE']]\n\n      # Explore neighbors\n      for (dr, dc), action in moves.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next cell is impassable using the pre-computed grid\n          if impassable_grid[next_r, next_c]:\n              continue\n\n          # Check if this position has already been visited\n          if next_pos in visited:\n              continue\n\n          # If valid and unvisited, add to visited set and queue\n          visited.add(next_pos)\n          new_path = path + [action]\n          queue.append((next_pos, new_path))\n\n  # If the BFS completes and no path to an adjacent primitive cell is found\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:19:34.285434", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If no primitive found anywhere on the grid, return empty path\n  if len(primitive_locations) == 0:\n      return []\n\n  # Pre-calculate cells that are *adjacent* to any primitive.\n  # These are the target cells for our pathfinding, as 'USE' typically acts on adjacent items.\n  # This map ensures consistency between the initial check and the BFS target condition.\n  adj_to_primitive_map = np.full((grid_height, grid_width), False, dtype=bool)\n\n  # Define relative neighbor offsets for 4-directional adjacency (Manhattan distance 1).\n  # These are the positions from which 'USE' could effectively be applied to a primitive.\n  neighbor_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  for pr, pc in primitive_locations:\n      for dr, dc in neighbor_offsets:\n          adj_r, adj_c = pr + dr, pc + dc\n          # Check bounds for the calculated adjacent cell\n          if 0 <= adj_r < grid_height and 0 <= adj_c < grid_width:\n              adj_to_primitive_map[adj_r, adj_c] = True\n\n  # Check if the agent's current position is already adjacent to a primitive.\n  # If so, the only action needed is 'USE'. This is the most efficient case.\n  if adj_to_primitive_map[agent_r, agent_c]:\n      return [action_map['USE']]\n\n  # Define possible moves and their corresponding actions\n  moves = {\n      (0, 1): action_map['RIGHT'],\n      (0, -1): action_map['LEFT'],\n      (1, 0): action_map['DOWN'],\n      (-1, 0): action_map['UP'],\n  }\n\n  # Identify impassable terrain indices using the world's non-grabbable entities.\n  # Agents cannot move onto cells containing these kinds.\n  impassable_indices = env.world.non_grabbable_indices\n\n  # BFS (Breadth-First Search) initialization\n  # The queue stores tuples of (current_position, path_taken_to_reach_current_position).\n  queue = collections.deque([((agent_r, agent_c), [])])\n  # The visited set keeps track of (r, c) tuples to avoid cycles and redundant paths.\n  visited = {(agent_r, agent_c)}\n\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # Explore neighbors\n      for (dr, dc), action in moves.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next cell contains any impassable entities.\n          # If it does, this path is blocked.\n          is_impassable = False\n          for kind_idx in impassable_indices:\n              if grid[next_r, next_c, kind_idx] > 0:\n                  is_impassable = True\n                  break\n          if is_impassable:\n              continue\n\n          # Check if this position has already been visited to ensure shortest path and prevent loops.\n          if next_pos in visited:\n              continue\n\n          # If valid and unvisited, add to visited set and create a new path.\n          visited.add(next_pos)\n          new_path = path + [action]\n\n          # If this newly reached cell is an \"adjacent-to-primitive\" cell,\n          # we have found the shortest path to a collectible position.\n          if adj_to_primitive_map[next_r, next_c]:\n              # Return the path to this cell followed by the 'USE' action to collect the primitive.\n              return new_path + [action_map['USE']]\n          \n          # If not a target cell, continue BFS from this new position.\n          queue.append((next_pos, new_path))\n\n  # If the BFS completes and no path to an adjacent primitive cell is found,\n  # it means the primitive is unreachable from the current position.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:20:45.327218", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T14:20:47.269879", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive.upper()]\n  \n  # 1. Validate inputs and perform pre-checks.\n  # If the primitive name is not found in the cookbook index, it's an invalid target.\n  if i_primitive is None:\n      return []\n\n  # 'Collect' implies adding an item to inventory. Non-grabbable entities (like workshops,\n  # water, or boundaries) cannot be picked up using the 'USE' action.\n  if i_primitive in env.world.non_grabbable_indices:\n      return []\n\n  # Get the current state of the environment.\n  start_state = env._current_state\n  \n  # Optimization/Pre-condition check: If the primitive is already in the agent's inventory,\n  # no collection actions are needed. The task is effectively already completed.\n  if start_state.inventory[i_primitive] > 0:\n      return []\n\n  # 2. Retrieve integer mappings for actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']   # Assuming this is a turn action\n  ACTION_RIGHT = action_map['RIGHT'] # Assuming this is a turn action\n  ACTION_USE = action_map['USE']\n\n  # Define all possible actions that change state (position or direction).\n  ALL_EXPLORE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Delta Row/Col based on agent's direction (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT)\n  # These are used to calculate the coordinates of the cell directly in front of the agent.\n  DR = [-1, 0, 1, 0] # Delta Row for (UP, RIGHT, DOWN, LEFT)\n  DC = [0, 1, 0, -1] # Delta Col for (UP, RIGHT, DOWN, LEFT)\n\n  # Get grid dimensions for boundary checks.\n  HEIGHT, WIDTH, _ = start_state.grid.shape\n\n  # Define a maximum search depth for BFS. This prevents excessively long searches.\n  # A reasonable upper bound for distinct (pos, dir) states is WIDTH * HEIGHT * 4 directions.\n  MAX_BFS_DEPTH = WIDTH * HEIGHT * 4 * 2 # Multiply by 2 for a generous buffer\n\n  # 3. Initialize Breadth-First Search (BFS) structures.\n  # The queue stores tuples of (current_CraftState_instance, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(start_state, [])])\n  \n  # The 'visited' set keeps track of (agent_row, agent_col, agent_direction) tuples.\n  # This prevents redundant exploration of the same state and avoids infinite loops.\n  visited = set([(start_state.pos[0], start_state.pos[1], start_state.dir)]) \n\n  # 4. Perform BFS to find the shortest action sequence.\n  while queue:\n    current_craft_state, path_to_current = queue.popleft()\n    \n    # Prune paths that exceed the maximum allowed depth.\n    if len(path_to_current) >= MAX_BFS_DEPTH:\n        continue\n\n    # --- Goal Check: Can the primitive be collected from the `current_craft_state`? ---\n    # The 'USE' action interacts with the grid cell directly in front of the agent.\n    \n    # Calculate the coordinates of the cell the agent is currently facing.\n    facing_dir = current_craft_state.dir\n    target_r = current_craft_state.pos[0] + DR[facing_dir]\n    target_c = current_craft_state.pos[1] + DC[facing_dir]\n\n    # Check if the target cell is within grid boundaries.\n    if 0 <= target_r < HEIGHT and 0 <= target_c < WIDTH:\n        # Check if the target cell contains the desired primitive.\n        # `grid[r, c, kind_idx] > 0` indicates presence.\n        if current_craft_state.grid[target_r, target_c, i_primitive] > 0:\n            # If the primitive is found in front, we've found the shortest path.\n            # Append the 'USE' action and return the complete action sequence.\n            return path_to_current + [ACTION_USE]\n\n    # --- Explore Next States: Simulate all possible movement and turn actions ---\n    for action in ALL_EXPLORE_ACTIONS:\n      # Simulate the action using `current_craft_state.step()`. This function\n      # returns a tuple: (reward, new_CraftState). We only need the `new_state`.\n      # The `step` function is assumed to correctly update `pos` for move actions\n      # and `dir` for turn actions, and handle collisions (e.g., by not changing pos).\n      _, next_craft_state = current_craft_state.step(action) \n      \n      # Create a unique key for the `next_craft_state` to check against the `visited` set.\n      # A state is uniquely defined by the agent's position and direction.\n      next_state_key = (next_craft_state.pos[0], next_craft_state.pos[1], next_craft_state.dir)\n      \n      # If this new state has not been visited, add it to the `visited` set\n      # and enqueue it along with the sequence of actions taken to reach it.\n      if next_state_key not in visited:\n        visited.add(next_state_key)\n        queue.append((next_craft_state, path_to_current + [action]))\n            \n  # 5. If the BFS completes (queue becomes empty) and no path to collect\n  # the primitive was found (or was found beyond MAX_BFS_DEPTH), it implies\n  # the primitive is either unreachable or not present on the map under the\n  # current conditions within the search limits. Return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:22:03.444789", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  initial_dir = current_state.dir \n  WIDTH, HEIGHT, n_kinds = grid.shape\n\n  # Get the integer index for the primitive, converting DSL's capitalized name to lowercase.\n  i_primitive = env.world.cookbook.index.index(primitive.lower())\n  \n  # Determine if the primitive is grabbable. This dictates whether the agent needs\n  # to move ONTO the primitive's square (for grabbable) or ADJACENT to it (for non-grabbable).\n  is_grabbable = i_primitive in env.world.grabbable_indices\n  \n  # Get action mappings from the environment.\n  ACTIONS = env.action_specs()\n  ACTION_UP = ACTIONS['UP']\n  ACTION_DOWN = ACTIONS['DOWN']\n  ACTION_LEFT = ACTIONS['LEFT']\n  ACTION_RIGHT = ACTIONS['RIGHT']\n  ACTION_USE = ACTIONS['USE']\n\n  # Mapping from internal direction constants to (dx, dy) deltas.\n  # CraftState.dir maps to: 0=UP (North), 1=RIGHT (East), 2=DOWN (South), 3=LEFT (West)\n  DIR_TO_DELTA = {\n      0: (0, -1),  # UP (decreasing Y)\n      1: (1, 0),   # RIGHT (increasing X)\n      2: (0, 1),   # DOWN (increasing Y)\n      3: (-1, 0),  # LEFT (decreasing X)\n  }\n  \n  # Map movement actions to the resulting internal direction the agent will face.\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: 0,    # Agent faces UP after moving UP\n      ACTION_RIGHT: 1, # Agent faces RIGHT after moving RIGHT\n      ACTION_DOWN: 2,  # Agent faces DOWN after moving DOWN\n      ACTION_LEFT: 3,  # Agent faces LEFT after moving LEFT\n  }\n\n  # List of all action values that correspond to movements.\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n  \n  # Set of indices for entities that block general movement (e.g., boundaries, water, workshops).\n  # Grabbable items (like 'wood', 'stone') are NOT in non_grabbable_indices, so they do not\n  # block movement and can be stepped upon.\n  impassable_indices = set(env.world.non_grabbable_indices)\n  \n  # BFS (Breadth-First Search) to find the shortest path.\n  # A state in BFS is represented as: ((x, y), current_direction, list_of_actions_to_reach_this_state)\n  q = collections.deque([((initial_pos), initial_dir, [])]) \n  \n  # Visited set: stores ((x, y), current_direction) tuples to avoid redundant paths and cycles.\n  visited = {((initial_pos), initial_dir)} \n\n  while q:\n      (cx, cy), current_dir, current_path = q.popleft()\n\n      # --- Goal Check: Determine if the current state satisfies the collection condition ---\n      if is_grabbable:\n          # For grabbable items (e.g., WOOD, STONE): The agent needs to be ON the primitive's cell.\n          if grid[cx, cy, i_primitive] > 0:\n              # If agent is on the primitive, return the path plus a USE action to collect it.\n              return list(current_path) + [ACTION_USE]\n      else:\n          # For non-grabbable items (e.g., WATER, WORKSHOP): The agent needs to be ADJACENT to it, facing it.\n          dx_front, dy_front = DIR_TO_DELTA[current_dir]\n          fx, fy = cx + dx_front, cy + dy_front # Cell directly in front of the agent\n\n          # Check if the cell in front is within grid bounds.\n          if 0 <= fx < WIDTH and 0 <= fy < HEIGHT:\n              # Check if the primitive is present (count > 0) in the cell directly in front.\n              if grid[fx, fy, i_primitive] > 0:\n                  # If the primitive is in front, return the path plus a USE action to interact.\n                  return list(current_path) + [ACTION_USE]\n\n      # --- Explore Possible Movement Actions from the Current State ---\n      for action_val in MOVEMENT_ACTIONS:\n          # Determine the agent's new direction after executing this movement action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_val]\n          \n          # Calculate the new position after the movement. The agent moves into the cell\n          # that corresponds to its new facing direction.\n          dx_move, dy_move = DIR_TO_DELTA[next_dir] \n          nx, ny = cx + dx_move, cy + dy_move # New position\n\n          # Boundary check: Ensure the next position is within grid boundaries.\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          # Obstacle check: Determine if the next cell (nx, ny) is traversable.\n          # A cell is traversable if it does not contain any of the impassable items.\n          is_obstacle = False\n          for obstacle_idx in impassable_indices:\n              if grid[nx, ny, obstacle_idx] > 0:\n                  is_obstacle = True\n                  break\n          \n          if is_obstacle:\n              continue # Cannot move into an obstacle cell.\n\n          # Form the tuple for the next state to check against the visited set.\n          next_state_tuple = ((nx, ny), next_dir)\n\n          # If this new state has not been visited before, add it to the queue.\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append(((nx, ny), next_dir, current_path + [action_val]))\n\n  # If the queue is exhausted and no path to the primitive was found, return an empty list.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:22:05.449745", "function_name": "collect", "function_body": "  \"\"\"Improved version of `collect_v1`.\n\n  This function uses Breadth-First Search (BFS) to find the shortest sequence of\n  movement actions that position the agent such that the target `primitive`\n  is directly in front of it. Once positioned, a single ACTION_USE is appended\n  to \"collect\" (interact with) the primitive.\n\n  The state in the BFS includes not only the agent's (x, y) position but also\n  its current facing direction, as the 'USE' action in CraftWorld is typically\n  direction-dependent, interacting with the cell directly in front.\n\n  Args:\n      env: The CraftLab environment instance, providing access to the current state,\n           world configuration (cookbook, indices), and action specifications.\n      primitive: A string representing the name of the primitive item to collect\n                 (e.g., \"WOOD\", \"WATER\", \"WORKSHOP0\"). The name is converted\n                 to lowercase for lookup in the internal index.\n\n  Returns:\n      A list of integer actions (e.g., [ACTION_RIGHT, ACTION_UP, ACTION_USE])\n      representing the shortest path to effectively \"collect\" the primitive.\n      This includes reaching a position adjacent to the primitive and facing it,\n      followed by a USE action. Returns an empty list if the primitive is not\n      found on the grid or is unreachable.\n  \"\"\"\n  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos  # Agent's starting (x, y) position\n  initial_dir = current_state.dir  # Agent's starting facing direction (0=UP, 1=RIGHT, 2=DOWN, 3=LEFT)\n  WIDTH, HEIGHT, _ = grid.shape  # Grid dimensions (n_kinds is not needed for loop iterations)\n\n  # Get the integer ID for the primitive. `index.index()` ensures the name\n  # is present in the cookbook's mapping and returns its corresponding integer ID.\n  i_primitive = env.world.cookbook.index.index(primitive.lower())\n  \n  # Retrieve action mappings for clarity and direct use within the BFS.\n  ACTIONS = env.action_specs()\n  ACTION_UP = ACTIONS['UP']\n  ACTION_DOWN = ACTIONS['DOWN']\n  ACTION_LEFT = ACTIONS['LEFT']\n  ACTION_RIGHT = ACTIONS['RIGHT']\n  ACTION_USE = ACTIONS['USE']\n\n  # Define internal direction constants (matching CraftState.dir) and their\n  # corresponding (dx, dy) deltas, which represent changes in coordinates.\n  DIR_TO_DELTA = {\n      0: (0, -1),  # UP (Y-coordinate decreases)\n      1: (1, 0),   # RIGHT (X-coordinate increases)\n      2: (0, 1),   # DOWN (Y-coordinate increases)\n      3: (-1, 0),  # LEFT (X-coordinate decreases)\n  }\n  \n  # Map movement actions to the resulting direction the agent will face after\n  # executing that action. For example, moving 'UP' means the agent will then\n  # be facing 'UP' (direction 0).\n  ACTION_TO_RESULTING_DIR = {\n      ACTION_UP: 0,\n      ACTION_RIGHT: 1,\n      ACTION_DOWN: 2,\n      ACTION_LEFT: 3,\n  }\n\n  # List of all movement action values to iterate through during BFS exploration.\n  MOVEMENT_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Identify indices of entities that are considered obstacles. These are\n  # typically non-grabbable items or boundaries that the agent cannot\n  # walk through. This set is used to determine traversable cells.\n  obstacle_indices = env.world.non_grabbable_indices\n  \n  # The BFS queue stores tuples:\n  # ( (current_x, current_y), current_direction, list_of_actions_to_reach_this_state )\n  q = collections.deque([((initial_pos), initial_dir, [])]) \n  \n  # The 'visited' set keeps track of states already explored to prevent infinite\n  # loops and redundant paths. A state is defined by the agent's (position, direction).\n  visited = {((initial_pos), initial_dir)} \n\n  while q:\n      (cx, cy), current_dir, current_path = q.popleft()\n\n      # Calculate the coordinates of the cell directly in front of the agent.\n      # This is the cell that ACTION_USE would interact with.\n      dx_front, dy_front = DIR_TO_DELTA[current_dir]\n      fx, fy = cx + dx_front, cy + dy_front # Front cell coordinates\n\n      # Check if the calculated front cell is within the grid boundaries.\n      if 0 <= fx < WIDTH and 0 <= fy < HEIGHT:\n          # Check if the target primitive is present in the cell directly in front.\n          # Grid values represent counts, so a count > 0 means the item is present.\n          if grid[fx, fy, i_primitive] > 0:\n              # Goal found: The primitive is directly in front of the agent,\n              # ready for interaction. Append ACTION_USE to the path and return it.\n              return list(current_path) + [ACTION_USE]\n\n      # Explore all possible next movement actions from the current state.\n      for action_val in MOVEMENT_ACTIONS:\n          # Determine the agent's new direction after taking this movement action.\n          next_dir = ACTION_TO_RESULTING_DIR[action_val]\n          \n          # Calculate the agent's new position after moving. The agent moves\n          # into the cell that corresponds to its new facing direction.\n          dx_move, dy_move = DIR_TO_DELTA[next_dir] \n          nx, ny = cx + dx_move, cy + dy_move # New position coordinates\n\n          # Ensure the new position is within the grid boundaries.\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue # Skip this action if it leads out of bounds.\n\n          # Check if the proposed new cell (nx, ny) contains any obstacle.\n          # The agent cannot move into a cell that contains an obstacle.\n          is_obstacle = False\n          for obstacle_idx in obstacle_indices:\n              if grid[nx, ny, obstacle_idx] > 0:\n                  is_obstacle = True\n                  break # Found an obstacle in this cell, no need to check further indices.\n          \n          if is_obstacle:\n              continue # Skip this action if the target cell is an obstacle.\n\n          # Form the tuple representing the next state (new position and new direction).\n          next_state_tuple = ((nx, ny), next_dir)\n\n          # If this new state has not been visited before during the BFS,\n          # add it to the queue for future exploration and mark it as visited.\n          if next_state_tuple not in visited:\n              visited.add(next_state_tuple)\n              q.append(((nx, ny), next_dir, current_path + [action_val]))\n\n  # If the BFS queue is exhausted and no path to the primitive was found\n  # (i.e., the primitive is unreachable or not present on the grid),\n  # return an empty list.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:22:42.539368", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  state = env._current_state\n  cookbook = state.world.cookbook\n\n  # Helper to check if a position is adjacent to a kind (similar to CraftState.next_to)\n  def _is_adjacent_to_kind(grid, cx, cy, kind_idx, WIDTH, HEIGHT):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around (cx, cy) contains `kind_idx`.\n      This simulates CraftState.next_to(kind_idx) but for an arbitrary (cx, cy).\n      \"\"\"\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = cx + dx, cy + dy\n              # Check bounds\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  # Check if the kind_idx is present at this neighbor cell\n                  if grid[nx, ny, kind_idx] > 0:\n                      return True\n      return False\n\n  # Get the integer index for the primitive from the cookbook's index\n  primitive_idx = cookbook.index[primitive]\n\n  # If the primitive is a grabbable item and already in inventory, no need to collect\n  if primitive_idx in state.world.grabbable_indices and state.inventory[primitive_idx] > 0:\n      return []\n\n  grid = state.grid\n  WIDTH, HEIGHT, N_KINDS = grid.shape\n  start_pos = state.pos\n\n  # Check if the agent is already adjacent to the primitive\n  if _is_adjacent_to_kind(grid, start_pos[0], start_pos[1], primitive_idx, WIDTH, HEIGHT):\n      # If it's a grabbable item, we need to USE it to collect\n      if primitive_idx in state.world.grabbable_indices:\n          return [action_map['USE']]\n      # If it's a non-grabbable environment item (e.g., workshop, water),\n      # being adjacent means it's \"collected\" for the purpose of this function.\n      return []\n\n  # BFS setup for pathfinding\n  q = collections.deque()\n  visited = set()\n\n  # Each item in queue is (current_position_tuple, path_list_of_actions_to_here)\n  q.append((start_pos, []))\n  visited.add(start_pos)\n\n  # Movement directions and corresponding action integer IDs\n  # (dx, dy) maps to action_name string, then to action ID\n  moves_map = {\n      (0, -1): 'UP',\n      (0, 1): 'DOWN',\n      (-1, 0): 'LEFT',\n      (1, 0): 'RIGHT'\n  }\n\n  # Identify obstacle kinds: entities that the agent cannot move onto.\n  # This typically includes non-grabbable environment items like boundaries, water, etc.\n  obstacle_kinds = state.world.non_grabbable_indices\n\n  while q:\n      current_pos, current_path = q.popleft()\n      cx, cy = current_pos\n\n      for (dx, dy), action_name in moves_map.items():\n          nx, ny = cx + dx, cy + dy\n\n          # Check if new position is within grid bounds\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          # Check if this position has already been visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check if the new position contains an obstacle\n          is_obstacle = False\n          for k_idx in obstacle_kinds:\n              if grid[nx, ny, k_idx] > 0:\n                  is_obstacle = True\n                  break\n          if is_obstacle:\n              continue\n\n          # Add the new position to visited set and extend the path\n          visited.add((nx, ny))\n          new_path = current_path + [action_map[action_name]]\n\n          # Check if this new position is adjacent to the target primitive\n          if _is_adjacent_to_kind(grid, nx, ny, primitive_idx, WIDTH, HEIGHT):\n              final_actions = new_path\n              # If the primitive is grabbable, append a 'USE' action to the path\n              if primitive_idx in state.world.grabbable_indices:\n                  final_actions.append(action_map['USE'])\n              return final_actions # Path found and actions generated\n\n          # If not at the goal, add the new position and path to the queue\n          q.append(((nx, ny), new_path))\n\n  # If the queue becomes empty and no path is found\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:22:44.508618", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  state = env._current_state\n  cookbook = state.world.cookbook\n\n  # Helper to check if a position is adjacent to a specific kind of entity.\n  # This is used for pathfinding, where we check if a potential agent position\n  # is next to the target primitive.\n  def _is_adjacent_to_kind(grid, cx, cy, kind_idx, WIDTH, HEIGHT):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around (cx, cy) contains `kind_idx`.\n      This function mimics `CraftState.next_to` but allows checking any arbitrary grid coordinate.\n      \"\"\"\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = cx + dx, cy + dy\n              # Ensure the neighboring cell is within the grid boundaries\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  # Check if the specified kind_idx is present at this neighbor cell\n                  if grid[nx, ny, kind_idx] > 0:\n                      return True\n      return False\n\n  # Retrieve the integer index for the primitive from the cookbook's item indexer.\n  primitive_idx = cookbook.index[primitive]\n\n  # Early exit condition: If the primitive is a grabbable item (e.g., WOOD, IRON)\n  # and the agent already possesses at least one in its inventory, no collection is needed.\n  if primitive_idx in state.world.grabbable_indices and state.inventory[primitive_idx] > 0:\n      return []\n\n  # Get current grid dimensions and agent's starting position\n  grid = state.grid\n  WIDTH, HEIGHT, _ = grid.shape\n  start_pos = state.pos\n\n  # First, check if the agent is already adjacent to the primitive at its current position.\n  if _is_adjacent_to_kind(grid, start_pos[0], start_pos[1], primitive_idx, WIDTH, HEIGHT):\n      # If it's a grabbable item, we need to apply the 'USE' action to pick it up.\n      if primitive_idx in state.world.grabbable_indices:\n          return [action_map['USE']]\n      # If it's a non-grabbable environment item (like a WORKSHOP, WATER, or a WALL/BOUNDARY),\n      # being adjacent means the primitive is effectively \"collected\" or accessible for its purpose.\n      # No further movement or action is required by this function.\n      return []\n\n  # Initialize Breadth-First Search (BFS) for pathfinding.\n  q = collections.deque()\n  visited = set() # Stores positions already visited to avoid infinite loops and redundant paths.\n\n  # Each element in the queue is a tuple: (current_position_tuple, list_of_actions_taken_to_reach_this_position).\n  q.append((start_pos, []))\n  visited.add(start_pos)\n\n  # Define the possible movement actions and their corresponding (dx, dy) coordinate changes.\n  moves_map = {\n      (0, -1): 'UP',\n      (0, 1): 'DOWN',\n      (-1, 0): 'LEFT',\n      (1, 0): 'RIGHT'\n  }\n\n  # Identify obstacle kinds that the agent cannot move onto.\n  # These are typically non-grabbable environment items (e.g., walls, water in some configurations).\n  obstacle_kinds = state.world.non_grabbable_indices\n\n  # BFS loop: Continues as long as there are positions to explore.\n  while q:\n      current_pos, current_path = q.popleft()\n      cx, cy = current_pos # Current x and y coordinates\n\n      # Explore all four possible directions (UP, DOWN, LEFT, RIGHT) from the current position.\n      for (dx, dy), action_name in moves_map.items():\n          nx, ny = cx + dx, cy + dy # Calculate the next potential position.\n\n          # 1. Check if the next position is within the grid boundaries.\n          if not (0 <= nx < WIDTH and 0 <= ny < HEIGHT):\n              continue\n\n          # 2. Check if this next position has already been visited during the BFS.\n          if (nx, ny) in visited:\n              continue\n\n          # 3. Check if the next position contains an obstacle that the agent cannot move onto.\n          is_obstacle = False\n          for k_idx in obstacle_kinds:\n              if grid[nx, ny, k_idx] > 0: # If an obstacle of this kind exists at (nx, ny)\n                  is_obstacle = True\n                  break\n          if is_obstacle:\n              continue # If it's an obstacle, skip this path.\n\n          # If the new position is valid (in bounds, not visited, and not an obstacle):\n          visited.add((nx, ny)) # Mark this position as visited.\n          new_path = current_path + [action_map[action_name]] # Extend the path.\n\n          # 4. Check if this new position is adjacent to the target primitive.\n          # If it is, we have found a path to collect the primitive.\n          if _is_adjacent_to_kind(grid, nx, ny, primitive_idx, WIDTH, HEIGHT):\n              final_actions = new_path\n              # If the primitive is grabbable, an additional 'USE' action is required\n              # after moving adjacent to it to actually collect it.\n              if primitive_idx in state.world.grabbable_indices:\n                  final_actions.append(action_map['USE'])\n              return final_actions # Return the complete list of actions.\n\n          # If the new position is not yet adjacent to the goal primitive,\n          # add it to the queue to continue exploring paths from this point.\n          q.append(((nx, ny), new_path))\n\n  # If the BFS completes and the queue becomes empty without finding a path\n  # to collect the primitive, return an empty list, indicating failure.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:23:32.664037", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current position (x, y)\n  \n  # Grid shape is (WIDTH, HEIGHT, n_kinds) -> (cols, rows, kinds)\n  grid_width, grid_height, n_kinds = grid.shape \n\n  # Get the integer ID for the primitive (e.g., \"WOOD\" from DSL becomes \"wood\" for index)\n  # Using .index() ensures the primitive is registered and returns its ID.\n  try:\n      primitive_id = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n      # If the primitive is not in the cookbook index, it cannot be collected.\n      # This can happen if the DSL refers to something not in the world's recipes/primitives.\n      return []\n\n  # Get action mappings from the environment (e.g., {\"UP\": 1, \"DOWN\": 0, ...})\n  ACTION_MAP = env.action_specs()\n\n  # Define movement deltas (dx, dy) corresponding to actions for grid[x, y, k]\n  # (dx, dy) means (change in x-coordinate, change in y-coordinate)\n  DELTAS = {\n      ACTION_MAP[\"UP\"]: (0, -1),    # y decreases\n      ACTION_MAP[\"DOWN\"]: (0, 1),   # y increases\n      ACTION_MAP[\"LEFT\"]: (-1, 0),  # x decreases\n      ACTION_MAP[\"RIGHT\"]: (1, 0),  # x increases\n  }\n  \n  # Identify non-walkable indices for BFS pathfinding.\n  unwalkable_indices = set()\n  for name in [\"boundary\", \"water\"]:\n      try:\n          # Use .index() to get ID, or pass if not present in cookbook\n          unwalkable_indices.add(env.world.cookbook.index.index(name))\n      except KeyError:\n          pass \n\n  # --- Pre-compute walkable cells for efficiency (Improvement over collect_v1) ---\n  # Create a boolean grid where True means walkable, False means unwalkable.\n  # walkable_map[x, y] will correspond to grid[x, y].\n  walkable_map = np.ones((grid_width, grid_height), dtype=bool) \n  for unwalkable_idx in unwalkable_indices:\n      # Ensure the unwalkable_idx is a valid kind index for the current grid\n      if unwalkable_idx < n_kinds: \n          # Mark cells containing unwalkable entities (count > 0) as False.\n          # grid[:, :, unwalkable_idx] gives a 2D slice (width, height) for that kind.\n          walkable_map[grid[:, :, unwalkable_idx] > 0] = False\n\n  # Determine if the target primitive requires a 'USE' action to be collected.\n  # Grabbable items are explicitly listed in env.world.grabbable_indices.\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # BFS setup:\n  # Queue stores tuples of (current_position_tuple, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(initial_pos, [])]) \n  # Set to keep track of visited (x, y) positions to avoid cycles and redundant paths\n  visited = {initial_pos} \n\n  # Helper function to check if a position (x, y) is valid (within grid bounds) and walkable\n  # This version utilizes the pre-computed walkable_map for faster checks.\n  def is_valid_and_walkable(x, y):\n      # Check grid boundaries first\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      # Then consult the pre-computed walkable_map\n      return walkable_map[x, y]\n\n  # Helper function to check if a position (current_x, current_y) is \"next_to\" the target primitive.\n  # This mimics the CraftState.next_to method, checking the 3x3 neighborhood.\n  def check_next_to_primitive(current_x, current_y, target_id):\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n              # Ensure neighbor is within grid bounds\n              if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n                  # Check if the primitive is present in the neighbor cell (count > 0)\n                  # Ensure target_id is valid for grid dimension\n                  if target_id < n_kinds and grid[neighbor_x, neighbor_y, target_id] > 0:\n                      return True\n      return False\n\n  # Perform Breadth-First Search\n  while queue:\n      (curr_x, curr_y), path = queue.popleft()\n\n      # Check if the current position is adjacent to the target primitive\n      if check_next_to_primitive(curr_x, curr_y, primitive_id):\n          # If found, this 'path' leads to a position adjacent to the primitive.\n          # If the primitive is grabbable, append the 'USE' action.\n          if is_grabbable:\n              return path + [ACTION_MAP[\"USE\"]]\n          else:\n              # If not grabbable (e.g., a workshop or boundary),\n              # we just need to reach an adjacent position.\n              # This path leads to a cell adjacent to the non-grabbable primitive.\n              return path\n\n      # Explore all possible movement actions from the current position\n      for action_id, (dx, dy) in DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position is valid, walkable, and hasn't been visited yet\n          if is_valid_and_walkable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited\n              # Add to queue with the updated path\n              queue.append(((next_x, next_y), path + [action_id]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:23:34.625537", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current position (x, y)\n  \n  # Grid shape is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, n_kinds = grid.shape \n\n  # Get the integer ID for the primitive (e.g., \"WOOD\" from DSL becomes \"wood\" for index)\n  # Using .index() ensures the primitive is registered and returns its ID.\n  # The DSL uses uppercase (e.g., WOOD), Cookbook uses lowercase (e.g., wood), so convert.\n  primitive_id = env.world.cookbook.index.index(primitive.lower()) \n\n  # Get action mappings from the environment (e.g., {\"UP\": 1, \"DOWN\": 0, ...})\n  ACTION_MAP = env.action_specs()\n\n  # Define movement deltas (dx, dy) corresponding to actions for grid[x, y, k]\n  # UP: (0, -1) -> decreases Y coordinate\n  # DOWN: (0, 1) -> increases Y coordinate\n  # LEFT: (-1, 0) -> decreases X coordinate\n  # RIGHT: (1, 0) -> increases X coordinate\n  DELTAS = {\n      ACTION_MAP[\"UP\"]: (0, -1),    \n      ACTION_MAP[\"DOWN\"]: (0, 1),   \n      ACTION_MAP[\"LEFT\"]: (-1, 0),  \n      ACTION_MAP[\"RIGHT\"]: (1, 0),  \n  }\n  \n  # Identify non-walkable indices for BFS pathfinding.\n  # Common obstacles include \"boundary\" and \"water\".\n  unwalkable_indices = set()\n  for name in [\"boundary\", \"water\"]:\n      try:\n          # Use .index() to get ID, or pass if not present in cookbook\n          unwalkable_indices.add(env.world.cookbook.index.index(name))\n      except KeyError:\n          pass \n\n  # --- Optimization: Pre-compute walkable cells for efficiency ---\n  # Create a boolean grid where True means walkable, False means unwalkable.\n  # The grid is (WIDTH, HEIGHT, N_KINDS), so indexing is grid[x, y, kind_idx].\n  # `walkable_map` should be (WIDTH, HEIGHT).\n  walkable_map = np.ones((grid_width, grid_height), dtype=bool) \n  for unwalkable_idx in unwalkable_indices:\n      # Only process if the unwalkable_idx exists within the current grid's kind dimension\n      if unwalkable_idx < n_kinds: \n          # Mark cells containing unwalkable entities as False\n          # grid[:, :, unwalkable_idx] gives a (WIDTH, HEIGHT) slice for that kind.\n          walkable_map[grid[:, :, unwalkable_idx] > 0] = False\n\n  # Determine if the target primitive requires a 'USE' action to be collected.\n  # Grabbable items are explicitly listed in env.world.grabbable_indices.\n  is_grabbable = primitive_id in env.world.grabbable_indices\n\n  # BFS setup:\n  # Queue stores tuples of (current_position_tuple, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(initial_pos, [])]) \n  visited = {initial_pos} # Set to keep track of visited (x, y) positions to avoid cycles\n\n  # Helper function to check if a position (x, y) is valid (within grid bounds) and walkable\n  # This version utilizes the pre-computed walkable_map for faster checks.\n  def is_valid_and_walkable(x, y):\n      # Check grid boundaries and then consult the walkable_map\n      return 0 <= x < grid_width and 0 <= y < grid_height and walkable_map[x, y]\n\n  # Helper function to check if a position (current_x, current_y) is \"next_to\" the target primitive.\n  # This mimics the CraftState.next_to method, checking the 3x3 neighborhood.\n  def check_next_to_primitive(current_x, current_y, target_id):\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n              # Ensure neighbor is within grid bounds\n              if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n                  # Check if the primitive is present in the neighbor cell (count > 0)\n                  # Ensure target_id is valid for grid dimension\n                  if target_id < n_kinds and grid[neighbor_x, neighbor_y, target_id] > 0:\n                      return True\n      return False\n\n  # Perform Breadth-First Search\n  while queue:\n      (curr_x, curr_y), path = queue.popleft()\n\n      # Check if the current position is adjacent to the target primitive\n      if check_next_to_primitive(curr_x, curr_y, primitive_id):\n          # If found, this 'path' leads to a position adjacent to the primitive.\n          # If the primitive is grabbable, append the 'USE' action.\n          if is_grabbable:\n              return path + [ACTION_MAP[\"USE\"]]\n          else:\n              # If not grabbable (e.g., a workshop or boundary),\n              # we just need to reach an adjacent position.\n              # This covers cases like 'collect WORKSHOP0' which means 'go next to WORKSHOP0'\n              return path\n\n      # Explore all possible movement actions from the current position\n      for action_id, (dx, dy) in DELTAS.items():\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position is valid, walkable, and hasn't been visited yet\n          if is_valid_and_walkable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited\n              # Add to queue with the updated path\n              queue.append((next_pos, path + [action_id]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:24:02.718415", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  # Improvement: If the primitive is defined as non-grabbable in the world,\n  # it cannot be collected. Return an empty list as no sequence of actions\n  # will achieve \"collection\" of this item.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n  \n  action_map = env.action_specs()\n  \n  MOVE_ACTIONS = [\n      action_map['UP'],\n      action_map['DOWN'],\n      action_map['LEFT'],\n      action_map['RIGHT']\n  ]\n  USE_ACTION = action_map['USE']\n\n  start_state = env._current_state\n  \n  # Initialize a Breadth-First Search (BFS) queue.\n  # The queue stores CraftState objects to explore.\n  queue = collections.deque([(start_state)])\n  \n  # The 'parent_map' stores information to reconstruct the path.\n  # Keys are (pos, dir) tuples representing a unique state (position and direction).\n  # Values are (action_taken_to_reach_this_state, parent_pos, parent_dir).\n  # This map also implicitly serves as the 'visited' set to avoid redundant computations,\n  # ensuring the shortest path in terms of steps.\n  start_key = (start_state.pos, start_state.dir)\n  parent_map = {start_key: (None, None, None)} # Start state has no parent action or parent state.\n  \n  goal_state_at_primitive_proximity = None # To store the CraftState from which the primitive can be collected.\n\n  # Perform BFS\n  while queue:\n    current_state = queue.popleft()\n    current_key = (current_state.pos, current_state.dir)\n    \n    # Check if the agent is currently next to the desired primitive.\n    if current_state.next_to(primitive_idx):\n      goal_state_at_primitive_proximity = current_state\n      break # Found the target location, exit BFS.\n\n    # Explore possible next states by trying all valid movement actions.\n    for action in MOVE_ACTIONS:\n      # Simulate the action to get the new state.\n      # CraftState.step creates a new state object, which is crucial for BFS.\n      _, new_state = current_state.step(action) \n      new_key = (new_state.pos, new_state.dir)\n      \n      # Only add to the queue if this new state (position and direction)\n      # has not been visited yet. This handles blocked moves and prevents cycles.\n      if new_key not in parent_map:\n        parent_map[new_key] = (action, current_state.pos, current_state.dir) # Store how we got to new_key from current_key.\n        queue.append(new_state)\n\n  # Reconstruct the path from the 'parent_map' if the goal was found.\n  if goal_state_at_primitive_proximity:\n    path = []\n    current_path_key = (goal_state_at_primitive_proximity.pos, goal_state_at_primitive_proximity.dir)\n    \n    # Backtrack from the goal state to the start state using the parent_map.\n    # The loop stops when we reach the start_key, which has a None parent action.\n    while current_path_key != start_key:\n      action_from_parent, parent_pos, parent_dir = parent_map[current_path_key]\n      path.append(action_from_parent)\n      current_path_key = (parent_pos, parent_dir)\n    \n    # The path is constructed in reverse order (from goal to start), so reverse it.\n    path.reverse()\n    \n    # The final action is always 'USE' once the primitive is in proximity.\n    return path + [USE_ACTION]\n  \n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:24:04.645361", "function_name": "collect", "function_body": "  primitive_idx = env.world.cookbook.index[primitive]\n\n  # If the primitive is defined as non-grabbable, it cannot be collected.\n  if primitive_idx in env.world.non_grabbable_indices:\n    return []\n  \n  action_map = env.action_specs()\n  \n  MOVE_ACTIONS = [\n      action_map['UP'],\n      action_map['DOWN'],\n      action_map['LEFT'],\n      action_map['RIGHT']\n  ]\n  USE_ACTION = action_map['USE']\n\n  start_state = env._current_state\n  # Use (position, direction) as the key for states in the BFS to correctly identify unique states.\n  start_state_key = (start_state.pos, start_state.dir)\n  \n  # The queue will store (CraftState instance, state_key)\n  queue = collections.deque([(start_state, start_state_key)])\n  \n  # parent_map stores (current_state_key) -> (action_to_reach_this_state, parent_state_key)\n  parent_map = {start_state_key: (None, None)} # Start state has no parent, no action to reach it.\n\n  goal_reached_state_key = None # To store the (pos, dir) key of the state from which the primitive can be collected.\n  \n  # Perform Breadth-First Search (BFS)\n  while queue:\n    current_state, current_state_key = queue.popleft()\n    \n    # Check if the agent is currently next to the desired primitive.\n    if current_state.next_to(primitive_idx):\n      goal_reached_state_key = current_state_key\n      break # Found the target state, exit BFS.\n\n    # Explore possible next states by trying all valid movement actions.\n    for action in MOVE_ACTIONS:\n      # Simulate the action to get the new state.\n      # CraftState.step creates a new state object, which is important for BFS.\n      _, new_state = current_state.step(action) \n      new_state_key = (new_state.pos, new_state.dir)\n      \n      # Only add to the queue if this new state (position and direction) has not been visited yet.\n      # This handles cases where a move is blocked (new_state_key == current_state_key)\n      # or prevents cycles and redundant exploration.\n      if new_state_key not in parent_map:\n        parent_map[new_state_key] = (action, current_state_key) # Store how we got to new_state_key from current_state_key.\n        queue.append((new_state, new_state_key))\n\n  # Reconstruct the path from the 'parent_map' if the goal was found.\n  if goal_reached_state_key:\n    path = []\n    current_path_key = goal_reached_state_key\n    \n    # Backtrack from the goal state key to the start state key using the parent_map.\n    while current_path_key != start_state_key:\n      action_from_parent, parent_key = parent_map[current_path_key]\n      path.append(action_from_parent)\n      current_path_key = parent_key\n    \n    # The path is constructed in reverse order (from goal to start), so reverse it.\n    path.reverse()\n    \n    # The final action is always 'USE' once the primitive is in proximity.\n    return path + [USE_ACTION]\n  \n  # If the queue becomes empty and no path to the primitive was found, return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:25:19.138874", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos # Agent's current position (x, y)\n  \n  # Grid shape is (WIDTH, HEIGHT, n_kinds)\n  grid_width, grid_height, _ = grid.shape \n\n  # Get the integer ID for the primitive.\n  # Convert primitive name to lowercase as cookbook.index likely stores them as such.\n  try:\n      primitive_id = env.world.cookbook.index.index(primitive.lower())\n  except KeyError:\n      # The primitive name is not recognized, so it cannot be collected.\n      return []\n\n  # Confirm if the primitive is actually a collectable resource.\n  # The `cookbook.primitives` set contains indices of items that can be collected\n  # (e.g., wood, stone, iron, etc.). If the requested primitive isn't in this set,\n  # it's not something this function should \"collect\" into inventory.\n  if primitive_id not in env.world.cookbook.primitives:\n      return [] # E.g., trying to collect \"WORKSHOP\" or \"BOUNDARY\"\n\n  # Get action mappings from the environment (e.g., {\"UP\": 1, \"DOWN\": 0, ...})\n  ACTION_MAP = env.action_specs()\n  ACTION_USE = ACTION_MAP['USE']\n\n  # Determine if the primitive is \"grabbable\" (can be picked up by walking onto its cell and USE)\n  # or if it's a \"resource\" that needs to be harvested from an adjacent cell (e.g., mining stone).\n  is_grabbable_pickup = primitive_id in env.world.grabbable_indices\n\n  # Define obstacles for pathfinding. These are cells the agent generally cannot walk onto.\n  # This includes boundaries, water, and other non-grabbable entities like stone blocks or trees.\n  unwalkable_obstacles = set(env.world.non_grabbable_indices)\n  try: unwalkable_obstacles.add(env.world.cookbook.index.index(\"boundary\"))\n  except KeyError: pass # \"boundary\" might not always be in non_grabbable_indices directly\n  try: unwalkable_obstacles.add(env.world.cookbook.index.index(\"water\"))\n  except KeyError: pass # \"water\" might not always be in non_grabbable_indices directly\n\n  # Define movement deltas (dx, dy) corresponding to actions.\n  # Using a list of (delta_x, delta_y, action_id) for easier iteration.\n  MOVES = [\n      (0, -1, ACTION_MAP[\"UP\"]),    # Move North (decrease Y)\n      (0, 1, ACTION_MAP[\"DOWN\"]),   # Move South (increase Y)\n      (-1, 0, ACTION_MAP[\"LEFT\"]),  # Move West (decrease X)\n      (1, 0, ACTION_MAP[\"RIGHT\"]),  # Move East (increase X)\n  ]\n  \n  # BFS setup:\n  # Queue stores tuples of (current_position_tuple, list_of_actions_taken_to_reach_here)\n  queue = collections.deque([(initial_pos, [])]) \n  # Set to keep track of visited (x, y) positions to avoid cycles and redundant paths.\n  visited = {initial_pos} \n\n  # Helper function to check if a position (x, y) is valid and traversable by the agent.\n  def is_traversable(x, y):\n      # Check grid boundaries.\n      if not (0 <= x < grid_width and 0 <= y < grid_height):\n          return False\n      \n      # Special case: If the target primitive is grabbable (meaning we walk onto it to pick it up)\n      # and the cell contains that primitive, then this cell IS traversable.\n      if is_grabbable_pickup and grid[x, y, primitive_id] > 0:\n          return True\n      \n      # For all other cases, check if the cell contains any general unwalkable obstacle.\n      for obstacle_idx in unwalkable_obstacles:\n          if grid[x, y, obstacle_idx] > 0:\n              return False # Cannot traverse this obstacle.\n      return True\n\n  # Perform Breadth-First Search\n  while queue:\n      (curr_x, curr_y), path = queue.popleft()\n\n      # Check if the current position is where we can collect the primitive.\n      # This depends on whether it's grabbable (on the cell) or harvested (adjacent).\n      \n      # Case 1: Primitive is grabbable (agent needs to be ON the cell and USE)\n      if is_grabbable_pickup:\n          if grid[curr_x, curr_y, primitive_id] > 0:\n              # Found the grabbable item at the current position, so collect it.\n              return path + [ACTION_USE]\n      # Case 2: Primitive is a resource to be harvested (agent needs to be ADJACENT and USE)\n      else: # This covers resources like STONE, WOOD, IRON, GRASS, ROCK, GOLD, GEM.\n          # Manually check the 3x3 neighborhood for the primitive (mimicking CraftState.next_to).\n          found_adjacent = False\n          for dx_offset in [-1, 0, 1]:\n              for dy_offset in [-1, 0, 1]:\n                  neighbor_x, neighbor_y = curr_x + dx_offset, curr_y + dy_offset\n                  # Ensure neighbor is within grid bounds.\n                  if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n                      # If the primitive is present in the neighbor cell (count > 0).\n                      if grid[neighbor_x, neighbor_y, primitive_id] > 0:\n                          found_adjacent = True\n                          break\n              if found_adjacent:\n                  break\n          \n          if found_adjacent:\n              # We are adjacent to the primitive resource, so collect it.\n              return path + [ACTION_USE]\n\n      # If the target condition is not met at the current position, explore neighbors.\n      for dx, dy, action_id in MOVES:\n          next_x, next_y = curr_x + dx, curr_y + dy\n          next_pos = (next_x, next_y)\n\n          # If the next position is valid, traversable, and hasn't been visited yet.\n          if is_traversable(next_x, next_y) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited.\n              # Add the next position to the queue with the updated path.\n              queue.append((next_pos, path + [action_id]))\n\n  # If the queue becomes empty and no path to collect the primitive was found, return an empty list.\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T14:25:19.164467", "function_name": "collect", "function_body": "    current_state = env._current_state\n    grid = current_state.grid\n    initial_pos = current_state.pos  # Agent's current position (x, y)\n    \n    grid_width, grid_height, n_kinds = grid.shape \n\n    ACTION_MAP = env.action_specs()\n    ACTION_USE = ACTION_MAP['USE']\n\n    # Map movement actions to (dx, dy) deltas based on grid[x, y] coordinates\n    # UP: decreases Y coordinate (row index)\n    # DOWN: increases Y coordinate (row index)\n    # LEFT: decreases X coordinate (column index)\n    # RIGHT: increases X coordinate (column index)\n    DELTAS = {\n        ACTION_MAP[\"UP\"]: (0, -1),    \n        ACTION_MAP[\"DOWN\"]: (0, 1),   \n        ACTION_MAP[\"LEFT\"]: (-1, 0),  \n        ACTION_MAP[\"RIGHT\"]: (1, 0),  \n    }\n    \n    # Get the integer ID for the primitive (e.g., \"WOOD\" -> \"wood\")\n    primitive_name = primitive.lower()\n    try:\n        primitive_id = env.world.cookbook.index.index(primitive_name) \n    except KeyError:\n        # If the primitive name is not known to the cookbook, we cannot find it.\n        return []\n\n    # Determine collection characteristics of the primitive\n    is_grabbable = primitive_id in env.world.grabbable_indices\n    # Check if the primitive is one of the workshop types (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2)\n    is_workshop = \"workshop\" in primitive_name \n\n    # Helper function to check if a position (x, y) is valid (within grid bounds) and walkable.\n    # A cell is unwalkable if it contains certain non-grabbable items that act as obstacles,\n    # UNLESS that item is the target workshop itself (which we need to walk onto).\n    def is_walkable(x, y):\n        # Check grid boundaries\n        if not (0 <= x < grid_width and 0 <= y < grid_height):\n            return False\n        \n        # Check if the cell contains any non-grabbable entity that acts as an obstacle.\n        # This covers items like \"boundary\", \"water\", \"stone\" blocks, etc., that typically block movement.\n        for obstacle_idx in env.world.non_grabbable_indices:\n            if grid[x, y, obstacle_idx] > 0: # If this non-grabbable item is present at (x,y)\n                # Special exception: If the obstacle is our specific target primitive AND\n                # that primitive is a workshop (which we are explicitly allowed to walk onto).\n                if obstacle_idx == primitive_id and is_workshop:\n                    continue # This cell is traversable because it's the target workshop.\n                else:\n                    return False # It's an obstacle we cannot walk onto.\n        return True\n\n    # Helper function to check if any cell in the 3x3 neighborhood around (curr_x, curr_y)\n    # contains the target primitive. This is used for non-grabbable resources like wood/stone\n    # that are collected from an adjacent cell using the USE action.\n    def is_primitive_adjacent(curr_x, curr_y, target_id):\n        for dx_offset in [-1, 0, 1]:\n            for dy_offset in [-1, 0, 1]:\n                neighbor_x, neighbor_y = curr_x + dx_offset, curr_y + dy_offset\n                # Ensure neighbor is within grid bounds\n                if 0 <= neighbor_x < grid_width and 0 <= neighbor_y < grid_height:\n                    # Check if the primitive is present in the neighbor cell (count > 0)\n                    if grid[neighbor_x, neighbor_y, target_id] > 0:\n                        return True\n        return False\n\n    # BFS (Breadth-First Search) for pathfinding\n    # The queue stores tuples of (current_position_tuple, list_of_actions_taken_to_reach_current_position).\n    queue = collections.deque([(initial_pos, [])]) \n    # Set to keep track of visited positions to avoid cycles and redundant paths.\n    visited = {initial_pos} \n\n    while queue:\n        (curr_x, curr_y), path = queue.popleft()\n\n        # Check if the current position satisfies the collection condition for the primitive.\n        \n        # Condition 1: Target is a Workshop (e.g., WORKSHOP0).\n        # Agent needs to reach and stand ON the workshop cell. No 'USE' action implied for \"collection\".\n        if is_workshop:\n            if grid[curr_x, curr_y, primitive_id] > 0:\n                return path # Return the path to the workshop cell.\n        \n        # Condition 2: Target is a Grabbable Resource (e.g., GRASS, or some dropped item).\n        # Agent needs to reach and stand ON the resource cell, then USE it.\n        elif is_grabbable: # This condition implies it's not a workshop\n            if grid[curr_x, curr_y, primitive_id] > 0:\n                return path + [ACTION_USE] # Return path to the cell + the USE action.\n\n        # Condition 3: Target is a Non-Grabbable Resource (e.g., WOOD, STONE, IRON, GOLD, GEM, ROCK).\n        # Agent needs to reach a cell ADJACENT to the resource, then USE it.\n        # This condition applies if the primitive is neither a workshop nor a directly grabbable item.\n        elif not is_workshop and not is_grabbable: \n            if is_primitive_adjacent(curr_x, curr_y, primitive_id):\n                return path + [ACTION_USE] # Return path to an adjacent cell + the USE action.\n\n        # If the primitive is not collected from the current position, explore valid neighbors.\n        for action_id, (dx, dy) in DELTAS.items():\n            next_x, next_y = curr_x + dx, curr_y + dy\n            next_pos = (next_x, next_y)\n\n            # If the next position is walkable and hasn't been visited yet, add it to the queue.\n            if is_walkable(next_x, next_y) and next_pos not in visited:\n                visited.add(next_pos) # Mark as visited\n                queue.append((next_pos, path + [action_id]))\n\n    # If the BFS queue becomes empty and no path to collect the primitive was found, return an empty list.\n    return []", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T14:26:21.948321", "function_name": "collect", "function_body": "  current_state = env._current_state\n  world = env.world  # Use a direct reference to world for cleaner access\n  cookbook_index = world.cookbook.index\n\n  # 1. Convert the string primitive name to its integer ID.\n  primitive_idx = cookbook_index[primitive]\n  if primitive_idx is None:\n      # If the primitive name is not found in the cookbook index, it cannot be collected.\n      return []\n\n  # 2. Verify if the primitive is a 'grabbable' item.\n  # The `collect` DSL action is intended for items that can be picked up into inventory.\n  # Non-grabbable items (e.g., WORKSHOPS, WATER, STONE, BOUNDARY) cannot be collected via `USE`.\n  if primitive_idx in world.non_grabbable_indices:\n      return []\n\n  # 3. Retrieve numeric action IDs from the environment's action specifications.\n  # This makes the code robust to changes in action mapping.\n  action_map = env.action_specs()\n  UP_ACTION = action_map['UP']\n  DOWN_ACTION = action_map['DOWN']\n  LEFT_ACTION = action_map['LEFT']\n  RIGHT_ACTION = action_map['RIGHT']\n  USE_ACTION = action_map['USE']\n\n  # 4. Check if the primitive is already in the agent's inventory.\n  # If so, no further actions are needed to collect it.\n  if current_state.inventory[primitive_idx] > 0:\n      return []\n\n  # 5. Optimization: Check if the primitive is immediately accessible (within the 3x3 neighborhood).\n  # If `next_to` is true, a single `USE_ACTION` is sufficient, avoiding pathfinding.\n  if current_state.next_to(primitive_idx):\n      return [USE_ACTION]\n\n  # 6. Initialize Breadth-First Search (BFS) for pathfinding.\n  # BFS is used to find the shortest sequence of movement actions to reach a collection point.\n  start_y, start_x = current_state.pos  # Agent's current (row, column) position\n  grid = current_state.grid\n  HEIGHT, WIDTH, _ = grid.shape\n\n  # BFS queue: Stores tuples of (current_y, current_x, list_of_actions_taken_to_reach_here).\n  q = collections.deque([(start_y, start_x, [])])\n  # Set to store visited grid cells, preventing cycles and redundant path exploration.\n  visited = {(start_y, start_x)}\n\n  # Define possible movement directions (change in y, change in x) and their corresponding actions.\n  move_deltas = [\n      (-1, 0, UP_ACTION),    # Move North (decrease row index)\n      (1, 0, DOWN_ACTION),   # Move South (increase row index)\n      (0, -1, LEFT_ACTION),  # Move West (decrease column index)\n      (0, 1, RIGHT_ACTION)   # Move East (increase column index)\n  ]\n\n  # Determine which entity kinds block agent movement.\n  # This set includes entities like water, stone, and boundaries that cannot be traversed.\n  # Note: Workshops are non-grabbable but are traversable by the agent.\n  impassable_for_movement_indices = set(world.non_grabbable_indices) - set(world.workshop_indices)\n\n  while q:\n      curr_y, curr_x, path_so_far = q.popleft()\n\n      # Check if the primitive is in the 3x3 neighborhood of the current cell.\n      # This is the \"goal\" condition for the BFS: finding a position from which `USE` can collect the item.\n      is_primitive_adjacent_to_current_pos = False\n      for dy_adj in [-1, 0, 1]:\n          for dx_adj in [-1, 0, 1]:\n              check_y, check_x = curr_y + dy_adj, curr_x + dx_adj\n              \n              # Ensure the neighboring coordinates are within grid boundaries.\n              if 0 <= check_y < HEIGHT and 0 <= check_x < WIDTH:\n                  # If the primitive is present at this specific neighboring location on the grid.\n                  if grid[check_y, check_x, primitive_idx] == 1:\n                      is_primitive_adjacent_to_current_pos = True\n                      break # Found primitive in neighborhood, no need to check others for this cell.\n          if is_primitive_adjacent_to_current_pos:\n              break\n\n      if is_primitive_adjacent_to_current_pos:\n          # If the current position allows collection, we've found the shortest path.\n          # Append the `USE_ACTION` to the movement path and return the complete action sequence.\n          return path_so_far + [USE_ACTION]\n\n      # If the primitive is not yet adjacent, explore adjacent cells for further movement.\n      for dy_move, dx_move, action_to_take in move_deltas:\n          next_y, next_x = curr_y + dy_move, curr_x + dx_move\n\n          # Check 1: Ensure the next cell is within the grid boundaries.\n          if not (0 <= next_y < HEIGHT and 0 <= next_x < WIDTH):\n              continue\n\n          # Check 2: Ensure the next cell has not been visited to prevent infinite loops and find shortest path.\n          if (next_y, next_x) in visited:\n              continue\n\n          # Check 3: Determine if the next cell is traversable (does not contain impassable terrain).\n          is_traversable = True\n          for kind_idx in impassable_for_movement_indices:\n              if grid[next_y, next_x, kind_idx] == 1:\n                  is_traversable = False\n                  break\n          \n          if is_traversable:\n              # If traversable, mark the cell as visited and add it to the queue for exploration,\n              # along with the path taken to reach it.\n              visited.add((next_y, next_x))\n              q.append((next_y, next_x, path_so_far + [action_to_take]))\n\n  # If the BFS completes and no path to a collection point (a cell adjacent to the primitive) was found,\n  # it means the primitive is either not on the map, or it is completely unreachable.\n  return []", "island_id": 6, "scores": {"3": 0.0}}
