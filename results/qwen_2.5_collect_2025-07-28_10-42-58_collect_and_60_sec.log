{"timestamp": "2025-07-28T12:50:57.188355", "function_name": "collect", "function_body": "  primitive_id = env.world.cookbook.index[primitive]\n\n  # Improvement for collect_v2:\n  # Before attempting to find and collect, check if the primitive is already in the agent's inventory.\n  # If the agent already possesses the primitive, no further actions are needed for collection.\n  if env._current_state.inventory[primitive_id] > 0:\n    return []\n\n  # Ensure the target primitive is actually \"grabbable\" (can be picked up or interacted with).\n  # Items like water, stone, or workshops are non-grabbable environment features.\n  # Attempting to \"collect\" them via the USE action doesn't make sense.\n  if primitive_id in env.world.non_grabbable_indices:\n    return []\n\n  # Get action mappings from the environment's action space.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  # Initialize a Breadth-First Search (BFS) for pathfinding.\n  # The queue will store tuples of (current_CraftState, list_of_actions_to_reach_this_state).\n  # The visited set keeps track of (agent_position, agent_direction) to prevent redundant exploration\n  # and infinite loops. The grid state itself doesn't change due to agent movement.\n  start_state = env._current_state\n  queue = collections.deque([(start_state, [])])\n  visited = {(start_state.pos, start_state.dir)}\n\n  # Perform BFS until the queue is empty or the goal is reached.\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # Check if the current state satisfies the goal: is the primitive within the agent's 3x3 neighborhood?\n    # If it is, the agent can use the 'USE' action to collect it.\n    if current_state.next_to(primitive_id):\n      # Goal reached: append the USE action to the discovered path and return the sequence.\n      return path_so_far + [USE]\n\n    # If the primitive is not yet adjacent, explore possible movement actions.\n    for action in MOVE_ACTIONS:\n      # Simulate taking the action from the current state.\n      # CraftState.step returns a new CraftState object, which is suitable for BFS.\n      # The reward is not considered for pathfinding in this context.\n      _reward, next_state_candidate = current_state.step(action)\n\n      next_pos = next_state_candidate.pos\n      next_dir = next_state_candidate.dir\n      next_state_identifier = (next_pos, next_dir)\n\n      # If this potential next state (defined by position and direction) has not been visited,\n      # add it to the queue for further exploration.\n      if next_state_identifier not in visited:\n        visited.add(next_state_identifier)\n        queue.append((next_state_candidate, path_so_far + [action]))\n\n  # If the BFS completes without finding a path to the primitive (i.e., the queue becomes empty),\n  # return an empty list, indicating the primitive is unreachable or not present.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:50:59.124369", "function_name": "collect", "function_body": "  try:\n    primitive_id = env.world.cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not found in the cookbook's index, it's an unknown item.\n    # This might happen if the provided 'primitive' string is not recognized by the current\n    # environment's loaded recipes/definitions. We cannot collect what is not identifiable.\n    return []\n\n  # Improvement from collect_v1: Add a check for non-grabbable entities.\n  # If the primitive is an entity that cannot be picked up (e.g., water, a workbench, or boundary),\n  # then attempting to \"collect\" it semantically does not make sense.\n  # In such cases, return an empty list of actions, indicating the task is not possible\n  # or is ill-defined for this type of primitive.\n  if primitive_id in env.world.non_grabbable_indices:\n    return []\n\n  # Get action mappings from the environment\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  MOVE_ACTIONS = [UP, DOWN, LEFT, RIGHT]\n\n  # Initialize BFS for pathfinding\n  # The queue stores tuples of (current_craft_state, list_of_actions_taken_to_reach_this_state).\n  # The visited set stores (agent_position, agent_direction) to avoid cycles and redundant exploration.\n  # For movement actions, the grid and inventory remain static, so (pos, dir) is a sufficient\n  # unique identifier for the agent's state in this pathfinding context.\n  start_state = env._current_state\n  queue = collections.deque([(start_state, [])])\n  visited = {(start_state.pos, start_state.dir)}\n\n  # BFS loop\n  while queue:\n    current_state, path_so_far = queue.popleft()\n\n    # Check if the current state satisfies the goal: is the primitive in the agent's 3x3 neighborhood?\n    # This is the condition for being able to \"USE\" and collect it.\n    if current_state.next_to(primitive_id):\n      # If yes, we have found the shortest path to a position adjacent to the primitive.\n      # Append the USE action and return the complete sequence of actions.\n      return path_so_far + [USE]\n\n    # If the primitive is not yet adjacent, explore possible movement actions from the current state.\n    for action in MOVE_ACTIONS:\n      # Simulate the step using the CraftState's step method.\n      # CraftState.step returns a *new* CraftState object, which is ideal for BFS as it\n      # represents a distinct state in the search space without modifying the original.\n      # The reward is not relevant for pathfinding here, so it's ignored.\n      _reward, next_state_candidate = current_state.step(action)\n\n      next_pos = next_state_candidate.pos\n      next_dir = next_state_candidate.dir\n      next_state_identifier = (next_pos, next_dir)\n\n      # If this next state (defined by position and direction) has not been visited before,\n      # add it to the queue to explore further.\n      if next_state_identifier not in visited:\n        visited.add(next_state_identifier)\n        queue.append((next_state_candidate, path_so_far + [action]))\n\n  # If the queue becomes empty and no path was found (i.e., the primitive is unreachable\n  # or does not exist on the grid), return an empty list, indicating failure to collect.\n  return []", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:51:37.242782", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  grid_height, grid_width, n_kinds = grid.shape\n\n  # Get the integer ID for the primitive (e.g., \"WOOD\" -> \"wood\")\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n\n  # Get action mappings from the environment\n  ACTION_MAP = env.action_specs()\n\n  # Define movement deltas corresponding to action IDs\n  DELTAS = {\n      ACTION_MAP[\"UP\"]: (-1, 0),\n      ACTION_MAP[\"DOWN\"]: (1, 0),\n      ACTION_MAP[\"LEFT\"]: (0, -1),\n      ACTION_MAP[\"RIGHT\"]: (0, 1),\n  }\n  \n  # Identify non-walkable indices for BFS pathfinding\n  unwalkable_indices = set()\n  try:\n      unwalkable_indices.add(env.world.cookbook.index[\"boundary\"])\n  except KeyError:\n      pass \n  try:\n      unwalkable_indices.add(env.world.cookbook.index[\"water\"])\n  except KeyError:\n      pass\n\n  # --- Improvement for collect_v2: Pre-compute walkable cells for efficiency ---\n  # Create a boolean grid where True means walkable, False means unwalkable.\n  walkable_map = np.ones((grid_height, grid_width), dtype=bool)\n  for unwalkable_idx in unwalkable_indices:\n      # Only process if the unwalkable_idx exists in the current grid's kind dimension\n      if unwalkable_idx < n_kinds: \n          # Mark cells containing unwalkable entities as False\n          walkable_map[grid[:, :, unwalkable_idx] > 0] = False\n\n  # BFS setup\n  queue = collections.deque([(initial_pos, [])]) # (current_position_tuple, list_of_actions_taken)\n  visited = {initial_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n  # Helper function to check if a position is valid (within grid bounds) and walkable\n  # This version utilizes the pre-computed walkable_map for faster checks.\n  def is_valid_and_walkable(r, c):\n      # Check grid boundaries and then consult the walkable_map\n      return 0 <= r < grid_height and 0 <= c < grid_width and walkable_map[r, c]\n\n  # Helper function to check if a position is \"next_to\" the target primitive\n  def check_next_to_primitive(r, c, target_id):\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              neighbor_r, neighbor_c = r + dr_offset, c + dc_offset\n              # Ensure neighbor is within grid bounds\n              if 0 <= neighbor_r < grid_height and 0 <= neighbor_c < grid_width:\n                  # Check if the primitive is present in the neighbor cell\n                  # Ensure target_id is valid for grid dimension\n                  if target_id < n_kinds and grid[neighbor_r, neighbor_c, target_id] > 0:\n                      return True\n      return False\n\n  # Perform BFS\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # Check if the current position is adjacent to (or on) the target primitive\n      if check_next_to_primitive(r, c, primitive_id):\n          # If so, we've found a path to get adjacent. The next action is 'USE'.\n          return path + [ACTION_MAP[\"USE\"]]\n\n      # Explore all possible movement actions from the current position\n      for action_id, (dr, dc) in DELTAS.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # If the next position is valid, walkable, and hasn't been visited yet\n          if is_valid_and_walkable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited\n              # Add to queue with the updated path\n              queue.append((next_pos, path + [action_id]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:51:39.341887", "function_name": "collect", "function_body": "  current_state = env._current_state\n  grid = current_state.grid\n  initial_pos = current_state.pos\n  grid_height, grid_width, n_kinds = grid.shape\n\n  # Get the integer ID for the primitive (e.g., \"WOOD\" -> \"wood\")\n  primitive_name = primitive.lower()\n  primitive_id = None\n  try:\n      primitive_id = env.world.cookbook.index[primitive_name]\n  except KeyError:\n      # If the primitive name is not recognized, it cannot be collected.\n      return []\n  \n  # --- Improvement: Check if the primitive is actually grabbable ---\n  # Primitives listed in Cookbook.primitives are usually grabbable, but some entities\n  # (like workshops, water, boundary) might be passed as 'primitive' in a general sense.\n  # CraftWorld explicitly tracks grabbable_indices. If the item is not grabbable,\n  # it cannot be collected by the agent using the 'USE' action.\n  if primitive_id not in env.world.grabbable_indices:\n      return []\n\n  # Get action mappings from the environment\n  ACTION_MAP = env.action_specs()\n\n  # Define movement deltas corresponding to action IDs\n  DELTAS = {\n      ACTION_MAP[\"UP\"]: (-1, 0),\n      ACTION_MAP[\"DOWN\"]: (1, 0),\n      ACTION_MAP[\"LEFT\"]: (0, -1),\n      ACTION_MAP[\"RIGHT\"]: (0, 1),\n  }\n  \n  # Identify non-walkable indices for BFS pathfinding\n  unwalkable_indices = set()\n  # Add known unwalkable terrain types if they exist in the cookbook index\n  for name in [\"boundary\", \"water\"]:\n      try:\n          unwalkable_indices.add(env.world.cookbook.index[name])\n      except KeyError:\n          pass # This item might not be defined in the current cookbook\n\n  # BFS setup\n  queue = collections.deque([(initial_pos, [])]) # (current_position_tuple, list_of_actions_taken)\n  visited = {initial_pos} # Set to keep track of visited positions to avoid cycles and redundant paths\n\n  # Helper function to check if a position is valid (within grid bounds) and walkable\n  def is_valid_and_walkable(r, c):\n      # Check grid boundaries\n      if not (0 <= r < grid_height and 0 <= c < grid_width):\n          return False\n      \n      # Check if the cell contains any unwalkable entity\n      for unwalkable_idx in unwalkable_indices:\n          if grid[r, c, unwalkable_idx] > 0: \n              return False\n      return True\n\n  # Helper function to check if a position is \"next_to\" the target primitive\n  # This mimics the CraftState.next_to method, checking the 3x3 neighborhood\n  def check_next_to_primitive(r, c, target_id):\n      for dr_offset in [-1, 0, 1]:\n          for dc_offset in [-1, 0, 1]:\n              neighbor_r, neighbor_c = r + dr_offset, c + dc_offset\n              # Ensure neighbor is within grid bounds\n              if 0 <= neighbor_r < grid_height and 0 <= neighbor_c < grid_width:\n                  # Check if the primitive is present in the neighbor cell\n                  if grid[neighbor_r, neighbor_c, target_id] > 0:\n                      return True\n      return False\n\n  # Perform BFS\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # Check if the current position is adjacent to (or on) the target primitive\n      # The agent needs to be able to \"USE\" it from this position.\n      if check_next_to_primitive(r, c, primitive_id):\n          # If so, we've found a path to get adjacent. The next action is 'USE'.\n          return path + [ACTION_MAP[\"USE\"]]\n\n      # Explore all possible movement actions from the current position\n      for action_id, (dr, dc) in DELTAS.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # If the next position is valid, walkable, and hasn't been visited yet\n          if is_valid_and_walkable(next_r, next_c) and next_pos not in visited:\n              visited.add(next_pos) # Mark as visited\n              # Add to queue with the updated path\n              queue.append((next_pos, path + [action_id]))\n\n  # If the queue becomes empty and no path to the primitive was found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:52:35.609897", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # Early exit: if the primitive is already in the agent's 3x3 neighborhood (including current cell),\n  # we can collect it immediately with USE.\n  if current_state.next_to(primitive_idx):\n      return [action_map['USE']]\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Pre-compute a set of all grid locations that contain the target primitive.\n  # This allows for O(1) average time lookup during the BFS.\n  primitive_locations_set = set()\n  for r in range(grid_height):\n      for c in range(grid_width):\n          if grid[r, c, primitive_idx] > 0:\n              primitive_locations_set.add((r, c))\n\n  # If there are no instances of the primitive on the grid, it's unreachable.\n  if not primitive_locations_set:\n      return []\n\n  # Define possible cardinal moves and their corresponding actions.\n  # These deltas will be used to explore neighbors in the BFS.\n  moves_delta = {\n      (0, 1): action_map['RIGHT'],\n      (0, -1): action_map['LEFT'],\n      (1, 0): action_map['DOWN'],\n      (-1, 0): action_map['UP'],\n  }\n\n  # Define the 3x3 neighborhood offsets (including the center).\n  # A cell (r,c) is a \"collection point\" if any cell in its 3x3 neighborhood contains the primitive.\n  collection_neighborhood_offsets = [\n      (-1, -1), (-1, 0), (-1, 1),\n      (0, -1),  (0, 0),  (0, 1),\n      (1, -1),  (1, 0),  (1, 1)\n  ]\n\n  # Get indices for impassable terrain (water and stone) to avoid pathfinding through them.\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # BFS Initialization:\n  # queue stores (r, c) tuples of positions to visit.\n  queue = collections.deque([(agent_r, agent_c)])\n  # path_info maps a position (r, c) to a tuple ((prev_r, prev_c), action_to_reach_r_c),\n  # allowing for path reconstruction by backtracking.\n  path_info = {(agent_r, agent_c): (None, None)} # Agent's starting position has no parent.\n  # visited set prevents redundant exploration and cycles.\n  visited = {(agent_r, agent_c)}\n\n  target_collection_point = None # This will store the first (closest) collection point found.\n\n  while queue:\n      r, c = queue.popleft()\n\n      # Check if the current position (r, c) is a valid \"collection point\".\n      # A collection point is any cell from which the agent can \"USE\" to get the primitive.\n      is_current_collection_point = False\n      for dr_adj, dc_adj in collection_neighborhood_offsets:\n          check_r, check_c = r + dr_adj, c + dc_adj\n          if (check_r, check_c) in primitive_locations_set:\n              is_current_collection_point = True\n              break\n      \n      # If we found a collection point, we have found the shortest path to it.\n      # Store it and break the BFS loop.\n      if is_current_collection_point:\n          target_collection_point = (r, c)\n          break \n\n      # Explore all cardinal neighbors from the current position.\n      for (dr, dc), action in moves_delta.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries.\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next position has already been visited.\n          if next_pos in visited:\n              continue\n\n          # Check if the next position contains any impassable terrain.\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[next_r, next_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # If the next position is valid, unvisited, and passable, add it to the queue\n          # and record its parent and the action taken to reach it.\n          visited.add(next_pos)\n          path_info[next_pos] = ((r, c), action)\n          queue.append(next_pos)\n  \n  # If a target collection point was found during the BFS, reconstruct the path.\n  if target_collection_point:\n      path = []\n      current = target_collection_point\n      # Backtrack from the target collection point to the agent's starting position.\n      while current != (agent_r, agent_c):\n          prev_pos, action_to_get_here = path_info[current]\n          path.append(action_to_get_here)\n          current = prev_pos\n      path.reverse() # The path was built in reverse order, so reverse it to get the correct sequence.\n\n      # Append the 'USE' action at the end, as the agent is now in a position to collect the primitive.\n      return path + [action_map['USE']]\n  \n  # If the queue becomes empty and no path to a collection point was found, the primitive is unreachable.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:52:37.709672", "function_name": "collect", "function_body": "", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:53:31.132301", "function_name": "collect", "function_body": "  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Map action IDs to (dr, dc) for pathfinding\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Retrieve primitive ID; assumes primitive is a valid name that exists in the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get relevant indices from the world configuration\n  # IMPROVEMENT 1: Convert non_grabbable_indices to a NumPy array once for efficient indexing.\n  # This optimizes the `is_blocked_for_movement` function below.\n  non_grabbable_indices_arr = np.array(list(env.world.non_grabbable_indices), dtype=int)\n  workshop_indices = set(env.world.workshop_indices) # Convert list to set for O(1) lookup\n  \n  # Determine if the target primitive is a workshop (requires agent to be adjacent)\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to determine if a given cell is blocked for movement.\n  # A cell is blocked if it is out of bounds or contains *any* non-grabbable item\n  # (e.g., water, stone, workshops).\n  # IMPROVEMENT 1 (continued): Use NumPy fancy indexing for faster check of non-grabbable items\n  # compared to iterating with a Python loop as in `collect_v1`.\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # 1. Check if the position is out of grid bounds.\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # 2. Check if the cell contains any non-grabbable entity.\n      # Only perform this check if there are actual non-grabbable indices to check against\n      # and if any of them are present at the given grid cell.\n      if non_grabbable_indices_arr.size > 0 and \\\n         np.any(grid[r, c, non_grabbable_indices_arr] > 0):\n          return True\n      return False\n      \n  # --- Define Target Positions for BFS ---\n  # These are the cells the agent needs to reach to interact with the primitive.\n  potential_target_positions = set()\n  \n  # Find all grid locations where the specific primitive (or workshop) is present.\n  # IMPROVEMENT 2: Use `np.argwhere` for finding all primitive locations on the grid.\n  # This is significantly more efficient than nested Python loops used in `collect_v1`\n  # for grabbable resources, and is consistent with how workshops are found.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n\n  if is_workshop_primitive:\n      # If the primitive is a workshop, the agent needs to move to a cell *adjacent* to it.\n      # Iterate over all found workshop locations.\n      for wr, wc in primitive_locations_on_grid:\n          # Check all 4 cardinal neighbors of the workshop.\n          for dr, dc in action_deltas.values(): \n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      # Iterate over all found primitive locations.\n      for r, c in primitive_locations_on_grid:\n          current_cell_pos = (r, c)\n          # Only consider it a target if the cell itself is not blocked for movement\n          # by other non-grabbable items (e.g., wood should not be on water and counted if water blocks movement).\n          if not is_blocked_for_movement(current_cell_pos):\n              potential_target_positions.add(current_cell_pos)\n\n  # If no reachable target positions are found, return an empty action list.\n  if not potential_target_positions:\n      return []\n\n  # --- BFS (Breadth-First Search) to find the shortest path to any target position ---\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to store visited positions to avoid cycles and redundant exploration, ensuring shortest path.\n  visited = {start_pos}\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in potential_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (within bounds, not previously visited, and not blocked),\n          # add it to the queue for further exploration.\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path was found, append the 'USE' action to collect/interact with the primitive.\n      # The 'USE' action (ID 4) is applied after reaching the target position.\n      actions = best_path + [4] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:53:33.065930", "function_name": "collect", "function_body": "  \"\"\"\n  Improved version of `collect_v1`.\n  Returns a list of actions to find and collect/interact with the primitive\n  passed in the function in the passed env.\n  This version distinguishes between grabbable resources (move onto) and\n  workshops (move next to), ensuring appropriate pathfinding for each.\n  It leverages NumPy's `argwhere` for efficient location finding.\n  \"\"\"\n  actions = []\n  \n  current_state = env._current_state\n  start_pos = current_state.pos\n  grid = current_state.grid\n  \n  # Map action IDs to (dr, dc) for pathfinding\n  # Action specs from CraftLab.action_specs(): DOWN: 0, UP: 1, LEFT: 2, RIGHT: 3, USE: 4\n  action_deltas = {\n      1: (-1, 0),  # UP\n      0: (1, 0),   # DOWN\n      2: (0, -1),  # LEFT\n      3: (0, 1)    # RIGHT\n  }\n  \n  rows, cols, _ = grid.shape\n\n  # Retrieve primitive ID; assumes primitive is a valid name that exists in the cookbook index.\n  primitive_id = env.world.cookbook.index[primitive]\n  \n  # Get relevant indices from the world configuration\n  # non_grabbable_indices is already a set (for O(1) lookups)\n  non_grabbable_indices = env.world.non_grabbable_indices \n  # workshop_indices is a list, convert to set for O(1) lookups\n  workshop_indices = set(env.world.workshop_indices) \n  \n  # Determine if the target primitive is a workshop (requires being adjacent to use)\n  is_workshop_primitive = primitive_id in workshop_indices\n\n  # Helper function to determine if a given cell is blocked for movement.\n  # A cell is blocked if it is out of bounds or contains *any* non-grabbable item\n  # (e.g., water, stone, workshops).\n  def is_blocked_for_movement(pos):\n      r, c = pos\n      # 1. Check if the position is out of grid bounds.\n      if not (0 <= r < rows and 0 <= c < cols):\n          return True \n      \n      # 2. Check if the cell contains any non-grabbable entity.\n      # Iterate through the known non-grabbable kind IDs.\n      for k_idx in non_grabbable_indices:\n          # If this specific non-grabbable kind is present at the position (count > 0),\n          # then the cell is blocked for agent movement.\n          if grid[r, c, k_idx] > 0:\n              return True\n      return False\n      \n  # --- Define Target Positions for BFS ---\n  # These are the cells the agent needs to reach to interact with the primitive.\n  potential_target_positions = set()\n  \n  # Find all grid locations where the primitive (or workshop) is present using NumPy.\n  primitive_locations_on_grid = np.argwhere(grid[:, :, primitive_id] > 0)\n\n  if is_workshop_primitive:\n      # If the primitive is a workshop, the agent needs to move to a cell *adjacent* to it.\n      # For each workshop location found, identify its valid, unblocked neighbors.\n      for wr, wc in primitive_locations_on_grid:\n          for dr, dc in action_deltas.values(): # Iterate over (dr, dc) for cardinal neighbors\n              nr, nc = wr + dr, wc + dc\n              neighbor_pos = (nr, nc)\n              \n              # A neighbor is a valid target if it's within bounds and not blocked for movement.\n              if not is_blocked_for_movement(neighbor_pos): \n                  potential_target_positions.add(neighbor_pos)\n  else:\n      # If the primitive is a grabbable resource (e.g., WOOD, IRON),\n      # the agent needs to move *onto* the cell containing the resource.\n      # Iterate over the found locations of the primitive.\n      for r, c in primitive_locations_on_grid:\n          current_cell_pos = (r, c)\n          # Only consider it a target if the cell itself is not blocked for movement\n          # by other non-grabbable items (e.g., wood on water is not reachable).\n          if not is_blocked_for_movement(current_cell_pos):\n              potential_target_positions.add(current_cell_pos)\n\n  # If no reachable target positions are found, return an empty action list.\n  if not potential_target_positions:\n      return []\n\n  # --- BFS to find the shortest path to any target position ---\n  # Queue stores tuples of (current_position, path_of_actions_to_reach_here)\n  q = collections.deque([(start_pos, [])]) \n  # Set to store visited positions to avoid cycles and redundant exploration, ensuring shortest path.\n  visited = {start_pos}\n  \n  path_found = False\n  best_path = []\n  \n  while q:\n      (r, c), path_so_far = q.popleft()\n\n      # If the current position is one of the target positions, we've found the shortest path.\n      if (r, c) in potential_target_positions:\n          path_found = True\n          best_path = path_so_far\n          break \n\n      # Explore neighbors\n      for action_id, (dr, dc) in action_deltas.items():\n          nr, nc = r + dr, c + dc\n          new_pos = (nr, nc)\n\n          # If the new position is valid (within bounds, not previously visited, and not blocked),\n          # add it to the queue for further exploration.\n          if new_pos not in visited and not is_blocked_for_movement(new_pos):\n              visited.add(new_pos)\n              q.append((new_pos, path_so_far + [action_id]))\n              \n  if path_found:\n      # If a path was found, append the 'USE' action to collect/interact with the primitive.\n      # The 'USE' action (ID 4) is applied after reaching the target position.\n      actions = best_path + [4] \n  \n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:54:40.721326", "function_name": "collect", "function_body": "  actions_list = []\n\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  current_state = env._current_state\n  current_pos = current_state.pos # (y, x) tuple representing agent's current position\n  current_grid = current_state.grid # The full grid as a numpy array (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, _ = current_grid.shape\n\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # Define cardinal directions for neighbors, useful for both checking and BFS\n  cardinal_dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)] # (dy, dx) offsets for Up, Down, Left, Right\n\n  # 1. Improved Early Exit: Check if the agent is already cardinally adjacent to the desired primitive.\n  # This assumes 'USE' action typically requires cardinal adjacency.\n  is_cardinally_adjacent = False\n  for dy, dx in cardinal_dirs:\n      adj_y, adj_x = current_pos[0] + dy, current_pos[1] + dx\n      # Check bounds for the adjacent cell\n      if 0 <= adj_y < grid_height and 0 <= adj_x < grid_width:\n          if current_grid[adj_y, adj_x, primitive_idx] == 1:\n              is_cardinally_adjacent = True\n              break\n  \n  if is_cardinally_adjacent:\n      if is_grabbable:\n          # If already cardinally next to a grabbable item, simply use it.\n          return [USE]\n      else:\n          # If already cardinally next to a non-grabbable item (e.g., workshop),\n          # no further actions are needed to \"collect\" it in this context.\n          return []\n\n  # 2. Scan the entire grid to find all occurrences of the primitive.\n  primitive_locations = []\n  for y in range(grid_height):\n      for x in range(grid_width):\n          # Check if the current grid cell contains the target primitive\n          if current_grid[y, x, primitive_idx] == 1:\n              primitive_locations.append((y, x))\n\n  # If the primitive is not found anywhere on the grid, there's nothing to collect.\n  if not primitive_locations:\n      return []\n\n  # 3. Improvement: Pre-calculate the set of all valid target cells for the BFS.\n  # A target cell is any cell that is cardinally adjacent to a primitive location\n  # and is also traversable by the agent (not water).\n  target_cells_to_reach = set()\n  water_idx = env.world.water_index # Index for impassable \"water\" terrain.\n\n  for p_y, p_x in primitive_locations:\n      for dy, dx in cardinal_dirs:\n          adj_y, adj_x = p_y + dy, p_x + dx\n          # Ensure the adjacent cell is within grid boundaries.\n          if 0 <= adj_y < grid_height and 0 <= adj_x < grid_width:\n              # Ensure the adjacent cell is traversable (not water).\n              if current_grid[adj_y, adj_x, water_idx] == 0: # 0 means no water in this cell\n                  target_cells_to_reach.add((adj_y, adj_x))\n  \n  # If no traversable cells adjacent to any primitive are found, it's impossible to reach.\n  if not target_cells_to_reach:\n      return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  # to any cell in the pre-calculated `target_cells_to_reach` set.\n  # The queue stores tuples of (current_coordinates, path_taken_to_reach_here).\n  q = collections.deque([(current_pos, [])])\n  # The visited set keeps track of (y, x) coordinates already explored to prevent cycles.\n  visited = {current_pos}\n\n  # Map (dy, dx) moves to their corresponding action IDs.\n  moves_and_actions = {\n      (-1, 0): UP,\n      (1, 0): DOWN,\n      (0, -1): LEFT,\n      (0, 1): RIGHT,\n  }\n\n  while q:\n      (curr_y, curr_x), path = q.popleft()\n\n      # Check if the current BFS node (curr_y, curr_x) is one of the target cells.\n      if (curr_y, curr_x) in target_cells_to_reach:\n          if is_grabbable:\n              # Path has been found to a cell adjacent to the primitive.\n              # For grabbable items, follow the path then USE.\n              return path + [USE]\n          else:\n              # For non-grabbable items, reaching an adjacent cell is sufficient.\n              return path\n\n      # Explore all valid neighboring cells from the current position.\n      for (dy, dx), action in moves_and_actions.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_coords = (next_y, next_x)\n\n          # Ensure the next coordinates are within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Ensure the next cell is not impassable (e.g., water).\n          if current_grid[next_y, next_x, water_idx] == 1:\n              continue\n\n          # If the next cell has not been visited yet, add it to the queue\n          # with the updated path.\n          if next_coords not in visited:\n              visited.add(next_coords)\n              q.append((next_coords, path + [action]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:54:43.310196", "function_name": "collect", "function_body": "  actions_list = []\n\n  # 1. Get the integer ID of the primitive\n  # The DSL ensures 'primitive' is a valid string (e.g., 'WOOD', 'STONE').\n  # The `cookbook.index.index` method will return a positive integer ID (>= 1) for\n  # all defined primitive types, potentially adding it to the index if not present.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get action mappings for clarity and direct use\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get current state details from the environment's internal state\n  current_state = env._current_state\n  current_pos = current_state.pos # (y, x) tuple representing agent's current position\n  current_grid = current_state.grid # The full grid as a numpy array (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Determine if the primitive is a 'grabbable' item (requiring a USE action)\n  # or a 'non-grabbable' one (like a workshop, where proximity is enough).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # 2. Check if the agent is already adjacent to the desired primitive.\n  # CraftState.next_to checks the 3x3 neighborhood around the agent's position.\n  # If already next to it, perform the necessary action immediately.\n  if current_state.next_to(primitive_idx):\n      if is_grabbable:\n          # If already next to a grabbable item, simply use it.\n          return [USE]\n      else:\n          # If already next to a non-grabbable item (e.g., workshop),\n          # no further actions are needed to \"collect\" it in this context.\n          return []\n\n  # 3. Scan the entire grid to find all occurrences of the primitive.\n  primitive_locations = []\n  for y in range(grid_height):\n      for x in range(grid_width):\n          # Check if the current grid cell contains the target primitive\n          if current_grid[y, x, primitive_idx] == 1:\n              primitive_locations.append((y, x))\n\n  # If the primitive is not found anywhere on the grid, there's nothing to collect.\n  if not primitive_locations:\n      return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  # to a cell that is within the 3x3 neighborhood of any primitive location.\n  # The queue stores tuples of (current_coordinates, path_taken_to_reach_here).\n  q = collections.deque([(current_pos, [])])\n  # The visited set keeps track of (y, x) coordinates already explored to prevent cycles.\n  visited = {current_pos}\n\n  # Define possible cardinal moves and their corresponding actions.\n  moves = {\n      (-1, 0): UP,    # Move Up (decrement row)\n      (1, 0): DOWN,   # Move Down (increment row)\n      (0, -1): LEFT,  # Move Left (decrement column)\n      (0, 1): RIGHT, # Move Right (increment column)\n  }\n\n  # Identify the index for water, which is considered an impassable terrain.\n  water_idx = env.world.water_index\n\n  while q:\n      (curr_y, curr_x), path = q.popleft()\n\n      # For each primitive location, check if the current BFS node (curr_y, curr_x)\n      # is such that the primitive is within its 3x3 neighborhood.\n      # This means abs(curr_y - p_y) <= 1 and abs(curr_x - p_x) <= 1,\n      # which covers cardinal and diagonal adjacency, as well as being on the same cell.\n      # This is consistent with CraftState.next_to, which checks the 3x3 area.\n      for p_y, p_x in primitive_locations:\n          if abs(curr_y - p_y) <= 1 and abs(curr_x - p_x) <= 1:\n              # A path has been found to a cell from which the primitive can be 'used'.\n              if is_grabbable:\n                  # If the item is grabbable, the sequence of actions includes\n                  # moving to this cell and then performing the USE action.\n                  return path + [USE]\n              else:\n                  # If the item is non-grabbable (e.g., a workshop),\n                  # simply reaching this cell (where it's 'next_to') is sufficient to \"collect\" it.\n                  return path\n\n      # Explore all valid neighboring cells from the current position.\n      for (dy, dx), action in moves.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_coords = (next_y, next_x)\n\n          # Ensure the next coordinates are within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Ensure the next cell is not impassable (e.g., water).\n          # It's assumed that primitive types other than water are generally traversable\n          # unless explicitly stated otherwise.\n          if current_grid[next_y, next_x, water_idx] == 1:\n              continue\n\n          # If the next cell has not been visited yet, add it to the queue\n          # with the updated path.\n          if next_coords not in visited:\n              visited.add(next_coords)\n              q.append((next_coords, path + [action]))\n\n  # If the queue becomes empty and no path was found, return an empty list.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:55:59.365446", "function_name": "collect", "function_body": "  state = env._current_state\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = env.world.cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in index, cannot collect\n    return []\n\n  # Define which primitives require a 'USE' action for collection/interaction.\n  # This includes grabbable items (e.g., WOOD, STONE) and workshops (e.g., BENCH, WORKSHOP0).\n  # Items like WATER or BOUNDARY typically don't require USE to be \"collected\" (i.e., interacted with).\n  use_required_kinds = env.world.grabbable_indices.union(env.world.workshop_indices)\n  requires_use_action = primitive_idx in use_required_kinds\n\n  # Get action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  start_pos = state.pos  # Agent's current position (row, col)\n  grid = state.grid      # Current grid layout (WIDTH, HEIGHT, n_kinds)\n  \n  grid_width_rows, grid_height_cols, _ = grid.shape\n\n  # --- Handle immediate collection/interaction ---\n  # Case 1: If the primitive requires 'USE' and the agent is already in a position to use it.\n  # This uses state.next_to, which checks the 3x3 neighborhood (including the current cell).\n  if requires_use_action and state.next_to(primitive_idx):\n      return [ACTION_USE]\n  \n  # Case 2: If the primitive does NOT require 'USE' and the agent is already ON the primitive.\n  # This covers items like 'WATER' or 'BOUNDARY' where simply being on the square is sufficient for \"collection\".\n  r_curr, c_curr = start_pos\n  if not requires_use_action and grid[r_curr, c_curr, primitive_idx] == 1:\n      return [] # Already \"collected\" by being on the square, no actions needed.\n\n  # --- BFS Pathfinding Setup ---\n  q = collections.deque()\n  # Queue stores tuples: (current_position (row, col), list_of_actions_to_reach_here)\n  q.append((start_pos, []))\n\n  visited = {start_pos} # Set of positions (row, col) already visited\n\n  # Define possible moves and their corresponding actions\n  moves = {\n      (-1, 0): ACTION_UP,    # Decrement row for UP\n      (1, 0): ACTION_DOWN,   # Increment row for DOWN\n      (0, -1): ACTION_LEFT,  # Decrement col for LEFT\n      (0, 1): ACTION_RIGHT,  # Increment col for RIGHT\n  }\n\n  # --- BFS Pathfinding Loop ---\n  while q:\n    (r, c), path = q.popleft() # Current position and path to reach it\n\n    # Explore neighbors\n    for (dr, dc), action_id in moves.items():\n      next_r, next_c = r + dr, c + dc\n      next_pos = (next_r, next_c)\n\n      # Check bounds: ensure next_pos is within the grid\n      if not (0 <= next_r < grid_width_rows and 0 <= next_c < grid_height_cols):\n        continue\n\n      # Check if this position has already been visited\n      if next_pos in visited:\n        continue\n\n      # Mark as visited and add to queue\n      visited.add(next_pos)\n      new_path = path + [action_id] # Path to reach next_pos\n\n      # Check if this neighbor cell contains the target primitive\n      if grid[next_r, next_c, primitive_idx] == 1:\n        # Target primitive found!\n        \n        # Determine the final action based on whether 'USE' is required\n        if requires_use_action:\n          # Agent needs to move to next_pos, and then use the item (which is now in its 3x3 neighborhood)\n          return new_path + [ACTION_USE]\n        else:\n          # For primitives that don't require USE, just reaching the location (i.e., being on the square) is enough.\n          return new_path\n      \n      # If not the target, add the new position and its path to the queue for further exploration\n      q.append((next_pos, new_path))\n\n  # If the queue becomes empty and no path was found to the primitive\n  return []", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:56:01.286418", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:57:27.863975", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get action mappings\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found, cannot collect\n    return []\n\n  # Determine properties of the primitive\n  is_grabbable = primitive_idx in world.grabbable_indices\n  is_water_target = primitive_idx == world.water_index\n  is_workshop_target = primitive_idx in world.workshop_indices\n\n  # Grid dimensions\n  grid = state.grid\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Define movement actions and their effects on (dr, dc, new_dir_value)\n  # The new_dir_value corresponds to the agent's internal state.dir (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  action_moves = {\n      ACTION_UP:    (-1, 0, 0), # Move UP (row-1, col), agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),  # Move DOWN (row+1, col), agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3), # Move LEFT (row, col-1), agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),  # Move RIGHT (row, col+1), agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell based on agent's direction (for ACTION_USE)\n  dir_to_target_delta = {\n      0: (-1, 0),  # Agent facing UP (dir 0) targets cell above (r-1, c)\n      1: (0, 1),   # Agent facing RIGHT (dir 1) targets cell to the right (r, c+1)\n      2: (1, 0),   # Agent facing DOWN (dir 2) targets cell below (r+1, c)\n      3: (0, -1),  # Agent facing LEFT (dir 3) targets cell to the left (r, c-1)\n  }\n\n  start_pos = state.pos  # Agent's current position (row, col)\n  start_dir = state.dir  # Agent's current facing direction (int: 0-3)\n\n  # Helper function to check if a position is adjacent to a kind (similar to CraftState.next_to)\n  def _is_adjacent_to_kind(grid_data, agent_r, agent_c, target_kind_idx, R_MAX, C_MAX):\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_adj, agent_c + dc_adj\n              # Check bounds\n              if 0 <= check_r < R_MAX and 0 <= check_c < C_MAX:\n                  # Check if the target_kind_idx is present at this neighbor cell\n                  if grid_data[check_r, check_c, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # BFS setup\n  q = collections.deque()\n  # Queue stores tuples: (current_pos_r, current_pos_c, current_dir, list_of_actions_to_reach_here)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n\n  # Visited set: (pos_r, pos_c, current_dir) to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Obstacle definition: Any non-grabbable entity that is NOT the primitive we are trying to collect.\n  # If the primitive itself is a non-grabbable item (e.g., WATER, WORKSHOP),\n  # we need to be able to move onto its cell or adjacent to it, so it's not an obstacle in this case.\n  obstacle_kinds_set = set(world.non_grabbable_indices)\n  obstacle_kinds_set.discard(primitive_idx) # Remove the target primitive from obstacles if it's non-grabbable and traversable/interactable\n\n  while q:\n    r, c, current_dir, path = q.popleft()\n\n    # --- Check for collection at current (r, c, current_dir) state ---\n    # This covers cases where the agent starts already able to collect or reaches a collection point.\n\n    # Case 1: Grabbable item. Needs to be facing it and use.\n    if is_grabbable:\n        # Calculate the cell directly in front of the agent\n        target_dr, target_dc = dir_to_target_delta[current_dir]\n        target_r, target_c = r + target_dr, c + target_dc\n\n        # Check if this target cell is within bounds and contains the primitive\n        if (0 <= target_r < GRID_ROWS and 0 <= target_c < GRID_COLS and\n            grid[target_r, target_c, primitive_idx] == 1):\n            # Found a state where agent can use the primitive. Append USE action.\n            return path + [ACTION_USE]\n\n    # Case 2: Non-grabbable, \"move-onto\" type (e.g., WATER, or STONE if not grabbable)\n    # This applies if the primitive is not grabbable AND it's not a workshop.\n    elif not is_grabbable and not is_workshop_target:\n        if grid[r, c, primitive_idx] == 1: # Agent is on the primitive's cell\n            return path\n    \n    # Case 3: Non-grabbable, \"adjacent-to\" type (e.g., WORKSHOP)\n    elif is_workshop_target:\n        # Check if current position (r, c) is adjacent to the workshop\n        if _is_adjacent_to_kind(grid, r, c, primitive_idx, GRID_ROWS, GRID_COLS):\n            return path\n\n    # --- Explore neighbors by taking movement actions ---\n    for action_id, (dr_move, dc_move, new_dir) in action_moves.items():\n      next_r, next_c = r + dr_move, c + dc_move\n      next_state_dir = new_dir\n\n      # Check bounds\n      if not (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS):\n        continue\n\n      # Check if this (position, direction) state has already been visited\n      if (next_r, next_c, next_state_dir) in visited:\n        continue\n\n      # Obstacle check: is the next cell blocked by an uncollectable non-grabbable?\n      is_blocked = False\n      for k_idx in obstacle_kinds_set:\n          if grid[next_r, next_c, k_idx] > 0:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue\n\n      new_path = path + [action_id]\n      visited.add((next_r, next_c, next_state_dir))\n      q.append((next_r, next_c, next_state_dir, new_path))\n\n  # If the queue becomes empty and no path was found to collect the primitive\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:57:29.770505", "function_name": "collect", "function_body": "  def _check_next_to_at_pos(grid, pos, kind_idx, WIDTH, HEIGHT):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around `pos` contains `kind_idx`.\n      This is a generalized version of CraftState.next_to for an arbitrary position.\n      \"\"\"\n      cx, cy = pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = cx + dx, cy + dy\n              # Check bounds\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  # Check if the kind_idx is present at this neighbor cell\n                  # We use `> 0` to check for presence, as inventory/grid cells can store counts.\n                  if grid[nx, ny, kind_idx] > 0:\n                      return True\n      return False\n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in index, cannot collect\n    return []\n\n  # Determine if the primitive is grabbable (requires 'USE' action and specific orientation)\n  is_grabbable = primitive_idx in world.grabbable_indices\n\n  # If it's a grabbable item and already in inventory, no need to collect\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n      return []\n\n  # Current state details\n  start_pos = state.pos  # Agent's current position (row, col)\n  start_dir = state.dir  # Agent's current facing direction (int: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  grid = state.grid      # Current grid layout (WIDTH, HEIGHT, n_kinds)\n  \n  grid_rows, grid_cols, _ = grid.shape # Dimensions of the grid\n\n  # Define movement actions and their effects on (dr, dc, new_dir_value)\n  # The new_dir_value corresponds to the agent's internal state.dir\n  action_moves = {\n      ACTION_UP:    (-1, 0, 0), # Move UP (dr=-1, dc=0), agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),  # Move DOWN (dr=1, dc=0), agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3), # Move LEFT (dr=0, dc=-1), agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),  # Move RIGHT (dr=0, dc=1), agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell based on agent's direction (for ACTION_USE)\n  dir_to_target_delta = {\n      0: (-1, 0),  # Agent facing UP (dir 0) targets cell above (r-1, c)\n      1: (0, 1),   # Agent facing RIGHT (dir 1) targets cell to the right (r, c+1)\n      2: (1, 0),   # Agent facing DOWN (dir 2) targets cell below (r+1, c)\n      3: (0, -1),  # Agent facing LEFT (dir 3) targets cell to the left (r, c-1)\n  }\n\n  # Obstacle kinds are non-grabbable entities that the agent cannot typically move onto.\n  # These are generally the items in `world.non_grabbable_indices`.\n  obstacle_kinds = world.non_grabbable_indices\n\n  # --- Handle immediate collection if agent is already in a state to collect ---\n  if is_grabbable:\n      # Calculate the cell directly in front of the agent\n      target_dr, target_dc = dir_to_target_delta[start_dir]\n      target_r, target_c = start_pos[0] + target_dr, start_pos[1] + target_dc\n\n      # Check if this target cell is within bounds and contains the primitive\n      if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n          grid[target_r, target_c, primitive_idx] > 0): \n          return [ACTION_USE] # Agent just needs to perform USE action\n  else:\n      # For non-grabbable items, being adjacent or on it is considered \"collected\"\n      if _check_next_to_at_pos(grid, start_pos, primitive_idx, grid_rows, grid_cols):\n          return [] # Already \"collected\" by being adjacent\n\n  # --- BFS Pathfinding Loop ---\n  q = collections.deque()\n  # Queue stores tuples: (current_pos_r, current_pos_c, current_dir, list_of_actions_to_reach_here)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n\n  # Visited set: (pos_r, pos_c, current_dir) to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    r, c, current_dir, path = q.popleft() # Current position, direction, and path to reach it\n\n    # Explore neighbors by taking movement actions\n    for action_id, (dr, dc, new_facing_dir) in action_moves.items():\n      next_r, next_c = r + dr, c + dc\n      next_dir = new_facing_dir # Agent's direction after this movement action\n\n      # Check bounds: ensure the new agent position is within the grid\n      if not (0 <= next_r < grid_rows and 0 <= next_c < grid_cols):\n        continue\n\n      # Check if the new position is an obstacle (cannot move onto it)\n      is_obstacle_at_next_pos = False\n      for k_idx in obstacle_kinds:\n          if grid[next_r, next_c, k_idx] > 0: # Check if any obstacle is present at next_pos\n              is_obstacle_at_next_pos = True\n              break\n      if is_obstacle_at_next_pos:\n          continue # Cannot move onto an obstacle\n\n      # Check if this (position, direction) state has already been visited\n      if (next_r, next_c, next_dir) in visited:\n        continue\n\n      new_path = path + [action_id]\n      visited.add((next_r, next_c, next_dir)) # Mark new state as visited\n\n      # --- Check if the primitive is collectable from this new state ---\n      if is_grabbable:\n          # For grabbable items, the agent must move to an adjacent cell and then USE it.\n          # Calculate the cell directly in front of the agent at its new position and direction\n          target_dr, target_dc = dir_to_target_delta[next_dir]\n          target_r, target_c = next_r + target_dr, next_c + target_dc\n\n          # Check if this target cell is within bounds and contains the primitive\n          if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n              grid[target_r, target_c, primitive_idx] > 0): \n              # Found a state where agent can use the primitive. Append USE action.\n              return new_path + [ACTION_USE]\n      else:\n          # For non-grabbable items, being adjacent to the primitive at the new position is sufficient.\n          if _check_next_to_at_pos(grid, (next_r, next_c), primitive_idx, grid_rows, grid_cols):\n              # Found a path to be adjacent to the primitive\n              return new_path\n      \n      # If not yet collected, add this new state to the queue for further exploration\n      q.append((next_r, next_c, next_dir, new_path))\n\n  # If the queue becomes empty and no path was found to collect the primitive\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:58:55.456067", "function_name": "collect", "function_body": "  # Helper function to get actions to turn from current_dir to target_dir\n  def _get_turn_actions(current_dir, target_dir, action_map):\n      actions = []\n      if current_dir == target_dir:\n          return actions\n      \n      # Directions are typically mapped as: 0=UP (North), 1=RIGHT (East), 2=DOWN (South), 3=LEFT (West)\n      # Calculate the shortest turn direction (clockwise or counter-clockwise)\n      # The modulo 4 ensures we stay within 0-3 range\n      diff = (target_dir - current_dir + 4) % 4 \n      if diff == 1: # 90 degrees clockwise turn\n          actions.append(action_map['RIGHT'])\n      elif diff == 2: # 180 degrees turn (two 90-degree turns in either direction)\n          actions.append(action_map['RIGHT'])\n          actions.append(action_map['RIGHT'])\n      elif diff == 3: # 90 degrees counter-clockwise turn\n          actions.append(action_map['LEFT'])\n      return actions\n\n  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  agent_r, agent_c = current_state.pos\n  initial_dir = current_state.dir\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Unified mapping for movement deltas (dr, dc) to agent's facing direction index.\n  # This mapping is used for:\n  # 1. Determining the agent's new direction after a move.\n  # 2. Determining the required agent direction to face an adjacent object for 'USE'.\n  DIR_MAPPING = {\n      (-1, 0): 0,  # Moving/facing UP (row decreases)\n      (0, 1): 1,   # Moving/facing RIGHT (column increases)\n      (1, 0): 2,   # Moving/facing DOWN (row increases)\n      (0, -1): 3,  # Moving/facing LEFT (column decreases)\n  }\n\n  # Identify indices of entities that block movement (e.g., water, stone).\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # --- Initial check: Is the primitive already adjacent and usable from the current position? ---\n  # Iterate through all 4 cardinal directions relative to the agent.\n  for (dr_adj, dc_adj), target_face_dir in DIR_MAPPING.items():\n      adj_r, adj_c = agent_r + dr_adj, agent_c + dc_adj\n      \n      # Ensure the adjacent cell is within grid boundaries.\n      if not (0 <= adj_r < grid_height and 0 <= adj_c < grid_width):\n          continue\n      \n      # Check if the adjacent cell contains the target primitive.\n      if grid[adj_r, adj_c, primitive_idx] > 0:\n          # Primitive is immediately adjacent. Calculate turns and return USE action.\n          turn_actions = _get_turn_actions(initial_dir, target_face_dir, action_map)\n          return turn_actions + [action_map['USE']]\n\n  # --- Breadth-First Search (BFS) for pathfinding to a primitive ---\n  # The queue for BFS stores tuples: (current_position (r, c), current_direction, path_taken_so_far)\n  queue = collections.deque([((agent_r, agent_c), initial_dir, [])])\n  \n  # The visited set stores (position (r, c), direction) to prevent revisiting the same state\n  # and finding non-optimal paths or getting stuck in cycles.\n  visited = {(agent_r, agent_c, initial_dir)}\n\n  while queue:\n      (r, c), current_path_dir, path = queue.popleft() # Dequeue the current state\n\n      # Explore all four possible cardinal movements from the current position.\n      for (dr_move, dc_move), move_action_id in [\n          ((-1, 0), action_map['UP']),    # Move UP\n          ((0, 1), action_map['RIGHT']),  # Move RIGHT\n          ((1, 0), action_map['DOWN']),   # Move DOWN\n          ((0, -1), action_map['LEFT']),  # Move LEFT\n      ]:\n          next_r, next_c = r + dr_move, c + dc_move\n          next_pos = (next_r, next_c)\n          \n          # Determine the agent's new facing direction after executing this move.\n          next_agent_dir = DIR_MAPPING[(dr_move, dc_move)]\n\n          # Skip if the next cell is out of bounds.\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Skip if the next cell contains impassable terrain.\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[next_r, next_c, idx] > 0: # If the cell contains an impassable item\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Skip if this specific state (position AND direction) has already been visited.\n          if (next_r, next_c, next_agent_dir) in visited:\n              continue\n\n          # Construct the path to this new cell.\n          new_path_to_next_cell = path + [move_action_id]\n          \n          # --- OPTIMIZATION: Check only the 4 neighbors of next_pos for the primitive ---\n          # Instead of iterating through all primitive_locations (which could be numerous),\n          # we directly check if any adjacent cell to the 'next_pos' contains the target primitive.\n          for (dr_adj_check, dc_adj_check), target_face_dir_check in DIR_MAPPING.items():\n              adj_r, adj_c = next_r + dr_adj_check, next_c + dc_adj_check\n              \n              # Ensure the adjacent cell being checked is within grid boundaries.\n              if not (0 <= adj_r < grid_height and 0 <= adj_c < grid_width):\n                  continue\n              \n              # If this adjacent cell contains the target primitive.\n              if grid[adj_r, adj_c, primitive_idx] > 0:\n                  # Found a primitive adjacent to 'next_pos'.\n                  # Calculate turn actions required from the agent's current direction (next_agent_dir)\n                  # to face this primitive (target_face_dir_check).\n                  turn_actions = _get_turn_actions(next_agent_dir, target_face_dir_check, action_map)\n                  \n                  # This sequence of actions leads to collecting the primitive.\n                  # Since BFS guarantees the shortest path (in terms of moves), this is an optimal solution.\n                  return new_path_to_next_cell + turn_actions + [action_map['USE']]\n\n          # If no usable primitive was found adjacent to 'next_pos',\n          # add this new state to the queue for further exploration and mark it as visited.\n          visited.add((next_r, next_c, next_agent_dir))\n          queue.append(((next_r, next_c), next_agent_dir, new_path_to_next_cell))\n  \n  # If the BFS completes and no path to a usable primitive is found, return an empty list.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:58:57.420651", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  agent_r, agent_c = current_state.pos\n  initial_dir = current_state.dir # Agent's starting direction\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Define the mapping from a movement delta (dr, dc) to the resulting agent direction.\n  # In CraftWorld, movement actions typically set the agent's facing direction.\n  # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT\n  DRDC_TO_DIR = {\n      (-1, 0): 0, # Moving UP sets direction to UP\n      (0, 1): 1,  # Moving RIGHT sets direction to RIGHT\n      (1, 0): 2,  # Moving DOWN sets direction to DOWN\n      (0, -1): 3, # Moving LEFT sets direction to LEFT\n  }\n\n  # Define the mapping from the relative position of a primitive (from the agent's perspective)\n  # to the required direction the agent must be facing to 'USE' that primitive.\n  REL_TO_DIR = {\n      (-1, 0): 0, # Primitive is one cell UP, agent must face UP\n      (0, 1): 1,  # Primitive is one cell RIGHT, agent must face RIGHT\n      (1, 0): 2,  # Primitive is one cell DOWN, agent must face DOWN\n      (0, -1): 3  # Primitive is one cell LEFT, agent must face LEFT\n  }\n\n  # Find all grid locations where the primitive exists (quantity > 0)\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If there are no instances of the primitive in the world, nothing to collect.\n  if len(primitive_locations) == 0:\n      return []\n\n  # Identify indices of entities that block movement (e.g., water, stone).\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # --- Precompute all \"goal states\" for the BFS ---\n  # A goal state is a tuple ((row, col), required_direction_to_face) from which\n  # the agent can immediately 'USE' the primitive.\n  goal_states = set()\n  for pr, pc in primitive_locations: # Iterate through each primitive location\n      # Check the four cardinal neighbors around the primitive.\n      # These are potential locations where the agent could stand to 'USE' the primitive.\n      for dr_adj, dc_adj in DRDC_TO_DIR.keys():\n          adj_r, adj_c = pr + dr_adj, pc + dc_adj # Candidate agent position\n\n          # Ensure the candidate agent position is within grid boundaries.\n          if not (0 <= adj_r < grid_height and 0 <= adj_c < grid_width):\n              continue\n\n          # Check if the candidate agent position is traversable (not an impassable entity).\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[adj_r, adj_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Calculate the relative position of the primitive FROM the agent's candidate position.\n          rel_r, rel_c = pr - adj_r, pc - adj_c\n          \n          # Determine the direction the agent needs to face from (adj_r, adj_c) to 'USE' this primitive.\n          required_face_dir = REL_TO_DIR[(rel_r, rel_c)]\n          \n          # Add this (position, required direction) pair to our set of goal states.\n          goal_states.add(((adj_r, adj_c), required_face_dir))\n\n  # If there are no traversable cells from which a primitive can be collected, it's unreachable.\n  if not goal_states:\n      return []\n\n  # --- Breadth-First Search (BFS) to find the shortest path to any goal state ---\n  # The queue stores tuples: (current_position (r, c), current_direction, path_taken_so_far)\n  queue = collections.deque([((agent_r, agent_c), initial_dir, [])])\n  \n  # The visited set stores (position (r, c), direction) to avoid cycles and redundant exploration,\n  # ensuring we find the shortest path.\n  visited = {(agent_r, agent_c, initial_dir)}\n\n  while queue:\n      (r, c), current_dir, path = queue.popleft() # Dequeue the current state\n\n      # Check if the current state (position AND direction) is one of our precomputed goal states.\n      if ((r, c), current_dir) in goal_states:\n          # If it is, we have found the shortest path to a position where the primitive can be used.\n          # The agent is already facing the correct direction to use it.\n          return path + [action_map['USE']]\n\n      # Explore all four cardinal movement options from the current position.\n      for (dr_move, dc_move), move_action in {\n          (-1, 0): action_map['UP'],\n          (0, 1): action_map['RIGHT'],\n          (1, 0): action_map['DOWN'],\n          (0, -1): action_map['LEFT'],\n      }.items():\n          next_r, next_c = r + dr_move, c + dc_move\n          next_pos = (next_r, next_c)\n          \n          # Determine the agent's new facing direction *after* this movement action.\n          next_agent_dir = DRDC_TO_DIR[(dr_move, dc_move)]\n\n          # Check if the next cell is within grid boundaries.\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next cell contains impassable terrain.\n          is_impassable_cell = False\n          for idx in impassable_indices:\n              if grid[next_r, next_c, idx] > 0:\n                  is_impassable_cell = True\n                  break\n          if is_impassable_cell:\n              continue\n\n          # Check if this specific state (next position AND next direction) has already been visited.\n          if (next_r, next_c, next_agent_dir) in visited:\n              continue\n\n          # If the next state is valid and unvisited, add it to the queue and mark as visited.\n          new_path = path + [move_action]\n          visited.add((next_r, next_c, next_agent_dir))\n          queue.append((next_pos, next_agent_dir, new_path))\n  \n  # If the BFS queue becomes empty and no path to a goal state was found,\n  # it means the primitive is unreachable.\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:59:33.234423", "function_name": "collect", "function_body": "  # Get the integer index for the primitive. Convert to upper case for robustness.\n  i_primitive = env.world.cookbook.index[primitive.upper()]\n  if i_primitive is None:\n      # Primitive name not found in the cookbook index\n      return [] \n\n  # Ensure the primitive is grabbable. 'collect' implies adding to inventory.\n  # Non-grabbable entities (like workshops, water, boundaries) cannot be collected.\n  if i_primitive in env.world.non_grabbable_indices:\n      return []\n\n  # Get action integer mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  MOVE_ACTIONS = [\n      ACTION_UP,\n      ACTION_DOWN,\n      ACTION_LEFT,\n      ACTION_RIGHT\n  ]\n\n  # Initialize BFS\n  start_state = env._current_state\n  # The queue stores CraftState objects, allowing full state transitions via .step()\n  queue = collections.deque([start_state])\n  \n  # The 'visited' dictionary maps (row, col, direction) tuples to \n  # (parent_key_tuple, action_taken_from_parent)\n  # This enables efficient path reconstruction by backtracking.\n  start_key = (start_state.pos[0], start_state.pos[1], start_state.dir)\n  visited = {start_key: None} # None indicates the start node has no parent\n\n  # Variable to store the key of the state from which the 'USE' action can be performed.\n  # This is the target state we are searching for in the BFS.\n  target_state_key = None \n\n  # Perform Breadth-First Search\n  while queue:\n    current_state = queue.popleft()\n    current_key = (current_state.pos[0], current_state.pos[1], current_state.dir)\n    \n    # --- Goal Check: Can we collect the primitive from the current_state? ---\n    # Use the next_to method, which checks if the primitive is in the 3x3 neighborhood.\n    if current_state.next_to(i_primitive):\n        # Found the shortest sequence of movements to reach a state\n        # where the primitive is in front or adjacent.\n        target_state_key = current_key\n        break # Exit BFS loop as the shortest path to the goal state is found\n\n    # --- Explore Possible Next States (Movement Actions) ---\n    for action in MOVE_ACTIONS:\n      # Simulate the action using the CraftState's step method.\n      # This method returns a *new* CraftState instance, reflecting the updated state.\n      # We don't care about the reward here, just the new state.\n      _, new_state = current_state.step(action) \n      \n      # The key for the 'visited' set must include position and direction,\n      # as different directions at the same position can lead to different outcomes.\n      new_state_key = (new_state.pos[0], new_state.pos[1], new_state.dir)\n      \n      # Only add to queue if this new state (position + direction) has not been visited before.\n      # This prevents redundant computations and infinite loops.\n      # It also implicitly handles blocked moves, as a blocked move will result in new_state_key\n      # being the same as current_key, which would already be in visited or is the start state.\n      if new_state_key not in visited:\n        # Store the parent key and the action taken to reach this new state.\n        visited[new_state_key] = (current_key, action) \n        queue.append(new_state)\n            \n  # --- Path Reconstruction ---\n  if target_state_key is None:\n      # If the queue became empty and no path to collect the primitive was found,\n      # it means the primitive is unreachable or not present in the accessible world.\n      return []\n  else:\n      # Reconstruct the path by backtracking from the target_state_key to the start_key.\n      path = []\n      current_reconstruct_key = target_state_key\n      while visited[current_reconstruct_key] is not None: # Stop when we reach the start node (parent is None)\n          # Get the parent key and the action that led from parent to current_reconstruct_key.\n          parent_key, action_taken = visited[current_reconstruct_key]\n          path.append(action_taken)\n          current_reconstruct_key = parent_key\n      \n      # The path is built in reverse order (from goal to start), so reverse it.\n      path.reverse()\n      \n      # Append the final 'USE' action to the sequence of movement actions.\n      # This completes the sequence to collect the item.\n      path.append(ACTION_USE)\n      return path", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:59:35.221745", "function_name": "collect", "function_body": "  # 1. Input validation / Pre-checks\n  cookbook = env.world.cookbook\n  \n  # Ensure the primitive name exists and get its index.\n  # Convert to uppercase for robustness, as DSL items are often processed this way.\n  primitive_upper = primitive.upper() \n  primitive_idx = cookbook.index[primitive_upper] \n  \n  if primitive_idx is None:\n      # Primitive name not found in the cookbook index\n      return [] \n\n  # Ensure the primitive is grabbable. 'collect' implies adding to inventory.\n  # Non-grabbable entities (like workshops, water, boundaries) cannot be collected by 'USE'.\n  if primitive_idx in env.world.non_grabbable_indices:\n      return []\n\n  # 2. Get action integer mappings from the environment's action_specs\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  MOVE_ACTIONS = [\n      ACTION_UP,\n      ACTION_DOWN,\n      ACTION_LEFT,\n      ACTION_RIGHT\n  ]\n\n  # 3. Initialize Breadth-First Search (BFS)\n  start_state = env._current_state\n  \n  # The queue will store tuples of (current_CraftState, list_of_actions_taken_to_reach_this_state)\n  queue = collections.deque([(start_state, [])])\n  \n  # The 'visited' set keeps track of (agent_position_tuple, agent_direction_int) tuples.\n  # This prevents redundant exploration of the same state (location + orientation),\n  # ensuring the shortest path is found and avoiding infinite loops.\n  visited = set([(start_state.pos, start_state.dir)]) \n\n  # 4. Perform BFS\n  while queue:\n    current_state, path_to_current = queue.popleft()\n    \n    # Check if the agent is currently next to the desired primitive.\n    # `CraftState.next_to` checks the 3x3 neighborhood, which is where a `USE` action can apply.\n    if current_state.next_to(primitive_idx):\n      # If the primitive is within reach, we found the shortest sequence of movements.\n      # Append the final 'USE' action and return the complete path.\n      return path_to_current + [ACTION_USE]\n\n    # Explore possible next states by trying all valid movement actions\n    for action in MOVE_ACTIONS:\n      # Simulate the action using the CraftState's step method.\n      # This method returns (reward, new_state); we only need the new_state for BFS.\n      _, new_state = current_state.step(action) \n      \n      # Construct a unique key for the new state based on position and direction.\n      new_state_key = (new_state.pos, new_state.dir)\n      \n      # Only add to the queue if this new state has not been visited before.\n      if new_state_key not in visited:\n        visited.add(new_state_key)\n        # Add the new state to the queue along with the accumulated path to reach it.\n        queue.append((new_state, path_to_current + [action]))\n\n  # If the queue becomes empty and no path to the primitive was found,\n  # it means the primitive is unreachable from the current state.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:00:20.759997", "function_name": "collect", "function_body": "  import collections # Required for deque for BFS\n\n  # 1. Initialize action IDs from environment's action_specs for robustness.\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  actions_sequence = [] # List to store the sequence of actions to be returned\n\n  # 2. Pre-compute relevant IDs for efficiency and readability.\n  # Normalize primitive name to lowercase for consistent lookup.\n  primitive_name_lower = primitive.lower()\n  primitive_id = env.world.cookbook.index[primitive_name_lower]\n  # Get the ID for impassable \"boundary\" cells.\n  boundary_id = env.world.cookbook.index[\"boundary\"]\n\n  # 3. Early exit: If the primitive is a grabbable item and already in inventory, no actions are needed.\n  if primitive_id in env.world.grabbable_indices:\n      current_observations = env.observations()\n      inventory = current_observations['features_dict']['inventory']\n      if inventory[primitive_id] > 0: # Check if the agent already possesses the item\n          return [] # Already collected, return an empty list of actions\n\n  # 4. Get current state information required for pathfinding.\n  current_observations = env.observations()\n  # Agent's current (x, y) position. Convert numpy array to tuple for hashability (needed for 'visited' set).\n  agent_current_position = tuple(current_observations['features_dict']['pos']) \n  full_grid_state = current_observations['features_dict']['features_global'] # Full grid layout for pathfinding\n\n  # Determine grid dimensions from the grid array's shape.\n  GRID_WIDTH, GRID_HEIGHT, _ = full_grid_state.shape\n\n  # Map movement differentials (dx, dy) to corresponding action IDs.\n  # This facilitates converting a path of coordinates into a sequence of actions.\n  move_deltas_to_action_map = {\n      (0, -1): ACTION_UP,    # Moving up means y-coordinate decreases\n      (0, 1): ACTION_DOWN,   # Moving down means y-coordinate increases\n      (-1, 0): ACTION_LEFT,  # Moving left means x-coordinate decreases\n      (1, 0): ACTION_RIGHT,  # Moving right means x-coordinate increases\n  }\n\n  # 5. Initialize BFS components.\n  # The queue stores tuples of (agent_position, path_to_this_position).\n  # `path_to_this_position` is a list of (x,y) coordinates the agent traverses.\n  bfs_queue = collections.deque([(agent_current_position, [agent_current_position])])\n  \n  # A set to keep track of visited agent positions to prevent cycles and redundant exploration.\n  visited_positions = {agent_current_position}\n\n  # This variable will store the shortest path (list of coordinates) to a location\n  # from which the primitive can be 'used'.\n  path_to_primitive_use_location = None \n\n  # 6. BFS Loop: Search for the shortest path to a cell from which the primitive can be 'used'.\n  while bfs_queue:\n      (current_x, current_y), current_path = bfs_queue.popleft() # Dequeue the current state\n\n      # Check the 3x3 neighborhood around the current agent position (current_x, current_y).\n      # The 'USE' action operates on this neighborhood, meaning we need to reach a cell adjacent to the primitive.\n      is_primitive_in_neighborhood = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              # Calculate the coordinates of the cell in the neighborhood being examined.\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n\n              # Ensure the neighbor cell is within the grid boundaries.\n              if not (0 <= neighbor_x < GRID_WIDTH and 0 <= neighbor_y < GRID_HEIGHT):\n                  continue\n\n              # Check if the target primitive is present at the current neighbor cell.\n              # `full_grid_state[x, y, kind_id]` indicates presence/count.\n              if full_grid_state[neighbor_x, neighbor_y, primitive_id] > 0:\n                  is_primitive_in_neighborhood = True\n                  break # Primitive found nearby, no need to check other cells in this neighborhood\n          if is_primitive_in_neighborhood:\n              break # Found it, exit outer offset loop to process this path\n\n      # If the primitive is found in the 3x3 neighborhood of the current agent position,\n      # then `current_path` leads to a valid 'USE' location. Because BFS explores layer by layer,\n      # this is guaranteed to be the shortest such path.\n      if is_primitive_in_neighborhood:\n          path_to_primitive_use_location = current_path\n          break # Path found, exit the main BFS loop\n\n      # If the primitive is not yet found nearby, explore valid adjacent cells for agent movement.\n      # Consider all four cardinal directions (UP, DOWN, LEFT, RIGHT) for agent movement.\n      for dx, dy in move_deltas_to_action_map.keys():\n          next_agent_x, next_agent_y = current_x + dx, current_y + dy\n\n          # Check if the potential next agent position is within grid boundaries.\n          if not (0 <= next_agent_x < GRID_WIDTH and 0 <= next_agent_y < GRID_HEIGHT):\n              continue\n\n          # Check for impassable obstacles. Cells containing the 'boundary_id' are considered blocked for movement.\n          if full_grid_state[next_agent_x, next_agent_y, boundary_id] > 0:\n               continue # This cell is blocked for movement, so skip it.\n\n          # If the next cell is traversable and has not been visited by the agent yet, add it to the queue.\n          if (next_agent_x, next_agent_y) not in visited_positions:\n              visited_positions.add((next_agent_x, next_agent_y))\n              # Enqueue the new position along with the path taken to reach it.\n              bfs_queue.append(((next_agent_x, next_agent_y), current_path + [(next_agent_x, next_agent_y)]))\n\n  # 7. Convert the found coordinate path into a list of agent actions.\n  if path_to_primitive_use_location:\n      # Iterate through the path of agent positions, reconstructing movement actions.\n      # We iterate up to the second-to-last element, as each action connects two consecutive points.\n      for i in range(len(path_to_primitive_use_location) - 1):\n          # Get the current and next agent positions from the path.\n          from_x, from_y = path_to_primitive_use_location[i]\n          to_x, to_y = path_to_primitive_use_location[i+1]\n\n          # Calculate the relative movement (change in x, change in y).\n          delta_x = to_x - from_x\n          delta_y = to_y - from_y\n\n          # Append the corresponding action ID to the actions sequence.\n          actions_sequence.append(move_deltas_to_action_map[(delta_x, delta_y)])\n\n      # After all movements are completed, the agent is in the optimal position to 'USE' the primitive.\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:00:22.926595", "function_name": "collect", "function_body": "  import collections # Required for deque for BFS\n\n  # 1. Map action names from DSL to integer IDs provided by the environment.\n  # This makes the code robust to changes in action ID mapping.\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # List to accumulate the sequence of actions to be executed.\n  actions_sequence = []\n\n  # 2. Convert the primitive string (e.g., \"WOOD\") to its corresponding integer ID.\n  # Assuming the Cookbook's index stores names in lowercase as per common practice.\n  primitive_id = env.world.cookbook.index[primitive.lower()]\n\n  # 3. Optimization: If the primitive is a grabbable item and already in the agent's inventory,\n  # no further actions are needed to \"collect\" it. Return an empty action list.\n  if primitive_id in env.world.grabbable_indices:\n      current_inventory = env.observations()['features_dict']['inventory']\n      if current_inventory[primitive_id] > 0: # Check if the count for this item is greater than zero\n          return [] # Item already collected\n\n  # 4. Retrieve current state information necessary for pathfinding (BFS).\n  current_observations = env.observations()\n  # Agent's current (x, y) position. Convert from numpy array to tuple for immutability and hashing in 'visited' set.\n  agent_current_pos = tuple(current_observations['features_dict']['pos'])\n  # The full grid layout, used to identify primitive locations and impassable areas.\n  grid_layout = current_observations['features_dict']['features_global']\n\n  # Determine grid dimensions from the grid_layout shape.\n  GRID_WIDTH, GRID_HEIGHT, _ = grid_layout.shape\n\n  # Define the possible cardinal movements and their corresponding action IDs.\n  # This mapping helps in reconstructing the action sequence from a path of coordinates.\n  movement_deltas_to_action = {\n      (0, -1): ACTION_UP,    # Moving up decreases the y-coordinate\n      (0, 1): ACTION_DOWN,   # Moving down increases the y-coordinate\n      (-1, 0): ACTION_LEFT,  # Moving left decreases the x-coordinate\n      (1, 0): ACTION_RIGHT,  # Moving right increases the x-coordinate\n  }\n\n  # 5. Initialize Breadth-First Search (BFS) components.\n  # The queue stores tuples: (agent_coordinates, path_of_coordinates_to_reach_here).\n  # The path is a list of (x,y) tuples, representing the sequence of agent positions.\n  bfs_queue = collections.deque([(agent_current_pos, [agent_current_pos])])\n  \n  # The 'visited' set keeps track of all agent positions already explored to prevent cycles\n  # and redundant computation, ensuring the shortest path is found.\n  visited_positions = {agent_current_pos}\n\n  # This variable will store the final sequence of agent positions leading to the 'USE' location.\n  path_to_use_location = None\n\n  # 6. BFS Loop: Search for the shortest path to an agent position from which\n  # the target primitive can be interacted with (i.e., is within the 3x3 neighborhood for 'USE').\n  while bfs_queue:\n      (current_agent_x, current_agent_y), current_path = bfs_queue.popleft() # Dequeue current state\n\n      # Check if the target primitive is within the 3x3 neighborhood of the current agent position.\n      # The 'USE' action typically operates on this surrounding area.\n      primitive_is_nearby = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              # Calculate coordinates of a cell in the 3x3 neighborhood.\n              neighbor_x, neighbor_y = current_agent_x + dx_offset, current_agent_y + dy_offset\n\n              # Ensure the neighbor cell is within the grid boundaries.\n              if not (0 <= neighbor_x < GRID_WIDTH and 0 <= neighbor_y < GRID_HEIGHT):\n                  continue\n\n              # Check if the primitive is present at this neighbor cell.\n              # grid_layout[x, y, kind_id] indicates presence/count.\n              if grid_layout[neighbor_x, neighbor_y, primitive_id] > 0:\n                  primitive_is_nearby = True\n                  break # Primitive found nearby, no need to check other cells in this neighborhood\n          if primitive_is_nearby:\n              break # Exit outer offset loop as a nearby primitive has been found\n\n      # If the primitive is found in the current agent's 3x3 neighborhood,\n      # then 'current_path' is the shortest path to a valid 'USE' location.\n      if primitive_is_nearby:\n          path_to_use_location = current_path\n          break # Path found, terminate BFS\n\n      # If the primitive is not found nearby, explore valid adjacent cells for agent movement.\n      # Iterate through all four cardinal directions.\n      for dx, dy in movement_deltas_to_action.keys():\n          next_agent_x, next_agent_y = current_agent_x + dx, current_agent_y + dy\n\n          # Check if the next potential agent position is within the grid boundaries.\n          if not (0 <= next_agent_x < GRID_WIDTH and 0 <= next_agent_y < GRID_HEIGHT):\n              continue\n\n          # Check for impassable obstacles. The \"boundary\" kind is usually non-traversable.\n          # Get the ID for \"boundary\" from the cookbook's index.\n          boundary_id = env.world.cookbook.index[\"boundary\"]\n          if grid_layout[next_agent_x, next_agent_y, boundary_id] > 0:\n               continue # This cell is blocked for movement, so skip it.\n\n          # If the next cell is traversable and has not been visited yet, add it to the queue.\n          next_agent_pos_tuple = (next_agent_x, next_agent_y)\n          if next_agent_pos_tuple not in visited_positions:\n              visited_positions.add(next_agent_pos_tuple)\n              # Extend the path and enqueue the new state.\n              bfs_queue.append((next_agent_pos_tuple, current_path + [next_agent_pos_tuple]))\n\n  # 7. Convert the found path of coordinates into a list of actions.\n  if path_to_use_location:\n      # Iterate through the path to reconstruct movement actions.\n      # The loop goes up to the second-to-last position because each action connects two positions.\n      for i in range(len(path_to_use_location) - 1):\n          from_x, from_y = path_to_use_location[i]\n          to_x, to_y = path_to_use_location[i+1]\n\n          # Calculate the relative movement (change in x, change in y).\n          delta_x = to_x - from_x\n          delta_y = to_y - from_y\n\n          # Append the corresponding action ID using the pre-defined map.\n          actions_sequence.append(movement_deltas_to_action[(delta_x, delta_y)])\n\n      # After all movements are performed, the agent is positioned optimally to interact with the primitive.\n      # Append the 'USE' action to the sequence.\n      actions_sequence.append(ACTION_USE)\n\n  return actions_sequence", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:02:33.280136", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive.upper()]\n  \n  # 1. Validate inputs and perform pre-checks.\n  # If the primitive name is not found in the cookbook index, it's an invalid target.\n  if i_primitive is None:\n      return []\n\n  # 'Collect' implies adding an item to inventory via the 'USE' action.\n  # Non-grabbable entities (like workshops, water, or boundaries) cannot be picked up.\n  # Checking against 'grabbable_indices' explicitly confirms the item can be collected.\n  if i_primitive not in env.world.grabbable_indices:\n      return []\n\n  # Get the current state of the environment.\n  start_state = env._current_state\n  \n  # Optimization/Pre-condition check: If the primitive is already in the agent's inventory,\n  # no collection actions are needed. The task is effectively already completed.\n  if start_state.inventory[i_primitive] > 0:\n      return []\n\n  # 2. Retrieve integer mappings for actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define the set of movement actions for BFS exploration.\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Delta Row/Col based on agent's direction (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT)\n  # These are used to calculate the coordinates of the cell directly in front of the agent.\n  DR = [-1, 0, 1, 0] # Delta Row for (UP, RIGHT, DOWN, LEFT)\n  DC = [0, 1, 0, -1] # Delta Col for (UP, RIGHT, DOWN, LEFT)\n\n  # Get grid dimensions for boundary checks.\n  HEIGHT, WIDTH, _ = start_state.grid.shape\n\n  # 3. Initialize Breadth-First Search (BFS) structures.\n  # The queue will store tuples of (current_CraftState_instance, list_of_actions_taken_to_reach_this_state).\n  queue = collections.deque([(start_state, [])])\n  \n  # The 'visited' set keeps track of (agent_row, agent_col, agent_direction) tuples.\n  # This prevents redundant exploration of the same state and avoids infinite loops.\n  # For movement actions, the inventory and grid remain constant, so only position and\n  # direction are necessary to define a unique state in the search.\n  visited = set([(start_state.pos[0], start_state.pos[1], start_state.dir)]) \n\n  # 4. Perform BFS to find the shortest action sequence.\n  # Adding a maximum search depth as a practical improvement to prevent unbounded searches\n  # in very large or complex environments where an item might be unreachable.\n  # The maximum number of unique (position, direction) states is H * W * 4.\n  max_search_depth = HEIGHT * WIDTH * 4\n  \n  while queue:\n    current_state, path_to_current = queue.popleft()\n\n    # If the current path length exceeds the maximum search depth, prune this path.\n    # This prevents searching indefinitely for items that are too far or unreachable.\n    if len(path_to_current) > max_search_depth:\n        continue # Skip this path, it's too long\n\n    # --- Goal Check: Can the primitive be collected from the `current_state`? ---\n    # The 'USE' action interacts with the grid cell directly in front of the agent.\n    \n    # Calculate the coordinates of the cell the agent is currently facing.\n    facing_dir = current_state.dir\n    target_r = current_state.pos[0] + DR[facing_dir]\n    target_c = current_state.pos[1] + DC[facing_dir]\n\n    # Check if the target cell is within grid boundaries.\n    if 0 <= target_r < HEIGHT and 0 <= target_c < WIDTH:\n        # Check if the target cell contains the desired primitive.\n        # `grid[r, c, kind_idx] > 0` indicates presence.\n        if current_state.grid[target_r, target_c, i_primitive] > 0:\n            # If the primitive is found in front, we've found the shortest path.\n            # Append the 'USE' action and return the complete action sequence.\n            return path_to_current + [ACTION_USE]\n\n    # --- Explore Next States: Simulate Movement Actions ---\n    # Iterate through all possible movement actions from the `current_state`.\n    for action in MOVE_ACTIONS:\n      # Simulate the action using `current_state.step()`. This function\n      # returns a tuple: (reward, new_CraftState). We only need the `new_state`.\n      _, new_state = current_state.step(action) \n      \n      # Create a unique key for the `new_state` to check against the `visited` set.\n      # A state is uniquely defined by the agent's position and direction.\n      new_state_key = (new_state.pos[0], new_state.pos[1], new_state.dir)\n      \n      # If this new state has not been visited, add it to the `visited` set\n      # and enqueue it along with the sequence of actions taken to reach it.\n      if new_state_key not in visited:\n        visited.add(new_state_key)\n        queue.append((new_state, path_to_current + [action]))\n            \n  # 5. If the BFS completes (queue becomes empty) and no path to collect\n  # the primitive was found, it implies the primitive is either unreachable\n  # or not present on the map under the current conditions. Return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:02:35.283795", "function_name": "collect", "function_body": "  i_primitive = env.world.cookbook.index[primitive.upper()]\n  \n  # 1. Validate inputs and perform pre-checks.\n  # If the primitive name is not found in the cookbook index, it's an invalid target.\n  if i_primitive is None:\n      return []\n\n  # 'Collect' implies adding an item to inventory. Non-grabbable entities (like workshops,\n  # water, or boundaries) cannot be picked up using the 'USE' action.\n  if i_primitive in env.world.non_grabbable_indices:\n      return []\n\n  # Get the current state of the environment.\n  start_state = env._current_state\n  \n  # Optimization/Pre-condition check: If the primitive is already in the agent's inventory,\n  # no collection actions are needed. The task is effectively already completed.\n  if start_state.inventory[i_primitive] > 0:\n      return []\n\n  # 2. Retrieve integer mappings for actions from the environment's action specifications.\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  # Define the set of movement actions for BFS exploration.\n  MOVE_ACTIONS = [ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT]\n\n  # Delta Row/Col based on agent's direction (0: UP, 1: RIGHT, 2: DOWN, 3: LEFT)\n  # These are used to calculate the coordinates of the cell directly in front of the agent.\n  DR = [-1, 0, 1, 0] # Delta Row for (UP, RIGHT, DOWN, LEFT)\n  DC = [0, 1, 0, -1] # Delta Col for (UP, RIGHT, DOWN, LEFT)\n\n  # Get grid dimensions for boundary checks.\n  HEIGHT, WIDTH, _ = start_state.grid.shape\n\n  # Define a maximum search depth. This is an improvement for robustness,\n  # preventing excessively long searches in very complex or potentially disconnected maps,\n  # or in cases where the state space might contain extremely long paths.\n  # This makes the search bounded, though it might not find a path if the shortest path\n  # exceeds this limit. A typical upper bound for states is grid_size * 4 directions.\n  MAX_BFS_DEPTH = HEIGHT * WIDTH * 4 * 2 # A generous bound (e.g., twice the number of unique (pos, dir) states)\n\n  # 3. Initialize Breadth-First Search (BFS) structures.\n  # The queue will store tuples of (current_CraftState_instance, list_of_actions_taken_to_reach_this_state, current_depth).\n  queue = collections.deque([(start_state, [], 0)]) # Added current_depth\n  \n  # The 'visited' set keeps track of (agent_row, agent_col, agent_direction) tuples.\n  # This prevents redundant exploration of the same state and avoids infinite loops.\n  visited = set([(start_state.pos[0], start_state.pos[1], start_state.dir)]) \n\n  # 4. Perform BFS to find the shortest action sequence.\n  while queue:\n    current_state, path_to_current, current_depth = queue.popleft() # Unpack current_depth\n    \n    # Check if the search has exceeded the maximum allowed depth.\n    if current_depth >= MAX_BFS_DEPTH:\n        # If so, prune this path and do not explore further from this state.\n        continue\n\n    # --- Goal Check: Can the primitive be collected from the `current_state`? ---\n    # The 'USE' action interacts with the grid cell directly in front of the agent.\n    \n    # Calculate the coordinates of the cell the agent is currently facing.\n    facing_dir = current_state.dir\n    target_r = current_state.pos[0] + DR[facing_dir]\n    target_c = current_state.pos[1] + DC[facing_dir]\n\n    # Check if the target cell is within grid boundaries.\n    if 0 <= target_r < HEIGHT and 0 <= target_c < WIDTH:\n        # Check if the target cell contains the desired primitive.\n        # `grid[r, c, kind_idx] > 0` indicates presence.\n        if current_state.grid[target_r, target_c, i_primitive] > 0:\n            # If the primitive is found in front, we've found the shortest path.\n            # Append the 'USE' action and return the complete action sequence.\n            return path_to_current + [ACTION_USE]\n\n    # --- Explore Next States: Simulate Movement Actions ---\n    # Iterate through all possible movement actions from the `current_state`.\n    for action in MOVE_ACTIONS:\n      # Simulate the action using `current_state.step()`. This function\n      # returns a tuple: (reward, new_CraftState). We only need the `new_state`.\n      _, new_state = current_state.step(action) \n      \n      # Create a unique key for the `new_state` to check against the `visited` set.\n      # A state is uniquely defined by the agent's position and direction.\n      new_state_key = (new_state.pos[0], new_state.pos[1], new_state.dir)\n      \n      # If this new state has not been visited, add it to the `visited` set\n      # and enqueue it along with the sequence of actions taken to reach it.\n      if new_state_key not in visited:\n        visited.add(new_state_key)\n        queue.append((new_state, path_to_current + [action], current_depth + 1)) # Increment depth for new state\n            \n  # 5. If the BFS completes (queue becomes empty) and no path to collect\n  # the primitive was found (or was found beyond MAX_BFS_DEPTH), it implies\n  # the primitive is either unreachable or not present on the map under the\n  # current conditions within the search limits. Return an empty list.\n  return []", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:03:48.017668", "function_name": "collect", "function_body": "  def _is_next_to_coord(cx, cy, i_kind, grid, GRID_WIDTH, GRID_HEIGHT):\n      # Iterate through a 3x3 neighborhood centered at (cx,cy)\n      for dx_offset in [-1, 0, 1]:\n          for dy_offset in [-1, 0, 1]:\n              nx, ny = cx + dx_offset, cy + dy_offset\n\n              # Check bounds\n              # grid shape is (WIDTH, HEIGHT, n_kinds)\n              if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n                  continue\n              \n              # Check if the specified kind is at (nx, ny)\n              if grid[nx, ny, i_kind] == 1:\n                  return True\n      return False\n\n  current_state = env._current_state\n  world = current_state.world\n  cookbook = world.cookbook\n  grid = current_state.grid\n  start_pos_x, start_pos_y = current_state.pos # (x, y) where x is col, y is row\n  \n  GRID_WIDTH, GRID_HEIGHT, N_KINDS = grid.shape # grid[x_coord, y_coord, kind_idx]\n\n  # Get primitive index\n  try:\n      primitive_idx = cookbook.index.index(primitive)\n  except KeyError:\n      # Primitive not found in cookbook, cannot collect\n      return []\n\n  # --- Improvement for collect_v2: Check if the primitive is actually grabbable ---\n  # The 'collect' action implies adding the item to inventory.\n  # If the primitive is a non-grabbable environment entity (like a workshop or water),\n  # it cannot be collected into the inventory. In such cases, return an empty action list.\n  if primitive_idx in world.non_grabbable_indices:\n      return []\n\n  # Get action mappings\n  action_specs = env.action_specs()\n  UP = action_specs['UP']    # Corresponds to dy = -1\n  DOWN = action_specs['DOWN'] # Corresponds to dy = 1\n  LEFT = action_specs['LEFT'] # Corresponds to dx = -1\n  RIGHT = action_specs['RIGHT'] # Corresponds to dx = 1\n  USE = action_specs['USE']\n\n  # Define possible movements (dx, dy) and corresponding actions\n  moves = [\n      (UP, (0, -1)),    # UP: (dx=0, dy=-1)\n      (DOWN, (0, 1)),   # DOWN: (dx=0, dy=1)\n      (LEFT, (-1, 0)),  # LEFT: (dx=-1, dy=0)\n      (RIGHT, (1, 0)),  # RIGHT: (dx=1, dy=0)\n  ]\n\n  # Queue for BFS: stores (x, y, list_of_actions_to_reach_here)\n  queue = collections.deque([(start_pos_x, start_pos_y, [])]) \n  visited = {(start_pos_x, start_pos_y)}\n\n  non_grabbable_indices = world.non_grabbable_indices\n\n  # Special handling for agent's initial position: check if primitive is already next to it\n  if _is_next_to_coord(start_pos_x, start_pos_y, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n      return [USE]\n\n  while queue:\n      cx, cy, path_actions = queue.popleft()\n\n      # Check if the primitive is in the 3x3 neighborhood of the current cell (cx, cy)\n      # If so, we have found a path to a location from which we can USE the primitive.\n      if _is_next_to_coord(cx, cy, primitive_idx, grid, GRID_WIDTH, GRID_HEIGHT):\n          return path_actions + [USE]\n\n      # Explore possible moves\n      for action, (dx, dy) in moves:\n          nx, ny = cx + dx, cy + dy\n\n          # Check if the new position is within grid bounds\n          if not (0 <= nx < GRID_WIDTH and 0 <= ny < GRID_HEIGHT):\n              continue\n\n          # Check if the new position has already been visited\n          if (nx, ny) in visited:\n              continue\n\n          # Check traversability: A cell is traversable if it does not contain any non-grabbable items\n          is_traversable = True\n          for non_grab_idx in non_grabbable_indices:\n              if grid[nx, ny, non_grab_idx] == 1: # If a non-grabbable item is present at (nx, ny)\n                  is_traversable = False\n                  break\n          \n          if is_traversable:\n              visited.add((nx, ny))\n              queue.append((nx, ny, path_actions + [action]))\n  \n  # If the queue becomes empty and no path to the primitive is found, return an empty list\n  return []", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:03:50.018984", "function_name": "collect", "function_body": "", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:05:05.667200", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in index, cannot collect\n    return []\n\n  # Improvement for collect_v2: Check if the primitive is already in the inventory.\n  # If the agent already possesses the primitive, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Determine properties of the primitive based on CraftWorld's indices\n  is_grabbable = primitive_idx in world.grabbable_indices\n  is_workshop_target = primitive_idx in world.workshop_indices\n  # Other non-grabbable primitives (e.g., WATER, BOUNDARY if it's a target) are assumed to be\n  # \"collected\" by simply being on their grid cell.\n\n  # Get grid dimensions\n  grid = state.grid\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Define movement actions and their effects on (row_change, col_change, new_direction_value)\n  # new_direction_value corresponds to agent's internal state.dir (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  action_moves = {\n      ACTION_UP:    (-1, 0, 0),  # Move UP (row-1, col), agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),   # Move DOWN (row+1, col), agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3),  # Move LEFT (row, col-1), agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),   # Move RIGHT (row, col+1), agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell for ACTION_USE based on agent's direction\n  dir_to_target_delta = {\n      0: (-1, 0),  # Agent facing UP (dir 0) targets cell above (r-1, c)\n      1: (0, 1),   # Agent facing RIGHT (dir 1) targets cell to the right (r, c+1)\n      2: (1, 0),   # Agent facing DOWN (dir 2) targets cell below (r+1, c)\n      3: (0, -1),  # Agent facing LEFT (dir 3) targets cell to the left (r, c-1)\n  }\n\n  # Helper function to check if a position is adjacent to a kind (similar to CraftState.next_to)\n  def _is_adjacent_to_kind(grid_data, agent_r, agent_c, target_kind_idx, R_MAX, C_MAX):\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              check_r, check_c = agent_r + dr_adj, agent_c + dc_adj\n              # Check bounds\n              if 0 <= check_r < R_MAX and 0 <= check_c < C_MAX:\n                  # Check if the target_kind_idx is present at this neighbor cell\n                  if grid_data[check_r, check_c, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # BFS setup\n  start_pos = state.pos  # Agent's current position (row, col)\n  start_dir = state.dir  # Agent's current facing direction (int: 0-3)\n\n  q = collections.deque()\n  # Queue stores tuples: (current_pos_r, current_pos_c, current_dir, list_of_actions_to_reach_here)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n\n  # Visited set: (pos_r, pos_c, current_dir) to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  # Define obstacles: Any non-grabbable entity that is NOT the primitive we are trying to collect.\n  # If the primitive itself is a non-grabbable item (e.g., WATER, WORKSHOP),\n  # we need to be able to move onto/adjacent to it, so it's not an obstacle in this specific search.\n  obstacle_kinds_set = set(world.non_grabbable_indices)\n  if primitive_idx in world.non_grabbable_indices:\n      obstacle_kinds_set.discard(primitive_idx) # Remove the target primitive from obstacles\n\n  # BFS Pathfinding Loop\n  while q:\n    r, c, current_dir, path = q.popleft() # Current position, direction, and path to reach it\n\n    # --- Check for collection at the current (r, c, current_dir) state ---\n    # This logic determines if the primitive can be collected from the current state (r,c,current_dir).\n    # This check is performed before exploring new moves from this state.\n\n    # Case 1: Grabbable primitive (e.g., WOOD, IRON, GRASS, STONE, etc.)\n    # Requires the agent to be facing the primitive and use the ACTION_USE.\n    if is_grabbable:\n        # Calculate the cell directly in front of the agent\n        target_dr, target_dc = dir_to_target_delta[current_dir]\n        target_r, target_c = r + target_dr, c + target_dc\n\n        # Check if the cell in front is within bounds and contains the target primitive\n        if (0 <= target_r < GRID_ROWS and 0 <= target_c < GRID_COLS and\n            grid[target_r, target_c, primitive_idx] == 1):\n            return path + [ACTION_USE] # Found a state where agent can use/collect the primitive.\n\n    # Case 2: Workshop primitive (e.g., WORKSHOP0, WORKSHOP1, WORKSHOP2)\n    # These are non-grabbable and require the agent to be adjacent to them.\n    elif is_workshop_target: # Workshops are by definition non-grabbable\n        # Check if current position (r, c) is adjacent to the workshop\n        if _is_adjacent_to_kind(grid, r, c, primitive_idx, GRID_ROWS, GRID_COLS):\n            return path # Agent is adjacent, \"collection\" achieved.\n\n    # Case 3: Other non-grabbable primitive (e.g., WATER, possibly BOUNDARY if it's a target)\n    # These are typically \"collected\" by simply being on their grid cell.\n    elif grid[r, c, primitive_idx] == 1: # The current cell (r,c) contains the primitive\n        return path # Agent is on the primitive's cell, \"collection\" achieved.\n\n    # --- Explore neighbors by taking movement actions ---\n    for action_id, (dr_move, dc_move, new_dir) in action_moves.items():\n      next_r, next_c = r + dr_move, c + dc_move\n      next_state_dir = new_dir\n\n      # Check bounds: ensure next_pos is within the grid\n      if not (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS):\n        continue\n\n      # Obstacle check: determine if the next cell is blocked by any obstacle kind\n      is_blocked = False\n      for k_idx in obstacle_kinds_set:\n          if grid[next_r, next_c, k_idx] > 0: # If the next cell contains this obstacle\n              is_blocked = True\n              break\n      if is_blocked:\n          continue\n\n      # Check if this (position, direction) state has already been visited\n      if (next_r, next_c, next_state_dir) in visited:\n        continue\n\n      # Add the new position and its path to the queue for further exploration\n      new_path = path + [action_id]\n      visited.add((next_r, next_c, next_state_dir))\n      q.append((next_r, next_c, next_state_dir, new_path))\n\n  # If the queue becomes empty and no path was found to collect the primitive\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:05:07.734959", "function_name": "collect", "function_body": "  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in index, cannot collect\n    return []\n\n  # Check if the primitive is already in the inventory.\n  # If the agent already possesses the primitive, no actions are needed.\n  if state.inventory[primitive_idx] > 0:\n    return []\n\n  # Determine properties of the primitive based on the world configuration\n  is_grabbable = primitive_idx in world.grabbable_indices\n  is_workshop_target = primitive_idx in world.workshop_indices\n\n  # Get grid dimensions\n  grid = state.grid\n  GRID_ROWS, GRID_COLS, _ = grid.shape\n\n  # Define possible movement actions and their effects on (row_change, col_change, new_direction_value)\n  # new_direction_value corresponds to the agent's internal state.dir (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  action_moves = {\n      ACTION_UP:    (-1, 0, 0),  # Move UP (row-1, col), agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),   # Move DOWN (row+1, col), agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3),  # Move LEFT (row, col-1), agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),   # Move RIGHT (row, col+1), agent faces RIGHT (dir 1)\n  }\n\n  # Helper function to check if a position is adjacent to a target kind.\n  # This is used for \"collection\" of workshop-like items where being next to it is sufficient.\n  def _is_adjacent_to_kind(check_grid, agent_r, agent_c, target_kind_idx, R_MAX, C_MAX):\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              adj_r, adj_c = agent_r + dr_adj, agent_c + dc_adj\n              # Check bounds and ensure the adjacent cell is not the agent's own cell\n              if (0 <= adj_r < R_MAX and 0 <= adj_c < C_MAX and\n                  (dr_adj != 0 or dc_adj != 0)):\n                  if check_grid[adj_r, adj_c, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # Helper function to determine if the primitive collection goal is achieved at a given state (r, c, dir).\n  # Returns (is_achieved: bool, actions_to_complete: list[int]).\n  def _check_goal_achieved(r_curr, c_curr, dir_curr, grid_data, p_idx, is_grab, is_workshop, act_use):\n      # Map agent direction to (dr, dc) for the cell directly in front of the agent.\n      dir_to_target_delta = {\n          0: (-1, 0),  # Facing UP, target is above\n          1: (0, 1),   # Facing RIGHT, target is to the right\n          2: (1, 0),   # Facing DOWN, target is below\n          3: (0, -1),  # Facing LEFT, target is to the left\n      }\n\n      # Case 1: Grabbable items (e.g., WOOD, IRON). Agent needs to be facing the item and then USE.\n      if is_grab:\n          target_dr, target_dc = dir_to_target_delta[dir_curr]\n          target_r, target_c = r_curr + target_dr, c_curr + target_dc\n\n          if (0 <= target_r < GRID_ROWS and 0 <= target_c < GRID_COLS and\n              grid_data[target_r, target_c, p_idx] == 1):\n              return True, [act_use] # Goal achieved, requires ACTION_USE\n          return False, [] # Not in a position to collect grabbable yet\n\n      # Case 2: Workshop items (e.g., WORKSHOP0). Agent needs to be adjacent to the workshop.\n      elif is_workshop:\n          if _is_adjacent_to_kind(grid_data, r_curr, c_curr, p_idx, GRID_ROWS, GRID_COLS):\n              return True, [] # Goal achieved, no further action needed (just proximity)\n          return False, []\n\n      # Case 3: Other non-grabbable items (e.g., WATER, STONE if they are the target and not workshops).\n      # Agent needs to be directly on the item's cell.\n      else:\n          if grid_data[r_curr, c_curr, p_idx] == 1:\n              return True, [] # Goal achieved, no further action needed (just being on it)\n          return False, []\n\n  # BFS setup\n  start_pos_r, start_pos_c = state.pos\n  start_dir = state.dir # Agent's current facing direction\n\n  q = collections.deque()\n  # Queue stores tuples: (current_pos_r, current_pos_c, current_dir, list_of_actions_to_reach_here)\n  q.append((start_pos_r, start_pos_c, start_dir, []))\n\n  # Visited set: (pos_r, pos_c, current_dir) to avoid redundant exploration and cycles\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  # Define obstacles: Any non-grabbable entity that is NOT the primitive we are trying to collect.\n  # If the primitive itself is a non-grabbable (e.g., WATER, WORKSHOP), it should not be an obstacle.\n  obstacle_kinds_set = set(world.non_grabbable_indices)\n  obstacle_kinds_set.discard(primitive_idx) # Allow moving onto/next to the target if it's non-grabbable\n\n  # --- Initial check for collection at the starting state ---\n  # This handles cases where the agent begins already in a collectible position.\n  is_achieved_initial, actions_initial_complete = _check_goal_achieved(\n      start_pos_r, start_pos_c, start_dir,\n      grid, primitive_idx, is_grabbable, is_workshop_target, ACTION_USE\n  )\n  if is_achieved_initial:\n      return actions_initial_complete\n\n  # BFS Pathfinding Loop\n  while q:\n    r, c, current_dir, path = q.popleft()\n\n    # Explore neighbors by attempting movement actions\n    for action_id, (dr_move, dc_move, new_dir) in action_moves.items():\n      next_r, next_c = r + dr_move, c + dc_move\n      next_state_dir = new_dir\n\n      # Check if the next position is within grid boundaries\n      if not (0 <= next_r < GRID_ROWS and 0 <= next_c < GRID_COLS):\n        continue\n\n      # Check if the next cell is blocked by an obstacle\n      is_blocked = False\n      for k_idx in obstacle_kinds_set:\n          if grid[next_r, next_c, k_idx] > 0:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue\n\n      # Check if this (position, direction) state has already been visited\n      if (next_r, next_c, next_state_dir) in visited:\n        continue\n\n      new_path = path + [action_id]\n      \n      # After moving to the new state, check if the goal is achieved from this state\n      is_achieved, actions_to_complete = _check_goal_achieved(\n          next_r, next_c, next_state_dir,\n          grid, primitive_idx, is_grabbable, is_workshop_target, ACTION_USE\n      )\n      if is_achieved:\n          # If goal is achieved, return the path to reach this state plus any final actions\n          return new_path + actions_to_complete\n\n      # If the goal is not yet achieved, add this new state to the queue for further exploration\n      visited.add((next_r, next_c, next_state_dir))\n      q.append((next_r, next_c, next_state_dir, new_path))\n\n  # If the queue becomes empty and no path was found to collect the primitive\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:06:22.085107", "function_name": "collect", "function_body": "  def _is_adjacent_to_kind_at_pos(grid_data, agent_r, agent_c, target_kind_idx, grid_rows, grid_cols):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around (agent_r, agent_c) contains target_kind_idx.\n      This helper is used to determine if a non-grabbable primitive is \"collected\" by proximity.\n      \"\"\"\n      for dr_adj in [-1, 0, 1]:\n          for dc_adj in [-1, 0, 1]:\n              adj_r, adj_c = agent_r + dr_adj, agent_c + dc_adj\n              # Check if the adjacent cell is within grid boundaries\n              if (0 <= adj_r < grid_rows and 0 <= adj_c < grid_cols):\n                  # Check if the target kind is present at the adjacent cell (count > 0)\n                  if grid_data[adj_r, adj_c, target_kind_idx] > 0:\n                      return True\n      return False\n\n  # Retrieve current environment state and world configuration\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get action mappings from the environment's action_specs\n  action_specs = env.action_specs()\n  ACTION_UP = action_specs['UP']\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  # Get the integer index for the primitive from the cookbook's index\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # If the primitive name is not recognized in the cookbook, it cannot be collected.\n    return []\n\n  # Determine if the primitive is a 'grabbable' item (requires 'USE' action to pick up)\n  is_grabbable = primitive_idx in world.grabbable_indices\n\n  # Optimization: If it's a grabbable item and already in the agent's inventory,\n  # no actions are needed as the collection goal is already satisfied.\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n      return []\n\n  # Current agent's position, direction, and the grid layout of the world\n  start_pos_r, start_pos_c = state.pos\n  start_dir = state.dir # Agent's initial facing direction (0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  grid = state.grid      # The current grid layout (numpy.ndarray: HEIGHT x WIDTH x n_kinds)\n  \n  grid_rows, grid_cols, _ = grid.shape # Dimensions of the grid\n\n  # Define possible movement actions and their effects on (row_change, col_change, new_direction_value)\n  # The new_direction_value corresponds to the agent's internal state.dir after the move.\n  move_actions = {\n      ACTION_UP:    (-1, 0, 0),  # Move UP: row decreases by 1, agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),   # Move DOWN: row increases by 1, agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3),  # Move LEFT: col decreases by 1, agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),   # Move RIGHT: col increases by 1, agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell for an ACTION_USE, relative to the agent's position\n  # based on its current facing direction.\n  direction_to_target_delta = {\n      0: (-1, 0),  # Agent facing UP (dir 0) targets the cell above (r-1, c)\n      1: (0, 1),   # Agent facing RIGHT (dir 1) targets the cell to the right (r, c+1)\n      2: (1, 0),   # Agent facing DOWN (dir 2) targets the cell below (r+1, c)\n      3: (0, -1),  # Agent facing LEFT (dir 3) targets the cell to the left (r, c-1)\n  }\n\n  # Define obstacles: These are non-grabbable entities that the agent cannot typically move onto.\n  # This set includes any non-grabbable entity, including the primitive itself if it's non-grabbable\n  # (e.g., \"WATER\", \"WORKSHOP0\"). The agent's goal for such items is to be adjacent, not on top of them.\n  obstacle_kinds = set(world.non_grabbable_indices)\n\n  # --- Initial check: Is the primitive collectable from the agent's starting state? ---\n  if is_grabbable:\n      # If the item is grabbable, check if the agent is already in position to 'USE' it.\n      # Calculate the cell directly in front of the agent.\n      target_dr, target_dc = direction_to_target_delta[start_dir]\n      target_r, target_c = start_pos_r + target_dr, start_pos_c + target_dc\n\n      # Check if this target cell is within grid bounds and contains the primitive.\n      if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n          grid[target_r, target_c, primitive_idx] > 0): \n          # Agent is already facing the grabbable item. Only the 'USE' action is needed.\n          return [ACTION_USE]\n  else:\n      # If the item is non-grabbable, check if the agent is already adjacent to it.\n      if _is_adjacent_to_kind_at_pos(grid, start_pos_r, start_pos_c, primitive_idx, grid_rows, grid_cols):\n          # Agent is already adjacent to the non-grabbable item. No further actions needed for collection.\n          return []\n\n  # --- Breadth-First Search (BFS) for the shortest path ---\n  q = collections.deque()\n  # Queue stores tuples: (current_row, current_col, current_direction, list_of_actions_to_reach_here)\n  q.append((start_pos_r, start_pos_c, start_dir, []))\n\n  # Visited set to prevent revisiting states and cycles.\n  # A state is defined by the agent's (row, col, direction).\n  visited = {(start_pos_r, start_pos_c, start_dir)}\n\n  while q:\n    r, c, current_dir, path = q.popleft() # Dequeue the current state and path to reach it\n\n    # Explore all possible movement actions from the current state\n    for action_id, (dr_move, dc_move, new_facing_dir) in move_actions.items():\n      next_r, next_c = r + dr_move, c + dc_move\n      next_dir = new_facing_dir # Agent's direction after performing this movement action\n\n      # 1. Boundary Check: Ensure the new position is within the grid boundaries.\n      if not (0 <= next_r < grid_rows and 0 <= next_c < grid_cols):\n        continue\n\n      # 2. Obstacle Check: Determine if the new position is blocked by any obstacle.\n      is_blocked = False\n      for k_idx in obstacle_kinds:\n          # If any kind marked as an obstacle is present at the next cell, it's blocked.\n          # This correctly handles cases where the primitive itself is a non-grabbable obstacle.\n          if grid[next_r, next_c, k_idx] > 0:\n              is_blocked = True\n              break\n      if is_blocked:\n          continue # Cannot move onto an obstacle.\n\n      # 3. Visited Check: Ensure this (position, direction) state has not been visited before.\n      if (next_r, next_c, next_dir) in visited:\n        continue\n\n      # If all checks pass, this is a valid new state.\n      new_path = path + [action_id]\n      visited.add((next_r, next_c, next_dir)) # Mark the new state as visited\n\n      # --- Check if the primitive is collectable from this new state (next_r, next_c, next_dir) ---\n      if is_grabbable:\n          # For grabbable items, the agent must be in a position to face and 'USE' the item.\n          target_dr, target_dc = direction_to_target_delta[next_dir]\n          target_r, target_c = next_r + target_dr, next_c + target_dc\n\n          # Check if the target cell is valid and contains the primitive.\n          if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n              grid[target_r, target_c, primitive_idx] > 0): \n              # Found a path to reach a position where the primitive can be used.\n              return new_path + [ACTION_USE] # Append the 'USE' action to complete collection.\n      else:\n          # For non-grabbable items, being adjacent to the primitive at the new position is sufficient.\n          if _is_adjacent_to_kind_at_pos(grid, next_r, next_c, primitive_idx, grid_rows, grid_cols):\n              # Found a path to be adjacent to the primitive.\n              return new_path # No additional 'USE' action is typically needed for non-grabbables.\n      \n      # If the goal is not yet achieved from this new state, add it to the queue for further exploration.\n      q.append((next_r, next_c, next_dir, new_path))\n\n  # If the BFS queue becomes empty and no path was found to collect the primitive, return an empty list.\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:06:24.124400", "function_name": "collect", "function_body": "  def _check_next_to_at_pos(grid, pos, kind_idx, WIDTH, HEIGHT):\n      \"\"\"\n      Checks if any cell in the 3x3 neighborhood around `pos` contains `kind_idx`.\n      This is a generalized version of CraftState.next_to for an arbitrary position.\n      \"\"\"\n      cx, cy = pos\n      for dx in [-1, 0, 1]:\n          for dy in [-1, 0, 1]:\n              nx, ny = cx + dx, cy + dy\n              # Check bounds\n              if 0 <= nx < WIDTH and 0 <= ny < HEIGHT:\n                  # Check if the kind_idx is present at this neighbor cell\n                  # We use `> 0` to check for presence, as inventory/grid cells can store counts.\n                  if grid[nx, ny, kind_idx] > 0:\n                      return True\n      return False\n\n  action_map = env.action_specs()\n  ACTION_UP = action_map['UP']\n  ACTION_DOWN = action_map['DOWN']\n  ACTION_LEFT = action_map['LEFT']\n  ACTION_RIGHT = action_map['RIGHT']\n  ACTION_USE = action_map['USE']\n\n  state = env._current_state\n  world = state.world\n  cookbook = world.cookbook\n\n  # Get the integer index for the primitive\n  try:\n    primitive_idx = cookbook.index[primitive]\n  except KeyError:\n    # Primitive name not found in index, cannot collect\n    return []\n\n  # Determine if the primitive is grabbable (requires 'USE' action and specific orientation)\n  # Grabbable items are those that can be picked up, typically requiring the 'USE' action when facing them.\n  is_grabbable = primitive_idx in world.grabbable_indices\n\n  # If it's a grabbable item and already in inventory, no need to collect\n  if is_grabbable and state.inventory[primitive_idx] > 0:\n      return []\n\n  # Current state details\n  start_pos = state.pos  # Agent's current position (row, col)\n  start_dir = state.dir  # Agent's current facing direction (int: 0:UP, 1:RIGHT, 2:DOWN, 3:LEFT)\n  grid = state.grid      # Current grid layout (WIDTH, HEIGHT, n_kinds)\n  \n  grid_rows, grid_cols, _ = grid.shape # Dimensions of the grid\n\n  # Define movement actions and their effects on (dr, dc, new_dir_value)\n  # The new_dir_value corresponds to the agent's internal state.dir\n  action_moves = {\n      ACTION_UP:    (-1, 0, 0), # Move UP (dr=-1, dc=0), agent faces UP (dir 0)\n      ACTION_DOWN:  (1, 0, 2),  # Move DOWN (dr=1, dc=0), agent faces DOWN (dir 2)\n      ACTION_LEFT:  (0, -1, 3), # Move LEFT (dr=0, dc=-1), agent faces LEFT (dir 3)\n      ACTION_RIGHT: (0, 1, 1),  # Move RIGHT (dr=0, dc=1), agent faces RIGHT (dir 1)\n  }\n\n  # Define how to calculate the target cell based on agent's direction (for ACTION_USE)\n  dir_to_target_delta = {\n      0: (-1, 0),  # Agent facing UP (dir 0) targets cell above (r-1, c)\n      1: (0, 1),   # Agent facing RIGHT (dir 1) targets cell to the right (r, c+1)\n      2: (1, 0),   # Agent facing DOWN (dir 2) targets cell below (r+1, c)\n      3: (0, -1),  # Agent facing LEFT (dir 3) targets cell to the left (r, c-1)\n  }\n\n  # Define obstacles: Any non-grabbable entity that the agent cannot typically move onto.\n  # This set *excludes* the primitive itself if the primitive is a non-grabbable item\n  # that the agent needs to stand on or be adjacent to (e.g., water, workshops).\n  obstacle_kinds_set = set(world.non_grabbable_indices)\n  if not is_grabbable: # If the target primitive is itself non-grabbable (e.g., WATER, WORKSHOP)\n      # Then the agent might need to move onto its cell or adjacent to it.\n      # So, it should not be considered an obstacle for pathfinding to reach it.\n      if primitive_idx in obstacle_kinds_set: # Only try to remove if it was actually there\n        obstacle_kinds_set.discard(primitive_idx)\n\n  # --- Handle immediate collection if agent is already in a state to collect ---\n  # This check covers the scenario where the agent is already at the target location\n  # or in the correct orientation to perform a USE action.\n  if is_grabbable:\n      # For grabbable items, the agent must be facing the item and then USE it.\n      target_dr, target_dc = dir_to_target_delta[start_dir]\n      target_r, target_c = start_pos[0] + target_dr, start_pos[1] + target_dc\n\n      # Check if this target cell is within bounds and contains the primitive\n      if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n          grid[target_r, target_c, primitive_idx] > 0): \n          return [ACTION_USE] # Agent just needs to perform USE action\n  else:\n      # For non-grabbable items, being adjacent to the primitive is usually sufficient.\n      # This includes being on the same cell if the primitive is a \"floor\" type item (like water).\n      if _check_next_to_at_pos(grid, start_pos, primitive_idx, grid_rows, grid_cols):\n          return [] # Already \"collected\" by being adjacent or on it.\n\n  # --- BFS Pathfinding Loop ---\n  q = collections.deque()\n  # Queue stores tuples: (current_pos_r, current_pos_c, current_dir, list_of_actions_to_reach_here)\n  q.append((start_pos[0], start_pos[1], start_dir, []))\n\n  # Visited set: (pos_r, pos_c, current_dir) to avoid cycles and redundant exploration\n  visited = {(start_pos[0], start_pos[1], start_dir)}\n\n  while q:\n    r, c, current_dir, path = q.popleft() # Current position, direction, and path to reach it\n\n    # Explore neighbors by taking movement actions\n    for action_id, (dr, dc, new_facing_dir) in action_moves.items():\n      next_r, next_c = r + dr, c + dc\n      next_dir = new_facing_dir # Agent's direction after this movement action\n\n      # Check bounds: ensure the new agent position is within the grid\n      if not (0 <= next_r < grid_rows and 0 <= next_c < grid_cols):\n        continue\n\n      # Check if the new position is an obstacle (cannot move onto it)\n      is_obstacle_at_next_pos = False\n      for k_idx in obstacle_kinds_set: # Use the refined obstacle set\n          if grid[next_r, next_c, k_idx] > 0: # Check if any obstacle is present at next_pos\n              is_obstacle_at_next_pos = True\n              break\n      if is_obstacle_at_next_pos:\n          continue # Cannot move onto an obstacle\n\n      # Check if this (position, direction) state has already been visited\n      if (next_r, next_c, next_dir) in visited:\n        continue\n\n      new_path = path + [action_id]\n      \n      # Mark new state as visited BEFORE checking for goal, to ensure we don't re-add it\n      # if it's not a goal state but could lead to one.\n      visited.add((next_r, next_c, next_dir)) \n\n      # --- Check if the primitive is collectable from this new state ---\n      # This check determines if reaching (next_r, next_c) with next_dir leads to collection.\n      if is_grabbable:\n          # For grabbable items, the agent must move to an adjacent cell and then USE it.\n          # Calculate the cell directly in front of the agent at its new position and direction\n          target_dr, target_dc = dir_to_target_delta[next_dir]\n          target_r, target_c = next_r + target_dr, next_c + target_dc\n\n          # Check if this target cell is within bounds and contains the primitive\n          if (0 <= target_r < grid_rows and 0 <= target_c < grid_cols and\n              grid[target_r, target_c, primitive_idx] > 0): \n              # Found a state where agent can use the primitive. Append USE action.\n              return new_path + [ACTION_USE]\n      else:\n          # For non-grabbable items, being adjacent to the primitive at the new position is sufficient.\n          if _check_next_to_at_pos(grid, (next_r, next_c), primitive_idx, grid_rows, grid_cols):\n              # Found a path to be adjacent to the primitive\n              return new_path\n      \n      # If not yet collected, add this new state to the queue for further exploration\n      q.append((next_r, next_c, next_dir, new_path))\n\n  # If the queue becomes empty and no path was found to collect the primitive\n  return []", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:07:26.160590", "function_name": "collect", "function_body": "  actions_list = []\n\n  # 1. Get the integer ID of the primitive.\n  # The DSL ensures 'primitive' is a valid string (e.g., 'WOOD', 'STONE').\n  # The `cookbook.index.index` method will return a positive integer ID (>= 1) for\n  # all defined primitive types, adding them if not already present.\n  primitive_idx = env.world.cookbook.index.index(primitive)\n\n  # Get action mappings for clarity and direct use from the environment's action_specs.\n  action_map = env.action_specs()\n  UP = action_map['UP']\n  DOWN = action_map['DOWN']\n  LEFT = action_map['LEFT']\n  RIGHT = action_map['RIGHT']\n  USE = action_map['USE']\n\n  # Get current state details from the environment's internal state.\n  current_state = env._current_state\n  current_pos = current_state.pos # (y, x) tuple representing agent's current position\n  current_grid = current_state.grid # The full grid as a numpy array (HEIGHT, WIDTH, n_kinds)\n  grid_height, grid_width, _ = current_grid.shape\n\n  # Determine if the primitive is a 'grabbable' item (requiring a USE action)\n  # or a 'non-grabbable' one (like a workshop, where proximity is enough).\n  is_grabbable = primitive_idx in env.world.grabbable_indices\n\n  # 2. Early exit: Check if the agent is already adjacent to the desired primitive.\n  # CraftState.next_to checks the 3x3 neighborhood around the agent's position for the item.\n  if current_state.next_to(primitive_idx):\n      if is_grabbable:\n          # If already next to a grabbable item, simply use it.\n          return [USE]\n      else:\n          # If already next to a non-grabbable item (e.g., workshop),\n          # no further actions are needed as collection is implicit by proximity.\n          return []\n\n  # 3. Scan the entire grid to find all occurrences of the primitive.\n  # This provides all possible target locations for the BFS.\n  # Using numpy.argwhere for a more concise way to find all (y, x) coordinates.\n  primitive_locations_arr = np.argwhere(current_grid[:, :, primitive_idx] == 1)\n  # Convert array of arrays to list of tuples for consistency with visited set and queue.\n  primitive_locations = [tuple(loc) for loc in primitive_locations_arr]\n\n  # If the primitive is not found anywhere on the grid, it cannot be collected.\n  if not primitive_locations:\n      return []\n\n  # 4. Perform a Breadth-First Search (BFS) to find the shortest path\n  # to a cell that is adjacent to any of the found primitive locations.\n  # The queue stores tuples of (current_coordinates, path_taken_to_reach_here).\n  q = collections.deque([(current_pos, [])])\n  # The visited set keeps track of (y, x) coordinates already explored to prevent cycles\n  # and redundant computation.\n  visited = {current_pos}\n\n  # Define possible cardinal moves (dy, dx) and their corresponding actions.\n  moves = {\n      (-1, 0): UP,    # Move Up (decrement row index)\n      (1, 0): DOWN,   # Move Down (increment row index)\n      (0, -1): LEFT,  # Move Left (decrement column index)\n      (0, 1): RIGHT, # Move Right (increment column index)\n  }\n\n  # Identify the index for water, which is explicitly defined as an impassable terrain.\n  water_idx = env.world.water_index\n\n  while q:\n      (curr_y, curr_x), path = q.popleft()\n\n      # For each known primitive location, check if the current BFS node (curr_y, curr_x)\n      # is directly adjacent (Manhattan distance of 1). This is our goal condition for BFS.\n      for p_y, p_x in primitive_locations:\n          if abs(curr_y - p_y) + abs(curr_x - p_x) == 1:\n              # A path has been found to a cell adjacent to a primitive.\n              if is_grabbable:\n                  # If the item is grabbable, the sequence of actions includes\n                  # moving to the adjacent cell and then performing the USE action.\n                  return path + [USE]\n              else:\n                  # If the item is non-grabbable (e.g., a workshop),\n                  # simply reaching an adjacent cell is sufficient to \"collect\" it.\n                  return path\n\n      # Explore all valid neighboring cells from the current position.\n      for (dy, dx), action in moves.items():\n          next_y, next_x = curr_y + dy, curr_x + dx\n          next_coords = (next_y, next_x)\n\n          # Ensure the next coordinates are within the grid boundaries.\n          if not (0 <= next_y < grid_height and 0 <= next_x < grid_width):\n              continue\n\n          # Ensure the next cell is not an impassable terrain (like water).\n          if current_grid[next_y, next_x, water_idx] == 1:\n              continue\n\n          # If the next cell has not been visited yet, add it to the queue\n          # with the updated path. This prevents cycles and redundant path exploration.\n          if next_coords not in visited:\n              visited.add(next_coords)\n              q.append((next_coords, path + [action]))\n\n  # If the queue becomes empty and no path was found (e.g., primitive is unreachable),\n  # return an empty list.\n  return []", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:07:28.909685", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:08:17.879063", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index[primitive]\n  current_state = env._current_state\n\n  # Check if already next to the primitive (using the agent's 3x3 next_to method)\n  if current_state.next_to(primitive_idx):\n      return [action_map['USE']]\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations where the primitive exists on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  # If no primitive found anywhere on the grid, return empty path\n  if len(primitive_locations) == 0:\n      return []\n\n  # Pre-calculate cells that are *adjacent* to any primitive.\n  # These are the target cells for our pathfinding, as 'USE' acts on adjacent items.\n  adj_to_primitive_map = np.full((grid_height, grid_width), False, dtype=bool)\n\n  # Define relative neighbor offsets for 4-directional adjacency (Manhattan distance 1).\n  # These are the positions from which 'USE' could effectively be applied to a primitive.\n  neighbor_offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n  for pr, pc in primitive_locations:\n      for dr, dc in neighbor_offsets:\n          adj_r, adj_c = pr + dr, pc + dc\n          # Check bounds for the calculated adjacent cell\n          if 0 <= adj_r < grid_height and 0 <= adj_c < grid_width:\n              adj_to_primitive_map[adj_r, adj_c] = True\n\n  # Define possible moves and their corresponding actions\n  moves = {\n      (0, 1): action_map['RIGHT'],\n      (0, -1): action_map['LEFT'],\n      (1, 0): action_map['DOWN'],\n      (-1, 0): action_map['UP'],\n  }\n\n  # Identify impassable terrain indices using the world's non-grabbable entities.\n  # This includes water, stone, and workshops, which typically block movement.\n  impassable_indices = env.world.non_grabbable_indices\n\n  # BFS (Breadth-First Search) initialization\n  queue = collections.deque([((agent_r, agent_c), [])])\n  visited = {(agent_r, agent_c)} # Keep track of visited (r, c) tuples to avoid cycles and redundant paths\n\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # If the current cell (r, c) is adjacent to a primitive (as pre-calculated),\n      # we have found the shortest path to a \"collectible\" position.\n      if adj_to_primitive_map[r, c]:\n          # Return the path to this cell followed by the 'USE' action.\n          return path + [action_map['USE']]\n\n      # Explore neighbors\n      for (dr, dc), action in moves.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Check if the next position is within grid boundaries\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Check if the next cell contains any impassable entities\n          is_impassable = False\n          for kind_idx in impassable_indices:\n              if grid[next_r, next_c, kind_idx] > 0: # If the cell contains this impassable kind\n                  is_impassable = True\n                  break\n          if is_impassable:\n              continue\n\n          # Check if this position has already been visited\n          if next_pos in visited:\n              continue\n\n          # If valid and unvisited, add to visited set and queue\n          visited.add(next_pos)\n          new_path = path + [action]\n          queue.append((next_pos, new_path))\n\n  # If the BFS completes and no path to an adjacent primitive cell is found\n  return []", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:08:19.965950", "function_name": "collect", "function_body": "  action_map = env.action_specs()\n  primitive_idx = env.world.cookbook.index.get(primitive)\n  if primitive_idx is None:\n      return []\n\n  current_state = env._current_state\n\n  # If the agent is already next to the primitive, simply use it.\n  if current_state.next_to(primitive_idx):\n      return [action_map['USE']]\n\n  agent_r, agent_c = current_state.pos\n  grid = current_state.grid\n  grid_height, grid_width, _ = grid.shape\n\n  # Find all locations of the primitive on the grid\n  primitive_locations = np.argwhere(grid[:, :, primitive_idx] > 0)\n\n  if len(primitive_locations) == 0:\n      return [] # Primitive not found anywhere on the grid\n\n  # Define possible moves and their corresponding actions (dr, dc) -> action_id\n  moves_dir = {\n      (0, 1): action_map['RIGHT'],\n      (0, -1): action_map['LEFT'],\n      (1, 0): action_map['DOWN'],\n      (-1, 0): action_map['UP'],\n  }\n\n  # Identify impassable entity indices from the world configuration\n  impassable_indices = {env.world.water_index, env.world.stone_index}\n\n  # Pre-calculate all valid \"target cells\" - these are cells from which the primitive can be 'USE'd.\n  # A target cell must be adjacent to a primitive location and must be traversable by the agent.\n  target_cells = set()\n  for pr, pc in primitive_locations:\n      for dr, dc in moves_dir.keys(): # Check 4 cardinal neighbors of the primitive\n          adj_r, adj_c = pr + dr, pc + dc\n          adj_pos = (adj_r, adj_c)\n\n          # Check bounds for the adjacent cell\n          if not (0 <= adj_r < grid_height and 0 <= adj_c < grid_width):\n              continue\n          \n          # Check if the adjacent cell is impassable for the agent\n          is_adj_cell_impassable = False\n          for idx in impassable_indices:\n              if grid[adj_r, adj_c, idx] > 0:\n                  is_adj_cell_impassable = True\n                  break\n          \n          if not is_adj_cell_impassable:\n              target_cells.add(adj_pos)\n  \n  # If no accessible cells adjacent to primitives exist (e.g., all are blocked or out of bounds)\n  if not target_cells:\n      return []\n\n  # Breadth-First Search (BFS) to find the shortest path from the agent's current position\n  # to any of the pre-calculated target cells.\n  queue = collections.deque([((agent_r, agent_c), [])]) # Stores (current_position, path_taken_to_reach_here)\n  visited = {(agent_r, agent_c)} # Stores visited (r, c) tuples to avoid cycles and redundant paths\n\n  while queue:\n      (r, c), path = queue.popleft()\n\n      # Check if the current cell (r, c) is one of our target cells.\n      # If it is, we've found a path to a location from which we can 'USE' the primitive.\n      if (r, c) in target_cells:\n          return path + [action_map['USE']]\n\n      # Explore neighbors of the current cell\n      for (dr, dc), action in moves_dir.items():\n          next_r, next_c = r + dr, c + dc\n          next_pos = (next_r, next_c)\n\n          # Boundary check for the next cell\n          if not (0 <= next_r < grid_height and 0 <= next_c < grid_width):\n              continue\n\n          # Impassable check for the next cell: agent cannot move into water/stone\n          is_next_cell_impassable = False\n          for idx in impassable_indices:\n              if grid[next_r, next_c, idx] > 0:\n                  is_next_cell_impassable = True\n                  break\n          if is_next_cell_impassable:\n              continue\n\n          # Visited check: avoid revisiting cells and longer paths\n          if next_pos in visited:\n              continue\n\n          # If the next cell is valid and unvisited, add it to the queue\n          visited.add(next_pos)\n          queue.append((next_pos, path + [action]))\n\n  # If the BFS completes and no path to a target cell is found\n  return []", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:09:07.288700", "function_name": "collect", "function_body": "  import collections\n\n  # 1. Get action IDs from the environment's action specifications for robustness.\n  action_specs = env.action_specs()\n  ACTION_DOWN = action_specs['DOWN']\n  ACTION_UP = action_specs['UP']\n  ACTION_LEFT = action_specs['LEFT']\n  ACTION_RIGHT = action_specs['RIGHT']\n  ACTION_USE = action_specs['USE']\n\n  actions_to_return = [] # This list will accumulate the planned actions.\n\n  # 2. Convert the DSL primitive name to the internal lowercase name for lookup\n  # and get its integer ID from the cookbook's index.\n  primitive_name_lower = primitive.lower()\n  try:\n      primitive_id = env.world.cookbook.index[primitive_name_lower]\n  except KeyError:\n      # If the primitive name is not recognized by the cookbook, it's not a valid target.\n      # This case shouldn't ideally happen with well-formed DSL input, but it's a safe guard.\n      return []\n\n  # 3. Get current state information needed for planning.\n  current_obs = env.observations()\n  # Agent's current position (x, y) - convert numpy array to tuple for hashability in sets.\n  current_pos = tuple(map(int, current_obs['features_dict']['pos']))\n  grid = current_obs['features_dict']['features_global'] # Full grid for pathfinding\n  inventory = current_obs['features_dict']['inventory'] # Current inventory\n\n  # 4. Early Exit Conditions:\n  #    a) If the primitive is not grabbable, it cannot be collected via the USE action.\n  if primitive_id not in env.world.grabbable_indices:\n      return [] # Cannot collect, so no actions are possible or needed.\n\n  #    b) If the grabbable primitive is already in the agent's inventory.\n  if inventory[primitive_id] > 0:\n      return [] # Already collected, return an empty list of actions.\n\n  # 5. Determine grid dimensions (WIDTH, HEIGHT).\n  # The grid has shape (WIDTH, HEIGHT, n_kinds).\n  WIDTH, HEIGHT, _ = grid.shape\n\n  # 6. Map movement differentials (dx, dy) to corresponding action IDs.\n  # This simplifies converting a path of (x,y) coordinates into a sequence of actions.\n  move_deltas_to_action_id = {\n      (0, -1): ACTION_UP,    # Moving North (y-coordinate decreases)\n      (0, 1): ACTION_DOWN,   # Moving South (y-coordinate increases)\n      (-1, 0): ACTION_LEFT,  # Moving West (x-coordinate decreases)\n      (1, 0): ACTION_RIGHT,  # Moving East (x-coordinate increases)\n  }\n\n  # 7. Identify impassable cell types for agent movement.\n  impassable_kind_ids = set()\n  # \"boundary\" (walls) are typically always impassable.\n  impassable_kind_ids.add(env.world.cookbook.index[\"boundary\"])\n  # \"water\" is also commonly an impassable obstacle for direct agent movement.\n  # Use `env.world.water_index` if available, otherwise fallback to cookbook index.\n  if hasattr(env.world, 'water_index'):\n      impassable_kind_ids.add(env.world.water_index)\n  else:\n      try:\n          impassable_kind_ids.add(env.world.cookbook.index[\"water\"])\n      except KeyError:\n          pass # 'water' might not be a defined kind in all environments, ignore if not found.\n\n  # 8. BFS Initialization.\n  # The queue stores tuples: (current_agent_position_xy, path_of_agent_positions_xy).\n  # `path_of_agent_positions_xy` is a list of (x,y) coordinate tuples.\n  queue = collections.deque([(current_pos, [current_pos])])\n  \n  # `visited` set tracks (x,y) coordinates that have been added to the queue\n  # to prevent infinite loops and redundant exploration.\n  visited = {current_pos}\n\n  # This will store the shortest path (sequence of agent positions) that leads to\n  # a location from which the `primitive_id` can be collected using the 'USE' action.\n  # This means the primitive must be in the 3x3 neighborhood of the agent's final position.\n  path_to_use_location = None \n\n  # 9. BFS Loop to find the shortest path to a 'use' location.\n  while queue:\n      (current_x, current_y), path_so_far = queue.popleft() # Dequeue the current agent state\n\n      # Check if the target primitive is in the 3x3 neighborhood of the current agent position.\n      # The 'USE' action interacts with the 3x3 area around the agent.\n      primitive_is_nearby = False\n      for dy_offset in [-1, 0, 1]:\n          for dx_offset in [-1, 0, 1]:\n              neighbor_x, neighbor_y = current_x + dx_offset, current_y + dy_offset\n\n              # Ensure the neighbor cell is within grid boundaries.\n              if not (0 <= neighbor_x < WIDTH and 0 <= neighbor_y < HEIGHT):\n                  continue\n\n              # Check if the `primitive_id` is present in this neighbor cell.\n              # `grid[x_coord, y_coord, kind_id]` indicates presence (usually 1 or 0 for existence).\n              if grid[neighbor_x, neighbor_y, primitive_id] > 0:\n                  primitive_is_nearby = True\n                  break # Primitive found nearby, no need to check other offsets in this neighborhood.\n          if primitive_is_nearby:\n              break # Found it, exit the outer offset loop to process this path.\n\n      # If the primitive is found in the 3x3 neighborhood of the current agent position,\n      # then `path_so_far` is the shortest path to a valid 'use' location.\n      if primitive_is_nearby:\n          path_to_use_location = path_so_far # Store this path.\n          break # Path found, exit the main BFS loop.\n\n      # If the primitive is not yet found nearby, explore valid adjacent cells for agent movement.\n      # Only consider cardinal directions (N, S, E, W) for agent movement actions.\n      for dx, dy in move_deltas_to_action_id.keys():\n          next_agent_x, next_agent_y = current_x + dx, current_y + dy\n\n          # Check if the next agent position is within grid boundaries.\n          if not (0 <= next_agent_x < WIDTH and 0 <= next_agent_y < HEIGHT):\n              continue\n\n          # Check if the proposed next agent position is impassable due to obstacles.\n          is_next_cell_impassable = False\n          for obstacle_id in impassable_kind_ids:\n              if grid[next_agent_x, next_agent_y, obstacle_id] > 0:\n                  is_next_cell_impassable = True\n                  break\n          if is_next_cell_impassable:\n              continue # This cell is blocked for movement, skip it.\n\n          # If the next cell is traversable and has not been visited yet, add it to the queue.\n          if (next_agent_x, next_agent_y) not in visited:\n              visited.add((next_agent_x, next_agent_y))\n              queue.append(((next_agent_x, next_agent_y), path_so_far + [(next_agent_x, next_agent_y)]))\n\n  # 10. If a path to a 'use' location was found, convert this coordinate path into a sequence of actions.\n  if path_to_use_location:\n      # Iterate through the path to generate movement actions.\n      # We iterate up to the second-to-last element, as each action connects two points.\n      for i in range(len(path_to_use_location) - 1):\n          from_x, from_y = path_to_use_location[i]\n          to_x, to_y = path_to_use_location[i+1]\n\n          # Calculate the relative movement (change in x, change in y).\n          delta_x = to_x - from_x\n          delta_y = to_y - from_y\n\n          # Append the corresponding action ID using the pre-defined map.\n          actions_to_return.append(move_deltas_to_action_id[(delta_x, delta_y)])\n\n      # After all movements are completed, the agent is at the optimal position.\n      # Perform the 'USE' action to collect the primitive.\n      actions_to_return.append(ACTION_USE)\n\n  return actions_to_return", "island_id": 4, "scores": {"3": 0.0}}
