"scores": {"3": 0.0}}
{"timestamp": "2025-07-28T22:08:29.495273", "function_name": "collect", "function_body": "  def bfs_find_primitive(grid, pos, target):\n    from collections import deque\n    \n    queue = deque([pos])\n    visited = set([pos])\n    parent = {}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        if grid[x, y, target] > 0:\n            path = []\n            while (x, y) != pos:\n                path.append((x, y))\n                x, y = parent[(x, y)]\n            return path[::-1]\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n  \n  primitive_index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  path = bfs_find_primitive(grid, pos, primitive_index)\n\n  actions = []\n  \n  if path is not None:\n      for (nx, ny) in path:\n          dx, dy = nx - pos[0], ny - pos[1]\n          direction = None\n          if dx == 0 and dy > 0:\n              direction = 3  # RIGHT\n          elif dx == 0 and dy < 0:\n              direction = 2  # LEFT\n          elif dx < 0 and dy == 0:\n              direction = 1  # UP\n          elif dx > 0 and dy == 0:\n              direction = 0  # DOWN\n\n          if direction is not None:\n            actions.append(direction)\n            pos = (nx, ny)  # Update the position after each step\n      \n      actions.append(4)  # USE action to collect the primitive\n  else:\n    while True:\n        direction = np.random.choice([0, 1, 2, 3])  # DOWN, UP, LEFT, RIGHT\n        reward, done, observations = env.step(direction)\n        \n        if env._current_state.next_to(primitive_index):\n            actions.append(4)  # USE action to collect the primitive\n            break\n\n        if done:\n            return actions\n        \n        actions.append(direction)\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T22:08:31.429106", "function_name": "collect", "function_body": "  def bfs_find_primitive(grid, pos, target):\n    from collections import deque\n    \n    queue = deque([pos])\n    visited = set([pos])\n    parent = {}\n    \n    while queue:\n        x, y = queue.popleft()\n        \n        if grid[x, y, target] > 0:\n            path = []\n            while (x, y) != pos:\n                path.append((x, y))\n                x, y = parent[(x, y)]\n            return path[::-1]\n        \n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n                queue.append((nx, ny))\n                visited.add((nx, ny))\n                parent[(nx, ny)] = (x, y)\n    \n    return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  path = bfs_find_primitive(grid, pos, primitive_index)\n\n  actions = []\n  \n  if path is not None:\n      for (nx, ny) in path:\n          dx, dy = nx - pos[0], ny - pos[1]\n          direction = None\n          if dx == 0 and dy > 0:\n              direction = 3  # RIGHT\n          elif dx == 0 and dy < 0:\n              direction = 2  # LEFT\n          elif dx < 0 and dy == 0:\n              direction = 1  # UP\n          elif dx > 0 and dy == 0:\n              direction = 0  # DOWN\n\n          if direction is not None:\n              actions.append(direction)\n              pos = (nx, ny)  # Update the position after each step\n      actions.append(4)  # USE action to collect the primitive\n      \n  else:\n    while True:\n        direction = np.random.choice([0, 1, 2, 3])  # DOWN, UP, LEFT, RIGHT\n        actions.append(direction)\n        reward, done, observations = env.step(direction)\n        \n        if env._current_state.next_to(primitive_index):\n            break\n  \n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T22:09:49.504645", "function_name": "collect", "function_body": "  def get_primitive_index(primitive):\n    if primitive not in env.world.cookbook.index:\n      raise ValueError(f\"Invalid or unknown primitive: {primitive}\")\n    \n    return env.world.cookbook.index[primitive]\n\n  # Get the index of the desired primitive\n  primitive_index = get_primitive_index(primitive)\n\n  def move_towards(target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    \n    # Calculate differences in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n      actions.extend([0] * abs(dy))  # DOWN\n    elif dy < 0:\n      actions.extend([1] * abs(dy))  # UP\n\n    return actions\n\n  def nearest_primitive_position(grid, primitive_index):\n    current_pos = env._current_state.pos\n    min_distance = float('inf')\n    nearest_pos = None\n    \n    for y in range(grid.shape[0]):\n        for x in range(grid.shape[1]):\n            if grid[y, x, primitive_index] > 0:\n                distance = abs(y - current_pos[1]) + abs(x - current_pos[0])\n                if distance < min_distance:\n                    min_distance = distance\n                    nearest_pos = (x, y)\n                    \n    return nearest_pos\n\n  # List to store the sequence of actions needed to collect the primitive\n  actions = []\n\n  while True:\n      target_pos = nearest_primitive_position(env._current_state.grid, primitive_index)\n      \n      if not target_pos:  # No more primitives to collect\n          break\n      \n      actions.extend(move_towards(target_pos))\n      actions.append(4)  # USE to collect the primitive\n\n      # Update the grid after collecting the primitive\n      env._current_state.grid[target_pos[1], target_pos[0], primitive_index] -= 1\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T22:09:51.451640", "function_name": "collect", "function_body": "  def get_primitive_index(primitive):\n    # Check if the primitive is valid and exists in the world's index\n    if primitive not in env.world.cookbook.index:\n      raise ValueError(f\"Invalid or unknown primitive: {primitive}\")\n    \n    # Retrieve the index of the primitive from the cookbook's index\n    return env.world.cookbook.index[primitive]\n\n  # Get the index of the desired primitive\n  primitive_index = get_primitive_index(primitive)\n\n  def move_towards(target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n\n    # Calculate the difference in x and y coordinates\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    if dx > 0:\n      actions.extend([3] * abs(dx))  # RIGHT\n    elif dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    \n    if dy > 0:\n      actions.extend([0] * abs(dy))  # DOWN\n    elif dy < 0:\n      actions.extend([1] * abs(dy))  # UP\n\n    return actions\n\n  def find_primitives():\n    \"\"\"Find all positions of the primitive in the grid.\"\"\"\n    positions = []\n    for y in range(env._current_state.grid.shape[0]):\n        for x in range(env._current_state.grid.shape[1]):\n            if env._current_state.grid[y, x, primitive_index] > 0:\n                positions.append((x, y))\n    return positions\n\n  def calculate_distance(pos1, pos2):\n      \"\"\"Calculate Manhattan distance between two positions.\"\"\"\n      return abs(pos1[0] - pos2[0]) + abs(pos1[1] - pos2[1])\n\n  # List to store the sequence of actions needed to collect the primitive\n  actions = []\n\n  # Find all positions of the primitive in the grid\n  primitives_positions = find_primitives()\n\n  # Sort positions by distance from current position\n  sorted_positions = sorted(primitives_positions, key=lambda pos: calculate_distance(env._current_state.pos, pos))\n\n  # Collect each primitive in order of proximity\n  for target_pos in sorted_positions:\n      actions.extend(move_towards(target_pos))\n      actions.append(4)  # USE to collect the primitive\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
