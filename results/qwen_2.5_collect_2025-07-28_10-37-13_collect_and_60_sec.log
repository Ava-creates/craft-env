{"timestamp": "2025-07-29T02:24:14.153350", "function_name": "collect", "function_body": "  actions = []\n  # Find the index for the desired primitive\n  primitive_index = env.world.cookbook.index.get(primitive)\n\n  # Check if the agent already has some in its inventory\n  if env._current_state.inventory[primitive_index] > 0:\n    return []\n\n  while not env._current_state.next_to(primitive_index):\n    # Move around to find the nearest primitive\n    # Simple approach: move randomly until found or max steps reached\n    action = np.random.choice([0, 1, 2, 3])  # DOWN, UP, LEFT, RIGHT\n    actions.append(action)\n    reward, done, observations = env.step(action)\n    if done:\n      break\n\n  # If the agent is next to the primitive, pick it up\n  if not done and env._current_state.next_to(primitive_index):\n    action = 4  # USE\n    actions.append(action)\n\n  return actions", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-29T02:25:05.104099", "function_name": "collect", "function_body": "  # Define actions\n  LEFT = 2\n  RIGHT = 3\n  UP = 1\n  DOWN = 0\n  USE = 4\n  \n  # Get the current state from the environment\n  current_state = env._current_state\n  \n  # Convert primitive name to its corresponding index in the cookbook\n  primitive_index = current_state.world.cookbook.index.get(primitive)\n  \n  if not primitive_index:\n    raise ValueError(f\"Unknown primitive: {primitive}\")\n  \n  actions = []\n  \n  # Define a function to move in a direction until a specific condition is met\n  def move_until(condition):\n    nonlocal actions, current_state\n    while True:\n      # Check the next position in the specified direction\n      if condition():\n        break\n      # Append the action to the list and update the state\n      actions.append(direction)\n      current_state = current_state.step(direction)[1]\n  \n  def move_to_position(x, y):\n    nonlocal actions, current_state\n    while current_state.pos[0] != x:\n      if current_state.pos[0] < x:\n        direction = RIGHT\n      else:\n        direction = LEFT\n      actions.append(direction)\n      current_state = current_state.step(direction)[1]\n    \n    while current_state.pos[1] != y:\n      if current_state.pos[1] < y:\n        direction = UP\n      else:\n        direction = DOWN\n      actions.append(direction)\n      current_state = current_state.step(direction)[1]\n\n  def find_and_collect_primitive():\n    nonlocal actions, current_state\n    # Scan the grid in a spiral pattern to find the primitive\n    width, height, _ = current_state.grid.shape\n    center_x, center_y = current_state.pos\n    steps = 0\n    direction_cycle = [UP, RIGHT, DOWN, LEFT]\n    while True:\n      for direction in direction_cycle:\n        if steps == 0:\n          # First step is always in the initial direction\n          dx, dy = [(0, -1), (1, 0), (0, 1), (-1, 0)][direction]\n        else:\n          # For subsequent steps, determine dx and dy based on the direction\n          dx, dy = [(0, -1), (1, 0), (0, 1), (-1, 0)][(steps // abs(steps)) if steps != 0 else 0]\n        \n        for _ in range(abs(steps)):\n          new_x, new_y = center_x + dx * _, center_y + dy * _\n          if 0 <= new_x < width and 0 <= new_y < height:\n            # Check if the primitive is at this position\n            if current_state.grid[new_x, new_y, primitive_index] > 0:\n              move_to_position(new_x, new_y)\n              actions.append(USE)\n              current_state = current_state.step(USE)[1]\n              return\n        steps += 1\n\n  # Start the process of finding and collecting the primitive\n  find_and_collect_primitive()\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
