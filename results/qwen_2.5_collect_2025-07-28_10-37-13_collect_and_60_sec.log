{"timestamp": "2025-07-28T11:45:05.974772", "function_name": "collect", "function_body": "  def is_reachable(pos, target_index):\n    queue = [pos]\n    visited = set([pos])\n\n    while queue:\n      current_pos = queue.pop(0)\n      \n      if grid[current_pos[1], current_pos[0], target_index] > 0:\n        return True\n\n      for direction in directions:\n        new_x = current_pos[0] + direction[0]\n        new_y = current_pos[1] + direction[1]\n\n        if (new_x, new_y) not in visited and 0 <= new_x < width and 0 <= new_y < height:\n          queue.append((new_x, new_y))\n          visited.add((new_x, new_y))\n\n    return False\n\n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  # Check if the primitive is in the inventory already\n  if env._current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect, already have it\n  \n  actions = []\n  grid = env._current_state.grid\n  width, height, _ = grid.shape\n\n  directions = [(1, 0), (0, 1), (-1, 0), (0, -1)]  # DOWN, RIGHT, UP, LEFT\n  start_pos = tuple(env._current_state.pos)\n\n  if not is_reachable(start_pos, primitive_index):\n    return []  # Could not find a path to the primitive\n\n  def get_shortest_path(pos, target_index):\n    queue = [(pos, [])]\n    visited = set([pos])\n\n    while queue:\n      current_pos, path = queue.pop(0)\n      \n      if grid[current_pos[1], current_pos[0], target_index] > 0:\n        return path\n\n      for direction in directions:\n        new_x = current_pos[0] + direction[0]\n        new_y = current_pos[1] + direction[1]\n\n        if (new_x, new_y) not in visited and 0 <= new_x < width and 0 <= new_y < height:\n          queue.append(((new_x, new_y), path + [direction]))\n          visited.add((new_x, new_y))\n\n    return None\n\n  path = get_shortest_path(start_pos, primitive_index)\n  if path is None:\n    return []  # Could not find the shortest path to the primitive\n\n  for direction in path:\n    if direction == (1, 0):  # DOWN\n      actions.append(1)\n    elif direction == (0, 1):  # RIGHT\n      actions.append(3)\n    elif direction == (-1, 0):  # UP\n      actions.append(2)\n    elif direction == (0, -1):  # LEFT\n      actions.append(4)\n\n  actions.append(4)  # USE to collect the item\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
