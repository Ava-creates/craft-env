{"timestamp": "2025-07-28T17:11:45.950510", "function_name": "collect", "function_body": "  # Initialize a list to store actions\n  actions = []\n\n  # Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Check if the agent is already next to the required primitive\n  if env._current_state.next_to(primitive_index):\n    return actions  # No need to move, already next to the primitive\n\n  # Find all positions of the primitive in the grid\n  primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n  # If no positions are found, raise an error or handle it appropriately\n  if len(primitive_positions) == 0:\n    raise ValueError(f\"No {primitive} found in the grid.\")\n\n  # Sort positions by distance to the agent's current position\n  distances = np.linalg.norm(primitive_positions - env._current_state.pos, axis=1)\n  nearest_position = primitive_positions[np.argmin(distances)]\n\n  # Calculate relative position from the agent's current position\n  dx = nearest_position[0] - env._current_state.pos[0]\n  dy = nearest_position[1] - env._current_state.pos[1]\n\n  # Determine the sequence of actions needed to reach the nearest primitive\n  if dx > 0:\n    actions.extend([env_factory.RIGHT for _ in range(dx)])\n  elif dx < 0:\n    actions.extend([env_factory.LEFT for _ in range(-dx)])\n\n  if dy > 0:\n    actions.extend([env_factory.DOWN for _ in range(dy)])\n  elif dy < 0:\n    actions.extend([env_factory.UP for _ in range(-dy)])\n\n  # Add the action to collect the primitive\n  actions.append(env_factory.USE)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-28T17:12:42.016732", "function_name": "collect", "function_body": "  def move_to(x, y):\n    nonlocal actions\n    current_x, current_y = env._current_state.pos\n\n    while current_x != x or current_y != y:\n      if x < current_x:\n        direction = \"LEFT\"\n      elif x > current_x:\n        direction = \"RIGHT\"\n      elif y < current_y:\n        direction = \"UP\"\n      elif y > current_current_y:\n        direction = \"DOWN\"\n\n      actions.append(env.action_specs()[direction])\n\n      # Update the current position\n      if direction == \"LEFT\":\n        current_x -= 1\n      elif direction == \"RIGHT\":\n        current_x += 1\n      elif direction == \"UP\":\n        current_y -= 1\n      elif direction == \"DOWN\":\n        current_y += 1\n\n  def collect_at(x, y):\n    nonlocal actions\n    move_to(x, y)\n    actions.append(env.action_specs()[\"USE\"])\n\n  # Search for the primitive in the grid\n  primitive_index = env.world.cookbook.index.index(primitive)\n  actions = []\n  grid = env._current_state.grid\n\n  def search_and_collect():\n    nonlocal actions, grid\n    while True:\n      found = False\n      for i in range(grid.shape[0]):\n        for j in range(grid.shape[1]):\n          if grid[i, j, primitive_index] > 0:\n            collect_at(i, j)\n            found = True\n            # Assuming that the grid is updated after each collection\n            grid[i, j, primitive_index] -= 1\n            break\n        if found:\n          break\n      if not found:\n        return\n\n  search_and_collect()\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-28T17:12:43.374421", "function_name": "collect", "function_body": "  # Get the index for the given primitive\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Define a list to hold actions\n  actions = []\n\n  def move_to(x, y):\n    nonlocal actions\n    current_x, current_y = env._current_state.pos\n\n    while current_x != x or current_y != y:\n      direction = None\n\n      if x < current_x:\n        direction = \"LEFT\"\n      elif x > current_x:\n        direction = \"RIGHT\"\n      elif y < current_y:\n        direction = \"UP\"\n      elif y > current_y:\n        direction = \"DOWN\"\n\n      actions.append(env.action_specs()[direction])\n\n      # Update the current position\n      if direction == \"LEFT\":\n        current_x -= 1\n      elif direction == \"RIGHT\":\n        current_x += 1\n      elif direction == \"UP\":\n        current_y -= 1\n      elif direction == \"DOWN\":\n        current_y += 1\n\n    return actions\n\n  def collect_at(x, y):\n    nonlocal actions\n    move_to(x, y)\n    actions.append(env.action_specs()[\"USE\"])\n    return actions\n\n  # Search for the primitive in the grid and perform BFS to find the nearest one\n  from collections import deque\n\n  grid = env._current_state.grid\n  queue = deque([(env._current_state.pos[0], env._current_state.pos[1])])\n  visited = set()\n  directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n  found = False\n\n  while queue:\n    current_x, current_y = queue.popleft()\n\n    if (current_x, current_y) in visited:\n      continue\n    visited.add((current_x, current_y))\n\n    # Check if the primitive is at the current position\n    if grid[current_x, current_y, primitive_index] > 0:\n      collect_at(current_x, current_y)\n      found = True\n      break\n\n    # Explore neighbors\n    for dx, dy in directions:\n      nx, ny = current_x + dx, current_y + dy\n      if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n        queue.append((nx, ny))\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T17:13:04.283903", "function_name": "collect", "function_body": "  def find_primitive(primitive):\n      non_grabbable_indices = env.world.non_grabbable_indices\n      grabbable_indices = env.world.grabbable_indices\n      grid = env._current_state.grid\n\n      # Find all positions of the primitive in the grid that are grabbable\n      positions = np.argwhere((grid[:, :, primitive] == 1) & (grabbable_indices[primitive]))\n      return positions\n\n  def move_to_position(pos):\n      current_pos = env._current_state.pos\n      x_diff, y_diff = pos - current_pos\n      \n      actions = []\n      if x_diff < 0:\n          actions.extend([env.world.LEFT] * abs(x_diff))\n      elif x_diff > 0:\n          actions.extend([env.world.RIGHT] * abs(x_diff))\n      \n      if y_diff < 0:\n          actions.extend([env.world.DOWN] * abs(y_diff))\n      elif y_diff > 0:\n          actions.extend([env.world.UP] * abs(y_diff))\n\n      return actions\n\n  # Find all positions of the primitive\n  positions = find_primitive(primitive)\n  \n  actions = []\n  for pos in positions:\n      actions.extend(move_to_position(pos))\n      actions.append(env.world.USE)  # Collect the primitive\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
