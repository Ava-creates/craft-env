{"timestamp": "2025-07-28T22:06:59.741112", "function_name": "collect", "function_body": "  UP = 1\n  DOWN = 0\n  LEFT = 3\n  RIGHT = 2\n  USE = 4\n\n  # Get the index for the primitive from the cookbook\n  primitive_index = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  width, height, _ = grid.shape\n\n  # Search for all positions with the primitive in the grid\n  target_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(target_positions) == 0:\n    return []  # No positions found with primitive.\n\n  actions = []\n  \n  def find_path(start, end):\n      \"\"\"Breadth-first search to find a path from start to end.\"\"\"\n      queue = [(start, [])]\n      visited = set()\n      \n      while queue:\n          (x, y), path = queue.pop(0)\n          \n          if (x, y) == end:\n              return path\n          \n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          \n          # Explore neighbors (UP, DOWN, LEFT, RIGHT)\n          for dx, dy, action in [(-1, 0, UP), (1, 0, DOWN), (0, -1, LEFT), (0, 1, RIGHT)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < width and 0 <= ny < height:\n                  queue.append(((nx, ny), path + [action]))\n      return None\n\n  def collect_primitive_at(pos):\n      \"\"\"Collect primitive at the given position.\"\"\"\n      path = find_path(current_state.pos, pos)\n      \n      if path is not None:\n          actions.extend(path)\n          actions.append(USE)\n          current_state.grid[pos[0], pos[1], primitive_index] -= 1\n          current_state.pos = pos\n\n  # Sort target positions based on proximity to current position\n  sorted_positions = sorted(target_positions, key=lambda p: abs(p[0] - pos[0]) + abs(p[1] - pos[1]))\n\n  for target_pos in sorted_positions:\n      collect_primitive_at(tuple(target_pos))\n  \n  return actions", "island_id": 4, "scores": {"3": 0.0}}
