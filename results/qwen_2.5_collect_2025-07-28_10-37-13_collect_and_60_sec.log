{"timestamp": "2025-07-28T19:45:42.132641", "function_name": "collect", "function_body": "  def find_nearest_primitive(grid, pos, i_primitive):\n    \"\"\"\n    Finds the nearest cell containing the primitive kind.\n    Returns (x, y) coordinates or None if not found.\n    \"\"\"\n    # Simple brute-force search for demonstration purposes\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = [pos]\n    visited = set([pos])\n    \n    while queue:\n      x, y = queue.pop(0)\n      if grid[x, y, i_primitive] > 0:\n        return x, y\n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if (nx, ny) not in visited and 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny))\n          visited.add((nx, ny))\n    return None\n\n  def move_towards(current_state, target):\n      \"\"\"\n      Generates actions to move from current state position to target.\n      Returns a list of action indices.\n      \"\"\"\n      actions = []\n      x, y = current_state.pos\n      tx, ty = target\n      \n      while x != tx or y != ty:\n          if x < tx:\n              actions.append(3)  # RIGHT\n              x += 1\n          elif x > tx:\n              actions.append(2)  # LEFT\n              x -= 1\n          \n          if y < ty:\n              actions.append(0)  # DOWN\n              y += 1\n          elif y > ty:\n              actions.append(1)  # UP\n              y -= 1\n      \n      return actions\n\n  def find_path_dijkstra(grid, start_pos, i_primitive):\n    \"\"\"\n    Finds the shortest path to the nearest cell containing the primitive kind using Dijkstra's algorithm.\n    Returns a list of action indices or None if not found.\n    \"\"\"\n    import heapq\n    \n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = [(0, start_pos)]  # Priority queue with distance as the key\n    visited = set()\n    came_from = {start_pos: None}\n    cost_so_far = {start_pos: 0}\n    \n    while queue:\n      current_cost, (x, y) = heapq.heappop(queue)\n      \n      if grid[x, y, i_primitive] > 0:\n          # Reconstruct path\n          path = []\n          current = (x, y)\n          while current != start_pos:\n              path.append(current)\n              current = came_from[current]\n          path.reverse()\n          \n          actions = []\n          cx, cy = start_pos\n          for nx, ny in path:\n              if cx < nx:\n                  actions.append(3)  # RIGHT\n              elif cx > nx:\n                  actions.append(2)  # LEFT\n              elif cy < ny:\n                  actions.append(0)  # DOWN\n              elif cy > ny:\n                  actions.append(1)  # UP\n              cx, cy = nx, ny\n          \n          return actions\n      \n      if (x, y) in visited:\n          continue\n      visited.add((x, y))\n      \n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          new_cost = current_cost + 1\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              if (nx, ny) not in cost_so_far or new_cost < cost_so_far[(nx, ny)]:\n                  cost_so_far[(nx, ny)] = new_cost\n                  heapq.heappush(queue, (new_cost, (nx, ny)))\n                  came_from[(nx, ny)] = (x, y)\n    \n    return None\n\n  actions = []\n  \n  current_state = env._current_state\n  grid = current_state.grid\n  index = current_state.world.cookbook.index\n  \n  i_primitive = index[primitive]\n\n  if current_state.inventory[i_primitive] > 0:\n      return []\n\n  # Find the shortest path to the nearest primitive kind using Dijkstra's algorithm\n  actions = find_path_dijkstra(grid, current_state.pos, i_primitive)\n  \n  if not actions:\n      print(f\"No {primitive} found in the grid.\")\n      return []\n  \n  # Once at the target position, use to collect the primitive kind\n  if current_state.next_to(i_primitive):\n      actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:45:44.147290", "function_name": "collect", "function_body": "  def find_nearest_primitive(grid, pos, i_primitive):\n    \"\"\"\n    Finds the nearest cell containing the primitive kind.\n    Returns (x, y) coordinates or None if not found.\n    \"\"\"\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = [pos]\n    visited = set([pos])\n    \n    while queue:\n      x, y = queue.pop(0)\n      if grid[x, y, i_primitive] > 0:\n        return x, y\n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if (nx, ny) not in visited and 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny))\n          visited.add((nx, ny))\n    return None\n\n  def move_towards(current_state, target):\n      \"\"\"\n      Generates actions to move from current state position to target.\n      Returns a list of action indices.\n      \"\"\"\n      actions = []\n      x, y = current_state.pos\n      tx, ty = target\n      \n      while x != tx or y != ty:\n          if x < tx:\n              actions.append(3)  # RIGHT\n              x += 1\n          elif x > tx:\n              actions.append(2)  # LEFT\n              x -= 1\n          \n          if y < ty:\n              actions.append(0)  # DOWN\n              y += 1\n          elif y > ty:\n              actions.append(1)  # UP\n              y -= 1\n      \n      return actions\n\n  def explore_grid(grid, start_pos):\n    \"\"\"\n    Explores the grid to find reachable areas and resources.\n    Returns a dictionary of resource positions.\n    \"\"\"\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]\n    queue = [start_pos]\n    visited = set([start_pos])\n    resource_positions = {}\n    \n    while queue:\n      x, y = queue.pop(0)\n      \n      for dx, dy in directions:\n        nx, ny = x + dx, y + dy\n        if (nx, ny) not in visited and 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n          queue.append((nx, ny))\n          visited.add((nx, ny))\n          \n          # Check for primitives in the neighboring cells\n          for i_primitive in env.world.cookbook.primitives:\n            if grid[nx, ny, i_primitive] > 0:\n              if i_primitive not in resource_positions:\n                resource_positions[i_primitive] = []\n              resource_positions[i_primitive].append((nx, ny))\n    \n    return resource_positions\n\n  actions = []\n  \n  current_state = env._current_state\n  grid = current_state.grid\n  index = current_state.world.cookbook.index\n  \n  i_primitive = index[primitive]\n\n  if current_state.inventory[i_primitive] > 0:\n    return []\n\n  # Explore the grid to find all reachable primitives\n  resource_positions = explore_grid(grid, current_state.pos)\n  \n  if i_primitive not in resource_positions or len(resource_positions[i_primitive]) == 0:\n      print(f\"No {primitive} found in the grid.\")\n      return []\n  \n  # Find the nearest primitive kind from the list of found positions\n  nearest_pos = min(resource_positions[i_primitive], key=lambda p: abs(p[0] - current_state.pos[0]) + abs(p[1] - current_state.pos[1]))\n  \n  actions += move_towards(current_state, nearest_pos)\n\n  # Once at the target position, use to collect the primitive kind\n  if current_state.next_to(i_primitive):\n      actions.append(4)  # USE\n\n  return actions", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:47:22.353986", "function_name": "collect", "function_body": "  def move_to_position(current_pos, target_pos, action_map):\n      dx = target_pos[0] - current_pos[0]\n      dy = target_pos[1] - current_pos[1]\n\n      actions = []\n      if dx > 0:\n          actions.extend([action_map['DOWN']] * abs(dx))\n      elif dx < 0:\n          actions.extend([action_map['UP']] * abs(dx))\n\n      if dy > 0:\n          actions.extend([action_map['RIGHT']] * abs(dy))\n      elif dy < 0:\n          actions.extend([action_map['LEFT']] * abs(dy))\n\n      return actions\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Step 1: Extract the current state and inventory from the environment\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Step 2: Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Step 3: Check if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Step 4: Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Step 5: Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Step 6: Generate actions to move to and collect all primitives within a certain radius\n  actions = []\n  for pos in sorted_positions:\n      actions.extend(move_to_position(current_state.pos, (pos[0], pos[1]), action_map))\n      actions.append(action_map['USE'])\n\n      # Update current position for the next iteration\n      current_state.pos = (pos[0], pos[1])\n\n      # Check if we have collected enough primitives\n      if inventory[primitive_index] > 0:\n          break\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:47:24.412929", "function_name": "collect", "function_body": "  def move_to_position(current_pos, target_pos, action_map):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    if dy < 0:\n        actions.extend([action_map['LEFT']] * abs(dy))\n    elif dy > 0:\n        actions.extend([action_map['RIGHT']] * abs(dy))\n\n    if dx < 0:\n        actions.extend([action_map['UP']] * abs(dx))\n    elif dx > 0:\n        actions.extend([action_map['DOWN']] * abs(dx))\n\n    return actions\n\n  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Step 1: Extract the current state and inventory from the environment\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Step 2: Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Step 3: Check if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Step 4: Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Step 5: Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Step 6: Generate actions to move to and collect all primitives within a certain radius\n  actions = []\n  for pos in sorted_positions:\n      actions.extend(move_to_position(current_state.pos, (pos[0], pos[1]), action_map))\n      actions.append(action_map['USE'])\n\n      # Update current position for the next iteration\n      current_state.pos = (pos[0], pos[1])\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:49:01.003029", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Step 1: Extract the current state and inventory from the environment\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Step 2: Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Step 3: Check if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Step 4: Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Step 5: Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Step 6: Generate actions to move to and collect all primitives within a certain radius\n  actions = []\n  for pos in sorted_positions:\n      dx = pos[0] - current_state.pos[0]\n      dy = pos[1] - current_state.pos[1]\n\n      if dx > 0:\n          actions.extend([action_map['DOWN']] * abs(dx))\n      elif dx < 0:\n          actions.extend([action_map['UP']] * abs(dx))\n\n      if dy > 0:\n          actions.extend([action_map['RIGHT']] * abs(dy))\n      elif dy < 0:\n          actions.extend([action_map['LEFT']] * abs(dy))\n\n      # Step 7: Add action to use the primitive\n      actions.append(action_map['USE'])\n\n      # Update current position for the next iteration\n      current_state.pos = (pos[0], pos[1])\n\n      # Simulate inventory update and check if we have enough primitives\n      simulated_inventory = np.copy(current_state.inventory)\n      simulated_inventory[primitive_index] += 1\n\n      # Check if we have collected at least one primitive\n      if simulated_inventory[primitive_index] > 0:\n          break\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:49:03.146503", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Step 1: Extract the current state and inventory from the environment\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Step 2: Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Step 3: Check if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Step 4: Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Step 5: Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Step 6: Generate actions to move to and collect all primitives within a certain radius\n  actions = []\n  for pos in sorted_positions:\n      dx = pos[0] - current_state.pos[0]\n      dy = pos[1] - current_state.pos[1]\n\n      # Determine the direction to move first based on Manhattan distance\n      if abs(dx) > abs(dy):\n          if dx > 0:\n              actions.extend([action_map['DOWN']] * abs(dx))\n          else:\n              actions.extend([action_map['UP']] * abs(dx))\n          if dy > 0:\n              actions.extend([action_map['RIGHT']] * abs(dy))\n          else:\n              actions.extend([action_map['LEFT']] * abs(dy))\n      else:\n          if dy > 0:\n              actions.extend([action_map['RIGHT']] * abs(dy))\n          else:\n              actions.extend([action_map['LEFT']] * abs(dy))\n          if dx > 0:\n              actions.extend([action_map['DOWN']] * abs(dx))\n          else:\n              actions.extend([action_map['UP']] * abs(dx))\n\n      # Step 7: Add action to use the primitive\n      actions.append(action_map['USE'])\n\n      # Update current position for the next iteration\n      current_state.pos = (pos[0], pos[1])\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:50:07.644246", "function_name": "collect", "function_body": "  index = env.world.cookbook.index.index(primitive)\n  if index is None:\n    raise ValueError(f\"Unknown primitive: {primitive}\")\n\n  UP, DOWN, LEFT, RIGHT, USE = 0, 1, 2, 3, 4\n  actions = []\n\n  # Check if the agent already has the required primitive in its inventory\n  if env._current_state.inventory[index] > 0:\n      return actions\n\n  # Define the BFS algorithm to find the nearest primitive\n  def bfs(grid, pos, primitive_index):\n    queue = [(pos, [])]\n    visited = set([pos])\n    \n    while queue:\n        current_pos, path = queue.pop(0)\n        x, y = current_pos\n        \n        if grid[x, y, primitive_index] > 0:\n            return path\n        \n        # Explore neighbors in the order: UP, DOWN, LEFT, RIGHT\n        for dx, dy, action in [(-1, 0, UP), (1, 0, DOWN), (0, -1, LEFT), (0, 1, RIGHT)]:\n            new_x, new_y = x + dx, y + dy\n            \n            if 0 <= new_x < grid.shape[0] and 0 <= new_y < grid.shape[1]:\n                if (new_x, new_y) not in visited:\n                    visited.add((new_x, new_y))\n                    queue.append(((new_x, new_y), path + [action]))\n    \n    return None\n\n  # Find the nearest primitive using BFS\n  path_to_primitive = bfs(env._current_state.grid, env._current_state.pos, index)\n  \n  if not path_to_primitive:\n      return []\n\n  # Follow the path to the primitive and collect it\n  for action in path_to_primitive:\n      actions.append(action)\n  actions.append(USE)  # Action to collect the primitive\n\n  return actions", "island_id": 8, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:50:09.604074", "function_name": "collect", "function_body": "  index = env.world.cookbook.index.index(primitive)\n  if index is None:\n    raise ValueError(f\"Unknown primitive: {primitive}\")\n\n  actions = []\n  \n  # Define movement directions\n  UP, DOWN, LEFT, RIGHT = 1, 0, 3, 2\n  \n  while True:\n      # Check if the agent has already collected enough primitives in its inventory\n      if env._current_state.inventory[index] > 0:\n          break\n      \n      # Find the nearest instance of the primitive using BFS\n      path_to_primitive = _find_nearest_primitive(env._current_state.grid, env._current_state.pos, index)\n      \n      if not path_to_primitive:\n          # If no primitive is found, move randomly to explore the grid\n          random_direction = np.random.choice([UP, DOWN, LEFT, RIGHT])\n          actions.append(random_direction)\n          return actions\n      \n      # Convert directions from BFS (UP: -1, DOWN: 1, LEFT: -1, RIGHT: 1) to action codes\n      actions_to_take = _follow_path(path_to_primitive, UP, DOWN, LEFT, RIGHT)\n\n      for action in actions_to_take:\n          actions.append(action)\n      \n      return actions", "island_id": 8, "scores": {"3": -1}}
{"timestamp": "2025-07-28T19:52:08.765910", "function_name": "collect", "function_body": "  def a_star_find_primitive(grid, pos, target):\n      from queue import PriorityQueue\n      import heapq\n      \n      open_set = PriorityQueue()\n      open_set.put((0, pos))\n      \n      came_from = {}\n      g_score = {pos: 0}\n      f_score = {pos: heuristic(pos, grid.shape[:2] // 2)}\n      \n      while not open_set.empty():\n          _, current = open_set.get()\n          \n          if grid[current[0], current[1], target] > 0:\n              path = []\n              while current in came_from:\n                  path.append(current)\n                  current = came_from[current]\n              return path[::-1]\n          \n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              neighbor = (current[0] + dx, current[1] + dy)\n              if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n                  tentative_g_score = g_score[current] + 1\n                  \n                  if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                      came_from[neighbor] = current\n                      g_score[neighbor] = tentative_g_score\n                      f_score[neighbor] = tentative_g_score + heuristic(neighbor, grid.shape[:2] // 2)\n                      open_set.put((f_score[neighbor], neighbor))\n      \n      return None\n  \n  def heuristic(pos1, pos2):\n      x1, y1 = pos1\n      x2, y2 = pos2\n      return abs(x1 - x2) + abs(y1 - y2)\n\n  primitive_index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n  \n  path = a_star_find_primitive(grid, pos, primitive_index)\n  \n  if path is not None:\n      actions = []\n      \n      for (nx, ny) in path:\n          dx, dy = nx - pos[0], ny - pos[1]\n          \n          direction = None\n          if dx == 0 and dy > 0:\n              direction = 0  # DOWN\n          elif dx == 0 and dy < 0:\n              direction = 1  # UP\n          elif dx < 0 and dy == 0:\n              direction = 2  # LEFT\n          elif dx > 0 and dy == 0:\n              direction = 3  # RIGHT\n\n          actions.append(direction)\n          pos = (nx, ny)  # Update the position after each step\n      \n      actions.append(4)  # USE action to collect the primitive\n      return actions\n  \n  else:\n      return []  # Return an empty list if no path is found", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-28T19:52:10.820732", "function_name": "collect", "function_body": "  def bfs_find_primitive(grid, pos, target):\n    from collections import deque\n    queue = deque([pos])\n    visited = set([pos])\n    parent = {}\n\n    while queue:\n      x, y = queue.popleft()\n      if grid[x, y, target] > 0:\n        path = []\n        while (x, y) != pos:\n          path.append((x, y))\n          x, y = parent[(x, y)]\n        return path[::-1]\n      \n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        nx, ny = x + dx, y + dy\n        if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and (nx, ny) not in visited:\n          queue.append((nx, ny))\n          visited.add((nx, ny))\n          parent[(nx, ny)] = (x, y)\n\n    return None\n\n  primitive_index = env.world.cookbook.index[primitive]\n  grid = env._current_state.grid\n  pos = env._current_state.pos\n\n  # First try to find the primitive using BFS\n  path = bfs_find_primitive(grid, pos, primitive_index)\n\n  if path is not None:\n    actions = []\n    for (nx, ny) in path:\n      dx, dy = nx - pos[0], ny - pos[1]\n      \n      direction = None\n      if dx == 0 and dy > 0:\n        direction = 0  # DOWN\n      elif dx == 0 and dy < 0:\n        direction = 1  # UP\n      elif dx < 0 and dy == 0:\n        direction = 2  # LEFT\n      elif dx > 0 and dy == 0:\n        direction = 3  # RIGHT\n\n      actions.append(direction)\n      pos = (nx, ny)  # Update the position after each step\n    \n    actions.append(4)  # USE action to collect the primitive\n    return actions\n  \n  else:\n    # If no path found, use a more efficient search strategy with A* algorithm\n    def heuristic(x1, y1, x2, y2):\n      return abs(x1 - x2) + abs(y1 - y2)\n\n    open_set = [(0, pos)]\n    came_from = {}\n    g_score = {pos: 0}\n    f_score = {pos: heuristic(*pos, *grid.shape[:2] // 2)}\n\n    while open_set:\n      _, current = min(open_set, key=lambda x: x[0])\n      open_set.remove((f_score[current], current))\n\n      if grid[current[0], current[1], primitive_index] > 0:\n        path = []\n        while current in came_from:\n          path.append(current)\n          current = came_from[current]\n        return path[::-1]\n\n      for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n        neighbor = (current[0] + dx, current[1] + dy)\n        if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:\n          tentative_g_score = g_score[current] + 1\n          if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n            came_from[neighbor] = current\n            g_score[neighbor] = tentative_g_score\n            f_score[neighbor] = tentative_g_score + heuristic(*neighbor, *grid.shape[:2] // 2)\n            open_set.append((f_score[neighbor], neighbor))\n\n    return None", "island_id": 5, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:52:37.793881", "function_name": "collect", "function_body": "  # Get the index for the primitive from the environment's cookbook.\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Find all positions of the primitive in the grid.\n  positions_of_primitive = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n  \n  actions_to_take = []\n\n  # Loop over each position of the primitive and collect it.\n  for pos in positions_of_primitive:\n    x, y = pos\n    current_x, current_y = env._current_state.pos\n\n    # Calculate differences to reach the target position.\n    dx = x - current_x\n    dy = y - current_y\n\n    # Move horizontally first.\n    if dx > 0:\n      actions_to_take.extend([env_factory.RIGHT] * abs(dx))\n    elif dx < 0:\n      actions_to_take.extend([env_factory.LEFT] * abs(dx))\n\n    # Then move vertically.\n    if dy > 0:\n      actions_to_take.extend([env_factory.DOWN] * abs(dy))\n    elif dy < 0:\n      actions_to_take.extend([env_factory.UP] * abs(dy))\n\n    # Use action to collect the primitive.\n    actions_to_take.append(env_factory.USE)\n\n  return actions_to_take", "island_id": 3, "scores": {"3": -1}}
