{"timestamp": "2025-07-28T12:28:58.861762", "function_name": "collect", "function_body": "  # Define action mappings\n  ACTION_UP = 1\n  ACTION_DOWN = 0\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  # Retrieve the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Initialize an empty list to store actions\n  actions = []\n\n  # Check if the primitive is already next to the agent\n  while not env._current_state.next_to(primitive_index):\n      # Move randomly until the primitive is found\n      action = np.random.choice([ACTION_UP, ACTION_DOWN, ACTION_LEFT, ACTION_RIGHT])\n      actions.append(action)\n  \n  # Once the primitive is next to the agent, collect it using the USE action\n  actions.append(ACTION_USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:29:00.762516", "function_name": "collect", "function_body": "  # Get the index of the primitive to collect\n  primitive_index = env.world.cookbook.index.get(primitive)\n\n  if primitive_index is None:\n      raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n\n  # Find positions of the primitive on the grid\n  primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n\n  actions = []\n\n  for pos in primitive_positions:\n      x, y = pos\n\n      while env._current_state.pos != (x, y):\n          # Calculate the direction to move towards the primitive\n          current_x, current_y = env._current_state.pos\n\n          if current_x < x:\n              actions.append(env_factory.DOWN)\n          elif current_x > x:\n              actions.append(env_factory.UP)\n\n          if current_y < y:\n              actions.append(env_factory.RIGHT)\n          elif current_y > y:\n              actions.append(env_factory.LEFT)\n\n      # Once at the position, collect the primitive\n      actions.append(env_factory.USE)\n\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:30:03.932880", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Step 1: Extract the current state and inventory from the environment\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Step 2: Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Step 3: Check if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Step 4: Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Step 5: Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Step 6: Generate actions to move to and collect all primitives within a certain radius\n  actions = []\n  for pos in sorted_positions:\n      dx = pos[0] - current_state.pos[0]\n      dy = pos[1] - current_state.pos[1]\n\n      if dx > 0:\n          actions.extend([action_map['DOWN']] * abs(dx))\n      elif dx < 0:\n          actions.extend([action_map['UP']] * abs(dx))\n\n      if dy > 0:\n          actions.extend([action_map['RIGHT']] * abs(dy))\n      elif dy < 0:\n          actions.extend([action_map['LEFT']] * abs(dy))\n\n      # Step 7: Add action to use the primitive\n      actions.append(action_map['USE'])\n\n      # Update current position for the next iteration\n      current_state.pos = (pos[0], pos[1])\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T12:30:05.843061", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Extract the current state and inventory\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Determine if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Generate actions to move to and collect the closest primitive\n  actions = []\n  for pos in sorted_positions:\n      dx = pos[0] - current_state.pos[0]\n      dy = pos[1] - current_state.pos[1]\n\n      if dx > 0:\n          actions.extend([action_map['DOWN']] * abs(dx))\n      elif dx < 0:\n          actions.extend([action_map['UP']] * abs(dx))\n\n      if dy > 0:\n          actions.extend([action_map['RIGHT']] * abs(dy))\n      elif dy < 0:\n          actions.extend([action_map['LEFT']] * abs(dy))\n\n      # Add action to use the primitive\n      actions.append(action_map['USE'])\n\n      # Update current state after each move and USE action\n      for action in actions:\n          reward, done, observations = env.step(action)\n          if done:\n              break\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:31:00.305691", "function_name": "collect", "function_body": "  # Get the current state from the environment\n  current_state = env._current_state\n\n  # Determine the index of the primitive we need to collect\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Find all positions in the grid where the primitive exists\n  primitive_positions = np.argwhere(current_state.grid[..., primitive_index] == 1)\n\n  if not primitive_positions.size:\n    return []\n\n  # Sort by proximity to the current position and also consider direction of movement\n  def sort_key(pos):\n      dist = np.linalg.norm(pos - np.array(current_state.pos))\n      # Penalize moving in the opposite direction if already facing that way\n      penalized_dist = dist + (10 * int(np.all((pos - np.array(current_state.pos)) == (-np.cos(np.radians(90*current_state.dir)), -np.sin(np.radians(90*current_state.dir)))))) \n      return penalized_dist\n\n  sorted_primitive_positions = primitive_positions[np.argsort([sort_key(pos) for pos in primitive_positions])]\n\n  actions = []\n\n  # Loop through each target position to collect the primitives\n  for pos in sorted_primitive_positions:\n    while not np.array_equal(current_state.pos, pos):\n        direction_to_target = (pos - np.array(current_state.pos))\n        direction_to_target[direction_to_target == -1] += current_state.grid.shape[0]\n        \n        # Calculate the shortest path using Manhattan distance\n        if abs(direction_to_target[0]) > abs(direction_to_target[1]):\n            move_dir = 0 if direction_to_target[0] > 0 else 2  # DOWN or UP\n        else:\n            move_dir = 3 if direction_to_target[1] > 0 else 1  # RIGHT or LEFT\n\n        actions.append(env.action_specs()[['DOWN', 'UP', 'LEFT', 'RIGHT'][move_dir]])\n        \n        # Simulate the step to update current_state for the next iteration\n        _, done, _ = env.step(actions[-1])\n        if done:\n            break\n        \n    # Collect the primitive once at the correct position\n    actions.append(env.action_specs()['USE'])\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T12:31:02.270154", "function_name": "collect", "function_body": "  # Get the current state from the environment\n  current_state = env._current_state\n\n  # Determine the index of the primitive we need to collect\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Find all positions in the grid where the primitive exists\n  primitive_positions = np.argwhere(current_state.grid[..., primitive_index] == 1)\n\n  if primitive_positions.size == 0:\n    # If no primitives are found, return an empty list of actions\n    return []\n\n  # Sort the positions by distance from the current position to prioritize closer ones\n  distances = np.linalg.norm(primitive_positions - np.array(current_state.pos), axis=1)\n  sorted_primitive_positions = primitive_positions[np.argsort(distances)]\n\n  actions = []\n  \n  for pos in sorted_primitive_positions:\n      # Calculate the direction needed to move towards the target position\n      direction_to_target = (pos - np.array(current_state.pos))\n\n      if direction_to_target[0] > 0:  # Move down\n          while current_state.pos[0] < pos[0]:\n              actions.append(env.action_specs()['DOWN'])\n              current_state, _, _ = env._current_state.step(env.action_specs()['DOWN'])\n      elif direction_to_target[0] < 0:  # Move up\n          while current_state.pos[0] > pos[0]:\n              actions.append(env.action_specs()['UP'])\n              current_state, _, _ = env._current_state.step(env.action_specs()['UP'])\n\n      if direction_to_target[1] > 0:  # Move right\n          while current_state.pos[1] < pos[1]:\n              actions.append(env.action_specs()['RIGHT'])\n              current_state, _, _ = env._current_state.step(env.action_specs()['RIGHT'])\n      elif direction_to_target[1] < 0:  # Move left\n          while current_state.pos[1] > pos[1]:\n              actions.append(env.action_specs()['LEFT'])\n              current_state, _, _ = env._current_state.step(env.action_specs()['LEFT'])\n\n      # Append the USE action to collect the primitive\n      actions.append(env.action_specs()['USE'])\n      current_state, _, _ = env._current_state.step(env.action_specs()['USE'])\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
