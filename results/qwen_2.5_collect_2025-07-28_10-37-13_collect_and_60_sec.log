{"timestamp": "2025-07-28T20:55:19.418032", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Step 1: Extract the current state and inventory from the environment\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Step 2: Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Step 3: Check if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Step 4: Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Step 5: Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Step 6: Generate actions to move to and collect all primitives within a certain radius\n  actions = []\n  for pos in sorted_positions:\n      dx = pos[0] - current_state.pos[0]\n      dy = pos[1] - current_state.pos[1]\n\n      if dx > 0:\n          actions.extend([action_map['DOWN']] * abs(dx))\n      elif dx < 0:\n          actions.extend([action_map['UP']] * abs(dx))\n\n      if dy > 0:\n          actions.extend([action_map['RIGHT']] * abs(dy))\n      elif dy < 0:\n          actions.extend([action_map['LEFT']] * abs(dy))\n\n      # Step 7: Add action to use the primitive\n      actions.append(action_map['USE'])\n\n      # Update current position for the next iteration\n      current_state.pos = (pos[0], pos[1])\n\n      # Check if we have collected the required amount of primitives\n      if inventory[primitive_index] > 0:\n          break\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T20:56:10.744024", "function_name": "collect", "function_body": "  grid = env._current_state.grid\n  pos = env._current_state.pos\n  inventory = env._current_state.inventory\n\n  # Define movement actions and their corresponding changes in position\n  movement_actions = {\n      'UP': (0, -1),\n      'DOWN': (0, 1),\n      'LEFT': (-1, 0),\n      'RIGHT': (1, 0)\n  }\n\n  # Find the index of the primitive from its name\n  primitive_index = env.world.cookbook.index[primitive]\n\n  actions = []\n  \n  def move_to(x, y):\n    dx, dy = x - pos[0], y - pos[1]\n    if dx > 0:\n        actions.extend([env.world.N_ACTIONS['RIGHT']] * abs(dx))\n    elif dx < 0:\n        actions.extend([env.world.N_ACTIONS['LEFT']] * abs(dx))\n    if dy > 0:\n        actions.extend([env.world.N_ACTIONS['DOWN']] * abs(dy))\n    elif dy < 0:\n        actions.extend([env.world.N_ACTIONS['UP']] * abs(dy))\n\n  def find_primitive():\n      # Perform a simple search to find the nearest primitive\n      for y in range(grid.shape[1]):\n          for x in range(grid.shape[0]):\n              if grid[x, y, primitive_index] > 0:\n                  return (x, y)\n      return None\n\n  target_pos = find_primitive()\n  \n  if target_pos is not None:\n      move_to(target_pos[0], target_pos[1])\n      actions.append(env.world.N_ACTIONS['USE'])\n      \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T20:56:12.848378", "function_name": "collect", "function_body": "  current_state = env._current_state\n  inventory = current_state.inventory\n  world = current_state.world\n  grid = current_state.grid\n  pos = current_state.pos\n\n  actions_to_take = []\n\n  # Check if the primitive is already in inventory\n  primitive_index = world.cookbook.index[primitive]\n  if inventory[primitive_index] > 0:\n    return actions_to_take\n  \n  # Find all positions of the primitive in the grid\n  primitive_positions = np.argwhere(grid[:, :, primitive_index] == 1)\n  \n  # If no primitives are found, do nothing\n  if len(primitive_positions) == 0:\n    return actions_to_take\n  \n  # Sort positions by distance from current position\n  distances = np.linalg.norm(pos - primitive_positions, axis=1)\n  sorted_indices = np.argsort(distances)\n  closest_primitive_position = tuple(primitive_positions[sorted_indices[0]])\n\n  # Calculate the path to the closest primitive\n  path_to_primitive = a_star(grid, pos, closest_primitive_position)\n\n  # Add actions to move to the closest primitive\n  for direction in path_to_primitive:\n    if direction == (1, 0):\n      actions_to_take.append(env.action_specs()[\"RIGHT\"])\n    elif direction == (-1, 0):\n      actions_to_take.append(env.action_specs()[\"LEFT\"])\n    elif direction == (0, 1):\n      actions_to_take.append(env.action_specs()[\"UP\"])\n    elif direction == (0, -1):\n      actions_to_take.append(env.action_specs()[\"DOWN\"])\n\n  # Add action to collect the primitive\n  actions_to_take.append(env.action_specs()[\"USE\"])\n\n  return actions_to_take", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T20:57:06.318548", "function_name": "collect", "function_body": "    # Initialize action list to store the actions\n    actions = []\n\n    # Get the index of the primitive from the environment's cookbook\n    primitive_index = env.world.cookbook.index[primitive]\n\n    # Check if the agent is already next to a cell containing the primitive\n    if env._current_state.next_to(primitive_index):\n        return actions\n\n    # Use a simple BFS to find the nearest cell containing the primitive\n    queue = [env._current_state.pos]\n    visited = set()\n    parent_map = {env._current_state.pos: None}\n\n    while queue:\n        current_pos = queue.pop(0)\n        if current_pos in visited:\n            continue\n\n        visited.add(current_pos)\n\n        # Check all 4 possible directions (UP, DOWN, LEFT, RIGHT)\n        for direction in [(0, 1), (0, -1), (1, 0), (-1, 0)]:\n            new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n\n            # Check if the new position is within grid bounds\n            if 0 <= new_pos[0] < env._current_state.grid.shape[0] and 0 <= new_pos[1] < env._current_state.grid.shape[1]:\n                if new_pos not in visited:\n                    queue.append(new_pos)\n                    parent_map[new_pos] = current_pos\n\n                # Check if the cell at new_pos contains the primitive\n                if env._current_state.grid[new_pos[0], new_pos[1], primitive_index] > 0:\n                    # Trace back the path from new_pos to the starting position\n                    while new_pos is not None:\n                        if parent_map[new_pos] is not None:\n                            delta = (new_pos[0] - parent_map[new_pos][0], new_pos[1] - parent_map[new_pos][1])\n                            if delta == (0, 1):\n                                actions.append(3)  # RIGHT\n                            elif delta == (0, -1):\n                                actions.append(2)  # LEFT\n                            elif delta == (1, 0):\n                                actions.append(0)  # DOWN\n                            elif delta == (-1, 0):\n                                actions.append(1)  # UP\n                        new_pos = parent_map[new_pos]\n                    break\n\n    return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T20:57:08.732366", "function_name": "collect", "function_body": "  # Define the movement actions corresponding to directions\n  movements = {\n      'UP': env_world.N_ACTIONS.DOWN,\n      'DOWN': env_world.N_ACTIONS.UP,\n      'LEFT': env_world.N_ACTIONS.RIGHT,\n      'RIGHT': env_world.N_ACTIONS.LEFT\n  }\n\n  # Define a function to move in a specific direction\n  def move(direction):\n      return movements[direction]\n\n  # Get the current state of the environment\n  state = env._current_state\n\n  # Find the indices of the primitive resource on the grid\n  primitive_index = list(state.world.cookbook.index.get(i) for i, name in enumerate(state.world.cookbook.primitives) if name == primitive)[0]\n  primitive_positions = np.argwhere(state.grid[:, :, primitive_index] > 0)\n\n  # Initialize a list to store the actions\n  actions = []\n\n  # Iterate over each position of the primitive resource on the grid\n  for pos in primitive_positions:\n      # Calculate the relative position from the agent's current position\n      rel_pos = (pos - np.array(state.pos)).tolist()\n\n      # Move the agent to the position of the primitive resource\n      if rel_pos[0] < 0:\n          actions.append(move('UP'))\n      elif rel_pos[0] > 0:\n          actions.append(move('DOWN'))\n\n      if rel_pos[1] < 0:\n          actions.append(move('LEFT'))\n      elif rel_pos[1] > 0:\n          actions.append(move('RIGHT'))\n\n      # Use the USE action to collect the primitive resource\n      actions.append(env_world.N_ACTIONS.USE)\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
