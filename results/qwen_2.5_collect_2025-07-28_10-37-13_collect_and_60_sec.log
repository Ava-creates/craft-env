{"timestamp": "2025-07-28T11:46:54.780765", "function_name": "collect", "function_body": "  def get_action_to_move(state, direction):\n    if direction == (0, 1):\n        return env.action_specs()['RIGHT']\n    elif direction == (0, -1):\n        return env.action_specs()['LEFT']\n    elif direction == (1, 0):\n        return env.action_specs()['DOWN']\n    elif direction == (-1, 0):\n        return env.action_specs()['UP']\n\n  def get_directions_to_target(start_pos, target_pos):\n      # Calculate differences\n      delta_x = target_pos[0] - start_pos[0]\n      delta_y = target_pos[1] - start_pos[1]\n\n      # Determine directions based on deltas\n      directions = []\n      if delta_x > 0:\n          directions.append((1, 0))  # Down\n      elif delta_x < 0:\n          directions.append((-1, 0))  # Up\n      \n      if delta_y > 0:\n          directions.append((0, 1))  # Right\n      elif delta_y < 0:\n          directions.append((0, -1))  # Left\n\n      return directions\n\n  def bfs_to_target(start_pos, target_index):\n    grid = env._current_state.grid\n    queue = [(start_pos, [])]\n    visited = set()\n    visited.add(start_pos)\n    \n    while queue:\n        current_pos, path = queue.pop(0)\n        \n        # Check if the target is in any of the adjacent cells\n        for direction in [(0, 1), (1, 0), (-1, 0), (0, -1)]:\n            new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n            \n            if (0 <= new_pos[0] < grid.shape[0] and\n                0 <= new_pos[1] < grid.shape[1] and\n                grid[new_pos][target_index] > 0):\n                \n                # Construct path to the target position\n                actions = []\n                for d in get_directions_to_target(start_pos, new_pos):\n                    actions.append(get_action_to_move(env._current_state, d))\n                \n                actions.append(4)  # Use action (to pick up the primitive)\n                return actions\n            \n            if (0 <= new_pos[0] < grid.shape[0] and\n                0 <= new_pos[1] < grid.shape[1] and\n                new_pos not in visited):\n                queue.append((new_pos, path + [direction]))\n                visited.add(new_pos)\n\n    # If no path is found, return an empty list (or handle accordingly)\n    return []\n\n  def get_adjacent_cells(pos):\n      \"\"\"Returns a list of adjacent cells (up, down, left, right)\"\"\"\n      x, y = pos\n      adjacent_cells = [(x + dx, y + dy) for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]\n                        if 0 <= x + dx < env._current_state.grid.shape[0] and \n                           0 <= y + dy < env._current_state.grid.shape[1]]\n      return adjacent_cells\n\n  # Get the current state of the environment\n  state = env._current_state\n  \n  # Define actions list\n  actions = []\n  \n  # Check if the primitive is already next to the agent\n  if state.next_to(state.world.cookbook.index.index(primitive)):\n      actions.append(4)  # Use action (to pick up the primitive)\n      return actions\n\n  # Find the index of the primitive in the environment's cookbook.\n  primitive_index = state.world.cookbook.index.index(primitive)\n\n  # Perform BFS to find the nearest primitive\n  target_actions = bfs_to_target(state.pos, primitive_index)\n  \n  if not target_actions:\n      return []\n  \n  actions.extend(target_actions)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T11:46:56.705397", "function_name": "collect", "function_body": "  def get_action_to_move(current_direction, target_direction):\n      if current_direction == 0 and target_direction == (0, -1):  # Facing right, need to go left\n          return env.action_specs()['LEFT']\n      elif current_direction == 0 and target_direction == (0, 1):  # Facing right, need to go right\n          return None\n      elif current_direction == 2 and target_direction == (0, -1):  # Facing left, need to go left\n          return None\n      elif current_direction == 2 and target_direction == (0, 1):  # Facing left, need to go right\n          return env.action_specs()['RIGHT']\n      elif current_direction == 1 and target_direction == (-1, 0):  # Facing down, need to go up\n          return env.action_specs()['UP']\n      elif current_direction == 1 and target_direction == (1, 0):  # Facing down, need to go down\n          return None\n      elif current_direction == 3 and target_direction == (-1, 0):  # Facing up, need to go up\n          return None\n      elif current_direction == 3 and target_direction == (1, 0):  # Facing up, need to go down\n          return env.action_specs()['DOWN']\n\n  def get_all_actions_to_target(current_pos, target_pos):\n      actions = []\n      while current_pos != target_pos:\n          if current_pos[0] < target_pos[0]:\n              actions.append(env.action_specs()['DOWN'])\n              current_pos = (current_pos[0] + 1, current_pos[1])\n          elif current_pos[0] > target_pos[0]:\n              actions.append(env.action_specs()['UP'])\n              current_pos = (current_pos[0] - 1, current_pos[1])\n          \n          if current_pos[1] < target_pos[1]:\n              actions.append(env.action_specs()['RIGHT'])\n              current_pos = (current_pos[0], current_pos[1] + 1)\n          elif current_pos[1] > target_pos[1]:\n              actions.append(env.action_specs()['LEFT'])\n              current_pos = (current_pos[0], current_pos[1] - 1)\n      return actions\n\n  def bfs_to_target(start_pos, target_index):\n    grid = env._current_state.grid\n    queue = [(start_pos, [])]\n    visited = set()\n    visited.add(start_pos)\n\n    while queue:\n        current_pos, path = queue.pop(0)\n        \n        # Check if the target is in any of the adjacent cells\n        for direction in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n            \n            if (0 <= new_pos[0] < grid.shape[0] and\n                0 <= new_pos[1] < grid.shape[1] and\n                grid[new_pos][target_index] > 0):\n                \n                # Construct path to the target position\n                actions = get_all_actions_to_target(start_pos, new_pos)\n                actions.append(env.action_specs()['USE'])  # Use action (to pick up the primitive)\n                return actions\n            \n            if (0 <= new_pos[0] < grid.shape[0] and\n                0 <= new_pos[1] < grid.shape[1] and\n                new_pos not in visited):\n                queue.append((new_pos, path + [direction]))\n                visited.add(new_pos)\n\n    # If no path is found, return an empty list (or handle accordingly)\n    return []\n\n  # Get the current state of the environment\n  state = env._current_state\n  \n  # Define actions list\n  actions = []\n  \n  # Check if the primitive is already next to the agent\n  if state.next_to(state.world.cookbook.index.index(primitive)):\n      actions.append(env.action_specs()['USE'])  # Use action (to pick up the primitive)\n      return actions\n\n  # Find the index of the primitive in the environment's cookbook.\n  primitive_index = state.world.cookbook.index.index(primitive)\n\n  # Perform BFS to find the nearest primitive\n  actions = bfs_to_target(state.pos, primitive_index)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T11:47:34.705496", "function_name": "collect", "function_body": "  # Initialize an empty list to store the actions\n  actions = []\n\n  # Get the current state from the environment\n  current_state = env._current_state\n\n  # Determine the index of the primitive we need to collect\n  primitive_index = current_state.world.cookbook.index[primitive]\n\n  # Find all positions in the grid where the primitive exists\n  primitive_positions = np.argwhere(current_state.grid[..., primitive_index] == 1)\n\n  if primitive_positions.size == 0:\n    # If no primitives are found, return an empty list of actions\n    return []\n\n  # Sort the positions by distance from the current position to prioritize closer ones\n  distances = np.linalg.norm(primitive_positions - np.array(current_state.pos), axis=1)\n  sorted_primitive_positions = primitive_positions[np.argsort(distances)]\n\n  for pos in sorted_primitive_positions:\n      # Calculate the direction needed to move towards the target position\n      direction_to_target = (pos - np.array(current_state.pos) + [3, 3]) % 6 - 3\n\n      if direction_to_target[0] == 1:  # Move down\n          actions.append(env.action_specs()['DOWN'])\n      elif direction_to_target[0] == -1:  # Move up\n          actions.append(env.action_specs()['UP'])\n      elif direction_to_target[1] == 1:  # Move right\n          actions.append(env.action_specs()['RIGHT'])\n      elif direction_to_target[1] == -1:  # Move left\n          actions.append(env.action_specs()['LEFT'])\n\n      # Append the USE action to collect the primitive\n      actions.append(env.action_specs()['USE'])\n\n  return actions", "island_id": 7, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T11:47:36.595566", "function_name": "collect", "function_body": "  # Create an index-to-name mapping for easy reference\n  index_to_name = {value: key for key, value in env.world.cookbook.index.contents.items()}\n  \n  # Determine the name of the primitive based on its index\n  primitive_name = index_to_name.get(primitive, None)\n  \n  if primitive_name is None:\n    raise ValueError(f\"Unknown primitive index: {primitive}\")\n  \n  actions = []\n  while not env._current_state.next_to(primitive):\n    available_actions = [0, 1, 2, 3]  # DOWN, UP, LEFT, RIGHT\n    action = np.random.choice(available_actions)\n    actions.append(action)\n    \n    # Check if the chosen action is moving towards the primitive\n    if env._current_state.next_to(primitive):\n      break\n\n  # Once adjacent to the primitive, collect it\n  USE_ACTION = 4  # Assuming USE is mapped to 4 in action_specs\n  actions.append(USE_ACTION)\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:48:33.570146", "function_name": "collect", "function_body": "  # Get the index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n\n  actions = []\n  \n  # Function to check if we are next to a given kind\n  def is_next_to(kind):\n    return env._current_state.next_to(env.world.cookbook.index[kind])\n  \n  # Move in a spiral pattern starting from the initial position\n  # This function generates spiral coordinates around the origin (0, 0)\n  def spiral():\n    x, y = 0, 0\n    dx, dy = 0, -1\n    while True:\n        if abs(x) == abs(y) and [dx, dy] != [-1, 0]:\n            dx, dy = -dy, dx\n        elif (x > 0 and y == 1-x):\n            dx, dy = -dy, dx\n        x, y = x+dx, y+dy\n        yield (x, y)\n  \n  # Start moving in a spiral pattern to find the primitive\n  for step in spiral():\n      if is_next_to(primitive):\n          actions.append(4)  # USE action to collect the primitive\n          break\n      \n      # Convert grid coordinates to world coordinates\n      world_x = env._current_state.pos[0] + step[0]\n      world_y = env._current_state.pos[1] + step[1]\n      \n      # Check if we are out of bounds\n      if (world_x < 0 or world_x >= env.world.scenario.init_grid.shape[0] or\n          world_y < 0 or world_y >= env.world.scenario.init_grid.shape[1]):\n          continue\n      \n      # Determine the direction to move towards the next grid cell in the spiral pattern\n      dx = np.sign(step[0])\n      dy = np.sign(step[1])\n      \n      if dx == 1:\n          actions.append(3)  # RIGHT\n      elif dx == -1:\n          actions.append(2)  # LEFT\n      elif dy == 1:\n          actions.append(1)  # UP\n      elif dy == -1:\n          actions.append(0)  # DOWN\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:48:35.442557", "function_name": "collect", "function_body": "  def find_primitive(primitive_index):\n    grid = env._current_state.grid\n    pos = env._current_state.pos\n    direction = env._current_state.dir\n    width, height, _ = grid.shape\n\n    # Simple search: move in all directions until the primitive is found.\n    for dx in range(-width + 1, width):\n      for dy in range(-height + 1, height):\n        new_pos = (pos[0] + dx, pos[1] + dy)\n        if not (0 <= new_pos[0] < width and 0 <= new_pos[1] < height):\n          continue\n        if grid[new_pos][primitive_index] > 0:\n          return new_pos\n\n    # If primitive is not found in the grid, we need to explore.\n    for dx in range(width):\n      for dy in range(height):\n        new_pos = (dx, dy)\n        if env._current_state.next_to(primitive_index):\n          return new_pos\n    return None\n\n  def navigate_to(pos):\n    current_pos = env._current_state.pos\n    path = []\n    # Simple greedy approach to move towards the target position.\n    while current_pos != pos:\n      dx, dy = pos[0] - current_pos[0], pos[1] - current_pos[1]\n      if dx > 0:\n          path.append(env_factory.MOVE_FUNC(\"RIGHT\"))\n      elif dx < 0:\n          path.append(env_factory.MOVE_FUNC(\"LEFT\"))\n      elif dy > 0:\n          path.append(env_factory.MOVE_FUNC(\"DOWN\"))\n      elif dy < 0:\n          path.append(env_factory.MOVE_FUNC(\"UP\"))\n      current_pos = pos\n    return path\n\n  primitive_index = env.world.cookbook.index.get(primitive)\n  if primitive_index is None:\n      raise ValueError(f\"Primitive {primitive} not found in the cookbook.\")\n\n  target_pos = find_primitive(primitive_index)\n\n  if target_pos is None:\n      # If we cannot find it, explore randomly.\n      width, height = env._current_state.grid.shape[:2]\n      actions = [env_factory.MOVE_FUNC(np.random.choice([\"UP\", \"DOWN\", \"LEFT\", \"RIGHT\"])) for _ in range(width * height)]\n      return actions\n\n  path_to_primitive = navigate_to(target_pos)\n\n  # Once we reach the target position, pick up the primitive.\n  pickup_action = env_factory.COLLECT_FUNC(primitive)\n  path_to_primitive.append(pickup_action)\n\n  return path_to_primitive", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T11:48:56.154055", "function_name": "collect", "function_body": "  actions = []\n  \n  # Get the index for the primitive from the cookbook\n  index_of_primitive = env.world.cookbook.index[primitive]\n\n  # Find positions of the primitive in the grid\n  positions = np.argwhere(env._current_state.grid[:, :, index_of_primitive] > 0)\n\n  if len(positions) == 0:\n    return actions\n\n  closest_position = None\n  min_distance = float('inf')\n\n  # Calculate distances from the current position to all found primitives and find the closest one\n  for pos in positions:\n      distance = abs(env._current_state.pos[0] - pos[0]) + abs(env._current_state.pos[1] - pos[1])\n      if distance < min_distance:\n          min_distance = distance\n          closest_position = pos\n\n  # Determine actions needed to move towards the closest position\n  delta_x = closest_position[0] - env._current_state.pos[0]\n  delta_y = closest_position[1] - env._current_state.pos[1]\n\n  if delta_x < 0:\n      actions.extend([env_factory.LEFT] * abs(delta_x))\n  elif delta_x > 0:\n      actions.extend([env_factory.RIGHT] * abs(delta_x))\n\n  if delta_y < 0:\n      actions.extend([env_factory.DOWN] * abs(delta_y))\n  elif delta_y > 0:\n      actions.extend([env_factory.UP] * abs(delta_y))\n\n  # Add action to collect the primitive\n  actions.append(env_factory.USE)\n\n  return actions", "island_id": 4, "scores": {"3": -1}}
