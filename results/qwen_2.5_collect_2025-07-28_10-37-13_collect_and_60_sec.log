{"timestamp": "2025-07-29T02:25:29.966944", "function_name": "collect", "function_body": "  # Get index for the specified primitive\n  index = env.world.cookbook.index[primitive]\n  \n  # Initialize the state from the scenario\n  current_state = env._current_state\n  \n  # Initialize a list to store actions\n  actions_to_take = []\n  \n  while not current_state.next_to(index):\n    # Find the position of the nearest primitive in the grid\n    pos_primitive = find_nearest(current_state, index)\n    \n    if pos_primitive is None:\n      break\n    \n    # Calculate the direction and distance to move towards the primitive\n    dx, dy = pos_primitive[0] - current_state.pos[0], pos_primitive[1] - current_state.pos[1]\n    \n    if dx > 0:\n      actions_to_take.extend([env.world.N_RIGHT for _ in range(abs(dx))])\n    elif dx < 0:\n      actions_to_take.extend([env.world.N_LEFT for _ in range(abs(dx))])\n      \n    if dy > 0:\n      actions_to_take.extend([env.world.N_DOWN for _ in range(abs(dy))])\n    elif dy < 0:\n      actions_to_take.extend([env.world.N_UP for _ in range(abs(dy))])\n    \n    # Move the agent to the position of the primitive\n    current_state = move_agent(current_state, actions_to_take)\n  \n  # Pick up the primitive if it's next to the agent\n  if current_state.next_to(index):\n    actions_to_take.append(env.world.N_USE)\n  \n  return actions_to_take", "island_id": 5, "scores": {"3": -1}}
{"timestamp": "2025-07-29T02:25:57.496230", "function_name": "collect", "function_body": "  def heuristic_distance(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  actions_to_take = []\n  \n  # Get the index for the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Search for all occurrences of the desired primitive in the grid\n  current_pos = env._current_state.pos\n  grid_shape = env._current_state.grid.shape[:2]  # (WIDTH, HEIGHT)\n\n  positions = []\n  for x in range(grid_shape[0]):\n      for y in range(grid_shape[1]):\n          if env._current_state.grid[x, y, primitive_index] > 0:\n              positions.append((x, y))\n\n  # Sort by heuristic distance to the current position\n  positions.sort(key=lambda pos: heuristic_distance(current_pos, pos))\n  \n  def move_to_and_collect(new_x, new_y):\n      dx = new_x - current_pos[0]\n      dy = new_y - current_pos[1]\n\n      while dx != 0 or dy != 0:\n          if dx < 0:\n              actions_to_take.append(1)  # LEFT\n              dx += 1\n          elif dx > 0:\n              actions_to_take.append(0)  # RIGHT\n              dx -= 1\n          \n          if dy < 0:\n              actions_to_take.append(3)  # UP\n              dy += 1\n          elif dy > 0:\n              actions_to_take.append(2)  # DOWN\n              dy -= 1\n\n      actions_to_take.append(4)  # USE to collect the primitive\n      \n  for new_x, new_y in positions:\n      move_to_and_collect(new_x, new_y)\n      \n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
