{"timestamp": "2025-07-28T19:53:06.750140", "function_name": "collect", "function_body": "  # Define action constants\n  LEFT = 0\n  RIGHT = 1\n  UP = 2\n  DOWN = 3\n  USE = 4\n\n  actions = []\n  current_state = env._current_state\n  \n  while True:\n    if current_state.next_to(env.world.index.get(primitive)):\n      actions.append(USE)\n      break\n    \n    # Determine the direction to move in\n    x, y = current_state.pos\n    grid = current_state.grid\n    width, height, _ = grid.shape\n    \n    # Check surrounding cells and determine movement\n    if x > 0 and grid[x-1, y, env.world.index.get(primitive)]:\n      actions.append(LEFT)\n    elif x < width - 1 and grid[x+1, y, env.world.index.get(primitive)]:\n      actions.append(RIGHT)\n    elif y > 0 and grid[x, y-1, env.world.index.get(primitive)]:\n      actions.append(DOWN)\n    elif y < height - 1 and grid[x, y+1, env.world.index.get(primitive)]:\n      actions.append(UP)\n    else:\n      # If no adjacent cells have the primitive, perform a random move\n      actions.append(np.random.choice([LEFT, RIGHT, UP, DOWN]))\n    \n    # Execute the action to get the new state\n    _, current_state = current_state.step(actions[-1])\n  \n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-28T19:55:24.138363", "function_name": "collect", "function_body": "  def get_primitive_index(primitive):\n    if primitive not in env.world.cookbook.index:\n      raise ValueError(f\"Invalid or unknown primitive: {primitive}\")\n    return env.world.cookbook.index[primitive]\n\n  primitive_index = get_primitive_index(primitive)\n\n  def move_towards(target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    path = astar(env._current_state.grid, current_pos, target_pos)\n    \n    for step in path:\n        if step[0] > current_pos[0]:\n            actions.append(3)  # RIGHT\n        elif step[0] < current_pos[0]:\n            actions.append(2)  # LEFT\n        \n        if step[1] > current_pos[1]:\n            actions.append(0)  # DOWN\n        elif step[1] < current_pos[1]:\n            actions.append(1)  # UP\n    \n    return actions\n\n  def astar(grid, start, end):\n      open_set = set([start])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, end)}\n\n      while open_set:\n          current = min(open_set, key=lambda k: f_score[k])\n\n          if current == end:\n              return reconstruct_path(came_from, current)\n\n          open_set.remove(current)\n          neighbors = get_neighbors(grid, current)\n\n          for neighbor in neighbors:\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, end)\n                  open_set.add(neighbor)\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def get_neighbors(grid, pos):\n      x, y = pos\n      neighbors = []\n      \n      # Define possible directions: RIGHT, LEFT, DOWN, UP\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      \n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          \n          # Check boundaries and if the cell is empty\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1] and grid[ny, nx].sum() == 0:\n              neighbors.append((nx, ny))\n      \n      return neighbors\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  actions = []\n\n  # Improve efficiency by finding the closest primitive first\n  def find_closest_primitive(grid, primitive_index):\n      current_pos = env._current_state.pos\n      min_distance = float('inf')\n      closest_pos = None\n      \n      for y in range(grid.shape[0]):\n          for x in range(grid.shape[1]):\n              if grid[y, x, primitive_index] > 0:\n                  distance = heuristic(current_pos, (x, y))\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_pos = (x, y)\n      \n      return closest_pos\n\n  # Find and collect all primitives in the order of proximity\n  while True:\n      target_pos = find_closest_primitive(env._current_state.grid, primitive_index)\n      if not target_pos:\n          break\n      \n      actions.extend(move_towards(target_pos))\n      actions.append(4)  # USE to collect the primitive\n      \n      # Update the grid to reflect that the primitive has been collected\n      env._current_state.grid[target_pos[1], target_pos[0], primitive_index] = 0\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:55:26.169149", "function_name": "collect", "function_body": "  def get_primitive_index(primitive):\n    if primitive not in env.world.cookbook.index:\n      raise ValueError(f\"Invalid or unknown primitive: {primitive}\")\n    return env.world.cookbook.index[primitive]\n\n  primitive_index = get_primitive_index(primitive)\n\n  def move_towards(target_pos):\n    current_pos = env._current_state.pos\n    actions = []\n    path = astar(env._current_state.grid, current_pos, target_pos)\n    \n    for step in path:\n        if step[0] > current_pos[0]:\n            actions.append(3)  # RIGHT\n        elif step[0] < current_pos[0]:\n            actions.append(2)  # LEFT\n        \n        if step[1] > current_pos[1]:\n            actions.append(0)  # DOWN\n        elif step[1] < current_pos[1]:\n            actions.append(1)  # UP\n    \n    return actions\n\n  def astar(grid, start, end):\n      open_set = set([start])\n      came_from = {}\n      g_score = {start: 0}\n      f_score = {start: heuristic(start, end)}\n\n      while open_set:\n          current = min(open_set, key=lambda k: f_score[k])\n\n          if current == end:\n              return reconstruct_path(came_from, current)\n\n          open_set.remove(current)\n          neighbors = get_neighbors(grid, current)\n\n          for neighbor in neighbors:\n              tentative_g_score = g_score[current] + 1\n\n              if neighbor not in g_score or tentative_g_score < g_score[neighbor]:\n                  came_from[neighbor] = current\n                  g_score[neighbor] = tentative_g_score\n                  f_score[neighbor] = tentative_g_score + heuristic(neighbor, end)\n                  open_set.add(neighbor)\n\n      return []\n\n  def heuristic(a, b):\n      return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def get_neighbors(grid, pos):\n      x, y = pos\n      neighbors = []\n      \n      # Define possible directions: RIGHT, LEFT, DOWN, UP\n      directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]\n      \n      for dx, dy in directions:\n          nx, ny = x + dx, y + dy\n          \n          # Check boundaries and if the cell is empty or contains a primitive\n          if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n              neighbors.append((nx, ny))\n      \n      return neighbors\n\n  def reconstruct_path(came_from, current):\n      total_path = [current]\n      while current in came_from:\n          current = came_from[current]\n          total_path.append(current)\n      return total_path[::-1]\n\n  actions = []\n\n  # Improve efficiency by finding the closest primitive first\n  def find_closest_primitive(grid, primitive_index):\n      current_pos = env._current_state.pos\n      min_distance = float('inf')\n      closest_pos = None\n      \n      for y in range(grid.shape[0]):\n          for x in range(grid.shape[1]):\n              if grid[y, x, primitive_index] > 0:\n                  distance = heuristic(current_pos, (x, y))\n                  if distance < min_distance:\n                      min_distance = distance\n                      closest_pos = (x, y)\n      \n      return closest_pos\n\n  # Find and collect all primitives in the order of proximity\n  while True:\n      target_pos = find_closest_primitive(env._current_state.grid, primitive_index)\n      if not target_pos:\n          break\n      \n      actions.extend(move_towards(target_pos))\n      actions.append(4)  # USE to collect the primitive\n      \n      # Update the grid to reflect that the primitive has been collected\n      env._current_state.grid[target_pos[1], target_pos[0], primitive_index] = 0\n\n  return actions", "island_id": 1, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T19:56:25.990826", "function_name": "collect", "function_body": "  UP = 1\n  DOWN = 0\n  LEFT = 3\n  RIGHT = 2\n  USE = 4\n\n  # Get the index for the primitive from the cookbook\n  primitive_index = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  width, height, _ = grid.shape\n\n  # Search for the primitive in the grid\n  target_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n\n  if len(target_positions) == 0:\n    raise ValueError(f\"No positions found with {primitive}.\")\n\n  actions = []\n\n  # Sort target_positions by distance to current position\n  distances = np.sqrt((target_positions[:, 0] - pos[0]) ** 2 + (target_positions[:, 1] - pos[1]) ** 2)\n  sorted_indices = np.argsort(distances)\n  ordered_target_positions = target_positions[sorted_indices]\n\n  for target_pos in ordered_target_positions:\n      target_x, target_y = target_pos\n\n      # Calculate the path to the target position\n      dx = target_x - pos[0]\n      dy = target_y - pos[1]\n\n      if dx > 0:\n          actions.extend([RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([LEFT] * abs(dx))\n\n      if dy > 0:\n          actions.extend([DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([UP] * abs(dy))\n\n      # Collect the primitive\n      actions.append(USE)\n\n      # Update current position to target position\n      pos = (target_x, target_y)\n  \n  return actions", "island_id": 4, "scores": {"3": -1}}
{"timestamp": "2025-07-28T19:56:27.959912", "function_name": "collect", "function_body": "  UP = 1\n  DOWN = 0\n  LEFT = 3\n  RIGHT = 2\n  USE = 4\n\n  # Get the index for the primitive from the cookbook\n  primitive_index = env.world.cookbook.index[primitive]\n\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  width, height, _ = grid.shape\n\n  # Search for the primitive in the grid\n  target_positions = np.argwhere(grid[:, :, primitive_index] > 0)\n  \n  if len(target_positions) == 0:\n    raise ValueError(f\"No positions found with {primitive}.\")\n\n  actions = []\n  closest_target = None\n  min_distance = float('inf')\n\n  # Find the closest target position\n  for target_pos in target_positions:\n      target_x, target_y = target_pos\n\n      # Calculate Manhattan distance to the target position\n      distance = abs(target_x - pos[0]) + abs(target_y - pos[1])\n\n      if distance < min_distance:\n          min_distance = distance\n          closest_target = (target_x, target_y)\n\n  # If a closest target is found, move towards it\n  if closest_target:\n      target_x, target_y = closest_target\n\n      dx = target_x - pos[0]\n      dy = target_y - pos[1]\n\n      if dx > 0:\n          actions.extend([RIGHT] * abs(dx))\n      elif dx < 0:\n          actions.extend([LEFT] * abs(dx))\n\n      if dy > 0:\n          actions.extend([DOWN] * abs(dy))\n      elif dy < 0:\n          actions.extend([UP] * abs(dy))\n\n      # Collect the primitive\n      actions.append(USE)\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
