{"timestamp": "2025-07-29T02:17:31.858928", "function_name": "collect", "function_body": "  def bfs(start, target_index):\n      \"\"\"Breadth-First Search to find the shortest path from start position to any cell containing target_index.\"\"\"\n      queue = [(start, [])]\n      visited = set()\n      while queue:\n          (x, y), path = queue.pop(0)\n          if grid[x, y, target_index] > 0 and (x, y) != pos:\n              return path\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  def compute_rotation_direction(current_dir, target_dir):\n      \"\"\"Compute the number of right rotations needed to face the target direction.\"\"\"\n      return (target_dir - current_dir) % 4\n\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  index_of_primitive = cookbook.index[primitive]\n  pos = current_state.pos\n  dir = current_state.dir\n  grid = current_state.grid\n  \n  actions_to_take = []\n\n  if current_state.next_to(index_of_primitive):\n      # If the primitive is next to the agent, collect it\n      actions_to_take.append(env.world.n_actions - 1)  # Assuming USE action corresponds to n_actions - 1\n\n  else:\n      path_to_primitive = bfs(pos, index_of_primitive)\n      if path_to_primitive is not None:\n          for dx, dy in path_to_primitive:\n              new_dir = {(-1, 0): 2, (1, 0): 3, (0, -1): 1, (0, 1): 0}[(dx, dy)]\n              # Compute the number of right rotations needed\n              num_rotations = compute_rotation_direction(dir, new_dir)\n              for _ in range(num_rotations):\n                  actions_to_take.append((dir + 1) % 4)  # Assuming RIGHT action corresponds to (current direction + 1) % 4\n                  dir = (dir + 1) % 4\n\n              pos = (pos[0] + dx, pos[1] + dy)\n              actions_to_take.append(dir)  # Move in the new direction\n\n          actions_to_take.append(env.world.n_actions - 1)  # Collect the primitive\n\n  return actions_to_take", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T02:17:33.106444", "function_name": "collect", "function_body": "  def bfs(start, target_index):\n      \"\"\"Breadth-First Search to find the shortest path from start position to any cell containing target_index.\"\"\"\n      queue = [(start, [])]\n      visited = set()\n      while queue:\n          (x, y), path = queue.pop(0)\n          if grid[x, y, target_index] > 0 and (x, y) != pos:\n              return path\n          if (x, y) in visited:\n              continue\n          visited.add((x, y))\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  queue.append(((nx, ny), path + [(dx, dy)]))\n      return None\n\n  def convert_direction(dx, dy):\n      \"\"\"Convert direction vector to corresponding action.\"\"\"\n      dir_map = {(-1, 0): 2, (1, 0): 3, (0, -1): 1, (0, 1): 0}\n      return dir_map[(dx, dy)]\n\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  index_of_primitive = cookbook.index[primitive]\n  pos = current_state.pos\n  dir = current_state.dir\n  grid = current_state.grid\n  \n  actions_to_take = []\n\n  if current_state.next_to(index_of_primitive):\n      # If the primitive is next to the agent, collect it directly\n      actions_to_take.append(env.world.n_actions - 1)  # Assuming USE action corresponds to n_actions - 1\n\n  else:\n      path_to_primitive = bfs(pos, target_index)\n      if path_to_primitive is not None:\n          for dx, dy in path_to_primitive:\n              new_dir = convert_direction(dx, dy)\n              if dir != new_dir:\n                  actions_to_take.append(new_dir)  # Turn to the correct direction\n                  dir = new_dir\n              actions_to_take.append(env.world.n_actions - 2)  # Move forward\n              pos = (pos[0] + dx, pos[1] + dy)\n          actions_to_take.append(env.world.n_actions - 1)  # Collect the primitive\n\n  return actions_to_take", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-29T02:18:51.949137", "function_name": "collect", "function_body": "  def bfs(start, target_index):\n    queue = [(start, [])]\n    visited = set()\n    while queue:\n        (x, y), path = queue.pop(0)\n        if grid[x, y, target_index] > 0 and (x, y) != pos:\n            return path\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def calculate_turns(current_dir, target_dir):\n    dir_diff = (target_dir - current_dir) % 4\n    turns = []\n    if dir_diff == 1:\n        turns.append(0)  # Turn right\n    elif dir_diff == 2:\n        turns.extend([0, 0])  # Turn around\n    elif dir_diff == 3:\n        turns.append(1)  # Turn left\n    return turns\n\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  index_of_primitive = cookbook.index[primitive]\n  pos = current_state.pos\n  grid = current_state.grid\n  \n  actions_to_take = []\n  \n  if current_state.next_to(index_of_primitive):\n      # If the primitive is next to the agent, collect it immediately\n      actions_to_take.append(env.world.n_actions - 1)\n  else:\n      path_to_primitive = bfs(pos, index_of_primitive)\n      \n      if path_to_primitive is None:\n          raise ValueError(\"Primitive not found in the grid.\")\n      \n      for dx, dy in path_to_primitive:\n          target_dir = {(-1, 0): 2, (1, 0): 3, (0, -1): 1, (0, 1): 0}[(dx, dy)]\n          actions_to_take.extend(calculate_turns(current_state.dir, target_dir))\n          actions_to_take.append(env.world.n_actions - 2)  # Assuming MOVE action corresponds to n_actions - 2\n          \n      actions_to_take.append(env.world.n_actions - 1)  # Collect the primitive\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T02:18:53.209896", "function_name": "collect", "function_body": "  def bfs(start, target_index):\n    queue = [(start, [])]\n    visited = set()\n    while queue:\n        (x, y), path = queue.pop(0)\n        if grid[x, y, target_index] > 0 and (x, y) != pos:\n            return path\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  index_of_primitive = cookbook.index[primitive]\n  pos = current_state.pos\n  grid = current_state.grid\n  \n  actions_to_take = []\n  \n  # Check if the primitive is next to the agent\n  if current_state.next_to(index_of_primitive):\n    actions_to_take.append(env.world.n_actions - 1)  # Collect the primitive immediately\n\n  else:\n      path_to_primitive = bfs(pos, index_of_primitive)\n      \n      if path_to_primitive is None:\n          raise ValueError(\"Primitive not found in the grid.\")\n      \n      for dx, dy in path_to_primitive:\n          new_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n          direction = {(-1, 0): 2, (1, 0): 3, (0, -1): 1, (0, 1): 0}[(dx, dy)]\n          \n          # Calculate the difference in direction\n          dir_diff = (direction - current_state.dir) % 4\n          \n          if dir_diff == 1:\n              actions_to_take.append(0)  # Turn right\n          elif dir_diff == 2:\n              actions_to_take.extend([0, 0])  # Turn around\n          elif dir_diff == 3:\n              actions_to_take.append(1)  # Turn left\n\n          actions_to_take.append(env.world.n_actions - 2)  # Move action to move forward\n      \n      actions_to_take.append(env.world.n_actions - 1)  # Collect the primitive\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T02:19:29.078839", "function_name": "collect", "function_body": "  actions = []\n  \n  # Assuming the primitive is represented by an index in the environment\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  while True:\n    if current_state.next_to(primitive_index):\n      actions.append(4)  # USE action to collect the primitive\n      break\n    \n    # If not, move in a direction that is likely to bring us closer to the primitive\n    # For simplicity, let's assume we know where the primitive is (which it usually won't)\n    # In practice, we would need a more sophisticated strategy to find the closest primitive\n    action = np.random.choice([0, 1, 2, 3])  # DOWN, UP, LEFT, RIGHT\n    actions.append(action)\n    reward, done, observations = env.step(action)\n    current_state = env._current_state\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-29T02:19:30.336114", "function_name": "collect", "function_body": "  # Initialize the list to store the sequence of actions.\n  actions = []\n\n  # Get the index for the desired primitive from the cookbook's index\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Get the current state of the environment\n  current_state = env._current_state\n\n  while not current_state.next_to(primitive_index):\n      # Find a path to the nearest cell containing the desired primitive\n      path = find_path(env, current_state.pos, primitive_index)\n      \n      if not path:\n          # If no path is found, wait for one step and try again (this could happen in dynamic environments or due to randomness)\n          actions.append(0)  # DOWN action as a placeholder; any non-useful action would suffice\n          continue\n      \n      for position in path[:-1]:  # Exclude the last position because we will use there\n          move_actions = get_move_actions(current_state.pos, position)\n          actions.extend(move_actions)\n          current_state = env._current_state\n\n      # Once next to the primitive, collect it\n      actions.append(4)  # USE action to collect the primitive\n      current_state = env._current_state\n\n  return actions", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-29T02:20:44.421631", "function_name": "collect", "function_body": "  def bfs(start, target_index):\n    queue = [(start, [])]\n    visited = set()\n    while queue:\n        (x, y), path = queue.pop(0)\n        if grid[x, y, target_index] > 0 and (x, y) != pos:\n            return path\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  index_of_primitive = cookbook.index[primitive]\n  pos = current_state.pos\n  grid = current_state.grid\n\n  if current_state.next_to(index_of_primitive):\n      actions_to_take = [env.world.n_actions - 1]  # Collect the primitive immediately\n\n  else:\n      path_to_primitive = bfs(pos, index_of_primitive)\n      if path_to_primitive is not None:\n          actions_to_take = []\n          for dx, dy in path_to_primitive:\n              new_pos = (current_state.pos[0] + dx, current_state.pos[1] + dy)\n              direction = {(-1, 0): 2, (1, 0): 3, (0, -1): 1, (0, 1): 0}[(dx, dy)]\n\n              # Check if the next position is already facing the correct direction\n              if current_state.dir == direction:\n                  actions_to_take.append(env.world.n_actions - 2)  # Move action to move forward\n              else:\n                  actions_to_take.append(direction)\n\n          # Add the final USE action to collect the primitive\n          actions_to_take.append(env.world.n_actions - 1)\n      else:\n          raise ValueError(\"Primitive not found in the grid.\")\n\n  return actions_to_take", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T02:20:45.685270", "function_name": "collect", "function_body": "  def bfs(start, target_index):\n    queue = [(start, [])]\n    visited = set()\n    while queue:\n        (x, y), path = queue.pop(0)\n        if grid[x, y, target_index] > 0 and (x, y) != pos:\n            return path\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            nx, ny = x + dx, y + dy\n            if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                queue.append(((nx, ny), path + [(dx, dy)]))\n    return None\n\n  def calculate_turns(current_dir, target_dir):\n    dir_diff = (target_dir - current_dir) % 4\n    turns = []\n    if dir_diff == 1:\n        turns.append(0)  # Turn right\n    elif dir_diff == 2:\n        turns.extend([0, 0])  # Turn around\n    elif dir_diff == 3:\n        turns.append(1)  # Turn left\n    return turns\n\n  current_state = env._current_state\n  cookbook = env.world.cookbook\n  index_of_primitive = cookbook.index[primitive]\n  pos = current_state.pos\n  grid = current_state.grid\n  \n  actions_to_take = []\n  \n  if current_state.next_to(index_of_primitive):\n      # If the primitive is next to the agent, collect it immediately\n      actions_to_take.append(env.world.n_actions - 1)\n  else:\n      path_to_primitive = bfs(pos, index_of_primitive)\n      \n      if path_to_primitive is None:\n          raise ValueError(\"Primitive not found in the grid.\")\n      \n      for dx, dy in path_to_primitive:\n          target_dir = {(-1, 0): 2, (1, 0): 3, (0, -1): 1, (0, 1): 0}[(dx, dy)]\n          actions_to_take.extend(calculate_turns(current_state.dir, target_dir))\n          actions_to_take.append(env.world.n_actions - 2)  # Assuming MOVE action corresponds to n_actions - 2\n          \n      actions_to_take.append(env.world.n_actions - 1)  # Collect the primitive\n  \n  return actions_to_take", "island_id": 0, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T02:21:34.030410", "function_name": "collect", "function_body": "  # Define movement actions\n  UP = 1\n  DOWN = 0\n  LEFT = 2\n  RIGHT = 3\n\n  # Get the current state from the environment\n  current_state = env._current_state\n  \n  # Get the index of the primitive to collect\n  primitive_index = current_state.world.cookbook.index.primitive(primitive)\n  \n  # Check if the agent is already next to the primitive\n  if current_state.next_to(primitive_index):\n    return [4]  # Use action to collect the primitive\n  \n  # Define a simple search algorithm (e.g., flood fill) to find the nearest primitive\n  def find_nearest_primitive(grid, pos, primitive_index):\n      queue = [(pos[0], pos[1])]\n      visited = set(queue)\n      \n      while queue:\n          x, y = queue.pop(0)\n          \n          # Check all four directions for the primitive\n          for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n              nx, ny = x + dx, y + dy\n              \n              if 0 <= nx < grid.shape[0] and 0 <= ny < grid.shape[1]:\n                  if (nx, ny) not in visited:\n                      visited.add((nx, ny))\n                      queue.append((nx, ny))\n                      \n                      # Check if the primitive is found\n                      if grid[nx, ny, primitive_index] > 0:\n                          return (nx, ny)\n      \n      return None\n  \n  # Find the nearest primitive position\n  nearest_primitive_pos = find_nearest_primitive(current_state.grid, current_state.pos, primitive_index)\n  \n  if not nearest_primitive_pos:\n      print(\"Primitive not found in the grid.\")\n      return []\n  \n  # Calculate the path to the nearest primitive using a simple greedy algorithm\n  def calculate_path(start_pos, end_pos):\n      path = []\n      x, y = start_pos\n      \n      while (x, y) != end_pos:\n          dx, dy = end_pos[0] - x, end_pos[1] - y\n          \n          if abs(dx) > abs(dy):\n              # Move in the x direction first\n              if dx < 0:\n                  path.append(UP)\n                  x -= 1\n              else:\n                  path.append(DOWN)\n                  x += 1\n          else:\n              # Move in the y direction next\n              if dy < 0:\n                  path.append(LEFT)\n                  y -= 1\n              else:\n                  path.append(RIGHT)\n                  y += 1\n      \n      return path\n  \n  # Calculate the path to the nearest primitive\n  path_to_primitive = calculate_path(current_state.pos, nearest_primitive_pos)\n  \n  # Add the USE action to collect the primitive once reaching it\n  if current_state.next_to(primitive_index):\n      path_to_primitive.append(4)  # Use action to collect the primitive\n  \n  return path_to_primitive", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-29T02:21:35.360262", "function_name": "collect", "function_body": "", "island_id": 9, "scores": {"3": -1}}
{"timestamp": "2025-07-29T02:22:50.980021", "function_name": "collect", "function_body": "  def heuristic_distance(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_closest_ungrabbed_primitive(current_pos, grid_shape, grid, primitive_index, grabbed_positions):\n      closest_pos = None\n      min_distance = float('inf')\n      \n      for x in range(grid_shape[0]):\n          for y in range(grid_shape[1]):\n              if grid[x, y, primitive_index] > 0 and (x, y) not in grabbed_positions:\n                  distance = heuristic_distance(current_pos, (x, y))\n                  if distance < min_distance:\n                      closest_pos = (x, y)\n                      min_distance = distance\n      \n      return closest_pos\n\n  def move_towards(target):\n    \"\"\"Generate actions to move the agent towards a target position.\"\"\"\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target\n    \n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    actions = []\n    if dx < 0:\n        actions.extend([1] * abs(dx))  # LEFT\n    elif dx > 0:\n        actions.extend([0] * abs(dx))  # RIGHT\n    \n    if dy < 0:\n        actions.extend([3] * abs(dy))  # UP\n    elif dy > 0:\n        actions.extend([2] * abs(dy))  # DOWN\n    \n    return actions\n\n  def collect_primitive():\n      \"\"\"Generate action to collect the primitive once the agent is near it.\"\"\"\n      return [4]  # USE\n\n  actions_to_take = []\n  \n  # Get the index for the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Search for all occurrences of the desired primitive in the grid\n  current_pos = env._current_state.pos\n  grid_shape = env._current_state.grid.shape[:2]  # (WIDTH, HEIGHT)\n  grabbed_positions = set()\n\n  while True:\n      closest_pos = find_closest_ungrabbed_primitive(current_pos, grid_shape, env._current_state.grid, primitive_index, grabbed_positions)\n      if closest_pos is None:\n          break\n      \n      actions_to_take.extend(move_towards(closest_pos))\n      actions_to_take.extend(collect_primitive())\n      \n      grabbed_positions.add(closest_pos)\n      current_pos = closest_pos\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T02:22:52.224869", "function_name": "collect", "function_body": "  def heuristic_distance(a, b):\n    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n\n  def find_closest_ungrabbed_primitive(current_pos, grid_shape, grid, primitive_index, grabbed_positions):\n      closest_pos = None\n      min_distance = float('inf')\n      \n      for x in range(grid_shape[0]):\n          for y in range(grid_shape[1]):\n              if grid[x, y, primitive_index] > 0 and (x, y) not in grabbed_positions:\n                  distance = heuristic_distance(current_pos, (x, y))\n                  if distance < min_distance:\n                      closest_pos = (x, y)\n                      min_distance = distance\n      \n      return closest_pos\n\n  def move_towards(target):\n    \"\"\"Generate actions to move the agent towards a target position.\"\"\"\n    current_x, current_y = env._current_state.pos\n    target_x, target_y = target\n    \n    dx = target_x - current_x\n    dy = target_y - current_y\n    \n    actions = []\n    if dx < 0:\n        actions.extend([1] * abs(dx))  # LEFT\n    elif dx > 0:\n        actions.extend([0] * abs(dx))  # RIGHT\n    \n    if dy < 0:\n        actions.extend([3] * abs(dy))  # UP\n    elif dy > 0:\n        actions.extend([2] * abs(dy))  # DOWN\n    \n    return actions\n\n  def collect_primitive():\n      \"\"\"Generate action to collect the primitive once the agent is near it.\"\"\"\n      return [4]  # USE\n\n  actions_to_take = []\n  \n  # Get the index for the desired primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Search for all occurrences of the desired primitive in the grid\n  current_pos = env._current_state.pos\n  grid_shape = env._current_state.grid.shape[:2]  # (WIDTH, HEIGHT)\n  grabbed_positions = set()\n\n  while True:\n      closest_pos = find_closest_ungrabbed_primitive(current_pos, grid_shape, env._current_state.grid, primitive_index, grabbed_positions)\n      if closest_pos is None:\n          break\n      \n      actions_to_take.extend(move_towards(closest_pos))\n      actions_to_take.extend(collect_primitive())\n      \n      grabbed_positions.add(closest_pos)\n      current_pos = closest_pos\n\n  return actions_to_take", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-29T02:23:52.728550", "function_name": "collect", "function_body": "  # Initialize an empty list to store actions\n  actions = []\n  \n  # Determine the index for the primitive from the cookbook's index\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Check if the primitive is in the agent's inventory\n  while env._current_state.inventory[primitive_index] == 0:\n      # If not, find the nearest cell containing the primitive\n      grid = env._current_state.grid\n      x, y = env._current_state.pos\n      \n      # Find all positions of the primitive in the grid\n      locations = np.argwhere(grid[:, :, primitive_index] > 0)\n      \n      if len(locations) == 0:\n          # If no primitives are found, return an empty list (or handle accordingly)\n          return actions\n      \n      # Calculate distances to all found primitives from the current position\n      distances = np.sum((locations - [x, y]) ** 2, axis=1)\n      \n      # Find the nearest primitive\n      nearest_location = locations[np.argmin(distances)]\n      nx, ny = nearest_location\n      \n      # Determine the direction needed to move towards the nearest primitive\n      dx = nx - x\n      dy = ny - y\n      \n      # Generate movement actions\n      if dx > 0:\n          actions.append(3)  # RIGHT\n      elif dx < 0:\n          actions.append(2)  # LEFT\n      if dy > 0:\n          actions.append(1)  # UP\n      elif dy < 0:\n          actions.append(0)  # DOWN\n      \n      # Add the USE action to collect the primitive\n      actions.append(4)\n      \n      # Update the current state in the environment after performing actions\n      for action in actions:\n          _, done, _ = env.step(action)\n          if done:\n              break\n  \n  return actions", "island_id": 7, "scores": {"3": -1}}
{"timestamp": "2025-07-29T02:23:53.957079", "function_name": "collect", "function_body": "  actions = []\n  \n  # Check the current inventory\n  if env._current_state.inventory[env.world.index.get(primitive)] > 0:\n    print(f\"Already have {primitive} in inventory.\")\n    return actions\n\n  # Define movement directions\n  DIRECTIONS = {\"UP\": 1, \"DOWN\": 2, \"LEFT\": 3, \"RIGHT\": 4}\n  \n  # Get the index of the primitive from the world's index mapping\n  target_index = env.world.index.get(primitive)\n  \n  # Check if the agent is next to the primitive\n  if env._current_state.next_to(target_index):\n    print(f\"Primitive {primitive} found nearby.\")\n    actions.append(DIRECTIONS[\"USE\"])\n    return actions\n\n  # If not, search for the primitive\n  grid = env._current_state.grid\n  \n  # Find all positions of the target primitive in the grid\n  positions = np.argwhere(grid[:, :, target_index] > 0)\n  \n  if len(positions) == 0:\n    print(f\"Primitive {primitive} not found on the map.\")\n    return actions\n\n  # Sort positions by distance to the agent's current position\n  pos_x, pos_y = env._current_state.pos\n  distances = np.sqrt((positions[:, 0] - pos_x)**2 + (positions[:, 1] - pos_y)**2)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Move towards the nearest primitive\n  for x, y in sorted_positions:\n    delta_x = x - pos_x\n    delta_y = y - pos_y\n\n    if delta_x > 0:\n      actions.extend([DIRECTIONS[\"DOWN\"]]*delta_x)\n    elif delta_x < 0:\n      actions.extend([DIRECTIONS[\"UP\"]]*abs(delta_x))\n\n    if delta_y > 0:\n      actions.extend([DIRECTIONS[\"RIGHT\"]]*delta_y)\n    elif delta_y < 0:\n      actions.extend([DIRECTIONS[\"LEFT\"]]*abs(delta_y))\n\n    # Once in position, use the primitive\n    actions.append(DIRECTIONS[\"USE\"])\n\n    break\n\n  return actions", "island_id": 7, "scores": {"3": -1}}
