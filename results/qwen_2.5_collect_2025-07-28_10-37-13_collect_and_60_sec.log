     if dy < 0:\n          actions.extend([1] * abs(dy))  # UP\n      elif dy > 0:\n          actions.extend([4] * dy)  # DOWN\n\n      current_pos = next_pos\n  \n  # Collect the item (assuming USE action will pick up the item)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:13:37.132339", "function_name": "collect", "function_body": "  def bfs(start_pos, target_index):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = [start_pos]\n    visited = set([start_pos])\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.pop(0)\n      \n      if grid[current_pos[1], current_pos[0], target_index] > 0:\n        path = []\n        while current_pos != start_pos:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        return list(reversed(path))\n\n      for direction in directions:\n        new_x = current_pos[0] + direction[0]\n        new_y = current_pos[1] + direction[1]\n\n        if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n          queue.append((new_x, new_y))\n          visited.add((new_x, new_y))\n          parent_map[(new_x, new_y)] = current_pos\n\n    return None\n\n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  # Check if the primitive is already in the inventory\n  if env._current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect, already have it\n  \n  actions = []\n  grid = env._current_state.grid\n  width, height, _ = grid.shape\n\n  # Perform BFS to find the shortest path to the primitive\n  start_pos = tuple(env._current_state.pos)\n  path = bfs(start_pos, primitive_index)\n\n  if not path:\n    return []  # Could not find a path to the primitive\n\n  current_pos = start_pos\n  for next_pos in path:\n    dx = next_pos[0] - current_pos[0]\n    dy = next_pos[1] - current_pos[1]\n\n    # Move horizontally first\n    if dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    elif dx > 0:\n      actions.extend([3] * dx)  # RIGHT\n\n    # Move vertically next\n    if dy < 0:\n      actions.extend([1] * abs(dy))  # UP\n    elif dy > 0:\n      actions.extend([4] * dy)  # DOWN\n\n    current_pos = next_pos\n\n  # Collect the item (assuming USE action will pick up the item)\n  actions.append(4)  # USE\n  \n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:13:39.300729", "function_name": "collect", "function_body": "  def bfs(start_pos, target_index):\n    directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # RIGHT, DOWN, LEFT, UP\n    queue = [start_pos]\n    visited = set([start_pos])\n    parent_map = {}\n\n    while queue:\n      current_pos = queue.pop(0)\n      \n      if grid[current_pos[1], current_pos[0], target_index] > 0:\n        path = []\n        while current_pos != start_pos:\n          path.append(current_pos)\n          current_pos = parent_map[current_pos]\n        return list(reversed(path))\n\n      for direction in directions:\n        new_x = current_pos[0] + direction[0]\n        new_y = current_pos[1] + direction[1]\n\n        if 0 <= new_x < width and 0 <= new_y < height and (new_x, new_y) not in visited:\n          queue.append((new_x, new_y))\n          visited.add((new_x, new_y))\n          parent_map[(new_x, new_y)] = current_pos\n\n    return None\n\n  def move_to(target_pos):\n    dx = target_pos[0] - current_pos[0]\n    dy = target_pos[1] - current_pos[1]\n\n    actions = []\n    \n    # Move horizontally first\n    if dx < 0:\n      actions.extend([2] * abs(dx))  # LEFT\n    elif dx > 0:\n      actions.extend([3] * dx)  # RIGHT\n\n    # Move vertically next\n    if dy < 0:\n      actions.extend([1] * abs(dy))  # UP\n    elif dy > 0:\n      actions.extend([4] * dy)  # DOWN\n\n    return actions\n\n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  # Check if the primitive is in the inventory already\n  if env._current_state.inventory[primitive_index] > 0:\n    return []  # No need to collect, already have it\n  \n  grid = env._current_state.grid\n  width, height, _ = grid.shape\n\n  # Perform BFS to find the shortest path to the primitive\n  start_pos = tuple(env._current_state.pos)\n  path = bfs(start_pos, primitive_index)\n\n  if not path:\n    return []  # Could not find a path to the primitive\n\n  current_pos = start_pos\n  actions = []\n\n  for next_pos in path:\n    actions.extend(move_to(next_pos))\n    current_pos = next_pos\n\n  # Collect the item (assuming USE action will pick up the item)\n  actions.append(4)  # USE\n\n  return actions", "island_id": 9, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:14:10.089731", "function_name": "collect", "function_body": "", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:14:12.375752", "function_name": "collect", "function_body": "  # Determine index of the primitive\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  actions = []\n  current_pos = (env._current_state.pos[0], env._current_state.pos[1])\n  \n  while not env._current_state.next_to(primitive_index):\n      # Find all positions of the primitive in the grid\n      primitive_positions = np.argwhere(env._current_state.grid[:, :, primitive_index] > 0)\n      \n      if len(primitive_positions) == 0:\n          break\n      \n      # Choose the closest position to move towards\n      closest_position = min(\n          primitive_positions, \n          key=lambda p: abs(p[0] - current_pos[0]) + abs(p[1] - current_pos[1])\n      )\n      \n      target_x, target_y = closest_position\n      \n      # Calculate direction needed to move closer to the target position\n      delta_x = target_x - current_pos[0]\n      delta_y = target_y - current_pos[1]\n      \n      if delta_x > 0:\n          actions.append(env._world_action_map['RIGHT'])\n      elif delta_x < 0:\n          actions.append(env._world_action_map['LEFT'])\n      \n      if delta_y > 0:\n          actions.append(env._world_action_map['DOWN'])\n      elif delta_y < 0:\n          actions.append(env._world_action_map['UP'])\n\n      # Update current position\n      current_pos = (current_pos[0] + delta_x, current_pos[1] + delta_y)\n      \n      # Move to the closest position and collect the primitive\n      if env._current_state.next_to(primitive_index):\n          actions.append(env._world_action_map['USE'])\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:15:39.937167", "function_name": "collect", "function_body": "  ACTION_UP = 0\n  ACTION_DOWN = 1\n  ACTION_LEFT = 3\n  ACTION_RIGHT = 2\n\n  # Function to convert position tuples to index\n  def pos_to_idx(pos):\n      return pos[1] * env.scenario.world.world.grid.shape[0] + pos[0]\n\n  # Get the current state of the environment\n  state = env._current_state\n\n  # Define actions list\n  actions = []\n\n  # Function to add a move action based on direction difference\n  def add_move_action(current_pos, target_pos):\n      if current_pos[1] < target_pos[1]:\n          actions.append(ACTION_DOWN)\n      elif current_pos[1] > target_pos[1]:\n          actions.append(ACTION_UP)\n      if current_pos[0] < target_pos[0]:\n          actions.append(ACTION_RIGHT)\n      elif current_pos[0] > target_pos[0]:\n          actions.append(ACTION_LEFT)\n\n  # Check if the primitive is already next to the agent\n  if state.next_to(state.world.cookbook.index.index(primitive)):\n      actions.append(4)  # Use action (to pick up the primitive)\n      return actions\n\n  # Perform a simple search to find the nearest primitive\n  grid = state.grid.copy()\n  start_pos = state.pos\n  queue = [start_pos]\n  visited = set()\n  visited.add(start_pos)\n\n  target_pos = None\n  while queue:\n      current_pos = queue.pop(0)\n      if state.next_to(state.world.cookbook.index.index(primitive)):\n          target_pos = current_pos\n          break\n\n      for direction in [(0, 1), (1, 0), (-1, 0), (0, -1)]:\n          new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n          if (0 <= new_pos[0] < grid.shape[0] and\n              0 <= new_pos[1] < grid.shape[1] and\n              new_pos not in visited):\n              queue.append(new_pos)\n              visited.add(new_pos)\n\n  if target_pos is None:\n      # Try to find the nearest primitive using a different approach\n      for x in range(grid.shape[0]):\n          for y in range(grid.shape[1]):\n              if grid[x, y, state.world.cookbook.index.index(primitive)] > 0:\n                  target_pos = (x, y)\n                  break\n\n  if target_pos is not None:\n      add_move_action(state.pos, target_pos)\n      actions.append(4)  # Use action (to pick up the primitive)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:15:41.935437", "function_name": "collect", "function_body": "  ACTION_UP = 0\n  ACTION_DOWN = 1\n  ACTION_LEFT = 3\n  ACTION_RIGHT = 2\n\n  def add_move_action(current_pos, target_pos):\n    actions = []\n    if current_pos[1] < target_pos[1]:\n        actions.append(ACTION_DOWN)\n    elif current_pos[1] > target_pos[1]:\n        actions.append(ACTION_UP)\n    if current_pos[0] < target_pos[0]:\n        actions.append(ACTION_RIGHT)\n    elif current_pos[0] > target_pos[0]:\n        actions.append(ACTION_LEFT)\n    return actions\n\n  def bfs_to_target(start_pos, target_index):\n      grid = env._current_state.grid\n      queue = [(start_pos, [])]\n      visited = set()\n      visited.add(start_pos)\n\n      while queue:\n          current_pos, path = queue.pop(0)\n          \n          # Check adjacent cells for the target primitive\n          for direction in [(1, 0), (0, 1), (-1, 0), (0, -1)]:\n              new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n              \n              if (0 <= new_pos[0] < grid.shape[0] and\n                  0 <= new_pos[1] < grid.shape[1]):\n                  \n                  # If the target primitive is found in an adjacent cell\n                  if grid[new_pos][target_index] > 0:\n                      # Construct path to the target position\n                      actions = add_move_action(start_pos, new_pos)\n                      actions.append(4)  # Use action (to pick up the primitive)\n                      return actions\n\n                  # If the new position is not visited and valid, add to queue\n                  if new_pos not in visited:\n                      queue.append((new_pos, path + [direction]))\n                      visited.add(new_pos)\n\n      return []\n\n  # Get the current state of the environment\n  state = env._current_state\n  \n  # Check if the primitive is already next to the agent\n  if state.next_to(state.world.cookbook.index.index(primitive)):\n      return [4]  # Use action (to pick up the primitive)\n\n  # Find the index of the primitive in the environment's cookbook.\n  primitive_index = state.world.cookbook.index.index(primitive)\n  \n  # Perform BFS to find the nearest primitive\n  actions = bfs_to_target(state.pos, primitive_index)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:16:36.377998", "function_name": "collect", "function_body": "  # Find the index for the primitive in the world.\n  world = env.world\n  index = world.cookbook.index.get(world.cookbook.primitives.intersection([primitive]).pop())\n\n  # Initialize an empty list to store actions.\n  actions = []\n\n  # Check if the agent is already next to the primitive.\n  current_state = env._current_state\n  if current_state.next_to(index):\n    return [env.world.N_ACTIONS - 1]  # Use action\n\n  # Get the grid and initial position of the agent.\n  grid = current_state.grid\n  pos = np.array(current_state.pos)\n\n  # Define possible movement actions.\n  movement_actions = {\n      'UP': env.world.UP,\n      'DOWN': env.world.DOWN,\n      'LEFT': env.world.LEFT,\n      'RIGHT': env.world.RIGHT\n  }\n\n  # Function to check if the agent can move in a certain direction without hitting a boundary.\n  def can_move_in_direction(direction):\n    new_pos = pos + np.array([direction[0], direction[1]])\n    return grid[new_pos[0], new_pos[1]].sum() == 0\n\n  # BFS to find the shortest path to the primitive.\n  queue = [(pos, [])]\n  visited = set()\n  found_path = False\n  path_to_primitive = []\n\n  while queue:\n      current_pos, path = queue.pop(0)\n      if tuple(current_pos) in visited:\n          continue\n      visited.add(tuple(current_pos))\n\n      # Check all four directions.\n      for direction_name, action in movement_actions.items():\n          new_pos = current_pos + np.array([direction_name == 'UP', direction_name == 'DOWN',\n                                            direction_name == 'LEFT', direction_name == 'RIGHT'])\n          if can_move_in_direction(new_pos):\n              new_path = path + [action]\n              queue.append((new_pos, new_path))\n\n              # Check if the new position is next to the primitive.\n              if grid[new_pos[0], new_pos[1], index] > 0:\n                  found_path = True\n                  path_to_primitive = new_path\n                  break\n\n      if found_path:\n          break\n\n  actions.extend(path_to_primitive)\n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:16:38.692156", "function_name": "collect", "function_body": "  # Define actions\n  UP = 1\n  DOWN = 0\n  LEFT = 3\n  RIGHT = 2\n  USE = 4\n\n  # Get the current state from the environment\n  current_state = env._current_state\n  \n  # Determine the index of the primitive to collect\n  primitive_index = current_state.world.cookbook.index.get(primitive)\n  \n  if primitive_index is None:\n      raise ValueError(f\"Primitive {primitive} not found in the cookbook.\")\n  \n  # Initialize a list to store actions\n  actions = []\n  \n  # Define a function to check if the agent is next to a specific entity kind\n  def next_to(entity_kind):\n      return current_state.next_to(current_state.world.cookbook.index.get(entity_kind))\n  \n  # Main loop to find and collect the primitive\n  while not next_to(primitive):\n      # Randomly move around until the agent finds the primitive\n      action = np.random.choice([UP, DOWN, LEFT, RIGHT])\n      actions.append(action)\n      \n      # Step in the environment with the chosen action\n      reward, done, observations = env.step(action)\n      if done:\n          break\n      \n  # Once next to the primitive, use the USE action to collect it\n  actions.append(USE)\n  \n  return actions", "island_id": 0, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:17:09.745166", "function_name": "collect", "function_body": "", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:22:09.931533", "function_name": "collect", "function_body": "  actions = []\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  dir = current_state.dir\n\n  # Convert the primitive name to its index in the environment's cookbook.\n  primitive_index = env.world.cookbook.index[primitive]\n\n  # Check if the agent is already next to the required primitive.\n  if current_state.next_to(primitive_index):\n    actions.append(env.action_specs()[\"USE\"])\n    return actions\n\n  # Find positions of the primitive in the grid\n  primitive_positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  # If no primitives are found, return an empty list.\n  if not len(primitive_positions):\n    return []\n\n  # Calculate distances from agent's position to all primitives.\n  distances = np.sum(np.abs(pos - primitive_positions), axis=1)\n  closest_primitive_pos = tuple(primitive_positions[np.argmin(distances)])\n\n  # Determine the direction and actions required to move towards the closest primitive\n  while pos != closest_primitive_pos:\n    delta_x, delta_y = closest_primitive_pos[0] - pos[0], closest_primitive_pos[1] - pos[1]\n\n    if delta_y > 0:\n      actions.append(env.action_specs()[\"DOWN\"])\n    elif delta_y < 0:\n      actions.append(env.action_specs()[\"UP\"])\n\n    if delta_x > 0:\n      actions.append(env.action_specs()[\"RIGHT\"])\n    elif delta_x < 0:\n      actions.append(env.action_specs()[\"LEFT\"])\n\n    # Update the position based on the action\n    pos = (pos[0] + (1 if delta_y > 0 else -1 if delta_y < 0 else 0),\n           pos[1] + (1 if delta_x > 0 else -1 if delta_x < 0 else 0))\n\n  # Once reached, use the primitive.\n  actions.append(env.action_specs()[\"USE\"])\n\n  return actions", "island_id": 1, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:23:36.962384", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Step 1: Extract the current state and inventory from the environment\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Step 2: Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Step 3: Check if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Step 4: Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Step 5: Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Step 6: Generate actions to move to and collect all primitives within a certain radius\n  actions = []\n  for pos in sorted_positions:\n      dx = pos[0] - current_state.pos[0]\n      dy = pos[1] - current_state.pos[1]\n\n      if dx > 0:\n          actions.extend([action_map['DOWN']] * abs(dx))\n      elif dx < 0:\n          actions.extend([action_map['UP']] * abs(dx))\n\n      if dy > 0:\n          actions.extend([action_map['RIGHT']] * abs(dy))\n      elif dy < 0:\n          actions.extend([action_map['LEFT']] * abs(dy))\n\n      # Step 7: Add action to use the primitive\n      actions.append(action_map['USE'])\n\n      # Update current position for the next iteration\n      env._current_state.pos = (pos[0], pos[1])\n\n      # Check if we have collected enough primitives\n      inventory = env._current_state.inventory\n      if inventory[primitive_index] > 0:\n          break\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:23:38.967460", "function_name": "collect", "function_body": "  ACTION_DOWN = 0\n  ACTION_UP = 1\n  ACTION_LEFT = 2\n  ACTION_RIGHT = 3\n  ACTION_USE = 4\n\n  action_map = {\n      'DOWN': ACTION_DOWN,\n      'UP': ACTION_UP,\n      'LEFT': ACTION_LEFT,\n      'RIGHT': ACTION_RIGHT,\n      'USE': ACTION_USE,\n  }\n\n  # Step 1: Extract the current state and inventory from the environment\n  current_state = env._current_state\n  inventory = current_state.inventory\n\n  # Step 2: Get the index of the primitive from the environment's cookbook\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  # Step 3: Check if we already have the required primitives in our inventory\n  if inventory[primitive_index] > 0:\n      return []\n\n  # Step 4: Search for the primitive on the grid\n  grid = current_state.grid\n  positions = np.argwhere(grid[:, :, primitive_index] == 1)\n\n  if len(positions) == 0:\n      raise ValueError(f\"No {primitive} found on the grid.\")\n\n  # Step 5: Sort positions based on distance from the current position\n  init_pos = current_state.pos\n  distances = np.linalg.norm(positions - init_pos, axis=1)\n  sorted_positions = positions[np.argsort(distances)]\n\n  # Step 6: Generate actions to move to and collect all primitives within a certain radius\n  actions = []\n  for pos in sorted_positions:\n      dx = pos[0] - current_state.pos[0]\n      dy = pos[1] - current_state.pos[1]\n\n      # Determine the direction and number of steps to take\n      if dx > 0:\n          actions.extend([action_map['DOWN']] * abs(dx))\n      elif dx < 0:\n          actions.extend([action_map['UP']] * abs(dx))\n\n      if dy > 0:\n          actions.extend([action_map['RIGHT']] * abs(dy))\n      elif dy < 0:\n          actions.extend([action_map['LEFT']] * abs(dy))\n\n      # Step 7: Add action to use the primitive\n      actions.append(action_map['USE'])\n\n      # Update current position for the next iteration\n      current_state.pos = (pos[0], pos[1])\n\n      # Check if we have collected enough primitives\n      inventory = env._current_state.inventory\n      if inventory[primitive_index] > 0:\n          break\n\n  return actions", "island_id": 6, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:24:12.257172", "function_name": "collect", "function_body": "  grabbable_indices = env.world.grabbable_indices\n  primitive_index = env.world.cookbook.index[primitive]\n  \n  # Get the initial state of the environment\n  current_state = env._current_state\n  \n  actions_to_take = []\n\n  while not current_state.next_to(primitive_index):\n      # If not next to the desired primitive, move in a random direction\n      direction = np.random.choice([0, 1, 2, 3])  # Assuming directions are represented as integers: UP=0, DOWN=1, LEFT=2, RIGHT=3\n      actions_to_take.append(direction)\n      reward, current_state, done = env.step(direction)\n\n  if current_state.next_to(primitive_index):\n      # If next to the desired primitive, collect it by using the USE action\n      actions_to_take.append(4)  # Assuming USE action is represented as integer 4\n\n  return actions_to_take", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:24:14.238122", "function_name": "collect", "function_body": "  actions = []\n  # Get the index of the primitive from the environment's world\n  primitive_index = env.world.cookbook.index.index(primitive)\n\n  if primitive_index is None:\n    raise ValueError(f\"Primitive '{primitive}' not found in the cookbook.\")\n\n  # Get the initial state of the scenario\n  current_state = env._current_state\n\n  while True:\n    if current_state.next_to(primitive_index):\n      actions.append(4)  # USE to collect the primitive\n      break\n    else:\n      # Move in a random direction (UP, DOWN, LEFT, RIGHT)\n      move_direction = np.random.choice([0, 1, 2, 3])\n      actions.append(move_direction)\n\n      # Perform the action and get the new state\n      _, current_state = current_state.step(actions[-1])\n\n    if len(actions) > 100:  # Prevent infinite loops\n      raise ValueError(\"Unable to find the primitive within a reasonable number of steps.\")\n\n  return actions", "island_id": 6, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:25:57.533092", "function_name": "collect", "function_body": "  def calculate_shortest_path(grid: np.ndarray, start: tuple, end: tuple):\n    \"\"\"\n    Calculates the shortest path on a grid from start to end using BFS.\n    \n    Parameters:\n    - grid: numpy.ndarray\n        The grid representing the environment where 0 is traversable and non-zero values are obstacles.\n    - start: tuple(int, int)\n        Starting position (y, x).\n    - end: tuple(int, int)\n        Ending position (y, x).\n        \n    Returns:\n    - List of actions to reach from start to end. If no path is found, returns an empty list.\n    \"\"\"\n    # Directions for UP, DOWN, LEFT, RIGHT\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    action_mapping = {(-1, 0): 1, (1, 0): 0, (0, -1): 2, (0, 1): 3}\n    \n    # BFS initialization\n    queue = [(start[0], start[1], [])]  # Queue stores tuples of (y, x, path)\n    visited = set()\n    \n    while queue:\n        current_y, current_x, path = queue.pop(0)\n        \n        if (current_y, current_x) == end:\n            return path\n        \n        if (current_y, current_x) in visited:\n            continue\n        visited.add((current_y, current_x))\n        \n        for dy, dx in directions:\n            new_y, new_x = current_y + dy, current_x + dx\n            \n            # Check boundaries and traversability\n            if 0 <= new_y < grid.shape[0] and 0 <= new_x < grid.shape[1] and grid[new_y, new_x] == 0:\n                queue.append((new_y, new_x, path + [action_mapping[(dy, dx)]]))\n    \n    return []  # No path found\n\n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  if not primitive_index:  # If the primitive index is None or zero\n      return []\n  \n  # Check if the agent is already next to the primitive\n  if env._current_state.next_to(primitive_index):\n      actions = [4]  # USE action to collect the primitive\n  else:\n      # Find all positions of the primitives on the grid\n      grid = env._current_state.grid[:, :, primitive_index]\n      y, x = np.where(grid > 0)\n      \n      if len(y) == 0 or len(x) == 0:\n          return []  # No primitives found\n      \n      agent_y, agent_x = env._current_state.pos\n      obstacles_grid = env._current_state.grid.sum(axis=2) - grid  # All non-primitive cells are obstacles\n      \n      min_path_length = float('inf')\n      best_path = []\n      \n      for nearest_y, nearest_x in zip(y, x):\n          path = calculate_shortest_path(obstacles_grid, (agent_y, agent_x), (nearest_y, nearest_x))\n          if len(path) < min_path_length:\n              min_path_length = len(path)\n              best_path = path\n      \n      actions.extend(best_path)\n      actions.append(4)  # USE action to collect the primitive\n  \n  return actions", "island_id": 2, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:25:59.538137", "function_name": "collect", "function_body": "  def calculate_shortest_path(grid: np.ndarray, start: tuple, end: tuple):\n    \"\"\"\n    Calculates the shortest path on a grid from start to end using BFS.\n    \n    Parameters:\n    - grid: numpy.ndarray\n        The grid representing the environment where 0 is traversable and non-zero values are obstacles.\n    - start: tuple(int, int)\n        Starting position (y, x).\n    - end: tuple(int, int)\n        Ending position (y, x).\n        \n    Returns:\n    - List of actions to reach from start to end. If no path is found, returns an empty list.\n    \"\"\"\n    # Directions for UP, DOWN, LEFT, RIGHT\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n    action_mapping = {(-1, 0): 1, (1, 0): 0, (0, -1): 2, (0, 1): 3}\n    \n    # BFS initialization\n    queue = [(start[0], start[1], [])]  # Queue stores tuples of (y, x, path)\n    visited = set()\n    \n    while queue:\n        current_y, current_x, path = queue.pop(0)\n        \n        if (current_y, current_x) == end:\n            return path\n        \n        if (current_y, current_x) in visited:\n            continue\n        visited.add((current_y, current_x))\n        \n        for dy, dx in directions:\n            new_y, new_x = current_y + dy, current_x + dx\n            \n            # Check boundaries and traversability\n            if 0 <= new_y < grid.shape[0] and 0 <= new_x < grid.shape[1] and grid[new_y, new_x] == 0:\n                queue.append((new_y, new_x, path + [action_mapping[(dy, dx)]]))\n    \n    return []  # No path found\n  \n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  if not primitive_index:  # If the primitive index is None or zero\n      return []\n  \n  # Initialize a list to store actions\n  actions = []\n  \n  # Check if the agent is already next to the primitive\n  if env._current_state.next_to(primitive_index):\n      actions.append(4)  # USE action to collect the primitive\n  else:\n      # Find all positions of the primitives on the grid\n      grid = env._current_state.grid[:, :, primitive_index]\n      y, x = np.where(grid > 0)\n      \n      if len(y) == 0 or len(x) == 0:\n          return []  # No primitives found\n      \n      agent_y, agent_x = env._current_state.pos\n      obstacles_grid = env._current_state.grid.sum(axis=2) - grid  # All non-primitive cells are obstacles\n      \n      min_path_length = float('inf')\n      best_path = []\n      \n      for nearest_y, nearest_x in zip(y, x):\n          path = calculate_shortest_path(obstacles_grid, (agent_y, agent_x), (nearest_y, nearest_x))\n          if len(path) < min_path_length:\n              min_path_length = len(path)\n              best_path = path\n      \n      actions.extend(best_path)\n      actions.append(4)  # USE action to collect the primitive\n  \n  return actions", "island_id": 2, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:28:00.432570", "function_name": "collect", "function_body": "  def get_action_to_move(current_direction, target_direction):\n    if current_direction == 0 and target_direction == (0, -1):  # Facing right, need to go left\n      return env.action_specs()['LEFT']\n    elif current_direction == 0 and target_direction == (0, 1):  # Facing right, need to go right\n      return None\n    elif current_direction == 2 and target_direction == (0, -1):  # Facing left, need to go left\n      return None\n    elif current_direction == 2 and target_direction == (0, 1):  # Facing left, need to go right\n      return env.action_specs()['RIGHT']\n    elif current_direction == 1 and target_direction == (-1, 0):  # Facing down, need to go up\n      return env.action_specs()['UP']\n    elif current_direction == 1 and target_direction == (1, 0):  # Facing down, need to go down\n      return None\n    elif current_direction == 3 and target_direction == (-1, 0):  # Facing up, need to go up\n      return None\n    elif current_direction == 3 and target_direction == (1, 0):  # Facing up, need to go down\n      return env.action_specs()['DOWN']\n\n  def bfs_to_target(start_pos, target_index):\n    grid = env._current_state.grid\n    queue = [(start_pos, [])]\n    visited = set()\n    visited.add(start_pos)\n\n    while queue:\n        current_pos, path = queue.pop(0)\n        \n        # Check if the target is in any of the adjacent cells\n        for direction in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n            \n            if (0 <= new_pos[0] < grid.shape[0] and\n                0 <= new_pos[1] < grid.shape[1] and\n                grid[new_pos][target_index] > 0):\n                \n                # Construct path to the target position\n                actions = []\n                current_direction = env._current_state.state.action_specs()['UP']  # Default facing up\n                \n                for step in path + [direction]:\n                    action = get_action_to_move(current_direction, step)\n                    if action is not None:\n                        actions.append(action)\n                    current_direction = (np.array(step) * np.array([1, -1])).sum()\n                \n                actions.append(env.action_specs()['USE'])  # Use action (to pick up the primitive)\n                return actions\n            \n            if (0 <= new_pos[0] < grid.shape[0] and\n                0 <= new_pos[1] < grid.shape[1] and\n                new_pos not in visited):\n                queue.append((new_pos, path + [direction]))\n                visited.add(new_pos)\n\n    # If no path is found, return an empty list (or handle accordingly)\n    return []\n\n  # Get the current state of the environment\n  state = env._current_state\n  \n  # Define actions list\n  actions = []\n  \n  # Check if the primitive is already next to the agent\n  if state.next_to(state.world.cookbook.index.index(primitive)):\n      actions.append(env.action_specs()['USE'])  # Use action (to pick up the primitive)\n      return actions\n\n  # Find the index of the primitive in the environment's cookbook.\n  primitive_index = state.world.cookbook.index.index(primitive)\n\n  # Perform BFS to find the nearest primitive\n  actions = bfs_to_target(state.pos, primitive_index)\n\n  return actions", "island_id": 3, "scores": {"3": -1}}
{"timestamp": "2025-07-28T13:28:02.450680", "function_name": "collect", "function_body": "  def get_action(current_direction, target_direction):\n      if current_direction == 0 and target_direction == (0, -1):  # Facing right, need to go left\n          return env.action_specs()['LEFT']\n      elif current_direction == 2 and target_direction == (0, 1):  # Facing left, need to go right\n          return env.action_specs()['RIGHT']\n      elif current_direction == 1 and target_direction == (-1, 0):  # Facing down, need to go up\n          return env.action_specs()['UP']\n      elif current_direction == 3 and target_direction == (1, 0):  # Facing up, need to go down\n          return env.action_specs()['DOWN']\n\n  def get_all_actions_to_target(current_pos, target_pos):\n      actions = []\n      while current_pos != target_pos:\n          target_direction = (target_pos[0] - current_pos[0], target_pos[1] - current_pos[1])\n          \n          # Determine the direction to move\n          if target_direction[0] < 0:\n              actions.append(env.action_specs()['UP'])\n              current_pos = (current_pos[0] - 1, current_pos[1])\n          elif target_direction[0] > 0:\n              actions.append(env.action_specs()['DOWN'])\n              current_pos = (current_pos[0] + 1, current_pos[1])\n\n          if target_direction[1] < 0:\n              actions.append(env.action_specs()['LEFT'])\n              current_pos = (current_pos[0], current_pos[1] - 1)\n          elif target_direction[1] > 0:\n              actions.append(env.action_specs()['RIGHT'])\n              current_pos = (current_pos[0], current_pos[1] + 1)\n\n      return actions\n\n  def bfs_to_target(start_pos, target_index):\n    grid = env._current_state.grid\n    queue = [(start_pos, [])]\n    visited = set()\n    visited.add(start_pos)\n    \n    while queue:\n        current_pos, path = queue.pop(0)\n\n        # Check if the primitive is in any of the adjacent cells\n        for direction in [(-1, 0), (1, 0), (0, -1), (0, 1)]:\n            new_pos = (current_pos[0] + direction[0], current_pos[1] + direction[1])\n            \n            if (0 <= new_pos[0] < grid.shape[0] and\n                0 <= new_pos[1] < grid.shape[1] and\n                grid[new_pos][target_index] > 0):\n                \n                # Construct path to the target position\n                actions = get_all_actions_to_target(start_pos, new_pos)\n                actions.append(env.action_specs()['USE'])  # Use action (to pick up the primitive)\n                return actions\n            \n            if (0 <= new_pos[0] < grid.shape[0] and\n                0 <= new_pos[1] < grid.shape[1] and\n                new_pos not in visited):\n                queue.append((new_pos, path + [direction]))\n                visited.add(new_pos)\n\n    # If no path is found, return an empty list (or handle accordingly)\n    return []\n\n  # Get the current state of the environment\n  state = env._current_state\n  \n  # Define actions list\n  actions = []\n  \n  # Check if the primitive is already next to the agent\n  if state.next_to(state.world.cookbook.index.index(primitive)):\n      actions.append(env.action_specs()['USE'])  # Use action (to pick up the primitive)\n      return actions\n\n  # Find the index of the primitive in the environment's cookbook.\n  primitive_index = state.world.cookbook.index.index(primitive)\n\n  # Perform BFS to find the nearest primitive\n  actions = bfs_to_target(state.pos, primitive_index)\n\n  return actions", "island_id": 3, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:29:47.852563", "function_name": "collect", "function_body": "  def find_closest_primitive(grid, pos, primitive_index):\n    \"\"\"Find the closest position of a primitive in the grid.\"\"\"\n    primitive_mask = grid[:, :, primitive_index] > 0\n    primitive_positions = np.argwhere(primitive_mask)\n    \n    if len(primitive_positions) == 0:\n      return None\n\n    distances = np.linalg.norm(primitive_positions - pos, axis=1)\n    closest_primitive_pos = tuple(primitive_positions[np.argmin(distances)])\n    return closest_primitive_pos\n\n  def determine_direction(current_pos, target_pos):\n    \"\"\"Determine the direction to move from current position to target position.\"\"\"\n    dy = target_pos[0] - current_pos[0]\n    dx = target_pos[1] - current_pos[1]\n\n    if abs(dx) > abs(dy):\n        return 0 if dx > 0 else 2\n    else:\n        return 1 if dy > 0 else 3\n\n  def move_to_target(current_state, target_pos):\n    \"\"\"Generate actions to move from the current state's position to the target position.\"\"\"\n    actions = []\n    pos = current_state.pos\n    direction = current_state.dir\n    \n    while pos != target_pos:\n        new_direction = determine_direction(pos, target_pos)\n        \n        if new_direction != direction:\n            actions.append(new_direction)\n            direction = new_direction\n        \n        actions.append(4)  # Assuming 4 corresponds to USE or moving in the current direction\n\n        if direction == 0:  # RIGHT\n            pos = (pos[0], pos[1] + 1)\n        elif direction == 1:  # DOWN\n            pos = (pos[0] + 1, pos[1])\n        elif direction == 2:  # LEFT\n            pos = (pos[0], pos[1] - 1)\n        elif direction == 3:  # UP\n            pos = (pos[0] - 1, pos[1])\n\n    return actions\n\n  def collect_primitive(current_state):\n      \"\"\"Generate action to collect the primitive at the current position.\"\"\"\n      if env.world.cookbook.index.get(env._current_state.dir) == \"WORKSHOP\":\n          return [4]\n      else:\n          return [4]\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  \n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  # Find the closest primitive position\n  target_pos = find_closest_primitive(grid, pos, primitive_index)\n\n  if target_pos is None:\n      return actions\n\n  # Generate actions to move to the target position\n  actions.extend(move_to_target(current_state, target_pos))\n  \n  # Add the action to collect the primitive\n  actions.extend(collect_primitive(current_state))\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
{"timestamp": "2025-07-28T13:29:49.840806", "function_name": "collect", "function_body": "  def find_closest_primitives(grid, pos, direction, primitive_index):\n    # Convert the grid to a boolean mask for the specified primitive\n    primitive_mask = grid[:, :, primitive_index] > 0\n    \n    # Find all positions where the primitive is present\n    primitive_positions = np.argwhere(primitive_mask)\n    \n    if len(primitive_positions) == 0:\n      return None, direction\n\n    # Calculate distances from current position to each primitive position\n    distances = np.linalg.norm(primitive_positions - pos, axis=1)\n    \n    # Find the closest primitive positions\n    min_distance = np.min(distances)\n    closest_primitive_positions = tuple(primitive_positions[distances == min_distance])\n\n    return closest_primitive_positions, direction\n\n  def determine_best_direction(current_pos, target_positions):\n      \"\"\"Determines the best direction (0: RIGHT, 1: DOWN, 2: LEFT, 3: UP) to move from current_pos towards any of the target positions.\"\"\"\n      directions = []\n      for pos in target_positions:\n          dy = pos[0] - current_pos[0]\n          dx = pos[1] - current_pos[1]\n\n          if abs(dx) > abs(dy):\n              direction = 0 if dx > 0 else 2\n          else:\n              direction = 1 if dy > 0 else 3\n\n          directions.append(direction)\n      \n      # Determine the most frequent direction\n      best_direction = max(set(directions), key=directions.count)\n      \n      return best_direction\n\n  def move_to_target(pos, direction, target_positions):\n    \"\"\"Generates actions to move from the current position to the nearest of the target positions.\"\"\"\n    actions = []\n    for pos in target_positions:\n        new_direction = determine_best_direction(pos, target_positions)\n        \n        # If the direction needs to be changed\n        if new_direction != direction:\n            actions.append(new_direction)\n            direction = new_direction\n        \n        # Move forward\n        actions.append(4)  # Assuming 4 corresponds to USE or moving in the current direction\n\n        # Update position based on direction\n        if direction == 0:  # RIGHT\n            pos = (pos[0], pos[1] + 1)\n        elif direction == 1:  # DOWN\n            pos = (pos[0] + 1, pos[1])\n        elif direction == 2:  # LEFT\n            pos = (pos[0], pos[1] - 1)\n        elif direction == 3:  # UP\n            pos = (pos[0] - 1, pos[1])\n\n    return actions\n\n  def collect_primitive():\n      \"\"\"Generates actions to collect the primitive at the current position.\"\"\"\n      if env.world.cookbook.index.get(env._current_state.dir) == \"WORKSHOP\":\n          return [4]  # Assuming USE action collects the primitive from a workshop\n      else:\n          return [4]  # Assuming USE action collects the primitive directly\n\n  actions = []\n  current_state = env._current_state\n  grid = current_state.grid\n  pos = current_state.pos\n  direction = current_state.dir\n  \n  primitive_index = env.world.cookbook.index.index(primitive)\n  \n  # Find the closest primitive and determine the direction to move towards it\n  target_positions, new_direction = find_closest_primitives(grid, pos, direction, primitive_index)\n\n  if target_positions is None:\n      return actions\n\n  # Generate actions to move to the nearest of the target positions\n  actions.extend(move_to_target(pos, direction, target_positions))\n  \n  # Add the action to collect the primitive\n  actions.extend(collect_primitive())\n\n  return actions", "island_id": 4, "scores": {"3": 0.0}}
