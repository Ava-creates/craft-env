{"timestamp": "2025-07-23T18:33:59.756229", "function_name": "craft", "function_body": "  total_reward = 0.0\n  \n  # Get target item index and its recipe details\n  target_item_idx = env.world.cookbook.index[item]\n  recipe = env.world.cookbook.recipes[target_item_idx]\n  \n  # Get workshop index\n  workshop_name = recipe[\"_at\"]\n  workshop_idx = env.world.cookbook.index[workshop_name]\n  \n  # Get needed ingredients (excluding special keys like _at, _yield)\n  ingredients_needed = {k: v for k, v in recipe.items() if isinstance(k, int)}\n\n  max_total_steps = 100  # Set a reasonable upper bound for all actions\n  current_steps = 0\n\n  # --- Step 1: Collect all required primitive ingredients ---\n  for ingredient_idx, count_needed in ingredients_needed.items():\n    while env._current_state.inventory[ingredient_idx] < count_needed and current_steps < max_total_steps:\n      obs = env.observations()\n      state = env._current_state\n      ingredient_collected_in_this_loop = False\n\n      # Find location of the ingredient on the global grid\n      global_grid = obs['features_dict']['features_global']\n      item_locations = np.argwhere(global_grid[:, :, ingredient_idx] == 1)\n\n      if len(item_locations) > 0:\n        target_item_x, target_item_y = item_locations[0] # Pick the first one\n        agent_x, agent_y = state.pos\n\n        # Determine relative direction from agent to ingredient\n        dx = target_item_x - agent_x\n        dy = target_item_y - agent_y\n\n        # If ingredient is adjacent\n        if abs(dx) + abs(dy) == 1:\n          # Determine the action to face the ingredient\n          action_to_face = -1\n          if dx == 1: action_to_face = env.action_specs()['RIGHT']\n          elif dx == -1: action_to_face = env.action_specs()['LEFT']\n          elif dy == 1: action_to_face = env.action_specs()['UP']\n          elif dy == -1: action_to_face = env.action_specs()['DOWN']\n\n          prev_inventory = state.inventory.copy()\n          \n          # If not facing the ingredient, perform action to change direction (agent's position will only change if the target cell is free)\n          if state.dir != action_to_face:\n            r, d, _ = env.step(action_to_face)\n            total_reward += r\n            current_steps += 1\n            if current_steps >= max_total_steps: break # Break if max steps reached during turn\n\n          # After turning (or if already facing), USE\n          r, d, _ = env.step(env.action_specs()['USE'])\n          total_reward += r\n          current_steps += 1\n\n          if env._current_state.inventory[ingredient_idx] > prev_inventory[ingredient_idx]:\n            ingredient_collected_in_this_loop = True\n          \n          if current_steps >= max_total_steps: break # Break if max steps reached during use\n          \n        else: # Not adjacent, try to move closer (greedy movement)\n          action_to_move = -1\n          if dx != 0:\n            action_to_move = env.action_specs()['RIGHT'] if dx > 0 else env.action_specs()['LEFT']\n          elif dy != 0:\n            action_to_move = env.action_specs()['UP'] if dy > 0 else env.action_specs()['DOWN']\n          \n          if action_to_move != -1:\n            r, d, _ = env.step(action_to_move)\n            total_reward += r\n            current_steps += 1\n          else: # No valid simple move found, perhaps blocked\n            break # Give up on this ingredient and move to next (or fail craft)\n      else: # Ingredient not found on grid\n        break # Give up on this ingredient\n\n    if env._current_state.inventory[ingredient_idx] < count_needed:\n      # Failed to collect enough of this ingredient, so return current reward\n      return total_reward\n\n  # --- Step 2: Move to workshop and craft ---\n  workshop_found = False\n  workshop_locations = np.argwhere(env.observations()['features_dict']['features_global'][:, :, workshop_idx] == 1)\n\n  if len(workshop_locations) > 0:\n    target_workshop_x, target_workshop_y = workshop_locations[0]\n    workshop_found = True\n  else:\n    return total_reward # No workshop found\n\n  crafted = False\n  while not crafted and current_steps < max_total_steps:\n    state = env._current_state\n    agent_x, agent_y = state.pos\n\n    dx = target_workshop_x - agent_x\n    dy = target_workshop_y - agent_y\n    \n    action_to_take = -1\n\n    # If adjacent to workshop\n    if abs(dx) + abs(dy) == 1:\n      # Determine the action to face the workshop\n      action_to_face = -1\n      if dx == 1: action_to_face = env.action_specs()['RIGHT']\n      elif dx == -1: action_to_face = env.action_specs()['LEFT']\n      elif dy == 1: action_to_face = env.action_specs()['UP']\n      elif dy == -1: action_to_face = env.action_specs()['DOWN']\n      \n      # If already facing the workshop, USE. Otherwise, change direction.\n      if state.dir == action_to_face:\n        action_to_take = env.action_specs()['USE']\n      else:\n        action_to_take = action_to_face # Change direction (agent's pos stays if blocked)\n    else: # Not adjacent, move closer\n      if dx != 0:\n        action_to_take = env.action_specs()['RIGHT'] if dx > 0 else env.action_specs()['LEFT']\n      elif dy != 0:\n        action_to_take = env.action_specs()['UP'] if dy > 0 else env.action_specs()['DOWN']\n      else:\n        # Should not happen if not crafted and not adjacent, implies stuck or unreachable\n        break # Cannot move closer\n\n    if action_to_take != -1:\n      prev_inventory = state.inventory.copy()\n      r, d, _ = env.step(action_to_take)\n      total_reward += r\n      current_steps += 1\n\n      # Check if the target item was crafted\n      if env._current_state.inventory[target_item_idx] > prev_inventory[target_item_idx]:\n        crafted = True\n    else:\n      break # No valid action found\n\n  return total_reward", "island_id": 3, "scores": {"3": -1}}
